<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimpleOpcFileServer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.3.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.85.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.145" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nodes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="kpi.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedModels\SharedModels.csproj" />
    <ProjectReference Include="..\Drivers\Drivers.Abstractions\Drivers.Abstractions.csproj" />
  </ItemGroup>

  <!-- Copy driver outputs to the drivers/ subfolder after build -->
  <Target Name="CopyDrivers" AfterTargets="Build">
    <ItemGroup>
      <DriverOutputFiles Include="..\Drivers\Drivers.Csv\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Modbus\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.S7\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Mqtt\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.EtherNetIP\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Sql\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.OpcUaClient\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Rest\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Tcp\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Knx\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.Simulation\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <DriverOutputFiles Include="..\Drivers\Drivers.SparkplugB\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)drivers" />
    <Copy SourceFiles="@(DriverOutputFiles)" DestinationFolder="$(OutputPath)drivers" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!-- Auto-build Docker all-in-one image on Release builds (opt-in via BuildDockerImage=true) -->
  <Import Project="..\docker\DockerAllInOne.targets" Condition="Exists('..\docker\DockerAllInOne.targets')" />

</Project>
