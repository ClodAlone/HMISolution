  "PlcPrograms": [
    {
      "Name": "Furnace Temperature Control",
      "Code": "(* IEC 61131-3 Structured Text — Furnace Temperature Controller *)\n(* Reads the furnace temperature and regulates it toward a 450°C setpoint *)\n(* by adjusting pressure proportionally. Clamps output to safe range. *)\n\nVAR\n    setpoint : REAL := 450.0;\n    error : REAL := 0.0;\n    kp : REAL := 0.5;\n    output : REAL := 0.0;\nEND_VAR\n\nerror := setpoint - Plant.Furnace.FurnaceTemperature;\noutput := kp * error;\n\n(* Clamp pressure output between 0 and 100 *)\nIF output > 100.0 THEN\n    output := 100.0;\nELSIF output < 0.0 THEN\n    output := 0.0;\nEND_IF;\n\nPlant.Furnace.FurnacePressure := output;\n",
      "Enabled": true,
      "IntervalMs": 500
    },
    {
      "Name": "Tank Level Monitor",
      "Code": "(* IEC 61131-3 Structured Text — Tank Level Monitor *)\n(* Reads the sine simulation as a sensor input, scales it to *)\n(* a 0–100 range, and writes it to TankLevel. *)\n(* Also adjusts Line1 Speed based on the fill level. *)\n\nVAR\n    rawSensor : REAL := 0.0;\n    level : REAL := 0.0;\n    speedCmd : REAL := 0.0;\nEND_VAR\n\nrawSensor := Plant.Simulation.Sine;\n\n(* Scale from -100..100 to 0..100 *)\nlevel := (rawSensor + 100.0) / 2.0;\nlevel := LIMIT(0.0, level, 100.0);\n\nPlant.Line1.TankLevel := level;\n\n(* Reduce line speed when tank is nearly full *)\nIF level > 90.0 THEN\n    speedCmd := 20.0;\nELSIF level > 70.0 THEN\n    speedCmd := 60.0;\nELSE\n    speedCmd := 100.0;\nEND_IF;\n\nPlant.Line1.Speed := speedCmd;\n",
      "Enabled": false,
      "IntervalMs": 1000
    },
    {
      "Name": "Plant Status Logic",
      "Code": "(* IEC 61131-3 Structured Text — Plant Status Logic *)\n(* Combines Temperature and Pressure readings to decide plant status. *)\n(* Writes a status string and computes a simple health score. *)\n\nVAR\n    temp : REAL := 0.0;\n    press : REAL := 0.0;\n    score : REAL := 100.0;\nEND_VAR\n\ntemp := Plant.Temperature;\npress := Plant.Pressure;\n\n(* Start at 100 and subtract penalties *)\nscore := 100.0;\n\nIF temp > 80.0 THEN\n    score := score - 30.0;\nELSIF temp > 50.0 THEN\n    score := score - 10.0;\nEND_IF;\n\nIF press > 60.0 THEN\n    score := score - 40.0;\nELSIF press > 40.0 THEN\n    score := score - 15.0;\nEND_IF;\n\n(* Write health score back to Pressure as a demo *)\n(* In a real system this would go to a dedicated variable *)\nIF score < 0.0 THEN\n    score := 0.0;\nEND_IF;\n\nPlant.Furnace.FurnaceHumidity := score;\n",
      "Enabled": false,
      "IntervalMs": 2000,
      "Language": "ST"
    },
    {
      "Name": "IL Pressure Monitor",
      "Code": "(* IEC 61131-3 Instruction List — Pressure Monitor *)\n(* Reads Plant.Pressure, compares against thresholds, *)\n(* and writes a clamped value to FurnacePressure. *)\n\nLD    Plant.Pressure\nST    _pressure\n\n(* If pressure > 80 cap it at 80 *)\nLD    _pressure\nGT    80.0\nJMPCN skip_cap\nLD    80.0\nST    _pressure\nskip_cap:\n\n(* If pressure < 5 set floor to 5 *)\nLD    _pressure\nLT    5.0\nJMPCN skip_floor\nLD    5.0\nST    _pressure\nskip_floor:\n\n(* Scale: multiply by 1.2 and write to furnace *)\nLD    _pressure\nMUL   1.2\nST    Plant.Furnace.FurnacePressure\n",
      "Enabled": false,
      "IntervalMs": 500,
      "Language": "IL"
    },
    {
      "Name": "IL Speed Ramp",
      "Code": "(* IEC 61131-3 Instruction List — Speed Ramp *)\n(* Reads Line1.Speed, adds 1 each cycle until 120, then resets to 0 *)\n\nLD    Plant.Line1.Speed\nADD   1\nST    _speed\n\n(* Check if above max *)\nLD    _speed\nGT    120\nJMPCN no_reset\nLD    0\nST    _speed\nno_reset:\n\n(* Write back *)\nLD    _speed\nST    Plant.Line1.Speed\n",
      "Enabled": false,
      "IntervalMs": 1000,
      "Language": "IL"
    },
    {
      "Name": "LD Tank Fill Control",
      "Code": "(* IEC 61131-3 Ladder Diagram — Tank Fill Control *)\n(* Uses contacts and coils to control tank filling logic *)\n(* Reads TankLevel and Blink, writes to Light1 and FurnaceHumidity *)\n\n(* Rung 1: If TankLevel < 30, turn on fill light *)\nRUNG \"Low Level Alarm\"\n  COMPARE LT Plant.Line1.TankLevel 30.0\n  COIL_S Plant.Line1.Light1\nEND_RUNG\n\n(* Rung 2: If TankLevel >= 80, turn off fill light *)\nRUNG \"High Level Stop\"\n  COMPARE GE Plant.Line1.TankLevel 80.0\n  COIL_R Plant.Line1.Light1\nEND_RUNG\n\n(* Rung 3: Copy Sine to FurnaceHumidity as a sensor value *)\nRUNG \"Sensor Copy\"\n  CONTACT NO Plant.Simulation.Blink\n  MOVE Plant.Simulation.Sine Plant.Furnace.FurnaceHumidity\nEND_RUNG\n",
      "Enabled": false,
      "IntervalMs": 500,
      "Language": "LD"
    },
    {
      "Name": "LD Motor Interlock",
      "Code": "(* IEC 61131-3 Ladder Diagram — Motor Interlock *)\n(* Classic start/stop motor circuit with interlock *)\n(* Uses Speed > 0 as \"motor running\", Light1 as start permit *)\n\n(* Rung 1: Start permit — Temperature must be below 80 *)\nRUNG \"Start Permit\"\n  COMPARE LT Plant.Temperature 80.0\n  COIL Plant.Line1.Light1\nEND_RUNG\n\n(* Rung 2: If permitted AND pressure normal, set speed to 100 *)\nRUNG \"Motor Run\"\n  CONTACT NO Plant.Line1.Light1\n  COMPARE LT Plant.Pressure 70.0\n  MOVE 100 Plant.Line1.Speed\nEND_RUNG\n\n(* Rung 3: Emergency — if pressure too high, stop motor *)\nRUNG \"Emergency Stop\"\n  COMPARE GE Plant.Pressure 70.0\n  MOVE 0 Plant.Line1.Speed\nEND_RUNG\n",
      "Enabled": false,
      "IntervalMs": 1000,
      "Language": "LD"
    }
  ],
