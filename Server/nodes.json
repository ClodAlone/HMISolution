      "Code": "OnChanged(\u0022Plant.Simulation.Sine\u0022, e =>\n{\n    var sineValue = (double)e.NewValue;\n    if (sineValue > 90)\n        Write(\u0022Plant.Simulation.Counter\u0022, Read(\u0022Plant.Simulation.Counter\u0022) ?? 0);\n});\nOnChanged(\u0022Plant.Simulation.Blink\u0022, e =>\n{\n    // Log each blink transition\n    System.Console.WriteLine($\u0022Blink changed to {e.NewValue} at {e.Timestamp:HH:mm:ss.fff}\u0022);\n});",
      "Enabled": false,
      "IntervalMs": 0
    },
