<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="WpfApp3.Contracts\WpfApp3.Contracts.csproj" />
    <ProjectReference Include="..\DataLogger\DataLogger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="WpfApp3.Contracts\**" />
    <EmbeddedResource Remove="WpfApp3.Contracts\**" />
    <None Remove="WpfApp3.Contracts\**" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Components\Button.xaml" />
    <Page Remove="Components\Ellipse.xaml" />
    <Page Remove="Components\Rectangle.xaml" />
    <Page Remove="Components\TextBlock.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="Components\Button.xaml" />
    <None Include="Components\Ellipse.xaml" />
    <None Include="Components\Rectangle.xaml" />
    <None Include="Components\TextBlock.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Components\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.106" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Components\Button.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Components\Ellipse.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Components\Rectangle.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Components\TextBlock.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Drivers.Abstractions\" />
    <Folder Include="Drivers.Modbus\" />
    <Folder Include="Drivers.OpcUaClient\" />
    <Folder Include="Server\" />
  </ItemGroup>

</Project>
