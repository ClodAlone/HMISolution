<UserControl x:Class="WpfApp3.Plugins.OpcDiscoveryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="{DynamicResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="GDS Discovery URL:" Foreground="{DynamicResource TextForegroundBrush}" Margin="5"/>
        
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox" Text="opc.tcp://localhost:4840" 
                     Background="{DynamicResource EditorBackgroundBrush}" 
                     Foreground="{DynamicResource TextForegroundBrush}" 
                     BorderBrush="{DynamicResource BorderBrush}"/>
            <Button Content="Discover" Click="Discover_Click" Grid.Column="1" Margin="5,0,0,0" Padding="5,2"
                    Style="{StaticResource TitleBarButtonStyle}" Background="#3E3E42" BorderThickness="1"/>
        </Grid>
        
        <ListView x:Name="ServersListView" Grid.Row="2" Margin="5" 
                  Background="{DynamicResource EditorBackgroundBrush}" 
                  Foreground="{DynamicResource TextForegroundBrush}" 
                  BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Application Name" DisplayMemberBinding="{Binding ApplicationName}" Width="150"/>
                    <GridViewColumn Header="Discovery URL" DisplayMemberBinding="{Binding DiscoveryUrls[0]}" Width="200"/>
                    <GridViewColumn Header="Product URI" DisplayMemberBinding="{Binding ProductUri}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
        
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <TextBlock Text="Discovering..." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
