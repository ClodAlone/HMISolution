<Window x:Class="ServerEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServerEditor"
        xmlns:vm="clr-namespace:ServerEditor.ViewModels"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:Helpers="clr-namespace:ServerEditor.Helpers"
        xmlns:controls="clr-namespace:ServerEditor.Controls"
        mc:Ignorable="d"
        Title="Server Editor" Height="450" Width="800">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁 "/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:VariableViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📄 "/>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text=" (" Foreground="Gray"/>
                <TextBlock Text="{Binding Variable.Type}" Foreground="Gray"/>
                <TextBlock Text=")" Foreground="Gray"/>
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:ScriptGroupViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📜 "/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:ScriptViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💻 "/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>

        <ContextMenu x:Key="FolderContextMenu">
            <MenuItem Header="Add Folder" Command="{Binding  RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddFolderCommand}" />
            <MenuItem Header="Add Variable" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddVariableCommand}" />
            <Separator/>
            <MenuItem Header="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="VariableContextMenu">
             <MenuItem Header="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="ScriptGroupContextMenu">
             <MenuItem Header="Add Script" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddScriptCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="ScriptContextMenu">
             <MenuItem Header="Check Syntax" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CheckSyntaxCommand}" />
             <Separator/>
             <MenuItem Header="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Command="{Binding LoadCommand}" Content="Load"/>
                <Label Content="Recent:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding RecentFiles}" SelectedItem="{Binding SelectedRecentFile}" Width="150" ToolTip="Recent Files"/>
                <Button Command="{Binding SaveCommand}" Content="Save"/>
                <Button Command="{Binding SaveAsCommand}" Content="Save As"/>
                <Separator/>
                <Button Command="{Binding AddFolderCommand}" Content="Add Folder"/>
                <Button Command="{Binding AddVariableCommand}" Content="Add Variable"/>
                <Button Command="{Binding AddScriptCommand}" Content="Add Script"/>
                <Separator/>
                <Button Command="{Binding CheckSyntaxCommand}" Content="Check Syntax"/>
                <Separator/>
                <Button Command="{Binding DeleteCommand}" Content="Delete"/>
                <Separator/>
                <Button Command="{Binding StartServerCommand}" Content="Run (Console)"/>
                <Button Command="{Binding StopServerCommand}" Content="Stop (Console)"/>
                <Separator/>
                <Label Content="Service:"/>
                <Button Command="{Binding InstallServiceCommand}" Content="Install"/>
                <Button Command="{Binding UninstallServiceCommand}" Content="Uninstall"/>
                <Button Command="{Binding StartServiceCmd}" Content="Start"/>
                <Button Command="{Binding StopServiceCmd}" Content="Stop"/>
                <Separator/>
                <Label Content="AI Engine:"/>
                <ComboBox ItemsSource="{Binding AiEngines}" SelectedItem="{Binding SelectedAiEngine}" Width="100"/>
            </ToolBar>
        </ToolBarTray>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="Design">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TreeView Grid.Column="0" ItemsSource="{Binding RootItems}" SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeName}" Value="Folder">
                                         <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TypeName}" Value="Variable">
                                         <Setter Property="ContextMenu" Value="{StaticResource VariableContextMenu}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TypeName}" Value="ScriptGroup">
                                         <Setter Property="ContextMenu" Value="{StaticResource ScriptGroupContextMenu}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TypeName}" Value="Script">
                                         <Setter Property="ContextMenu" Value="{StaticResource ScriptContextMenu}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- Editor Pane -->
                    <ContentControl Grid.Column="1" Content="{Binding SelectedItem}">
                        <ContentControl.Resources>
                            <!-- Script Editor Template -->
                            <DataTemplate DataType="{x:Type vm:ScriptViewModel}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Script Name: " VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" VerticalAlignment="Center"/>
                                        <TextBlock Text="  Interval (ms): " VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBox Text="{Binding IntervalMs}" Width="60"/>
                                        <TextBlock Text="  Language: " VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding Language}" Width="100"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Code:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="Undo" Command="Undo" CommandTarget="{Binding ElementName=CodeEditor}" Width="50" Margin="0,0,5,0"/>
                                        <Button Content="Redo" Command="Redo" CommandTarget="{Binding ElementName=CodeEditor}" Width="50"/>
                                    </StackPanel>
                                    <avalonEdit:TextEditor Grid.Row="3" x:Name="CodeEditor" 
                                             Helpers:AvalonEditBehaviour.AvalonEditText="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ShowLineNumbers="True"
                                             SyntaxHighlighting="{Binding SyntaxHighlightingName}"
                                             FontFamily="Consolas" 
                                             VerticalScrollBarVisibility="Auto" 
                                             HorizontalScrollBarVisibility="Auto"/>
                            

                                    <Button Grid.Row="4" Content="Check Syntax" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CheckSyntaxCommand}" 
                                            HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,5"/>
                                </Grid>
                            </DataTemplate>

                            <!-- Folder Editor Template -->
                            <DataTemplate DataType="{x:Type vm:FolderViewModel}">
                                <StackPanel Margin="10">
                                     <TextBlock Text="Folder Properties" FontWeight="Bold" Margin="0,0,0,10"/>
                                     <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Name: " VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                             <!-- Variable Editor Template -->
                            <DataTemplate DataType="{x:Type vm:VariableViewModel}">
                                <StackPanel Margin="10">
                                     <TextBlock Text="Variable Properties" FontWeight="Bold" Margin="0,0,0,10"/>
                                     <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Name: " VerticalAlignment="Center" Width="100"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    </StackPanel>
                                     <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Type: " VerticalAlignment="Center" Width="100"/>
                                        <ComboBox SelectedItem="{Binding Variable.Type}" ItemsSource="{Binding AvailableTypes}" Width="200" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Access: " VerticalAlignment="Center" Width="100"/>
                                        <TextBox Text="{Binding Variable.Access}" Width="200"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Driver Settings (JSON):" FontWeight="Bold" Margin="0,10,0,5"/>
                                    <TextBox Text="{Binding DriverSettingsJson, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="150" 
                                             AcceptsReturn="True" 
                                             AcceptsTab="True"
                                             FontFamily="Consolas" 
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </TabItem>
            
            <TabItem Header="Client">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:OpcBrowseControl x:Name="OpcBrowser" Grid.Column="0"/>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Gray"/>
                    <controls:OpcMonitorControl x:Name="OpcMonitor" Grid.Column="2"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Settings">
                <StackPanel Margin="10">
                    <GroupBox Header="Server Settings">
                        <StackPanel Margin="5">
                            <Label Content="Endpoint URL:"/>
                            <TextBox Text="{Binding ServerEndpointUrl, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                            <TextBlock Text="Requires server restart to apply." FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="JSON Editor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <Button Content="Refresh from Tree" Command="{Binding RefreshJsonCommand}" Margin="5"/>
                        <Button Content="Apply to Tree" Command="{Binding ApplyJsonCommand}" Margin="5"/>
                        <TextBlock Text="Edit JSON manually or use Copilot, then click Apply." VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    
                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CopilotPrompt, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                        <TextBlock IsHitTestVisible="False" Text="Ask Copilot (e.g. 'Add 5 temperature variables')..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CopilotPrompt}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="✨ Ask Copilot" Command="{Binding AskCopilotCommand}" Margin="5,0,0,0" Padding="10,5"/>
                        
                        <ProgressBar Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Background="Transparent" BorderThickness="0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiProcessing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- JSON Editor -->
                        <avalonEdit:TextEditor Grid.Column="0" 
                                 Helpers:AvalonEditBehaviour.AvalonEditText="{Binding JsonEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ShowLineNumbers="True"
                                 SyntaxHighlighting="Json"
                                 FontFamily="Consolas" 
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto"/>
                        
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Gray" Width="5"/>
                        
                        <!-- AI Pane: Logs & Diff -->
                        <Grid Grid.Column="2" Margin="5,0,0,0">
                            <TabControl>
                                <TabItem Header="Logs">
                                    <controls:LogViewerControl DataContext="{Binding AppLog}" />
                                </TabItem>
                                <TabItem Header="Diff">
                                    <avalonEdit:TextEditor 
                                            Helpers:AvalonEditBehaviour.AvalonEditText="{Binding DiffText, Mode=OneWay}"
                                            ShowLineNumbers="False"
                                            FontFamily="Consolas" 
                                            IsReadOnly="True"
                                            VerticalScrollBarVisibility="Auto" 
                                            HorizontalScrollBarVisibility="Auto"/>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Git / GitHub">
                <Grid Margin="10">
                    <StackPanel MaxWidth="400" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <GroupBox Header="User Identity">
                            <StackPanel Margin="5">
                                <Label Content="Name:"/>
                                <TextBox Text="{Binding GitUserName, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                                <Label Content="Email:" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding GitUserEmail, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                                <Button Content="Configure User" Command="{Binding ConfigureGitUserCommand}" Margin="0,10,0,0" Padding="5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Repository Actions" Margin="0,10,0,0">
                            <StackPanel Margin="5">
                                <Button Content="Initialize Repository" Command="{Binding InitGitRepoCommand}" Padding="5" Margin="0,0,0,5"/>
                                <Label Content="Remote Origin URL:" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding GitRemoteUrl, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                                <Button Content="Set Remote" Command="{Binding SetRemoteCommand}" Margin="0,5,0,0" Padding="5"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Commit Options" Margin="0,10,0,0">
                            <StackPanel Margin="5">
                                <Label Content="Commit Message (for next Save):"/>
                                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="2" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Logs">
                <controls:LogViewerControl DataContext="{Binding LogViewer}" />
            </TabItem>
        </TabControl>
        
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="Service Status: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ServiceStatus}" FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <CheckBox IsChecked="{Binding IsServiceInstalled, Mode=OneWay}" IsHitTestVisible="False" Content="Installed"/>
            </StatusBarItem>
            <Separator/>
             <StatusBarItem>
                <TextBlock Text="Console Process Running: "/>
            </StatusBarItem>
            <StatusBarItem>
                <CheckBox IsChecked="{Binding IsServerRunning, Mode=OneWay}" IsHitTestVisible="False"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
