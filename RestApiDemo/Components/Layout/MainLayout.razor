@inherits LayoutComponentBase

<div class="app-shell">
    <nav class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-icon">⚙</span>
            <span class="brand-text">HMI API Demo</span>
        </div>
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
            <span>🏠</span> Dashboard
        </NavLink>
        <NavLink href="/variables" class="nav-item">
            <span>📊</span> Variables
        </NavLink>
        <NavLink href="/alarms" class="nav-item">
            <span>🔔</span> Alarms
        </NavLink>
        <NavLink href="/recipes" class="nav-item">
            <span>📋</span> Recipes
        </NavLink>
        <NavLink href="/events" class="nav-item">
            <span>📜</span> Events &amp; Audit
        </NavLink>
        <NavLink href="/diagnostics" class="nav-item">
            <span>🔧</span> Diagnostics
        </NavLink>
        <NavLink href="/playground" class="nav-item">
            <span>🧪</span> API Playground
        </NavLink>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>