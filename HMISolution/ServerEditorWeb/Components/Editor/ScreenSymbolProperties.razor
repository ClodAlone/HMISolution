                </div>
            </div>

            <div class="mb-2">
                <label class="form-label mb-0 small">Messages (one per line, use @@StringId for localization)</label>
                <textarea class="form-control form-control-sm" rows="4"
                          style="font-size: 10px; font-family: monospace;"
                          @bind="_selectedSymbol.AnimTextMessages" @bind:after="OnChanged"></textarea>
            </div>

            <div class="form-text" style="font-size: 9px;">
                If Messages is empty, the Label is used. Use @@StringId for localized strings.
                Scroll cycles through messages as a marquee. Flash alternates colors. Fade crossfades between messages.
            </div>

            <button class="btn btn-sm btn-outline-info w-100 py-0 mt-2" style="font-size: 10px;" @onclick="ToggleWidgetPreview">
                @(_widgetPreviewActive ? "⏹ Hide Preview" : "▶ Preview Animation")
            </button>
            @if (_widgetPreviewActive)
            {
                var atMode = _selectedSymbol.AnimTextMode ?? "scroll";
                var atSpeed = _selectedSymbol.AnimTextSpeed > 0 ? _selectedSymbol.AnimTextSpeed : 5;
                var atColor1 = _selectedSymbol.Fill ?? "#e2e8f0";
                var atColor2 = _selectedSymbol.AnimTextColor2 ?? "#ff4444";
                var atBg1 = string.IsNullOrEmpty(_selectedSymbol.AnimTextBackground) ? "transparent" : _selectedSymbol.AnimTextBackground;
                var atBg2 = string.IsNullOrEmpty(_selectedSymbol.AnimTextBackground2) ? atBg1 : _selectedSymbol.AnimTextBackground2;
                var atText = !string.IsNullOrEmpty(_selectedSymbol.Label) ? _selectedSymbol.Label : "Sample Text";
                var atBr = _selectedSymbol.AnimTextBorderRadius;
                var atBorder = _selectedSymbol.AnimTextShowBorder ? $"border: 1px solid {atColor1};" : "";
                var atId = "atPrev";
                <div class="mt-2 rounded" style="background: #0f172a; border: 1px solid #334155; padding: 8px;">
                    <style>
                        @@keyframes @(atId)_scroll { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
                        @@keyframes @(atId)_flash { 0%,49% { color: @atColor1; background: @atBg1; } 50%,100% { color: @atColor2; background: @atBg2; } }
                        @@keyframes @(atId)_pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }
                        @@keyframes @(atId)_type { from { width: 0; } to { width: @(atText.Length)ch; } }
                        @@keyframes @(atId)_blink { 50% { border-color: transparent; } }
                    </style>
                    <div style="overflow: hidden; border-radius: @(atBr)px; @atBorder background: @atBg1; padding: 4px; font-size: 13px; font-weight: bold;">
                        @switch (atMode)
                        {
                            case "scroll":
                                <div style="white-space: nowrap; animation: @(atId)_scroll @(Fmt(atSpeed))s linear infinite; color: @atColor1;">@atText</div>
                                break;
                            case "flash":
                                <div style="text-align: center; animation: @(atId)_flash @(Fmt(atSpeed))s step-end infinite; color: @atColor1;">@atText</div>
                                break;
                            case "pulse":
                                <div style="text-align: center; animation: @(atId)_pulse @(Fmt(atSpeed))s ease-in-out infinite; color: @atColor1;">@atText</div>
                                break;
                            case "typewriter":
                                <div style="overflow: hidden; white-space: nowrap; border-right: 2px solid @atColor1; width: 0; color: @atColor1; animation: @(atId)_type @(Fmt(atSpeed))s steps(@atText.Length) infinite, @(atId)_blink 0.7s step-end infinite;">@atText</div>
                                break;
                            case "fade":
                                <div style="text-align: center; animation: @(atId)_pulse @(Fmt(atSpeed))s ease-in-out infinite; color: @atColor1;">@atText</div>
                                break;
                        }
                    </div>
                </div>
            }
        }
