@using SharedModels
@using ServerEditorWeb.Services
@using ServerEditorWeb.Models

<div class="problems-panel">
    <div class="problems-toolbar">
        <button class="btn btn-sm btn-outline-primary" @onclick="RunValidation" disabled="@_scanning">
            @if (_scanning)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            🔍 Validate Project
        </button>

        <div class="problems-filter-group">
            <button class="problems-filter-btn @(_showErrors ? "active error" : "")" @onclick="() => _showErrors = !_showErrors"
                    title="Toggle errors">
                🔴 @_errorCount
            </button>
            <button class="problems-filter-btn @(_showWarnings ? "active warning" : "")" @onclick="() => _showWarnings = !_showWarnings"
                    title="Toggle warnings">
                🟡 @_warningCount
            </button>
            <button class="problems-filter-btn @(_showInfo ? "active info" : "")" @onclick="() => _showInfo = !_showInfo"
                    title="Toggle info">
                🔵 @_infoCount
            </button>
        </div>

        @if (_issues.Count > 0)
        {
            <span class="problems-summary">
                @_filteredIssues.Count of @_issues.Count issues shown
            </span>
        }

        @if (!string.IsNullOrEmpty(_filterCategory))
        {
            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="ClearCategoryFilter" title="Clear category filter">
                ✕ @_filterCategory
            </button>
        }
    </div>

    @if (_issues.Count == 0 && !_scanning)
    {
        <div class="problems-empty">
            @if (_hasRun)
            {
                <div class="problems-empty-success">
                    <span style="font-size: 28px;">✅</span>
                    <div>No issues found. Project looks good!</div>
                </div>
            }
            else
            {
                <div class="text-muted">Click <strong>Validate Project</strong> to scan for issues.</div>
            }
        </div>
    }
    else
    {
        <div class="problems-table-wrap">
            <table class="problems-table">
                <thead>
                    <tr>
                        <th style="width: 32px;"></th>
                        <th style="width: 90px; cursor: pointer;" @onclick="() => ToggleCategorySort()">Category</th>
                        <th>Message</th>
                        <th style="width: 220px;">Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var issue in _filteredIssues)
                    {
                        var rowClass = issue.Severity switch
                        {
                            IssueSeverity.Error => "issue-error",
                            IssueSeverity.Warning => "issue-warning",
                            _ => "issue-info"
                        };
                        <tr class="@rowClass" @onclick="() => OnIssueClick(issue)" style="cursor: pointer;">
                            <td class="issue-icon">
                                @(issue.Severity switch
                                {
                                    IssueSeverity.Error => "🔴",
                                    IssueSeverity.Warning => "🟡",
                                    _ => "🔵"
                                })
                            </td>
                            <td class="issue-category" @onclick="() => FilterByCategory(issue.Category)" @onclick:stopPropagation
                                title="Click to filter by category">
                                @issue.Category
                            </td>
                            <td class="issue-message">@issue.Message</td>
                            <td class="issue-location" title="@issue.Location">@issue.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .problems-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        font-size: 12px;
    }

    .problems-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        border-bottom: 1px solid var(--border-color, #dee2e6);
        flex-shrink: 0;
        flex-wrap: wrap;
    }

    .problems-filter-group {
        display: flex;
        gap: 2px;
        border: 1px solid var(--border-color, #dee2e6);
        border-radius: 4px;
        overflow: hidden;
    }

    .problems-filter-btn {
        background: transparent;
        border: none;
        padding: 2px 8px;
        font-size: 11px;
        cursor: pointer;
        opacity: 0.4;
        transition: all 0.15s;
    }

    .problems-filter-btn.active {
        opacity: 1;
        font-weight: 600;
    }

    .problems-filter-btn.active.error { background: rgba(220, 53, 69, 0.1); }
    .problems-filter-btn.active.warning { background: rgba(255, 193, 7, 0.1); }
    .problems-filter-btn.active.info { background: rgba(13, 110, 253, 0.1); }

    .problems-summary {
        font-size: 11px;
        color: var(--text-muted, #6c757d);
        margin-left: auto;
    }

    .problems-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: var(--text-muted, #6c757d);
        font-size: 13px;
    }

    .problems-empty-success {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .problems-table-wrap {
        overflow: auto;
        flex: 1;
    }

    .problems-table {
        width: 100%;
        border-collapse: collapse;
    }

    .problems-table thead th {
        position: sticky;
        top: 0;
        background: var(--bg-secondary, #f8f9fa);
        border-bottom: 1px solid var(--border-color, #dee2e6);
        padding: 3px 6px;
        font-weight: 600;
        font-size: 11px;
        text-align: left;
        z-index: 1;
    }

    .problems-table tbody tr {
        border-bottom: 1px solid var(--border-color, #dee2e6);
        transition: background 0.1s;
    }

    .problems-table tbody tr:hover {
        background: var(--hover-bg, rgba(0, 123, 255, 0.05));
    }

    .problems-table td {
        padding: 2px 6px;
        vertical-align: middle;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 0;
    }

    .issue-icon { text-align: center; width: 32px; max-width: 32px; }

    .issue-category {
        font-size: 11px;
        color: var(--text-muted, #6c757d);
    }
    .issue-category:hover { text-decoration: underline; }

    .issue-message {
        white-space: normal;
        word-break: break-word;
    }

    .issue-location {
        font-size: 11px;
        color: var(--text-muted, #6c757d);
    }

    .issue-error { }
    .issue-warning { }
    .issue-info { }
</style>

@code {
    [Inject] private ProjectValidationService Validator { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;

    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private List<ProjectIssue> _issues = [];
    private List<ProjectIssue> _filteredIssues = [];
    private bool _scanning;
    private bool _hasRun;

    private bool _showErrors = true;
    private bool _showWarnings = true;
    private bool _showInfo = true;
    private string _filterCategory = "";
    private bool _sortCategoryAsc = true;

    private int _errorCount;
    private int _warningCount;
    private int _infoCount;

    public async Task RunValidation()
    {
        _scanning = true;
        _hasRun = true;
        StateHasChanged();

        await Task.Yield(); // Let UI update

        var model = Editor.RootModel;
        _issues = model != null ? Validator.Validate(model) : [];
        _errorCount = _issues.Count(i => i.Severity == IssueSeverity.Error);
        _warningCount = _issues.Count(i => i.Severity == IssueSeverity.Warning);
        _infoCount = _issues.Count(i => i.Severity == IssueSeverity.Info);

        ApplyFilter();

        _scanning = false;
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        _filteredIssues = _issues.Where(i =>
        {
            if (i.Severity == IssueSeverity.Error && !_showErrors) return false;
            if (i.Severity == IssueSeverity.Warning && !_showWarnings) return false;
            if (i.Severity == IssueSeverity.Info && !_showInfo) return false;
            if (!string.IsNullOrEmpty(_filterCategory) &&
                !i.Category.Equals(_filterCategory, StringComparison.OrdinalIgnoreCase)) return false;
            return true;
        })
        .OrderBy(i => i.Severity)
        .ThenBy(i => _sortCategoryAsc ? i.Category : "")
        .ThenByDescending(i => _sortCategoryAsc ? "" : i.Category)
        .ToList();
    }

    private void FilterByCategory(string category)
    {
        _filterCategory = _filterCategory == category ? "" : category;
        ApplyFilter();
    }

    private void ClearCategoryFilter()
    {
        _filterCategory = "";
        ApplyFilter();
    }

    private void ToggleCategorySort()
    {
        _sortCategoryAsc = !_sortCategoryAsc;
        ApplyFilter();
    }

    private async Task OnIssueClick(ProjectIssue issue)
    {
        if (!string.IsNullOrEmpty(issue.NavigationTarget))
            await OnNavigate.InvokeAsync(issue.NavigationTarget);
    }

    /// <summary>Get counts for external display (e.g. panel badge).</summary>
    public (int errors, int warnings, int info) GetCounts() => (_errorCount, _warningCount, _infoCount);
}
