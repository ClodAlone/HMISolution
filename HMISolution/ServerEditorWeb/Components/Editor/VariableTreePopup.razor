@using SharedModels
@using ServerEditorWeb.Services

<div class="modal-backdrop show" @onclick="Cancel"></div>
<div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 420px;">
        <div class="modal-content vtp-modal">
            <div class="modal-header py-2">
                <h6 class="modal-title">📂 Select Variable</h6>
                <button type="button" class="btn-close btn-close-sm" @onclick="Cancel"></button>
            </div>
            <div class="modal-body p-0">
                <div class="vtp-search">
                    <input type="text" class="form-control form-control-sm" placeholder="Search…"
                           @bind="_search" @bind:event="oninput" />
                </div>
                <div class="vtp-tree">
                    @if (_rootNodes.Count == 0)
                    {
                        <div class="text-muted small p-3">No variables found.</div>
                    }
                    else
                    {
                        @foreach (var node in _rootNodes)
                        {
                            RenderNode(node, 0);
                        }
                    }
                </div>
            </div>
            <div class="modal-footer py-1 px-2">
                <span class="small text-muted flex-grow-1 text-truncate">@(_selectedPath ?? "No selection")</span>
                <button class="btn btn-sm btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-sm btn-primary" disabled="@(string.IsNullOrEmpty(_selectedPath))" @onclick="Confirm">OK</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? CurrentValue { get; set; }
    [Parameter] public EventCallback<string?> OnSelect { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    [Inject] private NodeEditorService Editor { get; set; } = default!;

    private string _search = "";
    private string? _selectedPath;
    private List<VtpNode> _rootNodes = new();
    private List<VtpNode> _allNodes = new();

    protected override void OnInitialized()
    {
        _selectedPath = CurrentValue;
        BuildTree();
    }

    private void BuildTree()
    {
        _rootNodes.Clear();
        _allNodes.Clear();

        var root = Editor.RootModel?.Folder;
        if (root != null)
        {
            foreach (var sub in root.Folders)
            {
                var node = BuildFolderNode(sub, root.Name);
                _rootNodes.Add(node);
            }
            foreach (var v in root.Variables)
            {
                var path = string.IsNullOrEmpty(root.Name) ? v.Name : $"{root.Name}.{v.Name}";
                var vn = new VtpNode { Name = v.Name, Path = path, Type = v.Type, IsFolder = false };
                _rootNodes.Add(vn);
                _allNodes.Add(vn);
            }
        }

        // Add calculated variables
        var calcVars = Editor.RootModel?.CalculatedVariables;
        if (calcVars != null)
        {
            var calcFolders = new Dictionary<string, VtpNode>();
            foreach (var cv in calcVars)
            {
                if (!cv.Enabled || string.IsNullOrWhiteSpace(cv.Name)) continue;
                var folder = string.IsNullOrWhiteSpace(cv.FolderPath) ? "_Calculated" : cv.FolderPath;
                if (!calcFolders.TryGetValue(folder, out var fn))
                {
                    fn = new VtpNode { Name = folder, Path = folder, IsFolder = true, IsExpanded = false };
                    calcFolders[folder] = fn;
                    _rootNodes.Add(fn);
                    _allNodes.Add(fn);
                }
                var fullPath = $"{folder}.{cv.Name}";
                var vn = new VtpNode { Name = cv.Name, Path = fullPath, Type = cv.Type, IsFolder = false };
                fn.Children.Add(vn);
                _allNodes.Add(vn);
            }
        }

        // Auto-expand to current selection
        if (!string.IsNullOrEmpty(CurrentValue))
        {
            ExpandToPath(_rootNodes, CurrentValue);
        }
    }

    private VtpNode BuildFolderNode(Folder folder, string parentPath)
    {
        var path = string.IsNullOrEmpty(parentPath) ? folder.Name : $"{parentPath}.{folder.Name}";
        var node = new VtpNode { Name = folder.Name, Path = path, IsFolder = true, IsExpanded = false };
        _allNodes.Add(node);

        foreach (var sub in folder.Folders)
        {
            node.Children.Add(BuildFolderNode(sub, path));
        }
        foreach (var v in folder.Variables)
        {
            var vn = new VtpNode { Name = v.Name, Path = $"{path}.{v.Name}", Type = v.Type, IsFolder = false };
            node.Children.Add(vn);
            _allNodes.Add(vn);
        }
        return node;
    }

    private bool ExpandToPath(List<VtpNode> nodes, string path)
    {
        foreach (var n in nodes)
        {
            if (!n.IsFolder) continue;
            if (path.StartsWith(n.Path + ".", StringComparison.OrdinalIgnoreCase) || path.Equals(n.Path, StringComparison.OrdinalIgnoreCase))
            {
                n.IsExpanded = true;
                ExpandToPath(n.Children, path);
                return true;
            }
        }
        return false;
    }

    private bool MatchesSearch(VtpNode node)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        if (node.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            node.Path.Contains(_search, StringComparison.OrdinalIgnoreCase))
            return true;
        // Show folder if any child matches
        if (node.IsFolder)
            return node.Children.Any(c => MatchesSearch(c));
        return false;
    }

    private void RenderNode(VtpNode node, int depth)
    {
        if (!MatchesSearch(node)) return;

        var indent = depth * 16;
        var isSelected = node.Path == _selectedPath;
        var searchActive = !string.IsNullOrWhiteSpace(_search);

        if (node.IsFolder)
        {
            <div class="vtp-row @(isSelected ? "vtp-row-sel" : "")" style="padding-left: @(indent)px;"
                 @onclick="() => ToggleFolder(node)">
                <span class="vtp-expand">@(node.IsExpanded || searchActive ? "▾" : "▸")</span>
                <span class="vtp-icon">📁</span>
                <span class="vtp-name">@node.Name</span>
            </div>
            if (node.IsExpanded || searchActive)
            {
                foreach (var child in node.Children)
                {
                    RenderNode(child, depth + 1);
                }
            }
        }
        else
        {
            <div class="vtp-row vtp-var @(isSelected ? "vtp-row-sel" : "")" style="padding-left: @(indent + 16)px;"
                 @onclick="() => SelectVariable(node)"
                 @ondblclick="() => DoubleClickVariable(node)">
                <span class="vtp-icon">📊</span>
                <span class="vtp-name">@node.Name</span>
                <span class="vtp-type">@node.Type</span>
            </div>
        }
    }

    private void ToggleFolder(VtpNode node)
    {
        node.IsExpanded = !node.IsExpanded;
    }

    private void SelectVariable(VtpNode node)
    {
        _selectedPath = node.Path;
    }

    private async Task DoubleClickVariable(VtpNode node)
    {
        _selectedPath = node.Path;
        await OnSelect.InvokeAsync(_selectedPath);
    }

    private async Task Confirm()
    {
        await OnSelect.InvokeAsync(_selectedPath);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    private class VtpNode
    {
        public string Name { get; set; } = "";
        public string Path { get; set; } = "";
        public string Type { get; set; } = "";
        public bool IsFolder { get; set; }
        public bool IsExpanded { get; set; }
        public List<VtpNode> Children { get; set; } = new();
    }
}
