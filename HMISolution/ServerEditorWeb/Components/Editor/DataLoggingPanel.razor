@using ServerEditorWeb.Services
@using SharedModels

<div class="datalogging-panel">
    @if (!_hasDbConfig)
    {
        <div class="alert alert-info mb-0">
            <strong>Data Logging not configured</strong>
            <p class="mb-0 small mt-1">To enable data logging, open the <strong>Server Settings</strong> panel and configure a Database provider (Sqlite or TimescaleDb).</p>
        </div>
    }
    else if (_loggedVariables.Count == 0)
    {
        <div class="alert alert-warning mb-0">
            <strong>No variables with DataLogging enabled</strong>
            <p class="mb-0 small mt-1">Select a variable in the project tree, then enable <strong>DataLogging</strong> in the Properties panel to start recording history.</p>
        </div>
    }
    else
    {
        @if (_connInfo == null && _hasDbConfig)
        {
            <div class="alert alert-secondary mb-2 py-2">
                <small>The database file has not been created yet. Start the server to begin recording data.</small>
            </div>
        }

        @* Variable selector + controls *@
        <div class="d-flex gap-2 mb-2 align-items-center flex-wrap">
            <select class="form-select form-select-sm" style="max-width: 350px;" @bind="_selectedVariable">
                <option value="">-- Select a variable --</option>
                @foreach (var v in _loggedVariables)
                {
                    <option value="@v">@v</option>
                }
            </select>

            <select class="form-select form-select-sm" style="max-width: 140px;" @bind="_timeRange">
                <option value="5">Last 5 min</option>
                <option value="15">Last 15 min</option>
                <option value="60">Last 1 hour</option>
                <option value="360">Last 6 hours</option>
                <option value="1440">Last 24 hours</option>
                <option value="0">All time</option>
            </select>

            <input type="number" class="form-control form-control-sm" style="max-width: 100px;"
                   placeholder="Max rows" @bind="_maxRows" title="Max rows to load" />

            <button class="btn btn-sm btn-primary" @onclick="LoadData" disabled="@(string.IsNullOrEmpty(_selectedVariable) || _loading || _connInfo == null)">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Load
            </button>

            <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh" disabled="@(string.IsNullOrEmpty(_selectedVariable) || _loading)"
                    title="Refresh">Refresh</button>
        </div>

        @* Stats *@
        @if (_stats.count > 0)
        {
            <div class="d-flex gap-3 mb-2 small text-muted align-items-center">
                <span class="badge @(_connInfo!.Provider == "Sqlite" ? "bg-secondary" : "bg-info text-dark")">@_connInfo.Provider</span>
                <span><strong>@_stats.count</strong> total records</span>
                @if (_stats.oldest.HasValue)
                {
                    <span>Oldest: <strong>@_stats.oldest.Value.ToLocalTime().ToString("g")</strong></span>
                }
                @if (_stats.newest.HasValue)
                {
                    <span>Newest: <strong>@_stats.newest.Value.ToLocalTime().ToString("g")</strong></span>
                }
                <span>Showing <strong>@_entries.Count</strong> rows</span>
            </div>
        }

        @* Data table *@
        <div class="datalogging-table-wrap">
            <table class="table table-sm table-striped table-hover mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width: 200px;">Timestamp</th>
                        <th>Value</th>
                        <th style="width: 80px;">Quality</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_entries.Count == 0 && !_loading)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">
                                @if (string.IsNullOrEmpty(_selectedVariable))
                                {
                                    <text>Select a variable and click Load</text>
                                }
                                else
                                {
                                    <text>No data found for the selected time range</text>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var entry in _entries)
                    {
                        <tr>
                            <td class="text-nowrap font-monospace small">@entry.Time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                            <td class="font-monospace"><strong>@entry.DisplayValue</strong></td>
                            <td>
                                @if (entry.Quality == 0)
                                {
                                    <span class="badge bg-success">Good</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@entry.Quality</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public string NodesPath { get; set; } = "";

    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private DataLoggingReaderService Reader { get; set; } = default!;

    private List<string> _loggedVariables = [];
    private List<DataLogEntry> _entries = [];
    private string _selectedVariable = "";
    private int _timeRange = 60;
    private int _maxRows = 500;
    private bool _loading;
    private bool _hasDbConfig;
    private DataLogConnectionInfo? _connInfo;
    private (int count, DateTime? oldest, DateTime? newest) _stats;

    protected override void OnParametersSet()
    {
        RefreshVariableList();
    }

    private void RefreshVariableList()
    {
        var model = Editor.RootModel;
        _loggedVariables = Reader.GetLoggedVariables(model);

        _hasDbConfig = model?.Database != null
            && !string.IsNullOrEmpty(model.Database.Provider);

        _connInfo = Reader.ResolveConnection(model?.Database,
            string.IsNullOrEmpty(NodesPath) ? Editor.CurrentFilePath : NodesPath);

        if (!string.IsNullOrEmpty(_selectedVariable) && !_loggedVariables.Contains(_selectedVariable))
        {
            _selectedVariable = "";
            _entries.Clear();
            _stats = default;
        }
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(_selectedVariable) || _connInfo == null)
            return;

        _loading = true;
        StateHasChanged();

        try
        {
            var endTime = DateTime.UtcNow;
            var startTime = _timeRange > 0 ? endTime.AddMinutes(-_timeRange) : DateTime.MinValue;

            var connInfo = _connInfo;
            var variable = _selectedVariable;
            var maxRows = _maxRows;

            var (entries, stats) = await Task.Run(() =>
            {
                var e = Reader.ReadHistory(connInfo, variable, startTime, endTime, maxRows);
                var s = Reader.GetVariableStats(connInfo, variable);
                return (e, s);
            });

            _entries = entries;
            _stats = stats;
        }
        catch (Exception ex)
        {
            _entries.Clear();
            _stats = (0, null, null);
            System.Diagnostics.Debug.WriteLine($"DataLogging read error: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Refresh()
    {
        RefreshVariableList();
        if (!string.IsNullOrEmpty(_selectedVariable))
            await LoadData();
    }
}
