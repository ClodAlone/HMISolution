        private async Task ScrollToSymbolAsync(ScreenSymbol sym)
    {
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.querySelector('.screen-canvas-wrap')?.scrollTo({{ left: {F(Math.Max(0, sym.X - 60))}, top: {F(Math.Max(0, sym.Y - 60))}, behavior: 'smooth' }})");
        }
        catch { /* ignore if JS not available */ }
    }
private void DeleteSelected()
    {
        var screen = GetScreen();
        if (screen == null) return;

        if (_selectedSymbols.Count > 0)
        {
            var removed = _selectedSymbols.ToList();
            var indices = removed.Select(s => screen.Symbols.IndexOf(s)).ToList();
            foreach (var sym in removed)
                screen.Symbols.Remove(sym);

            UndoRedo.RecordAction(new CollectionAction
            {
                Description = removed.Count == 1 ? "Delete symbol" : $"Delete {removed.Count} symbols",
                UndoCallback = () =>
                {
                    for (int i = 0; i < removed.Count; i++)
                    {
                        var idx = Math.Min(indices[i], screen.Symbols.Count);
                        screen.Symbols.Insert(idx, removed[i]);
                    }
                },
                RedoCallback = () =>
                {
                    foreach (var sym in removed)
                        screen.Symbols.Remove(sym);
                }
            });

            _selectedSymbols.Clear();
            _selectedSymbol = null;
            NotifySelectionChanged();
            OnChanged();
        }
    }

    /// <summary>Called from the keyboard Delete shortcut via Home.razor.</summary>
    public void DeleteSelectedFromKeyboard()
    {
        DeleteSelected();
        StateHasChanged();
    }

    private void CopySelectedSymbols()
    {
