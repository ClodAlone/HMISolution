    // ─── Smart Snap: compute alignment guide lines ──────────
    private void ComputeSmartSnapGuides(ScreenConfig screen)
    {
        var sel = _selectedSymbol!;
        var selLeft = sel.X;
        var selRight = sel.X + sel.Width;
        var selTop = sel.Y;
        var selBottom = sel.Y + sel.Height;
        var selCx = sel.X + sel.Width / 2.0;
        var selCy = sel.Y + sel.Height / 2.0;

        foreach (var other in screen.Symbols)
        {
            if (_selectedSymbols.Contains(other)) continue;
            var oLeft = other.X;
            var oRight = other.X + other.Width;
            var oTop = other.Y;
            var oBottom = other.Y + other.Height;
            var oCx = other.X + other.Width / 2.0;
            var oCy = other.Y + other.Height / 2.0;

            // Vertical guides (match X positions)
            TrySnapX(ref selLeft, oLeft, screen.Height, selLeft);
            TrySnapX(ref selLeft, oRight, screen.Height, selLeft);
            TrySnapX(ref selRight, oLeft, screen.Height, selRight);
            TrySnapX(ref selRight, oRight, screen.Height, selRight);
            TrySnapX(ref selCx, oCx, screen.Height, selCx);

            // Horizontal guides (match Y positions)
            TrySnapY(ref selTop, oTop, screen.Width, selTop);
            TrySnapY(ref selTop, oBottom, screen.Width, selTop);
            TrySnapY(ref selBottom, oTop, screen.Width, selBottom);
            TrySnapY(ref selBottom, oBottom, screen.Width, selBottom);
            TrySnapY(ref selCy, oCy, screen.Width, selCy);
        }
    }

    private void TrySnapX(ref double selEdge, double targetEdge, double canvasH, double origEdge)
    {
        if (Math.Abs(selEdge - targetEdge) < SmartSnapThreshold)
        {
            var offset = targetEdge - origEdge;
            foreach (var s in _selectedSymbols) s.X += offset;
            _snapGuides.Add((targetEdge, 0, targetEdge, canvasH));
        }
    }

    private void TrySnapY(ref double selEdge, double targetEdge, double canvasW, double origEdge)
    {
        if (Math.Abs(selEdge - targetEdge) < SmartSnapThreshold)
        {
            var offset = targetEdge - origEdge;
            foreach (var s in _selectedSymbols) s.Y += offset;
            _snapGuides.Add((0, targetEdge, canvasW, targetEdge));
        }
    }

    // ─── Distribute to Columns ──────────────────────────────
    private void ApplyDistributeToColumns()
    {
        _showDistributeDialog = false;
        var screen = GetScreen();
        if (screen == null || _selectedSymbols.Count < 2) return;

        CaptureSnapshots(_selectedSymbols);
        var cols = Math.Max(1, _distributeColumns);
        var sorted = _selectedSymbols.OrderBy(s => s.Y).ThenBy(s => s.X).ToList();

        // Use the top-left of the bounding box as the start position
        var startX = sorted.Min(s => s.X);
        var startY = sorted.Min(s => s.Y);
        var maxW = sorted.Max(s => s.Width);
        var maxH = sorted.Max(s => s.Height);
        var cellW = maxW + _distributeGapX;
        var cellH = maxH + _distributeGapY;

        for (int i = 0; i < sorted.Count; i++)
        {
            var col = i % cols;
            var row = i / cols;
            sorted[i].X = startX + col * cellW;
            sorted[i].Y = startY + row * cellH;
        }
        RecordSnapshotUndo("Distribute symbols");
        OnChanged();
    }

