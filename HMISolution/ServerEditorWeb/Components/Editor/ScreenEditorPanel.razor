    private void PasteSymbols()
    {
        var screen = GetScreen();
        if (screen == null || !Clipboard.CanPasteSymbols) return;

        var symbols = Clipboard.PasteSymbols();
        if (symbols == null || symbols.Count == 0) return;

        var newSelection = new List<ScreenSymbol>();
        var groupMapping = new Dictionary<string, string>();

        foreach (var src in symbols)
        {
            string? newGroupId = null;
            if (!string.IsNullOrEmpty(src.GroupId))
            {
                if (!groupMapping.ContainsKey(src.GroupId))
                    groupMapping[src.GroupId] = $"grp_{_nextGroupId++}";
                newGroupId = groupMapping[src.GroupId];
            }

            var pasted = new ScreenSymbol
            {
                Id = $"sym_{_nextId++}",
                Type = src.Type,
                X = src.X + 20,
                Y = src.Y + 20,
                Width = src.Width,
                Height = src.Height,
                Fill = src.Fill,
                Stroke = src.Stroke,
                StrokeWidth = src.StrokeWidth,
                Label = src.Label,
                Rotation = src.Rotation,
                SvgContent = src.SvgContent,
                GroupId = newGroupId,
                Animations = src.Animations.Select(a => new SymbolAnimation
                {
                    Id = $"anim_{_nextAnimId++}",
                    Name = a.Name,
                    Enabled = a.Enabled,
                    Property = a.Property,
                    Trigger = a.Trigger,
                    TriggerVariable = a.TriggerVariable,
                    TriggerCondition = a.TriggerCondition,
                    Keyframes = a.Keyframes.Select(k => new AnimationKeyframe
                    {
                        Percent = k.Percent,
                        Value = k.Value,
                        Easing = k.Easing
                    }).ToList(),
                    DurationMs = a.DurationMs,
                    DelayMs = a.DelayMs,
                    Easing = a.Easing,
                    RepeatCount = a.RepeatCount,
                    AutoReverse = a.AutoReverse
                }).ToList(),
                VariablePath = src.VariablePath,
                FillBinding = src.FillBinding,
                VisibilityBinding = src.VisibilityBinding,
                RotationBinding = src.RotationBinding,
                LabelBinding = src.LabelBinding,
                MinValue = src.MinValue,
                MaxValue = src.MaxValue
            };
            screen.Symbols.Add(pasted);
            newSelection.Add(pasted);
        }

        UndoRedo.RecordAction(new CollectionAction
        {
            Description = $"Paste {newSelection.Count} symbol(s)",
            UndoCallback = () => { foreach (var s in newSelection) screen.Symbols.Remove(s); },
            RedoCallback = () => { foreach (var s in newSelection) screen.Symbols.Add(s); }
        });

        _selectedSymbols = new HashSet<ScreenSymbol>(newSelection);
        _selectedSymbol = newSelection.First();
        NotifySelectionChanged();
        OnChanged();
    }

