@using ServerEditorWeb.Models
@using ServerEditorWeb.Services
@using SharedModels
@using Microsoft.JSInterop
@implements IDisposable

<div class="screen-editor-panel">
    @if (GetScreen() is not ScreenConfig screen)
    {
        <p class="text-muted p-2">Select a Screen node in the tree to open the screen editor.</p>
    }
    else if (screen.LayoutMode == "responsive")
    {
        <ResponsiveScreenEditorPanel Node="Node" OnPropertyChanged="OnPropertyChanged" />
    }
    else
    {
        @* Toolbar *@
        <div class="screen-toolbar">
            <div class="d-flex gap-1 align-items-center flex-wrap">
                <span class="small fw-bold me-2">@screen.Name</span>

                

                @if (_selectedSymbols.Count > 1)
                {
                    <span class="badge bg-primary me-1" style="font-size: 10px;">@_selectedSymbols.Count selected</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected" title="Delete All Selected">🗑</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopySelectedSymbols" title="Copy (Ctrl+C)">📋 Copy</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PasteSymbols" title="Paste (Ctrl+V)" disabled="@(!Clipboard.CanPasteSymbols)">📌 Paste</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected" title="Duplicate All">⧉ Dup</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(-90)" title="Rotate Left 90°">↺</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(90)" title="Rotate Right 90°">↻</button>
                    <span class="mx-1">|</span>
                    <button class="btn btn-sm btn-outline-success" @onclick="GroupSelected" title="Group selected symbols">🔗 Group</button>
                    @if (_selectedSymbols.Any(s => !string.IsNullOrEmpty(s.GroupId)))
                    {
                        <button class="btn btn-sm btn-outline-warning" @onclick="UngroupSelected" title="Ungroup selected symbols">✂ Ungroup</button>
                    }
                }
                else if (_selectedSymbol != null)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected" title="Delete">🗑</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopySelectedSymbols" title="Copy (Ctrl+C)">📋 Copy</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PasteSymbols" title="Paste (Ctrl+V)" disabled="@(!Clipboard.CanPasteSymbols)">📌 Paste</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected" title="Duplicate">⧉ Dup</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(-90)" title="Rotate Left 90°">↺</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(90)" title="Rotate Right 90°">↻</button>
                    @if (!string.IsNullOrEmpty(_selectedSymbol.GroupId))
                    {
                        <span class="mx-1">|</span>
                        <button class="btn btn-sm btn-outline-warning" @onclick="UngroupSelected" title="Ungroup">✂ Ungroup</button>
                    }
                }

                @if (_selectedSymbols.Count == 0 && Clipboard.CanPasteSymbols)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PasteSymbols" title="Paste (Ctrl+V)">📌 Paste</button>
                }

                <span class="mx-1">|</span>

                <label class="form-label mb-0 small">W:</label>
                <input type="number" class="form-control form-control-sm" style="width: 60px;" @bind="screen.Width" @bind:after="OnChanged" />
                <label class="form-label mb-0 small">H:</label>
                <input type="number" class="form-control form-control-sm" style="width: 60px;" @bind="screen.Height" @bind:after="OnChanged" />
                <label class="form-label mb-0 small">BG:</label>
                <input type="color" class="form-control form-control-sm form-control-color" style="width: 35px; height: 28px;"
                       @bind="screen.Background" @bind:after="OnChanged" />
                <label class="form-label mb-0 small">BG Image:</label>
                <InputFile OnChange="(e) => OnBackgroundImageSelected(e, screen)" accept="image/*"
                           class="form-control form-control-sm" style="width: 130px; font-size: 10px;" />
                @if (!string.IsNullOrEmpty(screen.BackgroundImage))
                {
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 10px;"
                            @onclick="() => { screen.BackgroundImage = string.Empty; OnChanged(); }" title="Remove background image">✕</button>
                }

                <span class="mx-1">|</span>
                <button class="btn btn-sm @(screen.ShowGrid ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => { screen.ShowGrid = !screen.ShowGrid; OnChanged(); }" title="Toggle Grid">
                    ⊞ Grid
                </button>
                @if (screen.ShowGrid)
                {
                    <input type="number" class="form-control form-control-sm" style="width: 50px;" min="5" max="100"
                           @bind="screen.EditorGridSize" @bind:after="OnChanged" title="Grid size (px)" />
                }
                <button class="btn btn-sm @(screen.SnapToGrid ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => { screen.SnapToGrid = !screen.SnapToGrid; OnChanged(); }" title="Snap to Grid">
                    🧲 Snap
                </button>
                <button class="btn btn-sm @(screen.SmartSnap ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => { screen.SmartSnap = !screen.SmartSnap; OnChanged(); }" title="Smart Snap (align to other objects)">
                    📏 Smart
                </button>

                @if (_selectedSymbols.Count > 1)
                {
                    <span class="mx-1">|</span>
                    <button class="btn btn-sm btn-outline-info" @onclick="() => _showDistributeDialog = true" title="Distribute selected symbols into columns">
                        🔲 Distribute
                    </button>
                }

                <span class="ms-auto small text-muted">Symbols: @screen.Symbols.Count</span>

                <span class="mx-1">|</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => SwitchToResponsive(screen)" title="Switch to responsive HTML layout">
                    📐 Responsive
                </button>
            </div>
        </div>

        <div class="screen-editor-body">
            @* SVG Canvas *@
            <div class="screen-canvas-wrap">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="@screen.Width" height="@screen.Height"
                     class="screen-canvas"
                     style="background: @screen.Background; font-family: sans-serif;"
                     @onmousedown="OnCanvasMouseDown"
                     @onmousemove="OnCanvasMouseMove"
                     @onmouseup="OnCanvasMouseUp">

                    @if (!string.IsNullOrEmpty(screen.BackgroundImage))
                    {
                        <image href="@screen.BackgroundImage" x="0" y="0"
                               width="@screen.Width" height="@screen.Height"
                               preserveAspectRatio="xMidYMid slice" />
                    }

                    @* ── Editor grid overlay ── *@
                    @if (screen.ShowGrid)
                    {
                        var gs = Math.Max(5, screen.EditorGridSize);
                        <defs>
                            <pattern id="editor-grid" width="@gs" height="@gs" patternUnits="userSpaceOnUse">
                                <path d="M @gs 0 L 0 0 0 @gs" fill="none" stroke="rgba(0,0,0,0.10)" stroke-width="0.5" />
                            </pattern>
                        </defs>
                        <rect width="@screen.Width" height="@screen.Height" fill="url(#editor-grid)" pointer-events="none" />
                    }

                    @foreach (var sym in screen.Symbols)
                    {
                        var isSelected = _selectedSymbols.Contains(sym);
                        var liveValue = GetLiveValue(sym);
                        var fillColor = EvalFillBinding(sym, liveValue);
                        var visible = EvalVisibilityBinding(sym, liveValue);
                        var rotation = EvalRotationBinding(sym, liveValue);
                        var labelText = EvalLabelBinding(sym, liveValue);

                        if (!visible) continue;

                        <g transform="translate(@sym.X, @sym.Y) rotate(@rotation.ToString("F1"), @((sym.Width / 2).ToString("F1")), @((sym.Height / 2).ToString("F1")))"
                           @onmousedown="(e) => OnSymbolMouseDown(e, sym)" @onmousedown:stopPropagation
                           class="screen-symbol @(isSelected ? "selected" : "")"
                           style="cursor: move; @SymbolFontStyle(sym)">

                            @switch (sym.Type)
                            {
                                case "rect":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="3" />
                                    break;
                                case "circle":
                                    var r = Math.Min(sym.Width, sym.Height) / 2;
                                    <circle cx="@(sym.Width / 2)" cy="@(sym.Height / 2)" r="@r"
                                            fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    break;
                                case "ellipse":
                                    <ellipse cx="@(sym.Width / 2)" cy="@(sym.Height / 2)"
                                             rx="@(sym.Width / 2)" ry="@(sym.Height / 2)"
                                             fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    break;
                                case "text":
                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 5, "middle", "middle", fillColor, 14, labelText ?? sym.Label, sym)
                                    break;
                                case "line":
                                    <line x1="0" y1="@sym.Height" x2="@sym.Width" y2="0"
                                          stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    break;
                                case "gauge":
                                    @RenderGauge(sym, fillColor, liveValue)
                                    break;
                                case "indicator":
                                    <circle cx="@(sym.Width / 2)" cy="@(sym.Height / 2)"
                                            r="@(Math.Min(sym.Width, sym.Height) / 2 - 2)"
                                            fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 4, "middle", "middle", "white", 10, labelText ?? sym.Label, sym)
                                    break;
                                case "svg":
                                    @if (!string.IsNullOrEmpty(sym.SvgContent))
                                    {
                                        @RenderLibrarySvg(sym)
                                    }
                                    break;
                                case "alarmlist":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#1a1a2e" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", 11, "🔔 Alarm List")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#333" stroke-width="1" />
                                    @RenderSvgText(sym.Width / 2, 40, "middle", "middle", "#888", 9, "(live alarms displayed at runtime)")
                                    break;
                                case "hdachart":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#111827" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", 11, "📊 HDA Chart")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#374151" stroke-width="1" />
                                    <line x1="40" y1="32" x2="40" y2="@(sym.Height - 20)" stroke="#374151" stroke-width="1" />
                                    <line x1="40" y1="@(sym.Height - 20)" x2="@(sym.Width - 10)" y2="@(sym.Height - 20)" stroke="#374151" stroke-width="1" />
                                    <polyline points="@BuildFakeHdaPolyline(sym)" fill="none" stroke="#3b82f6" stroke-width="1.5" />
                                    @if (sym.HdaVariablePaths.Count > 0)
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", 8, string.Join(", ", sym.HdaVariablePaths.Take(3)))
                                    }
                                    else
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", 8, "(configure variables in properties)")
                                    }
                                    break;
                                case "hdagrid":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#111827" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", 11, "📋 HDA Data Grid")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#374151" stroke-width="1" />
                                    @* Fake table header row *@
                                    <rect x="8" y="32" width="@(sym.Width - 16)" height="14" fill="#0f172a" rx="1" />
                                    @RenderSvgText(40, 42, "start", "middle", "#9ca3af", 7, "Timestamp")
                                    @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#9ca3af", 7, "Variable 1")
                                    @RenderSvgText(sym.Width - 40, 42, "end", "middle", "#9ca3af", 7, "Variable 2")
                                    @* Fake data rows *@
                                    @for (int row = 0; row < 4 && row * 13 + 50 < sym.Height - 20; row++)
                                    {
                                        var ry = 50 + row * 13;
                                        <line x1="8" y1="@ry" x2="@(sym.Width - 8)" y2="@ry" stroke="#1f2937" stroke-width="0.5" />
                                        @RenderSvgText(40, ry + 9, "start", "middle", "#6b7280", 7, "00:00:00.000")
                                        @RenderSvgText(sym.Width / 2, ry + 9, "middle", "middle", "#d1d5db", 7, "12.345")
                                        @RenderSvgText(sym.Width - 40, ry + 9, "end", "middle", "#d1d5db", 7, "67.890")
                                    }
                                    @if (sym.HdaVariablePaths.Count > 0)
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", 8, string.Join(", ", sym.HdaVariablePaths.Take(3)))
                                    }
                                    else
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", 8, "(configure variables in properties)")
                                    }
                                    break;
                                case "eventlog":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#0f172a" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e2e8f0", ScaledFontSize(11, sym), "📓 Event Log")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                    @* Fake table header *@
                                    <rect x="8" y="32" width="@(sym.Width - 16)" height="14" fill="#1e293b" rx="1" />
                                    @RenderSvgText(30, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Time")
                                    @RenderSvgText(100, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Category")
                                    @RenderSvgText(160, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Severity")
                                    @RenderSvgText(220, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Source")
                                    @RenderSvgText(sym.Width - 40, 42, "end", "middle", "#94a3b8", ScaledFontSize(7, sym), "Message")
                                    @* Fake data rows *@
                                    @RenderEventLogPreviewRows(sym)
                                    @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(8, sym),
                                        string.IsNullOrEmpty(sym.EventLogCategories) ? "All categories" : sym.EventLogCategories)
                                    break;
                                case "editbox":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#1e293b" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @* Simulated text input area *@
                                    <rect x="3" y="3" width="@(sym.Width - (sym.Height > 24 ? 28 : 6))" height="@(sym.Height - 6)"
                                          fill="#0f172a" rx="2" />
                                    @RenderSvgText(10, sym.Height / 2 + 1, "start", "middle", "#94a3b8", 10,
                                        !string.IsNullOrEmpty(sym.VariablePath) ? "42.5" : "—")
                                    @* Spin buttons *@
                                    @if (sym.Height > 24)
                                    {
                                        var bx = sym.Width - 24;
                                        <rect x="@bx" y="3" width="21" height="@((sym.Height - 6) / 2 - 1)" fill="#334155" rx="2" />
                                        @RenderSvgText(bx + 10.5, sym.Height * 0.25 + 1, "middle", "middle", "#94a3b8", 7, "▲")
                                        <rect x="@bx" y="@(sym.Height / 2 + 1)" width="21" height="@((sym.Height - 6) / 2 - 1)" fill="#334155" rx="2" />
                                        @RenderSvgText(bx + 10.5, sym.Height * 0.75, "middle", "middle", "#94a3b8", 7, "▼")
                                    }
                                    @if (!string.IsNullOrEmpty(sym.VariablePath))
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#6b7280", 7, sym.VariablePath)
                                    }
                                    else
                                    {
                                            @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#ef4444", 7, "(set VariablePath)")
                                            }
                                            break;
                                        case "ipcamera":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#0a0a0a" stroke="#475569" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @* Camera icon *@
                                            @RenderSvgText(sym.Width / 2, sym.Height / 2 - 8, "middle", "middle", "#4b5563", 28, "📷")
                                            @if (sym.Camera != null && !string.IsNullOrEmpty(sym.Camera.CameraId))
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 16, "middle", "middle", "#9ca3af", 10, sym.Camera.CameraId)
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 28, "middle", "middle", "#6b7280", 8,
                                                    sym.Camera.Protocol.ToUpperInvariant() + (sym.Camera.EnableYolo ? " + YOLO" : ""))
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 18, "middle", "middle", "#ef4444", 8, "(configure camera)")
                                            }
                                            break;
                                        case "recipe":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#1a1a2e" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", 11, "📦 Recipe")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @if (!string.IsNullOrEmpty(sym.RecipeName))
                                            {
                                                @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#6ee7b7", 10, sym.RecipeName)
                                                @* Fake action buttons preview *@
                                                <rect x="8" y="54" width="@((sym.Width - 24) / 4)" height="16" fill="#1e40af" rx="2" />
                                                @RenderSvgText(8 + (sym.Width - 24) / 8, 63, "middle", "middle", "#e2e8f0", 7, "Load")
                                                <rect x="@(12 + (sym.Width - 24) / 4)" y="54" width="@((sym.Width - 24) / 4)" height="16" fill="#065f46" rx="2" />
                                                @RenderSvgText(12 + (sym.Width - 24) * 3 / 8, 63, "middle", "middle", "#e2e8f0", 7, "Save")
                                                <rect x="@(16 + (sym.Width - 24) / 2)" y="54" width="@((sym.Width - 24) / 4)" height="16" fill="#7c3aed" rx="2" />
                                                @RenderSvgText(16 + (sym.Width - 24) * 5 / 8, 63, "middle", "middle", "#e2e8f0", 7, "Activate")
                                                @RenderSvgText(sym.Width / 2, sym.Height - 8, "middle", null, "#475569", 8, "(live recipe control at runtime)")
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 6, "middle", "middle", "#ef4444", 8, "(set RecipeName)")
                                            }
                                            break;
                                        case "screenembed":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#0f172a" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", 11, "🪟 Screen Embed")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @if (sym.EmbeddedScreens.Count > 0)
                                            {
                                                @if (sym.EmbeddedScreens.Count == 1)
                                                {
                                                    @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#38bdf8", 10, sym.EmbeddedScreens[0])
                                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 10, "middle", "middle", "#475569", 9, "(embedded at runtime)")
                                                }
                                                else
                                                {
                                                    @* Preview tabs *@
                                                    var tabW = Math.Min(80.0, (sym.Width - 8) / sym.EmbeddedScreens.Count);
                                                    @for (var ti = 0; ti < Math.Min(sym.EmbeddedScreens.Count, 6); ti++)
                                                    {
                                                        var tx = 4 + ti * tabW;
                                                        var isFirst = ti == 0;
                                                        <rect x="@((int)tx)" y="30" width="@((int)(tabW - 2))" height="16" fill="@(isFirst ? "#1e40af" : "#1e293b")" rx="2" />
                                                        @RenderSvgText(tx + tabW / 2 - 1, 39, "middle", "middle", isFirst ? "#e2e8f0" : "#64748b", 7, sym.EmbeddedScreens[ti].Length > 10 ? sym.EmbeddedScreens[ti][..10] + "…" : sym.EmbeddedScreens[ti])
                                                    }
                                                    @if (sym.EmbeddedScreens.Count > 6)
                                                    {
                                                        @RenderSvgText(sym.Width - 10, 39, "end", "middle", "#64748b", 7, $"+{sym.EmbeddedScreens.Count - 6}")
                                                    }
                                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 14, "middle", "middle", "#475569", 9, $"{sym.EmbeddedScreens.Count} screens — tabbed at runtime")
                                                }
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 6, "middle", "middle", "#ef4444", 8, "(add screens in properties)")
                                            }
                                            break;
                                        case "imagemap":
                                            @if (sym.ImageMapEntries.Count > 0 && !string.IsNullOrEmpty(sym.ImageMapEntries[0].ImageData))
                                            {
                                                <image href="@sym.ImageMapEntries[0].ImageData" x="0" y="0"
                                                       width="@sym.Width" height="@sym.Height"
                                                       preserveAspectRatio="xMidYMid meet" />
                                            }
                                            else
                                            {
                                                <rect width="@sym.Width" height="@sym.Height"
                                                      fill="#1e293b" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 - 8, "middle", "middle", "#64748b", 22, "🖼️")
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 12, "middle", "middle", "#94a3b8", 9, "Image Map")
                                            }
                                            @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#6b7280", 7, $"{sym.ImageMapEntries.Count} image(s)")
                                            break;
                                        case "trend":
                                            var tw = sym.Width - 12;
                                            var tMid = sym.Height / 2 + 4;
                                            var tAmp = (sym.Height - 40) * 0.3;
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="@(sym.TrendBackground ?? "#111827")" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 14, "middle", "middle", "#e0e0e0", 10, "📈 Realtime Trend")
                                            <line x1="4" y1="22" x2="@(sym.Width - 4)" y2="22" stroke="#334155" stroke-width="1" />
                                            <polyline points="@($"6,{tMid} {6 + tw * 0.15},{tMid - tAmp} {6 + tw * 0.3},{tMid + tAmp * 0.5} {6 + tw * 0.5},{tMid - tAmp * 0.7} {6 + tw * 0.7},{tMid + tAmp * 0.3} {6 + tw * 0.85},{tMid - tAmp * 0.4} {6 + tw},{tMid + tAmp * 0.1}")"
                                                       fill="none" stroke="#3b82f6" stroke-width="1.5" />
                                            @if (sym.TrendPens.Count > 1)
                                            {
                                                <polyline points="@($"6,{tMid + 4} {6 + tw * 0.1},{tMid + tAmp * 0.6} {6 + tw * 0.25},{tMid - tAmp * 0.3} {6 + tw * 0.45},{tMid + tAmp * 0.8} {6 + tw * 0.6},{tMid - tAmp * 0.2} {6 + tw * 0.8},{tMid + tAmp * 0.5} {6 + tw},{tMid - tAmp * 0.3}")"
                                                           fill="none" stroke="#ef4444" stroke-width="1.5" />
                                            }
                                            @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", 7, $"{sym.TrendPens.Count} pen(s) · {sym.TrendTimeWindowSeconds}s")
                                            break;
                                        case "lamp":
                                            {
                                                var lmpOn = sym.LampOnColor ?? "#fbbf24";
                                                var lmpGlass = sym.LampGlassColor ?? "#fef3c7";
                                                var lmpBase = sym.LampBaseColor ?? "#78716c";
                                                var lmpCx = sym.Width / 2.0;
                                                var lmpR = Math.Min(sym.Width, sym.Height) * 0.32;
                                                var lmpBaseW = lmpR * 1.1;
                                                var lmpBaseH = sym.Height * 0.22;
                                                var lmpBaseY = sym.Height * 0.68;
                                                <circle cx="@F(lmpCx)" cy="@F(sym.Height*0.4)" r="@F(lmpR)" fill="@lmpGlass" stroke="@lmpOn" stroke-width="1.5" opacity="0.9" />
                                                <circle cx="@F(lmpCx)" cy="@F(sym.Height*0.4)" r="@F(lmpR*0.6)" fill="@lmpOn" opacity="0.6" />
                                                <rect x="@F(lmpCx-lmpBaseW/2)" y="@F(lmpBaseY)" width="@F(lmpBaseW)" height="@F(lmpBaseH)" rx="2" fill="@lmpBase" stroke="#555" stroke-width="0.5" />
                                                <line x1="@F(lmpCx-lmpBaseW/2)" y1="@F(lmpBaseY+lmpBaseH*0.33)" x2="@F(lmpCx+lmpBaseW/2)" y2="@F(lmpBaseY+lmpBaseH*0.33)" stroke="#666" stroke-width="0.5" />
                                                <line x1="@F(lmpCx-lmpBaseW/2)" y1="@F(lmpBaseY+lmpBaseH*0.66)" x2="@F(lmpCx+lmpBaseW/2)" y2="@F(lmpBaseY+lmpBaseH*0.66)" stroke="#666" stroke-width="0.5" />
                                            }
                                            break;
                                        case "light":
                                            {
                                                var ltOn = sym.LightOnColor ?? "#fbbf24";
                                                var ltBody = sym.LightBodyColor ?? "#64748b";
                                                var ltCx = sym.Width / 2.0;
                                                var ltW = sym.Width * 0.5;
                                                var ltH = sym.Height * 0.3;
                                                <rect x="@F(ltCx-ltW/2)" y="0" width="@F(ltW)" height="@F(ltH)" rx="3" fill="@ltBody" stroke="#475569" stroke-width="1" />
                                                <polygon points="@F(ltCx-ltW/2),@F(ltH) @F(ltCx-sym.Width*0.42),@F(sym.Height*0.85) @F(ltCx+sym.Width*0.42),@F(sym.Height*0.85) @F(ltCx+ltW/2),@F(ltH)" fill="@ltOn" opacity="0.25" />
                                                <circle cx="@F(ltCx)" cy="@F(ltH+4)" r="4" fill="@ltOn" opacity="0.9" />
                                            }
                                            break;
                                        case "wire":
                                            {
                                                var wrC = sym.WireEnergizedColor ?? "#ef4444";
                                                var wrThk = sym.WireThickness > 0 ? sym.WireThickness : 3;
                                                var wrOri = sym.WireOrientation ?? "horizontal";
                                                var wrIsCorner = wrOri.StartsWith("corner");
                                                @if (wrIsCorner)
                                                {
                                                    var wrMid = wrThk / 2;
                                                    var wrD = wrOri switch {
                                                        "corner-tl" => $"M {F(sym.Width)},{F(wrMid)} L {F(wrMid)},{F(wrMid)} L {F(wrMid)},{F(sym.Height)}",
                                                        "corner-tr" => $"M 0,{F(wrMid)} L {F(sym.Width-wrMid)},{F(wrMid)} L {F(sym.Width-wrMid)},{F(sym.Height)}",
                                                        "corner-bl" => $"M {F(wrMid)},0 L {F(wrMid)},{F(sym.Height-wrMid)} L {F(sym.Width)},{F(sym.Height-wrMid)}",
                                                        _ => $"M {F(sym.Width-wrMid)},0 L {F(sym.Width-wrMid)},{F(sym.Height-wrMid)} L 0,{F(sym.Height-wrMid)}"
                                                    };
                                                    <path d="@wrD" stroke="@wrC" stroke-width="@F(wrThk)" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                                                }
                                                else if (wrOri == "vertical")
                                                {
                                                    var wrX = sym.Width / 2.0;
                                                    <line x1="@F(wrX)" y1="0" x2="@F(wrX)" y2="@sym.Height" stroke="@wrC" stroke-width="@F(wrThk)" stroke-linecap="round" />
                                                    <circle cx="@F(wrX)" cy="3" r="@F(wrThk*0.8)" fill="@wrC" />
                                                    <circle cx="@F(wrX)" cy="@F(sym.Height-3)" r="@F(wrThk*0.8)" fill="@wrC" />
                                                }
                                                else
                                                {
                                                    var wrY = sym.Height / 2.0;
                                                    <line x1="0" y1="@F(wrY)" x2="@sym.Width" y2="@F(wrY)" stroke="@wrC" stroke-width="@F(wrThk)" stroke-linecap="round" />
                                                    <circle cx="3" cy="@F(wrY)" r="@F(wrThk*0.8)" fill="@wrC" />
                                                    <circle cx="@F(sym.Width-3)" cy="@F(wrY)" r="@F(wrThk*0.8)" fill="@wrC" />
                                                }
                                            }
                                            break;
                                        case "transformer":
                                            {
                                                var tfPri = sym.TransformerPrimaryColor ?? "#3b82f6";
                                                var tfSec = sym.TransformerSecondaryColor ?? "#22c55e";
                                                var tfCore = sym.TransformerCoreColor ?? "#64748b";
                                                var tfIsV = (sym.TransformerOrientation ?? "vertical") == "vertical";
                                                var tfCx = sym.Width / 2.0;
                                                var tfCy = sym.Height / 2.0;
                                                @if (tfIsV) {
                                                    var tfCoilR = Math.Min(sym.Width * 0.35, sym.Height * 0.22);
                                                    <rect x="@F(tfCx-2)" y="@F(tfCy-tfCoilR*0.3)" width="4" height="@F(tfCoilR*0.6)" fill="@tfCore" />
                                                    <circle cx="@F(tfCx)" cy="@F(tfCy-tfCoilR*1.1)" r="@F(tfCoilR)" fill="none" stroke="@tfPri" stroke-width="2.5" />
                                                    <circle cx="@F(tfCx)" cy="@F(tfCy+tfCoilR*1.1)" r="@F(tfCoilR)" fill="none" stroke="@tfSec" stroke-width="2.5" />
                                                    <line x1="@F(tfCx)" y1="0" x2="@F(tfCx)" y2="@F(tfCy-tfCoilR*2.1)" stroke="@tfPri" stroke-width="1.5" />
                                                    <line x1="@F(tfCx)" y1="@F(tfCy+tfCoilR*2.1)" x2="@F(tfCx)" y2="@sym.Height" stroke="@tfSec" stroke-width="1.5" />
                                                } else {
                                                    var tfCoilR = Math.Min(sym.Height * 0.35, sym.Width * 0.22);
                                                    <rect x="@F(tfCx-tfCoilR*0.3)" y="@F(tfCy-2)" width="@F(tfCoilR*0.6)" height="4" fill="@tfCore" />
                                                    <circle cx="@F(tfCx-tfCoilR*1.1)" cy="@F(tfCy)" r="@F(tfCoilR)" fill="none" stroke="@tfPri" stroke-width="2.5" />
                                                    <circle cx="@F(tfCx+tfCoilR*1.1)" cy="@F(tfCy)" r="@F(tfCoilR)" fill="none" stroke="@tfSec" stroke-width="2.5" />
                                                    <line x1="0" y1="@F(tfCy)" x2="@F(tfCx-tfCoilR*2.1)" y2="@F(tfCy)" stroke="@tfPri" stroke-width="1.5" />
                                                    <line x1="@F(tfCx+tfCoilR*2.1)" y1="@F(tfCy)" x2="@sym.Width" y2="@F(tfCy)" stroke="@tfSec" stroke-width="1.5" />
                                                }
                                            }
                                            break;
                                        case "battery":
                                            {
                                                var batCase = sym.BatteryCaseColor ?? "#334155";
                                                var batFull = sym.BatteryFullColor ?? "#22c55e";
                                                var batLow = sym.BatteryLowColor ?? "#ef4444";
                                                var batSegs = sym.BatterySegments > 0 ? sym.BatterySegments : 4;
                                                var batIsV = (sym.BatteryOrientation ?? "vertical") == "vertical";
                                                var batPct = 0.65;
                                                var batFilledSegs = (int)Math.Ceiling(batSegs * batPct);
                                                var batColor = batPct < 0.25 ? batLow : batFull;
                                                @if (batIsV) {
                                                    var batTermW = sym.Width * 0.35;
                                                    var batTermH = 4.0;
                                                    <rect x="@F(sym.Width/2-batTermW/2)" y="0" width="@F(batTermW)" height="@F(batTermH)" rx="1" fill="#94a3b8" />
                                                    <rect x="2" y="@F(batTermH)" width="@F(sym.Width-4)" height="@F(sym.Height-batTermH-2)" rx="3" fill="@batCase" stroke="#475569" stroke-width="1" />
                                                    var batSegH = (sym.Height - batTermH - 8) / batSegs;
                                                    @for (var bi = 0; bi < batSegs; bi++) {
                                                        var bsy = sym.Height - 4 - (bi + 1) * batSegH;
                                                        var bFill = bi < batFilledSegs ? batColor : "#1e293b";
                                                        <rect x="5" y="@F(bsy)" width="@F(sym.Width-10)" height="@F(batSegH-2)" rx="1" fill="@bFill" />
                                                    }
                                                } else {
                                                    var batTermW2 = 4.0;
                                                    var batTermH2 = sym.Height * 0.35;
                                                    <rect x="@F(sym.Width-batTermW2)" y="@F(sym.Height/2-batTermH2/2)" width="@F(batTermW2)" height="@F(batTermH2)" rx="1" fill="#94a3b8" />
                                                    <rect x="0" y="2" width="@F(sym.Width-batTermW2-2)" height="@F(sym.Height-4)" rx="3" fill="@batCase" stroke="#475569" stroke-width="1" />
                                                    var batSegW = (sym.Width - batTermW2 - 8) / batSegs;
                                                    @for (var bi = 0; bi < batSegs; bi++) {
                                                        var bsx = 4 + bi * batSegW;
                                                        var bFill = bi < batFilledSegs ? batColor : "#1e293b";
                                                        <rect x="@F(bsx)" y="5" width="@F(batSegW-2)" height="@F(sym.Height-10)" rx="1" fill="@bFill" />
                                                    }
                                                }
                                            }
                                            break;
                            }

                            @if (!string.IsNullOrEmpty(labelText ?? sym.Label) && sym.Type is not "text" and not "lamp" and not "light" and not "wire" and not "transformer" and not "battery")
                            {
                                @RenderSvgText(sym.Width / 2, sym.Height + 14, "middle", null, "#333", 11, labelText ?? sym.Label, sym)
                            }

                            @if (sym.Animations.Count > 0)
                            {
                                @* Animation indicator badge *@
                                <circle cx="@(sym.Width - 2)" cy="4" r="5" fill="#17a2b8" stroke="white" stroke-width="1"/>
                                @RenderSvgText(sym.Width - 2, 7, "middle", "middle", "white", 7, "▶")
                            }

                            @if (isSelected)
                            {
                                <rect x="-2" y="-2" width="@(sym.Width + 4)" height="@(sym.Height + 4)"
                                      fill="none" stroke="@(sym == _selectedSymbol ? "#0d6efd" : "#6ea8fe")" stroke-width="1.5" stroke-dasharray="4,2" rx="2" />

                                @if (sym == _selectedSymbol)
                                {
                                    @* ── Resize handles (8 directions) ── *@
                                    var hw = 6.0;
                                    var hh = 6.0;
                                    var w = sym.Width;
                                    var h = sym.Height;

                                    @foreach (var handle in _resizeHandles)
                                    {
                                        var hName = handle.Name;
                                        var hx = handle.GetX(w, hw);
                                        var hy = handle.GetY(h, hh);
                                        var hCursor = handle.Cursor;

                                        <rect x="@hx" y="@hy" width="@hw" height="@hh" rx="1"
                                              fill="white" stroke="#0d6efd" stroke-width="1"
                                              style="cursor: @hCursor;"
                                              @onmousedown="(e) => OnResizeHandleMouseDown(e, sym, hName)" @onmousedown:stopPropagation />
                                    }

                                    @if (_selectedSymbols.Count == 1)
                                    {
                                        @* Rotation handle — single selection only *@
                                        <line x1="@(w / 2)" y1="-2" x2="@(w / 2)" y2="-20"
                                              stroke="#0d6efd" stroke-width="1" />
                                        <circle cx="@(w / 2)" cy="-24" r="5"
                                                fill="#0d6efd" stroke="white" stroke-width="1.5"
                                                style="cursor: grab;"
                                                @onmousedown="(e) => OnRotateHandleMouseDown(e, sym)" @onmousedown:stopPropagation />
                                    }
                                }
                            }
                        </g>
                    }

                    @* ── Smart snap guide lines ── *@
                    @if (_snapGuides.Count > 0)
                    {
                        @foreach (var guide in _snapGuides)
                        {
                            <line x1="@F(guide.X1)" y1="@F(guide.Y1)" x2="@F(guide.X2)" y2="@F(guide.Y2)"
                                  stroke="#ff4081" stroke-width="0.8" stroke-dasharray="3,2" pointer-events="none" />
                        }
                    }

                    @* Marquee selection rectangle *@
                    @if (_isMarqueeSelecting)
                    {
                        var mx = Math.Min(_marqueeStartX, _marqueeEndX);
                        var my = Math.Min(_marqueeStartY, _marqueeEndY);
                        var mw = Math.Abs(_marqueeEndX - _marqueeStartX);
                        var mh = Math.Abs(_marqueeEndY - _marqueeStartY);
                        <rect x="@mx" y="@my" width="@mw" height="@mh"
                              fill="rgba(13,110,253,0.08)" stroke="#0d6efd" stroke-width="1" stroke-dasharray="4,2" />
                    }
                </svg>
            </div>
        </div>
    }
</div>

@if (_showDistributeDialog)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Distribute to Columns</h6>
                    <button type="button" class="btn-close" @onclick="() => _showDistributeDialog = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small">Number of columns:</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="50" @bind="_distributeColumns" />
                    <label class="form-label small mt-2">Horizontal gap (px):</label>
                    <input type="number" class="form-control form-control-sm" min="0" max="200" @bind="_distributeGapX" />
                    <label class="form-label small mt-2">Vertical gap (px):</label>
                    <input type="number" class="form-control form-control-sm" min="0" max="200" @bind="_distributeGapY" />
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _showDistributeDialog = false">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="ApplyDistributeToColumns">Apply</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private OpcClientService Opc { get; set; } = default!;
    [Inject] private ClipboardService Clipboard { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private UndoRedoService UndoRedo { get; set; } = default!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private ScreenSymbol? _selectedSymbol;
    private HashSet<ScreenSymbol> _selectedSymbols = new();
    private bool _isDragging;
    private bool _isRotating;
    private bool _isResizing;
    private string _resizeHandle = "";
    private double _resizeStartWidth, _resizeStartHeight;
    private double _resizeStartX, _resizeStartY;
    private Dictionary<ScreenSymbol, (double X, double Y, double W, double H)> _multiResizeStarts = new();
    private (double X, double Y, double W, double H) _multiBoundsStart;
    private bool _isMarqueeSelecting;
    private double _dragStartX, _dragStartY;
    private double _symStartX, _symStartY;
    private double _rotateStartAngle;
    private double _symStartRotation;
    private Dictionary<ScreenSymbol, (double X, double Y)> _multiDragStarts = new();
    private double _marqueeStartX, _marqueeStartY, _marqueeEndX, _marqueeEndY;
    private double _marqueeCanvasOffsetX, _marqueeCanvasOffsetY;
    private int _nextId = 1;
    private int _nextGroupId = 1;
    private int _nextAnimId = 1;
    private System.Threading.Timer? _refreshTimer;
    private TreeNode? _previousNode;

    // ─── Undo snapshots ──────────────────────────────────────
    private Dictionary<ScreenSymbol, string> _operationSnapshots = new();

    private void CaptureSnapshots(IEnumerable<ScreenSymbol> symbols)
    {
        _operationSnapshots.Clear();
        foreach (var s in symbols)
            _operationSnapshots[s] = System.Text.Json.JsonSerializer.Serialize(s);
    }

    private void RecordSnapshotUndo(string description)
    {
        var actions = new List<UndoAction>();
        foreach (var (sym, oldJson) in _operationSnapshots)
        {
            var newJson = System.Text.Json.JsonSerializer.Serialize(sym);
            if (newJson != oldJson)
                actions.Add(new SnapshotAction { Target = sym, OldJson = oldJson, NewJson = newJson, Description = description });
        }
        if (actions.Count == 1)
            UndoRedo.RecordAction(actions[0]);
        else if (actions.Count > 1)
            UndoRedo.RecordAction(new CompoundAction { Actions = actions, Description = description });
        _operationSnapshots.Clear();
    }

    // ─── Grid / Snap / Distribute state ─────────────────────
    private List<(double X1, double Y1, double X2, double Y2)> _snapGuides = new();
    private const double SmartSnapThreshold = 5.0;
    private bool _showDistributeDialog;
    private int _distributeColumns = 3;
    private int _distributeGapX = 10;
    private int _distributeGapY = 10;

    // ─── Resize handle definitions ──────────────────────────
    private record ResizeHandleDef(string Name, string Cursor,
        Func<double, double, double> GetX,
        Func<double, double, double> GetY);

    private static readonly ResizeHandleDef[] _resizeHandles =
    [
        new("nw", "nwse-resize", (w, s) => -2 - s / 2,          (h, s) => -2 - s / 2),
        new("ne", "nesw-resize", (w, s) => w + 2 - s / 2,       (h, s) => -2 - s / 2),
        new("sw", "nesw-resize", (w, s) => -2 - s / 2,          (h, s) => h + 2 - s / 2),
        new("se", "nwse-resize", (w, s) => w + 2 - s / 2,       (h, s) => h + 2 - s / 2),
        new("n",  "ns-resize",   (w, s) => w / 2 - s / 2,       (h, s) => -2 - s / 2),
        new("s",  "ns-resize",   (w, s) => w / 2 - s / 2,       (h, s) => h + 2 - s / 2),
        new("w",  "ew-resize",   (w, s) => -2 - s / 2,          (h, s) => h / 2 - s / 2),
        new("e",  "ew-resize",   (w, s) => w + 2 - s / 2,       (h, s) => h / 2 - s / 2),
    ];

    protected override void OnInitialized()
    {
        Opc.StateChanged += OnOpcChanged;
        Editor.AnimationPreviewTick += OnAnimationPreviewTick;
        _refreshTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void OnOpcChanged() => InvokeAsync(StateHasChanged);
    private void OnAnimationPreviewTick() => InvokeAsync(StateHasChanged);

    private async Task OnBackgroundImageSelected(InputFileChangeEventArgs e, ScreenConfig screen)
    {
        var file = e.File;
        if (file == null) return;

        const long maxSize = 10 * 1024 * 1024; // 10 MB
        using var stream = file.OpenReadStream(maxSize);
        using var ms = new System.IO.MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        var oldBg = screen.BackgroundImage;
        screen.BackgroundImage = $"data:{file.ContentType};base64,{base64}";
        var newBg = screen.BackgroundImage;
        UndoRedo.RecordAction(new CollectionAction
        {
            Description = "Change background image",
            UndoCallback = () => screen.BackgroundImage = oldBg,
            RedoCallback = () => screen.BackgroundImage = newBg
        });
        OnChanged();
    }

    private ScreenConfig? GetScreen()
    {
        return (Node as ScreenNode)?.Screen;
    }

    protected override void OnParametersSet()
    {
        if (Node != _previousNode)
        {
            _previousNode = Node;
            _selectedSymbol = null;
            _selectedSymbols.Clear();
            _isDragging = false;
            _isRotating = false;
            _isMarqueeSelecting = false;
            NotifySelectionChanged();
        }

        // Ensure all symbols have unique IDs
        var screen = GetScreen();
        if (screen != null)
        {
            foreach (var sym in screen.Symbols)
            {
                if (string.IsNullOrEmpty(sym.Id))
                    sym.Id = $"sym_{_nextId++}";
                else if (int.TryParse(sym.Id.Replace("sym_", ""), out var n) && n >= _nextId)
                    _nextId = n + 1;

                // Ensure animation IDs
                foreach (var a in sym.Animations)
                {
                    if (string.IsNullOrEmpty(a.Id))
                        a.Id = $"anim_{_nextAnimId++}";
                    else if (int.TryParse(a.Id.Replace("anim_", ""), out var an) && an >= _nextAnimId)
                        _nextAnimId = an + 1;
                }
            }

            // Clear selection if the symbol was removed externally
            _selectedSymbols.RemoveWhere(s => !screen.Symbols.Contains(s));
            if (_selectedSymbol != null && !screen.Symbols.Contains(_selectedSymbol))
                _selectedSymbol = null;
            if (_selectedSymbol == null && _selectedSymbols.Count > 0)
                _selectedSymbol = _selectedSymbols.First();
        }
    }

    public void AddSymbol(ScreenConfig screen, string type)
    {
        var sym = new ScreenSymbol
        {
            Id = $"sym_{_nextId++}",
            Type = type,
            X = 50 + screen.Symbols.Count * 20 % (screen.Width - 100),
            Y = 50 + screen.Symbols.Count * 20 % (screen.Height - 80),
            Width = type == "text" ? 120 : type == "line" ? 100 : type is "alarmlist" or "hdachart" or "hdagrid" or "eventlog" ? 500 : type == "editbox" ? 160 : type == "ipcamera" ? 320 : type == "recipe" ? 280 : type == "screenembed" ? 400 : type == "lamp" ? 60 : type == "light" ? 80 : type == "wire" ? 200 : type == "transformer" ? 80 : type == "battery" ? 40 : 80,
            Height = type == "text" ? 30 : type == "line" ? 2 : type == "indicator" ? 30 : type == "alarmlist" ? 250 : type is "hdachart" or "hdagrid" or "eventlog" ? 220 : type == "editbox" ? 32 : type == "ipcamera" ? 240 : type == "recipe" ? 300 : type == "screenembed" ? 300 : type == "lamp" ? 80 : type == "light" ? 60 : type == "wire" ? 20 : type == "transformer" ? 100 : type == "battery" ? 80 : 40,
            Label = type == "text" ? "Label" : type == "alarmlist" ? "Alarm List" : type == "hdachart" ? "HDA Chart" : type == "hdagrid" ? "HDA Grid" : type == "eventlog" ? "Event Log" : type == "editbox" ? "" : type == "ipcamera" ? "" : type == "recipe" ? "" : type == "screenembed" ? "Embedded Screen" : "",
            Fill = type == "indicator" ? "#44cc44" : type == "alarmlist" ? "#1a1a2e" : type is "hdachart" or "hdagrid" ? "#111827" : type == "eventlog" ? "#0f172a" : type == "editbox" ? "#1e293b" : type == "ipcamera" ? "#0a0a0a" : type == "recipe" ? "#1a1a2e" : type == "screenembed" ? "#0f172a" : type == "lamp" ? "#fbbf24" : type == "light" ? "#fbbf24" : type == "wire" ? "#ef4444" : type == "transformer" ? "#3b82f6" : type == "battery" ? "#22c55e" : "#4a90d9"
        };

        if (type == "gauge")
        {
            sym.Width = 80;
            sym.Height = 80;
            sym.MinValue = 0;
            sym.MaxValue = 100;
        }

        if (type == "alarmlist")
        {
            sym.Stroke = "#333333";
            sym.StrokeWidth = 1;
        }

        if (type == "hdachart")
        {
            sym.Stroke = "#333333";
            sym.StrokeWidth = 1;
