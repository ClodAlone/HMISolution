    private void RotateSelected(double degrees)
    {
        if (_selectedSymbols.Count > 0)
        {
            CaptureSnapshots(_selectedSymbols);
            foreach (var sym in _selectedSymbols)
                sym.Rotation = (sym.Rotation + degrees) % 360;
            RecordSnapshotUndo("Rotate symbol(s)");
            OnChanged();
        }
