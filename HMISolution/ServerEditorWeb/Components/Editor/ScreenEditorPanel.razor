    // ─── Drag symbols ──────────────────────────────────────

    private void OnSymbolMouseDown(MouseEventArgs e, ScreenSymbol sym)
    {
        var isCtrl = e.CtrlKey;

        if (isCtrl)
        {
            // Ctrl+Click: toggle this symbol in/out of multi-selection
            if (_selectedSymbols.Contains(sym))
            {
                _selectedSymbols.Remove(sym);
                _selectedSymbol = _selectedSymbols.Count > 0 ? _selectedSymbols.First() : null;
            }
            else
            {
                _selectedSymbols.Add(sym);
                _selectedSymbol = sym;
            }
            // Also select all group members if clicking a grouped symbol
            ExpandSelectionToGroups();
            NotifySelectionChanged();
            return;
        }

        // Plain click: if clicking a symbol already in the multi-selection, keep the selection
        // and start dragging the whole set. Otherwise, start a new single selection.
        if (!_selectedSymbols.Contains(sym))
        {
            _selectedSymbols.Clear();
            _selectedSymbol = sym;
            _selectedSymbols.Add(sym);

            // Auto-select group members
            ExpandSelectionToGroups();
        }
        else
        {
            _selectedSymbol = sym;
        }
        NotifySelectionChanged();

        // Capture undo snapshots before drag
        CaptureSnapshots(_selectedSymbols);

        // Start drag for all selected
        _isDragging = true;
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
        _multiDragStarts.Clear();
        foreach (var s in _selectedSymbols)
            _multiDragStarts[s] = (s.X, s.Y);
    }

    private void ExpandSelectionToGroups()
    {
        var screen = GetScreen();
        if (screen == null) return;

        var groupIds = _selectedSymbols
            .Where(s => !string.IsNullOrEmpty(s.GroupId))
            .Select(s => s.GroupId!)
            .Distinct()
            .ToHashSet();

        if (groupIds.Count == 0) return;

        foreach (var sym in screen.Symbols)
        {
            if (!string.IsNullOrEmpty(sym.GroupId) && groupIds.Contains(sym.GroupId))
                _selectedSymbols.Add(sym);
        }
    }

    private void OnCanvasMouseDown(MouseEventArgs e)
    {
        if (_isDragging || _isRotating || _isResizing) return;

        // Click on empty area — start marquee or clear selection
        if (!e.CtrlKey)
        {
            _selectedSymbol = null;
            _selectedSymbols.Clear();
            NotifySelectionChanged();
        }

        // Start marquee selection
        _isMarqueeSelecting = true;
        // We use ClientX/Y relative offsets for the marquee rectangle
        // Store starting client coords — will compute SVG-local coords in move
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
        _marqueeStartX = e.OffsetX;
        _marqueeStartY = e.OffsetY;
        _marqueeEndX = _marqueeStartX;
        _marqueeEndY = _marqueeStartY;
    }

    private void OnCanvasMouseMove(MouseEventArgs e)
    {
        if (_isDragging && _selectedSymbols.Count > 0)
        {
            var screen = GetScreen();
            var dx = e.ClientX - _dragStartX;
            var dy = e.ClientY - _dragStartY;
            foreach (var s in _selectedSymbols)
            {
                if (_multiDragStarts.TryGetValue(s, out var start))
                {
                    s.X = start.X + dx;
                    s.Y = start.Y + dy;
                }
            }

            // Snap to grid
            if (screen != null && screen.SnapToGrid && screen.EditorGridSize >= 5)
            {
                var gs = (double)screen.EditorGridSize;
                // Compute offset from first selected symbol's desired position to nearest grid
                var anchor = _selectedSymbol ?? _selectedSymbols.First();
                var snapDx = Math.Round(anchor.X / gs) * gs - anchor.X;
                var snapDy = Math.Round(anchor.Y / gs) * gs - anchor.Y;
                foreach (var s in _selectedSymbols)
                {
                    s.X += snapDx;
                    s.Y += snapDy;
                }
            }

            // Smart snap (alignment guides)
            _snapGuides.Clear();
            if (screen != null && screen.SmartSnap && _selectedSymbol != null)
            {
                ComputeSmartSnapGuides(screen);
            }
        }
        else if (_isResizing)
        {
            ApplyResize(e);
        }
        else if (_isRotating && _selectedSymbol != null)
        {
            var dx = e.ClientX - _dragStartX;
            var dy = e.ClientY - _dragStartY;
            var currentAngle = Math.Atan2(dy, dx) * 180.0 / Math.PI;
            var delta = currentAngle - _rotateStartAngle;
            _selectedSymbol.Rotation = Math.Round((_symStartRotation + delta) % 360, 1);
        }
        else if (_isMarqueeSelecting)
        {
            _marqueeEndX = _marqueeStartX + (e.ClientX - _dragStartX);
            _marqueeEndY = _marqueeStartY + (e.ClientY - _dragStartY);
        }
    }

    private void OnCanvasMouseUp(MouseEventArgs e)
    {
        if (_isMarqueeSelecting)
        {
            _isMarqueeSelecting = false;
            ApplyMarqueeSelection(e.CtrlKey);
        }

        if (_isDragging || _isRotating || _isResizing)
        {
            var wasDragging = _isDragging;
            var wasRotating = _isRotating;
            var wasResizing = _isResizing;
            _isDragging = false;
            _isRotating = false;
            _isResizing = false;
            _resizeHandle = "";
            _multiDragStarts.Clear();
            _multiResizeStarts.Clear();
            _snapGuides.Clear();

            // Record undo for the completed operation
            if (wasDragging) RecordSnapshotUndo("Move symbol(s)");
            else if (wasResizing) RecordSnapshotUndo("Resize symbol(s)");
            else if (wasRotating) RecordSnapshotUndo("Rotate symbol");

            OnChanged();
        }
    }

    private void ApplyMarqueeSelection(bool additive)
    {
        var screen = GetScreen();
        if (screen == null) return;

        var x1 = Math.Min(_marqueeStartX, _marqueeEndX);
        var y1 = Math.Min(_marqueeStartY, _marqueeEndY);
        var x2 = Math.Max(_marqueeStartX, _marqueeEndX);
        var y2 = Math.Max(_marqueeStartY, _marqueeEndY);

        // Only apply if the marquee has meaningful size
        if (x2 - x1 < 3 && y2 - y1 < 3) return;

        if (!additive)
        {
            _selectedSymbols.Clear();
            _selectedSymbol = null;
        }

        foreach (var sym in screen.Symbols)
        {
            // Check if symbol's bounding box intersects the marquee
            if (sym.X + sym.Width >= x1 && sym.X <= x2 &&
                sym.Y + sym.Height >= y1 && sym.Y <= y2)
            {
                _selectedSymbols.Add(sym);
            }
        }

        // Expand to include full groups
        ExpandSelectionToGroups();

        _selectedSymbol = _selectedSymbols.Count > 0 ? _selectedSymbols.First() : null;
        NotifySelectionChanged();
    }

    private void OnRotateHandleMouseDown(MouseEventArgs e, ScreenSymbol sym)
    {
        _selectedSymbol = sym;
        CaptureSnapshots(new[] { sym });
        _isRotating = true;
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
        _rotateStartAngle = Math.Atan2(0, 0) * 180.0 / Math.PI;
        _symStartRotation = sym.Rotation;
    }

    // ─── Resize handles ─────────────────────────────────────

    private void OnResizeHandleMouseDown(MouseEventArgs e, ScreenSymbol sym, string handle)
    {
        _selectedSymbol = sym;
        CaptureSnapshots(_selectedSymbols);
        _isResizing = true;
        _resizeHandle = handle;
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;

        if (_selectedSymbols.Count > 1)
        {
            // Multi-selection: compute bounding box and store per-symbol relative positions
            _multiResizeStarts.Clear();
            double bx1 = double.MaxValue, by1 = double.MaxValue, bx2 = double.MinValue, by2 = double.MinValue;
            foreach (var s in _selectedSymbols)
            {
                bx1 = Math.Min(bx1, s.X);
                by1 = Math.Min(by1, s.Y);
                bx2 = Math.Max(bx2, s.X + s.Width);
                by2 = Math.Max(by2, s.Y + s.Height);
                _multiResizeStarts[s] = (s.X, s.Y, s.Width, s.Height);
            }
            _multiBoundsStart = (bx1, by1, bx2 - bx1, by2 - by1);
        }
        else
        {
            // Single selection
            _resizeStartX = sym.X;
            _resizeStartY = sym.Y;
            _resizeStartWidth = sym.Width;
            _resizeStartHeight = sym.Height;
        }
    }

    private void ApplyResize(MouseEventArgs e)
    {
        var dx = e.ClientX - _dragStartX;
        var dy = e.ClientY - _dragStartY;
        const double minSize = 8;

        if (_selectedSymbols.Count > 1)
        {
            ApplyMultiResize(dx, dy, minSize);
        }
        else if (_selectedSymbol != null)
        {
            ApplySingleResize(_selectedSymbol, dx, dy, minSize);
        }
    }

    private void ApplySingleResize(ScreenSymbol sym, double dx, double dy, double minSize)
    {
        var x = _resizeStartX;
        var y = _resizeStartY;
        var w = _resizeStartWidth;
        var h = _resizeStartHeight;

        switch (_resizeHandle)
        {
            case "se":
                w += dx; h += dy;
                break;
            case "nw":
                x += dx; y += dy; w -= dx; h -= dy;
                break;
            case "ne":
                y += dy; w += dx; h -= dy;
                break;
            case "sw":
                x += dx; w -= dx; h += dy;
                break;
            case "n":
                y += dy; h -= dy;
                break;
            case "s":
                h += dy;
                break;
            case "w":
                x += dx; w -= dx;
                break;
            case "e":
                w += dx;
                break;
        }

        // Enforce minimum size
        if (w < minSize) { if (_resizeHandle.Contains('w')) x -= (minSize - w); w = minSize; }
        if (h < minSize) { if (_resizeHandle.Contains('n')) y -= (minSize - h); h = minSize; }

        sym.X = x;
        sym.Y = y;
        sym.Width = w;
        sym.Height = h;
    }

    private void ApplyMultiResize(double dx, double dy, double minSize)
    {
        var (bx, by, bw, bh) = _multiBoundsStart;
        if (bw < 1) bw = 1;
        if (bh < 1) bh = 1;

        // Compute the new bounding box dimensions
        double nbx = bx, nby = by, nbw = bw, nbh = bh;

        switch (_resizeHandle)
        {
            case "se": nbw += dx; nbh += dy; break;
            case "nw": nbx += dx; nby += dy; nbw -= dx; nbh -= dy; break;
            case "ne": nby += dy; nbw += dx; nbh -= dy; break;
            case "sw": nbx += dx; nbw -= dx; nbh += dy; break;
            case "n":  nby += dy; nbh -= dy; break;
            case "s":  nbh += dy; break;
            case "w":  nbx += dx; nbw -= dx; break;
            case "e":  nbw += dx; break;
        }

        if (nbw < minSize) nbw = minSize;
        if (nbh < minSize) nbh = minSize;

        var scaleX = nbw / bw;
        var scaleY = nbh / bh;

        foreach (var s in _selectedSymbols)
        {
            if (!_multiResizeStarts.TryGetValue(s, out var orig)) continue;

            // Scale position relative to original bounding box origin
            var relX = orig.X - bx;
            var relY = orig.Y - by;

            s.X = nbx + relX * scaleX;
            s.Y = nby + relY * scaleY;
            s.Width = Math.Max(orig.W * scaleX, minSize);
            s.Height = Math.Max(orig.H * scaleY, minSize);
        }
    }

    // ─── Group / Ungroup ────────────────────────────────────

    private void GroupSelected()
    {
        if (_selectedSymbols.Count < 2) return;

        CaptureSnapshots(_selectedSymbols);
        var groupId = $"grp_{_nextGroupId++}";
        foreach (var sym in _selectedSymbols)
            sym.GroupId = groupId;
        RecordSnapshotUndo("Group symbols");
        OnChanged();
    }

    private void UngroupSelected()
    {
        var screen = GetScreen();
        if (screen == null) return;

        // Collect all group IDs from the current selection
        var groupIds = _selectedSymbols
            .Where(s => !string.IsNullOrEmpty(s.GroupId))
            .Select(s => s.GroupId!)
            .Distinct()
            .ToHashSet();

        // Snapshot all affected symbols before ungroup
        var affected = screen.Symbols.Where(s => !string.IsNullOrEmpty(s.GroupId) && groupIds.Contains(s.GroupId)).ToList();
        CaptureSnapshots(affected);

        // Clear GroupId from ALL symbols that belong to those groups (not just selected ones)
        foreach (var sym in affected)
            sym.GroupId = null;

        RecordSnapshotUndo("Ungroup symbols");
        OnChanged();
    }

    private void SelectGroup()
    {
        if (_selectedSymbol == null || string.IsNullOrEmpty(_selectedSymbol.GroupId)) return;

        var screen = GetScreen();
        if (screen == null) return;

        var groupId = _selectedSymbol.GroupId;
        foreach (var sym in screen.Symbols)
        {
            if (sym.GroupId == groupId)
                _selectedSymbols.Add(sym);
        }
    }
    // ─── OPC live values ────────────────────────────────────

    private string? GetLiveValue(ScreenSymbol sym)
    {
        if (string.IsNullOrEmpty(sym.VariablePath)) return null;

        foreach (var item in Opc.MonitoredItems)
        {
            if (item.DisplayName == sym.VariablePath ||
                item.NodeIdString.EndsWith(sym.VariablePath, StringComparison.OrdinalIgnoreCase))
                return item.Value;
        }
        return null;
    }

    private double? ParseNumericValue(string? val)
    {
        if (val == null) return null;
        if (double.TryParse(val, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;
        if (bool.TryParse(val, out var b))
            return b ? 1 : 0;
        return null;
    }

    // ─── Simple binding evaluations ─────────────────────────

    private string EvalFillBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.FillBinding) || liveValue == null)
            return sym.Fill;

        try
        {
            var numVal = ParseNumericValue(liveValue);
            var binding = sym.FillBinding;

            // Simple pattern: "value > X ? 'colorA' : 'colorB'"
            if (binding.Contains('?') && binding.Contains(':'))
            {
                var condResult = EvalSimpleCondition(binding, liveValue, numVal);
                if (condResult != null) return condResult;
            }
        }
        catch { }
        return sym.Fill;
    }

    private bool EvalVisibilityBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.VisibilityBinding) || liveValue == null)
            return true;

        try
        {
            var numVal = ParseNumericValue(liveValue);
            return EvalSimpleBool(sym.VisibilityBinding, liveValue, numVal);
        }
        catch { }
        return true;
    }

    private double EvalRotationBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.RotationBinding) || liveValue == null)
            return sym.Rotation;

        try
        {
            var numVal = ParseNumericValue(liveValue);
            if (numVal.HasValue)
            {
                var expr = sym.RotationBinding.Replace("value", numVal.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
                if (expr.Contains('*'))
                {
                    var parts = expr.Split('*');
                    if (parts.Length == 2 && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var a)
                        && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var b))
                        return a * b;
                }
                if (double.TryParse(expr.Trim(), System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var d))
                    return d;
            }
        }
        catch { }
        return sym.Rotation;
    }

    private string? EvalLabelBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.LabelBinding) || liveValue == null)
            return null;

        try
        {
            var binding = sym.LabelBinding;

            // Simple pattern: "value + ' suffix'"
            if (binding.Contains("value"))
            {
                var result = binding.Replace("value", liveValue);
                // Clean up simple string concatenation
                result = result.Replace("+ '", "").Replace("' +", "").Replace("'", "").Replace("+", "").Replace("  ", " ").Trim();
                if (!string.IsNullOrEmpty(result))
                    return $"{liveValue} {result.Replace(liveValue, "").Trim()}".Trim();
                return liveValue;
            }
        }
        catch { }
        return liveValue;
    }

    private string? EvalSimpleCondition(string binding, string liveValue, double? numVal)
    {
        // Parse: "value > 50 ? '#ff0000' : '#00ff00'"
        var qIdx = binding.IndexOf('?');
        var cIdx = binding.IndexOf(':', qIdx + 1);
        if (qIdx < 0 || cIdx < 0) return null;

        var condition = binding[..qIdx].Trim();
        var trueVal = binding[(qIdx + 1)..cIdx].Trim().Trim('\'', '"', ' ');
        var falseVal = binding[(cIdx + 1)..].Trim().Trim('\'', '"', ' ');

        var result = EvalSimpleBool(condition, liveValue, numVal);
        return result ? trueVal : falseVal;
    }

    private bool EvalSimpleBool(string condition, string liveValue, double? numVal)
    {
        condition = condition.Trim();

        // "value == true" / "value == false"
        if (condition.Contains("=="))
        {
            var parts = condition.Split("==", 2);
            var right = parts[1].Trim().Trim('\'', '"');
            if (right.Equals("true", StringComparison.OrdinalIgnoreCase))
                return liveValue.Equals("True", StringComparison.OrdinalIgnoreCase) || liveValue == "1";
            if (right.Equals("false", StringComparison.OrdinalIgnoreCase))
                return liveValue.Equals("False", StringComparison.OrdinalIgnoreCase) || liveValue == "0";
            if (numVal.HasValue && double.TryParse(right, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var rn))
                return Math.Abs(numVal.Value - rn) < 0.0001;
            return liveValue == right;
        }

        if (numVal.HasValue)
        {
            if (condition.Contains(">="))
                return TryCompare(condition, ">=", numVal.Value, (a, b) => a >= b);
            if (condition.Contains("<="))
                return TryCompare(condition, "<=", numVal.Value, (a, b) => a <= b);
            if (condition.Contains('>'))
                return TryCompare(condition, ">", numVal.Value, (a, b) => a > b);
            if (condition.Contains('<'))
                return TryCompare(condition, "<", numVal.Value, (a, b) => a < b);
            if (condition.Contains("!="))
                return TryCompare(condition, "!=", numVal.Value, (a, b) => Math.Abs(a - b) > 0.0001);
        }

        return true;
    }

    private static bool TryCompare(string expr, string op, double value, Func<double, double, bool> compare)
    {
        var parts = expr.Split(op, 2);
        if (parts.Length == 2 &&
            double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var threshold))
            return compare(value, threshold);
        return true;
    }

    // ─── HDA chart design-time polyline ──

    private static string BuildFakeHdaPolyline(ScreenSymbol sym)
    {
        var w = sym.Width - 50;
        var h = sym.Height - 55;
        var b = sym.Height - 22;
        double[] yFactors = [0.3, 0.5, 0.4, 0.7, 0.55, 0.8, 0.65];
        double[] xFactors = [0, 0.15, 0.3, 0.5, 0.65, 0.8, 1.0];
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < yFactors.Length; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.Append($"{50 + w * xFactors[i]:F0},{b - h * yFactors[i]:F0}");
        }
        return sb.ToString();
    }

