@using Microsoft.JSInterop
@using SharedModels
@using ServerEditorWeb.Services
@implements IDisposable

<div class="script-editor-panel">
    @if (GetScript() is not ScriptConfig script)
    {
        <p class="text-muted p-2">Select a Script node to open the code editor.</p>
    }
    else
    {
        @* Toolbar *@
        <div class="script-editor-toolbar">
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <span class="small fw-bold me-2">@_scriptNode!.Name</span>
                <span class="badge bg-secondary">@script.Language</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="CheckSyntax" disabled="@_checkingSyntax">
                    @if (_checkingSyntax)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Check Syntax
                </button>
                @if (!string.IsNullOrEmpty(_syntaxResult))
                {
                    <span class="small @(_syntaxSuccess ? "text-success" : "text-danger")">@_syntaxResult</span>
                }

                @if (ServerProcess.IsServerRunning)
                {
                    <span class="border-start ms-1 me-1" style="height:20px"></span>
                    @if (_debugState == ScriptDebugState.Paused)
                    {
                        <button class="btn btn-sm btn-success" title="Continue" @onclick="() => SendDebugCommand(ScriptDebugCommand.Continue)">▶</button>
                        <button class="btn btn-sm btn-outline-primary" title="Step Over" @onclick="() => SendDebugCommand(ScriptDebugCommand.StepOver)">⏭</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-warning" title="Pause" @onclick="() => SendDebugCommand(ScriptDebugCommand.Pause)">⏸</button>
                    }
                    <button class="btn btn-sm btn-outline-danger" title="Detach" @onclick="() => SendDebugCommand(ScriptDebugCommand.Detach)">⏹</button>
                    @if (_debugState == ScriptDebugState.Paused)
                    {
                        <span class="badge bg-warning text-dark">Paused @(_pausedLine >= 0 ? $"line {_pausedLine + 1}" : "")</span>
                    }
                    else if (_debugState == ScriptDebugState.Stepping)
                    {
                        <span class="badge bg-info">Stepping</span>
                    }
                }
            </div>
        </div>

        @* Code Editor + Debug *@
        <div class="script-editor-body">
            <CodeEditor @ref="_editor" @bind-Value="script.Code" @bind-Value:after="OnCodeChanged"
                        Language="@GetEditorLanguage(script.Language)" Height="100%"
                        Completions="_completions"
                        EnableBreakpoints="true"
                        BreakpointsChanged="OnBreakpointsChanged"
                        Initialized="OnEditorInitialized" />
            <ProgramDebugPanel Category="Script" ProgramName="@script.Name"
                              ServerRunning="ServerProcess.IsServerRunning"
                              SourceCode="@script.Code" Height="100%"
                              EditorElement="@(_editor?.EditorElement ?? default)"
                              OnDebugSessionChanged="OnDebugSessionUpdated" />
        </div>
    }
</div>

<style>
    .script-editor-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }
    .script-editor-toolbar {
        padding: 4px 8px;
        border-bottom: 1px solid var(--bs-border-color);
        background: #f8f9fa;
        flex-shrink: 0;
    }
    .script-editor-body {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .script-editor-body .CodeMirror {
        flex: 1;
        height: auto !important;
    }
</style>

@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private SyntaxCheckService SyntaxChecker { get; set; } = default!;
    [Inject] private ServerProcessService ServerProcess { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private ScriptDebugService DebugService { get; set; } = default!;

    private CodeEditor? _editor;
    private ScriptNode? _scriptNode;
    private ScriptConfig? _lastScript;
    private string _syntaxResult = "";
    private bool _syntaxSuccess;
    private bool _checkingSyntax;
    private List<CodeEditor.CompletionItem> _completions = new();
    private int[] _breakpointLines = [];
    private ScriptDebugState _debugState = ScriptDebugState.Detached;
    private int _pausedLine = -1;
    private bool _needsBreakpointRestore;
    private string? _debugError;

    private ScriptConfig? GetScript()
    {
        _scriptNode = Node as ScriptNode;
        return _scriptNode?.Script;
    }

    protected override void OnParametersSet()
    {
        var script = GetScript();
        if (script != _lastScript)
        {
            _lastScript = script;
            _syntaxResult = "";
            _breakpointLines = script?.Breakpoints?.ToArray() ?? [];
            _needsBreakpointRestore = true;
            RebuildCompletions();
        }
    }

    private void RebuildCompletions()
    {
        _completions = new List<CodeEditor.CompletionItem>();

        // API functions available in scripts
        _completions.Add(new() { Text = "Read", DisplayText = "Read(\"varPath\") \u2192 object?", ClassName = "cm-hint-function" });
        _completions.Add(new() { Text = "ReadDouble", DisplayText = "ReadDouble(\"varPath\") \u2192 double", ClassName = "cm-hint-function" });
        _completions.Add(new() { Text = "ReadInt", DisplayText = "ReadInt(\"varPath\") \u2192 int", ClassName = "cm-hint-function" });
        _completions.Add(new() { Text = "ReadBool", DisplayText = "ReadBool(\"varPath\") \u2192 bool", ClassName = "cm-hint-function" });
        _completions.Add(new() { Text = "Write", DisplayText = "Write(\"varPath\", value)", ClassName = "cm-hint-function" });
        _completions.Add(new() { Text = "Log", DisplayText = "Log(\"message\")", ClassName = "cm-hint-function" });
        _completions.Add(new() { Text = "OnChanged", DisplayText = "OnChanged(\"varPath\", handler)", ClassName = "cm-hint-function" });

        // Variable paths from the project
        var model = Editor.RootModel;
        if (model?.Folder != null)
            CollectVariablePaths(model.Folder, "", _completions);
    }

    private static void CollectVariablePaths(Folder folder, string prefix, List<CodeEditor.CompletionItem> items)
    {
        var folderPath = string.IsNullOrEmpty(prefix) ? folder.Name : $"{prefix}.{folder.Name}";
        foreach (var v in folder.Variables)
        {
            var path = $"{folderPath}.{v.Name}";
            items.Add(new CodeEditor.CompletionItem
            {
                Text = path,
                DisplayText = $"{path}  ({v.Type})",
                ClassName = "cm-hint-variable"
            });
        }
        foreach (var sub in folder.Folders)
            CollectVariablePaths(sub, folderPath, items);
    }

    private async Task OnCodeChanged()
    {
        await OnPropertyChanged.InvokeAsync();
    }

    private async Task CheckSyntax()
    {
        var script = GetScript();
        if (script == null) return;

        _syntaxResult = "";
        _checkingSyntax = true;
        StateHasChanged();

        try
        {
            var code = script.Code;
            var language = script.Language;
            var (success, message) = await Task.Run(() => SyntaxChecker.CheckSyntax(code, language));
            _syntaxSuccess = success;
            _syntaxResult = message;
        }
        catch (Exception ex)
        {
            _syntaxSuccess = false;
            _syntaxResult = $"Error: {ex.Message}";
        }
        finally
        {
            _checkingSyntax = false;
        }
    }

    private static string GetEditorLanguage(string language)
    {
        return language.Equals("VB", StringComparison.OrdinalIgnoreCase)
            || language.Equals("VB.NET", StringComparison.OrdinalIgnoreCase)
            || language.Equals("VisualBasic", StringComparison.OrdinalIgnoreCase)
            ? "vb" : "csharp";
    }

    private async Task OnBreakpointsChanged(int[] lines)
    {
        _breakpointLines = lines;
        var script = GetScript();
        if (script != null)
        {
            script.Breakpoints = lines.ToList();
            await OnPropertyChanged.InvokeAsync();

            if (ServerProcess.IsServerRunning)
            {
                try
                {
                    await DebugService.SetBreakpointsAsync(script.Name, lines.ToList());
                    _debugError = null;
                }
                catch (Exception ex)
                {
                    _debugError = $"Set breakpoints failed: {ex.Message}";
                    StateHasChanged();
                }
            }
        }
    }

    private async Task SendDebugCommand(ScriptDebugCommand command)
    {
        var script = GetScript();
        if (script == null) return;
        try
        {
            await DebugService.SendCommandAsync(script.Name, command);
            _debugError = null;
        }
        catch (Exception ex)
        {
            _debugError = $"Debug cmd failed: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task OnDebugSessionUpdated(ScriptDebugSession? session)
    {
        var prevState = _debugState;
        var prevLine = _pausedLine;
        _debugState = session?.State ?? ScriptDebugState.Detached;
        _pausedLine = session?.PausedAtLine ?? -1;

        if (_editor != null)
        {
            if (_debugState == ScriptDebugState.Paused && _pausedLine >= 0)
                await _editor.SetCurrentDebugLineAsync(_pausedLine);
            else if (prevState == ScriptDebugState.Paused)
                await _editor.ClearCurrentDebugLineAsync();
        }
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        ServerProcess.StateChanged += OnServerStateChanged;
    }

    private async void OnServerStateChanged()
    {
        await InvokeAsync(async () =>
        {
            if (ServerProcess.IsServerRunning)
                await PushBreakpointsToServerAsync();
            StateHasChanged();
        });
    }

    private async Task OnEditorInitialized()
    {
        if (_needsBreakpointRestore && _editor != null && _breakpointLines.Length > 0)
        {
            _needsBreakpointRestore = false;
            await _editor.SetBreakpointsAsync(_breakpointLines);
            if (ServerProcess.IsServerRunning)
                await PushBreakpointsToServerAsync();
        }
        StateHasChanged();
    }

    private async Task PushBreakpointsToServerAsync()
    {
        var script = GetScript();
        if (script == null || _breakpointLines.Length == 0) return;
        try
        {
            await DebugService.SetBreakpointsAsync(script.Name, _breakpointLines.ToList());
            _debugError = null;
        }
        catch (Exception ex)
        {
            _debugError = $"Set breakpoints failed: {ex.Message}";
        }
    }

    public void Dispose()
    {
        ServerProcess.StateChanged -= OnServerStateChanged;
    }
}
