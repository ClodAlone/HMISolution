@page "/"
@page "/screen/{ScreenName}"
@using SharedModels
@using RuntimeViewer.Shared.Services
@using RuntimeViewer.Shared.Components.Viewer
@implements IDisposable

<PageTitle>@(_currentScreen != null ? Localization.Resolve(_currentScreen.Name) : "Runtime Viewer")</PageTitle>

@if (_loginRequired && !Auth.IsAuthenticated)
{
    @* -- Login Modal (required ÔÇö blocks everything) -- *@
    <div class="rv-login-overlay">
        <div class="rv-login-card">
            <div class="rv-login-header">
                <span>­ƒöÉ</span>
                <span>Runtime Viewer Login</span>
            </div>
            <div class="rv-login-body">
                @if (!string.IsNullOrEmpty(_loginError))
                {
                    <div class="rv-login-error">@_loginError</div>
                }
                <div class="rv-login-field">
                    <label>Username</label>
                    <input type="text" @bind="_loginUsername" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter username" autofocus />
                </div>
                <div class="rv-login-field">
                    <label>Password</label>
                    <input type="password" @bind="_loginPassword" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter password" />
                </div>
                <button class="rv-login-btn" @onclick="DoLogin" disabled="@_loginBusy">
                    @if (_loginBusy)
                    {
                        <span>Signing inÔÇª</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
            <div class="rv-login-footer">Runtime Viewer</div>
        </div>
    </div>
}
else if (Auth.MustChangePassword)
{
    @* -- Force Change Password Modal -- *@
    <div class="rv-login-overlay">
        <div class="rv-login-card">
            <div class="rv-login-header">
                <span>­ƒöæ</span>
                <span>Change Password</span>
            </div>
            <div class="rv-login-body">
                <div style="font-size: 12px; color: #aaa; margin-bottom: 8px;">
                    You must change your password before continuing.
                </div>
                <div style="font-size: 10px; color: #888; margin-bottom: 12px; font-style: italic;">
                    @(SharedModels.PasswordValidator.GetRequirementsText(Project.Model?.Server?.RequireStrongPassword ?? false))
                </div>
                @if (!string.IsNullOrEmpty(_changePwError))
                {
                    <div class="rv-login-error">@_changePwError</div>
                }
                @if (!string.IsNullOrEmpty(_changePwSuccess))
                {
                    <div style="background: #155724; color: #d4edda; padding: 6px 10px; border-radius: 4px; font-size: 12px; margin-bottom: 8px;">@_changePwSuccess</div>
                }
                <div class="rv-login-field">
                    <label>Current Password</label>
                    <input type="password" @bind="_changePwCurrent" placeholder="Current password" />
                </div>
                <div class="rv-login-field">
                    <label>New Password</label>
                    <input type="password" @bind="_changePwNew" placeholder="New password" />
                </div>
                <div class="rv-login-field">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="_changePwConfirm" @onkeydown="OnChangePwKeyDown"
                           placeholder="Confirm new password" />
                </div>
                <button class="rv-login-btn" @onclick="DoChangePassword">Change Password</button>
            </div>
        </div>
    </div>
}
else
{

<div class="rv-app @(Project.IsKiosk ? "rv-kiosk" : "") @(NavStyle == "sidebar" ? "rv-nav-sidebar" : "")">
    @if (!Project.IsKiosk || Project.Settings.ShowNavigationBar)
    {
        @* -- Top bar -- *@
        <div class="rv-topbar">
            <span class="rv-title">Runtime Viewer</span>

            @if (NavigableScreens.Count > 1 && NavStyle != "bottom" && NavStyle != "hamburger")
            {
                <div class="rv-screen-tabs">
                    @foreach (var scr in NavigableScreens)
                    {
                        var s = scr;
                        <button class="rv-tab @(s == _currentScreen ? "active" : "")"
                                @onclick="() => DoNavigateScreen(s.Name)">
                            @Localization.Resolve(s.Name)
                        </button>
                    }
                </div>
            }
            @if (NavStyle == "hamburger" && NavigableScreens.Count > 1)
            {
                <button class="rv-hamburger-btn" @onclick="() => _hamburgerOpen = true" title="Navigation">&#x2630;</button>
            }

            <div class="rv-status">
                @if (Opc.IsConnected)
                {
                    <span class="rv-badge rv-badge-ok">Connected</span>
                }
                else if (_connecting)
                {
                    <span class="rv-badge rv-badge-warn">Connecting...</span>
                }
                else if (_reconnecting)
                {
                    <span class="rv-badge rv-badge-warn">Reconnecting...</span>
                    <button class="rv-btn" @onclick="StopReconnectTimer" title="Stop auto-reconnect">Stop</button>
                    <button class="rv-btn" @onclick="Connect" title="Try now">Retry Now</button>
                }
                else
                {
                    <span class="rv-badge rv-badge-err">Disconnected</span>
                    <button class="rv-btn" @onclick="Connect">Reconnect</button>
                }
                @if (!string.IsNullOrEmpty(Opc.ErrorMessage))
                {
                    <span class="rv-error" title="@Opc.ErrorMessage">Warning</span>
                }
                <span class="rv-file" title="@Project.ConfigPath">@Path.GetFileName(Project.ConfigPath)</span>

                @if (_loginRequired)
                {
                    <span class="rv-badge" style="background:#555;color:#ccc;" title="@Auth.Group">@Auth.Username</span>
                    <button class="rv-btn" style="background:#dc3545;" @onclick="DoLogout">Logout</button>
                }
                                <button class="rv-btn" style="background:@(CurrentFitMode != "scroll" ? "#2563eb" : "#374151"); font-size:10px;"
                        @onclick="CycleFitMode" title="@FitModeTooltip">@FitModeLabel</button>
<button class="rv-btn" style="background:@(_showDiag ? "#2563eb" : "#374151"); font-size:10px;"
                        @onclick="ToggleDiag" title="OPC Diagnostics">­ƒöì Diag</button>
@if (Project.Settings.EnableTagBrowser)
                {
                    <button class="rv-btn" style="background:@(_showTagBrowser ? "#2563eb" : "#374151"); font-size:10px;"
                            @onclick="ToggleTagBrowser" title="Tag Browser">&#x1F3F7;&#xFE0F; Tags</button>
                }
            </div>
        </div>
    }
    else if (Project.IsKiosk && NavigableScreens.Count > 1 && NavStyle != "bottom")
    {
        @* -- Kiosk: minimal navigation bar (nav only, no status chrome) -- *@
        <div class="rv-topbar rv-topbar-minimal">
            @if (NavStyle == "hamburger")
            {
                <button class="rv-hamburger-btn" @onclick="() => _hamburgerOpen = true" title="Navigation">&#x2630;</button>
            }
            else
            {
                <div class="rv-screen-tabs">
                    @foreach (var scr in NavigableScreens)
                    {
                        var s = scr;
                        <button class="rv-tab @(s == _currentScreen ? "active" : "")"
                                @onclick="() => DoNavigateScreen(s.Name)">
                            @Localization.Resolve(s.Name)
                        </button>
                    }
                </div>
            }
            @if (_loginRequired)
            {
                <span style="flex:1;"></span>
                <span class="rv-badge" style="background:#555;color:#ccc;font-size:10px;">@Auth.Username</span>
                <button class="rv-btn" style="background:#dc3545;font-size:10px;" @onclick="DoLogout">Logout</button>
            }
        </div>
    }
    else if (_loginRequired)
    {
        @* Kiosk mode: small floating logout button (no navigation needed) *@
        <div class="rv-kiosk-logout">
            <span class="small" style="color:#aaa;">@Auth.Username</span>
            <button class="rv-btn" style="background:#dc3545;font-size:10px;" @onclick="DoLogout">Logout</button>
        </div>
    }

    @* -- Diagnostics panel -- *@
    @if (_showDiag)
    {
        <div class="rv-diag-panel">
            <div class="rv-diag-header">
                <span>­ƒöì OPC Diagnostics</span>
                <span style="flex:1;"></span>
                <span class="rv-diag-badge">Session: @(Opc.IsConnected ? "Ô£ô Connected" : "Ô£ù Disconnected")</span>
                <span class="rv-diag-badge">Values: @(_diagValueCount)</span>
                <button class="rv-diag-btn" @onclick="ToggleDiag">Ô£ò Close</button>
            </div>
            <div class="rv-diag-body" @ref="_diagScrollRef">
                @foreach (var line in Opc.DiagnosticLog)
                {
                    var cls = line.Contains("Ô£ù") || line.Contains("FAILED") || line.Contains("Error")
                        ? "rv-diag-err"
                        : line.Contains("Ô£ô") ? "rv-diag-ok"
                        : line.Contains("NOTIFY") ? "rv-diag-notify"
                        : "";
                    <div class="rv-diag-line @cls">@line</div>
                }
                @if (Opc.DiagnosticLog.Count == 0)
                {
                    <div class="rv-diag-line" style="color:#666;">No log entries yet. Waiting for OPC activityÔÇª</div>
                }
            </div>
            <div class="rv-diag-footer">
                <span style="color:#888;font-size:9px;">Live values cache:</span>
                @{ var cachedValues = GetCachedValues(); }
                @if (cachedValues.Count == 0)
                {
                    <span style="color:#666;font-size:9px;margin-left:8px;">empty ÔÇö no values received yet</span>
                }
                else
                {
                    @foreach (var kv in cachedValues.Take(20))
                    {
                        <span class="rv-diag-val"><b>@kv.Key</b> = @kv.Value</span>
                    }
                    @if (cachedValues.Count > 20)
                    {
                        <span style="color:#888;font-size:9px;">ÔÇª +@(cachedValues.Count - 20) more</span>
                    }
                }
            </div>
        </div>
    }

    @* -- Tag Browser panel -- *@
    @if (_showTagBrowser)
    {
        <TagBrowserPanel OnClose="ToggleTagBrowser" />
    }

    @* -- Canvas -- *@
    <div class="rv-viewport">
        @if (_currentScreen != null)
        {
            <ScreenRenderer Screen="_currentScreen" IsKiosk="Project.IsKiosk" BestFit="_bestFit" OnRequestLogin="ShowAccessLoginPrompt" />
        }
        else if (Project.Screens.Count == 0)
        {
            <div class="rv-empty">
                <h3>No screens found</h3>
                <p>The loaded configuration has no screens defined.</p>
                @if (string.IsNullOrEmpty(Project.ConfigPath))
                {
                    <p class="rv-hint">Pass a JSON config path as a command-line argument:<br />
                        <code>dotnet run -- path/to/nodes.json</code></p>
                }
            </div>
        }
    </div>

    @* -- Bottom tab navigation -- *@
    @if (NavStyle == "bottom" && NavigableScreens.Count > 1)
    {
        <div class="rv-bottom-nav">
            @foreach (var scr in NavigableScreens)
            {
                var s = scr;
                <button class="rv-bottom-tab @(s == _currentScreen ? "active" : "")"
                        @onclick="() => DoNavigateScreen(s.Name)">
                    <span class="rv-bottom-tab-icon">&#x1F5BC;</span>
                    <span class="rv-bottom-tab-label">@Localization.Resolve(s.Name)</span>
                </button>
            }
        </div>
    }
</div>

@* -- Hamburger menu overlay -- *@
@if (_hamburgerOpen)
{
    <div class="rv-hamburger-backdrop" @onclick="() => _hamburgerOpen = false"></div>
    <div class="rv-hamburger-menu">
        <div class="rv-hamburger-header">
            <span>Navigation</span>
            <button class="rv-hamburger-close" @onclick="() => _hamburgerOpen = false">&#x2715;</button>
        </div>
        @foreach (var scr in NavigableScreens)
        {
            var s = scr;
            <div class="rv-hamburger-item @(s == _currentScreen ? "active" : "")"
                 @onclick="() => { DoNavigateScreen(s.Name); _hamburgerOpen = false; }">
                <span>&#x1F5BC;</span>
                <span>@Localization.Resolve(s.Name)</span>
            </div>
        }
    </div>
}

@* -- Kiosk fullscreen prompt -- *@
@if (Project.IsKiosk && !_isFullscreen)
{
    <div class="rv-kiosk-prompt" @onclick="EnterFullscreen">
        <div class="rv-kiosk-prompt-box">
            <div class="rv-kiosk-prompt-icon">&#x26F6;</div>
            <div class="rv-kiosk-prompt-text">Click anywhere to enter fullscreen</div>
            <div class="rv-kiosk-prompt-hint">Press Escape to exit fullscreen later</div>
        </div>
    </div>
}

@* -- Popup overlay -- *@
@if (_popupScreen != null)
{
    <div class="rv-popup-backdrop" @onclick="ClosePopup"></div>
    <div class="rv-popup">
        <div class="rv-popup-header">
            <span>@Localization.Resolve(_popupScreen.Name)</span>
            <button class="rv-popup-close" @onclick="ClosePopup">Ô£ò</button>
        </div>
        <div class="rv-popup-body">
            <ScreenRenderer Screen="_popupScreen" OnRequestLogin="ShowAccessLoginPrompt" />
        </div>
    </div>
}

@* -- Modal overlay -- *@
@if (_modalScreen != null)
{
    <div class="rv-modal-backdrop"></div>
    <div class="rv-modal">
        <div class="rv-modal-header">
            <span>@Localization.Resolve(_modalScreen.Name)</span>
            <button class="rv-popup-close" @onclick="CloseModal">Ô£ò</button>
        </div>
        <div class="rv-modal-body">
            <ScreenRenderer Screen="_modalScreen" OnRequestLogin="ShowAccessLoginPrompt" />
        </div>
    </div>
}

@* -- Access login prompt (shown when clicking a locked symbol) -- *@
@if (_showAccessLogin)
{
    <div class="rv-login-overlay rv-login-overlay-access" @onclick="DismissAccessLogin">
        <div class="rv-login-card" @onclick:stopPropagation>
            <div class="rv-login-header">
                <span>­ƒöÆ</span>
                <span>Authentication Required</span>
            </div>
            <div class="rv-login-body">
                <div class="rv-login-hint">This action requires write access. Please sign in.</div>
                @if (!string.IsNullOrEmpty(_loginError))
                {
                    <div class="rv-login-error">@_loginError</div>
                }
                <div class="rv-login-field">
                    <label>Username</label>
                    <input type="text" @bind="_loginUsername" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter username" autofocus />
                </div>
                <div class="rv-login-field">
                    <label>Password</label>
                    <input type="password" @bind="_loginPassword" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter password" />
                </div>
                <button class="rv-login-btn" @onclick="DoAccessLogin" disabled="@_loginBusy">
                    @if (_loginBusy)
                    {
                        <span>Signing inÔÇª</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
                <button class="rv-login-btn-cancel" @onclick="DismissAccessLogin">Cancel</button>
            </div>
        </div>
    </div>
}

@* -- Numeric Pad -- *@
@if (_showNumericPad)
{
    <div class="rv-pad-backdrop" @onclick="ClosePad"></div>
    <div class="rv-pad">
        <div class="rv-pad-header">
            <span>#️⃣ Numeric Pad</span>
            <span class="rv-pad-path">@_padVariablePath</span>
            <button class="rv-popup-close" @onclick="ClosePad">✕</button>
        </div>
        <div class="rv-pad-display">
            <input type="text" class="rv-pad-input" @bind="_padInputValue" @onkeydown="OnPadKeyDown" />
        </div>
        <div class="rv-pad-keys">
            <button class="rv-pad-key" @onclick="() => PadAppend("7")">7</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("8")">8</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("9")">9</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("4")">4</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("5")">5</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("6")">6</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("1")">1</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("2")">2</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("3")">3</button>
            <button class="rv-pad-key rv-pad-fn" @onclick="PadToggleSign">+/-</button>
            <button class="rv-pad-key" @onclick="() => PadAppend("0")">0</button>
            <button class="rv-pad-key" @onclick="() => PadAppend(".")">.</button>
