@* -- Toast notifications -- *@
@if (_toasts.Count > 0)
{
    <div class="rv-toast-container">
        @foreach (var toast in _toasts)
        {
            var t = toast;
            <div class="rv-toast rv-toast-@t.Type @(t.FadeOut ? "rv-toast-fade-out" : "")">
                <span class="rv-toast-icon">@ToastIcon(t.Type)</span>
                <div class="rv-toast-body">
                    <div class="rv-toast-title">@t.Title</div>
                    @if (!string.IsNullOrEmpty(t.Message))
                    {
                        <div class="rv-toast-message">@t.Message</div>
                    }
                </div>
                <button class="rv-toast-close" @onclick="() => DismissToast(t.Id)">&#x2715;</button>
            </div>
        }
    </div>
}

} @* end else (authenticated) *@

@code {
    [Parameter] public string? ScreenName { get; set; }

    [Inject] private ProjectService Project { get; set; } = default!;
    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;
    [Inject] private CommandService Commands { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private RuntimeAuthService Auth { get; set; } = default!;
    [Inject] private LocalizationService Localization { get; set; } = default!;

    private ScreenConfig? _currentScreen;
    private ScreenConfig? _popupScreen;
    private ScreenConfig? _modalScreen;
    private bool _connecting;
    private bool _isFullscreen;
    private IJSObjectReference? _kioskModule;

    // Login state
    private bool _loginRequired;
    private bool _showAccessLogin;
    private string _loginUsername = "";
    private string _loginPassword = "";
    private string _loginError = "";
    private bool _loginBusy;

    // Change password state
    private string _changePwCurrent = "";
    private string _changePwNew = "";
    private string _changePwConfirm = "";
    private string _changePwError = "";
    private string _changePwSuccess = "";

    // Idle auto-logoff
    private DateTime _lastActivity = DateTime.UtcNow;
    private System.Threading.Timer? _idleTimer;
    private DotNetObjectReference<Home>? _idleRef;

    // Toast notifications
    private List<ToastItem> _toasts = new();
    private int _toastId;
    private bool _hamburgerOpen;

    // Tag Browser
    private bool _showTagBrowser;

    // Input Pads
    private bool _showNumericPad;
    private bool _showAlphaNumericPad;
    private string _padVariablePath = "";
    private string _padInputValue = "";

    // Auto-reconnect
    private System.Threading.Timer? _reconnectTimer;
    private bool _reconnecting;
    private static readonly TimeSpan ReconnectInterval = TimeSpan.FromSeconds(5);

    // Retry timer for monitored items that failed because the server was
    // still loading its address space (deferred loading).
    private System.Threading.Timer? _itemRetryTimer;

    // Fit mode
    private bool _bestFit = true;
    private bool _showDiag;

    private string CurrentFitMode => _currentScreen?.FitMode is "contain" or "fill" or "scroll"
        ? _currentScreen.FitMode
        : (_bestFit ? "contain" : "scroll");

    private string FitModeLabel => CurrentFitMode switch
    {
        "contain" => "\u25a3 Contain",
