    // ÔöÇÔöÇÔöÇ Login / Logout ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    private async Task OnLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        _loginError = "";
        _loginBusy = true;
        StateHasChanged();

        await Task.Delay(100); // UI feedback

        var model = Project.Model;
        if (model == null)
        {
            _loginError = "No project loaded.";
            _loginBusy = false;
            return;
        }

        var (success, message) = Auth.Login(_loginUsername, _loginPassword, model.Users, model.UserGroups);
        _loginBusy = false;

        if (success)
        {
            _opcPassword = _loginPassword;
            _loginError = "";
            _loginUsername = "";
            _loginPassword = "";
            _lastActivity = DateTime.UtcNow;
            ShowToast("success", "Signed In", $"Welcome, {Auth.Username}.");

            // (Re)connect to OPC with the authenticated credentials
            if (!Opc.IsConnected && !string.IsNullOrEmpty(Project.Settings.EndpointUrl))
                await Connect();
        }
        else
        {
            _loginError = message;
        }
    }

    private void DoLogout()
    {
        ShowToast("info", "Signed Out", "You have been logged out.");
        Auth.Logout();
        _opcPassword = null;
        _popupScreen = null;
        _modalScreen = null;
        _loginUsername = "";
        _loginPassword = "";
        _loginError = "";

        // Disconnect OPC when anonymous is not allowed
        if (!Project.Settings.EnableAnonymous)
        {
            StopReconnectTimer();
            Opc.Disconnect();
        }
    }

