    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Project.IsKiosk)
        {
            _kioskModule = await JS.InvokeAsync<IJSObjectReference>("import", "./kiosk.js");
            _isFullscreen = await _kioskModule.InvokeAsync<bool>("isFullscreen");
            StateHasChanged();
        }

        if (firstRender && _loginRequired)
        {
            // Register idle activity tracking via JS interop
            _idleRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("eval", """
                window.__rvSetupIdle = function(dotNetRef) {
                    window.__rvIdleRef = dotNetRef;
                    var handler = function() { dotNetRef.invokeMethodAsync('OnUserActivity'); };
                    document.addEventListener('mousemove', handler);
                    document.addEventListener('keydown', handler);
                    document.addEventListener('click', handler);
                    document.addEventListener('touchstart', handler);
                };
            """);
            await JS.InvokeVoidAsync("__rvSetupIdle", _idleRef);

            // Start idle check timer (every 5 seconds)
            _idleTimer = new System.Threading.Timer(CheckIdleTimeout, null, 5000, 5000);
        }
    }

    [JSInvokable]
    public void OnUserActivity()
    {
        _lastActivity = DateTime.UtcNow;
    }

    private void CheckIdleTimeout(object? state)
    {
        if (!Auth.IsAuthenticated || Auth.AutoLogOffSeconds <= 0) return;

        var idleSeconds = (DateTime.UtcNow - _lastActivity).TotalSeconds;
        if (idleSeconds >= Auth.AutoLogOffSeconds)
        {
            InvokeAsync(() =>
            {
                DoLogout();
                ShowToast("warning", "Session Expired", "You have been logged out due to inactivity.");
                _loginError = "You have been logged out due to inactivity.";
                StateHasChanged();
            });
        }
    }

    private async Task EnterFullscreen()
    {
        if (_kioskModule != null)
        {
            await _kioskModule.InvokeVoidAsync("enterFullscreen");
            _isFullscreen = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ScreenName))
        {
            _currentScreen = Project.Screens.FirstOrDefault(s =>
                s.Name.Equals(ScreenName, StringComparison.OrdinalIgnoreCase));
        }

        _currentScreen ??= Project.StartupScreen;

        if (!Opc.IsConnected && !_connecting && !string.IsNullOrEmpty(Project.Settings.EndpointUrl))
        {
            // When anonymous is disabled, wait for the user to log in first
            if (!Project.Settings.EnableAnonymous && _loginRequired && !Auth.IsAuthenticated)
                return;
            await Connect();
        }
    }

    private string? _opcPassword;

    private async Task Connect()
    {
        _connecting = true;
        StateHasChanged();

        // When anonymous access is disabled, use the logged-in user's credentials
        if (Auth.IsAuthenticated && !(Project.Settings.EnableAnonymous))
            await Opc.ConnectAsync(Project.Settings.EndpointUrl, Auth.Username, _opcPassword);
        else
            await Opc.ConnectAsync(Project.Settings.EndpointUrl);

        _connecting = false;
        if (Opc.IsConnected)
        {
            StopReconnectTimer();
            ShowToast("success", "Connected", "OPC server connection established.");
            StartItemRetryTimer();
        }
        else
        {
            if (!_reconnecting)
                ShowToast("error", "Connection Failed", Opc.ErrorMessage ?? "Unable to connect. Retrying...");
            StartReconnectTimer();
        }
        StateHasChanged();
    }

    private void StartReconnectTimer()
    {
        if (_reconnectTimer != null) return;
        _reconnecting = true;
        _reconnectTimer = new System.Threading.Timer(OnReconnectTick, null, ReconnectInterval, ReconnectInterval);
    }

    private void StopReconnectTimer()
    {
        _reconnecting = false;
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
    }

    private void OnReconnectTick(object? state)
    {
        _ = InvokeAsync(async () =>
        {
            if (Opc.IsConnected || _connecting) return;
            await Connect();
        });
    }

    private void StartItemRetryTimer()
    {
        _itemRetryTimer?.Dispose();
        _itemRetryTimer = new System.Threading.Timer(OnItemRetryTick, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void StopItemRetryTimer()
    {
        _itemRetryTimer?.Dispose();
        _itemRetryTimer = null;
    }

    private void OnItemRetryTick(object? state)
    {
        _ = InvokeAsync(() =>
        {
            if (!Opc.IsConnected || !Opc.HasFailedMonitoredItems)
            {
                StopItemRetryTimer();
                return;
            }
            Opc.RetryFailedMonitoredItems();
            StateHasChanged();
        });
    }

