    private void ClosePad()
    {
        _showNumericPad = false;
        _showAlphaNumericPad = false;
        _padVariablePath = "";
        _padInputValue = "";
    }

    private async Task SubmitPadValue()
    {
        if (!string.IsNullOrEmpty(_padVariablePath))
            await Opc.WriteValueAsync(_padVariablePath, _padInputValue);
        ClosePad();
    }

    private void PadAppend(string ch)
    {
        _padInputValue += ch;
    }

    private void PadBackspace()
    {
        if (_padInputValue.Length > 0)
            _padInputValue = _padInputValue[..^1];
    }

    private void PadClear()
    {
        _padInputValue = "";
    }

    private void PadToggleSign()
    {
        if (_padInputValue.StartsWith("-"))
            _padInputValue = _padInputValue[1..];
        else
            _padInputValue = "-" + _padInputValue;
    }

    private async Task OnPadKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitPadValue();
        else if (e.Key == "Escape") ClosePad();
    }

    // ÔöÇÔöÇÔöÇ Change Password ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ

    private async Task OnChangePwKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoChangePassword();
    }

    private Task DoChangePassword()
    {
        _changePwError = "";
        _changePwSuccess = "";

        var requireStrong = Project.Model?.Server?.RequireStrongPassword ?? false;
        var (success, message) = Auth.ChangePassword(_changePwCurrent, _changePwNew, _changePwConfirm, requireStrong);
        if (success)
        {
            _changePwSuccess = message;
            _changePwCurrent = "";
            _changePwNew = "";
            _changePwConfirm = "";
            ShowToast("success", "Password Changed", message);
            // Persist the password change to the nodes.json file
            SaveProjectQuietly();
        }
        else
        {
            _changePwError = message;
        }

        return Task.CompletedTask;
    }

    private void SaveProjectQuietly()
    {
        try
        {
            var model = Project.Model;
            if (model != null && !string.IsNullOrEmpty(Project.ConfigPath))
            {
                var options = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
                var json = System.Text.Json.JsonSerializer.Serialize(model, options);
                File.WriteAllText(Project.ConfigPath, json);
            }
        }
        catch { /* best effort */ }
    }

    private void ToggleDiag()
    {
        _showDiag = !_showDiag;
        if (_showDiag)
        {
            Opc.StateChanged += OnDiagStateChanged;
            _diagTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(() =>
                {
                    _diagValueCount = GetCachedValues().Count;
                    StateHasChanged();
                });
            }, null, 500, 1000);
        }
        else
        {
            Opc.StateChanged -= OnDiagStateChanged;
            _diagTimer?.Dispose();
            _diagTimer = null;
        }
    }

    private void OnDiagStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleTagBrowser()
    {
        _showTagBrowser = !_showTagBrowser;
    }

    private List<KeyValuePair<string, string>> GetCachedValues()
    {
        // Collect all known variable paths from current screen and read their cached values
        var result = new List<KeyValuePair<string, string>>();
        if (_currentScreen == null) return result;

        var paths = _currentScreen.Symbols
            .Where(s => !string.IsNullOrEmpty(s.VariablePath))
            .Select(s => s.VariablePath!)
            .Distinct();

        foreach (var p in paths)
        {
            var v = Opc.GetValue(p);
            result.Add(new KeyValuePair<string, string>(p, v ?? "(null)"));
        }
        return result;
    }

    // ÔöÇÔöÇÔöÇ Toast helpers ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
    private record ToastItem(int Id, string Type, string Title, string Message, bool FadeOut = false);

    private void ShowToast(string type, string title, string message = "")
    {
        var id = ++_toastId;
        _toasts.Add(new ToastItem(id, type, title, message));
        _ = AutoDismissToast(id);
    }

    private async Task AutoDismissToast(int id)
    {
        await Task.Delay(4000);
        await InvokeAsync(() => { FadeOutToast(id); StateHasChanged(); });
        await Task.Delay(300);
        await InvokeAsync(() => { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); });
    }

    private void FadeOutToast(int id)
    {
        var idx = _toasts.FindIndex(t => t.Id == id);
        if (idx >= 0) _toasts[idx] = _toasts[idx] with { FadeOut = true };
    }

    private void DismissToast(int id)
    {
        _toasts.RemoveAll(t => t.Id == id);
    }

    private string ToastIcon(string type) => type switch
    {
        "success" => "\u2705",
        "error" => "\u274C",
        "warning" => "\u26A0\uFE0F",
        _ => "\u2139\uFE0F"
    };

    private List<ScreenConfig> NavigableScreens => Project.Screens.Where(s => s.ShowInNavigation).ToList();
    private string NavStyle => Project.Settings.NavigationStyle?.ToLowerInvariant() ?? "tabs";

    public async void Dispose()
    {
        Commands.NavigateScreen -= DoNavigateScreen;
        Commands.OpenScreenPopup -= DoOpenPopup;
        Commands.OpenScreenModal -= DoOpenModal;
        Commands.RequestLogin -= OnCommandLogin;
        Commands.RequestLogout -= OnCommandLogout;
        Commands.ChangeLanguage -= OnChangeLanguage;
        Commands.RequestNumericPad -= OnRequestNumericPad;
        Commands.RequestAlphaNumericPad -= OnRequestAlphaNumericPad;
        Opc.StateChanged -= OnDiagStateChanged;
        _idleTimer?.Dispose();
        _reconnectTimer?.Dispose();
        _itemRetryTimer?.Dispose();
        _diagTimer?.Dispose();
        _idleRef?.Dispose();
        if (_kioskModule != null)
        {
            try { await _kioskModule.DisposeAsync(); } catch { }
        }
    }
