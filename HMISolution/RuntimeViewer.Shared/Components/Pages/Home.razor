    private async Task DoAccessLogin()
    {
        _loginError = "";
        _loginBusy = true;
        StateHasChanged();

        await Task.Delay(100);

        var model = Project.Model;
        if (model == null)
        {
            _loginError = "No project loaded.";
            _loginBusy = false;
            return;
        }

        var (success, message) = Auth.Login(_loginUsername, _loginPassword, model.Users, model.UserGroups);
        _loginBusy = false;

        if (success)
        {
            _showAccessLogin = false;
            _loginError = "";
            _loginUsername = "";
            _loginPassword = "";
        }
        else
        {
            _loginError = message;
        }
    }

