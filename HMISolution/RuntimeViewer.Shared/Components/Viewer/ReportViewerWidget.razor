@using SharedModels
@using RuntimeViewer.Shared.Services
@inject OpcRuntimeClient Opc

<div class="rv-report-viewer" style="width: 100%; height: 100%; overflow: auto; background: #0f172a; border-radius: 4px; padding: 8px;"
     @onclick:stopPropagation @onmousedown:stopPropagation>
    <div class="d-flex align-items-center gap-2 mb-2" style="font-size: 12px;">
        <span style="color: #94a3b8;">📄 @ReportName</span>
        <button class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 10px;"
                @onclick="GenerateReport" disabled="@_generating">
            @if (_generating)
            {
                <span>â³ Generating...</span>
            }
            else
            {
                <span>â–¶ Generate</span>
            }
        </button>
        @if (!string.IsNullOrEmpty(_lastGenerated))
        {
            <span style="color: #64748b; font-size: 9px;">Last: @_lastGenerated</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_reportHtml))
    {
        <div class="rv-report-content" style="background: #1e293b; border-radius: 4px; padding: 4px; overflow: auto; max-height: calc(100% - 40px);">
            @((MarkupString)_reportHtml)
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger small py-1 px-2">@_error</div>
    }
    else
    {
        <div style="color: #475569; font-size: 11px; text-align: center; padding: 20px;">
            Click <strong>Generate</strong> to create the report.
        </div>
    }
</div>

@code {
    [Parameter] public string ReportName { get; set; } = "";

    private string? _reportHtml;
    private string? _error;
    private string? _lastGenerated;
    private bool _generating;

    private async Task GenerateReport()
    {
        if (string.IsNullOrWhiteSpace(ReportName) || _generating) return;
        _generating = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Write the report name to the _System.GenerateReport trigger variable
            // The server will detect this write and generate the report
            await Opc.WriteValueAsync("_System.GenerateReport", ReportName);
            // Wait briefly for the server to process
            await Task.Delay(500);
            // Read back the generated HTML from _System.ReportOutput
            var output = Opc.GetValue("_System.ReportOutput." + ReportName);
            if (!string.IsNullOrEmpty(output) && output != "0" && output != "False")
            {
                _reportHtml = output;
            }
            else
            {
                // Fallback: generate a client-side summary from live values
                _reportHtml = await BuildClientSideReportAsync();
            }
            _lastGenerated = DateTime.Now.ToString("HH:mm:ss");
        }
        catch
        {
            // Fallback to client-side report
            _reportHtml = await BuildClientSideReportAsync();
            _lastGenerated = DateTime.Now.ToString("HH:mm:ss");
        }
        finally
        {
            _generating = false;
            StateHasChanged();
        }
    }

    private Task<string> BuildClientSideReportAsync()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<div style='font-family: Segoe UI, sans-serif; color: #e2e8f0; padding: 12px;'>");
        sb.AppendLine($"<h2 style='color: #38bdf8; margin-bottom: 8px;'>📄 {System.Net.WebUtility.HtmlEncode(ReportName)}</h2>");
        sb.AppendLine($"<p style='color: #64748b; font-size: 11px;'>Generated at {DateTime.Now:yyyy-MM-dd HH:mm:ss}</p>");
        sb.AppendLine("<hr style='border-color: #334155; margin: 8px 0;' />");
        sb.AppendLine("<p style='color: #94a3b8; font-size: 12px;'>This report was generated client-side. For full server-side generation with historical data charts, use the <strong>GenerateReport</strong> command action or server-side triggers.</p>");
        sb.AppendLine("</div>");
        return Task.FromResult(sb.ToString());
    }
}