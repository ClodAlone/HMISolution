    private void OnFindReplaceNavigate(string target)
    {
        if (string.IsNullOrEmpty(target)) return;

        if (target.StartsWith("script:"))
        {
            var name = target[7..];
            var node = FindNodeByNameAndType<ScriptNode>(name);
            if (node != null) { Editor.SelectNode(node); _dockContainer?.ActivatePanel("scripteditor"); }
        }
        else if (target.StartsWith("plc:"))
        {
            var name = target[4..];
            var node = FindNodeByNameAndType<PlcProgramNode>(name);
            if (node != null) { Editor.SelectNode(node); _dockContainer?.ActivatePanel("plceditor"); }
        }
        else if (target.StartsWith("screen:"))
        {
            var screenName = target[7..];
            foreach (var root in Editor.RootItems)
            {
                var found = FindScreenNode(root, screenName);
                if (found != null) { Editor.SelectNode(found); _dockContainer?.ActivatePanel("screen"); break; }
            }
        }
        else if (target.StartsWith("variable:"))
        {
            _dockContainer?.ActivatePanel("properties");
        }
        else if (target.StartsWith("json:"))
        {
            _dockContainer?.ActivatePanel("json");
        }
        else if (target.StartsWith("strings:"))
        {
            _dockContainer?.ActivatePanel("strings");
        }
    }

    private T? FindNodeByNameAndType<T>(string name) where T : TreeNode
    {
        foreach (var root in Editor.RootItems)
        {
            var found = FindNodeByNameAndType<T>(root, name);
            if (found != null) return found;
        }
        return null;
    }

    private static T? FindNodeByNameAndType<T>(TreeNode node, string name) where T : TreeNode
    {
        if (node is T typed && typed.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
            return typed;
        foreach (var child in node.Children)
        {
            var found = FindNodeByNameAndType<T>(child, name);
            if (found != null) return found;
        }
        return null;
    }

    public void Dispose()
    {
        Editor.StateChanged -= OnEditorStateChanged;
        Editor.ScreenSelectionChanged -= OnScreenSelectionChanged;
        Editor.ReportSectionSelectionChanged -= OnReportSectionSelectionChanged;
        Theme.ThemeChanged -= OnThemeChanged;
        UndoRedo.StateChanged -= OnUndoRedoStateChanged;
        PropertyGrid.OnPropertySet -= OnPropertyGridValueSet;
        L.LocaleChanged -= OnLocaleChanged;
        _serverLogService.Dispose();
        _appLogService.Dispose();
        _shortcutRef?.Dispose();
        _idleTimer?.Dispose();
        _idleRef?.Dispose();
    }
}
