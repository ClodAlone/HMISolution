// ─── Rename ─────────────────────────────────────────────
private TreeNode? _renameNode;
private string _renameText = "";
private bool _renameDialogVisible;
private int _renameRefCount;

private void OnRenameNode(TreeNode node)
{
    if (node is not (VariableNode or FolderNode)) return;
    _renameNode = node;
    _renameText = node.Name;
    _renameRefCount = 0;
    _renameDialogVisible = true;
}

private void CommitRename()
{
    if (_renameNode != null && !string.IsNullOrWhiteSpace(_renameText) && _renameText != _renameNode.Name)
    {
        _renameRefCount = Editor.RenameVariableOrFolder(_renameNode, _renameText.Trim());
        var msg = _renameRefCount > 0
            ? $"Renamed. Updated {_renameRefCount} reference(s) across the project."
            : "Renamed. No references found to update.";
        _renameDialogVisible = false;
        _renameNode = null;
        ShowToast(true, msg);
        return;
    }
    _renameDialogVisible = false;
    _renameNode = null;
}

private void OnRenameKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
{
    if (e.Key == "Enter") CommitRename();
    else if (e.Key == "Escape") CancelRename();
}

private void CancelRename()
{
    _renameDialogVisible = false;
    _renameNode = null;
}

private void OnDelete(TreeNode node)
{
    // If the right-clicked node is part of multi-selection, delete all selected
    if (!Editor.SelectedItems.Contains(node))
