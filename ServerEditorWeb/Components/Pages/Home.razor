private void UnsavedDialogSave()
{
    if (_pendingCloseProject is { } proj)
    {
        var wasActive = Editor.ActiveProject;
        if (wasActive != proj)
            Editor.SetActiveProject(proj);

        var (success, msg) = Editor.Save();
        ShowToast(success, msg);
        if (success)
        {
            _appLogService.AddLog("INF", msg);
            Editor.CloseProject(proj);
        }

        if (wasActive != null && wasActive != proj && Editor.OpenProjects.Contains(wasActive))
            Editor.SetActiveProject(wasActive);
    }
    _showUnsavedDialog = false;
    _pendingCloseProject = null;
}

