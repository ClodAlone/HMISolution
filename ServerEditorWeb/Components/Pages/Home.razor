    // ─── Auth helpers ───────────────────────────────────────

    private void OnLoginResult(bool success)
    {
        if (success)
        {
            _appLogService.AddLog("INF", $"User '{Auth.Username}' logged in ({Auth.AccessLevel}).");
            _lastActivity = DateTime.UtcNow;
            StateHasChanged();
        }
    }

    private void Logout()
    {
        var user = Auth.Username;
        Auth.Logout();
        _appLogService.AddLog("INF", $"User '{user}' logged out.");
        _requiresLogin = AuthService.IsLoginRequired(Editor.RootModel);
    }

    // ─── Change Password ────────────────────────────────────

    private async Task OnChangePwKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoChangePassword();
    }

    private Task DoChangePassword()
    {
        _changePwError = "";
        _changePwSuccess = "";

        var requireStrong = Editor.RootModel?.Server?.RequireStrongPassword ?? false;
        var (success, message) = Auth.ChangePassword(_changePwCurrent, _changePwNew, _changePwConfirm, requireStrong);
        if (success)
        {
            _changePwSuccess = message;
            _changePwCurrent = "";
            _changePwNew = "";
            _changePwConfirm = "";
            // Persist the password change
            Editor.MarkChanged();
            Editor.Save();
        }
        else
        {
            _changePwError = message;
        }

        return Task.CompletedTask;
    }

    private void OnLibrarySymbolSelected(SymbolLibraryItem item)
    {
        // Find the active screen from the selected node, or the screen editor panel context
        var screenNode = Editor.SelectedItem as ScreenNode;
        if (screenNode?.Screen == null)
        {
            // Try to find any screen node in the tree
            _appLogService.AddLog("WRN", "Select a Screen node to add a library symbol.");
            return;
        }

        var screen = screenNode.Screen;
        var sym = new ScreenSymbol
        {
            Id = $"sym_{screen.Symbols.Count + 1}_{DateTime.Now.Ticks}",
            Type = "svg",
            X = 50 + screen.Symbols.Count * 20 % Math.Max(1, screen.Width - 100),
            Y = 50 + screen.Symbols.Count * 20 % Math.Max(1, screen.Height - 80),
            Width = item.DefaultWidth,
            Height = item.DefaultHeight,
            Label = item.Name,
            SvgContent = item.SvgContent,
            Fill = "none",
            Stroke = "#333333"
        };

        screen.Symbols.Add(sym);
        Editor.MarkChanged();
        _dockContainer?.ShowPanel("screen", "center");
    }

