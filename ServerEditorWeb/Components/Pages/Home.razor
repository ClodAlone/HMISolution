    [JSInvokable]
    public void OnKeyboardPaste()
    {
        Editor.PasteFromClipboard(Clipboard);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnKeyboardSave()
    {
        Save();
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnKeyboardOpen()
    {
        OpenFileBrowser();
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnKeyboardUndo()
    {
        PerformUndo();
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnKeyboardRedo()
    {
        PerformRedo();
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnKeyboardEscape()
    {
        if (_dockContainer != null)
        {
            if (_dockContainer.IsMaximized)
                _dockContainer.ToggleMaximize();
        }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnKeyboardDelete()
    {
        // If a screen editor has selected symbols, delete those; otherwise delete the tree node
        if (Editor.SelectedScreenSymbols.Count > 0)
        {
            _screenEditorPanel?.DeleteSelectedFromKeyboard();
        }
        else if (CanDeleteSelection())
        {
            Delete();
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Editor.StateChanged -= OnEditorStateChanged;
        Editor.ScreenSelectionChanged -= OnScreenSelectionChanged;
        Theme.ThemeChanged -= OnThemeChanged;
        UndoRedo.StateChanged -= OnUndoRedoStateChanged;
        PropertyGrid.OnPropertySet -= OnPropertyGridValueSet;
        _serverLogService.Dispose();
        _appLogService.Dispose();
        _shortcutRef?.Dispose();
        _idleTimer?.Dispose();
        _idleRef?.Dispose();
    }
