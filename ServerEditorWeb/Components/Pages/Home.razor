    {
        if (UndoRedo.Redo())
        {
            Editor.MarkChanged();
        }
    }

    // ─── Auth helpers ───────────────────────────────────────

    private void OnLoginResult(bool success)
    {
        if (success)
        {
            _appLogService.AddLog("INF", $"User '{Auth.Username}' logged in ({Auth.AccessLevel}).");
            _lastActivity = DateTime.UtcNow;
            StateHasChanged();
        }
        else
        {
            // User cancelled login - close the project that required it
            var proj = Editor.ActiveProject;
            if (proj != null)
            {
                Editor.CloseProject(proj);
            }
            _requiresLogin = false;
            StateHasChanged();
        }
    }

    private void Logout()
    {
        var user = Auth.Username;
        Auth.Logout();
        _appLogService.AddLog("INF", $"User '{user}' logged out.");
        _requiresLogin = AuthService.IsLoginRequired(Editor.RootModel);
    }

    // ─── Change Password ────────────────────────────────────

    private async Task OnChangePwKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoChangePassword();
    }

    private Task DoChangePassword()
    {
        _changePwError = "";
        _changePwSuccess = "";

        var requireStrong = Editor.RootModel?.Server?.RequireStrongPassword ?? false;
        var (success, message) = Auth.ChangePassword(_changePwCurrent, _changePwNew, _changePwConfirm, requireStrong);
        if (success)
        {
            _changePwSuccess = message;
            _changePwCurrent = "";
            _changePwNew = "";
            _changePwConfirm = "";
            // Persist the password change
            Editor.MarkChanged();
            Editor.Save();
        }
        else
        {
            _changePwError = message;
        }

        return Task.CompletedTask;
    }

    // --- Project Lock / Unlock helpers --------------------------

    private void OpenUnlockDialog()
    {
        CloseMenus();
        _unlockPassword = "";
        _unlockError = "";
        _showUnlockDialog = true;
    }

    private async Task OnUnlockKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            DoUnlockProject();
    }

    private void DoUnlockProject()
    {
        var (success, msg) = Editor.UnlockProject(_unlockPassword);
        if (success)
        {
            _showUnlockDialog = false;
            _unlockPassword = "";
            _unlockError = "";
            _appLogService.AddLog("INF", "Project unlocked.");
            ShowToast(true, "Project unlocked.");
        }
        else
        {
            _unlockError = msg;
        }
    }

    private void LockProjectMenu()
    {
        CloseMenus();
        Editor.LockProject();
        _appLogService.AddLog("INF", "Project locked.");
        ShowToast(true, "Project locked.");
    }

    private void OpenSetPasswordDialog()
    {
        CloseMenus();
        _setPwCurrent = "";
        _setPwNew = "";
        _setPwConfirm = "";
        _setPwError = "";
        _setPwSuccess = "";
        _showSetPasswordDialog = true;
    }

    private void OpenRemovePasswordDialog()
    {
        CloseMenus();
        _setPwCurrent = "";
        _setPwNew = "";
        _setPwConfirm = "";
        _setPwError = "";
        _setPwSuccess = "";
        _showSetPasswordDialog = true;
        // The dialog handles removal when new password is left empty
    }

    private void CloseSetPasswordDialog()
    {
        _showSetPasswordDialog = false;
        _setPwError = "";
        _setPwSuccess = "";
    }

    private async Task OnSetPwKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            DoSetProjectPassword();
    }

    private void DoSetProjectPassword()
    {
        _setPwError = "";
        _setPwSuccess = "";

        if (!string.IsNullOrEmpty(_setPwNew) && _setPwNew != _setPwConfirm)
        {
            _setPwError = "Passwords do not match.";
            return;
        }

        if (!string.IsNullOrEmpty(_setPwNew) && _setPwNew.Length < 4)
        {
            _setPwError = "Password must be at least 4 characters.";
            return;
        }

        var (success, msg) = Editor.SetProjectPassword(_setPwNew, _setPwCurrent);
        if (success)
        {
            _setPwSuccess = msg;
            _setPwCurrent = "";
            _setPwNew = "";
            _setPwConfirm = "";
            _appLogService.AddLog("INF", msg);
            Editor.Save();
            ShowToast(true, msg);
            // Close after a brief moment so the user sees the success message
            _showSetPasswordDialog = false;
        }
        else
        {
            _setPwError = msg;
        }
    }

    /// <summary>Returns true if the active project is locked and shows a toast warning.</summary>
    private bool GuardLocked()
    {
        if (Editor.IsActiveProjectLocked)
        {
            ShowToast(false, "Project is locked. Unlock it first to make changes.");
            return true;
        }
        return false;
    }

    private void OnLibrarySymbolSelected(SymbolLibraryItem item)
    {
        // Find the active screen from the selected node, or the screen editor panel context
        var screenNode = Editor.SelectedItem as ScreenNode;
        if (screenNode?.Screen == null)
        {
            // Try to find any screen node in the tree
            _appLogService.AddLog("WRN", "Select a Screen node to add a library symbol.");
            return;
        }

        var screen = screenNode.Screen;
        var sym = new ScreenSymbol
        {
            Id = $"sym_{screen.Symbols.Count + 1}_{DateTime.Now.Ticks}",
            Type = "svg",
            X = 50 + screen.Symbols.Count * 20 % Math.Max(1, screen.Width - 100),
            Y = 50 + screen.Symbols.Count * 20 % Math.Max(1, screen.Height - 80),
            Width = item.DefaultWidth,
            Height = item.DefaultHeight,
            Label = item.Name,
            SvgContent = item.SvgContent,
            Fill = "none",
            Stroke = "#333333"
        };

        screen.Symbols.Add(sym);
        Editor.MarkChanged();
        _dockContainer?.ShowPanel("screen", "center");
    }

    private void OnToolboxSymbolSelected(string type)
    {
        var screenNode = Editor.SelectedItem as ScreenNode;
        if (screenNode?.Screen == null)
        {
            _appLogService.AddLog("WRN", "Select a Screen node to add a symbol from the Toolbox.");
            return;
        }

        _screenEditorPanel?.AddSymbol(screenNode.Screen, type);
        _dockContainer?.ShowPanel("screen", "center");
    }

    private void RefreshJson()
    {
        Editor.RefreshJsonFromTree();
    }

    private void ApplyJson()
    {
        if (GuardLocked()) return;
        var (success, msg) = Editor.ApplyJsonToTree();
        _jsonEditor?.ShowMessage(success, msg);
    }

    private void OnAiJsonResult(string newJson)
    {
        var oldJson = Editor.JsonEditorText;
        Editor.JsonEditorText = newJson;
        _appLogService.AddLog("INF", "AI response applied.");
        _appLogService.AddLog("DBG", $"JSON Length change: {newJson.Length - oldJson.Length}");
        Editor.DiffText = newJson;
    }

    private void SetupLogDirectory()
    {
        if (!string.IsNullOrEmpty(Editor.CurrentFilePath))
        {
            var dir = Path.GetDirectoryName(Path.GetFullPath(Editor.CurrentFilePath));
            if (dir != null)
            {
                var configName = Path.GetFileNameWithoutExtension(Editor.CurrentFilePath);
                _serverLogService.SetLogDirectory(Path.Combine(dir, "Logs"), $"log-{configName}-*.txt");
            }
        }
    }

    private async void ShowToast(bool success, string message)
    {
        _toastSuccess = success;
        _toast = message;
        StateHasChanged();
        await Task.Delay(3000);
        _toast = "";
        await InvokeAsync(StateHasChanged);
    }

