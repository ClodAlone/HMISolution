    private DotNetObjectReference<Home>? _shortcutRef;

    protected override void OnInitialized()
    {
        Editor.StateChanged += OnEditorStateChanged;
        Editor.ScreenSelectionChanged += OnScreenSelectionChanged;
        Editor.SetUndoService(UndoRedo);
        Theme.ThemeChanged += OnThemeChanged;
        UndoRedo.StateChanged += OnUndoRedoStateChanged;
        PropertyGrid.OnPropertySet += OnPropertyGridValueSet;
        _availableFiles = Editor.GetAvailableFiles();
        _serverLogService.Start();
        _appLogService.AddLog("INF", "Server Editor Web started.");

        if (!string.IsNullOrEmpty(Editor.CurrentFilePath))
        {
            _selectedFile = Editor.CurrentFilePath;
            SetupLogDirectory();
        }

        _requiresLogin = AuthService.IsLoginRequired(Editor.RootModel);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("themeManager.setTheme", Theme.Theme);
            _shortcutRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("editorShortcuts.init", _shortcutRef);

            // Setup idle tracking for auto-logoff
            if (_requiresLogin)
            {
                _idleRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("eval", """
                    window.__edSetupIdle = function(dotNetRef) {
                        var handler = function() { dotNetRef.invokeMethodAsync('OnUserActivity'); };
                        document.addEventListener('mousemove', handler);
                        document.addEventListener('keydown', handler);
                        document.addEventListener('click', handler);
                        document.addEventListener('touchstart', handler);
                    };
                """);
                await JS.InvokeVoidAsync("__edSetupIdle", _idleRef);
                _idleTimer = new System.Threading.Timer(CheckIdleTimeout, null, 5000, 5000);
            }
        }

        // Sync browser beforeunload guard whenever the unsaved state changes
        if (Editor.AnyUnsavedChanges != _lastSyncedUnsaved)
        {
            _lastSyncedUnsaved = Editor.AnyUnsavedChanges;
            await JS.InvokeVoidAsync("editorShortcuts.setUnsavedChanges", _lastSyncedUnsaved);
        }
    }

    [JSInvokable]
    public void OnUserActivity()
    {
        _lastActivity = DateTime.UtcNow;
    }

    private void CheckIdleTimeout(object? state)
    {
        if (!Auth.IsAuthenticated || Auth.AutoLogOffSeconds <= 0) return;

        var idleSeconds = (DateTime.UtcNow - _lastActivity).TotalSeconds;
        if (idleSeconds >= Auth.AutoLogOffSeconds)
        {
            InvokeAsync(() =>
            {
                Logout();
                _appLogService.AddLog("INF", "Auto log-off: session expired due to inactivity.");
                StateHasChanged();
            });
        }
    }

    private async void OnThemeChanged()
    {
        await JS.InvokeVoidAsync("themeManager.setTheme", Theme.Theme);
        await InvokeAsync(StateHasChanged);
    }

    private void OnEditorStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnScreenSelectionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnUndoRedoStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnPropertyGridValueSet(object target, System.Reflection.PropertyInfo property, object? oldValue, object? newValue)
    {
        UndoRedo.RecordPropertyChange(target, property, oldValue, newValue);
    }

    private void LoadFile()
    {
        if (string.IsNullOrEmpty(_selectedFile)) return;
        var (success, msg) = Editor.LoadFromFile(_selectedFile);
        ShowToast(success, msg);
        if (success)
        {
            UndoRedo.Clear();
            SetupLogDirectory();
            _requiresLogin = AuthService.IsLoginRequired(Editor.RootModel);
        }
    }

    private void Save()
    {
        if (GuardLocked()) return;
        if (string.IsNullOrEmpty(Editor.CurrentFilePath))
        {
            // No file path yet — redirect to Save As
            _saveAsPath = "";
            _showSaveAsDialog = true;
            return;
        }
        var (success, msg) = Editor.Save();
        ShowToast(success, msg);
        if (success)
            _appLogService.AddLog("INF", msg);
    }

    private void SaveAs()
    {
        if (GuardLocked()) return;
        if (string.IsNullOrEmpty(_saveAsPath)) return;
        var (success, msg) = Editor.SaveAs(_saveAsPath);
        ShowToast(success, msg);
        if (success)
        {
            _showSaveAsDialog = false;
            _selectedFile = _saveAsPath;
            _availableFiles = Editor.GetAvailableFiles();
            _appLogService.AddLog("INF", msg);
            SetupLogDirectory();
        }
    }

    private void NewFile()
    {
        Editor.NewFile();
        UndoRedo.Clear();
        _selectedFile = "";
        _appLogService.AddLog("INF", "New configuration created.");
    }

    private void SelectNode(TreeNodeClickArgs e)
    {
        Editor.SelectNode(e.Node, e.CtrlKey, e.ShiftKey);
        if (e.Node is not ScreenNode)
            Editor.SetScreenSelection(null, []);
        // Auto-activate the project that owns the clicked node
        var proj = FindAncestorProject(e.Node);
        if (proj != null && !proj.IsActive)
            Editor.SetActiveProject(proj);
    }

    private static ProjectNode? FindAncestorProject(TreeNode? node)
    {
        while (node != null)
        {
            if (node is ProjectNode pn) return pn;
            node = node.Parent;
        }
        return null;
    }

    private void OnNodeDoubleClick(TreeNode node)
    {
        Editor.SelectNode(node);

        var panelId = node switch
        {
            ScreenNode or ScreenGroupNode => "screen",
            UserNode or UserGroupNode or UserGroupListNode => "users",
            ScriptNode => "scripteditor",
            ScriptGroupNode => "json",
            PlcProgramNode pn when pn.PlcProgram.Language.Equals("LD", StringComparison.OrdinalIgnoreCase) => "ladder",
            PlcProgramNode => "plceditor",
            PlcGroupNode => "properties",
            RecipeNode or RecipeGroupNode => "properties",
            SchedulerNode or SchedulerGroupNode => "scheduler",
            ReportNode or ReportGroupNode => "report",
            _ => "properties"
        };

        _dockContainer?.ActivatePanel(panelId);
    }

    private void AddFolder()
    {
        if (GuardLocked()) return;
        if (Editor.SelectedItem is FolderNode or VariableGroupNode)
            Editor.AddFolder();
        else
            Editor.AddResourceFolder();
    }
    private void AddVariable() { if (GuardLocked()) return; Editor.AddVariable(); }
    private void AddScript() { if (GuardLocked()) return; Editor.AddScript(); }
    private void AddPlcProgram() { if (GuardLocked()) return; Editor.AddPlcProgram(); }
    private void AddRecipe() { if (GuardLocked()) return; Editor.AddRecipe(); }
    private void AddScheduler() { if (GuardLocked()) return; Editor.AddScheduler(); }
    private void AddReport() { if (GuardLocked()) return; Editor.AddReport(); }
    private void AddScreen() { if (GuardLocked()) return; Editor.AddScreen(); }
    private void Delete() { if (GuardLocked()) return; Editor.DeleteSelected(); }

    private bool CanAddFolder() => Editor.SelectedItem is FolderNode or VariableGroupNode
        or ScriptGroupNode or PlcGroupNode or ScreenGroupNode or ResourceFolderNode;

    private bool CanCopySelection()
    {
        if (Editor.SelectedItems.Count == 0) return false;
        return Editor.SelectedItems.All(n => n is VariableNode or FolderNode { Parent: not null }
            or ScriptNode or PlcProgramNode or ScreenNode or RecipeNode or SchedulerNode or ReportNode or ResourceFolderNode);
    }

    private bool CanDeleteSelection()
    {
        return Editor.SelectedItems.Any(n => n.Parent != null);
    }

