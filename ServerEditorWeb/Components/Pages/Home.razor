    private async Task LoadFile()
    {
        if (string.IsNullOrEmpty(_selectedFile)) return;

        _isLoadingProject = true;
        _loadingFileName = Path.GetFileName(_selectedFile);
        _loadingStatus = $"Opening {_loadingFileName}\u2026";
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            var (success, msg) = await Editor.OpenProjectAsync(_selectedFile, status =>
            {
                _loadingStatus = status;
                InvokeAsync(StateHasChanged);
            });

            ShowToast(success, msg);
            if (success)
            {
                UndoRedo.Clear();
                SetupLogDirectory();
                _requiresLogin = AuthService.IsLoginRequired(Editor.RootModel);
            }
        }
        finally
        {
            _isLoadingProject = false;
            _loadingStatus = "";
            _loadingFileName = "";
            StateHasChanged();
        }
    }

