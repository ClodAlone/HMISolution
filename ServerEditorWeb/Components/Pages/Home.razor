private void OnSetActiveProject(TreeNode node) { if (node is ProjectNode pn) Editor.SetActiveProject(pn); }
private void OnCloseProject(TreeNode node)
{
    if (node is not ProjectNode pn) return;
    if (pn.HasUnsavedChanges)
    {
        _pendingCloseProject = pn;
        _showUnsavedDialog = true;
    }
    else
    {
        Editor.CloseProject(pn);
    }
}

private void OnFindReferences(TreeNode node)
{
    if (node is not VariableNode vn) return;
    _dockContainer?.ActivatePanel("xref");
    // Build the variable path and trigger search in the panel
    _crossRefPanel?.SearchVariable(BuildVariablePath(vn));
}

private static string BuildVariablePath(VariableNode vn)
{
    var parts = new List<string> { vn.Name };
    TreeNode? current = vn.Parent;
    while (current != null)
    {
        if (current is FolderNode fn)
            parts.Add(fn.Name);
        else if (current is VariableGroupNode)
            break;
        current = current.Parent;
    }
    parts.Reverse();
    return string.Join(".", parts);
}

private async Task OnAddToWatch(TreeNode node)
{
    if (node is not VariableNode vn) return;
    _dockContainer?.ActivatePanel("watch");
    var path = BuildVariablePath(vn);
    if (_watchTablePanel != null)
        await _watchTablePanel.AddVariableExternal(path);
}

private void OnProblemNavigate(string target)
{
    if (target.StartsWith("screen:"))
    {
        var screenName = target[7..];
        // Find screen node in tree and navigate to it
        foreach (var root in Editor.RootItems)
        {
            var found = FindScreenNode(root, screenName);
            if (found != null)
            {
                Editor.SelectNode(found);
                _dockContainer?.ActivatePanel("screen");
                break;
            }
        }
    }
}

private static TreeNode? FindScreenNode(TreeNode node, string name)
{
    if (node is ScreenNode sn && sn.Name.Equals(name, StringComparison.OrdinalIgnoreCase)) return sn;
    foreach (var child in node.Children)
    {
        var found = FindScreenNode(child, name);
        if (found != null) return found;
    }
    return null;
}

private void UnsavedDialogSave()
{
    if (_pendingCloseProject is { } proj)
    {
        var wasActive = Editor.ActiveProject;
        if (wasActive != proj)
            Editor.SetActiveProject(proj);

        var (success, msg) = Editor.Save();
        ShowToast(success, msg);
        if (success)
        {
            _appLogService.AddLog("INF", msg);
            Editor.CloseProject(proj);
        }

        if (wasActive != null && wasActive != proj && Editor.OpenProjects.Contains(wasActive))
            Editor.SetActiveProject(wasActive);
    }
    _showUnsavedDialog = false;
    _pendingCloseProject = null;
}

private void UnsavedDialogDiscard()
{
    if (_pendingCloseProject is { } proj)
        Editor.CloseProject(proj);
    _showUnsavedDialog = false;
    _pendingCloseProject = null;
}

private void UnsavedDialogCancel()
{
    _showUnsavedDialog = false;
    _pendingCloseProject = null;
}

