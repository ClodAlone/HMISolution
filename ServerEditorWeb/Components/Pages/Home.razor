    {
        Theme.Toggle();
        await JS.InvokeVoidAsync("themeManager.setTheme", Theme.Theme);
    }

    private void OnPropertyChanged()
    {
        if (GuardLocked()) return;
        Editor.MarkChanged();
    }

    private void PerformUndo()
    {
        if (UndoRedo.Undo())
        {
            Editor.MarkChanged();
        }
    }

