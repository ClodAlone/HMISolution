    private void DoSetProjectPassword()
    {
        _setPwError = "";
        _setPwSuccess = "";

        if (!string.IsNullOrEmpty(_setPwNew) && _setPwNew != _setPwConfirm)
        {
            _setPwError = "Passwords do not match.";
            return;
        }

        if (!string.IsNullOrEmpty(_setPwNew) && _setPwNew.Length < 4)
        {
            _setPwError = "Password must be at least 4 characters.";
            return;
        }

        var (success, msg) = Editor.SetProjectPassword(_setPwNew, _setPwCurrent);
        if (success)
        {
            _setPwSuccess = msg;
            _setPwCurrent = "";
            _setPwNew = "";
            _setPwConfirm = "";
            _appLogService.AddLog("INF", msg);
            Editor.Save();
            ShowToast(true, msg);
            // Close after a brief moment so the user sees the success message
            _showSetPasswordDialog = false;
        }
        else
        {
            _setPwError = msg;
        }
    }

