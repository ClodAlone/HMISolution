    private void OnAiJsonResult(string newJson)
    {
        var oldJson = Editor.JsonEditorText;
        Editor.JsonEditorText = newJson;
        _appLogService.AddLog("INF", "AI response applied.");
        _appLogService.AddLog("DBG", $"JSON Length change: {newJson.Length - oldJson.Length}");
        Editor.DiffText = newJson;
    }

    private void SetupLogDirectory()
    {
        if (!string.IsNullOrEmpty(Editor.CurrentFilePath))
        {
            var dir = Path.GetDirectoryName(Path.GetFullPath(Editor.CurrentFilePath));
            if (dir != null)
            {
                var configName = Path.GetFileNameWithoutExtension(Editor.CurrentFilePath);
                _serverLogService.SetLogDirectory(Path.Combine(dir, "Logs"), $"log-{configName}-*.txt");
            }
        }
    }

    private async void ShowToast(bool success, string message)
    {
        _toastSuccess = success;
        _toast = message;
        StateHasChanged();
        await Task.Delay(3000);
        _toast = "";
        await InvokeAsync(StateHasChanged);
    }

