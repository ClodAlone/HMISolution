@page "/"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@using ServerEditorWeb.Models
@using ServerEditorWeb.Services
@using SharedModels
@using ServerEditorWeb.Components.Editor
@implements IDisposable

<PageTitle>Server Editor</PageTitle>

@if (_requiresLogin && !Auth.IsAuthenticated)
{
    <LoginDialog OnLoginResult="OnLoginResult" />
}
else if (Auth.MustChangePassword)
{
    @* -- Force Change Password Modal -- *@
    <div class="login-overlay">
        <div class="login-card">
            <div class="login-header">
                <span class="login-icon">🔑</span>
                <h5 class="mb-0">Change Password</h5>
            </div>
            <div class="login-body">
                <p class="text-muted small">You must change your password before continuing.</p>
                <p class="text-muted small fst-italic" style="font-size: 10px;">
                    @(SharedModels.PasswordValidator.GetRequirementsText(Editor.RootModel?.Server?.RequireStrongPassword ?? false))
                </p>
                @if (!string.IsNullOrEmpty(_changePwError))
                {
                    <div class="alert alert-danger py-1 small mb-2">@_changePwError</div>
                }
                @if (!string.IsNullOrEmpty(_changePwSuccess))
                {
                    <div class="alert alert-success py-1 small mb-2">@_changePwSuccess</div>
                }
                <div class="mb-2">
                    <label class="form-label small">Current Password</label>
                    <input type="password" class="form-control" @bind="_changePwCurrent" placeholder="Current password" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">New Password</label>
                    <input type="password" class="form-control" @bind="_changePwNew" placeholder="New password" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Confirm New Password</label>
                    <input type="password" class="form-control" @bind="_changePwConfirm" placeholder="Confirm password"
                           @onkeydown="OnChangePwKeyDown" />
                </div>
                <button class="btn btn-primary w-100" @onclick="DoChangePassword">Change Password</button>
            </div>
        </div>
    </div>
}
else
{
<div class="editor-container">
    @* Menubar *@
    <div class="editor-toolbar">
        @if (_openMenu != null)
        {
            <div class="menubar-backdrop" @onclick="CloseMenus"></div>
        }
        <div class="menubar">
            @* File menu *@
            <div class="menubar-item @(_openMenu == "file" ? "open" : "")" @onclick='() => ToggleMenu("file")' @onmouseenter='() => HoverMenu("file")'>
                File
                @if (_openMenu == "file")
                {
                    <div class="menubar-dropdown">
                        <div class="menu-item" @onclick="NewFileMenu" @onclick:stopPropagation>
                            <span class="menu-icon">📄</span><span class="menu-label">New</span><span class="menu-shortcut">Ctrl+N</span>
                        </div>
                        <div class="menu-separator"></div>
                        <div class="menu-section-label">Open</div>
                        <div class="menu-item" @onclick="OpenFileBrowser" @onclick:stopPropagation>
                            <span class="menu-icon">🗂️</span><span class="menu-label">Browse Server…</span><span class="menu-shortcut">Ctrl+O</span>
                        </div>
                        @foreach (var file in _availableFiles.Take(5))
                        {
                            var f = file;
                            <div class="menu-item" @onclick="() => QuickLoadFile(f)" @onclick:stopPropagation title="@f">
                                <span class="menu-icon"></span><span class="menu-label">@Path.GetFileName(f)</span>
                                <span class="menu-shortcut" style="opacity:.5; font-size:11px;">@Path.GetDirectoryName(f)</span>
                            </div>
                        }
                        @if (Editor.RecentFiles.Count > 0)
                        {
                            <div class="menu-separator"></div>
                            <div class="menu-section-label">Recent</div>
                            @foreach (var file in Editor.RecentFiles.Where(f => !_availableFiles.Contains(f)).Take(5))
                            {
                                var f = file;
                                <div class="menu-item" @onclick="() => QuickLoadFile(f)" @onclick:stopPropagation title="@f">
                                    <span class="menu-icon"></span><span class="menu-label">@Path.GetFileName(f)</span>
                                    <span class="menu-shortcut" style="opacity:.5; font-size:11px;">@Path.GetDirectoryName(f)</span>
                                </div>
                            }
                        }
                        <div class="menu-separator"></div>
                        <div class="menu-item @(!Editor.HasUnsavedChanges ? "disabled" : "")" @onclick="SaveMenu" @onclick:stopPropagation>
                            <span class="menu-icon">💾</span><span class="menu-label">Save</span><span class="menu-shortcut">Ctrl+S</span>
                        </div>
                        <div class="menu-item" @onclick="SaveAsMenu" @onclick:stopPropagation>
                            <span class="menu-icon">💾</span><span class="menu-label">Save As…</span><span class="menu-shortcut">Ctrl+Shift+S</span>
                        </div>
                    </div>
                }
            </div>

            @* Edit menu *@
            <div class="menubar-item @(_openMenu == "edit" ? "open" : "")" @onclick='() => ToggleMenu("edit")' @onmouseenter='() => HoverMenu("edit")'>
                Edit
                @if (_openMenu == "edit")
                {
                    <div class="menubar-dropdown">
                        <div class="menu-item @(Editor.SelectedItem is not (FolderNode or VariableGroupNode) ? "disabled" : "")" @onclick="AddFolderMenu" @onclick:stopPropagation>
                            <span class="menu-icon">📁</span><span class="menu-label">Add Folder</span>
                        </div>
                        <div class="menu-item @(Editor.SelectedItem is not (FolderNode or VariableGroupNode) ? "disabled" : "")" @onclick="AddVariableMenu" @onclick:stopPropagation>
                            <span class="menu-icon">🏷️</span><span class="menu-label">Add Variable</span>
                        </div>
                        <div class="menu-item @(Editor.SelectedItem is not ScriptGroupNode ? "disabled" : "")" @onclick="AddScriptMenu" @onclick:stopPropagation>
                            <span class="menu-icon">⚡</span><span class="menu-label">Add Script</span>
                        </div>
                        <div class="menu-item @(Editor.SelectedItem is not ScreenGroupNode ? "disabled" : "")" @onclick="AddScreenMenu" @onclick:stopPropagation>
                            <span class="menu-icon">🖼️</span><span class="menu-label">Add Screen</span>
                        </div>
                        <div class="menu-separator"></div>
                        @{
                            var canCopy = Editor.SelectedItem is VariableNode or FolderNode { Parent: not null } or ScriptNode or ScreenNode;
                            var canPaste = Clipboard.CanPasteInto(Editor.SelectedItem);
                        }
                        <div class="menu-item @(!canCopy ? "disabled" : "")" @onclick="CopyMenu" @onclick:stopPropagation>
                            <span class="menu-icon">📋</span><span class="menu-label">Copy</span><span class="menu-shortcut">Ctrl+C</span>
                        </div>
                        <div class="menu-item @(!canPaste ? "disabled" : "")" @onclick="PasteMenu" @onclick:stopPropagation>
                            <span class="menu-icon">📌</span><span class="menu-label">Paste</span><span class="menu-shortcut">Ctrl+V</span>
                        </div>
                        <div class="menu-separator"></div>
                        <div class="menu-item danger @(Editor.SelectedItem?.Parent == null ? "disabled" : "")" @onclick="DeleteMenu" @onclick:stopPropagation>
                            <span class="menu-icon">🗑</span><span class="menu-label">Delete</span><span class="menu-shortcut">Del</span>
                        </div>
                    </div>
                }
            </div>

             @* View menu *@
            <div class="menubar-item @(_openMenu == "view" ? "open" : "")" @onclick='() => ToggleMenu("view")' @onmouseenter='() => HoverMenu("view")'>
                View
                @if (_openMenu == "view")
                {
                    <div class="menubar-dropdown">
                        <div class="menu-section-label">Panels</div>
                        @foreach (var p in _panels)
                        {
                            var panel = p;
                            <div class="menu-item" @onclick="() => TogglePanelMenu(panel)" @onclick:stopPropagation>
                                <span class="menu-check">@(panel.Zone != "hidden" ? "✓" : "")</span>
                                <span class="menu-label">@panel.Icon @panel.Title</span>
                            </div>
                        }
                        <div class="menu-separator"></div>
                        <div class="menu-item" @onclick="ToggleMaximize" @onclick:stopPropagation>
                            <span class="menu-check">@(_dockContainer?.IsMaximized == true ? "✓" : "")</span>
                            <span class="menu-label">⬜ Maximize Active Panel</span>
                            <span class="menu-shortcut">Esc</span>
                        </div>
                    </div>
                }
            </div>

            @* Settings menu *@
            <div class="menubar-item @(_openMenu == "settings" ? "open" : "")" @onclick='() => ToggleMenu("settings")' @onmouseenter='() => HoverMenu("settings")'>
                Settings
                @if (_openMenu == "settings")
                {
                    <div class="menubar-dropdown">
                        <div class="menu-section-label">Theme</div>
                        <div class="menu-item" @onclick="SetLightTheme" @onclick:stopPropagation>
                            <span class="menu-check">@(Theme.Theme == "light" ? "●" : "")</span>
                            <span class="menu-label">☀️ Light</span>
                        </div>
                        <div class="menu-item" @onclick="SetDarkTheme" @onclick:stopPropagation>
                            <span class="menu-check">@(Theme.Theme == "dark" ? "●" : "")</span>
                            <span class="menu-label">🌙 Dark</span>
                        </div>
                        <div class="menu-separator"></div>
                        <div class="menu-section-label">Project Protection</div>
                        @if (Editor.IsActiveProjectLocked)
                        {
                            <div class="menu-item" @onclick="OpenUnlockDialog" @onclick:stopPropagation>
                                <span class="menu-icon">🔓</span><span class="menu-label">Unlock Project…</span>
                            </div>
                        }
                        else if (Editor.ActiveProjectHasPassword)
                        {
                            <div class="menu-item" @onclick="LockProjectMenu" @onclick:stopPropagation>
                                <span class="menu-icon">🔒</span><span class="menu-label">Lock Project</span>
                            </div>
                            <div class="menu-item" @onclick="OpenSetPasswordDialog" @onclick:stopPropagation>
                                <span class="menu-icon">🔑</span><span class="menu-label">Change Password…</span>
                            </div>
                            <div class="menu-item danger" @onclick="OpenRemovePasswordDialog" @onclick:stopPropagation>
                                <span class="menu-icon">🗑</span><span class="menu-label">Remove Password…</span>
                            </div>
                        }
                        else
                        {
                            <div class="menu-item @(Editor.RootModel == null ? "disabled" : "")" @onclick="OpenSetPasswordDialog" @onclick:stopPropagation>
                                <span class="menu-icon">🔒</span><span class="menu-label">Set Password…</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="menubar-spacer"></div>

            @* Status area *@
            <div class="menubar-status">
                @if (Auth.IsAuthenticated)
                {
                    <span class="badge bg-info text-dark" style="font-size: 10px;" title="@Auth.AccessLevel access">👤 @Auth.Username</span>
                    <button class="dock-btn" title="Logout" @onclick="Logout" @onclick:stopPropagation>🔓</button>
                }
                @if (Editor.IsActiveProjectLocked)
                {
                    <span class="badge bg-danger" style="font-size: 10px; cursor: pointer;" title="Project is locked — click to unlock" @onclick="OpenUnlockDialog" @onclick:stopPropagation>🔒 Locked</span>
                }
                else if (Editor.ActiveProjectHasPassword)
                {
                    <span class="badge bg-success" style="font-size: 10px;" title="Project is unlocked">🔓 Unlocked</span>
                }
                @if (Editor.HasUnsavedChanges)
                {
                    <span class="badge bg-warning text-dark" style="font-size: 10px;">Unsaved</span>
                }
                @if (!string.IsNullOrEmpty(Editor.CurrentFilePath))
                {
                    <span title="@Editor.CurrentFilePath">@Path.GetFileName(Editor.CurrentFilePath)</span>
                }
                <button class="dock-btn" title="Toggle theme" @onclick="ToggleTheme" @onclick:stopPropagation>
                    @(Theme.Theme == "dark" ? "☀️" : "🌙")
                </button>
            </div>
        </div>
    </div>

    @* Toolbar *@
    <div class="editor-iconbar">
        @* File operations *@
        <button class="iconbar-btn" title="New (Ctrl+N)" @onclick="NewFile">📄</button>
        <button class="iconbar-btn" title="Save (Ctrl+S)" @onclick="Save"
                disabled="@(!Editor.HasUnsavedChanges)">💾</button>
        <button class="iconbar-btn" title="Save As… (Ctrl+Shift+S)" @onclick="() => { _saveAsPath = Editor.CurrentFilePath ?? string.Empty; _showSaveAsDialog = true; }">📥</button>

        <span class="iconbar-sep"></span>

        @* Edit operations *@
        <button class="iconbar-btn" title="@($"Undo{(UndoRedo.UndoDescription != null ? $" — {UndoRedo.UndoDescription}" : "")} (Ctrl+Z)")" @onclick="PerformUndo"
                disabled="@(!UndoRedo.CanUndo)">↩️</button>
        <button class="iconbar-btn" title="@($"Redo{(UndoRedo.RedoDescription != null ? $" — {UndoRedo.RedoDescription}" : "")} (Ctrl+Y)")" @onclick="PerformRedo"
                disabled="@(!UndoRedo.CanRedo)">↪️</button>
        <button class="iconbar-btn" title="Copy (Ctrl+C)" @onclick="() => Editor.CopySelected(Clipboard)"
                disabled="@(!CanCopySelection())">📋</button>
        <button class="iconbar-btn" title="Paste (Ctrl+V)" @onclick="() => Editor.PasteFromClipboard(Clipboard)"
                disabled="@(!Clipboard.CanPasteInto(Editor.SelectedItem))">📌</button>
        <button class="iconbar-btn" title="Delete (Del)" @onclick="Delete"
                disabled="@(!CanDeleteSelection())">🗑️</button>

        <span class="iconbar-sep"></span>

        @* Add operations *@
        <button class="iconbar-btn" title="Add Folder" @onclick="AddFolder"
                disabled="@(!CanAddFolder())">📁</button>
        <button class="iconbar-btn" title="Add Variable" @onclick="AddVariable"
                disabled="@(Editor.SelectedItem is not (FolderNode or VariableGroupNode))">🏷️</button>
        <button class="iconbar-btn" title="Add Script" @onclick="AddScript"
                disabled="@(Editor.SelectedItem is not (ScriptGroupNode or ResourceFolderNode { ResourceKind: "Script" }))">⚡</button>
        <button class="iconbar-btn" title="Add PLC Program" @onclick="AddPlcProgram"
                disabled="@(Editor.SelectedItem is not (PlcGroupNode or ResourceFolderNode { ResourceKind: "PlcProgram" }))">⚙️</button>
        <button class="iconbar-btn" title="Add Recipe" @onclick="AddRecipe"
                disabled="@(Editor.SelectedItem is not RecipeGroupNode)">📦</button>
        <button class="iconbar-btn" title="Add Scheduler" @onclick="AddScheduler"
                disabled="@(Editor.SelectedItem is not SchedulerGroupNode)">📅</button>
        <button class="iconbar-btn" title="Add Report" @onclick="AddReport"
                disabled="@(Editor.SelectedItem is not ReportGroupNode)">📄</button>
        <button class="iconbar-btn" title="Add Screen" @onclick="AddScreen"
                disabled="@(Editor.SelectedItem is not (ScreenGroupNode or ResourceFolderNode { ResourceKind: "Screen" }))">🖼️</button>

        <span class="iconbar-sep"></span>

        @* Layout *@
        <button class="iconbar-btn @(_dockContainer?.IsMaximized == true ? "iconbar-btn-active" : "")"
                title="@(_dockContainer?.IsMaximized == true ? "Restore layout (Esc)" : "Maximize active panel")"
                @onclick="ToggleMaximize">
            @(_dockContainer?.IsMaximized == true ? "🗗" : "⬜")
        </button>
    </div>

    @* Main Content *@
    <div class="editor-main">
        @* Left Panel: Tree (hidden when maximized) *@
        @if (_dockContainer?.IsMaximized != true)
        {
        <div class="editor-tree">
            <TreeView Nodes="Editor.RootItems" SelectedNode="Editor.SelectedItem" OnSelect="SelectNode"
                    OnDoubleClick="OnNodeDoubleClick"
                    OnAddFolder="OnAddFolder" OnAddVariable="OnAddVariable" OnAddScript="OnAddScript"
                    OnAddPlcProgram="OnAddPlcProgram" OnAddRecipe="OnAddRecipe" OnAddScheduler="OnAddScheduler" OnAddReport="OnAddReport"
                    OnAddScreen="OnAddScreen" OnAddUserGroup="OnAddUserGroup" OnAddUser="OnAddUser"
                    OnDelete="OnDelete"
                    OnCopy="OnCopyNode" OnPaste="OnPasteNode"
                    OnSetActiveProject="OnSetActiveProject" OnCloseProject="OnCloseProject" />
        </div>
        }

        @* Dockable Content Area *@
        <DockContainer @ref="_dockContainer" Panels="_panels" OnLayoutChanged="StateHasChanged">
            <PanelContent>
                @if (context.Id == "properties")
                {
                    @if (Editor.SelectedScreenSymbol != null && Editor.SelectedItem is ScreenNode)
                    {
                        <ScreenSymbolProperties OnPropertyChanged="OnPropertyChanged" />
                    }
                    else if (Editor.SelectedItems.Count > 1)
                    {
                        <PropertyGridPanel Nodes="Editor.SelectedItems" OnPropertyChanged="OnPropertyChanged" />
                    }
                    else
                    {
                        <NodeProperties Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                    }
                }
                else if (context.Id == "json")
                {
                    <JsonEditor @ref="_jsonEditor"
                                @bind-JsonText="Editor.JsonEditorText"
                                OnRefresh="RefreshJson"
                                OnApply="ApplyJson"
                                OnAiJsonResult="OnAiJsonResult" />
                }
                else if (context.Id == "server")
                {
                    <ServerPanel NodesPath="@Editor.CurrentFilePath" />
                }
                else if (context.Id == "git")
                {
                    <GitPanel NodesPath="@Editor.CurrentFilePath" />
                }
                else if (context.Id == "opc")
                {
                    <OpcBrowsePanel EndpointUrl="@Editor.ServerEndpointUrl" />
                }
                else if (context.Id == "datalogging")
                {
                    <DataLoggingPanel NodesPath="@Editor.CurrentFilePath" />
                }
                else if (context.Id == "screen")
                {
                    <ScreenEditorPanel @ref="_screenEditorPanel" Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "symbols")
                {
                    <SymbolLibraryPanel OnSymbolSelected="OnLibrarySymbolSelected" />
                }
                else if (context.Id == "toolbox")
                {
                    <ScreenToolboxPanel OnSymbolTypeSelected="OnToolboxSymbolSelected" />
                }
                else if (context.Id == "serverlog")
                {
                    <LogViewer Title="Server Logs" Service="_serverLogService" />
                }
                else if (context.Id == "applog")
                {
                    <LogViewer Title="App Log" Service="_appLogService" />
                }
                else if (context.Id == "users")
                {
                    <UserManagementPanel OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "strings")
                {
                    <StringEditorPanel OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "images")
                {
                    <ImageResourcePanel OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "eventlog")
                {
                    <EventLogSettingsPanel OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "ladder")
                {
                    <LadderEditorPanel Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "scripteditor")
                {
                    <ScriptEditorPanel Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "plceditor")
                {
                    <PlcEditorPanel Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "scheduler")
                {
                    <SchedulerEditorPanel Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "report")
                {
                    <ReportEditorPanel Node="Editor.SelectedItem" OnPropertyChanged="OnPropertyChanged" />
                }
                else if (context.Id == "crashes")
                {
                    <CrashReportsPanel />
                }
            </PanelContent>
        </DockContainer>
    </div>
</div>
} @* end of else (authenticated or no login required) *@

@if (_showSaveAsDialog)
{
    <div class="modal-backdrop show" @onclick="() => _showSaveAsDialog = false"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">💾 Save As</h6>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => _showSaveAsDialog = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">File path:</label>
                    <input type="text" class="form-control form-control-sm" @bind="_saveAsPath"
                           placeholder="C:\path\to\nodes.json" />
                    @if (!string.IsNullOrEmpty(Editor.CurrentFilePath))
                    {
                        <div class="mt-2 small text-muted">
                            Current: <code>@Editor.CurrentFilePath</code>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _showSaveAsDialog = false">Cancel</button>
                    <button class="btn btn-sm btn-success" @onclick="SaveAs" disabled="@string.IsNullOrEmpty(_saveAsPath)">💾 Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showUnsavedDialog && _pendingCloseProject != null)
{
    <div class="modal-backdrop show" @onclick="UnsavedDialogCancel"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">⚠️ Unsaved Changes</h6>
                    <button type="button" class="btn-close btn-close-sm" @onclick="UnsavedDialogCancel"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">The project <strong>@_pendingCloseProject.Name</strong> has unsaved changes. Do you want to save before closing?</p>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-secondary" @onclick="UnsavedDialogCancel">Cancel</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="UnsavedDialogDiscard">Discard</button>
                    <button class="btn btn-sm btn-success" @onclick="UnsavedDialogSave">💾 Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showFileBrowser)
{
    <div class="modal-backdrop show" @onclick="() => _showFileBrowser = false"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">📂 Open Project File</h6>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => _showFileBrowser = false"></button>
                </div>
                <div class="modal-body p-0" style="max-height: 450px; display: flex; flex-direction: column;">
                    @* Address bar *@
                    <div class="d-flex align-items-center gap-1 px-3 py-2 border-bottom" style="background: var(--bg-secondary, #f8f9fa);">
                        <button class="btn btn-sm btn-outline-secondary px-2" title="Up"
                                disabled="@(string.IsNullOrEmpty(_browsePath) || Path.GetDirectoryName(_browsePath) == null)"
                                @onclick="BrowseUp">⬆</button>
                        <input type="text" class="form-control form-control-sm" value="@_browsePath"
                               @onchange="OnBrowsePathChanged" placeholder="Enter path…" />
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary px-2 dropdown-toggle" title="Drives"
                                    @onclick="() => _showDriveList = !_showDriveList" @onclick:stopPropagation>💻</button>
                            @if (_showDriveList)
                            {
                                <div class="dropdown-menu show" style="min-width: 80px;">
                                    @foreach (var drive in _browseDrives)
                                    {
                                        var d = drive;
                                        <button class="dropdown-item small" @onclick="() => BrowseTo(d)" @onclick:stopPropagation>@d</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @* File list *@
                    <div style="overflow-y: auto; flex: 1; min-height: 200px;" @onclick="() => _showDriveList = false">
                        <table class="table table-sm table-hover mb-0" style="font-size: 13px;">
                            <thead>
                                <tr><th style="width: 30px;"></th><th>Name</th><th style="width: 100px;">Size</th></tr>
                            </thead>
                            <tbody>
                                @if (_browseDirs.Length == 0 && _browseFiles.Length == 0)
                                {
                                    <tr><td colspan="3" class="text-center text-muted py-3">
                                        @(string.IsNullOrEmpty(_browsePath) ? "Select a drive or enter a path" : "Empty folder or access denied")
                                    </td></tr>
                                }
                                @foreach (var dir in _browseDirs)
                                {
                                    var d = dir;
                                    var name = Path.GetFileName(d);
                                    <tr class="cursor-pointer" style="cursor: pointer;" @ondblclick="() => BrowseTo(d)">
                                        <td>📁</td><td>@name</td><td></td>
                                    </tr>
                                }
                                @foreach (var file in _browseFiles)
                                {
                                    var f = file;
                                    var name = Path.GetFileName(f);
                                    var size = "";
                                    try { var fi = new FileInfo(f); size = fi.Length < 1024 ? $"{fi.Length} B" : $"{fi.Length / 1024} KB"; } catch { }
                                    var isSelected = f == _browseSelectedFile;
                                    <tr class="@(isSelected ? "table-primary" : "")" style="cursor: pointer;"
                                        @onclick="() => _browseSelectedFile = f"
                                        @ondblclick="() => BrowseLoadFile(f)">
                                        <td>📄</td><td>@name</td><td class="text-muted">@size</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @* Selected file display *@
                    @if (!string.IsNullOrEmpty(_browseSelectedFile))
                    {
                        <div class="px-3 py-1 border-top small text-muted" style="background: var(--bg-secondary, #f8f9fa);">
                            <code>@_browseSelectedFile</code>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _showFileBrowser = false">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="() => BrowseLoadFile(_browseSelectedFile)"
                            disabled="@string.IsNullOrEmpty(_browseSelectedFile)">📂 Open</button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_toast))
