@using ServerEditorWeb.Services
@using SharedModels
@using System.Text.Json
@using System.Text.Json.Serialization

<div class="modal-backdrop show" @onclick="OnClose"></div>
<div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">🚀 New Project</h6>
                <button type="button" class="btn-close btn-close-sm" @onclick="OnClose"></button>
            </div>
            <div class="modal-body p-3">
                @if (_step == WizardStep.ChooseMethod)
                {
                    <p class="text-muted small mb-3">Choose how you want to create your project:</p>

                    <div class="d-flex gap-3 mb-3">
                        <button class="wizard-method-card @(_method == CreateMethod.Template ? "active" : "")"
                                @onclick="() => _method = CreateMethod.Template">
                            <span class="wizard-method-icon">📋</span>
                            <span class="wizard-method-title">From Template</span>
                            <span class="wizard-method-desc">Start from a pre-built project template</span>
                        </button>
                        <button class="wizard-method-card @(_method == CreateMethod.Ai ? "active" : "")"
                                @onclick="() => _method = CreateMethod.Ai">
                            <span class="wizard-method-icon">🤖</span>
                            <span class="wizard-method-title">AI Generated</span>
                            <span class="wizard-method-desc">Describe your project and let AI build it</span>
                        </button>
                        <button class="wizard-method-card @(_method == CreateMethod.Blank ? "active" : "")"
                                @onclick="() => _method = CreateMethod.Blank">
                            <span class="wizard-method-icon">📄</span>
                            <span class="wizard-method-title">Blank Project</span>
                            <span class="wizard-method-desc">Start with an empty configuration</span>
                        </button>
                    </div>

                    @if (_method == CreateMethod.Template)
                    {
                        <h6 class="mb-2">Select a Template</h6>
                        <div class="wizard-template-grid">
                            @foreach (var tmpl in _templates)
                            {
                                var t = tmpl;
                                <button class="wizard-template-card @(_selectedTemplate == t.Id ? "active" : "")"
                                        @onclick="() => _selectedTemplate = t.Id">
                                    <span class="wizard-template-icon">@t.Icon</span>
                                    <span class="wizard-template-name">@t.Name</span>
                                    <span class="wizard-template-desc">@t.Description</span>
                                    <span class="wizard-template-tags">
                                        @foreach (var tag in t.Tags)
                                        {
                                            <span class="badge bg-secondary me-1" style="font-size: 9px;">@tag</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                    }
                    else if (_method == CreateMethod.Ai)
                    {
                        <h6 class="mb-2">Describe Your Project</h6>
                        <div class="mb-2">
                            <label class="form-label small mb-1">AI Engine</label>
                            <select class="form-select form-select-sm" style="width: 200px;"
                                    @bind="_aiEngine">
                                @foreach (var eng in Ai.AvailableEngines)
                                {
                                    <option value="@eng">@eng</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <textarea class="form-control form-control-sm" rows="5"
                                      placeholder="Describe your HMI/SCADA project in natural language. For example:&#10;&#10;• A home automation system with lighting, HVAC, and security sensors for a 3-floor building&#10;• An industrial bottling line with 4 stations, conveyor belt monitoring, and alarm management&#10;• A solar farm monitoring system with 50 inverters, weather station, and energy dashboards"
                                      @bind="_aiPrompt"></textarea>
                        </div>
                        <div class="d-flex gap-2 small text-muted">
                            <span>💡</span>
                            <span>The more detail you provide, the better the result. Include information about equipment, variables, screens, and alarms you need.</span>
                        </div>
                    }
                }
                else if (_step == WizardStep.Generating)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <p class="mb-1">Generating your project...</p>
                        <p class="text-muted small">@_generationStatus</p>
                    </div>
                }
                else if (_step == WizardStep.Error)
                {
                    <div class="alert alert-danger small mb-0">
                        <strong>Error:</strong> @_errorMessage
                    </div>
                }
            </div>
            <div class="modal-footer py-2">
                @if (_step == WizardStep.ChooseMethod)
                {
                    <button class="btn btn-sm btn-secondary" @onclick="OnClose">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="Create"
                            disabled="@(!CanCreate)">
                        @if (_method == CreateMethod.Ai)
                        {
                            <span>🤖 Generate Project</span>
                        }
                        else
                        {
                            <span>✨ Create Project</span>
                        }
                    </button>
                }
                else if (_step == WizardStep.Error)
                {
                    <button class="btn btn-sm btn-secondary" @onclick="() => _step = WizardStep.ChooseMethod">Back</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<NodeModel?> OnCreated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Inject] private AiService Ai { get; set; } = default!;

    private enum WizardStep { ChooseMethod, Generating, Error }
    private enum CreateMethod { Template, Ai, Blank }

    private WizardStep _step = WizardStep.ChooseMethod;
    private CreateMethod _method = CreateMethod.Template;
    private string _selectedTemplate = "home-automation";
    private string _aiEngine = "OpenAI";
    private string _aiPrompt = "";
    private string _generationStatus = "";
    private string _errorMessage = "";

    private bool CanCreate => _method switch
    {
        CreateMethod.Blank => true,
        CreateMethod.Template => !string.IsNullOrEmpty(_selectedTemplate),
        CreateMethod.Ai => !string.IsNullOrWhiteSpace(_aiPrompt),
        _ => false
    };

    private record TemplateInfo(string Id, string Icon, string Name, string Description, string[] Tags);

    private static readonly TemplateInfo[] _templates =
    [
        new("home-automation", "🏠", "Home Automation",
            "Smart home with lighting, HVAC, security, and energy monitoring.",
            ["KNX", "Modbus", "MQTT", "4 Screens"]),
        new("industrial-line", "🏭", "Industrial Production Line",
            "Manufacturing line with conveyors, motors, sensors, and alarm management.",
            ["S7", "Modbus", "Alarms", "6 Screens"]),
        new("building-management", "🏢", "Building Management (BMS)",
            "Commercial building with HVAC zones, lighting schedules, and energy metering.",
            ["BACnet", "Modbus", "Schedulers", "5 Screens"]),
        new("energy-monitoring", "⚡", "Energy Monitoring",
            "Power plant or solar farm with inverters, meters, and performance dashboards.",
            ["Modbus", "HDA", "Charts", "4 Screens"]),
        new("water-treatment", "💧", "Water Treatment",
            "Water/wastewater plant with pumps, valves, flow meters, and chemical dosing.",
            ["Modbus", "Alarms", "Trends", "5 Screens"]),
        new("hvac-system", "❄️", "HVAC System",
            "Heating, ventilation, and air conditioning with AHUs, chillers, and zone control.",
            ["BACnet", "Modbus", "Schedules", "4 Screens"]),
    ];

    private async Task Create()
    {
        switch (_method)
        {
            case CreateMethod.Blank:
                await OnCreated.InvokeAsync(null);
                break;

            case CreateMethod.Template:
                var model = BuildTemplateModel(_selectedTemplate);
                await OnCreated.InvokeAsync(model);
                break;

            case CreateMethod.Ai:
                await GenerateWithAi();
                break;
        }
    }

    private async Task GenerateWithAi()
    {
        _step = WizardStep.Generating;
        _generationStatus = $"Sending request to {_aiEngine}...";
        StateHasChanged();

        try
        {
            // Build a minimal starter JSON as the base
            var baseModel = new NodeModel
            {
                Folder = new Folder { Name = "Root" },
                Server = new ServerSettings(),
                Screens = new List<ScreenConfig>()
            };

            var baseJson = JsonSerializer.Serialize(baseModel, new JsonSerializerOptions { WriteIndented = true });

            var prompt = $"""
                Create a complete OPC UA HMI/SCADA project based on this description:

                {_aiPrompt}

                Generate a full project configuration with:
                1. A well-organized folder hierarchy with realistic variables (Double, Int32, Boolean types) including engineering units
                2. Multiple screens with appropriate widgets (gauges, indicators, charts, alarm lists, trends)
                3. Alarm configurations on critical variables (HighHigh, High, Low, LowLow thresholds)
                4. At least one script for automation logic
                5. Data logging on key process variables
                6. Realistic initial values and appropriate variable access modes (Read, ReadWrite)

                Make variable names clear and descriptive. Use a dark theme (#1a1a2e) for screen backgrounds.
                """;

            _generationStatus = "AI is generating your project...";
            StateHasChanged();

            var (newJson, comments) = await Ai.AskAsync(_aiEngine, prompt, baseJson);

            if (string.IsNullOrWhiteSpace(newJson))
            {
                _step = WizardStep.Error;
                _errorMessage = string.IsNullOrEmpty(comments) ? "AI returned an empty response." : comments;
                return;
            }

            _generationStatus = "Parsing AI response...";
            StateHasChanged();

            var lenientOptions = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                Converters = { new LenientStringConverter() }
            };

            var generatedModel = JsonSerializer.Deserialize<NodeModel>(newJson, lenientOptions);
            if (generatedModel == null)
            {
                _step = WizardStep.Error;
                _errorMessage = "Failed to parse the AI-generated configuration.";
                return;
            }

            await OnCreated.InvokeAsync(generatedModel);
        }
        catch (Exception ex)
        {
            _step = WizardStep.Error;
            _errorMessage = ex.Message;
        }
    }

    /// <summary>Builds a navigation bar of navbuttons across the bottom of each screen.</summary>
    private static void AddNavigationBar(List<ScreenConfig> screens)
    {
        const int btnHeight = 36;
        const int btnGap = 6;
        const int barPadding = 10;
        const int barBottomMargin = 8;

        foreach (var screen in screens)
        {
            var totalBtns = screens.Count;
            var availableWidth = screen.Width - barPadding * 2 - (totalBtns - 1) * btnGap;
            var btnWidth = (int)(availableWidth / totalBtns);
            if (btnWidth > 180) btnWidth = 180;

            var totalBarWidth = totalBtns * btnWidth + (totalBtns - 1) * btnGap;
            var startX = (screen.Width - totalBarWidth) / 2.0;
            var barY = screen.Height - btnHeight - barBottomMargin;

            // Background bar
            screen.Symbols.Add(new ScreenSymbol
            {
                Id = "sym_nav_bar",
                Type = "rect",
                X = 0, Y = barY - 6,
                Width = screen.Width, Height = btnHeight + 18,
                Fill = "#16213e", Stroke = "none", StrokeWidth = 0,
                Label = ""
            });

            for (int i = 0; i < screens.Count; i++)
            {
                var target = screens[i];
                var isCurrent = target.Name == screen.Name;
                screen.Symbols.Add(new ScreenSymbol
                {
                    Id = $"sym_nav_{i}",
                    Type = "navbutton",
                    X = startX + i * (btnWidth + btnGap),
                    Y = barY,
                    Width = btnWidth,
                    Height = btnHeight,
                    Label = target.Name,
                    NavButtonTarget = target.Name,
                    NavButtonStyle = "filled",
                    NavButtonIcon = "",
                    NavButtonIconPosition = "none",
                    NavButtonColor = isCurrent ? "#3b82f6" : "#2a3a5c",
                    NavButtonTextColor = "#ffffff",
                    FontSize = 11,
                    FontWeight = isCurrent ? "bold" : "",
                });
            }
        }
    }
    private static void AddScreenHeader(ScreenConfig screen, string icon, string title)
    {
        screen.Symbols.Add(new ScreenSymbol
        {
            Id = "sym_header_bg", Type = "rect",
            X = 0, Y = 0, Width = screen.Width, Height = 44,
            Fill = "#16213e", Stroke = "none", StrokeWidth = 0, Label = ""
        });
        screen.Symbols.Add(new ScreenSymbol
        {
            Id = "sym_header_title", Type = "text",
            X = 16, Y = 8, Width = screen.Width - 32, Height = 30,
            Fill = "transparent", Stroke = "none", StrokeWidth = 0,
            Label = icon + " " + title,
            FontSize = 18, FontWeight = "bold"
        });
    }

    private static NodeModel BuildTemplateModel(string templateId)
    {
        return templateId switch
        {
            "home-automation" => BuildHomeAutomation(),
            "industrial-line" => BuildIndustrialLine(),
            "building-management" => BuildBuildingManagement(),
            "energy-monitoring" => BuildEnergyMonitoring(),
            "water-treatment" => BuildWaterTreatment(),
            "hvac-system" => BuildHvacSystem(),
            _ => new NodeModel { Folder = new Folder { Name = "Root" }, Server = new ServerSettings() }
        };
    }

