    private static NodeModel BuildIndustrialLine()
    {
        var model = new NodeModel
        {
            Folder = new Folder
            {
                Name = "Root",
                Folders =
                [
                    new Folder
                    {
                        Name = "Conveyor",
                        Variables =
                        [
                            new Variable { Name = "Running", Type = "Boolean", Access = "ReadWrite", Value = false },
                            new Variable { Name = "Speed", Type = "Double", Access = "ReadWrite", Value = 0, EngineeringUnit = "m/min",
                                Alarm = new AlarmConfig { HighHighLimit = 30, HighLimit = 25 },
                                DataLogging = new DataLoggingConfig { Enabled = true } },
                            new Variable { Name = "MotorCurrent", Type = "Double", Access = "Read", Value = 0, EngineeringUnit = "A",
                                Alarm = new AlarmConfig { HighLimit = 15, HighHighLimit = 20 } },
                            new Variable { Name = "ItemCount", Type = "Int32", Access = "Read", Value = 0 },
                            new Variable { Name = "Fault", Type = "Boolean", Access = "Read", Value = false,
                                Alarm = new AlarmConfig { HighLimit = 1 } },
                        ]
                    },
                    new Folder
                    {
                        Name = "Station1_Fill",
                        Variables =
