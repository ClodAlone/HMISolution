@using ServerEditorWeb.Models
@using ServerEditorWeb.Services
@inject IJSRuntime JS
@inject ClipboardService Clipboard

@if (Visible)
{
    <div class="dock-context-backdrop" @onclick="Close"></div>
    <div class="dock-context-menu" style="left: @(X)px; top: @(Y)px;">
        @if (Node is ProjectNode projectNode)
        {
            @if (!projectNode.IsActive)
            {
                <div class="dock-context-item" @onclick="SetActiveProject">⭐ Set Active Project</div>
            }
            <div class="dock-context-item dock-context-danger" @onclick="CloseProject">❌ Close Project</div>
            <div class="dock-context-separator"></div>
        }
        @if (Node is FolderNode or VariableGroupNode)
        {
            <div class="dock-context-item" @onclick="AddFolder">📁 Add Folder</div>
            <div class="dock-context-item" @onclick="AddVariable">🏷️ Add Variable</div>
        }
        @if (Node is ScriptGroupNode or (ResourceFolderNode { ResourceKind: "Script" }))
        {
            <div class="dock-context-item" @onclick="AddFolder">📁 Add Folder</div>
            <div class="dock-context-item" @onclick="AddScript">⚡ Add Script</div>
        }
        @if (Node is PlcGroupNode or (ResourceFolderNode { ResourceKind: "PlcProgram" }))
        {
            <div class="dock-context-item" @onclick="AddFolder">📁 Add Folder</div>
            <div class="dock-context-item" @onclick="AddPlcProgram">⚙️ Add PLC Program</div>
        }
        @if (Node is RecipeGroupNode)
        {
            <div class="dock-context-item" @onclick="AddRecipe">📦 Add Recipe</div>
        }
        @if (Node is SchedulerGroupNode)
        {
            <div class="dock-context-item" @onclick="AddScheduler">📅 Add Scheduler</div>
        }
        @if (Node is ReportGroupNode)
        {
            <div class="dock-context-item" @onclick="AddReport">📄 Add Report</div>
        }
        @if (Node is CalculatedGroupNode)
        {
            <div class="dock-context-item" @onclick="AddCalculated">📐 Add Calculated Tag</div>
        }
        @if (Node is AssetGroupNode)
        {
            <div class="dock-context-item" @onclick="AddAsset">🔧 Add Asset</div>
        }
        @if (Node is BatchGroupNode)
        {
            <div class="dock-context-item" @onclick="AddBatch">🔄 Add Batch Sequence</div>
        }
        @if (Node is EventGroupNode)
        {
            <div class="dock-context-item" @onclick="AddEvent">🔔 Add Event</div>
        }
        @if (Node is AliasMapGroupNode)
        {
            <div class="dock-context-item" @onclick="AddAliasMap">🔗 Add Alias Map</div>
        }
        @if (Node is AutomationRuleGroupNode)
        {
            <div class="dock-context-item" @onclick="AddAutomationRule">⚙️ Add Automation Rule</div>
        }
        @if (Node is ScreenGroupNode or (ResourceFolderNode { ResourceKind: "Screen" }))
        {
            <div class="dock-context-item" @onclick="AddFolder">📁 Add Folder</div>
            <div class="dock-context-item" @onclick="AddScreen">🖼️ Add Screen</div>
        }
        @if (Node is UserGroupListNode)
        {
            <div class="dock-context-item" @onclick="AddUserGroup">🛡️ Add User Group</div>
        }
        @if (Node is UserGroupNode)
        {
            <div class="dock-context-item" @onclick="AddUser">👤 Add User</div>
        }
        @if (Node is VariableNode)
        {
            <div class="dock-context-separator"></div>
            <div class="dock-context-item" @onclick="FindReferences">🔗 Find References</div>
            <div class="dock-context-item" @onclick="AddToWatch">👁️ Add to Watch</div>
            <div class="dock-context-item" @onclick="PinVariable">⭐ Pin to Favourites</div>
        }
        @if (Node is PinnedVariableNode)
        {
            <div class="dock-context-separator"></div>
            <div class="dock-context-item" @onclick="UnpinVariable">⭐ Remove from Pinned</div>
        }
        @if (Node is not ProjectNode)
        {
            <div class="dock-context-separator"></div>
            @if (Node is VariableNode or FolderNode { Parent: not null } or ScriptNode or PlcProgramNode or RecipeNode or SchedulerNode or ReportNode or CalculatedNode or AssetNode or BatchNode or EventNode or AliasMapNode or ScreenNode or UserNode or UserGroupNode or ResourceFolderNode)
            {
                <div class="dock-context-item" @onclick="Copy">📋 Copy</div>
            }
            @if (Node is ScriptNode or ScreenNode or PlcProgramNode)
            {
                <div class="dock-context-item" @onclick="Duplicate">📄 Duplicate</div>
            }
            @if (Clipboard.CanPasteInto(Node))
            {
                <div class="dock-context-item" @onclick="Paste">📌 Paste @(!string.IsNullOrEmpty(Clipboard.Label) ? $"({Clipboard.Label})" : "")</div>
            }
            <div class="dock-context-separator"></div>
            <div class="dock-context-item dock-context-danger" @onclick="Delete">🗑 Delete</div>
        }
        <div class="dock-context-separator"></div>
        <div class="dock-context-item" @onclick="FindInEditor">🔍 Find in Editor</div>
        <div class="dock-context-item" @onclick="FindInProject">🌐 Find in Project</div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddFolder { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddVariable { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddScript { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddPlcProgram { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddRecipe { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddScheduler { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddReport { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddCalculated { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddScreen { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAsset { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddBatch { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddEvent { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAliasMap { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAutomationRule { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddUserGroup { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddUser { get; set; }
    [Parameter] public EventCallback<TreeNode> OnRename { get; set; }
    [Parameter] public EventCallback<TreeNode> OnDelete { get; set; }
    [Parameter] public EventCallback<TreeNode> OnCopy { get; set; }
    [Parameter] public EventCallback<TreeNode> OnDuplicate { get; set; }
    [Parameter] public EventCallback<TreeNode> OnPaste { get; set; }
    [Parameter] public EventCallback<TreeNode> OnSetActiveProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnCloseProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnFindReferences { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddToWatch { get; set; }
    [Parameter] public EventCallback<TreeNode> OnPinVariable { get; set; }
    [Parameter] public EventCallback<TreeNode> OnUnpinVariable { get; set; }
    [Parameter] public EventCallback OnFindInEditor { get; set; }
    [Parameter] public EventCallback OnFindInProject { get; set; }

    private void Close() => OnClose.InvokeAsync();
    private void AddFolder() { OnAddFolder.InvokeAsync(Node!); Close(); }
    private void AddVariable() { OnAddVariable.InvokeAsync(Node!); Close(); }
    private void AddScript() { OnAddScript.InvokeAsync(Node!); Close(); }
    private void AddPlcProgram() { OnAddPlcProgram.InvokeAsync(Node!); Close(); }
    private void AddRecipe() { OnAddRecipe.InvokeAsync(Node!); Close(); }
    private void AddScheduler() { OnAddScheduler.InvokeAsync(Node!); Close(); }
    private void AddReport() { OnAddReport.InvokeAsync(Node!); Close(); }
    private void AddCalculated() { OnAddCalculated.InvokeAsync(Node!); Close(); }
    private void AddScreen() { OnAddScreen.InvokeAsync(Node!); Close(); }
    private void AddAsset() { OnAddAsset.InvokeAsync(Node!); Close(); }
    private void AddBatch() { OnAddBatch.InvokeAsync(Node!); Close(); }
    private void AddEvent() { OnAddEvent.InvokeAsync(Node!); Close(); }
    private void AddAliasMap() { OnAddAliasMap.InvokeAsync(Node!); Close(); }
    private void AddAutomationRule() { OnAddAutomationRule.InvokeAsync(Node!); Close(); }
    private void AddUserGroup() { OnAddUserGroup.InvokeAsync(Node!); Close(); }
    private void AddUser() { OnAddUser.InvokeAsync(Node!); Close(); }
    private void Rename() { OnRename.InvokeAsync(Node!); Close(); }
    private void Delete() { OnDelete.InvokeAsync(Node!); Close(); }
    private void Copy() { OnCopy.InvokeAsync(Node!); Close(); }
    private void Duplicate() { OnDuplicate.InvokeAsync(Node!); Close(); }
    private void Paste() { OnPaste.InvokeAsync(Node!); Close(); }
    private void SetActiveProject() { OnSetActiveProject.InvokeAsync(Node!); Close(); }
    private void CloseProject() { OnCloseProject.InvokeAsync(Node!); Close(); }
    private void FindReferences() { OnFindReferences.InvokeAsync(Node!); Close(); }
    private void AddToWatch() { OnAddToWatch.InvokeAsync(Node!); Close(); }
    private void PinVariable() { OnPinVariable.InvokeAsync(Node!); Close(); }
    private void UnpinVariable() { OnUnpinVariable.InvokeAsync(Node!); Close(); }
    private void FindInEditor() { OnFindInEditor.InvokeAsync(); Close(); }
    private void FindInProject() { OnFindInProject.InvokeAsync(); Close(); }
}
