    private void AddLibrarySymbol(ScreenConfig screen, SymbolLibraryItem item, double dropX = -1, double dropY = -1)
    {
        var sym = new ScreenSymbol
        {
            Id = $"sym_{_nextId++}",
            Type = "svg",
            X = dropX >= 0 ? (int)(dropX - item.DefaultWidth / 2.0) : 50 + screen.Symbols.Count * 20 % Math.Max(1, screen.Width - 100),
            Y = dropY >= 0 ? (int)(dropY - item.DefaultHeight / 2.0) : 50 + screen.Symbols.Count * 20 % Math.Max(1, screen.Height - 80),
            Width = item.DefaultWidth,
            Height = item.DefaultHeight,
            Label = item.Name,
            SvgContent = item.SvgContent,
            Fill = "none",
            Stroke = "#333333"
        };

        if (item.Animations.Count > 0)
        {
            foreach (var anim in item.Animations)
            {
                sym.Animations.Add(new SymbolAnimation
                {
                    Id = Guid.NewGuid().ToString("N")[..8],
                    Name = anim.Name,
                    Enabled = anim.Enabled,
                    Property = anim.Property,
                    Trigger = anim.Trigger,
                    TriggerVariable = anim.TriggerVariable,
                    TriggerCondition = anim.TriggerCondition,
                    Keyframes = anim.Keyframes.Select(k => new AnimationKeyframe
                    {
                        Percent = k.Percent,
                        Value = k.Value,
                        Easing = k.Easing
                    }).ToList(),
                    DurationMs = anim.DurationMs,
                    DelayMs = anim.DelayMs,
                    Easing = anim.Easing,
                    RepeatCount = anim.RepeatCount,
                    AutoReverse = anim.AutoReverse
                });
            }
        }

        screen.Symbols.Add(sym);
        Editor.MarkChanged();
        _selectedSymbols.Clear();
        _selectedSymbol = sym;
        _selectedSymbols.Add(sym);
        NotifySelectionChanged();
        StateHasChanged();
    }

