    private void DeleteSelected()
    {
        var screen = GetScreen();
        if (screen == null) return;

        if (_selectedSymbols.Count > 0)
        {
            var removed = _selectedSymbols.ToList();
            var indices = removed.Select(s => screen.Symbols.IndexOf(s)).ToList();
            foreach (var sym in removed)
                screen.Symbols.Remove(sym);

            UndoRedo.RecordAction(new CollectionAction
            {
                Description = removed.Count == 1 ? "Delete symbol" : $"Delete {removed.Count} symbols",
                UndoCallback = () =>
                {
                    for (int i = 0; i < removed.Count; i++)
                    {
                        var idx = Math.Min(indices[i], screen.Symbols.Count);
                        screen.Symbols.Insert(idx, removed[i]);
                    }
                },
                RedoCallback = () =>
                {
                    foreach (var sym in removed)
                        screen.Symbols.Remove(sym);
                }
            });

            _selectedSymbols.Clear();
            _selectedSymbol = null;
            NotifySelectionChanged();
            OnChanged();
        }
    }

    /// <summary>Called from the keyboard Delete shortcut via Home.razor.</summary>
    public void DeleteSelectedFromKeyboard()
    {
        DeleteSelected();
        StateHasChanged();
    }

    // --- Tab cycling (z-order) ---

    /// <summary>Select the next symbol in z-order (Tab key). Wraps around.</summary>
    public void SelectNextByZOrder()
    {
        var screen = GetScreen();
        if (screen == null || screen.Symbols.Count == 0) return;

        if (_selectedSymbol == null)
        {
            var first = screen.Symbols[0];
            _selectedSymbols.Clear();
            _selectedSymbol = first;
            _selectedSymbols.Add(first);
        }
        else
        {
            var idx = screen.Symbols.IndexOf(_selectedSymbol);
            var next = (idx + 1) % screen.Symbols.Count;
            var sym = screen.Symbols[next];
            _selectedSymbols.Clear();
            _selectedSymbol = sym;
            _selectedSymbols.Add(sym);
        }
        NotifySelectionChanged();
        _ = ScrollToSymbolAsync(_selectedSymbol);
        StateHasChanged();
    }

    /// <summary>Select the previous symbol in z-order (Shift+Tab key). Wraps around.</summary>
    public void SelectPreviousByZOrder()
    {
        var screen = GetScreen();
        if (screen == null || screen.Symbols.Count == 0) return;

        if (_selectedSymbol == null)
        {
            var last = screen.Symbols[^1];
            _selectedSymbols.Clear();
            _selectedSymbol = last;
            _selectedSymbols.Add(last);
        }
        else
        {
            var idx = screen.Symbols.IndexOf(_selectedSymbol);
            var prev = (idx - 1 + screen.Symbols.Count) % screen.Symbols.Count;
            var sym = screen.Symbols[prev];
            _selectedSymbols.Clear();
            _selectedSymbol = sym;
            _selectedSymbols.Add(sym);
        }
        NotifySelectionChanged();
        _ = ScrollToSymbolAsync(_selectedSymbol);
        StateHasChanged();
    }

    // --- Z-order commands ---

    private void BringToFront()
    {
        var screen = GetScreen();
        if (screen == null || _selectedSymbol == null) return;
        var sym = _selectedSymbol;
        var oldIdx = screen.Symbols.IndexOf(sym);
        if (oldIdx < 0 || oldIdx == screen.Symbols.Count - 1) return;

        screen.Symbols.RemoveAt(oldIdx);
        screen.Symbols.Add(sym);

        UndoRedo.RecordAction(new CollectionAction
        {
            Description = "Bring to front",
            UndoCallback = () => { screen.Symbols.Remove(sym); screen.Symbols.Insert(oldIdx, sym); },
            RedoCallback = () => { screen.Symbols.Remove(sym); screen.Symbols.Add(sym); }
        });
        OnChanged();
    }

    private void SendToBack()
    {
        var screen = GetScreen();
        if (screen == null || _selectedSymbol == null) return;
        var sym = _selectedSymbol;
        var oldIdx = screen.Symbols.IndexOf(sym);
        if (oldIdx <= 0) return;

        screen.Symbols.RemoveAt(oldIdx);
        screen.Symbols.Insert(0, sym);

        UndoRedo.RecordAction(new CollectionAction
        {
            Description = "Send to back",
            UndoCallback = () => { screen.Symbols.Remove(sym); screen.Symbols.Insert(oldIdx, sym); },
            RedoCallback = () => { screen.Symbols.Remove(sym); screen.Symbols.Insert(0, sym); }
        });
        OnChanged();
    }

    private void MoveForward()
    {
        var screen = GetScreen();
        if (screen == null || _selectedSymbol == null) return;
        var sym = _selectedSymbol;
        var idx = screen.Symbols.IndexOf(sym);
        if (idx < 0 || idx == screen.Symbols.Count - 1) return;

        screen.Symbols.RemoveAt(idx);
        screen.Symbols.Insert(idx + 1, sym);

        UndoRedo.RecordAction(new CollectionAction
        {
            Description = "Move forward",
            UndoCallback = () => { screen.Symbols.RemoveAt(idx + 1); screen.Symbols.Insert(idx, sym); },
            RedoCallback = () => { screen.Symbols.RemoveAt(idx); screen.Symbols.Insert(idx + 1, sym); }
        });
        OnChanged();
    }

    private void MoveBackward()
    {
        var screen = GetScreen();
        if (screen == null || _selectedSymbol == null) return;
        var sym = _selectedSymbol;
        var idx = screen.Symbols.IndexOf(sym);
        if (idx <= 0) return;

        screen.Symbols.RemoveAt(idx);
        screen.Symbols.Insert(idx - 1, sym);

        UndoRedo.RecordAction(new CollectionAction
        {
            Description = "Move backward",
            UndoCallback = () => { screen.Symbols.RemoveAt(idx - 1); screen.Symbols.Insert(idx, sym); },
            RedoCallback = () => { screen.Symbols.RemoveAt(idx); screen.Symbols.Insert(idx - 1, sym); }
        });
        OnChanged();
    }

    private void CopySelectedSymbols()
    {
        if (_selectedSymbols.Count == 0) return;
        Clipboard.CopySymbols(_selectedSymbols.ToList());
    }

    private void PasteSymbols()
    {
        var screen = GetScreen();
        if (screen == null || !Clipboard.CanPasteSymbols) return;

        var symbols = Clipboard.PasteSymbols();
        if (symbols == null || symbols.Count == 0) return;

        var newSelection = new List<ScreenSymbol>();
        var groupMapping = new Dictionary<string, string>();

        foreach (var src in symbols)
        {
            string? newGroupId = null;
            if (!string.IsNullOrEmpty(src.GroupId))
            {
                if (!groupMapping.ContainsKey(src.GroupId))
                    groupMapping[src.GroupId] = $"grp_{_nextGroupId++}";
                newGroupId = groupMapping[src.GroupId];
            }

            var pasted = new ScreenSymbol
            {
                Id = $"sym_{_nextId++}",
                Type = src.Type,
                X = src.X + 20,
                Y = src.Y + 20,
                Width = src.Width,
                Height = src.Height,
                Fill = src.Fill,
                Stroke = src.Stroke,
                StrokeWidth = src.StrokeWidth,
                Label = src.Label,
                Rotation = src.Rotation,
                SvgContent = src.SvgContent,
                GroupId = newGroupId,
                Animations = src.Animations.Select(a => new SymbolAnimation
                {
                    Id = $"anim_{_nextAnimId++}",
                    Name = a.Name,
                    Enabled = a.Enabled,
                    Property = a.Property,
                    Trigger = a.Trigger,
                    TriggerVariable = a.TriggerVariable,
                    TriggerCondition = a.TriggerCondition,
                    Keyframes = a.Keyframes.Select(k => new AnimationKeyframe
                    {
                        Percent = k.Percent,
                        Value = k.Value,
                        Easing = k.Easing
                    }).ToList(),
                    DurationMs = a.DurationMs,
                    DelayMs = a.DelayMs,
                    Easing = a.Easing,
                    RepeatCount = a.RepeatCount,
                    AutoReverse = a.AutoReverse
                }).ToList(),
                VariablePath = src.VariablePath,
                FillBinding = src.FillBinding,
                VisibilityBinding = src.VisibilityBinding,
                RotationBinding = src.RotationBinding,
                LabelBinding = src.LabelBinding,
                MinValue = src.MinValue,
                MaxValue = src.MaxValue
            };
            screen.Symbols.Add(pasted);
            newSelection.Add(pasted);
        }

        UndoRedo.RecordAction(new CollectionAction
        {
            Description = $"Paste {newSelection.Count} symbol(s)",
            UndoCallback = () => { foreach (var s in newSelection) screen.Symbols.Remove(s); },
            RedoCallback = () => { foreach (var s in newSelection) screen.Symbols.Add(s); }
        });

        _selectedSymbols = new HashSet<ScreenSymbol>(newSelection);
        _selectedSymbol = newSelection.First();
        NotifySelectionChanged();
        OnChanged();
    }

