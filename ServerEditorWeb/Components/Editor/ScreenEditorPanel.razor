                </div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); CopySelectedSymbols(); }">&#128203; Copy</button>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); DuplicateSelected(); }">&#10697; Duplicate</button>
                <button class="ctx-item ctx-danger" @onclick="() => { CloseContextMenu(); DeleteSelected(); }">&#128465; Delete</button>
                <div class="ctx-sep"></div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); BringToFront(); }">&#9195; Bring to Front</button>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); MoveForward(); }">&#9650; Move Forward</button>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); MoveBackward(); }">&#9660; Move Backward</button>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); SendToBack(); }">&#9196; Send to Back</button>
                <div class="ctx-sep"></div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); RotateSelected(-90); }">&#8634; Rotate Left 90&#176;</button>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); RotateSelected(90); }">&#8635; Rotate Right 90&#176;</button>
                @if (_selectedSymbol != null && !string.IsNullOrEmpty(_selectedSymbol.UserSymbolGroupName))
