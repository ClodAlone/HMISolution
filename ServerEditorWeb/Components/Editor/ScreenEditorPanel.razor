                    <div class="ctx-sep"></div>
                    <div class="ctx-menu-header" style="padding:4px 12px;color:var(--code-accent);font-size:10px;text-transform:uppercase;letter-spacing:0.5px;">
                        &#128230; @_selectedSymbol.UserSymbolGroupName
                    </div>
                    <button class="ctx-item" @onclick="() => { CloseContextMenu(); SelectEntireGroup(_selectedSymbol); }">&#128279; Select Entire Group</button>
                    <button class="ctx-item" @onclick="() => { CloseContextMenu(); _editAliasGroupId = _selectedSymbol.GroupId; _showEditAliasDialog = true; }">&#9999; Edit Aliases...</button>
                }
            }
            @if (_selectedSymbols.Count > 1)
            {
                <div class="ctx-sep"></div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); GroupSelected(); }">&#128279; Group</button>
                @if (_selectedSymbols.Any(s => !string.IsNullOrEmpty(s.GroupId)))
