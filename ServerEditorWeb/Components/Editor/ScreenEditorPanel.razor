    @if (_showDistributeDialog)
    {
        <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title">Distribute to Columns</h6>
                        <button class="btn-close" @onclick="() => _showDistributeDialog = false"></button>
                    </div>
                    <div class="modal-body">
                        <label>Columns:</label>
                        <input type="number" class="form-control form-control-sm" @bind="_distributeColumns" min="1" max="20" />
                        <label class="mt-2">Gap X:</label>
                        <input type="number" class="form-control form-control-sm" @bind="_distributeGapX" />
                        <label class="mt-2">Gap Y:</label>
                        <input type="number" class="form-control form-control-sm" @bind="_distributeGapY" />
                    </div>
                    <div class="modal-footer py-1">
                        <button class="btn btn-sm btn-primary" @onclick="ApplyDistributeToColumns">Apply</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => _showDistributeDialog = false">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (_showEditAliasDialog && !string.IsNullOrEmpty(_editAliasGroupId))
    {
        var aliasScreen = (Editor.SelectedItem as ScreenNode)?.Screen;
        var aliasGroupSyms = aliasScreen?.Symbols.Where(s => s.GroupId == _editAliasGroupId).ToList() ?? new();
        var aliasSource = aliasGroupSyms.FirstOrDefault();
        <div style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:10000;display:flex;align-items:center;justify-content:center;" @onclick="() => _showEditAliasDialog = false">
            <div style="background:var(--dialog-bg);border:1px solid var(--dialog-border);border-radius:8px;padding:16px;min-width:420px;max-width:600px;max-height:80vh;overflow-y:auto;color:var(--dialog-text);" @onclick:stopPropagation>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0" style="color:var(--dialog-text);">&#9999; Edit Aliases &#8212; @(aliasSource?.UserSymbolGroupName ?? "Group")</h6>
                    <button class="btn-close" @onclick="() => _showEditAliasDialog = false"></button>
                </div>
                @if (aliasSource != null && aliasSource.InstanceAliases.Count > 0)
                {
                    <table class="table table-sm mb-0" style="font-size:12px;">
                        <thead><tr><th style="width:35%">Alias</th><th>Variable Path</th></tr></thead>
                        <tbody>
                            @foreach (var alias in aliasSource.InstanceAliases.Keys.ToList())
                            {
                                var key = alias;
                                <tr>
                                    <td><code style="color:var(--code-accent);">{@key}</code></td>
                                    <td>
                                        <VariablePathPicker
                                            Value="@aliasSource.InstanceAliases[key]"
                                            ValueChanged="(v) => { aliasSource.InstanceAliases[key] = v; PropagateEditAliases(aliasSource); OnChanged(); }"
                                            Placeholder="Select variable path..." />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-muted small">No alias definitions in this group.</div>
                }
                <div class="text-end mt-3">
                    <button class="btn btn-sm btn-secondary" @onclick="() => _showEditAliasDialog = false">Close</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private OpcClientService Opc { get; set; } = default!;
    [Inject] private ClipboardService Clipboard { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private UndoRedoService UndoRedo { get; set; } = default!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private ScreenSymbol? _selectedSymbol;
    private HashSet<ScreenSymbol> _selectedSymbols = new();
    private bool _isDragging;
    private bool _isRotating;
    private bool _isResizing;
    private string _resizeHandle = "";
    private double _resizeStartWidth, _resizeStartHeight;
    private double _resizeStartX, _resizeStartY;
    private Dictionary<ScreenSymbol, (double X, double Y, double W, double H)> _multiResizeStarts = new();
    private (double X, double Y, double W, double H) _multiBoundsStart;
    private bool _isMarqueeSelecting;
    private double _dragStartX, _dragStartY;
    private double _symStartX, _symStartY;
    private double _rotateStartAngle;
    private double _symStartRotation;
    private Dictionary<ScreenSymbol, (double X, double Y)> _multiDragStarts = new();
    private double _marqueeStartX, _marqueeStartY, _marqueeEndX, _marqueeEndY;
    private double _marqueeCanvasOffsetX, _marqueeCanvasOffsetY;
    private int _nextId = 1;
    private int _nextGroupId = 1;
    private int _nextAnimId = 1;
    private System.Threading.Timer? _refreshTimer;
    private TreeNode? _previousNode;

    // ─── Grid / Snap / Distribute state ─────────────────────
    private List<(double X1, double Y1, double X2, double Y2)> _snapGuides = new();
    private const double SmartSnapThreshold = 5.0;
    private bool _showDistributeDialog;
    private int _distributeColumns = 3;
    private int _distributeGapX = 10;
    private int _distributeGapY = 10;


    // --- User Symbol Library dialog state ---
    private bool _showSaveToLibraryDialog;
    private string _userGroupName = "";
    private string _userGroupCategory = "";
    private string _userGroupAliasText = "";
    // --- Context menu state ---
    private bool _showContextMenu;
    private double _ctxMenuX;
    private double _ctxMenuY;
    private ScreenSymbol? _ctxSymbol;
    // --- Edit Aliases dialog state ---
    private bool _showEditAliasDialog;
    private string? _editAliasGroupId;

    // ─── Undo snapshots
    private Dictionary<ScreenSymbol, string> _operationSnapshots = new();

    private void CaptureSnapshots(IEnumerable<ScreenSymbol> symbols)
    {
        _operationSnapshots.Clear();
        foreach (var s in symbols)
            _operationSnapshots[s] = System.Text.Json.JsonSerializer.Serialize(s);
    }

    private void RecordSnapshotUndo(string description)
    {
        var actions = new List<UndoAction>();
        foreach (var (sym, oldJson) in _operationSnapshots)
        {
            var newJson = System.Text.Json.JsonSerializer.Serialize(sym);
            if (newJson != oldJson)
                actions.Add(new SnapshotAction { Target = sym, OldJson = oldJson, NewJson = newJson, Description = description });
        }
        if (actions.Count == 1)
            UndoRedo.RecordAction(actions[0]);
        else if (actions.Count > 1)
            UndoRedo.RecordAction(new CompoundAction { Actions = actions, Description = description });
        _operationSnapshots.Clear();
    }

    // ─── Resize handle definitions ──────────────────────────
    private record ResizeHandleDef(string Name, string Cursor,
        Func<double, double, double> GetX,
        Func<double, double, double> GetY);

    private static readonly ResizeHandleDef[] _resizeHandles =
    [
        new("nw", "nwse-resize", (w, s) => -2 - s / 2,          (h, s) => -2 - s / 2),
        new("ne", "nesw-resize", (w, s) => w + 2 - s / 2,       (h, s) => -2 - s / 2),
        new("sw", "nesw-resize", (w, s) => -2 - s / 2,          (h, s) => h + 2 - s / 2),
        new("se", "nwse-resize", (w, s) => w + 2 - s / 2,       (h, s) => h + 2 - s / 2),
        new("n",  "ns-resize",   (w, s) => w / 2 - s / 2,       (h, s) => -2 - s / 2),
        new("s",  "ns-resize",   (w, s) => w / 2 - s / 2,       (h, s) => h + 2 - s / 2),
        new("w",  "ew-resize",   (w, s) => -2 - s / 2,          (h, s) => h / 2 - s / 2),
        new("e",  "ew-resize",   (w, s) => w + 2 - s / 2,       (h, s) => h / 2 - s / 2),
    ];

    protected override void OnInitialized()
    {
        Opc.StateChanged += OnOpcChanged;
        Editor.AnimationPreviewTick += OnAnimationPreviewTick;
        _refreshTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void OnOpcChanged() => InvokeAsync(StateHasChanged);
    private void OnAnimationPreviewTick() => InvokeAsync(StateHasChanged);

    private string? ResolveImageData(string? imageId)
    {
        if (string.IsNullOrEmpty(imageId)) return null;
        return Editor.RootModel?.Images?.FirstOrDefault(i => i.Id == imageId)?.Data;
    }

    private ScreenConfig? GetScreen()
    {
        return (Node as ScreenNode)?.Screen;
    }

    protected override void OnParametersSet()
    {
        if (Node != _previousNode)
        {
            _previousNode = Node;
            _selectedSymbol = null;
            _selectedSymbols.Clear();
            _isDragging = false;
            _isRotating = false;
            _isMarqueeSelecting = false;
            NotifySelectionChanged();
        }

        // Ensure all symbols have unique IDs
        var screen = GetScreen();
        if (screen != null)
        {
            foreach (var sym in screen.Symbols)
            {
                if (string.IsNullOrEmpty(sym.Id))
                    sym.Id = $"sym_{_nextId++}";
                else if (int.TryParse(sym.Id.Replace("sym_", ""), out var n) && n >= _nextId)
                    _nextId = n + 1;

                // Ensure animation IDs
                foreach (var a in sym.Animations)
                {
                    if (string.IsNullOrEmpty(a.Id))
                        a.Id = $"anim_{_nextAnimId++}";
                    else if (int.TryParse(a.Id.Replace("anim_", ""), out var an) && an >= _nextAnimId)
                        _nextAnimId = an + 1;
                }
            }

            // Clear selection if the symbol was removed externally
            _selectedSymbols.RemoveWhere(s => !screen.Symbols.Contains(s));
            if (_selectedSymbol != null && !screen.Symbols.Contains(_selectedSymbol))
                _selectedSymbol = null;
            if (_selectedSymbol == null && _selectedSymbols.Count > 0)
                _selectedSymbol = _selectedSymbols.First();
        }
    }

    // --- JS-based drag-and-drop (avoids chatty ondragover over SignalR) ---
    private DotNetObjectReference<ScreenEditorPanel>? _dotNetRef;
    private bool _canvasDropInitialized;
    private TreeNode? _lastRenderedNode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var hasScreen = GetScreen() != null;
        if (firstRender && hasScreen)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("canvasDrop.init", _dotNetRef);
            _canvasDropInitialized = true;
            _lastRenderedNode = Node;
        }
        else if (!_canvasDropInitialized && hasScreen)
        {
            // First time we have a screen after initial render
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("canvasDrop.init", _dotNetRef);
            _canvasDropInitialized = true;
            _lastRenderedNode = Node;
        }
        else if (_canvasDropInitialized && hasScreen && _lastRenderedNode != Node)
        {
            // Screen changed - re-attach to the new SVG element
            _lastRenderedNode = Node;
            await JS.InvokeVoidAsync("canvasDrop.reinit");
        }
    }

    [JSInvokable]
    public void JsOnCanvasDrop(double dropX, double dropY)
    {
        var screen = GetScreen();
        if (screen == null) return;

        // Handle toolbox drag
        if (ScreenToolboxPanel.DraggedToolboxType is { } toolboxType)
        {
            AddSymbol(screen, toolboxType, dropX, dropY);
            ScreenToolboxPanel.DraggedToolboxType = null;
            StateHasChanged();
            return;
        }

        // Handle symbol library drag
        if (SymbolLibraryPanel.DraggedLibraryItem is { } libItem)
        {
            AddLibrarySymbol(screen, libItem, dropX, dropY);
            SymbolLibraryPanel.DraggedLibraryItem = null;
            StateHasChanged();
            return;
        }

        // Handle user symbol group drag
        if (ScreenToolboxPanel.DraggedUserGroup is { } userGroup)
        {
            DropUserSymbolGroup(screen, userGroup, dropX, dropY);
