    @if (_showSaveToLibraryDialog)
    {
        <div class="modal show d-block" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title">Save to User Symbol Library</h6>
                        <button class="btn-close" @onclick="() => _showSaveToLibraryDialog = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small">Group Name:</label>
                        <input type="text" class="form-control form-control-sm" @bind="_userGroupName" placeholder="e.g. Motor Control" />
                        <label class="form-label small mt-2">Category:</label>
                        <input type="text" class="form-control form-control-sm" @bind="_userGroupCategory" placeholder="e.g. Motors" />
                        <label class="form-label small mt-2">Alias Definitions (one per line):</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="_userGroupAliasText" placeholder="Motor&#10;Speed&#10;Status"></textarea>
                        <div class="text-muted small mt-1">Each alias becomes a {AliasName} placeholder in variable paths.</div>
                    </div>
                    <div class="modal-footer py-1">
                        <button class="btn btn-sm btn-primary" @onclick="SaveSelectedAsUserGroup" disabled="@(string.IsNullOrWhiteSpace(_userGroupName))">Save</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => _showSaveToLibraryDialog = false">Cancel</button>
                    </div>
                </div>
            </div>
