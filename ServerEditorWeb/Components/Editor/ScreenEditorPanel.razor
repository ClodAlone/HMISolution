    /// Returns the original size when the symbol has no custom font size.</summary>
    private static int ScaledFontSize(int designSize, ScreenSymbol sym, int baseSize = 11)
        => sym.FontSize > 0 ? Math.Max(1, (int)Math.Round(designSize * (double)sym.FontSize / baseSize)) : designSize;

