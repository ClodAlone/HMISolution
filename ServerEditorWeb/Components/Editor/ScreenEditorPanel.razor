            else if (_selectedSymbol != null && !string.IsNullOrEmpty(_selectedSymbol.GroupId))
            {
                <div class="ctx-sep"></div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); UngroupSelected(); }">&#9986; Ungroup</button>
            }
            @if (Clipboard.CanPasteSymbols)
            {
                <div class="ctx-sep"></div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); PasteSymbols(); }">&#128204; Paste</button>
            }
            @if (_selectedSymbols.Count == 0 && !Clipboard.CanPasteSymbols)
            {
                <div class="ctx-menu-header" style="padding:6px 12px;font-size:11px;">Right-click a symbol for actions</div>
