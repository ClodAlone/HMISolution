                    <button class="ctx-item" @onclick="() => { CloseContextMenu(); UngroupSelected(); }">&#9986; Ungroup</button>
                }
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); _showDistributeDialog = true; }">&#9638; Distribute...</button>
                <div class="ctx-sep"></div>
                <button class="ctx-item" @onclick="() => { CloseContextMenu(); ShowSaveToUserLibraryDialog(); }">&#128190; Save to User Library...</button>
