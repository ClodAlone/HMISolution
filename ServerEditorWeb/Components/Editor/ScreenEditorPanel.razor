@using ServerEditorWeb.Models
@using ServerEditorWeb.Services
@using SharedModels
@implements IAsyncDisposable

<div class="screen-editor-panel">
    @if (GetScreen() is not ScreenConfig screen)
    {
        <p class="text-muted p-2">Select a Screen node in the tree to open the screen editor.</p>
    }
    else if (screen.LayoutMode == "responsive")
    {
        <ResponsiveScreenEditorPanel Node="Node" OnPropertyChanged="OnPropertyChanged" />
    }
    else
    {
        @* Toolbar *@
        <div class="screen-toolbar">
            <div class="d-flex gap-1 align-items-center flex-wrap">
                <span class="small fw-bold me-2">@screen.Name</span>



                @if (_selectedSymbols.Count > 1)
                {
                    <span class="badge bg-primary me-1" style="font-size: 10px;">@_selectedSymbols.Count selected</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected" title="Delete All Selected">🗑</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopySelectedSymbols" title="Copy (Ctrl+C)">📋 Copy</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PasteSymbols" title="Paste (Ctrl+V)" disabled="@(!Clipboard.CanPasteSymbols)">📌 Paste</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected" title="Duplicate All">⧉ Dup</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(-90)" title="Rotate Left 90°">↺</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(90)" title="Rotate Right 90°">↻</button>
                    <span class="mx-1">|</span>
                    <button class="btn btn-sm btn-outline-success" @onclick="GroupSelected" title="Group selected symbols">🔗 Group</button>
                    @if (_selectedSymbols.Any(s => !string.IsNullOrEmpty(s.GroupId)))
                    {
                        <button class="btn btn-sm btn-outline-warning" @onclick="UngroupSelected" title="Ungroup selected symbols">✂ Ungroup</button>
                    }
                    <span class="mx-1">|</span>
                    <button class="btn btn-sm btn-outline-info" @onclick="ShowSaveToUserLibraryDialog" title="Save selected symbols as a reusable user symbol group">&#128190; Save to Library</button>
                }
                else if (_selectedSymbol != null)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected" title="Delete">🗑</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopySelectedSymbols" title="Copy (Ctrl+C)">📋 Copy</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PasteSymbols" title="Paste (Ctrl+V)" disabled="@(!Clipboard.CanPasteSymbols)">📌 Paste</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DuplicateSelected" title="Duplicate">⧉ Dup</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(-90)" title="Rotate Left 90°">↺</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RotateSelected(90)" title="Rotate Right 90°">↻</button>
                    @if (!string.IsNullOrEmpty(_selectedSymbol.GroupId))
                    {
                        <span class="mx-1">|</span>
                        <button class="btn btn-sm btn-outline-warning" @onclick="UngroupSelected" title="Ungroup">✂ Ungroup</button>
                    }
                }

                @if (_selectedSymbols.Count == 0 && Clipboard.CanPasteSymbols)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PasteSymbols" title="Paste (Ctrl+V)">📌 Paste</button>
                }

                <span class="mx-1">|</span>

                <label class="form-label mb-0 small">W:</label>
                <input type="number" class="form-control form-control-sm" style="width: 60px;" @bind="screen.Width" @bind:after="OnChanged" />
                <label class="form-label mb-0 small">H:</label>
                <input type="number" class="form-control form-control-sm" style="width: 60px;" @bind="screen.Height" @bind:after="OnChanged" />
                <label class="form-label mb-0 small">BG:</label>
                <ColorPicker Value="@(screen.Background)" ValueChanged="(v) => { screen.Background = v; }" OnAfterChange="OnChanged" />
                <label class="form-label mb-0 small">BG Image:</label>
                <select class="form-select form-select-sm" style="width: 130px; font-size: 10px;"
                        value="@screen.BackgroundImageId"
                        @onchange="(e) => { screen.BackgroundImageId = e.Value?.ToString() ?? string.Empty; OnChanged(); }">
                    <option value="">(none)</option>
                    @foreach (var img in (Editor.RootModel?.Images ?? []))
                    {
                        <option value="@img.Id">@img.Id</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(screen.BackgroundImageId))
                {
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 10px;"
                            @onclick="() => { screen.BackgroundImageId = string.Empty; OnChanged(); }" title="Remove background image">?</button>
                }

                <span class="mx-1">|</span>
                <button class="btn btn-sm @(screen.ShowGrid ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => { screen.ShowGrid = !screen.ShowGrid; OnChanged(); }" title="Toggle Grid">
                    Grid
                </button>
                @if (screen.ShowGrid)
                {
                    <input type="number" class="form-control form-control-sm" style="width: 50px;" min="5" max="100"
                           @bind="screen.EditorGridSize" @bind:after="OnChanged" title="Grid size (px)" />
                }
                <button class="btn btn-sm @(screen.SnapToGrid ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => { screen.SnapToGrid = !screen.SnapToGrid; OnChanged(); }" title="Snap to Grid">
                    Snap
                </button>
                <button class="btn btn-sm @(screen.SmartSnap ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => { screen.SmartSnap = !screen.SmartSnap; OnChanged(); }" title="Smart Snap (align to other objects)">
                    Smart
                </button>

                @if (_selectedSymbols.Count > 1)
                {
                    <span class="mx-1">|</span>
                    <button class="btn btn-sm btn-outline-info" @onclick="() => _showDistributeDialog = true" title="Distribute selected symbols into columns">
                        Distribute
                    </button>
                }

                @if (_selectedSymbols.Count > 0)
                {
                    <span class="mx-1">|</span>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="BringToFront" title="Bring to Front">&#x23EB;</button>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="MoveForward" title="Move Forward">&#x25B2;</button>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="MoveBackward" title="Move Backward">&#x25BC;</button>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="SendToBack" title="Send to Back">&#x23EC;</button>
                }

                <span class="ms-auto small text-muted">Symbols: @screen.Symbols.Count</span>

                <span class="mx-1">|</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => SwitchToResponsive(screen)" title="Switch to responsive HTML layout">
                    📐 Responsive
                </button>
            </div>
        </div>

        <div class="screen-editor-body">
            @* SVG Canvas *@
            <div class="screen-canvas-wrap">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="@screen.Width" height="@screen.Height"
                     class="screen-canvas"
                     style="background: @screen.Background; font-family: sans-serif;"
                     @onmousedown="OnCanvasMouseDown"
                     @onmousemove="OnCanvasMouseMove"
                     @onmouseup="OnCanvasMouseUp"
                     @oncontextmenu="OnCanvasContextMenu" @oncontextmenu:preventDefault>
                    @{ var bgData = ResolveImageData(screen.BackgroundImageId); }
                    @if (!string.IsNullOrEmpty(bgData))
                    {
                        <image href="@bgData" x="0" y="0"
                               width="@screen.Width" height="@screen.Height"
                               preserveAspectRatio="xMidYMid slice" />
                    }

                    @* Editor grid *@
                    @if (screen.ShowGrid && screen.EditorGridSize >= 5)
                    {
                        var gs = screen.EditorGridSize;
                        <defs>
                            <pattern id="editor-grid" width="@gs" height="@gs" patternUnits="userSpaceOnUse">
                                <path d="M @gs 0 L 0 0 0 @gs" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="0.5" />
                                <circle cx="0" cy="0" r="1" fill="rgba(255,255,255,0.35)" />
                            </pattern>
                        </defs>
                        <rect width="@screen.Width" height="@screen.Height" fill="url(#editor-grid)" />
                    }

                    @* Smart-snap alignment guides *@
                    @foreach (var guide in _snapGuides)
                    {
                        <line x1="@guide.X1" y1="@guide.Y1" x2="@guide.X2" y2="@guide.Y2"
                              stroke="#ff4444" stroke-width="0.5" stroke-dasharray="3,2" />
                    }

                    @foreach (var sym in screen.Symbols)
                    {
                        var isSelected = _selectedSymbols.Contains(sym);
                        var liveValue = GetLiveValue(sym);
                        var fillColor = EvalFillBinding(sym, liveValue);
                        var visible = EvalVisibilityBinding(sym, liveValue);
                        var rotation = EvalRotationBinding(sym, liveValue);
                        var labelText = EvalLabelBinding(sym, liveValue);

                        if (!visible) continue;

                        <g transform="translate(@sym.X, @sym.Y) rotate(@rotation.ToString("F1"), @((sym.Width / 2).ToString("F1")), @((sym.Height / 2).ToString("F1")))"
                           @onmousedown="(e) => OnSymbolMouseDown(e, sym)" @onmousedown:stopPropagation
                           class="screen-symbol @(isSelected ? "selected" : "")"
                           style="cursor: move; @SymbolFontStyle(sym)">

                            @switch (sym.Type)
                            {
                                case "rect":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="3" />
                                    break;
                                case "circle":
                                    var r = Math.Min(sym.Width, sym.Height) / 2;
                                    <circle cx="@(sym.Width / 2)" cy="@(sym.Height / 2)" r="@r"
                                            fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    break;
                                case "ellipse":
                                    <ellipse cx="@(sym.Width / 2)" cy="@(sym.Height / 2)"
                                             rx="@(sym.Width / 2)" ry="@(sym.Height / 2)"
                                             fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    break;
                                case "text":
                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 5, "middle", "middle", fillColor, 14, labelText ?? sym.Label, sym)
                                    break;
                                case "line":
                                    <line x1="0" y1="@sym.Height" x2="@sym.Width" y2="0"
                                          stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    break;
                                case "gauge":
                                    @RenderGauge(sym, fillColor, liveValue)
                                    break;
                                case "indicator":
                                    <circle cx="@(sym.Width / 2)" cy="@(sym.Height / 2)"
                                            r="@(Math.Min(sym.Width, sym.Height) / 2 - 2)"
                                            fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 4, "middle", "middle", "white", 10, labelText ?? sym.Label, sym)
                                    break;
                                case "svg":
                                    @if (!string.IsNullOrEmpty(sym.SvgContent))
                                    {
                                        @RenderLibrarySvg(sym)
                                    }
                                    break;
                                case "alarmlist":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#1a1a2e" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "🔔 Alarm List")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#333" stroke-width="1" />
                                    @RenderSvgText(sym.Width / 2, 40, "middle", "middle", "#888", ScaledFontSize(9, sym), "(live alarms displayed at runtime)")
                                    break;
                                case "hdachart":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#111827" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "📊 HDA Chart")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#374151" stroke-width="1" />
                                    <line x1="40" y1="32" x2="40" y2="@(sym.Height - 20)" stroke="#374151" stroke-width="1" />
                                    <line x1="40" y1="@(sym.Height - 20)" x2="@(sym.Width - 10)" y2="@(sym.Height - 20)" stroke="#374151" stroke-width="1" />
                                    <polyline points="@BuildFakeHdaPolyline(sym)" fill="none" stroke="#3b82f6" stroke-width="1.5" />
                                    @if (sym.HdaVariablePaths.Count > 0)
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(8, sym), string.Join(", ", sym.HdaVariablePaths.Take(3)))
                                    }
                                    else
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(8, sym), "(configure variables in properties)")
                                    }
                                    break;
                                case "hdagrid":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#111827" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "📋 HDA Data Grid")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#374151" stroke-width="1" />
                                    @* Fake table header row *@
                                    <rect x="8" y="32" width="@(sym.Width - 16)" height="14" fill="#0f172a" rx="1" />
                                    @RenderSvgText(40, 42, "start", "middle", "#9ca3af", ScaledFontSize(7, sym), "Timestamp")
                                    @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#9ca3af", ScaledFontSize(7, sym), "Variable 1")
                                    @RenderSvgText(sym.Width - 40, 42, "end", "middle", "#9ca3af", ScaledFontSize(7, sym), "Variable 2")
                                    @* Fake data rows *@
                                    @for (int row = 0; row < 4 && row * 13 + 50 < sym.Height - 20; row++)
                                    {
                                        var ry = 50 + row * 13;
                                        <line x1="8" y1="@ry" x2="@(sym.Width - 8)" y2="@ry" stroke="#1f2937" stroke-width="0.5" />
                                        @RenderSvgText(40, ry + 9, "start", "middle", "#6b7280", ScaledFontSize(7, sym), "00:00:00.000")
                                        @RenderSvgText(sym.Width / 2, ry + 9, "middle", "middle", "#d1d5db", ScaledFontSize(7, sym), "12.345")
                                        @RenderSvgText(sym.Width - 40, ry + 9, "end", "middle", "#d1d5db", ScaledFontSize(7, sym), "67.890")
                                    }
                                    @if (sym.HdaVariablePaths.Count > 0)
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(8, sym), string.Join(", ", sym.HdaVariablePaths.Take(3)))
                                    }
                                    else
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(8, sym), "(configure variables in properties)")
                                    }
                                    break;
                                case "eventlog":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#0f172a" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e2e8f0", ScaledFontSize(11, sym), "📓 Event Log")
                                    <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                    @* Fake table header *@
                                    <rect x="8" y="32" width="@(sym.Width - 16)" height="14" fill="#1e293b" rx="1" />
                                    @RenderSvgText(30, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Time")
                                    @RenderSvgText(100, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Category")
                                    @RenderSvgText(160, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Severity")
                                    @RenderSvgText(220, 42, "start", "middle", "#94a3b8", ScaledFontSize(7, sym), "Source")
                                    @RenderSvgText(sym.Width - 40, 42, "end", "middle", "#94a3b8", ScaledFontSize(7, sym), "Message")
                                    @* Fake data rows *@
                                    @RenderEventLogPreviewRows(sym)
                                    @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(8, sym),
                                        string.IsNullOrEmpty(sym.EventLogCategories) ? "All categories" : sym.EventLogCategories)
                                    break;
                                case "editbox":
                                    <rect width="@sym.Width" height="@sym.Height"
                                          fill="#1e293b" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                    @* Simulated text input area *@
                                    <rect x="3" y="3" width="@(sym.Width - (sym.Height > 24 ? 28 : 6))" height="@(sym.Height - 6)"
                                          fill="#0f172a" rx="2" />
                                    @RenderSvgText(10, sym.Height / 2 + 1, "start", "middle", "#94a3b8", ScaledFontSize(10, sym),
                                        !string.IsNullOrEmpty(sym.VariablePath) ? "42.5" : "—")
                                    @* Spin buttons *@
                                    @if (sym.Height > 24)
                                    {
                                        var bx = sym.Width - 24;
                                        <rect x="@bx" y="3" width="21" height="@((sym.Height - 6) / 2 - 1)" fill="#334155" rx="2" />
                                        @RenderSvgText(bx + 10.5, sym.Height * 0.25 + 1, "middle", "middle", "#94a3b8", ScaledFontSize(7, sym), "▲")
                                        <rect x="@bx" y="@(sym.Height / 2 + 1)" width="21" height="@((sym.Height - 6) / 2 - 1)" fill="#334155" rx="2" />
                                        @RenderSvgText(bx + 10.5, sym.Height * 0.75, "middle", "middle", "#94a3b8", ScaledFontSize(7, sym), "▼")
                                    }
                                    @if (!string.IsNullOrEmpty(sym.VariablePath))
                                    {
                                        @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#6b7280", ScaledFontSize(7, sym), sym.VariablePath)
                                    }
                                    else
                                    {
                                            @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#ef4444", ScaledFontSize(7, sym), "(set VariablePath)")
                                            }
                                            break;
                                        case "ipcamera":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#0a0a0a" stroke="#475569" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @* Camera icon *@
                                            @RenderSvgText(sym.Width / 2, sym.Height / 2 - 8, "middle", "middle", "#4b5563", ScaledFontSize(28, sym), "📷")
                                            @if (sym.Camera != null && !string.IsNullOrEmpty(sym.Camera.CameraId))
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 16, "middle", "middle", "#9ca3af", ScaledFontSize(10, sym), sym.Camera.CameraId)
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 28, "middle", "middle", "#6b7280", ScaledFontSize(8, sym),
                                                    sym.Camera.Protocol.ToUpperInvariant() + (sym.Camera.EnableYolo ? " + YOLO" : ""))
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 18, "middle", "middle", "#ef4444", ScaledFontSize(8, sym), "(configure camera)")
                                            }
                                            break;
                                        case "recipe":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#1a1a2e" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "📦 Recipe")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @if (!string.IsNullOrEmpty(sym.RecipeName))
                                            {
                                                @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#6ee7b7", ScaledFontSize(10, sym), sym.RecipeName)
                                                @* Fake action buttons preview *@
                                                <rect x="8" y="54" width="@((sym.Width - 24) / 4)" height="16" fill="#1e40af" rx="2" />
                                                @RenderSvgText(8 + (sym.Width - 24) / 8, 63, "middle", "middle", "#e2e8f0", ScaledFontSize(7, sym), "Load")
                                                <rect x="@(12 + (sym.Width - 24) / 4)" y="54" width="@((sym.Width - 24) / 4)" height="16" fill="#065f46" rx="2" />
                                                @RenderSvgText(12 + (sym.Width - 24) * 3 / 8, 63, "middle", "middle", "#e2e8f0", ScaledFontSize(7, sym), "Save")
                                                <rect x="@(16 + (sym.Width - 24) / 2)" y="54" width="@((sym.Width - 24) / 4)" height="16" fill="#7c3aed" rx="2" />
                                                @RenderSvgText(16 + (sym.Width - 24) * 5 / 8, 63, "middle", "middle", "#e2e8f0", ScaledFontSize(7, sym), "Activate")
                                                @RenderSvgText(sym.Width / 2, sym.Height - 8, "middle", null, "#475569", ScaledFontSize(8, sym), "(live recipe control at runtime)")
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 6, "middle", "middle", "#ef4444", ScaledFontSize(8, sym), "(set RecipeName)")
                                            }
                                            break;
                                        case "weeklyplanner":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#1a1a2e" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "📅 Weekly Planner")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @if (!string.IsNullOrEmpty(sym.SchedulerName))
                                            {
                                                @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#6ee7b7", ScaledFontSize(10, sym), sym.SchedulerName)
                                                var wpDayW = (sym.Width - 16) / 7.0;
                                                string[] wpDays = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
                                                @for (var di = 0; di < 7; di++)
                                                {
                                                    var dx = 8 + di * wpDayW;
                                                    <rect x="@F(dx)" y="54" width="@F(wpDayW - 2)" height="@(sym.Height - 70)" fill="#0f172a" rx="2" />
                                                    @RenderSvgText(dx + wpDayW / 2 - 1, 64, "middle", "middle", "#94a3b8", ScaledFontSize(7, sym), wpDays[di])
                                                }
                                                @RenderSvgText(sym.Width / 2, sym.Height - 8, "middle", null, "#475569", ScaledFontSize(8, sym), "(live schedule at runtime)")
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 6, "middle", "middle", "#ef4444", ScaledFontSize(8, sym), "(set SchedulerName)")
                                            }
                                            break;
                                        case "reportviewer":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#1a1a2e" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "`u{1F4C4} Report Viewer")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @if (!string.IsNullOrEmpty(sym.ReportName))
                                            {
                                                @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#f97316", ScaledFontSize(10, sym), sym.ReportName)
                                                <rect x="8" y="54" width="@(sym.Width - 16)" height="14" fill="#1e293b" rx="2" />
                                                @RenderSvgText(sym.Width / 2, 62, "middle", "middle", "#94a3b8", ScaledFontSize(7, sym), "report data rows")
                                                <rect x="8" y="70" width="@(sym.Width - 16)" height="14" fill="#0f172a" rx="2" />
                                                <rect x="8" y="86" width="@(sym.Width - 16)" height="14" fill="#1e293b" rx="2" />
                                                @RenderSvgText(sym.Width / 2, sym.Height - 8, "middle", null, "#475569", ScaledFontSize(8, sym), "(generated at runtime)")
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 6, "middle", "middle", "#ef4444", ScaledFontSize(8, sym), "(set ReportName)")
                                            }
                                            break;
                                        case "screenembed":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#0f172a" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e0e0e0", ScaledFontSize(11, sym), "🪟 Screen Embed")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @if (sym.EmbeddedScreens.Count > 0)
                                            {
                                                @if (sym.EmbeddedScreens.Count == 1)
                                                {
                                                    @RenderSvgText(sym.Width / 2, 42, "middle", "middle", "#38bdf8", ScaledFontSize(10, sym), sym.EmbeddedScreens[0])
                                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 10, "middle", "middle", "#475569", ScaledFontSize(9, sym), "(embedded at runtime)")
                                                }
                                                else
                                                {
                                                    @* Preview tabs *@
                                                    var tabW = Math.Min(80.0, (sym.Width - 8) / sym.EmbeddedScreens.Count);
                                                    @for (var ti = 0; ti < Math.Min(sym.EmbeddedScreens.Count, 6); ti++)
                                                    {
                                                        var tx = 4 + ti * tabW;
                                                        var isFirst = ti == 0;
                                                        <rect x="@((int)tx)" y="30" width="@((int)(tabW - 2))" height="16" fill="@(isFirst ? "#1e40af" : "#1e293b")" rx="2" />
                                                        @RenderSvgText(tx + tabW / 2 - 1, 39, "middle", "middle", isFirst ? "#e2e8f0" : "#64748b", ScaledFontSize(7, sym), sym.EmbeddedScreens[ti].Length > 10 ? sym.EmbeddedScreens[ti][..10] + "…" : sym.EmbeddedScreens[ti])
                                                    }
                                                    @if (sym.EmbeddedScreens.Count > 6)
                                                    {
                                                        @RenderSvgText(sym.Width - 10, 39, "end", "middle", "#64748b", ScaledFontSize(7, sym), $"+{sym.EmbeddedScreens.Count - 6}")
                                                    }
                                                    @RenderSvgText(sym.Width / 2, sym.Height / 2 + 14, "middle", "middle", "#475569", ScaledFontSize(9, sym), $"{sym.EmbeddedScreens.Count} screens — tabbed at runtime")
                                                }
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 6, "middle", "middle", "#ef4444", ScaledFontSize(8, sym), "(add screens in properties)")
                                            }
                                            break;
                                        case "imagemap":
                                            @if (sym.ImageMapEntries.Count > 0 && !string.IsNullOrEmpty(sym.ImageMapEntries[0].ImageData))
                                            {
                                                <image href="@sym.ImageMapEntries[0].ImageData" x="0" y="0"
                                                       width="@sym.Width" height="@sym.Height"
                                                       preserveAspectRatio="xMidYMid meet" />
                                            }
                                            else
                                            {
                                                <rect width="@sym.Width" height="@sym.Height"
                                                      fill="#1e293b" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 - 8, "middle", "middle", "#64748b", ScaledFontSize(22, sym), "🖼️")
                                                @RenderSvgText(sym.Width / 2, sym.Height / 2 + 12, "middle", "middle", "#94a3b8", ScaledFontSize(9, sym), "Image Map")
                                            }
                                            @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#6b7280", ScaledFontSize(7, sym), $"{sym.ImageMapEntries.Count} image(s)")
                                            break;
                                        case "trend":
                                            var tw = sym.Width - 12;
                                            var tMid = sym.Height / 2 + 4;
                                            var tAmp = (sym.Height - 40) * 0.3;
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="@(sym.TrendBackground ?? "#111827")" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 14, "middle", "middle", "#e0e0e0", ScaledFontSize(10, sym), "📈 Realtime Trend")
                                            <line x1="4" y1="22" x2="@(sym.Width - 4)" y2="22" stroke="#334155" stroke-width="1" />
                                            <polyline points="@($"6,{tMid} {6 + tw * 0.15},{tMid - tAmp} {6 + tw * 0.3},{tMid + tAmp * 0.5} {6 + tw * 0.5},{tMid - tAmp * 0.7} {6 + tw * 0.7},{tMid + tAmp * 0.3} {6 + tw * 0.85},{tMid - tAmp * 0.4} {6 + tw},{tMid + tAmp * 0.1}")"
                                                       fill="none" stroke="#3b82f6" stroke-width="1.5" />
                                            @if (sym.TrendPens.Count > 1)
                                            {
                                                <polyline points="@($"6,{tMid + 4} {6 + tw * 0.1},{tMid + tAmp * 0.6} {6 + tw * 0.25},{tMid - tAmp * 0.3} {6 + tw * 0.45},{tMid + tAmp * 0.8} {6 + tw * 0.6},{tMid - tAmp * 0.2} {6 + tw * 0.8},{tMid + tAmp * 0.5} {6 + tw},{tMid - tAmp * 0.3}")"
                                                           fill="none" stroke="#ef4444" stroke-width="1.5" />
                                            }
                                            @RenderSvgText(sym.Width / 2, sym.Height - 6, "middle", null, "#6b7280", ScaledFontSize(7, sym), $"{sym.TrendPens.Count} pen(s) · {sym.TrendTimeWindowSeconds}s")
                                            break;
                                        case "switch":
                                                // Apple-style toggle switch preview (OFF state in editor)
                                                var swW = sym.Width;
                                                var swH = sym.Height;
                                                var swR = swH / 2.0;
                                                var swOffColor = sym.SwitchOffColor ?? "#787880";
                                                var swKnobR = swR - 2;
                                            <rect width="@swW" height="@swH" rx="@F(swR)" ry="@F(swR)"
                                                  fill="@swOffColor" />
                                            @* Knob in OFF position (left) *@
                                            <circle cx="@F(swR)" cy="@F(swR)" r="@F(swKnobR)"
                                                    fill="white" style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));" />
                                            @if (!string.IsNullOrEmpty(sym.VariablePath))
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#6b7280", ScaledFontSize(7, sym), sym.VariablePath)
                                            }
                                            else
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height + 12, "middle", null, "#ef4444", ScaledFontSize(7, sym), "(set VariablePath)")
                                            }
                                            break;
                                        case "rotaryswitch":
                                                var rsSize = Math.Min(sym.Width, sym.Height);
                                                var rsCx = sym.Width / 2.0;
                                                var rsCy = sym.Height / 2.0;
                                                var rsOuter = rsSize / 2.0 - 2;
                                                var rsInner = rsOuter * 0.55;
                                                var rsPositions = Math.Max(2, Math.Min(12, sym.SwitchPositions));
                                                var rsLabels = (sym.SwitchPositionLabels ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                var rsDialColor = sym.SwitchDialColor ?? "#2d2d2d";
                                                var rsKnobColor = sym.SwitchKnobColor ?? "#e0e0e0";
                                            <circle cx="@F(rsCx)" cy="@F(rsCy)" r="@F(rsOuter)"
                                                    fill="@rsDialColor" stroke="#555" stroke-width="1" />
                                            @* Position tick marks *@
                                            @for (int pi = 0; pi < rsPositions; pi++)
                                            {
                                                var angle = -150.0 + (300.0 / (rsPositions - 1)) * pi;
                                                var rad = angle * Math.PI / 180.0;
                                                var tx1 = rsCx + (rsOuter - 2) * Math.Sin(rad);
                                                var ty1 = rsCy - (rsOuter - 2) * Math.Cos(rad);
                                                var tx2 = rsCx + (rsOuter - 7) * Math.Sin(rad);
                                                var ty2 = rsCy - (rsOuter - 7) * Math.Cos(rad);
                                                <line x1="@F(tx1)" y1="@F(ty1)" x2="@F(tx2)" y2="@F(ty2)"
                                                      stroke="#aaa" stroke-width="1.5" stroke-linecap="round" />
                                                var lx = rsCx + (rsOuter + 8) * Math.Sin(rad);
                                                var ly = rsCy - (rsOuter + 8) * Math.Cos(rad);
                                                var pLabel = pi < rsLabels.Length ? rsLabels[pi].Trim() : pi.ToString();
                                                @RenderSvgText(lx, ly + 3, "middle", "middle", "#888", ScaledFontSize(7, sym), pLabel)
                                            }
                                            @* Knob (pointing to position 0) *@
                                            <circle cx="@F(rsCx)" cy="@F(rsCy)" r="@F(rsInner)"
                                                    fill="@rsKnobColor" stroke="#999" stroke-width="0.5"
                                                    style="filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4));" />
                                                var rsKnobAngle = -150.0;
                                                var rsKnobRad = rsKnobAngle * Math.PI / 180.0;
                                                var rsKnx = rsCx + rsInner * 0.7 * Math.Sin(rsKnobRad);
                                                var rsKny = rsCy - rsInner * 0.7 * Math.Cos(rsKnobRad);
                                            <line x1="@F(rsCx)" y1="@F(rsCy)" x2="@F(rsKnx)" y2="@F(rsKny)"
                                                  stroke="#333" stroke-width="2.5" stroke-linecap="round" />
                                            break;
                                            case "knob":
                                                var kbSize = Math.Min(sym.Width, sym.Height);
                                                var kbCx = sym.Width / 2.0;
                                                var kbCy = sym.Height / 2.0;
                                                var kbR = kbSize / 2.0 - 4;
                                                var kbInner = kbR * 0.65;
                                                var kbMin2 = sym.MinValue ?? 0;
                                                var kbMax2 = sym.MaxValue ?? 100;
                                                var kbTicks = 5;
                                            <circle cx="@F(kbCx)" cy="@F(kbCy)" r="@F(kbR + 2)"
                                                    fill="#1a1a1a" stroke="#555" stroke-width="1" />
                                            <circle cx="@F(kbCx)" cy="@F(kbCy)" r="@F(kbInner)"
                                                    fill="@(sym.KnobColor ?? "#3a3a3a")" stroke="#666" stroke-width="0.5"
                                                    style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));" />
                                            @if (sym.KnobShowScale)
                                            {
                                                @for (int ki = 0; ki <= kbTicks; ki++)
                                                {
                                                    var kAngle = -150.0 + (300.0 / kbTicks) * ki;
                                                    var kRad2 = kAngle * Math.PI / 180.0;
                                                    var ktx1 = kbCx + kbR * Math.Sin(kRad2);
                                                    var kty1 = kbCy - kbR * Math.Cos(kRad2);
                                                    var ktx2 = kbCx + (kbR - 5) * Math.Sin(kRad2);
                                                    var kty2 = kbCy - (kbR - 5) * Math.Cos(kRad2);
                                                    <line x1="@F(ktx1)" y1="@F(kty1)" x2="@F(ktx2)" y2="@F(kty2)"
                                                          stroke="#888" stroke-width="1" stroke-linecap="round" />
                                                    var kVal = kbMin2 + (kbMax2 - kbMin2) / kbTicks * ki;
                                                    var klx = kbCx + (kbR + 8) * Math.Sin(kRad2);
                                                    var kly = kbCy - (kbR + 8) * Math.Cos(kRad2);
                                                    @RenderSvgText(klx, kly + 3, "middle", "middle", "#888", ScaledFontSize(6, sym), kVal.ToString("F0"))
                                                }
                                            }
                                            @* Pointer line at min position *@
                                                var kpAngle = -150.0;
                                                var kpRad = kpAngle * Math.PI / 180.0;
                                                var kpx = kbCx + kbInner * 0.75 * Math.Sin(kpRad);
                                                var kpy = kbCy - kbInner * 0.75 * Math.Cos(kpRad);
                                            <line x1="@F(kbCx)" y1="@F(kbCy)" x2="@F(kpx)" y2="@F(kpy)"
                                                  stroke="@(sym.KnobPointerColor ?? "#ff6b35")" stroke-width="2.5" stroke-linecap="round" />
                                            <circle cx="@F(kbCx)" cy="@F(kbCy)" r="3" fill="@(sym.KnobPointerColor ?? "#ff6b35")" />
                                            @if (sym.KnobShowValue)
                                            {
                                                @RenderSvgText(sym.Width / 2, sym.Height - 2, "middle", null, "#aaa", ScaledFontSize(8, sym), $"{kbMin2:F0}{sym.KnobUnit}")
                                            }
                                            break;

                                                case "hslider":
                                                var hsW = sym.Width;
                                                var hsH = sym.Height;
                                                var hsTrackY = hsH / 2.0;
                                                var hsTrackH = Math.Max(4, hsH * 0.15);
                                                var hsThumbW = Math.Max(12, hsH * 0.6);
                                                var hsThumbH = hsH * 0.7;
                                                var hsFill = hsW * 0.35;
                                            <rect width="@F(hsW)" height="@F(hsH)" rx="4" fill="#1a1a2e" stroke="#334155" stroke-width="1" />
                                            <rect x="@F(hsThumbW / 2)" y="@F(hsTrackY - hsTrackH / 2)" width="@F(hsW - hsThumbW)" height="@F(hsTrackH)" rx="@F(hsTrackH / 2)"
                                                  fill="@(sym.SliderTrackColor ?? "#444")" />
                                            <rect x="@F(hsThumbW / 2)" y="@F(hsTrackY - hsTrackH / 2)" width="@F(hsFill)" height="@F(hsTrackH)" rx="@F(hsTrackH / 2)"
                                                  fill="@(sym.SliderFillColor ?? "#3b82f6")" />
                                            @if (sym.SliderShowTicks)
                                            {
                                                var hsTicks2 = 5;
                                                @for (int hti = 0; hti <= hsTicks2; hti++)
                                                {
                                                    var htx = hsThumbW / 2.0 + (hsW - hsThumbW) / hsTicks2 * hti;
                                                    <line x1="@F(htx)" y1="@F(hsTrackY + hsTrackH / 2 + 2)" x2="@F(htx)" y2="@F(hsTrackY + hsTrackH / 2 + 6)"
                                                          stroke="#666" stroke-width="1" />
                                                }
                                            }
                                            @* Thumb at ~35% *@
                                                var hsThumbX = hsThumbW / 2.0 + hsFill - hsThumbW / 2.0;
                                            <rect x="@F(hsThumbX)" y="@F(hsTrackY - hsThumbH / 2)" width="@F(hsThumbW)" height="@F(hsThumbH)" rx="4"
                                                  fill="@(sym.SliderThumbColor ?? "#ffffff")" stroke="#ccc" stroke-width="0.5"
                                                  style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4));" />
                                            <line x1="@F(hsThumbX + hsThumbW / 2 - 2)" y1="@F(hsTrackY - 3)" x2="@F(hsThumbX + hsThumbW / 2 - 2)" y2="@F(hsTrackY + 3)"
                                                  stroke="#999" stroke-width="0.8" />
                                            <line x1="@F(hsThumbX + hsThumbW / 2 + 2)" y1="@F(hsTrackY - 3)" x2="@F(hsThumbX + hsThumbW / 2 + 2)" y2="@F(hsTrackY + 3)"
                                                  stroke="#999" stroke-width="0.8" />
                                            break;
                                                case "vslider":
                                                var vsW2 = sym.Width;
                                                var vsH2 = sym.Height;
                                                var vsTrackX = vsW2 / 2.0;
                                                var vsTrackW = Math.Max(4, vsW2 * 0.15);
                                                var vsThumbW2 = vsW2 * 0.7;
                                                var vsThumbH2 = Math.Max(12, vsW2 * 0.4);
                                                var vsFillH = vsH2 * 0.35;
                                            <rect width="@F(vsW2)" height="@F(vsH2)" rx="4" fill="#1a1a2e" stroke="#334155" stroke-width="1" />
                                            <rect x="@F(vsTrackX - vsTrackW / 2)" y="@F(vsThumbH2 / 2)" width="@F(vsTrackW)" height="@F(vsH2 - vsThumbH2)" rx="@F(vsTrackW / 2)"
                                                  fill="@(sym.SliderTrackColor ?? "#444")" />
                                            <rect x="@F(vsTrackX - vsTrackW / 2)" y="@F(vsH2 - vsThumbH2 / 2 - vsFillH)" width="@F(vsTrackW)" height="@F(vsFillH)" rx="@F(vsTrackW / 2)"
                                                  fill="@(sym.SliderFillColor ?? "#3b82f6")" />
                                            @if (sym.SliderShowTicks)
                                            {
                                                var vsTicks2 = 5;
                                                @for (int vti = 0; vti <= vsTicks2; vti++)
                                                {
                                                    var vty = vsThumbH2 / 2.0 + (vsH2 - vsThumbH2) / vsTicks2 * vti;
                                                    <line x1="@F(vsTrackX + vsTrackW / 2 + 2)" y1="@F(vty)" x2="@F(vsTrackX + vsTrackW / 2 + 6)" y2="@F(vty)"
                                                          stroke="#666" stroke-width="1" />
                                                }
                                            }
                                            @* Thumb at ~35% from bottom *@
                                                var vsThumbY = vsH2 - vsThumbH2 / 2.0 - vsFillH - vsThumbH2 / 2.0;
                                            <rect x="@F(vsTrackX - vsThumbW2 / 2)" y="@F(vsThumbY)" width="@F(vsThumbW2)" height="@F(vsThumbH2)" rx="4"
                                                  fill="@(sym.SliderThumbColor ?? "#ffffff")" stroke="#ccc" stroke-width="0.5"
                                                  style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4));" />
                                            <line x1="@F(vsTrackX - 3)" y1="@F(vsThumbY + vsThumbH2 / 2 - 2)" x2="@F(vsTrackX + 3)" y2="@F(vsThumbY + vsThumbH2 / 2 - 2)"
                                                  stroke="#999" stroke-width="0.8" />
                                            <line x1="@F(vsTrackX - 3)" y1="@F(vsThumbY + vsThumbH2 / 2 + 2)" x2="@F(vsTrackX + 3)" y2="@F(vsThumbY + vsThumbH2 / 2 + 2)"
                                                  stroke="#999" stroke-width="0.8" />
                                            break;
                                        case "button":
                                                var btnW = sym.Width;
                                                var btnH = sym.Height;
                                                var btnStyle = sym.ButtonStyle ?? "raised";
                                                var btnColor = sym.ButtonColor ?? "#3b82f6";
                                                var btnTextColor = sym.ButtonTextColor ?? "#ffffff";
                                                var btnRadius = Math.Min(sym.ButtonBorderRadius, (int)(btnH / 2));
                                                var btnLabel = sym.Label ?? "Button";
                                                var btnIcon = sym.ButtonIcon ?? "";
                                                var btnIconPos = sym.ButtonIconPosition ?? "left";
                                            @switch (btnStyle)
                                            {
                                                case "outline":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="none" stroke="@btnColor" stroke-width="2" />
                                                    break;
                                                case "glass":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="@btnColor" opacity="0.25" stroke="rgba(255,255,255,0.3)" stroke-width="1" />
                                                    <rect x="1" y="1" width="@F(btnW - 2)" height="@F(btnH / 2.0 - 1)" rx="@Math.Max(0, btnRadius - 1)"
                                                          fill="rgba(255,255,255,0.15)" stroke="none" />
                                                    break;
                                                case "danger":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="#dc2626" stroke="#991b1b" stroke-width="1" />
                                                    <rect x="1" y="1" width="@F(btnW - 2)" height="@F(btnH / 2.0 - 1)" rx="@Math.Max(0, btnRadius - 1)"
                                                          fill="rgba(255,255,255,0.12)" stroke="none" />
                                                    break;
                                                case "success":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="#16a34a" stroke="#15803d" stroke-width="1" />
                                                    <rect x="1" y="1" width="@F(btnW - 2)" height="@F(btnH / 2.0 - 1)" rx="@Math.Max(0, btnRadius - 1)"
                                                          fill="rgba(255,255,255,0.12)" stroke="none" />
                                                    break;
                                                case "warning":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="#d97706" stroke="#b45309" stroke-width="1" />
                                                    <rect x="1" y="1" width="@F(btnW - 2)" height="@F(btnH / 2.0 - 1)" rx="@Math.Max(0, btnRadius - 1)"
                                                          fill="rgba(255,255,255,0.12)" stroke="none" />
                                                    break;
                                                case "pill":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@F(btnH / 2.0)"
                                                          fill="@btnColor" stroke="none" />
                                                    break;
                                                case "flat":
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="@btnColor" stroke="none" />
                                                    break;
                                                case "icon":
                                                    var iconR = Math.Min(btnW, btnH) / 2.0;
                                                    <circle cx="@F(btnW / 2.0)" cy="@F(btnH / 2.0)" r="@F(iconR)"
                                                            fill="@btnColor" stroke="none" />
                                                    break;
                                                default: @* raised *@
                                                    <rect width="@F(btnW)" height="@F(btnH)" rx="@btnRadius"
                                                          fill="@btnColor" stroke="none"
                                                          style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));" />
                                                    <rect x="1" y="1" width="@F(btnW - 2)" height="@F(btnH / 2.0 - 1)" rx="@Math.Max(0, btnRadius - 1)"
                                                          fill="rgba(255,255,255,0.15)" stroke="none" />
                                                    break;
                                            }
                                            var btnCx = btnW / 2.0;
                                            var btnCy = btnH / 2.0;
                                            var btnFs = sym.FontSize > 0 ? (double)sym.FontSize : Math.Max(8, Math.Min(14, btnH * 0.38));
                                            var btnIconFs = btnFs + 2;
                                            var hasIcon = !string.IsNullOrEmpty(btnIcon);
                                            var displayText = hasIcon
                                                ? (btnIconPos == "right" ? btnLabel + " " + btnIcon : btnIcon + " " + btnLabel)
                                                : btnLabel;
                                            @if (btnIconPos == "center" && !string.IsNullOrEmpty(btnIcon))
                                            {
                                                @RenderSvgText(btnCx, btnCy + 1, "middle", "middle", btnTextColor, (int)btnIconFs, btnIcon)
                                            }
                                            else if (btnIconPos == "top" && !string.IsNullOrEmpty(btnIcon))
                                            {
                                                @RenderSvgText(btnCx, btnCy - 4, "middle", "middle", btnTextColor, (int)btnIconFs, btnIcon)
                                                @RenderSvgText(btnCx, btnCy + btnFs * 0.7, "middle", "middle", btnTextColor, (int)(btnFs * 0.75), btnLabel)
                                            }
                                            else
                                            {
                                                @RenderSvgText(btnCx, btnCy + 1, "middle", "middle", btnTextColor, (int)btnFs, displayText)
                                            }
                                            break;
                                        case "animtext":
                                                var atW = sym.Width;
                                                var atH = sym.Height;
                                                var atBg = sym.AnimTextBackground;
                                                var atBr = sym.AnimTextBorderRadius;
                                                var atBorder = sym.AnimTextShowBorder;
                                                var atMode = sym.AnimTextMode ?? "scroll";
                                                var atLabel = sym.Label ?? "Animated Text";
                                            @if (!string.IsNullOrEmpty(atBg))
                                            {
                                                <rect width="@F(atW)" height="@F(atH)" rx="@atBr"
                                                      fill="@atBg" stroke="@(atBorder ? sym.Stroke : "none")" stroke-width="@(atBorder ? sym.StrokeWidth : 0)" />
                                            }
                                            @RenderSvgText(atW / 2.0, atH / 2.0 + 1, "middle", "middle", sym.Fill ?? "#00e5ff", sym.FontSize > 0 ? sym.FontSize : 14, atLabel, sym)
                                            @RenderSvgText(atW - 6, ScaledFontSize(10, sym), "end", null, "#888", ScaledFontSize(7, sym), atMode)
                                            break;
                                        case "progressbar":
                                            var pbTrack = sym.ProgressBarTrackColor ?? "#2d2d2d";
                                            var pbR = sym.ProgressBarBorderRadius;
                                            var pbHoriz = (sym.ProgressBarOrientation ?? "horizontal") == "horizontal";
                                            <rect width="@sym.Width" height="@sym.Height" rx="@pbR" fill="@pbTrack" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                                            @if (pbHoriz)
                                            {
                                                <rect width="@(sym.Width * 0.6)" height="@sym.Height" rx="@pbR" fill="@sym.Fill" />
                                            }
                                            else
                                            {
                                                <rect y="@(sym.Height * 0.4)" width="@sym.Width" height="@(sym.Height * 0.6)" rx="@pbR" fill="@sym.Fill" />
                                            }
