                                                    @RenderSvgText(rcx + 10, rcy, "start", "middle", ri == 0 ? "#e2e8f0" : "#94a3b8", ScaledFontSize(11, sym), rgOpts[ri])
                                                }
                                            }
                                            break;
                                        case "kpiwidget":
                                            @RenderKpiEditorPreview(sym)
                                            break;
                                        case "nlquery":
                                            <rect width="@sym.Width" height="@sym.Height"
                                                  fill="#0f172a" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                                            @RenderSvgText(sym.Width / 2, 16, "middle", "middle", "#e2e8f0", ScaledFontSize(11, sym), "🤖 NL Query")
                                            <line x1="4" y1="26" x2="@(sym.Width - 4)" y2="26" stroke="#334155" stroke-width="1" />
                                            @RenderSvgText(sym.Width / 2, 40, "middle", "middle", "#64748b", ScaledFontSize(9, sym), "(AI-powered chat at runtime)")
                                            break;
                            }
                            @if (!string.IsNullOrEmpty(labelText ?? sym.Label) && sym.Type is not "text" and not "button" and not "animtext" and not "numericdisplay" and not "progressbar" and not "dropdown" and not "radiogroup" and not "sparkline" and not "colorzone" and not "alarmbanner" and not "conveyor" and not "piechart" and not "barchart" and not "navbutton" and not "heatexchanger" and not "popup" and not "setpointramp" and not "flowmeter" and not "xyplot" and not "pdfviewer" and not "alarmanalytics" and not "kpiwidget" and not "nlquery")
                            {
                                @RenderSvgText(sym.Width / 2, sym.Height + 14, "middle", null, "#333", 11, labelText ?? sym.Label, sym)
                            }

                            @{
                                var badgeX = sym.Width - 2.0;
                            }
                            @if (sym.Animations.Count > 0)
                            {
                                @* Animation indicator badge *@
                                <circle cx="@badgeX" cy="4" r="5" fill="#17a2b8" stroke="white" stroke-width="1"/>
                                @RenderSvgText(badgeX, ScaledFontSize(7, sym), "middle", "middle", "white", ScaledFontSize(7, sym), "▶")
                                badgeX -= 12;
                            }
                            @if (SymbolHasVariables(sym))
                            {
                                @* Variable binding indicator badge *@
                                <circle cx="@badgeX" cy="4" r="5" fill="#28a745" stroke="white" stroke-width="1"/>
                                @RenderSvgText(badgeX, ScaledFontSize(7, sym), "middle", "middle", "white", ScaledFontSize(7, sym), "V")
                                badgeX -= 12;
                            }
                            @if (sym.Commands.Count > 0)
                            {
                                @* Command indicator badge *@
                                <circle cx="@badgeX" cy="4" r="5" fill="#fd7e14" stroke="white" stroke-width="1"/>
                                @RenderSvgText(badgeX, ScaledFontSize(7, sym), "middle", "middle", "white", ScaledFontSize(7, sym), "C")
                                badgeX -= 12;
                            }
                            @if (!string.IsNullOrEmpty(sym.UserSymbolGroupName))
                            {
                                @* User Symbol Group indicator badge *@
                                <circle cx="@badgeX" cy="4" r="5" fill="#8b5cf6" stroke="white" stroke-width="1"/>
                                @RenderSvgText(badgeX, ScaledFontSize(7, sym), "middle", "middle", "white", ScaledFontSize(7, sym), "G")
                                badgeX -= 12;
                            }

                            @if (isSelected)
                            {
                                <rect x="-2" y="-2" width="@(sym.Width + 4)" height="@(sym.Height + 4)"
                                      fill="none" stroke="@(sym == _selectedSymbol ? "#0d6efd" : "#6ea8fe")" stroke-width="1.5" stroke-dasharray="4,2" rx="2" />

                                @if (sym == _selectedSymbol)
                                {
                                    @* ── Resize handles (8 directions) ── *@
                                    var hw = 6.0;
                                    var hh = 6.0;
                                    var w = sym.Width;
                                    var h = sym.Height;

                                    @foreach (var handle in _resizeHandles)
                                    {
                                        var hName = handle.Name;
                                        var hx = handle.GetX(w, hw);
                                        var hy = handle.GetY(h, hh);
                                        var hCursor = handle.Cursor;

                                        <rect x="@hx" y="@hy" width="@hw" height="@hh" rx="1"
                                              fill="white" stroke="#0d6efd" stroke-width="1"
                                              style="cursor: @hCursor;"
                                              @onmousedown="(e) => OnResizeHandleMouseDown(e, sym, hName)" @onmousedown:stopPropagation />
                                    }

                                    @if (_selectedSymbols.Count == 1)
                                    {
                                        @* Rotation handle — single selection only *@
                                        <line x1="@(w / 2)" y1="-2" x2="@(w / 2)" y2="-20"
                                              stroke="#0d6efd" stroke-width="1" />
                                        <circle cx="@(w / 2)" cy="-24" r="5"
                                                fill="#0d6efd" stroke="white" stroke-width="1.5"
                                                style="cursor: grab;"
                                                @onmousedown="(e) => OnRotateHandleMouseDown(e, sym)" @onmousedown:stopPropagation />
                                    }
                                }
                            }
                        </g>
                    }


                    @* User Symbol Group bounding box + label when selected *@
                    @{
                        var selectedGroupIds = _selectedSymbols
                            .Where(s => !string.IsNullOrEmpty(s.GroupId) && !string.IsNullOrEmpty(s.UserSymbolGroupName))
                            .Select(s => s.GroupId!)
                            .Distinct()
                            .ToList();
                    }
                    @foreach (var gid in selectedGroupIds)
                    {
                        var grpSyms = screen.Symbols.Where(s => s.GroupId == gid).ToList();
                        var gMinX = grpSyms.Min(s => s.X) - 4;
                        var gMinY = grpSyms.Min(s => s.Y) - 16;
                        var gMaxX = grpSyms.Max(s => s.X + s.Width) + 4;
                        var gMaxY = grpSyms.Max(s => s.Y + s.Height) + 4;
                        var grpName = grpSyms.FirstOrDefault()?.UserSymbolGroupName ?? "";
                        <rect x="@gMinX" y="@gMinY" width="@(gMaxX - gMinX)" height="@(gMaxY - gMinY)"
                              fill="none" stroke="#8b5cf6" stroke-width="1" stroke-dasharray="6,3" rx="4" opacity="0.7" />
                        @if (!string.IsNullOrEmpty(grpName))
                        {
                            <rect x="@gMinX" y="@(gMinY - 1)" width="@(grpName.Length * 6 + 12)" height="13" rx="3" fill="#8b5cf6" opacity="0.85" />
                            @RenderSvgGroupLabel(gMinX + 6, gMinY + 9, grpName)
                        }
                    }

                    @* Marquee selection rectangle *@
                    @if (_isMarqueeSelecting)
                    {
                        var mx = Math.Min(_marqueeStartX, _marqueeEndX);
                        var my = Math.Min(_marqueeStartY, _marqueeEndY);
                        var mw = Math.Abs(_marqueeEndX - _marqueeStartX);
                        var mh = Math.Abs(_marqueeEndY - _marqueeStartY);
                        <rect x="@mx" y="@my" width="@mw" height="@mh"
                              fill="rgba(13,110,253,0.08)" stroke="#0d6efd" stroke-width="1" stroke-dasharray="4,2" />
                    }
                </svg>
            </div>
        </div>
    }



    @if (_showContextMenu)
    {
        <div style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9998;" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault></div>
        <div class="ctx-menu" style="position:fixed;left:@(_ctxMenuX)px;top:@(_ctxMenuY)px;z-index:9999;min-width:200px;background:var(--ctx-menu-bg);border:1px solid var(--ctx-menu-border);border-radius:6px;padding:4px 0;box-shadow:0 4px 16px var(--ctx-menu-shadow);font-size:12px;color:var(--ctx-menu-text);">
            @if (_selectedSymbols.Count > 0)
