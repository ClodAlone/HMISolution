    // --- Smart Snap: compute alignment guide lines ---
    private void ComputeSmartSnapGuides(ScreenConfig screen)
    {
        var sel = _selectedSymbol!;
        var selCx = sel.X + sel.Width / 2;
        var selCy = sel.Y + sel.Height / 2;

        foreach (var other in screen.Symbols)
        {
            if (_selectedSymbols.Contains(other)) continue;

            var oCx = other.X + other.Width / 2;
            var oCy = other.Y + other.Height / 2;

            // Left edge alignment
            if (Math.Abs(sel.X - other.X) < SmartSnapThreshold)
            {
                sel.X = other.X;
                _snapGuides.Add((other.X, Math.Min(sel.Y, other.Y), other.X, Math.Max(sel.Y + sel.Height, other.Y + other.Height)));
            }
            // Right edge alignment
            if (Math.Abs((sel.X + sel.Width) - (other.X + other.Width)) < SmartSnapThreshold)
            {
                sel.X = other.X + other.Width - sel.Width;
                var rx = other.X + other.Width;
                _snapGuides.Add((rx, Math.Min(sel.Y, other.Y), rx, Math.Max(sel.Y + sel.Height, other.Y + other.Height)));
            }
            // Center X alignment
            if (Math.Abs(selCx - oCx) < SmartSnapThreshold)
            {
                var offset = oCx - selCx;
                foreach (var s in _selectedSymbols) s.X += offset;
                _snapGuides.Add((oCx, Math.Min(sel.Y, other.Y), oCx, Math.Max(sel.Y + sel.Height, other.Y + other.Height)));
            }
            // Top edge alignment
            if (Math.Abs(sel.Y - other.Y) < SmartSnapThreshold)
            {
                sel.Y = other.Y;
                _snapGuides.Add((Math.Min(sel.X, other.X), other.Y, Math.Max(sel.X + sel.Width, other.X + other.Width), other.Y));
            }
            // Bottom edge alignment
            if (Math.Abs((sel.Y + sel.Height) - (other.Y + other.Height)) < SmartSnapThreshold)
            {
                sel.Y = other.Y + other.Height - sel.Height;
                var by = other.Y + other.Height;
                _snapGuides.Add((Math.Min(sel.X, other.X), by, Math.Max(sel.X + sel.Width, other.X + other.Width), by));
            }
            // Center Y alignment
            if (Math.Abs(selCy - oCy) < SmartSnapThreshold)
            {
                var offset = oCy - selCy;
                foreach (var s in _selectedSymbols) s.Y += offset;
                _snapGuides.Add((Math.Min(sel.X, other.X), oCy, Math.Max(sel.X + sel.Width, other.X + other.Width), oCy));
            }
        }
    }

    // --- Distribute to Columns ---
    private void ApplyDistributeToColumns()
    {
        _showDistributeDialog = false;
        var screen = GetScreen();
        if (screen == null || _selectedSymbols.Count < 2) return;

        CaptureSnapshots(_selectedSymbols);
        var cols = Math.Max(1, _distributeColumns);
        var sorted = _selectedSymbols.OrderBy(s => s.Y).ThenBy(s => s.X).ToList();

        var startX = sorted.Min(s => s.X);
        var startY = sorted.Min(s => s.Y);
        var maxW = sorted.Max(s => s.Width);
        var maxH = sorted.Max(s => s.Height);
        var cellW = maxW + _distributeGapX;
        var cellH = maxH + _distributeGapY;

        for (int i = 0; i < sorted.Count; i++)
        {
            var col = i % cols;
            var row = i / cols;
            sorted[i].X = startX + col * cellW;
            sorted[i].Y = startY + row * cellH;
        }
        RecordSnapshotUndo("Distribute symbols");
        OnChanged();
    }

