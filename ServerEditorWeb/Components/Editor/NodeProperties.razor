@using ServerEditorWeb.Models
@using ServerEditorWeb.Services
@using SharedModels
@inject IJSRuntime JS
@implements IDisposable

@if (Node == null)
{
    <div class="properties-panel">
        <p class="text-muted">@L["general.selectItem"]</p>
    </div>
}
else if (Node is FolderNode folder)
{
    <div class="properties-panel">
        <h5>📁 @L["section.folder"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="folder.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(folder, nameof(folder.Name))" />
        </div>
        <div class="text-muted">
            @L["prop.children"]: @folder.Children.Count (@L["prop.folders"]: @(folder.Children.OfType<FolderNode>().Count()), @L["prop.variables"]: @(folder.Children.OfType<VariableNode>().Count()))
        </div>
        @{
            var varCount = folder.Children.OfType<VariableNode>().Count();
        }
        @if (varCount > 0 || true)
        {
            <hr class="my-3" />
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <span class="small fw-semibold">Variables:</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ExportVariablesCsv(folder)" title="Export all variables in this folder to CSV">
                    📥 Export CSV
                </button>
                <label class="btn btn-sm btn-outline-secondary mb-0" title="Import variables from CSV file">
                    📤 Import CSV
                    <InputFile OnChange="(e) => ImportVariablesCsv(folder, e)" accept=".csv" style="display:none;" />
                </label>
            </div>
            @if (!string.IsNullOrEmpty(_csvMessage))
            {
                <div class="mt-2 alert @(_csvSuccess ? "alert-success" : "alert-danger") py-1 small">@_csvMessage</div>
            }
        }
    </div>
}
else if (Node is VariableNode variable)
{
    <div class="properties-panel">
        <h5>🏷️ @L["section.variable"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="variable.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(variable, nameof(variable.Name))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.type"]</label>
            <select class="form-select" @bind="variable.Variable.Type" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.Type))">
                @foreach (var t in VariableNode.AvailableTypes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.access"]</label>
            <select class="form-select" @bind="variable.Variable.Access" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.Access))">
                <option value="Read">Read</option>
                <option value="Write">Write</option>
                <option value="ReadWrite">ReadWrite</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">@L["prop.initialValue"]</label>
            <input type="text" class="form-control" @bind="variable.Variable.InitialValue" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.InitialValue))"
                   placeholder="@L["prop.initialValueHint"]" />
            <div class="form-text">@L["prop.initialValueDesc"]</div>
        </div>

        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="variable.Variable.Retentive" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.Retentive))" />
            <label class="form-check-label">@L["prop.retentive"]</label>
            <div class="form-text">@L["prop.retentiveHint"]</div>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(variable.Variable.Statistics?.Enabled == true)"
                       @onchange="e => { variable.Variable.Statistics ??= new SharedModels.VariableStatisticsConfig(); variable.Variable.Statistics.Enabled = (bool)(e.Value ?? false); if (!variable.Variable.Statistics.Enabled) variable.Variable.Statistics = null; OnChanged(); }" />
                <label class="form-check-label">@L["prop.enableStats"]</label>
            </div>
            <div class="form-text">@L["prop.enableStatsHint"]</div>
        </div>

        @* ── Data Logging ── *@
        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(variable.Variable.DataLogging?.Enabled == true)"
                       @onchange="e => { variable.Variable.DataLogging ??= new SharedModels.DataLoggingConfig(); variable.Variable.DataLogging.Enabled = (bool)(e.Value ?? false); if (!variable.Variable.DataLogging.Enabled) variable.Variable.DataLogging = null; OnChanged(); }" />
                <label class="form-check-label">Enable Data Logging</label>
            </div>
            <div class="form-text">Record this variable's value changes to the data logging database.</div>
        </div>
        @if (variable.Variable.DataLogging is { Enabled: true } dlCfg)
        {
            <div class="mb-2">
                <label class="form-label small">Hysteresis</label>
                <input type="number" step="any" class="form-control form-control-sm"
                       @bind="dlCfg.Hysteresis" @bind:after="OnChanged" />
                <div class="form-text">Minimum change in value before a new sample is recorded. 0 = log every change.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Max Age (days)</label>
                <input type="number" step="any" min="0" class="form-control form-control-sm"
                       value="@(dlCfg.MaxAge?.TotalDays)"
                       @onchange="e => { var d = double.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : (double?)null; dlCfg.MaxAge = d.HasValue ? TimeSpan.FromDays(d.Value) : null; OnChanged(); }" />
                <div class="form-text">Automatically purge logged data older than this. Empty or 0 = keep forever.</div>
            </div>
        }

        @* ── Engineering Unit ── *@
        <div class="mb-3">
            <label class="form-label">Engineering Unit</label>
            <input type="text" class="form-control" @bind="variable.Variable.EngineeringUnit" @bind:after="OnChanged"
                   placeholder="e.g. °C, bar, %, m³/h" />
            <div class="form-text">Exposed as OPC UA EngineeringUnits property.</div>
        </div>

        @* ── Scaling ── *@
        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(variable.Variable.Scaling != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) variable.Variable.Scaling ??= new SharedModels.ScalingConfig(); else variable.Variable.Scaling = null; OnChanged(); }" />
                <label class="form-check-label">Enable Linear Scaling</label>
            </div>
            <div class="form-text">Convert raw driver values to engineering units (linear interpolation).</div>
        </div>
        @if (variable.Variable.Scaling is { } sc)
        {
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Raw Min</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.RawMin" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label small">Raw Max</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.RawMax" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Eng Min</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.EngMin" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label small">Eng Max</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.EngMax" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="sc.ClampEnabled" @bind:after="OnChanged" />
                <label class="form-check-label">Clamp to engineering range</label>
            </div>
        }

        <VariableDriverEditor Variable="variable.Variable"
                              VariableNode="variable"
                              OnChanged="OnChanged" />

        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between">
                <label class="form-label mb-0">@L["prop.driverJson"]</label>
                <button class="btn btn-sm btn-link py-0" style="font-size: 9px;"
                        @onclick="() => _showDriverJson = !_showDriverJson">
                    @(_showDriverJson ? "▼ Hide" : "▶ Show")
                </button>
            </div>
            @if (_showDriverJson)
            {
                <CodeEditor @bind-Value="variable.DriverSettingsJson" @bind-Value:after="OnDriverJsonChanged" Language="json" Height="120px" />
            }
        </div>
    </div>
}
else if (Node is ScriptNode script)
{
    <div class="properties-panel">
        <h5>⚡ @L["section.script"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="script.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(script, nameof(script.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="script.Script.Enabled" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(script.Script, nameof(script.Script.Enabled))" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.interval"]</label>
            <input type="number" class="form-control" @bind="script.Script.IntervalMs" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(script.Script, nameof(script.Script.IntervalMs))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.language"]</label>
            <select class="form-select" @bind="script.Script.Language" @bind:after="OnLanguageChanged">
                <option value="CSharp">C#</option>
                <option value="VB">VB.NET</option>
            </select>
        </div>
        <div class="alert alert-info small mt-2">
            <strong>Script Editor</strong> — Double-click the node or open the
            <strong>Script Editor</strong> panel to edit code with syntax checking and live debug annotations.
        </div>
    </div>
}
else if (Node is ResourceFolderNode resFolder)
{
    <div class="properties-panel">
        <h5>📁 @L["section.folder"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="resFolder.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(resFolder, nameof(resFolder.Name))" />
        </div>
        <div class="text-muted">
            @L["prop.type"]: @resFolder.ResourceKind<br/>
            @L["prop.children"]: @resFolder.Children.Count
        </div>
    </div>
}
else if (Node is ScriptGroupNode)
{
    <div class="properties-panel">
        <h5>📜 Script Group</h5>
        <p class="text-muted">Select a script to edit, or add a new one.</p>
    </div>
}
else if (Node is PlcProgramNode plcNode)
{
    <div class="properties-panel">
        <h5>⚙️ @L["section.plc"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="plcNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(plcNode, nameof(plcNode.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="plcNode.PlcProgram.Enabled" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(plcNode.PlcProgram, nameof(plcNode.PlcProgram.Enabled))" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.cycleTime"]</label>
            <input type="number" class="form-control" @bind="plcNode.PlcProgram.IntervalMs" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(plcNode.PlcProgram, nameof(plcNode.PlcProgram.IntervalMs))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.language"]</label>
            <select class="form-select" @bind="plcNode.PlcProgram.Language" @bind:after="OnPlcLanguageChanged">
                <option value="ST">Structured Text (ST)</option>
                <option value="IL">Instruction List (IL)</option>
                <option value="LD">Ladder Diagram (LD)</option>
            </select>
        </div>

        @if (plcNode.PlcProgram.Language.Equals("LD", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert alert-info small">
                <strong>⚡ Ladder Diagram</strong> — Double-click the node or open the
                <strong>Ladder Editor</strong> panel to use the graphical editor with contacts, coils, and function blocks.
            </div>
        }
        else
        {
            <div class="alert alert-info small">
                <strong>@GetPlcLanguageLabel(plcNode.PlcProgram.Language) Editor</strong> — Double-click the node or open the
                <strong>PLC Editor</strong> panel to edit code with syntax checking and live debug annotations.
            </div>
        }

        @* ── PID Auto-Tune Wizard ── *@
        @if (plcNode.PlcProgram.Language.Equals("ST", StringComparison.OrdinalIgnoreCase))
        {
            <hr />
            <h6>🎛️ PID Auto-Tune Wizard</h6>
            <div class="form-text mb-2">
                Automatically compute PID gains (Kp, Ki, Kd) using relay feedback, then generate
                Structured Text code for the tuned controller.
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(plcNode.PlcProgram.PidAutoTune != null)"
                       @onchange="(e) => { if ((bool)(e.Value ?? false)) plcNode.PlcProgram.PidAutoTune ??= new PidAutoTuneConfig(); else plcNode.PlcProgram.PidAutoTune = null; OnChanged(); }" />
                <label class="form-check-label">Enable PID Auto-Tune</label>
            </div>
            @if (plcNode.PlcProgram.PidAutoTune is { } pidCfg)
            {
                <div class="card p-2 mb-2">
                    <h6 class="small mb-2">Step 1 — Process Variables</h6>
                    <div class="mb-1">
                        <label class="form-label mb-0 small">Process Variable (PV) Path</label>
                        <VariablePathPicker Value="@pidCfg.ProcessVariablePath"
                                            ValueChanged="v => { pidCfg.ProcessVariablePath = v ?? string.Empty; }"
                                            OnChanged="OnChanged"
                                            Placeholder="e.g. Plant.Furnace.Temperature" />
                        <div class="form-text">OPC variable path of the sensor reading.</div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label mb-0 small">Output Path</label>
                        <VariablePathPicker Value="@pidCfg.OutputPath"
                                            ValueChanged="v => { pidCfg.OutputPath = v ?? string.Empty; }"
                                            OnChanged="OnChanged"
                                            Placeholder="e.g. Plant.Furnace.HeaterPower" />
                        <div class="form-text">OPC variable path for the controller output (actuator).</div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label mb-0 small">Setpoint Path (optional)</label>
                        <VariablePathPicker Value="@pidCfg.SetpointPath"
                                            ValueChanged="v => { pidCfg.SetpointPath = v ?? string.Empty; }"
                                            OnChanged="OnChanged"
                                            Placeholder="Leave empty to use constant below" />
                    </div>
                    <div class="row g-2 mb-1">
                        <div class="col-6">
                            <label class="form-label mb-0 small">Setpoint Value</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   @bind="pidCfg.Setpoint" @bind:after="OnChanged" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small">PID Type</label>
                            <select class="form-select form-select-sm" @bind="pidCfg.PidType" @bind:after="OnChanged">
                                <option value="P">P (Proportional only)</option>
                                <option value="PI">PI (Proportional + Integral)</option>
                                <option value="PID">PID (Full)</option>
                            </select>
                        </div>
                    </div>

                    <h6 class="small mt-2 mb-2">Step 2 — Relay Experiment Parameters</h6>
                    <div class="row g-2 mb-1">
                        <div class="col-4">
                            <label class="form-label mb-0 small">Relay Amplitude</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   @bind="pidCfg.RelayAmplitude" @bind:after="OnChanged" />
                            <div class="form-text">Half-amplitude of relay output.</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Output Bias</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   @bind="pidCfg.OutputBias" @bind:after="OnChanged" />
                            <div class="form-text">Steady-state center output.</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Hysteresis</label>
                            <input type="number" step="0.01" class="form-control form-control-sm"
                                   @bind="pidCfg.Hysteresis" @bind:after="OnChanged" />
                        </div>
                    </div>
                    <div class="row g-2 mb-1">
                        <div class="col-6">
                            <label class="form-label mb-0 small">Output Min</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   @bind="pidCfg.OutputMin" @bind:after="OnChanged" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small">Output Max</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   @bind="pidCfg.OutputMax" @bind:after="OnChanged" />
                        </div>
                    </div>

                    <h6 class="small mt-2 mb-2">Step 3 — Compute Gains</h6>
                    <div class="form-text mb-2">
                        Click <strong>Calculate (Offline)</strong> to compute gains from manually observed oscillation data,
                        or fill the fields above and use the server's live auto-tune endpoint at runtime.
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label mb-0 small">Ultimate Gain (Ku)</label>
                            <input type="number" step="0.001" class="form-control form-control-sm" @bind="_pidKu" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Ultimate Period (Pu, sec)</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="_pidPu" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Osc. Amplitude</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="_pidAmplitude" />
                        </div>
                    </div>
                    <button class="btn btn-sm btn-primary mb-2"
                            disabled="@(_pidKu <= 0 || _pidPu <= 0 || _pidAmplitude <= 0)"
                            @onclick="() => ComputePidGains(plcNode)">
                        🧮 Calculate (Ziegler–Nichols)
                    </button>

                    @if (!string.IsNullOrEmpty(_pidResultMessage))
                    {
                        <div class="alert @(_pidResultSuccess ? "alert-success" : "alert-danger") small py-1 px-2">
                            @_pidResultMessage
                        </div>
                    }

                    @if (pidCfg.LastKp > 0)
                    {
                        <h6 class="small mt-2 mb-1">Computed Gains</h6>
                        <div class="d-flex gap-3 small mb-2">
                            <span><strong>Kp</strong> = @pidCfg.LastKp</span>
                            <span><strong>Ki</strong> = @pidCfg.LastKi</span>
                            <span><strong>Kd</strong> = @pidCfg.LastKd</span>
                        </div>
                        <button class="btn btn-sm btn-outline-success"
                                @onclick="() => GeneratePidCode(plcNode)">
                            📝 Generate ST Code &amp; Apply
                        </button>
                        <div class="form-text mt-1">
                            Replaces the PLC program code with a tuned PID controller. Paths marked <code>TODO_</code> must be updated.
                        </div>
                    }
                </div>
            }
        }
    </div>
}
else if (Node is PlcGroupNode)
{
    <div class="properties-panel">
        <h5>🔧 PLC Programs</h5>
        <p class="text-muted">Select a PLC program to edit, or add a new one.</p>
        <p class="text-muted small">
            PLC programs use IEC 61131-3 languages to read and write OPC variables cyclically.<br/>
            Supported languages: <strong>Structured Text (ST)</strong>, <strong>Instruction List (IL)</strong>, and <strong>Ladder Diagram (LD)</strong>.
        </p>
    </div>
}
else if (Node is RecipeNode recipeNode)
{
    <div class="properties-panel">
        <h5>📦 @L["section.recipe"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="recipeNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(recipeNode, nameof(recipeNode.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="recipeNode.Recipe.Enabled" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(recipeNode.Recipe, nameof(recipeNode.Recipe.Enabled))" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.dbPath"]</label>
            <input type="text" class="form-control" @bind="recipeNode.Recipe.DbPath" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(recipeNode.Recipe, nameof(recipeNode.Recipe.DbPath))"
                   placeholder="recipes/{name}.db (relative to config)" />
            <div class="form-text">Leave empty for default: <code>recipes/@(recipeNode.Name).db</code></div>
        </div>

        <h6 class="mt-3">Recipe Variables</h6>
        <p class="text-muted small">
            Each variable is identified by a stable <strong>Index</strong> (used as the column key in the database)
            and maps to an OPC <strong>Variable Path</strong>.
        </p>

        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th style="width: 60px;">Index</th>
                    <th>Variable Path</th>
                    <th style="width: 120px;">Display Name</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < recipeNode.Recipe.Variables.Count; i++)
                {
                    var idx = i;
                    var rv = recipeNode.Recipe.Variables[idx];
                    <tr>
                        <td>
                            <input type="number" class="form-control form-control-sm" value="@rv.Index"
                                   @onchange="e => { rv.Index = int.TryParse(e.Value?.ToString(), out var n) ? n : rv.Index; OnChanged(); }" />
                        </td>
                        <td>
                            <VariablePathPicker Value="@rv.VariablePath"
                                             ValueChanged="v => { rv.VariablePath = v ?? string.Empty; }"
                                             OnChanged="OnChanged"
                                             Placeholder="e.g. Plant.Furnace.Temperature" />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" value="@rv.DisplayName"
                                   placeholder="(optional)"
                                   @onchange="e => { rv.DisplayName = e.Value?.ToString() ?? string.Empty; OnChanged(); }" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRecipeVariable(recipeNode, idx)" title="Remove">🗑</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddRecipeVariable(recipeNode)">➕ Add Variable</button>

        <div class="alert alert-info small mt-3">
            <strong>OPC Variables at Runtime:</strong><br/>
            The server creates the following variables under <code>Recipe.@(recipeNode.Name)</code>:
            <ul class="mb-0 mt-1">
                <li><code>.Load</code> — Write a recipe name to load stored values into OPC variables</li>
                <li><code>.Save</code> — Write a recipe name to save current OPC variable values</li>
                <li><code>.Activate</code> — Write a recipe name to load + set as active</li>
                <li><code>.Delete</code> — Write a recipe name to delete it from the database</li>
                <li><code>.ActiveName</code> — Read the currently active recipe name</li>
                <li><code>.RecipeList</code> — Read a comma-separated list of stored recipes</li>
                <li><code>.LastStatus</code> — Read the result of the last operation</li>
            </ul>
        </div>
    </div>
}
else if (Node is RecipeGroupNode)
{
    <div class="properties-panel">
        <h5>🍳 Recipes</h5>
        <p class="text-muted">Select a recipe to edit, or add a new one.</p>
        <p class="text-muted small">
            Recipes store named sets of variable values in a SQLite database.<br/>
            At runtime, OPC command variables allow loading, saving, and activating recipes
            from HMI screens, scripts, or PLC programs.
        </p>
    </div>
}
else if (Node is SchedulerNode schedulerNode)
{
    <div class="properties-panel">
        <h5>📅 @L["section.scheduler"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="schedulerNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(schedulerNode, nameof(schedulerNode.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="schedulerNode.Scheduler.Enabled" @bind:after="OnChanged" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">Enable Variable</label>
            <VariablePathPicker Value="@schedulerNode.Scheduler.EnableVariablePath"
                                ValueChanged='v => { schedulerNode.Scheduler.EnableVariablePath = v ?? string.Empty; }'
                                OnChanged="OnChanged"
                                Placeholder="e.g. Plant.Scheduler.Enable" />
            <div class="form-text">Optional. When set, the scheduler is active only when this variable is truthy (1 / true). Leave empty to always run when Enabled is checked.</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="schedulerNode.Scheduler.AllowRuntimeEdit" @bind:after="OnChanged" />
            <label class="form-check-label">@L["prop.allowRuntimeEdit"]</label>
            <div class="form-text">@L["prop.allowRuntimeEditHint"]</div>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.slotGranularity"]</label>
            <select class="form-select" @bind="schedulerNode.Scheduler.SlotMinutes" @bind:after="OnChanged">
                <option value="15">15 minutes</option>
                <option value="60">1 hour</option>
            </select>
        </div>

        <h6 class="mt-3">Weekend Behavior</h6>
        <div class="mb-3">
            <select class="form-select" @bind="schedulerNode.Scheduler.WeekendMode" @bind:after="OnChanged">
                <option value="Same">Same as weekdays</option>
                <option value="Off">Off (no execution)</option>
                <option value="Custom">Custom weekend schedule</option>
            </select>
        </div>

        <h6 class="mt-3">Holiday Behavior</h6>
        <div class="mb-3">
            <select class="form-select" @bind="schedulerNode.Scheduler.HolidayMode" @bind:after="OnChanged">
                <option value="Same">Same as normal schedule</option>
                <option value="Off">Off (no execution)</option>
                <option value="Weekend">Use weekend schedule</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.holidayLocale"]</label>
            <select class="form-select" @bind="schedulerNode.Scheduler.HolidayLocale" @bind:after="OnChanged">
                <option value="">@L["prop.none"]</option>
                @foreach (var locale in SharedModels.HolidayCalendars.AvailableLocales)
                {
                    <option value="@locale">@locale</option>
                }
            </select>
            <div class="form-text">@L["prop.holidayLocaleHint"]</div>
        </div>

        @if (!string.IsNullOrEmpty(schedulerNode.Scheduler.HolidayLocale) && SharedModels.HolidayCalendars.BuiltIn.TryGetValue(schedulerNode.Scheduler.HolidayLocale, out var builtInHolidays))
        {
            <details class="mb-3">
                <summary class="small text-muted">Built-in holidays (@schedulerNode.Scheduler.HolidayLocale): @builtInHolidays.Count</summary>
                <ul class="list-unstyled small ps-3 mt-1">
                    @foreach (var h in builtInHolidays)
                    {
                        <li>@h.Name — @h.Month/@h.Day</li>
                    }
                </ul>
            </details>
        }

        <h6 class="mt-3">Custom Holidays</h6>
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th style="width: 60px;">Month</th>
                    <th style="width: 60px;">Day</th>
                    <th style="width: 60px;">Year</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in schedulerNode.Scheduler.CustomHolidays)
                {
                    var holiday = h;
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" @bind="holiday.Name" @bind:after="OnChanged" /></td>
                        <td><input type="number" class="form-control form-control-sm" @bind="holiday.Month" @bind:after="OnChanged" /></td>
                        <td><input type="number" class="form-control form-control-sm" @bind="holiday.Day" @bind:after="OnChanged" /></td>
                        <td><input type="number" class="form-control form-control-sm" @bind="holiday.Year" @bind:after="OnChanged" placeholder="0=all" /></td>
                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => { schedulerNode.Scheduler.CustomHolidays.Remove(holiday); OnChanged(); }">🗑</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-sm btn-outline-primary" @onclick="() => { schedulerNode.Scheduler.CustomHolidays.Add(new SharedModels.HolidayEntry()); OnChanged(); }">➕ Add Holiday</button>

        <h6 class="mt-3">Activate Commands</h6>
        <p class="text-muted small">Commands executed when a time slot becomes active.</p>
        @for (int i = 0; i < schedulerNode.Scheduler.Commands.Count; i++)
        {
            var idx = i;
            var cmd = schedulerNode.Scheduler.Commands[idx];
            <div class="border rounded p-2 mb-2" style="font-size: 11px;">
                <div class="d-flex gap-1 mb-1">
                    <select class="form-select form-select-sm" style="font-size: 10px;" @bind="cmd.Action" @bind:after="OnChanged">
                        <optgroup label="Navigation">
                            <option value="NavigateScreen">Navigate Screen</option>
                            <option value="OpenScreenPopup">Open Screen Popup</option>
                            <option value="OpenScreenModal">Open Screen Modal</option>
                        </optgroup>
                        <optgroup label="Variables">
                            <option value="SetVariable">Set Variable</option>
                            <option value="WriteVariable">Write Variable</option>
                            <option value="ResetVariable">Reset Variable</option>
                            <option value="ToggleVariable">Toggle Variable</option>
                            <option value="IncrementVariable">Increment Variable</option>
                            <option value="DecrementVariable">Decrement Variable</option>
                        </optgroup>
                        <optgroup label="Scripting">
                            <option value="ExecuteScript">Execute Script</option>
                            <option value="ExecuteJavaScript">Execute JavaScript</option>
                        </optgroup>
                        <optgroup label="Authentication">
                            <option value="Login">Login</option>
                            <option value="Logout">Logout</option>
                        </optgroup>
                        <optgroup label="Alarms">
                            <option value="AcknowledgeAllAlarms">Acknowledge All Alarms</option>
                            <option value="ResetAllAlarms">Reset All Alarms</option>
                        </optgroup>
                        <optgroup label="Other">
                            <option value="ChangeLanguage">Change Language</option>
                        </optgroup>
                    </select>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;" @onclick="() => { schedulerNode.Scheduler.Commands.RemoveAt(idx); OnChanged(); }">🗑</button>
                </div>
                @if (cmd.Action is "SetVariable" or "WriteVariable" or "ToggleVariable" or "IncrementVariable" or "DecrementVariable")
                {
                    <VariablePathPicker Value="@cmd.VariablePath"
                                        ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                        OnChanged="OnChanged"
                                        Placeholder="Variable path" />
                    @if (cmd.Action is not "ToggleVariable")
                    {
                        <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="@(cmd.Action is "IncrementVariable" or "DecrementVariable" ? "Step (default 1)" : "Value")" @bind="cmd.Value" @bind:after="OnChanged" />
                    }
                }
                else if (cmd.Action == "ResetVariable")
                {
                    <VariablePathPicker Value="@cmd.VariablePath"
                                        ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                        OnChanged="OnChanged"
                                        Placeholder="Variable path" />
                }
                else if (cmd.Action is "NavigateScreen" or "OpenScreenPopup" or "OpenScreenModal")
                {
                    <ScreenPicker Value="@cmd.TargetScreen"
                                  ValueChanged='v => { cmd.TargetScreen = v ?? string.Empty; }'
                                  OnChanged="OnChanged"
                                  Placeholder="(select screen)" />
                    <select class="form-select form-select-sm mt-1" style="font-size: 10px;" @bind="cmd.AliasMapName" @bind:after="OnChanged">
                        <option value="">(no alias map)</option>
                        @if (Editor.RootModel?.AliasMaps != null)
                        {
                            @foreach (var am in Editor.RootModel.AliasMaps)
                            {
                                <option value="@am.Name">@am.Name</option>
                            }
                        }
                    </select>
                }
                else if (cmd.Action is "ExecuteScript" or "ExecuteJavaScript")
                {
                    <textarea class="form-control form-control-sm" style="font-size: 10px;" rows="3" placeholder="@(cmd.Action == "ExecuteJavaScript" ? "JavaScript code" : "C# script")" @bind="cmd.Script" @bind:after="OnChanged"></textarea>
                }
                else if (cmd.Action is "AcknowledgeAllAlarms" or "ResetAllAlarms")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Comment (optional)" @bind="cmd.Value" @bind:after="OnChanged" />
                }
                else if (cmd.Action == "ChangeLanguage")
                {
                    <LocalePicker Value="@cmd.TargetLocale"
                                  ValueChanged='v => { cmd.TargetLocale = v ?? string.Empty; }'
                                  OnChanged="OnChanged"
                                  Placeholder="(select language)" />
                }
                else if (cmd.Action == "GenerateReport")
                {
                    <ReportPicker Value="@cmd.TargetReport"
                                  ValueChanged='v => { cmd.TargetReport = v ?? string.Empty; }'
                                  OnChanged="OnChanged"
                                  Placeholder="(select report)" />
                }
            </div>
        }
        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddSchedulerCommand(schedulerNode, false)">➕ Add Command</button>

        <h6 class="mt-3">Deactivate Commands</h6>
        <p class="text-muted small">Commands executed when leaving a time slot (becomes inactive).</p>
        @for (int i = 0; i < schedulerNode.Scheduler.DeactivateCommands.Count; i++)
        {
            var idx = i;
            var cmd = schedulerNode.Scheduler.DeactivateCommands[idx];
            <div class="border rounded p-2 mb-2" style="font-size: 11px;">
                <div class="d-flex gap-1 mb-1">
                    <select class="form-select form-select-sm" style="font-size: 10px;" @bind="cmd.Action" @bind:after="OnChanged">
                        <optgroup label="Navigation">
                            <option value="NavigateScreen">Navigate Screen</option>
                            <option value="OpenScreenPopup">Open Screen Popup</option>
                            <option value="OpenScreenModal">Open Screen Modal</option>
                        </optgroup>
                        <optgroup label="Variables">
                            <option value="SetVariable">Set Variable</option>
                            <option value="WriteVariable">Write Variable</option>
                            <option value="ResetVariable">Reset Variable</option>
                            <option value="ToggleVariable">Toggle Variable</option>
                            <option value="IncrementVariable">Increment Variable</option>
                            <option value="DecrementVariable">Decrement Variable</option>
                        </optgroup>
                        <optgroup label="Scripting">
                            <option value="ExecuteScript">Execute Script</option>
                            <option value="ExecuteJavaScript">Execute JavaScript</option>
                        </optgroup>
                        <optgroup label="Authentication">
                            <option value="Login">Login</option>
                            <option value="Logout">Logout</option>
                        </optgroup>
                        <optgroup label="Alarms">
                            <option value="AcknowledgeAllAlarms">Acknowledge All Alarms</option>
                            <option value="ResetAllAlarms">Reset All Alarms</option>
                        </optgroup>
                        <optgroup label="Other">
                            <option value="ChangeLanguage">Change Language</option>
                        </optgroup>
                    </select>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;" @onclick="() => { schedulerNode.Scheduler.DeactivateCommands.RemoveAt(idx); OnChanged(); }">🗑</button>
                </div>
                @if (cmd.Action is "SetVariable" or "WriteVariable" or "ToggleVariable" or "IncrementVariable" or "DecrementVariable")
                {
                    <VariablePathPicker Value="@cmd.VariablePath"
                                        ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                        OnChanged="OnChanged"
                                        Placeholder="Variable path" />
                    @if (cmd.Action is not "ToggleVariable")
                    {
                        <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="@(cmd.Action is "IncrementVariable" or "DecrementVariable" ? "Step (default 1)" : "Value")" @bind="cmd.Value" @bind:after="OnChanged" />
                    }
                }
                else if (cmd.Action == "ResetVariable")
                {
                    <VariablePathPicker Value="@cmd.VariablePath"
                                        ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                        OnChanged="OnChanged"
                                        Placeholder="Variable path" />
                }
                else if (cmd.Action is "NavigateScreen" or "OpenScreenPopup" or "OpenScreenModal")
                {
                    <ScreenPicker Value="@cmd.TargetScreen"
                                  ValueChanged='v => { cmd.TargetScreen = v ?? string.Empty; }'
                                  OnChanged="OnChanged"
                                  Placeholder="(select screen)" />
                    <select class="form-select form-select-sm mt-1" style="font-size: 10px;" @bind="cmd.AliasMapName" @bind:after="OnChanged">
                        <option value="">(no alias map)</option>
                        @if (Editor.RootModel?.AliasMaps != null)
                        {
                            @foreach (var am in Editor.RootModel.AliasMaps)
                            {
                                <option value="@am.Name">@am.Name</option>
                            }
                        }
                    </select>
                }
                else if (cmd.Action is "ExecuteScript" or "ExecuteJavaScript")
                {
                    <textarea class="form-control form-control-sm" style="font-size: 10px;" rows="3" placeholder="@(cmd.Action == "ExecuteJavaScript" ? "JavaScript code" : "C# script")" @bind="cmd.Script" @bind:after="OnChanged"></textarea>
                }
                else if (cmd.Action is "AcknowledgeAllAlarms" or "ResetAllAlarms")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Comment (optional)" @bind="cmd.Value" @bind:after="OnChanged" />
                }
                else if (cmd.Action == "ChangeLanguage")
                {
                    <LocalePicker Value="@cmd.TargetLocale"
                                  ValueChanged='v => { cmd.TargetLocale = v ?? string.Empty; }'
                                  OnChanged="OnChanged"
                                  Placeholder="(select language)" />
                }
                else if (cmd.Action == "GenerateReport")
                {
                    <ReportPicker Value="@cmd.TargetReport"
                                  ValueChanged='v => { cmd.TargetReport = v ?? string.Empty; }'
                                  OnChanged="OnChanged"
                                  Placeholder="(select report)" />
                }
            </div>
        }
        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddSchedulerCommand(schedulerNode, true)">➕ Add Deactivate Command</button>

        <div class="alert alert-info small mt-3">
            <strong>Usage:</strong> Use the <strong>Scheduler Editor</strong> panel to visually edit the weekly schedule.
            Add a <strong>Weekly Planner</strong> widget to a screen to let runtime users view/edit the schedule.
        </div>
    </div>
}
else if (Node is SchedulerGroupNode)
{
    <div class="properties-panel">
        <h5>⏰ Schedulers</h5>
        <p class="text-muted">Select a scheduler to edit, or add a new one.</p>
        <p class="text-muted small">
            Schedulers execute commands at configured times on a weekly recurring basis.<br/>
            Supports different behaviors for weekdays, weekends, and public holidays.
        </p>
    </div>
}
else if (Node is ReportNode reportNode)
{
    var _selectedSection = Editor.SelectedReportSection;
    <div class="properties-panel">
    @if (_selectedSection != null && reportNode.Report.Sections.Contains(_selectedSection))
    {
        var sec = _selectedSection;
        <h5>@GetReportSectionIcon(sec.Type) @sec.Type Section Properties</h5>
        <div class="mb-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editor.SetReportSectionSelection(null)">← Back to Report Properties</button>
        </div>

        @if (sec.Type == "Header")
        {
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" class="form-control" @bind="sec.Title" @bind:after="OnChanged" placeholder="Section heading" />
            </div>
        }
        else if (sec.Type == "Text")
        {
            <div class="mb-3">
                <label class="form-label">Title (optional)</label>
                <input type="text" class="form-control" @bind="sec.Title" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">Content (HTML supported)</label>
                <textarea class="form-control" rows="4" @bind="sec.Content" @bind:after="OnChanged"></textarea>
            </div>
        }
        else if (sec.Type == "Chart")
        {
            <div class="mb-3">
                <label class="form-label">Chart Title</label>
                <input type="text" class="form-control" @bind="sec.Title" @bind:after="OnChanged" placeholder="e.g. Temperature History" />
            </div>
            <div class="mb-3">
                <label class="form-label">Chart Type</label>
                <select class="form-select" @bind="sec.ChartType" @bind:after="OnChanged">
                    <option value="Line">Line</option>
                    <option value="Bar">Bar</option>
                    <option value="Area">Area</option>
                    <option value="Pie">Pie</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Time Range (minutes)</label>
                <input type="number" class="form-control" @bind="sec.ChartTimeRangeMinutes" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">Max Points</label>
                <input type="number" class="form-control" @bind="sec.ChartMaxPoints" @bind:after="OnChanged" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label">Width</label>
                    <input type="number" class="form-control" @bind="sec.ChartWidth" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label">Height</label>
                    <input type="number" class="form-control" @bind="sec.ChartHeight" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="sec.ChartShowLegend" @bind:after="OnChanged" />
                <label class="form-check-label">Show Legend</label>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="sec.ChartShowGrid" @bind:after="OnChanged" />
                <label class="form-check-label">Show Grid</label>
            </div>
            <div class="mb-3">
                <label class="form-label">Variable Paths</label>
                @for (int vi = 0; vi < sec.ChartVariablePaths.Count; vi++)
                {
                    var vIdx = vi;
                    <div class="d-flex gap-1 mb-1">
                        <VariablePathPicker Value="@sec.ChartVariablePaths[vIdx]"
                                            ValueChanged="v => { sec.ChartVariablePaths[vIdx] = v ?? string.Empty; }"
                                            OnChanged="OnChanged"
                                            Placeholder="e.g. Folder1.Temperature" />
                        <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                @onclick="() => { sec.ChartVariablePaths.RemoveAt(vIdx); OnChanged(); }">✕</button>
                    </div>
                }
                <button class="btn btn-sm btn-outline-primary"
                        @onclick="() => { sec.ChartVariablePaths.Add(string.Empty); OnChanged(); }">➕ Add Variable</button>
            </div>
        }
        else if (sec.Type == "Table")
        {
            <div class="mb-3">
                <label class="form-label">Table Title</label>
                <input type="text" class="form-control" @bind="sec.Title" @bind:after="OnChanged" placeholder="e.g. Current Values" />
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="sec.TableShowStatistics" @bind:after="OnChanged" />
                <label class="form-check-label">Show Statistics (Min/Max/Avg)</label>
            </div>
            @if (sec.TableShowStatistics)
            {
                <div class="mb-3">
                    <label class="form-label">Statistics Time Range (minutes)</label>
                    <input type="number" class="form-control" @bind="sec.TableTimeRangeMinutes" @bind:after="OnChanged" />
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Variable Paths</label>
                @for (int ti = 0; ti < sec.TableVariablePaths.Count; ti++)
                {
                    var tIdx = ti;
                    <div class="d-flex gap-1 mb-1">
                        <VariablePathPicker Value="@sec.TableVariablePaths[tIdx]"
                                            ValueChanged="v => { sec.TableVariablePaths[tIdx] = v ?? string.Empty; }"
                                            OnChanged="OnChanged"
                                            Placeholder="e.g. Folder1.Pressure" />
                        <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                @onclick="() => { sec.TableVariablePaths.RemoveAt(tIdx); OnChanged(); }">✕</button>
                    </div>
                }
                <button class="btn btn-sm btn-outline-primary"
                        @onclick="() => { sec.TableVariablePaths.Add(string.Empty); OnChanged(); }">➕ Add Variable</button>
            </div>
        }
        else if (sec.Type == "Value")
        {
            <div class="mb-3">
                <label class="form-label">Label</label>
                <input type="text" class="form-control" @bind="sec.ValueLabel" @bind:after="OnChanged" placeholder="e.g. Current Temperature" />
            </div>
            <div class="mb-3">
                <label class="form-label">Variable Path</label>
                <VariablePathPicker Value="@sec.ValueVariablePath"
                                    ValueChanged="v => { sec.ValueVariablePath = v ?? string.Empty; }"
                                    OnChanged="OnChanged"
                                    Placeholder="e.g. Folder1.Temperature" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label">Format</label>
                    <input type="text" class="form-control" @bind="sec.ValueFormat" @bind:after="OnChanged" placeholder="e.g. F2" />
                </div>
                <div class="col-6">
                    <label class="form-label">Unit</label>
                    <input type="text" class="form-control" @bind="sec.ValueUnit" @bind:after="OnChanged" placeholder="e.g. °C" />
                </div>
            </div>
        }
        else if (sec.Type == "PageBreak")
        {
            <div class="text-muted small">Page break (PDF only). No additional settings.</div>
        }
    }
    else
    {
        <h5>📄 @L["section.report"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="reportNode.Name" @bind:after="OnChanged" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="reportNode.Report.Enabled" @bind:after="OnChanged" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.title"]</label>
            <input type="text" class="form-control" @bind="reportNode.Report.Title" @bind:after="OnChanged" placeholder="Report title in header" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.description"]</label>
            <textarea class="form-control" rows="2" @bind="reportNode.Report.Description" @bind:after="OnChanged" placeholder="Optional subtitle"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.format"]</label>
            <select class="form-select" @bind="reportNode.Report.Format" @bind:after="OnChanged">
                <option value="HTML">HTML</option>
                <option value="PDF">PDF</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.pageSize"]</label>
            <select class="form-select" @bind="reportNode.Report.PageSize" @bind:after="OnChanged">
                <option value="A4">A4</option>
                <option value="Letter">Letter</option>
                <option value="A3">A3</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.orientation"]</label>
            <select class="form-select" @bind="reportNode.Report.Orientation" @bind:after="OnChanged">
                <option value="Portrait">Portrait</option>
                <option value="Landscape">Landscape</option>
            </select>
        </div>

        <h6 class="mt-3">Delivery</h6>
        <div class="mb-3">
            <label class="form-label">@L["prop.deliveryMethod"]</label>
            <select class="form-select" @bind="reportNode.Report.Delivery.Method" @bind:after="OnChanged">
                <option value="Disk">Save to Disk</option>
                <option value="Email">Send via Email</option>
                <option value="Both">Both (Disk + Email)</option>
            </select>
        </div>

        @if (reportNode.Report.Delivery.Method is "Disk" or "Both")
        {
            <div class="mb-3">
                <label class="form-label">@L["prop.outputDir"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.DiskPath" @bind:after="OnChanged" placeholder="Reports" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.fileNamePattern"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.FileNamePattern" @bind:after="OnChanged" placeholder="{ReportName}_{DateTime}" />
                <div class="form-text">Placeholders: {ReportName}, {DateTime}, {Date}</div>
            </div>
        }

        @if (reportNode.Report.Delivery.Method is "Email" or "Both")
        {
            <div class="mb-3">
                <label class="form-label">@L["prop.recipients"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.EmailRecipients" @bind:after="OnChanged" placeholder="user@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.emailSubject"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.EmailSubject" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpServer"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.SmtpServer" @bind:after="OnChanged" placeholder="smtp.example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpPort"]</label>
                <input type="number" class="form-control" @bind="reportNode.Report.Delivery.SmtpPort" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpUser"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.SmtpUser" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpPass"]</label>
                <input type="password" class="form-control" @bind="reportNode.Report.Delivery.SmtpPassword" @bind:after="OnChanged" />
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="reportNode.Report.Delivery.SmtpUseSsl" @bind:after="OnChanged" />
                <label class="form-check-label">@L["prop.smtpSsl"]</label>
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.fromAddress"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.SmtpFromAddress" @bind:after="OnChanged" placeholder="noreply@example.com" />
            </div>
        }

        <div class="alert alert-info small mt-3">
            <strong>Sections:</strong> @reportNode.Report.Sections.Count section(s).<br/>
            Open the <strong>Report Designer</strong> panel (double-click) to add charts, tables, text and value sections.
        </div>
    }
    </div>
}
else if (Node is ReportGroupNode)
{
    <div class="properties-panel">
        <h5>📊 Reports</h5>
        <p class="text-muted">Select a report to edit, or add a new one.</p>
        <p class="text-muted small">
            Reports can include charts from historical data, real-time OPC values, tables, and text.<br/>
            Generate reports on demand or bind them to a <strong>GenerateReport</strong> command action.<br/>
            Add a <strong>Report Viewer</strong> widget to a screen to display generated reports at runtime.
        </p>
    </div>
}
else if (Node is ScreenNode screen)
{
    <div class="properties-panel">
        <h5>🖼️ @L["section.screen"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="screen.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(screen, nameof(screen.Name))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.width"]</label>
            <input type="number" class="form-control" @bind="screen.Screen.Width" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(screen.Screen, nameof(screen.Screen.Width))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.height"]</label>
            <input type="number" class="form-control" @bind="screen.Screen.Height" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(screen.Screen, nameof(screen.Screen.Height))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.background"]</label>
            <ColorPicker Value="@(screen.Screen.Background)"
                         ValueChanged="(v) => { screen.Screen.Background = v; }"
                         OnAfterChange="OnChanged" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.backgroundImage"]</label>
            <select class="form-select form-select-sm"
                    value="@screen.Screen.BackgroundImageId"
                    @onchange="(e) => { screen.Screen.BackgroundImageId = e.Value?.ToString() ?? string.Empty; OnChanged(); }">
                <option value="">@L["prop.none"]</option>
                @foreach (var img in (Editor.RootModel?.Images ?? []))
                {
                    <option value="@img.Id">@img.Id</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">📐 Fit Mode</label>
            <select class="form-select" @bind="screen.Screen.FitMode" @bind:after="OnChanged">
                <option value="contain">Contain (fit, keep aspect ratio)</option>
                <option value="fill">Fill (stretch to fill viewport)</option>
                <option value="scroll">Scroll (actual size, scroll bars)</option>
            </select>
            <div class="form-text">How the screen canvas fits into the runtime viewport.</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="screen.Screen.ShowInNavigation" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(screen.Screen, nameof(screen.Screen.ShowInNavigation))" />
            <label class="form-check-label">@L["prop.showInNav"]</label>
            <div class="form-text">@L["prop.showInNavHint"]</div>
        </div>
        <div class="mb-3">
            <label class="form-label">🔒 Allowed Groups</label>
            <div class="form-text mb-1">Restrict this screen to specific user groups. If none are selected, all groups can see it.</div>
            @foreach (var ug in (Editor.RootModel?.UserGroups ?? []))
            {
                var grp = ug;
                var isChecked = screen.Screen.AllowedGroups.Contains(grp.Name, StringComparer.OrdinalIgnoreCase);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@isChecked"
                           @onchange="(e) => { ToggleScreenAllowedGroup(screen.Screen, grp.Name, (bool)(e.Value ?? false)); OnChanged(); }" />
                    <label class="form-check-label small">@grp.Name</label>
                </div>
            }
            @if ((Editor.RootModel?.UserGroups ?? []).Count == 0)
            {
                <div class="text-muted small fst-italic">No user groups defined.</div>
            }
        </div>
        <div class="text-muted">
            @L["prop.symbols"]: @screen.Screen.Symbols.Count
        </div>
        <p class="text-muted small mt-2">@L["prop.screenEditorHint"]</p>
    </div>
}
else if (Node is ScreenGroupNode)
{
    <div class="properties-panel">
        <h5>🖥️ @L["section.screenGroup"]</h5>
        <p class="text-muted">@L["section.screenGroupHint"]</p>
    </div>
}
else if (Node is UserGroupListNode)
{
    <div class="properties-panel">
        <h5>👥 @L["section.userGroupList"]</h5>
        <p class="text-muted">@L["section.userGroupListHint"]</p>
        <p class="text-muted small">@L["section.userGroupListHint2"]</p>
    </div>
}
else if (Node is ServerSettingsNode ssNode)
{
    <div class="properties-panel">
        <h5>⚙️ @L["section.serverSettings"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.endpointUrl"]</label>
            <input type="text" class="form-control" @bind="ssNode.Settings.EndpointUrl" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EndpointUrl))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.startupScreen"]</label>
            <select class="form-select"
                    value="@ssNode.Settings.StartupScreen"
                    @onchange="(e) => { ssNode.Settings.StartupScreen = e.Value?.ToString() ?? string.Empty; OnChanged(); }">
                <option value="">@L["prop.none"]</option>
                @foreach (var scr in (Editor.RootModel?.Screens ?? []))
                {
                    <option value="@scr.Name">@scr.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.navStyle"]</label>
            <select class="form-select" @bind="ssNode.Settings.NavigationStyle" @bind:after="OnChanged"
                    @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.NavigationStyle))">
                <option value="tabs">@L["prop.navTabs"]</option>
                <option value="sidebar">@L["prop.navSidebar"]</option>
                <option value="hamburger">@L["prop.navHamburger"]</option>
                <option value="bottom">@L["prop.navBottom"]</option>
            </select>
            <div class="form-text">@L["prop.navStyleHint"]</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.ShowNavigationBar" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.ShowNavigationBar))" />
            <label class="form-check-label">@L["prop.showNavBar"]</label>
            <div class="form-text">@L["prop.showNavBarHint"]</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableAnonymous" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableAnonymous))" />
            <label class="form-check-label">@L["prop.enableAnon"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableEditorLogin" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableEditorLogin))" />
            <label class="form-check-label">@L["prop.requireEditorLogin"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableRuntimeLogin" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableRuntimeLogin))" />
            <label class="form-check-label">@L["prop.requireRuntimeLogin"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.RequireStrongPassword" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.RequireStrongPassword))" />
            <label class="form-check-label">@L["prop.requireStrongPw"]</label>
        </div>

        @* ── External Authentication (OAuth) ── *@
        <hr />
        <h6>🔑 External Authentication (OAuth)</h6>
        <div class="form-text mb-2">
            Allow users to sign in with Google, Microsoft, Facebook, or GitHub.
            External users are mapped to a local user by email, or assigned to a default group.
        </div>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.ExternalAuth?.Enabled == true)"
                   @onchange="(e) => { EnsureExternalAuthConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable External Authentication</label>
        </div>
        @if (ssNode.Settings.ExternalAuth is { Enabled: true } extAuthCfg)
        {
            <div class="mb-2">
                <label class="form-label small">Default Group (for unmapped users)</label>
                <select class="form-select form-select-sm" @bind="extAuthCfg.DefaultGroup" @bind:after="OnChanged">
                    <option value="">— Deny unmapped users —</option>
                    @foreach (var grp in (Editor.RootModel?.UserGroups ?? []))
                    {
                        <option value="@grp.Name">@grp.Name</option>
                    }
                </select>
                <div class="form-text">Group assigned to external users not in the local user list. Empty = deny access.</div>
            </div>

            @for (int pi = 0; pi < extAuthCfg.Providers.Count; pi++)
            {
                var idx = pi;
                var prov = extAuthCfg.Providers[idx];
                <div class="card mb-2">
                    <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                        <span>
                            @(prov.Name switch { "Google" => "🔵", "Microsoft" => "🟦", "Facebook" => "🔷", "GitHub" => "⬛", _ => "🔑" })
                            @prov.Name
                        </span>
                        <div class="d-flex align-items-center gap-1">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" @bind="prov.Enabled" @bind:after="OnChanged" />
                            </div>
                            <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;"
                                    @onclick="() => { extAuthCfg.Providers.RemoveAt(idx); OnChanged(); }">🗑</button>
                        </div>
                    </div>
                    @if (prov.Enabled)
                    {
                        <div class="card-body p-2">
                            <div class="mb-1">
                                <label class="form-label mb-0 small">Client ID</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="prov.ClientId" @bind:after="OnChanged"
                                       placeholder="From provider's developer console" />
                            </div>
                            <div class="mb-1">
                                <label class="form-label mb-0 small">Client Secret</label>
                                <input type="password" class="form-control form-control-sm"
                                       @bind="prov.ClientSecret" @bind:after="OnChanged" />
                            </div>
                            <div class="mb-1">
                                <label class="form-label mb-0 small">Allowed Domains (optional, comma-separated)</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="prov.AllowedDomains" @bind:after="OnChanged"
                                       placeholder="mycompany.com, partner.org" />
                                <div class="form-text">Restrict to specific email domains. Empty = allow all.</div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="input-group input-group-sm mb-2">
                <select class="form-select form-select-sm" @bind="_newExternalProvider">
                    <option value="">— Select provider —</option>
                    @foreach (var name in new[] { "Google", "Microsoft", "Facebook", "GitHub" })
                    {
                        @if (!extAuthCfg.Providers.Any(p => p.Name == name))
                        {
                            <option value="@name">@name</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary"
                        disabled="@string.IsNullOrEmpty(_newExternalProvider)"
                        @onclick="() => AddExternalProvider(extAuthCfg)">➕ Add</button>
            </div>
        }

        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableTagBrowser" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableTagBrowser))" />
            <label class="form-check-label">Enable Tag Browser in Runtime</label>
            <div class="form-text">Show the Tag Browser button in the runtime viewer top bar, allowing operators to browse, search, read, and write OPC UA tags.</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnablePredictivePreconnect" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnablePredictivePreconnect))" />
            <label class="form-check-label">Enable Predictive Pre-connection</label>
            <div class="form-text">When enabled, the runtime viewer learns navigation patterns and pre-subscribes OPC UA variables for the predicted next screen, reducing latency. The model is persisted between sessions.</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableScreenPreloading" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableScreenPreloading))" />
            <label class="form-check-label">Enable Screen Pre-loading</label>
            <div class="form-text">When enabled, the runtime viewer pre-loads predicted next screens in the background (hidden) so that navigation is nearly instant. Cached screens are evicted automatically under memory pressure.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.diagPort"]</label>
            <input type="number" class="form-control" @bind="ssNode.Settings.DiagnosticsPort" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.DiagnosticsPort))" />
            <div class="form-text">@L["prop.diagPortHint"]</div>
        </div>

        @* ─── Data Logging Database ────────────────────────────── *@
        <hr />
        <h6>🗄️ Data Logging Database</h6>
        <div class="form-text mb-2">
            Configure the database used for historical data logging of variable values.
        </div>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(Editor.RootModel?.Database != null)"
                   @onchange="e => { if ((bool)(e.Value ?? false)) EnsureDatabaseConfig(); else Editor.RootModel!.Database = null; OnChanged(); }" />
            <label class="form-check-label">Enable Data Logging Database</label>
        </div>
        @if (Editor.RootModel?.Database is { } dbCfg)
        {
            <div class="mb-2">
                <label class="form-label small">Provider</label>
                <select class="form-select form-select-sm" @bind="dbCfg.Provider" @bind:after="OnChanged">
                    <option value="Sqlite">SQLite (local file)</option>
                    <option value="TimescaleDb">TimescaleDB (PostgreSQL)</option>
                </select>
                <div class="form-text">SQLite for simple/local deployments. TimescaleDB for production/multi-node.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Connection String</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="dbCfg.ConnectionString" @bind:after="OnChanged"
                       placeholder="@(dbCfg.Provider == "Sqlite" ? "Data Source=history.db" : "Host=localhost;Port=5432;Database=hmi;Username=postgres;Password=hmipass")" />
                <div class="form-text">
                    @if (dbCfg.Provider == "Sqlite")
                    {
                        <span>Path to the SQLite file (relative to project folder).</span>
                    }
                    else
                    {
                        <span>Npgsql connection string to the TimescaleDB/PostgreSQL instance.</span>
                    }
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Table Name</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="dbCfg.TableName" @bind:after="OnChanged"
                       placeholder="variable_data" />
                <div class="form-text">Database table where logged values are stored. Default: <code>variable_data</code>.</div>
            </div>
            <div class="mb-2">
                <button class="btn btn-sm btn-outline-info" disabled="@_dbTesting"
                        @onclick="() => TestDatabaseConnection(dbCfg)">
                    @if (_dbTesting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    🔌 Test Connection
                </button>
                @if (!string.IsNullOrEmpty(_dbTestMessage))
                {
                    <div class="alert @(_dbTestSuccess ? "alert-success" : "alert-danger") small py-1 px-2 mt-1 mb-0">
                        @_dbTestMessage
                    </div>
                }
            </div>
        }

        @* ─── Event Log ──────────────────────────────────────── *@
        <hr />
        <h6>📋 Event Log</h6>
        <div class="form-text mb-2">
            Server event log for alarms, authentication, driver events, and system messages.
        </div>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.EventLog?.Enabled == true)"
                   @onchange="e => { EnsureEventLogConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable Event Log</label>
        </div>
        @if (ssNode.Settings.EventLog is { Enabled: true })
        {
            <div class="mb-2">
                <label class="form-label small">Database Path</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="ssNode.Settings.EventLog.DbPath" @bind:after="OnChanged"
                       placeholder="events.db" />
                <div class="form-text">SQLite file for event storage (relative to project folder). Default: <code>events.db</code>.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Max Age (days)</label>
                <input type="number" class="form-control form-control-sm" min="0"
                       @bind="ssNode.Settings.EventLog.MaxAgeDays" @bind:after="OnChanged" />
                <div class="form-text">Events older than this are periodically purged. 0 = keep forever. Default: 90.</div>
            </div>
        }

        @* ─── FDA 21 CFR Part 11 Compliance ──────────────────── *@
        <hr />
        <h6>🔒 FDA 21 CFR Part 11 Compliance</h6>
        <div class="form-text mb-2">
            Regulatory compliance for pharmaceutical/biotech: electronic signatures, tamper-proof audit trails, password policies, account lockout.
        </div>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.Compliance?.Enabled == true)"
                   @onchange="e => { EnsureComplianceConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable FDA 21 CFR Part 11 Compliance</label>
        </div>
        @if (ssNode.Settings.Compliance is { Enabled: true })
        {
            <div class="mb-2">
                <label class="form-label small">Audit Trail Database Path</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="ssNode.Settings.Compliance.AuditDbPath" @bind:after="OnChanged"
                       placeholder="audit_trail.db" />
                <div class="form-text">SQLite file for tamper-proof audit storage. Default: <code>audit_trail.db</code>.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Audit Retention (days)</label>
                <input type="number" class="form-control form-control-sm" min="0"
                       @bind="ssNode.Settings.Compliance.AuditRetentionDays" @bind:after="OnChanged" />
                <div class="form-text">Audit records older than this are purged. 0 = keep forever. Default: 2555 (7 years).</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.RequireElectronicSignatures" @bind:after="OnChanged" />
                <label class="form-check-label">Require Electronic Signatures</label>
                <div class="form-text">Re-authenticate users for critical operations (recipe changes, config modifications, user management).</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.RequireDualSignatures" @bind:after="OnChanged" />
                <label class="form-check-label">Require Dual Signatures</label>
                <div class="form-text">High-risk operations require approval from two users.</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.RequireReasonForChange" @bind:after="OnChanged" />
                <label class="form-check-label">Require Reason for Change</label>
                <div class="form-text">Users must provide a reason when making critical changes.</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.VerifyIntegrityOnStartup" @bind:after="OnChanged" />
                <label class="form-check-label">Verify Integrity on Startup</label>
                <div class="form-text">Validate audit trail hash chain on server startup (recommended).</div>
            </div>

            <h6 class="mt-3">Password Policy</h6>
            <div class="mb-2">
                <label class="form-label small">Minimum Password Length</label>
                <input type="number" class="form-control form-control-sm" min="4" max="64"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.MinLength" @bind:after="OnChanged" />
                <div class="form-text">Minimum characters required. Default: 8.</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.RequireUppercase" @bind:after="OnChanged" />
                <label class="form-check-label">Require Uppercase</label>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.RequireLowercase" @bind:after="OnChanged" />
                <label class="form-check-label">Require Lowercase</label>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.RequireDigit" @bind:after="OnChanged" />
                <label class="form-check-label">Require Digit</label>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.RequireSpecialChar" @bind:after="OnChanged" />
                <label class="form-check-label">Require Special Character</label>
            </div>
            <div class="mb-2">
                <label class="form-label small">Prevent Reuse (last N passwords)</label>
                <input type="number" class="form-control form-control-sm" min="0" max="24"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.HistoryCount" @bind:after="OnChanged" />
                <div class="form-text">Users cannot reuse their last N passwords. 0 = no history. Default: 5.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Password Max Age (days)</label>
                <input type="number" class="form-control form-control-sm" min="0"
                       @bind="ssNode.Settings.Compliance.PasswordPolicy.MaxAgeDays" @bind:after="OnChanged" />
                <div class="form-text">Force password change after N days. 0 = no expiration. Default: 90.</div>
            </div>

            <h6 class="mt-3">Account Lockout</h6>
            <div class="mb-2">
                <label class="form-label small">Max Failed Login Attempts</label>
                <input type="number" class="form-control form-control-sm" min="1" max="100"
                       @bind="ssNode.Settings.Compliance.MaxFailedLoginAttempts" @bind:after="OnChanged" />
                <div class="form-text">Lock account after N failed attempts. Default: 5.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Lockout Duration (minutes)</label>
                <input type="number" class="form-control form-control-sm" min="1" max="1440"
                       @bind="ssNode.Settings.Compliance.LockoutDurationMinutes" @bind:after="OnChanged" />
                <div class="form-text">How long the account remains locked. Default: 30.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Auto Log-Off (minutes)</label>
                <input type="number" class="form-control form-control-sm" min="0"
                       @bind="ssNode.Settings.Compliance.AutoLogOffMinutes" @bind:after="OnChanged" />
                <div class="form-text">Automatically log off inactive users. 0 = disabled. Default: 15.</div>
            </div>
        }

        @* ─── Alarm Notifications ─────────────────────────────── *@
        <hr />
        <h6>📨 Alarm Notifications</h6>
        <div class="form-text mb-2">
            Send alarm notifications via Email, Telegram, WhatsApp, Alexa, and/or IP Speakers (Sonos) when alarms with "Notify on activation" fire.
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.AlarmNotification?.Enabled == true)"
                   @onchange="(e) => { EnsureAlarmNotification(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable Alarm Notifications</label>
        </div>
        @if (ssNode.Settings.AlarmNotification is { Enabled: true })
        {
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label small">Min Severity</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="1000"
                           @bind="ssNode.Settings.AlarmNotification.MinSeverity" @bind:after="OnChanged" />
                    <div class="form-text">Only notify for alarms ≥ this severity (1–1000).</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Cooldown (sec)</label>
                    <input type="number" class="form-control form-control-sm" min="0"
                           @bind="ssNode.Settings.AlarmNotification.CooldownSeconds" @bind:after="OnChanged" />
                    <div class="form-text">Seconds between repeated notifications for the same alarm.</div>
                </div>
            </div>

            @* ── Email Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>📧 Email (SMTP)</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.Email?.Enabled == true)"
                               @onchange="(e) => { EnsureEmailChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.Email is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="row g-1 mb-1">
                            <div class="col-8">
                                <label class="form-label mb-0 small">SMTP Host</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.SmtpHost" @bind:after="OnChanged"
                                       placeholder="smtp.gmail.com" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small">Port</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.SmtpPort" @bind:after="OnChanged" />
                            </div>
                        </div>
                        <div class="mb-1 form-check">
                            <input class="form-check-input" type="checkbox"
                                   @bind="ssNode.Settings.AlarmNotification.Email.UseSsl" @bind:after="OnChanged" />
                            <label class="form-check-label small">Use SSL/TLS</label>
                        </div>
                        <div class="row g-1 mb-1">
                            <div class="col-6">
                                <label class="form-label mb-0 small">Username</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.Username" @bind:after="OnChanged" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small">Password</label>
                                <input type="password" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.Password" @bind:after="OnChanged" />
                            </div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">From</label>
                            <input type="email" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Email.From" @bind:after="OnChanged"
                                   placeholder="alerts@mycompany.com" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">To (comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Email.To" @bind:after="OnChanged"
                                   placeholder="operator@mycompany.com, manager@mycompany.com" />
                        </div>
                    </div>
                }
            </div>

            @* ── Telegram Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>✈️ Telegram</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.Telegram?.Enabled == true)"
                               @onchange="(e) => { EnsureTelegramChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.Telegram is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Bot Token</label>
                            <input type="password" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Telegram.BotToken" @bind:after="OnChanged"
                                   placeholder="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11" />
                            <div class="form-text">Create a bot via @@BotFather on Telegram.</div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Chat ID(s) (comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Telegram.ChatId" @bind:after="OnChanged"
                                   placeholder="-1001234567890" />
                            <div class="form-text">User, group, or channel ID. Use @@userinfobot to find your chat ID.</div>
                        </div>
                        <div class="mb-1 form-check">
                            <input class="form-check-input" type="checkbox"
                                   @bind="ssNode.Settings.AlarmNotification.Telegram.UseHtml" @bind:after="OnChanged" />
                            <label class="form-check-label small">Use HTML formatting</label>
                        </div>
                    </div>
                }
            </div>

            @* ── WhatsApp Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>💬 WhatsApp</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.WhatsApp?.Enabled == true)"
                               @onchange="(e) => { EnsureWhatsAppChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.WhatsApp is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Access Token</label>
                            <input type="password" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.WhatsApp.AccessToken" @bind:after="OnChanged"
                                   placeholder="WhatsApp Cloud API access token" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Phone Number ID</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.WhatsApp.PhoneNumberId" @bind:after="OnChanged"
                                   placeholder="From Meta Business Manager" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">To (E.164 format, comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.WhatsApp.To" @bind:after="OnChanged"
                                   placeholder="+1234567890, +0987654321" />
                        </div>
                        <div class="row g-1 mb-1">
                            <div class="col-6">
                                <label class="form-label mb-0 small">Template Name (optional)</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.WhatsApp.TemplateName" @bind:after="OnChanged"
                                       placeholder="alarm_notification" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small">Template Language</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.WhatsApp.TemplateLanguage" @bind:after="OnChanged"
                                       placeholder="en_US" />
                            </div>
                        </div>
                        <div class="form-text">Use a template for initiating conversations. Leave empty for free-form text (24h session window only).</div>
                    </div>
                }
            </div>


            @* ── Alexa Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>🔊 Alexa</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.Alexa?.Enabled == true)"
                               @onchange="(e) => { EnsureAlexaChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.Alexa is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Client ID</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Alexa.ClientId" @bind:after="OnChanged"
                                   placeholder="amzn1.application-oa2-client.xxxx" />
                            <div class="form-text">Login with Amazon (LWA) Client ID from the Alexa developer console.</div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Client Secret</label>
                            <input type="password" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Alexa.ClientSecret" @bind:after="OnChanged"
                                   placeholder="LWA client secret" />
                        </div>
                        <div class="row g-1 mb-1">
                            <div class="col-6">
                                <label class="form-label mb-0 small">Region</label>
                                <select class="form-select form-select-sm"
                                        @bind="ssNode.Settings.AlarmNotification.Alexa.Region" @bind:after="OnChanged">
                                    <option value="EU">EU (Europe)</option>
                                    <option value="NA">NA (North America)</option>
                                    <option value="FE">FE (Far East)</option>
                                </select>
                            </div>
                            <div class="col-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           @bind="ssNode.Settings.AlarmNotification.Alexa.UseSandbox" @bind:after="OnChanged" />
                                    <label class="form-check-label small">Sandbox (development)</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-text">Requires an Alexa Skill with Proactive Events enabled. Sends a notification (yellow ring) to all linked Alexa devices.</div>
                    </div>
                }
            </div>

            @* ── IP Speaker (Sonos) Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>🔈 IP Speaker (Sonos)</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.IpSpeaker?.Enabled == true)"
                               @onchange="(e) => { EnsureIpSpeakerChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.IpSpeaker is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Speaker Addresses (comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.IpSpeaker.SpeakerAddresses" @bind:after="OnChanged"
                                   placeholder="192.168.1.50, 192.168.1.51:1400" />
                            <div class="form-text">IP or IP:port of each Sonos/UPnP speaker. Default port: 1400.</div>
                        </div>
                        <div class="row g-1 mb-1">
                            <div class="col-4">
                                <label class="form-label mb-0 small">Volume (0-100)</label>
                                <input type="number" class="form-control form-control-sm" min="0" max="100"
                                       @bind="ssNode.Settings.AlarmNotification.IpSpeaker.Volume" @bind:after="OnChanged" />
                                <div class="form-text">0 = keep current volume.</div>
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small">TTS Language</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.IpSpeaker.TtsLanguage" @bind:after="OnChanged"
                                       placeholder="en" />
                            </div>
                            <div class="col-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           @bind="ssNode.Settings.AlarmNotification.IpSpeaker.RestoreVolume" @bind:after="OnChanged" />
                                    <label class="form-check-label small">Restore volume</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Custom TTS URL (optional)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.IpSpeaker.TtsUrlTemplate" @bind:after="OnChanged"
                                   placeholder="http://my-tts/speak?text={text}&lang={lang}" />
                            <div class="form-text">Use <code>{text}</code> and <code>{lang}</code> placeholders. Leave empty for Google Translate TTS.</div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small fw-semibold">Severity-based Volume (optional, 0 = use default)</label>
                            <div class="row g-1">
                                <div class="col-4">
                                    <label class="form-label mb-0 small">Critical (≥800)</label>
                                    <input type="number" class="form-control form-control-sm" min="0" max="100"
                                           @bind="ssNode.Settings.AlarmNotification.IpSpeaker.VolumeCritical" @bind:after="OnChanged" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label mb-0 small">Warning (500-799)</label>
                                    <input type="number" class="form-control form-control-sm" min="0" max="100"
                                           @bind="ssNode.Settings.AlarmNotification.IpSpeaker.VolumeWarning" @bind:after="OnChanged" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label mb-0 small">Info (&lt;500)</label>
                                    <input type="number" class="form-control form-control-sm" min="0" max="100"
                                           @bind="ssNode.Settings.AlarmNotification.IpSpeaker.VolumeInfo" @bind:after="OnChanged" />
                                </div>
                            </div>
                            <div class="form-text">Set per-severity volume. 0 = use the default volume above. Per-alarm VolumeOverride takes priority.</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ── GDS (Global Discovery Server) ── *@
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label mb-0 fw-bold">🌐 GDS (Global Discovery Server)</label>
        </div>
        <div class="form-text mb-2">Configure a GDS endpoint for centralized certificate management.</div>
        <div class="mb-2">
            <label class="form-label mb-0 small">GDS Endpoint URL</label>
            <input type="text" class="form-control form-control-sm"
                   value="@(ssNode.Settings.Gds?.EndpointUrl ?? "")"
                   @onchange="(e) => { EnsureGdsConfig(ssNode).EndpointUrl = e.Value?.ToString() ?? string.Empty; OnChanged(); }"
                   placeholder="opc.tcp://gds.example.com:58810/GlobalDiscoveryServer" />
        </div>
        <div class="row g-2 mb-1">
            <div class="col-6">
                <label class="form-label mb-0 small">Username (optional)</label>
                <input type="text" class="form-control form-control-sm"
                       value="@(ssNode.Settings.Gds?.UserName ?? "")"
                       @onchange="(e) => { EnsureGdsConfig(ssNode).UserName = e.Value?.ToString() ?? string.Empty; OnChanged(); }"
                       placeholder="Anonymous if empty" />
            </div>
            <div class="col-6">
                <label class="form-label mb-0 small">Password</label>
                <input type="password" class="form-control form-control-sm"
                       value="@(ssNode.Settings.Gds?.Password ?? "")"
                       @onchange="(e) => { EnsureGdsConfig(ssNode).Password = e.Value?.ToString() ?? string.Empty; OnChanged(); }" />
            </div>
        </div>
    </div>

    @* ── Backup / Snapshots ── *@
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label mb-0 fw-bold">💾 Automated Backups</label>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.Backup?.Enabled == true)"
                       @onchange="(e) => { EnsureBackupConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            </div>
        </div>
        <div class="form-text mb-2">ZIP snapshots of the project stored in a <code>backups/</code> folder.</div>
        @if (ssNode.Settings.Backup is { Enabled: true })
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Backup.SnapshotOnSave" @bind:after="OnChanged" />
                <label class="form-check-label small">Snapshot on every save</label>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label mb-0 small">Schedule (minutes)</label>
                    <input type="number" class="form-control form-control-sm" min="0"
                           @bind="ssNode.Settings.Backup.ScheduleMinutes" @bind:after="OnChanged" />
                    <div class="form-text">0 = disabled.</div>
                </div>
                <div class="col-6">
                    <label class="form-label mb-0 small">Max snapshots</label>
                    <input type="number" class="form-control form-control-sm" min="1"
                           @bind="ssNode.Settings.Backup.MaxSnapshots" @bind:after="OnChanged" />
                    <div class="form-text">Oldest auto-pruned.</div>
                </div>
            </div>
        }

        @* ── REST API ── *@
        <hr />
        <h6>🌐 REST API</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.Api?.Enabled == true)"
                       @onchange="@(e => { EnsureApiConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); })" />
                <label class="form-check-label fw-semibold">Enable REST API</label>
            </div>
            <div class="form-text mb-2">Expose variables, alarms, recipes, events, and diagnostics to external systems (MES, ERP, dashboards).</div>
        </div>
        @if (ssNode.Settings.Api is { Enabled: true } apiCfg)
        {
            <div class="card border-0 bg-light mb-3">
                <div class="card-body p-3">
                    <h6 class="card-subtitle mb-3 text-muted">
                        <i class="bi bi-gear-fill"></i> Server Configuration
                    </h6>

                    <div class="mb-3">
                        <label class="form-label mb-1 small fw-semibold">
                            <i class="bi bi-hdd-network"></i> Port
                        </label>
                        <input type="number" class="form-control form-control-sm" 
                               @bind="apiCfg.Port" @bind:after="OnChanged"
                               min="1024" max="65535" />
                        <div class="form-text">Default: 14842. Must be different from OPC UA port (14840) and diagnostics port (14841).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-1 small fw-semibold">
                            <i class="bi bi-key-fill"></i> API Key (Authentication)
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="@(_showApiKey ? "text" : "password")" 
                                   class="form-control form-control-sm font-monospace" 
                                   @bind="apiCfg.ApiKey" @bind:after="OnChanged"
                                   placeholder="Generate a secure key..." />
                            <button class="btn btn-outline-secondary" type="button" 
                                    @onclick="() => _showApiKey = !_showApiKey">
                                <i class="bi @(_showApiKey ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                            <button class="btn btn-outline-primary" type="button" 
                                    @onclick="() => GenerateApiKey(apiCfg)">
                                <i class="bi bi-arrow-clockwise"></i> Generate
                            </button>
                        </div>
                        <div class="form-text">
                            Clients authenticate via <code>X-API-Key: your-key</code> header or <code>?apiKey=your-key</code> query parameter.
                            <br />
                            <strong class="text-warning">⚠ Leave empty to disable authentication (NOT recommended for production)</strong>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 mb-0 small">
                        <i class="bi bi-info-circle-fill"></i> <strong>Base URL:</strong> 
                        <code>http://your-server:@(apiCfg.Port)/api/</code>
                    </div>
                </div>
            </div>

            <div class="card border-0 bg-light mb-3">
                <div class="card-body p-3">
                    <h6 class="card-subtitle mb-3 text-muted">
                        <i class="bi bi-list-check"></i> Available Endpoints
                    </h6>

                    @* Variables *@
                    <div class="mb-2">
                        <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center w-100 text-start" 
                                @onclick="() => _expandedApiSection = _expandedApiSection == 1 ? 0 : 1">
                            <i class="bi @(_expandedApiSection == 1 ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                            <i class="bi bi-diagram-3-fill text-primary me-2"></i>
                            <span class="fw-semibold small">Variables</span>
                        </button>
                        @if (_expandedApiSection == 1)
                        {
                            <div class="ms-4 mt-2">
                                <ul class="list-unstyled mb-0 small font-monospace">
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/variables - List all</li>
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/variables/{path} - Read single</li>
                                    <li class="mb-1"><span class="badge bg-info me-1">POST</span> /api/variables - Batch read</li>
                                    <li class="mb-1"><span class="badge bg-warning me-1">PUT</span> /api/variables/{path} - Write single</li>
                                    <li class="mb-1"><span class="badge bg-warning me-1">PUT</span> /api/variables - Batch write</li>
                                </ul>
                            </div>
                        }
                    </div>

                    @* Alarms *@
                    <div class="mb-2">
                        <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center w-100 text-start" 
                                @onclick="() => _expandedApiSection = _expandedApiSection == 2 ? 0 : 2">
                            <i class="bi @(_expandedApiSection == 2 ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                            <span class="fw-semibold small">Alarms</span>
                        </button>
                        @if (_expandedApiSection == 2)
                        {
                            <div class="ms-4 mt-2">
                                <ul class="list-unstyled mb-0 small font-monospace">
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/alarms - List active</li>
                                    <li class="mb-1"><span class="badge bg-info me-1">POST</span> /api/alarms/{id}/acknowledge</li>
                                    <li class="mb-1"><span class="badge bg-info me-1">POST</span> /api/alarms/{id}/shelve</li>
                                    <li class="mb-1"><span class="badge bg-info me-1">POST</span> /api/alarms/{id}/unshelve</li>
                                </ul>
                            </div>
                        }
                    </div>

                    @* Recipes *@
                    <div class="mb-2">
                        <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center w-100 text-start" 
                                @onclick="() => _expandedApiSection = _expandedApiSection == 3 ? 0 : 3">
                            <i class="bi @(_expandedApiSection == 3 ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                            <i class="bi bi-journal-text text-success me-2"></i>
                            <span class="fw-semibold small">Recipes</span>
                        </button>
                        @if (_expandedApiSection == 3)
                        {
                            <div class="ms-4 mt-2">
                                <ul class="list-unstyled mb-0 small font-monospace">
                                    <li class="mb-1"><span class="badge bg-info me-1">POST</span> /api/recipes/{name}/execute</li>
                                    <li class="ps-4 text-muted">Actions: Load, Save, Activate, Delete</li>
                                </ul>
                            </div>
                        }
                    </div>

                    @* Events & Audit *@
                    <div class="mb-2">
                        <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center w-100 text-start" 
                                @onclick="() => _expandedApiSection = _expandedApiSection == 4 ? 0 : 4">
                            <i class="bi @(_expandedApiSection == 4 ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                            <i class="bi bi-calendar-event text-info me-2"></i>
                            <span class="fw-semibold small">Events & Audit</span>
                        </button>
                        @if (_expandedApiSection == 4)
                        {
                            <div class="ms-4 mt-2">
                                <ul class="list-unstyled mb-0 small font-monospace">
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/events?category&severity&limit</li>
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/audit?startTime&endTime</li>
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/export/csv?category&limit</li>
                                </ul>
                            </div>
                        }
                    </div>

                    @* Diagnostics *@
                    <div class="mb-2">
                        <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center w-100 text-start" 
                                @onclick="() => _expandedApiSection = _expandedApiSection == 5 ? 0 : 5">
                            <i class="bi @(_expandedApiSection == 5 ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                            <i class="bi bi-activity text-secondary me-2"></i>
                            <span class="fw-semibold small">Diagnostics</span>
                        </button>
                        @if (_expandedApiSection == 5)
                        {
                            <div class="ms-4 mt-2">
                                <ul class="list-unstyled mb-0 small font-monospace">
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/health - Service status</li>
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/diagnostics - Performance metrics</li>
                                    <li class="mb-1"><span class="badge bg-success me-1">GET</span> /api/redundancy - HA status</li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="alert alert-warning py-2 px-3 small mb-3">
                <i class="bi bi-shield-lock-fill"></i> <strong>Security Best Practices:</strong>
                <ul class="mb-0 mt-1 ps-3">
                    <li>Always use a strong, unique API key in production</li>
                    <li>Use HTTPS reverse proxy (nginx/IIS) for encrypted transport</li>
                    <li>Restrict access via firewall rules</li>
                    <li>Monitor API access via event logs</li>
                </ul>
            </div>
        }

        @* ── Redundancy / High Availability ── *@
        <hr />
        <h6>🔄 Redundancy / HA</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.Redundancy != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) ssNode.Settings.Redundancy ??= new SharedModels.RedundancyConfig(); else ssNode.Settings.Redundancy = null; OnChanged(); }" />
                <label class="form-check-label">Enable Redundancy</label>
            </div>
            <div class="form-text">Heartbeat-based failover between primary and standby servers.</div>
        </div>
        @if (ssNode.Settings.Redundancy is { } redCfg)
        {
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="redCfg.Enabled" @bind:after="OnChanged" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="mb-2">
                <label class="form-label small">Role</label>
                <select class="form-select form-select-sm" @bind="redCfg.Role" @bind:after="OnChanged">
                    <option value="Primary">Primary</option>
                    <option value="Standby">Standby</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label small">Partner Endpoint</label>
                <input type="text" class="form-control form-control-sm" @bind="redCfg.PartnerEndpoint" @bind:after="OnChanged"
                       placeholder="http://192.168.1.100:14841" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Heartbeat (sec)</label>
                    <input type="number" min="1" class="form-control form-control-sm" @bind="redCfg.HeartbeatIntervalSeconds" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label small">Missed Beats</label>
                    <input type="number" min="1" class="form-control form-control-sm" @bind="redCfg.FailoverMissedHeartbeats" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">State Sync Interval (ms)</label>
                <input type="number" min="0" class="form-control form-control-sm" @bind="redCfg.StateSyncIntervalMs" @bind:after="OnChanged" />
                <div class="form-text">0 = disabled. Default 10000 (10 sec).</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="redCfg.AutoSwitchback" @bind:after="OnChanged" />
                <label class="form-check-label">Auto Switchback</label>
                <div class="form-text">Automatically return to standby when primary recovers.</div>
            </div>
        }

        @* ── Rate Limiting / Throttling ── *@
        <hr />
        <h6>🛡️ Rate Limiting</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.RateLimit != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) ssNode.Settings.RateLimit ??= new SharedModels.RateLimitConfig(); else ssNode.Settings.RateLimit = null; OnChanged(); }" />
                <label class="form-check-label">Enable Rate Limiting</label>
            </div>
        </div>
        @if (ssNode.Settings.RateLimit is { } rlCfg)
        {
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="rlCfg.Enabled" @bind:after="OnChanged" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="mb-2">
                <label class="form-label small">Window (seconds)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="rlCfg.WindowSeconds" @bind:after="OnChanged" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">REST API max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.ApiMaxRequestsPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">OPC UA writes max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.OpcUaWriteMaxPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Login attempts max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.LoginMaxAttemptsPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Diagnostics max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.DiagnosticsMaxRequestsPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
            </div>
        }

        @* --- Natural Language Query ----------------------------- *@
        <hr />
        <h6>Natural Language Query</h6>
        <div class="form-text mb-2">
            Let operators ask plain-English questions about historical process data and get AI-powered answers.
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.NaturalLanguageQuery?.Enabled == true)"
                   @onchange="@(e => { EnsureNlQueryConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); })" />
            <label class="form-check-label">Enable Natural Language Query</label>
        </div>
        @if (ssNode.Settings.NaturalLanguageQuery is { Enabled: true })
        {
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">AI Engine</label>
                    <select class="form-select form-select-sm"
                            value="@(ssNode.Settings.NaturalLanguageQuery.Engine)"
                            @onchange="@(e => { SetNlEngine(ssNode, e.Value?.ToString()); OnChanged(); })">
                        <option value="Ollama">Ollama (local)</option>
                        <option value="OpenAI">OpenAI</option>
                        <option value="Gemini">Gemini</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small">Model</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="ssNode.Settings.NaturalLanguageQuery.Model" @bind:after="OnChanged"
                           placeholder="mistral" />
                    <div class="form-text">e.g. mistral, llama3, gpt-4o</div>
                </div>
            </div>
            @if (ssNode.Settings.NaturalLanguageQuery.Engine == "Ollama")
            {
                <div class="mb-2">
                    <label class="form-label small">Ollama Base URL</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="ssNode.Settings.NaturalLanguageQuery.OllamaBaseUrl" @bind:after="OnChanged"
                           placeholder="http://localhost:11434" />
                </div>
            }
            @if (ssNode.Settings.NaturalLanguageQuery.Engine is "OpenAI" or "Gemini")
            {
                <div class="mb-2">
                    <label class="form-label small">API Key</label>
                    <input type="password" class="form-control form-control-sm"
                           @bind="ssNode.Settings.NaturalLanguageQuery.ApiKey" @bind:after="OnChanged"
                           placeholder="sk-..." />
                    <div class="form-text">Or set OPENAI_API_KEY / GEMINI_API_KEY env var on the RuntimeViewer host.</div>
                </div>
            }
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Default Time Range (min)</label>
                    <input type="number" class="form-control form-control-sm" min="1"
                           @bind="ssNode.Settings.NaturalLanguageQuery.DefaultTimeRangeMinutes" @bind:after="OnChanged" />
                    <div class="form-text">Fallback when user does not specify a time range.</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Max Data Points</label>
                    <input type="number" class="form-control form-control-sm" min="10" max="5000"
                           @bind="ssNode.Settings.NaturalLanguageQuery.MaxDataPoints" @bind:after="OnChanged" />
                    <div class="form-text">Per-variable limit sent to the AI.</div>
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Input Placeholder</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="ssNode.Settings.NaturalLanguageQuery.Placeholder" @bind:after="OnChanged"
                       placeholder="Ask about your process data..." />
            </div>
        }
        <hr />
        <h6>🌐 Multi-Site Dashboard</h6>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.MultiSiteDashboard?.Enabled == true)"
                   @onchange="(e) => { EnsureMultiSiteConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable multi-site dashboard</label>
        </div>
        @if (ssNode.Settings.MultiSiteDashboard is { Enabled: true })
        {
            <div class="mb-2">
                <label class="form-label small">Refresh Interval (seconds)</label>
                <input type="number" class="form-control form-control-sm" min="2" max="60"
                       @bind="ssNode.Settings.MultiSiteDashboard.RefreshIntervalSeconds" @bind:after="OnChanged" />
            </div>
            <h6 class="small mt-3">Sites (@(ssNode.Settings.MultiSiteDashboard.Sites.Count))</h6>
            @for (int i = 0; i < ssNode.Settings.MultiSiteDashboard.Sites.Count; i++)
            {
                var idx = i; var site = ssNode.Settings.MultiSiteDashboard.Sites[idx];
                <div class="border rounded p-2 mb-2" style="background:var(--surface-alt,#f8f8f8);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="small">@(string.IsNullOrEmpty(site.Name) ? "(unnamed)" : site.Name)</strong>
                        <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:9px;"
                                @onclick="() => { ssNode.Settings.MultiSiteDashboard!.Sites.RemoveAt(idx); OnChanged(); }">🗑</button>
                    </div>
                    <div class="row g-1 mb-1">
                        <div class="col-5"><label class="form-label mb-0 small">Name</label><input type="text" class="form-control form-control-sm" @bind="site.Name" @bind:after="OnChanged" /></div>
                        <div class="col-4"><label class="form-label mb-0 small">ID</label><input type="text" class="form-control form-control-sm" @bind="site.Id" @bind:after="OnChanged" /></div>
                        <div class="col-3"><label class="form-label mb-0 small">Enabled</label><input class="form-check-input ms-2 mt-2" type="checkbox" @bind="site.Enabled" @bind:after="OnChanged" /></div>
                    </div>
                    <div class="mb-1"><label class="form-label mb-0 small">Hub URL</label><input type="text" class="form-control form-control-sm" @bind="site.HubUrl" @bind:after="OnChanged" placeholder="https://relay.example.com/relay" /></div>
                    <div class="mb-1"><label class="form-label mb-0 small">API Key</label><input type="text" class="form-control form-control-sm" @bind="site.ApiKey" @bind:after="OnChanged" /></div>
                    <details class="mt-1"><summary class="small text-muted" style="cursor:pointer;">KPIs (@site.Kpis.Count)</summary>
                        @for (int k = 0; k < site.Kpis.Count; k++)
                        {
                            var ki = k; var kpi = site.Kpis[ki];
                            <div class="row g-1 mb-1 ms-1">
                                <div class="col-3"><input type="text" class="form-control form-control-sm" @bind="kpi.Label" @bind:after="OnChanged" placeholder="Label" /></div>
                                <div class="col-4"><VariablePathPicker Value="@kpi.VariablePath" ValueChanged='v => { kpi.VariablePath = v ?? string.Empty; }' OnChanged="OnChanged" Placeholder="Variable path" /></div>
                                <div class="col-1"><input type="text" class="form-control form-control-sm" @bind="kpi.Unit" @bind:after="OnChanged" placeholder="Unit" /></div>
                                <div class="col-1"><input type="number" class="form-control form-control-sm" @bind="kpi.WarningThreshold" @bind:after="OnChanged" placeholder="Warn" title="Warning threshold" /></div>
                                <div class="col-1"><input type="number" class="form-control form-control-sm" @bind="kpi.AlarmThreshold" @bind:after="OnChanged" placeholder="Alm" title="Alarm threshold" /></div>
                                <div class="col-1"><button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:9px;" @onclick="() => { site.Kpis.RemoveAt(ki); OnChanged(); }">🗑</button></div>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-primary mt-1 ms-1" @onclick="() => { site.Kpis.Add(new SiteKpi()); OnChanged(); }">➕ KPI</button>
                    </details>
                </div>
            }
            <button class="btn btn-sm btn-outline-primary" @onclick="() => AddMultiSiteSite(ssNode)">➕ Add Site</button>
        }

        @* ── Cloud Relay ── *@
        <hr />
        <h6>☁️ Cloud Relay</h6>
        <div class="form-text mb-2">
            Connect the edge server to a cloud SignalR relay hub. The CloudBridge forwards live OPC values
            and alarms outbound — no inbound firewall ports required. Remote RuntimeViewer clients connect
            through the same hub.
        </div>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.CloudRelay?.Enabled == true)"
                   @onchange="(e) => { EnsureCloudRelayConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable Cloud Relay</label>
        </div>
        @if (ssNode.Settings.CloudRelay is { Enabled: true } cloudRelayCfg)
        {
            <div class="mb-2">
                <label class="form-label small">Hub URL</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="cloudRelayCfg.HubUrl" @bind:after="OnChanged"
                       placeholder="https://myrelay.azurewebsites.net/relay" />
                <div class="form-text">The SignalR hub endpoint. Both the bridge and viewers connect here.</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">API Key</label>
                <input type="password" class="form-control form-control-sm"
                       @bind="cloudRelayCfg.ApiKey" @bind:after="OnChanged"
                       placeholder="Shared secret for authentication" />
                <div class="form-text">Sent as <code>?apiKey=…</code> during the SignalR handshake.</div>
            </div>

            @* Store-and-Forward *@
            <div class="card mt-2 mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>💾 Store &amp; Forward</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(cloudRelayCfg.StoreAndForward?.Enabled == true)"
                               @onchange="(e) => { EnsureStoreAndForwardConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (cloudRelayCfg.StoreAndForward is { Enabled: true } safCfg)
                {
                    <div class="card-body p-2">
                        <div class="form-text mb-2">
                            When the cloud connection is lost, data is spooled to a local SQLite file and
                            automatically forwarded when connectivity is restored.
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Spool File Path</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="safCfg.SpoolPath" @bind:after="OnChanged"
                                   placeholder="cloud_spool.db" />
                            <div class="form-text">Relative to project folder. Default: <code>cloud_spool.db</code>.</div>
                        </div>
                        <div class="row g-2 mb-1">
                            <div class="col-4">
                                <label class="form-label mb-0 small">Max Rows</label>
                                <input type="number" min="1000" class="form-control form-control-sm"
                                       @bind="safCfg.MaxRows" @bind:after="OnChanged" />
                                <div class="form-text">Oldest rows purged when exceeded.</div>
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small">Batch Size</label>
                                <input type="number" min="1" class="form-control form-control-sm"
                                       @bind="safCfg.BatchSize" @bind:after="OnChanged" />
                                <div class="form-text">Rows per drain cycle.</div>
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small">Drain Interval (s)</label>
                                <input type="number" min="1" class="form-control form-control-sm"
                                       @bind="safCfg.DrainIntervalSeconds" @bind:after="OnChanged" />
                                <div class="form-text">Seconds between drain attempts.</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* ── MQTT Sparkplug B ── *@
        <hr />
        <h6>📡 Sparkplug B (MQTT)</h6>
        <div class="form-text mb-2">
            Publish OPC variables as Sparkplug B metrics to an MQTT broker for SCADA interoperability (Ignition, AVEVA, etc.).
        </div>
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.Sparkplug?.Enabled == true)"
                   @onchange="e => { EnsureSparkplugConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable Sparkplug B Publisher</label>
        </div>
        @if (ssNode.Settings.Sparkplug is { Enabled: true } spCfg)
        {
            <div class="row g-2 mb-2">
                <div class="col-8">
                    <label class="form-label small">MQTT Broker</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="spCfg.Broker" @bind:after="OnChanged"
                           placeholder="mqtt.factory.local" />
                </div>
                <div class="col-4">
                    <label class="form-label small">Port</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="65535"
                           @bind="spCfg.Port" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Group ID</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="spCfg.GroupId" @bind:after="OnChanged"
                           placeholder="Factory1" />
                    <div class="form-text">Logical grouping of edge nodes</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Edge Node ID</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="spCfg.EdgeNodeId" @bind:after="OnChanged"
                           placeholder="HMI-Server-01" />
                    <div class="form-text">Unique ID for this server</div>
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Publish Interval (ms)</label>
                    <input type="number" class="form-control form-control-sm" min="0"
                           @bind="spCfg.PublishIntervalMs" @bind:after="OnChanged" />
                    <div class="form-text">0 = on-change only</div>
                </div>
                <div class="col-6 d-flex align-items-end">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox"
                               @bind="spCfg.PublishOnChange" @bind:after="OnChanged" />
                        <label class="form-check-label small">Publish on change</label>
                    </div>
                </div>
            </div>
            <details class="mb-2">
                <summary class="small">Authentication & TLS</summary>
                <div class="row g-2 mt-1 mb-2">
                    <div class="col-6">
                        <label class="form-label small">Username</label>
                        <input type="text" class="form-control form-control-sm"
                               @bind="spCfg.Username" @bind:after="OnChanged" placeholder="(optional)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Password</label>
                        <input type="password" class="form-control form-control-sm"
                               @bind="spCfg.Password" @bind:after="OnChanged" placeholder="(optional)" />
                    </div>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox"
                           @bind="spCfg.UseTls" @bind:after="OnChanged" />
                    <label class="form-check-label small">Use TLS/SSL</label>
                </div>
            </details>
            <details class="mb-2">
                <summary class="small">Variable Filters</summary>
                <div class="mt-1 mb-2">
                    <label class="form-label small">Include Variables (one per line, * wildcard)</label>
                    <textarea class="form-control form-control-sm" rows="3"
                              value="@string.Join("\n", spCfg.IncludeVariables)"
                              @onchange="e => { spCfg.IncludeVariables = ParseLines(e.Value?.ToString()); OnChanged(); }"
                              placeholder="Empty = publish ALL variables&#10;Plant.*&#10;Line1.Motor.*"></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Exclude Variables (one per line, * wildcard)</label>
                    <textarea class="form-control form-control-sm" rows="2"
                              value="@string.Join("\n", spCfg.ExcludeVariables)"
                              @onchange="e => { spCfg.ExcludeVariables = ParseLines(e.Value?.ToString()); OnChanged(); }"
                              placeholder="Plant.Internal.*"></textarea>
                </div>
            </details>
        }

    </div>
}
else if (Node is BatchNode batchNode)
{
 <div class="properties-panel">
    <h5>🔄 Batch Sequence</h5>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" @bind="batchNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(batchNode, nameof(batchNode.Name))" />
    </div>
    <div class="mb-2 form-check">
        <input class="form-check-input" type="checkbox" @bind="batchNode.Batch.Enabled" @bind:after="OnChanged" />
        <label class="form-check-label">Enabled</label>
    </div>
    <div class="mb-2 form-check">
        <input class="form-check-input" type="checkbox" @bind="batchNode.Batch.AutoRestart" @bind:after="OnChanged" />
        <label class="form-check-label">Auto-Restart (loop)</label>
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" class="form-control" @bind="batchNode.Batch.Description" @bind:after="OnChanged" />
    </div>
    <div class="mb-3">
        <label class="form-label">Start Variable Path</label>
        <VariablePathPicker Value="@batchNode.Batch.StartVariablePath"
                            ValueChanged='v => { batchNode.Batch.StartVariablePath = v ?? string.Empty; }'
                            OnChanged="OnChanged"
                            Placeholder="Write true to start" />
    </div>
    <div class="mb-3">
        <label class="form-label">Abort Variable Path</label>
        <VariablePathPicker Value="@batchNode.Batch.AbortVariablePath"
                            ValueChanged='v => { batchNode.Batch.AbortVariablePath = v ?? string.Empty; }'
                            OnChanged="OnChanged"
                            Placeholder="Abort variable path" />
    </div>
    <div class="mb-3">
        <label class="form-label">Hold Variable Path</label>
        <VariablePathPicker Value="@batchNode.Batch.HoldVariablePath"
                            ValueChanged='v => { batchNode.Batch.HoldVariablePath = v ?? string.Empty; }'
                            OnChanged="OnChanged"
                            Placeholder="Optional" />
    </div>
    <hr />
    <h6>📋 Steps (@batchNode.Batch.Steps.Count)</h6>
    @for (int i = 0; i < batchNode.Batch.Steps.Count; i++)
    {
        var idx = i; var step = batchNode.Batch.Steps[idx];
        <div class="border rounded p-2 mb-2" style="background: var(--surface-alt, #f8f8f8);">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="small">@(idx+1). @(string.IsNullOrEmpty(step.Name) ? "(unnamed)" : step.Name)</strong>
                <div>
                    @if (idx > 0) { <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size:9px;" @onclick="() => MoveStepUp(batchNode, idx)">▲</button> }
                    @if (idx < batchNode.Batch.Steps.Count-1) { <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size:9px;" @onclick="() => MoveStepDown(batchNode, idx)">▼</button> }
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:9px;" @onclick="() => { batchNode.Batch.Steps.RemoveAt(idx); OnChanged(); }">🗑</button>
                </div>
            </div>
            <div class="row g-1 mb-1">
                <div class="col-5"><label class="form-label mb-0 small">Name</label><input type="text" class="form-control form-control-sm" @bind="step.Name" @bind:after="OnChanged" /></div>
                <div class="col-4"><label class="form-label mb-0 small">ID</label><input type="text" class="form-control form-control-sm" @bind="step.Id" @bind:after="OnChanged" /></div>
                <div class="col-3"><label class="form-label mb-0 small">Timeout(s)</label><input type="number" class="form-control form-control-sm" @bind="step.TimeoutSeconds" @bind:after="OnChanged" /></div>
            </div>
            <div class="mb-1"><label class="form-label mb-0 small">Description</label><input type="text" class="form-control form-control-sm" @bind="step.Description" @bind:after="OnChanged" /></div>
        </div>
    }
    <button class="btn btn-sm btn-outline-primary mb-3" @onclick="() => AddBatchStep(batchNode)">➕ Add Step</button>
    <hr />
    <h6>🔀 Transitions (@batchNode.Batch.Transitions.Count)</h6>
    @for (int i = 0; i < batchNode.Batch.Transitions.Count; i++)
    {
        var idx = i; var trans = batchNode.Batch.Transitions[idx];
        <div class="border rounded p-2 mb-2" style="background: var(--surface-alt, #f8f8f8);">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold">@GetStepName(batchNode, trans.FromStepId) → @GetStepName(batchNode, trans.ToStepId)</span>
                <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:9px;" @onclick="() => { batchNode.Batch.Transitions.RemoveAt(idx); OnChanged(); }">🗑</button>
            </div>
            <div class="row g-1 mb-1">
                <div class="col-6"><label class="form-label mb-0 small">From Step</label><select class="form-select form-select-sm" @bind="trans.FromStepId" @bind:after="OnChanged"><option value="">(select)</option>@foreach (var s in batchNode.Batch.Steps){<option value="@s.Id">@s.Name</option>}</select></div>
                <div class="col-6"><label class="form-label mb-0 small">To Step</label><select class="form-select form-select-sm" @bind="trans.ToStepId" @bind:after="OnChanged"><option value="">(select)</option>@foreach (var s in batchNode.Batch.Steps){<option value="@s.Id">@s.Name</option>}</select></div>
            </div>
            <div class="row g-1 mb-1">
                <div class="col-5"><label class="form-label mb-0 small">Condition Variable</label><VariablePathPicker Value="@trans.ConditionVariablePath" ValueChanged='v => { trans.ConditionVariablePath = v ?? string.Empty; }' OnChanged="OnChanged" Placeholder="OPC path or empty" /></div>
                <div class="col-3"><label class="form-label mb-0 small">Operator</label><select class="form-select form-select-sm" @bind="trans.ConditionOperator" @bind:after="OnChanged"><option value="True">True</option><option value="False">False</option><option value="==">==(eq)</option><option value="!=">!=(neq)</option><option value=">">&gt;</option><option value="<">&lt;</option></select></div>
                <div class="col-4"><label class="form-label mb-0 small">Value / Delay(s)</label><div class="input-group input-group-sm"><input type="text" class="form-control form-control-sm" @bind="trans.ConditionValue" @bind:after="OnChanged" placeholder="Value" /><input type="number" class="form-control form-control-sm" style="max-width:60px" @bind="trans.DelaySeconds" @bind:after="OnChanged" title="Min dwell seconds" /></div></div>
            </div>
        </div>
    }
    <button class="btn btn-sm btn-outline-primary" @onclick="() => AddBatchTransition(batchNode)">➕ Add Transition</button>
    <p class="text-muted small mt-3">At runtime: <code>_Batch.@(batchNode.Batch.Name).State</code>, <code>.CurrentStep</code>, <code>.StepElapsed</code> etc.</p>
 </div>
}
else if (Node is AliasMapNode aliasMapNode)
{
 <div class="properties-panel">
    <h5>🔀 Alias Map</h5>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" @bind="aliasMapNode.Name" @bind:after="OnChanged" />
    </div>

    <h6>Mappings</h6>
    <p class="text-muted small">
        Define alias-to-variable-path mappings. In screen variable bindings, use <code>{AliasName}</code>
        syntax. At runtime, <code>{AliasName}</code> is replaced with the real OPC path defined here.
    </p>

    @{ var mappings = aliasMapNode.AliasMap.Mappings; }

    @if (mappings.Count > 0)
    {
        <table class="table table-sm table-bordered">
            <thead><tr><th>Alias</th><th>Real Path</th><th></th></tr></thead>
            <tbody>
                @foreach (var key in mappings.Keys.ToList())
                {
                    var k = key;
                    <tr>
                        <td>
                            <input type="text" class="form-control form-control-sm" value="@k"
                                   @onchange="e => { var nk = e.Value?.ToString() ?? k; if (nk != k && !string.IsNullOrWhiteSpace(nk)) { var v = mappings[k]; mappings.Remove(k); mappings[nk] = v; OnChanged(); } }" />
                        </td>
                        <td>
                            <VariablePathPicker Value="@mappings[k]"
                                                ValueChanged='v => { mappings[k] = v ?? ""; OnChanged(); }' />
                        </td>
                        <td style="width:32px;text-align:center;">
                            <button class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="() => { mappings.Remove(k); OnChanged(); }">âœ•</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-muted small mb-2">No mappings defined yet.</div>
    }

    <button class="btn btn-sm btn-outline-primary" @onclick="() => AddAliasMapping(aliasMapNode)">
        + Add Mapping
    </button>
 </div>
}
else if (Node is EventNode eventNode)
{
 <div class="properties-panel">
    <h5>🔔 Event</h5>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" @bind="eventNode.Name" @bind:after="OnChanged"
               @onfocus="() => CaptureForUndo(eventNode, nameof(eventNode.Name))" />
    </div>
    <div class="mb-2 form-check">
        <input class="form-check-input" type="checkbox" @bind="eventNode.Event.Enabled" @bind:after="OnChanged" />
        <label class="form-check-label">Enabled</label>
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" class="form-control" @bind="eventNode.Event.Description" @bind:after="OnChanged" placeholder="Optional notes..." />
    </div>

    <hr />
    <h6>🔍 Condition</h6>
    <div class="mb-3">
        <label class="form-label">Variable Path</label>
        <VariablePathPicker Value="@eventNode.Event.ConditionVariablePath"
                            ValueChanged='v => { eventNode.Event.ConditionVariablePath = v ?? string.Empty; }'
                            OnChanged="OnChanged"
                            Placeholder="e.g. Sensors.Temperature.Value" />
        <div class="form-text">OPC variable whose value is evaluated as the trigger condition.</div>
    </div>
    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label">Operator</label>
            <select class="form-select" @bind="eventNode.Event.ConditionOperator" @bind:after="OnChanged">
                <option value="True">True (truthy / non-zero)</option>
                <option value="False">False (falsy / zero)</option>
                <option value="==">== (equals)</option>
                <option value="!=">!= (not equal)</option>
                <option value=">">&gt; (greater than)</option>
                <option value="<">&lt; (less than)</option>
                <option value=">=">&gt;= (greater or equal)</option>
                <option value="<=">&lt;= (less or equal)</option>
            </select>
        </div>
        <div class="col-6">
            <label class="form-label">Value</label>
            <input type="text" class="form-control" @bind="eventNode.Event.ConditionValue" @bind:after="OnChanged"
                   placeholder="Comparison value"
                   disabled="@(eventNode.Event.ConditionOperator is "True" or "False")" />
        </div>
    </div>

    <hr />
    <h6>⚙️ Trigger</h6>
    <div class="row g-2 mb-3">
        <div class="col-6">
            <label class="form-label">Trigger Mode</label>
            <select class="form-select" @bind="eventNode.Event.TriggerMode" @bind:after="OnChanged">
                <option value="RisingEdge">Rising Edge (false → true)</option>
                <option value="FallingEdge">Falling Edge (true → false)</option>
                <option value="Continuous">Continuous (while true)</option>
            </select>
        </div>
        <div class="col-6">
            <label class="form-label">Hold Time (seconds)</label>
            <input type="number" class="form-control" min="0" @bind="eventNode.Event.HoldTimeSeconds" @bind:after="OnChanged" />
            <div class="form-text">Condition must stay true for this duration before firing. 0 = immediate.</div>
        </div>
    </div>

    <hr />
    <h6>▶ Commands (@eventNode.Event.Commands.Count)</h6>
    <p class="text-muted small">Executed when the event fires.</p>
    @for (int i = 0; i < eventNode.Event.Commands.Count; i++)
    {
        var idx = i;
        var cmd = eventNode.Event.Commands[idx];
        <div class="border rounded p-2 mb-2" style="font-size: 11px;">
            <div class="d-flex gap-1 mb-1">
                <select class="form-select form-select-sm" style="font-size: 10px;" @bind="cmd.Action" @bind:after="OnChanged">
                    <optgroup label="Navigation">
                        <option value="NavigateScreen">Navigate Screen</option>
                        <option value="OpenScreenPopup">Open Screen Popup</option>
                        <option value="OpenScreenModal">Open Screen Modal</option>
                    </optgroup>
                    <optgroup label="Variables">
                        <option value="SetVariable">Set Variable</option>
                        <option value="WriteVariable">Write Variable</option>
                        <option value="ResetVariable">Reset Variable</option>
                        <option value="ToggleVariable">Toggle Variable</option>
                        <option value="IncrementVariable">Increment Variable</option>
                        <option value="DecrementVariable">Decrement Variable</option>
                    </optgroup>
                    <optgroup label="Scripting">
                        <option value="ExecuteScript">Execute Script</option>
                        <option value="ExecuteJavaScript">Execute JavaScript</option>
                    </optgroup>
                    <optgroup label="Authentication">
                        <option value="Login">Login</option>
                        <option value="Logout">Logout</option>
                    </optgroup>
                    <optgroup label="Alarms">
                        <option value="AcknowledgeAllAlarms">Acknowledge All Alarms</option>
                        <option value="ResetAllAlarms">Reset All Alarms</option>
                    </optgroup>
                    <optgroup label="Other">
                        <option value="ChangeLanguage">Change Language</option>
                        <option value="GenerateReport">Generate Report</option>
                    </optgroup>
                </select>
                <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;" @onclick="() => { eventNode.Event.Commands.RemoveAt(idx); OnChanged(); }">🗑</button>
            </div>
            @if (cmd.Action is "SetVariable" or "WriteVariable" or "ToggleVariable" or "IncrementVariable" or "DecrementVariable")
            {
                <VariablePathPicker Value="@cmd.VariablePath"
                                    ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                    OnChanged="OnChanged"
                                    Placeholder="Variable path" />
                @if (cmd.Action is not "ToggleVariable")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="@(cmd.Action is "IncrementVariable" or "DecrementVariable" ? "Step (default 1)" : "Value")" @bind="cmd.Value" @bind:after="OnChanged" />
                }
            }
            else if (cmd.Action == "ResetVariable")
            {
                <VariablePathPicker Value="@cmd.VariablePath"
                                    ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                    OnChanged="OnChanged"
                                    Placeholder="Variable path" />
            }
            else if (cmd.Action is "NavigateScreen" or "OpenScreenPopup" or "OpenScreenModal")
            {
                <ScreenPicker Value="@cmd.TargetScreen"
                              ValueChanged='v => { cmd.TargetScreen = v ?? string.Empty; }'
                              OnChanged="OnChanged"
                              Placeholder="(select screen)" />
                <select class="form-select form-select-sm mt-1" style="font-size: 10px;" @bind="cmd.AliasMapName" @bind:after="OnChanged">
                    <option value="">(no alias map)</option>
                    @if (Editor.RootModel?.AliasMaps != null)
                    {
                        @foreach (var am in Editor.RootModel.AliasMaps)
                        {
                            <option value="@am.Name">@am.Name</option>
                        }
                    }
                </select>
            }
            else if (cmd.Action is "ExecuteScript" or "ExecuteJavaScript")
            {
                <textarea class="form-control form-control-sm" style="font-size: 10px;" rows="3" placeholder="@(cmd.Action == "ExecuteJavaScript" ? "JavaScript code" : "C# script")" @bind="cmd.Script" @bind:after="OnChanged"></textarea>
            }
            else if (cmd.Action is "AcknowledgeAllAlarms" or "ResetAllAlarms")
            {
                <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Comment (optional)" @bind="cmd.Value" @bind:after="OnChanged" />
            }
            else if (cmd.Action == "ChangeLanguage")
            {
                <LocalePicker Value="@cmd.TargetLocale"
                              ValueChanged='v => { cmd.TargetLocale = v ?? string.Empty; }'
                              OnChanged="OnChanged"
                              Placeholder="(select language)" />
            }
            else if (cmd.Action == "GenerateReport")
            {
                <ReportPicker Value="@cmd.TargetReport"
                              ValueChanged='v => { cmd.TargetReport = v ?? string.Empty; }'
                              OnChanged="OnChanged"
                              Placeholder="(select report)" />
            }
        </div>
    }
    <button class="btn btn-sm btn-outline-primary" @onclick="() => AddEventCommand(eventNode, false)">➕ Add Command</button>

    <hr />
    <h6>⏹ Clear Commands (@eventNode.Event.ClearCommands.Count)</h6>
    <p class="text-muted small">Optional commands executed when the condition clears (edge resets).</p>
    @for (int i = 0; i < eventNode.Event.ClearCommands.Count; i++)
    {
        var idx = i;
        var cmd = eventNode.Event.ClearCommands[idx];
        <div class="border rounded p-2 mb-2" style="font-size: 11px;">
            <div class="d-flex gap-1 mb-1">
                <select class="form-select form-select-sm" style="font-size: 10px;" @bind="cmd.Action" @bind:after="OnChanged">
                    <optgroup label="Navigation">
                        <option value="NavigateScreen">Navigate Screen</option>
                        <option value="OpenScreenPopup">Open Screen Popup</option>
                        <option value="OpenScreenModal">Open Screen Modal</option>
                    </optgroup>
                    <optgroup label="Variables">
                        <option value="SetVariable">Set Variable</option>
                        <option value="WriteVariable">Write Variable</option>
                        <option value="ResetVariable">Reset Variable</option>
                        <option value="ToggleVariable">Toggle Variable</option>
                        <option value="IncrementVariable">Increment Variable</option>
                        <option value="DecrementVariable">Decrement Variable</option>
                    </optgroup>
                    <optgroup label="Scripting">
                        <option value="ExecuteScript">Execute Script</option>
                        <option value="ExecuteJavaScript">Execute JavaScript</option>
                    </optgroup>
                    <optgroup label="Authentication">
                        <option value="Login">Login</option>
                        <option value="Logout">Logout</option>
                    </optgroup>
                    <optgroup label="Alarms">
                        <option value="AcknowledgeAllAlarms">Acknowledge All Alarms</option>
                        <option value="ResetAllAlarms">Reset All Alarms</option>
                    </optgroup>
                    <optgroup label="Other">
                        <option value="ChangeLanguage">Change Language</option>
                        <option value="GenerateReport">Generate Report</option>
                    </optgroup>
                </select>
                <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;" @onclick="() => { eventNode.Event.ClearCommands.RemoveAt(idx); OnChanged(); }">🗑</button>
            </div>
            @if (cmd.Action is "SetVariable" or "WriteVariable" or "ToggleVariable" or "IncrementVariable" or "DecrementVariable")
            {
                <VariablePathPicker Value="@cmd.VariablePath"
                                    ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                    OnChanged="OnChanged"
                                    Placeholder="Variable path" />
                @if (cmd.Action is not "ToggleVariable")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Value" @bind="cmd.Value" @bind:after="OnChanged" />
                }
            }
            else if (cmd.Action == "ResetVariable")
            {
                <VariablePathPicker Value="@cmd.VariablePath"
                                    ValueChanged="v => { cmd.VariablePath = v ?? string.Empty; }"
                                    OnChanged="OnChanged"
                                    Placeholder="Variable path" />
            }
            else if (cmd.Action is "NavigateScreen" or "OpenScreenPopup" or "OpenScreenModal")
            {
                <ScreenPicker Value="@cmd.TargetScreen"
                              ValueChanged='v => { cmd.TargetScreen = v ?? string.Empty; }'
                              OnChanged="OnChanged"
                              Placeholder="(select screen)" />
                <select class="form-select form-select-sm mt-1" style="font-size: 10px;" @bind="cmd.AliasMapName" @bind:after="OnChanged">
                    <option value="">(no alias map)</option>
                    @if (Editor.RootModel?.AliasMaps != null)
                    {
                        @foreach (var am in Editor.RootModel.AliasMaps)
                        {
