    private async Task TestDatabaseConnection(DatabaseConfig cfg)
    {
        _dbTesting = true;
        _dbTestMessage = "";
        _dbTestSuccess = false;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(cfg.ConnectionString))
            {
                _dbTestMessage = "Connection string is empty.";
                return;
            }

            if (cfg.Provider == "Sqlite")
            {
                await using var conn = new Microsoft.Data.Sqlite.SqliteConnection(cfg.ConnectionString);
                await conn.OpenAsync();
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "SELECT sqlite_version();";
                var version = await cmd.ExecuteScalarAsync();
                _dbTestSuccess = true;
                _dbTestMessage = $"✅ SQLite connection successful (v{version}).";
            }
            else
            {
                await using var conn = new Npgsql.NpgsqlConnection(cfg.ConnectionString);
                await conn.OpenAsync();
                // Check TimescaleDB extension
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "SELECT default_version FROM pg_available_extensions WHERE name = 'timescaledb';";
                var tsVersion = await cmd.ExecuteScalarAsync();
                await using var verCmd = conn.CreateCommand();
                verCmd.CommandText = "SELECT version();";
                var pgVersion = await verCmd.ExecuteScalarAsync();
                _dbTestSuccess = true;
                _dbTestMessage = tsVersion != null
                    ? $"✅ Connection successful — PostgreSQL ({pgVersion}), TimescaleDB v{tsVersion} available."
                    : $"✅ Connection successful — PostgreSQL ({pgVersion}). ⚠ TimescaleDB extension not found.";
            }
        }
        catch (Exception ex)
        {
            _dbTestMessage = $"❌ Connection failed: {ex.Message}";
        }
        finally
        {
            _dbTesting = false;
            StateHasChanged();
        }
    }

