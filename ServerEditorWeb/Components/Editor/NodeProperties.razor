    private void MoveStepUp(BatchNode node, int idx)
    {
        if (idx <= 0) return;
        (node.Batch.Steps[idx], node.Batch.Steps[idx - 1]) = (node.Batch.Steps[idx - 1], node.Batch.Steps[idx]);
        OnChanged();
    }

    private void MoveStepDown(BatchNode node, int idx)
    {
        if (idx >= node.Batch.Steps.Count - 1) return;
        (node.Batch.Steps[idx], node.Batch.Steps[idx + 1]) = (node.Batch.Steps[idx + 1], node.Batch.Steps[idx]);
        OnChanged();
    }

    private string GetStepName(BatchNode node, string stepId)
    {
        var step = node.Batch.Steps.FirstOrDefault(s => s.Id == stepId);
        return step?.Name ?? stepId;
    }

