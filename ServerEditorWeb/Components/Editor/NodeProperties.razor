@using ServerEditorWeb.Models
@using ServerEditorWeb.Services
@using SharedModels
@implements IDisposable

@if (Node == null)
{
    <div class="properties-panel">
        <p class="text-muted">@L["general.selectItem"]</p>
    </div>
}
else if (Node is FolderNode folder)
{
    <div class="properties-panel">
        <h5>📁 @L["section.folder"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="folder.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(folder, nameof(folder.Name))" />
        </div>
        <div class="text-muted">
            @L["prop.children"]: @folder.Children.Count (@L["prop.folders"]: @(folder.Children.OfType<FolderNode>().Count()), @L["prop.variables"]: @(folder.Children.OfType<VariableNode>().Count()))
        </div>
    </div>
}
else if (Node is VariableNode variable)
{
    <div class="properties-panel">
        <h5>🏷️ @L["section.variable"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="variable.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(variable, nameof(variable.Name))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.type"]</label>
            <select class="form-select" @bind="variable.Variable.Type" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.Type))">
                @foreach (var t in VariableNode.AvailableTypes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.access"]</label>
            <select class="form-select" @bind="variable.Variable.Access" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.Access))">
                <option value="Read">Read</option>
                <option value="Write">Write</option>
                <option value="ReadWrite">ReadWrite</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">@L["prop.initialValue"]</label>
            <input type="text" class="form-control" @bind="variable.Variable.InitialValue" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.InitialValue))"
                   placeholder="@L["prop.initialValueHint"]" />
            <div class="form-text">@L["prop.initialValueDesc"]</div>
        </div>

        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="variable.Variable.Retentive" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(variable.Variable, nameof(variable.Variable.Retentive))" />
            <label class="form-check-label">@L["prop.retentive"]</label>
            <div class="form-text">@L["prop.retentiveHint"]</div>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(variable.Variable.Statistics?.Enabled == true)"
                       @onchange="e => { variable.Variable.Statistics ??= new SharedModels.VariableStatisticsConfig(); variable.Variable.Statistics.Enabled = (bool)(e.Value ?? false); if (!variable.Variable.Statistics.Enabled) variable.Variable.Statistics = null; OnChanged(); }" />
                <label class="form-check-label">@L["prop.enableStats"]</label>
            </div>
            <div class="form-text">@L["prop.enableStatsHint"]</div>
        </div>

        @* ── Engineering Unit ── *@
        <div class="mb-3">
            <label class="form-label">Engineering Unit</label>
            <input type="text" class="form-control" @bind="variable.Variable.EngineeringUnit" @bind:after="OnChanged"
                   placeholder="e.g. °C, bar, %, m³/h" />
            <div class="form-text">Exposed as OPC UA EngineeringUnits property.</div>
        </div>

        @* ── Scaling ── *@
        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(variable.Variable.Scaling != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) variable.Variable.Scaling ??= new SharedModels.ScalingConfig(); else variable.Variable.Scaling = null; OnChanged(); }" />
                <label class="form-check-label">Enable Linear Scaling</label>
            </div>
            <div class="form-text">Convert raw driver values to engineering units (linear interpolation).</div>
        </div>
        @if (variable.Variable.Scaling is { } sc)
        {
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Raw Min</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.RawMin" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label small">Raw Max</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.RawMax" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Eng Min</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.EngMin" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label small">Eng Max</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="sc.EngMax" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="sc.ClampEnabled" @bind:after="OnChanged" />
                <label class="form-check-label">Clamp to engineering range</label>
            </div>
        }

        <VariableDriverEditor Variable="variable.Variable"
                              VariableNode="variable"
                              OnChanged="OnChanged" />

        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between">
                <label class="form-label mb-0">@L["prop.driverJson"]</label>
                <button class="btn btn-sm btn-link py-0" style="font-size: 9px;"
                        @onclick="() => _showDriverJson = !_showDriverJson">
                    @(_showDriverJson ? "Ôû╝ Hide" : "ÔûÂ Show")
                </button>
            </div>
            @if (_showDriverJson)
            {
                <CodeEditor @bind-Value="variable.DriverSettingsJson" @bind-Value:after="OnDriverJsonChanged" Language="json" Height="120px" />
            }
        </div>
    </div>
}
else if (Node is ScriptNode script)
{
    <div class="properties-panel">
        <h5>⚡ @L["section.script"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="script.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(script, nameof(script.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="script.Script.Enabled" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(script.Script, nameof(script.Script.Enabled))" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.interval"]</label>
            <input type="number" class="form-control" @bind="script.Script.IntervalMs" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(script.Script, nameof(script.Script.IntervalMs))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.language"]</label>
            <select class="form-select" @bind="script.Script.Language" @bind:after="OnLanguageChanged">
                <option value="CSharp">C#</option>
                <option value="VB">VB.NET</option>
            </select>
        </div>
        <div class="alert alert-info small mt-2">
            <strong>Script Editor</strong> — Double-click the node or open the
            <strong>Script Editor</strong> panel to edit code with syntax checking and live debug annotations.
        </div>
    </div>
}
else if (Node is ResourceFolderNode resFolder)
{
    <div class="properties-panel">
        <h5>📁 @L["section.folder"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="resFolder.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(resFolder, nameof(resFolder.Name))" />
        </div>
        <div class="text-muted">
            @L["prop.type"]: @resFolder.ResourceKind<br/>
            @L["prop.children"]: @resFolder.Children.Count
        </div>
    </div>
}
else if (Node is ScriptGroupNode)
{
    <div class="properties-panel">
        <h5>📜 Script Group</h5>
        <p class="text-muted">Select a script to edit, or add a new one.</p>
    </div>
}
else if (Node is PlcProgramNode plcNode)
{
    <div class="properties-panel">
        <h5>⚙️ @L["section.plc"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="plcNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(plcNode, nameof(plcNode.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="plcNode.PlcProgram.Enabled" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(plcNode.PlcProgram, nameof(plcNode.PlcProgram.Enabled))" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.cycleTime"]</label>
            <input type="number" class="form-control" @bind="plcNode.PlcProgram.IntervalMs" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(plcNode.PlcProgram, nameof(plcNode.PlcProgram.IntervalMs))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.language"]</label>
            <select class="form-select" @bind="plcNode.PlcProgram.Language" @bind:after="OnPlcLanguageChanged">
                <option value="ST">Structured Text (ST)</option>
                <option value="IL">Instruction List (IL)</option>
                <option value="LD">Ladder Diagram (LD)</option>
            </select>
        </div>

        @if (plcNode.PlcProgram.Language.Equals("LD", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert alert-info small">
                <strong>⚡ Ladder Diagram</strong> — Double-click the node or open the
                <strong>Ladder Editor</strong> panel to use the graphical editor with contacts, coils, and function blocks.
            </div>
        }
        else
        {
            <div class="alert alert-info small">
                <strong>@GetPlcLanguageLabel(plcNode.PlcProgram.Language) Editor</strong> — Double-click the node or open the
                <strong>PLC Editor</strong> panel to edit code with syntax checking and live debug annotations.
            </div>
        }
    </div>
}
else if (Node is PlcGroupNode)
{
    <div class="properties-panel">
        <h5>🔧 PLC Programs</h5>
        <p class="text-muted">Select a PLC program to edit, or add a new one.</p>
        <p class="text-muted small">
            PLC programs use IEC 61131-3 languages to read and write OPC variables cyclically.<br/>
            Supported languages: <strong>Structured Text (ST)</strong>, <strong>Instruction List (IL)</strong>, and <strong>Ladder Diagram (LD)</strong>.
        </p>
    </div>
}
else if (Node is RecipeNode recipeNode)
{
    <div class="properties-panel">
        <h5>📦 @L["section.recipe"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="recipeNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(recipeNode, nameof(recipeNode.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="recipeNode.Recipe.Enabled" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(recipeNode.Recipe, nameof(recipeNode.Recipe.Enabled))" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.dbPath"]</label>
            <input type="text" class="form-control" @bind="recipeNode.Recipe.DbPath" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(recipeNode.Recipe, nameof(recipeNode.Recipe.DbPath))"
                   placeholder="recipes/{name}.db (relative to config)" />
            <div class="form-text">Leave empty for default: <code>recipes/@(recipeNode.Name).db</code></div>
        </div>

        <h6 class="mt-3">Recipe Variables</h6>
        <p class="text-muted small">
            Each variable is identified by a stable <strong>Index</strong> (used as the column key in the database)
            and maps to an OPC <strong>Variable Path</strong>.
        </p>

        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th style="width: 60px;">Index</th>
                    <th>Variable Path</th>
                    <th style="width: 120px;">Display Name</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < recipeNode.Recipe.Variables.Count; i++)
                {
                    var idx = i;
                    var rv = recipeNode.Recipe.Variables[idx];
                    <tr>
                        <td>
                            <input type="number" class="form-control form-control-sm" value="@rv.Index"
                                   @onchange="e => { rv.Index = int.TryParse(e.Value?.ToString(), out var n) ? n : rv.Index; OnChanged(); }" />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" value="@rv.VariablePath"
                                   placeholder="e.g. Plant.Furnace.Temperature"
                                   @onchange="e => { rv.VariablePath = e.Value?.ToString() ?? string.Empty; OnChanged(); }" />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" value="@rv.DisplayName"
                                   placeholder="(optional)"
                                   @onchange="e => { rv.DisplayName = e.Value?.ToString() ?? string.Empty; OnChanged(); }" />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRecipeVariable(recipeNode, idx)" title="Remove">Ô£ò</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddRecipeVariable(recipeNode)">Ô×ò Add Variable</button>

        <div class="alert alert-info small mt-3">
            <strong>OPC Variables at Runtime:</strong><br/>
            The server creates the following variables under <code>Recipe.@(recipeNode.Name)</code>:
            <ul class="mb-0 mt-1">
                <li><code>.Load</code> — Write a recipe name to load stored values into OPC variables</li>
                <li><code>.Save</code> — Write a recipe name to save current OPC variable values</li>
                <li><code>.Activate</code> — Write a recipe name to load + set as active</li>
                <li><code>.Delete</code> — Write a recipe name to delete it from the database</li>
                <li><code>.ActiveName</code> — Read the currently active recipe name</li>
                <li><code>.RecipeList</code> — Read a comma-separated list of stored recipes</li>
                <li><code>.LastStatus</code> — Read the result of the last operation</li>
            </ul>
        </div>
    </div>
}
else if (Node is RecipeGroupNode)
{
    <div class="properties-panel">
        <h5>🍳 Recipes</h5>
        <p class="text-muted">Select a recipe to edit, or add a new one.</p>
        <p class="text-muted small">
            Recipes store named sets of variable values in a SQLite database.<br/>
            At runtime, OPC command variables allow loading, saving, and activating recipes
            from HMI screens, scripts, or PLC programs.
        </p>
    </div>
}
else if (Node is SchedulerNode schedulerNode)
{
    <div class="properties-panel">
        <h5>📅 @L["section.scheduler"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="schedulerNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(schedulerNode, nameof(schedulerNode.Name))" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="schedulerNode.Scheduler.Enabled" @bind:after="OnChanged" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="schedulerNode.Scheduler.AllowRuntimeEdit" @bind:after="OnChanged" />
            <label class="form-check-label">@L["prop.allowRuntimeEdit"]</label>
            <div class="form-text">@L["prop.allowRuntimeEditHint"]</div>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.slotGranularity"]</label>
            <select class="form-select" @bind="schedulerNode.Scheduler.SlotMinutes" @bind:after="OnChanged">
                <option value="15">15 minutes</option>
                <option value="60">1 hour</option>
            </select>
        </div>

        <h6 class="mt-3">Weekend Behavior</h6>
        <div class="mb-3">
            <select class="form-select" @bind="schedulerNode.Scheduler.WeekendMode" @bind:after="OnChanged">
                <option value="Same">Same as weekdays</option>
                <option value="Off">Off (no execution)</option>
                <option value="Custom">Custom weekend schedule</option>
            </select>
        </div>

        <h6 class="mt-3">Holiday Behavior</h6>
        <div class="mb-3">
            <select class="form-select" @bind="schedulerNode.Scheduler.HolidayMode" @bind:after="OnChanged">
                <option value="Same">Same as normal schedule</option>
                <option value="Off">Off (no execution)</option>
                <option value="Weekend">Use weekend schedule</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.holidayLocale"]</label>
            <select class="form-select" @bind="schedulerNode.Scheduler.HolidayLocale" @bind:after="OnChanged">
                <option value="">@L["prop.none"]</option>
                @foreach (var locale in SharedModels.HolidayCalendars.AvailableLocales)
                {
                    <option value="@locale">@locale</option>
                }
            </select>
            <div class="form-text">@L["prop.holidayLocaleHint"]</div>
        </div>

        @if (!string.IsNullOrEmpty(schedulerNode.Scheduler.HolidayLocale) && SharedModels.HolidayCalendars.BuiltIn.TryGetValue(schedulerNode.Scheduler.HolidayLocale, out var builtInHolidays))
        {
            <details class="mb-3">
                <summary class="small text-muted">Built-in holidays (@schedulerNode.Scheduler.HolidayLocale): @builtInHolidays.Count</summary>
                <ul class="list-unstyled small ps-3 mt-1">
                    @foreach (var h in builtInHolidays)
                    {
                        <li>@h.Name — @h.Month/@h.Day</li>
                    }
                </ul>
            </details>
        }

        <h6 class="mt-3">Custom Holidays</h6>
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th style="width: 60px;">Month</th>
                    <th style="width: 60px;">Day</th>
                    <th style="width: 60px;">Year</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in schedulerNode.Scheduler.CustomHolidays)
                {
                    var holiday = h;
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" @bind="holiday.Name" @bind:after="OnChanged" /></td>
                        <td><input type="number" class="form-control form-control-sm" @bind="holiday.Month" @bind:after="OnChanged" /></td>
                        <td><input type="number" class="form-control form-control-sm" @bind="holiday.Day" @bind:after="OnChanged" /></td>
                        <td><input type="number" class="form-control form-control-sm" @bind="holiday.Year" @bind:after="OnChanged" placeholder="0=all" /></td>
                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => { schedulerNode.Scheduler.CustomHolidays.Remove(holiday); OnChanged(); }">Ô£ò</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-sm btn-outline-primary" @onclick="() => { schedulerNode.Scheduler.CustomHolidays.Add(new SharedModels.HolidayEntry()); OnChanged(); }">Ô×ò Add Holiday</button>

        <h6 class="mt-3">Activate Commands</h6>
        <p class="text-muted small">Commands executed when a time slot becomes active.</p>
        @for (int i = 0; i < schedulerNode.Scheduler.Commands.Count; i++)
        {
            var idx = i;
            var cmd = schedulerNode.Scheduler.Commands[idx];
            <div class="border rounded p-2 mb-2" style="font-size: 11px;">
                <div class="d-flex gap-1 mb-1">
                    <select class="form-select form-select-sm" style="font-size: 10px;" @bind="cmd.Action" @bind:after="OnChanged">
                        <optgroup label="Navigation">
                            <option value="NavigateScreen">Navigate Screen</option>
                            <option value="OpenScreenPopup">Open Screen Popup</option>
                            <option value="OpenScreenModal">Open Screen Modal</option>
                        </optgroup>
                        <optgroup label="Variables">
                            <option value="SetVariable">Set Variable</option>
                            <option value="WriteVariable">Write Variable</option>
                            <option value="ResetVariable">Reset Variable</option>
                            <option value="ToggleVariable">Toggle Variable</option>
                            <option value="IncrementVariable">Increment Variable</option>
                            <option value="DecrementVariable">Decrement Variable</option>
                        </optgroup>
                        <optgroup label="Scripting">
                            <option value="ExecuteScript">Execute Script</option>
                            <option value="ExecuteJavaScript">Execute JavaScript</option>
                        </optgroup>
                        <optgroup label="Authentication">
                            <option value="Login">Login</option>
                            <option value="Logout">Logout</option>
                        </optgroup>
                        <optgroup label="Alarms">
                            <option value="AcknowledgeAllAlarms">Acknowledge All Alarms</option>
                            <option value="ResetAllAlarms">Reset All Alarms</option>
                        </optgroup>
                        <optgroup label="Other">
                            <option value="ChangeLanguage">Change Language</option>
                        </optgroup>
                    </select>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;" @onclick="() => { schedulerNode.Scheduler.Commands.RemoveAt(idx); OnChanged(); }">Ô£ò</button>
                </div>
                @if (cmd.Action is "SetVariable" or "WriteVariable" or "ToggleVariable" or "IncrementVariable" or "DecrementVariable")
                {
                    <input type="text" class="form-control form-control-sm mb-1" style="font-size: 10px;" placeholder="Variable path" @bind="cmd.VariablePath" @bind:after="OnChanged" />
                    @if (cmd.Action is not "ToggleVariable")
                    {
                        <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="@(cmd.Action is "IncrementVariable" or "DecrementVariable" ? "Step (default 1)" : "Value")" @bind="cmd.Value" @bind:after="OnChanged" />
                    }
                }
                else if (cmd.Action == "ResetVariable")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Variable path" @bind="cmd.VariablePath" @bind:after="OnChanged" />
                }
                else if (cmd.Action is "NavigateScreen" or "OpenScreenPopup" or "OpenScreenModal")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Screen name" @bind="cmd.TargetScreen" @bind:after="OnChanged" />
                }
                else if (cmd.Action is "ExecuteScript" or "ExecuteJavaScript")
                {
                    <textarea class="form-control form-control-sm" style="font-size: 10px;" rows="3" placeholder="@(cmd.Action == "ExecuteJavaScript" ? "JavaScript code" : "C# script")" @bind="cmd.Script" @bind:after="OnChanged"></textarea>
                }
                else if (cmd.Action is "AcknowledgeAllAlarms" or "ResetAllAlarms")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Comment (optional)" @bind="cmd.Value" @bind:after="OnChanged" />
                }
                else if (cmd.Action == "ChangeLanguage")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Language code (e.g. en, de, it)" @bind="cmd.Value" @bind:after="OnChanged" />
                }
                else if (cmd.Action == "GenerateReport")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Report name" @bind="cmd.TargetReport" @bind:after="OnChanged" />
                }
            </div>
        }
        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddSchedulerCommand(schedulerNode, false)">Ô×ò Add Command</button>

        <h6 class="mt-3">Deactivate Commands</h6>
        <p class="text-muted small">Commands executed when leaving a time slot (becomes inactive).</p>
        @for (int i = 0; i < schedulerNode.Scheduler.DeactivateCommands.Count; i++)
        {
            var idx = i;
            var cmd = schedulerNode.Scheduler.DeactivateCommands[idx];
            <div class="border rounded p-2 mb-2" style="font-size: 11px;">
                <div class="d-flex gap-1 mb-1">
                    <select class="form-select form-select-sm" style="font-size: 10px;" @bind="cmd.Action" @bind:after="OnChanged">
                        <optgroup label="Navigation">
                            <option value="NavigateScreen">Navigate Screen</option>
                            <option value="OpenScreenPopup">Open Screen Popup</option>
                            <option value="OpenScreenModal">Open Screen Modal</option>
                        </optgroup>
                        <optgroup label="Variables">
                            <option value="SetVariable">Set Variable</option>
                            <option value="WriteVariable">Write Variable</option>
                            <option value="ResetVariable">Reset Variable</option>
                            <option value="ToggleVariable">Toggle Variable</option>
                            <option value="IncrementVariable">Increment Variable</option>
                            <option value="DecrementVariable">Decrement Variable</option>
                        </optgroup>
                        <optgroup label="Scripting">
                            <option value="ExecuteScript">Execute Script</option>
                            <option value="ExecuteJavaScript">Execute JavaScript</option>
                        </optgroup>
                        <optgroup label="Authentication">
                            <option value="Login">Login</option>
                            <option value="Logout">Logout</option>
                        </optgroup>
                        <optgroup label="Alarms">
                            <option value="AcknowledgeAllAlarms">Acknowledge All Alarms</option>
                            <option value="ResetAllAlarms">Reset All Alarms</option>
                        </optgroup>
                        <optgroup label="Other">
                            <option value="ChangeLanguage">Change Language</option>
                        </optgroup>
                    </select>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;" @onclick="() => { schedulerNode.Scheduler.DeactivateCommands.RemoveAt(idx); OnChanged(); }">Ô£ò</button>
                </div>
                @if (cmd.Action is "SetVariable" or "WriteVariable" or "ToggleVariable" or "IncrementVariable" or "DecrementVariable")
                {
                    <input type="text" class="form-control form-control-sm mb-1" style="font-size: 10px;" placeholder="Variable path" @bind="cmd.VariablePath" @bind:after="OnChanged" />
                    @if (cmd.Action is not "ToggleVariable")
                    {
                        <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="@(cmd.Action is "IncrementVariable" or "DecrementVariable" ? "Step (default 1)" : "Value")" @bind="cmd.Value" @bind:after="OnChanged" />
                    }
                }
                else if (cmd.Action == "ResetVariable")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Variable path" @bind="cmd.VariablePath" @bind:after="OnChanged" />
                }
                else if (cmd.Action is "NavigateScreen" or "OpenScreenPopup" or "OpenScreenModal")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Screen name" @bind="cmd.TargetScreen" @bind:after="OnChanged" />
                }
                else if (cmd.Action is "ExecuteScript" or "ExecuteJavaScript")
                {
                    <textarea class="form-control form-control-sm" style="font-size: 10px;" rows="3" placeholder="@(cmd.Action == "ExecuteJavaScript" ? "JavaScript code" : "C# script")" @bind="cmd.Script" @bind:after="OnChanged"></textarea>
                }
                else if (cmd.Action is "AcknowledgeAllAlarms" or "ResetAllAlarms")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Comment (optional)" @bind="cmd.Value" @bind:after="OnChanged" />
                }
                else if (cmd.Action == "ChangeLanguage")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Language code (e.g. en, de, it)" @bind="cmd.Value" @bind:after="OnChanged" />
                }
                else if (cmd.Action == "GenerateReport")
                {
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;" placeholder="Report name" @bind="cmd.TargetReport" @bind:after="OnChanged" />
                }
            </div>
        }
        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddSchedulerCommand(schedulerNode, true)">Ô×ò Add Deactivate Command</button>

        <div class="alert alert-info small mt-3">
            <strong>Usage:</strong> Use the <strong>Scheduler Editor</strong> panel to visually edit the weekly schedule.
            Add a <strong>Weekly Planner</strong> widget to a screen to let runtime users view/edit the schedule.
        </div>
    </div>
}
else if (Node is SchedulerGroupNode)
{
    <div class="properties-panel">
        <h5>⏰ Schedulers</h5>
        <p class="text-muted">Select a scheduler to edit, or add a new one.</p>
        <p class="text-muted small">
            Schedulers execute commands at configured times on a weekly recurring basis.<br/>
            Supports different behaviors for weekdays, weekends, and public holidays.
        </p>
    </div>
}
else if (Node is ReportNode reportNode)
{
    <div class="properties-panel">
        <h5>📄 @L["section.report"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="reportNode.Name" @bind:after="OnChanged" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="reportNode.Report.Enabled" @bind:after="OnChanged" />
            <label class="form-check-label">@L["prop.enabled"]</label>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.title"]</label>
            <input type="text" class="form-control" @bind="reportNode.Report.Title" @bind:after="OnChanged" placeholder="Report title in header" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.description"]</label>
            <textarea class="form-control" rows="2" @bind="reportNode.Report.Description" @bind:after="OnChanged" placeholder="Optional subtitle"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.format"]</label>
            <select class="form-select" @bind="reportNode.Report.Format" @bind:after="OnChanged">
                <option value="HTML">HTML</option>
                <option value="PDF">PDF</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.pageSize"]</label>
            <select class="form-select" @bind="reportNode.Report.PageSize" @bind:after="OnChanged">
                <option value="A4">A4</option>
                <option value="Letter">Letter</option>
                <option value="A3">A3</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.orientation"]</label>
            <select class="form-select" @bind="reportNode.Report.Orientation" @bind:after="OnChanged">
                <option value="Portrait">Portrait</option>
                <option value="Landscape">Landscape</option>
            </select>
        </div>

        <h6 class="mt-3">Delivery</h6>
        <div class="mb-3">
            <label class="form-label">@L["prop.deliveryMethod"]</label>
            <select class="form-select" @bind="reportNode.Report.Delivery.Method" @bind:after="OnChanged">
                <option value="Disk">Save to Disk</option>
                <option value="Email">Send via Email</option>
                <option value="Both">Both (Disk + Email)</option>
            </select>
        </div>

        @if (reportNode.Report.Delivery.Method is "Disk" or "Both")
        {
            <div class="mb-3">
                <label class="form-label">@L["prop.outputDir"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.DiskPath" @bind:after="OnChanged" placeholder="Reports" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.fileNamePattern"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.FileNamePattern" @bind:after="OnChanged" placeholder="{ReportName}_{DateTime}" />
                <div class="form-text">Placeholders: {ReportName}, {DateTime}, {Date}</div>
            </div>
        }

        @if (reportNode.Report.Delivery.Method is "Email" or "Both")
        {
            <div class="mb-3">
                <label class="form-label">@L["prop.recipients"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.EmailRecipients" @bind:after="OnChanged" placeholder="user@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.emailSubject"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.EmailSubject" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpServer"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.SmtpServer" @bind:after="OnChanged" placeholder="smtp.example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpPort"]</label>
                <input type="number" class="form-control" @bind="reportNode.Report.Delivery.SmtpPort" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpUser"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.SmtpUser" @bind:after="OnChanged" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.smtpPass"]</label>
                <input type="password" class="form-control" @bind="reportNode.Report.Delivery.SmtpPassword" @bind:after="OnChanged" />
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="reportNode.Report.Delivery.SmtpUseSsl" @bind:after="OnChanged" />
                <label class="form-check-label">@L["prop.smtpSsl"]</label>
            </div>
            <div class="mb-3">
                <label class="form-label">@L["prop.fromAddress"]</label>
                <input type="text" class="form-control" @bind="reportNode.Report.Delivery.SmtpFromAddress" @bind:after="OnChanged" placeholder="noreply@example.com" />
            </div>
        }

        <div class="alert alert-info small mt-3">
            <strong>Sections:</strong> @reportNode.Report.Sections.Count section(s).<br/>
            Open the <strong>Report Designer</strong> panel (double-click) to add charts, tables, text and value sections.
        </div>
    </div>
}
else if (Node is ReportGroupNode)
{
    <div class="properties-panel">
        <h5>📊 Reports</h5>
        <p class="text-muted">Select a report to edit, or add a new one.</p>
        <p class="text-muted small">
            Reports can include charts from historical data, real-time OPC values, tables, and text.<br/>
            Generate reports on demand or bind them to a <strong>GenerateReport</strong> command action.<br/>
            Add a <strong>Report Viewer</strong> widget to a screen to display generated reports at runtime.
        </p>
    </div>
}
else if (Node is ScreenNode screen)
{
    <div class="properties-panel">
        <h5>🖼️ @L["section.screen"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="screen.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(screen, nameof(screen.Name))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.width"]</label>
            <input type="number" class="form-control" @bind="screen.Screen.Width" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(screen.Screen, nameof(screen.Screen.Width))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.height"]</label>
            <input type="number" class="form-control" @bind="screen.Screen.Height" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(screen.Screen, nameof(screen.Screen.Height))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.background"]</label>
            <ColorPicker Value="@(screen.Screen.Background)"
                         ValueChanged="(v) => { screen.Screen.Background = v; }"
                         OnAfterChange="OnChanged" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.backgroundImage"]</label>
            <select class="form-select form-select-sm"
                    value="@screen.Screen.BackgroundImageId"
                    @onchange="(e) => { screen.Screen.BackgroundImageId = e.Value?.ToString() ?? string.Empty; OnChanged(); }">
                <option value="">@L["prop.none"]</option>
                @foreach (var img in (Editor.RootModel?.Images ?? []))
                {
                    <option value="@img.Id">@img.Id</option>
                }
            </select>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="screen.Screen.ShowInNavigation" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(screen.Screen, nameof(screen.Screen.ShowInNavigation))" />
            <label class="form-check-label">@L["prop.showInNav"]</label>
            <div class="form-text">@L["prop.showInNavHint"]</div>
        </div>
        <div class="text-muted">
            @L["prop.symbols"]: @screen.Screen.Symbols.Count
        </div>
        <p class="text-muted small mt-2">@L["prop.screenEditorHint"]</p>
    </div>
}
else if (Node is ScreenGroupNode)
{
    <div class="properties-panel">
        <h5>🖥️ @L["section.screenGroup"]</h5>
        <p class="text-muted">@L["section.screenGroupHint"]</p>
    </div>
}
else if (Node is UserGroupListNode)
{
    <div class="properties-panel">
        <h5>👥 @L["section.userGroupList"]</h5>
        <p class="text-muted">@L["section.userGroupListHint"]</p>
        <p class="text-muted small">@L["section.userGroupListHint2"]</p>
    </div>
}
else if (Node is ServerSettingsNode ssNode)
{
    <div class="properties-panel">
        <h5>⚙️ @L["section.serverSettings"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.endpointUrl"]</label>
            <input type="text" class="form-control" @bind="ssNode.Settings.EndpointUrl" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EndpointUrl))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.startupScreen"]</label>
            <select class="form-select"
                    value="@ssNode.Settings.StartupScreen"
                    @onchange="(e) => { ssNode.Settings.StartupScreen = e.Value?.ToString() ?? string.Empty; OnChanged(); }">
                <option value="">@L["prop.none"]</option>
                @foreach (var scr in (Editor.RootModel?.Screens ?? []))
                {
                    <option value="@scr.Name">@scr.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.navStyle"]</label>
            <select class="form-select" @bind="ssNode.Settings.NavigationStyle" @bind:after="OnChanged"
                    @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.NavigationStyle))">
                <option value="tabs">@L["prop.navTabs"]</option>
                <option value="sidebar">@L["prop.navSidebar"]</option>
                <option value="hamburger">@L["prop.navHamburger"]</option>
                <option value="bottom">@L["prop.navBottom"]</option>
            </select>
            <div class="form-text">@L["prop.navStyleHint"]</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.ShowNavigationBar" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.ShowNavigationBar))" />
            <label class="form-check-label">@L["prop.showNavBar"]</label>
            <div class="form-text">@L["prop.showNavBarHint"]</div>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableAnonymous" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableAnonymous))" />
            <label class="form-check-label">@L["prop.enableAnon"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableEditorLogin" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableEditorLogin))" />
            <label class="form-check-label">@L["prop.requireEditorLogin"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableRuntimeLogin" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableRuntimeLogin))" />
            <label class="form-check-label">@L["prop.requireRuntimeLogin"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.RequireStrongPassword" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.RequireStrongPassword))" />
            <label class="form-check-label">@L["prop.requireStrongPw"]</label>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ssNode.Settings.EnableTagBrowser" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.EnableTagBrowser))" />
            <label class="form-check-label">Enable Tag Browser in Runtime</label>
            <div class="form-text">Show the Tag Browser button in the runtime viewer top bar, allowing operators to browse, search, read, and write OPC UA tags.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.diagPort"]</label>
            <input type="number" class="form-control" @bind="ssNode.Settings.DiagnosticsPort" @bind:after="OnChanged"
                   @onfocus="() => CaptureForUndo(ssNode.Settings, nameof(ssNode.Settings.DiagnosticsPort))" />
            <div class="form-text">@L["prop.diagPortHint"]</div>
        </div>

        @* ─── Alarm Notifications ─────────────────────────────── *@
        <hr />
        <h6>📨 Alarm Notifications</h6>
        <div class="form-text mb-2">
            Send alarm notifications via Email, Telegram, and/or WhatsApp when alarms with "Notify on activation" fire.
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.AlarmNotification?.Enabled == true)"
                   @onchange="(e) => { EnsureAlarmNotification(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            <label class="form-check-label">Enable Alarm Notifications</label>
        </div>
        @if (ssNode.Settings.AlarmNotification is { Enabled: true })
        {
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label small">Min Severity</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="1000"
                           @bind="ssNode.Settings.AlarmNotification.MinSeverity" @bind:after="OnChanged" />
                    <div class="form-text">Only notify for alarms ≥ this severity (1–1000).</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Cooldown (sec)</label>
                    <input type="number" class="form-control form-control-sm" min="0"
                           @bind="ssNode.Settings.AlarmNotification.CooldownSeconds" @bind:after="OnChanged" />
                    <div class="form-text">Seconds between repeated notifications for the same alarm.</div>
                </div>
            </div>

            @* ── Email Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>📧 Email (SMTP)</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.Email?.Enabled == true)"
                               @onchange="(e) => { EnsureEmailChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.Email is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="row g-1 mb-1">
                            <div class="col-8">
                                <label class="form-label mb-0 small">SMTP Host</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.SmtpHost" @bind:after="OnChanged"
                                       placeholder="smtp.gmail.com" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 small">Port</label>
                                <input type="number" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.SmtpPort" @bind:after="OnChanged" />
                            </div>
                        </div>
                        <div class="mb-1 form-check">
                            <input class="form-check-input" type="checkbox"
                                   @bind="ssNode.Settings.AlarmNotification.Email.UseSsl" @bind:after="OnChanged" />
                            <label class="form-check-label small">Use SSL/TLS</label>
                        </div>
                        <div class="row g-1 mb-1">
                            <div class="col-6">
                                <label class="form-label mb-0 small">Username</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.Username" @bind:after="OnChanged" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small">Password</label>
                                <input type="password" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.Email.Password" @bind:after="OnChanged" />
                            </div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">From</label>
                            <input type="email" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Email.From" @bind:after="OnChanged"
                                   placeholder="alerts@mycompany.com" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">To (comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Email.To" @bind:after="OnChanged"
                                   placeholder="operator@mycompany.com, manager@mycompany.com" />
                        </div>
                    </div>
                }
            </div>

            @* ── Telegram Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>✈️ Telegram</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.Telegram?.Enabled == true)"
                               @onchange="(e) => { EnsureTelegramChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.Telegram is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Bot Token</label>
                            <input type="password" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Telegram.BotToken" @bind:after="OnChanged"
                                   placeholder="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11" />
                            <div class="form-text">Create a bot via @@BotFather on Telegram.</div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Chat ID(s) (comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.Telegram.ChatId" @bind:after="OnChanged"
                                   placeholder="-1001234567890" />
                            <div class="form-text">User, group, or channel ID. Use @@userinfobot to find your chat ID.</div>
                        </div>
                        <div class="mb-1 form-check">
                            <input class="form-check-input" type="checkbox"
                                   @bind="ssNode.Settings.AlarmNotification.Telegram.UseHtml" @bind:after="OnChanged" />
                            <label class="form-check-label small">Use HTML formatting</label>
                        </div>
                    </div>
                }
            </div>

            @* ── WhatsApp Channel ── *@
            <div class="card mb-2">
                <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                    <span>💬 WhatsApp</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               checked="@(ssNode.Settings.AlarmNotification.WhatsApp?.Enabled == true)"
                               @onchange="(e) => { EnsureWhatsAppChannel(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
                    </div>
                </div>
                @if (ssNode.Settings.AlarmNotification.WhatsApp is { Enabled: true })
                {
                    <div class="card-body p-2">
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Access Token</label>
                            <input type="password" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.WhatsApp.AccessToken" @bind:after="OnChanged"
                                   placeholder="WhatsApp Cloud API access token" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">Phone Number ID</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.WhatsApp.PhoneNumberId" @bind:after="OnChanged"
                                   placeholder="From Meta Business Manager" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label mb-0 small">To (E.164 format, comma-separated)</label>
                            <input type="text" class="form-control form-control-sm"
                                   @bind="ssNode.Settings.AlarmNotification.WhatsApp.To" @bind:after="OnChanged"
                                   placeholder="+1234567890, +0987654321" />
                        </div>
                        <div class="row g-1 mb-1">
                            <div class="col-6">
                                <label class="form-label mb-0 small">Template Name (optional)</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.WhatsApp.TemplateName" @bind:after="OnChanged"
                                       placeholder="alarm_notification" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 small">Template Language</label>
                                <input type="text" class="form-control form-control-sm"
                                       @bind="ssNode.Settings.AlarmNotification.WhatsApp.TemplateLanguage" @bind:after="OnChanged"
                                       placeholder="en_US" />
                            </div>
                        </div>
                        <div class="form-text">Use a template for initiating conversations. Leave empty for free-form text (24h session window only).</div>
                    </div>
                }
            </div>
        }
    </div>

    @* ── GDS (Global Discovery Server) ── *@
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label mb-0 fw-bold">🌐 GDS (Global Discovery Server)</label>
        </div>
        <div class="form-text mb-2">Configure a GDS endpoint for centralized certificate management.</div>
        <div class="mb-2">
            <label class="form-label mb-0 small">GDS Endpoint URL</label>
            <input type="text" class="form-control form-control-sm"
                   value="@(ssNode.Settings.Gds?.EndpointUrl ?? "")"
                   @onchange="(e) => { EnsureGdsConfig(ssNode).EndpointUrl = e.Value?.ToString() ?? string.Empty; OnChanged(); }"
                   placeholder="opc.tcp://gds.example.com:58810/GlobalDiscoveryServer" />
        </div>
        <div class="row g-2 mb-1">
            <div class="col-6">
                <label class="form-label mb-0 small">Username (optional)</label>
                <input type="text" class="form-control form-control-sm"
                       value="@(ssNode.Settings.Gds?.UserName ?? "")"
                       @onchange="(e) => { EnsureGdsConfig(ssNode).UserName = e.Value?.ToString() ?? string.Empty; OnChanged(); }"
                       placeholder="Anonymous if empty" />
            </div>
            <div class="col-6">
                <label class="form-label mb-0 small">Password</label>
                <input type="password" class="form-control form-control-sm"
                       value="@(ssNode.Settings.Gds?.Password ?? "")"
                       @onchange="(e) => { EnsureGdsConfig(ssNode).Password = e.Value?.ToString() ?? string.Empty; OnChanged(); }" />
            </div>
        </div>
    </div>

    @* ── Backup / Snapshots ── *@
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label mb-0 fw-bold">💾 Automated Backups</label>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.Backup?.Enabled == true)"
                       @onchange="(e) => { EnsureBackupConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); }" />
            </div>
        </div>
        <div class="form-text mb-2">ZIP snapshots of the project stored in a <code>backups/</code> folder.</div>
        @if (ssNode.Settings.Backup is { Enabled: true })
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox"
                       @bind="ssNode.Settings.Backup.SnapshotOnSave" @bind:after="OnChanged" />
                <label class="form-check-label small">Snapshot on every save</label>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label mb-0 small">Schedule (minutes)</label>
                    <input type="number" class="form-control form-control-sm" min="0"
                           @bind="ssNode.Settings.Backup.ScheduleMinutes" @bind:after="OnChanged" />
                    <div class="form-text">0 = disabled.</div>
                </div>
                <div class="col-6">
                    <label class="form-label mb-0 small">Max snapshots</label>
                    <input type="number" class="form-control form-control-sm" min="1"
                           @bind="ssNode.Settings.Backup.MaxSnapshots" @bind:after="OnChanged" />
                    <div class="form-text">Oldest auto-pruned.</div>
                </div>
            </div>
        }

        @* ── REST API ── *@
        <hr />
        <h6>🌐 REST API</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.Api != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) ssNode.Settings.Api ??= new SharedModels.ApiConfig(); else ssNode.Settings.Api = null; OnChanged(); }" />
                <label class="form-check-label">Enable REST API</label>
            </div>
            <div class="form-text">Expose variables, alarms, recipes, and reports to external systems (MES/ERP).</div>
        </div>
        @if (ssNode.Settings.Api is { } apiCfg)
        {
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="apiCfg.Enabled" @bind:after="OnChanged" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="mb-2">
                <label class="form-label small">Port</label>
                <input type="number" class="form-control form-control-sm" @bind="apiCfg.Port" @bind:after="OnChanged" />
                <div class="form-text">Default: 14842</div>
            </div>
            <div class="mb-2">
                <label class="form-label small">API Key</label>
                <input type="text" class="form-control form-control-sm" @bind="apiCfg.ApiKey" @bind:after="OnChanged"
                       placeholder="Leave empty for no auth (not recommended)" />
                <div class="form-text">Clients send this via <code>X-API-Key</code> header or <code>?apiKey=</code> query parameter.</div>
            </div>
        }

        @* ── Redundancy / High Availability ── *@
        <hr />
        <h6>🔄 Redundancy / HA</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.Redundancy != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) ssNode.Settings.Redundancy ??= new SharedModels.RedundancyConfig(); else ssNode.Settings.Redundancy = null; OnChanged(); }" />
                <label class="form-check-label">Enable Redundancy</label>
            </div>
            <div class="form-text">Heartbeat-based failover between primary and standby servers.</div>
        </div>
        @if (ssNode.Settings.Redundancy is { } redCfg)
        {
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="redCfg.Enabled" @bind:after="OnChanged" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="mb-2">
                <label class="form-label small">Role</label>
                <select class="form-select form-select-sm" @bind="redCfg.Role" @bind:after="OnChanged">
                    <option value="Primary">Primary</option>
                    <option value="Standby">Standby</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label small">Partner Endpoint</label>
                <input type="text" class="form-control form-control-sm" @bind="redCfg.PartnerEndpoint" @bind:after="OnChanged"
                       placeholder="http://192.168.1.100:14841" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Heartbeat (sec)</label>
                    <input type="number" min="1" class="form-control form-control-sm" @bind="redCfg.HeartbeatIntervalSeconds" @bind:after="OnChanged" />
                </div>
                <div class="col-6">
                    <label class="form-label small">Missed Beats</label>
                    <input type="number" min="1" class="form-control form-control-sm" @bind="redCfg.FailoverMissedHeartbeats" @bind:after="OnChanged" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">State Sync Interval (ms)</label>
                <input type="number" min="0" class="form-control form-control-sm" @bind="redCfg.StateSyncIntervalMs" @bind:after="OnChanged" />
                <div class="form-text">0 = disabled. Default 10000 (10 sec).</div>
            </div>
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="redCfg.AutoSwitchback" @bind:after="OnChanged" />
                <label class="form-check-label">Auto Switchback</label>
                <div class="form-text">Automatically return to standby when primary recovers.</div>
            </div>
        }

        @* ── Rate Limiting / Throttling ── *@
        <hr />
        <h6>🛡️ Rate Limiting</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       checked="@(ssNode.Settings.RateLimit != null)"
                       @onchange="e => { if ((bool)(e.Value ?? false)) ssNode.Settings.RateLimit ??= new SharedModels.RateLimitConfig(); else ssNode.Settings.RateLimit = null; OnChanged(); }" />
                <label class="form-check-label">Enable Rate Limiting</label>
            </div>
        </div>
        @if (ssNode.Settings.RateLimit is { } rlCfg)
        {
            <div class="mb-2 form-check">
                <input class="form-check-input" type="checkbox" @bind="rlCfg.Enabled" @bind:after="OnChanged" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="mb-2">
                <label class="form-label small">Window (seconds)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="rlCfg.WindowSeconds" @bind:after="OnChanged" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">REST API max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.ApiMaxRequestsPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">OPC UA writes max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.OpcUaWriteMaxPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Login attempts max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.LoginMaxAttemptsPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Diagnostics max/window</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="rlCfg.DiagnosticsMaxRequestsPerWindow" @bind:after="OnChanged" />
                    <div class="form-text">0 = unlimited</div>
                </div>
            </div>
        }

        @* --- Natural Language Query ----------------------------- *@
        <hr />
        <h6>Natural Language Query</h6>
        <div class="form-text mb-2">
            Let operators ask plain-English questions about historical process data and get AI-powered answers.
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox"
                   checked="@(ssNode.Settings.NaturalLanguageQuery?.Enabled == true)"
                   @onchange="@(e => { EnsureNlQueryConfig(ssNode).Enabled = (bool)(e.Value ?? false); OnChanged(); })" />
            <label class="form-check-label">Enable Natural Language Query</label>
        </div>
        @if (ssNode.Settings.NaturalLanguageQuery is { Enabled: true })
        {
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">AI Engine</label>
                    <select class="form-select form-select-sm"
                            value="@(ssNode.Settings.NaturalLanguageQuery.Engine)"
                            @onchange="@(e => { SetNlEngine(ssNode, e.Value?.ToString()); OnChanged(); })">
                        <option value="Ollama">Ollama (local)</option>
                        <option value="OpenAI">OpenAI</option>
                        <option value="Gemini">Gemini</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small">Model</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="ssNode.Settings.NaturalLanguageQuery.Model" @bind:after="OnChanged"
                           placeholder="mistral" />
                    <div class="form-text">e.g. mistral, llama3, gpt-4o</div>
                </div>
            </div>
            @if (ssNode.Settings.NaturalLanguageQuery.Engine == "Ollama")
            {
                <div class="mb-2">
                    <label class="form-label small">Ollama Base URL</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="ssNode.Settings.NaturalLanguageQuery.OllamaBaseUrl" @bind:after="OnChanged"
                           placeholder="http://localhost:11434" />
                </div>
            }
            @if (ssNode.Settings.NaturalLanguageQuery.Engine is "OpenAI" or "Gemini")
            {
                <div class="mb-2">
                    <label class="form-label small">API Key</label>
                    <input type="password" class="form-control form-control-sm"
                           @bind="ssNode.Settings.NaturalLanguageQuery.ApiKey" @bind:after="OnChanged"
                           placeholder="sk-..." />
                    <div class="form-text">Or set OPENAI_API_KEY / GEMINI_API_KEY env var on the RuntimeViewer host.</div>
                </div>
            }
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small">Default Time Range (min)</label>
                    <input type="number" class="form-control form-control-sm" min="1"
                           @bind="ssNode.Settings.NaturalLanguageQuery.DefaultTimeRangeMinutes" @bind:after="OnChanged" />
                    <div class="form-text">Fallback when user does not specify a time range.</div>
                </div>
                <div class="col-6">
                    <label class="form-label small">Max Data Points</label>
                    <input type="number" class="form-control form-control-sm" min="10" max="5000"
                           @bind="ssNode.Settings.NaturalLanguageQuery.MaxDataPoints" @bind:after="OnChanged" />
                    <div class="form-text">Per-variable limit sent to the AI.</div>
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small">Input Placeholder</label>
                <input type="text" class="form-control form-control-sm"
                       @bind="ssNode.Settings.NaturalLanguageQuery.Placeholder" @bind:after="OnChanged"
                       placeholder="Ask about your process data..." />
            </div>
        }
    </div>
}
else if (Node is CalculatedNode calcNode)
{
    <div class="properties-panel">
        <h5>📐 Calculated Tag</h5>
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" @bind="calcNode.Name" @bind:after="OnChanged" />
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="calcNode.Config.Enabled" @bind:after="OnChanged" />
            <label class="form-check-label">Enabled</label>
        </div>
        <div class="mb-3">
            <label class="form-label">Output Type</label>
            <select class="form-select" @bind="calcNode.Config.Type" @bind:after="OnChanged">
                <option value="Double">Double</option>
                <option value="Int32">Int32</option>
                <option value="Boolean">Boolean</option>
                <option value="String">String</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Folder Path</label>
            <input type="text" class="form-control" @bind="calcNode.Config.FolderPath" @bind:after="OnChanged" placeholder="_Calculated" />
            <div class="form-text">OPC UA folder where the variable is created.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Interval (ms)</label>
            <input type="number" min="100" class="form-control" @bind="calcNode.Config.IntervalMs" @bind:after="OnChanged" />
        </div>
        <div class="mb-3">
            <label class="form-label">Engineering Unit</label>
            <input type="text" class="form-control" @bind="calcNode.Config.EngineeringUnit" @bind:after="OnChanged" placeholder="e.g. °C, bar" />
        </div>

        <hr />
        <h6>Computation Mode</h6>
        <div class="mb-2">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="calcMode_@calcNode.Name"
                       checked="@(string.IsNullOrEmpty(calcNode.Config.AggregateFunction))"
                       @onchange="() => { calcNode.Config.AggregateFunction = string.Empty; OnChanged(); }" />
                <label class="form-check-label">Expression</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="calcMode_@calcNode.Name"
                       checked="@(!string.IsNullOrEmpty(calcNode.Config.AggregateFunction))"
                       @onchange="() => SetAggregateMode(calcNode)" />
                <label class="form-check-label">Aggregate Function</label>
            </div>
        </div>

        @if (string.IsNullOrEmpty(calcNode.Config.AggregateFunction))
        {
            <div class="mb-3">
                <label class="form-label">Expression</label>
                <textarea class="form-control" rows="3" @bind="calcNode.Config.Expression" @bind:after="OnChanged"
                          placeholder="Read(&quot;Tank1.Level&quot;) + Read(&quot;Tank2.Level&quot;)"></textarea>
                <div class="form-text">C# expression. Use <code>Read("path")</code> to reference variables.</div>
            </div>
        }
        else
        {
            <div class="mb-2">
                <label class="form-label">Function</label>
                <select class="form-select" @bind="calcNode.Config.AggregateFunction" @bind:after="OnChanged">
                    <option value="Avg">Avg (Average)</option>
                    <option value="Sum">Sum</option>
                    <option value="Min">Min</option>
                    <option value="Max">Max</option>
                    <option value="Count">Count</option>
                    <option value="RateOfChange">RateOfChange</option>
                    <option value="Delta">Delta</option>
                    <option value="RunningAvg">RunningAvg</option>
                    <option value="RunningMin">RunningMin</option>
                    <option value="RunningMax">RunningMax</option>
                    <option value="StdDev">StdDev</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Source Path(s)</label>
                <input type="text" class="form-control" @bind="calcNode.Config.AggregateSourcePath" @bind:after="OnChanged"
                       placeholder="Tank1.Level or Tank1.Level;Tank2.Level" />
                <div class="form-text">Semicolon-separated for multi-source aggregates (Sum, Min, Max across tags).</div>
            </div>
            <div class="mb-2">
                <label class="form-label">Window (seconds)</label>
                <input type="number" min="1" class="form-control" @bind="calcNode.Config.AggregateWindowSeconds" @bind:after="OnChanged" />
                <div class="form-text">Rolling window for time-based aggregates. Default 300 (5 min).</div>
            </div>
        }
    </div>
}
else if (Node is CalculatedGroupNode)
{
    <div class="properties-panel">
        <h5>🔢 Calculated Tags</h5>
        <p class="text-muted">Select a calculated tag to edit, or add a new one.</p>
        <p class="text-muted small">
            Calculated tags compute values from expressions or aggregate functions.<br/>
            Use <strong>Expression</strong> mode for custom C# formulas, or <strong>Aggregate</strong> mode for built-in functions like Avg, Sum, Min, Max, StdDev, etc.
        </p>
    </div>
}
else if (Node is UserGroupNode ugNode)
{
    <div class="properties-panel">
        <h5>🛡️ @L["section.userGroup"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.name"]</label>
            <input type="text" class="form-control" @bind="ugNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(ugNode, nameof(ugNode.Name))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.accessLevel"]</label>
            <select class="form-select" @bind="ugNode.UserGroup.AccessLevel" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(ugNode.UserGroup, nameof(ugNode.UserGroup.AccessLevel))">
                <option value="Read">Read</option>
                <option value="Write">Write</option>
                <option value="ReadWrite">ReadWrite</option>
            </select>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" @bind="ugNode.UserGroup.CanAccessEditor" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(ugNode.UserGroup, nameof(ugNode.UserGroup.CanAccessEditor))" />
            <label class="form-check-label">@L["prop.canAccessEditor"]</label>
        </div>
        <div class="text-muted">
            @L["section.users"]: @(ugNode.Children.OfType<UserNode>().Count())
        </div>
    </div>
}
else if (Node is UserNode uNode)
{
    <div class="properties-panel">
        <h5>👤 @L["section.user"]</h5>
        <div class="mb-3">
            <label class="form-label">@L["prop.username"]</label>
            <input type="text" class="form-control" @bind="uNode.Name" @bind:after="OnChanged" @onfocus="() => CaptureForUndo(uNode, nameof(uNode.Name))" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.group"]</label>
            <input type="text" class="form-control" value="@uNode.User.Group" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["prop.password"]</label>
            @if (!string.IsNullOrEmpty(uNode.User.PasswordHash))
            {
                <div>
                    <span class="badge bg-success">🔐 @L["prop.pwEncrypted"]</span>
                    <small class="text-muted ms-2">@L["prop.pwResetHint"]</small>
                </div>
            }
            else
            {
                <span class="text-warning small">⚠ @L["prop.pwNotSet"]</span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private UndoRedoService UndoRedo { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private EditorLocalizationService L { get; set; } = default!;

    private bool _showDriverJson;

    protected override void OnInitialized()
    {
        L.LocaleChanged += OnLocaleChanged;
    }

    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.LocaleChanged -= OnLocaleChanged;
    }

    // Snapshot for undo: captured before a @bind writes its new value
    private object? _pendingTarget;
    private System.Reflection.PropertyInfo? _pendingProp;
    private object? _pendingOldValue;

    /// <summary>Call this BEFORE @bind writes: e.g. @onfocus or @bind:before</summary>
    private void CaptureForUndo(object target, string propertyName)
    {
        _pendingTarget = target;
        _pendingProp = target.GetType().GetProperty(propertyName);
        _pendingOldValue = _pendingProp?.GetValue(target);
    }

    private async Task OnChanged()
    {
        FlushUndo();
        await OnPropertyChanged.InvokeAsync();
    }

    private async Task AddSchedulerCommand(SchedulerNode node, bool deactivate)
    {
        var cmd = new SharedModels.SymbolCommand
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Action = "SetVariable"
        };
        if (deactivate)
            node.Scheduler.DeactivateCommands.Add(cmd);
        else
            node.Scheduler.Commands.Add(cmd);
        await OnChanged();
    }
    private void FlushUndo()
    {
        if (_pendingTarget != null && _pendingProp != null)
        {
            var newValue = _pendingProp.GetValue(_pendingTarget);
            UndoRedo.RecordPropertyChange(_pendingTarget, _pendingProp, _pendingOldValue, newValue);
            _pendingTarget = null;
            _pendingProp = null;
            _pendingOldValue = null;
        }
    }

    private async Task OnDriverJsonChanged()
    {
        // The JSON editor was changed manually — trigger re-render of the visual editor
        await OnPropertyChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnLanguageChanged()
    {
        await OnPropertyChanged.InvokeAsync();
    }

    private async Task OnPlcLanguageChanged()
    {
        await OnPropertyChanged.InvokeAsync();
    }

    private static string GetPlcLanguageLabel(string language) => language?.ToUpperInvariant() switch
    {
        "IL" => "Instruction List",
        "LD" => "Ladder Diagram",
        _ => "Structured Text"
    };

    private void AddRecipeVariable(RecipeNode node)
    {
        var nextIndex = node.Recipe.Variables.Count > 0
            ? node.Recipe.Variables.Max(v => v.Index) + 1
            : 0;
        node.Recipe.Variables.Add(new RecipeVariable { Index = nextIndex, VariablePath = "", DisplayName = "" });
        OnChanged();
    }

    private void RemoveRecipeVariable(RecipeNode node, int listIndex)
    {
        if (listIndex >= 0 && listIndex < node.Recipe.Variables.Count)
        {
            node.Recipe.Variables.RemoveAt(listIndex);
            OnChanged();
        }
    }

