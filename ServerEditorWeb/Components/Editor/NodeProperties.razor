@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private UndoRedoService UndoRedo { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private EditorLocalizationService L { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private bool _showDriverJson;

    // CSV export / import
    private string _csvMessage = "";
    private bool _csvSuccess;

    private async Task ExportVariablesCsv(FolderNode folder)
    {
        var lines = new System.Text.StringBuilder();
        lines.AppendLine("Name,Type,Access,InitialValue,Retentive,EngineeringUnit");
        foreach (var vn in GetAllVariableNodes(folder))
        {
            var v = vn.Variable;
            lines.AppendLine($"{CsvEscape(vn.Name)},{CsvEscape(v.Type)},{CsvEscape(v.Access)},{CsvEscape(v.InitialValue ?? "")},{v.Retentive},{CsvEscape(v.EngineeringUnit ?? "")}");
        }
        await JSRuntime.InvokeVoidAsync("dockManager.downloadText",
            $"{folder.Name}_variables.csv", "text/csv", lines.ToString());
    }

    private async Task ImportVariablesCsv(FolderNode folder, Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _csvMessage = "";
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            int added = 0, updated = 0;
            foreach (var line in lines.Skip(1)) // skip header
            {
                var cols = SplitCsvLine(line);
                if (cols.Length < 2) continue;
                var name = cols[0].Trim();
                if (string.IsNullOrEmpty(name)) continue;
                var type = cols.Length > 1 ? cols[1].Trim() : "Double";
                var access = cols.Length > 2 ? cols[2].Trim() : "ReadWrite";
                var initialValue = cols.Length > 3 ? cols[3].Trim() : "";
                var retentive = cols.Length > 4 && cols[4].Trim().Equals("true", StringComparison.OrdinalIgnoreCase);
                var engineeringUnit = cols.Length > 5 ? cols[5].Trim() : "";

                var existing = folder.Children.OfType<VariableNode>().FirstOrDefault(v => v.Name == name);
                if (existing != null)
                {
                    existing.Variable.Type = type;
                    existing.Variable.Access = access;
                    existing.Variable.InitialValue = string.IsNullOrEmpty(initialValue) ? "" : initialValue;
                    existing.Variable.Retentive = retentive;
                    existing.Variable.EngineeringUnit = engineeringUnit;
                    updated++;
                }
                else
                {
                    var variable = new Variable { Name = name, Type = type, Access = access, InitialValue = string.IsNullOrEmpty(initialValue) ? "" : initialValue, Retentive = retentive, EngineeringUnit = engineeringUnit };
                    var node = new VariableNode(variable) { Parent = folder };
                    folder.Children.Add(node);
                    added++;
                }
            }
            Editor.MarkChanged();
            OnPropertyChanged.InvokeAsync();
            _csvSuccess = true;
            _csvMessage = $"Imported: {added} added, {updated} updated.";
        }
        catch (Exception ex)
        {
            _csvSuccess = false;
            _csvMessage = $"Import failed: {ex.Message}";
        }
    }

    private static IEnumerable<VariableNode> GetAllVariableNodes(TreeNode node)
    {
        foreach (var child in node.Children)
        {
            if (child is VariableNode vn) yield return vn;
            else foreach (var d in GetAllVariableNodes(child)) yield return d;
        }
    }

    private static string CsvEscape(string v)
    {
        if (v.Contains(',') || v.Contains('"') || v.Contains('\n'))
            return '"' + v.Replace("\"", "\"\"") + '"';
        return v;
    }

    private static string[] SplitCsvLine(string line)
    {
        var result = new List<string>();
        var sb = new System.Text.StringBuilder();
        bool inQuotes = false;
        for (int i = 0; i < line.Length; i++)
        {
            var c = line[i];
            if (c == '"') { inQuotes = !inQuotes; continue; }
            if (c == ',' && !inQuotes) { result.Add(sb.ToString()); sb.Clear(); continue; }
            sb.Append(c);
        }
        result.Add(sb.ToString());
        return result.ToArray();
    }

    // Password reset fields
    private string _resetPassword = "";
    private string _resetPasswordMessage = "";
    private bool _resetPasswordSuccess;

    // External auth provider add
    private string _newExternalProvider = "";

    // PID auto-tune wizard
    private double _pidKu;
    private double _pidPu;
    private double _pidAmplitude;
    private string _pidResultMessage = "";
    private bool _pidResultSuccess;

    // Database connection test
    private bool _dbTesting;
    private string _dbTestMessage = "";
    private bool _dbTestSuccess;

    protected override void OnInitialized()
    {
        L.LocaleChanged += OnLocaleChanged;
        Editor.ReportSectionSelectionChanged += OnReportSectionChanged;
    }

    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);
    private void OnReportSectionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.LocaleChanged -= OnLocaleChanged;
        Editor.ReportSectionSelectionChanged -= OnReportSectionChanged;
    }

    // Snapshot for undo: captured before a @bind writes its new value
    private object? _pendingTarget;
    private System.Reflection.PropertyInfo? _pendingProp;
    private object? _pendingOldValue;

    /// <summary>Call this BEFORE @bind writes: e.g. @onfocus or @bind:before</summary>
    private void CaptureForUndo(object target, string propertyName)
    {
        _pendingTarget = target;
        _pendingProp = target.GetType().GetProperty(propertyName);
        _pendingOldValue = _pendingProp?.GetValue(target);
    }

    private async Task OnChanged()
    {
        FlushUndo();
        await OnPropertyChanged.InvokeAsync();
    }

    private static string GetReportSectionIcon(string type) => type switch
    {
        "Header" => "📝",
        "Text" => "📃",
        "Chart" => "📊",
        "Table" => "📋",
        "Value" => "🔢",
        "PageBreak" => "📄",
        _ => "❓"
    };

    private async Task AddSchedulerCommand(SchedulerNode node, bool deactivate)
    {
        var cmd = new SharedModels.SymbolCommand
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Action = "SetVariable"
        };
        if (deactivate)
            node.Scheduler.DeactivateCommands.Add(cmd);
        else
            node.Scheduler.Commands.Add(cmd);
        await OnChanged();
    }
    private async Task AddEventCommand(EventNode node, bool clear)
    {
        var cmd = new SharedModels.SymbolCommand
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Action = "SetVariable"
        };
        if (clear)
            node.Event.ClearCommands.Add(cmd);
        else
            node.Event.Commands.Add(cmd);
        await OnChanged();
    }
    private void FlushUndo()
    {
        if (_pendingTarget != null && _pendingProp != null)
        {
            var newValue = _pendingProp.GetValue(_pendingTarget);
            UndoRedo.RecordPropertyChange(_pendingTarget, _pendingProp, _pendingOldValue, newValue);
            _pendingTarget = null;
            _pendingProp = null;
            _pendingOldValue = null;
        }
    }

    private async Task OnDriverJsonChanged()
    {
        // The JSON editor was changed manually — trigger re-render of the visual editor
        await OnPropertyChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnLanguageChanged()
    {
        await OnPropertyChanged.InvokeAsync();
    }

    private async Task OnPlcLanguageChanged()
    {
        await OnPropertyChanged.InvokeAsync();
    }

    private static string GetPlcLanguageLabel(string language) => language?.ToUpperInvariant() switch
