    private void ComputePidGains(PlcProgramNode plcNode)
    {
        _pidResultMessage = "";
        _pidResultSuccess = false;

        var pidCfg = plcNode.PlcProgram.PidAutoTune;
        if (pidCfg == null) return;

        var result = PidAutoTuner.ComputeGains(_pidKu, _pidPu, _pidAmplitude, 0, pidCfg.PidType);
        if (result.Success)
        {
            pidCfg.LastKp = result.Kp;
            pidCfg.LastKi = result.Ki;
            pidCfg.LastKd = result.Kd;
            _pidResultMessage = $"Gains computed — Kp={result.Kp}, Ki={result.Ki}, Kd={result.Kd}";
            _pidResultSuccess = true;
            OnChanged();
        }
        else
        {
            _pidResultMessage = result.Message;
        }
    }

    private void GeneratePidCode(PlcProgramNode plcNode)
    {
        var pidCfg = plcNode.PlcProgram.PidAutoTune;
        if (pidCfg == null) return;

        var result = new PidAutoTuner.TuneResult
        {
            Kp = pidCfg.LastKp,
            Ki = pidCfg.LastKi,
            Kd = pidCfg.LastKd,
            UltimateGain = _pidKu,
            UltimatePeriod = _pidPu
        };

        var code = PidAutoTuner.GenerateStCode(result, pidCfg.PidType);

        // Replace placeholder paths with configured paths
        if (!string.IsNullOrEmpty(pidCfg.SetpointPath))
            code = code.Replace("Read('TODO_SETPOINT_PATH')", $"Read('{pidCfg.SetpointPath}')");
        else
            code = code.Replace("Read('TODO_SETPOINT_PATH')", pidCfg.Setpoint.ToString(System.Globalization.CultureInfo.InvariantCulture));

        if (!string.IsNullOrEmpty(pidCfg.ProcessVariablePath))
            code = code.Replace("Read('TODO_PV_PATH')", $"Read('{pidCfg.ProcessVariablePath}')");

        if (!string.IsNullOrEmpty(pidCfg.OutputPath))
            code = code.Replace("Write('TODO_OUTPUT_PATH'", $"Write('{pidCfg.OutputPath}'");

        code = code.Replace("OutMin : REAL := 0.0;", $"OutMin : REAL := {pidCfg.OutputMin.ToString(System.Globalization.CultureInfo.InvariantCulture)};");
        code = code.Replace("OutMax : REAL := 100.0;", $"OutMax : REAL := {pidCfg.OutputMax.ToString(System.Globalization.CultureInfo.InvariantCulture)};");

        plcNode.PlcProgram.Code = code;
        _pidResultMessage = "ST code generated and applied to the PLC program.";
        _pidResultSuccess = true;
        OnChanged();
    }

    private void ResetUserPassword(UserNode uNode)
    {
        _resetPasswordMessage = "";
        _resetPasswordSuccess = false;

        if (string.IsNullOrWhiteSpace(_resetPassword))
        {
            _resetPasswordMessage = "Password cannot be empty.";
            return;
        }

        var requireStrong = Editor.RootModel?.Server?.RequireStrongPassword ?? false;
        if (requireStrong)
        {
            var (valid, error) = SharedModels.PasswordValidator.Validate(_resetPassword, true);
            if (!valid)
            {
                _resetPasswordMessage = error!;
                return;
            }
        }

        uNode.User.PasswordHash = SharedModels.PasswordHasher.Hash(_resetPassword);
        uNode.User.Password = "";
        uNode.User.PasswordChangedDate = DateTime.UtcNow;
        _resetPassword = "";
        _resetPasswordMessage = "Password set successfully.";
        _resetPasswordSuccess = true;
        OnChanged();
    }

    private void ToggleScreenAllowedGroup(ScreenConfig screen, string groupName, bool isChecked)
    {
        if (isChecked)
        {
            if (!screen.AllowedGroups.Contains(groupName, StringComparer.OrdinalIgnoreCase))
                screen.AllowedGroups.Add(groupName);
        }
        else
        {
            screen.AllowedGroups.RemoveAll(g => g.Equals(groupName, StringComparison.OrdinalIgnoreCase));
        }
    }

