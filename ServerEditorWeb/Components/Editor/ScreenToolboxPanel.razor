                break;
            case "knob":
                builder.AddMarkupContent(10, "<circle cx=\"80\" cy=\"40\" r=\"26\" fill=\"#1e293b\" stroke=\"#475569\" stroke-width=\"3\"/><circle cx=\"80\" cy=\"40\" r=\"18\" fill=\"#334155\"/><line x1=\"80\" y1=\"40\" x2=\"80\" y2=\"24\" stroke=\"#3b82f6\" stroke-width=\"3\" stroke-linecap=\"round\" class=\"tbx-anim-spin-text\"/><text x=\"80\" y=\"74\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"8\">0 ---- 100</text>");
                break;
            case "hslider":
                builder.AddMarkupContent(10, "<rect x=\"15\" y=\"38\" width=\"130\" height=\"4\" rx=\"2\" fill=\"#334155\"/><rect x=\"15\" y=\"38\" width=\"80\" height=\"4\" rx=\"2\" fill=\"#3b82f6\" class=\"tbx-anim-fill\"/><circle cx=\"95\" cy=\"40\" r=\"8\" fill=\"#3b82f6\" stroke=\"#1e293b\" stroke-width=\"2\" class=\"tbx-anim-pulse\"/><text x=\"15\" y=\"58\" fill=\"#64748b\" font-size=\"8\">0</text><text x=\"145\" y=\"58\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"8\">100</text>");
                break;
            case "vslider":
                builder.AddMarkupContent(10, "<rect x=\"78\" y=\"5\" width=\"4\" height=\"70\" rx=\"2\" fill=\"#334155\"/><rect x=\"78\" y=\"30\" width=\"4\" height=\"45\" rx=\"2\" fill=\"#3b82f6\" class=\"tbx-anim-fill\"/><circle cx=\"80\" cy=\"30\" r=\"8\" fill=\"#3b82f6\" stroke=\"#1e293b\" stroke-width=\"2\" class=\"tbx-anim-pulse\"/><text x=\"68\" y=\"10\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"8\">100</text><text x=\"68\" y=\"78\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"8\">0</text>");
                break;
            case "animtext":
                builder.AddMarkupContent(10, "<rect x=\"15\" y=\"20\" width=\"130\" height=\"40\" rx=\"4\" fill=\"#1e293b\" stroke=\"#334155\" stroke-width=\"1\"/><text x=\"80\" y=\"46\" text-anchor=\"middle\" fill=\"#22d3ee\" font-size=\"14\" font-weight=\"bold\" class=\"tbx-anim-pulse\">RUNNING</text>");
                break;

            case "progressbar":
                builder.AddMarkupContent(10, "<rect x=\"15\" y=\"30\" width=\"130\" height=\"20\" rx=\"4\" fill=\"#1e293b\" stroke=\"#334155\" stroke-width=\"1\"/><rect x=\"17\" y=\"32\" width=\"82\" height=\"16\" rx=\"2\" fill=\"#3b82f6\" class=\"tbx-anim-fill\"/><text x=\"80\" y=\"44\" text-anchor=\"middle\" fill=\"#e2e8f0\" font-size=\"10\">65%</text>");
                break;
            case "numericdisplay":
                builder.AddMarkupContent(10, "<rect x=\"20\" y=\"18\" width=\"120\" height=\"44\" rx=\"6\" fill=\"#0f172a\" stroke=\"#334155\" stroke-width=\"1.5\"/><text x=\"80\" y=\"48\" text-anchor=\"middle\" fill=\"#22d3ee\" font-size=\"24\" font-family=\"monospace\" class=\"tbx-anim-pulse\">42.7</text><text x=\"130\" y=\"48\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"9\">C</text>");
                break;
            case "ledarray":
                builder.AddMarkupContent(10, "<circle cx=\"25\" cy=\"40\" r=\"8\" fill=\"#22c55e\" class=\"tbx-anim-pulse\"/><circle cx=\"50\" cy=\"40\" r=\"8\" fill=\"#ef4444\" opacity=\"0.3\"/><circle cx=\"75\" cy=\"40\" r=\"8\" fill=\"#22c55e\" class=\"tbx-anim-pulse\"/><circle cx=\"100\" cy=\"40\" r=\"8\" fill=\"#f59e0b\" class=\"tbx-anim-pulse\"/><circle cx=\"125\" cy=\"40\" r=\"8\" fill=\"#ef4444\" opacity=\"0.3\"/><text x=\"80\" y=\"65\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"8\">Bit 0-4</text>");
                break;
            case "conveyor":
                builder.AddMarkupContent(10, "<rect x=\"10\" y=\"30\" width=\"140\" height=\"20\" rx=\"3\" fill=\"#334155\"/><line x1=\"10\" y1=\"35\" x2=\"150\" y2=\"35\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"8 4\" class=\"tbx-anim-flow\"/><line x1=\"10\" y1=\"45\" x2=\"150\" y2=\"45\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"8 4\" class=\"tbx-anim-flow\"/><circle cx=\"20\" cy=\"40\" r=\"10\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2.5\"/><circle cx=\"140\" cy=\"40\" r=\"10\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2.5\"/><rect x=\"55\" y=\"18\" width=\"24\" height=\"12\" rx=\"2\" fill=\"#f59e0b\" opacity=\"0.8\"/><rect x=\"95\" y=\"18\" width=\"24\" height=\"12\" rx=\"2\" fill=\"#22d3ee\" opacity=\"0.8\"/>");
