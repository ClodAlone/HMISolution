                builder.AddMarkupContent(10, "<rect x='10' y='5' width='140' height='70' rx='6' fill='#0f172a' stroke='#334155' stroke-width='1'/><text x='80' y='17' text-anchor='middle' fill='#94a3b8' font-size='8'>OEE</text><path d='M 52 48 A 25 25 0 1 1 108 48' fill='none' stroke='#334155' stroke-width='5' stroke-linecap='round'/><path d='M 52 48 A 25 25 0 1 1 101 30' fill='none' stroke='#22c55e' stroke-width='5' stroke-linecap='round'/><text x='80' y='50' text-anchor='middle' fill='#22c55e' font-size='12' font-weight='bold'>72%</text><text x='80' y='60' text-anchor='middle' fill='#64748b' font-size='6'>Target: 85%</text><text x='50' y='72' text-anchor='middle' fill='#94a3b8' font-size='5'>A:90%</text><text x='80' y='72' text-anchor='middle' fill='#94a3b8' font-size='5'>P:85%</text><text x='110' y='72' text-anchor='middle' fill='#94a3b8' font-size='5'>Q:94%</text>");
                break;

            case "nlquery":
                builder.AddMarkupContent(10, "<rect x='10' y='5' width='140' height='70' rx='6' fill='#0f172a' stroke='#334155' stroke-width='1'/><text x='80' y='18' text-anchor='middle' fill='#e2e8f0' font-size='9' font-weight='bold'>🤖 NL Query</text><line x1='14' y1='24' x2='146' y2='24' stroke='#334155' stroke-width='1'/><rect x='16' y='30' width='90' height='12' rx='3' fill='#1e293b'/><text x='20' y='39' fill='#94a3b8' font-size='7'>What was max temp?</text><rect x='16' y='46' width='128' height='20' rx='3' fill='#1e40af' opacity='0.3'/><text x='20' y='58' fill='#60a5fa' font-size='7'>The max temperature was 87.3°C...</text>");
                break;

            default:
                builder.AddMarkupContent(10, $"<text x=\"80\" y=\"35\" text-anchor=\"middle\" fill=\"#94a3b8\" font-size=\"28\">{item.Icon}</text><text x=\"80\" y=\"60\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"10\">{item.Label}</text>");
                break;
        }
        if (!string.IsNullOrEmpty(item.Animation))
            builder.AddMarkupContent(90, $"<rect x=\"0\" y=\"0\" width=\"{w}\" height=\"{h}\" fill=\"none\" stroke=\"#22d3ee\" stroke-width=\"2\" stroke-dasharray=\"6 4\" rx=\"4\" class=\"tbx-anim-dash\"/>");
        builder.CloseElement();
    };

    private record ToolboxItem(string Type, string Icon, string Label, string Tooltip, string CssClass, string Animation = "");
    private record ToolboxCategory(string Name, string Icon, List<ToolboxItem> Items);

    private static readonly List<ToolboxCategory> _categories =
    [
        new("Shapes", "🔷",
        [
            new("rect",    "▭", "Rectangle", "Rectangle shape",    "item-shape"),
            new("circle",  "●", "Circle",    "Circle shape",       "item-shape"),
