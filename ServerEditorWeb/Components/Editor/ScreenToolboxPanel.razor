                break;

            case "flowmeter":
                builder.AddMarkupContent(10, "<rect x=\"55\" y=\"15\" width=\"50\" height=\"50\" rx=\"6\" fill=\"#1e293b\" stroke=\"#475569\" stroke-width=\"2\"/><line x1=\"10\" y1=\"40\" x2=\"55\" y2=\"40\" stroke=\"#3b82f6\" stroke-width=\"3\" stroke-dasharray=\"8 4\" class=\"tbx-anim-flow\"/><line x1=\"105\" y1=\"40\" x2=\"150\" y2=\"40\" stroke=\"#3b82f6\" stroke-width=\"3\" stroke-dasharray=\"8 4\" class=\"tbx-anim-flow\"/><text x=\"80\" y=\"38\" text-anchor=\"middle\" fill=\"#22d3ee\" font-size=\"12\" class=\"tbx-anim-pulse\">125</text><text x=\"80\" y=\"52\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"8\">m3/h</text>");
                break;
            case "setpointramp":
