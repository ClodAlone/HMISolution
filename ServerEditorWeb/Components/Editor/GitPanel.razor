@using ServerEditorWeb.Services
@inject IJSRuntime JS

<div class="git-panel">
    <h6>Git Integration</h6>

    @if (!_gitService.IsGitRepository())
    {
        <button class="btn btn-sm btn-outline-primary mb-2" @onclick="InitRepo" disabled="@_busy">Initialize Git Repository</button>
    }
    else if (!string.IsNullOrEmpty(_currentBranch))
    {
        <div class="mb-2 small"><strong>Branch:</strong> @_currentBranch &nbsp; <strong>Remote:</strong> @(string.IsNullOrEmpty(_remoteUrl) ? "(not set)" : _remoteUrl)</div>
    }

    <div class="mb-2">
        <label class="form-label">User Name</label>
        <input type="text" class="form-control form-control-sm" @bind="_userName" />
    </div>
    <div class="mb-2">
        <label class="form-label">User Email</label>
        <input type="email" class="form-control form-control-sm" @bind="_userEmail" />
    </div>
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="ConfigureUser"
            disabled="@(_busy || string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_userEmail))">
        Set Identity
    </button>

    <div class="mb-2">
        <label class="form-label">Remote URL</label>
        <input type="text" class="form-control form-control-sm" @bind="_remoteUrl" />
    </div>
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="SetRemote"
            disabled="@(_busy || string.IsNullOrWhiteSpace(_remoteUrl))">
        Set Remote Origin
    </button>

    <div class="mb-2">
        <label class="form-label">Commit Message</label>
        <input type="text" class="form-control form-control-sm" @bind="CommitMessage" />
    </div>
    <div class="d-flex gap-2 flex-wrap mb-2">
        <button class="btn btn-sm btn-primary" @onclick="CommitAndPush" disabled="@(_busy || !_gitService.IsGitRepository())">
            @if (_busy && _busyAction == "commitpush") { <span>⏳ Pushing…</span> } else { <span>Commit &amp; Push</span> }
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Pull" disabled="@(_busy || !_gitService.IsGitRepository())">
            @if (_busy && _busyAction == "pull") { <span>⏳ Pulling…</span> } else { <span>Pull</span> }
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="GetStatus" disabled="@(_busy || !_gitService.IsGitRepository())">
            @if (_busy && _busyAction == "status") { <span>⏳</span> } else { <span>Status</span> }
        </button>
    </div>

    @if (_busy)
    {
        <div class="small text-muted mb-2">⏳ @_busyLabel</div>
    }

    @if (!string.IsNullOrEmpty(_result))
    {
        <div class="mt-2 position-relative">
            <button class="btn btn-sm btn-outline-secondary position-absolute" style="top:4px;right:4px;padding:1px 6px;font-size:10px;z-index:1;"
                    @onclick="CopyResult" title="Copy to clipboard">
                @(_copied ? "✓ Copied" : "📋 Copy")
            </button>
            <pre class="p-2 bg-light border rounded small" style="user-select:text;-webkit-user-select:text;white-space:pre-wrap;word-break:break-all;max-height:300px;overflow:auto;">@_result</pre>
        </div>
    }

    @* ── Script / File Diff Viewer ── *@
    <hr class="my-3" />
    <h6>📜 File Diff</h6>
    <div class="mb-2">
        <label class="form-label small">File path (relative to repo root)</label>
        <input type="text" class="form-control form-control-sm" @bind="_diffFilePath" placeholder="e.g. scripts/MyScript.js" />
    </div>
    <button class="btn btn-sm btn-outline-secondary mb-2" @onclick="LoadCommitLog"
            disabled="@(_busy || !_gitService.IsGitRepository() || string.IsNullOrWhiteSpace(_diffFilePath))">
        📋 Load History
    </button>

    @if (_commitLog.Count > 0)
    {
        <div class="mb-2" style="max-height:160px;overflow-y:auto;">
            <table class="table table-sm table-hover" style="font-size:11px;">
                <thead><tr><th>Hash</th><th>Date</th><th>Author</th><th>Subject</th><th></th></tr></thead>
                <tbody>
                    @for (int i = 0; i < _commitLog.Count; i++)
                    {
                        var idx = i;
                        var c = _commitLog[i];
                        <tr class="@(_selectedCommitIdx == idx ? "table-primary" : "")" style="cursor:pointer;" @onclick="() => SelectCommit(idx)">
                            <td><code>@c.ShortHash</code></td>
                            <td>@c.Date.LocalDateTime.ToString("MM/dd HH:mm")</td>
                            <td>@c.Author</td>
                            <td>@c.Subject</td>
                            <td>
                                @if (idx + 1 < _commitLog.Count)
                                {
                                    <button class="btn btn-sm btn-outline-primary py-0 px-1" style="font-size:10px;"
                                            @onclick:stopPropagation
                                            @onclick="() => ShowDiff(idx)" title="Diff vs previous commit">
                                        ↔
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(_diffContent))
    {
        <div class="mt-1 position-relative">
            <span class="small fw-bold">Diff: @_diffLabel</span>
            <button class="btn btn-sm btn-outline-secondary position-absolute" style="top:0;right:0;padding:1px 6px;font-size:10px;"
                    @onclick="ClearDiff" title="Close">✕</button>
        </div>
        <pre class="border rounded p-1" style="font-size:11px;white-space:pre;overflow:auto;max-height:380px;line-height:1.3;">
            @foreach (var line in _diffLines)
            {
                <span class="@DiffLineClass(line)">@line
</span>
            }
        </pre>
    }
</div>

@code {
    [Parameter] public string NodesPath { get; set; } = "";
    [Parameter] public string CommitMessage { get; set; } = "Update nodes.json";

    [Inject] private GitService _gitService { get; set; } = default!;

    private string _userName = "";
    private string _userEmail = "";
    private string _remoteUrl = "";
    private string _result = "";

    // diff viewer
    private string _diffFilePath = "";
    private List<GitCommitInfo> _commitLog = new();
    private int _selectedCommitIdx = -1;
    private string _diffContent = "";
    private string _diffLabel = "";
    private string[] _diffLines = [];

    private static string DiffLineClass(string line) => line.Length > 0 ? line[0] switch
    {
        '+' => "text-success",
        '-' => "text-danger",
        '@' => "text-info fw-bold",
        _ => ""
    } : "";

    private async Task LoadCommitLog()
    {
        await RunBusy("log", "Loading history…", async () =>
        {
            _commitLog = await _gitService.GetLogAsync(_diffFilePath, 30);
            _selectedCommitIdx = -1;
            _diffContent = "";
            _diffLines = [];
        });
    }

    private void SelectCommit(int idx)
    {
        _selectedCommitIdx = idx;
    }

    private async Task ShowDiff(int idx)
    {
        if (idx + 1 >= _commitLog.Count) return;
        var newer = _commitLog[idx];
        var older = _commitLog[idx + 1];
        await RunBusy("diff", "Loading diff…", async () =>
        {
            _diffContent = await _gitService.GetFileDiffAsync(_diffFilePath, older.Hash, newer.Hash);
            _diffLabel = $"{older.ShortHash} → {newer.ShortHash} ({newer.Date.LocalDateTime:MM/dd HH:mm})";
            _diffLines = _diffContent.Split('\n');
        });
    }

    private void ClearDiff()
    {
        _diffContent = "";
        _diffLines = [];
    }

    private string _currentBranch = "";
    private bool _configLoaded;
    private bool _copied;
    private bool _busy;
    private string _busyAction = "";
    private string _busyLabel = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(NodesPath))
        {
            var dir = Path.GetDirectoryName(Path.GetFullPath(NodesPath));
            if (dir != null)
                _gitService.SetWorkingDirectory(dir);
        }

        if (_gitService.IsGitRepository() && !_configLoaded)
        {
            _configLoaded = true;
            _userName = await _gitService.GetConfigValueAsync("user.name");
            _userEmail = await _gitService.GetConfigValueAsync("user.email");
            _remoteUrl = await _gitService.GetRemoteUrlAsync();
            _currentBranch = await _gitService.GetCurrentBranchAsync();
        }
    }

    private async Task InitRepo()
    {
        await RunBusy("init", "Initializing repository…", async () =>
        {
            _result = await _gitService.InitRepoAsync();
        });
    }

    private async Task ConfigureUser()
    {
        await RunBusy("identity", "Setting user identity…", async () =>
        {
            _result = await _gitService.SetUserIdentityAsync(_userName, _userEmail);
        });
    }

    private async Task SetRemote()
    {
        await RunBusy("remote", "Setting remote origin…", async () =>
        {
            _result = await _gitService.SetRemoteOriginAsync(_remoteUrl);
        });
    }

    private async Task CommitAndPush()
    {
        if (string.IsNullOrEmpty(NodesPath)) return;

        await RunBusy("commitpush", "Committing changes…", async () =>
        {
            var fullPath = Path.GetFullPath(NodesPath);
            var repoRoot = _gitService.WorkingDirectory;
            var relativePath = string.IsNullOrEmpty(repoRoot)
                ? Path.GetFileName(NodesPath)
                : Path.GetRelativePath(repoRoot, fullPath).Replace('\\', '/');

            var msg = string.IsNullOrWhiteSpace(CommitMessage) ? "Update nodes.json" : CommitMessage;
            _result = await _gitService.CommitChangesAsync(relativePath, msg);

            var isError = _result.StartsWith("Error", StringComparison.OrdinalIgnoreCase)
                       || _result.StartsWith("Git execution failed", StringComparison.OrdinalIgnoreCase);
            if (!isError)
            {
                _busyLabel = "Pushing to remote…";
                StateHasChanged();
                var pushResult = await _gitService.PushAsync();
                _result += "\n" + pushResult;
            }
        });
    }

    private async Task Pull()
    {
        await RunBusy("pull", "Pulling from remote…", async () =>
        {
            _result = await _gitService.PullAsync();
        });
    }

    private async Task GetStatus()
    {
        await RunBusy("status", "Fetching status…", async () =>
        {
            _result = await _gitService.GetStatusAsync();
        });
    }

    private async Task RunBusy(string action, string label, Func<Task> work)
    {
        _busy = true;
        _busyAction = action;
        _busyLabel = label;
        _result = "";
        StateHasChanged();
        await Task.Yield(); // let the UI update before the blocking work

        try
        {
            await work();
        }
        finally
        {
            _busy = false;
            _busyAction = "";
            _busyLabel = "";
        }
    }

    private async Task CopyResult()
    {
        if (string.IsNullOrEmpty(_result)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _result);
            _copied = true;
            StateHasChanged();
            _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() => { _copied = false; StateHasChanged(); }));
        }
        catch { /* clipboard API not available */ }
    }
}
