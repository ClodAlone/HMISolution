@using ServerEditorWeb.Services
@inject IJSRuntime JS

<div class="git-panel">
    <h6>Git Integration</h6>

    @if (!_gitService.IsGitRepository())
    {
        <button class="btn btn-sm btn-outline-primary mb-2" @onclick="InitRepo">Initialize Git Repository</button>
    }

    <div class="mb-2">
        <label class="form-label">User Name</label>
        <input type="text" class="form-control form-control-sm" @bind="_userName" />
    </div>
    <div class="mb-2">
        <label class="form-label">User Email</label>
        <input type="email" class="form-control form-control-sm" @bind="_userEmail" />
    </div>
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="ConfigureUser"
            disabled="@(string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_userEmail))">
        Set Identity
    </button>

    <div class="mb-2">
        <label class="form-label">Remote URL</label>
        <input type="text" class="form-control form-control-sm" @bind="_remoteUrl" />
    </div>
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="SetRemote"
            disabled="@string.IsNullOrWhiteSpace(_remoteUrl)">
        Set Remote Origin
    </button>

    <div class="mb-2">
        <label class="form-label">Commit Message</label>
        <input type="text" class="form-control form-control-sm" @bind="CommitMessage" />
    </div>
    <div class="d-flex gap-2 flex-wrap mb-2">
        <button class="btn btn-sm btn-primary" @onclick="CommitAndPush" disabled="@(!_gitService.IsGitRepository())">Commit & Push</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Pull" disabled="@(!_gitService.IsGitRepository())">Pull</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="GetStatus" disabled="@(!_gitService.IsGitRepository())">Status</button>
    </div>

    @if (!string.IsNullOrEmpty(_result))
    {
        <div class="mt-2 position-relative">
            <button class="btn btn-sm btn-outline-secondary position-absolute" style="top:4px;right:4px;padding:1px 6px;font-size:10px;z-index:1;"
                    @onclick="CopyResult" title="Copy to clipboard">
                @(_copied ? "✓ Copied" : "📋 Copy")
            </button>
            <pre class="p-2 bg-light border rounded small" style="user-select:text;-webkit-user-select:text;white-space:pre-wrap;word-break:break-all;max-height:300px;overflow:auto;">@_result</pre>
        </div>
    }
</div>

@code {
    [Parameter] public string NodesPath { get; set; } = "";
    [Parameter] public string CommitMessage { get; set; } = "Update nodes.json";

    [Inject] private GitService _gitService { get; set; } = default!;

    private string _userName = "";
    private string _userEmail = "";
    private string _remoteUrl = "";
    private string _result = "";
    private bool _configLoaded;
    private bool _copied;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(NodesPath))
        {
            var dir = Path.GetDirectoryName(Path.GetFullPath(NodesPath));
            if (dir != null)
                _gitService.SetWorkingDirectory(dir);
        }

        if (_gitService.IsGitRepository() && !_configLoaded)
        {
            _configLoaded = true;
            _userName = await _gitService.GetConfigValueAsync("user.name");
            _userEmail = await _gitService.GetConfigValueAsync("user.email");
            _remoteUrl = await _gitService.GetRemoteUrlAsync();
        }
    }

    private async Task InitRepo()
    {
        _result = await _gitService.InitRepoAsync();
    }

    private async Task ConfigureUser()
    {
        _result = await _gitService.SetUserIdentityAsync(_userName, _userEmail);
    }

    private async Task SetRemote()
    {
        _result = await _gitService.SetRemoteOriginAsync(_remoteUrl);
    }

    private async Task CommitAndPush()
    {
        if (string.IsNullOrEmpty(NodesPath)) return;

        // Build a path relative to the git repo root so `git add` finds the file.
        var fullPath = Path.GetFullPath(NodesPath);
        var repoRoot = _gitService.WorkingDirectory;
        var relativePath = string.IsNullOrEmpty(repoRoot)
            ? Path.GetFileName(NodesPath)
            : Path.GetRelativePath(repoRoot, fullPath).Replace('\\', '/');

        var msg = string.IsNullOrWhiteSpace(CommitMessage) ? "Update nodes.json" : CommitMessage;
        _result = await _gitService.CommitChangesAsync(relativePath, msg);

        var isError = _result.StartsWith("Error", StringComparison.OrdinalIgnoreCase)
                   || _result.StartsWith("Git execution failed", StringComparison.OrdinalIgnoreCase);
        if (!isError)
        {
            var pushResult = await _gitService.PushAsync();
            _result += "\n" + pushResult;
        }
    }

    private async Task Pull()
    {
        _result = await _gitService.PullAsync();
    }

    private async Task GetStatus()
    {
        _result = await _gitService.GetStatusAsync();
    }

    private async Task CopyResult()
    {
        if (string.IsNullOrEmpty(_result)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _result);
            _copied = true;
            StateHasChanged();
            _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() => { _copied = false; StateHasChanged(); }));
        }
        catch { /* clipboard API not available */ }
    }
}
