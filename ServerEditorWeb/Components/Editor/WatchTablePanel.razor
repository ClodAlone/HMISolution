        padding: 3px 8px;
        font-size: 11px;
        flex-shrink: 0;
        border-top: 1px solid var(--bs-border-color);
    }
    .watch-status-ok { color: #198754; background: #d1e7dd; }
    .watch-status-err { color: #842029; background: #f8d7da; }
</style>

@code {
    [Inject] private WatchTableService Watch { get; set; } = default!;
    [Inject] private CrossReferenceService XRef { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private ServerProcessService ServerProcess { get; set; } = default!;

    private string _addText = "";
    private bool _dropdownOpen;
    private List<string> _allPaths = new();
    private List<string> _filteredPaths = new();
    private const int MaxDropdownItems = 100;

    private string? _editingPath;
    private string _editValue = "";
    private string? _statusMessage;
    private bool _statusSuccess;
    private System.Timers.Timer? _statusTimer;

    protected override void OnInitialized()
    {
        Watch.StateChanged += OnWatchStateChanged;

        // Load saved watch lists for active project
        var projectName = Editor.ActiveProject?.Name ?? "default";
        Watch.LoadSavedLists(projectName);
    }

    private void OnWatchStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Public method for external callers (e.g. tree context menu "Add to Watch").
    /// </summary>
    public async Task AddVariableExternal(string variablePath)
    {
        await Watch.AddVariable(variablePath);
        if (!Watch.IsConnected && ServerProcess.IsServerRunning)
            await Connect();
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshAllPaths()
    {
        if (Editor.RootModel != null)
            _allPaths = XRef.GetAllVariablePaths(Editor.RootModel);
        else
            _allPaths = new();
    }

    private void FilterPaths()
    {
        if (_allPaths.Count == 0) RefreshAllPaths();

        if (string.IsNullOrEmpty(_addText))
            _filteredPaths = _allPaths.Take(MaxDropdownItems).ToList();
        else
            _filteredPaths = _allPaths
                .Where(p => p.Contains(_addText, StringComparison.OrdinalIgnoreCase))
                .Take(MaxDropdownItems)
                .ToList();
    }

    private void OnAddTextChanged()
    {
        FilterPaths();
        _dropdownOpen = _filteredPaths.Count > 0;
    }

    private void OnComboInputFocus()
    {
        FilterPaths();
        _dropdownOpen = _filteredPaths.Count > 0;
    }

    private void ToggleDropdown()
    {
        if (_dropdownOpen)
            _dropdownOpen = false;
        else
        {
            FilterPaths();
            _dropdownOpen = _filteredPaths.Count > 0;
        }
    }

    private void OnComboFocusOut() => _dropdownOpen = false;

    private async Task AddFromDropdown(string path)
    {
        _addText = "";
        _dropdownOpen = false;
        await Watch.AddVariable(path);
        if (!Watch.IsConnected && ServerProcess.IsServerRunning)
            await Connect();
    }

    private async Task OnAddKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _dropdownOpen = false;
            await AddVariable();
        }
        else if (e.Key == "Escape")
        {
            _dropdownOpen = false;
        }
    }

    private async Task AddVariable()
    {
        if (string.IsNullOrWhiteSpace(_addText)) return;
        var path = _addText.Trim();
        _addText = "";
        _dropdownOpen = false;
        await Watch.AddVariable(path);
        if (!Watch.IsConnected && ServerProcess.IsServerRunning)
            await Connect();
    }

    private async Task RemoveEntry(WatchEntry entry)
    {
        await Watch.RemoveVariable(entry.VariablePath);
    }

    private async Task ClearAll()
    {
        await Watch.RemoveAll();
    }

    private async Task Connect()
    {
        var endpoint = Editor.ServerEndpointUrl;
        if (string.IsNullOrEmpty(endpoint))
            endpoint = Editor.RootModel?.Server?.EndpointUrl ?? "opc.tcp://localhost:14840/SimpleOpcFileServer";
        await Watch.ConnectAsync(endpoint);
    }

    #region Inline Editing (Write)

    private void StartEdit(WatchEntry entry)
    {
        if (!entry.IsWritable) return;
        _editingPath = entry.VariablePath;
        _editValue = entry.Value;
    }

    private void CancelEdit()
    {
        _editingPath = null;
        _editValue = "";
    }

    private async Task OnEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, WatchEntry entry)
    {
        if (e.Key == "Enter") await CommitWrite(entry);
        else if (e.Key == "Escape") CancelEdit();
    }

    private async Task CommitWrite(WatchEntry entry)
    {
        var (success, msg) = await Watch.WriteValueAsync(entry, _editValue);
        _editingPath = null;
        ShowStatus(msg, success);
    }

    private void ShowStatus(string message, bool success)
    {
        _statusMessage = message;
        _statusSuccess = success;
        _statusTimer?.Dispose();
        _statusTimer = new System.Timers.Timer(3000) { AutoReset = false };
        _statusTimer.Elapsed += (_, _) => InvokeAsync(() => { _statusMessage = null; StateHasChanged(); });
        _statusTimer.Start();
    }

    #endregion

    #region Watch List Save/Load

    private async Task OnListSelected(ChangeEventArgs e)
    {
        var listName = e.Value?.ToString();
        if (string.IsNullOrEmpty(listName)) return;
        var projectName = Editor.ActiveProject?.Name ?? "default";
        await Watch.LoadList(projectName, listName);
    }

    private void SaveCurrentList()
    {
        var name = Watch.ActiveListName ?? "Watch List 1";
        var projectName = Editor.ActiveProject?.Name ?? "default";
        Watch.SaveList(projectName, name);
        ShowStatus($"Saved \"{name}\"", true);
    }

    private void DeleteCurrentList()
    {
        if (string.IsNullOrEmpty(Watch.ActiveListName)) return;
        var projectName = Editor.ActiveProject?.Name ?? "default";
        var name = Watch.ActiveListName;
        Watch.DeleteList(projectName, name);
        ShowStatus($"Deleted \"{name}\"", true);
    }

    #endregion

    private static string GetQualityBadge(string quality) => quality switch
    {
        "Good" => "bg-success",
        "Disconnected" or "" => "bg-secondary",
        _ when quality.StartsWith("Bad") => "bg-danger",
        _ when quality.StartsWith("Uncertain") => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string GetRowClass(WatchEntry entry)
    {
        if (!entry.IsConnected && !string.IsNullOrEmpty(entry.Quality))
            return "watch-row-disconnected";
        return entry.Quality switch
        {
            "Good" => "watch-row-good",
            _ when entry.Quality.StartsWith("Bad") => "watch-row-bad",
            _ when entry.Quality.StartsWith("Uncertain") => "watch-row-uncertain",
            _ => ""
        };
    }

    public void Dispose()
    {
        Watch.StateChanged -= OnWatchStateChanged;
        _statusTimer?.Dispose();
    }
}
