        display: flex;
        gap: 2px;
        align-items: center;
    }
    .watch-edit-input {
        flex: 1;
        border: 1px solid #86b7fe;
        border-radius: 3px;
        font-size: 11px;
        padding: 1px 4px;
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        outline: none;
        min-width: 0;
    }
    .watch-edit-btn {
        border: none;
        border-radius: 3px;
        padding: 1px 6px;
        font-size: 12px;
        cursor: pointer;
        line-height: 1;
    }
    .watch-edit-ok { background: #d1e7dd; color: #0f5132; }
    .watch-edit-ok:hover { background: #badbcc; }
