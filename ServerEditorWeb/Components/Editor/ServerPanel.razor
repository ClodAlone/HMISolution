@using ServerEditorWeb.Services
@using System.Runtime.InteropServices
@using System.ServiceProcess
@using SharedModels
@inject IJSRuntime JS
@implements IDisposable

<div class="server-panel">
    <h6>Server Process</h6>
    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-sm btn-success" @onclick="StartServer" disabled="@(ServerProcess.IsServerRunning || string.IsNullOrEmpty(NodesPath))">▶ Start</button>
        <button class="btn btn-sm btn-danger" @onclick="StopServer" disabled="@(!ServerProcess.IsServerRunning)">⏹ Stop</button>
        <span class="badge @(ServerProcess.IsServerRunning ? "bg-success" : "bg-secondary") align-self-center">
            @(ServerProcess.IsServerRunning ? "Running" : "Stopped")
        </span>
        @if (ServerProcess.IsExternalProcess)
        {
            <span class="badge bg-info align-self-center" style="font-size: 9px;" title="This server was started outside the editor (e.g. console, service). The editor can still stop it.">⚡ external</span>
        }
    </div>

    <div class="mb-3">
        <label class="form-label small text-muted mb-1">OPC UA Endpoint</label>
        <div class="input-group input-group-sm">
            <span class="input-group-text" style="font-size: 10px;">🔗</span>
            <input type="text" class="form-control form-control-sm font-monospace"
                   style="font-size: 11px;"
                   value="@Editor.ServerEndpointUrl"
                   @onchange="OnEndpointChanged" />
        </div>
    </div>

    @if (ServerProcessService.IsDocker)
    {
        <h6>🐳 Docker Service Instances</h6>
        <div class="mb-2 small text-muted" style="font-size: 10px;">
            Manage HMI Server and RuntimeViewer instances. Configuration is saved to
            <code>/data/.hmi-services.json</code> and persists across container restarts.
        </div>

        @* Quick Start for current project *@
        @if (!string.IsNullOrEmpty(NodesPath))
        {
            <div class="d-flex gap-2 mb-2 align-items-center flex-wrap">
                <button class="btn btn-sm btn-success" style="font-size: 10px;"
                        @onclick="DockerQuickStartServer"
                        disabled="@DockerIsServerRunningForCurrent">
                    ▶ Start Server
                </button>
                <button class="btn btn-sm btn-primary" style="font-size: 10px;"
                        @onclick="DockerQuickStartViewer"
                        disabled="@DockerIsViewerRunningForCurrent">
                    ▶ Start Viewer (port @_dockerNewPort)
                </button>
                @if (DockerIsServerRunningForCurrent || DockerIsViewerRunningForCurrent)
                {
                    <button class="btn btn-sm btn-danger" style="font-size: 10px;"
                            @onclick="DockerStopCurrentProject">
                        ⏹ Stop All
                    </button>
                }
                <span class="text-muted small" style="font-size: 10px;">
                    Project: <strong>@(Path.GetFileName(Path.GetDirectoryName(NodesPath)) ?? "current")</strong>
                </span>
            </div>
        }
        else
        {
            <div class="text-warning small mb-2" style="font-size: 10px;">
                ⚠ Open a project first to use quick-start buttons.
            </div>
        }

        @* Add New Instance (advanced) *@
        <details class="mb-2">
            <summary class="small text-muted" style="font-size: 10px; cursor: pointer;">➕ Add instance for a different project…</summary>
        <div class="mt-1 p-2 rounded" style="background: #1e293b; border: 1px solid #334155;">
            <div class="d-flex gap-2 align-items-end flex-wrap">
                <div>
                    <label class="form-label mb-0 small text-muted" style="font-size: 9px;">Project</label>
                    <select class="form-select form-select-sm" style="width: 220px; font-size: 10px;" @bind="_dockerNewProject">
                        <option value="">— select project —</option>
                        @foreach (var p in _dockerAvailableProjects)
                        {
                            var displayName = Path.GetFileName(Path.GetDirectoryName(p)) ?? p;
                            <option value="@p">@displayName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0 small text-muted" style="font-size: 9px;">Type</label>
                    <select class="form-select form-select-sm" style="width: 100px; font-size: 10px;" @bind="_dockerNewKind">
                        <option value="Server">Server</option>
                        <option value="Viewer">Viewer</option>
                    </select>
                </div>
                @if (_dockerNewKind == "Viewer")
                {
                    <div>
                        <label class="form-label mb-0 small text-muted" style="font-size: 9px;">Port</label>
                        <input type="number" class="form-control form-control-sm" style="width: 70px; font-size: 10px;"
                               @bind="_dockerNewPort" min="1" max="65535" />
                    </div>
                }
                <button class="btn btn-sm btn-success" style="font-size: 10px;"
                        @onclick="DockerAddInstance" disabled="@string.IsNullOrEmpty(_dockerNewProject)">
                    ➕ Start
                </button>
            </div>
        </div>
        </details>

        @* Instance List *@
        @if (DockerServices.Instances.Count > 0)
        {
            <table class="table table-sm table-borderless mb-1" style="font-size: 10px;">
                <thead>
                    <tr>
                        <th style="width: 55px;">Type</th>
                        <th>Project</th>
                        <th style="width: 50px;">Port</th>
                        <th style="width: 50px;">PID</th>
                        <th style="width: 55px;">Status</th>
                        <th style="width: 45px;">Auto</th>
                        <th style="width: 95px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in DockerServices.Instances)
                    {
                        <tr>
                            <td>@(inst.Kind == DockerServiceManager.InstanceKind.Server ? "🖥️ Srv" : "🖼️ Vwr")</td>
                            <td class="text-truncate" style="max-width: 150px;" title="@inst.ProjectPath">@inst.DisplayName</td>
                            <td>@(inst.Port > 0 ? inst.Port.ToString() : "—")</td>
                            <td class="font-monospace">@(inst.IsRunning ? inst.Pid.ToString() : "—")</td>
                            <td>
                                <span class="badge @(inst.IsRunning ? "bg-success" : "bg-secondary")" style="font-size: 8px;">
                                    @(inst.IsRunning ? "Running" : "Stopped")
                                </span>
                            </td>
                            <td>
                                <input type="checkbox" class="form-check-input" style="width: 14px; height: 14px;"
                                       checked="@inst.AutoStart"
                                       @onchange="e => DockerToggleAutoStart(inst.Id, (bool)(e.Value ?? false))"
                                       title="Auto-start on container boot" />
                            </td>
                            <td>
                                @if (inst.IsRunning)
                                {
                                    <button class="btn btn-sm btn-outline-danger" style="font-size: 9px; padding: 1px 5px;"
                                            @onclick="() => DockerStopInstance(inst.Id)">⏹ Stop</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success" style="font-size: 9px; padding: 1px 5px;"
                                            @onclick="() => DockerRestartInstance(inst)">▶ Start</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" style="font-size: 9px; padding: 1px 5px;"
                                        @onclick="() => DockerRemoveInstance(inst.Id)" title="Remove instance">🗑</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-muted small" style="font-size: 10px;">No instances configured. Use the controls above to start a server or viewer.</div>
        }

        @if (!string.IsNullOrEmpty(_dockerMessage))
        {
            <div class="mt-1 alert @(_dockerMessageSuccess ? "alert-success" : "alert-danger") alert-dismissible py-1 px-2" style="font-size: 10px;">
                @_dockerMessage
                <button type="button" class="btn-close" style="font-size: 8px;" @onclick="() => _dockerMessage = string.Empty"></button>
            </div>
        }
    }
    else if (ServerProcessService.IsWindows)
    {
        <h6>🪟 Windows Service</h6>
        <div class="mb-2">
            <span class="text-muted">Status: </span>
            <span class="badge @WinServiceStatusBadge">@WinServiceStatusText</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-success" @onclick="InstallWinService"
                    disabled="@(_isWinServiceInstalled || string.IsNullOrEmpty(NodesPath))">Install</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="UninstallWinService"
                    disabled="@(!_isWinServiceInstalled)">Uninstall</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="StartWinService"
                    disabled="@(!_isWinServiceInstalled || _winServiceStatus == ServiceControllerStatus.Running)">Start</button>
            <button class="btn btn-sm btn-outline-warning" @onclick="StopWinService"
                    disabled="@(!_isWinServiceInstalled || _winServiceStatus != ServiceControllerStatus.Running)">Stop</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshStatus">↻ Refresh</button>
        </div>
    }
    else if (ServerProcessService.IsLinux)
    {
        <h6>🐧 Linux systemd Service</h6>
        <div class="mb-2">
            <span class="text-muted">Status: </span>
            <span class="badge @LinuxServiceStatusBadge">@_linuxServiceStatus</span>
        </div>
        <div class="d-flex gap-2 flex-wrap mb-2">
            <button class="btn btn-sm btn-outline-success" @onclick="InstallLinuxService"
                    disabled="@(_isLinuxServiceInstalled || string.IsNullOrEmpty(NodesPath))">Install</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="UninstallLinuxService"
                    disabled="@(!_isLinuxServiceInstalled)">Uninstall</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="StartLinuxService"
                    disabled="@(!_isLinuxServiceInstalled || _linuxServiceStatus == "active")">Start</button>
            <button class="btn btn-sm btn-outline-warning" @onclick="StopLinuxService"
                    disabled="@(!_isLinuxServiceInstalled || _linuxServiceStatus != "active")">Stop</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshStatus">↻ Refresh</button>
        </div>

        @* Unit file preview / help *@
        <div class="mt-2">
            <button class="btn btn-sm btn-outline-info" @onclick="ToggleUnitPreview">
                @(_showUnitPreview ? "Hide" : "Show") Unit File
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ShowLogs" disabled="@(!_isLinuxServiceInstalled)">
                📋 View Logs
            </button>
        </div>

        @if (_showUnitPreview)
        {
            <div class="mt-2">
                <label class="form-label small fw-bold mb-1">systemd Unit File — @($"/etc/systemd/system/{ServerProcess.SystemdServiceName}.service")</label>
                <pre class="p-2 rounded" style="background: #1e293b; color: #e2e8f0; font-size: 11px; max-height: 200px; overflow-y: auto; white-space: pre-wrap;">@_unitFileContent</pre>
                <div class="text-muted" style="font-size: 10px;">
                    Manual install: <code>sudo cp unit-file /etc/systemd/system/@(ServerProcess.SystemdServiceName).service && sudo systemctl daemon-reload && sudo systemctl enable --now @(ServerProcess.SystemdServiceName)</code>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_linuxLogs))
        {
            <div class="mt-2">
                <label class="form-label small fw-bold mb-1">Recent Logs (journalctl)</label>
                <pre class="p-2 rounded" style="background: #0f172a; color: #94a3b8; font-size: 10px; max-height: 200px; overflow-y: auto; white-space: pre-wrap;">@_linuxLogs</pre>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="mt-2 alert @(_messageSuccess ? "alert-success" : "alert-danger") alert-dismissible">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = string.Empty"></button>
        </div>
    }

    @* ─── Server Output Log ───────────────────────────────── *@
    @if (ServerProcess.OutputLines.Count > 0 || ServerProcess.IsServerRunning)
    {
        <div class="mt-2">
            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="() => _showServerOutput = !_showServerOutput">
                @(_showServerOutput ? "▾" : "▸") 📋 Output
                <span class="badge bg-secondary" style="font-size: 9px;">@ServerProcess.OutputLines.Count</span>
                @if (ServerProcess.IsServerRunning && ServerProcess.OutputLines.Count > 0)
                {
                    <span class="badge bg-success" style="font-size: 8px;">live</span>
                }
            </button>
            @if (_showServerOutput)
            {
                <div class="mt-1 position-relative">
                    <div class="position-absolute d-flex gap-1" style="top: 4px; right: 4px; z-index: 1;">
                        <button class="btn btn-sm btn-outline-secondary" style="font-size: 9px; padding: 1px 5px;"
                                @onclick="() => CopyToClipboard(string.Join(Environment.NewLine, ServerProcess.OutputLines))" title="Copy output">📋</button>
                        <button class="btn btn-sm btn-outline-secondary" style="font-size: 9px; padding: 1px 5px;"
                                @onclick="() => ServerProcess.ClearOutput()" title="Clear output">🗑</button>
                    </div>
                    <pre data-server-output class="p-2 rounded mb-0" style="background: #0f172a; color: #e2e8f0; font-size: 10px; max-height: 250px; overflow-y: auto; white-space: pre-wrap; font-family: 'Cascadia Mono', 'Consolas', monospace;" @ref="_serverOutputEl">@string.Join("\n", ServerProcess.OutputLines)</pre>
                </div>
            }
        </div>
    }

    <hr class="my-3" />

    @* ─── RuntimeViewer Section ─────────────────────────────── *@
    <h6>🖥️ RuntimeViewer Process</h6>
    <div class="d-flex gap-2 mb-2 align-items-center flex-wrap">
        <div>
            <label class="form-label mb-0 small">Runtime</label>
            <select class="form-select form-select-sm" style="width: 120px; font-size: 11px;"
                    @bind="_rvMode">
                <option value="web">🌐 Web</option>
                <option value="desktop">🖥️ Desktop</option>
            </select>
        </div>
        @if (_rvMode == "web")
        {
            <div>
                <label class="form-label mb-0 small">Port</label>
                <input type="number" class="form-control form-control-sm" style="width: 80px; font-size: 11px;"
                       @bind="_rvPort" min="1" max="65535" />
            </div>
        }
        <div class="form-check align-self-end mb-1">
            <input type="checkbox" class="form-check-input" id="rvKiosk" @bind="_rvKiosk" />
            <label class="form-check-label small" for="rvKiosk">Kiosk</label>
        </div>
        <div class="align-self-end">
            <button class="btn btn-sm btn-success" @onclick="StartViewer" disabled="@(ViewerProcess.IsViewerRunning || string.IsNullOrEmpty(NodesPath))">▶ Start</button>
        </div>
        <div class="align-self-end">
            <button class="btn btn-sm btn-danger" @onclick="StopViewer" disabled="@(!ViewerProcess.IsViewerRunning)">⏹ Stop</button>
        </div>
        <span class="badge @(ViewerProcess.IsViewerRunning ? "bg-success" : "bg-secondary") align-self-end mb-1">
            @(ViewerProcess.IsViewerRunning ? "Running" : "Stopped")
        </span>
        @if (ViewerProcess.IsExternalProcess)
        {
            <span class="badge bg-info align-self-end mb-1" style="font-size: 9px;" title="This viewer was started outside the editor. The editor can still stop it.">⚡ external</span>
        }
        @if (ViewerProcess.IsViewerRunning && _rvMode == "web")
        {
            <button class="btn btn-sm btn-outline-primary align-self-end" @onclick="OpenViewer">🌐 Open</button>
        }
    </div>

    @if (ServerProcessService.IsDocker)
    {
        @* Docker viewer instances are managed in the combined Docker Service Instances section above *@
    }
    else if (ServerProcessService.IsWindows)
    {
        <h6>🪟 RuntimeViewer Windows Service</h6>
        <div class="mb-2">
            <span class="text-muted">Status: </span>
            <span class="badge @RvWinServiceStatusBadge">@RvWinServiceStatusText</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-success" @onclick="InstallRvWinService"
                    disabled="@(_isRvWinServiceInstalled || string.IsNullOrEmpty(NodesPath))">Install</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="UninstallRvWinService"
                    disabled="@(!_isRvWinServiceInstalled)">Uninstall</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="StartRvWinService"
                    disabled="@(!_isRvWinServiceInstalled || _rvWinServiceStatus == ServiceControllerStatus.Running)">Start</button>
            <button class="btn btn-sm btn-outline-warning" @onclick="StopRvWinService"
                    disabled="@(!_isRvWinServiceInstalled || _rvWinServiceStatus != ServiceControllerStatus.Running)">Stop</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshStatus">↻ Refresh</button>
        </div>
    }
    else if (ServerProcessService.IsLinux)
    {
        <h6>🐧 RuntimeViewer systemd Service</h6>
        <div class="mb-2">
            <span class="text-muted">Status: </span>
            <span class="badge @RvLinuxServiceStatusBadge">@_rvLinuxServiceStatus</span>
        </div>
        <div class="d-flex gap-2 flex-wrap mb-2">
            <button class="btn btn-sm btn-outline-success" @onclick="InstallRvLinuxService"
                    disabled="@(_isRvLinuxServiceInstalled || string.IsNullOrEmpty(NodesPath))">Install</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="UninstallRvLinuxService"
                    disabled="@(!_isRvLinuxServiceInstalled)">Uninstall</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="StartRvLinuxService"
                    disabled="@(!_isRvLinuxServiceInstalled || _rvLinuxServiceStatus == "active")">Start</button>
            <button class="btn btn-sm btn-outline-warning" @onclick="StopRvLinuxService"
                    disabled="@(!_isRvLinuxServiceInstalled || _rvLinuxServiceStatus != "active")">Stop</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshStatus">↻ Refresh</button>
        </div>

        <div class="mt-2">
            <button class="btn btn-sm btn-outline-info" @onclick="ToggleRvUnitPreview">
                @(_showRvUnitPreview ? "Hide" : "Show") Unit File
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ShowRvLogs" disabled="@(!_isRvLinuxServiceInstalled)">
                📋 View Logs
            </button>
        </div>

        @if (_showRvUnitPreview)
        {
            <div class="mt-2">
                <label class="form-label small fw-bold mb-1">systemd Unit File — @($"/etc/systemd/system/{ViewerProcess.SystemdServiceName}.service")</label>
                <pre class="p-2 rounded" style="background: #1e293b; color: #e2e8f0; font-size: 11px; max-height: 200px; overflow-y: auto; white-space: pre-wrap;">@_rvUnitFileContent</pre>
            </div>
        }

        @if (!string.IsNullOrEmpty(_rvLinuxLogs))
        {
            <div class="mt-2">
                <label class="form-label small fw-bold mb-1">Recent Logs (journalctl)</label>
                <pre class="p-2 rounded" style="background: #0f172a; color: #94a3b8; font-size: 10px; max-height: 200px; overflow-y: auto; white-space: pre-wrap;">@_rvLinuxLogs</pre>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_rvMessage))
    {
        <div class="mt-2 alert @(_rvMessageSuccess ? "alert-success" : "alert-danger") alert-dismissible">
            @_rvMessage
            <button type="button" class="btn-close" @onclick="() => _rvMessage = string.Empty"></button>
        </div>
    }

    @* ─── RuntimeViewer Output Log ────────────────────────── *@
    @if (ViewerProcess.OutputLines.Count > 0 || ViewerProcess.IsViewerRunning)
    {
        <div class="mt-2">
            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="() => _showViewerOutput = !_showViewerOutput">
                @(_showViewerOutput ? "▾" : "▸") 📋 Output
                <span class="badge bg-secondary" style="font-size: 9px;">@ViewerProcess.OutputLines.Count</span>
                @if (ViewerProcess.IsViewerRunning && ViewerProcess.OutputLines.Count > 0)
                {
                    <span class="badge bg-success" style="font-size: 8px;">live</span>
                }
            </button>
            @if (_showViewerOutput)
            {
                <div class="mt-1 position-relative">
                    <div class="position-absolute d-flex gap-1" style="top: 4px; right: 4px; z-index: 1;">
                        <button class="btn btn-sm btn-outline-secondary" style="font-size: 9px; padding: 1px 5px;"
                                @onclick="() => CopyToClipboard(string.Join(Environment.NewLine, ViewerProcess.OutputLines))" title="Copy output">📋</button>
                        <button class="btn btn-sm btn-outline-secondary" style="font-size: 9px; padding: 1px 5px;"
                                @onclick="() => ViewerProcess.ClearOutput()" title="Clear output">🗑</button>
                    </div>
                    <pre data-viewer-output class="p-2 rounded mb-0" style="background: #0f172a; color: #e2e8f0; font-size: 10px; max-height: 250px; overflow-y: auto; white-space: pre-wrap; font-family: 'Cascadia Mono', 'Consolas', monospace;" @ref="_viewerOutputEl">@string.Join("\n", ViewerProcess.OutputLines)</pre>
                </div>
            }
        </div>
    }

    <hr class="my-3" />

    @* ─── Performance Dashboard ──────────────────────────────── *@
    <h6>📊 Process Performance</h6>

    @* Server Process Performance *@
    @if (_serverPerf != null)
    {
        <div class="perf-section mb-3">
            <div class="perf-header">🖥️ Server</div>
            <div class="perf-grid">
                <div class="perf-metric">
                    <span class="perf-label">CPU</span>
                    <div class="perf-bar-wrap">
                        <div class="perf-bar" style="width: @Math.Min(_serverPerf.CpuPercent, 100)%; background: @CpuColor(_serverPerf.CpuPercent);"></div>
                    </div>
                    <span class="perf-value">@_serverPerf.CpuPercent%</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Memory</span>
                    <span class="perf-value">@_serverPerf.WorkingSetMB MB</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Private</span>
                    <span class="perf-value">@_serverPerf.PrivateMemoryMB MB</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Threads</span>
                    <span class="perf-value">@_serverPerf.ThreadCount</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Handles</span>
                    <span class="perf-value">@_serverPerf.HandleCount</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">CPU Time</span>
                    <span class="perf-value">@FormatCpuTime(_serverPerf.TotalProcessorTime)</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Uptime</span>
                    <span class="perf-value">@FormatUptime(_serverPerf.Uptime)</span>
                </div>
            </div>
        </div>
    }
    else if (ServerProcess.IsServerRunning)
    {
        <div class="text-muted small mb-2">⏳ Collecting server metrics…</div>
    }
    else
    {
        <div class="text-muted small mb-2">Server is stopped.</div>
    }

    @* RuntimeViewer Process Performance *@
    @if (_viewerPerf != null)
    {
        <div class="perf-section mb-3">
            <div class="perf-header">🖥️ RuntimeViewer</div>
            <div class="perf-grid">
                <div class="perf-metric">
                    <span class="perf-label">CPU</span>
                    <div class="perf-bar-wrap">
                        <div class="perf-bar" style="width: @Math.Min(_viewerPerf.CpuPercent, 100)%; background: @CpuColor(_viewerPerf.CpuPercent);"></div>
                    </div>
                    <span class="perf-value">@_viewerPerf.CpuPercent%</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Memory</span>
                    <span class="perf-value">@_viewerPerf.WorkingSetMB MB</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Private</span>
                    <span class="perf-value">@_viewerPerf.PrivateMemoryMB MB</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Threads</span>
                    <span class="perf-value">@_viewerPerf.ThreadCount</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Handles</span>
                    <span class="perf-value">@_viewerPerf.HandleCount</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">CPU Time</span>
                    <span class="perf-value">@FormatCpuTime(_viewerPerf.TotalProcessorTime)</span>
                </div>
                <div class="perf-metric">
                    <span class="perf-label">Uptime</span>
                    <span class="perf-value">@FormatUptime(_viewerPerf.Uptime)</span>
                </div>
            </div>
        </div>
    }
    else if (ViewerProcess.IsViewerRunning)
    {
        <div class="text-muted small mb-2">⏳ Collecting viewer metrics…</div>
    }
    else
    {
        <div class="text-muted small mb-2">RuntimeViewer is stopped.</div>
    }

    @* ─── Subsystem Performance (from Server diagnostics endpoint) ── *@
    @if (_serverDiag != null && _serverDiag.Subsystems.Count > 0)
    {
        var diag = _serverDiag;
        var subsystems = diag.Subsystems.ToList();
        var isLive = DiagClient.Latest != null;
        <h6 class="mt-2">⚡ Subsystem Performance
            <span class="text-muted" style="font-size: 9px;">
                @(isLive ? "(live from server)" : "(from project config)")
            </span>
        </h6>

        @if (subsystems.Any(s => !string.IsNullOrEmpty(s.LastError)))
        {
            <button class="btn btn-sm btn-outline-danger mb-1" style="font-size: 9px; padding: 1px 6px;" @onclick="CopyAllDiagErrors" title="Copy all error messages to clipboard">📋 Copy All Errors</button>
        }

        @if (!isLive && ServerProcess.IsServerRunning && _serverDiagError != null)
        {
            <div class="text-warning small mb-2" title="@_serverDiagError">
                ⚠ Waiting for OPC UA diagnostics…
            </div>
        }

        @foreach (var category in subsystems.GroupBy(s => s.Category).OrderBy(g => g.Key))
        {
            <div class="perf-subsystem-group mb-2">
                <div class="perf-subsystem-cat">@CategoryIcon(category.Key) @category.Key</div>
                <table class="table table-sm table-borderless mb-0" style="font-size: 10px;">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Name</th>
                            <th class="text-end" style="width: 60px;">Status</th>
                            <th class="text-end" style="width: 55px;">Cycles</th>
                            <th class="text-end" style="width: 70px;">Avg</th>
                            <th class="text-end" style="width: 70px;">Max</th>
                            <th class="text-end" style="width: 70px;">Last</th>
                            <th class="text-end" style="width: 70px;">Total</th>
                            <th style="min-width: 80px;">Load</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in category)
                        {
                            var loadPct = subsystems.Sum(s => s.TotalCpuMs) > 0
                                ? sub.TotalCpuMs / subsystems.Sum(s => s.TotalCpuMs) * 100
                                : 0;
                            <tr class="@(sub.Status == "Error" ? "table-danger" : "")">
                                <td class="text-truncate" style="max-width: 140px;" title="@sub.Name">@sub.Name</td>
                                <td class="text-end">
                                    <span class="badge @(sub.Status == "Running" ? "bg-success" : sub.Status == "Error" ? "bg-danger" : "bg-secondary")" style="font-size: 8px;">
                                        @sub.Status
                                    </span>
                                </td>
                                <td class="text-end font-monospace">@sub.CycleCount.ToString("N0")</td>
                                <td class="text-end font-monospace">@FormatCycleTime(sub.AvgCycleMs)</td>
                                <td class="text-end font-monospace">@FormatCycleTime(sub.MaxCycleMs)</td>
                                <td class="text-end font-monospace">@FormatCycleTime(sub.LastCycleMs)</td>
                                <td class="text-end font-monospace">@FormatCycleTime(sub.TotalCpuMs)</td>
                                <td>
                                    <div class="perf-bar-wrap" style="height: 8px;">
                                        <div class="perf-bar" style="width: @Math.Min(loadPct, 100).ToString("F0")%; background: @CpuColor(loadPct);"></div>
                                    </div>
                                    <span style="font-size: 8px; font-family: monospace;">@loadPct.ToString("F1")%</span>
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(sub.LastError))
                            {
                                <tr>
                                    <td colspan="8" class="text-danger" style="font-size: 9px; padding-top: 0; user-select: text;">
                                        ⚠ @sub.LastError
                                        <button class="btn btn-link btn-sm p-0 ms-1 text-danger" style="font-size: 9px; vertical-align: baseline;"
                                                title="Copy error to clipboard"
                                                @onclick="() => CopyToClipboard(sub.LastError)">📋</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (ServerProcess.IsServerRunning && _serverDiagError != null)
    {
        <div class="text-warning small mt-2" title="@_serverDiagError">
            ⚠ Waiting for OPC UA diagnostics connection…
        </div>
    }
    else if (_serverDiagError != null && !ServerProcess.IsServerRunning)
    {
        <div class="text-muted small mt-2" title="@_serverDiagError">
            ℹ Start the server to see live subsystem metrics
        </div>
    }

    @* ─── Project Subsystem Breakdown ────────────────────────── *@
    @if (_subsystems.Count > 0)
    {
        <h6 class="mt-2">🔧 Project Subsystems</h6>
        <table class="table table-sm table-borderless" style="font-size: 11px;">
            <thead>
                <tr><th>Subsystem</th><th class="text-end">Count</th><th>Items</th></tr>
            </thead>
            <tbody>
                @foreach (var sub in _subsystems)
                {
                    <tr>
                        <td>@sub.Icon @sub.Name</td>
                        <td class="text-end fw-bold">@sub.Count</td>
                        <td class="text-muted" style="font-size: 10px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @sub.Details
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @* ─── License Status ─────────────────────────────────────── *@
    @{
        var lic = LicenseManager.Current;
    }
    <h6 class="mt-2">🔑 License</h6>
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge @(lic.IsValid ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">@lic.Tier</span>
        @if (!string.IsNullOrEmpty(lic.LicensedTo))
        {
            <span class="text-muted small">@lic.LicensedTo</span>
        }
    </div>
    <div class="small text-muted mb-1" style="font-size: 10px;">@lic.Message</div>
    @if (lic.License != null)
    {
        <table class="table table-sm table-borderless mb-1" style="font-size: 10px;">
            <tbody>
                <tr><td class="text-muted" style="width: 90px;">Variables</td><td>@FormatLimit(lic.License.MaxVariables)</td></tr>
                <tr><td class="text-muted">Drivers</td><td>@FormatLimit(lic.License.MaxDrivers)</td></tr>
                <tr><td class="text-muted">Scripts</td><td>@FormatLimit(lic.License.MaxScripts)</td></tr>
                <tr><td class="text-muted">PLC Programs</td><td>@FormatLimit(lic.License.MaxPlcPrograms)</td></tr>
                <tr><td class="text-muted">Screens</td><td>@FormatLimit(lic.License.MaxScreens)</td></tr>
                <tr><td class="text-muted">Recipes</td><td>@FormatLimit(lic.License.MaxRecipes)</td></tr>
                <tr><td class="text-muted">Data Logging</td><td>@(lic.License.AllowDataLogging ? "✅" : "❌")</td></tr>
                <tr><td class="text-muted">AI Assistant</td><td>@(lic.License.AllowAi ? "✅" : "❌")</td></tr>
                @if (lic.ExpiresUtc < DateTime.MaxValue && lic.ExpiresUtc > DateTime.MinValue)
                {
                    <tr><td class="text-muted">Expires</td><td>@lic.ExpiresUtc.ToString("yyyy-MM-dd") (@lic.DaysRemaining days)</td></tr>
                }
                else if (lic.IsValid)
                {
                    <tr><td class="text-muted">Expires</td><td>Never (perpetual)</td></tr>
                }
            </tbody>
        </table>
        <div class="text-muted" style="font-size: 9px; font-family: monospace;">
            Machine ID: @LicenseManager.GetMachineId()
        </div>
    }
</div>

@code {
    [Parameter] public string NodesPath { get; set; } = "";

    [Inject] private ServerProcessService ServerProcess { get; set; } = default!;
    [Inject] private RuntimeViewerProcessService ViewerProcess { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private ServerDiagnosticsClient DiagClient { get; set; } = default!;
    [Inject] private AuthService Auth { get; set; } = default!;
    [Inject] private DockerServiceManager DockerServices { get; set; } = default!;

    // Windows service state
    private bool _isWinServiceInstalled;
    private ServiceControllerStatus _winServiceStatus;

    // Linux systemd state
    private bool _isLinuxServiceInstalled;
    private string _linuxServiceStatus = "unknown";
    private bool _showUnitPreview;
    private string _unitFileContent = "";
    private string _linuxLogs = "";

    // Shared
    private string _message = "";
    private bool _messageSuccess;
    private Timer? _statusTimer;

    // RuntimeViewer settings
    private int _rvPort = 8081;
    private bool _rvKiosk;
    private string _rvMode = "web"; // "web" or "desktop"

    // RuntimeViewer Windows service state
    private bool _isRvWinServiceInstalled;
    private ServiceControllerStatus _rvWinServiceStatus;

    // RuntimeViewer Linux systemd state
    private bool _isRvLinuxServiceInstalled;
    private string _rvLinuxServiceStatus = "unknown";
    private bool _showRvUnitPreview;
    private string _rvUnitFileContent = "";
    private string _rvLinuxLogs = "";

    // RuntimeViewer messages
    private string _rvMessage = "";
    private bool _rvMessageSuccess;

    // Output log panels
    private bool _showServerOutput;
    private bool _showViewerOutput;
    private ElementReference _serverOutputEl;
    private ElementReference _viewerOutputEl;


    // --- Docker Service Management ---
    private string _dockerNewProject = "";
    private string _dockerNewKind = "Server";
    private int _dockerNewPort = 8081;
    private string _dockerMessage = "";
    private bool _dockerMessageSuccess;
    private List<string> _dockerAvailableProjects = new();

    private bool DockerIsServerRunningForCurrent =>
        !string.IsNullOrEmpty(NodesPath) &&
        DockerServices.Instances.Any(i =>
            i.Kind == DockerServiceManager.InstanceKind.Server &&
            i.IsRunning &&
            string.Equals(i.ProjectPath, Path.GetFullPath(NodesPath), StringComparison.OrdinalIgnoreCase));

    private bool DockerIsViewerRunningForCurrent =>
        !string.IsNullOrEmpty(NodesPath) &&
        DockerServices.Instances.Any(i =>
            i.Kind == DockerServiceManager.InstanceKind.Viewer &&
            i.IsRunning &&
            string.Equals(i.ProjectPath, Path.GetFullPath(NodesPath), StringComparison.OrdinalIgnoreCase));

    private void DockerQuickStartServer()
    {
        if (string.IsNullOrEmpty(NodesPath)) return;
        var result = DockerServices.StartServer(NodesPath);
        _dockerMessageSuccess = result.success;
        _dockerMessage = result.message;
    }

    private void DockerQuickStartViewer()
    {
        if (string.IsNullOrEmpty(NodesPath)) return;
        var result = DockerServices.StartViewer(NodesPath, _dockerNewPort);
        _dockerMessageSuccess = result.success;
        _dockerMessage = result.message;
    }

    private void DockerStopCurrentProject()
    {
        if (string.IsNullOrEmpty(NodesPath)) return;
        var fullPath = Path.GetFullPath(NodesPath);
        foreach (var inst in DockerServices.Instances.Where(i =>
            i.IsRunning &&
            string.Equals(i.ProjectPath, fullPath, StringComparison.OrdinalIgnoreCase)).ToList())
        {
            DockerServices.StopInstance(inst.Id);
        }
        _dockerMessageSuccess = true;
        _dockerMessage = "Stopped all instances for current project.";
    }

    private void DockerAddInstance()
    {
        if (string.IsNullOrEmpty(_dockerNewProject)) return;
        (bool success, string message) result;
        if (_dockerNewKind == "Viewer")
            result = DockerServices.StartViewer(_dockerNewProject, _dockerNewPort);
        else
            result = DockerServices.StartServer(_dockerNewProject);
        _dockerMessageSuccess = result.success;
        _dockerMessage = result.message;
        if (result.success)
            _dockerNewProject = "";
    }

    private void DockerStopInstance(string instanceId)
    {
        var (success, message) = DockerServices.StopInstance(instanceId);
        _dockerMessageSuccess = success;
        _dockerMessage = message;
    }

    private void DockerRemoveInstance(string instanceId)
    {
        var (success, message) = DockerServices.RemoveInstance(instanceId);
        _dockerMessageSuccess = success;
        _dockerMessage = message;
    }

    private void DockerRestartInstance(DockerServiceManager.ManagedInstance inst)
    {
        (bool success, string message) result;
        if (inst.Kind == DockerServiceManager.InstanceKind.Viewer)
            result = DockerServices.StartViewer(inst.ProjectPath, inst.Port);
        else
            result = DockerServices.StartServer(inst.ProjectPath);
        _dockerMessageSuccess = result.success;
        _dockerMessage = result.message;
    }

    private void DockerToggleAutoStart(string instanceId, bool autoStart)
    {
        DockerServices.SetAutoStart(instanceId, autoStart);
    }

    private void RefreshDockerProjects()
    {
        if (ServerProcessService.IsDocker)
            _dockerAvailableProjects = DockerServices.GetAvailableProjects();
    }

    // Performance tracking
    private readonly ProcessPerformanceTracker _serverPerfTracker = new();
    private readonly ProcessPerformanceTracker _viewerPerfTracker = new();
    private ProcessPerformanceSnapshot? _serverPerf;
    private ProcessPerformanceSnapshot? _viewerPerf;
    private Timer? _perfTimer;

    // Server diagnostics (subsystem-level)
    private ServerDiagnostics? _serverDiag;
    private string? _serverDiagError;
    private Timer? _diagTimer2;

    // Subsystem breakdown
    private List<SubsystemInfo> _subsystems = new();
    private record SubsystemInfo(string Icon, string Name, int Count, string Details);

    private string WinServiceStatusText => _isWinServiceInstalled ? _winServiceStatus.ToString() : "Not Installed";
    private string WinServiceStatusBadge => _isWinServiceInstalled
        ? _winServiceStatus == ServiceControllerStatus.Running ? "bg-success" : "bg-warning"
        : "bg-secondary";

    private string LinuxServiceStatusBadge => _linuxServiceStatus switch
    {
        "active" => "bg-success",
        "inactive" => "bg-secondary",
        "failed" => "bg-danger",
        _ => "bg-warning"
    };

    private string RvWinServiceStatusText => _isRvWinServiceInstalled ? _rvWinServiceStatus.ToString() : "Not Installed";
    private string RvWinServiceStatusBadge => _isRvWinServiceInstalled
        ? _rvWinServiceStatus == ServiceControllerStatus.Running ? "bg-success" : "bg-warning"
        : "bg-secondary";

    private string RvLinuxServiceStatusBadge => _rvLinuxServiceStatus switch
    {
        "active" => "bg-success",
        "inactive" => "bg-secondary",
        "failed" => "bg-danger",
        _ => "bg-warning"
    };

    protected override void OnInitialized()
    {
        ServerProcess.StateChanged += OnServerStateChanged;
        ViewerProcess.StateChanged += OnServerStateChanged;
        ServerProcess.OutputChanged += OnOutputChanged;
        ViewerProcess.OutputChanged += OnOutputChanged;
        DockerServices.StateChanged += OnDockerStateChanged;
        RefreshDockerProjects();
        _statusTimer = new Timer(_ => InvokeAsync(async () => { await RefreshStatusAsync(); StateHasChanged(); }), null, TimeSpan.Zero, TimeSpan.FromSeconds(5));
        _perfTimer = new Timer(_ => InvokeAsync(() => { SamplePerformance(); BuildSubsystems(); StateHasChanged(); return Task.CompletedTask; }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
        _diagTimer2 = new Timer(_ => InvokeAsync(async () => { await PollDiagInBackground(); }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void OnServerStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnDockerStateChanged()
    {
        InvokeAsync(() => { RefreshDockerProjects(); StateHasChanged(); });
    }

    private void OnOutputChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Yield();
            // Auto-scroll to bottom
            try
            {
                if (_showServerOutput)
                    await JS.InvokeVoidAsync("eval", "document.querySelector('[data-server-output]')?.scrollTo(0, 999999)");
                if (_showViewerOutput)
                    await JS.InvokeVoidAsync("eval", "document.querySelector('[data-viewer-output]')?.scrollTo(0, 999999)");
            }
            catch { /* element may not be rendered yet */ }
        });
    }

    private void RefreshStatus()
    {
        _ = RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        // Detect externally started processes (e.g. server started from console before editor)
        if (!string.IsNullOrEmpty(NodesPath))
        {
            ServerProcess.DetectExternalProcess(NodesPath);
            ViewerProcess.DetectExternalProcess(NodesPath);
        }

        // Docker containers don't have systemd or Windows services --
        // process detection above is sufficient.
        if (ServerProcessService.IsDocker)
            return;

        if (ServerProcessService.IsWindows)
        {
            _isWinServiceInstalled = ServerProcess.IsServiceInstalled();
            if (_isWinServiceInstalled)
                _winServiceStatus = ServerProcess.GetServiceStatus();
            else
                _winServiceStatus = 0;

            _isRvWinServiceInstalled = ViewerProcess.IsServiceInstalled();
            if (_isRvWinServiceInstalled)
                _rvWinServiceStatus = ViewerProcess.GetServiceStatus();
            else
                _rvWinServiceStatus = 0;
        }
        else if (ServerProcessService.IsLinux)
        {
            _isLinuxServiceInstalled = await ServerProcess.IsSystemdServiceInstalledAsync();
            if (_isLinuxServiceInstalled)
                _linuxServiceStatus = await ServerProcess.GetSystemdStatusAsync();
            else
                _linuxServiceStatus = "not installed";

            _isRvLinuxServiceInstalled = await ViewerProcess.IsSystemdServiceInstalledAsync();
            if (_isRvLinuxServiceInstalled)
                _rvLinuxServiceStatus = await ViewerProcess.GetSystemdStatusAsync();
            else
                _rvLinuxServiceStatus = "not installed";
        }
    }

