    // ─── Performance ─────────────────────────────────────────

    private void SamplePerformance()
    {
        if (ServerProcess.IsServerRunning)
        {
            _serverPerf = _serverPerfTracker.Sample(ServerProcess.ServerProcess);
        }
        else
        {
            _serverPerf = null;
            _serverPerfTracker.Reset();
        }

        if (ViewerProcess.IsViewerRunning)
        {
            _viewerPerf = _viewerPerfTracker.Sample(ViewerProcess.ViewerProcess);
        }
        else
        {
            _viewerPerf = null;
            _viewerPerfTracker.Reset();
        }
    }

    private void OnEndpointChanged(ChangeEventArgs e)
    {
        Editor.SetServerEndpointUrl(e.Value?.ToString() ?? string.Empty);
    }

    private async Task PollDiagnosticsAsync()
    {
        // Read diagnostics from the OPC UA server's _Diagnostics.Json variable
        var model = Editor.RootModel;
        var endpointUrl = model?.Server?.EndpointUrl ?? "opc.tcp://localhost:14840/SimpleOpcFileServer";

        // When anonymous OPC is disabled, pass editor user credentials
        string? diagUser = null, diagPass = null;
        if (model?.Server?.EnableAnonymous == false && Auth.IsAuthenticated)
        {
            diagUser = Auth.Username;
            diagPass = Auth.OpcPassword;
        }

        await DiagClient.PollAsync(endpointUrl, diagUser, diagPass);
        _serverDiag = DiagClient.Latest;
        _serverDiagError = DiagClient.Error;
        MergeDiagnosticsWithProject();
    }

    /// <summary>
    /// Runs diagnostics polling off the Blazor render thread, then pushes results to UI.
    /// </summary>
    private async Task PollDiagInBackground()
    {
        await PollDiagnosticsAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Ensures all project subsystems appear in _serverDiag even if the running server
    /// doesn't report them (e.g. server still starting, old binary without instrumentation).
    /// When the server is stopped, clears the diagnostics so the section is hidden.
    /// </summary>
    private void MergeDiagnosticsWithProject()
    {
        var model = Editor.RootModel;
        if (model == null) return;

        // Don't show subsystem performance when the server is stopped.
        if (!ServerProcess.IsServerRunning)
        {
            _serverDiag = null;
            return;
        }

        // Build a set of entries the server reported (empty if poll failed)
        var reported = new HashSet<string>();
        if (_serverDiag != null)
        {
            foreach (var s in _serverDiag.Subsystems)
                reported.Add($"{s.Category}:{s.Name}");
        }

        // When the server is running, always ensure a container exists so
        // project-config subsystems appear while the endpoint connects.
        _serverDiag ??= new SharedModels.ServerDiagnostics();

        // Add missing scripts
        foreach (var script in model.Scripts)
        {
            if (!reported.Contains($"Script:{script.Name}"))
            {
                _serverDiag.Subsystems.Add(new SharedModels.SubsystemDiagnostics
                {
                    Category = "Script",
                    Name = script.Name,
                    Enabled = script.Enabled,
                    Status = script.Enabled ? "Running" : "Disabled"
                });
            }
        }

        // Add missing PLC programs
        foreach (var plc in model.PlcPrograms)
        {
            if (!reported.Contains($"PlcProgram:{plc.Name}"))
            {
                _serverDiag.Subsystems.Add(new SharedModels.SubsystemDiagnostics
                {
                    Category = "PlcProgram",
                    Name = plc.Name,
                    Enabled = plc.Enabled,
                    Status = plc.Enabled ? "Running" : "Disabled"
                });
            }
        }

        // Add missing recipes
        foreach (var recipe in model.Recipes)
        {
            if (!reported.Contains($"Recipe:{recipe.Name}"))
            {
                _serverDiag.Subsystems.Add(new SharedModels.SubsystemDiagnostics
                {
                    Category = "Recipe",
                    Name = recipe.Name,
                    Enabled = recipe.Enabled,
                    Status = recipe.Enabled ? "Running" : "Disabled"
                });
            }
        }

        // Add missing data logger
        if (model.Database != null && !string.IsNullOrEmpty(model.Database.ConnectionString))
        {
            // Check both provider name and class name variants
            var hasLogger = _serverDiag.Subsystems.Any(s => s.Category == "DataLogger");
            if (!hasLogger)
            {
                _serverDiag.Subsystems.Add(new SharedModels.SubsystemDiagnostics
                {
                    Category = "DataLogger",
                    Name = model.Database.Provider,
                    Enabled = true,
                    Status = "Running"
                });
            }
        }

        // Filter out drivers that are not used by any variable in the current project
        var usedDrivers = new HashSet<string>(CollectDriverBindings(model.Folder).Distinct(), StringComparer.OrdinalIgnoreCase);
        _serverDiag.Subsystems.RemoveAll(s => s.Category == "Driver" && !usedDrivers.Contains(s.Name));

        // If nothing was added and there are no subsystems, clear _serverDiag so the UI doesn't show an empty section
        if (_serverDiag.Subsystems.Count == 0)
            _serverDiag = null;
    }

    private void BuildSubsystems()
    {
        var model = Editor.RootModel;
        if (model == null)
        {
            _subsystems = [];
            return;
        }

        var list = new List<SubsystemInfo>();

        // Variables
        var varCount = CountVariables(model.Folder);
        list.Add(new("🏷️", "Variables", varCount, ""));

        // Driver bindings
        var driverBindings = CollectDriverBindings(model.Folder);
        foreach (var grp in driverBindings.GroupBy(d => d).OrderBy(g => g.Key))
        {
            list.Add(new("🔌", $"Driver: {grp.Key}", grp.Count(), $"{grp.Count()} variables"));
        }

        // Alarms
        var alarmCount = CountAlarms(model.Folder);
        if (alarmCount > 0)
            list.Add(new("🔔", "Alarms", alarmCount, $"{alarmCount} configured"));

        // Data logging
        var logCount = CountDataLogging(model.Folder);
        if (logCount > 0)
            list.Add(new("📊", "Data Logging", logCount, $"{logCount} variables logged"));

        // Historical database
        if (model.Database != null && !string.IsNullOrEmpty(model.Database.ConnectionString))
            list.Add(new("🗄️", $"Database ({model.Database.Provider})", 1, model.Database.TableName));

        // Scripts
        if (model.Scripts.Count > 0)
            list.Add(new("⚡", "Scripts", model.Scripts.Count,
                string.Join(", ", model.Scripts.Select(s => s.Name).Take(5))));

        // PLC programs
        if (model.PlcPrograms.Count > 0)
            list.Add(new("⚙️", "PLC Programs", model.PlcPrograms.Count,
                string.Join(", ", model.PlcPrograms.Select(p => p.Name).Take(5))));

        // Recipes
        if (model.Recipes.Count > 0)
            list.Add(new("📦", "Recipes", model.Recipes.Count,
                string.Join(", ", model.Recipes.Select(r => r.Name).Take(5))));

        // Screens
        if (model.Screens.Count > 0)
            list.Add(new("🖼️", "Screens", model.Screens.Count,
                string.Join(", ", model.Screens.Select(s => s.Name).Take(5))));

        // Cameras
        if (model.Cameras.Count > 0)
            list.Add(new("📷", "Cameras", model.Cameras.Count,
                string.Join(", ", model.Cameras.Select(c => c.CameraId).Take(5))));

        // Users & groups
        if (model.Users.Count > 0)
            list.Add(new("👤", "Users", model.Users.Count, ""));
        if (model.UserGroups.Count > 0)
            list.Add(new("👥", "User Groups", model.UserGroups.Count, ""));

        // Strings
        if (model.Strings.Count > 0)
            list.Add(new("🌐", "Localized Strings", model.Strings.Count, ""));

        _subsystems = list;
    }

    private static int CountVariables(Folder folder)
    {
        int count = folder.Variables.Count;
        foreach (var sub in folder.Folders)
            count += CountVariables(sub);
        return count;
    }

    private static int CountAlarms(Folder folder)
    {
        int count = folder.Variables.Count(v => v.Alarm != null);
        foreach (var sub in folder.Folders)
            count += CountAlarms(sub);
        return count;
    }

    private static int CountDataLogging(Folder folder)
    {
        int count = folder.Variables.Count(v => v.DataLogging != null);
        foreach (var sub in folder.Folders)
            count += CountDataLogging(sub);
        return count;
    }

    private static List<string> CollectDriverBindings(Folder folder)
    {
        var result = new List<string>();
        foreach (var v in folder.Variables)
        {
            if (v.DriverConfigs != null)
            {
                foreach (var key in v.DriverConfigs.Keys)
                    result.Add(key);
            }
        }
        foreach (var sub in folder.Folders)
            result.AddRange(CollectDriverBindings(sub));
        return result;
    }

    private static string CpuColor(double pct) => pct switch
    {
        < 30 => "#22c55e",
        < 60 => "#eab308",
        < 80 => "#f97316",
        _ => "#ef4444"
    };

    private static string CategoryIcon(string category) => category switch
    {
        "Driver" => "🔌",
        "Script" => "⚡",
        "PlcProgram" => "⚙️",
        "Recipe" => "📦",
        "DataLogger" => "📊",
        "EventLogger" => "📓",
        _ => "●"
    };

    private static string FormatUptime(TimeSpan ts)
    {
        if (ts.TotalDays >= 1)
            return $"{(int)ts.TotalDays}d {ts.Hours}h {ts.Minutes}m";
        if (ts.TotalHours >= 1)
            return $"{ts.Hours}h {ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Minutes}m {ts.Seconds}s";
    }

    private static string FormatCpuTime(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        if (ts.TotalMinutes >= 1)
            return $"{(int)ts.TotalMinutes}m {ts.Seconds}s {ts.Milliseconds}ms";
        if (ts.TotalSeconds >= 1)
            return $"{ts.TotalSeconds:F2}s";
        if (ts.TotalMilliseconds >= 1)
            return $"{ts.TotalMilliseconds:F1}ms";
        if (ts.TotalMilliseconds >= 0.001)
            return $"{ts.TotalMicroseconds:F1}µs";
        return "0µs";
    }

    /// <summary>
    /// Format a subsystem cycle time given in milliseconds.
    /// Auto-scales between µs, ms, s, min, h for readable display.
    /// </summary>
    private static string FormatCycleTime(double ms)
    {
        if (ms <= 0)
            return "—";
        if (ms >= 60_000)
            return $"{ms / 60_000:F1}m";
        if (ms >= 1000)
            return $"{ms / 1000:F2}s";
        if (ms >= 1)
            return $"{ms:F2}ms";
        if (ms >= 0.001)
            return $"{ms * 1000:F1}µs";
        return $"{ms * 1_000_000:F0}ns";
    }

    public void Dispose()
    {
        ServerProcess.StateChanged -= OnServerStateChanged;
        ViewerProcess.StateChanged -= OnServerStateChanged;
        ServerProcess.OutputChanged -= OnOutputChanged;
        ViewerProcess.OutputChanged -= OnOutputChanged;
        DockerServices.StateChanged -= OnDockerStateChanged;
        _statusTimer?.Dispose();
        _perfTimer?.Dispose();
        _diagTimer2?.Dispose();
    }

    private static string FormatLimit(int max) => max == 0 ? "Unlimited" : max.ToString();

    private async Task CopyToClipboard(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { /* clipboard may not be available */ }
    }

    private async Task CopyAllDiagErrors()
    {
        if (_serverDiag == null) return;
        var errors = _serverDiag.Subsystems.ToList()
            .Where(s => !string.IsNullOrEmpty(s.LastError))
            .Select(s => $"[{s.Category}/{s.Name}] {s.LastError}");
        var text = string.Join(Environment.NewLine, errors);
        if (!string.IsNullOrEmpty(text))
            await CopyToClipboard(text);
    }
}
