@using SharedModels
@using ServerEditorWeb.Services

<div class="var-picker" @onfocusin="OnFocusIn" @onfocusout="OnFocusOutDelayed">
    <div class="var-picker-input-wrap">
        <input type="text" class="form-control form-control-sm var-picker-input"
               style="@InputStyle"
               value="@Value"
               @oninput="OnInput"
               @onkeydown="OnKeyDown"
               placeholder="@Placeholder" />
        <button type="button" class="var-picker-toggle" tabindex="-1"
                @onmousedown="() => _preventClose = true" @onmousedown:preventDefault
                @onclick="ToggleDropdown" title="Browse variables">&#x25BE;</button>
        <button type="button" class="var-picker-browse @(string.IsNullOrEmpty(Value) ? "var-picker-browse-last" : "")" tabindex="-1"
                @onclick="OpenTreePicker" title="Pick variable from tree">&#x1F4C2;</button>
        <button type="button" class="var-picker-clear" tabindex="-1"
                style="@(string.IsNullOrEmpty(Value) ? "display:none" : "")"
                @onmousedown="() => _preventClose = true" @onmousedown:preventDefault
                @onclick="ClearValue" title="Clear">&#x2715;</button>
    </div>

    @if (_showDropdown && _filteredPaths.Count > 0)
    {
        <div class="var-picker-dropdown" @onmousedown:preventDefault>
            @for (var i = 0; i < _filteredPaths.Count; i++)
            {
                var item = _filteredPaths[i];
                var idx = i;
                <div class="var-picker-item @(idx == _highlightIndex ? "var-picker-item-hl" : "")"
                     @onmousedown="() => SelectItem(item)" @onmousedown:preventDefault>
                    <span class="var-picker-item-icon">@(new MarkupString(item.IsFolder ? "&#x1F4C1;" : "&#x1F4CA;"))</span>
                    <span class="var-picker-item-path">@item.Path</span>
                    @if (!item.IsFolder)
                    {
                        <span class="var-picker-item-type">@item.Type</span>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_showTreePicker)
{
    <div class="var-tree-overlay" @onclick="CloseTreePicker" @onclick:stopPropagation>
        <div class="var-tree-dialog" @onclick:stopPropagation>
            <div class="var-tree-header">
                <span class="var-tree-title">Select Variable</span>
                <button type="button" class="var-tree-close" @onclick="CloseTreePicker">&times;</button>
            </div>
            <div class="var-tree-filter">
                <input type="text" class="form-control form-control-sm"
                       placeholder="Filter variables..."
                       @oninput="OnTreeFilterInput" />
            </div>
            <div class="var-tree-body">
                @RenderTreeLevel(_treeRoots, 0)
            </div>
            <div class="var-tree-footer">
                @if (!string.IsNullOrEmpty(_treeSelectedPath))
                {
                    <span class="var-tree-selected-label">@_treeSelectedPath</span>
                }
                <button type="button" class="btn btn-sm btn-primary"
                        disabled="@(string.IsNullOrEmpty(_treeSelectedPath))"
                        @onclick="ConfirmTreeSelection">OK</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="CloseTreePicker">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select variable\u2026";
    [Parameter] public string InputStyle { get; set; } = "";

    [Inject] private NodeEditorService Editor { get; set; } = default!;

    private bool _showDropdown;
    private int _highlightIndex = -1;
    private string _filter = "";
    private List<VarPathEntry> _allPaths = new();
    private List<VarPathEntry> _filteredPaths = new();
    private bool _preventClose;
    private CancellationTokenSource? _closeCts;

    // Tree picker state
    private bool _showTreePicker;
    private string? _treeSelectedPath;
    private string _treeFilter = "";
    private List<TreeVarNode> _treeRoots = new();
    private HashSet<string> _expandedTreeNodes = new();

    protected override void OnParametersSet()
    {
        RebuildPaths();
    }

    private void RebuildPaths()
    {
        _allPaths.Clear();
        var root = Editor.RootModel?.Folder;
        if (root != null)
        {
            // Skip root folder name — variable paths in the project never include it
            foreach (var sub in root.Folders)
                CollectPaths(sub, "");
            foreach (var v in root.Variables)
                _allPaths.Add(new VarPathEntry { Path = v.Name, Type = v.Type, IsFolder = false });
        }

        // Include calculated / virtual variables
        var calcVars = Editor.RootModel?.CalculatedVariables;
        if (calcVars != null)
        {
            foreach (var cv in calcVars)
            {
                if (!cv.Enabled || string.IsNullOrWhiteSpace(cv.Name)) continue;
                var folder = string.IsNullOrWhiteSpace(cv.FolderPath) ? "_Calculated" : cv.FolderPath;
                var fullPath = $"{folder}.{cv.Name}";
                // Add folder entry once
                if (!_allPaths.Any(p => p.IsFolder && p.Path == folder))
                {
                    _allPaths.Add(new VarPathEntry { Path = folder, IsFolder = true });
                }
                _allPaths.Add(new VarPathEntry
                {
                    Path = fullPath,
                    Type = cv.Type,
                    IsFolder = false
                });
            }
        }

        // Include variables from child projects, prefixed with the child project name
        if (Editor.ActiveProject != null)
        {
            foreach (var childProj in NodeEditorService.GetAllChildProjects(Editor.ActiveProject))
            {
                var projectPrefix = childProj.Name;
                var childRoot = childProj.Model.Folder;
                if (childRoot != null)
                {
                    _allPaths.Add(new VarPathEntry { Path = projectPrefix, IsFolder = true });
                    foreach (var sub in childRoot.Folders)
                        CollectPaths(sub, projectPrefix);
                    foreach (var v in childRoot.Variables)
                        _allPaths.Add(new VarPathEntry { Path = $"{projectPrefix}.{v.Name}", Type = v.Type, IsFolder = false });
                }
                var childCalc = childProj.Model.CalculatedVariables;
                if (childCalc != null)
                {
                    foreach (var cv in childCalc)
                    {
                        if (!cv.Enabled || string.IsNullOrWhiteSpace(cv.Name)) continue;
                        var folder = string.IsNullOrWhiteSpace(cv.FolderPath)
                            ? $"{projectPrefix}._Calculated"
                            : $"{projectPrefix}.{cv.FolderPath}";
                        var fullPath = $"{folder}.{cv.Name}";
                        if (!_allPaths.Any(p => p.IsFolder && p.Path == folder))
                            _allPaths.Add(new VarPathEntry { Path = folder, IsFolder = true });
                        _allPaths.Add(new VarPathEntry { Path = fullPath, Type = cv.Type, IsFolder = false });
                    }
                }
            }
        }

        ApplyFilter();
    }

    private void CollectPaths(Folder folder, string prefix)
    {
        var folderPath = string.IsNullOrEmpty(prefix) ? folder.Name : $"{prefix}.{folder.Name}";

        // Add folder entry (for browsing context)
        if (!string.IsNullOrEmpty(prefix))
        {
            _allPaths.Add(new VarPathEntry { Path = folderPath, IsFolder = true });
        }

        foreach (var v in folder.Variables)
        {
            _allPaths.Add(new VarPathEntry
            {
                Path = $"{folderPath}.{v.Name}",
                Type = v.Type,
                IsFolder = false
            });
        }

        foreach (var sub in folder.Folders)
        {
            CollectPaths(sub, folderPath);
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_filter))
        {
            // Show variables only (not folders) when no filter
            _filteredPaths = _allPaths.Where(p => !p.IsFolder).ToList();
        }
        else
        {
            _filteredPaths = _allPaths
                .Where(p => p.Path.Contains(_filter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        _highlightIndex = -1;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        _filter = val;
        Value = val;
        await ValueChanged.InvokeAsync(val);
        await OnChanged.InvokeAsync();
        RebuildPaths();
        _showDropdown = true;
    }

    private async Task ClearValue()
    {
        Value = "";
        _filter = "";
        _showDropdown = false;
        await ValueChanged.InvokeAsync(string.Empty);
        await OnChanged.InvokeAsync();
    }

    private void OnFocusIn()
    {
        // Cancel any pending close
        _closeCts?.Cancel();
        _closeCts = null;

        RebuildPaths();
        _filter = Value ?? "";
        _showDropdown = true;
    }

    private async Task OnFocusOutDelayed()
    {
        if (_preventClose)
        {
            _preventClose = false;
            return;
        }

        _closeCts?.Cancel();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        try
        {
            await Task.Delay(250, token);
            if (!token.IsCancellationRequested)
            {
                _showDropdown = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { /* focus returned, keep open */ }
    }

    private void ToggleDropdown()
    {
        _preventClose = false;
        if (_showDropdown)
        {
            _showDropdown = false;
        }
        else
        {
            _filter = "";
            RebuildPaths();
            _showDropdown = true;
        }
    }

    private async Task SelectItem(VarPathEntry item)
    {
        if (item.IsFolder)
        {
            // Selecting a folder filters to its children
            _filter = item.Path + ".";
            Value = _filter;
            await ValueChanged.InvokeAsync(Value);
            ApplyFilter();
        }
        else
        {
            Value = item.Path;
            _showDropdown = false;
            await ValueChanged.InvokeAsync(Value);
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_showDropdown || _filteredPaths.Count == 0)
        {
            if (e.Key == "ArrowDown")
            {
                _filter = Value ?? "";
                RebuildPaths();
                _showDropdown = true;
            }
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _highlightIndex = Math.Min(_highlightIndex + 1, _filteredPaths.Count - 1);
                break;
            case "ArrowUp":
                _highlightIndex = Math.Max(_highlightIndex - 1, 0);
                break;
            case "Enter":
                if (_highlightIndex >= 0 && _highlightIndex < _filteredPaths.Count)
                    await SelectItem(_filteredPaths[_highlightIndex]);
                break;
            case "Escape":
                _showDropdown = false;
                break;
        }
    }

    // ─── Tree picker ─────────────────────────────────────────

    private void OpenTreePicker()
    {
        _showDropdown = false;
        _treeSelectedPath = Value;
        _treeFilter = "";
        BuildTree();
        _showTreePicker = true;
    }

    private void CloseTreePicker()
    {
        _showTreePicker = false;
    }

    private async Task ConfirmTreeSelection()
    {
        if (!string.IsNullOrEmpty(_treeSelectedPath))
        {
            Value = _treeSelectedPath;
            await ValueChanged.InvokeAsync(Value);
            await OnChanged.InvokeAsync();
        }
        _showTreePicker = false;
    }

    private void BuildTree()
    {
        _treeRoots = new List<TreeVarNode>();
        _expandedTreeNodes.Clear();

        var root = Editor.RootModel?.Folder;
        if (root != null)
        {
            // Skip root folder — show its children as top-level tree nodes
            foreach (var sub in root.Folders)
            {
                var child = BuildFolderNode(sub, "");
                if (child != null) _treeRoots.Add(child);
            }
            foreach (var v in root.Variables)
            {
                _treeRoots.Add(new TreeVarNode { Name = v.Name, FullPath = v.Name, Type = v.Type, IsFolder = false });
            }
        }

        // Add calculated variables
        var calcVars = Editor.RootModel?.CalculatedVariables;
        if (calcVars?.Count > 0)
        {
            var calcFolder = new TreeVarNode { Name = "_Calculated", IsFolder = true, FullPath = "_Calculated" };
            foreach (var cv in calcVars)
            {
                if (!cv.Enabled || string.IsNullOrWhiteSpace(cv.Name)) continue;
                var folder = string.IsNullOrWhiteSpace(cv.FolderPath) ? "_Calculated" : cv.FolderPath;
                calcFolder.Children.Add(new TreeVarNode
                {
                    Name = cv.Name,
                    FullPath = $"{folder}.{cv.Name}",
                    Type = cv.Type,
                    IsFolder = false
                });
            }
            if (calcFolder.Children.Count > 0)
                _treeRoots.Add(calcFolder);
        }

        // Add child project variable trees
        if (Editor.ActiveProject != null)
        {
            foreach (var childProj in NodeEditorService.GetAllChildProjects(Editor.ActiveProject))
            {
                var projPrefix = childProj.Name;
                var projNode = new TreeVarNode { Name = $"🔗 {projPrefix}", IsFolder = true, FullPath = projPrefix };
                var childRoot = childProj.Model.Folder;
                if (childRoot != null)
                {
                    foreach (var sub in childRoot.Folders)
                    {
                        var child = BuildFolderNode(sub, projPrefix);
                        if (child != null) projNode.Children.Add(child);
                    }
                    foreach (var v in childRoot.Variables)
                        projNode.Children.Add(new TreeVarNode { Name = v.Name, FullPath = $"{projPrefix}.{v.Name}", Type = v.Type, IsFolder = false });
                }
                var childCalc = childProj.Model.CalculatedVariables;
                if (childCalc?.Count > 0)
                {
                    var calcNode = new TreeVarNode { Name = "_Calculated", IsFolder = true, FullPath = $"{projPrefix}._Calculated" };
                    foreach (var cv in childCalc)
                    {
                        if (!cv.Enabled || string.IsNullOrWhiteSpace(cv.Name)) continue;
                        var folder = string.IsNullOrWhiteSpace(cv.FolderPath) ? $"{projPrefix}._Calculated" : $"{projPrefix}.{cv.FolderPath}";
                        calcNode.Children.Add(new TreeVarNode { Name = cv.Name, FullPath = $"{folder}.{cv.Name}", Type = cv.Type, IsFolder = false });
                    }
                    if (calcNode.Children.Count > 0) projNode.Children.Add(calcNode);
                }
                if (projNode.Children.Count > 0)
                    _treeRoots.Add(projNode);
            }
        }

        // Auto-expand to the currently selected value
        if (!string.IsNullOrEmpty(Value))
        {
            ExpandToPath(Value);
        }
    }

    private TreeVarNode BuildFolderNode(Folder folder, string prefix)
    {
        var folderPath = string.IsNullOrEmpty(prefix) ? folder.Name : $"{prefix}.{folder.Name}";
        var node = new TreeVarNode { Name = folder.Name, FullPath = folderPath, IsFolder = true };

        foreach (var sub in folder.Folders)
        {
            var child = BuildFolderNode(sub, folderPath);
            if (child != null) node.Children.Add(child);
        }

        foreach (var v in folder.Variables)
        {
            node.Children.Add(new TreeVarNode
            {
                Name = v.Name,
                FullPath = $"{folderPath}.{v.Name}",
                Type = v.Type,
                IsFolder = false
            });
        }

        return node;
    }

    private void ExpandToPath(string path)
    {
        var parts = path.Split('.');
        var current = "";
        for (int i = 0; i < parts.Length - 1; i++)
        {
            current = i == 0 ? parts[i] : $"{current}.{parts[i]}";
            _expandedTreeNodes.Add(current);
        }
    }

    private void ToggleTreeNode(string fullPath)
    {
        if (!_expandedTreeNodes.Add(fullPath))
            _expandedTreeNodes.Remove(fullPath);
    }

    private void SelectTreeVariable(string fullPath)
    {
        _treeSelectedPath = fullPath;
    }

    private void OnTreeFilterInput(ChangeEventArgs e)
    {
        _treeFilter = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(_treeFilter))
        {
            // Auto-expand all folders when filtering
            ExpandAllNodes(_treeRoots);
        }
    }

    private void ExpandAllNodes(List<TreeVarNode> nodes)
    {
        foreach (var n in nodes)
        {
            if (n.IsFolder)
            {
                _expandedTreeNodes.Add(n.FullPath);
                ExpandAllNodes(n.Children);
            }
        }
    }

    private bool NodeMatchesFilter(TreeVarNode node)
    {
        if (string.IsNullOrWhiteSpace(_treeFilter)) return true;
        if (node.Name.Contains(_treeFilter, StringComparison.OrdinalIgnoreCase)) return true;
        if (node.IsFolder)
            return node.Children.Any(NodeMatchesFilter);
        return false;
    }

    private RenderFragment RenderTreeLevel(List<TreeVarNode> nodes, int depth) => builder =>
    {
        int seq = 0;
        foreach (var node in nodes)
        {
            if (!NodeMatchesFilter(node)) continue;

            if (node.IsFolder)
            {
                var expanded = _expandedTreeNodes.Contains(node.FullPath);
                var capturedNode = node;

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "var-tree-node var-tree-folder");
                builder.AddAttribute(seq++, "style", $"padding-left: {depth * 16 + 4}px;");
                builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleTreeNode(capturedNode.FullPath)));

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-chevron");
                builder.AddContent(seq++, expanded ? "\u25BE" : "\u25B8");
                builder.CloseElement();

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-icon");
                builder.AddContent(seq++, "\U0001F4C1");
                builder.CloseElement();

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-name");
                builder.AddContent(seq++, capturedNode.Name);
                builder.CloseElement();

                builder.CloseElement();

                if (expanded)
                {
                    builder.AddContent(seq++, RenderTreeLevel(capturedNode.Children, depth + 1));
                }
            }
            else
            {
                var isSelected = node.FullPath == _treeSelectedPath;
                var capturedNode = node;

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", $"var-tree-node var-tree-var{(isSelected ? " var-tree-var-selected" : "")}");
                builder.AddAttribute(seq++, "style", $"padding-left: {depth * 16 + 4}px;");
                builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => SelectTreeVariable(capturedNode.FullPath)));
                builder.AddAttribute(seq++, "ondblclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, async () => { _treeSelectedPath = capturedNode.FullPath; await ConfirmTreeSelection(); }));

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-chevron");
                builder.AddMarkupContent(seq++, "&nbsp;");
                builder.CloseElement();

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-icon");
                builder.AddContent(seq++, "\U0001F4CA");
                builder.CloseElement();

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-name");
                builder.AddContent(seq++, capturedNode.Name);
                builder.CloseElement();

                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "var-tree-type");
                builder.AddContent(seq++, capturedNode.Type);
                builder.CloseElement();

                builder.CloseElement();
            }
        }
    };
    // ─── Models ─────────────────────────────────────────────

    private class VarPathEntry
    {
        public string Path { get; set; } = "";
        public string Type { get; set; } = "";
        public bool IsFolder { get; set; }
    }

    private class TreeVarNode
    {
        public string Name { get; set; } = "";
        public string FullPath { get; set; } = "";
        public string Type { get; set; } = "";
        public bool IsFolder { get; set; }
        public List<TreeVarNode> Children { get; set; } = new();
    }
}