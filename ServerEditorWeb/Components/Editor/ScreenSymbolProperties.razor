        @if (_selectedSymbol.Type is "pipe")

        {

            <hr class="my-2" />

            <h6 class="mb-2 small" style="color: #64748b;">ðŸ”§ Pipe Settings</h6>



            <div class="mb-2">

                <label class="form-label mb-0 small">Orientation</label>

                <select class="form-select form-select-sm" style="font-size: 10px;"

                        @bind="_selectedSymbol.PipeOrientation" @bind:after="OnChanged">

                    <option value="horizontal">â†”ï¸ Horizontal</option>

                    <option value="vertical">â†•ï¸ Vertical</option>
                    <option value="corner-tl">&#x2B10; Corner &#x2196; (top-left)</option>
                    <option value="corner-tr">&#x2B10; Corner &#x2197; (top-right)</option>
                    <option value="corner-bl">&#x2B10; Corner &#x2199; (bottom-left)</option>
                    <option value="corner-br">&#x2B10; Corner &#x2198; (bottom-right)</option>

                </select>

            </div>



            <div class="d-flex gap-1 mb-2">

                <div>

                    <label class="form-label mb-0 small">Pipe</label>

                    <ColorPicker Value="@(_selectedSymbol.PipeColor)" ValueChanged="(v) => { _selectedSymbol.PipeColor = v; }" OnAfterChange="OnChanged" />

                </div>

                <div>

                    <label class="form-label mb-0 small">Flow</label>

                    <ColorPicker Value="@(_selectedSymbol.PipeFlowColor)" ValueChanged="(v) => { _selectedSymbol.PipeFlowColor = v; }" OnAfterChange="OnChanged" />

                </div>

            </div>



            <div class="form-check mb-2" style="font-size: 10px;">

                <input class="form-check-input" type="checkbox"

                       @bind="_selectedSymbol.PipeShowFlow" @bind:after="OnChanged" />

                <label class="form-check-label">Show flow animation</label>

            </div>



            <div class="mb-2">

                <label class="form-label mb-0 small">Flow Speed (seconds)</label>

                <input type="number" class="form-control form-control-sm" style="width: 70px; font-size: 10px;"

                       min="0.1" max="10" step="0.1"

                       @bind="_selectedSymbol.PipeFlowSpeed" @bind:after="OnChanged" />

            </div>



            <div class="form-text" style="font-size: 9px;">Optionally bind a boolean variable to control flow on/off. If no variable is bound, flow always animates when enabled.</div>



            <button class="btn btn-sm btn-outline-info w-100 py-0 mt-2" style="font-size: 10px;" @onclick="ToggleWidgetPreview">
                @(_widgetPreviewActive ? "\u23f9 Hide Preview" : "\u25b6 Preview Animation")
            </button>
            @if (_widgetPreviewActive)
            {
                var prevW = 200.0; var prevH = 60.0;
                var pPipeC = _selectedSymbol.PipeColor ?? "#64748b";
                var pFlowC = _selectedSymbol.PipeFlowColor ?? "#94a3b8";
                var pSpeed = _selectedSymbol.PipeFlowSpeed > 0 ? _selectedSymbol.PipeFlowSpeed : 1;
                var pIsH = (_selectedSymbol.PipeOrientation ?? "horizontal") == "horizontal";
                var pIsCorner = (_selectedSymbol.PipeOrientation ?? "").StartsWith("corner");
                <div class="mt-2 rounded" style="background: #0f172a; border: 1px solid #334155; padding: 4px; text-align: center;">
                    @if (pIsH)
                    {
                        <svg width="@prevW" height="@prevH" viewBox="0 0 @prevW @prevH" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <style>
                                    @@keyframes pipeFlowPreview { 0% { stroke-dashoffset: 20; } 100% { stroke-dashoffset: 0; } }
                                </style>
                            </defs>
                            <rect x="0" y="@Fmt(prevH*0.25)" width="@prevW" height="@Fmt(prevH*0.5)" rx="@Fmt(prevH*0.25)" fill="@pPipeC" />
                            <rect x="2" y="@Fmt(prevH*0.25+2)" width="@Fmt(prevW*0.25)" height="@Fmt(prevH*0.5-4)" rx="2" fill="rgba(255,255,255,0.15)" />
                            @for (int pi = 0; pi < 5; pi++)
                            {
                                var lx = prevW * 0.1 + pi * prevW * 0.2;
                                <line x1="@Fmt(lx)" y1="@Fmt(prevH*0.35)" x2="@Fmt(lx + prevW*0.08)" y2="@Fmt(prevH*0.35)"
                                      stroke="@pFlowC" stroke-width="2" stroke-dasharray="6,4"
                                      style="animation: pipeFlowPreview @(Fmt(pSpeed))s linear infinite;" />
                            }
                        </svg>
                    }
                    else
                    {
                        var pvW = 60.0; var pvH = 120.0;
                        <svg width="@pvW" height="@pvH" viewBox="0 0 @pvW @pvH" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <style>
                                    @@keyframes pipeFlowVPreview { 0% { stroke-dashoffset: 20; } 100% { stroke-dashoffset: 0; } }
                                </style>
                            </defs>
                            <rect x="@Fmt(pvW*0.2)" y="0" width="@Fmt(pvW*0.6)" height="@pvH" rx="@Fmt(pvW*0.3)" fill="@pPipeC" />
                            @for (int pi = 0; pi < 5; pi++)
                            {
                                var ly = pvH * 0.1 + pi * pvH * 0.2;
                                <line x1="@Fmt(pvW*0.45)" y1="@Fmt(ly)" x2="@Fmt(pvW*0.45)" y2="@Fmt(ly + pvH*0.08)"
                                      stroke="@pFlowC" stroke-width="2" stroke-dasharray="6,4"
                                      style="animation: pipeFlowVPreview @(Fmt(pSpeed))s linear infinite;" />
                            }
                        </svg>
                    }
                    @if (pIsCorner)
                    {
                        var cDir = _selectedSymbol.PipeOrientation ?? "corner-tl";
                        var cW = 100.0; var cH = 100.0;
                        var cThk = cH * 0.3;
                        var cMid = cThk / 2;
                        <svg width="@cW" height="@cH" viewBox="0 0 @cW @cH" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <style>
                                    @@keyframes pipeFlowCornerPreview { 0% { stroke-dashoffset: 20; } 100% { stroke-dashoffset: 0; } }
                                </style>
                            </defs>
                            @if (cDir == "corner-tl")
                            {
                                <path d="M @Fmt(cW),@Fmt(cMid) L @Fmt(cMid),@Fmt(cMid) L @Fmt(cMid),@cH" stroke="@pPipeC" stroke-width="@Fmt(cThk)" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                            }
                            else if (cDir == "corner-tr")
                            {
                                <path d="M 0,@Fmt(cMid) L @Fmt(cW-cMid),@Fmt(cMid) L @Fmt(cW-cMid),@cH" stroke="@pPipeC" stroke-width="@Fmt(cThk)" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                            }
                            else if (cDir == "corner-bl")
                            {
                                <path d="M @Fmt(cMid),0 L @Fmt(cMid),@Fmt(cH-cMid) L @cW,@Fmt(cH-cMid)" stroke="@pPipeC" stroke-width="@Fmt(cThk)" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                            }
                            else
                            {
                                <path d="M @Fmt(cW-cMid),0 L @Fmt(cW-cMid),@Fmt(cH-cMid) L 0,@Fmt(cH-cMid)" stroke="@pPipeC" stroke-width="@Fmt(cThk)" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                            }
                        </svg>
                    }
                </div>
            }

        }

