                        <option value="10080">7 days</option>
                        <option value="0">All</option>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0 small">Max Rows</label>
                    <input type="number" class="form-control form-control-sm" style="font-size: 10px; width: 80px;"
                           @bind="_selectedSymbol.EventLogMaxRows" @bind:after="OnChanged" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label mb-0 small">Category Filter</label>
                <select class="form-select form-select-sm" style="font-size: 10px;"
                        @bind="_selectedSymbol.EventLogCategories" @bind:after="OnChanged">
                    <option value="">All Categories</option>
                    <option value="Alarm">Alarm only</option>
                    <option value="Auth">Auth only</option>
                    <option value="Driver">Driver only</option>
                    <option value="System">System only</option>
                    <option value="Alarm,Auth">Alarm + Auth</option>
                    <option value="Alarm,Driver">Alarm + Driver</option>
                    <option value="Alarm,Auth,Driver">Alarm + Auth + Driver</option>
                    <option value="Driver,System">Driver + System</option>
                </select>
            </div>
        }


        @if (_selectedSymbol.Type is "tank")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #3b82f6;">Tank Settings</h6>
            <div class="mb-2">
                <label class="form-label mb-0 small">Tank Style</label>
                <select class="form-select form-select-sm" style="font-size: 10px;"
                        @bind="_selectedSymbol.TankStyle" @bind:after="OnChanged">
                    <option value="rect">Rectangular</option>
                    <option value="round">Rounded</option>
                    <option value="cylinder">Cylinder</option>
                </select>
            </div>
            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Body</label>
                    <ColorPicker Value="@(_selectedSymbol.TankBodyColor)" ValueChanged="(v) => { _selectedSymbol.TankBodyColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Liquid</label>
                    <ColorPicker Value="@(_selectedSymbol.TankLiquidColor)" ValueChanged="(v) => { _selectedSymbol.TankLiquidColor = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>
            <div class="form-check mb-2" style="font-size: 10px;">
                <input class="form-check-input" type="checkbox"
