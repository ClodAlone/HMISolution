            <button class="btn btn-sm btn-outline-info w-100 py-0 mt-2" style="font-size: 10px;" @onclick="ToggleWidgetPreview">
                @(_widgetPreviewActive ? "\u23f9 Hide Preview" : "\u25b6 Preview Animation")
            </button>
            @if (_widgetPreviewActive)
            {
                var cvW = 220.0; var cvH = 60.0;
                var cvRun = _selectedSymbol.ConveyorRunColor ?? "#22c55e";
                var cvFrame = _selectedSymbol.ConveyorFrameColor ?? "#334155";
                var cvSpd = _selectedSymbol.ConveyorSpeed > 0 ? _selectedSymbol.ConveyorSpeed : 1;
                var cvIsH = _selectedSymbol.ConveyorOrientation == "horizontal";
                <div class="mt-2 rounded" style="background: #0f172a; border: 1px solid #334155; padding: 4px; text-align: center;">
                    @if (cvIsH)
                    {
                        <svg width="@cvW" height="@cvH" viewBox="0 0 @cvW @cvH" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <style>
                                    @@keyframes convPreviewScroll { 0% { transform: translateX(0); } 100% { transform: translateX(16px); } }
                                </style>
                            </defs>
                            <rect width="@cvW" height="@cvH" rx="4" fill="@cvFrame" stroke="#334155" stroke-width="1" />
                            <clipPath id="cvClipH"><rect x="4" y="@Fmt(cvH*0.2)" width="@Fmt(cvW-8)" height="@Fmt(cvH*0.6)" rx="2" /></clipPath>
                            <rect x="4" y="@Fmt(cvH*0.2)" width="@Fmt(cvW-8)" height="@Fmt(cvH*0.6)" rx="2" fill="@cvRun" />
                            <g clip-path="url(#cvClipH)" style="animation: convPreviewScroll @(Fmt(cvSpd))s linear infinite;">
                                @for (int ci = -1; ci < 15; ci++)
                                {
                                    var cx2 = 4 + ci * 16;
                                    <line x1="@cx2" y1="@Fmt(cvH*0.2)" x2="@cx2" y2="@Fmt(cvH*0.8)" stroke="rgba(0,0,0,0.15)" stroke-width="2" />
                                }
                            </g>
                            <circle cx="14" cy="@Fmt(cvH/2)" r="@Fmt(cvH*0.22)" fill="@cvFrame" stroke="#94a3b8" stroke-width="1.5" />
                            <circle cx="@Fmt(cvW-14)" cy="@Fmt(cvH/2)" r="@Fmt(cvH*0.22)" fill="@cvFrame" stroke="#94a3b8" stroke-width="1.5" />
                        </svg>
                    }
                    else
                    {
                        var cvVW = 60.0; var cvVH = 140.0;
                        <svg width="@cvVW" height="@cvVH" viewBox="0 0 @cvVW @cvVH" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <style>
                                    @@keyframes convPreviewScrollV { 0% { transform: translateY(0); } 100% { transform: translateY(16px); } }
                                </style>
                            </defs>
                            <rect width="@cvVW" height="@cvVH" rx="4" fill="@cvFrame" stroke="#334155" stroke-width="1" />
                            <clipPath id="cvClipV"><rect x="@Fmt(cvVW*0.2)" y="4" width="@Fmt(cvVW*0.6)" height="@Fmt(cvVH-8)" rx="2" /></clipPath>
                            <rect x="@Fmt(cvVW*0.2)" y="4" width="@Fmt(cvVW*0.6)" height="@Fmt(cvVH-8)" rx="2" fill="@cvRun" />
                            <g clip-path="url(#cvClipV)" style="animation: convPreviewScrollV @(Fmt(cvSpd))s linear infinite;">
                                @for (int ci = -1; ci < 10; ci++)
                                {
                                    var cy2 = 4 + ci * 16;
                                    <line x1="@Fmt(cvVW*0.2)" y1="@cy2" x2="@Fmt(cvVW*0.8)" y2="@cy2" stroke="rgba(0,0,0,0.15)" stroke-width="2" />
                                }
                            </g>
                            <circle cx="@Fmt(cvVW/2)" cy="14" r="@Fmt(cvVW*0.22)" fill="@cvFrame" stroke="#94a3b8" stroke-width="1.5" />
                            <circle cx="@Fmt(cvVW/2)" cy="@Fmt(cvVH-14)" r="@Fmt(cvVW*0.22)" fill="@cvFrame" stroke="#94a3b8" stroke-width="1.5" />
                        </svg>
                    }
                </div>
            }
        }

