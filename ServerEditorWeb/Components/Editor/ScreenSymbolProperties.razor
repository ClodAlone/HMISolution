                    @onclick="() => { _selectedSymbol.ImageMapEntries.Add(new ImageMapEntry()); OnChanged(); }">＋ Add Image</button>
        }

        @if (_selectedSymbol.Type is "trend")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #10b981;">📈 Realtime Trend Settings</h6>

            <div class="mb-2">
                <label class="form-label mb-0 small">Pens (@_selectedSymbol.TrendPens.Count traces)</label>
                @for (int i = 0; i < _selectedSymbol.TrendPens.Count; i++)
                {
                    var idx = i;
                    var pen = _selectedSymbol.TrendPens[idx];
                    <div class="d-flex gap-1 mb-1 align-items-center">
                        <VariablePathPicker Value="@pen.VariablePath"
                                            ValueChanged="(v) => { pen.VariablePath = v ?? string.Empty; }"
                                            OnChanged="OnChanged"
                                            Placeholder="Variable path…"
                                            InputStyle="font-size: 10px;" />
                        <input type="text" class="form-control form-control-sm" style="width: 55px; font-size: 10px;"
                               placeholder="Label"
                               @bind="pen.Label" @bind:after="OnChanged" />
                        <ColorPicker Value="@(pen.Color)" ValueChanged="(v) => { pen.Color = v; }" OnAfterChange="OnChanged" />
                        <input type="number" class="form-control form-control-sm" style="width: 40px; font-size: 9px;"
                               step="0.5" min="0.5" max="5" placeholder="W"
                               @bind="pen.LineWidth" @bind:after="OnChanged" title="Line width" />
                        <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;"
                                @onclick="() => { _selectedSymbol.TrendPens.RemoveAt(idx); OnChanged(); }">✕</button>
                    </div>
                }
                <button class="btn btn-sm btn-outline-success w-100 py-0" style="font-size: 10px;"
                        @onclick="() => { _selectedSymbol.TrendPens.Add(new TrendPen()); OnChanged(); }">＋ Add Pen</button>
            </div>

            <div class="d-flex gap-1 mb-2 flex-wrap">
                <div>
                    <label class="form-label mb-0 small">Time Window</label>
                    <select class="form-select form-select-sm" style="font-size: 10px;"
                            @bind="_selectedSymbol.TrendTimeWindowSeconds" @bind:after="OnChanged">
                        <option value="10">10 sec</option>
                        <option value="30">30 sec</option>
                        <option value="60">1 min</option>
                        <option value="120">2 min</option>
                        <option value="300">5 min</option>
                        <option value="600">10 min</option>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0 small">Y Min</label>
                    <input type="number" step="any" class="form-control form-control-sm" style="width: 60px; font-size: 10px;"
                           @bind="_selectedSymbol.TrendYMin" @bind:after="OnChanged" placeholder="auto" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Y Max</label>
                    <input type="number" step="any" class="form-control form-control-sm" style="width: 60px; font-size: 10px;"
                           @bind="_selectedSymbol.TrendYMax" @bind:after="OnChanged" placeholder="auto" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2 flex-wrap">
                <div>
                    <label class="form-label mb-0 small">Background</label>
                    <ColorPicker Value="@(_selectedSymbol.TrendBackground)" ValueChanged="(v) => { _selectedSymbol.TrendBackground = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div class="form-check" style="font-size: 10px;">
                    <input type="checkbox" class="form-check-input" id="@($"tgrid_{_selectedSymbol.Id}")"
                           checked="@_selectedSymbol.TrendShowGrid"
                           @onchange="(e) => { _selectedSymbol.TrendShowGrid = (bool)(e.Value ?? false); OnChanged(); }" />
                    <label class="form-check-label" for="@($"tgrid_{_selectedSymbol.Id}")">Grid</label>
                </div>
                <div class="form-check" style="font-size: 10px;">
                    <input type="checkbox" class="form-check-input" id="@($"tcur_{_selectedSymbol.Id}")"
                           checked="@_selectedSymbol.TrendShowCursor"
                           @onchange="(e) => { _selectedSymbol.TrendShowCursor = (bool)(e.Value ?? false); OnChanged(); }" />
                    <label class="form-check-label" for="@($"tcur_{_selectedSymbol.Id}")">Cursor</label>
                </div>
                <div class="form-check" style="font-size: 10px;">
                    <input type="checkbox" class="form-check-input" id="@($"tleg_{_selectedSymbol.Id}")"
                           checked="@_selectedSymbol.TrendShowLegend"
                           @onchange="(e) => { _selectedSymbol.TrendShowLegend = (bool)(e.Value ?? false); OnChanged(); }" />
                    <label class="form-check-label" for="@($"tleg_{_selectedSymbol.Id}")">Legend</label>
                </div>
            </div>
        }

        @if (_selectedSymbol.Type is "switch")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #34c759;">🔀 Toggle Switch Settings</h6>

            <div class="mb-2">
                <label class="form-label mb-0 small">Style</label>
                <select class="form-select form-select-sm" style="font-size: 10px;"
                        @bind="_selectedSymbol.SwitchStyle" @bind:after="OnChanged">
                    <option value="apple">Apple (iOS pill)</option>
                    <option value="flat">Flat (minimal)</option>
                </select>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">ON Color</label>
                    <ColorPicker Value="@(_selectedSymbol.SwitchOnColor)" ValueChanged="(v) => { _selectedSymbol.SwitchOnColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">OFF Color</label>
                    <ColorPicker Value="@(_selectedSymbol.SwitchOffColor)" ValueChanged="(v) => { _selectedSymbol.SwitchOffColor = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>
            <div class="form-text" style="font-size: 9px;">Bind a boolean variable. The switch toggles on click when a ToggleVariable command is configured.</div>
        }

        @if (_selectedSymbol.Type is "rotaryswitch")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #f59e0b;">🎛️ Rotary Switch Settings</h6>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Positions</label>
                    <input type="number" class="form-control form-control-sm" style="width: 55px; font-size: 10px;"
                           min="2" max="12"
                           @bind="_selectedSymbol.SwitchPositions" @bind:after="OnChanged" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label mb-0 small">Position Labels</label>
                <input type="text" class="form-control form-control-sm" style="font-size: 10px;"
                       placeholder="Off,Low,Med,High"
                       @bind="_selectedSymbol.SwitchPositionLabels" @bind:after="OnChanged" />
                <div class="form-text" style="font-size: 9px;">Comma-separated. Fewer labels than positions → indices used.</div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Knob</label>
                    <ColorPicker Value="@(_selectedSymbol.SwitchKnobColor)" ValueChanged="(v) => { _selectedSymbol.SwitchKnobColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Dial</label>
                    <ColorPicker Value="@(_selectedSymbol.SwitchDialColor)" ValueChanged="(v) => { _selectedSymbol.SwitchDialColor = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>
            <div class="form-text" style="font-size: 9px;">Bind a numeric variable (0 to N−1). Use IncrementVariable command with wrapping, or WriteVariable per position.</div>
        }


        @if (_selectedSymbol.Type is "knob")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #ff6b35;">🎚️ Knob Settings</h6>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Min</label>
                    <input type="number" class="form-control form-control-sm" style="width: 70px;"
                           @bind="_selectedSymbol.MinValue" @bind:after="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Max</label>
                    <input type="number" class="form-control form-control-sm" style="width: 70px;"
                           @bind="_selectedSymbol.MaxValue" @bind:after="OnChanged" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Knob</label>
                    <ColorPicker Value="@(_selectedSymbol.KnobColor)" ValueChanged="(v) => { _selectedSymbol.KnobColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Pointer</label>
                    <ColorPicker Value="@(_selectedSymbol.KnobPointerColor)" ValueChanged="(v) => { _selectedSymbol.KnobPointerColor = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div class="form-check form-check-inline small">
                    <input class="form-check-input" type="checkbox" @bind="_selectedSymbol.KnobShowScale" @bind:after="OnChanged" />
                    <label class="form-check-label">Scale</label>
                </div>
                <div class="form-check form-check-inline small">
                    <input class="form-check-input" type="checkbox" @bind="_selectedSymbol.KnobShowValue" @bind:after="OnChanged" />
                    <label class="form-check-label">Value</label>
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label mb-0 small">Unit</label>
                <input type="text" class="form-control form-control-sm" style="width: 80px;"
                       @bind="_selectedSymbol.KnobUnit" @bind:after="OnChanged" placeholder="e.g. %" />
            </div>

            <div class="form-text" style="font-size: 9px;">Bind a numeric variable. Drag the knob to set the value interactively at runtime. Uses WriteVariable command.</div>
        }

        @if (_selectedSymbol.Type is "hslider" or "vslider")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #3b82f6;">@(_selectedSymbol.Type == "hslider" ? "↔️" : "↕️") Slider Settings</h6>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Min</label>
                    <input type="number" class="form-control form-control-sm" style="width: 70px;"
                           @bind="_selectedSymbol.MinValue" @bind:after="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Max</label>
                    <input type="number" class="form-control form-control-sm" style="width: 70px;"
                           @bind="_selectedSymbol.MaxValue" @bind:after="OnChanged" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Track</label>
                    <ColorPicker Value="@(_selectedSymbol.SliderTrackColor)" ValueChanged="(v) => { _selectedSymbol.SliderTrackColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Fill</label>
                    <ColorPicker Value="@(_selectedSymbol.SliderFillColor)" ValueChanged="(v) => { _selectedSymbol.SliderFillColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Thumb</label>
                    <ColorPicker Value="@(_selectedSymbol.SliderThumbColor)" ValueChanged="(v) => { _selectedSymbol.SliderThumbColor = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div class="form-check form-check-inline small">
                    <input class="form-check-input" type="checkbox" @bind="_selectedSymbol.SliderShowValue" @bind:after="OnChanged" />
                    <label class="form-check-label">Value</label>
                </div>
                <div class="form-check form-check-inline small">
                    <input class="form-check-input" type="checkbox" @bind="_selectedSymbol.SliderShowTicks" @bind:after="OnChanged" />
                    <label class="form-check-label">Ticks</label>
                </div>
            </div>

            <div class="form-text" style="font-size: 9px;">Bind a numeric variable. Drag the thumb to set the value interactively at runtime. Uses WriteVariable command.</div>
        }

        @if (_selectedSymbol.Type is "button")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #3b82f6;">🔲 Button Settings</h6>

            <div class="mb-2">
                <label class="form-label mb-0 small">Style</label>
                <select class="form-select form-select-sm" style="font-size: 10px;"
                        @bind="_selectedSymbol.ButtonStyle" @bind:after="OnChanged">
                    <option value="raised">Raised (3D gradient)</option>
                    <option value="flat">Flat (solid fill)</option>
                    <option value="outline">Outline (border only)</option>
                    <option value="pill">Pill (capsule)</option>
                    <option value="glass">Glass (frosted)</option>
                    <option value="danger">Danger (red)</option>
                    <option value="success">Success (green)</option>
                    <option value="warning">Warning (amber)</option>
                    <option value="icon">Icon (compact)</option>
                </select>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Color</label>
                    <ColorPicker Value="@(_selectedSymbol.ButtonColor)" ValueChanged="(v) => { _selectedSymbol.ButtonColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Text</label>
                    <ColorPicker Value="@(_selectedSymbol.ButtonTextColor)" ValueChanged="(v) => { _selectedSymbol.ButtonTextColor = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Radius</label>
                    <input type="number" class="form-control form-control-sm" style="width: 55px; font-size: 10px;"
                           min="0" max="999"
                           @bind="_selectedSymbol.ButtonBorderRadius" @bind:after="OnChanged" />
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div class="flex-grow-1">
                    <label class="form-label mb-0 small">Icon</label>
                    <input type="text" class="form-control form-control-sm" style="font-size: 10px;"
                           placeholder="e.g. ▶, ⏹, ⚙️, 🔄"
                           @bind="_selectedSymbol.ButtonIcon" @bind:after="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Position</label>
                    <select class="form-select form-select-sm" style="font-size: 10px; width: 80px;"
                            @bind="_selectedSymbol.ButtonIconPosition" @bind:after="OnChanged">
                        <option value="left">Left</option>
                        <option value="right">Right</option>
                        <option value="top">Top</option>
                        <option value="center">Center</option>
                    </select>
                </div>
            </div>

            <div class="form-text" style="font-size: 9px;">Add commands (Click, WhilePressed, etc.) to define button actions. Use Label for button text.</div>
        }
        @if (_selectedSymbol.Type is "animtext")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #f59e0b;">🎬 Animated Text Settings</h6>

            <div class="mb-2">
                <label class="form-label mb-0 small">Animation Mode</label>
                <select class="form-select form-select-sm" style="font-size: 10px;"
                        @bind="_selectedSymbol.AnimTextMode" @bind:after="OnChanged">
                    <option value="scroll">Scroll (marquee)</option>
                    <option value="flash">Flash (color alternation)</option>
                    <option value="pulse">Pulse (opacity)</option>
                    <option value="typewriter">Typewriter</option>
                    <option value="fade">Fade (crossfade messages)</option>
                </select>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Speed (sec)</label>
                    <input type="number" class="form-control form-control-sm" style="width: 65px; font-size: 10px;"
                           min="0.5" max="60" step="0.5"
                           @bind="_selectedSymbol.AnimTextSpeed" @bind:after="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Radius</label>
                    <input type="number" class="form-control form-control-sm" style="width: 55px; font-size: 10px;"
                           min="0" max="50"
                           @bind="_selectedSymbol.AnimTextBorderRadius" @bind:after="OnChanged" />
                </div>
                <div class="d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="atBorder"
                               @bind="_selectedSymbol.AnimTextShowBorder" @bind:after="OnChanged" />
                        <label class="form-check-label small" for="atBorder">Border</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Text Color 1</label>
                    <ColorPicker Value="@(_selectedSymbol.Fill)" ValueChanged="(v) => { _selectedSymbol.Fill = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">Text Color 2</label>
                    <ColorPicker Value="@(_selectedSymbol.AnimTextColor2)" ValueChanged="(v) => { _selectedSymbol.AnimTextColor2 = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">BG 1</label>
                    <ColorPicker Value="@(_selectedSymbol.AnimTextBackground)" ValueChanged="(v) => { _selectedSymbol.AnimTextBackground = v; }" OnAfterChange="OnChanged" />
                </div>
                <div>
                    <label class="form-label mb-0 small">BG 2</label>
                    <ColorPicker Value="@(_selectedSymbol.AnimTextBackground2)" ValueChanged="(v) => { _selectedSymbol.AnimTextBackground2 = v; }" OnAfterChange="OnChanged" />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label mb-0 small">Messages (one per line, use @@StringId for localization)</label>
                <textarea class="form-control form-control-sm" rows="4"
                          style="font-size: 10px; font-family: monospace;"
                          @bind="_selectedSymbol.AnimTextMessages" @bind:after="OnChanged"></textarea>
            </div>

            <div class="form-text" style="font-size: 9px;">
                If Messages is empty, the Label is used. Use @@StringId for localized strings.
                Scroll cycles through messages as a marquee. Flash alternates colors. Fade crossfades between messages.
            </div>

            <button class="btn btn-sm btn-outline-info w-100 py-0 mt-2" style="font-size: 10px;" @onclick="ToggleWidgetPreview">
                @(_widgetPreviewActive ? "\u23f9 Hide Preview" : "\u25b6 Preview Animation")
            </button>
            @if (_widgetPreviewActive)
            {
                var atMode = _selectedSymbol.AnimTextMode ?? "scroll";
                var atSpeed = _selectedSymbol.AnimTextSpeed > 0 ? _selectedSymbol.AnimTextSpeed : 5;
                var atColor1 = _selectedSymbol.Fill ?? "#e2e8f0";
                var atColor2 = _selectedSymbol.AnimTextColor2 ?? "#ff4444";
                var atBg1 = string.IsNullOrEmpty(_selectedSymbol.AnimTextBackground) ? "transparent" : _selectedSymbol.AnimTextBackground;
                var atBg2 = string.IsNullOrEmpty(_selectedSymbol.AnimTextBackground2) ? atBg1 : _selectedSymbol.AnimTextBackground2;
                var atText = !string.IsNullOrEmpty(_selectedSymbol.Label) ? _selectedSymbol.Label : "Sample Text";
                var atBr = _selectedSymbol.AnimTextBorderRadius;
                var atBorder = _selectedSymbol.AnimTextShowBorder ? $"border: 1px solid {atColor1};" : "";
                var atId = "atPrev";
                <div class="mt-2 rounded" style="background: #0f172a; border: 1px solid #334155; padding: 8px;">
                    <style>
                        @@keyframes @(atId)_scroll { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
                        @@keyframes @(atId)_flash { 0%,49% { color: @atColor1; background: @atBg1; } 50%,100% { color: @atColor2; background: @atBg2; } }
                        @@keyframes @(atId)_pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }
                        @@keyframes @(atId)_type { from { width: 0; } to { width: @(atText.Length)ch; } }
                        @@keyframes @(atId)_blink { 50% { border-color: transparent; } }
                    </style>
                    <div style="overflow: hidden; border-radius: @(atBr)px; @atBorder background: @atBg1; padding: 4px; font-size: 13px; font-weight: bold;">
                        @switch (atMode)
                        {
                            case "scroll":
                                <div style="white-space: nowrap; animation: @(atId)_scroll @(Fmt(atSpeed))s linear infinite; color: @atColor1;">@atText</div>
                                break;
                            case "flash":
                                <div style="text-align: center; animation: @(atId)_flash @(Fmt(atSpeed))s step-end infinite; color: @atColor1;">@atText</div>
                                break;
                            case "pulse":
                                <div style="text-align: center; animation: @(atId)_pulse @(Fmt(atSpeed))s ease-in-out infinite; color: @atColor1;">@atText</div>
                                break;
                            case "typewriter":
                                <div style="overflow: hidden; white-space: nowrap; border-right: 2px solid @atColor1; width: 0; color: @atColor1; animation: @(atId)_type @(Fmt(atSpeed))s steps(@atText.Length) infinite, @(atId)_blink 0.7s step-end infinite;">@atText</div>
                                break;
                            case "fade":
                                <div style="text-align: center; animation: @(atId)_pulse @(Fmt(atSpeed))s ease-in-out infinite; color: @atColor1;">@atText</div>
                                break;
                        }
                    </div>
                </div>
            }
        }
        @if (_selectedSymbol.Type is "eventlog")
        {
            <hr class="my-2" />
            <h6 class="mb-2 small" style="color: #94a3b8;">📓 Event Log Settings</h6>

            <div class="d-flex gap-1 mb-2">
                <div>
                    <label class="form-label mb-0 small">Time Range</label>
                    <select class="form-select form-select-sm" style="font-size: 10px;"
                            @bind="_selectedSymbol.EventLogTimeRangeMinutes" @bind:after="OnChanged">
                        <option value="5">5 min</option>
                        <option value="15">15 min</option>
                        <option value="60">1 hour</option>
                        <option value="360">6 hours</option>
