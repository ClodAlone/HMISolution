    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChangedAsync;
        if (Session.IsInitialized) return;
        Session.IsInitialized = true;
        _ollamaUrl = AiService.OllamaBaseUrl;
        _sampleFiles = AiService.GetSampleFiles(DefaultSamplesPath);
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", RecentPromptsKey);
            if (!string.IsNullOrEmpty(stored))
            {
                _recentPrompts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(stored) ?? new();
            }
        }
        catch
        {
            // ignore storage errors (e.g. prerendering)
        }
    }

    private Task OnSessionChangedAsync() => InvokeAsync(StateHasChanged);

    private Task RefreshSessionAsync() => Session.NotifyChangedAsync();

    public void Dispose()
    {
        Session.Changed -= OnSessionChangedAsync;
    }

    private void ToggleSuggestions()
    {
        _showSuggestions = !_showSuggestions;
    }

    private void SelectSuggestion(string text)
    {
        if (_isProcessing) return;
        _prompt = text;
        _selectedTaskId = "";
        _showSuggestions = false;
        if (CommonPrompts.Contains(text) || text.Contains(AiTaskCatalog.CommonInstructions, StringComparison.Ordinal))
            OnResourceOnlyChanged(new ChangeEventArgs { Value = false });
        else if (text.Contains(AiTaskCatalog.ResourceInstructions, StringComparison.Ordinal))
            OnResourceOnlyChanged(new ChangeEventArgs { Value = true });
    }

    private void OnTaskChanged(ChangeEventArgs e)
    {
        if (_isProcessing) return;
        var id = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(id))
        {
            _selectedTaskId = "";
            return;
        }

        var task = AiTaskCatalog.Tasks.FirstOrDefault(task => task.Id == id);
        if (task == null)
        {
            _aiError = "The selected common task is not available. Choose another task.";
            return;
        }

        _selectedTaskId = task.Id;
        _resourceOnly = task.CreatesResources;
        _prompt = task.Prompt + "\n\n" + (_resourceOnly ? AiTaskCatalog.ResourceInstructions : AiTaskCatalog.CommonInstructions);
        _scopePath = "";
        _chunkedMode = false;
        _resourceJson = "";
        _showSuggestions = false;
        _aiError = "";
        _aiComments = "";
        if (!_resourceOnly) RefreshFolderScopes();
    }

    private void LoadTaskTemplate()
    {
        if (_isProcessing) return;
        var task = AiTaskCatalog.Tasks.FirstOrDefault(task => task.Id == _selectedTaskId);
        var template = task?.ResourceBundle;
        if (template == null)
        {
            _aiError = "The selected task has no built-in resource template.";
            return;
        }
        if (ResourceProject == null || ResourceProject.IsLocked)
        {
            _aiError = "Select and unlock a target project before loading sample resources.";
            return;
        }
        _resourceOnly = true;
        _scopePath = "";
        _chunkedMode = false;
        _resourceTarget = ResourceProject;
        _resourceJson = template;
        _aiError = "";
        _aiComments = $"Exact sample for '{task!.Title}' loaded locally, not imported. Review the bundle, then Add resources. Review and enable the imported simulation script, save the project, and run the server and viewer. Existing project settings and startup screen are preserved.";
    }

    private void OnResourceOnlyChanged(ChangeEventArgs e)
    {
        if (_isProcessing) return;
        _resourceOnly = e.Value is true;
        _scopePath = "";
        _chunkedMode = false;
        _resourceJson = "";
        if (!_resourceOnly) RefreshFolderScopes();
    }

    private Task ImportResources()
    {
        if (_isProcessing || !OnImportResources.HasDelegate)
        {
            _aiError = _isProcessing ? "Wait for generation to complete before adding resources." : "Resource import is not available in this editor.";
            return Task.CompletedTask;
        }
        if (_resourceTarget == null || _resourceTarget != ResourceProject || _resourceTarget.IsLocked)
        {
            _aiError = "Select and unlock the original target project before adding these resources.";
            return Task.CompletedTask;
        }
        return OnImportResources.InvokeAsync(new AiResourceImportRequest(_resourceTarget, _resourceJson));
    }

    public void ShowResourceImportResult(bool success, string message)
    {
        _aiError = success ? "" : message;
        if (success)
        {
            _resourceJson = "";
            _jsonNeedsRefresh = true;
            _aiComments = message;
        }
        ShowMessage(success, message);
    }

    private async Task RemoveRecent(string text)
    {
        _recentPrompts.Remove(text);
        await SaveRecentPrompts();
    }

    private async Task SaveRecentPrompts()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_recentPrompts);
            await JS.InvokeVoidAsync("localStorage.setItem", RecentPromptsKey, json);
        }
        catch
        {
            // ignore storage errors
        }
    }

    private async Task RememberPrompt(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        _recentPrompts.RemoveAll(p => string.Equals(p, text, StringComparison.OrdinalIgnoreCase));
        _recentPrompts.Insert(0, text);
        if (_recentPrompts.Count > MaxRecentPrompts)
            _recentPrompts = _recentPrompts.Take(MaxRecentPrompts).ToList();
        await SaveRecentPrompts();
    }

    private async Task OnJsonChanged()
    {
        await JsonTextChanged.InvokeAsync(JsonText);
    }

    private async Task Refresh()
    {
        _message = "";
        await OnRefresh.InvokeAsync();
        _jsonNeedsRefresh = false;
    }

    private async Task Apply()
    {
        if (_jsonNeedsRefresh)
        {
            _aiError = "Refresh from Tree before applying full JSON edits; new resources have been added.";
            return;
        }
        await OnApply.InvokeAsync();
    }

    public void ShowMessage(bool success, string message)
    {
        _success = success;
        _message = message;
    }

