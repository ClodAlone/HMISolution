@using ServerEditorWeb.Services
@using ServerEditorWeb.Models
@inject IJSRuntime JS
@implements IDisposable

<div class="json-editor-panel d-flex flex-column">
    <div class="d-flex gap-2 mb-2" style="order:2;">
        <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh">&#x27F3; Refresh from Tree</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="Apply" disabled="@_jsonNeedsRefresh">&#x2714; Apply to Tree</button>
        @if (_jsonNeedsRefresh)
        {
            <span class="small text-warning">New resources were added. Refresh from Tree before applying full JSON edits.</span>
        }
    </div>
    <div style="order:3;">
        <CodeEditor @bind-Value="JsonText" @bind-Value:after="OnJsonChanged" Language="json" Height="@(_aiExpanded ? "calc(100vh - 520px)" : "calc(100vh - 260px)")" />
    </div>
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="mt-2 alert @(_success ? "alert-success" : "alert-danger")" style="order:4;">@_message</div>
    }

    @* -- AI Assistant (pinned to top of panel) -- *@
    <div class="mb-2 border-bottom pb-2" style="order:1;">
        <div class="d-flex align-items-center gap-2" @onclick="() => _aiExpanded = !_aiExpanded" style="cursor:pointer;">
            <span style="font-size: 12px;">@(_aiExpanded ? "▼" : "▶")</span>
            <strong style="font-size: 13px;">&#x1F916; AI Assistant</strong>
        </div>

        @if (_aiExpanded)
        {
            <div class="mt-2">
                <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                    <select class="form-select form-select-sm" style="width:120px;" @bind="_selectedEngine">
                        @foreach (var engine in AiService.AvailableEngines)
                        {
                            <option value="@engine">@engine</option>
                        }
                    </select>
                    @if (_selectedEngine == "OpenAI")
                    {
                        <select class="form-select form-select-sm" style="width:150px;"
                                value="@AiService.OpenAiModel"
                                @onchange="OnOpenAiModelChanged"
                                title="OpenAI model (lower TPM models like gpt-4o have small rate limits)">
                            @foreach (var m in AiService.OpenAiModels)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    }
                    else if (_selectedEngine == "Claude")
                    {
                        <select class="form-select form-select-sm" style="width:200px;"
                                value="@AiService.ClaudeModel"
                                @onchange="OnClaudeModelChanged"
                                title="Anthropic Claude model. Older dated snapshots may be retired; prefer '-latest' aliases.">
                            @foreach (var m in AiService.ClaudeModels)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    }
                </div>

                <label class="small d-flex align-items-center gap-2 mb-2">
                    <input type="checkbox" class="form-check-input" checked="@_resourceOnly"
                           @onchange="OnResourceOnlyChanged" disabled="@_isProcessing" />
                    Generate new resources only (does not send or replace the current project)
                </label>
                <div class="d-flex gap-1 align-items-center mb-2">
                    <label class="small text-muted text-nowrap mb-0" style="min-width:90px;">Edit scope:</label>
                    <select class="form-select form-select-sm flex-grow-1" disabled="@(_resourceOnly || _isProcessing)"
                            @bind="_scopePath"
                            title="Restrict the edit to a folder subtree or a top-level section (Screens, Scripts, etc.). Only that slice is sent to the AI; the rest is preserved locally.">
                        <option value="">@(_resourceOnly ? "-- New resources only (current project not sent) --" : "-- Whole project (sends full JSON) --")</option>
                        @foreach (var s in _folderScopes)
                        {
                            <option value="@s.Key">@s.Label</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_resourceOnly || _isProcessing)" title="Refresh scope list from the current JSON" @onclick="RefreshFolderScopes">&#x27F3;</button>
                    @if (_scopePath.StartsWith("folder:"))
                    {
                        <label class="d-flex align-items-center gap-1 m-0 small text-nowrap"
                               title="Ask the AI to return only NEW items (fast). Turn off if you also need to modify or delete existing items in the subtree.">
                            <input type="checkbox" class="form-check-input m-0" @bind="_additionsOnly" />
                            Additions only (fast)
                        </label>
                    }
                </div>

                <div class="d-flex gap-1 align-items-center mb-2">
                    <label class="small text-muted text-nowrap mb-0" style="min-width:90px;">Reference file:</label>
                    <select class="form-select form-select-sm flex-grow-1"
                            value="@_selectedSamplePath"
                            @onchange="OnSampleChanged">
                        <option value="">-- No reference file --</option>
                        @foreach (var group in _sampleFiles.GroupBy(f => f.Group))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var (name, path, _) in group)
                                {
                                    <option value="@path">@name</option>
                                }
                            </optgroup>
                        }
                        @if (!string.IsNullOrEmpty(_customFilePath))
                        {
                            <optgroup label="Custom File">
                                <option value="@_customFilePath">@System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(_customFilePath))/@System.IO.Path.GetFileName(_customFilePath)</option>
                            </optgroup>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-secondary" title="Browse for a custom file" @onclick="BrowseCustomFile">
                        &#x1F4C1;
                    </button>
                    @if (!string.IsNullOrEmpty(_selectedSamplePath))
                    {
                        <span class="badge bg-success text-nowrap" style="font-size: 10px;">&#x2713; loaded</span>
                        <button class="btn btn-link btn-sm p-0 text-nowrap" style="font-size: 10px;" @onclick="PreviewReference">Preview</button>
                        <button class="btn btn-link btn-sm p-0 text-danger text-nowrap" style="font-size: 10px;" @onclick="ClearReference">Clear</button>
                    }
                </div>

                @if (_selectedEngine == "Ollama")
                {
                    <div class="mb-2 p-2 border rounded bg-body-secondary" style="font-size: 12px;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <label class="text-nowrap"><strong>Model:</strong></label>
                            <select class="form-select form-select-sm" style="width:160px;" @bind="_ollamaModel">
                                @if (_ollamaModels.Length == 0)
                                {
                                    <option value="@_ollamaModel">@_ollamaModel</option>
                                }
                                @foreach (var m in _ollamaModels)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary px-2" title="Refresh model list" @onclick="RefreshOllamaModels">&#x27F3;</button>
                            <label class="text-nowrap ms-2"><strong>URL:</strong></label>
                            <input type="text" class="form-control form-control-sm" style="width:200px;" @bind="_ollamaUrl" placeholder="http://localhost:11434" />
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="text-nowrap"><strong>Train folder:</strong></label>
                            <input type="text" class="form-control form-control-sm" @bind="_trainFolder" placeholder="C:\Work\samples" />
                            <button class="btn btn-sm btn-warning px-2" @onclick="TrainOllama" disabled="@(AiService.IsTraining)">
                                @if (AiService.IsTraining)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                &#x1F9E0; Train
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(AiService.TrainingStatus))
                        {
                            <div class="mt-1 small text-muted"><em>@AiService.TrainingStatus</em></div>
                        }
                    </div>
                }

                @if (_showPreview && !string.IsNullOrEmpty(_referencePreview))
                {
                    <div class="mb-2 p-2 border rounded" style="max-height: 150px; overflow-y: auto; font-size: 10px; font-family: monospace; background: #1e1e1e; color: #d4d4d4;">
                        <pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">@_referencePreview</pre>
                    </div>
                }

                @if (_showBrowse)
                {
                    <div class="mb-2 p-2 border rounded bg-body-secondary">
                        <div class="d-flex gap-1">
                            <input type="text" class="form-control form-control-sm" @bind="_browseInput"
                                   placeholder="C:\path\to\file" />
                            <button class="btn btn-sm btn-primary" @onclick="ConfirmBrowse">OK</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showBrowse = false">X</button>
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 align-items-center flex-wrap mb-2" style="font-size:11px;">
                    <label class="d-flex align-items-center gap-1 m-0">
                        <input type="checkbox" class="form-check-input m-0" checked="@AiService.CompactJsonBeforeSend"
                               @onchange="OnCompactChanged" />
                        Compact JSON (saves ~30%)
                    </label>
                    <label class="d-flex align-items-center gap-1 m-0">
                        Max ref chars:
                        <input type="number" class="form-control form-control-sm" style="width:90px;" step="10000" min="1000"
                               value="@AiService.MaxReferenceChars"
                               @onchange="OnMaxRefChanged" />
                    </label>
                    <label class="d-flex align-items-center gap-1 m-0"
                           title="Split large reference files into multiple sequential AI calls. Only takes effect when a reference file is selected and its size exceeds the chunk size.">
                        <input type="checkbox" class="form-check-input m-0" checked="@_chunkedMode"
                               @onchange="OnChunkedChanged" disabled="@(_resourceOnly || _isProcessing)" />
                        Chunked import
                    </label>
                    @if (_chunkedMode)
                    {
                        <label class="d-flex align-items-center gap-1 m-0">
                            Chunk chars:
                            <input type="number" class="form-control form-control-sm" style="width:90px;" step="5000" min="2000"
                                   @bind="_chunkChars" @bind:event="onchange" />
                        </label>
                        @if (!string.IsNullOrEmpty(_selectedSamplePath))
                        {
                            <span class="text-muted">→ @_estimatedChunks chunk(s)</span>
                        }
                        else
                        {
                            <span class="text-warning">(select a reference file to activate)</span>
                        }
                    }
                </div>

                <div class="mb-2">
                    <label for="json-ai-common-task" class="small fw-semibold">Common task</label>
                    <select id="json-ai-common-task" class="form-select form-select-sm" value="@_selectedTaskId"
                            @onchange="OnTaskChanged" disabled="@_isProcessing">
                        <option value="">-- Choose a task, then customize the request --</option>
                        @foreach (var category in AiTaskCatalog.Tasks.GroupBy(task => task.Category))
                        {
                            <optgroup label="@category.Key">
                                @foreach (var task in category)
                                {
                                    <option value="@task.Id">@task.Title</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <div class="small text-muted mt-1">Customize the request below. Enter adds a line; Ctrl+Enter (Cmd+Enter on Mac) sends it.</div>
                    @if (!string.IsNullOrEmpty(_selectedTaskId))
                    {
                        <div class="small text-muted mt-1" role="status">
                            Task loaded, not sent. @(_resourceOnly ? "Resource-only generation selected; review the bundle, then Add resources." : "Whole-project scope selected to edit existing resources.")
                            Edit names, paths, and values below, review any selected reference file, then click Ask AI.
                            Executable demo resources are requested disabled for review.
                        </div>
                        @if (AiTaskCatalog.Tasks.FirstOrDefault(task => task.Id == _selectedTaskId)?.ResourceBundle != null)
                        {
                            <button class="btn btn-sm btn-outline-success mt-1" @onclick="LoadTaskTemplate"
                                    disabled="@(_isProcessing || ResourceProject == null || ResourceProject.IsLocked)">
                                Load exact sample resources
                            </button>
                            <div class="small text-muted mt-1">No AI call needed. Loads the built-in sample into the editable preview below; it does not apply request customizations. Review it, then Add resources. Enable the simulation script after review.</div>
                        }
                    }
                    @if (_resourceOnly)
                    {
                        <div class="small text-muted mt-1">
                            Variables are added inside a fresh AI_Task folder. Other resource names get the same unique prefix;
                            scripts, PLC programs, and screens also get an editor group. Internal references are updated together.
                            The __TASK__ placeholder in the preview is replaced only when you add the resources.
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_resourceJson))
                    {
                        <label class="small fw-semibold mt-2" for="json-ai-resource-preview">New resource bundle (editable preview)</label>
                        <textarea id="json-ai-resource-preview" class="form-control form-control-sm font-monospace"
                                  rows="10" @bind="_resourceJson" @bind:event="oninput" disabled="@_isProcessing"></textarea>
                        <button class="btn btn-sm btn-success mt-1" @onclick="ImportResources"
                                disabled="@(_isProcessing || _resourceTarget != ResourceProject || ResourceProject == null || ResourceProject.IsLocked)">
                            Add resources to @(_resourceTarget?.Name)
                        </button>
                        @if (_resourceTarget != ResourceProject)
                        {
                            <div class="small text-warning">The target project changed. Return to the original project or generate a new bundle.</div>
                        }
                    }
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" type="button" title="Recent &amp; common prompts"
                                @onclick="ToggleSuggestions">🕘</button>
                        @if (_showSuggestions)
                        {
                            <div class="dropdown-menu show p-1" style="max-height: 300px; overflow-y: auto; font-size: 11px; min-width: 320px;">
                                @if (_recentPrompts.Count > 0)
                                {
                                    <h6 class="dropdown-header">Recent</h6>
                                    @foreach (var p in _recentPrompts)
                                    {
                                        <div class="d-flex align-items-center">
                                            <button class="dropdown-item text-truncate" style="max-width: 260px;" type="button" title="@p" @onclick="() => SelectSuggestion(p)">@p</button>
                                            <button class="btn btn-sm btn-link text-danger p-0 px-1" type="button" title="Remove" @onclick="() => RemoveRecent(p)">✕</button>
                                        </div>
                                    }
                                    <div class="dropdown-divider"></div>
                                }
                                <h6 class="dropdown-header">Common Commands</h6>
                                @foreach (var p in CommonPrompts)
                                {
                                    <button class="dropdown-item" type="button" @onclick="() => SelectSuggestion(p)">@p</button>
                                }
                            </div>
                        }
                    </div>
                    <textarea class="form-control form-control-sm flex-grow-1" @bind="_prompt"
                              @bind:event="oninput" rows="5" aria-label="AI task request" disabled="@_isProcessing"
                              @onkeydown="OnPromptKeyDown"
                              placeholder="@(_selectedSamplePath != "" ? "e.g. Import all variables from the reference..." : "Describe what you want the AI to do...")"></textarea>
                    @{
                        int jsonCharsEstimate;
                        if (_resourceOnly)
                        {
                            jsonCharsEstimate = AiService.BuildResourceBundlePrompt("").Length;
                        }
                        else if (!string.IsNullOrEmpty(_scopePath))
                        {
                            var scope = _folderScopes.FirstOrDefault(s => s.Key == _scopePath);
                            jsonCharsEstimate = scope.ApproxChars + _folderScopes.Count * 40; // subtree + outline overhead
                        }
                        else
                        {
                            jsonCharsEstimate = AiService.CompactJsonBeforeSend ? (int)(JsonText.Length * 0.65) : JsonText.Length;
                        }
                        var refCharsEstimate = _chunkedMode
                            ? Math.Min(_referenceCharCount, _chunkChars)
                            : Math.Min(_referenceCharCount, AiService.MaxReferenceChars);
                        var estTokens = (jsonCharsEstimate + refCharsEstimate + _prompt.Length) / 4;
                        var (tokLimit, tokEngineHint) = _selectedEngine switch
                        {
                            "OpenAI" when AiService.OpenAiModel.Contains("mini") => (200_000, "gpt-4o-mini TPM 200 K"),
                            "OpenAI" => (30_000, "gpt-4o TPM 30 K"),
                            "Claude" => (200_000, "Claude context 200 K"),
                            "Gemini" => (1_000_000, "Gemini context 1 M"),
                            _ => (128_000, "local model")
                        };
                        var overLimit = estTokens > tokLimit;
                        var tokenClass = overLimit ? "text-danger fw-bold" : (estTokens > tokLimit * 0.8 ? "text-warning" : "text-muted");
                        var suffix = !string.IsNullOrEmpty(_scopePath) ? "/scoped" : (_chunkedMode ? "/chunk" : "");
                    }
                    <span class="small @tokenClass text-nowrap"
                          title="Estimated input tokens (chars/4) for this @(!string.IsNullOrEmpty(_scopePath) ? "scoped edit" : (_chunkedMode ? "chunk" : "request")). Limit: @tokLimit.ToString("N0") (@tokEngineHint).">
                        ~@estTokens.ToString("N0") / @tokLimit.ToString("N0") tok@suffix
                    </span>
                    <button class="btn btn-sm btn-primary" @onclick="Ask"
                            disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_prompt) || overLimit)"
                            title="@(overLimit ? "Estimated tokens exceed the selected model's limit — shrink reference or split the request." : "")">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Ask AI
                    </button>
                    @if (_isProcessing)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="CancelStreaming" title="Stop generation">&#x25A0;</button>
                    }
                </div>

                @if (_isProcessing || _streamCharCount > 0)
                {
                    <div class="mt-2 p-2 border rounded position-relative" style="background:#0f1420; color:#d4d4d4;">
                        <button class="btn btn-sm btn-outline-light position-absolute" style="top:4px; right:4px; padding:2px 6px; font-size:10px;"
                                title="Copy status + stream content" @onclick="CopyStatusPanel">
                            @if (_copyStatusMsg == "copied") { <span>&#x2714; Copied</span> } else { <span>&#x1F4CB; Copy</span> }
                        </button>
                        <div class="d-flex flex-wrap gap-3 mb-1" style="font-size:11px; padding-right:70px;">
                            <span>
                                <strong>Streaming:</strong>
                                @if (_isProcessing) { <span class="text-info">live</span> } else { <span class="text-success">done</span> }
                            </span>
                            @if (_totalChunks > 1)
                            {
                                <span class="text-warning"><strong>Chunk:</strong> @_currentChunk / @_totalChunks</span>
                            }
                            <span><strong>Chars:</strong> @_streamCharCount</span>
                            <span><strong>Elapsed:</strong> @_streamElapsed.TotalSeconds.ToString("F1")s</span>
                            <span class="text-success"><strong>+@_diffStats.Added</strong> lines</span>
                            <span class="text-danger"><strong>-@_diffStats.Removed</strong> lines</span>
                            <span class="text-muted">@_diffStats.Unchanged unchanged</span>
                        </div>
                        <pre class="mb-0" style="max-height:180px; overflow:auto; font-size:10px; font-family:monospace; white-space:pre-wrap; word-break:break-all;">@_streamTail</pre>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_aiComments))
                {
                    <div class="mt-2 alert alert-info py-1 small d-flex align-items-start gap-2">
                        <div class="flex-grow-1"><strong>AI:</strong> @_aiComments</div>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size:10px;"
                                title="Copy AI comments" @onclick="() => CopyText(_aiComments, nameof(_aiComments))">
                            @if (_copyStatusMsg == nameof(_aiComments)) { <span>&#x2714;</span> } else { <span>&#x1F4CB;</span> }
                        </button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_aiError))
                {
                    <div class="mt-2 alert alert-danger py-1 small d-flex align-items-start gap-2">
                        <div class="flex-grow-1" style="white-space:pre-wrap; word-break:break-word;">@_aiError</div>
                        <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:10px;"
                                title="Copy error text" @onclick="() => CopyText(_aiError, nameof(_aiError))">
                            @if (_copyStatusMsg == nameof(_aiError)) { <span>&#x2714; Copied</span> } else { <span>&#x1F4CB; Copy</span> }
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string JsonText { get; set; } = "";
    [Parameter] public EventCallback<string> JsonTextChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<(bool success, string message)> OnApply { get; set; }
    [Parameter] public EventCallback<string> OnAiJsonResult { get; set; }
    [Parameter] public ProjectNode? ResourceProject { get; set; }
    [Parameter] public EventCallback<AiResourceImportRequest> OnImportResources { get; set; }
    [Parameter] public JsonEditorSession Session { get; set; } = new();

    [Inject] private AiService AiService { get; set; } = default!;

    private bool _resourceOnly { get => Session.ResourceOnly; set => Session.ResourceOnly = value; }
    private bool _jsonNeedsRefresh { get => Session.JsonNeedsRefresh; set => Session.JsonNeedsRefresh = value; }
    private string _resourceJson { get => Session.ResourceJson; set => Session.ResourceJson = value; }
    private ProjectNode? _resourceTarget { get => Session.ResourceTarget; set => Session.ResourceTarget = value; }
    private string _message { get => Session.Message; set => Session.Message = value; }
    private bool _success { get => Session.Success; set => Session.Success = value; }
    private bool _aiExpanded { get => Session.AiExpanded; set => Session.AiExpanded = value; }
    private string _selectedEngine { get => Session.SelectedEngine; set => Session.SelectedEngine = value; }
    private string _prompt { get => Session.Prompt; set => Session.Prompt = value; }
    private string _aiComments { get => Session.AiComments; set => Session.AiComments = value; }
    private string _aiError { get => Session.AiError; set => Session.AiError = value; }
    private bool _isProcessing { get => Session.IsProcessing; set => Session.IsProcessing = value; }
    private List<(string Name, string Path, string Group)> _sampleFiles { get => Session.SampleFiles; set => Session.SampleFiles = value; }
    private string _selectedSamplePath { get => Session.SelectedSamplePath; set => Session.SelectedSamplePath = value; }
    private string _customFilePath { get => Session.CustomFilePath; set => Session.CustomFilePath = value; }
    private string _referencePreview { get => Session.ReferencePreview; set => Session.ReferencePreview = value; }
    private bool _showPreview { get => Session.ShowPreview; set => Session.ShowPreview = value; }
    private bool _showBrowse { get => Session.ShowBrowse; set => Session.ShowBrowse = value; }
    private string _browseInput { get => Session.BrowseInput; set => Session.BrowseInput = value; }
    private string _ollamaModel { get => Session.OllamaModel; set => Session.OllamaModel = value; }
    private string _ollamaUrl { get => Session.OllamaUrl; set => Session.OllamaUrl = value; }
    private string[] _ollamaModels { get => Session.OllamaModels; set => Session.OllamaModels = value; }
    private string _trainFolder { get => Session.TrainFolder; set => Session.TrainFolder = value; }
    private CancellationTokenSource? _streamCts { get => Session.StreamCts; set => Session.StreamCts = value; }
    private int _streamCharCount { get => Session.StreamCharCount; set => Session.StreamCharCount = value; }
    private string _streamTail { get => Session.StreamTail; set => Session.StreamTail = value; }
    private TimeSpan _streamElapsed { get => Session.StreamElapsed; set => Session.StreamElapsed = value; }
    private SimpleJsonDiff.Stats _diffStats { get => Session.DiffStats; set => Session.DiffStats = value; }
    private DateTime _lastUiUpdateUtc { get => Session.LastUiUpdateUtc; set => Session.LastUiUpdateUtc = value; }
    private string? _copyStatusMsg { get => Session.CopyStatusMsg; set => Session.CopyStatusMsg = value; }
    private int _referenceCharCount { get => Session.ReferenceCharCount; set => Session.ReferenceCharCount = value; }
    private bool _chunkedMode { get => Session.ChunkedMode; set => Session.ChunkedMode = value; }
    private int _chunkChars { get => Session.ChunkChars; set => Session.ChunkChars = value; }
    private int _currentChunk { get => Session.CurrentChunk; set => Session.CurrentChunk = value; }
    private int _totalChunks { get => Session.TotalChunks; set => Session.TotalChunks = value; }
    private int _estimatedChunks => _referenceCharCount == 0 || _chunkChars <= 0 ? 0 : (int)Math.Ceiling(_referenceCharCount / (double)_chunkChars);
    private string _scopePath { get => Session.ScopePath; set => Session.ScopePath = value; }
    private List<AiService.ScopeEntry> _folderScopes { get => Session.FolderScopes; set => Session.FolderScopes = value; }
    private bool _additionsOnly { get => Session.AdditionsOnly; set => Session.AdditionsOnly = value; }

    private static readonly string DefaultSamplesPath = Path.Combine("C:", "Work", "samples");

    private const string RecentPromptsKey = "jsonEditor.recentPrompts";
    private const int MaxRecentPrompts = 10;
    private bool _showSuggestions { get => Session.ShowSuggestions; set => Session.ShowSuggestions = value; }
    private List<string> _recentPrompts { get => Session.RecentPrompts; set => Session.RecentPrompts = value; }
    private string _selectedTaskId { get => Session.SelectedTaskId; set => Session.SelectedTaskId = value; }

    private static readonly string[] CommonPrompts =
    {
        "Import all variables from the reference project",
