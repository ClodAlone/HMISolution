    private async Task OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !_isProcessing && !string.IsNullOrWhiteSpace(_prompt))
        {
            await Ask();
        }
    }

    private async Task Ask()
    {
        if (_isProcessing || string.IsNullOrWhiteSpace(_prompt)) return;
        var resourceOnly = _resourceOnly;
        if (!resourceOnly && _jsonNeedsRefresh)
        {
            _aiError = "Refresh from Tree before asking AI to edit the full project; new resources have been added.";
            return;
        }
        if (resourceOnly)
        {
            if (ResourceProject == null || ResourceProject.IsLocked)
            {
                _aiError = "Open and unlock a project before generating new resources.";
                return;
            }
            _resourceTarget = ResourceProject;
            _resourceJson = "";
        }

        _isProcessing = true;
        await RememberPrompt(_prompt);
        _aiComments = "";
        _aiError = "";
        _streamCharCount = 0;
        _streamTail = "";
        _diffStats = default;
        _streamElapsed = TimeSpan.Zero;
        _lastUiUpdateUtc = DateTime.MinValue;
        _currentChunk = 0;
        _totalChunks = 0;
        _streamCts?.Cancel();
        _streamCts = new CancellationTokenSource();
        var startedAt = DateTime.UtcNow;
        var originalJson = JsonText;

        try
        {
            string? referenceJson = null;
            string? referenceFileName = null;

            if (!string.IsNullOrEmpty(_selectedSamplePath))
            {
                referenceJson = AiService.ReadReferenceFile(_selectedSamplePath);
                referenceFileName = Path.GetFileName(_selectedSamplePath);
                if (resourceOnly && string.IsNullOrWhiteSpace(referenceJson))
                    throw new InvalidOperationException("The selected reference file is missing or empty. Choose a readable reference or select No reference file before generating resources.");
            }

            if (_selectedEngine == "Ollama")
            {
                AiService.OllamaModel = _ollamaModel;
                AiService.OllamaBaseUrl = _ollamaUrl;
            }

            Func<string, Task> onDelta = async accumulated =>
            {
                _streamCharCount = accumulated.Length;
                _streamElapsed = DateTime.UtcNow - startedAt;
                _streamTail = accumulated.Length > 2000
                    ? "... " + accumulated[^2000..]
                    : accumulated;

                if ((DateTime.UtcNow - _lastUiUpdateUtc).TotalMilliseconds < 250) return;
                _lastUiUpdateUtc = DateTime.UtcNow;

                if (resourceOnly)
                {
                    await RefreshSessionAsync();
                    return;
                }

                // Live JSON preview
                var isAdditionsMode =
                    (_scopePath.StartsWith("folder:") && _additionsOnly) ||
                    (_chunkedMode && !string.IsNullOrEmpty(_selectedSamplePath) && _referenceCharCount > _chunkChars);

                if (isAdditionsMode)
                {
                    var preview = AiService.BuildLiveAdditionsPreview(originalJson, accumulated);
                    if (!string.IsNullOrEmpty(preview) && preview != JsonText)
                    {
                        JsonText = preview;
                        await JsonTextChanged.InvokeAsync(preview);
                    }
                    _diffStats = SimpleJsonDiff.Compare(originalJson, preview);
                }
                else if (string.IsNullOrEmpty(_scopePath))
                {
                    // Whole-project mode: the stream itself is the new JSON — push it as it types.
                    var pending = accumulated.Split(["///COMMENTS///"], 2, StringSplitOptions.None)[0]
                        .Replace("```json", "").Replace("```", "").Trim();
                    if (pending.Length > 20 && pending.StartsWith('{') && pending != JsonText)
                    {
                        JsonText = pending;
                        await JsonTextChanged.InvokeAsync(pending);
                    }
                    _diffStats = SimpleJsonDiff.Compare(originalJson, pending);
                }
                else
                {
                    // Scoped-echo mode: partial subtree JSON — only compute diff, don't overwrite editor mid-stream.
                    var pending = accumulated.Split(["///COMMENTS///"], 2, StringSplitOptions.None)[0]
                        .Replace("```json", "").Replace("```", "");
                    _diffStats = SimpleJsonDiff.Compare(originalJson, pending);
                }

                await RefreshSessionAsync();
            };

            string newJson;
            string comments;

            if (resourceOnly)
            {
                (newJson, comments) = await AiService.AskResourcesAsync(
                    _selectedEngine, _prompt, referenceJson, referenceFileName, onDelta, _streamCts.Token);
            }
            else if (_chunkedMode && !string.IsNullOrEmpty(referenceJson) && referenceJson.Length > _chunkChars)
            {
                (newJson, comments) = await AiService.AskInChunksAsync(
                    _selectedEngine, _prompt, JsonText, referenceJson, referenceFileName,
                    _chunkChars,
                    async (currentChunk, totalChunks, _) =>
                    {
                        _currentChunk = currentChunk;
                        _totalChunks = totalChunks;
                        await RefreshSessionAsync();
                    },
                    onDelta,
                    _streamCts.Token);
            }
            else if (!string.IsNullOrEmpty(_scopePath))
            {
                if (_scopePath.StartsWith("folder:") && _additionsOnly)
                {
                    var scopePath = _scopePath["folder:".Length..];
                    (newJson, comments) = await AiService.AskFolderAdditionsAsync(
                        _selectedEngine, _prompt, JsonText, scopePath,
                        onDelta, _streamCts.Token);
                }
                else
                {
                    (newJson, comments) = await AiService.AskScopedAsync(
                        _selectedEngine, _prompt, JsonText, _scopePath,
                        onDelta, _streamCts.Token);
                }
            }
            else
            {
                (newJson, comments) = await AiService.AskStreamingAsync(
                    _selectedEngine, _prompt, JsonText, referenceJson, referenceFileName,
                    onDelta,
                    _streamCts.Token);
            }

            if (resourceOnly && !string.IsNullOrWhiteSpace(newJson))
            {
                _resourceJson = newJson;
                _aiComments = comments;
            }
            else if (!resourceOnly && !string.IsNullOrEmpty(newJson))
            {
                _aiComments = comments;
                _diffStats = SimpleJsonDiff.Compare(originalJson, newJson);

                // Propagate the final merged JSON: bind push → parent updates
                // Editor.JsonEditorText → OnAiJsonResult callback runs → tree is auto-applied.
                // Setting JsonText directly is intentional so the CodeEditor sees the
                // change on its next OnParametersSetAsync pass (Value != _lastValue).
                JsonText = newJson;
                await JsonTextChanged.InvokeAsync(newJson);
                await RefreshSessionAsync();
                await OnAiJsonResult.InvokeAsync(newJson);
            }
            else
            {
                // AI produced no usable merged JSON — restore the editor to the pre-stream state
                // so a stale streaming preview doesn't linger and confuse the user.
                if (!resourceOnly && JsonText != originalJson)
                {
                    JsonText = originalJson;
                    await JsonTextChanged.InvokeAsync(originalJson);
                }
                _aiError = string.IsNullOrEmpty(comments) ? "AI returned no changes." : comments;
            }
        }
        catch (OperationCanceledException)
        {
            _aiError = "Generation cancelled.";
        }
        catch (Exception ex)
        {
            _aiError = $"AI Error: {ex.Message}";
        }
        finally
        {
            _streamElapsed = DateTime.UtcNow - startedAt;
            _isProcessing = false;
            _streamCts?.Dispose();
            _streamCts = null;
            await RefreshSessionAsync();
        }
    }

    private void CancelStreaming()
    {
        _streamCts?.Cancel();
    }

