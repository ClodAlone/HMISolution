        background: #665d1e;
        color: #ffc107;
    }
</style>

@code {
    [Parameter] public EventCallback OnNavigateToScript { get; set; }
    [Parameter] public EventCallback OnNavigateToPlc { get; set; }
    [Parameter] public EventCallback<string> OnNavigateToItem { get; set; }

    [Inject] private FindReplaceService FindReplace { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private enum Mode { CurrentEditor, GlobalProject }
    private Mode _mode = Mode.CurrentEditor;
    private ElementReference _searchInput;

    private string _statusMessage = "";
    private bool _statusIsError;
    private int _editorMatchCount = -1;
    private List<FindReplaceService.FindResult>? _globalResults;
    private HashSet<string> _collapsedGroups = new();

    protected override void OnInitialized()
    {
        FindReplace.StateChanged += OnServiceStateChanged;
    }

    private void OnServiceStateChanged() => InvokeAsync(StateHasChanged);

    public async Task FocusSearchAsync()
    {
        try
        {
            // Small delay to ensure the panel is rendered and visible
            await Task.Yield();
            await JS.InvokeVoidAsync("focusElement", _searchInput);
        }
        catch { }
    }

    public void SetEditorMode()
    {
        _mode = Mode.CurrentEditor;
        StateHasChanged();
    }

    public void SetGlobalMode()
    {
        _mode = Mode.GlobalProject;
        StateHasChanged();
    }

    private void SetMode(Mode mode)
    {
        _mode = mode;
        _statusMessage = "";
        if (mode == Mode.CurrentEditor)
            _globalResults = null;
    }

    private async Task OnSearchTextChanged()
    {
        if (_mode == Mode.CurrentEditor)
        {
            await UpdateEditorSearch();
        }
    }

    private async Task OnOptionsChanged()
    {
        if (_mode == Mode.CurrentEditor)
        {
            await UpdateEditorSearch();
        }
    }

    private async Task UpdateEditorSearch()
    {
        _statusMessage = "";
        if (string.IsNullOrEmpty(FindReplace.SearchText))
        {
            _editorMatchCount = -1;
            await JS.InvokeVoidAsync("codeEditor.clearSearch");
            return;
        }

        try
        {
            _editorMatchCount = await JS.InvokeAsync<int>("codeEditor.startSearch",
                FindReplace.SearchText, FindReplace.CaseSensitive, FindReplace.UseRegex, FindReplace.WholeWord);
        }
        catch
        {
            _editorMatchCount = -1;
        }
    }

    private async Task FindNext()
    {
        if (string.IsNullOrEmpty(FindReplace.SearchText)) return;
        var found = await JS.InvokeAsync<bool>("codeEditor.findNext",
            FindReplace.SearchText, FindReplace.CaseSensitive, FindReplace.UseRegex, FindReplace.WholeWord);
        _statusMessage = found ? "" : "No more matches.";
        _statusIsError = !found;
    }

    private async Task FindPrevious()
    {
        if (string.IsNullOrEmpty(FindReplace.SearchText)) return;
        var found = await JS.InvokeAsync<bool>("codeEditor.findPrev",
            FindReplace.SearchText, FindReplace.CaseSensitive, FindReplace.UseRegex, FindReplace.WholeWord);
        _statusMessage = found ? "" : "No more matches.";
        _statusIsError = !found;
    }

    private async Task ReplaceCurrent()
    {
        if (string.IsNullOrEmpty(FindReplace.SearchText)) return;
        var replaced = await JS.InvokeAsync<bool>("codeEditor.replaceCurrent",
            FindReplace.SearchText, FindReplace.ReplaceText ?? "", FindReplace.CaseSensitive, FindReplace.UseRegex, FindReplace.WholeWord);
        if (replaced)
        {
            _editorMatchCount = Math.Max(0, _editorMatchCount - 1);
            _statusMessage = "Replaced.";
            _statusIsError = false;
        }
        else
        {
            _statusMessage = "No match at cursor.";
            _statusIsError = true;
        }
    }

    private async Task ReplaceAllInEditor()
    {
        if (string.IsNullOrEmpty(FindReplace.SearchText)) return;
        var count = await JS.InvokeAsync<int>("codeEditor.replaceAll",
            FindReplace.SearchText, FindReplace.ReplaceText ?? "", FindReplace.CaseSensitive, FindReplace.UseRegex, FindReplace.WholeWord);
        _editorMatchCount = 0;
        _statusMessage = $"Replaced {count} occurrence(s).";
        _statusIsError = count == 0;
    }

    private void SearchGlobal()
    {
        _statusMessage = "";
        _globalResults = FindReplace.SearchProject();
        _collapsedGroups.Clear();
        if (_globalResults.Count == 0)
        {
            _statusMessage = "No matches found in the project.";
            _statusIsError = true;
        }
    }

    private void ReplaceAllGlobal()
    {
        var count = FindReplace.ReplaceAllInProject();
        _statusMessage = count > 0
            ? $"Replaced {count} occurrence(s) across the project."
            : "No matches to replace.";
        _statusIsError = count == 0;

        if (count > 0)
        {
            Editor.MarkChanged();
            // Refresh results
            _globalResults = FindReplace.SearchProject();
        }
    }

    private void ToggleGroup(string key)
    {
        if (!_collapsedGroups.Remove(key))
            _collapsedGroups.Add(key);
    }

    private async Task NavigateToResult(FindReplaceService.FindResult result)
    {
        // Navigate to the appropriate editor/panel based on the result category
        var category = result.Category.TrimStart('[').Split(']').Last().Trim();

        if (category is "Script")
        {
            // Find the script node and navigate
            await OnNavigateToItem.InvokeAsync($"script:{result.ItemName}");
        }
        else if (category is "PLC Program")
        {
            await OnNavigateToItem.InvokeAsync($"plc:{result.ItemName}");
        }
        else if (category is "Variable" or "Folder")
        {
            await OnNavigateToItem.InvokeAsync($"variable:{result.ItemName}");
        }
        else if (category is "Screen" or "Screen Symbol")
        {
            var screenName = result.ItemName.Contains('/') ? result.ItemName.Split('/')[0] : result.ItemName;
            await OnNavigateToItem.InvokeAsync($"screen:{screenName}");
        }
        else if (category is "JSON Editor")
        {
            await OnNavigateToItem.InvokeAsync("json:");
        }
        else if (category is "String")
        {
            await OnNavigateToItem.InvokeAsync("strings:");
        }
    }

    private MarkupString HighlightContext(string context)
    {
        if (string.IsNullOrEmpty(context) || string.IsNullOrEmpty(FindReplace.SearchText))
            return new MarkupString(System.Net.WebUtility.HtmlEncode(context));

        // Truncate long context
        var text = context.Length > 200 ? context[..200] + "…" : context;

        try
        {
            if (FindReplace.UseRegex)
            {
                var options = FindReplace.CaseSensitive ? System.Text.RegularExpressions.RegexOptions.None : System.Text.RegularExpressions.RegexOptions.IgnoreCase;
                var escaped = System.Text.RegularExpressions.Regex.Replace(
                    System.Net.WebUtility.HtmlEncode(text),
                    FindReplace.SearchText,
                    m => $"<span class=\"fr-highlight\">{m.Value}</span>",
                    options);
                return new MarkupString(escaped);
            }

            var comparison = FindReplace.CaseSensitive ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
            var html = "";
            int idx = 0;
            while (idx < text.Length)
            {
                var pos = text.IndexOf(FindReplace.SearchText, idx, comparison);
                if (pos < 0)
                {
                    html += System.Net.WebUtility.HtmlEncode(text[idx..]);
                    break;
                }
                html += System.Net.WebUtility.HtmlEncode(text[idx..pos]);
                html += $"<span class=\"fr-highlight\">{System.Net.WebUtility.HtmlEncode(text[pos..(pos + FindReplace.SearchText.Length)])}</span>";
                idx = pos + FindReplace.SearchText.Length;
            }
            return new MarkupString(html);
        }
        catch
        {
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text));
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_mode == Mode.CurrentEditor)
            {
                if (e.ShiftKey)
                    await FindPrevious();
                else
                    await FindNext();
            }
            else
            {
                SearchGlobal();
            }
        }
        else if (e.Key == "Escape")
        {
            if (_mode == Mode.CurrentEditor)
            {
                await JS.InvokeVoidAsync("codeEditor.clearSearch");
                _editorMatchCount = -1;
            }
        }
    }

    private async Task OnReplaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_mode == Mode.CurrentEditor)
                await ReplaceCurrent();
            else
                ReplaceAllGlobal();
        }
    }

    public void Dispose()
    {
        FindReplace.StateChanged -= OnServiceStateChanged;
    }
}
