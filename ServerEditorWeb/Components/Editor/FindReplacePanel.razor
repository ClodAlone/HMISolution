    .fr-status-error { color: var(--danger-color, #dc3545); }
    .fr-results-header {
        padding: 3px 8px;
        background: var(--bg-secondary, #f8f9fa);
        border-bottom: 1px solid var(--border-color, #dee2e6);
        font-size: 11px;
        font-weight: 600;
        flex-shrink: 0;
    }
