        flex: 1;
        overflow-y: auto;
        min-height: 0;
    }
    .fr-no-results {
        padding: 12px;
        text-align: center;
        color: var(--text-muted, #999);
    }
    .fr-result-group-header {
        padding: 3px 8px;
        background: var(--bg-tertiary, #f0f0f0);
