        color: var(--text-muted, #999);
    }
    .fr-actions {
        padding: 4px 8px;
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        flex-shrink: 0;
        border-bottom: 1px solid var(--border-color, #dee2e6);
    }
    .fr-actions .btn { font-size: 11px; padding: 2px 8px; }
    .fr-status {
        padding: 3px 8px;
        font-size: 11px;
        flex-shrink: 0;
    }
