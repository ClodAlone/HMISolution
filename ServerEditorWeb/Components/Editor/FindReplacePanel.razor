    }
    .fr-label {
        width: 52px;
        font-weight: 600;
        color: var(--text-secondary, #555);
        flex-shrink: 0;
        font-size: 11px;
    }
    .fr-input {
        flex: 1;
        padding: 3px 6px;
        border: 1px solid var(--border-color, #dee2e6);
