@using ServerEditorWeb.Services
@using ServerEditorWeb.Models
@using Microsoft.JSInterop
@implements IDisposable

<div class="find-replace-panel">
    @* ── Mode Tabs ── *@
    <div class="fr-mode-tabs">
        <button class="fr-mode-tab @(_mode == Mode.CurrentEditor ? "active" : "")"
                @onclick="() => SetMode(Mode.CurrentEditor)" title="Find in active code editor (Ctrl+F)">
            📝 Editor
        </button>
        <button class="fr-mode-tab @(_mode == Mode.GlobalProject ? "active" : "")"
                @onclick="() => SetMode(Mode.GlobalProject)" title="Find across the entire project (Ctrl+Shift+F)">
            🌐 Project
        </button>
    </div>

    @* ── Search Inputs ── *@
    <div class="fr-inputs">
        <div class="fr-row">
            <span class="fr-label">Find:</span>
            <input type="text" class="fr-input" @bind="FindReplace.SearchText" @bind:event="oninput"
                   @bind:after="OnSearchTextChanged" @onkeydown="OnSearchKeyDown"
                   placeholder="Search text…" @ref="_searchInput" />
        </div>
        <div class="fr-row">
            <span class="fr-label">Replace:</span>
            <input type="text" class="fr-input" @bind="FindReplace.ReplaceText" @bind:event="oninput"
                   placeholder="Replace with…" @onkeydown="OnReplaceKeyDown" />
        </div>
        <div class="fr-options">
            <label class="fr-option" title="Match Case (Alt+C)">
                <input type="checkbox" @bind="FindReplace.CaseSensitive" @bind:after="OnOptionsChanged" />
                <span>Aa</span>
            </label>
            <label class="fr-option" title="Whole Word (Alt+W)">
                <input type="checkbox" @bind="FindReplace.WholeWord" @bind:after="OnOptionsChanged" />
                <span>W</span>
            </label>
            <label class="fr-option" title="Use Regular Expression (Alt+R)">
                <input type="checkbox" @bind="FindReplace.UseRegex" @bind:after="OnOptionsChanged" />
                <span>.*</span>
            </label>
            @if (_mode == Mode.CurrentEditor && _editorMatchCount >= 0)
            {
                <span class="fr-match-count">@_editorMatchCount match(es)</span>
            }
        </div>
    </div>

    @* ── Action Buttons ── *@
    <div class="fr-actions">
        @if (_mode == Mode.CurrentEditor)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="FindPrevious" title="Find Previous (Shift+Enter)"
                    disabled="@string.IsNullOrEmpty(FindReplace.SearchText)">◀ Prev</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="FindNext" title="Find Next (Enter / F3)"
                    disabled="@string.IsNullOrEmpty(FindReplace.SearchText)">Next ▶</button>
            <button class="btn btn-sm btn-outline-warning" @onclick="ReplaceCurrent" title="Replace current match"
                    disabled="@string.IsNullOrEmpty(FindReplace.SearchText)">Replace</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ReplaceAllInEditor" title="Replace all in active editor"
                    disabled="@string.IsNullOrEmpty(FindReplace.SearchText)">Replace All</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="SearchGlobal" title="Search entire project"
                    disabled="@string.IsNullOrEmpty(FindReplace.SearchText)">🔍 Search Project</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ReplaceAllGlobal" title="Replace all in entire project"
                    disabled="@string.IsNullOrEmpty(FindReplace.SearchText)">Replace All in Project</button>
        }
    </div>

    @* ── Status ── *@
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="fr-status @(_statusIsError ? "fr-status-error" : "fr-status-success")">
            @_statusMessage
        </div>
    }

    @* ── Global Results ── *@
    @if (_mode == Mode.GlobalProject && _globalResults != null)
    {
        <div class="fr-results-header">
            <span>@_globalResults.Count result(s) found</span>
        </div>
        <div class="fr-results">
            @if (_globalResults.Count == 0 && !string.IsNullOrEmpty(FindReplace.SearchText))
            {
                <div class="fr-no-results">No matches found.</div>
            }
            else
            {
                @foreach (var group in _globalResults.GroupBy(r => r.Category))
                {
                    <div class="fr-result-group">
                        <div class="fr-result-group-header" @onclick="() => ToggleGroup(group.Key)">
                            <span>@(_collapsedGroups.Contains(group.Key) ? "▶" : "▼")</span>
                            <strong>@group.Key</strong>
                            <span class="fr-result-count">(@group.Count())</span>
                        </div>
                        @if (!_collapsedGroups.Contains(group.Key))
                        {
                            @foreach (var result in group.Take(200))
                            {
                                <div class="fr-result-item" @onclick="() => NavigateToResult(result)" title="@result.ItemName — @result.FieldName">
                                    <span class="fr-result-name">@result.ItemName</span>
                                    <span class="fr-result-field">@result.FieldName</span>
                                    @if (result.Line >= 0)
                                    {
                                        <span class="fr-result-line">Ln @(result.Line + 1)</span>
                                    }
                                    <div class="fr-result-context">@HighlightContext(result.Context)</div>
                                </div>
                            }
                            @if (group.Count() > 200)
                            {
                                <div class="fr-result-overflow">… and @(group.Count() - 200) more</div>
                            }
                        }
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    .find-replace-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        font-size: 12px;
    }
    .fr-mode-tabs {
