@using Microsoft.JSInterop
@using SharedModels
@using ServerEditorWeb.Services
@implements IDisposable

<div class="plc-editor-panel">
    @if (GetPlcProgram() is not PlcProgramConfig plc)
    {
        <p class="text-muted p-2">Select a PLC program with ST or IL language to open the code editor.</p>
    }
    else
    {
        @* Toolbar *@
        <div class="plc-editor-toolbar">
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <span class="small fw-bold me-2">@_plcNode!.Name</span>
                <span class="badge bg-secondary">@GetPlcLanguageLabel(plc.Language)</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="CheckSyntax" disabled="@_checkingSyntax">
                    @if (_checkingSyntax)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Check Syntax
                </button>
                @if (!string.IsNullOrEmpty(_syntaxResult))
                {
                    <span class="small @(_syntaxSuccess ? "text-success" : "text-danger")">@_syntaxResult</span>
                }

                @if (ServerProcess.IsServerRunning)
                {
                    <span class="border-start ms-1 me-1" style="height:20px"></span>
                    @if (_debugState == ScriptDebugState.Paused)
                    {
                        <button class="btn btn-sm btn-success" title="Continue" @onclick="() => SendDebugCommand(ScriptDebugCommand.Continue)">▶</button>
                        <button class="btn btn-sm btn-outline-primary" title="Step Over" @onclick="() => SendDebugCommand(ScriptDebugCommand.StepOver)">⏭</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-warning" title="Pause" @onclick="() => SendDebugCommand(ScriptDebugCommand.Pause)">⏸</button>
                    }
                    <button class="btn btn-sm btn-outline-danger" title="Detach" @onclick="() => SendDebugCommand(ScriptDebugCommand.Detach)">⏹</button>
                    @if (_debugState == ScriptDebugState.Paused)
                    {
                        <span class="badge bg-warning text-dark">Paused @(_pausedLine >= 0 ? $"line {_pausedLine + 1}" : "")</span>
                    }
                    else if (_debugState == ScriptDebugState.Stepping)
                    {
                        <span class="badge bg-info">Stepping</span>
                    }
                }
            </div>
        </div>

        @* Code Editor + Debug + Snippet Toolbox *@
        <div class="plc-editor-body">
            <div class="plc-editor-main">
                <CodeEditor @ref="_editor" @bind-Value="plc.Code" @bind-Value:after="OnCodeChanged"
                            Language="@GetPlcEditorLanguage(plc.Language)" Height="100%"
                            Completions="_completions"
                            EnableBreakpoints="true"
                            BreakpointsChanged="OnBreakpointsChanged"
                            Initialized="OnEditorInitialized" />
                <ProgramDebugPanel Category="PlcProgram" ProgramName="@plc.Name"
                                  ServerRunning="ServerProcess.IsServerRunning"
                                  SourceCode="@plc.Code" Height="100%"
                                  EditorElement="@(_editor?.EditorElement ?? default)"
                                  OnDebugSessionChanged="OnDebugSessionUpdated"
                                  OnExecutionLineChanged="OnExecutionLineChanged" />
            </div>

            @* Snippet Toolbox Sidebar *@
            <SnippetToolboxPanel Language="@GetSnippetLanguageCode(plc.Language)"
                                OnInsertCode="InsertSnippetAsync"
                                OnSnippetAdded="OnSnippetAdded" />
        </div>
    }
</div>

<style>
    .plc-editor-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }
    .plc-editor-toolbar {
        padding: 4px 8px;
        border-bottom: 1px solid var(--bs-border-color);
        background: #f8f9fa;
        flex-shrink: 0;
    }
    .plc-editor-body {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: row;
    }
    .plc-editor-main {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .plc-editor-body > div:first-child {
        flex: 1;
        min-height: 0;
        position: relative;
    }
    .plc-editor-body .CodeMirror {
        position: absolute !important;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        height: auto !important;
    }
</style>

@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private SyntaxCheckService SyntaxChecker { get; set; } = default!;
    [Inject] private ServerProcessService ServerProcess { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private ScriptDebugService DebugService { get; set; } = default!;

    private CodeEditor? _editor;
    private PlcProgramNode? _plcNode;
    private PlcProgramConfig? _lastPlc;
    private string _syntaxResult = "";
    private bool _syntaxSuccess;
    private bool _checkingSyntax;
    private List<CodeEditor.CompletionItem> _completions = new();
    private int[] _breakpointLines = [];
    private ScriptDebugState _debugState = ScriptDebugState.Detached;
    private int _pausedLine = -1;
    private bool _needsBreakpointRestore;
    private string? _debugError;

    private PlcProgramConfig? GetPlcProgram()
    {
        _plcNode = Node as PlcProgramNode;
        if (_plcNode != null && !_plcNode.PlcProgram.Language.Equals("LD", StringComparison.OrdinalIgnoreCase))
            return _plcNode.PlcProgram;
        return null;
    }

    protected override void OnParametersSet()
    {
        var plc = GetPlcProgram();
        if (plc != _lastPlc)
        {
            _lastPlc = plc;
            _syntaxResult = "";
            _breakpointLines = plc?.Breakpoints?.ToArray() ?? [];
            _needsBreakpointRestore = true;
            RebuildCompletions();
        }
    }

    private void RebuildCompletions()
    {
        _completions = new List<CodeEditor.CompletionItem>();

        // IEC 61131-3 ST keywords
        var stKeywords = new[] {
            "VAR", "END_VAR", "VAR_INPUT", "VAR_OUTPUT", "VAR_IN_OUT", "VAR_GLOBAL",
            "IF", "THEN", "ELSIF", "ELSE", "END_IF",
            "CASE", "OF", "END_CASE",
            "FOR", "TO", "BY", "DO", "END_FOR",
            "WHILE", "END_WHILE", "REPEAT", "UNTIL", "END_REPEAT",
            "TRUE", "FALSE", "AND", "OR", "NOT", "XOR", "MOD",
            "INT", "DINT", "REAL", "LREAL", "BOOL", "STRING", "BYTE", "WORD", "DWORD", "TIME"
        };
        foreach (var kw in stKeywords)
            _completions.Add(new CodeEditor.CompletionItem { Text = kw, DisplayText = kw, ClassName = "cm-hint-keyword" });

        // Built-in ST/PLC functions
        var stFunctions = new (string Name, string Desc)[] {
            ("ABS", "ABS(x) \u2192 absolute value"),
            ("SQRT", "SQRT(x) \u2192 square root"),
            ("SIN", "SIN(x) \u2192 sine"),
            ("COS", "COS(x) \u2192 cosine"),
            ("TAN", "TAN(x) \u2192 tangent"),
            ("ASIN", "ASIN(x) \u2192 arc sine"),
            ("ACOS", "ACOS(x) \u2192 arc cosine"),
            ("ATAN", "ATAN(x) \u2192 arc tangent"),
            ("ATAN2", "ATAN2(y, x) \u2192 arc tangent 2"),
            ("EXP", "EXP(x) \u2192 e^x"),
            ("LN", "LN(x) \u2192 natural log"),
            ("LOG", "LOG(x) \u2192 log base 10"),
            ("POW", "POW(base, exp) \u2192 power"),
            ("EXPT", "EXPT(base, exp) \u2192 power"),
            ("MIN", "MIN(a, b) \u2192 minimum"),
            ("MAX", "MAX(a, b) \u2192 maximum"),
            ("LIMIT", "LIMIT(min, val, max)"),
            ("SEL", "SEL(cond, val0, val1)"),
            ("MUX", "MUX(idx, val0, val1, ...)"),
            ("TRUNC", "TRUNC(x) \u2192 truncate"),
            ("ROUND", "ROUND(x) \u2192 round"),
            ("FLOOR", "FLOOR(x) \u2192 floor"),
            ("CEIL", "CEIL(x) \u2192 ceiling"),
            ("READ", "READ(\"varPath\") \u2192 read variable"),
            ("READBOOL", "READBOOL(\"varPath\") \u2192 bool"),
            ("READINT", "READINT(\"varPath\") \u2192 int"),
            ("READDOUBLE", "READDOUBLE(\"varPath\") \u2192 double"),
            ("WRITE", "WRITE(\"varPath\", value)"),
            ("RANDOM", "RANDOM() \u2192 0.0..1.0")
        };
        foreach (var (name, desc) in stFunctions)
            _completions.Add(new CodeEditor.CompletionItem { Text = name, DisplayText = desc, ClassName = "cm-hint-function" });

        // Variable paths from the project
        var model = Editor.RootModel;
        if (model?.Folder != null)
            CollectVariablePaths(model.Folder, "", _completions);
    }

    private static void CollectVariablePaths(Folder folder, string prefix, List<CodeEditor.CompletionItem> items)
    {
        var folderPath = string.IsNullOrEmpty(prefix) ? folder.Name : $"{prefix}.{folder.Name}";
        foreach (var v in folder.Variables)
        {
            var path = $"{folderPath}.{v.Name}";
            items.Add(new CodeEditor.CompletionItem
            {
                Text = path,
                DisplayText = $"{path}  ({v.Type})",
                ClassName = "cm-hint-variable"
            });
        }
        foreach (var sub in folder.Folders)
            CollectVariablePaths(sub, folderPath, items);
    }

    private async Task OnCodeChanged()
    {
        await OnPropertyChanged.InvokeAsync();
    }

    private async Task CheckSyntax()
    {
        var plc = GetPlcProgram();
        if (plc == null) return;

        _syntaxResult = "";
        _checkingSyntax = true;
        StateHasChanged();

        try
        {
            var code = plc.Code;
            var language = plc.Language;
            var (success, message) = await Task.Run(() => SyntaxChecker.CheckPlcSyntax(code, language));
            _syntaxSuccess = success;
            _syntaxResult = message;
        }
        catch (Exception ex)
        {
            _syntaxSuccess = false;
            _syntaxResult = $"Error: {ex.Message}";
        }
        finally
        {
            _checkingSyntax = false;
        }
    }

    private static string GetPlcEditorLanguage(string language) => language?.ToUpperInvariant() switch
    {
        "IL" => "text",
        "LD" => "text",
        _ => "st"
    };

    private static string GetPlcLanguageLabel(string language) => language?.ToUpperInvariant() switch
    {
        "IL" => "Instruction List",
        "LD" => "Ladder Diagram",
        _ => "Structured Text"
    };

    private async Task OnBreakpointsChanged(int[] lines)
    {
        _breakpointLines = lines;
        var plc = GetPlcProgram();
        if (plc != null)
        {
            plc.Breakpoints = lines.ToList();
            await OnPropertyChanged.InvokeAsync();

            if (ServerProcess.IsServerRunning)
            {
                try
                {
                    await DebugService.SetBreakpointsAsync(plc.Name, lines.ToList());
                    _debugError = null;
                }
                catch (Exception ex)
                {
                    _debugError = $"Set breakpoints failed: {ex.Message}";
                    StateHasChanged();
                }
            }
        }
    }

    private async Task SendDebugCommand(ScriptDebugCommand command)
    {
        var plc = GetPlcProgram();
        if (plc == null) return;
        try
        {
            await DebugService.SendCommandAsync(plc.Name, command);
            _debugError = null;
        }
        catch (Exception ex)
        {
            _debugError = $"Debug cmd failed: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task OnDebugSessionUpdated(ScriptDebugSession? session)
    {
        var prevState = _debugState;
        var prevLine = _pausedLine;
        _debugState = session?.State ?? ScriptDebugState.Detached;
        _pausedLine = session?.PausedAtLine ?? -1;

        if (_editor != null)
        {
            if (_debugState == ScriptDebugState.Paused && _pausedLine >= 0)
            {
                await _editor.ClearExecutionLineAsync();
                await _editor.SetCurrentDebugLineAsync(_pausedLine);
            }
            else if (prevState == ScriptDebugState.Paused)
            {
                await _editor.ClearCurrentDebugLineAsync();
            }
        }
        StateHasChanged();
    }

    private int _execLine = -1;

    private async Task OnExecutionLineChanged(int line)
    {
        _execLine = line;
        if (_editor == null || _debugState == ScriptDebugState.Paused) return;
        if (line >= 0)
            await _editor.SetExecutionLineAsync(line);
        else
            await _editor.ClearExecutionLineAsync();
    }

    protected override void OnInitialized()
    {
        ServerProcess.StateChanged += OnServerStateChanged;
    }

    private async void OnServerStateChanged()
    {
        await InvokeAsync(async () =>
        {
            if (ServerProcess.IsServerRunning)
                await PushBreakpointsToServerAsync();
            StateHasChanged();
        });
    }

    private async Task OnEditorInitialized()
    {
        if (_needsBreakpointRestore && _editor != null && _breakpointLines.Length > 0)
        {
            _needsBreakpointRestore = false;
            await _editor.SetBreakpointsAsync(_breakpointLines);
            if (ServerProcess.IsServerRunning)
                await PushBreakpointsToServerAsync();
        }
        StateHasChanged();
    }

    private async Task PushBreakpointsToServerAsync()
    {
        var plc = GetPlcProgram();
        if (plc == null || _breakpointLines.Length == 0) return;
        try
        {
            await DebugService.SetBreakpointsAsync(plc.Name, _breakpointLines.ToList());
            _debugError = null;
        }
        catch (Exception ex)
        {
            _debugError = $"Set breakpoints failed: {ex.Message}";
        }
    }

    // --- Snippet Insertion -----

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string GetSnippetLanguageCode(string language) => language?.ToUpperInvariant() switch
    {
        "IL" => "PlcIl",
        "LD" => "PlcLd",
        _ => "PlcSt"
    };

    private async Task InsertSnippetAsync(string snippetCode)
    {
        if (_editor?.EditorElement.Id == null) return;

        try
        {
            await JS.InvokeVoidAsync("codeSnippet.insertWithIndent", 
                _editor.EditorElement, snippetCode);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error inserting snippet: {ex.Message}");
        }
    }

    private Task OnSnippetAdded(CodeSnippet snippet)
    {
        // Optionally add to completions or refresh UI
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ServerProcess.StateChanged -= OnServerStateChanged;
    }
}

