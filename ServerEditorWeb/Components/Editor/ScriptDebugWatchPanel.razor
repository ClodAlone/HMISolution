@using SharedModels
@using ServerEditorWeb.Services
@implements IDisposable

<div class="debug-watch-panel">
    @if (_debugInfo?.DebugSession is { } session)
    {
        <div class="debug-watch-header">
            <span class="badge @GetStateBadgeClass(session.State)">@session.State</span>
            @if (!string.IsNullOrEmpty(_debugInfo.Name))
            {
                <span class="fw-bold small">@_debugInfo.Name</span>
            }
            @if (session.State == ScriptDebugState.Paused && session.PausedAtLine >= 0)
            {
                <span class="text-secondary small">Line @(session.PausedAtLine + 1)</span>
            }
        </div>
        @if (session.WatchVariables.Count > 0)
        {
            <div class="debug-watch-table-wrap">
                <table class="table table-sm table-striped mb-0">
                    <thead><tr><th>Variable</th><th>Value</th></tr></thead>
                    <tbody>
                        @foreach (var kv in session.WatchVariables.OrderBy(x => x.Key))
                        {
                            <tr><td class="text-nowrap">@kv.Key</td><td>@kv.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted small p-2 mb-0">No watch variables captured yet.</p>
        }
    }
    else
    {
        <div class="small p-2 mb-0">
            <p class="text-muted mb-1">@_statusMessage</p>
            @if (_diagError != null)
            {
                <p class="text-danger mb-0" style="font-size:10px">@_diagError</p>
            }
        </div>
    }
</div>

<style>
    .debug-watch-panel { display: flex; flex-direction: column; height: 100%; overflow: hidden; font-size: 12px; }
    .debug-watch-header { display: flex; align-items: center; gap: 6px; padding: 4px 8px; border-bottom: 1px solid var(--bs-border-color); background: #f8f9fa; flex-shrink: 0; }
    .debug-watch-table-wrap { flex: 1; overflow: auto; }
    .debug-watch-table-wrap th, .debug-watch-table-wrap td { padding: 2px 6px !important; font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 11px; }
</style>

@code {
    [Inject] private ScriptDebugService DebugService { get; set; } = default!;
    [Inject] private ServerProcessService ServerProcess { get; set; } = default!;

    private ProgramDebugInfo? _debugInfo;
    private System.Threading.Timer? _refreshTimer;
    private string _statusMessage = "Waiting...";
    private string? _diagError;

    protected override void OnInitialized()
    {
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await PollAsync();
            await InvokeAsync(StateHasChanged);
        }, null, 500, 1000);
    }

    private async Task PollAsync()
    {
        if (!ServerProcess.IsServerRunning)
        {
            _debugInfo = null;
            _statusMessage = "Server not running.";
            _diagError = null;
            return;
        }

        ServerDiagnostics? diag = null;
        try
        {
            diag = await DebugService.PollDiagnosticsAsync();
        }
        catch (Exception ex)
        {
            _diagError = ex.Message;
        }

        if (diag == null)
        {
            _debugInfo = null;
            _statusMessage = "Cannot reach diagnostics endpoint.";
            return;
        }

        var scripts = diag.ProgramDebug?.Where(d => d.Category == "Script").ToList();
        if (scripts == null || scripts.Count == 0)
        {
            _debugInfo = null;
            _statusMessage = "No scripts running.";
            _diagError = null;
            return;
        }

        var withSession = scripts.FirstOrDefault(d => d.DebugSession != null);
        if (withSession != null)
        {
            _debugInfo = withSession;
            _statusMessage = "";
            _diagError = null;
            return;
        }

        _debugInfo = null;
        var names = string.Join(", ", scripts.Select(s => s.Name));
        _statusMessage = "Scripts: " + names + " - set breakpoints to debug.";
        _diagError = null;
    }

    private static string GetStateBadgeClass(ScriptDebugState state) => state switch
    {
        ScriptDebugState.Paused => "bg-warning text-dark",
        ScriptDebugState.Stepping => "bg-info",
        ScriptDebugState.Running => "bg-success",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
