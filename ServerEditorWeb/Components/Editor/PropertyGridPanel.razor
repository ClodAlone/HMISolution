@using ServerEditorWeb.Services
@using ServerEditorWeb.Models

<div class="property-grid-panel">
    @if (_targets.Count == 0)
    {
        <p class="text-muted p-2">Select an item in the tree to inspect its properties.</p>
    }
    else
    {
        <div class="property-grid-header">
            <span class="property-grid-icon">@GetIcon()</span>
            <span class="property-grid-title">@GetTitle()</span>
            @if (_targets.Count > 1)
            {
                <span class="badge bg-primary ms-auto">@_targets.Count selected</span>
            }
            else
            {
                <span class="badge bg-secondary ms-auto">@_targets[0].GetType().Name</span>
            }
        </div>

        <div class="property-grid-body">
            @foreach (var group in _groups)
            {
                var groupId = group.Category;
                var isExpanded = _expandedGroups.Contains(groupId);

                <div class="property-grid-group">
                    <div class="property-grid-group-header" @onclick="() => ToggleGroup(groupId)">
                        <span class="property-grid-chevron">@(isExpanded ? "â–¾" : "â–¸")</span>
                        <span class="property-grid-group-name">@group.Category</span>
                        <span class="property-grid-group-count">@group.Properties.Count</span>
                    </div>

                    @if (isExpanded)
                    {
                        @foreach (var prop in group.Properties)
                        {
                            <div class="property-grid-row" title="@(prop.Description ?? "")">
                                <div class="property-grid-label">
                                    @prop.DisplayName
                                    @if (_targets.Count == 1 && prop.IsNullable && prop.IsComplexType)
                                    {
                                        @RenderSubObjectButtons(prop)
                                    }
                                </div>
                                <div class="property-grid-value">
                                    @if (prop.IsComplexType)
                                    {
                                        @if (_targets.Count == 1)
                                        {
                                            @RenderSubObject(prop)
                                        }
                                        else
                                        {
                                            <span class="text-muted small">(complex â€” select single item)</span>
                                        }
                                    }
                                    else if (prop.IsCollection)
                                    {
                                        <span class="text-muted small">(collection â€” edit in JSON)</span>
                                    }
                                    else
                                    {
                                        @RenderMultiEditor(prop)
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public TreeNode? Node { get; set; }
    [Parameter] public List<TreeNode> Nodes { get; set; } = [];
    [Parameter] public EventCallback OnPropertyChanged { get; set; }

    [Inject] private PropertyGridService Grid { get; set; } = default!;

    private List<object> _targets = [];
    private List<PropertyGroup> _groups = [];
    private HashSet<string> _expandedGroups = ["General"];

    protected override void OnParametersSet()
    {
        _targets = ResolveTargets();
        if (_targets.Count > 0)
        {
            _groups = Grid.GetPropertyGroups(_targets[0]);

            // For multi-selection, filter to only properties that exist on all targets
            if (_targets.Count > 1)
            {
                var commonType = _targets[0].GetType();
                if (_targets.All(t => t.GetType() == commonType))
                {
                    // Same type â€” keep all properties (they're all common)
                }
                else
                {
                    // Mixed types â€” intersect property names
                    var allPropSets = _targets.Select(t =>
                        Grid.GetPropertyGroups(t)
                            .SelectMany(g => g.Properties)
                            .Select(p => p.Name)
                            .ToHashSet()
                    ).ToList();

                    var common = allPropSets.Aggregate((a, b) => { a.IntersectWith(b); return a; });

                    _groups = _groups.Select(g => new PropertyGroup
                    {
                        Category = g.Category,
                        Properties = g.Properties.Where(p => common.Contains(p.Name)).ToList()
                    }).Where(g => g.Properties.Count > 0).ToList();
                }
            }
        }
        else
        {
            _groups = [];
        }

        foreach (var g in _groups)
            _expandedGroups.Add(g.Category);
    }

    private List<object> ResolveTargets()
    {
        if (Nodes.Count > 1)
        {
            return Nodes
                .Select(ResolveTarget)
                .Where(t => t != null)
                .Cast<object>()
                .ToList();
        }

        var single = ResolveTarget(Node);
        return single != null ? [single] : [];
    }

    private static object? ResolveTarget(TreeNode? node) => node switch
    {
        FolderNode f => f.Folder,
        VariableNode v => v.Variable,
        ScriptNode s => s.Script,
        ScreenNode sc => sc.Screen,
        UserGroupNode ug => ug.UserGroup,
        UserNode u => u.User,
        PlcProgramNode p => p.PlcProgram,
        RecipeNode r => r.Recipe,
        ServerSettingsNode ss => ss.Settings,
        ScriptGroupNode => null,
        ScreenGroupNode => null,
        UserGroupListNode => null,
        _ => null
    };

    private string GetIcon() => Node?.Icon ?? "ðŸ“„";

    private string GetTitle()
    {
        if (_targets.Count > 1)
            return $"{_targets.Count} items";
        return Node?.Name ?? "Unknown";
    }

    private void ToggleGroup(string groupId)
    {
        if (!_expandedGroups.Add(groupId))
            _expandedGroups.Remove(groupId);
    }

    /// <summary>
    /// Returns whether all targets have the same value for the given property.
    /// If mixed, sets strValue to "" and returns false.
    /// </summary>
    private (bool uniform, string display) GetMultiValue(PropertyDescriptor prop)
    {
        if (_targets.Count <= 1)
        {
            var v = Grid.GetValue(_targets[0], prop);
            return (true, v?.ToString() ?? "");
        }

        var values = _targets.Select(t => Grid.GetValue(t, prop)).ToList();
        var first = values[0];
        bool allSame = values.All(v => Equals(v, first));
        return allSame ? (true, first?.ToString() ?? "") : (false, "");
    }

    private void SetMultiValue(PropertyDescriptor prop, object? value)
    {
        foreach (var target in _targets)
            Grid.SetValue(target, prop, value);
        NotifyChanged();
    }

    private RenderFragment RenderMultiEditor(PropertyDescriptor prop) => builder =>
    {
        var primary = _targets[0];
        var (uniform, display) = GetMultiValue(prop);
        var propType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        var placeholder = uniform ? "" : "(mixed)";

        int seq = 0;

        if (propType == typeof(bool))
        {
            var boolVal = uniform && Grid.GetValue(primary, prop) is true;
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "class", "form-check-input");
            builder.AddAttribute(seq++, "checked", boolVal);
            builder.AddAttribute(seq++, "disabled", prop.IsReadOnly);
            if (!uniform)
            {
                builder.AddAttribute(seq++, "style", "opacity: 0.5;");
            }
            builder.AddAttribute(seq++, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                SetMultiValue(prop, e.Value is true);
            }));
            builder.CloseElement();
        }
        else if (prop.EnumValues.Length > 0)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "class", "form-select form-select-sm property-grid-input" + (uniform ? "" : " text-muted"));
            builder.AddAttribute(seq++, "disabled", prop.IsReadOnly);
            builder.AddAttribute(seq++, "value", display);
            builder.AddAttribute(seq++, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                var converted = Grid.ConvertValue(e.Value?.ToString(), prop.PropertyInfo.PropertyType);
                if (converted != null)
                    SetMultiValue(prop, converted);
            }));
            if (!uniform)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", "");
                builder.AddContent(seq++, "(mixed)");
                builder.CloseElement();
            }
            foreach (var ev in prop.EnumValues)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", ev);
                builder.AddContent(seq++, ev);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        else if (propType == typeof(int) || propType == typeof(long) || propType == typeof(short)
              || propType == typeof(double) || propType == typeof(float) || propType == typeof(decimal)
              || propType == typeof(byte) || propType == typeof(ushort) || propType == typeof(uint))
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "class", "form-control form-control-sm property-grid-input");
            builder.AddAttribute(seq++, "value", display);
            builder.AddAttribute(seq++, "placeholder", placeholder);
            builder.AddAttribute(seq++, "disabled", prop.IsReadOnly);
            if (propType == typeof(double) || propType == typeof(float) || propType == typeof(decimal))
                builder.AddAttribute(seq++, "step", "any");
            builder.AddAttribute(seq++, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                var converted = Grid.ConvertValue(e.Value?.ToString(), prop.PropertyInfo.PropertyType);
                if (converted != null)
                    SetMultiValue(prop, converted);
            }));
            builder.CloseElement();
        }
        else if (propType == typeof(TimeSpan))
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "text");
            builder.AddAttribute(seq++, "class", "form-control form-control-sm property-grid-input");
            builder.AddAttribute(seq++, "placeholder", uniform ? "hh:mm:ss or d.hh:mm:ss" : "(mixed)");
            builder.AddAttribute(seq++, "value", display);
            builder.AddAttribute(seq++, "disabled", prop.IsReadOnly);
            builder.AddAttribute(seq++, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                var input = e.Value?.ToString();
                if (string.IsNullOrWhiteSpace(input) && prop.IsNullable)
                    SetMultiValue(prop, null);
                else
                {
                    var converted = Grid.ConvertValue(input, prop.PropertyInfo.PropertyType);
                    if (converted != null)
                        SetMultiValue(prop, converted);
                }
            }));
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "text");
            builder.AddAttribute(seq++, "class", "form-control form-control-sm property-grid-input");
            builder.AddAttribute(seq++, "value", display);
            builder.AddAttribute(seq++, "placeholder", placeholder);
            builder.AddAttribute(seq++, "disabled", prop.IsReadOnly);
            builder.AddAttribute(seq++, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                var converted = Grid.ConvertValue(e.Value?.ToString(), prop.PropertyInfo.PropertyType);
                SetMultiValue(prop, converted);
            }));
            builder.CloseElement();
        }
    };

    private RenderFragment RenderSubObject(PropertyDescriptor prop) => builder =>
    {
        var subObj = Grid.GetValue(_targets[0], prop);
        if (subObj == null)
        {
            int seq = 0;
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-muted small fst-italic");
            builder.AddContent(seq++, "(null)");
            builder.CloseElement();
            return;
        }

        var subGroups = Grid.GetPropertyGroups(subObj);
        int s = 0;

        builder.OpenElement(s++, "div");
        builder.AddAttribute(s++, "class", "property-grid-sub");

        foreach (var subGroup in subGroups)
        {
            foreach (var subProp in subGroup.Properties)
            {
                if (subProp.IsComplexType || subProp.IsCollection) continue;

                builder.OpenElement(s++, "div");
                builder.AddAttribute(s++, "class", "property-grid-row property-grid-sub-row");

                builder.OpenElement(s++, "div");
                builder.AddAttribute(s++, "class", "property-grid-label");
                builder.AddContent(s++, subProp.DisplayName);
                builder.CloseElement();

                builder.OpenElement(s++, "div");
                builder.AddAttribute(s++, "class", "property-grid-value");
                builder.AddContent(s++, RenderMultiEditor(subProp));
                builder.CloseElement();

                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };

    private void CreateSubObject(PropertyDescriptor prop)
    {
        if (_targets.Count == 0) return;
        var instance = Grid.CreateInstance(prop.PropertyInfo.PropertyType);
        if (instance != null)
        {
            Grid.SetValue(_targets[0], prop, instance);
            _groups = Grid.GetPropertyGroups(_targets[0]);
            NotifyChanged();
        }
    }

    private void ClearSubObject(PropertyDescriptor prop)
    {
        if (_targets.Count == 0) return;
        Grid.SetValue(_targets[0], prop, null);
        _groups = Grid.GetPropertyGroups(_targets[0]);
        NotifyChanged();
    }

    private RenderFragment RenderSubObjectButtons(PropertyDescriptor prop) => builder =>
    {
        var subVal = Grid.GetValue(_targets[0], prop);
        int seq = 0;
        if (subVal == null)
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "btn btn-outline-primary btn-xs ms-1");
            builder.AddAttribute(seq++, "title", $"Create {prop.Name}");
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => CreateSubObject(prop)));
            builder.AddContent(seq++, "+");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "btn btn-outline-danger btn-xs ms-1");
            builder.AddAttribute(seq++, "title", $"Remove {prop.Name}");
            builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ClearSubObject(prop)));
            builder.AddContent(seq++, "âœ•");
            builder.CloseElement();
        }
    };

    private void NotifyChanged()
    {
        OnPropertyChanged.InvokeAsync();
        StateHasChanged();
    }
}
