@using ServerEditorWeb.Models
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="tree-item">
    <div @ref="_headerRef" class="tree-item-header @(Node.IsSelected ? "selected" : "") @(Node is ProjectNode pn && pn.IsActive ? "active-project" : "")"
         @onclick="OnClick"
         @onclick:stopPropagation="true"
         @ondblclick="() => OnDoubleClick.InvokeAsync(Node)"
         @ondblclick:stopPropagation="true"
         @oncontextmenu="ShowContextMenu" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>

        @if (Node.Children.Count > 0)
        {
            <span class="tree-toggle" @onclick="ToggleExpand" @onclick:stopPropagation="true">
                @(IsEffectivelyExpanded ? "▼" : "▶")
            </span>
        }
        else
        {
            <span class="tree-toggle">&nbsp;&nbsp;</span>
        }

        <span class="tree-icon">@Node.Icon</span>
        @if (Node is ProjectNode projNode)
        {
            <span class="tree-name">@projNode.Name@(projNode.HasUnsavedChanges ? " *" : "")</span>
            <span class="tree-type project-path" title="@projNode.FilePath">@(string.IsNullOrEmpty(projNode.FilePath) ? "(unsaved)" : projNode.FilePath)</span>
        }
        else if (Node is VariableNode varNode && GetLiveValue != null)
        {
            var liveVal = GetLiveValue(varNode.GetFullPath());
            var varTooltip = BuildVarTooltip(varNode);
            <span class="tree-name" title="@varTooltip">@Node.Name</span>
            <span class="tree-type">(@Node.TypeName)</span>
            @if (liveVal != null)
            {
                <span class="tree-live-value" title="Live value">@liveVal</span>
            }
        }
        else if (Node is VariableNode varNode2)
        {
            var varTooltip2 = BuildVarTooltip(varNode2);
            <span class="tree-name" title="@varTooltip2">@Node.Name</span>
            <span class="tree-type">(@Node.TypeName)</span>
        }
        else
        {
            <span class="tree-name">@Node.Name</span>
        }
    </div>

    @if (_contextMenuVisible)
    {
        <TreeViewContextMenu Visible="true" X="@_contextMenuX" Y="@_contextMenuY" Node="Node"
            OnClose="HideContextMenu"
            OnAddFolder="OnAddFolder"
            OnAddVariable="OnAddVariable"
            OnAddScript="OnAddScript"
            OnAddPlcProgram="OnAddPlcProgram"
            OnAddRecipe="OnAddRecipe"
            OnAddScheduler="OnAddScheduler"
            OnAddReport="OnAddReport"
            OnAddCalculated="OnAddCalculated"
            OnAddAsset="OnAddAsset"
            OnAddScreen="OnAddScreen"
            OnAddBatch="OnAddBatch"
            OnAddEvent="OnAddEvent" OnAddAliasMap="OnAddAliasMap" OnAddAutomationRule="OnAddAutomationRule" OnAddAiAgent="OnAddAiAgent"
            OnAddUserGroup="OnAddUserGroup"
            OnAddUser="OnAddUser"
            OnRename="OnRename"
            OnDelete="OnDelete"
            OnCopy="OnCopy"
            OnDuplicate="OnDuplicate"
            OnPaste="OnPaste"
            OnSetActiveProject="OnSetActiveProject"
            OnCloseProject="OnCloseProject"
            OnAddChildProject="OnAddChildProject"
            OnCreateChildProject="OnCreateChildProject"
            OnRemoveChildProject="OnRemoveChildProject"
            OnFindReferences="OnFindReferences"
            OnAddToWatch="OnAddToWatch"
            OnPinVariable="OnPinVariable"
            OnUnpinVariable="OnUnpinVariable"
            OnFindInEditor="OnFindInEditor"
            OnFindInProject="OnFindInProject" />
    }

    @if (IsEffectivelyExpanded && Node.Children.Count > 0)
    {
        <div class="tree-children">
            @foreach (var child in Node.Children)
            {
                @if (string.IsNullOrEmpty(FilterText) || NodeMatchesFilter(child, FilterText))
                {
                    <TreeViewItem Node="child" FilterText="@FilterText" OnSelect="OnSelect" OnDoubleClick="OnDoubleClick" SelectedNode="SelectedNode"
                        OnAddFolder="OnAddFolder" OnAddVariable="OnAddVariable" OnAddScript="OnAddScript"
                        OnAddPlcProgram="OnAddPlcProgram" OnAddRecipe="OnAddRecipe" OnAddScheduler="OnAddScheduler" OnAddReport="OnAddReport"
                        OnAddCalculated="OnAddCalculated" OnAddAsset="OnAddAsset" OnAddBatch="OnAddBatch" OnAddEvent="OnAddEvent" OnAddAliasMap="OnAddAliasMap" OnAddAutomationRule="OnAddAutomationRule" OnAddAiAgent="OnAddAiAgent" OnAddScreen="OnAddScreen" OnAddUserGroup="OnAddUserGroup" OnAddUser="OnAddUser"
                        OnCopy="OnCopy" OnDuplicate="OnDuplicate" OnPaste="OnPaste"
                        OnSetActiveProject="OnSetActiveProject" OnCloseProject="OnCloseProject"
                        OnAddChildProject="OnAddChildProject" OnCreateChildProject="OnCreateChildProject" OnRemoveChildProject="OnRemoveChildProject"
                        OnFindReferences="OnFindReferences"
                        OnAddToWatch="OnAddToWatch"
                        OnPinVariable="OnPinVariable"
                        OnUnpinVariable="OnUnpinVariable"
                        GetLiveValue="GetLiveValue"
                        OnFindInEditor="OnFindInEditor"
                        OnFindInProject="OnFindInProject" />
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public TreeNode Node { get; set; } = default!;
    [Parameter] public TreeNode? SelectedNode { get; set; }
    [Parameter] public string FilterText { get; set; } = "";
    [Parameter] public Func<string, string?>? GetLiveValue { get; set; }
    [Parameter] public EventCallback<TreeNodeClickArgs> OnSelect { get; set; }
    [Parameter] public EventCallback<TreeNode> OnDoubleClick { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddFolder { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddVariable { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddScript { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddPlcProgram { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddRecipe { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddScheduler { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddReport { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddCalculated { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAsset { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddBatch { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddEvent { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAliasMap { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAutomationRule { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddAiAgent { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddScreen { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddUserGroup { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddUser { get; set; }
    [Parameter] public EventCallback<TreeNode> OnRename { get; set; }
    [Parameter] public EventCallback<TreeNode> OnDelete { get; set; }
    [Parameter] public EventCallback<TreeNode> OnCopy { get; set; }
    [Parameter] public EventCallback<TreeNode> OnDuplicate { get; set; }
    [Parameter] public EventCallback<TreeNode> OnPaste { get; set; }
    [Parameter] public EventCallback<TreeNode> OnSetActiveProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnCloseProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddChildProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnCreateChildProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnRemoveChildProject { get; set; }
    [Parameter] public EventCallback<TreeNode> OnFindReferences { get; set; }
    [Parameter] public EventCallback<TreeNode> OnAddToWatch { get; set; }
    [Parameter] public EventCallback<TreeNode> OnPinVariable { get; set; }
    [Parameter] public EventCallback<TreeNode> OnUnpinVariable { get; set; }
    [Parameter] public EventCallback OnFindInEditor { get; set; }
    [Parameter] public EventCallback OnFindInProject { get; set; }

    private ElementReference _headerRef;
    private bool _wasSelected;
    private bool _contextMenuVisible;
    private double _contextMenuX, _contextMenuY;

    private bool IsEffectivelyExpanded =>
        !string.IsNullOrEmpty(FilterText) ? Node.Children.Count > 0 : Node.IsExpanded;

    private void OnClick(MouseEventArgs e)
    {
        OnSelect.InvokeAsync(new TreeNodeClickArgs(Node, e.CtrlKey, e.ShiftKey));
    }

    private void ShowContextMenu(MouseEventArgs e)
    {
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuVisible = true;
        StateHasChanged();
    }
    private void HideContextMenu()
    {
        _contextMenuVisible = false;
        StateHasChanged();
    }

    private void ToggleExpand()
    {
        Node.IsExpanded = !Node.IsExpanded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Node.IsSelected && !_wasSelected)
        {
            try { await JS.InvokeVoidAsync("editorShortcuts.scrollIntoView", _headerRef); } catch { }
        }
        _wasSelected = Node.IsSelected;
    }

    private static bool NodeMatchesFilter(TreeNode node, string filter)
    {
        if (node.Name.Contains(filter, StringComparison.OrdinalIgnoreCase))
            return true;
        foreach (var child in node.Children)
        {
            if (NodeMatchesFilter(child, filter))
                return true;
        }
        return false;
    }

    // QW-14: Rich tooltip for variable nodes
    private static string BuildVarTooltip(VariableNode varNode)
    {
        var v = varNode.Variable;
        var sb = new System.Text.StringBuilder();
        sb.Append(varNode.GetFullPath());
        sb.Append("\nType: ").Append(v.Type);
        sb.Append("  |  Access: ").Append(v.Access);
        if (!string.IsNullOrEmpty(v.EngineeringUnit))
            sb.Append("\nUnit: ").Append(v.EngineeringUnit);
        if (v.Alarm != null)
            sb.Append("\nAlarm: Hi=").Append(v.Alarm.HighLimit).Append(" Lo=").Append(v.Alarm.LowLimit);
        if (v.DriverConfigs != null && v.DriverConfigs.Count > 0)
        {
            foreach (var kv in v.DriverConfigs)
                sb.Append("\nDriver[").Append(kv.Key).Append("]: ").Append(kv.Value.ToString());
        }
        return sb.ToString();
    }
}
