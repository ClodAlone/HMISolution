@using Microsoft.JSInterop
@implements IAsyncDisposable

<div @ref="_element"></div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Language { get; set; } = "json";
    [Parameter] public string Height { get; set; } = "300px";
    [Parameter] public EventCallback Initialized { get; set; }
    [Parameter] public List<CompletionItem>? Completions { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference _element;
    private DotNetObjectReference<CodeEditor>? _dotNetRef;
    private bool _initialized;
    private string _lastValue = "";
    private List<CompletionItem>? _lastCompletions;

    /// <summary>Exposes the host element so sibling components can target the CodeMirror instance via JS interop.</summary>
    public ElementReference EditorElement => _element;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _lastValue = Value ?? "";
            await JS.InvokeVoidAsync("codeEditor.create", _element, _dotNetRef, _lastValue, Language, Height);
            _initialized = true;
            if (Completions is { Count: > 0 })
            {
                _lastCompletions = Completions;
                await JS.InvokeVoidAsync("codeEditor.setCompletions", _element, Completions);
            }
            await Initialized.InvokeAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && (Value ?? "") != _lastValue)
        {
            _lastValue = Value ?? "";
            await JS.InvokeVoidAsync("codeEditor.setValue", _element, _lastValue);
        }
        if (_initialized && Completions != _lastCompletions)
        {
            _lastCompletions = Completions;
            await JS.InvokeVoidAsync("codeEditor.setCompletions", _element, Completions ?? new());
        }
    }

    [JSInvokable]
    public async Task OnEditorChanged(string value)
    {
        _lastValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        if (_initialized)
        {
            try { await JS.InvokeVoidAsync("codeEditor.destroy", _element); }
            catch { }
        }
        _dotNetRef?.Dispose();
    }

    public class CompletionItem
    {
        public string Text { get; set; } = "";
        public string? DisplayText { get; set; }
        public string? ClassName { get; set; }
    }
}
