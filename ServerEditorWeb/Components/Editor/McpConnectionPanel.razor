@using SharedModels
@using ServerEditorWeb.Services
@using ServerEditorWeb.Models

@inject NodeEditorService Editor

<div class="ar-panel">

    @* Left sidebar: connection list *@
    <div class="ar-sidebar">
        <div class="ar-sidebar-toolbar">
            <strong class="small">🔌 MCP Connections</strong>
            <button class="btn btn-sm btn-outline-primary" @onclick="AddConnection" title="Add new MCP connection">➕</button>
        </div>

        @if (!_connections.Any())
        {
            <div class="ar-list-empty small text-muted">No MCP connections yet. Click ➕ to create one.</div>
        }
        else
        {
            <div class="ar-list">
                @foreach (var conn in _connections)
                {
                    var c = conn;
                    <div class="ar-list-item @(c == _selected ? "active" : "")"
                         @onclick="() => SelectConnection(c)">
                        <span class="ar-list-icon">@(c.Enabled ? "🟢" : "⚫")</span>
                        <span class="ar-list-name">@c.Name</span>
                        <span class="ar-list-group" title="Transport">@c.TransportType</span>
                        <button class="ar-list-delete btn btn-link p-0 ms-auto"
                                @onclick="() => DeleteConnection(c)" @onclick:stopPropagation title="Delete connection">🗑</button>
                    </div>
                }
            </div>
        }
    </div>

    @* Right: connection editor *@
    <div class="ar-editor">
        @if (_selected == null)
        {
            <div class="ar-editor-empty">
                <div style="font-size:2.5rem;opacity:.2;">🔌</div>
                <div class="mt-2 text-muted small">Select an MCP connection to edit, or click ➕ to create one.</div>
            </div>
        }
        else
        {
            <div class="ar-editor-scroll">

                @* ── Header ── *@
                <div class="ar-section ar-header-section">
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-auto">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox"
                                       @bind="_selected.Enabled"
                                       @bind:after="NotifyChanged"
                                       id="mc-enabled" />
                                <label class="form-check-label small" for="mc-enabled">Enabled</label>
                            </div>
                        </div>
                        <div class="col">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Connection name"
                                   @bind="_selected.Name"
                                   @bind:after="NotifyChanged" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Description (optional)"
                                   @bind="_selected.Description"
                                   @bind:after="NotifyChanged" />
                        </div>
                    </div>
                </div>

                @* ── Transport ── *@
                <div class="ar-section">
                    <div class="ar-section-header">
                        <span class="ar-section-title">🔧 Transport</span>
                    </div>
                    <div class="ar-card">
                        <div class="ar-row">
                            <label class="form-label small mb-0">Type</label>
                            <select class="form-select form-select-sm" style="width:140px;"
                                    @bind="_selected.TransportType" @bind:after="NotifyChanged">
                                <option value="Sse">SSE / HTTP (remote)</option>
                                <option value="Stdio">Stdio (local process)</option>
                            </select>
                        </div>

                        @if (_selected.TransportType == "Stdio")
                        {
                            <div class="ar-row mt-2">
                                <label class="form-label small mb-0">Command</label>
                                <input type="text" class="form-control form-control-sm" style="max-width:260px;"
                                       placeholder="e.g. npx, python, node"
                                       @bind="_selected.Command" @bind:after="NotifyChanged" />
                                <label class="form-label small mb-0">Arguments</label>
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="e.g. -y my-mcp-server"
                                       @bind="_selected.Arguments" @bind:after="NotifyChanged" />
                            </div>
                            <div class="small text-warning mt-2">
                                ⚠ Stdio transport is not yet supported by the built-in MCP client — only SSE/HTTP connections can be called at runtime.
                            </div>
                        }
                        else
                        {
                            <div class="ar-row mt-2">
                                <label class="form-label small mb-0">Endpoint URL</label>
                                <input type="text" class="form-control form-control-sm" style="min-width:300px;flex:1;"
                                       placeholder="https://example.com/mcp"
                                       @bind="_selected.Endpoint" @bind:after="NotifyChanged" />
                            </div>
                        }

                        <div class="ar-row mt-2">
                            <label class="form-label small mb-0">API Key env var</label>
                            <input type="text" class="form-control form-control-sm" style="max-width:220px;"
                                   placeholder="e.g. MY_MCP_API_KEY"
                                   @bind="_selected.ApiKeyEnvVar" @bind:after="NotifyChanged" />
                            <label class="form-label small mb-0 ms-3">Timeout</label>
                            <input type="number" class="form-control form-control-sm" style="width:90px;" min="1"
                                   @bind="_selected.TimeoutSeconds" @bind:after="NotifyChanged" />
                            <span class="small text-muted">sec</span>
                        </div>
                        <div class="small text-muted mt-2">
                            The API key value itself is never stored in the project — only the name of the environment variable
                            holding it. Set that variable on the server host before starting the MCP server process.
                        </div>
                    </div>
                </div>

                <div class="small text-muted mt-2 px-1">
                    To let an AI Agent use tools from this connection, add entries like
                    <code>@(_selected.Name).toolName</code> to that agent's "Allowed MCP Tools" list.
                </div>

            </div>
        }
    </div>
</div>

<style>
    .ar-panel { display: flex; height: 100%; overflow: hidden; }
    .ar-sidebar { width: 240px; flex-shrink: 0; border-right: 1px solid var(--bs-border-color, #333); display: flex; flex-direction: column; overflow: hidden; }
    .ar-sidebar-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 6px 8px; border-bottom: 1px solid var(--bs-border-color, #333); flex-shrink: 0; }
    .ar-list { flex: 1; overflow-y: auto; }
    .ar-list-empty { padding: 12px; text-align: center; }
    .ar-list-item { display: flex; align-items: center; gap: 5px; padding: 6px 8px; cursor: pointer; border-bottom: 1px solid var(--bs-border-color-translucent, #2a2a2a); font-size: 12px; }
    .ar-list-item:hover { background: var(--bs-primary-bg-subtle, #0d6efd1a); }
    .ar-list-item.active { background: var(--bs-primary-bg-subtle, #0d6efd2a); border-left: 3px solid #0d6efd; padding-left: 5px; }
    .ar-list-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ar-list-group { font-size: 9px; color: #f59e0b; background: #7c2d1220; border: 1px solid #f59e0b55; border-radius: 3px; padding: 1px 3px; }
    .ar-list-delete { opacity: 0; color: #dc3545; font-size: 11px; }
    .ar-list-item:hover .ar-list-delete { opacity: 1; }
    .ar-editor { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .ar-editor-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; }
    .ar-editor-scroll { flex: 1; overflow-y: auto; padding: 10px; }
    .ar-section { margin-bottom: 12px; border: 1px solid var(--bs-border-color, #333); border-radius: 6px; overflow: hidden; }
    .ar-header-section { padding: 8px 10px; background: var(--bs-secondary-bg, #252525); }
    .ar-section-header { display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: var(--bs-secondary-bg, #252525); border-bottom: 1px solid var(--bs-border-color, #333); flex-wrap: wrap; }
    .ar-section-title { font-size: 12px; font-weight: 600; }
    .ar-card { padding: 8px 10px; border-bottom: 1px solid var(--bs-border-color-translucent, #2a2a2a); }
    .ar-card:last-child { border-bottom: none; }
    .ar-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .ar-empty-hint { padding: 8px 10px; }
</style>

@code {
    private List<McpConnectionConfig> _connections = new();
    private McpConnectionConfig? _selected;

    protected override void OnInitialized()
    {
        Editor.StateChanged += OnEditorChanged;
        LoadConnections();
    }

    protected override void OnParametersSet() => LoadConnections();

    private void LoadConnections()
    {
        _connections = Editor.RootModel?.McpConnections ?? new();
        if (_selected != null && !_connections.Contains(_selected))
            _selected = null;
    }

    private void OnEditorChanged()
    {
        LoadConnections();
        InvokeAsync(StateHasChanged);
    }

    private void SelectConnection(McpConnectionConfig conn) => _selected = conn;

    private void AddConnection()
    {
        if (Editor.RootModel == null) return;
        var conn = new McpConnectionConfig { Name = $"MCP Connection {_connections.Count + 1}" };
        _connections.Add(conn);
        _selected = conn;
        Editor.HasUnsavedChanges = true;
    }

    private void DeleteConnection(McpConnectionConfig conn)
    {
        if (Editor.RootModel == null) return;
        _connections.Remove(conn);
        if (_selected == conn) _selected = _connections.FirstOrDefault();
        Editor.HasUnsavedChanges = true;
    }

    private void NotifyChanged()
    {
        Editor.HasUnsavedChanges = true;
        StateHasChanged();
    }
}
