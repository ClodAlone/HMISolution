@using ServerEditorWeb.Services

<div class="modal-backdrop show" @onclick="OnClose"></div>
<div class="modal show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content about-modal">
            <div class="modal-header py-2">
                <h6 class="modal-title">ℹ️ About — Server Editor</h6>
                <button type="button" class="btn-close btn-close-sm" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                @* App info *@
                <div class="about-app-info">
                    <div class="about-logo">🏭</div>
                    <div>
                        <h5 class="mb-1">Simple OPC File Server — Editor</h5>
                        <div class="text-muted small">
                            <div>Version: <strong>@_appVersion</strong></div>
                            <div>Framework: @_framework</div>
                            <div>OS: @_os</div>
                        </div>
                    </div>
                </div>

                <hr />

                @* License summary *@
                <h6>📦 Third-Party Licenses (@_licenses.Count packages)</h6>
                <p class="text-muted small mb-2">
                    All NuGet packages used across the solution with their license information.
                </p>

                <div class="about-license-summary mb-3">
                    @foreach (var group in _licenseGroups)
                    {
                        <span class="badge @GetLicenseBadgeClass(group.Key) me-1 mb-1">
                            @group.Key (@group.Value)
                        </span>
                    }
                </div>

                <div class="about-license-table-wrap">
                    <table class="table table-sm table-hover about-license-table">
                        <thead>
                            <tr>
                                <th>Package</th>
                                <th>Version</th>
                                <th>License</th>
                                <th>Authors</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pkg in _licenses)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(pkg.ProjectUrl))
                                        {
                                            <a href="@pkg.ProjectUrl" target="_blank" rel="noopener noreferrer" class="about-pkg-link">@pkg.PackageName</a>
                                        }
                                        else
                                        {
                                            @pkg.PackageName
                                        }
                                    </td>
                                    <td class="text-muted">@pkg.Version</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(pkg.LicenseUrl))
                                        {
                                            <a href="@pkg.LicenseUrl" target="_blank" rel="noopener noreferrer">
                                                <span class="badge @GetLicenseBadgeClass(pkg.License)">@(string.IsNullOrEmpty(pkg.License) ? "View" : pkg.License)</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge @GetLicenseBadgeClass(pkg.License)">@(string.IsNullOrEmpty(pkg.License) ? "Unknown" : pkg.License)</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@pkg.Authors</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-sm btn-secondary" @onclick="OnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .about-modal {
        font-size: 13px;
    }

    .about-app-info {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .about-logo {
        font-size: 48px;
        line-height: 1;
    }

    .about-license-summary {
        display: flex;
        flex-wrap: wrap;
    }

    .about-license-table-wrap {
        max-height: 350px;
        overflow-y: auto;
        border: 1px solid var(--border-color, #dee2e6);
        border-radius: 4px;
    }

    .about-license-table {
        margin-bottom: 0;
        font-size: 12px;
    }

    .about-license-table thead th {
        position: sticky;
        top: 0;
        background: var(--bg-secondary, #f8f9fa);
        z-index: 1;
        font-size: 11px;
    }

    .about-pkg-link {
        text-decoration: none;
    }

    .about-pkg-link:hover {
        text-decoration: underline;
    }
</style>

@code {
    [Inject] private LicenseService LicenseSvc { get; set; } = default!;

    [Parameter] public EventCallback OnClose { get; set; }

    private List<PackageLicenseInfo> _licenses = [];
    private Dictionary<string, int> _licenseGroups = [];
    private string _appVersion = "";
    private string _framework = "";
    private string _os = "";

    protected override void OnInitialized()
    {
        _licenses = LicenseSvc.GetPackageLicenses();
        _licenseGroups = _licenses
            .GroupBy(p => string.IsNullOrEmpty(p.License) ? "Unknown" : p.License)
            .OrderByDescending(g => g.Count())
            .ToDictionary(g => g.Key, g => g.Count());

        var (version, framework, os) = LicenseService.GetAppInfo();
        _appVersion = version;
        _framework = framework;
        _os = os;
    }

    private static string GetLicenseBadgeClass(string license)
    {
        return license?.ToUpperInvariant() switch
        {
            "MIT" => "bg-success",
            "APACHE-2.0" => "bg-info text-dark",
            "BSD" or "BSD-2-CLAUSE" or "BSD-3-CLAUSE" => "bg-info text-dark",
            "POSTGRESQL" => "bg-info text-dark",
            "MPL-2.0" => "bg-warning text-dark",
            "LGPL" or "GPL" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
