@using SharedModels
@using ServerEditorWeb.Services
@using Microsoft.JSInterop
@implements IDisposable

@if (_debugInfo != null)
{
    <div class="debug-status-bar">
        <span class="badge @(_debugInfo.Status == "Running" ? "bg-success" : "bg-danger")">
            @_debugInfo.Status
        </span>
        <span class="text-secondary">#@_debugInfo.CycleCount</span>
        @if (!string.IsNullOrEmpty(_debugInfo.LastError))
        {
            <span class="text-danger ms-2" title="@_debugInfo.LastError">
                @TruncateError(_debugInfo.LastError)
            </span>
        }
    </div>
}
else if (IsServerRunning && !string.IsNullOrEmpty(ProgramName))
{
    <div class="debug-status-bar">
        <span class="spinner-border spinner-border-sm" style="width: 12px; height: 12px;"></span>
        <span class="text-secondary ms-1">Connecting...</span>
    </div>
}

<style>
    .debug-status-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 6px;
        font-size: 11px;
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        background: #f8f9fa;
        border: 1px solid var(--bs-border-color);
        border-top: none;
        border-radius: 0 0 0.375rem 0.375rem;
    }
    .debug-inline-annotation {
        color: rgba(25, 135, 84, 0.8);
        font-style: italic;
        font-size: 0.8em;
        pointer-events: auto;
        white-space: nowrap;
        user-select: none;
    }
    .debug-line-executed {
        background: rgba(25, 135, 84, 0.05) !important;
    }
    .debug-line-write {
        background: rgba(13, 110, 253, 0.07) !important;
    }
    .debug-line-write .debug-inline-annotation {
        color: rgba(13, 110, 253, 0.85);
        font-weight: 600;
    }
</style>

@code {
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string ProgramName { get; set; } = "";
    [Parameter] public bool ServerRunning { get; set; }
    [Parameter] public string SourceCode { get; set; } = "";
    [Parameter] public string Height { get; set; } = "300px";
    [Parameter] public ElementReference EditorElement { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ServerDiagnosticsClient DiagClient { get; set; } = default!;
    [Inject] private ServerProcessService ServerProcess { get; set; } = default!;
    [Inject] private NodeEditorService Editor { get; set; } = default!;
    [Inject] private AuthService Auth { get; set; } = default!;

    private ProgramDebugInfo? _debugInfo;
    private System.Threading.Timer? _refreshTimer;
    private int _lineCount;
    private Dictionary<int, List<string>>? _scriptLineMap;

    private bool IsServerRunning => ServerRunning || ServerProcess.IsServerRunning;
    private bool HasEditorElement => !EditorElement.Equals(default(ElementReference));

    protected override void OnInitialized()
    {
        ServerProcess.StateChanged += OnServerStateChanged;
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await PollAndUpdateAsync();
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await PushAnnotationsToEditorAsync();
            });
        }, null, 500, 2000);
    }

    protected override void OnParametersSet()
    {
        _lineCount = string.IsNullOrEmpty(SourceCode) ? 0 : SourceCode.Split('\n').Length;
        _scriptLineMap = null;
        UpdateDebugInfo();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await PushAnnotationsToEditorAsync();
    }

    private async Task PushAnnotationsToEditorAsync()
    {
        if (!HasEditorElement) return;

        if (_debugInfo == null)
        {
            try { await JS.InvokeVoidAsync("codeEditor.clearDebugAnnotations", EditorElement); } catch { }
            return;
        }

        var annotations = new Dictionary<string, string>();
        for (int i = 0; i < _lineCount; i++)
        {
            var text = GetAnnotation(i);
            if (!string.IsNullOrEmpty(text))
                annotations[i.ToString()] = text;
        }

        try
        {
            await JS.InvokeVoidAsync("codeEditor.setDebugAnnotations",
                EditorElement, annotations,
                _debugInfo.ExecutedLines.ToArray(),
                _debugInfo.WriteLines.ToArray());
        }
        catch { }
    }

    private async void OnServerStateChanged()
    {
        await PollAndUpdateAsync();
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await PushAnnotationsToEditorAsync();
        });
    }

    private async Task PollAndUpdateAsync()
    {
        if (!IsServerRunning || string.IsNullOrEmpty(ProgramName))
        {
            _debugInfo = null;
            return;
        }
        try
        {
            var endpointUrl = Editor.ServerEndpointUrl;
            string? user = null, pass = null;
            if (Editor.RootModel?.Server?.EnableAnonymous == false && Auth.IsAuthenticated)
            {
                user = Auth.Username;
                pass = Auth.OpcPassword;
            }
            await DiagClient.PollAsync(endpointUrl, user, pass);
        }
        catch { }
        UpdateDebugInfo();
    }

    private void UpdateDebugInfo()
    {
        if (!IsServerRunning || string.IsNullOrEmpty(ProgramName))
        {
            _debugInfo = null;
            return;
        }
        _debugInfo = DiagClient.Latest?.ProgramDebug?
            .FirstOrDefault(d => d.Category == Category
                && d.Name.Equals(ProgramName, StringComparison.OrdinalIgnoreCase));
    }

    private string? GetAnnotation(int line)
    {
        if (_debugInfo == null) return null;
        if (_debugInfo.LineAnnotations.TryGetValue(line, out var annotation))
            return annotation;
        if (Category == "Script" && _debugInfo.Variables.Count > 0)
        {
            var map = GetScriptLineMap();
            if (map.TryGetValue(line, out var varNames))
            {
                var parts = new List<string>();
                foreach (var name in varNames)
                {
                    if (_debugInfo.Variables.TryGetValue("[read] " + name, out var rv))
                        parts.Add(name + " = " + rv);
                    else if (_debugInfo.Variables.TryGetValue("[write] " + name, out var wv))
                        parts.Add(name + " = " + wv);
                }
                if (parts.Count > 0) return string.Join(", ", parts);
            }
        }
        return null;
    }

    private Dictionary<int, List<string>> GetScriptLineMap()
    {
        if (_scriptLineMap != null) return _scriptLineMap;
        _scriptLineMap = new Dictionary<int, List<string>>();
        if (string.IsNullOrEmpty(SourceCode)) return _scriptLineMap;
        var lines = SourceCode.Split('\n');
        var pattern = new System.Text.RegularExpressions.Regex(
            @"(?:Read(?:Double|Int|Bool)?|Write)\s*\(\s*""([^""]+)""",
            System.Text.RegularExpressions.RegexOptions.Compiled);
        for (int i = 0; i < lines.Length; i++)
        {
            var matches = pattern.Matches(lines[i]);
            if (matches.Count > 0)
            {
                var varNames = new List<string>();
                foreach (System.Text.RegularExpressions.Match m in matches)
                    varNames.Add(m.Groups[1].Value);
                _scriptLineMap[i] = varNames;
            }
        }
        return _scriptLineMap;
    }

    private static string TruncateError(string text)
    {
        return text.Length > 60 ? text[..58] + "..." : text;
    }

    public void Dispose()
    {
        ServerProcess.StateChanged -= OnServerStateChanged;
        _refreshTimer?.Dispose();
    }
}
