@using SharedModels
@using ServerEditorWeb.Models
@using System.Text.Json
@inject DriverTestService _driverTestSvc

<OpcItemPickerPopup Visible="_showOpcPicker" OnItemSelected="OnOpcItemPicked" OnCancelled="() => _showOpcPicker = false" />

@* ─── Driver Configurations ───────────────────────────── *@
<div class="mb-2">
    <label class="form-label fw-bold small">🔌 Driver Bindings</label>

    @foreach (var driverKey in _configuredDrivers)
    {
        var key = driverKey;
        <div class="card vde-card mb-2">
            <div class="card-header vde-card-header d-flex justify-content-between align-items-center py-1 px-2">
                <span class="small fw-bold" style="color: var(--accent-color);">@DriverIcon(key) @key</span>
                <span class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info py-0 px-1" style="font-size: 9px;"
                            disabled="@_testBusy"
                            @onclick="() => RunDriverTest(key)" title="Test read this driver variable">⚡ Test</button>
                    @if (DriverTestService.SupportsWrite(key))
                    {
                        <button class="btn btn-sm btn-outline-warning py-0 px-1" style="font-size: 9px;"
                                disabled="@_testBusy"
                                @onclick="() => ToggleWritePanel(key)" title="Write a value to this driver">✏️ Write</button>
                    }
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 9px;"
                            @onclick="() => RemoveDriver(key)" title="Remove driver binding">✕</button>
                </span>
            </div>
            <div class="card-body vde-card-body p-2">
                @if (_testBusy && _testDriverKey == key)
                {
                    <div class="vde-progress p-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="vde-spinner"></span>
                            <span class="small" style="font-size: 11px;">@(_testOperation == "write" ? "Writing…" : "Testing…") connecting to @key driver</span>
                        </div>
                        <div class="vde-progress-bar mt-1"><div class="vde-progress-bar-fill"></div></div>
                    </div>
                }
                @if (_testDriverKey == key && _testResult != null)
                {
                    <div class="vde-test-result p-2 mb-2 @(_testResult.Success ? "vde-test-ok" : "vde-test-err")">
                        <div class="d-flex justify-content-between align-items-start">
                            <span>@(_testResult.Success ? "✅" : "❌") @_testResult.Message</span>
                            <button class="btn btn-sm py-0 px-1" style="font-size:9px;" @onclick="DismissTestResult">✕</button>
                        </div>
                        @if (_testResult is { Success: true, Value: not null })
                        {
                            <div class="mt-1"><code style="font-size:11px;">@_testResult.Value</code></div>
                            <button class="btn btn-sm btn-outline-info py-0 px-1 mt-1" style="font-size:9px;" disabled="@_testBusy" @onclick="() => RunDriverTest(key)">🔄 Re-test</button>
                        }
                    </div>
                }
                @if (_writeDriverKey == key)
                {
                    <div class="vde-test-result p-2 mb-2" style="border: 1px solid color-mix(in srgb, var(--bs-warning, #ffc107) 40%, transparent); border-radius: 4px; background: color-mix(in srgb, var(--bs-warning, #ffc107) 8%, transparent);">
                        <label class="form-label mb-1 small fw-bold" style="font-size: 10px;">✏️ Write Test Value</label>
                        <div class="d-flex gap-1 align-items-center">
                            <input type="text" class="form-control form-control-sm" style="font-size: 11px;"
                                   placeholder="@WriteHint(key)" @bind="_testWriteValue" @bind:event="oninput" />
                            <button class="btn btn-sm btn-warning py-0 px-2" style="font-size: 10px; white-space: nowrap;"
                                    disabled="@(_testBusy || string.IsNullOrWhiteSpace(_testWriteValue))"
                                    @onclick="() => RunDriverTestWrite(key)">⚡ Send</button>
                            <button class="btn btn-sm py-0 px-1" style="font-size: 9px;" @onclick="DismissWritePanel">✕</button>
                        </div>
                        @if (_writeResult != null)
                        {
                            <div class="mt-1 small @(_writeResult.Success ? "text-success" : "text-danger")" style="font-size: 10px;">
                                @(_writeResult.Success ? "✅" : "❌") @_writeResult.Message
                            </div>
                        }
                    </div>
                }
                @RenderDriverFields(key)
            </div>
        </div>
    }

    @* Add driver dropdown *@
    <div class="d-flex gap-1 mb-2">
        <select class="form-select form-select-sm" style="font-size: 11px; width: auto;" @bind="_selectedDriverToAdd">
            <option value="">+ Add driver…</option>
            @foreach (var d in _availableDrivers.Where(d => !_configuredDrivers.Contains(d)))
            {
                <option value="@d">@DriverIcon(d) @d</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-success" style="font-size: 10px;" disabled="@string.IsNullOrEmpty(_selectedDriverToAdd)"
                @onclick="AddSelectedDriver">Add</button>
    </div>
</div>

@* ─── Alarm Configuration ───────────────────────────── *@
<div class="mb-2">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <label class="form-label fw-bold small mb-0">🔔 Alarm</label>
        @if (Variable.Alarm == null)
        {
            <button class="btn btn-sm btn-outline-warning py-0 px-1" style="font-size: 10px;"
                    @onclick="EnableAlarm">Enable</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 10px;"
                    @onclick="DisableAlarm">Remove</button>
        }
    </div>

    @if (Variable.Alarm != null)
    {
        <div class="card vde-card p-2 mb-1" style="border-color: var(--warning-color);">
            @* Trigger type selector *@
            <div class="mb-2">
                <label class="form-label mb-0 small" title="Choose how the alarm is triggered: by numeric limit thresholds or by a condition expression.">
                    Trigger Type <span class="vde-hint">ⓘ</span>
                </label>
                <select class="form-select form-select-sm" @bind="Variable.Alarm.TriggerType" @bind:after="OnAlarmChanged">
                    <option value="@AlarmTriggerType.Limit">📊 Limit (High/Low thresholds)</option>
                    <option value="@AlarmTriggerType.Condition">⚡ Condition (expression)</option>
                </select>
            </div>

            @if (Variable.Alarm.TriggerType == AlarmTriggerType.Limit)
            {
                @* ── Limit mode ── *@
                <div class="row g-1 mb-1">
                    <div class="col-6">
                        <label class="form-label mb-0 small" title="Critical upper threshold (optional). Triggers severity 900 alarm when value exceeds this limit.">
                            High-High Limit <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" step="any"
                               value="@Variable.Alarm.HighHighLimit" @onchange="(e) => { Variable.Alarm.HighHighLimit = ParseNullableDouble(e.Value); OnAlarmChanged(); }"
                               placeholder="(optional)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label mb-0 small" title="Upper threshold. Triggers severity 700 alarm when value exceeds this limit.">
                            High Limit <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" step="any"
                               @bind="Variable.Alarm.HighLimit" @bind:after="OnAlarmChanged" />
                    </div>
                </div>
                <div class="row g-1 mb-1">
                    <div class="col-6">
                        <label class="form-label mb-0 small" title="Lower threshold. Triggers severity 500 alarm when value falls below this limit.">
                            Low Limit <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" step="any"
                               @bind="Variable.Alarm.LowLimit" @bind:after="OnAlarmChanged" />
                    </div>
                    <div class="col-6">
                        <label class="form-label mb-0 small" title="Critical lower threshold (optional). Triggers severity 900 alarm when value falls below this limit.">
                            Low-Low Limit <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" step="any"
                               value="@Variable.Alarm.LowLowLimit" @onchange="(e) => { Variable.Alarm.LowLowLimit = ParseNullableDouble(e.Value); OnAlarmChanged(); }"
                               placeholder="(optional)" />
                    </div>
                </div>
            }
            else
            {
                @* ── Condition mode ── *@
                <div class="row g-1 mb-1">
                    <div class="col-5">
                        <label class="form-label mb-0 small" title="Comparison operator. The alarm activates when: value {operator} {compare value}. 'True'/'False' treat the value as boolean. 'Changed' triggers on any value change.">
                            Operator <span class="vde-hint">ⓘ</span>
                        </label>
                        <select class="form-select form-select-sm" @bind="Variable.Alarm.Operator" @bind:after="OnAlarmChanged">
                            <option value="==">== (equals)</option>
                            <option value="!=">!= (not equals)</option>
                            <option value=">">&gt; (greater than)</option>
                            <option value=">=">&gt;= (greater or equal)</option>
                            <option value="<">&lt; (less than)</option>
                            <option value="<=">&lt;= (less or equal)</option>
                            <option value="True">True (boolean true)</option>
                            <option value="False">False (boolean false)</option>
                        </select>
                    </div>
                    <div class="col-4">
                        @{
                            bool hideCompareValue = Variable.Alarm.Operator is "True" or "False";
                        }
                        <label class="form-label mb-0 small" title="The value to compare against. For numeric variables use a number, for strings use text. Ignored for True/False operators.">
                            Compare Value <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="text" class="form-control form-control-sm"
                               @bind="Variable.Alarm.CompareValue" @bind:after="OnAlarmChanged"
                               placeholder="@(hideCompareValue ? "(n/a)" : "e.g. 0, true, OFF")"
                               disabled="@hideCompareValue" />
                    </div>
                    <div class="col-3">
                        <label class="form-label mb-0 small" title="OPC UA alarm severity (1–1000). 1=low, 500=medium, 900=critical.">
                            Severity <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" min="1" max="1000"
                               @bind="Variable.Alarm.ConditionSeverity" @bind:after="OnAlarmChanged" />
                    </div>
                </div>
                <div class="vde-desc mb-1">
                    Alarm triggers when: <code>value @Variable.Alarm.Operator @(hideCompareValue ? "" : Variable.Alarm.CompareValue)</code>
                </div>
            }

            @* ── Common: Hysteresis & Message ── *@
            <div class="row g-1 mb-1">
                <div class="col-4">
                    <label class="form-label mb-0 small" title="Deadband value to prevent alarm flickering. For Limit alarms: the value must return past the threshold by this amount before the alarm clears. For Condition alarms with numeric operators: same deadband applies. Set to 0 to disable.">
                        Hysteresis <span class="vde-hint">ⓘ</span>
                    </label>
                    <input type="number" class="form-control form-control-sm" step="any" min="0"
                           @bind="Variable.Alarm.Hysteresis" @bind:after="OnAlarmChanged"
                           placeholder="0" />
                </div>
                <div class="col-8">
                    <label class="form-label mb-0 small" title="Human-readable message text included in alarm events. Leave empty for auto-generated messages.">
                        Message <span class="vde-hint">ⓘ</span>
                    </label>
                    <input type="text" class="form-control form-control-sm"
                           @bind="Variable.Alarm.Message" @bind:after="OnAlarmChanged"
                           placeholder="Alarm message text (optional)" />
                </div>
            </div>
            <div class="mb-1">
                <div class="form-check form-check-sm">
                    <input class="form-check-input" type="checkbox" id="notifyOnActivation"
                           @bind="Variable.Alarm.NotifyOnActivation" @bind:after="OnAlarmChanged" />
                    <label class="form-check-label small" for="notifyOnActivation"
                           title="Send notifications (Email, Telegram, WhatsApp) when this alarm activates. Configure channels in Server Settings → Alarm Notifications.">
                        📨 Notify on activation <span class="vde-hint">ⓘ</span>
                    </label>
                </div>
                <div class="form-text mt-1" style="font-size: 10px;">Configure Email, Telegram, and WhatsApp channels in <strong>Server Settings → 📨 Alarm Notifications</strong>.</div>
            </div>
            @if (Variable.Alarm.Hysteresis > 0)
            {
                <div class="vde-desc mb-1">
                    @if (Variable.Alarm.TriggerType == AlarmTriggerType.Limit)
                    {
                        <text>Alarm clears when value returns within limits by @Variable.Alarm.Hysteresis (e.g. High: activates at @Variable.Alarm.HighLimit, clears at @((Variable.Alarm.HighLimit - Variable.Alarm.Hysteresis).ToString("G6")))</text>
                    }
                    else
                    {
                        <text>Deadband of @Variable.Alarm.Hysteresis applied to numeric condition deactivation</text>
                    }
                </div>
            }
        </div>
    }
</div>

@* ─── Anomaly Detection Configuration ──────────────────── *@
<div class="mb-2">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <label class="form-label fw-bold small mb-0">🔍 Anomaly Detection</label>
        @if (Variable.AnomalyDetection == null || !Variable.AnomalyDetection.Enabled)
        {
            <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 10px;"
                    @onclick="EnableAnomalyDetection"
                    disabled="@(Variable.DataLogging is not { Enabled: true })"
                    title="@(Variable.DataLogging is { Enabled: true } ? "Enable anomaly detection" : "Enable Data Logging first")">Enable</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 10px;"
                    @onclick="DisableAnomalyDetection">Remove</button>
        }
    </div>

    @if (Variable.DataLogging is not { Enabled: true } && Variable.AnomalyDetection is not { Enabled: true })
    {
        <div class="vde-desc">Requires <strong>Data Logging</strong> to be enabled (needs historical data for analysis).</div>
    }

    @if (Variable.AnomalyDetection is { Enabled: true })
    {
        <div class="card vde-card p-2 mb-1" style="border-color: var(--danger-color);">
            <div class="row g-1 mb-1">
                <div class="col-4">
                    <label class="form-label mb-0 small" title="Z-score threshold. Values exceeding this many standard deviations from the mean are flagged as anomalies. Lower = more sensitive. Default 3.0.">
                        Sensitivity <span class="vde-hint">ⓘ</span>
                    </label>
                    <input type="number" class="form-control form-control-sm" step="0.1" min="0.5"
                           @bind="Variable.AnomalyDetection.Sensitivity" @bind:after="OnAnomalyChanged" />
                </div>
                <div class="col-4">
                    <label class="form-label mb-0 small" title="Historical lookback window in minutes for computing rolling mean and standard deviation. Default 60.">
                        Window (min) <span class="vde-hint">ⓘ</span>
                    </label>
                    <input type="number" class="form-control form-control-sm" min="1"
                           @bind="Variable.AnomalyDetection.WindowMinutes" @bind:after="OnAnomalyChanged" />
                </div>
                <div class="col-4">
                    <label class="form-label mb-0 small" title="Cooldown between repeated notifications for this variable in seconds. Default 300 (5 min).">
                        Cooldown (s) <span class="vde-hint">ⓘ</span>
                    </label>
                    <input type="number" class="form-control form-control-sm" min="0"
                           @bind="Variable.AnomalyDetection.CooldownSeconds" @bind:after="OnAnomalyChanged" />
                </div>
            </div>
            <div class="row g-1 mb-1">
                <div class="col-4">
                    <label class="form-label mb-0 small" title="OPC UA alarm severity (1–1000) for anomaly alerts. Default 600.">
                        Severity <span class="vde-hint">ⓘ</span>
                    </label>
                    <input type="number" class="form-control form-control-sm" min="1" max="1000"
                           @bind="Variable.AnomalyDetection.Severity" @bind:after="OnAnomalyChanged" />
                </div>
                <div class="col-8">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox"
                               @bind="Variable.AnomalyDetection.EnableTrendPrediction" @bind:after="OnAnomalyChanged" />
                        <label class="form-check-label small"
                               title="Use linear regression on historical data to predict if a limit alarm will be breached within the prediction horizon.">
                            📈 Trend Prediction <span class="vde-hint">ⓘ</span>
                        </label>
                    </div>
                </div>
            </div>
            @if (Variable.AnomalyDetection.EnableTrendPrediction)
            {
                <div class="row g-1 mb-1">
                    <div class="col-6">
                        <label class="form-label mb-0 small" title="How far ahead (in minutes) to project the linear trend to detect upcoming limit breaches. Default 30.">
                            Prediction Horizon (min) <span class="vde-hint">ⓘ</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" min="1"
                               @bind="Variable.AnomalyDetection.PredictionHorizonMinutes" @bind:after="OnAnomalyChanged" />
                    </div>
                </div>
                @if (Variable.Alarm == null)
                {
                    <div class="vde-desc" style="color: var(--warning-color);">⚠️ Trend prediction requires an <strong>Alarm</strong> with limit thresholds configured above.</div>
                }
            }
            <div class="vde-desc">Detects abnormal values using Z-score analysis on historical data.</div>
        </div>
    }
</div>

<style>
    /* Theme-aware card styling */
    .vde-card {
        border-color: var(--border-color);
    }
    .vde-card-header {
        background: var(--bg-tertiary);
        border-bottom-color: var(--border-color);
    }
    .vde-card-body {
        background: var(--bg-secondary);
    }
    /* Info hint icon */
    .vde-hint {
        color: var(--text-muted);
        font-size: 9px;
        cursor: help;
    }
    /* Description text below fields */
    .vde-desc {
        font-size: 9px;
        color: var(--text-muted);
        margin-top: 1px;
        line-height: 1.2;
    }
    .vde-test-result { border-radius: 4px; font-size: 11px; }
    .vde-test-ok { background: color-mix(in srgb, var(--bs-success, #198754) 12%, transparent); border: 1px solid color-mix(in srgb, var(--bs-success, #198754) 30%, transparent); }
    .vde-test-err { background: color-mix(in srgb, var(--bs-danger, #dc3545) 12%, transparent); border: 1px solid color-mix(in srgb, var(--bs-danger, #dc3545) 30%, transparent); }
    /* Progress indicator */
    .vde-progress {
        border-radius: 4px;
        font-size: 11px;
        background: color-mix(in srgb, var(--bs-info, #0dcaf0) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--bs-info, #0dcaf0) 25%, transparent);
    }
    .vde-spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid color-mix(in srgb, var(--bs-info, #0dcaf0) 30%, transparent);
        border-top-color: var(--bs-info, #0dcaf0);
        border-radius: 50%;
        animation: vde-spin 0.8s linear infinite;
    }
    @@keyframes vde-spin { to { transform: rotate(360deg); } }
    .vde-progress-bar {
        height: 3px;
        border-radius: 2px;
        background: color-mix(in srgb, var(--bs-info, #0dcaf0) 15%, transparent);
        overflow: hidden;
    }
    .vde-progress-bar-fill {
        height: 100%;
        width: 40%;
        border-radius: 2px;
        background: var(--bs-info, #0dcaf0);
        animation: vde-indeterminate 1.4s ease-in-out infinite;
    }
    @@keyframes vde-indeterminate {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(350%); }
    }
</style>

@code {
    [Parameter] public Variable Variable { get; set; } = default!;
    [Parameter] public VariableNode VariableNode { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly string[] _availableDrivers =
        ["Modbus", "S7", "OpcUaClient", "Mqtt", "Rest", "Csv", "Tcp", "Sql", "EtherNetIP", "Knx", "Simulation"];

    private List<string> _configuredDrivers = new();
    private Dictionary<string, object> _configCache = new();
    private string _selectedDriverToAdd = "";


    private bool _testBusy;
    private string? _testDriverKey;
    private string _testOperation = "read";
    private ServerEditorWeb.Services.DriverTestResult? _testResult;

    private string? _writeDriverKey;
    private string _testWriteValue = "";
    private ServerEditorWeb.Services.DriverTestResult? _writeResult;

    protected override void OnParametersSet()
    {
        RefreshFromJson();
    }

    private void RefreshFromJson()
    {
        _configuredDrivers.Clear();
        _configCache.Clear();
        if (Variable.DriverConfigs == null) return;
        foreach (var kvp in Variable.DriverConfigs)
            _configuredDrivers.Add(kvp.Key);
    }

    private T GetConfig<T>(string driverKey) where T : new()
    {
        var cacheKey = driverKey + typeof(T).Name;
        if (_configCache.TryGetValue(cacheKey, out var cached))
            return (T)cached;

        T result = new();
        if (Variable.DriverConfigs != null && Variable.DriverConfigs.TryGetValue(driverKey, out var elem))
        {
            try { result = JsonSerializer.Deserialize<T>(elem.GetRawText(), _jsonOpts) ?? new T(); }
            catch { }
        }
        _configCache[cacheKey] = result;
        return result;
    }

    private void SetConfig<T>(string driverKey, T config)
    {
        _configCache[driverKey + typeof(T).Name] = config!;
        Variable.DriverConfigs ??= new();
        var json = JsonSerializer.Serialize(config);
        Variable.DriverConfigs[driverKey] = JsonSerializer.Deserialize<JsonElement>(json);
        SyncJsonEditor();
        OnChanged.InvokeAsync();
    }

    private void SyncJsonEditor()
    {
        VariableNode.DriverSettingsJson = Variable.DriverConfigs is { Count: > 0 }
            ? JsonSerializer.Serialize(Variable.DriverConfigs, _jsonWriteOpts)
            : "{}";
    }

    private void AddSelectedDriver()
    {
        if (string.IsNullOrEmpty(_selectedDriverToAdd) || _configuredDrivers.Contains(_selectedDriverToAdd)) return;
        Variable.DriverConfigs ??= new();
        Variable.DriverConfigs[_selectedDriverToAdd] = JsonSerializer.Deserialize<JsonElement>("{}");
        _configuredDrivers.Add(_selectedDriverToAdd);
        _selectedDriverToAdd = "";
        SyncJsonEditor();
        OnChanged.InvokeAsync();
    }

    private void RemoveDriver(string key)
    {
        Variable.DriverConfigs?.Remove(key);
        _configuredDrivers.Remove(key);
        _configCache.Remove(key);
        SyncJsonEditor();
        OnChanged.InvokeAsync();
    }

    private void EnableAlarm() { Variable.Alarm = new AlarmConfig(); SyncJsonEditor(); OnChanged.InvokeAsync(); }
    private void DisableAlarm() { Variable.Alarm = null; SyncJsonEditor(); OnChanged.InvokeAsync(); }
    private void OnAlarmChanged() { SyncJsonEditor(); OnChanged.InvokeAsync(); }

    private void EnableAnomalyDetection() { Variable.AnomalyDetection = new AnomalyDetectionConfig { Enabled = true }; SyncJsonEditor(); OnChanged.InvokeAsync(); }
    private void DisableAnomalyDetection() { Variable.AnomalyDetection = null; SyncJsonEditor(); OnChanged.InvokeAsync(); }
    private void OnAnomalyChanged() { SyncJsonEditor(); OnChanged.InvokeAsync(); }

    // Helpers for onchange handlers that assign string fields
    private void SetString<T>(string driverKey, T config, Action<T, string> setter, ChangeEventArgs e)
    {
        setter(config, e.Value?.ToString() ?? string.Empty);
        SetConfig(driverKey, config);
    }
    private void SetInt<T>(string driverKey, T config, Action<T, int> setter, ChangeEventArgs e, int fallback = 0)
    {
        setter(config, int.TryParse(e.Value?.ToString(), out var v) ? v : fallback);
        SetConfig(driverKey, config);
    }
    private void SetDouble<T>(string driverKey, T config, Action<T, double> setter, ChangeEventArgs e, double fallback = 0)
    {
        setter(config, double.TryParse(e.Value?.ToString(), out var v) ? v : fallback);
        SetConfig(driverKey, config);
    }
    private void SetNullableString<T>(string driverKey, T config, Action<T, string?> setter, ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        setter(config, string.IsNullOrEmpty(s) ? null : s);
        SetConfig(driverKey, config);
    }

    private static readonly JsonSerializerOptions _jsonOpts = new() { PropertyNameCaseInsensitive = true };
    private static readonly JsonSerializerOptions _jsonWriteOpts = new() { WriteIndented = true };

    private static double? ParseNullableDouble(object? value)
    {
        var s = value?.ToString();
        if (string.IsNullOrWhiteSpace(s)) return null;
        return double.TryParse(s, out var v) ? v : null;
    }

    private static string DriverIcon(string key) => key switch
    {
        "Modbus" => "🔧", "S7" => "🏭", "OpcUaClient" => "🔗", "Mqtt" => "📡",
        "Rest" => "🌐", "Csv" => "📄", "Tcp" => "🔌", "Sql" => "🗄️",
        "EtherNetIP" => "⚙️", "Knx" => "🏠", "Simulation" => "📈", _ => "❓"
    };

