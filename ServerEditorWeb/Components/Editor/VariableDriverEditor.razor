    // Driver Test helpers
    private string? GetDriverConfigJson(string driverKey)
    {
        if (Variable.DriverConfigs != null && Variable.DriverConfigs.TryGetValue(driverKey, out var elem))
            return elem.GetRawText();
        return null;
    }

    private async Task RunDriverTest(string driverKey)
    {
        var json = GetDriverConfigJson(driverKey);
        if (json is null)
        {
            _testDriverKey = driverKey;
            _testResult = new DriverTestResult(false, "No configuration found for this driver.", null);
            return;
        }
        _testBusy = true;
        _testDriverKey = driverKey;
        _testOperation = "read";
        _testResult = null;
        StateHasChanged();
        try
        {
            _testResult = await _driverTestSvc.TestReadAsync(driverKey, json);
        }
        catch (Exception ex)
        {
            _testResult = new DriverTestResult(false, ex.Message, null);
        }
        finally { _testBusy = false; }
    }

    private void DismissTestResult() { _testResult = null; _testDriverKey = null; }

    private void ToggleWritePanel(string driverKey)
    {
        if (_writeDriverKey == driverKey) { DismissWritePanel(); return; }
        _writeDriverKey = driverKey;
        _testWriteValue = "";
        _writeResult = null;
    }

    private void DismissWritePanel() { _writeDriverKey = null; _testWriteValue = ""; _writeResult = null; }

    private async Task RunDriverTestWrite(string driverKey)
    {
        var json = GetDriverConfigJson(driverKey);
        if (json is null)
        {
            _writeResult = new DriverTestResult(false, "No configuration found for this driver.", null);
            return;
        }
        _testBusy = true;
        _testDriverKey = driverKey;
        _testOperation = "write";
        _writeResult = null;
        StateHasChanged();
        try
        {
            _writeResult = await _driverTestSvc.TestWriteAsync(driverKey, json, _testWriteValue);
        }
        catch (Exception ex)
        {
            _writeResult = new DriverTestResult(false, ex.Message, null);
        }
        finally { _testBusy = false; }
    }

    private static string WriteHint(string key) => key switch
    {
        "Modbus" => "Value (0–65535 or true/false)",
        "S7" => "Value to write",
        "OpcUaClient" => "Value to write",
        "Mqtt" => "Message payload to publish",
        "Tcp" => "Data to send (\\r\\n for line ending)",
        "Sql" => "SQL statement (UPDATE/INSERT)",
        _ => "Value"
    };

    // ─── OPC Item Picker ─────────────────────────────────────
    private bool _showOpcPicker;
    private string? _opcPickerDriverKey;

    private void OpenOpcPicker(string driverKey)
    {
        _opcPickerDriverKey = driverKey;
        _showOpcPicker = true;
    }

    private void OnOpcItemPicked((string EndpointUrl, string NodeId) selection)
    {
        _showOpcPicker = false;
        if (_opcPickerDriverKey == null) return;

        var c = GetConfig<OpcUaClientFields>(_opcPickerDriverKey);
        c.EndpointUrl = selection.EndpointUrl;
        c.NodeId = selection.NodeId;
        SetConfig(_opcPickerDriverKey, c);
        _opcPickerDriverKey = null;
    }
