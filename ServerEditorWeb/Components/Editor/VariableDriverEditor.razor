    private RenderFragment RenderDriverFields(string key) => key switch
    {
        "Modbus" => RenderModbus(key),
        "S7" => RenderS7(key),
        "OpcUaClient" => RenderOpcUaClient(key),
        "Mqtt" => RenderMqtt(key),
        "Rest" => RenderRest(key),
        "Csv" => RenderCsv(key),
        "Tcp" => RenderTcp(key),
        "Sql" => RenderSql(key),
        "EtherNetIP" => RenderEtherNetIP(key),
        "Knx" => RenderKnx(key),
        "Simulation" => RenderSimulation(key),
