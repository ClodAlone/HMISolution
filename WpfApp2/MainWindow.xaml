<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        xmlns:ad="http://schemas.xceed.com/wpf/xaml/avalondock"
        mc:Ignorable="d"
        Title="VS2026 Layout Simulator" Height="700" Width="1400"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource ForegroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource PanelBackgroundColor}" Margin="0,0,0,1" Height="30">
            <Menu>
                <MenuItem Header="File"/>
                <MenuItem Header="Edit"/>
                <MenuItem Header="View">
                    <MenuItem Header="Theme">
                        <MenuItem Header="Dark" Click="DarkTheme_Click"/>
                        <MenuItem Header="Light" Click="LightTheme_Click"/>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </StackPanel>

        <!-- Main Content with DockingManager -->
        <ad:DockingManager Grid.Row="1">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <!-- Left Panel: Solution Explorer -->
                    <ad:LayoutAnchorablePane DockWidth="250">
                        <ad:LayoutAnchorable Title="Solution Explorer" CanClose="False" CanAutoHide="True">
                            <TreeView>
                                <TreeViewItem Header="WpfApp2" IsExpanded="True">
                                    <TreeViewItem Header="Properties"/>
                                    <TreeViewItem Header="References"/>
                                    <TreeViewItem Header="MainWindow.xaml"/>
                                    <TreeViewItem Header="App.xaml"/>
                                </TreeViewItem>
                            </TreeView>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>

                    <!-- Center Panel: Documents -->
                    <ad:LayoutDocumentPane>
                        <ad:LayoutDocument Title="MainWindow.xaml" ContentId="doc1">
                            <Grid>
                                <TextBlock Text="MainWindow.xaml" 
                                          Margin="10" FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </ad:LayoutDocument>
                        <ad:LayoutDocument Title="App.xaml" ContentId="doc2">
                            <Grid>
                                <TextBlock Text="App.xaml" 
                                          Margin="10" FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </ad:LayoutDocument>
                    </ad:LayoutDocumentPane>

                    <!-- Right Panel: Properties -->
                    <ad:LayoutAnchorablePane DockWidth="300">
                        <ad:LayoutAnchorable Title="Properties" CanClose="False" CanAutoHide="True">
                            <Grid>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Properties" 
                                              FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Name:" Margin="0,5,0,2"/>
                                    <TextBox Margin="0,0,0,10"/>
                                    <TextBlock Text="Type:" Margin="0,5,0,2"/>
                                    <TextBox/>
                                </StackPanel>
                            </Grid>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>

        <!-- Bottom Panel: Output/Error List/Background Tasks -->
        <ad:DockingManager Grid.Row="2">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePane>
                        <ad:LayoutAnchorable Title="Output" ContentId="output" CanClose="False">
                            <Grid>
                                <TextBlock Text="Build output will appear here..." 
                                          Margin="10" VerticalAlignment="Top"/>
                            </Grid>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable Title="Error List" ContentId="errors" CanClose="False">
                            <Grid>
                                <TextBlock Text="No errors or warnings" 
                                          Margin="10" VerticalAlignment="Top"/>
                            </Grid>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable Title="Background Tasks" ContentId="tasks" CanClose="False">
                            <Grid Background="{DynamicResource PanelBackgroundColor}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Task Buttons -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" Height="35">
                                    <Button Content="Start Sample Task" Click="StartSampleTask_Click" 
                                           Margin="5" Padding="10,5" Background="{DynamicResource AccentColor}" 
                                           Foreground="{DynamicResource ForegroundColor}" Cursor="Hand"/>
                                    <Button Content="Start Build" Click="StartBuild_Click" 
                                           Margin="5" Padding="10,5" Background="{DynamicResource AccentColor}" 
                                           Foreground="{DynamicResource ForegroundColor}" Cursor="Hand"/>
                                    <Button Content="Clear Completed" Click="ClearCompleted_Click" 
                                           Margin="5" Padding="10,5" Background="{DynamicResource PanelBorderColor}" 
                                           Foreground="{DynamicResource ForegroundColor}" Cursor="Hand"/>
                                </StackPanel>

                                <!-- Tasks List -->
                                <ListBox Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding Tasks}" 
                                        Background="{DynamicResource PanelBackgroundColor}" 
                                        Foreground="{DynamicResource ForegroundColor}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5" Background="{DynamicResource BackgroundColor}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TaskName}" 
                                                          FontWeight="Bold" Margin="5"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" TextAlignment="Right" Margin="5" HorizontalAlignment="Right">
                                                    <Run Text="{Binding PercentComplete, Mode=OneWay}"/>
                                                    <Run Text="%"/>
                                                </TextBlock>

                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding PercentComplete}" 
                                                            Maximum="100" Height="20" Margin="5"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Status}" 
                                                          Margin="5" FontSize="12"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentStatus}" 
                                                          TextAlignment="Right" Margin="5" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </Grid>
</Window>
