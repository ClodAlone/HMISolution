<ResourceDictionary              
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" 
             xmlns:properties="clr-namespace:TrendRealTimeSlim.Properties;assembly=TrendRealTimeSlim"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:locals="clr-namespace:TrendRealTimeSlim.Converters;assembly=TrendRealTimeSlim">

    <locals:YTextConverter x:Key="yTextConverter" />
    <locals:TextConverter x:Key="textConverter" />
    <locals:TextMultiConverter x:Key="TextMultiConverter" />
    <converters:DateFormatConverter x:Key="DateFormatConverter" />
    <converters:TimeFormatConverter x:Key="TimeFormatConverter" />
    <DataTemplate x:Key="XlabelTemplateFull">
        <StackPanel Orientation="Vertical" Margin="0,2,0,0">
            <TextBlock HorizontalAlignment="Center"
							Foreground="{Binding AxisLabelForeground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontSize="{Binding XAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding XAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding XAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding XAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="DateFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource DateFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center"
							Foreground="{Binding AxisLabelForeground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontSize="{Binding XAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding XAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding XAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding XAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="TimeFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource TimeFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="XlabelTemplate">
        <StackPanel Orientation="Vertical" Margin="0,2,0,0">
            <TextBlock HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="DateFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource DateFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="TimeFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource TimeFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="XlabelTemplateFont">
        <StackPanel Orientation="Vertical" Margin="0,2,0,0">
            <TextBlock HorizontalAlignment="Center"
							FontSize="{Binding XAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding XAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding XAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding XAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="DateFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource DateFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center"
							FontSize="{Binding XAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding XAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding XAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding XAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="TimeFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource TimeFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="XlabelTemplateFore">
        <StackPanel Orientation="Vertical" Margin="0,2,0,0">
            <TextBlock HorizontalAlignment="Center" 
                            Foreground="{Binding AxisLabelForeground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">

                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="DateFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource DateFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center"
							Foreground="{Binding AxisLabelForeground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource TextMultiConverter}">
                        <Binding />
                        <Binding Path="TimeFormat" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Converter="{StaticResource TimeFormatConverter}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="YlabelTemplateFull">
        <TextBlock Margin="10,0,10,0"  HorizontalAlignment="Right" TextAlignment="Justify"  
							Foreground="{Binding AxisLabelForeground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontSize="{Binding YAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding YAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding YAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding YAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" >
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource yTextConverter}">
                    <Binding />
                    <Binding Path="PointFormat" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="YlabelTemplate">
        <TextBlock Margin="10,0,10,0"  HorizontalAlignment="Right" TextAlignment="Justify">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource yTextConverter}">
                    <Binding />
                    <Binding Path="PointFormat" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="YlabelTemplateFont">
        <TextBlock Margin="10,0,10,0"  HorizontalAlignment="Right" TextAlignment="Justify"
							FontSize="{Binding YAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding YAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding YAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding YAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" >
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource yTextConverter}">
                    <Binding />
                    <Binding Path="PointFormat" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="YlabelTemplateFore">
        <TextBlock Margin="10,0,10,0"  HorizontalAlignment="Right" TextAlignment="Justify" 
							Foreground="{Binding AxisLabelForeground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource yTextConverter}">
                    <Binding />
                    <Binding Path="PointFormat" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="SecYlabelTemplateFull">
        <TextBlock Margin="10,0,10,0"  HorizontalAlignment="Right" TextAlignment="Justify" 
							Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Control}, AncestorLevel=2, Mode=FindAncestor}}"
							FontSize="{Binding YAxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontFamily="{Binding YAxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontWeight="{Binding YAxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
							FontStyle="{Binding YAxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" >
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource yTextConverter}">
                    <Binding />
                    <Binding Path="PointFormat" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="SecYlabelTemplateFore">
        <TextBlock Margin="10,0,10,0"  HorizontalAlignment="Right" TextAlignment="Justify"
							Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Control}, AncestorLevel=2, Mode=FindAncestor}}">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource yTextConverter}">
                    <Binding />
                    <Binding Path="PointFormat" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>


    <DataTemplate x:Key="legendAreaHeaderTemplate">
        <TextBlock Background="Transparent" Text="{Binding}" Foreground="{Binding LegendAreaForeground, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"  Width="Auto" Grid.Column="0" />
    </DataTemplate>
</ResourceDictionary>
