<UserControl xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  x:Class="TrendRealTimeSlim.Controls.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:TrendRealTimeSlim.Properties"
             xmlns:smartutils="clr-namespace:SmartControlUtilities.Controls;assembly=SmartControlUtilities"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             mc:Ignorable="d" Width="900" Height="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1"  x:Name="commands">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddPen}" Margin="5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="1" IsEnabled="False" x:Name="btnDelete" 
                        ToolTip="{x:Static properties:Resources.RemovePen}" Click="OnDelete" Margin="5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2" IsEnabled="True" x:Name="btnClearAll" 
                        ToolTip="{x:Static properties:Resources.ClearAll}" Click="ClearAll_Click">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <dxg:GridControl Visibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AllowDrop="False" Grid.Row="0" MinWidth="2" x:Name="gridControl">
                <dxg:GridControl.Columns>
                  <dxg:GridColumn DisplayMemberBinding="{Binding Path=Visible, Mode=TwoWay}" Header="{x:Static properties:Resources.VisibleTitle}">
                    <dxg:GridColumn.EditSettings>
                      <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn DisplayMemberBinding="{Binding Path=LColor, Mode=TwoWay}" Header="{x:Static properties:Resources.ColorTitle}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <commoncontrols:CustomPopupColorEdit Name="PART_Editor" Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" BrushSelected="OnBrushSelected" Color="{Binding RowData.Row.LColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn MinWidth="50" Header="{x:Static properties:Resources.PenName}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <TextBox IsReadOnly="False" IsHitTestVisible="True" x:Name="text" HorizontalAlignment="Stretch" 
                                                 Text="{Binding Path=Data.Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="text_TextChanged" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn MinWidth="50" AllowDrop="False" AllowEditing="False" DisplayMemberBinding="{Binding Path=tagName, Mode=TwoWay}" Header="{x:Static properties:Resources.TagName}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                              <smartutils:TagSelector NodeID="NodeId" RuntimeVersion="True" ReferencedTag="TagReference" ColumnPropName="ColuName"
                                  OnApplyChanges="TagSelector_OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                  <dxg:GridColumn DisplayMemberBinding="{Binding Path=AutoScale, Mode=TwoWay}" Header="{x:Static properties:Resources.AutomaticScale}">
                    <dxg:GridColumn.EditSettings>
                      <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn x:Name="useEUMinMaxColumn" DisplayMemberBinding="{Binding Path=UseEURange, Mode=TwoWay}" Header="{x:Static properties:Resources.EUnit}">
                    <dxg:GridColumn.EditSettings>
                      <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                  </dxg:GridColumn>
                  <dxg:GridColumn DisplayMemberBinding="{Binding Path=ShowAxis, Mode=TwoWay}" Header="{x:Static properties:Resources.ShowAxis}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:CheckEditSettings/>
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=Range.Low, Mode=TwoWay}" Header="{x:Static properties:Resources.Min}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="g" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=Range.High, Mode=TwoWay}" Header="{x:Static properties:Resources.Max}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="g" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=serieTypeLine, Mode=TwoWay}" Header="{x:Static properties:Resources.PenStyle}">

                        <dxg:GridColumn.EditTemplate>
                            <ControlTemplate>
                                <dxe:ComboBoxEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.useTableAggregation,Converter={StaticResource InverseBooleanConverter}}" 
                                          HorizontalContentAlignment="Left"                                        
                                          EditValue="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}" 
                                          SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                                          EditorActivated="LINE_Editor_DropDownOpened"
                                          IsTextEditable="False"
                                          AllowNullInput="False" 
                                          AcceptsReturn="False"
                                          AutoComplete="False" 
                                          ImmediatePopup="True">
                                </dxe:ComboBoxEdit>
                            </ControlTemplate>
                        </dxg:GridColumn.EditTemplate>
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit Name="PART_Editor" 
                                      IsEnabled="{Binding RowData.Row.useTableAggregation,Converter={StaticResource InverseBooleanConverter}}"/>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn x:Name="arrayIndex" DisplayMemberBinding="{Binding Path=ArrayIndex, Mode=TwoWay}" Header="{x:Static properties:Resources.ArrayIndex}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=StrokeThickness, Mode=TwoWay}" Header="{x:Static properties:Resources.StrokeThickness}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowMoveColumnToDropArea="False" 
                                       Name="tableView" ShowTotalSummary="False" 
                                       FocusedRowChanged="tableView_FocusedRowChanged"
                                       CellValueChanging="tableView_CellValueChanging"
                                       CellValueChanged="tableView_CellValueChanged" 
                                       AutoWidth="true" ShowGroupPanel="False" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
