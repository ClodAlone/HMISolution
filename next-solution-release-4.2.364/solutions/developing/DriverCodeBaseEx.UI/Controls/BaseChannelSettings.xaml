<UserControl x:Class="DriverCodeBaseEx.UI.Controls.BaseChannelSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:local="clr-namespace:DriverCodeBaseEx.Converters;assembly=DriverCodeBaseEx"
             xmlns:locControls="clr-namespace:DriverCodeBaseEx.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />            
            <local:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--<GridSplitter Grid.Column="1" Grid.RowSpan="7" HorizontalAlignment="Stretch" Background="Transparent" />-->
        <TextBlock Text="{x:Static properties:Resources.Name}"  VerticalAlignment="Center" x:FieldModifier="public" Name="ChNameText" Grid.Row="0"/>
        <TextBox Name="ChName" Grid.Column="2" Grid.Row="0" x:FieldModifier="public" 
                 Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged }"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"> </TextBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="ChNameErr"
            Content="{Binding ElementName=ChName, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.WaitTime}" VerticalAlignment="Center" x:FieldModifier="public" Name="WaitTimeText" Grid.Row="1"/>
        <TextBox Name="WaitTime" Grid.Column="2" Grid.Row="1" x:FieldModifier="public"
                 Text="{Binding WaitTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="WaitTimeErr"
            Content="{Binding ElementName=WaitTime, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.Timeout}" VerticalAlignment="Center" x:FieldModifier="public" Name="TimeoutText" Grid.Row="2"/>
        <TextBox Name="Timeout" Grid.Column="2" Grid.Row="2" x:FieldModifier="public"
                 Text="{Binding Timeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="2" Grid.Column="3" x:FieldModifier="public" Name="TimeoutErr"
            Content="{Binding ElementName=Timeout, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.PollingNotInUseTime}" VerticalAlignment="Center" x:FieldModifier="public" Name="PollNotUseText" Grid.Row="3"/>
        <TextBox Name="PollNotUse" Grid.Column="2" Grid.Row="3" x:FieldModifier="public"
                 Text="{Binding PollingTimeNotInUse, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="3" Grid.Column="3" x:FieldModifier="public" Name="PollNotUseErr"
            Content="{Binding ElementName=PollNotUse, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.PollingInErrorTime}" VerticalAlignment="Center" x:FieldModifier="public" Name="PollErrorText" Grid.Row="4"/>
        <TextBox Name="PollError" Grid.Column="2" Grid.Row="4" x:FieldModifier="public"
                 Text="{Binding PollingTimeInError, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="4" Grid.Column="3" x:FieldModifier="public" Name="PollErrorErr"
            Content="{Binding ElementName=PollError, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.StateCommandVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TXBStateCommandVariable" Grid.Row="5"/>
        <locControls:StateCommand Grid.Row="5" Grid.Column="2" x:FieldModifier="public"  x:Name="DKPStateCommandVariable"/>
        <ContentPresenter Grid.Row="5" Grid.Column="3" 
            Content="{Binding ElementName=DKPStateCommandVariable, Path=(Validation.Errors).CurrentItem}"/>

    </Grid>
</UserControl>
