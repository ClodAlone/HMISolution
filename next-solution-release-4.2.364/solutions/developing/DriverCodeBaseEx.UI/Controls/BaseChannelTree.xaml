<UserControl x:Class="DriverCodeBaseEx.UI.Controls.BaseChannelTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:self="clr-namespace:DriverCodeBaseEx.UI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
        </ResourceDictionary>
    </UserControl.Resources>
    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewChannel}" Content="{x:Static properties:UICommandResource.AddNewChannelText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewStation}" Content="{x:Static properties:UICommandResource.AddNewStationText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.TestComm}" Content="{x:Static properties:UICommandResource.TestCommText}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarSubItem Content="{x:Static self:Properties.UICommandResource.EditMenuText}">
                    <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                    <dxb:BarButtonItem Command="Properties" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                </dxb:BarSubItem>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>
    <UserControl.CommandBindings>
        <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />
        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />
        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewStation}" 
                    Executed="OnAddNewStation" 
                    CanExecute="CanAddNewStation" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewChannel}" 
                    Executed="OnAddNewChannel" 
                    CanExecute="CanAddNewChannel" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.TestComm}" 
                    Executed="OnTestComm" 
                    CanExecute="CanTestComm" />
    </UserControl.CommandBindings>
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button ToolTipService.ShowOnDisabled="True" Grid.Row="0" Grid.Column="0" Name="btnAdd" Content="{x:Static properties:Resources.AddChannel}" Command="{x:Static self:UIGeneralCommands.AddNewChannel}" ></Button> <!--Click="ChannelAdd_Click"-->
            <Button ToolTipService.ShowOnDisabled="True" Grid.Row="0" Grid.Column="1" Name="btnAddStation" Content="{x:Static properties:Resources.AddStation}" Command="{x:Static self:UIGeneralCommands.AddNewStation}" ></Button> <!--Click="StationAdd_Click"-->
            <Button ToolTipService.ShowOnDisabled="True" Grid.Row="0" Grid.Column="2" Name="btnEdit" Content="{x:Static properties:Resources.Edit}" Command="ApplicationCommands.Properties"></Button>
            <Button ToolTipService.ShowOnDisabled="True" Grid.Row="0" Grid.Column="3" Name="btnDel" Content="{x:Static properties:Resources.Delete}" Command="ApplicationCommands.Delete"></Button>
            <Button ToolTipService.ShowOnDisabled="True" Grid.Row="0" Grid.Column="4" Name="btnTestComm" Content="{x:Static properties:Resources.TestComm}" Command="{x:Static self:UIGeneralCommands.TestComm}" Visibility="Collapsed"></Button>
        </Grid>

        <dxg:TreeListControl Grid.Row="2" x:Name="treeListControl" SelectionMode="Row" SelectedItemChanged="TreeListControl_SelectedItemChanged">
            <dxg:TreeListControl.Columns>
                <dxg:TreeListColumn FieldName="ItemHeader" FilterPopupMode="Excel" SortIndex="0" SortOrder="Ascending" Header="{x:Static properties:Resources.ChannelName}" />
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                        ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                        AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                        ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                        IsSynchronizedWithCurrentItem="True" NodeExpanding="OnTreeNodeExpanding"
                                        RowDoubleClick="OnRowDoubleClick" AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing">
                    <!-- AllowDragDrop="True" StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd"
                                        CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"-->
                    <dxg:TreeListView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                            <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                        </Style>
                    </dxg:TreeListView.RowStyle>
                    <dxg:TreeListView.CellStyle>
                        <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                          <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                        </Style>
                    </dxg:TreeListView.CellStyle>
                </dxg:TreeListView>
            </dxg:TreeListControl.View>
            <!--<dxg:TreeListControl.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
            </dxg:TreeListControl.CommandBindings>-->
        </dxg:TreeListControl>
    </Grid>
</UserControl>
