<ResourceDictionary              
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" 
             xmlns:properties="clr-namespace:Trends.Properties;assembly=Trends"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:locals="clr-namespace:Trends.Converters;assembly=Trends">

    <DataTemplate x:Key="ColumnHeaderTemplate">
        <Border>
            <ContentPresenter Name="contentPresenter" Content="{Binding}" TextBlock.Foreground="{Binding ControlForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                     Style="{Binding  Path=(dxg:BaseGridHeader.GridColumn).ActualColumnHeaderContentStyle, RelativeSource={RelativeSource TemplatedParent}}">
            </ContentPresenter>
        </Border>
    </DataTemplate>
</ResourceDictionary>
