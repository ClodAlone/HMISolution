<UserControl x:Class="Trends.Chart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" 
             xmlns:properties="clr-namespace:Trends.Properties"
             xmlns:locals="clr-namespace:Trends.Converters"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <locals:SampleToMaxValue x:Key="SampleToMaxValue" />
            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="{Binding DefToolbarHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="5" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <ControlTemplate x:Key="legendTemplate" TargetType="dxc:Legend">
                <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding LegendMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                        <dxc:LegendItemsControl ReverseItems="True" 
                                                ItemTemplate="{TemplateBinding ItemTemplate}" 
                                                LegendItems="{Binding Path=Items, RelativeSource={RelativeSource TemplatedParent}}">
                            <dxc:LegendItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </dxc:LegendItemsControl.ItemsPanel>
                        </dxc:LegendItemsControl>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>

          <dxc:PointOptions x:Key="pointOption">
            <dxc:PointOptions.ValueNumericOptions>
              <dxc:NumericOptions Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                  Format="FixedPoint" />
            </dxc:PointOptions.ValueNumericOptions>
          </dxc:PointOptions>

          <dxc:PointOptions x:Key="integerPointOption">
            <dxc:PointOptions.ValueNumericOptions>
              <dxc:NumericOptions Precision="0"
                                  Format="FixedPoint" />
            </dxc:PointOptions.ValueNumericOptions>
          </dxc:PointOptions>

          <dxc:PointOptions x:Key="integerPercentPointOption"  PointView="ArgumentAndValues">
            <dxc:PointOptions.ValueNumericOptions>
              <dxc:NumericOptions Precision="0"
                                  Format="Percent" />
            </dxc:PointOptions.ValueNumericOptions>
            <dxc:PieSeries.PercentOptions>
              <dxc:PercentOptions ValueAsPercent="True"/>
            </dxc:PieSeries.PercentOptions>
          </dxc:PointOptions>

          <dxc:PointOptions x:Key="percentPointOption"  PointView="ArgumentAndValues">
            <dxc:PointOptions.ValueNumericOptions>
              <dxc:NumericOptions Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                  Format="Percent" />
            </dxc:PointOptions.ValueNumericOptions>
            <dxc:PieSeries.PercentOptions>
              <dxc:PercentOptions ValueAsPercent="True" PercentageAccuracy="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"/>
            </dxc:PieSeries.PercentOptions>
          </dxc:PointOptions>



          <!--2DLinestyles-->
            <dxc:LineSeries2D x:Key="seriesLineStyle" x:Shared="False"
                          AnimationAutoStartMode="SetStartState" PointOptions="{StaticResource pointOption}"
                          MarkerSize="5">
                <dxc:LineSeries2D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:LineSeries2D.Label>
            </dxc:LineSeries2D>

            <dxc:LineStepSeries2D x:Key="seriesStepLineStyle" x:Shared="False"
                          AnimationAutoStartMode="SetStartState"  PointOptions="{StaticResource pointOption}"
                          MarkerSize="5">
                <dxc:LineStepSeries2D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:LineStepSeries2D.Label>
            </dxc:LineStepSeries2D>

            <!--<dxc:LineFullStackedSeries2D x:Key="seriesFullStackedStyle" x:Shared="False"
								            AnimationAutoStartMode="SetStartState" 
                          MarkerSize="5">
                <dxc:LineFullStackedSeries2D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:LineFullStackedSeries2D.Label>
            </dxc:LineFullStackedSeries2D>-->
            <dxc:BarSideBySideSeries2D x:Key="seriesColumnStyle" x:Shared="False"
                                    BarWidth="0.5" PointOptions="{StaticResource pointOption}"
								    AnimationAutoStartMode="SetStartState" >
                <dxc:BarSideBySideSeries2D.Label>
                    <dxc:SeriesLabel    Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:BarSideBySideSeries2D.Label>
            </dxc:BarSideBySideSeries2D>

            <dxc:PointSeries2D x:Key="seriesScatterStyle" x:Shared="False"
                          AnimationAutoStartMode="SetStartState" PointOptions="{StaticResource pointOption}"
                          MarkerSize="8">
                <dxc:PointSeries2D.MarkerModel>
                    <dxc:SquareMarker2DModel/>
                </dxc:PointSeries2D.MarkerModel>
                <dxc:PointSeries2D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:PointSeries2D.Label>
            </dxc:PointSeries2D>
            
            <dxc:AreaSeries2D x:Key="seriesAreaStyle" x:Shared="False"
                          Transparency="0.5"  PointOptions="{StaticResource pointOption}"
							AnimationAutoStartMode="SetStartState" 
                          MarkerSize="5">
                <dxc:AreaSeries2D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaSeries2D.Label>
            </dxc:AreaSeries2D>

            <!--<dxc:AreaStepSeries2D x:Key="seriesAreaStepStyle" x:Shared="False"
                            Transparency="0.5" 
							AnimationAutoStartMode="SetStartState" 
                          MarkerSize="5">
                <dxc:AreaStepSeries2D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaStepSeries2D.Label>
            </dxc:AreaStepSeries2D>

            <dxc:AreaStackedSeries2D x:Key="seriesAreaStackedStyle" x:Shared="False"
                            Transparency="0.5" 
							AnimationAutoStartMode="SetStartState" >
                <dxc:AreaStackedSeries2D.Label>
                    <dxc:SeriesLabel   Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaStackedSeries2D.Label>
            </dxc:AreaStackedSeries2D>

            <dxc:AreaFullStackedSeries2D x:Key="seriesAreaFullStackedStyle" x:Shared="False"
                            Transparency="0.5" 
							AnimationAutoStartMode="SetStartState" >
                <dxc:AreaFullStackedSeries2D.Label>
                    <dxc:SeriesLabel   Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaFullStackedSeries2D.Label>
            </dxc:AreaFullStackedSeries2D>-->

            <!--3DLinestyles-->
            <dxc:AreaSeries3D x:Key="seriesLineStyle3D" x:Shared="False" PointOptions="{StaticResource pointOption}"
								AnimationAutoStartMode="SetStartState" >
                <dxc:AreaSeries3D.Label>
                    <dxc:SeriesLabel    Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaSeries3D.Label>
            </dxc:AreaSeries3D>
            <dxc:AreaStackedSeries3D ArgumentScaleType="Numerical" x:Key="seriesStepLineStyle3D" x:Shared="False"
								  AnimationAutoStartMode="SetStartState"  PointOptions="{StaticResource pointOption}">
                <dxc:AreaStackedSeries3D.Label>
                    <dxc:SeriesLabel Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaStackedSeries3D.Label>
            </dxc:AreaStackedSeries3D>
            <dxc:BarSideBySideSeries3D  x:Key="seriesColumnStyle3D" x:Shared="False"
								  AnimationAutoStartMode="SetStartState"  PointOptions="{StaticResource pointOption}">
                <dxc:BarSideBySideSeries3D.Model>
                    <dxc:BoxBar3DModel />
                </dxc:BarSideBySideSeries3D.Model>
                <dxc:BarSideBySideSeries3D.Label>
                    <dxc:SeriesLabel Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:BarSideBySideSeries3D.Label>
            </dxc:BarSideBySideSeries3D>
            <dxc:AreaFullStackedSeries3D x:Key="seriesScatterStyle3D" x:Shared="False"
								           AnimationAutoStartMode="SetStartState"  PointOptions="{StaticResource pointOption}">
                <dxc:AreaFullStackedSeries3D.Label>
                    <dxc:SeriesLabel  Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaFullStackedSeries3D.Label>

            </dxc:AreaFullStackedSeries3D>
            <dxc:AreaSeries3D x:Key="seriesAreaStyle3D" x:Shared="False"
								          AnimationAutoStartMode="SetStartState"  PointOptions="{StaticResource pointOption}">
                <dxc:AreaSeries3D.Label>
                    <dxc:SeriesLabel Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:AreaSeries3D.Label>
            </dxc:AreaSeries3D>

            <dxc:PieSeries2D x:Key="pieSeries"  x:Shared="False"  PointOptions="{StaticResource percentPointOption}"
								          AnimationAutoStartMode="SetStartState">
                <dxc:PieSeries2D.Model>
                    <dxc:GlossyPie2DModel/>
                </dxc:PieSeries2D.Model>
                <dxc:PieSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:PieSeries2D.Label>
                <dxc:PieSeries2D.Titles>
                    <dxc:Title />
                </dxc:PieSeries2D.Titles>
            </dxc:PieSeries2D>

            <dxc:PieSeries3D x:Key="pieSeries3D"  x:Shared="False" PointOptions="{StaticResource percentPointOption}"
								          AnimationAutoStartMode="SetStartState">
                <dxc:PieSeries3D.Model>
                    <dxc:RectanglePie3DModel/>
                </dxc:PieSeries3D.Model>
                <dxc:PieSeries3D.Titles>
                    <dxc:Title />
                </dxc:PieSeries3D.Titles>
                <dxc:PieSeries3D.Label>
                    <dxc:SeriesLabel Visible="False" 
                                  ResolveOverlappingMode="Default" 
                                  ConnectorThickness="1" />
                </dxc:PieSeries3D.Label>
            </dxc:PieSeries3D>

            <dxc:SimpleDiagram2D x:Key="simplediagram">
                <dxc:SimpleDiagram2D.Series>
                    <dxc:PieSeries2D  x:Name="simpledataContextSerie" DisplayName="simpledataContextSerie"  Visible="False"
								            FontSize="{Binding AxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontFamily="{Binding AxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontWeight="{Binding AxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontStyle="{Binding AxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                            Visibility="Collapsed" 
                                            ArgumentDataMember="SourcePicoSeconds" ArgumentScaleType="Numerical" 
                                            ValueDataMember="Value" ValueScaleType="Numerical"
                                            AnimationAutoStartMode="SetStartState"
                                            PointOptions="{StaticResource percentPointOption}">
                        <dxc:PieSeries2D.Model>
                            <dxc:GlossyPie2DModel/>
                        </dxc:PieSeries2D.Model>
                        <dxc:PieSeries2D.Label>
                            <dxc:SeriesLabel Visible="{Binding SeriesLabelVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                             dxc:PieSeries.LabelPosition="Outside"
                                            ResolveOverlappingMode="{Binding ResolveLabelOverlappingMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                            ConnectorThickness="1" />
                        </dxc:PieSeries2D.Label>
                        <dxc:PieSeries2D.Titles>
                            <dxc:Title />
                        </dxc:PieSeries2D.Titles>
                    </dxc:PieSeries2D>
                </dxc:SimpleDiagram2D.Series>
            </dxc:SimpleDiagram2D>
            <dxc:XYDiagram2D x:Key="diagram" BarDistance="0.04"  AllowSeriesBitmapCaching="False"
                         Rotated="{Binding Rotated, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                         Zoom="diagram_Zoom" MouseWheel="diagram_MouseWheel" 
                         EnableAxisXNavigation="True" EnableAxisYNavigation="True" >
              <dxc:XYDiagram2D.NavigationOptions>
                <dxc:NavigationOptions
                    UseKeyboard="True"
                    UseScrollBars="True"
                    UseMouse="True"
                    UseTouchDevice="True"/>
              </dxc:XYDiagram2D.NavigationOptions>


              <dxc:XYDiagram2D.DefaultPane>
                    <dxc:Pane x:Name="pane2D" Grid.Row="0">
                        <dxc:Pane.AxisYScrollBarOptions>
                            <dxc:ScrollBarOptions Alignment="Far" Visible="False"/>
                        </dxc:Pane.AxisYScrollBarOptions>
                        <dxc:Pane.AxisXScrollBarOptions>
                            <dxc:ScrollBarOptions Alignment="Far" Visible="False"/>
                        </dxc:Pane.AxisXScrollBarOptions>
                    </dxc:Pane>
                </dxc:XYDiagram2D.DefaultPane>

                <dxc:XYDiagram2D.AxisY>
                    <dxc:AxisY2D Name="axisY2D"
                                Logarithmic="{Binding LogarithmicYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                LogarithmicBase="{Binding LogarithmicBaseYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                GridLinesMinorVisible="True">
                        <dxc:AxisY2D.CrosshairAxisLabelOptions>
                            <dxc:CrosshairAxisLabelOptions Pattern=" {V:F0}"/>
                        </dxc:AxisY2D.CrosshairAxisLabelOptions>
                        <dxc:AxisY2D.Title>
                            <dxc:AxisTitle />
                        </dxc:AxisY2D.Title>
                        <!--<dxc:AxisY2D.Range>
                            <dxc:AxisRange 
                                    MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						            MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                    dxc:AxisY2D.AlwaysShowZeroLevel="True" SideMarginsEnabled="True"/>
                        </dxc:AxisY2D.Range>-->
                        <dxc:AxisY2D.WholeRange>
                            <dxc:Range 
                                    MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						            MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                    dxc:AxisY2D.AlwaysShowZeroLevel="True" AutoSideMargins="False" SideMarginsValue="0"/>
                        </dxc:AxisY2D.WholeRange>
                        <dxc:AxisY2D.Label>
                            <dxc:AxisLabel>
                                <dxc:AxisY2D.ResolveOverlappingOptions>
                                    <dxc:AxisLabelResolveOverlappingOptions AllowHide="True" 
                                                                        AllowRotate="False"
                                                                        AllowStagger="False"
                                                                        MinIndent="50"/>
                                </dxc:AxisY2D.ResolveOverlappingOptions>
                            </dxc:AxisLabel>
                        </dxc:AxisY2D.Label>
                    </dxc:AxisY2D>
                </dxc:XYDiagram2D.AxisY>

                <dxc:XYDiagram2D.AxisX>
                    <dxc:AxisX2D Name="axisX2D" GridLinesVisible="True" GridLinesMinorVisible="True">
                        <dxc:AxisX2D.CrosshairAxisLabelOptions>
                            <dxc:CrosshairAxisLabelOptions Pattern=" {A:F0}"/>
                        </dxc:AxisX2D.CrosshairAxisLabelOptions>
                        <dxc:AxisX2D.WholeRange>
                            <dxc:Range 
                                    MinValue="0"
						            MaxValue="{Binding SampleNumber, Mode=OneWay, Converter={StaticResource SampleToMaxValue}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                    AutoSideMargins="False" SideMarginsValue="0"/>
                        </dxc:AxisX2D.WholeRange>
                        <!--<dxc:AxisX2D.Range>
                            <dxc:AxisRange 
                                            MinValue="0"
                						    MaxValue="{Binding SampleNumber, Mode=OneWay, Converter={StaticResource SampleToMaxValue}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                            SideMarginsEnabled="True" x:Name="timeRange"/>
                        </dxc:AxisX2D.Range>-->
                        <dxc:AxisX2D.Title>
                            <dxc:AxisTitle />
                        </dxc:AxisX2D.Title>
                        <dxc:AxisX2D.Label>
                            <dxc:AxisLabel >
                                <dxc:Axis2D.ResolveOverlappingOptions>
                                    <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                                                                    AllowRotate="False"
                                                                                    AllowStagger="True"
                                                                                    MinIndent="50"/>
                                </dxc:Axis2D.ResolveOverlappingOptions>
                            </dxc:AxisLabel>
                        </dxc:AxisX2D.Label>
                    </dxc:AxisX2D>
                </dxc:XYDiagram2D.AxisX>
                <dxc:XYDiagram2D.Series>
                    <dxc:BarSideBySideSeries2D x:Name="dataContextSerie" DisplayName="dataContextSerie"  Visible="False"
								            FontSize="{Binding AxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontFamily="{Binding AxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontWeight="{Binding AxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontStyle="{Binding AxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                            Visibility="Collapsed"
                                            ArgumentDataMember="SourcePicoSeconds" ArgumentScaleType="Numerical" 
                                            ValueDataMember="Value" ValueScaleType="Numerical"
                                            AnimationAutoStartMode="SetStartState">
                        <dxc:BarSideBySideSeries2D.Label>
                            <dxc:SeriesLabel Visible="{Binding SeriesLabelVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                ResolveOverlappingMode="{Binding ResolveLabelOverlappingMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                ConnectorThickness="1" />
                        </dxc:BarSideBySideSeries2D.Label>
                        <dxc:BarSideBySideSeries2D.PointOptions>
                            <dxc:PointOptions>
                                <dxc:PointOptions.ValueNumericOptions>
                                    <dxc:NumericOptions Format="FixedPoint" />
                                </dxc:PointOptions.ValueNumericOptions>
                            </dxc:PointOptions>
                        </dxc:BarSideBySideSeries2D.PointOptions>
                    </dxc:BarSideBySideSeries2D>
                </dxc:XYDiagram2D.Series>
            </dxc:XYDiagram2D>
            <dxc:SimpleDiagram3D x:Key="simplediagram3D" MouseWheel="chart_MouseWheel">
                <dxc:SimpleDiagram3D.Series>
                    <dxc:PieSeries3D   x:Name="simpledataContextSerie3D"  DisplayName="simpledataContextSerie3D"  Visible="False"
								            FontSize="{Binding AxsisFontSettings.FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontFamily="{Binding AxsisFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontWeight="{Binding AxsisFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontStyle="{Binding AxsisFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                            Visibility="Collapsed" 
                                            ArgumentDataMember="SourcePicoSeconds" ArgumentScaleType="Numerical" 
                                            ValueDataMember="Value" ValueScaleType="Numerical"
                                            PointOptions="{StaticResource percentPointOption}"
                                            AnimationAutoStartMode="SetStartState">
                        <dxc:PieSeries3D.Model>
                            <dxc:RectanglePie3DModel/>
                        </dxc:PieSeries3D.Model>
                        <dxc:PieSeries3D.Label>
                            <dxc:SeriesLabel Visible="{Binding SeriesLabelVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                             dxc:PieSeries.LabelPosition="Outside"
                                            ResolveOverlappingMode="{Binding ResolveLabelOverlappingMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                            ConnectorThickness="1" />
                        </dxc:PieSeries3D.Label>
                        <dxc:PieSeries3D.Titles>
                            <dxc:Title />
                        </dxc:PieSeries3D.Titles>
                    </dxc:PieSeries3D>
                </dxc:SimpleDiagram3D.Series>
            </dxc:SimpleDiagram3D>
            <dxc:XYDiagram3D x:Key="diagram3D" MouseWheel="chart_MouseWheel" 
                             RuntimeZooming="True" 
                             RuntimeScrolling="True">
              <dxc:XYDiagram3D.NavigationOptions>
                <dxc:NavigationOptions3D
                    UseKeyboard="True"
                    UseMouse="True"
                    UseTouchDevice="True"/>
              </dxc:XYDiagram3D.NavigationOptions>
                <dxc:XYDiagram3D.ContentTransform>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D Angle="-30" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </dxc:XYDiagram3D.ContentTransform>
                <dxc:XYDiagram3D.AxisY>
                    <dxc:AxisY3D Name="axisY3D" 
                                Logarithmic="{Binding LogarithmicYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                LogarithmicBase="{Binding LogarithmicBaseYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                GridLinesVisible="True" GridLinesMinorVisible="True">
                        <dxc:AxisY3D.Title>
                            <dxc:AxisTitle />
                        </dxc:AxisY3D.Title>
                        <dxc:AxisY3D.WholeRange>
                            <!--<dxc:AxisRange 
                            MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						    MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                            dxc:AxisY2D.AlwaysShowZeroLevel="False" SideMarginsEnabled="True"/>-->
                            <dxc:Range 
                                MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						        MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                dxc:AxisY3D.AlwaysShowZeroLevel="True" AutoSideMargins="True" SideMarginsValue="0"/>
                        </dxc:AxisY3D.WholeRange>
                        <dxc:AxisY3D.Label>
                            <dxc:AxisLabel />
                        </dxc:AxisY3D.Label>
                    </dxc:AxisY3D>
                </dxc:XYDiagram3D.AxisY>
                <dxc:XYDiagram3D.AxisX>
                    <dxc:AxisX3D Name="axisX3D" 
                                GridLinesVisible="True" GridLinesMinorVisible="True">
                        <dxc:AxisX3D.WholeRange>
                            <dxc:Range 
                                    MinValue="0"
						            MaxValue="{Binding SampleNumber, Mode=OneWay, Converter={StaticResource SampleToMaxValue}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                    AutoSideMargins="False" SideMarginsValue="0"/>
                        </dxc:AxisX3D.WholeRange>
                        <!--<dxc:AxisX3D.Range>
                            <dxc:AxisRange 
                            MinValue="0"
						    MaxValue="{Binding SampleNumber, Mode=OneWay, Converter={StaticResource SampleToMaxValue}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                            SideMarginsEnabled="False" x:Name="timeRange3D"/>
                        </dxc:AxisX3D.Range>-->
                        <dxc:AxisX3D.Label>
                            <dxc:AxisLabel />
                        </dxc:AxisX3D.Label>
                        <dxc:AxisX3D.Title>
                            <dxc:AxisTitle />
                        </dxc:AxisX3D.Title>
                    </dxc:AxisX3D>
                </dxc:XYDiagram3D.AxisX>
                <dxc:XYDiagram3D.Series>
                    <dxc:BarSideBySideSeries3D x:Name="dataContextSerie3D" DisplayName="dataContextSerie3D" Visible="False"
                                              ArgumentDataMember="SourcePicoSeconds" ArgumentScaleType="Numerical" 
                                              ValueDataMember="Value" ValueScaleType="Numerical" 
                                              AnimationAutoStartMode="SetStartState">
                        <dxc:BarSideBySideSeries3D.Model>
                            <dxc:CylinderBar3DModel />
                        </dxc:BarSideBySideSeries3D.Model>
                        <dxc:BarSideBySideSeries3D.Label>
                            <dxc:SeriesLabel Visible="{Binding SeriesLabelVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                         ResolveOverlappingMode="{Binding ResolveLabelOverlappingMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                         ConnectorThickness="1" />
                        </dxc:BarSideBySideSeries3D.Label>
                        <dxc:BarSideBySideSeries3D.PointOptions>
                            <dxc:PointOptions>
                                <dxc:PointOptions.ValueNumericOptions>
                                    <dxc:NumericOptions Precision = "3" Format="FixedPoint" />
                                </dxc:PointOptions.ValueNumericOptions>
                            </dxc:PointOptions>
                        </dxc:BarSideBySideSeries3D.PointOptions>
                    </dxc:BarSideBySideSeries3D>
                </dxc:XYDiagram3D.Series>
            </dxc:XYDiagram3D>
            <dxc:Range x:Key="rangeY2D"
                                    MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						            MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                    dxc:AxisY2D.AlwaysShowZeroLevel="True" AutoSideMargins="False" SideMarginsValue="0"/>

            <dxc:Range x:Key="rangeY3D"
                                MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						        MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                dxc:AxisY3D.AlwaysShowZeroLevel="True" AutoSideMargins="True" SideMarginsValue="0"/>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ListView Visibility="Collapsed" />
        <!--
                MouseMove="chart_MouseMove" MouseLeave="chart_MouseLeave"  CustomDrawSeries="chart_CustomDrawSeries" 
                -->
        <dxc:ChartControl Grid.RowSpan="10" MinHeight="1" MinWidth="1" Diagram="{StaticResource diagram}" Grid.Row="1"
                          IsManipulationEnabled = "true" IsEnabled="True" CustomDrawSeriesPoint="chart_CustomDrawSeriesPoint"  CustomDrawSeries="chart_CustomDrawSeries" MouseLeave="chart_MouseLeave" MouseMove="chart_MouseMove"
				                  x:Name="chart" AnimationMode="Disabled" BorderThickness="0"
                                  BorderBrush="{x:Null}" >
            <dxc:ChartControl.CrosshairOptions>
                <dxc:CrosshairOptions ShowArgumentLine="True" ShowValueLine="True" x:Name="crosshair"
                                                      ShowArgumentLabels="True" ShowValueLabels="True"
                                                      ShowCrosshairLabels="False"
                                                      CrosshairLabelMode="ShowForNearestSeries"/>
            </dxc:ChartControl.CrosshairOptions>
            <dxc:ChartControl.Legend>
                <dxc:Legend x:Name="chartLegend" Margin="{Binding LegendMargin, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                            Visibility="{Binding LegendAreaVisible, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                            VerticalPosition="{Binding LegendVerticalPosition, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                            HorizontalPosition="{Binding LegendHorizontalPosition, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontSize="{Binding AxsisFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontFamily="{Binding AxsisFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontWeight="{Binding AxsisFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
								            FontStyle="{Binding AxsisFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                            Template="{StaticResource legendTemplate}">
                </dxc:Legend>
            </dxc:ChartControl.Legend>
        </dxc:ChartControl>
        <Popup Name="pointTooltip" AllowsTransparency="True">
            <dxe:TextEdit x:Name="ttContent" IsReadOnly="True" />
        </Popup>
        <dxb:BarContainerControl ContainerType="Top" Visibility="Visible" x:Name="toolbar" VerticalAlignment="Top" >

            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" dxb:MergingProperties.Name="mainChartToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" x:Name="toolbar1" >
                <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="resetbutton" Command="{Binding Path=ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTip="{x:Static properties:Resources.ResetTitle}"/>
                <dxb:BarButtonItem Glyph="{DynamicResource OkSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="pushbutton" Command="{Binding Path=PushCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTip="{x:Static properties:Resources.PushTitle}"/>
                <dxb:BarItemSeparator />
                <dxb:BarCheckItem x:Name="seriesLabelVisible" Content="{x:Static properties:Resources.SeriesLabelVisibleTitle}" IsChecked="{Binding SeriesLabelVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                <dxb:BarItemSeparator />
                <dxb:BarCheckItem x:Name="legendAreaVisible" Content="{x:Static properties:Resources.LegendAreaVisible}" IsChecked="{Binding LegendAreaVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                <dxb:BarItemSeparator />
                <dxb:BarCheckItem x:Name="simplepie" Content="{x:Static properties:Resources.SimplePie}" IsChecked="{Binding SimpleDiagram, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                <dxb:BarItemSeparator />
                <dxb:BarItemSeparator />
                <dxb:BarCheckItem x:Name="checkBox3D" Content="{x:Static properties:Resources.Style3D}" IsChecked="{Binding Enable3D, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                <dxb:BarItemSeparator />
                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="zoom3D" Content="{x:Static properties:Resources.Zoom3DTitle}" IsEnabled="{Binding Enable3D, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarEditItem.ContentTemplate>
                    <DataTemplate>
                      <dxe:TextEdit
                        EditValue="{Binding Zoom3DPercent, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        MaskType="Numeric" MaskUseAsDisplayFormat="True" Mask="P"
                        Name="PART_Editor" MinWidth="100"/>
                    </DataTemplate>
                  </dxb:BarEditItem.ContentTemplate>
                </dxb:BarEditItem>

                <!--<TextBlock Margin="4,0,0,0" Text="{x:Static properties:Resources.Rotation3DTitle}" IsEnabled="{Binding Enable3D, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <dxe:TextEdit Margin="4,0,0,0" Width="100" 
                              EditValue="{Binding RotationAngle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                              MaskType="Numeric"  DisplayFormatString="" />-->

            </dxb:ToolBarControl>
        </dxb:BarContainerControl>
    </Grid>
</UserControl>
