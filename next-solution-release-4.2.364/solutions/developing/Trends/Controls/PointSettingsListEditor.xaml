<UserControl x:Class="Trends.Controls.PointSettingsListEditor"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Trends.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:Trends.Properties"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
            <Button Grid.Row="1" Grid.Column="0" Click="OnAdd" Margin="0"  ToolTip="{x:Static properties:Resources.AddPointSettingButtonTitle}">
            <Button.Content>
                    <Image Margin="2" Source="{DynamicResource AddNewSmall}" Height="16" Width="16" />
            </Button.Content>

        </Button>
            <Button Grid.Row="1" Grid.Column="1" x:Name="btnDelete" ToolTip="{x:Static properties:Resources.DeletePointSettingButtonTitle}"
                            Click="OnDelete" Margin="0">
            <Button.Content>
                    <Image Margin="2" Source="{DynamicResource RemoveMinusSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
            <Button Grid.Row="1" Grid.Column="2"  Margin="0"  Click="OnMoveDown"  ToolTip="{x:Static properties:Resources.MoveDownButtonTitle}">
                <Image Source="{DynamicResource MoveDownSmall}" Height="16" Width="16" />
        </Button>
            <Button Grid.Row="1" Grid.Column="3"  Margin="0"  Click="OnMoveUp"  ToolTip="{x:Static properties:Resources.MoveUpButtonTitle}">
                <Image Source="{DynamicResource MoveUpSmall}" Height="16" Width="16" />
        </Button>
        </Grid>
    <dxg:GridControl MaxHeight="360" AllowDrop="False" Grid.Row="7" Grid.ColumnSpan="2" Name="gridControl" Height="275">
            <dxg:GridControl.Columns>
                <dxg:GridColumn AllowDrop="False" x:Name="penColo" DisplayMemberBinding="{Binding Path=PColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.PointColor}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <commoncontrols:CustomPopupColorEdit Name="PART_Editor" Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" BrushSelected="OnBrushSelected" Color="{Binding RowData.Row.PColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn AllowDrop="False" Header="{x:Static properties:Resources.PointName}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Click="DlgButton_Click_ClearLabel" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{DynamicResource CancelSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button DockPanel.Dock="Right" Click="DlgButton_Click_Label" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <TextBox IsReadOnly="False" IsHitTestVisible="True" x:Name="text" HorizontalAlignment="Stretch" 
                                                 Text="{Binding Path=Data.PLabel, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                                   AllowSorting="False"/>

            </dxg:GridControl.View>
        </dxg:GridControl>

    </StackPanel>
</UserControl>
