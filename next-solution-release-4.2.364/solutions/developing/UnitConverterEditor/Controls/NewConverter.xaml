<UserControl x:Class="UnitConverterManager.Controls.NewConverter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UnitConverterManager.Controls"
             xmlns:properties="clr-namespace:UnitConverterManager.Properties"
             xmlns:templates="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             FocusManager.FocusedElement="{Binding ElementName=txtConverter}"
             mc:Ignorable="d" 
             Height="100" Width="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,2" Grid.Row="1" Text="{x:Static properties:Resources.NewConverterName}" VerticalAlignment="Center" />
            <TextBox Margin="0,2" Grid.Row="1" Grid.Column="2" Text="" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="txtConverter" />
            <ContentPresenter Margin="0,2" Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=txtConverter, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </ScrollViewer>
</UserControl>
