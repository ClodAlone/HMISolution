<UserControl x:Class="UnitConverterManager.Controls.UnitConverterSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:converters="clr-namespace:UnitConverterManager.Converters"
             mc:Ignorable="d" 
             Height="300" Width="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:CSVIdConverter x:Key="CSVIdConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                Name="gridDataControl" 
                                AutoPopulateColumns="False" 
                                AllowDrop="True" 
                                AllowLiveDataShaping="False" 
                                dx:DXSerializer.SerializationID="gridDataControl" 
                                dx:DXSerializer.StoreLayoutMode="All" 
                                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
            <dxg:GridControl.Resources>
                <DataTemplate x:Key="cellTemplate" x:Shared="False">
                    <DockPanel>
                        <TextBlock x:Name="txtConverterItem" ToolTip="{Binding Value, Mode=OneWay, Converter={StaticResource CSVIdConverter}}" Text="{Binding Value, Mode=OneWay, Converter={StaticResource CSVIdConverter}}" />
                    </DockPanel>
                </DataTemplate>
            </dxg:GridControl.Resources>
            <dxg:GridControl.Columns>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ID, Mode=OneWay}" FieldName="ID" Header="ID"/>
                <!--<dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Description, Mode=OneWay}" FieldName="Description" Header="{x:Static properties:Resources.PluginDescription}"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=AssemblyName, Mode=OneWay}" FieldName="AssemblyName" Header="{x:Static properties:Resources.PluginAssemblyName}"/>-->
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>

                <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Row" 
                            MultiSelectMode="Row">
                    <!--<dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>-->
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
