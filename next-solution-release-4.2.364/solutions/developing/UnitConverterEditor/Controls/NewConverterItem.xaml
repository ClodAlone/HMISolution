<UserControl x:Class="UnitConverterManager.Controls.NewConverterItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UnitConverterManager.Controls"
             xmlns:properties="clr-namespace:UnitConverterManager.Properties"
             xmlns:templates="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             mc:Ignorable="d" 
             Height="100" Width="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--<TextBlock Grid.Row="0" Text="{x:Static properties:Resources.NewConverterItemName}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="txtConverterName" />
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=txtConverterName, Path=(Validation.Errors).CurrentItem}"/>-->

            <TextBlock Margin="0,2" Grid.Row="1" Text="{x:Static properties:Resources.NewConverterItemIUnit}" VerticalAlignment="Center" />
            <TextBox Margin="0,2" Grid.Row="1" Grid.Column="2" Text="{Binding ConverterItem.InputUnit, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="txtConverterIU" />
            <ContentPresenter Margin="0,2" Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=txtConverterIU, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Margin="0,2" Grid.Row="2" Text="{x:Static properties:Resources.NewConverterItemDescription}" VerticalAlignment="Center" />
            <TextBox Margin="0,2" Grid.Row="2" Grid.Column="2" Text="{Binding ConverterItem.Description, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="txtConverterOU" />
            <ContentPresenter Margin="0,2" Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=txtConverterOU, Path=(Validation.Errors).CurrentItem}"/>


            <TextBlock Grid.Row="3" Margin="0,2" Text="{x:Static properties:Resources.NewConverterItemIExpression}" VerticalAlignment="Center" />
            <Grid Grid.Row="3" Margin="0,2" Grid.Column="2">
                <templates:UConverterPropertyEditor x:Name="txtConverterIExpression"/>
            </Grid>
            <ContentPresenter Margin="0,2" Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=txtConverterIExpression, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Margin="0,2" Text="{x:Static properties:Resources.NewConverterItemOExpression}" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Margin="0,2"  Grid.Column="2">
                <templates:UConverterPropertyEditor x:Name="txtConverterOExpression"/>
            </Grid>
            <ContentPresenter Margin="0,2" Grid.Row="4" Grid.Column="3" 
            Content="{Binding ElementName=txtConverterOExpression, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </ScrollViewer>
</UserControl>
