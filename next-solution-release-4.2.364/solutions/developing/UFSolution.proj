<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<Import Project=".\MSBuild.Tasks\MSBuild.Mercurial.Tasks" />
	<Import Project=".\MSBuild.Tasks\MSBuild.Community.Tasks.Targets" />

 	<PropertyGroup>
		<BuildDebugDir>.\UFSolution\bin\Debug</BuildDebugDir>
  		<BuildOutputDir>.\UFSolution\bin\Release</BuildOutputDir>
		<BuildRetailDir>.\UFSolution\bin\Retail</BuildRetailDir>
		<BuildPublishDir>.\UFSolution\bin\NetCore</BuildPublishDir>
		<BuildWebHMIPublishDir>.\UFSolution\bin\WebClientHMI</BuildWebHMIPublishDir>
		<BuildDeployServerPublishDir>.\UFSolution\bin\DeployServer</BuildDeployServerPublishDir>
		<BuildLicenseServiceDir>.\MSZUtilsWebService\bin\Release</BuildLicenseServiceDir>
		<BuildLicenseClientDir>.\MSZUtils\bin\Release</BuildLicenseClientDir>
		<BuildInstallDongleDir>.\InstallDongle\bin\Release</BuildInstallDongleDir>
		<BuildWebClientHTML5Dir>.\UFWebClientResponsive.HTML5\bin</BuildWebClientHTML5Dir>
		<PackageWebClientHTML5Dir>.\UFWebClientResponsive.HTML5\obj\Release\Package\PackageTmp</PackageWebClientHTML5Dir>
		<BuildSourceDir>..\..\Sources</BuildSourceDir>
	  	<SolutionToCompile>UFSolution.sln</SolutionToCompile>
		<MSBuildMercurialPath>.</MSBuildMercurialPath>
		<!-- Set this property to true to build without incrementing the assembly version. -->
		<SkipIncrementAssemblyVersion Condition=" '$(SkipIncrementAssemblyVersion)' == '' " >false</SkipIncrementAssemblyVersion>
		<!-- Set this property to true to avoid assembly obfuscation. -->
		<SkipObfuscation Condition=" '$(SkipObfuscation)' == '' " >false</SkipObfuscation>
		<!-- Set this property to empty string to skip the singing of compiled files -->
		<CertFriendlyName>PROGEA SRL</CertFriendlyName>
		<ObfuscationWorkingPath>.\UFSolution\bin\ObfuscationWorkingFolder</ObfuscationWorkingPath>
		<ObfuscationBatchFile>RunObfuscationTool.bat</ObfuscationBatchFile>
		<CoreFlagsTool>C:\Program Files (x86)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\CorFlags.exe</CoreFlagsTool>
 	</PropertyGroup>
	
	<PropertyGroup>
		<ProjectsToPublish1>.\MSServer.Core\MSServer.Core.csproj</ProjectsToPublish1>
		<ProjectsToPublish2>.\LogicService.Core\LogicService.Core.csproj</ProjectsToPublish2>
		<ProjectsToPublish3>.\UFUAServerApp.Core\UFUAServerApp.Core.csproj</ProjectsToPublish3>
		<ProjectsToPublish4>.\RecipeUAServer.Core\RecipeUAServer.Core.csproj</ProjectsToPublish4>
		<ProjectsToPublish5>.\DeleteHistoryData\DeleteHistoryData.csproj</ProjectsToPublish5>
		<ProjectsToPublish6>.\RestoreManager\RestoreManager.csproj</ProjectsToPublish6>
	</PropertyGroup>

	<ItemGroup>
		<ProjectsWebHMIToPublish Include=".\WebNExTHMI\WebNExTHMI\WebNExTHMI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectsDeployServerToPublish Include=".\DeployServer\DeployServer.csproj" />
	</ItemGroup>

	<Target Name="GetHgVersion">
		<HgVersion LocalPath="$(MSBuildProjectDirectory)" Timeout="30000">
			<Output TaskParameter="Revision" PropertyName="HgRevision" />
			<Output TaskParameter="Changeset" PropertyName="HgChangeset" />
		</HgVersion>
		<Message Text="Last revision (changeset) from Kiln: $(HgRevision) ($(HgChangeset))" />
	</Target>

	<Target Name="SetVersionInfo">
	<Attrib Files="AssemblyVersionInfo.txt" ReadOnly="false"/>
    	<Version	
		Condition=" '$(SkipIncrementAssemblyVersion)' == 'true' "
		VersionFile="AssemblyVersionInfo.txt"
	         BuildType="None"
		RevisionType="None">
		<Output TaskParameter="Major" PropertyName="Major" />
		<Output TaskParameter="Minor" PropertyName="Minor" />
		<Output TaskParameter="Build" PropertyName="Build" />
		<Output TaskParameter="Revision" PropertyName="Revision" />
	</Version>

	<Version 
		Condition=" '$(SkipIncrementAssemblyVersion)' != 'true' "
		VersionFile="AssemblyVersionInfo.txt"
		BuildType="Increment"
		RevisionType="None">
		<Output TaskParameter="Major" PropertyName="Major" />
		<Output TaskParameter="Minor" PropertyName="Minor" />
		<Output TaskParameter="Build" PropertyName="Build" />
		<Output TaskParameter="Revision" PropertyName="Revision" />
	</Version>

	<PropertyGroup>
		<BuildNumber>$(Major).$(Minor).$(Build).$(HgRevision)</BuildNumber>
	</PropertyGroup>
		<Message Importance="high" Text="Build number set to &quot;$(BuildNumber)&quot;" />

	<AssemblyInfo
                  CodeLanguage="CS"
                  OutputFile="AssemblyVersionInfo.cs"
                  AssemblyFileVersion="$(BuildNumber)" />

	<PropertyGroup>
		<VersionNumber>$(Major).$(Minor).0.0</VersionNumber>
	</PropertyGroup>

	<FileUpdate Files="SharedAssemblyInfo.cs"
            Regex="AssemblyVersion\(&quot;.*&quot;\)\]"
            ReplacementText="AssemblyVersion(&quot;$(VersionNumber)&quot;)]" />
	
	</Target>

	<Target Name="Clean">
		<RemoveDir Directories=".\UFSolution\bin\" />
		<RemoveDir Directories="$(BuildLicenseRetailPath)" />
		<RemoveDir Directories="$(BuildLicenseServiceDir)" />
		<RemoveDir Directories="$(BuildLicenseClientDir)" />
		<RemoveDir Directories="$(BuildInstallDongleDir)" />
		<RemoveDir Directories="$(BuildWebClientHTML5Dir)" />
		<RemoveDir Directories="$(PackageWebClientHTML5Dir)" />
		<MSBuild Projects="$(SolutionToCompile)" Targets="Clean" StopOnFirstFailure="false" ContinueOnError="true" 
				Properties="Configuration=Release;Platform=Any CPU" />
		<MSBuild Projects="$(ProjectsToPublish1)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0" />
		<MSBuild Projects="$(ProjectsToPublish2)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0" />
		<MSBuild Projects="$(ProjectsToPublish3)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0" />
		<MSBuild Projects="$(ProjectsToPublish4)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0" />
		<MSBuild Projects="$(ProjectsToPublish5)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0" />
		<MSBuild Projects="$(ProjectsToPublish6)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0" />
		<MSBuild Projects="@(ProjectsDeployServerToPublish)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0" />
		<MSBuild Projects="@(ProjectsWebHMIToPublish)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0" />
	</Target>

	<Target Name="Restore">
		<!--
		<MSBuild Projects="$(SolutionToCompile)" Targets="Restore" StopOnFirstFailure="false" ContinueOnError="true" 
				Properties="Configuration=Release;Platform=Any CPU" />
		-->
		<Exec Command="dotnet.exe restore $(SolutionToCompile)" ContinueOnError="WarnAndContinue" />
		<Exec Command=".\Packages\nuget.exe restore $(SolutionToCompile)" ContinueOnError="WarnAndContinue" />
	</Target>

	<Target Name="PreBuild">
		<!-- Tile has been removed on new WebClient HTML5 responsive version
		<Exec Command="CALL .\UFWebClient.HTML5\js\CombineJS.bat" ContinueOnError="WarnAndContinue" />
		-->
	</Target>

	<Target Name="AfterBuild">
		<!-- replace 'OPCUAClient.Config.xml' with release version -->
		<!--<Exec Command="XCOPY /Y $(BuildOutputDir)\OPCUAClient.Config.Release.xml $(BuildOutputDir)\OPCUAClient.Config.xml" ContinueOnError="WarnAndContinue" />
		<Exec Command="DEL /Q $(BuildOutputDir)\OPCUAClient.Config.Release.xml" />-->

		<!-- copy dependency assemblies -->
		<Exec Command="XCOPY /Y $(BuildSourceDir)\References\ShaderEffects\ShaderEffects.dll $(BuildOutputDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildSourceDir)\LinqStatistics_src\LinqStatistics\bin\Release\LinqStatistics.dll $(BuildOutputDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildSourceDir)\helixtoolkit\Output\HelixToolkit.Wpf.dll $(BuildOutputDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\WPFUtilities.dll $(BuildOutputDir)\LogicService\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\net48\Utilities.dll $(BuildOutputDir)\" ContinueOnError="WarnAndContinue" />

		<!-- create retail folder and move files inside -->
		<MakeDir Directories="$(BuildRetailDir)" />
		<Exec Command="XCOPY /S /Y $(BuildOutputDir)\*.* $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /S /Y $(PackageWebClientHTML5Dir)\*.* $(BuildRetailDir)\UFWebClient.HTML5\" ContinueOnError="WarnAndContinue" />

		<!-- copy NetCore assemblies -->
		<MakeDir Directories="$(BuildPublishDir)" />
		<MakeDir Directories="$(BuildPublishDir)\LogicExtensions" />
		<MakeDir Directories="$(BuildPublishDir)\DataSinks" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\DocumentManagers\LogicExtensions\netstandard2.0\LogicCommon*.* $(BuildPublishDir)\LogicExtensions\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\DocumentManagers\LogicExtensions\netstandard2.0\Jint*.* $(BuildPublishDir)\LogicExtensions\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\DataSinks\netstandard2.0\SysVariables*.* $(BuildPublishDir)\DataSinks\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\DataSinks\netstandard2.0\TempVariables*.* $(BuildPublishDir)\DataSinks\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\netstandard2.0\TempVariablesModel*.* $(BuildPublishDir)\DataSinks\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\netstandard2.0\Utilities.dll $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />

		<!-- merge NetCore files -->
		<Exec Command="XCOPY /D /S /Y $(BuildPublishDir)-1\*.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /D /S /Y $(BuildPublishDir)-2\*.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /D /S /Y $(BuildPublishDir)-3\*.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /D /S /Y $(BuildPublishDir)-4\*.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /D /S /Y $(BuildPublishDir)-5\*.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /D /S /Y $(BuildPublishDir)-6\*.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />
		
		<Exec Command="XCOPY /D /S /Y $(BuildWebHMIPublishDir)-win-x86\WebNExTHMI.exe $(BuildWebHMIPublishDir)\x86\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /D /S /Y $(BuildDeployServerPublishDir)-win-x86\DeployServer.exe $(BuildDeployServerPublishDir)\x86\" ContinueOnError="WarnAndContinue" />

		<!-- remove target framework folders -->
		<!--
		<RemoveDir Directories="$(BuildRetailDir)\net47" ContinueOnError="WarnAndContinue" />
		<RemoveDir Directories="$(BuildRetailDir)\netcoreapp2.0" ContinueOnError="WarnAndContinue" />
		<RemoveDir Directories="$(BuildRetailDir)\netcoreapp2.1" ContinueOnError="WarnAndContinue" />
		<RemoveDir Directories="$(BuildRetailDir)\netstandard2.0" ContinueOnError="WarnAndContinue" />
		-->

		<Exec Command="XCOPY /Y $(BuildOutputDir)\Toolbox\*.* $(BuildRetailDir)\UFWebClient.HTML5\bin\Toolbox\" ContinueOnError="WarnAndContinue" />
