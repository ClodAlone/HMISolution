		<!-- Copy missing license tool files -->
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\MSZService.exe $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\MSZService.exe.config $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\Mindscape.Raygun4Net.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\Mindscape.Raygun4Net4.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
