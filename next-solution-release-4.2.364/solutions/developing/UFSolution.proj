		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\ConcurrentLog4Net.dll.config $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\log4net.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\MSZ.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\MSZ.dll.config $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
