		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\Utilities.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\Newtonsoft.Json.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\Opc.Ua.Core.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /D $(BuildOutputDir)\VFS.dll $(BuildInstallDongleDir)\" ContinueOnError="WarnAndContinue" />

		<!-- removed beacuse XCOPY cannot work with multiple list of files
		<ReadLinesFromFile File="FilesToCopy.txt">
			<Output TaskParameter="Lines" ItemName="FilesToCopy" />
		</ReadLinesFromFile>

		<CombinePath BasePath="$(BuildRetailDir)" Paths="@(FilesToCopy)">
		            <Output TaskParameter="CombinedPaths" ItemName="FilesToCopyWithPath" />
		</CombinePath >

		<Exec Command="XCOPY /Y @(FilesToCopyWithPath) $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		-->

		<!-- add/remove files to delete changing 'FileToDelete.txt" file -->
		<ReadLinesFromFile File="FilesToDelete.txt">
			<Output TaskParameter="Lines" ItemName="FilesToDelete" />
		</ReadLinesFromFile>

		<CombinePath BasePath="$(BuildRetailDir)" Paths="@(FilesToDelete)">
		            <Output TaskParameter="CombinedPaths" ItemName="FilesToDeleteWithPath" />
		</CombinePath >
		
		<Exec Command="DEL /F /S /Q @(FilesToDeleteWithPath)" ContinueOnError="WarnAndContinue" />

		<!-- copy shared dependency assemblies -->
		<!--
		<Exec Command="XCOPY /Y $(BuildOutputDir)\DocumentManagers\Newtonsoft.Json.dll $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\DocumentManagers\PubNub-Messaging.dll $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		-->

		<Exec Command="XCOPY /Y $(BuildOutputDir)\WebService\Newtonsoft.Json.dll $(BuildRetailDir)\WebService\" ContinueOnError="WarnAndContinue" />

		<Exec Command="XCOPY /Y $(PackageWebClientHTML5Dir)\bin\Newtonsoft.Json.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />

		<!-- delete unused HTML5 file -->
		<Exec Command="DEL /F /Q $(BuildRetailDir)\UFWebClient.HTML5\bin\DataSinks\GPIO*.*" ContinueOnError="WarnAndContinue" />
		<Exec Command="DEL /F /Q $(BuildRetailDir)\UFWebClient.HTML5\bin\TempVariables.*" ContinueOnError="WarnAndContinue" />
		<RemoveDir Directories="$(BuildRetailDir)\UFWebClient.HTML5\bin\WizardPlugins" />
		<Exec Command="FOR /F %%a IN ('DIR /B /A-D $(BuildRetailDir)\Drivers\*.*') DO DEL /F /Q $(BuildRetailDir)\%%a" />
	</Target>
	
	<Target Name="PreCompile">
		<MSBuild Projects=".\Dynamics\MSZ.csproj" ContinueOnError="ErrorAndStop" 
		     Properties="Configuration=Release;Platform=AnyCPU;DebugType=none;GenerateDocumentation=false;DefineTrace=false;RunCodeAnalysis=False" />
		<MSBuild Projects=".\GenerateHash\GenerateHash.csproj" ContinueOnError="ErrorAndStop" 
		     Properties="Configuration=Release;Platform=AnyCPU;DebugType=none;GenerateDocumentation=false;DefineTrace=false;RunCodeAnalysis=False" />

		<Exec Command="dotNET_Reactor.Console.exe -file &quot;.\UFSolution\bin\Release\net48\MSZ.dll&quot; -targetfile &quot;.\UFSolution\bin\Obfuscated\net48\&lt;AssemblyFileName&gt;&quot; -cert_friendly_name &quot;$(CertFriendlyName)&quot; -sha1_timestamp_server &quot;http://timestamp.sectigo.com&quot; -sha256_timestamp_server &quot;http://timestamp.sectigo.com&quot; -antitamp 0 -hide_calls 1 -hide_calls_internals 1 -invalid_metadata 0 -control_flow_obfuscation 1 -flow_level 9 -antistrong 1 -all_params 1 -exclude_properties 1 -exclude_compiler_types 0 -exclude_serializable_types 1" ContinueOnError="ErrorAndStop" />
		<Exec Command="dotNET_Reactor.Console.exe -file &quot;.\UFSolution\bin\Release\netstandard2.0\MSZ.dll&quot; -targetfile &quot;.\UFSolution\bin\Obfuscated\netstandard2.0\&lt;AssemblyFileName&gt;&quot; -cert_friendly_name &quot;$(CertFriendlyName)&quot; -sha1_timestamp_server &quot;http://timestamp.sectigo.com&quot; -sha256_timestamp_server &quot;http://timestamp.sectigo.com&quot; -antitamp 0 -hide_calls 1 -hide_calls_internals 1 -invalid_metadata 0 -control_flow_obfuscation 1 -flow_level 9 -antistrong 1 -all_params 1 -exclude_properties 1 -exclude_compiler_types 0 -exclude_serializable_types 1" ContinueOnError="ErrorAndStop" />

		<!-- Numerical Hashing -->
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /V&quot;ohash1&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48\MSZ.dll&quot; /D&quot;.\UFUAServerBase\AntiHack\Numerical.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /V&quot;ohash2&quot; /S&quot;.\UFSolution\bin\Obfuscated\netstandard2.0\MSZ.dll&quot; /D&quot;.\UFUAServerBase\AntiHack\Numerical.cs&quot;" ContinueOnError="ErrorAndStop" />
	</Target>
	
	<Target Name="AfterCompile">
		<Exec Command="dotNET_Reactor.Console.exe -project &quot;NetHashing.nrproj&quot; -cert_friendly_name &quot;$(CertFriendlyName)&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command="dotNET_Reactor.Console.exe -project &quot;DotNetHashing.nrproj&quot; -cert_friendly_name &quot;$(CertFriendlyName)&quot;" ContinueOnError="ErrorAndStop" />
		
		<!-- ArrayIndex Hashing (32 bits) -->
		<Exec Command="XCOPY /Y .\UFSolution\bin\Obfuscated\net48\MoviconNext.exe .\UFSolution\bin\Obfuscated\net48_x86\" ContinueOnError="ErrorAndStop" />
		<Exec Command="XCOPY /Y .\UFSolution\bin\Obfuscated\net48\MoviconNextRT.exe .\UFSolution\bin\Obfuscated\net48_x86\" ContinueOnError="ErrorAndStop" />
		<Exec Command="&quot;$(CoreFlagsTool)&quot; .\UFSolution\bin\Obfuscated\net48_x86\MoviconNext.exe /32BITREQ+" ContinueOnError="ErrorAndStop" />
		<Exec Command="&quot;$(CoreFlagsTool)&quot; .\UFSolution\bin\Obfuscated\net48_x86\MoviconNextRT.exe /32BITREQ+" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash1_x86&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48_x86\MoviconNext.exe&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash2_x86&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48_x86\MoviconNextRT.exe&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		
		<!-- ArrayIndex Hashing -->
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash1&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48\MoviconNext.exe&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash2&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48\MoviconNextRT.exe&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash4_1&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48\UFUAServerBase.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash4_2&quot; /S&quot;.\UFSolution\bin\Obfuscated\netstandard2.0\UFUAServerBase.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash5_1&quot; /S&quot;.\UFSolution\bin\Obfuscated\net48\MSZ.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash5_2&quot; /S&quot;.\UFSolution\bin\Obfuscated\netstandard2.0\MSZ.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash6_1&quot; /S&quot;..\..\Sources\Daemon\lib_x64\libipld.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash6_2&quot; /S&quot;..\..\Sources\Daemon\lib_linux\libipld.so.0.5.2&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash6_3&quot; /S&quot;..\..\Sources\Daemon\lib_linux\libipld.so.0.5.2.arm&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />

		<MSBuild Projects=".\Utilities\Utilities.csproj" ContinueOnError="ErrorAndStop"
		     Properties="Configuration=Release;Platform=AnyCPU;DebugType=none;GenerateDocumentation=false;DefineTrace=false;RunCodeAnalysis=False;BaseOutputPath=C:\Temp\bin\Release\" />
	</Target>

	<Target Name="Compile">
		<MakeDir Directories="$(OutputDirectory)" />
		<CallTarget Targets="PreBuild"/>
		<CallTarget Targets="PreCompile"/>
		<MSBuild Projects="$(SolutionToCompile)" ContinueOnError="ErrorAndContinue" 
		     Properties="Configuration=Release;Platform=Any CPU;DebugType=none;GenerateDocumentation=false;DefineTrace=false;DeployOnBuild=true;DeployTarget=Package;AutoParameterizationWebConfigConnectionStrings=False;RunCodeAnalysis=False" />
		<CallTarget Targets="Publish"/>
		<CallTarget Targets="PublishDeployServer"/>
		<CallTarget Targets="PublishWebHMI"/>
		<CallTarget Targets="AfterCompile"/>
		<CallTarget Targets="AfterBuild"/>
	</Target>

	<Target Name="Publish">
		<MSBuild Projects="$(ProjectsToPublish1)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0;PublishDir=.$(BuildPublishDir)-1;SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="$(ProjectsToPublish2)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0;PublishDir=.$(BuildPublishDir)-2;SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="$(ProjectsToPublish3)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0;PublishDir=.$(BuildPublishDir)-3;SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="$(ProjectsToPublish4)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0;PublishDir=.$(BuildPublishDir)-4;SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="$(ProjectsToPublish5)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0;PublishDir=.$(BuildPublishDir)-5;SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="$(ProjectsToPublish6)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=netcoreapp2.0;PublishDir=.$(BuildPublishDir)-6;SelfContained=false;_IsPortable=true;DebugType=none" />
	</Target>
	
	<Target Name="PublishDeployServer">
		<MSBuild Projects="@(ProjectsDeployServerToPublish)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0;PublishDir=.$(BuildDeployServerPublishDir);SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="@(ProjectsDeployServerToPublish)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0" />
		<MSBuild Projects="@(ProjectsDeployServerToPublish)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0;PublishDir=.$(BuildDeployServerPublishDir)-win-x86;SelfContained=false;_IsPortable=true;DebugType=none;RuntimeIdentifier=win-x86" />
		<Exec Command="FOR /F %%a IN ('DIR /B /S $(BuildDeployServerPublishDir)\wwwroot\scripts\*.js') DO terser --compress --mangle --output %%a %%a" /> 
	</Target>
	
	<Target Name="PublishWebHMI">
		<MSBuild Projects="@(ProjectsWebHMIToPublish)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0;PublishDir=..\..\$(BuildWebHMIPublishDir);SelfContained=false;_IsPortable=true;DebugType=none" />
		<MSBuild Projects="@(ProjectsWebHMIToPublish)" ContinueOnError="ErrorAndContinue" Targets="Clean" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0" />
		<MSBuild Projects="@(ProjectsWebHMIToPublish)" ContinueOnError="ErrorAndContinue" Targets="Publish" 
			Properties="Configuration=Release;Platform=Any CPU;TargetFramework=net6.0;PublishDir=..\..\$(BuildWebHMIPublishDir)-win-x86;SelfContained=false;_IsPortable=true;DebugType=none;RuntimeIdentifier=win-x86" />
		<Exec Command="FOR /F %%a IN ('DIR /B /S $(BuildWebHMIPublishDir)\wwwroot\scripts\*.js') DO terser --compress --mangle --output %%a %%a" /> 
		<Exec Command="terser --compress --mangle --output $(BuildWebHMIPublishDir)\wwwroot\js\nouislider-13.1.4.js $(BuildWebHMIPublishDir)\wwwroot\js\nouislider-13.1.4.js" /> 
	</Target>

	<Target Name="Build" DependsOnTargets="Clean;Restore;Compile">
		<Message Text="Finish to build version $(BuildNumber)"/>
	</Target>
</Project>