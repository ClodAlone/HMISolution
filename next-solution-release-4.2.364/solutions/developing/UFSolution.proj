		<Exec Command="XCOPY /Y /S $(BuildOutputDir)\ThemeResources\*.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\ThemeResources\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y /S $(BuildOutputDir)\ThemeResources\*.config $(BuildRetailDir)\UFWebClient.HTML5\bin\ThemeResources\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\RuntimeDarkSharedResources.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\RuntimeLightSharedResources.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\Microsoft.Expression.*.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\Microsoft.Surface.Presentation.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\System.Data.SQLite.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\System.Data.SQLite.dll.config $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\System.Data.SQLite.EF6.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\System.Data.SQLite.Linq.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\x64\SQLite.Interop.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\x64\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\x86\SQLite.Interop.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\x86\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\LinqStatistics.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\HelixToolkit.Wpf.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\MSSchedulerSettings.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\Nager.Date.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\MSModel.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\MSServerInfo.dll $(BuildRetailDir)\UFWebClient.HTML5\bin\" ContinueOnError="WarnAndContinue" />
