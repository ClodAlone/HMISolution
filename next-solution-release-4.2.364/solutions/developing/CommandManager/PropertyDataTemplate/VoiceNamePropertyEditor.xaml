<UserControl x:Class="CommandManager.PropertyDataTemplate.VoiceNamePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:local="clr-namespace:CommandManager"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d"
             d:DesignHeight="25" d:DesignWidth="200">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <utilities:UriConverter x:Key="UriConverter" />
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel>
    <Button x:Name="uri" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click_Clear">
      <Button.Content>
        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
      </Button.Content>
    </Button>
    <!--<ComboBox DropDownOpened="combo_DropDownOpened" IsTextSearchEnabled="False" 
                  SelectionChanged="combo_SelectionChanged" x:Name="combo" IsEditable="False"/>-->
    <dxe:ComboBoxEdit
            x:Name="uriLabel" IsTextEditable="False"
            Text="{Binding Path=Tag,ElementName=uri, UpdateSourceTrigger=PropertyChanged}"
            PopupOpening="uriLabel_PopupOpening"
            ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"/>
  </DockPanel>
</UserControl>
