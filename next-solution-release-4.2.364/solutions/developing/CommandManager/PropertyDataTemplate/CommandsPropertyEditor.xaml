<UserControl x:Class="CommandManager.PropertyDataTemplate.CommandsPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CommandManager.UserControls.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CommandsValueConverter x:Key="CommandsValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <!--<Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}"
                    Click="DlgButton_ClickClear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>-->
            <Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}"
                    Click="DlgButton_ClickEdit">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <!--<TextBox x:Name="txtValue" Validation.ErrorTemplate="{x:Null}" IsReadOnly="True"
               Text="{Binding Value, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CommandsValueConverter}, ValidatesOnDataErrors=True}"/>-->
        </DockPanel>
        <!--<ContentPresenter Grid.Column="1" Content="{Binding ElementName=txtValue, Path=(Validation.Errors).CurrentItem}"/>-->
    </Grid>
</UserControl>
