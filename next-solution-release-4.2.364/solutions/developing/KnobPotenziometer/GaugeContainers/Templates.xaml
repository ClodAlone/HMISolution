<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <ControlTemplate  x:Key="knobExpressLabelTemplate">
    <TextBlock RenderTransformOrigin="0.5,0.5"
               Text="{Binding Text}" Visibility="{Binding ShowLabels, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
               Foreground="{Binding LabelForeground, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
               FontStyle="{Binding LabelFontSettings.FontStyle, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
               FontWeight="{Binding LabelFontSettings.FontWeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
               FontFamily="{Binding LabelFontSettings.FontFamily, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
               FontSize="{Binding LabelFontSettings.FontSize, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                   />
  </ControlTemplate>
  <TextBox RenderTransformOrigin="0.5,0.5" x:Key="knobExpressValueTemplate"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" IsReadOnly="true" TextAlignment="Center" Background="Transparent" BorderThickness="0"
             Foreground="{Binding ValueForeground, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontStyle="{Binding ValueFontSettings.FontStyle, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontWeight="{Binding ValueFontSettings.FontWeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontFamily="{Binding ValueFontSettings.FontFamily, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontSize="{Binding ValueFontSettings.FontSize, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                   />
  <TextBlock RenderTransformOrigin="0.5,0.5" x:Key="knobExpressEngeneeringUnitTemplate"
             HorizontalAlignment="Center" VerticalAlignment="Center"  IsHitTestVisible="False" TextAlignment="Center" Background="Transparent"
             Foreground="{Binding EngeneeringUnitForeground, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontStyle="{Binding EngeneeringUnitFontSettings.FontStyle, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontWeight="{Binding EngeneeringUnitFontSettings.FontWeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontFamily="{Binding EngeneeringUnitFontSettings.FontFamily, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
             FontSize="{Binding EngeneeringUnitFontSettings.FontSize, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                   />
  
    <Viewbox x:Key="Flat_ScaleLayerTemplate"  Stretch="Fill" HorizontalAlignment="Left" 
             VerticalAlignment="Top" Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
      <Grid RenderTransformOrigin="0.5, 0.5" Width="150" Height="150" Margin="5"
            ClipToBounds="False">
        <Ellipse Margin="5" Tag="RingBackBrush" Fill="{Binding RingBackBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
        <Ellipse Margin="5" Width="110" Height="110">
          <Ellipse.Fill>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFBCC0CA" Offset="0"/>
              <GradientStop Color="#FF5C6378" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Margin="5" Tag="BackgroundBorderBrush"
                 Fill="{Binding BackgroundBorderBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                 Width="106" Height="106"/>
        <Ellipse Fill="White" Width="95" Height="95" Margin="27.5,26.5,27.5,27.5"/>
        <Ellipse Margin="5" Width="95" Height="95"
                 Tag="BackgroundBrush"
                 Fill="{Binding BackgroundBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>

        <Ellipse  Width="65" Height="65" Fill="White" Opacity="0.8" Margin="39.5,40.5,39.5,38.5"/>
        <Ellipse Margin="5" Width="65" Height="65" >
          <Ellipse.Fill>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FF5C6378"/>
              <GradientStop Color="#FFC0C2CB" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Margin="5" Tag="BackgroundBrush" Width="63" Height="63"
                 Fill="{Binding BackgroundBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
      </Grid>
    </Viewbox>

    <Viewbox x:Key="Classic_ScaleLayerTemplate"  Stretch="Fill" HorizontalAlignment="Left"
             VerticalAlignment="Top" Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
      <Grid RenderTransformOrigin="0.5, 0.5" Width="150" Height="150" Margin="5"
            ClipToBounds="False">
        <Ellipse Margin="5" Tag="RingBackBrush" Fill="{Binding RingBackBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
        <Ellipse Margin="5" Width="110" Height="110">
          <Ellipse.Fill>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFBCC0CA" Offset="0"/>
              <GradientStop Color="#FF5C6378" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Margin="5" Tag="BackgroundBorderBrush"
                 Fill="{Binding BackgroundBorderBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                 Width="106" Height="106"/>
        <Ellipse Fill="White" Width="95" Height="95" Margin="27.5,26.5,27.5,27.5"/>
        <Ellipse Margin="5" Width="95" Height="95"
                 Tag="BackgroundBrush"
                 Fill="{Binding BackgroundBrush,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
      </Grid>
    </Viewbox>

