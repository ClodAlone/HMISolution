<UserControl 
             x:Class="CustomWizardPlugin.ProjectWizardScreenTemplate"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="http://progea.com/CommonControls"
             mc:Ignorable="d"  
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:properties="clr-namespace:CustomWizardPlugin.Properties" 
             xmlns:converters="clr-namespace:WizardPluginHelpers.Converters;assembly=WizardPluginHelpers"
             HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:InvertBooleanConverter x:Key="InvertBoolean" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="{x:Static properties:Resources.ScreenNumber}"  Margin="10,0,0,0"
                HorizontalAlignment="Left"/>
            <dxe:SpinEdit EditValueChanged="spineditScreenNo_EditValueChanged" Grid.Column="1"
                x:Name="spineditScreenNo"  Margin="10,0,0,0"
                MinValue="0" MaxValue="999"
                VerticalAlignment="Top" Value="0"
                HorizontalAlignment="Left"
                Width="150" IsFloatValue="False"/>
        </Grid>
        <Grid x:Name="screenOption" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1" IsEnabled="False" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Content="{x:Static properties:Resources.ScreenWidth}" Grid.Row="0"   Margin="10,0,0,0"
                HorizontalAlignment="Left"/>
            <dxe:SpinEdit x:Name="spineditScreenWidth" Grid.Column="1" Grid.Row="0"
                    MinValue="100" Margin="10,0,0,0"
                    VerticalAlignment="Top" Value="1920"
                    HorizontalAlignment="Left"
                    Width="150" IsFloatValue="False" />

            <Label Content="{x:Static properties:Resources.ScreenHeight}"  Grid.Row="1"  Margin="10,8,0,0"
                    HorizontalAlignment="Left"/>
            <dxe:SpinEdit x:Name="spineditScreenHeight"  Grid.Column="1" Grid.Row="1"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                    MinValue="100" Margin="10,8,0,0"
                    VerticalAlignment="Top" Value="1080"
                    HorizontalAlignment="Left"
                    Width="150" IsFloatValue="False" />

            <Label Content="{x:Static properties:Resources.ScreenBackColor}" Grid.Row="2"  Margin="10,8,0,0"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                    HorizontalAlignment="Left"/>
            <cc:CustomPopupColorEdit x:Name="colorBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" 
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                              Margin="10,8,0,0" Height="21" Grid.Column="1" Grid.Row="2"/>

            <Label Content="{x:Static properties:Resources.AddScreenCaption}" Grid.Row="3"  Margin="10,8,0,0"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                        HorizontalAlignment="Left" />
            <CheckBox  x:Name="checkboxEnTitle" IsChecked="False" Grid.Column="1" Grid.Row="3"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                        VerticalAlignment="Bottom" Margin="10,8,0,0"
                        HorizontalAlignment="Left" 
                        Width="150" />

            <Label Content="{x:Static properties:Resources.ScreenForeColor}"   Margin="10,8,0,0" Grid.Row="4"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                   HorizontalAlignment="Left"/>
            <cc:CustomPopupColorEdit x:Name="colorTxtBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                              Margin="10,8,0,0"  Grid.Column="1"  Grid.Row="4"/>

            <Label Content="{x:Static properties:Resources.ScreenTitleFont}" Margin="10,8,0,0" HorizontalAlignment="Left" Grid.Row="5"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
            <dxe:FontEdit  x:Name="titleFont"  EditValue="Arial" Grid.Column="1" Grid.Row="5"  Margin="10,8,0,0"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Width="150" />

            <Label Content="{x:Static properties:Resources.ScreenTitleFontSize}" Margin="10,8,0,0" Grid.Row="6"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                        HorizontalAlignment="Left"/>
            <dxe:SpinEdit  Value="22" MinValue="8" x:Name="spineditScreenTitleFontSize" Grid.Row="6" Margin="10,8,0,0"
                   IsEnabled="{Binding EnableOptions, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                        VerticalAlignment="Top"  Grid.Column="1"
                        HorizontalAlignment="Left"
                        Width="150" />
        </Grid>
        <Grid x:Name="screenOption1"  Margin="0,20" Grid.ColumnSpan="2"  Grid.Column="2" Grid.Row="1" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
          <Grid IsEnabled="{Binding IsChecked, ElementName=checkboxEnTemplate, Converter={StaticResource InvertBoolean}, Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{x:Static properties:Resources.CreateNavBar}"  Margin="10,0,0,0"
              DockPanel.Dock="Left" HorizontalAlignment="Left"/>
            <CheckBox Grid.Row="0" IsChecked="False"  x:Name="checkboxCreateNavBar" Grid.Column="1"
                    VerticalAlignment="Bottom"  Margin="10,0,0,0"
                    HorizontalAlignment="Left" />

            <Label Grid.Row="1" Content="{x:Static properties:Resources.NavBarLayoutType}"  Margin="10,0,0,0"
              DockPanel.Dock="Left" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" x:Name="navBarLayoutType" MinWidth="150" HorizontalAlignment="Left"
            SelectedIndex="0" VerticalAlignment="Bottom" IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}"/>

            <Label Grid.Row="2" Content="{x:Static properties:Resources.NavBarBackColor}"  Margin="10,0,0,0"
              DockPanel.Dock="Left" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}"/>
            <cc:CustomPopupColorEdit x:Name="colorNavBarBackBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"
                   IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}" Margin="10,0,0,0"  Grid.Column="1"  Grid.Row="2"/>

            <Label Grid.Row="3" Content="{x:Static properties:Resources.NavBarButtonColor}"  Margin="10,0,0,0"
              DockPanel.Dock="Left" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}"/>
            <cc:CustomPopupColorEdit x:Name="colorNavBarButtonBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"
                   IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}" Margin="10,0,0,0"  Grid.Column="1"  Grid.Row="3"/>

            <Label Grid.Row="4" Content="{x:Static properties:Resources.NavBarButtonForeColor}"  Margin="10,0,0,0"
              DockPanel.Dock="Left" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}"/>
            <cc:CustomPopupColorEdit x:Name="colorNavBarButtonForeBrush" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"
                   IsEnabled="{Binding IsChecked, ElementName=checkboxCreateNavBar}" Margin="10,0,0,0"  Grid.Column="1"  Grid.Row="4"/>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="{x:Static properties:Resources.SelectScreenTemplate}"  Margin="10,0,0,0"
                      DockPanel.Dock="Left" HorizontalAlignment="Left"/>
            <CheckBox Grid.Row="0" IsChecked="False"  x:Name="checkboxEnTemplate" Grid.Column="1"
                      VerticalAlignment="Bottom"  Margin="10,0,0,0"
                      HorizontalAlignment="Left" />

            <Viewbox x:Name="thumb" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="10,0,0,0"
                     Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            </Viewbox>

            <Button MinWidth="100" HorizontalContentAlignment="Center" Margin="10,8,0,0"
                    x:Name="templateButton"
                       Grid.Row="1" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=checkboxEnTemplate}"
                      VerticalContentAlignment="Center" Click="screenTemplate_Click"
                          Content="{x:Static properties:Resources.Select}"/>
          </Grid>

        </Grid>
    </Grid>
</UserControl>
