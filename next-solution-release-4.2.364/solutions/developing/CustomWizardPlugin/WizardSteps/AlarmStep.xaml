<UserControl x:Class="CustomWizardPlugin.AlarmStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CustomWizardPlugin.Properties"
             mc:Ignorable="d"
             HorizontalAlignment="Left" VerticalAlignment="Top">
  <Grid HorizontalAlignment="Left">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50*" />
      <ColumnDefinition Width="50*" />
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Vertical" Margin="30">
      <Label HorizontalAlignment="Left" x:Name="labelHisTitle" Content="{x:Static properties:Resources.AddAlarms}"
             HorizontalContentAlignment="Left" />
      <StackPanel Margin="10,10,0,0"  Orientation="Vertical">
        <CheckBox  Margin="2,0,0,0" Grid.ColumnSpan="3" Grid.Row="0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxAnalogAlarm" Content="{x:Static properties:Resources.AddAnalogPrototype}"/>
        <CheckBox  Margin="2,10,0,0" Grid.ColumnSpan="3" Grid.Row="1" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDigitalAlarm" Content="{x:Static properties:Resources.AddDigitalPrototype}"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Vertical" Grid.Column="1" Margin="30">
      <Label HorizontalAlignment="Left" x:Name="labelDlrTitle" Content="{x:Static properties:Resources.AddDatalogger}"
             HorizontalContentAlignment="Left" />
      <StackPanel Margin="10,10,0,0" Orientation="Vertical">
        <CheckBox  Margin="2,0,0,0" Grid.ColumnSpan="3" Grid.Row="0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLROnChange" Content="{x:Static properties:Resources.AddDataloggerOnChange}"/>
        <CheckBox  Margin="2,10,0,0" Grid.ColumnSpan="3" Grid.Row="1" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLR5Sec" Content="{x:Static properties:Resources.AddDatalogger5Sec}"/>
        <CheckBox  Margin="2,10,0,0" Grid.ColumnSpan="3" Grid.Row="2" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLR30Sec" Content="{x:Static properties:Resources.AddDatalogger30Sec}"/>
        <CheckBox  Margin="2,10,0,0" Grid.ColumnSpan="3" Grid.Row="3" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLR1Min" Content="{x:Static properties:Resources.AddDatalogger1Min}"/>
      </StackPanel>
    </StackPanel>

  </Grid>
</UserControl>
