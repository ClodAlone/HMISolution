<UserControl x:Class="Pads.NumericPasswordPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:Pads.Properties"
             xmlns:local="clr-namespace:Pads"
             FocusManager.FocusedElement="{Binding ElementName=txt}"
             mc:Ignorable="d" 
             Height="300" Width="300">
    <Grid>
        <Grid x:Name="grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <StackPanel x:Name="minLenghtPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Content="{x:Static properties:Resources.MinValueTitle}"/>
                    <Label Content="" x:Name="minTxt" FontSize="22" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="maxLenghtPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Content="{x:Static properties:Resources.MaxValueTitle}"/>
                    <Label Content="" x:Name="maxTxt" FontSize="22" Margin="10,0,0,0"/>
                </StackPanel>
                <PasswordBox Password="" x:Name="txt" FontSize="22" KeyUp="Txt_KeyUp">
                    <PasswordBox.Resources>
                        <Storyboard x:Key="blink">
                            <DoubleAnimation 
                                             Storyboard.TargetName="txt"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0"
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                        </Storyboard>
                    </PasswordBox.Resources>
                </PasswordBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
