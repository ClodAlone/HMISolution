<UserControl x:Class="Pads.NumericPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:Pads.Properties"
             xmlns:local="clr-namespace:Pads"
             FocusManager.FocusedElement="{Binding ElementName=txt}"
             FontSize="{Binding Source={x:Static properties:Settings.Default},Path=NumericFontSize}" 
             mc:Ignorable="d" 
             Height="300" Width="300">
    <Grid>
        <Grid x:Name="grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True" x:Name="minValuePanel" Visibility="Collapsed">
                    <Label Content="{x:Static properties:Resources.MinValueTitle}" x:Name="minLabel" DockPanel.Dock="Left" />
                    <Label Content="" x:Name="minTxt" Margin="10,0,0,0"/>
                </DockPanel>
                <DockPanel Grid.Row="1" LastChildFill="True" x:Name="maxValuePanel" Visibility="Collapsed" DockPanel.Dock="Left">
                    <Label Content="{x:Static properties:Resources.MaxValueTitle}" x:Name="maxLabel" />
                    <Label Content="" x:Name="maxTxt" Margin="10,0,0,0"/>
                </DockPanel>
                <DockPanel Grid.Row="2" LastChildFill="True" >
                    <Button x:Name="plusMinusButton" Content="+/-" Click="Button_Click" ClickMode="Press"
                            Height="{Binding ElementName=txt, Path=ActualHeight}" 
                            Width="Auto" 
                            DockPanel.Dock="Left"/>
                    <TextBox Text="" x:Name="txt" Grid.Column="1" HorizontalAlignment="Stretch">
                        <TextBox.Resources>
                            <Storyboard x:Key="blink">
                                <DoubleAnimation 
                                             Storyboard.TargetName="txt"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0"
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                            </Storyboard>
                        </TextBox.Resources>
                    </TextBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
