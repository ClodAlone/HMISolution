<dxb:BarSubItem
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="StringManager.MenuControls.BarCommonItems"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:StringManager"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:StringManager.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/Strings.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewStringManager" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="100" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="100" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectStringManager" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="80" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <dxb:BarButtonItem x:Name="biAddNewLocale" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMaddlanguage}"  
                                 Command="{x:Static self:UIGeneralCommands.AddNewLocale}" />
            <dxb:BarButtonItem x:Name="biAddNewLocaleText" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMaddstring}"  
                                 Command="{x:Static self:UIGeneralCommands.AddNewLocaleText}" />

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItem x:Name="biRemoveLocale" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMRemoveLanguage}"  
                                 Command="{x:Static self:UIGeneralCommands.RemoveLocale}" />

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItem x:Name="biTranslateColumns" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMTranslateColumn}"  
                                 Command="{x:Static self:UIGeneralCommands.TranslateColumns}" />

            <dxb:BarCheckItem x:Name="biEnableAutoTranslate" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMEnableAutotranslate}"  
                                 Command="{x:Static self:UIGeneralCommands.EnableAutoTranslate}" 
                                 IsChecked="{Binding IsAutoTranslate, Mode=OneWay}"/>
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biToolsStringManager" Content="{x:Static translatableMenu:Resources.ToolsHeaderTitle}">
        <dxb:BarButtonItem MergeOrder="82" x:Name="biImportStrings" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMimportdata}"  
                                 Command="{x:Static self:UIGeneralCommands.ImportStrings}" />

        <dxb:BarButtonItem MergeOrder="83" x:Name="biExportStrings" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                 Glyph="{StaticResource STMexportdata}"  
                                 Command="{x:Static self:UIGeneralCommands.ExportStrings}" />
    </dxb:BarSubItem>
</dxb:BarSubItem>
