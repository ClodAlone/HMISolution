<UserControl x:Class="StringManager.Controls.NewLocale"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             d:DesignHeight="311" d:DesignWidth="519">
    <Grid>
        <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                Name="gridDataControl" 
                                AutoPopulateColumns="False" 
                                AllowDrop="True" 
                                AllowLiveDataShaping="False" 
                                MouseDoubleClick="gridDataControl_MouseDoubleClick"
                                dx:DXSerializer.SerializationID="gridDataControl" 
                                dx:DXSerializer.StoreLayoutMode="All" 
                                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
            <dxg:GridControl.Columns>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=NativeName, Mode=OneWay}" FieldName="NativeName" Header="Native Name"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" FieldName="Name" Header="Name"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=TwoLetterISOLanguageName, Mode=OneWay}" FieldName="TwoLetterISOLanguageName" Header="Two Letter ISO Language Name"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ThreeLetterISOLanguageName, Mode=OneWay}" FieldName="ThreeLetterISOLanguageName" Header="Three Letter ISO Language Name"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ThreeLetterWindowsLanguageName, Mode=OneWay}" FieldName="ThreeLetterWindowsLanguageName" Header="Three Letter Windows Language Name"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=EnglishName, Mode=OneWay}" FieldName="EnglishName" Header="English Name"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=DisplayName, Mode=OneWay}" FieldName="DisplayName" Header="Display Name"/>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>

                <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="False"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Row" 
                            MultiSelectMode="Row">
                    <!--<dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>-->
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>

        <ProgressBar IsIndeterminate="True" x:Name="progressBar" Height="5" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
