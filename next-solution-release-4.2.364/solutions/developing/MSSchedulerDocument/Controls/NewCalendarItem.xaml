<UserControl x:Class="MSSchedulerSettings.Controls.NewCalendarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:MSSchedulerSettings.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:MSSchedulerSettings.Converters"
             xmlns:self="clr-namespace:MSSchedulerSettings.Controls"
             xmlns:wpfutils="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WebDialogBtnStyle">
                <Setter Property="Button.Padding" Value="5" />
                <Setter Property="Button.Margin" Value="5" />
            </Style>
            <converters:DateToTimeConverter x:Key="DateToTimeConverter" />
            <converters:InvariantCultureDateConverter x:Key="InvariantCultureDateConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="mainPanel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.CalendarItemType}" VerticalAlignment="Center" x:Name="textConditionType"/>
            <wpfutils:ComboWeb Grid.Column="1" Grid.Row="0" SelectedValue="{Binding Type}" x:Name="comboCalendarItemType" VerticalAlignment="Center" 
                  HorizontalAlignment="Stretch" IsEditable="False"  SelectionChanged="comboCalendarItemType_SelectionChanged"/>
            <!--<controls:WebListView x:Name="comboCalendarItemTypeWeb" Visibility="Collapsed" SelectedValue="{Binding Type}" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"
            	HorizontalAlignment="Stretch" SelectionChanged="comboCalendarItemType_SelectionChanged" />-->

            <TextBlock x:Name="tbStartDate" Grid.Row="1" Text="{x:Static properties:Resources.StartDate}" VerticalAlignment="Center" />
        <dxe:DateEdit Margin="2,0,2,0" Grid.Row="1" Grid.Column="1" EditValue="{Binding StartDate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                 x:Name="textEditStartDate" MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True"/>
        <self:WebDateEdit Margin="2,0,2,0" Grid.Row="1" Grid.Column="1" EditValue="{Binding StartDate, Converter={StaticResource InvariantCultureDateConverter}, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                 x:Name="textEditStartDate_text" Visibility="Collapsed" MaskType="DateTime" DisplayFormatString="" MaskUseAsDisplayFormat="True"/>
        <ContentPresenter Grid.Row="1" Grid.Column="2" Name="cpStartDate" 
            Content="{Binding ElementName=textEditStartDate, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock x:Name="tbEndDate" Grid.Row="2" Text="{x:Static properties:Resources.EndDate}" VerticalAlignment="Center" />
        <dxe:DateEdit Margin="2,0,2,0" Grid.Row="2" Grid.Column="1" EditValue="{Binding EndDate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                 x:Name="textEditEndDate" MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True"/>
        <self:WebDateEdit Margin="2,0,2,0" Grid.Row="2" Grid.Column="1" EditValue="{Binding EndDate, Converter={StaticResource InvariantCultureDateConverter}, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                 x:Name="textEditEndDate_text" Visibility="Collapsed" MaskType="DateTime" DisplayFormatString="" MaskUseAsDisplayFormat="True"/>
        <ContentPresenter Grid.Row="2" Grid.Column="2" Name="cpEndDate" 
            Content="{Binding ElementName=textEditEndDate, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock x:Name="tbDayMonth" Grid.Row="3" Text="{x:Static properties:Resources.DayMonth}" VerticalAlignment="Center"/>
        <wpfutils:ComboWeb Grid.Column="1" Grid.Row="3" SelectedIndex="{Binding Path=DayOfMonth, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" x:Name="comboDayMonth" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboDayMonth_SelectionChanged" />
        
        <TextBlock x:Name="tbMonth" Grid.Row="4" Text="{x:Static properties:Resources.Month}" VerticalAlignment="Center"/>
            <wpfutils:ComboWeb Grid.Column="1" Grid.Row="4" SelectedValue="{Binding Month}" x:Name="comboMonth" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False"  SelectionChanged="comboMonth_SelectionChanged"/>

            <TextBlock x:Name="tbWeek" Grid.Row="5" Text="{x:Static properties:Resources.WeekOfMonth}" VerticalAlignment="Center" />
            <wpfutils:ComboWeb Grid.Column="1" Grid.Row="5" SelectedValue="{Binding WeekOfMonth}" x:Name="comboWeekOfMonth" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />

            <TextBlock x:Name="tbDay" Grid.Row="6" Text="{x:Static properties:Resources.DayOfWeek}" VerticalAlignment="Center" />
            <wpfutils:ComboWeb Grid.Column="1" Grid.Row="6" SelectedValue="{Binding DayOfWeek}" x:Name="comboDayOfWeek" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboDayOfWeek_SelectionChanged" />

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.StartTime}" VerticalAlignment="Center" Name="lblStartTime" />
        <dxe:TextEdit Margin="2,0,2,0" Grid.Row="7" Grid.Column="1" EditValue="{Binding StartDate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                x:Name="textEditStartTime" MaskType="DateTimeAdvancingCaret" DisplayFormatString="HH:mm:ss" Mask="HH:mm:ss"/>
        <ContentPresenter Grid.Row="7" Grid.Column="2" Name="cpStartTime"
                Content="{Binding ElementName=textEditStartTime, Path=(Validation.Errors).CurrentItem}" />
        <TextBox Visibility="Collapsed" Grid.Row="7" Grid.Column="1" Margin="1"
                 FontFamily="{Binding ElementName=comboCalendarItemType, Path=FontFamily, Mode=OneWay}"
                 FontSize="{Binding ElementName=comboCalendarItemType, Path=FontSize, Mode=OneWay}"
                 FontStyle="{Binding ElementName=comboCalendarItemType, Path=FontStyle, Mode=OneWay}"
                 FontWeight="{Binding ElementName=comboCalendarItemType, Path=FontWeight, Mode=OneWay}"
                 x:Name="textEditStartTime_web" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}">
        </TextBox>
        <ContentPresenter Visibility="Collapsed" Grid.Row="7" Grid.Column="2" Name="cpStartTime_web"
            Content="{Binding ElementName=textEditStartTime_web, Path=(Validation.Errors).CurrentItem}" />


        <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.EndTime}" VerticalAlignment="Center" Name="lblEndTime" />
        <dxe:TextEdit Margin="2,0,2,0" Grid.Row="8" Grid.Column="1" EditValue="{Binding EndDate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                 x:Name="textEditEndTime" MaskType="DateTimeAdvancingCaret" DisplayFormatString="HH:mm:ss" Mask="HH:mm:ss"/>
        <ContentPresenter Grid.Row="8" Grid.Column="2" Name="cpEndTime" 
            Content="{Binding ElementName=textEditEndTime, Path=(Validation.Errors).CurrentItem}" />
            <TextBox Visibility="Collapsed" Grid.Row="8" Grid.Column="1" Margin="1"
                 FontFamily="{Binding ElementName=comboCalendarItemType, Path=FontFamily, Mode=OneWay}"
                 FontSize="{Binding ElementName=comboCalendarItemType, Path=FontSize, Mode=OneWay}"
                 FontStyle="{Binding ElementName=comboCalendarItemType, Path=FontStyle, Mode=OneWay}"
                 FontWeight="{Binding ElementName=comboCalendarItemType, Path=FontWeight, Mode=OneWay}"
                 x:Name="textEditEndTime_web" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" />

            <ContentPresenter Visibility="Collapsed" Grid.Row="8" Grid.Column="2" Name="cpEndTime_web"
            Content="{Binding ElementName=textEditEndTime_web, Path=(Validation.Errors).CurrentItem}" />
        <StackPanel x:Name="webDialogButtons" Visibility="Collapsed" Grid.Row="9" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Button x:Name="webOkBtn" Style="{StaticResource WebDialogBtnStyle}" Content="{x:Static properties:Resources.WeeklyItemEditFormOk}" Click="WebDialogOk_Click" />
            <Button x:Name="webCancelBtn" Style="{StaticResource WebDialogBtnStyle}" Content="{x:Static properties:Resources.WeeklyItemEditFormCancel}" Click="WebDialogCancel_Click" />
        </StackPanel>
    </Grid>
    </StackPanel>
</UserControl>
