<UserControl x:Class="MSSchedulerSettings.Controls.WeeklyItemEditList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:MSSchedulerSettings.Properties"
             xmlns:wpfutilities="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             mc:Ignorable="d" 
              MinWidth="350" MinHeight="250">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <ListView x:Name="itemList" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
      <ListView.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
          <EventSetter Event="MouseDoubleClick" Handler="listViewLink_MouseDoubleClick" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
            <Button x:Name="uriDelete" DockPanel.Dock="Right" Tag="{Binding}" Click="DlgButtonDelete_Click">
              <Button.Content>
                <Image Source="{StaticResource DeleteSmall}" Height="16" Width="16" />
              </Button.Content>
            </Button>
            <Button x:Name="uriEdit" DockPanel.Dock="Right" Tag="{Binding}" Click="DlgButtonEdit_Click">
              <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
              </Button.Content>
            </Button>
            <TextBlock Text="{Binding Name}" />
          </DockPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
        <Button Click="DlgButtonAdd_Click" Grid.Row="1" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.AddNewWeeklyItem}">
      <Button.Content>
        <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
      </Button.Content>
    </Button>
        <Button Click="DlgButtonRemoveAll_Click" Grid.Row="2" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.RemoveAllWeeklyItem}">
        <Button.Content>
            <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
        </Button.Content>
    </Button>
    <Button Margin="5,5" Grid.Row="3" Content="{x:Static properties:Resources.WeeklyItemEditFormOk}"
            HorizontalAlignment="Center"
            MinWidth="{Binding Source={x:Static wpfutilities:Settings.Default}, Path=ButtonsWidth}"
            MinHeight="{Binding Source={x:Static wpfutilities:Settings.Default}, Path=ButtonsHeight}"
            x:Name="okBtn" Click="OnOKButtonClick" />
  </Grid>
</UserControl>
