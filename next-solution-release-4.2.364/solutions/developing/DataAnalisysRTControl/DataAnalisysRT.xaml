<UserControl x:Class="DataAnalisysRTControl.DataAnalisysRT"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:localconverters="clr-namespace:DataAnalisysRTControl.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:DataAnalisysRTControl.Properties"
	           xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:sys="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:System="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/DataAnalisysRTControl.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues"
                            ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="sys:HorizontalComparisonAlignment"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <converters:ConditionalStyleConverter x:Key="ConditionalStyleConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertedVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <localconverters:FilterTypeToBooleanConverter x:Key="FilterTypeToBooleanConverter" />
            <localconverters:OperatingModeToVisibilityConverter x:Key="OperatingModeToVisibilityConverter" />
            <localconverters:DoublePrecisionConverter x:Key="DoublePrecisionConverter" />
            <Style TargetType="{x:Type Button}" x:Key="ButtonRowCommandStyle">
            </Style>
            <DataTemplate x:Key="Data">
                <Grid>
                    <StackPanel>
                        <dxe:ImageEdit IsPrintingMode="True" Source="{Binding Content}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="AxisTitleTemplate">
                <TextBlock Text="{Binding}" Margin="0,30,0,0">
                    
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="40" X="30"/>
                            <RotateTransform CenterX="0.5" CenterY="0.5" Angle="90"/>
                            
                        </TransformGroup>
                        
                    </TextBlock.RenderTransform>
                </TextBlock>
            </DataTemplate>
            <dxc:LineSeries2D ArgumentScaleType="DateTime" x:Key="lineSeries" x:Shared="False"
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:LineSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:LineSeries2D.Label>
                <dxc:LineSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:LineSeries2D.PointOptions>
            </dxc:LineSeries2D>

            <dxc:LineStepSeries2D ArgumentScaleType="DateTime" x:Key="lineStepSeries" x:Shared="False"
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:LineStepSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:LineStepSeries2D.Label>
                <dxc:LineStepSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:LineStepSeries2D.PointOptions>
            </dxc:LineStepSeries2D>

            <dxc:LineStackedSeries2D ArgumentScaleType="DateTime" x:Key="lineStackedSeries" x:Shared="False"
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:LineStackedSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:LineStackedSeries2D.Label>
                <dxc:LineStackedSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:LineStackedSeries2D.PointOptions>
            </dxc:LineStackedSeries2D>

            <dxc:LineFullStackedSeries2D ArgumentScaleType="DateTime" x:Key="lineFullStackedSeries" x:Shared="False"
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:LineFullStackedSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:LineFullStackedSeries2D.Label>
                <dxc:LineFullStackedSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:LineFullStackedSeries2D.PointOptions>
            </dxc:LineFullStackedSeries2D>

            <dxc:AreaSeries2D ArgumentScaleType="DateTime" x:Key="areaSeries" x:Shared="False"
                              Transparency="0.5" ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" MarkerSize="5">
                <dxc:AreaSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:AreaSeries2D.Label>
                <dxc:AreaSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:AreaSeries2D.PointOptions>
            </dxc:AreaSeries2D>
            <!--<dxc:AreaSeries2D ArgumentScaleType="DateTime" x:Key="areaSeries" x:Shared="False"
                              Transparency="0.5" 
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:AreaSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:AreaSeries2D.Label>
                <dxc:AreaSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:AreaSeries2D.PointOptions>
            </dxc:AreaSeries2D>-->

            <dxc:AreaStepSeries2D ArgumentScaleType="DateTime" x:Key="areaStepSeries" x:Shared="False"
                                Transparency="0.5" 
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:AreaStepSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:AreaStepSeries2D.Label>
                <dxc:AreaStepSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:AreaStepSeries2D.PointOptions>
            </dxc:AreaStepSeries2D>

            <dxc:AreaStackedSeries2D ArgumentScaleType="DateTime" x:Key="areaStackedSeries" x:Shared="False"
                                Transparency="0.5" 
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                  AnimationAutoStartMode="PlayOnce">
                <dxc:AreaStackedSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:AreaStackedSeries2D.Label>
                <dxc:AreaStackedSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:AreaStackedSeries2D.PointOptions>
            </dxc:AreaStackedSeries2D>

            <dxc:AreaFullStackedSeries2D ArgumentScaleType="DateTime" x:Key="areaFullStackedSeries" x:Shared="False"
                                Transparency="0.5" 
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                  AnimationAutoStartMode="PlayOnce">
                <dxc:AreaFullStackedSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:AreaFullStackedSeries2D.Label>
                <dxc:AreaFullStackedSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:AreaFullStackedSeries2D.PointOptions>
            </dxc:AreaFullStackedSeries2D>

            <dxc:BarSideBySideSeries2D ArgumentScaleType="DateTime" x:Key="barSideSeries" x:Shared="False"
                                                  ArgumentDataMember="SourceTimeStamp" 
                                                  ValueDataMember="dValue" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                  AnimationAutoStartMode="PlayOnce">
                <dxc:BarSideBySideSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:BarSideBySideSeries2D.Label>
            </dxc:BarSideBySideSeries2D>


            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="{Binding DefToolbarHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="5" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <dxc:SecondaryAxisY2D x:Key="secondaryaxisY" x:Shared="False"
                        Logarithmic="False" Alignment="Near"
                        LogarithmicBase="10.0"
                        GridLinesVisible="False" GridLinesMinorVisible="False">
                <dxc:AxisY2D.NumericScaleOptions>
                    <dxc:ContinuousNumericScaleOptions AutoGrid="{Binding YAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                </dxc:AxisY2D.NumericScaleOptions>
                <dxc:SecondaryAxisY2D.CrosshairAxisLabelOptions>
                    <dxc:CrosshairAxisLabelOptions Pattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                </dxc:SecondaryAxisY2D.CrosshairAxisLabelOptions>
                <dxc:SecondaryAxisY2D.WholeRange>
                    <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" AutoSideMargins="False" SideMarginsValue="0" />
                </dxc:SecondaryAxisY2D.WholeRange>
                <dxc:SecondaryAxisY2D.Label>
                    <dxc:AxisLabel TextPattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                        <dxc:SecondaryAxisY2D.ResolveOverlappingOptions>
                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                    AllowRotate="True"
                                    AllowStagger="True"
                                    MinIndent="5" />
                        </dxc:SecondaryAxisY2D.ResolveOverlappingOptions>
                    </dxc:AxisLabel>
                </dxc:SecondaryAxisY2D.Label>
            </dxc:SecondaryAxisY2D>
            <dxc:SecondaryAxisX2D x:Key="secondaryaxisX"  x:Shared="True"
                    GridLinesVisible="False" 
                    GridLinesMinorVisible="False">
                <dxc:SecondaryAxisX2D.DateTimeScaleOptions>
                    <dxc:ContinuousDateTimeScaleOptions AutoGrid="{Binding XAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                </dxc:SecondaryAxisX2D.DateTimeScaleOptions>
                <dxc:SecondaryAxisX2D.WholeRange>
                    <dxc:Range AutoSideMargins="False" SideMarginsValue="0" />
                </dxc:SecondaryAxisX2D.WholeRange>
                <dxc:SecondaryAxisX2D.CrosshairLabelTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}" Padding="5,1">
                            <TextBlock Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}" FontStretch="{Binding FontStretch}" FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}" Text="{Binding Text}" />
                        </Border>
                    </DataTemplate>
                </dxc:SecondaryAxisX2D.CrosshairLabelTemplate>
                <dxc:SecondaryAxisX2D.CrosshairAxisLabelOptions>
                    <dxc:CrosshairAxisLabelOptions Pattern=" {A:G}" />
                </dxc:SecondaryAxisX2D.CrosshairAxisLabelOptions>
                <dxc:SecondaryAxisX2D.Label>
                    <dxc:AxisLabel>
                        <dxc:Axis2D.ResolveOverlappingOptions>
                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                                                                    AllowRotate="False"
                                                                                    AllowStagger="False"
                                                                                    MinIndent="5" />
                        </dxc:Axis2D.ResolveOverlappingOptions>
                    </dxc:AxisLabel>
                </dxc:SecondaryAxisX2D.Label>
            </dxc:SecondaryAxisX2D>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="view">

        <Grid x:Name="mainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AdornerDecorator Grid.Row="1" x:Name="adorner" Grid.ColumnSpan="10" Grid.RowSpan="10">
            <dxd:DockLayoutManager x:Name="dockManager" DockItemHidden="OnDockItemHidden" ClosedPanelsBarVisibility="Auto">

                <dxd:LayoutGroup x:Name="groupGeneral">

                    <dxd:LayoutPanel ShowCaption="False" Caption="{x:Static properties:Resources.ChartTitle}" x:Name="chartPanel">
                        <Grid x:Name="mainChartGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="9*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <dxc:ChartControl Name="chart" BorderThickness="0" EnableAnimation="False" 
                          CrosshairEnabled="{Binding IsInStop, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                          PreviewKeyDown="chart_PreviewKeyDown" 
                          CustomDrawSeries="chart_CustomDrawSeries"
                          PreviewMouseDown="chart_MouseDown"
                          AxisScaleChanged="chart_AxisScaleChanged"
                          BoundDataChanged="chart_BoundDataChanged"
                          PreviewMouseWheel="chart_PreviewMouseWheel">
                                <dxc:ChartControl.IsManipulationEnabled>True</dxc:ChartControl.IsManipulationEnabled>
                                <dxc:ChartControl.CrosshairOptions>
                                    <dxc:CrosshairOptions ShowArgumentLine="True" ShowValueLine="True" x:Name="crosshair"
                                                      ShowArgumentLabels="True" ShowValueLabels="True"
                                                      ShowCrosshairLabels="True"
                                                      CrosshairLabelMode="ShowForNearestSeries" />
                                </dxc:ChartControl.CrosshairOptions>
                                <dxc:ChartControl.Diagram>
                                    <dxc:XYDiagram2D Name="diagram" AllowSeriesBitmapCaching="False" Rotated="{Binding Rotated, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" Scroll="OnDiagramScroll"
                                           Zoom="diagram_Zoom" MouseWheel="diagram_MouseWheel" EnableAxisXNavigation="True" EnableAxisYNavigation="True">
                                        <dxc:XYDiagram2D.DefaultPane>
                                            <dxc:Pane x:Name="pane" Grid.Row="0">
                                                <dxc:Pane.AxisYScrollBarOptions>
                                                    <dxc:ScrollBarOptions Alignment="Far"
                                                              Visible="True" />
                                                </dxc:Pane.AxisYScrollBarOptions>
                                                <dxc:Pane.AxisXScrollBarOptions>
                                                    <dxc:ScrollBarOptions Alignment="Near" 
                                                              Visible="True" />
                                                </dxc:Pane.AxisXScrollBarOptions>
                                            </dxc:Pane>
                                        </dxc:XYDiagram2D.DefaultPane>

                                        <dxc:XYDiagram2D.AxisY>
                                            <dxc:AxisY2D Name="axisY" Visible="False"
                                                     Logarithmic="{Binding LogarithmicYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                     LogarithmicBase="{Binding LogarithmicBaseYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                     GridLinesVisible="{Binding YGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                     GridLinesMinorVisible="{Binding YMinorGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                <dxc:AxisY2D.NumericScaleOptions>
                                                    <dxc:ContinuousNumericScaleOptions x:Name="numericalScaleOptions" AutoGrid="{Binding YAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                                </dxc:AxisY2D.NumericScaleOptions>
                                                <dxc:AxisY2D.CrosshairAxisLabelOptions>
                                                    <dxc:CrosshairAxisLabelOptions Pattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                                </dxc:AxisY2D.CrosshairAxisLabelOptions>
                                                <dxc:AxisY2D.WholeRange>
                                                    <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" AutoSideMargins="False" SideMarginsValue="0" />
                                                </dxc:AxisY2D.WholeRange>
                                                <dxc:AxisY2D.Label>
                                                    <dxc:AxisLabel TextPattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                                                                    AllowRotate="True"
                                                                                    AllowStagger="True"
                                                                                    MinIndent="5" />
                                                        </dxc:Axis2D.ResolveOverlappingOptions>
                                                    </dxc:AxisLabel>
                                                </dxc:AxisY2D.Label>
                                            </dxc:AxisY2D>
                                        </dxc:XYDiagram2D.AxisY>
                                        <dxc:XYDiagram2D.SecondaryAxesX>
                                                
                                        </dxc:XYDiagram2D.SecondaryAxesX>
                                        <dxc:XYDiagram2D.SecondaryAxesY>
                                            <!--<dxc:SecondaryAxisY2D x:Name="pressureAxis" Foreground="Red" Alignment="Near" GridLinesVisible="True" GridLinesMinorVisible="True" MinorCount="3">
                                                <dxc:SecondaryAxisY2D.Title>
                                                    <dxc:AxisTitle Content="Pressure"/>
                                                </dxc:SecondaryAxisY2D.Title>
                                                <dxc:SecondaryAxisY2D.Range>
                                                    <dxc:AxisRange MaxValue="1025" MinValue="1014" />
                                                </dxc:SecondaryAxisY2D.Range>
                                            </dxc:SecondaryAxisY2D>
                                            <dxc:SecondaryAxisY2D x:Name="humidityAxis" Foreground="BlueViolet" Alignment="Near" GridLinesVisible="True" GridLinesMinorVisible="True" MinorCount="2">
                                                <dxc:SecondaryAxisY2D.Title>
                                                    <dxc:AxisTitle Content="Humidity"/>
                                                </dxc:SecondaryAxisY2D.Title>
                                                <dxc:SecondaryAxisY2D.Range>
                                                    <dxc:AxisRange MaxValue="120" MinValue="0" />
                                                </dxc:SecondaryAxisY2D.Range>
                                            </dxc:SecondaryAxisY2D>-->
                                        </dxc:XYDiagram2D.SecondaryAxesY>
                                        <dxc:XYDiagram2D.AxisX>
                                            <dxc:AxisX2D Name="axisX" 
                                                     GridLinesVisible="{Binding XGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                     GridLinesMinorVisible="{Binding XMinorGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                <dxc:AxisX2D.DateTimeScaleOptions>
                                                    <!--<dxc:ManualDateTimeScaleOptions AggregateFunction="None" AutoGrid="{Binding XAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />-->
                                                    <dxc:ContinuousDateTimeScaleOptions AutoGrid="{Binding XAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                                </dxc:AxisX2D.DateTimeScaleOptions>
                                                <dxc:AxisX2D.WholeRange>
                                                    <dxc:Range AutoSideMargins="False" SideMarginsValue="0" />
                                                </dxc:AxisX2D.WholeRange>
                                                <dxc:AxisX2D.CrosshairLabelTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Background}" Padding="5,1">
                                                            <TextBlock Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}" FontStretch="{Binding FontStretch}" FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}" Text="{Binding Text}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </dxc:AxisX2D.CrosshairLabelTemplate>
                                                <dxc:AxisX2D.CrosshairAxisLabelOptions>
                                                    <dxc:CrosshairAxisLabelOptions Pattern=" {A:G}" />
                                                </dxc:AxisX2D.CrosshairAxisLabelOptions>
                                                <dxc:AxisX2D.Label>
                                                    <dxc:AxisLabel>
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
