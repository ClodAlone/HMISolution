                        <dxb:BarItemSeparator/>
                    </dxb:BarLinkContainerItem>

                    <dxb:BarItemSeparator/>
                  
                    <dxb:BarLinkContainerItem x:Name="toolbarCompare" IsVisible="{Binding ShowToolbarCompare, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="startTextTitle" IsReadOnly="True" Content="{x:Static properties:Resources.StartDate}">
                          <dxb:BarEditItem.ContentTemplate>
                            <DataTemplate>
                              <dxe:TextEdit
                                MaskType="DateTime" MaskUseAsDisplayFormat="True" IsReadOnly="True"
                                MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
                                EditValue="{Binding DateTimeStart}"
                                Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonDateSpanMinWidth}"/>
                            </DataTemplate>
                          </dxb:BarEditItem.ContentTemplate>
                        </dxb:BarEditItem>
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="endTextTitle" IsReadOnly="True" Content="{x:Static properties:Resources.EndDate}">
                          <dxb:BarEditItem.ContentTemplate>
                            <DataTemplate>
                              <dxe:TextEdit
                                MaskType="DateTime" MaskUseAsDisplayFormat="True" IsReadOnly="True"
                                MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                                EditValue="{Binding DateTimeEnd}"
                                Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonDateSpanMinWidth}"/>
                            </DataTemplate>
                          </dxb:BarEditItem.ContentTemplate>
                        </dxb:BarEditItem>
                    </dxb:BarLinkContainerItem>
                </dxb:ToolBarControl>
            </dxb:BarContainerControl>

            <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="10" Grid.RowSpan="10" />
            <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="nullconnectionContent" Text="{Binding ConnectionError, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <Viewbox Stretch="Fill" Visibility="Collapsed" x:Name="txtMode" IsHitTestVisible="False" 
                   KeyboardNavigation.IsTabStop="False"
                 Width="{Binding ElementName=layoutItems, Path=Width}" Height="{Binding ElementName=layoutItems, Path=Height}">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" 
                   KeyboardNavigation.IsTabStop="False"
                       Text="{x:Static properties:Resources.NoReportLicense}" FontSize="48" Opacity="0.1">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-45" />
                </TextBlock.LayoutTransform>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </TextBlock.Effect>
            </TextBlock>
        </Viewbox>
    </Grid>
</UserControl>
