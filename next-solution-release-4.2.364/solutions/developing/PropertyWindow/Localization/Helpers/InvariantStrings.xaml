<UserControl x:Class="PropertyControl.Localization.Helpers.InvariantStrings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PropertyControl.Localization"
             xmlns:properties="clr-namespace:PropertyControl.Properties"
             mc:Ignorable="d" Height="200" Width="400"
             d:DesignHeight="200" d:DesignWidth="400">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="{x:Static properties:Resources.InvariatStringTitle}" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" Margin="2" Text="{x:Static properties:Resources.InvariantStringDisplayName}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Margin="2" Text="{x:Static properties:Resources.InvariantStringCategory}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="3" Margin="2" Text="{x:Static properties:Resources.InvariantStringCategoryPriority}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="4" Margin="2" Text="{x:Static properties:Resources.InvariatStringHelp}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="5" Margin="2" Text="{x:Static properties:Resources.InvariatStringPriority}" VerticalAlignment="Center" />
        
        <TextBox x:Name="txtPropertyName" Grid.Row="1" Grid.Column="1" Margin="2" Text="{Binding DisplayName, Mode=OneTime}" />
        <TextBox x:Name="txtPropertyCategory" Grid.Row="2" Grid.Column="1" Margin="2" Text="{Binding Category, Mode=OneTime}" />
        <TextBox x:Name="txtPropertyCategoryPriority" Grid.Row="3" Grid.Column="1" Margin="2" Text="{Binding CategoryPriority, Mode=OneTime}" />
        <TextBox x:Name="txtPropertyHelp" Grid.Row="4" Grid.Column="1" Margin="2" TextWrapping="Wrap" Text="{Binding Description, Mode=OneTime}" />
        <TextBox x:Name="txtPropertyPriority" PreviewTextInput="TextBox_PreviewTextInput" Grid.Row="5" Grid.Column="1" Margin="2" TextWrapping="Wrap" Text="{Binding Priority, Mode=OneTime}" />
    </Grid>
</UserControl>
