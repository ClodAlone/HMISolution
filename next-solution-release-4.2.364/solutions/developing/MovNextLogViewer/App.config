<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="MovNextLogViewer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
    <log4net>
      <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
        <File value="${ALLUSERSPROFILE}\Progea\MovNextLogViewer.Log\SysLog.xml" />
        <encoding value="unicode" />
        <appendToFile value="true" />
        <rollingStyle value="Size" />
        <maxSizeRollBackups value="10" />
        <maximumFileSize value="10MB" />
        <staticLogFileName value="true" />
        <param name="LockingModel" type="ConcurrentLog4Net.ConcurrentMinimalLock,ConcurrentLog4Net" />
        <datePattern value="yyyyMMdd" />
        <layout type="log4net.Layout.XmlLayout">
          <locationInfo value="true" />
        </layout>
      </appender>
      <root>
        <level value="DEBUG" />
        <appender-ref ref="RollingFileAppender" />
      </root>
    </log4net>
    <appSettings>
        <add key="log4net.Internal.Emit" value="false"/>
    </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="Toolbox" />
    </assemblyBinding>
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7"/>
  </startup>
  <applicationSettings>
    <MovNextLogViewer.Properties.Settings>
      <setting name="ThemeName" serializeAs="String">
        <value>MetropolisDark</value>
      </setting>
      <setting name="VisualStyle" serializeAs="String">
        <value>Blend</value>
      </setting>
      <setting name="LoggerName" serializeAs="String">
        <value>MovNextLogViewer</value>
      </setting>
      <setting name="MainTitle" serializeAs="String">
        <value>Movicon.NExT Log File Viewer</value>
      </setting>
    </MovNextLogViewer.Properties.Settings>
  </applicationSettings>
</configuration>
