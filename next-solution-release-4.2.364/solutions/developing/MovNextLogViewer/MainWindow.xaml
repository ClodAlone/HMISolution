<Window x:Class="MovNextLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovNextLogViewer"
        xmlns:lv="clr-namespace:Log4NetViewer;assembly=Log4NetViewer"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        mc:Ignorable="d"
        x:Name="mainWindow"
        Width="1024" Height="576"><!-- 16:9 -->
    <Grid>
        <lv:Log4NetViewer x:Name="logViewer" IsExternalWpfApp="True"
            Grid.Row="0" Grid.Column="0" Background="{x:Null}">
        </lv:Log4NetViewer>
    </Grid>
</Window>
