<dxb:BarSubItem
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="ScriptManager.MenuControls.BarCommonItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:ScriptManager"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:properties="clr-namespace:ScriptManager.Properties"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/Script.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewScripts" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="90" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="90" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectScripts" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem x:Name="biScriptEdit" MergeOrder="70" Content="{x:Static properties:Resources.TypeTitle}"  MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <dxb:BarItemLinkSeparator MergeOrder="15" />

            <dxb:BarButtonItem MergeOrder="20" x:Name="biEditReferences" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" 
                                       RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.EditReferences}" 
                                       Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" Glyph="{StaticResource SCMEditaReferenze}"/>
            <dxb:BarButtonItem MergeOrder="30" x:Name="biDebugStepInto" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" 
                                       RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.DebugStepInto}" 
                                       Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" Glyph="{StaticResource SCMEditor}"/>
        </dxb:BarSubItem>
    </dxb:BarSubItem>
</dxb:BarSubItem>
