<basetype:RangeBaseControl  x:Class="Meters.LinearMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:converters="clr-namespace:Meters.Converters" 
             xmlns:properties="clr-namespace:Meters.Properties" 
             xmlns:basetype="clr-namespace:RangeBaseControl;assembly=RangeBaseControl"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             FontSize="10" FontFamily="Segoe UI" FontWeight="Normal" FontStyle="Normal"
             mc:Ignorable="d">
    <basetype:RangeBaseControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </basetype:RangeBaseControl.Resources>
    <Grid x:Name="container"
          MinWidth="{Binding Path=MinControlVisibility,Mode=OneWay,Source={x:Static properties:Settings.Default}}"
          MinHeight="{Binding Path=MinControlVisibility,Mode=OneWay,Source={x:Static properties:Settings.Default}}">
    </Grid>
</basetype:RangeBaseControl>
