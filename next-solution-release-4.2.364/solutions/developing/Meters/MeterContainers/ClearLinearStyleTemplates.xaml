<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate  x:Key="ClearLinear_ForegroundTemplate">
        <Rectangle RenderTransformOrigin="0.5, 1" Fill="{Binding LevelFill, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"  
                   Margin="0.5,0,0.5,00" StrokeThickness="0" HorizontalAlignment="Center" Width="5.5" RadiusX="1" RadiusY="1"/>
    </ControlTemplate>
    <ControlTemplate  x:Key="ClearLinear_Template">
        <Viewbox  Width="6.025" Stretch="Fill" RenderTransformOrigin="0.5, 1"  Margin="{Binding LevelBackgroundMargin, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
          <Grid Height="15.149" RenderTransformOrigin="0.5,0.5" Width="15.103">
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="90"/>
                <TranslateTransform/>
              </TransformGroup>
            </Grid.RenderTransform>
            <Rectangle Stroke="{DynamicResource E_L_MetalTank1}" 
                       Fill="{Binding LevelBackgroundFill, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"/>
          </Grid>
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>
