<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox x:Key="ClearLinear_Vertical"   Stretch="Fill"  HorizontalAlignment="Left" VerticalAlignment="Top" Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
        <Canvas Height="15.467" Canvas.Left="-1.811" Canvas.Top="-2.502" Width="15.411" RenderTransformOrigin="0.5,0.5" >
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Height="15.467" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Stroke="{DynamicResource E_L_MetalTank1}" StrokeThickness="0.5" StrokeMiterLimit="10" StrokeLineJoin="Miter" Width="12.202" Canvas.Left="1.514"/>
            <Rectangle  Tag="Background" Height="14.462" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeThickness="0.5" StrokeMiterLimit="10" StrokeLineJoin="Miter" Width="11.198" Fill="{DynamicResource G_nuance07}" Canvas.Left="2.017" Canvas.Top="0.504"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="ClearLinear_Horizontal"  Stretch="Fill"   HorizontalAlignment="Left" VerticalAlignment="Top" Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
        <Canvas Height="18.163" Canvas.Left="-1.811" Canvas.Top="-2.502" Width="201.401" >
            <Rectangle Height="18.163" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Stroke="{DynamicResource E_L_MetalTank1}" StrokeThickness="0.5" StrokeMiterLimit="10" StrokeLineJoin="Miter" Width="156.305" Canvas.Left="20.754" Fill="{DynamicResource E_L_MetalTank1}"/>
            <Rectangle Tag="Background" Height="17.477" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeThickness="0.5" StrokeMiterLimit="10" StrokeLineJoin="Miter" Width="145.62" Fill="{DynamicResource G_nuance07}" Canvas.Left="26.768" Canvas.Top="0.343"/>
        </Canvas>
    </Viewbox>
</ResourceDictionary>