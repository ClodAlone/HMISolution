<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate  x:Key="EmptyBar_ForegroundTemplate">
        <Rectangle RenderTransformOrigin="0.5, 1" Fill="{Binding LevelFill, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"  Margin="0" StrokeThickness="0" HorizontalAlignment="Center" Width="6" RadiusX="0" RadiusY="0"/>
    </ControlTemplate>
    <ControlTemplate  x:Key="EmptyBar_Template">
        <Viewbox  Width="8"   Stretch="Fill" RenderTransformOrigin="0.5, 1"  Margin="0,-32">
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>
