<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate  x:Key="Termometer1_ForegroundTemplate">
    <Rectangle RenderTransformOrigin="0.5, 1" Fill="{Binding LevelFill, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
               Margin="0,-10"
               StrokeThickness="0" HorizontalAlignment="Center" Width="4" RadiusX="0" RadiusY="0"/>
  </ControlTemplate>
  <ControlTemplate  x:Key="Termometer1_Template">
    <Viewbox  Width="12"   Stretch="Fill" RenderTransformOrigin="0.5, 1"
              Margin="0,-10,0,-40">
      <Canvas Height="12.031" Width="11.951" RenderTransformOrigin="0.5,0.5">
        <Rectangle RadiusY="1" RadiusX="2" Fill="{Binding LevelBackgroundFill, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Height="11.275" Stretch="Fill" Width="3.905" Opacity="1" Canvas.Left="4.024"/>
        <Ellipse Height="3.87" Width="11.949" Fill="{Binding LevelFill, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Canvas.Left="0.002" Canvas.Top="8.098"/>
      </Canvas>
    </Viewbox>
  </ControlTemplate>
</ResourceDictionary>
