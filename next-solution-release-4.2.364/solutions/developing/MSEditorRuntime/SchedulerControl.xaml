<UserControl x:Class="SchedulerRTControl.SchedulerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:SchedulerRTControl.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             mc:Ignorable="d" Width="434" Height="337"
             d:DesignHeight="337" d:DesignWidth="434"
             xmlns:userlocal="clr-namespace:MSSchedulerSettings;assembly=MSSchedulerSettings"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:schedulerrtcontrol="clr-namespace:SchedulerRTControl"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" 
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             Foreground="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
             xmlns:controls="clr-namespace:MSSchedulerSettings.Controls;assembly=MSSchedulerSettings">
    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <userlocal:DateTimeToShortDateStringConverter x:Key="DateTimeConverter" />
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid x:Name="view">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView x:Name="flv" Visibility="Collapsed" />
        <TextBlock x:Name="txtNoDocument" Grid.Row="0" Text="{x:Static properties:Resources.SchedulerNoDocument}" 
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Grid Grid.Row="1" x:Name="GridContainer">
            <Grid x:Name="schedSelectionWeb" Visibility="Collapsed" Grid.ColumnSpan="3" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" x:Name="schedName" Text="{x:Static properties:Resources.SchedulerName}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!--<controls:WebListView Grid.ColumnSpan="2" Height="70" Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" 
            x:Name="listVariables" HorizontalAlignment="Stretch" SelectionChanged="cmbVariables_SelectionChanged"
            DisplayMemberPath="FullName" Grid.Row="1" />-->
                <wpfutilities:ComboWeb ItemPropertyName="FullName" Grid.ColumnSpan="2" 
            x:Name="listVariables" HorizontalAlignment="Stretch" SelectionChanged="cmbVariables_SelectionChanged"
            DisplayMemberPath="FullName" Grid.Row="1" />
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button x:Name="btnRefreshWeb" Click="btnRefresh_Click">
                        <!--Grid.Column="0" Grid.Row="2" -->
                        <Image Source="{DynamicResource RefreshSmall}" Height="16" Width="16" />
                    </Button>
                    <Button ToolTipService.ShowOnDisabled="True" x:Name="btnSaveWeb" ToolTip="{x:Static properties:Resources.SchedulerSave}" Click="btnSave_Click">
                        <!--Grid.Column="1" Grid.Row="2" -->
                        <Image x:Name="saveWeb" Source="{DynamicResource SaveSmall}" Height="16" Width="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="schedSelectionDesign" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="schedName1" Text="{x:Static properties:Resources.SchedulerName}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" 
                    x:Name="cmbVariables" HorizontalAlignment="Stretch" 
                    SelectionChanged="cmbVariables_SelectionChanged"
            		IsReadOnly="True" DisplayMemberPath="FullName" />
                <Button Grid.Column="2" ToolTipService.ShowOnDisabled="True" x:Name="btnRefresh" Click="btnRefresh_Click">
                    <Image x:Name="reload" Source="{DynamicResource RefreshSmall}" Height="16" Width="16" />
                </Button>
                <Button Grid.Column="3" ToolTipService.ShowOnDisabled="True" x:Name="btnSave" ToolTip="{x:Static properties:Resources.SchedulerSave}" 
                Click="btnSave_Click">
                    <Image x:Name="save" Source="{DynamicResource SaveSmall}" Height="16" Width="16" />
                </Button>
            </Grid>
        </Grid>
        <ContentControl Grid.Row="2" Name="gridEvent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <cc:CircularProgressBar Grid.RowSpan="3" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed" x:Name="busyControl" Opacity="0.3" />
        <wpfutilities:WebConfirmationDialog Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.RowSpan="10" Grid.ColumnSpan="10" x:Name="WebDialogUC" />
        <wpfutilities:WebConfirmationDialog Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.RowSpan="10" Grid.ColumnSpan="10" x:Name="WebDialogUC_Event" />
        <ContentControl x:Name="webPopupHost" Grid.RowSpan="10" Grid.ColumnSpan="10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>
