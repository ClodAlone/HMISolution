<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="ScreenParametersEditor.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultFileExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.xml</Value>
    </Setting>
    <Setting Name="TypeLabel" Type="System.String" Scope="Application">
      <Value Profile="(Default)">ScreenParameter</Value>
    </Setting>
    <Setting Name="MaxUndoRedoActions" Type="System.Int16" Scope="Application">
      <Value Profile="(Default)">50</Value>
    </Setting>
    <Setting Name="ImportExportAlias" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Alias</Value>
    </Setting>
    <Setting Name="ImportExportTag" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Tag</Value>
    </Setting>
    <Setting Name="SaveAsFileExtensions" Type="System.String" Scope="Application">
      <Value Profile="(Default)" />
    </Setting>
  </Settings>
</SettingsFile>