<ListBox x:Class="ComboBoxControls.OptionButtonControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:System="clr-namespace:System;assembly=mscorlib"
            mc:Ignorable="d" 
            Height="51" Width="130.5"
            IsSynchronizedWithCurrentItem="True"  SelectionChanged="listbox_SelectionChanged" 
    		IsTextSearchEnabled="False" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Single"
    		HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
    <ListBox.Resources>
        <ResourceDictionary>
            <Style x:Key="Option_ItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{Binding Foreground}"/>
                <Setter Property="FontSize" Value="{Binding FontSize}"/>
                <Setter Property="FontWeight" Value="{Binding FontWeight}"/>
                <Setter Property="FontFamily" Value="{Binding FontFamily}"/>
                <Setter Property="FontStyle" Value="{Binding FontStyle}"/>
                <Setter Property="SnapsToDevicePixels" Value="true"/>
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate x:Name="optionControlTemplate" TargetType="ListBoxItem">
                            <RadioButton IsThreeState="False"
                                        MinHeight="{Binding BulletDimension, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}, Mode=OneWay}"
                                        Height="{Binding OptionItemDimension, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}, Mode=OneWay}" 
                                        Click="radio_Click"
                                        x:Name="radio" Style="{DynamicResource OptionButtonStandardStyle}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                                        FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                                        FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                                        FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        GroupName="{Binding RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}, Mode=OneWay, Path=Name}" 
                                        >
                                <RadioButton.Content>
                            <ContentPresenter 
                                        Content="{Binding OptionContent}" 
                                        ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" 
                                        ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" 
                                        HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" 
                                        VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
                                        SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                        </RadioButton.Content>
                            </RadioButton>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
          <Style x:Key="Option_ItemStyleNew" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{Binding Foreground}"/>
            <Setter Property="FontSize" Value="{Binding FontSize}"/>
            <Setter Property="FontWeight" Value="{Binding FontWeight}"/>
            <Setter Property="FontFamily" Value="{Binding FontFamily}"/>
            <Setter Property="FontStyle" Value="{Binding FontStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate x:Name="optionControlTemplate" TargetType="ListBoxItem">
                  <RadioButton IsThreeState="False"
                              MinHeight="{Binding BulletDimension, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}, Mode=OneWay}"
                              Height="{Binding OptionItemDimension, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}, Mode=OneWay}"
                              Click="radio_Click"
                              x:Name="radio" Style="{DynamicResource OptionButtonStandardStyleNew}"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                              FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                              FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                              FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                              FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                              GroupName="{Binding RelativeSource={RelativeSource AncestorType=ListBox,Mode=FindAncestor}, Mode=OneWay, Path=Name}"
                                        >
                    <RadioButton.Content>
                      <ContentPresenter
                                  Content="{Binding OptionContent}"
                                  ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                  ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
                                  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                    </RadioButton.Content>
                  </RadioButton>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ResourceDictionary>
    </ListBox.Resources>
</ListBox>
