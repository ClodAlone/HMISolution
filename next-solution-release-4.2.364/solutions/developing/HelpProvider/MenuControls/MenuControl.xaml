<dxb:BarManager x:Class="HelpProvider.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:local="clr-namespace:HelpProvider"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:HelpProvider.Properties"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="HelpBarManager"
             mc:Ignorable="d">
  <dxb:BarManager.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/HelpProvider.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarManager.Resources>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="mainMenu"  dxb:BarNameScope.IsScopeOwner="True">
            <dxb:BarSubItemLink BarItemName="biHelpHelp" MergeType="MergeItems" MergeOrder="0"/>
        </dxb:Bar>
        <dxb:Bar Caption="{x:Static translatableMenu:Resources.MainToolBarTitle}" x:Name="helpMainToolBar" dxb:MergingProperties.Name="mainToolBar"
                             GlyphSize="Small" ShowDragWidget="False" 
                             AllowCustomizationMenu="False"
                             AllowDrop="False" 
                             AllowHide="False"
                             AllowCollapse="False"
                             AllowQuickCustomization="False">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True"  BarItemName="biCHelp"/>
            <dxb:BarCheckItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="rbLocalHelp"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biAboutBox"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
    <dxb:BarManager.Items>
        <!-- Help -->
        <dxb:BarSubItem x:Name="biHelpHelp" Content="{x:Static translatableMenu:Resources.HelpRibbonTitle}" MergeType="MergeItems">
          <dxb:BarButtonItem MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biCHelp" CategoryName="{x:Static properties:Resources.HelpRibbonHeader}" RibbonStyle="SmallWithText" 
                                   Command="ApplicationCommands.Help" Content="{x:Static appproperties:ApplicationCommandsResource.Help}" Glyph="{StaticResource HPHelp}"/>
          <dxb:BarCheckItem MergeOrder="30" ToolTipService.ShowOnDisabled="True" x:Name="rbLocalHelp" CategoryName="{x:Static properties:Resources.HelpRibbonHeader}" RibbonStyle="SmallWithText" 
                                  Command="{x:Static local:UIGeneralCommands.LocalHelp}" Content="{x:Static properties:Resources.LocalHelp}" Glyph="{StaticResource HPUseLocalHelp}"/>
            
            <dxb:BarItemLinkSeparator MergeOrder="35" />

          <dxb:BarButtonItem MergeOrder="999" ToolTipService.ShowOnDisabled="True" x:Name="biAboutBox" CategoryName="{x:Static properties:Resources.HelpRibbonHeader}" RibbonStyle="SmallWithText" 
                                   Command="{x:Static local:UIGeneralCommands.AboutBox}" Content="{x:Static properties:Resources.AboutRibbonTitle}" Glyph="{StaticResource HPAbout}"/>
        </dxb:BarSubItem>
    </dxb:BarManager.Items>
</dxb:BarManager>
