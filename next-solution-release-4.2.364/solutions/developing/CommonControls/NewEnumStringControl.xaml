<UserControl x:Class="CommonControls.NewEnumStringControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="300" 
             FocusManager.FocusedElement="{Binding ElementName=enumStringName}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <StackPanel Orientation="Vertical" >
                <TextBlock Text="{x:Static properties:Resources.NewEnumStringTitle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox Margin="5,10,5,10" x:Name="enumStringName" Height="200" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
