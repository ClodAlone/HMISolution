<UserControl x:Class="CommonControls.NewTransport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ms="http://namespaces.mindscape.co.nz/wpf"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:local="clr-namespace:UFUAEditor"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:c="clr-namespace:UFUAEditor.Controls"
             mc:Ignorable="d" 
             Height="310" Width="300"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\ResourceDictionary\DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:TransportList x:Key="TransListData"/>
            <converters:DivideDoubleByTwoConverter x:Key="DivideDoubleByTwoConverter" />
            <!--<DataTemplate x:Key="TransportEditor" DataType="String">
                <DockPanel>
                    <Button Tag="{Binding Value, Mode=TwoWay}" Click="EditTransport_Click" DockPanel.Dock="Right">...</Button>
                    <TextBlock Text="{Binding Value}" />
                </DockPanel>
            </DataTemplate>-->
            <DataTemplate x:Key="TranspCombo" DataType="String">
                <DockPanel>
                    <ComboBox x:Name="tcom" SelectedValue="{Binding Value}" ItemsSource="{Binding Source={StaticResource TransListData}}" />
                    
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.TraspName}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="comboTransport" ItemsSource="{Binding Source={StaticResource TransListData}}" 
                      Validation.ErrorTemplate="{x:Null}" SelectedValue="{Binding Path=Transport, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" Margin="0,4" SelectionChanged="comboTransport_SelectionChanged" />
                <ContentPresenter Grid.Column="2" Content="{Binding ElementName=comboTransport, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
            <ms:PropertyGrid Grid.Row="1" Name="propertyGridShadow" TreeViewItem.Expanded="OnPropertyGridNodeExpanded" 
                         SizeChanged="PropertyGrid_SizeChanged" IsVisibleChanged="PropertyGrid_VisibleChanged"
                         Grouping="{x:Static ms:PropertyGrouping.ByCategory}"
                         AllowModifyCollections="False"
                         IsToolBarVisible="True">
                <ms:PropertyGrid.Editors>
                    <ms:PropertyEditor PropertyName="Transport" EditorTemplate="{StaticResource TranspCombo}"  />
                </ms:PropertyGrid.Editors>
            </ms:PropertyGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
