<UserControl x:Class="CommonControls.PropertyDataTemplate.ConnectionSourcePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CommonControls.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ConnectionStringConverter x:Key="ConnectionStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Click="DlgButton_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="connection"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="connectionlabel" IsReadOnly="False" Validation.ErrorTemplate="{x:Null}">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource ConnectionStringConverter}" UpdateSourceTrigger="LostFocus" StringFormat="X8">
                        <Binding Path="Value" Mode="TwoWay" ValidatesOnDataErrors="True" />
                        <Binding Path="Workspace" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </DockPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding ElementName=connectionlabel, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
