<UserControl x:Class="CommonControls.SQLiteConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:local="clr-namespace:CommonControls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Padding="12">
        <StackPanel>
            <TextBlock Width="500" FontSize="13" Name="tbDescription" TextWrapping="Wrap" Margin="0,0,0,32" />
            <Grid Name="DBSettings" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Name="label2" Content="{x:Static properties:Resources.lblDatabase}" />
                <TextBox Grid.Column="2" Grid.Row="0" Name="tbDatabase" IsEnabled="True"/>
                <Button Grid.Row="0" Grid.Column="3" Click="Button_Click">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Label Grid.Column="0" Grid.Row="2" Name="label7" Content="{x:Static properties:Resources.lblPassword}" />
                <dxe:PasswordBoxEdit Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2" Name="tbPassword" IsEnabled="True" />
                <Label Grid.Column="0" Grid.Row="4" Name="label8" Content="{x:Static properties:Resources.SQLiteDateTimeKind}" />
                <dxe:ComboBoxEdit Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2" Name="cbDateTimeKind" IsEnabled="True" IsTextEditable="False">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EnumItemsSourceBehavior EnumType="{x:Type local:SQLiteDateTimeKind}" />
                    </dxmvvm:Interaction.Behaviors>
                </dxe:ComboBoxEdit>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
