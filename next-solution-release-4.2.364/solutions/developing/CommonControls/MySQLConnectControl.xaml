<UserControl x:Class="CommonControls.MySQLConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:local="clr-namespace:CommonControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d">
    <Border Padding="12">
        <StackPanel>
            <TextBlock Width="500" FontSize="13" Name="tbDescription" TextWrapping="Wrap" Margin="0,0,0,32" />
            <Grid Name="DBSettings" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Name="label1" Content="{x:Static properties:Resources.lblMySQLServer}"/>
                <!--<ComboBox Grid.Column="2" Grid.Row="0" Name="tbServer" Text="" 
                          DropDownOpened="tbServer_PopupOpening" IsEditable="True" 
                          SelectionChanged="tbServer_SelectionChanged" 
                          TextBoxBase.TextChanged="tbServer_TextChanged" />-->
                <TextBox Grid.Column="2" Grid.Row="0" Name="tbServer" IsEnabled="True"/>
                <Label Grid.Column="0" Grid.Row="2" Name="label2" Content="{x:Static properties:Resources.lblDatabase}" />
                <!--<ComboBox Grid.Column="2" Grid.Row="2" Name="cbDatabase" DropDownOpened="cbDatabase_PopupOpening" IsEditable="True" />-->
                <TextBox Grid.Column="2" Grid.Row="2" Name="tbDatabase" IsEnabled="True"/>
                <Label Grid.Column="0" Grid.Row="4" Name="label6" Content="{x:Static properties:Resources.lblLogin}" />
                <TextBox Grid.Column="2" Grid.Row="4" Name="tbLogin" IsEnabled="True"/>
                <Label Grid.Column="0" Grid.Row="6" Name="label7" Content="{x:Static properties:Resources.lblPassword}" />
                <dxe:PasswordBoxEdit Grid.Column="2" Grid.Row="6" Name="tbPassword" IsEnabled="True" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
