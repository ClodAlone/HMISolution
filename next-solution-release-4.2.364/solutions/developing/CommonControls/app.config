<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="CommonControls.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <CommonControls.Properties.Settings>
            <setting name="lblSQLAzurePrefix" serializeAs="String">
                <value>tcp:</value>
            </setting>
            <setting name="lblSQLAzureSuffix" serializeAs="String">
                <value>.database.windows.net</value>
            </setting>
            <setting name="SQLiteFileType" serializeAs="String">
                <value>SQLite Databases (*.db;*.sqlite)|*.db;*.sqlite|All Files (*.*)|*.*</value>
            </setting>
        </CommonControls.Properties.Settings>
    </applicationSettings>
</configuration>