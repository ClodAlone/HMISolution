<UserControl x:Class="CommonControls.SQLConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="500">
    <Border Padding="12">
        <StackPanel>
            <TextBlock Width="500" FontSize="13" Name="tbDescription" TextWrapping="Wrap" Margin="0,0,0,32" />
            <Grid Name="DBSettings" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Name="label1" Content="{x:Static properties:Resources.lblSQLServer}" />
                <ComboBox Grid.Column="2" Grid.Row="0" Name="tbServer" Text="(local)\SQLEXPRESS" DropDownOpened="tbServer_PopupOpening" 
                          IsEditable="True" SelectionChanged="tbServer_SelectionChanged" 
                          TextBoxBase.TextChanged="tbServer_TextChanged"/>
                <Label Grid.Column="0" Grid.Row="2" Name="label2" Content="{x:Static properties:Resources.lblDatabase}" />
                <ComboBox Grid.Column="2" Grid.Row="2" Name="cbDatabase" DropDownOpened="cbDatabase_PopupOpening" IsEditable="True" />
                <Label Grid.Column="0" Grid.Row="4" Name="label6" Content="{x:Static properties:Resources.lblLogin}"/>
                <TextBox Grid.Column="2" Grid.Row="4" Text="sa" Name="tbLogin" IsEnabled="True"/>
                <Label Grid.Column="0" Grid.Row="6" Name="label7" Content="{x:Static properties:Resources.lblPassword}"/>
                <dxe:PasswordBoxEdit Grid.Column="2" Grid.Row="6" Name="tbPassword" IsEnabled="True"/>
                <StackPanel Orientation="Vertical" Grid.Row="8" Grid.Column="2" HorizontalAlignment="Left">
                    <RadioButton Name="rbWindowsAuthentication" IsChecked="True" Margin="0,0,0,4" GroupName="AutentificationGroup" Content="{x:Static properties:Resources.lblWinAuth}" />
                    <RadioButton Name="rbSQLServerAuthentication" GroupName="AutentificationGroup" Content="{x:Static properties:Resources.lblSQLAuth}"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,24">
                <!--<Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0" Grid.Row="0" Name="label6">Login name:</Label>
                    <TextBox Grid.Column="2" Grid.Row="0" Text="sa" Name="tbLogin" IsEnabled="True"/>
                    <Label Grid.Column="0" Grid.Row="2" Name="label7">Password:</Label>
                    <TextBox Grid.Column="2" Grid.Row="2" Name="tbPassword" IsEnabled="True"/>
                </Grid>-->
                <!--<GroupBox Name="stackPanel1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0">
                    <StackPanel Orientation="Vertical">
                        <RadioButton Name="rbWindowsAuthentication" IsChecked="True" Margin="0,0,0,4" GroupName="AutentificationGroup">Windows authentication</RadioButton>
                        <RadioButton Name="rbSQLServerAuthentication" GroupName="AutentificationGroup">SQL Server authentication</RadioButton>
                    </StackPanel>
                </GroupBox>-->

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
