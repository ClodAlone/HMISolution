<UserControl x:Class="CommonControls.CustomPopupColorEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxei="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFUtilities;component/Resources/ColorPopupTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BrushToNameConverter x:Key="BrushNameConverter" />
            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <dxe:PopupColorEdit x:Name="colorEdit" DisplayMode="Color"
                            Color="{Binding Color, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                            DefaultColor="Transparent" ShowNoColorButton="True" ShowDefaultColorButton="True" />
        <Grid IsHitTestVisible="False" Visibility="Collapsed" x:Name="brushSelection">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Margin="4,0,3,0" BorderBrush="LightGray" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="PART_Brush_Color">
                <Grid>
                    <dxei:TransparentBrushRectangle dx:FocusHelper2.Focusable="False" BlockWidth="4" BlockHeight="4"/>
                    <Rectangle Height="12" Width="12" Stretch="Fill" Fill="{Binding SelectedBrush, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" SnapsToDevicePixels="true" />
                </Grid>
            </Border>
            <TextBlock x:Name="PART_Brush_Editor" VerticalAlignment="Center" Grid.Column="1" Style="{DynamicResource {dxet:PopupColorEditThemeKey ResourceKey=PART_EditorStyle}}" Text="{Binding SelectedBrush, Mode=OneWay, Converter={StaticResource BrushNameConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
        </Grid>

        <Grid IsHitTestVisible="False"  x:Name="colorSelection">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Margin="4,0,3,0" BorderBrush="LightGray" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                  x:Name="PART_Color">
            <Grid>
              <dxei:TransparentBrushRectangle dx:FocusHelper2.Focusable="False" BlockWidth="4" BlockHeight="4"/>
              <Rectangle Height="12" Width="12" Stretch="Fill"
                         Fill="{Binding Color, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}, 
                         RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" SnapsToDevicePixels="true" />
            </Grid>
          </Border>
          <TextBlock x:Name="PART_Editor" VerticalAlignment="Center" Grid.Column="1" Style="{DynamicResource {dxet:PopupColorEditThemeKey ResourceKey=PART_EditorStyle}}"
                     Text="{Binding Color, Mode=OneWay, Converter={StaticResource BrushNameConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
        </Grid>
    </Grid>
</UserControl>
    
