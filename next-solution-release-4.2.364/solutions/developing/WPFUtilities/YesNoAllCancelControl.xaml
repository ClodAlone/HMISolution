<UserControl x:Class="WPFUtilities.YesNoAllCancelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             mc:Ignorable="d" 
             Height="150" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Margin="15" Grid.Row="0" x:Name="lblControlText" LineHeight="Auto" TextAlignment="Center" TextWrapping="Wrap"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Name="btnYes" Content="{x:Static properties:Resources.LabelYes}" Click="Yes_Click"></Button>
            <Button Grid.Row="0" Grid.Column="1" Name="btnYesAll" Content="{x:Static properties:Resources.LabelYesAll}" Click="YesAll_Click"></Button>
            <Button Grid.Row="0" Grid.Column="2" Name="btnNo" Content="{x:Static properties:Resources.LabelNo}" Click="No_Click"></Button>
            <Button Grid.Row="0" Grid.Column="3" Name="btnNoAll" Content="{x:Static properties:Resources.LabelNoAll}" Click="NoAll_Click"></Button>
            <Button Grid.Row="0" Grid.Column="4" Name="btnCancel" Content="{x:Static properties:Resources.LabelCancel}" Click="Cancel_Click"></Button>
        </Grid>
    </Grid>
</UserControl>
