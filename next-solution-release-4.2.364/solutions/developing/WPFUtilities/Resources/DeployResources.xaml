<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
                    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
                    xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
                    xmlns:dxct="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys">
    <Border x:Key="editArea"
        BorderBrush="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
        Background="{dxi:ThemeResource {dxct:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}" />
    <Border x:Key="plotArea"
          BorderBrush="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
          Background="{dxi:ThemeResource {dxct:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}" />
    <Border x:Key="headerContent"
          BorderBrush="{dxi:ThemeResource {dxt:GridColumnHeaderThemeKey ResourceKey=HeaderCaptionForeground}}"
          Background="{dxi:ThemeResource {dxt:GridColumnHeaderThemeKey ResourceKey=Background}}" />
    <Border x:Key="rowContent"
          BorderBrush="{dxi:ThemeResource {dxt:GridRowThemeKey ResourceKey=GridDataRowDelimiterBrush}}"
          Background="{dxi:ThemeResource {dxt:GridColumnHeaderThemeKey ResourceKey=Background}}" />

</ResourceDictionary>