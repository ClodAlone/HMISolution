                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level23}" Name="Level23" Margin="5"
                      IsChecked="{Binding Path=Value,
                                    Converter={StaticResource BitMaskConverter},
                                    ConverterParameter={x:Static local:BitMask.Level23}}"/>
                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level24}" Name="Level24" Margin="5"
                      IsChecked="{Binding Path=Value,
