                                    ConverterParameter={x:Static local:BitMask.Level30}}"/>
                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level31}" Name="Level31" Margin="5"
                      IsChecked="{Binding Path=Value,
                                    Converter={StaticResource BitMaskConverter},
                                    ConverterParameter={x:Static local:BitMask.Level31}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
