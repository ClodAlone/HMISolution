                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level26}" Name="Level26" Margin="5"
                      IsChecked="{Binding Path=Value,
                                    Converter={StaticResource BitMaskConverter},
                                    ConverterParameter={x:Static local:BitMask.Level26}}"/>
                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level27}" Name="Level27" Margin="5"
                      IsChecked="{Binding Path=Value,
                                    Converter={StaticResource BitMaskConverter},
                                    ConverterParameter={x:Static local:BitMask.Level27}}"/>
                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level28}" Name="Level28" Margin="5"
                      IsChecked="{Binding Path=Value,
                                    Converter={StaticResource BitMaskConverter},
                                    ConverterParameter={x:Static local:BitMask.Level28}}"/>
                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level29}" Name="Level29" Margin="5"
