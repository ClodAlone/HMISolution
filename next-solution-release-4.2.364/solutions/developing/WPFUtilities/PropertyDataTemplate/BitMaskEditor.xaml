                                    ConverterParameter={x:Static local:BitMask.Level12}}"/>
                <CheckBox Style="{StaticResource comboStyle}" Content="{x:Static properties:Resources.Level13}" Name="Level13" Margin="5"
                      IsChecked="{Binding Path=Value,
