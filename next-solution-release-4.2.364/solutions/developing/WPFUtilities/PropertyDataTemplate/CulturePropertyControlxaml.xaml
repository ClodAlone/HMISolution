<UserControl x:Class="WPFUtilities.PropertyDataTemplate.CulturePropertyControlxaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!--<ComboBox x:Name="cmbCultures" 
                  DropDownOpened="cmbCultures_DropDownOpened"
                  IsTextSearchEnabled="True" IsEditable="False"
                  SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                  Validation.ErrorTemplate="{x:Null}"/>-->
        <DockPanel>
            <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <dxe:ComboBoxEdit
                        x:Name="cmbCultures" IsTextEditable="False"
                        PopupOpening="cmbCultures_PopupOpening"
                        Text="{Binding Path=Tag,ElementName=uriButton, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" 
                        SelectedIndexChanged="cmbCultures_SelectedIndexChanged"
                        ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"/>
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=uriButton, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
