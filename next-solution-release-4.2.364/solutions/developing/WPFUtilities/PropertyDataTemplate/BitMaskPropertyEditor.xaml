<UserControl x:Class="WPFUtilities.PropertyDataTemplate.BitMaskPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:WPFUtilities.Converters"             
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:AccessMaskConverter x:Key="AccessMaskConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Button x:Name="bitmask"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <TextBox x:Name="text" IsReadOnly="False" Text="{Binding Path=Tag, ElementName=bitmask, UpdateSourceTrigger=LostFocus, StringFormat=X8, Converter={StaticResource AccessMaskConverter}}" />
    </DockPanel>
</UserControl>
