<UserControl x:Class="WPFUtilities.PropertyDataTemplate.TimeSpanPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFUtilities.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <local:TimeSpanEdit x:Name="timeSpanControl" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            TimeSpan="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                            Mask="{Binding Path=TimeSpanFormat, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                            Validation.ErrorTemplate="{x:Null}" 
                            ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />
        <ContentPresenter Grid.Column="1" 
            Content="{Binding ElementName=timeSpanControl, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
