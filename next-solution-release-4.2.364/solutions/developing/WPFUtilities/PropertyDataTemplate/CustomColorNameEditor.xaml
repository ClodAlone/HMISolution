<UserControl x:Class="WPFUtilities.PropertyDataTemplate.CustomColorNameEditor"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             Width="300" Height="110"
             d:DesignHeight="110" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.ColorName}" Grid.Column="1" Grid.Row="1" />
        <TextBox x:Name="textbox_colorName" Grid.Column="2" Grid.Row="1" />
        <Grid Grid.ColumnSpan="13" Margin="10,15,10,5" Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OkButton" Content="{x:Static properties:Resources.LabelOk}" Grid.Column="1" />
            <Button x:Name="CancelButton" Content="{x:Static properties:Resources.LabelCancel}" Grid.Column="3" />
        </Grid>
    </Grid>
</UserControl>
