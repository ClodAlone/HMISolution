<UserControl x:Class="WPFUtilities.PropertyDataTemplate.UConverterPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click_Clear">
            <Button.Content>
                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Button x:Name="uri"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <TextBox x:Name="text" IsReadOnly="False" Text="{Binding Path=Tag, ElementName=uri, UpdateSourceTrigger=PropertyChanged}" 
                 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}" />
    </DockPanel>
</UserControl>
