<wpfutilities:BarManagerBase
    xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities" x:Class="LogicManager.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:go="http://schemas.nwoods.com/GoXam"
             xmlns:self="clr-namespace:LogicManager"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="LogicBarManager"
             xmlns:properties="clr-namespace:LogicManager.Properties"
             mc:Ignorable="d">
    <dxb:BarManager.CommandBindings>
        <CommandBinding Command="{x:Static self:UIGeneralCommands.ShowToolbar}" 
                    Executed="OnShowToolbar" 
                    CanExecute="CanAlwaysExecute" />
    </dxb:BarManager.CommandBindings>
    <dxb:BarManager.Resources>
        <DataTemplate x:Key="paletteDataTemplate">
            <go:Palette Padding="1">
                <go:Diagram.Layout>
                    <go:GridLayout CellSize="10 10" Spacing="10 10" Sorting="Forward"/>
                </go:Diagram.Layout>
            </go:Palette>
        </DataTemplate>
    </dxb:BarManager.Resources>
    <dxb:BarManager.Items>
        <self:BarCommonItems x:Name="menuItems" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}" />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="logicMenu">
            <dxb:BarSubItemLink BarItemName="biViewLogic" MergeType="MergeItems"/>
            <dxb:BarSubItemLink BarItemName="biProjectLogic" MergeType="MergeItems"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</wpfutilities:BarManagerBase>
