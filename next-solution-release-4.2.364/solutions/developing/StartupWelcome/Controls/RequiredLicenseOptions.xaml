<UserControl x:Class="StartupWelcome.Controls.RequiredLicenseOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StartupWelcome.Controls"
             mc:Ignorable="d" Height="480" Width="640"
             d:DesignHeight="480" d:DesignWidth="640">

    <UserControl.Resources>
        <local:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        <local:StringToIntegerConverter x:Key="StringToIntegerConverter" />
        
        <DataTemplate x:Key="BooleanTemplate">
            <CheckBox IsChecked="{Binding Converter={StaticResource StringToBooleanConverter}, Mode=OneWay}" IsEnabled="False" />
        </DataTemplate>
        <DataTemplate x:Key="NumberTemplate">
            <TextBox Text="{Binding Converter={StaticResource StringToIntegerConverter}, Mode=OneWay}" IsReadOnly="True" />
        </DataTemplate>
        <DataTemplate x:Key="DescriptionTemplate">
            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" />
        </DataTemplate>

        <local:OptionTemplateSelector x:Key="OptionTemplateSelector"
                                      BooleanTemplate="{StaticResource BooleanTemplate}"
                                      NumberTemplate="{StaticResource NumberTemplate}"
                                      DescriptionTemplate="{StaticResource DescriptionTemplate}" />

        <DataTemplate x:Key="DefaultDataTemplate">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding Path=Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" />
                <ListView ItemsSource="{Binding Path=Values, Mode=OneWay}" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="5,0,5,0" Text="{Binding Path=Key}" />
                                    <ContentControl Margin="5,0,5,0" Grid.Column="1" Content="{Binding Path=Value}"
                                                    ContentTemplateSelector="{StaticResource OptionTemplateSelector}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <ListView ItemsSource="{Binding Options, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                  ItemTemplate="{StaticResource DefaultDataTemplate}"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </StackPanel>
</UserControl>
