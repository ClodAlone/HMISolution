<dxb:BarManager x:Class="StartupWelcome.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:local="clr-namespace:StartupWelcome"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:StartupWelcome.Properties"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="StartupBarManager"
             mc:Ignorable="d">
  <dxb:BarManager.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/StartupWelcome.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarManager.Resources>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="startupMenu">
            <dxb:BarSubItemLink BarItemName="biFileStartup" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="biOptionsStartup" MergeType="MergeItems" />
        </dxb:Bar>
        <dxb:Bar Caption="{x:Static translatableMenu:Resources.MainToolBarTitle}" x:Name="startupMainToolBar" dxb:MergingProperties.Name="mainToolBar"
                             GlyphSize="Small" ShowDragWidget="True" 
                             AllowCustomizationMenu="True"
                             AllowDrop="True" 
                             AllowHide="True"
                             AllowCollapse="True"
                             AllowQuickCustomization="True">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" MergeOrder="0" BarItemName="biNew"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" MergeOrder="1" BarItemName="biOpen"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" MergeOrder="2" BarItemName="biOpenDB" />
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" MergeOrder="4" BarItemName="biStartUp"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" MergeOrder="5" BarItemName="biGetKey"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" MergeOrder="6" BarItemName="biDongleOptions"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" MergeOrder="7" BarItemName="biDongleRequired"/>
            <!--<dxb:BarItemLinkSeparator />-->
        </dxb:Bar>
    </dxb:BarManager.Bars>
    <dxb:BarManager.Items>
        <!-- File -->
        <dxb:BarSubItem x:Name="biFileStartup" Content="{x:Static translatableMenu:Resources.FileRibbonTitle}" MergeType="MergeItems">
            <!-- Quick Commands-->
            <dxb:BarButtonItem  MergeOrder="0" ToolTipService.ShowOnDisabled="True" x:Name="biNew" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}" 
                                   RibbonStyle="Default" Command="ApplicationCommands.New" 
                                   Content="{x:Static appproperties:ApplicationCommandsResource.New}" Glyph="{StaticResource SWNew}"/>
            <dxb:BarButtonItem  MergeOrder="10" ToolTipService.ShowOnDisabled="True" x:Name="biOpen" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}" 
                                   RibbonStyle="Default" Command="ApplicationCommands.Open"
                                   Content="{x:Static properties:Resources.OpenProject}" Glyph="{StaticResource OpenFolderSmall}"/>
            <dxb:BarButtonItem  MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biOpenDB" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}"
                                 RibbonStyle="Default" Command="ApplicationCommands.Open" CommandParameter="DB"
                                 Content="{x:Static properties:Resources.OpenDBProject}" Glyph="{StaticResource DataSmall}"/>
          <!-- Startup -->
            <dxb:BarButtonItem MergeOrder="30" ToolTipService.ShowOnDisabled="True" x:Name="biStartUp" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.StartUpPage}" 
                                   Content="{x:Static properties:UICommandResource.StartupPageText}" Glyph="{StaticResource SWStartUpWelcome}"/>
            <dxb:BarItemLinkSeparator MergeOrder="35" />
          <!-- Recent projects -->
          <dxb:BarItemLinkSeparator MergeOrder="105" />
          <dxb:BarSubItem MergeOrder="110" x:Name="recentProjects" Content="{x:Static properties:Resources.RecentMenuHeader}"
                          MergeType="MergeItems" Popup="recentProjects_Popup">
          </dxb:BarSubItem>
          <!-- Workspace config -->
            <dxb:BarItemLinkSeparator MergeOrder="115" />
            <dxb:BarSubItem MergeOrder="120" Content="{x:Static properties:Resources.WorkspaceMenuHeader}" MergeType="MergeItems">
                <dxb:BarCheckItem x:Name="useLayoutToFile" CloseSubMenuOnClick="False" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}" 
                                RibbonStyle="SmallWithText" Content="{x:Static properties:UICommandResource.UseLayoutToFileText}" 
                                Command="{x:Static local:UIGeneralCommands.UseLayoutToFile}" />
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="loadLayout" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.ManageLayouts}" IsEnabled="{Binding IsEnabled, ElementName=useLayoutToFile}" CommandParameter="Load"
                                   Content="{x:Static properties:UICommandResource.LoadLayoutText}" Glyph="{StaticResource OpenSmall}"/>
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="saveLayout" CategoryName="{x:Static translatableMenu:Resources.FileRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.ManageLayouts}" IsEnabled="{Binding IsEnabled, ElementName=useLayoutToFile}" CommandParameter="Save"
                                   Content="{x:Static properties:UICommandResource.SaveLayoutText}" Glyph="{StaticResource SaveSmall}"/>
            </dxb:BarSubItem>
        </dxb:BarSubItem>
        <!-- License (Dongle) -->
        <dxb:BarSubItem x:Name="biOptionsStartup" Content="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" MergeType="MergeItems">
            <!--<dxb:BarSubItem.Resources>
                <Style TargetType="{x:Type dxb:BarSubItemLinkControl}">
                    <Setter Property="Height" Value="0" />
                </Style>
            </dxb:BarSubItem.Resources>-->
            <dxb:BarSubItem MergeOrder="50" x:Name="biOptionsDeployServer" Content="{x:Static properties:Resources.DeployServerRibbonTitle}" MergeType="MergeItems">
              <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biDeployServerService" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}"
                                         RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.DeployServerService}"
                                         Content="{x:Static properties:UICommandResource.DeployServerServiceText}" Glyph="{StaticResource SWDeployServerService}"/>
            </dxb:BarSubItem>
            <dxb:BarItemSeparator MergeOrder="55" />
            <dxb:BarSubItem MergeOrder="60" x:Name="biOptionsLicense" Content="{x:Static properties:Resources.LicenseRibbonTitle}" MergeType="MergeItems">
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biGetKey" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}"
                                           RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.GetKey}" 
                                           Content="{x:Static  properties:UICommandResource.GetKeyText}" Glyph="{StaticResource SWDongleSettings}"/>
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biDongleOptions" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}"
                                           RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.DongleOptions}" 
                                           Content="{x:Static properties:UICommandResource.DongleOptionsText}" Glyph="{StaticResource SWDongleOptions}"/>
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biDongleRequired" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}"
                                           RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.DongleRequired}" 
                                           Content="{x:Static properties:UICommandResource.DongleRequiredText}" Glyph="{StaticResource SWDongleRequired}"/>
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biDongleService" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}"
                                           RibbonStyle="SmallWithText" Command="{x:Static local:UIGeneralCommands.DongleService}" 
                                           Content="{x:Static properties:UICommandResource.DongleServiceText}" Glyph="{StaticResource SWDongleService}"/>
            </dxb:BarSubItem>
            <dxb:BarItemSeparator MergeOrder="65" />
        </dxb:BarSubItem>
    </dxb:BarManager.Items>
</dxb:BarManager>
