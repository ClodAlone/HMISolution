<UserControl x:Class="CommandExplorer.CommandEditorUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="300" Width="500" x:Name="control" DataContextChanged="control_DataContextChanged" Unloaded="control_Unloaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
        <ContentControl x:Name="left"/>
        <ContentControl x:Name="right" Grid.Column="2"/>
    </Grid>

</UserControl>
