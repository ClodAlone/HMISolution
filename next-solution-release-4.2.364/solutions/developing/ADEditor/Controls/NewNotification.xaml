<UserControl x:Class="ADEditor.Controls.NewNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:ADEditor"
             xmlns:properties="clr-namespace:ADEditor.Properties"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:templates="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             xmlns:common="clr-namespace:ADEditor.PropertyDataTemplate"
             xmlns:wpfc="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:wpfconverters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" Width="300" Height="400"
             x:Name="NewNotificationUserControl"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <wpfconverters:EditValueToBrushConverter x:Key="EditValueToBrushConverter" />
            <self:AttachmentsVisibilityConverter x:Key="AttachmentsVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewNotificationTitle}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewNotificationType}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" Grid.Row="1" SelectedValue="{Binding NotificationType}" x:Name="comboNotificationType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboNotificationType_SelectionChanged" />

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewNotificationName}" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.Column="2">
                <templates:TextPropertyEditor BindingPath="Name" 
                                              Workspace="{Binding Workspace, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
            </Grid>

            <TextBlock Grid.Row="3" x:Name="txtAlarmName" Text="{x:Static properties:Resources.NewNotificationAlarmName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding AlarmName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditAlarmName" IsReadOnly="True" />
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=textEditAlarmName, Path=(Validation.Errors).CurrentItem}"/>


            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewNotificationMessage}" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Grid.Column="2">
                <templates:TextPropertyEditor BindingPath="Message" 
                                              Workspace="{Binding Workspace, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
            </Grid>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.NewNotificationRecipient}" VerticalAlignment="Center" />
            <Grid Grid.Row="5" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Recipient, ValidatesOnDataErrors=True, UpdateSourceTrigger=LostFocus}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditRecipient" IsReadOnly="True" />
                <Button Grid.Column="1" Name="btnRecipient" Click="btnRecipient_Click">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="btnRecipient_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <ContentPresenter Grid.Row="5" Grid.Column="3" 
            Content="{Binding ElementName=textEditRecipient, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.NewNotificationTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="6" Grid.Column="2">
                <common:NotificationItemPropertyEditor x:Name="textEditItem"  />
                <common:TextBoxNotificationItemPropertyEditor x:Name="textBoxEditItem"  />
            </Grid>
            <ContentPresenter Grid.Row="6" Grid.Column="3" 
                              Content="{Binding ElementName=textEditItem, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.PluginAssociation}" VerticalAlignment="Center" />
            <Grid Grid.Row="7" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding PluginName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditPlugin" IsReadOnly="True" />
                <Button Grid.Column="1" Name="btnAddPlugin" Click="btnAddPlugin_Click">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="btnAddPlugin_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <ContentPresenter Grid.Row="7" Grid.Column="3" 
            Content="{Binding ElementName=textEditPlugin, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.Attachments}" VerticalAlignment="Center"
                   Visibility="{Binding PluginName, Converter={StaticResource AttachmentsVisibilityConverter}, Mode=OneWay}"/>
            <Grid Grid.Row="8" Grid.Column="2"
              Visibility="{Binding PluginName, Converter={StaticResource AttachmentsVisibilityConverter}, Mode=OneWay}" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Attachments, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditAttachments" />
                <Button Grid.Column="1" Name="btnAddAttach" Click="btnAddAttach_Click">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="btnAddAttach_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>


            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.NewNotificationPriority}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" Grid.Row="9" SelectedValue="{Binding Priority}" x:Name="comboPriority" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />

            <TextBlock Grid.Row="10" x:Name="txtAlarmType" Text="{x:Static properties:Resources.NewNotificationAlarmType}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" Grid.Row="10" SelectedValue="{Binding AlarmType}" x:Name="comboAlarmType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboAlarmType_SelectionChanged" />

            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.NewNotificationCondition}" VerticalAlignment="Center" x:Name="textConditionType"/>
            <ComboBox Grid.Column="2" Grid.Row="11" SelectedValue="{Binding ConditionType}" x:Name="comboConditionType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />

            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.NewNotificationValue}" VerticalAlignment="Center" x:Name="textBlockActivationValue"/>
            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.NewNotificationSetPointValue}" VerticalAlignment="Center" x:Name="textBlockSetPointValue" Visibility="Collapsed"/>

            <dxe:SpinEdit Grid.Column="2" Grid.Row="12" MaskType="Numeric" Mask="#########.00" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Double}" Name="textActivationValue" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding ActivationValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                <dxe:SpinEdit.Foreground>
                    <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                        <Binding Path="ActivationValue" />
                        <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                    </MultiBinding>
                </dxe:SpinEdit.Foreground>
            </dxe:SpinEdit>
            <ContentPresenter Grid.Row="12" Grid.Column="3" 
            Content="{Binding ElementName=textActivationValue, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.DeviationType}" VerticalAlignment="Center" x:Name="textDeviationType"/>
            <ComboBox Grid.Column="2" Grid.Row="14" SelectedValue="{Binding DeviationType}" x:Name="comboDeviationType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False"
                  SelectionChanged="comboDeviationType_SelectionChanged"/>

            <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.HHLimit}" VerticalAlignment="Center" x:Name="textBlockHighHighLimit"/>
            <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.HHLevel}" VerticalAlignment="Center" x:Name="textBlockHighHighLevel" Visibility="Collapsed"/>
            <Grid Grid.Row="15" Grid.Column="2" Name="gridHighHighLimit">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkHighHighLimit" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableHighHighLimit, UpdateSourceTrigger=PropertyChanged}" />
                <dxe:SpinEdit HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=IsChecked, ElementName=checkHighHighLimit}" Grid.Column="2" MaskType="Numeric" Mask="#########.00" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Double}" Name="textHighHighLimit" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding HighHighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:SpinEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="HighHighLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:SpinEdit.Foreground>
                </dxe:SpinEdit>
                <!-- Percent limit is hidden by default -->
                <dxe:TextEdit Height="25" Grid.Column="2" Mask="P2" MaskUseAsDisplayFormat="True" MaskType="Numeric" Name="textHighHighPercentLimit" Visibility="Collapsed" IsEnabled="{Binding Path=IsChecked, ElementName=checkHighHighLimit}" EditValue="{Binding HighHighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:TextEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="HighHighLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:TextEdit.Foreground>
                </dxe:TextEdit>
            </Grid>
            <ContentPresenter Grid.Row="15" Grid.Column="3" 
            Content="{Binding ElementName=textHighHighLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.HLimit}" VerticalAlignment="Center" x:Name="textBlockHighLimit"/>
            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.HLevel}" VerticalAlignment="Center" x:Name="textBlockHighLevel" Visibility="Collapsed"/>
            <Grid Grid.Row="16" Grid.Column="2" Name="gridHighLimit">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkHighLimit" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableHighLimit, UpdateSourceTrigger=PropertyChanged}" />
                <dxe:SpinEdit HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=IsChecked, ElementName=checkHighLimit}" Grid.Column="2" MaskType="Numeric" Mask="#########.00" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Double}" Name="textHighLimit" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding HighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:SpinEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="HighLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:SpinEdit.Foreground>
                </dxe:SpinEdit>
                <!-- Percent limit is hidden by default -->
                <dxe:TextEdit Height="25" Grid.Column="2" Mask="P2" MaskUseAsDisplayFormat="True" MaskType="Numeric" Name="textHighPercentLimit" Visibility="Collapsed" IsEnabled="{Binding Path=IsChecked, ElementName=checkHighLimit}"
                                    EditValue="{Binding HighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:TextEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="HighLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:TextEdit.Foreground>
                </dxe:TextEdit>
            </Grid>
            <ContentPresenter Grid.Row="16" Grid.Column="3" 
            Content="{Binding ElementName=textHighLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="17" Text="{x:Static properties:Resources.LLimit}" VerticalAlignment="Center" x:Name="textBlockLowLimit"/>
            <TextBlock Grid.Row="17" Text="{x:Static properties:Resources.LLevel}" VerticalAlignment="Center" x:Name="textBlockLowLevel" Visibility="Collapsed"/>
            <Grid Grid.Column="2" Grid.Row="17" Name="gridLowLimit">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkLowLimit" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableLowLimit, UpdateSourceTrigger=PropertyChanged}" />
                <dxe:SpinEdit HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLimit}" Grid.Column="2" MaskType="Numeric" Mask="#########.00" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Double}" Name="textLowLimit" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding LowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:SpinEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="LowLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:SpinEdit.Foreground>
                </dxe:SpinEdit>
                <!-- Percent limit is hidden by default -->
                <dxe:TextEdit Height="25" Grid.Column="2" Mask="P2" MaskUseAsDisplayFormat="True" MaskType="Numeric" Name="textLowPercentLimit" Visibility="Collapsed" IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLimit}"
                                    EditValue="{Binding LowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:TextEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="LowLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:TextEdit.Foreground>
                </dxe:TextEdit>
            </Grid>
            <ContentPresenter Grid.Row="17" Grid.Column="3" 
            Content="{Binding ElementName=textLowLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="18" Text="{x:Static properties:Resources.LLLimit}" VerticalAlignment="Center" x:Name="textBlockLowLowLimit"/>
            <TextBlock Grid.Row="18" Text="{x:Static properties:Resources.LLLevel}" VerticalAlignment="Center" x:Name="textBlockLowLowLevel" Visibility="Collapsed"/>
            <Grid Grid.Column="2" Grid.Row="18" Name="gridLowLowLimit">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkLowLowLimit" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableLowLowLimit, UpdateSourceTrigger=PropertyChanged}" />
                <dxe:SpinEdit HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLowLimit}" Grid.Column="2" MaskType="Numeric" Mask="#########.00" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Double}" Name="textLowLowLimit" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding LowLowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
                    <dxe:SpinEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="LowLowLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:SpinEdit.Foreground>
                </dxe:SpinEdit>
                <!-- Percent limit is hidden by default -->
                <dxe:TextEdit Height="25" Grid.Column="2" Mask="P2" MaskUseAsDisplayFormat="True" MaskType="Numeric" Name="textLowLowPercentLimit" Visibility="Collapsed" IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLowLimit}"
                                    EditValue="{Binding LowLowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:TextEdit.Foreground>
                        <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                            <Binding Path="LowLowLimit" />
                            <Binding ElementName="NewNotificationUserControl" Path="Foreground" />
                        </MultiBinding>
                    </dxe:TextEdit.Foreground>
                </dxe:TextEdit>
            </Grid>
            <ContentPresenter Grid.Row="18" Grid.Column="3" 
            Content="{Binding ElementName=textLowLowLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="20" Text="{x:Static properties:Resources.ADSeverity}" VerticalAlignment="Center" x:Name="textBlockSeverity"/>

            <dxe:SpinEdit Grid.Column="2" Grid.Row="20" MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" Name="textSeverity" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding Severity, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="20" Grid.Column="3" 
            Content="{Binding ElementName=textSeverity, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="22" Text="{x:Static properties:Resources.TimeUnit}" VerticalAlignment="Center" Name="txtBlockTimeUnit" />
            <wpfc:TimeSpanEdit x:Name="textEditTimeUnit" Grid.Row="22" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TimeSpan="{Binding TimeUnit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                               Validation.ErrorTemplate="{x:Null}" 
                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />
            <ContentPresenter Grid.Row="22" Grid.Column="3" 
            Content="{Binding ElementName=textEditTimeUnit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="23" Text="{x:Static properties:Resources.DelayTimeOn}" VerticalAlignment="Center" Name="txtBlockDelayTimeOn" />
            <wpfc:TimeSpanEdit x:Name="textEditDelayTimeOn" Grid.Row="23" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TimeSpan="{Binding DelayTimeOn, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                               Validation.ErrorTemplate="{x:Null}" 
                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />
            <ContentPresenter Grid.Row="23" Grid.Column="3" 
            Content="{Binding ElementName=textEditDelayTimeOn, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="24" Text="{x:Static properties:Resources.DelayTimeOff}" VerticalAlignment="Center" Name="txtBlockDelayTimeOff" />
            <wpfc:TimeSpanEdit x:Name="textEditDelayTimeOff" Grid.Row="24" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TimeSpan="{Binding DelayTimeOff, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                               Validation.ErrorTemplate="{x:Null}" 
                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />
            <ContentPresenter Grid.Row="24" Grid.Column="3" 
            Content="{Binding ElementName=textEditDelayTimeOff, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="26" Text="{x:Static properties:Resources.EnableON}" VerticalAlignment="Center" x:Name="textBlockEnableON"/>
            <CheckBox Grid.Row="26" Grid.Column="2" Name="checkEnableON" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableON, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="26" Grid.Column="3" 
            Content="{Binding ElementName=textBlockEnableON, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="27" Text="{x:Static properties:Resources.EnableOFF}" VerticalAlignment="Center" x:Name="textBlockEnableOFF"/>
            <CheckBox Grid.Row="27" Grid.Column="2" Name="checkEnableOFF" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableOFF, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="27" Grid.Column="3" 
            Content="{Binding ElementName=textBlockEnableOFF, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="28" Text="{x:Static properties:Resources.EnableACK}" VerticalAlignment="Center" x:Name="textBlockEnableACK"/>
            <CheckBox Grid.Row="28" Grid.Column="2" Name="checkEnableACK" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableACK, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="28" Grid.Column="3" 
            Content="{Binding ElementName=textBlockEnableACK, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="29" Text="{x:Static properties:Resources.EnableCONFIRMED}" VerticalAlignment="Center" x:Name="textBlockEnableCONFIRMED"/>
            <CheckBox Grid.Row="29" Grid.Column="2" Name="checkEnableCONFIRMED" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableCONFIRMED, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="29" Grid.Column="3" 
            Content="{Binding ElementName=textBlockEnableCONFIRMED, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
