<UserControl x:Class="PhoenixContactPLCI.UI.SettingsControls.AddressCnt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:PhoenixContactPLCI.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>        
        <TextBlock Text="{x:Static properties:Resources.CaptionAddress}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>
        <TextBox Name="TxTAddress" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
                Text="{Binding Address, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=TxTAddress, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>    
</UserControl>
