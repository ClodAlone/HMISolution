<UserControl x:Class="IEC60870_5_104.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC60870_5_104.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="2" Grid.RowSpan="10" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.ASDUType}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <ComboBox Name="CmbASDUType" Grid.Column="2" Grid.Row="0" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding ASDUType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=CmbASDUType, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtStartAddMon" Text="{x:Static properties:Resources.StartAddMon}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="StartAddMonBox" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"                         
                 Text="{Binding StartAddMon, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=StartAddMonBox, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtStartAddCtrl" Text="{x:Static properties:Resources.StartAddCtrl}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="StartAddCtrlBox" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding StartAddCtrl, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=StartAddCtrlBox, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtCmdQualifier" Text="{x:Static properties:Resources.CmdQualifier}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <ComboBox Name="CmbCmdQualifier" Grid.Column="2" Grid.Row="3" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedValue="{Binding CmdQualifier, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="3" Grid.Column="3" 
                          Content="{Binding ElementName=CmbCmdQualifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtParamQualifier" Text="{x:Static properties:Resources.ParamQualifier}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1"/>
                <ComboBox Name="CmbParamQualifier" Grid.Column="2" Grid.Row="4" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedValue="{Binding ParamQualifier, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
                          Content="{Binding ElementName=CmbParamQualifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtCmdAction" Text="{x:Static properties:Resources.CmdAction}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
                <ComboBox Name="CmbCmdAction" Grid.Column="2" Grid.Row="5" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedValue="{Binding CmdAction, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="5" Grid.Column="3" 
                          Content="{Binding ElementName=CmbCmdAction, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.CotVariable}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1"/>
                <DockPanel Grid.Row="6" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,5">
                    <Button DockPanel.Dock="Right" Click="ResetCotVariableTag_Click">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="SetCotVariableTag_Click">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <TextBox x:Name="textEditCotVariable" IsReadOnly="True" HorizontalAlignment="Stretch" 
                     Text="{Binding CotVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     Validation.ErrorTemplate="{x:Null}" />
                </DockPanel>
                <ContentPresenter Grid.Row="6" Grid.Column="3" 
                Content="{Binding ElementName=textEditCotVariable, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.QualityVariable}" VerticalAlignment="Center" Grid.Row="7" Margin="0,1"/>
                <DockPanel Grid.Row="7" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,5">
                    <Button DockPanel.Dock="Right" Click="ResetQualityVariableTag_Click">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="SetQualityVariableTag_Click">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <TextBox x:Name="textEditQualityVariable" IsReadOnly="True" HorizontalAlignment="Stretch" 
                     Text="{Binding QualityVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     Validation.ErrorTemplate="{x:Null}" />
                </DockPanel>
                <ContentPresenter Grid.Row="7" Grid.Column="3" 
                Content="{Binding ElementName=textEditQualityVariable, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBUpdateTimeStamp" Text="{x:Static properties:Resources.UpdateTimeStamp}" VerticalAlignment="Center" Grid.Row="8" Margin="0,1"/>
                <CheckBox Name="CkUpdateTimeStamp" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding UpdateTimeStamp, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="8" Grid.Column="3" x:FieldModifier="public" Name="CheckUpdateTimeStampErr"
                Content="{Binding ElementName=CkUpdateTimeStamp, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBWriteTimeStamp" Text="{x:Static properties:Resources.WriteTimeStamp}" VerticalAlignment="Center" Grid.Row="9" Margin="0,1"/>
                <CheckBox Name="CkWriteTimeStamp" Grid.Row="9" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding WriteTimeStamp, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="9" Grid.Column="3" x:FieldModifier="public" Name="CheckWriteTimeStampErr"
            Content="{Binding ElementName=CkWriteTimeStamp, Path=(Validation.Errors).CurrentItem}"/>

              <TextBlock Name="TxBFileNameVariable" Text="{x:Static properties:Resources.FileNameVariable}" VerticalAlignment="Center" Grid.Row="10" Margin="0,1"/>
              <DockPanel Grid.Row="10" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,5">
                <Button DockPanel.Dock="Right" Click="ResetFileNameVariableTag_Click" Name="btnFileVariableNameReset">
                  <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                  </Button.Content>
                </Button>
                <Button DockPanel.Dock="Right" Click="SetFileNameVariableTag_Click" Name="btnFileVariableNameSet">
                  <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                  </Button.Content>
                </Button>
                <TextBox x:Name="textEditFileNameVariable" IsReadOnly="True" HorizontalAlignment="Stretch"
                 Text="{Binding FileNameVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                 Validation.ErrorTemplate="{x:Null}" />
              </DockPanel>
              <ContentPresenter Grid.Row="10" Grid.Column="3"
              Content="{Binding ElementName=textEditFileNameVariable, Path=(Validation.Errors).CurrentItem}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
