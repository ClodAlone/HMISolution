<UserControl x:Class="OmronEthernetIP.UI.SettingsControls.ABAddress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:OmronEthernetIP.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
			<ColumnDefinition Width="5"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
			<ColumnDefinition Width="10"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Name="LabStartAddr" Text="{x:Static properties:Resources.ABAddress}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
		<TextBox Name="StartAddr" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
		 Text="{Binding ABAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
		<ContentPresenter Grid.Row="2" Grid.Column="3" 
		Content="{Binding ElementName=StartAddr, Path=(Validation.Errors).CurrentItem}"/>
	</Grid>
</UserControl>
