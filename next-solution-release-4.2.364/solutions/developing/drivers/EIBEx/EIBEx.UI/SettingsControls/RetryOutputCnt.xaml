<UserControl x:Class="EIB.UI.SettingsControls.RetryOutputCnt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"           
             xmlns:properties="clr-namespace:EIB.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static properties:Resources.CaptionRetryOutput}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1" Name="RetryOutputText"/>
        <CheckBox Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Name="RetryOutput" Margin="0,5"
            IsChecked="{Binding RetryOutput, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="6" Grid.Column="3"
            Content="{Binding ElementName=RetryOutput, Path=(Validation.Errors).CurrentItem}"/>

    </Grid>
</UserControl>
