<UserControl x:Class="ROCDriver.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ROCDriver.UI.Properties"
             mc:Ignorable="d" Height="300" Width="600"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="1" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Name="TxBStationID" Text="{x:Static properties:Resources.StationID}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="StationID" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding StationID, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=StationID, Path=(Validation.Errors).CurrentItem}"/>

				<TextBlock Name="TxBStationGroup" Text="{x:Static properties:Resources.DeviceGroup}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
				<TextBox Name="TbStationGroup" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding StationGroup, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
				<ContentPresenter Grid.Row="2" Grid.Column="3"
                Content="{Binding ElementName=TbStationGroup, Path=(Validation.Errors).CurrentItem}"/>

				<TextBlock Text="{x:Static properties:Resources.CheckDeviceConnection}" VerticalAlignment="Center" x:FieldModifier="public" Name="textCheckDeviceConnection" Grid.Row="3" Margin="0,1"/>
				<CheckBox Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Name="checkCheckDeviceConnection" Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      IsChecked="{Binding CheckDeviceConnection, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

				<TextBlock Text="{x:Static properties:Resources.Ping_TLP_PointType}" VerticalAlignment="Center" Name ="textPingPointType" Grid.Row="4" Margin="0,1"/>
				<TextBox Name="TbPingPointType" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
						Text="{Binding PingPointType, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
				<ContentPresenter Grid.Row="4" Grid.Column="3"
						Content="{Binding ElementName=TbPingPointType, Path=(Validation.Errors).CurrentItem}"/>

				<TextBlock Text="{x:Static properties:Resources.Ping_TLP_LogicalNumber}" VerticalAlignment="Center" Name ="textPingLogicalNumber" Grid.Row="5" Margin="0,1"/>
				<TextBox Name="TbPingLogicalNumber" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
						Text="{Binding PingLogicalNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
				<ContentPresenter Grid.Row="5" Grid.Column="3"
						Content="{Binding ElementName=TbPingLogicalNumber, Path=(Validation.Errors).CurrentItem}"/>

				<TextBlock Text="{x:Static properties:Resources.Ping_TLP_Parameter}" VerticalAlignment="Center" Name ="textPingParameter" Grid.Row="6" Margin="0,1"/>
				<TextBox Name="TbPingParameter" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
						Text="{Binding PingParameter, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
				<ContentPresenter Grid.Row="6" Grid.Column="3"
						Content="{Binding ElementName=TbPingParameter, Path=(Validation.Errors).CurrentItem}"/>

			</Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
