<UserControl x:Class="OpcClientDriver.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:OpcClientDriver.UI.Properties"
             mc:Ignorable="d" Height="400" Width="600"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                	<RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock Text="{x:Static properties:Resources.RemDisItemAfterSecs}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="RemoveDisabledItemAfterSecs" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding RemoveDisabledItemAfterSecs, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=RemoveDisabledItemAfterSecs, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.MaxCleanCount}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="MaxCleanCount" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MaxCleanCount, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=MaxCleanCount, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.UseAlwaysSecureConnections}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUseAlwaysSecureConnections" Margin="0,1"/>
                <CheckBox  Grid.Row="3" Grid.Column="2" Name="UseAlwaysSecureConnections" VerticalAlignment="Center" Margin="0,5"
                      x:FieldModifier="public" IsChecked="{Binding UseAlwaysSecureConnections, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{x:Static properties:Resources.FastSamplingInterval}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1"/>
                <TextBox Name="FastSamplingInterval" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding FastSamplingInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
                Content="{Binding ElementName=FastSamplingInterval, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.SlowSamplingInterval}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
                <TextBox Name="SlowSamplingInterval" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding SlowSamplingInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3" 
                Content="{Binding ElementName=SlowSamplingInterval, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.DisableWhenNotUsed}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textDisableWhenNotUsed" Margin="0,1"/>
                <CheckBox  Grid.Row="6" Grid.Column="2" Name="DisableWhenNotUsed" VerticalAlignment="Center" Margin="0,5"
                      x:FieldModifier="public" IsChecked="{Binding DisableWhenNotUsed, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{x:Static properties:Resources.PublishingInterval}" VerticalAlignment="Center" Grid.Row="7" Margin="0,1"/>
                <TextBox Name="PublishingInterval" Grid.Column="2" Grid.Row="7" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding PublishingInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="7" Grid.Column="3" 
                Content="{Binding ElementName=PublishingInterval, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.UsePollingRead}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUsePollingRead" Margin="0,1"/>
                <CheckBox  Grid.Row="8" Grid.Column="2" Name="UsePollingRead" VerticalAlignment="Center" Margin="0,5"
                      x:FieldModifier="public" IsChecked="{Binding UsePollingRead, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{x:Static properties:Resources.ConnectionTimeout}" VerticalAlignment="Center" Grid.Row="9" Margin="0,1"/>
                <TextBox Name="ConnectionTimeout" Grid.Column="2" Grid.Row="9" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding ConnectionTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="9" Grid.Column="3" 
                Content="{Binding ElementName=ConnectionTimeout, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.User}" VerticalAlignment="Center" Grid.Row="10" Margin="0,1"/>
                <TextBox Name="OPCUAUser" Grid.Column="2" Grid.Row="10" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding User, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="10" Grid.Column="3" 
                Content="{Binding ElementName=OPCUAUser, Path=(Validation.Errors).CurrentItem}"/>
                
                <TextBlock Text="{x:Static properties:Resources.Password}" Grid.Row="11"/>
                <cc:BindablePasswordBox Grid.Row="11" Grid.Column="2" Password="{Binding Password, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 x:Name="Password" />
                <ContentPresenter Grid.Row="11" Grid.Column="3" 
                Content="{Binding ElementName=Password, Path=(Validation.Errors).CurrentItem}"/>
                
	            <TextBlock Text="{x:Static properties:Resources.UseServerDiscovery}" VerticalAlignment="Center" Grid.Row="12" Margin="0,1"/>
	            <CheckBox  Grid.Row="12" Grid.Column="2" Name="UseServerDiscovery" VerticalAlignment="Center" Margin="5"
	                      x:FieldModifier="public" IsChecked="{Binding UseServerDiscovery, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
