<UserControl x:Class="ExampleDemo.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ExampleDemo.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <ResourceDictionary Source="/../SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/../SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
    <StackPanel x:Name="MainStack" Orientation="Vertical">
    <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
              <ColumnDefinition Width="5"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
              <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static properties:Resources.Name}" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Margin="0,1"/>
            <TextBox Name="ChName" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=ChName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Channel}" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Margin="0,1"/>
            <ComboBox x:FieldModifier="public" Name="CmbChannel" Grid.Column="2" Grid.Row="1"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Name"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding Channel, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbChannel, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.SimulationInterval}" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Margin="0,1"/>
            <TextBox Name="SimulationInterval" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding SimulationInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=SimulationInterval, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
