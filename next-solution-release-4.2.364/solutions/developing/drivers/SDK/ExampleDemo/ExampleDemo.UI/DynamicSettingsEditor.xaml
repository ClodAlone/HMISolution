<UserControl x:Class="ExampleDemo.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ExampleDemo.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/../SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/../SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
    <StackPanel x:Name="MainStack" Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
          <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static properties:Resources.Method}" Name ="TMethod" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
        <ComboBox Name="CmbMethod" Grid.Column="2" Grid.Row="0" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedIndex="{Binding Path=MethodID, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
        </ComboBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=CmbMethod, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.DemoType}" Name="TDemoType" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
        <ComboBox Name="CmbDemoType" Grid.Column="2" Grid.Row="1"  
                   HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedIndex="{Binding Path=DemoType, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
        </ComboBox>
        <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbDemoType, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.Station}" Name="TStation" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                   <ComboBox Name="CmbStation" Grid.Column="2" Grid.Row="3" 
                  DisplayMemberPath="Name"
                  SelectedValuePath="Name"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding StationName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
        </ComboBox>
        <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=CmbStation, Path=(Validation.Errors).CurrentItem}"/>

    </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
