<UserControl x:Class="DriverSerialExample.UI.ImportTagsEditorTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverSerialExample.UI.Properties"
             xmlns:local="clr-namespace:DriverSerialExample.UI"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
  <!--xmlns:tree="clr-namespace:Aga.Controls.Tree;assembly=Aga.Controls"-->
 <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/../SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/../SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--<Style x:Key="CustomListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#FF2C2C2C"></Setter>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FF262626"></Setter>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="true">
                        <Setter Property="Background" Value="Gray" />
                    </Trigger>
                </Style.Triggers>
            </Style>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <!--<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.ImportTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
        --><!--<TreeView Grid.Row="1" Name="ImportTree" 
                  Height="356" HorizontalAlignment="Left" VerticalAlignment="Top" Width="600" />--><!--
        <Grid Grid.Row="1" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            --><!--<tree:TreeList Name="ImportTree" Foreground="White" Background="#FF414141">--><!--
            <tree:TreeList Name="ImportTree" Foreground="White" Background="#FF414141"
                           ItemContainerStyle="{DynamicResource CustomListViewItemStyle}" AlternationCount="2" >
                <tree:TreeList.View>
                    <GridView>
                        <GridView.Columns>

                            <GridViewColumn Width="300" >
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Name" Click="lvUsersColumnHeader_Click">Name</GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <tree:RowExpander/>
                                            <TextBlock Text="{Binding Name}"></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100" DisplayMemberBinding="{Binding Address}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Address" Click="lvUsersColumnHeader_Click">Address</GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="80" DisplayMemberBinding="{Binding szType}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Type" Click="lvUsersColumnHeader_Click">Type</GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>

                        </GridView.Columns>
                    </GridView>
                </tree:TreeList.View>
            </tree:TreeList>
        </Grid>
 
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130*" />
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="200*" />
            </Grid.ColumnDefinitions>
            <CheckBox Name="AddStationName" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content ="{x:Static properties:Resources.AddStationName}"></CheckBox>
            <TextBlock Text="{x:Static properties:Resources.Station}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Margin="0,11"/>
            <ComboBox Name="CmbStation" Grid.Column="2" 
                      DisplayMemberPath="Value" SelectedValuePath="Key" 
                      Margin="0,10,0,2" IsEditable="False">
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Name="btnOpen" Content="{x:Static properties:Resources.ImportLoadFile}" Click="LoadFile_Click"></Button>
            <Button Grid.Row="0" Grid.Column="1" Name="btnSelAll" Content="{x:Static properties:Resources.ImportSelectAll}" Click="SelAll_Click"></Button>
            <Button Grid.Row="0" Grid.Column="2" Name="btnClear" Content="{x:Static properties:Resources.ImportSelectNone}" Click="Clear_Click"></Button>
            <Button Grid.Row="0" Grid.Column="3" Name="btnImport" Content="{x:Static properties:Resources.ImportTags}" Click="Import_Click"></Button>
        </Grid>
        --><!--<Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Name="btnOpen" Content="{x:Static properties:Resources.LoadFile}" Click="LoadFile_Click"></Button>
            <Button Grid.Row="0" Grid.Column="1" Name="btnClear" Content="{x:Static properties:Resources.SelectNone}" Click="Clear_Click"></Button>
            <Button Grid.Row="0" Grid.Column="2" Name="btnImport" Content="{x:Static properties:Resources.ImportTags}" Click="Import_Click"></Button>
        </Grid>--><!--

    </Grid>-->
  <DockPanel x:Name="MainStack"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Width="Auto"
          Height="Auto"
          Dock="Top" >
  </DockPanel>
</UserControl>
