<UserControl x:Class="BrPvi.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:BrPvi.UI.Properties"                                       
             mc:Ignorable="d"  Height="400" Width="600"
             d:DesignHeight="600" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="12" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Name="TextPviRoutingPath" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIRoutingPath}" Grid.Row="0" Margin="0,1"/>
                <TextBox Name="PviRoutingPath" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviRoutingPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=PviRoutingPath, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviResponseTimeout" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIResponseTimeout}" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="PviResponseTimeout" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviResponseTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3"
            Content="{Binding ElementName=PviResponseTimeout, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviInterfaceType" Text="{x:Static properties:Resources.CaptionPVIInterfaceType}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <ComboBox Name="CmbPviInterfaceType" Grid.Column="2" Grid.Row="2" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"  Margin="0,5"
                  SelectedValue="{Binding BrPviInterfaceType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=CmbPviInterfaceType, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviSourceStationPort" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIEthernetSourceStationPort}" Grid.Row="3" Margin="0,1"/>
                <TextBox Name="PviSourceStationport" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviSourceStationPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3"
            Content="{Binding ElementName=PviSourceStationPort, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviSourceStationID" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIEthernetSourceStationID}" Grid.Row="4" Margin="0,1"/>
                <TextBox Name="PviSourceStationID" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviSourceStationID, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3"
            Content="{Binding ElementName=PviSourceStationID, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviDestinationStationIPAddress" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIEthernetDestinationStationIPAddress}" Grid.Row="5" Margin="0,1"/>
                <TextBox Name="PviDestinationStationIPAddress" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviDestinationStationIPAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3"
            Content="{Binding ElementName=PviDestinationStationIPAddress, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviDestinationStationPort" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIEthernetDestinationStationPort}" Grid.Row="6" Margin="0,1"/>
                <TextBox Name="PviSourceDestinationport" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviDestinationStationPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="6" Grid.Column="3"
            Content="{Binding ElementName=PviDestinationStationPort, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviDestinationStationID" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVIEthernetDestinationStationID}" Grid.Row="7" Margin="0,1"/>
                <TextBox Name="PviDestinationStationID" Grid.Column="2" Grid.Row="7" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviDestinationStationID, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="7" Grid.Column="3"
            Content="{Binding ElementName=PviDestinationStationID, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviSerialPort" VerticalAlignment="Center" Text="{x:Static properties:Resources.CaptionPVISerialPort}" Grid.Row="8" Margin="0,1"/>
                <TextBox Name="PviSerialPort" Grid.Column="2" Grid.Row="8" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding BrPviSerialPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="8" Grid.Column="3"
            Content="{Binding ElementName=PviSerialPort, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviSerialBaudrate" Text="{x:Static properties:Resources.CaptionPVISerialBaudrate}" VerticalAlignment="Center" Grid.Row="9" Margin="0,1"/>
                <ComboBox Name="CmbPviSerialBaudrate" Grid.Column="2" Grid.Row="9" IsEditable="False"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Value"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedValue="{Binding BrPviSerialBaudrate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="9" Grid.Column="3"
            Content="{Binding ElementName=CmbPviSerialBaudrate, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviSerialParity" Text="{x:Static properties:Resources.CaptionPVISerialParity}" VerticalAlignment="Center" Grid.Row="10" Margin="0,1"/>
                <ComboBox Name="CmbPviSerialParity" Grid.Column="2" Grid.Row="10" IsEditable="False"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedIndex="{Binding Path=BrPviSerialParity, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="10" Grid.Column="3"
            Content="{Binding ElementName=CmbPviSerialParity, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TextPviSerialFlowControl" Text="{x:Static properties:Resources.CaptionPVISerialFlowControl}" VerticalAlignment="Center" Grid.Row="11" Margin="0,1"/>
                <ComboBox Name="CmbPviSerialFlowControl" Grid.Column="2" Grid.Row="11" IsEditable="False"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedIndex="{Binding Path=BrPviSerialFlowControl, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,5"/>
                <ContentPresenter Grid.Row="11" Grid.Column="3"
            Content="{Binding ElementName=CmbPviSerialFlowControl, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
