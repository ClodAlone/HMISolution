<UserControl x:Class="BrPvi.UI.SettingsControls.cntPviArrayLength"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:BrPvi.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />
              <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>    
            <TextBlock Name="txPviArrayLength" Text="{x:Static properties:Resources.CaptionPVIArrayLength}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
            <TextBox Name="PviArrayLength" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding BrPviArrayLength, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" ></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3"
                Content="{Binding ElementName=PviArrayLength, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>        
</UserControl>
