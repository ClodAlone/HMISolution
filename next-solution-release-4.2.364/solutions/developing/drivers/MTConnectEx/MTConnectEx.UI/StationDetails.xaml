<UserControl x:Class="MTConnect.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:MTConnect.UI.Properties"
             mc:Ignorable="d" Height="200" Width="600"
             d:DesignHeight="60" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
              <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="12" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.MTConnectDeviceID}" VerticalAlignment="Center" x:FieldModifier="public" Name="MTConnectDeviceIdText" Grid.Row="0" Margin="0,5"/>
                <TextBox Name="DeviceId" Grid.Column="2" Grid.Row="0" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}"  Margin="0,5"
                           Text="{Binding DeviceId, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="DeviceIdErr"
                      Content="{Binding ElementName=DeviceId, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.MTConnectMaxNumberOfItemsForRequest}" VerticalAlignment="Center" x:FieldModifier="public" Name="MaxNumberOfItemsForRequestText" Grid.Row="1" Margin="0,5"/>
                <TextBox Name="MaxNumberOfItemsForRequest" Grid.Column="2" Grid.Row="1" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}"  Margin="0,5"
                           Text="{Binding MaxNumberOfItemsForRequest, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="MaxNumberOfItemsForRequestErr"
                      Content="{Binding ElementName=MaxNumberOfItemsForRequest, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
