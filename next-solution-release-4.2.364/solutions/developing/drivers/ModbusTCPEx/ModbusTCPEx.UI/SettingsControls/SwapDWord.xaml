<UserControl x:Class="ModbusTCP.UI.SettingsControls.SwapDWord"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModbusTCP.UI.SettingsControls"
             xmlns:properties="clr-namespace:ModbusTCP.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="TxBSwapDWords" Text="{x:Static properties:Resources.SwapDWords}" VerticalAlignment="Center" Margin="0,1"/>
                <CheckBox Name="CheckSwaDpWords" Grid.Column="2" VerticalAlignment="Center"  Margin="0,5"
                  IsChecked="{Binding SwapDWords, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Column="3" x:FieldModifier="public" Name="CheckSwapWordsErr"
                Content="{Binding ElementName=CheckSwapWords, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
