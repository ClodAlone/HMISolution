<UserControl x:Class="IEC61850.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC61850.UI.Properties"
             mc:Ignorable="d" Width="400" Height="400"
             d:DesignHeight="400" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Grid.RowSpan="5" HorizontalAlignment="Stretch" Background="Transparent" />

                <TextBlock Name="TxtClientSessionSelector" Text="{x:Static properties:Resources.IEC61850ClientSessionSelector}" VerticalAlignment="Center"  Grid.Row="0" Margin="0,1"/>
                <TextBox Name="ChClientSessionSelector" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding ClientSessionSelector, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3"
                Content="{Binding ElementName=ChClientSessionSelector, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtClientPresentationSelector" Text="{x:Static properties:Resources.IEC61850ClientPresentationSelector}" VerticalAlignment="Center"  Grid.Row="1" Margin="0,1"/>
                <TextBox Name="ChClientPresentationSelector" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding ClientPresentationSelector, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3"
                Content="{Binding ElementName=ChClientPresentationSelector, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtClientApplicationID" Text="{x:Static properties:Resources.IEC61850ClientApplicationID}" VerticalAlignment="Center"  Grid.Row="2" Margin="0,1"/>
                <TextBox Name="ChClientApplicationID" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding ClientApplicationID, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3"
                Content="{Binding ElementName=ChClientApplicationID, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtClientAEQualifier" Text="{x:Static properties:Resources.IEC61850ClientAEQualifier}" VerticalAlignment="Center"  Grid.Row="3" Margin="0,1"/>
                <TextBox Name="ChClientAEQualifier" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding ClientAEQualifier, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3"
                Content="{Binding ElementName=ChClientAEQualifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtReportAutomaticActivation" Text="{x:Static properties:Resources.IEC61850ReportAutomaticActivation}" VerticalAlignment="Center"  Grid.Row="4" Margin="0,1"/>
                <CheckBox Name="ChReportAutomaticActivation" Grid.Column="2" Grid.Row="4" VerticalAlignment="Center" Margin="0,5" HorizontalAlignment="Stretch"
                    IsChecked="{Binding ReportAutomaticActivation, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3" x:FieldModifier="public" Name="ChReportAutomaticActivationErr"
                Content="{Binding ElementName=ChReportAutomaticActivation, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtTimeZone" Text="{x:Static properties:Resources.CaptionTimeZone}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
                <ComboBox Name="CmbTimeZone" Grid.Column="2" Grid.Row="5" x:FieldModifier="public" Margin="0,5"
                     Text="{Binding TimeZone}"
                     IsEditable="True" IsReadOnly="False" HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     SelectedValue="{Binding TimeZone, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                    </ComboBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3"
                Content="{Binding ElementName=CmbTimeZone, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
