<UserControl x:Class="ModBus.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ModBus.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="5" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <!--<TextBlock Text="{x:Static properties:Resources.FunctionCode}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <ComboBox Name="CmbFunctionCode" Grid.Column="2" Grid.Row="0" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding FunctionCode, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
                </ComboBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=CmbFunctionCode, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="{x:Static properties:Resources.StartAddress}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="StartAddr" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding StartAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=StartAddr, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="{x:Static properties:Resources.FileNumber}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="FileNum" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding FileNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=FileNum, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="{x:Static properties:Resources.Broadcast}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <CheckBox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,5"
                  IsChecked="{Binding BroadCast, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>-->
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
