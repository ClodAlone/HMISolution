<UserControl x:Class="RMS621.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:RMS621.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto" />
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Grid.RowSpan="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <TextBlock Text="{x:Static properties:Resources.CaptionCommand}" Grid.Row="0" Margin="0,5"/>
                <ComboBox Name="CmbCommand" Grid.Column="2" Grid.Row="0" IsEditable="False" Margin="0,5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                        SelectedValue="{Binding Command, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CmbCommand_SelectionChanged" />
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=CmbCommand, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblProcess" Text="{x:Static properties:Resources.CaptionProcess}" Grid.Row="1" Margin="0,5"/>
                <ComboBox Name="CmbProcess" Grid.Column="2" Grid.Row="1" IsEditable="False" Margin="0,5"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                        SelectedValuePath="Value"
                        DisplayMemberPath="Description"
                        SelectedValue="{Binding Process, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=CmbProcess, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblProcessNumber" Text="{x:Static properties:Resources.CaptionProcessNumber}" VerticalAlignment="Center" Grid.Row="2" Margin="0,5"/>
                <TextBox Name="txtProcessNumber" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,5"
                        Text="{Binding ProcessNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=txtProcessNumber, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>            
        </StackPanel>
    </ScrollViewer>
</UserControl>

