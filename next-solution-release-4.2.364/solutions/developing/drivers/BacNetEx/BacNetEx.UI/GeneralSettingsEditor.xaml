<UserControl x:Class="BACnet.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties1="clr-namespace:BACnet.UI.Properties"
             xmlns:baseproperties="clr-namespace:DriverCodeBaseEx.UI;assembly=DriverCodeBaseEx.UI"
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties;assembly=DriverCodeBaseEx.UI"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" Height="300" Width="600"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dx:DXTabControl Name="tabGeneral" >
            <dx:DXTabItem  Name="GeneralSettings" Header="{x:Static properties:Resources.GeneralSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="MainStack" Orientation="Vertical">
	                    <Grid x:Name="gridSpecific">
	                        <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>
	                        <Grid.RowDefinitions>
	                            <RowDefinition Height="Auto"/>                            
	                        </Grid.RowDefinitions>
	                        <GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />
	                        <TextBlock Text="{x:Static properties1:Resources.CaptionAllowOtherBACnetClients}" VerticalAlignment="Center" x:FieldModifier="public" Name="txtAllowOtherBACnetClients" Grid.Row="1" Margin="0,1"/>
                            <CheckBox x:Name="chkAllowOtherBACnetClients" Grid.Row="1" VerticalAlignment="Center" x:FieldModifier="public" Margin="0,5"
	        		            IsChecked="{Binding AllowOtherBACnetClients, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="2" />
	                        <ContentPresenter Grid.Row="1" Grid.Column="3" 
	        		            Content="{Binding (Validation.Errors).CurrentItem, ElementName=chkAllowOtherBACnetClients}"/>
	                    </Grid>
                    </StackPanel>
                </ScrollViewer>
                <!--<Grid x:Name="gridGeneral">
                </Grid>-->
            </dx:DXTabItem>
            <dx:DXTabItem  Name="ChannelSettings" Header="{x:Static properties:Resources.ChannelsSettings}">
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
