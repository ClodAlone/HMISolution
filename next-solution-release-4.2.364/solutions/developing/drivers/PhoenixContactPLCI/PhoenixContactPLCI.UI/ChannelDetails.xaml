<UserControl x:Class="PhoenixContactPLCI.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:PhoenixContactPLCI.UI.Properties"
             mc:Ignorable="d" Height="300" Width="400" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>              
              <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <!--x:Name="MainGrid">-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Stretch" Background="Transparent" />

                <TextBlock Name="lblServerAddress" Text="{x:Static properties:Resources.CaptionServerAddress}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1" />
                <TextBox Name="TxTServerAddress" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
        		Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
        		Content="{Binding ElementName=TxTServerAddress, Path= (Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblServerPort" Text="{x:Static properties:Resources.CaptionServerPort}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="TxTServerPort" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch"
                 Text="{Binding ServerPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=TxTServerPort, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.CaptionSubscribeVariables}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUsePing" Margin="0,1"/>
                <CheckBox  Grid.Row="2" Grid.Column="2" Name="chkSubscribeVariables" VerticalAlignment="Center" Margin="5"
                        x:FieldModifier="public" IsChecked="{Binding SubscribeVariables, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
