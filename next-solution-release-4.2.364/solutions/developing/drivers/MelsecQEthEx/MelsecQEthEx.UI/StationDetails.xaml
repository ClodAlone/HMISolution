<UserControl x:Class="MelsecQEth.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:MelsecQEth.UI.Properties"
             mc:Ignorable="d" Height="400" Width="600"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="5" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.NetworkNumber}" Grid.Row="0" Margin="0,1"/>
                <TextBox Name="TxtNetworkNumber" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding NetworkNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=TxtNetworkNumber, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.PcNumber}" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="TxtPcNumber" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding PcNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=TxtPcNumber, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Text="{x:Static properties:Resources.PlcType}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <ComboBox Name="CmbPlcType" Grid.Column="2" Grid.Row="2" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding PlcType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                 Content="{Binding ElementName=CmbPlcType, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="LabelNrMaxAggregatedRequests" Text="{x:Static properties:Resources.CaptionLabelNrMaxAggregatedRequests}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <TextBox Name="TxLabelNrMaxAggregatedRequests" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding LabelNrMaxAggregatedRequests, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=TxLabelNrMaxAggregatedRequests, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

