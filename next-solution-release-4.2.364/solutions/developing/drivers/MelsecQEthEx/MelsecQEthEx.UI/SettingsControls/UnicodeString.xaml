<UserControl x:Class="MelsecQEth.UI.SettingsControls.UnicodeString"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MelsecQEth.UI.SettingsControls"
             xmlns:properties="clr-namespace:MelsecQEth.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
        <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="TxBkUnicodeString" Text="{x:Static properties:Resources.StringUnicode}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
        <CheckBox Name="CheckUnicodeString" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="0,5"
                  IsChecked="{Binding UnicodeString, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=CheckUnicodeString, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
