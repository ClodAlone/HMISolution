<UserControl x:Class="FanucCNC.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:FanucCNC.UI.Properties"
             mc:Ignorable="d" Height="300" Width="600"
             d:DesignHeight="60" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock Name="lblServerAddress" Text="{x:Static properties:Resources.CaptionDeviceAddress}" VerticalAlignment="Center" Grid.Row="0"/>
                <TextBox Name="TxTDeviceAddress" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
        		    Text="{Binding DeviceAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,5" />
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
        		    Content="{Binding ElementName=TxTDeviceAddress, Path= (Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblDevicePort" Text="{x:Static properties:Resources.CaptionDevicePort}" VerticalAlignment="Center" Grid.Row="1"/>
                <TextBox Name="TxTDevicePort" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch"
                     Text="{Binding DevicePort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                    Content="{Binding ElementName=TxTDevicePort, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblMachineSeries" Text="{x:Static properties:Resources.CaptionMachineSeries}" VerticalAlignment="Center" Grid.Row="2"/>
                <ComboBox Name="cmbMachineSeries" Grid.Column="2" Grid.Row="2" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                      SelectedValuePath="Code"
                      DisplayMemberPath="Description"
                      SelectedValue="{Binding MachineSerie, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=cmdMachineSeries, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
