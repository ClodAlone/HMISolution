<UserControl x:Class="FanucCNC.UI.DynamicSettingsControl_Custom_UploadProgramFromCnc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:FanucCNC.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="MainStack" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>                
            </Grid.RowDefinitions>
            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->

            <TextBlock Text="Cnc file's folder" VerticalAlignment="Center" Grid.Row="0"/>
            <TextBox Name="txtCNCSourcePath" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
                 Text="{Binding CNCSourcePath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=txtCNCSourcePath, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CaptionRemoveStartEndProgram}" VerticalAlignment="Center" Grid.Row="1"/>
            <CheckBox x:Name="chkRemoveStartEndProgram" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding RemoveStartEndProgram, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></CheckBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3"
            Content="{Binding ElementName=chkRemoveStartEndProgram, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CaptionRemoveProgramName}" VerticalAlignment="Center" Grid.Row="2"/>
            <CheckBox x:Name="chkRemoveProgramName" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding RemoveProgramName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></CheckBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=chkRemoveProgramName, Path=(Validation.Errors).CurrentItem}"/>

            <!--<TextBlock Text="Pc file's folder" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
            <TextBox Name="txtPCTargetPath" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch"
                 Text="{Binding PCTargetPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=txtPCTargetPath, Path=(Validation.Errors).CurrentItem}"/>-->

        </Grid>
    </StackPanel>
</UserControl>
