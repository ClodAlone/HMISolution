<UserControl x:Class="FanucCNC.UI.DynamicSettingsControl_cnc_rdparam_cnc_wrparam"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:FanucCNC.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="MainStack" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>                
            </Grid.RowDefinitions>
            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->

            <TextBlock Text="{x:Static properties:Resources.CaptionParameterNumber}" VerticalAlignment="Center" Grid.Row="0"/>
            <TextBox Name="txtPNumber" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
                 Text="{Binding PNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=txtPNumber, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CaptionParameterSize}" VerticalAlignment="Center" Grid.Row="1"/>
            <ComboBox Name="cmbPSize" Grid.Column="2" Grid.Row="1" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValuePath="Code"
                  DisplayMemberPath="Description"
                  SelectedValue="{Binding PSize, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="1" Grid.Column="3"                               
            Content="{Binding ElementName=cmbPSize, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CaptionAxisNr}" VerticalAlignment="Center" Grid.Row="2"/>
            <TextBox Name="txtAxisNr" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch"
                 Text="{Binding AxisNr, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=txtAxisNr, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </StackPanel>
</UserControl>
