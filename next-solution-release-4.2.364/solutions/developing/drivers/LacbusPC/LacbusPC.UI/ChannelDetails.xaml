<UserControl x:Class="LacbusPC.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:LacbusPC.UI.Properties"
             mc:Ignorable="d" Height="550" Width="600"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="2" Grid.RowSpan="6" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock VerticalAlignment="Center" Grid.Row="0" Margin="0,1" Text="{x:Static properties:Resources.LacbusHostName}"/>
                <TextBox Name="LacbusHostName" Grid.Column="2" Grid.Row="0"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding LacbusPCHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3"
                Content="{Binding ElementName=LacbusHostName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Grid.Row="1" Margin="0,1" Text="{x:Static properties:Resources.LacbusHostPort}"/>
                <TextBox Name="LacbusHostPort" Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding LacbusPCHostPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3"
                Content="{Binding ElementName=LacbusHostPort, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.LacbusConnectionTimeout}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="ConnectionTimeout" Grid.Column="2" Grid.Row="2"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding LacbusPCConnectionTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3"
                Content="{Binding ElementName=ConnectionTimeout, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.LacbusPCNumber}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <TextBox Name="PCNumber" Grid.Column="2" Grid.Row="3"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
               Text="{Binding LacbusPCPCNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3"
                Content="{Binding ElementName=PCNumber, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBBackupHostName" Text="{x:Static properties:Resources.LacbusBackupHostName}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1" x:FieldModifier="public"/>
                <TextBox Name="BackupHostName" Grid.Column="2" Grid.Row="4" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding LacbusPCBackupHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3"
                Content="{Binding ElementName=BackupHostName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.LacbusTimeZone}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
                <ComboBox Name="CmbTimeZone" Grid.Column="2" Grid.Row="5" x:FieldModifier="public"
                 Text="{Binding LacbusPCTimeZone}"
                 IsEditable="True" IsReadOnly="False" HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 SelectedValue="{Binding LacbusPCTimeZone, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3"
                Content="{Binding ElementName=CmbTimeZone, Path=(Validation.Errors).CurrentItem}"/>

	            <TextBlock Text="{x:Static properties:Resources.LacbusMaxPendingRTUPollReq}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1"/>
	            <TextBox Name="MaxPendingRTUPollReq" Grid.Column="2" Grid.Row="6"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
	                Text="{Binding LacbusPCMaxPendingRTUPollReq, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
	            <ContentPresenter Grid.Row="6" Grid.Column="3"
	            Content="{Binding ElementName=MaxPendingRTUPollReq, Path=(Validation.Errors).CurrentItem}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
