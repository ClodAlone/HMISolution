<UserControl x:Class="BACnet.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:BACnet.UI.Properties"
             mc:Ignorable="d" Height="400" Width="600"
             d:DesignHeight="400" d:DesignWidth="600"
             Grid.IsSharedSizeScope="True" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="6" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.HostDeviceName}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" />
                <TextBox x:Name="HostName" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
        		Text="{Binding DeviceHostName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=HostName}"/>

                <TextBlock Text="{x:Static properties:Resources.HostDevicePort}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox x:Name="HostPort" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
        		Text="{Binding DeviceHostPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=HostPort}"/>

	            <TextBlock Text="{x:Static properties:Resources.WhoIsDisabled}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
	            <CheckBox x:Name="CkWhoIsDisabled" Grid.Row="3" VerticalAlignment="Center" x:FieldModifier="public" Margin="5"  
	        		IsChecked="{Binding WhoIsDisabled, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="2" />
	            <ContentPresenter Grid.Row="3" Grid.Column="3" 
	        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=CkWhoIsDisabled}"/>

                <TextBlock Text="{x:Static properties:Resources.DeviceInstance}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1"/>
                <TextBox x:Name="tboxDeviceInstance" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
        		Text="{Binding DeviceInstance, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=tboxDeviceInstance}"/>

            <TextBlock Text="{x:Static properties:Resources.TIME_SINCH}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
            <ComboBox x:Name="CmbTimeSync" Grid.Column="2" Grid.Row="5" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                      SelectedValue="{Binding TimeSync, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <ContentPresenter Grid.Row="5" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=CmbTimeSync}"/>

            <TextBlock x:Name="TxBTxCOVInterval" Text="{x:Static properties:Resources.COV_INTERVAL}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1"/>
            <TextBox x:Name="TxCOVInterval" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
        		Text="{Binding COVInterval, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <ContentPresenter Grid.Row="6" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=TxCOVInterval}"/>

            <TextBlock Text="{x:Static properties:Resources.FORCEINITPOLL}" VerticalAlignment="Center" x:FieldModifier="public" Name="TxBForceInitialPolling" Grid.Row="7" Margin="0,1"/>
            <CheckBox x:Name="CkForceInitialPolling" Grid.Row="7" VerticalAlignment="Center" x:FieldModifier="public" Margin="0,5"  
        		IsChecked="{Binding ForceInitialPolling, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="2" />

            <TextBlock Text="{x:Static properties:Resources.REGISTERBBMD}" VerticalAlignment="Center" Grid.Row="8" Margin="0,1"/>
            <CheckBox x:Name="CkRegisterBBMD" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Margin="5"
        		IsChecked="{Binding BBMDRegister, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <ContentPresenter Grid.Row="8" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=CkRegisterBBMD}"/>

            <TextBlock x:Name="TxBTxBBMDAddress" Text="{x:Static properties:Resources.BBMDADDRESS}" VerticalAlignment="Center" Grid.Row="9" Margin="0,1"/>
            <TextBox x:Name="TxBBMDAddress" Grid.Column="2" Grid.Row="9" HorizontalAlignment="Stretch"
        		Text="{Binding BBMDAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

            <TextBlock x:Name="TxBTxBBMDLifetime" Text="{x:Static properties:Resources.BBMD_LIFETIME}" VerticalAlignment="Center" Grid.Row="10" Margin="0,1"/>
            <TextBox x:Name="TxBBMDLifetime" Grid.Column="2" Grid.Row="10" HorizontalAlignment="Stretch"
        		Text="{Binding BBMDLifetime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <ContentPresenter Grid.Row="10" Grid.Column="3" 
        		Content="{Binding (Validation.Errors).CurrentItem, ElementName=TxBBMDLifetime}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
