<UserControl x:Class="BACnet.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:BACnet.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" />-->
                </Grid.RowDefinitions>

                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="5" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.ObjectName}" Grid.Row="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Name="TxtObjectName" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding ObjectName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=TxtObjectName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.BACnetObjectType}" Grid.Row="1" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Name="CmbObjectType" Grid.Column="2" Grid.Row="1" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding BACnetObjectType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbObjectType, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBTxInstanceNumber" Text="{x:Static properties:Resources.InstanceNumber}" Grid.Row="2" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Name="TxInstanceNumber" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding InstanceNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" />
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=TxInstanceNumber, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.PropertyIdentifier}" Grid.Row="3" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Name="CmbPropertyIdentifier" Grid.Column="2" Grid.Row="3" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding PropertyIdentifier, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=CmbPropertyIdentifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBCOVEnable" Text="{x:Static properties:Resources.ENABLECOV}" VerticalAlignment="Center" Grid.Row="4" Margin="0,5"/>
                <CheckBox Name="CkCOVEnable" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"  Margin="0,5"
                  IsChecked="{Binding COVEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3" x:FieldModifier="public" Name="CheckCOVEnableErr"
            Content="{Binding ElementName=CkCOVEnable, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBTxDataSize" Text="{x:Static properties:Resources.DataSize}" Grid.Row="5" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Name="TxDataSize" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding DataSize, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" />
                <ContentPresenter Grid.Row="5" Grid.Column="3" 
            Content="{Binding ElementName=TxDataSize, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBTxArrayIndex" Text="{x:Static properties:Resources.ArrayIndex}" Grid.Row="6" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Name="TxArrayIndex" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding ArrayIndex, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" />
                <ContentPresenter Grid.Row="6" Grid.Column="3" 
            Content="{Binding ElementName=TxArrayIndex, Path=(Validation.Errors).CurrentItem}"/>


                <TextBlock Name="TxBPriorityLevel" Text="{x:Static properties:Resources.PriorityLevel}" Grid.Row="8" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Name="CmbPriorityLevel" Grid.Column="2" Grid.Row="8" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding PriorityLevel, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"  />
                <ContentPresenter Grid.Row="8" Grid.Column="3" 
            Content="{Binding ElementName=CmbPriorityLevel, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
