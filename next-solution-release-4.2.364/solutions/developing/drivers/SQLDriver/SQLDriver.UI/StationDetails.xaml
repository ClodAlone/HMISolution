<UserControl x:Class="SQLDriver.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:SQLDriver.UI.Properties"
             mc:Ignorable="d" Height="300" Width="600"
             d:DesignHeight="100" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="1" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.SQLDriverTableName}" Grid.Row="0" Margin="0,1" VerticalAlignment="Center" x:FieldModifier="public" Name="SQLDriverServerText" />
                <TextBox Name="SQLDriverTableName" Grid.Column="2" Grid.Row="0" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                           Text="{Binding SQLDriverTableName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=SQLDriverTableName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBox Grid.Column="2" Grid.Row="0" Name="Table" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                          Text="{Binding SQLDriverTableName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"/>
                <TextBlock Text="{x:Static properties:Resources.SQLDriverColumnName}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="SQLDriverTableColumnName" Grid.Column="2" Grid.Row="1" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                           Text="{Binding SQLDriverColumnNameTagName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
                <TextBox Name="CmbSQLDriverColumnNameTagName" Grid.Column="2" Grid.Row="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  Text="{Binding SQLDriverColumnNameTagName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=CmbSQLDriverColumnNameTagName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.SQLDriverColumnValue}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="SQLDriverColumnValue" Grid.Column="2" Grid.Row="2" x:FieldModifier="public"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                           Text="{Binding SQLDriverColumnNameTagName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
                <TextBox Name="CmbSQLDriverColumnValue" Grid.Column="2" Grid.Row="2"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  Text="{Binding SQLDriverColumnValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=CmbSQLDriverColumnValue, Path=(Validation.Errors).CurrentItem, UpdateSourceTrigger=PropertyChanged}"/>

	            <TextBlock Text="{x:Static properties:Resources.SQLMultiColumn}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
	            <CheckBox  Grid.Row="3" Grid.Column="2" Name="EnableMultiColumn" VerticalAlignment="Center" Margin="5" Validation.ErrorTemplate="{x:Null}"
	                      IsChecked="{Binding SQLDriverMultiColumn, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />
	            <ContentPresenter Grid.Row="3" Grid.Column="3" 
	            Content="{Binding ElementName=EnableMultiColumn, Path=(Validation.Errors).CurrentItem, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
