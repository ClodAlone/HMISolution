<UserControl x:Class="CoDeSys.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CoDeSys.UI.Properties"
             mc:Ignorable="d" Height="300" Width="400" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>              
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid> <!--x:Name="MainGrid">-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Stretch" Background="Transparent" />

                <TextBlock Name="TextConnectionType" Text="{x:Static properties:Resources.ConnectionType}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <ComboBox Name="CmbConnectionType" Grid.Column="2" Grid.Row="0" IsEditable="False" Margin="0,5" 

                          HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding ConnectionType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CmbConnectionType_SelectionChanged" />
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=CmbConnectionType, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblDeviceName" Text="{x:Static properties:Resources.DeviceName}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" />
                <TextBox Name="TxTDeviceName" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,5"
        		    Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
        		    Content="{Binding ElementName=TxTDeviceName, Path= (Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblDeviceAddress" Text="{x:Static properties:Resources.DeviceAddress}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="TxTDeviceAddress" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding DeviceAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                    Content="{Binding ElementName=TxTDeviceAddress, Path=(Validation.Errors).CurrentItem}"/>

                <!--<TextBlock Name="TextPlcVersion" Text="{x:Static properties:Resources.PlcVersion}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <ComboBox Name="CmbPlcVersion" Grid.Column="2" Grid.Row="3" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding PlcVersion, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=CmbPlcVersion, Path=(Validation.Errors).CurrentItem}"/>-->

                <TextBlock Name="lblPlcPort" Text="{x:Static properties:Resources.PlcPort}"  VerticalAlignment="Center" Grid.Row="4" Margin="0,1"/>
                <TextBox Name="TextPlcPort" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" Margin="0,5" 
                     Text="{Binding PlcPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
                Content="{Binding ElementName=PlcPort, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblUserPLC" Text="{x:Static properties:Resources.UserPLC}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
                <TextBox Name="TxTUserPLC" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding UserPLC, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3" 
                    Content="{Binding ElementName=TxTUserPLC, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="lblPasswordPLC" Text="{x:Static properties:Resources.PasswordPLC}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1"/>
                <TextBox Name="TxTPasswordPLC" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding PasswordPLC, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="6" Grid.Column="3" 
                    Content="{Binding ElementName=TxTUserPLC, Path=(Validation.Errors).CurrentItem}"/>

                <!--<TextBlock Name="lblPasswordGateWay" Text="{x:Static properties:Resources.PasswordGateWay}" VerticalAlignment="Center" Grid.Row="7" Margin="0,1"/>
                <TextBox Name="TxTPasswordGateWay" Grid.Column="2" Grid.Row="7" HorizontalAlignment="Stretch"
                     Text="{Binding PasswordGateWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="7" Grid.Column="3" 
                    Content="{Binding ElementName=TxTPasswordGateWay, Path=(Validation.Errors).CurrentItem}"/>-->

                <TextBlock Name="lblCyclicListUdateRate" Text="{x:Static properties:Resources.CyclicListUdateRate}"  VerticalAlignment="Center" Grid.Row="8" Margin="0,1"/>
                <TextBox Name="TxTCyclicListUdateRate"  Grid.Column="2" Grid.Row="8" HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding CyclicListUdateRate, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="8" Grid.Column="3" 
                Content="{Binding ElementName=TxTCyclicListUdateRate, Path=(Validation.Errors).CurrentItem}"/>

                <!--<TextBlock Grid.Row="9" Text="{x:Static properties:Resources.Motorola}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textMotorola" Margin="0,1"/>
                <CheckBox  Grid.Row="9" Grid.Column="2" Name="Motorola" VerticalAlignment="Center" Margin="5"
                            x:FieldModifier="public" IsChecked="{Binding Motorola, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />-->

                <!--<TextBlock Name="TextBufferSize" Text="{x:Static properties:Resources.BufferSize}"  VerticalAlignment="Center" Grid.Row="10" Margin="0,1"/>
                <TextBox Grid.Column="2" Grid.Row="10" HorizontalAlignment="Stretch"
                     Text="{Binding BufferSize, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="10" Grid.Column="3" 
                Content="{Binding ElementName=BufferSize, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Grid.Row="11" Text="{x:Static properties:Resources.LogIn}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textLogIn" Margin="0,1"/>
                <CheckBox  Grid.Row="11" Grid.Column="2" Name="LogIn" VerticalAlignment="Center" Margin="5"
                            x:FieldModifier="public" IsChecked="{Binding LogIn, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />-->

                <!--<TextBlock Name="TextProtocol" Text="{x:Static properties:Resources.Protocol}" VerticalAlignment="Center" Grid.Row="12" Margin="0,1"/>
                <ComboBox Name="CmbProtocol" Grid.Column="2" Grid.Row="12" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding Protocol, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="12" Grid.Column="3" 
                Content="{Binding ElementName=Protocol, Path=(Validation.Errors).CurrentItem}"/>-->

                <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.UseDirectReading}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUseDirectReading" Margin="0,5"/>
                <CheckBox  Grid.Row="13" Grid.Column="2" Name="chkUseDirectReading" VerticalAlignment="Center" Margin="0,5"
                            x:FieldModifier="public" IsChecked="{Binding UseDirectReading, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Name="lblMaxDynamicAggregation" Text="{x:Static properties:Resources.MaxDynamicAggregation}"  VerticalAlignment="Center" Grid.Row="14" Margin="0,5"/>
                <TextBox Name="TxtMaxDynamicAggregation" Grid.Column="2" Grid.Row="14" HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding MaxDynamicAggregation, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="14" Grid.Column="3" 
                Content="{Binding ElementName=TxtMaxDynamicAggregation, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.UsePing}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUsePing" Margin="0,5"/>
                <CheckBox  Grid.Row="15" Grid.Column="2" Name="chkUsePing" VerticalAlignment="Center" Margin="0,5"
                            x:FieldModifier="public" IsChecked="{Binding UsePing, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
