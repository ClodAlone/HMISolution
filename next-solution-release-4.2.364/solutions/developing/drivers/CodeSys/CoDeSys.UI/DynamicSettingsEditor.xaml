<UserControl x:Class="CoDeSys.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CoDeSys.UI.Properties"
             mc:Ignorable="d" Width="500" Height="200"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto" />
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="Auto"/>-->
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <GridSplitter Grid.Column="1" Grid.RowSpan="4" HorizontalAlignment="Stretch" Background="Transparent" />
                <TextBlock Text="{x:Static properties:Resources.VarName}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <TextBox Name="TxTAddress" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
                 Text="{Binding Address, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=TxTAddress, Path=(Validation.Errors).CurrentItem}"/>

                <!--<TextBlock Text="{x:Static properties:Resources.VarDataFormat}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
            <ComboBox Name="CmbVarType" Grid.Column="2" Grid.Row="1" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedValue="{Binding CoDeSysVarType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbVarType, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="CoDeStsTagFormat" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
            <ComboBox Name="CmbTagFormat" Grid.Column="2" Grid.Row="1" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  SelectedValue="{Binding TagFormat, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" >
            </ComboBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbTagFormat, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="CoDeSysABAddress" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
            <TextBox Name="StartAddr" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch"
                 Text="{Binding ABAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=StartAddr, Path=(Validation.Errors).CurrentItem}"/>-->

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
