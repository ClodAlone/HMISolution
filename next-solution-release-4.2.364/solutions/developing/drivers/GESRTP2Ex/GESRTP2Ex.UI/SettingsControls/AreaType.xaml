<UserControl x:Class="GESRTP2.UI.SettingsControls.AreaType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:GESRTP2.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static properties:Resources.AreaType}" VerticalAlignment="Center" Margin="0,1"/>
        <ComboBox Name="CmbAreaType" Grid.Column="2" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                      SelectedValue="{Binding AreaType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
        <ContentPresenter Grid.Column="3" 
                Content="{Binding ElementName=CmbAreaType, Path=(Validation.Errors).CurrentItem}"/>

    </Grid>
</UserControl>
