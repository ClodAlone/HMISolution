<UserControl x:Class="OmronEthernetIP.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:OmronEthernetIP.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock Text="{x:Static properties:Resources.TagFormat}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <ComboBox Name="CmbTagFormat" Grid.Column="2" Grid.Row="0" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding  TagFormat, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" >
                </ComboBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=CmbTagFormat, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.ABAddress}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="StartAddr" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding ABAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=StartAddr, Path=(Validation.Errors).CurrentItem}"/>

	            <TextBlock Name="TxStructStringLength" Text="{x:Static properties:Resources.StructureStringLengths}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
	            <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKPStructStringLength" >
	                <Button DockPanel.Dock="Right" Click="ResetStructStringLength_Click">
	                  <Button.Content>
	                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
	                  </Button.Content>
	                </Button>
	                <Button DockPanel.Dock="Right" Click="SetStructStringLength_Click">
	                  <Button.Content>
	                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
	                  </Button.Content>
	                </Button>
	                <TextBox Name="TbStructStringLength"
	                     Text="{Binding StructStringFieldLengths, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
	            </DockPanel>
	            <ContentPresenter Grid.Row="2" Grid.Column="3"
	            Content="{Binding ElementName=TbStructStringLength, Path=(Validation.Errors).CurrentItem}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
