<UserControl x:Class="Demo.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:baseproperties="clr-namespace:DriverCodeBaseEx.UI.Properties;assembly=DriverCodeBaseEx.UI"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" Width="600" Height="300"
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dx:DXTabControl Name="tabGeneral" >
            <dx:DXTabItem Name="GeneralSettings" Header="{x:Static baseproperties:Resources.GeneralSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="MainStack" Orientation="Vertical">
                    </StackPanel>
                </ScrollViewer>
            </dx:DXTabItem>
            <dx:DXTabItem Name="ChannelSettings" Header="{x:Static baseproperties:Resources.ChannelsSettings}">
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
