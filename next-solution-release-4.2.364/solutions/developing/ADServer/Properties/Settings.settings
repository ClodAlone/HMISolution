<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="ADServer.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="UsersExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">users</Value>
    </Setting>
    <Setting Name="TypeLabel" Type="System.String" Scope="User">
      <Value Profile="(Default)">Settings</Value>
    </Setting>
    <Setting Name="DefaultPersistenceFileExt" Type="System.String" Scope="User">
      <Value Profile="(Default)">.pers</Value>
    </Setting>
    <Setting Name="LogPath" Type="System.String" Scope="User">
      <Value Profile="(Default)">Log\DispatcherLog.xml</Value>
    </Setting>
    <Setting Name="NetCoreLogPath" Type="System.String" Scope="User">
      <Value Profile="(Default)">Log\DispatcherLog.log</Value>
    </Setting>
  </Settings>
</SettingsFile>