<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:WebHMIProjectWizardPlugin.Properties"
    xmlns:converters="clr-namespace:WizardPluginHelpers.Converters;assembly=WizardPluginHelpers"   
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="WebHMIProjectWizardPlugin.ProjectWizardPathAndType"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    mc:Ignorable="d"
    HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
            <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

  <Grid HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label HorizontalAlignment="Left" x:Name="projectName"
             Content="{x:Static properties:Resources.ProjectName}" />
        <TextBox Text="{Binding ProjectName}" VerticalAlignment="Top"  HorizontalAlignment="Stretch"
               Grid.Row="1" x:Name="textBoxProjectName"  KeyboardNavigation.DirectionalNavigation="None"
               Height="Auto" />

        <Label Grid.Row="2" HorizontalAlignment="Left" Margin="0,10,0,0" x:Name="projectFolder"
            Content="{x:Static properties:Resources.ProjectFolder}" />
        <DockPanel LastChildFill="True" Grid.Row="3" HorizontalAlignment="Stretch">
            <Button Margin="2,0,0,0" DockPanel.Dock="Right"
                    HorizontalAlignment="Left"  MinWidth="40" x:Name="btnBrowse" Click="btnBrowse_Click">
                <Button.Content>
                    <Image Source="{StaticResource OpenFolder}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox Text="{Binding Path=ProjectPath,Mode=OneWay}"
             VerticalAlignment="Top"  HorizontalAlignment="Left" IsEnabled="False"
             Grid.Row="2" TextWrapping="Wrap" x:Name="textBoxProjectPath"
             MinWidth="478" Height="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
