<UserControl x:Class="ClientEditor.Controls.NewAppNameEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ClientEditor.Properties"
             FocusManager.FocusedElement="{Binding ElementName=txtName}"
             mc:Ignorable="d" Height="100" Width="250"
             d:DesignHeight="100" d:DesignWidth="250">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Content="{x:Static properties:Resources.AppName}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="txtName" Grid.Column="1"/>
    </Grid>
</UserControl>
