<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:properties="clr-namespace:ClientEditor.Properties"
    xmlns:local="clr-namespace:ClientEditor.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Class="ClientEditor.Controls.AppNameSettingsEditor" 
    mc:Ignorable="d" 
    Height="400" Width="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:DisplayNameConverter x:Key="DisplayNameConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dxlc:LayoutControl Orientation="Vertical" >
            <dxlc:LayoutGroup>
                <dxlc:LayoutGroup HorizontalAlignment="Left" dxlc:LayoutControl.AllowHorizontalSizing="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" x:Name="stackAdd">
                            <Button Click="ButtonAdd_Click" ToolTip="{x:Static properties:Resources.AddAppNameHelp}">
                                <Button.Content>
                                    <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                            <Button x:Name="btnDelete" Click="ButtonDelete_Click" ToolTip="{x:Static properties:Resources.RemoveAppNameHelp}"
                                IsEnabled="{Binding SelectedItems.Count, ElementName=listboxItems}">
                                <Button.Content>
                                    <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                            <Button Click="ButtonFetch_Click" ToolTip="{x:Static properties:Resources.FetchHelp}">
                                <Button.Content>
                                    <Image Margin="2" Source="{StaticResource RefreshSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.CurrentItem}" Margin="0,10,10,2" />
                        <dxe:ListBoxEdit Grid.Row="2" x:Name="listboxItems" MouseDoubleClick="listboxItems_MouseDoubleClick"
                                        SelectedItem="{Binding ElementName=layoutItems, Path=DataContext, Mode=TwoWay}" 
                                    HorizontalAlignment="Stretch" Margin="0,0,0.4,0" VerticalAlignment="Stretch" />
                    </Grid>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
                        <!--<dxlc:DataLayoutControl x:Name="layoutItems" CurrentItem="{Binding Data4}" Background="Transparent"/>-->
                      <Grid x:Name="layoutItems" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <!--empty space for Connect Items At Startup-->
                          <RowDefinition Height="0" />
                          <RowDefinition Height="50" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="50" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MinWidth="100" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,0,10" Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" VerticalAlignment="Center" Text="{x:Static properties:Resources.AppNameServerConnectionGroup}" />
                        <TextBlock Margin="0,0,0,10" Grid.Row="7" Grid.ColumnSpan="2" FontWeight="Bold" VerticalAlignment="Center" Text="{x:Static properties:Resources.AppNameBackupServerConnectionGroup}" />
                        <TextBlock Margin="0,0,0,10" Grid.Row="11" Grid.ColumnSpan="2" FontWeight="Bold" VerticalAlignment="Center" Text="{x:Static properties:Resources.AppNameDefaultClientSessionGroup}" />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding HostNameRenamed, Converter={StaticResource DisplayNameConverter}, ConverterParameter=HostNameRenamed}" />
                        <DockPanel Grid.Row="1" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right"
                                  Tag="{Binding HostNameRenamed, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="String_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Width="16" />
                            </Button.Content>
                          </Button>
                          <TextBox Margin="10,0,0,0" Text="{Binding HostNameRenamed, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          x:Name="textHostNameRenamed" />
                        </DockPanel>


                        <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="{Binding BackupHostName, Converter={StaticResource DisplayNameConverter}, ConverterParameter=BackupHostName}" />
                        <DockPanel Grid.Row="8" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right"
                                  Tag="{Binding BackupHostName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="String_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <TextBox Margin="10,0,0,0" Text="{Binding BackupHostName, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          x:Name="textBackupHostName" />
                        </DockPanel>


                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding EndpointRenamed, Converter={StaticResource DisplayNameConverter}, ConverterParameter=EndpointRenamed}" />
                        <DockPanel Grid.Row="3" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                  Tag="{Binding EndpointRenamed, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="String_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <TextBox Margin="10,0,0,0" Text="{Binding EndpointRenamed, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          x:Name="textEndpointRenamed" />
                        </DockPanel>


                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{Binding AlwaysDiscoverEndpoint, Converter={StaticResource DisplayNameConverter}, ConverterParameter=AlwaysDiscoverEndpoint}" />
                        <DockPanel Grid.Row="4" Grid.Column="1" LastChildFill="True">
                          <CheckBox Margin="10,0,0,0" IsChecked="{Binding AlwaysDiscoverEndpoint, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          x:Name="textAlwaysDiscoverEndpoint" />
                        </DockPanel>

                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding AppNameRenamed, Converter={StaticResource DisplayNameConverter}, ConverterParameter=AppNameRenamed}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                  Tag="{Binding AppNameRenamed, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="String_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <TextBox Margin="10,0,0,0" Text="{Binding AppNameRenamed, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          x:Name="textAppNameRenamed" />
                        </DockPanel>


                        <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="{Binding BackupAppName, Converter={StaticResource DisplayNameConverter}, ConverterParameter=BackupAppName}" />
                        <DockPanel Grid.Row="9" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                  Tag="{Binding BackupAppName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="String_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <TextBox Margin="10,0,0,0" Text="{Binding BackupAppName, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          x:Name="textBackupAppName" />
                        </DockPanel>
      
                        <TextBlock Grid.Row="20" Text="{Binding UseSecurityWhenNotLocal, Converter={StaticResource DisplayNameConverter}, ConverterParameter=UseSecurityWhenNotLocal}" />
                        <DockPanel Grid.Row="20" Grid.Column="1" LastChildFill="True">
                          <CheckBox Margin="10,0,0,0" IsChecked="{Binding UseSecurityWhenNotLocal, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          x:Name="textUseSecurityWhenNotLocal" />
                        </DockPanel>



                        <TextBlock Grid.Row="17" VerticalAlignment="Center" Text="{Binding RemoveDisabledItemAfterSecs, Converter={StaticResource DisplayNameConverter}, ConverterParameter=RemoveDisabledItemAfterSecs}" />
                        <DockPanel Grid.Row="17" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                  Tag="{Binding RemoveDisabledItemAfterSecs, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="RemoveDisabledItemAfterSecs_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <dxe:SpinEdit Margin="10,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                        MinValue="0"  MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" Validation.ErrorTemplate="{x:Null}"
                                        Name="textRemoveDisabledItemAfterSecs" 
                                        VerticalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" 
                                        EditValue="{Binding RemoveDisabledItemAfterSecs, UpdateSourceTrigger=PropertyChanged}">
                          </dxe:SpinEdit>
                        </DockPanel>
                        <ContentPresenter Grid.Row="17" Grid.Column="3"
                        Content="{Binding ElementName=textRemoveDisabledItemAfterSecs, Path=(Validation.Errors).CurrentItem}"/>


                        <TextBlock Grid.Row="18" VerticalAlignment="Center" Text="{Binding MaxCleanCount, Converter={StaticResource DisplayNameConverter}, ConverterParameter=MaxCleanCount}" />
                        <DockPanel Grid.Row="18" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                  Tag="{Binding MaxCleanCount, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="MaxCleanCount_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <dxe:SpinEdit Margin="10,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                        MinValue="0"  MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" Validation.ErrorTemplate="{x:Null}"
                                        Name="textMaxCleanCount" 
                                        VerticalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                                        EditValue="{Binding MaxCleanCount, UpdateSourceTrigger=PropertyChanged}">
                          </dxe:SpinEdit>
                        </DockPanel>
                        <ContentPresenter Grid.Row="18" Grid.Column="3"
                        Content="{Binding ElementName=textMaxCleanCount, Path=(Validation.Errors).CurrentItem}"/>


                        <TextBlock Grid.Row="19" VerticalAlignment="Center" Text="{Binding UseAlwaysSecureConnections, Converter={StaticResource DisplayNameConverter}, ConverterParameter=UseAlwaysSecureConnections}" />
                        <DockPanel Grid.Row="19" Grid.Column="1" LastChildFill="True">
                          <CheckBox Margin="10,0,0,0" IsChecked="{Binding UseAlwaysSecureConnections, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                          x:Name="textUseAlwaysSecureConnections" />
                        </DockPanel>

                      <TextBlock Grid.Row="14" VerticalAlignment="Center" Text="{Binding FastSamplingInterval, Converter={StaticResource DisplayNameConverter}, ConverterParameter=FastSamplingInterval}" />
                      <DockPanel Grid.Row="14" Grid.Column="1" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                Tag="{Binding FastSamplingInterval, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="FastSamplingInterval_Clear">
                          <Button.Content>
                            <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                          </Button.Content>
                        </Button>
                        <dxe:SpinEdit Margin="10,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                        MinValue="0"  MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" Validation.ErrorTemplate="{x:Null}"
                                      Name="textFastSamplingInterval" 
                                      VerticalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                                      EditValue="{Binding FastSamplingInterval, UpdateSourceTrigger=PropertyChanged}">
                        </dxe:SpinEdit>
                      </DockPanel>
                        <ContentPresenter Grid.Row="14" Grid.Column="3"
                        Content="{Binding ElementName=textFastSamplingInterval, Path=(Validation.Errors).CurrentItem}"/>


                      <TextBlock Grid.Row="15" VerticalAlignment="Center" Text="{Binding SlowSamplingInterval, Converter={StaticResource DisplayNameConverter}, ConverterParameter=SlowSamplingInterval}" />
                      <DockPanel Grid.Row="15" Grid.Column="1" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                Tag="{Binding SlowSamplingInterval, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="SlowSamplingInterval_Clear">
                          <Button.Content>
                            <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                          </Button.Content>
                        </Button>
                        <dxe:SpinEdit Margin="10,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                        MinValue="0"  MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" Validation.ErrorTemplate="{x:Null}"
                                      Name="textSlowSamplingInterval" 
                                      VerticalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                                      EditValue="{Binding SlowSamplingInterval, UpdateSourceTrigger=PropertyChanged}">
                        </dxe:SpinEdit>
                      </DockPanel>
                        <ContentPresenter Grid.Row="15" Grid.Column="3"
                        Content="{Binding ElementName=textSlowSamplingInterval, Path=(Validation.Errors).CurrentItem}"/>



                        <TextBlock Grid.Row="16" VerticalAlignment="Center" Text="{Binding DisableWhenNotUsed, Converter={StaticResource DisplayNameConverter}, ConverterParameter=DisableWhenNotUsed}" />
                        <DockPanel Grid.Row="16" Grid.Column="1" LastChildFill="True">
                          <CheckBox Margin="10,0,0,0" IsChecked="{Binding DisableWhenNotUsed, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                          x:Name="textDisableWhenNotUsed" />
                        </DockPanel>


                        <TextBlock Grid.Row="12" VerticalAlignment="Center" Text="{Binding PublishingInterval, Converter={StaticResource DisplayNameConverter}, ConverterParameter=PublishingInterval}" />
                        <DockPanel Grid.Row="12" Grid.Column="1" LastChildFill="True">
                          <Button DockPanel.Dock="Right" Height="{Binding Path=Height, ElementName=textHostNameRenamed}"
                                  Tag="{Binding PublishingInterval, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="PublishingInterval_Clear">
                            <Button.Content>
                              <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                            </Button.Content>
                          </Button>
                          <dxe:SpinEdit Margin="10,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                        MinValue="0"  MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" Validation.ErrorTemplate="{x:Null}"
                                        Name="textPublishingInterval" 
                                        VerticalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                                        EditValue="{Binding PublishingInterval, UpdateSourceTrigger=PropertyChanged}">
                          </dxe:SpinEdit>
                        </DockPanel>
                        <ContentPresenter Grid.Row="12" Grid.Column="3"
                        Content="{Binding ElementName=textPublishingInterval, Path=(Validation.Errors).CurrentItem}"/>

                        <TextBlock Grid.Row="13" VerticalAlignment="Center" Text="{Binding UsePollingRead, Converter={StaticResource DisplayNameConverter}, ConverterParameter=UsePollingRead}" />
                        <DockPanel Grid.Row="13" Grid.Column="1" LastChildFill="True">
                            <CheckBox Margin="10,0,0,0" IsChecked="{Binding UsePollingRead, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                        x:Name="textUsePollingRead" />
                        </DockPanel>
                      </Grid>
                    </ScrollViewer>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</UserControl>
