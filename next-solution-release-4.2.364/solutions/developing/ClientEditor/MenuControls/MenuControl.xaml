<wpfutilities:BarManagerBase
    xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities" x:Class="ClientEditor.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:self="clr-namespace:ClientEditor"
             xmlns:properties="clr-namespace:ClientEditor.Properties"
             xmlns:menucontrols="clr-namespace:ClientEditor.MenuControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="ClientBarManager"
             mc:Ignorable="d">
  <dxb:BarManager.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/Client.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarManager.Resources>
    <dxb:BarManager.CommandBindings>
        <CommandBinding Command="{x:Static self:UIGeneralCommands.ShowToolbar}" 
                    Executed="OnShowToolbar" 
                    CanExecute="CanAlwaysExecute" />
    </dxb:BarManager.CommandBindings>
    <dxb:BarManager.Items>
        <menucontrols:BarCommonItems x:Name="menuItems" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}" />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="clientMenu">
          <dxb:BarSubItemLink BarItemName="biViewClient" MergeType="MergeItems" />
          <dxb:BarSubItemLink BarItemName="biProjectClient" MergeType="MergeItems" />
        </dxb:Bar>
    </dxb:BarManager.Bars>
</wpfutilities:BarManagerBase>
