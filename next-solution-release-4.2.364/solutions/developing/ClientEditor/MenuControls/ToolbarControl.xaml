<dxb:BarManager
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="ClientEditor.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientEditor.MenuControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="ClientBarManagerToolbar"
             mc:Ignorable="d">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="clientToolbar" x:Name="clientToolBar1"
                GlyphSize="Small" ShowDragWidget="True"
                AllowCustomizationMenu="False"
                AllowDrop="False"
                AllowHide="False"
                AllowCollapse="False"
                AllowQuickCustomization="False">
          <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddFolder"/>
          <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddTag"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
