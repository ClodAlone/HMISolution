<UserControl x:Class="ImportWizardPlugin.Controls.ControlMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImportWizardPlugin"
             Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBox Text="{Binding TextMessage}" IsReadOnly="True" x:Name="textBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10" FontFamily="Segoe UI" FontWeight="Normal" FontSize="18" TextWrapping="WrapWithOverflow"
         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
