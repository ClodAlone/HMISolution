<UserControl x:Class="Toolbox.ToolBoxUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Toolbox"
        Height="300" Width="300" KeyDown="UserControl_KeyDown"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
        xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
        xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities">
    <UserControl.Resources>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
      <dxg:TreeListControl x:Key="treeListControl" SelectionMode="Row" x:Shared="False"
                                  SelectionChanged="treeListControl_SelectionChanged">
        <dxg:TreeListControl.Columns>
          <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="ItemHeader" />
          <!-- Validate="OnTreeHeaderValidate" -->
        </dxg:TreeListControl.Columns>
        <dxg:TreeListControl.View>
          <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                  MultiSelectMode="None"
                                  ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                  AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                  ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                  BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch"  VerticalAlignment="Top"
                                  IsSynchronizedWithCurrentItem="True" AllowDragDrop="False" RowDoubleClick="OnRowDoubleClick"
                                  NodeChanged="OnTreeNodeChanged" NodeExpanding="OnTreeNodeExpanding"  NodeCollapsing="OnTreeNodeCollapsing"
                                  AutoWidth="True" DropRecord="TreeListControl_DragEnd" DragRecordOver="TreeListControl_DragRecordOver"
                                  StartRecordDrag="TreeListControl_DragStart" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop">
            <!--<dxg:TreeListView.RowStyle>
              <Style TargetType="{x:Type dxg:RowControl}">
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </dxg:TreeListView.RowStyle>-->
            <dxg:TreeListView.CellStyle>
              <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
              </Style>
            </dxg:TreeListView.CellStyle>
          </dxg:TreeListView>
        </dxg:TreeListControl.View>
      </dxg:TreeListControl>

    </UserControl.Resources>
    <Grid>
        <dxb:BarManager.DXContextMenu>
            <dxb:PopupMenu x:Name="contextMenu">
                <dxb:PopupMenu.Items>
                    <dxb:BarButtonItem ItemClick="MenuItemReset_Click" Content="Reset"/>
                </dxb:PopupMenu.Items>
            </dxb:PopupMenu>
        </dxb:BarManager.DXContextMenu>

        <dx:DXTabControl x:Name="tabControl"/>
      
        <TextBlock FontFamily="Segoe UI" FontSize="30" Grid.RowSpan="30"
                            VerticalAlignment="Center" TextWrapping="WrapWithOverflow"
                            HorizontalAlignment="Center" x:Name="txtNoLibrary"
                            FontWeight="Light" Text="{x:Static local:Properties.Resources.NoTools}"/>
    </Grid>
</UserControl>
