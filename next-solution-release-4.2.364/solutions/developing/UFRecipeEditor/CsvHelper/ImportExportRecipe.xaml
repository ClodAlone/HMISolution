<UserControl x:Class="UFRecipeEditor.CsvHelper.ImportExportRecipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties"
             xmlns:converters="clr-namespace:UFRecipeEditor.Converters"
             xmlns:local="clr-namespace:UFRecipeEditor.CsvHelper"
             mc:Ignorable="d"  Width="500" Height="450">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TextToBooleanConverter x:Key="TextToBooleanConverter" />
            <converters:SeparatorOptionToVisibilityConverter x:Key="SeparatorOptionToVisibilityConverter" />
            <converters:ImportActionTypeToBooleanConverter x:Key="ImportActionTypeToBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Margin="2" FontWeight="Bold" Header="{x:Static properties:Resources.ImportExportDialogCsvFile}">
            <DockPanel Margin="5">
                <Button DockPanel.Dock="Right"  Margin="2" MinWidth="30" Content="..." Click="SelectFile_Click" />
                <TextBox IsReadOnly="True" Margin="2" TextWrapping="Wrap" Text="{Binding FilePath, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
            </DockPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Margin="2" FontWeight="Bold" Header="{x:Static properties:Resources.ImportExportDialogSeparatorChar}" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Margin="2" x:Name="comboSeparatorType" 
                          SelectedItem="{Binding SeparatorOption, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
                <TextBox Margin="2" x:Name="txtSeparatorChar" Grid.Column="1" MinWidth="50"
                         Visibility="{Binding SelectedItem, ElementName=comboSeparatorType, Mode=OneWay, Converter={StaticResource SeparatorOptionToVisibilityConverter}}"
                         Text="{Binding SeparatorChar, ValidatesOnDataErrors=True, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" 
                         MaxLength="{Binding SeparatorLenght, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                         Validation.ErrorTemplate="{x:Null}" />
                <ContentPresenter Grid.Row="1" Grid.Column="2" 
                              Content="{Binding ElementName=txtSeparatorChar, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </GroupBox>
        <GroupBox Margin="2" Grid.Row="2" FontWeight="Bold" Header="{x:Static properties:Resources.ImportExportDialogActionType}">
            <StackPanel Margin="5">
                <RadioButton Margin="2" Content="{x:Static properties:Resources.ImportExportDialogActionTypeClean}"
                             IsChecked="{Binding ImportActionType, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, 
                                        Converter={StaticResource ImportActionTypeToBooleanConverter}, ConverterParameter={x:Static local:ImportActionType.CleanBefore}}" />
                <RadioButton Margin="2" Content="{x:Static properties:Resources.ImportExportDialogActionTypeMerge}"
                             IsChecked="{Binding ImportActionType, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, 
                                        Converter={StaticResource ImportActionTypeToBooleanConverter}, ConverterParameter={x:Static local:ImportActionType.MergeDuplicates}}" />
                <RadioButton Margin="2" Content="{x:Static properties:Resources.ImportExportDialogActionTypeSkip}"
                             IsChecked="{Binding ImportActionType, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, 
                                        Converter={StaticResource ImportActionTypeToBooleanConverter}, ConverterParameter={x:Static local:ImportActionType.SkipDuplicates}}" />
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="3" Margin="2" 
                  FontWeight="Bold" Header="{x:Static properties:Resources.ImportExportDialogTrace}" >
            <ScrollViewer x:Name="scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="txtOutput" Background="{x:Null}" BorderBrush="{x:Null}" IsReadOnly="True" />
            </ScrollViewer>
        </GroupBox>
        <Grid Grid.Row="4" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <!--<ColumnDefinition />-->
            </Grid.ColumnDefinitions>
            <Button Margin="2" Grid.Column="0" Content="{x:Static properties:Resources.ImportExportDialogImportCommand}" 
                    Command="{Binding ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
            <Button Margin="2" Grid.Column="1" Content="{x:Static properties:Resources.ImportExportDialogExportCommand}" 
                    Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
            <!--<Button Margin="2" Grid.Column="2" Content="{x:Static properties:Resources.ImportExportDialogCloseCommand}" IsCancel="True" />-->
        </Grid>
    </Grid>
</UserControl>
