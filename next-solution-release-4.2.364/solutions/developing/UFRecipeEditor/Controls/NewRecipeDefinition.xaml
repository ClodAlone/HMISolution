<UserControl x:Class="UFRecipeEditor.Controls.NewRecipeDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties" 
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:commontemplate="clr-namespace:OPCUAViewModel.PropertyDataTemplate;assembly=OPCUAViewModel"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" Width="450" Height="480"
             d:DesignHeight="480" d:DesignWidth="450">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewRecipeDefinitionTitle}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewRecipeDefinitionRecipeName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecipeName, Mode=OneWay}" IsReadOnly="True"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="textEditName" />

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewRecipeDefinitionDescription}" VerticalAlignment="Center" />
            <Grid x:Name="gridDesc" Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="textEditDesc" />
                <Button Click="textEditDesc_Click" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="textEditDesc_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>

            <TextBlock  x:Name="textBlockMaxLength" Grid.Row="3" Text="{x:Static properties:Resources.NewRecipeDefinitionMaxLength}" VerticalAlignment="Center" />
            <dxe:SpinEdit Grid.Row="3" MinValue="1" Grid.Column="1" MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding MaxLength, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="3" Grid.Column="2" 
            Content="{Binding ElementName=textMaxLength, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewRecipeDefinitionDynamicSettings}" VerticalAlignment="Center" x:Name="textDynamicSettings"/>
            <Grid Grid.Column="1" Grid.Row="4" x:Name="gridDynamic">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding DynamicSettingsForEditing}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="0"/>
                <Button HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="Button_Click" Grid.Column="1">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2"  Click="Button_Clear" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.NewRecipeDefinitionConnectionString}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Grid.Row="6" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ReadableConnectionString, UpdateSourceTrigger=PropertyChanged}" 
                 Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                 x:Name="textEditConnection" TextWrapping="Wrap" IsReadOnly="False" />
                <Button Grid.Column="1" Click="textEditConnection_DefaultButtonClick" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2"  Click="textEditConnection_ClearButtonClick" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <ContentPresenter Grid.Row="6" Grid.Column="2" 
            Content="{Binding ElementName=textEditConnection, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeList}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="7" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeList" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="7" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTagTagRecipeList, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeIndex}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeIndex" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="8" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTagTagRecipeIndex, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeState}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="9" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeState" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="9" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTag, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeLoad}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="10" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeLoad" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="10" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTag, Path=(Validation.Errors).CurrentItem}"/>
            
            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeSave}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="11" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeSave" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="11" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTag, Path=(Validation.Errors).CurrentItem}"/>
            
            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeDelete}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="12" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeDelete" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="12" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTag, Path=(Validation.Errors).CurrentItem}"/>
            
            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeWrite}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="13" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeWrite" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="13" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTag, Path=(Validation.Errors).CurrentItem}"/>
            
            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.NewDataValueDefinitionTagRecipeRead}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="14" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagRecipeRead" AllowDataSync="False" AllowRemoteServer="True" />
            </DockPanel>
            <ContentPresenter Grid.Row="14" Grid.Column="2" 
                              Content="{Binding ElementName=uriColumnTag, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
