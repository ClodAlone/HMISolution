<UserControl x:Class="UFRecipeEditor.Controls.NewConfigurationSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties"
             xmlns:converters="clr-namespace:CommonControls.Converters;assembly=CommonControls"
             xmlns:wpfc="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:component="clr-namespace:UFRecipeEditor.ComponentService"
             mc:Ignorable="d" d:DesignHeight="1024" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ConnectionStringConverter x:Key="ConnectionStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.CSHeader}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.CSApplicationName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApplicationName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textApplicationName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textApplicationName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.CSEventsDefConnection}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Grid.Row="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                         x:Name="textEditEventConnection">
                    <TextBox.Text>
                        <MultiBinding Converter="{StaticResource ConnectionStringConverter}" UpdateSourceTrigger="PropertyChanged">
                            <Binding Path="EventDefaultConnection" Mode="TwoWay" ValidatesOnDataErrors="True" />
                            <Binding Path="Workspace" Source="{x:Static component:RecipeEditorManagerComponent.recipeEditorManagerComponent}" Mode="OneWay" />
                        </MultiBinding>
                    </TextBox.Text>
                </TextBox>
                <Button Grid.Column="1" Click="textEditEventConnection_DefaultButtonClick" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2" Click="textEditEventConnection_DlgButton_Clear" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <ContentPresenter Grid.Column="3" Content="{Binding ElementName=textEditEventConnection, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.CSEventsMaxAge}" VerticalAlignment="Center" />
            <wpfc:TimeSpanEdit x:Name="textEditMaxAge" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TimeSpan="{Binding EventMaxAge, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                               Validation.ErrorTemplate="{x:Null}" 
                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />
        </Grid>
    </ScrollViewer>
</UserControl>
