<dxb:BarSubItem
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="UFRecipeEditor.MenuControls.BarCommonItems"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFRecipeEditor"
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/Recipe.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewRecipe" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="140" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="140" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectRecipe" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="110" x:Name="biRecipeService" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">

            <dxb:BarButtonItem MergeOrder="20" x:Name="biAddNewGroup"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMadddatabase_32x32}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewGroup}" />
            <dxb:BarButtonItem MergeOrder="30" x:Name="biAddNewDataValue"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMAddPrototypesList_32x32}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewDataValue}" />

            <dxb:BarItemLinkSeparator MergeOrder="35" />

            <dxb:BarButtonItem MergeOrder="40" x:Name="biMoveTagUp"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMMoveTagUp}"  
                             Command="self:UIGeneralCommands.MoveTagUp" />
            <dxb:BarButtonItem MergeOrder="50" x:Name="biMoveTagDown"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMMoveTagDown}"  
                             Command="self:UIGeneralCommands.MoveTagDown" />

            <dxb:BarItemLinkSeparator MergeOrder="55"/>

            <dxb:BarButtonItem MergeOrder="56" x:Name="biCsvImportExport"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMcsv}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportRecipe}" />

            <dxb:BarItemLinkSeparator MergeOrder="58"/>

            <dxb:BarButtonItem MergeOrder="60" x:Name="biResetRecipeLayout"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMSynchronizeLayout}"  
                             Command="{x:Static self:UIGeneralCommands.ResetRecipeLayout}" />

            <dxb:BarButtonItem MergeOrder="70" x:Name="biCreateRecipeDatabase"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                            Glyph="{StaticResource RCPMSynchronizeDatabase}"  
                            Command="{x:Static self:UIGeneralCommands.CreateRecipeDatabase}" />

            <dxb:BarItemLinkSeparator MergeOrder="75"/>

            <dxb:BarSubItem MergeOrder="78" Content="{x:Static properties:Resources.ServerRibbonTitle}">
                <dxb:BarButtonItem x:Name="biStartServerText" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                       RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.StartServer}"
                                       Content="{x:Static properties:UICommandResource.StartServerText}" Glyph="{StaticResource RCPMStartServerSmall}"/>
                <dxb:BarButtonItem x:Name="biStopServerText" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                       RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.StopServer}"
                                       Content="{x:Static properties:UICommandResource.StopServerText}" Glyph="{StaticResource RCPMStopServerSmall}"/>
                <dxb:BarItemLinkSeparator/>
                <dxb:BarButtonItem x:Name="biCertificateChecker"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                   Glyph="{StaticResource RCPMCertificate}"
                                   Command="{x:Static self:UIGeneralCommands.CertificateChecker}" />
            </dxb:BarSubItem>

            <dxb:BarButtonItem MergeOrder="80" x:Name="biServiceManager"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMServiceManager32x32}"  
                             Command="{x:Static self:UIGeneralCommands.ServiceManager}" />

            <dxb:BarButtonItem MergeOrder="90" x:Name="biTestRecipeEditor" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource RCPMtestlayout}"  
                             Command="{x:Static self:UIGeneralCommands.TestRecipeEditor}" />

            <!--<dxb:BarButtonItem  
                             Glyph="{StaticResource RCPMRedCross2_32x32}"  
                             Command="ApplicationCommands.Delete" />-->
        </dxb:BarSubItem>
    </dxb:BarSubItem>
</dxb:BarSubItem>
