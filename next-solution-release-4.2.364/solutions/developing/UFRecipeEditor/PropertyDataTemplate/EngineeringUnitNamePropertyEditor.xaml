<UserControl x:Class="UFRecipeEditor.PropertyDataTemplate.EngineeringUnitNamePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image x:Name="cancelImg" Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <dxe:ComboBoxEdit
                    x:Name="uriLabel" 
                    Text="{Binding Path=Tag, ElementName=uriButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                    PopupOpening="uriLabel_PopupOpening" PreviewKeyDown="uriLabel_KeyDown" 
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
            </dxe:ComboBoxEdit>
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=uriButton, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
