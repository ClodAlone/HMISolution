<UserControl x:Class="UFRecipeEditor.UFRecipeEditorUI"
             xmlns:lc="clr-namespace:UFRecipeLayout;assembly=UFRecipeLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:self="clr-namespace:UFRecipeEditor"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d" Width="500" Height="300"
             d:DesignHeight="500" d:DesignWidth="300">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
    </ResourceDictionary>
  </UserControl.Resources>

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    Executed="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />

        <CommandBinding Command="ApplicationCommands.Redo"
                    Executed="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ServiceManager}" 
                    Executed="OnServiceManager" 
                    CanExecute="CanServiceManager" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewGroup}" 
                    Executed="OnAddNewGroup" 
                    CanExecute="CanAddNewGroup" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewDataValue}" 
                    Executed="OnAddNewDataValue" 
                    CanExecute="CanAddNewDataValue" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.MoveTagUp}" 
                    Executed="OnMoveTagUp" 
                    CanExecute="CanMoveTagUp" />
        
        <CommandBinding Command="{x:Static self:UIGeneralCommands.MoveTagDown}" 
                    Executed="OnMoveTagDown" 
                    CanExecute="CanMoveTagDown" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportRecipe}" 
                    Executed="OnImportExportRecipe" 
                    CanExecute="CanImportExportRecipe" />

        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ResetRecipeLayout}" 
                    Executed="OnResetRecipeLayout" 
                    CanExecute="CanResetRecipeLayout" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CreateRecipeDatabase}" 
                    Executed="OnCreateRecipeDatabase" 
                    CanExecute="CanCreateRecipeDatabase" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.TestRecipeEditor}" 
                    Executed="OnShowRecipeEditor" 
                    CanExecute="CanShowRecipeEditor" />

      <CommandBinding Command="{x:Static self:UIGeneralCommands.AddStringId}"
          Executed="OnAddStringId"
          CanExecute="CanAddStringId" />

    </UserControl.CommandBindings>

    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu">
            <dxb:PopupMenu.Items>

                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewGroup}" Content="{x:Static properties:UICommandResource.AddNewGroupText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewDataValue}" Content="{x:Static properties:UICommandResource.AddNewDataValueText}"/>

                <dxb:BarItemLinkSeparator />

                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.MoveTagUp}" Content="{x:Static properties:UICommandResource.MoveTagUpText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.MoveTagDown}" Content="{x:Static properties:UICommandResource.MoveTagDownText}"/>

                <dxb:BarItemLinkSeparator />

                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.ImportExportRecipe}" Content="{x:Static properties:UICommandResource.ImportExportRecipeText}"/>

                <dxb:BarItemLinkSeparator />

                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.ResetRecipeLayout}" Content="{x:Static properties:UICommandResource.ResetRecipeLayoutText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CreateRecipeDatabase}" Content="{x:Static properties:UICommandResource.CreateRecipeDatabaseText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.TestRecipeEditor}" Content="{x:Static properties:UICommandResource.TestRecipeEditorText}"/>

                <dxb:BarItemLinkSeparator />

                <dxb:BarSubItem Content="{x:Static self:Properties.UICommandResource.EditMenuText}">
                    <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                    <dxb:BarButtonItem Command="Properties" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                </dxb:BarSubItem>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

    <Grid>
        <dx:DXTabControl SelectionChanged="DXTabControl_SelectionChanged">
            <dx:DXTabControl.View>
                <dx:TabControlMultiLineView HeaderLocation="Bottom" />
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="treeListTab">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static properties:Resources.RecipeTreeView}" />
                    </StackPanel>
                </dx:DXTabItem.Header>
                
                <dxg:TreeListControl Name="treeListControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged">
                    <dxg:TreeListControl.Columns>
                        <dxg:TreeListColumn FieldName="ItemHeader" FilterPopupMode="Excel" Header="{x:Static self:Properties.Resources.RecipeConfiguration}" />
                        <dxg:TreeListColumn FieldName="OID" x:Name="MemberOrderColumn" SortMode="Custom" FilterPopupMode="Excel" Header="{x:Static self:Properties.Resources.DataValueOrderId}" />
                        <dxg:TreeListColumn FieldName="Type" Visible="False" FilterPopupMode="Excel" Header="{x:Static translatableMenu:Resources.ViewRibbonTitle}" />
                    </dxg:TreeListControl.Columns>
                    <dxg:TreeListControl.View>
                        <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                    PreviewDragOver="treeListControl_PreviewDragOver" CustomColumnSort="OnColumnSort"
                    StartRecordDrag="treeListControl_DragStart" CompleteRecordDragDrop="treeListControl_CompletedDragDrop"
                    PreviewQueryContinueDrag="treeListControl_PreviewQueryContinueDrag"
                    DropRecord="treeListControl_DragEnd" NodeChanged="OnTreeNodeChanged"
                    ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                    AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                    ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                    IsSynchronizedWithCurrentItem="True" AllowDragDrop="True" NodeExpanding="OnTreeNodeExpanding"
                    AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing" PreviewMouseDoubleClick="treeListControl_PreviewMouseDoubleClick">
                            <!-- HiddenEditor="OnHiddenEditor" PreviewDragOver="treeListControl_PreviewDragOver" PreviewDrop="treeListControl_PreviewDrop"
                    PreviewQueryContinueDrag="addressSpaceTree_PreviewQueryContinueDrag" DragRecordOver="TreeListControl_DragRecordOver"
                    StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop" -->
                            <dxg:TreeListView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                    <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                                </Style>
                            </dxg:TreeListView.RowStyle>
                            <dxg:TreeListView.CellStyle>
                                <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                  <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                                </Style>
                            </dxg:TreeListView.CellStyle>
                        </dxg:TreeListView>
                    </dxg:TreeListControl.View>
                    <dxg:TreeListControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:TreeListControl.CommandBindings>
                </dxg:TreeListControl>

            </dx:DXTabItem>
            <dx:DXTabItem x:Name="layoutEditorTab">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static properties:Resources.RecipeLayoutView}" />
                    </StackPanel>
                </dx:DXTabItem.Header>
                <lc:LayoutRecipeEditor Grid.Row="1" x:Name="layoutEditorControl" PreviewMouseDoubleClick="layoutEditorControl_PreviewMouseDoubleClick"/>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
