        <CommandBinding Command="{x:Static self:UIGeneralCommands.CreateBorder}" 
                    Executed="OnCreateBorder" 
                    CanExecute="CanExecuteSelectedFirstLevel" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.GeneratePowerTemplate}" 
