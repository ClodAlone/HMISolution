<UserControl x:Class="ScreenManager.ScreenEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:properties="clr-namespace:ScreenManager.Properties"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"    
    xmlns:self="clr-namespace:ScreenManager"
    xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    FocusManager.FocusedElement="{Binding ElementName=MainSurface}"
    PreviewDrop="MainSurface_Drop"
    PreviewKeyDown="MainSurface_PreviewKeyDown"
    PreviewKeyUp="MainSurface_PreviewKeyUp"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    xmlns:opcua="clr-namespace:OPCUAViewModel.Converters;assembly=OPCUAViewModel"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxeh="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
    x:Name="ScreenEditorControl" PreviewMouseWheel="MainSurface_PreviewMouseWheel" 
    Loaded="ScreenEditorControl_Loaded" Width="800" Height="600">
    
    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Storyboards.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/Screen.xaml" />
            </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />

            <self:ToPercentConverter x:Key="scaleToPercentConverter" />
            <self:BarItemMinWidthConverter x:Key="BarItemMinWidthConverter" />
            <opcua:UriConverter x:Key="UriConverter" />
            <utilities:UriToUriAbsoluteImageConverter x:Key="uriToUriAbsoluteImageConverter" x:Shared="True"/>
            <self:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
            <Grid x:Key="WaitingRepositoryItem" Width="100" Height="60" x:Shared="False">
                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="10"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Opacity="0.5" IsIndeterminate="True" MaxHeight="10"/>
                <TextBlock  Grid.Row="1" Text="{x:Static properties:Resources.ScreanViewLoading}" />
            </Grid>

            <DataTemplate x:Key="TreeColumnDataTemplate">
                <DockPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding RowData.Row.ItemHeader}" VerticalAlignment="Center" />
                    <CheckBox Margin="4 0 0 0" Loaded="OnCheckboxLoaded" Click="OnTreeNodeChecked" />
                </DockPanel>
            </DataTemplate>

            <Grid x:Key="ErrorRepositoryItem" Width="100" Height="60" x:Shared="False">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="??????" Foreground="Red" Background="DarkGray" FontSize="30"/>
                <TextBlock  Grid.Row="1" Text="{x:Static properties:Resources.ScreanViewNotFound}" />
            </Grid>

            <DataTemplate x:Key="Data">
                <Grid>
                    <StackPanel>
                        <dxe:ImageEdit IsPrintingMode="True" Source="{Binding Content}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <dxg:TreeListControl x:Key="objectBrowserTree" SelectionMode="Row">
                <dxg:TreeListControl.Columns>
                    <dxg:TreeListColumn Width="200" FieldName="ItemHeader" FilterPopupMode="Excel" Header="{x:Static properties:Resources.TreeName}" />
                    <dxg:TreeListColumn Width="50" FieldName="ZLayer" FilterPopupMode="Excel" SortIndex="0" SortOrder="Descending" Header="{x:Static properties:Resources.TreeZLayer}" />
                    <dxg:TreeListColumn Width="50" FieldName="VisualCount" FilterPopupMode="Excel" Header="{x:Static properties:Resources.TreeVisual}" />
                    <dxg:TreeListColumn Width="50" FieldName="LogicCount" FilterPopupMode="Excel" Header="{x:Static properties:Resources.TreeLogic}" />
                    <dxg:TreeListColumn Width="50" FieldName="ContainsCode" FilterPopupMode="Excel" Header="{x:Static properties:Resources.TreeContainsCode}" />
                    <dxg:TreeListColumn Width="50" FieldName="IsDynamic" FilterPopupMode="Excel" Header="{x:Static properties:Resources.TreeIsDynamic}" />
                </dxg:TreeListControl.Columns>
                <dxg:TreeListControl.View>
                    <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True" RowDoubleClick="OnRowDoubleClick" SearchPanelAllowFilter="True"
                                ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto" ShowSearchPanelMode="Always"
                                AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                IsSynchronizedWithCurrentItem="True" NodeExpanding="OnTreeNodeExpanding" AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing" AllowDragDrop="False">
                        <!-- StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"-->
                        <dxg:TreeListView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                                <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                            </Style>
                        </dxg:TreeListView.RowStyle>
                        <dxg:TreeListView.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                              <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                            </Style>
                        </dxg:TreeListView.CellStyle>
                    </dxg:TreeListView>
                </dxg:TreeListControl.View>
            </dxg:TreeListControl>

           <dxg:TreeListControl x:Key="referenceListTree" SelectionMode="Row" Tag="True"
                                FilterChanged="OnFilterChanged">
            <dxg:TreeListControl.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceDictionary Source="/ScreenManager;component/Resources/SearchPanelResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>      
                <DataTemplate x:Key="ReferenceListCellDisplayTemplate">
                    <TextBlock Padding="3,0,0,0" VerticalAlignment="Center" 
                               Text="{Binding Path=Value}" 
                               dxeh:TextBlockService.EnableTextHighlighting="True" 
                               dxeh:TextBlockService.HighlightedTextCriteria="Contains" 
                               dxeh:TextBlockService.HighlightedText="{Binding View.SearchString}" />
                </DataTemplate>                  
              </ResourceDictionary>
            </dxg:TreeListControl.Resources>
                <dxg:TreeListControl.Columns>
                    <dxg:TreeListColumn ReadOnly="True" AllowEditing="False" FilterPopupMode="Excel" SortIndex="0" SortOrder="Ascending" 
                                        DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" FieldName="Name" Header="{x:Static properties:Resources.TreeName}"
                                        CellDisplayTemplate="{StaticResource ReferenceListCellDisplayTemplate}" />
                    <dxg:TreeListColumn ReadOnly="True" AllowEditing="False" FilterPopupMode="Excel" SortIndex="1" SortOrder="Ascending" 
                                        DisplayMemberBinding="{Binding Path=StringRepresentation, Mode=OneWay}"  FieldName="StringRepresentation" Header="{x:Static properties:Resources.TreeHumanReadable}"
                                        CellDisplayTemplate="{StaticResource ReferenceListCellDisplayTemplate}" />
                    <dxg:TreeListColumn ReadOnly="True" AllowEditing="False" FilterPopupMode="Excel" SortIndex="1" SortOrder="Ascending" 
                                        DisplayMemberBinding="{Binding Path=AppName, Mode=OneWay}" FieldName="AppName" Header="{x:Static properties:Resources.TreeAppName}"
                                        CellDisplayTemplate="{StaticResource ReferenceListCellDisplayTemplate}" />
                    <dxg:TreeListColumn ReadOnly="True" AllowEditing="False" FilterPopupMode="Excel" SortIndex="2" SortOrder="Ascending" 
                                        DisplayMemberBinding="{Binding Path=EndpointUrl, Mode=OneWay}" FieldName="EndpointUrl" Header="{x:Static properties:Resources.TreeEndpointUrl}"
                                        CellDisplayTemplate="{StaticResource ReferenceListCellDisplayTemplate}" />
                    <dxg:TreeListColumn ReadOnly="True" AllowEditing="False" FilterPopupMode="Excel" SortIndex="3" SortOrder="Ascending" 
                                        DisplayMemberBinding="{Binding Path=RelativePath, Mode=OneWay}" FieldName="RelativePath" Header="{x:Static properties:Resources.TreeRelativePath}"
                                        CellDisplayTemplate="{StaticResource ReferenceListCellDisplayTemplate}" />
                    <dxg:TreeListColumn ReadOnly="True" AllowEditing="False" FilterPopupMode="Excel" SortIndex="3" SortOrder="Ascending" 
                                        DisplayMemberBinding="{Binding Path=ResolvedNodeId, Mode=OneWay}" FieldName="ResolvedNodeId" Header="{x:Static properties:Resources.TreeResolvedNodeId}"
                                        CellDisplayTemplate="{StaticResource ReferenceListCellDisplayTemplate}" />
                </dxg:TreeListControl.Columns>
                <dxg:TreeListControl.View>
                    <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True" RowDoubleClick="OnRowDoubleClick" SearchPanelHorizontalAlignment="Stretch"
                                ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto" SearchPanelAllowFilter="True"
                                AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False" ShowSearchPanelMode="Always"
                                ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                SearchStringToFilterCriteria="OnSearchStringChanged"
                                IsSynchronizedWithCurrentItem="True" NodeExpanding="OnTreeNodeExpanding" AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing" AllowDragDrop="False">
                        <!-- StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"-->
                        <dxg:TreeListView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                                <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                            </Style>
                        </dxg:TreeListView.RowStyle>
                        <dxg:TreeListView.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                              <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                            </Style>
                        </dxg:TreeListView.CellStyle>
                    </dxg:TreeListView>
                </dxg:TreeListControl.View>
            </dxg:TreeListControl>

        </ResourceDictionary>
        
    </UserControl.Resources>
    
    <!-- Command Binding section -->
    <UserControl.InputBindings>
        <KeyBinding Key="ESC" Command="ApplicationCommands.Stop" />
    </UserControl.InputBindings>
    
    <UserControl.CommandBindings>


