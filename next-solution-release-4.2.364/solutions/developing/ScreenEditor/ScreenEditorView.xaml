                                            <Canvas.LayoutTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PART_ZoomTransformBackground" ScaleX="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevelX}"
                                                ScaleY="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevelY}" />
                                                    <TranslateTransform x:Name="PART_PanTransformBackground" X="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=OffsetLevelX}"
                                                Y="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=OffsetLevelY}" />
                                                </TransformGroup>
                                            </Canvas.LayoutTransform>
                                        </Canvas>
                                        <Canvas x:Name="MainSurface" Background="Transparent" AllowDrop="True" VirtualizingPanel.IsVirtualizing="True"
                            ClipToBounds="True" VerticalAlignment="Top" HorizontalAlignment="Left"
                            ManipulationStarting="Window_ManipulationStarting"
                            ManipulationDelta="Window_ManipulationDelta"
                            ManipulationInertiaStarting="Window_InertiaStarting"
                            ManipulationCompleted="Window_ManipulationCompleted"
                            PreviewDragOver="MainSurface_DragOver" 
                            PreviewQueryContinueDrag="MainSurface_QueryContinueDrag" 
                            PreviewMouseMove="MainSurface_MouseMove" 
                            PreviewMouseDown="MainSurface_MouseDown" 
                            PreviewMouseUp="MainSurface_MouseUp">
                                            <Canvas.ToolTip>
                                                <ToolTip x:Name="tooltipTag" Visibility="Collapsed"/>
                                            </Canvas.ToolTip>

                                            <Canvas.LayoutTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PART_ZoomTransform" ScaleX="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevelX}"
                                                ScaleY="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevelY}" />
                                                    <TranslateTransform x:Name="PART_PanTransform" X="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=OffsetLevelX}"
                                                Y="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=OffsetLevelY}" />
                                                </TransformGroup>
                                            </Canvas.LayoutTransform>

                                        </Canvas>

                                        <Rectangle x:Name="borderMainSurface" VerticalAlignment="Top" HorizontalAlignment="Left"
                            StrokeDashArray="2.0 2.0"
                           Stroke="Black"
                           StrokeThickness="1">
                                            <Rectangle.LayoutTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PART_ZoomTransformRect" ScaleX="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevelX}"
                                            ScaleY="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevelY}" />
                                                    <TranslateTransform x:Name="PART_PanTransformRect" X="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=OffsetLevelX}"
                                            Y="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=OffsetLevelY}" />
                                                </TransformGroup>
                                            </Rectangle.LayoutTransform>
                                            <Rectangle.Effect>
                                                <DropShadowEffect ShadowDepth="1" Color="White"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </Grid>

                                    <!--</tools:OverviewContentHolder>-->
                                </ScrollViewer>
                                <StackPanel x:Name="editingTools" Orientation="Horizontal" Grid.Row="1" Margin="4">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Right"
                                               Text="{x:Static properties:Resources.ScreenViewLanguage}" />
                                    <ComboBox SelectedIndex="0" SelectionChanged="ComboChangeLanguage" x:Name="langCombo" Margin="2,0,0,0"
                                              Width="100" IsEditable="False" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ActiveLanguages, Mode=OneWay}"/>

                                    <!--<TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Width="50" Margin="10,0,0,0" Text="{x:Static properties:Resources.ScreenViewGrid}" />
                                    <dxe:SpinEdit MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Double}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="50" Increment="1" MinValue="0" MaxValue="1000" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=GridSize, UpdateSourceTrigger=PropertyChanged}" />-->

                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  TextAlignment="Right"
                                               Margin="10,0,0,0" Text="{x:Static properties:Resources.ScreanViewZoom}" />
                                    <dxe:ComboBoxEdit MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Double}" 
                                                      VerticalAlignment="Center"  Margin="2,0,0,0"
                                                      HorizontalAlignment="Left" x:Name="comboZoom"
                                                      Width="100"  
                                                      AllowSpinOnMouseWheel="False" IsTextEditable="True" 
                                                      EditValue="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, 
                                                      Path=ZoomLevel, Converter={StaticResource scaleToPercentConverter}, 
                                                      UpdateSourceTrigger=PropertyChanged}" />
                                  <RepeatButton x:Name="btnZoomOut" Margin="2,0,0,0"
                                                Command="{x:Static self:UIGeneralCommands.ZoomOut}"
                                                Delay="500" Interval="50"
                                                ToolTip="{x:Static properties:Resources.ZoomOut}">
                                    <Image Source="{StaticResource SMzoomout}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"
                                      ToolTip="{x:Static properties:Resources.ZoomOut}"
                                      HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                  </RepeatButton>

                                  <RepeatButton x:Name="btnZoomIn" Margin="2,0,0,0"
                                                Command="{x:Static self:UIGeneralCommands.ZoomIn}"
                                                Delay="500" Interval="50"
                                                ToolTip="{x:Static properties:Resources.ZoomIn}">
                                    <Image Source="{StaticResource SMzoomin}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"
                                      ToolTip="{x:Static properties:Resources.ZoomIn}"
                                      HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                  </RepeatButton>

                                  <StackPanel Orientation="Horizontal" x:Name="stackEntityOptions">
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  TextAlignment="Right"
                                               Margin="10,0,0,0" Text="{x:Static properties:Resources.EnityX}" />
                                        <dxe:SpinEdit MaskType="Numeric" Mask="#########0.00" EditValueType="{x:Type sys:Double}" 
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="2,0,0,0" Width="100" 
                                                  Increment="1" AllowSpinOnMouseWheel="False" DisplayFormatString="#########0.00" 
                                                  IsTextEditable="True" EditValue="{Binding RelativeSource={RelativeSource 
                                                  AncestorType={x:Type UserControl}}, Path=SelectionXPos, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  TextAlignment="Right"
                                               Margin="10,0,0,0" Text="{x:Static properties:Resources.EnityY}" />
                                        <dxe:SpinEdit MaskType="Numeric" Mask="#########0.00" EditValueType="{x:Type sys:Double}" 
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="2,0,0,0" Width="100"
                                                  Increment="1" AllowSpinOnMouseWheel="False"  DisplayFormatString="#########0.00" 
                                                  IsTextEditable="True" EditValue="{Binding RelativeSource={RelativeSource 
                                                  AncestorType={x:Type UserControl}}, Path=SelectionYPos, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  TextAlignment="Right"
                                               Margin="10,0,0,0" Text="{x:Static properties:Resources.EnityWidth}" />
                                            <dxe:SpinEdit MaskType="Numeric" Mask="#########0.00" EditValueType="{x:Type sys:Double}" 
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="2,0,0,0" Width="100"
                                                  Increment="1" MinValue="0" AllowSpinOnMouseWheel="False"  DisplayFormatString="#########0.00" 
                                                  IsTextEditable="True" EditValue="{Binding RelativeSource={RelativeSource 
                                                  AncestorType={x:Type UserControl}}, Path=SelectionWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  TextAlignment="Right"
                                               Margin="10,0,0,0" Text="{x:Static properties:Resources.EnityHeight}" />
                                                <dxe:SpinEdit MaskType="Numeric" Mask="#########0.00" EditValueType="{x:Type sys:Double}" 
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="2,0,0,0" Width="100"
                                                  Increment="1" MinValue="0" AllowSpinOnMouseWheel="False"  DisplayFormatString="#########0.00" 
                                                  IsTextEditable="True" EditValue="{Binding RelativeSource={RelativeSource 
                                                  AncestorType={x:Type UserControl}}, Path=SelectionHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <!--<Slider Margin="10 0 10 0" Minimum="10" LargeChange="20" TickFrequency="10" Maximum="200" SmallChange="10" TickPlacement="TopLeft" Width="200" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=ZoomLevel, Converter={StaticResource scaleToPercentConverter}}" />-->

                                    <!--<ToggleButton x:Name="btnOverview" ToolTip="{x:Static self:Properties.Resources.OverviewButtonTooltip}">
                                        <ToggleButton.Content>
                                            <Image Width="16" Height="16" Source="{StaticResource SMScreenManager}" />
                                        </ToggleButton.Content>
                                    </ToggleButton>-->
                                            <!--<ToggleButton x:Name="btnExplorer" ToolTip="{x:Static self:Properties.Resources.ExplorerButtonTooltip}">
                                        <ToggleButton.Content>
                                            <Image Width="16" Height="16" Source="{StaticResource SMPrototypesList}" />
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                    <ToggleButton x:Name="btnEntityReference" ToolTip="{x:Static self:Properties.Resources.ReferenceListButtonTooltip}">
                                        <ToggleButton.Content>
                                            <Image Width="16" Height="16" Source="{StaticResource SMEntities}" />
                                        </ToggleButton.Content>
                                    </ToggleButton>-->

                                    <!--<Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtX" Grid.Column="0" Margin="4"/>
                                        <TextBlock x:Name="txtY" Grid.Column="1" Margin="4"/>
                                        <TextBlock x:Name="txtWidth" Grid.Column="2" Margin="4"/>
                                        <TextBlock x:Name="txtHeight" Grid.Column="3" Margin="4"/>
                                    </Grid>-->
                                </StackPanel>
                            </Grid>

                            <lc:LayoutControl x:Name="layoutItems" Background="Transparent" IsCustomization="True" Visibility="Collapsed"/>

                        </Grid>
                    </dxdo:LayoutPanel>
                </dxdo:DocumentGroup>
            </dxdo:LayoutGroup>
            <dxdo:DockLayoutManager.AutoHideGroups>
                <dxdo:AutoHideGroup DockType="Bottom" x:Name="ScreenEditorAutoHideGroup_ObjectsPanel" DestroyOnClosingChildren="False">
                    <dxdo:LayoutPanel FloatOnDoubleClick="False" IsVisibleChanged="OnObjectsPanelVisibilityChanged" AutoHidden="True" x:Name="ObjectsPanel" Opacity="0.9" AllowClose="False" Caption="{x:Static self:Properties.Resources.ExplorerButtonTooltip}" ItemHeight="300">
                      <Grid>
                        <dxe:FlyoutControl
                                x:Name="objectsPanelFlyoutControl"
                                Content="{x:Static self:Properties.Resources.PopupFlyoutMessage}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                AllowMoveAnimation="False"
                                PlacementTarget="{Binding ElementName=ObjectsPanelTreeContainer}"
                                IsOpen="False">
                          <dxe:FlyoutControl.Settings>
                            <dxe:FlyInSettings />
                          </dxe:FlyoutControl.Settings>
                        </dxe:FlyoutControl>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                              </Grid.RowDefinitions>
                            <Button Click="ObjectsRefresh_Click" Grid.Row="0" HorizontalAlignment="Stretch" Content="{x:Static properties:Resources.RefreshView}" MinWidth="50" />
                            <ContentControl Grid.Row="1" x:Name="ObjectsPanelTreeContainer">

                            </ContentControl>
                          </Grid>
                      </Grid>
                    </dxdo:LayoutPanel>
                </dxdo:AutoHideGroup>
                <dxdo:AutoHideGroup DockType="Bottom" x:Name="ScreenEditorAutoHideGroup_ReferencesPanel" DestroyOnClosingChildren="False">
                    <dxdo:LayoutPanel FloatOnDoubleClick="False" IsVisibleChanged="OnReferencesPanelVisibilityChanged" AutoHidden="True" x:Name="ReferencesPanel" Opacity="0.9" AllowClose="False" Caption="{x:Static self:Properties.Resources.ReferenceListButtonTooltip}" ItemHeight="300">
                        <Grid>
                            <dxe:FlyoutControl
                                x:Name="referenceFlyoutControl" 
                                Content="{x:Static self:Properties.Resources.PopupFlyoutMessage}"
                                HorizontalAlignment="Stretch"
                                PlacementTarget="{Binding ElementName=entityReferenceList}"
                                VerticalAlignment="Top"
                                AllowMoveAnimation="False" 
                                IsOpen="False">
                                <dxe:FlyoutControl.Settings>
                                    <dxe:FlyInSettings />
                                </dxe:FlyoutControl.Settings>
                            </dxe:FlyoutControl>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Button Click="ReferenceRefresh_Click" Grid.Row="0" HorizontalAlignment="Stretch" Content="{x:Static properties:Resources.RefreshView}" MinWidth="50" />
                                <ContentControl Grid.Row="1" Name="entityReferenceList">
                                    <!--<ContentControl.Effect>
                                        <DropShadowEffect Opacity="0.5" ShadowDepth="10"/>
                                    </ContentControl.Effect>-->
                                </ContentControl>
                            </Grid>
                        </Grid>
                    </dxdo:LayoutPanel>
                </dxdo:AutoHideGroup>
            </dxdo:DockLayoutManager.AutoHideGroups>
        </dxdo:DockLayoutManager>
    </Grid>
</UserControl>
