        <CommandBinding Command="{x:Static self:UIGeneralCommands.Rotate}" 
                    Executed="OnRotate" 
                    CanExecute="CanExecuteSelected" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportXaml}" 
