<UserControl x:Class="ScreenManager.StyleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:effects="clr-namespace:ShaderEffects;assembly=ShaderEffects"
             xmlns:local="clr-namespace:ScreenManager"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
              xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
              xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" Width="600" Height="500"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />

            <local:DivideDoubleByTwoConverter x:Key="DivideDoubleByTwoConverter" />
            
            <DataTemplate x:Key="ItemTemplate">
                <Button x:Name="btn" ClipToBounds="False" Width="200" Height="200" Margin="20, 20, 20, 20" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                                PreviewMouseDown="Button_PreviewMouseDown" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button.Resources>
                        <Storyboard x:Key="MouseOver">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>

                        <Storyboard x:Key="MouseLeave">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </Button.Resources>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
                        </EventTrigger>
                    </Button.Triggers>
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <SkewTransform AngleX="0" AngleY="0" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Button.Effect>
                        <effects:ReflectionEffect InputHeight="{Binding ElementName=btn, Path=ActualHeight}" />
                    </Button.Effect>
                </Button>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

          <dxg:TreeListControl x:Name="treeListControl" SelectionMode="Row" x:Shared="False"
                                      SelectionChanged="treeListControl_SelectionChanged">
            <dxg:TreeListControl.Columns>
              <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="ItemHeader" />
              <!-- Validate="OnTreeHeaderValidate" -->
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
              <dxg:TreeListView x:Name="treeViewFolder" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                      MultiSelectMode="None"
                                      ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                      AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                      ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                      BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch"  VerticalAlignment="Top"
                                      IsSynchronizedWithCurrentItem="True" AllowDragDrop="False"
                                      AutoWidth="True">
                <dxg:TreeListView.RowStyle>
                  <Style TargetType="{x:Type dxg:RowControl}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </dxg:TreeListView.RowStyle>
                <dxg:TreeListView.CellStyle>
                  <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                    <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                  </Style>
                </dxg:TreeListView.CellStyle>
              </dxg:TreeListView>
            </dxg:TreeListControl.View>
          </dxg:TreeListControl>
          
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            
            <cc:CarouselControl HorizontalAlignment="Stretch" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Background="Transparent" 
                            LookDownOffset="60" RotationSpeed="100" Scale="0.8" Fade="0.5" 
                            Grid.Column="2" x:Name="Carousel">
            </cc:CarouselControl>


            <TextBlock FontFamily="Segoe UI" FontSize="30" Grid.RowSpan="30"
                            VerticalAlignment="Center" TextWrapping="WrapWithOverflow"
                            HorizontalAlignment="Center" x:Name="txtNoLibrary"
                            FontWeight="Light" Text="{x:Static properties:Resources.SelectResourceFile}"/>

        </Grid>

        <Grid Grid.Column="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="{x:Static properties:Resources.StyleEditor_PreviousBtnTitle}" Click="Button_Prev" Background="Transparent" BorderBrush="Transparent" />
            <Button Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="{x:Static properties:Resources.StyleEditor_NextBtnTitle}" Click="Button_Next" Background="Transparent" BorderBrush="Transparent" />
        </Grid>

        <Button Grid.Row="3" Click="Button_Click">Load From File</Button>
    </Grid>
</UserControl>
