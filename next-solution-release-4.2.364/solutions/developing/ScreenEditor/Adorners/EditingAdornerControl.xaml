<UserControl x:Class="ScreenManager.Adorners.EditingAdornerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:self="clr-namespace:ScreenManager"
    xmlns:selfconverters="clr-namespace:ScreenManager.Adorners.Converters"
    xmlns:converters="clr-namespace:OPCUAViewModel.Converters;assembly=OPCUAViewModel"
    ClipToBounds="False" 
    xmlns:properties="clr-namespace:ScreenManager.Properties" 
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    Background="{x:Null}" Height="8000" Width="40" Visibility="Collapsed">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="panelButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="panelButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>-->

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlassButton.xaml"/>
              <ResourceDictionary Source="/SharedResources;component/Resources/Screen.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <self:BoolToVisibilityConverter x:Key="BooleanToVisibility" />
            <self:RevertBoolToVisibilityConverter x:Key="RevertBooleanToVisibility" />
            <selfconverters:InverseZoomConverter x:Key="InverseZoomConverter" x:Shared="true"/>
            <!--<converters:UriConverter x:Key="RelativePathConverter" />-->
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.LayoutTransform>
        <TransformGroup>
            <ScaleTransform x:Name="PART_ZoomTransform" 
                            ScaleX="{Binding Path=Document.ActiveView.ZoomLevelX, Converter={StaticResource InverseZoomConverter}}"
                            ScaleY="{Binding Path=Document.ActiveView.ZoomLevelY, Converter={StaticResource InverseZoomConverter}}" />
        </TransformGroup>
    </UserControl.LayoutTransform>

    <!--<UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource MouseOverOpacity}" x:Name="MouseOver_BeginStoryboard" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource MouseLeaveOpacity}" x:Name="MouseLeave_BeginStoryboard" />
        </EventTrigger>
    </UserControl.Triggers>-->

    <Grid Background="{x:Null}" ClipToBounds="False" Margin="2,2,2,2" x:Name="grid">
        <Grid.Resources>
            <SolidColorBrush x:Key="menuLabel" Color="LightGray" />
            <SolidColorBrush x:Key="menuChecked" Color="#FF70BB54" />
            <SolidColorBrush x:Key="menuBackground" Color="#FF333333" />
            <SolidColorBrush x:Key="menuUnchecked" Color="DimGray" />
            <SolidColorBrush x:Key="menuOver" Color="DarkGray" />

            <Storyboard x:Key="ShowShine">
                <DoubleAnimation Duration="00:00:00.3000000" To="1" AutoReverse="True" RepeatBehavior="Forever" 
                                Storyboard.TargetProperty="Opacity" />
            </Storyboard>
            <Storyboard x:Key="HideShine">
                <DoubleAnimation Duration="00:00:00.3000000" To="0.5"  
                                Storyboard.TargetProperty="Opacity" />
            </Storyboard>


            <Storyboard x:Key="MouseOver">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="MouseLeave">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Style x:Key="btnToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <SkewTransform AngleX="0" AngleY="0" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="BorderBrush" Value="Red" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Black" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="ShowShine_BeginStoryboard" Storyboard="{StaticResource ShowShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard x:Name="HideShine_BeginStoryboard" Storyboard="{StaticResource HideShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="btnStyle" TargetType="{x:Type Button}">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <SkewTransform AngleX="0" AngleY="0" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="BorderBrush" Value="Red" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Black" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="ShowShine_BeginStoryboard" Storyboard="{StaticResource ShowShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard x:Name="HideShine_BeginStoryboard" Storyboard="{StaticResource HideShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </Grid.Resources>

        <Expander IsExpanded="True" x:Name="expander" Background="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="False">
            <Expander.Header>
                <Image Source="{StaticResource SMLock}" Stretch="None" Visibility="{Binding LockMovement, Converter={StaticResource BooleanToVisibility}}"
                       VerticalAlignment="Center" IsHitTestVisible="False"
                        HorizontalAlignment="Center" Width="20" Height="20"/>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Vertical" Opacity=".8" ClipToBounds="False" >
                <ToggleButton x:Name="btnShow" Margin="1,1,1,1">
                    <ToggleButton.Content>
                        <Grid>
                            <TextBlock Text="•" Visibility="{Binding SourceSymbolLinkedActive, Converter={StaticResource RevertBooleanToVisibility}}"/>
                            <Image Source="{StaticResource SMLink}" Stretch="None" Visibility="{Binding SourceSymbolLinkedActive, Converter={StaticResource BooleanToVisibility}}"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        HorizontalAlignment="Center" Width="20" Height="20"/>
                        </Grid>
                    </ToggleButton.Content>
                </ToggleButton>
                <Button Margin="1,1,1,1"
                              Command="{x:Static self:UIGeneralCommands.DynamicPropertyInspector}">
                    <Button.Content>
                        <Grid>
                            <Image Stretch="None"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        HorizontalAlignment="Center" Width="20" Height="20" Source="{StaticResource SMDataFind}" />
                        </Grid>
                    </Button.Content>
                </Button>
                <Button Margin="1,1,1,1"
                              Command="{x:Static self:UIGeneralCommands.ExploreObjectTree}">
                    <Button.Content>
                        <Grid>
                            <Image Stretch="None"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        HorizontalAlignment="Center" Width="20" Height="20" Source="{StaticResource SMTree}" />
                        </Grid>
                    </Button.Content>
                </Button>

                <ToggleButton x:Name="btnShowSmart" Visibility="Collapsed" Margin="1,1,1,1">
                    <ToggleButton.Content>
                        <Grid>
                            <Image Source="{StaticResource SMPropertyWindow}" Stretch="None"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        HorizontalAlignment="Center" Width="20" Height="20"/>
                        </Grid>
                    </ToggleButton.Content>
                </ToggleButton>
            </StackPanel>
        </Expander>

        <Popup IsOpen="{Binding ElementName=btnShowSmart, Path=IsChecked}"
               PlacementTarget="{Binding ElementName=btnShowSmart}" 
               x:Name="popupSmart"
               StaysOpen="False" 
               Placement="Right" ClipToBounds="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <StackPanel Opacity="0.90" Margin="20,0,0,0" Background="{StaticResource menuBackground}" VerticalAlignment="Center" ClipToBounds="False"
                        HorizontalAlignment="Stretch" x:Name="panelSmart">
                <ContentControl x:Name="contentSmart" MinHeight="300" />
            </StackPanel>
        </Popup>
        
            <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>-->
        <Popup IsOpen="{Binding ElementName=btnShow, Path=IsChecked}"
               PlacementTarget="{Binding ElementName=btnShow}" 
               x:Name="popup" Opened="popup_Opened"
               StaysOpen="False"
               Placement="Bottom" ClipToBounds="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <StackPanel Opacity="0.90" Margin="20,0,0,0" VerticalAlignment="Center" ClipToBounds="False"
                        HorizontalAlignment="Stretch" x:Name="panelButtons" Width="200">

                <StackPanel Margin="2,2,2,2" HorizontalAlignment="Stretch">
                    <Border BorderBrush="{StaticResource menuLabel}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{x:Static self:UIGeneralCommands.Rename}" 
                			VerticalAlignment="Center" HorizontalAlignment="Stretch" 
                		 Margin="2,2,2,2">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EntityName}" Margin="2,2,2,2"/>
                                        <Image Width="16" Height="16" Source="{StaticResource SMCommonproperties}" Margin="2,2,2,2"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <TextBlock x:Name="txtType" Margin="2,2,2,2"/>
                        </StackPanel>
                    </Border>
                    <Grid ClipToBounds="False" Margin="0">
                        <ToggleButton x:Name="ShowInlinePropBtn" Command="{x:Static self:UIGeneralCommands.ShowInlineProperties}" 
                			VerticalAlignment="Center" HorizontalAlignment="Stretch" ToolTip="{x:Static properties:Resources.OnEditCommonProperty}" 
                			Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="16" Height="16" Source="{StaticResource SMCommonproperties}" />
                                    <TextBlock Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                               x:Name="menuLabel4" Text="{x:Static properties:Resources.OnEditCommonProperty}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                        </ToggleButton>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0" 
                            HorizontalAlignment="Stretch">
                        <ToggleButton ToolTip="{Binding Command.Text, RelativeSource={RelativeSource Self}}" 
                                      x:Name="ShowStyleEditorBtn" Command="{x:Static self:UIGeneralCommands.StyleEditor}" 
                			VerticalAlignment="Center" HorizontalAlignment="Stretch"
                			Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SMeditstyle}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                   x:Name="menuLabel5" Text="{x:Static properties:Resources.OnEditStyle}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                        </ToggleButton>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0" 
                            HorizontalAlignment="Stretch">
                        <Button  Margin="2,2,2,2"
                              Command="{x:Static self:UIGeneralCommands.ExecuteDroppingCode}" 
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" ToolTip="{x:Static properties:Resources.OnExecuteDroppingCode}">
                            <Button.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SMexecutedroppingcode}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                   x:Name="menuLabel6" Text="{x:Static properties:Resources.OnExecuteDroppingCode}"/>
                                </DockPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0" 
                            HorizontalAlignment="Stretch">
                        <ToggleButton x:Name="btnBitmapCache"  ToolTip="{x:Static properties:Resources.OnEnCache}"
                			               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                           Click="btnBitmapCache_Click"  
                			               Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SMcache}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                           Foreground="White" Text="{x:Static properties:Resources.Cache}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuChecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="{StaticResource menuUnchecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuOver}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0" 
                            HorizontalAlignment="Stretch">
                        <ToggleButton  x:Name="Manipulation"  ToolTip="{x:Static properties:Resources.OnEnManipulation}"
                                           IsChecked="{Binding EnableManipulation}"  
                			               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                			               Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SMmanipulation}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                           Foreground="White" Text="{x:Static properties:Resources.Manipulation}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuChecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="{StaticResource menuUnchecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuOver}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <Grid ClipToBounds="False" Margin="0" 
                            HorizontalAlignment="Stretch">
                        <ToggleButton  x:Name="lockMovement"  ToolTip="{x:Static properties:Resources.OnLockMovement}"
                                           IsChecked="{Binding LockMovement}"  
                			               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                			               Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SMLock}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                           Foreground="White" Text="{x:Static properties:Resources.LockPosition}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuChecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="{StaticResource menuUnchecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuOver}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <Grid ClipToBounds="False" Margin="0"  Visibility="{Binding ElementName=btn3DEdit,Path=Visibility}"
                            HorizontalAlignment="Stretch">
                        <ToggleButton  x:Name="btn3DEdit"  ToolTip="{x:Static properties:Resources.On3DEdit}"
                			               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                			               Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SM3dedit}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                   x:Name="menuLabel10" Text="{x:Static properties:Resources.Edit3D}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuChecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="{StaticResource menuUnchecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuOver}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0"   Visibility="{Binding ElementName=btn3DCamera,Path=Visibility}"
                            HorizontalAlignment="Stretch">
                        <ToggleButton  x:Name="btn3DCamera" Visibility="Collapsed"   ToolTip="{x:Static properties:Resources.Camera3D}"
                			               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                			               Margin="2,2,2,2">
                            <ToggleButton.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SM3Dcameraedit}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                   x:Name="menuLabel11" Text="{x:Static properties:Resources.Camera3D}"/>
                                </DockPanel>
                            </ToggleButton.Content>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuChecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="{StaticResource menuUnchecked}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource menuOver}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0"   Visibility="{Binding ElementName=btn3DCameraPositions,Path=Visibility}"
                            HorizontalAlignment="Stretch">
                        <Button x:Name="btn3DCameraPositions" ToolTip="{x:Static properties:Resources.On3DCameraPositions}"
                			VerticalAlignment="Center" HorizontalAlignment="Stretch" Visibility="Collapsed"
                			Margin="2,2,2,2">
                            <Button.Content>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                    <Image Width="16" Height="16" Source="{StaticResource SM3dcamerapositionedit}" />
                                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                       Visibility="{Binding ElementName=btn3DCameraPositions, Path=Visibility}"
                                       x:Name="menuLabel12" Text="{x:Static properties:Resources.On3DCameraPositions}"/>
                                </DockPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0"  
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical">
                            <Button VerticalAlignment="Top" Margin="2,2,2,2" ToolTip="{x:Static properties:Resources.OnEditDataTypeItem}"
                              Command="{x:Static self:UIGeneralCommands.EditDataTypeItem}" 
                              HorizontalAlignment="Stretch" >
                                <Button.Content>
                                    <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                        <Image Width="16" Height="16" Source="{StaticResource SMitemdatatype}" />
                                        <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                       x:Name="menuLabel13" Text="{x:Static properties:Resources.EditDataTypeItem}"/>
                                    </DockPanel>
                                </Button.Content>
                            </Button>
                            <Grid Margin="2,2,2,2"  ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Background="{x:Null}" TextWrapping="WrapWithOverflow" Grid.Row="0" Text="{Binding Path=OpcuaDataTypeEntityReference.HumanReadable, UpdateSourceTrigger=PropertyChanged}" ClipToBounds="False"/>
                                <!--<TextBlock Background="{x:Null}" TextWrapping="WrapWithOverflow"  Grid.Row="1" Text="{Binding Path=OpcuaDataTypeEntityReference.ResolvedNodeId, UpdateSourceTrigger=PropertyChanged}" ClipToBounds="False"/>-->
                                <!--<TextBlock x:Name="relativePath" Background="{x:Null}" TextWrapping="WrapWithOverflow"  Grid.Row="2" Text="{Binding OpcuaDataTypeEntityReference, Converter={StaticResource RelativePathConverter}, UpdateSourceTrigger=PropertyChanged}" FontStyle="Italic" ClipToBounds="False"/>-->
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid ClipToBounds="False" Margin="0"  
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical">
                            <Button x:Name="OpcuaEntityReferenceBtn"  ToolTip="{x:Static properties:Resources.OnEditDataContextItem}"
                              Command="{x:Static self:UIGeneralCommands.EditDataContextItem}" 
                              VerticalAlignment="Top" Margin="2,2,2,2" 
                              >
                                <Button.Content>
                                    <DockPanel HorizontalAlignment="Left" LastChildFill="True" ClipToBounds="False" Width="183" >
                                        <Image Width="16" Height="16" Source="{StaticResource SMitemdatacontext}" />
                                        <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" 
                                       x:Name="menuLabel1" Text="{x:Static properties:Resources.EditDataContextItem}"/>
                                    </DockPanel>
                                </Button.Content>
                            </Button>
                            <Grid Margin="2,2,2,2"  ClipToBounds="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Background="{x:Null}" TextWrapping="Wrap"  Grid.Row="0" Grid.RowSpan="2" 
                                       Text="{Binding Path=OpcuaEntityReference.HumanReadable, UpdateSourceTrigger=PropertyChanged}" ClipToBounds="False"/>
                                <!--<TextBlock Background="{x:Null}" TextWrapping="WrapWithOverflow"  Grid.Row="2" Text="{Binding Path=OpcuaEntityReference.ResolvedNodeId, UpdateSourceTrigger=PropertyChanged}" ClipToBounds="False"/>-->
                                <!--<TextBlock Background="{x:Null}" TextWrapping="Wrap"  Grid.Row="2" Grid.RowSpan="2"  
                                       Text="{Binding Path=OpcuaEntityReference, Converter={StaticResource RelativePathConverter}, UpdateSourceTrigger=PropertyChanged}" FontStyle="Italic" ClipToBounds="False"/>-->
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource menuLabel}" BorderThickness="0">
                        <DockPanel LastChildFill="True"  Margin="0">
                            <TextBlock  DockPanel.Dock="Top" Margin="2,0,0,0" HorizontalAlignment="Left" x:Name="menuLabel2" Text="{x:Static properties:Resources.Expression}" />
                            <Button DockPanel.Dock="Right"  Command="{x:Static self:UIGeneralCommands.ClearExpression}">
                                <Button.Content>
                                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{x:Static self:UIGeneralCommands.EditExpression}" HorizontalAlignment="Right" Margin="2">
                                <Button.Content>
                                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                            <TextBox Background="{StaticResource menuLabel}" Margin="2" x:Name="menuLabel14" HorizontalAlignment="Stretch" Text="{Binding Path=Expression, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource menuLabel}" BorderThickness="0">
                        <DockPanel LastChildFill="True"  Margin="0">
                            <TextBlock DockPanel.Dock="Top" Margin="2,0,0,0" HorizontalAlignment="Left" x:Name="menuLabel3" Text="{x:Static properties:Resources.Reverse}"/>
                            <Button DockPanel.Dock="Right"  Command="{x:Static self:UIGeneralCommands.ClearReverseExpression}">
                                <Button.Content>
                                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{x:Static self:UIGeneralCommands.EditReverseExpression}" Margin="2">
                                <Button.Content>
                                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                            <TextBox Background="{StaticResource menuLabel}" HorizontalAlignment="Stretch" Margin="2" x:Name="menuLabel15" Text="{Binding Path=ReverseExpression, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="btnEnableRotationThumbs" Content="{x:Static properties:Resources.EnableRotationThumbs}"/>
            </StackPanel>
        </Popup>
    </Grid>
</UserControl>
