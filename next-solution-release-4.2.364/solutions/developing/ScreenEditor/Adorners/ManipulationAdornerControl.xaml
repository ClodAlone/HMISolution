<UserControl x:Class="ScreenManager.Adorners.ManipulationAdornerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:self="clr-namespace:ScreenManager"
    x:Name="adornerControl"
    xmlns:properties="clr-namespace:ScreenManager.Properties" 
    Background="{x:Null}" 
    Width="120" Height="8000">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="panelButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="panelButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource MouseOverOpacity}" x:Name="MouseOver_BeginStoryboard" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource MouseLeaveOpacity}" x:Name="MouseLeave_BeginStoryboard" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{x:Null}" Height="8000">
        <Grid.Resources>
            <Storyboard x:Key="ShowShine">
                <DoubleAnimation Duration="00:00:00.3000000" To="1" AutoReverse="True" RepeatBehavior="Forever" 
                                Storyboard.TargetProperty="Opacity" />
            </Storyboard>
            <Storyboard x:Key="HideShine">
                <DoubleAnimation Duration="00:00:00.3000000" To="0.5"  
                                Storyboard.TargetProperty="Opacity" />
            </Storyboard>


            <Storyboard x:Key="MouseOver">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="MouseLeave">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Style x:Key="btnToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <SkewTransform AngleX="0" AngleY="0" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="BorderBrush" Value="Red" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Black" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="ShowShine_BeginStoryboard" Storyboard="{StaticResource ShowShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard x:Name="HideShine_BeginStoryboard" Storyboard="{StaticResource HideShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type Button}">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <SkewTransform AngleX="0" AngleY="0" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="BorderBrush" Value="Red" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Black" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="50" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="ShowShine_BeginStoryboard" Storyboard="{StaticResource ShowShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard x:Name="HideShine_BeginStoryboard" Storyboard="{StaticResource HideShine}" />
                            <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="panelButtons" Opacity="0.3" Background="{x:Null}" >

            <ToggleButton x:Name="enableManBtn" Style="{DynamicResource btnToggleStyle}" 
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          FontSize="12" Height="50" Width="50" Margin="2,2,2,2" 
                          Command="{x:Static self:UIGeneralCommands.EnableManipulationControl}"
                          CommandParameter="{Binding Path=AdornedControl, ElementName=adornerControl}">Man
                <ToggleButton.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </ToggleButton.Effect>
            </ToggleButton>

            <ToggleButton x:Name="resetManBtn" Style="{DynamicResource btnToggleStyle}" 
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          FontSize="12" Height="50" Width="50" Margin="2,2,2,2" 
                          Command="{x:Static self:UIGeneralCommands.ResetManipulationControl}"
                          CommandParameter="{Binding Path=AdornedControl, ElementName=adornerControl}">Reset
                <ToggleButton.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </ToggleButton.Effect>
            </ToggleButton>

            <ToggleButton x:Name="zoomBtn" Style="{DynamicResource btnToggleStyle}" 
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          FontSize="12" Height="50" Width="50" Margin="2,2,2,2"
                          Command="{x:Static self:UIGeneralCommands.ZoomControl}"
                          CommandParameter="{Binding Path=AdornedControl, ElementName=adornerControl}">Zoom
                <ToggleButton.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </ToggleButton.Effect>
            </ToggleButton>

            <ToggleButton x:Name="iconBtn" Style="{DynamicResource btnToggleStyle}" Visibility="Collapsed"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          FontSize="12" Height="50" Width="50" Margin="2,2,2,2"
                          Command="{x:Static self:UIGeneralCommands.IconControl}"
                          CommandParameter="{Binding Path=AdornedControl, ElementName=adornerControl}">Icon
                <ToggleButton.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </ToggleButton.Effect>
            </ToggleButton>

        </StackPanel>
    </Grid>
</UserControl>
