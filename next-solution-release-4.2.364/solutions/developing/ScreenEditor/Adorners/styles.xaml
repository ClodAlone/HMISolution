<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:ScreenManager.Adorners"
                    xmlns:converters="clr-namespace:ScreenManager.Adorners.Converters"
                    x:Class="ScreenManager.Adorners.ThumbsResources">

    <converters:BrushColorConverter x:Key="ColorConverter"/>

    <!-- RotateThumb Style -->
    <Style TargetType="{x:Type s:RotateThumb}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Cursor" Value="Rotate.cur" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type s:RotateThumb}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="ShowShine">
                            <DoubleAnimation Duration="00:00:00.5000000" To="1" AutoReverse="True" RepeatBehavior="Forever" 
                                Storyboard.TargetName="RotateEllipse" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                        <Storyboard x:Key="HideShine">
                            <DoubleAnimation Duration="00:00:00.5000000" To="0.2"  
                                Storyboard.TargetName="RotateEllipse" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="Goldenrod" Stretch="Fill" ToolTip="Rotate" x:Name="RotateEllipse" Opacity="0.2"></Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ShowShine_BeginStoryboard" Storyboard="{StaticResource ShowShine}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="HideShine_BeginStoryboard" Storyboard="{StaticResource HideShine}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


