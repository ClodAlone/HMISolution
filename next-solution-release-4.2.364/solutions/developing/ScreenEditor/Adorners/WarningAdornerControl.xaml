<UserControl x:Class="ScreenManager.Adorners.WarningAdornerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Background="Transparent" Opacity="1"
             ClipToBounds="False" MinHeight="40" MinWidth="60"
             d:DesignHeight="12" d:DesignWidth="300">
    <Grid ClipToBounds="False">
        <Border BorderBrush="Yellow" x:Name="mainBorder" BorderThickness="2" ClipToBounds="False"/>
        <TextBlock x:Name="txtTooltip" HorizontalAlignment="Stretch" Margin="4" ClipToBounds="False"
                   TextWrapping="Wrap" VerticalAlignment="Stretch" TextAlignment="Center"
                   Background="Yellow" Opacity="0.3" Foreground="Yellow" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
