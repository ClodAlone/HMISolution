<UserControl x:Class="ScreenManager.Popups.DynamicPropertyInspectorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScreenManager"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5" x:Name="rowSplitter"/>
            <RowDefinition Height="Auto" x:Name="rowContent"/>
        </Grid.RowDefinitions>
        <ContentControl x:Name="contentControlProperty"/>
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
        <ContentControl x:Name="contentControl" Grid.Row="2"/>
    </Grid>
</UserControl>
