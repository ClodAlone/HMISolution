<UserControl x:Class="ScreenManager.Popups.SmartProperties"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             Background="{x:Null}" Height="300" Width="400">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/Screen.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
        <Grid Background="{x:Null}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="name" Background="{x:Null}" />
            <!--Toolbar-->
            <dxb:BarContainerControl ContainerType="Top" x:Name="toolbar" Grid.Row="1" Background="{x:Null}">
                <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                    <dxb:BarButtonItem Content="Close" Glyph="{StaticResource SMRunPage}" GlyphSize="Custom" CustomGlyphSize="14,14" Name="OK" ToolTip="Close" ItemClick="OK_Click"/>
                </dxb:ToolBarControl>
            </dxb:BarContainerControl>

        <dx:DXTabControl Margin="0,0,12,12" Grid.Row="2" x:Name="tabControl" />
    </Grid>
</UserControl>
