<UserControl x:Class="ScreenManager.NewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ScreenManager"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:pdtemplates="clr-namespace:ScreenManager.PropertyDataTemplate"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             FocusManager.FocusedElement="{Binding ElementName=ScreenNameTxt}"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Height="300" Width="690">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Storyboards.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:FileNameToVisibilityConverter x:Key="FileNameToVisibilityConverter"/>
      <utilities:BrushToNameConverter x:Key="BrushNameConverter" />
      <LinearGradientBrush x:Key="Nuance30" EndPoint="0.5,0.905" StartPoint="0.5,-0.622">
        <GradientStop Color="#FF6E7072" Offset="0"/>
        <GradientStop Color="sc#1, 0.08857274, 0.0902648, 0.09382588" Offset="0.65896815061569214"/>
        <GradientStop Color="#FF282526" Offset="1"/>
      </LinearGradientBrush>
    </ResourceDictionary>
  </UserControl.Resources>
    <Grid x:Name="TreeviewContainerGrid">
      <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="10">
        <DockPanel LastChildFill="True" HorizontalAlignment="Left" Margin="0,2,0,0">
          <Label Content="{x:Static properties:Resources.ScreenWidth}" DockPanel.Dock="Left"
                    HorizontalAlignment="Left" MinWidth="120"/>
          <Button Margin="2,0,0,0" DockPanel.Dock="Right"
                  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, 
                  AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" 
                  ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"
                  CommandParameter="0">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <dxe:SpinEdit x:Name="spineditScreenWidth" MinWidth="160"
              EditValue="{Binding ScreenWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}"
              VerticalAlignment="Top" Mask="#########0" EditValueType="{x:Type sys:Double}"
              InvalidValueBehavior="AllowLeaveEditor"
              HorizontalAlignment="Left" IsFloatValue="False" />
        </DockPanel>
        <DockPanel LastChildFill="True" HorizontalAlignment="Left" Margin="0,2,0,0">
          <Label Content="{x:Static properties:Resources.ScreenHeight}"  
                 DockPanel.Dock="Left"
                 HorizontalAlignment="Left" MinWidth="120"/>
          <Button Margin="2,0,0,0" DockPanel.Dock="Right" x:Name="btnClear"
                  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, 
                  AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"
                  CommandParameter="1" >
            <Button.Content>
              <Image Margin="2" HorizontalAlignment="Left" Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <dxe:SpinEdit x:Name="spineditScreenHeight"  MinWidth="160"
              EditValue="{Binding ScreenHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}"
              VerticalAlignment="Top" Mask="#########0" EditValueType="{x:Type sys:Double}"
              HorizontalAlignment="Left"
              InvalidValueBehavior="AllowLeaveEditor" IsFloatValue="False" />
        </DockPanel>
        <DockPanel LastChildFill="True" HorizontalAlignment="Left" Margin="0,2,0,0">
          <Label Content="{x:Static properties:Resources.ScreenBackColor}"
                 DockPanel.Dock="Left"
                 HorizontalAlignment="Left" MinWidth="120"/>
          <Button Margin="2,0,0,0" DockPanel.Dock="Right"
                Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, 
                    AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True"
                ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"
                CommandParameter="2" >
            <Button.Content>
              <Image Margin="2" HorizontalAlignment="Left" Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <DockPanel LastChildFill="True" HorizontalAlignment="Left"  MinWidth="160">
            <commoncontrols:CustomPopupColorEdit x:Name="popupColorEdit" OnlySolidColors="False"
                Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                DockPanel.Dock="Right"
                SelectedBrush="{Binding ScreenBackBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
        </DockPanel>
        <DockPanel LastChildFill="True" HorizontalAlignment="Left"  Margin="0,2,0,0"
                   Visibility="{Binding Path=fileName, Converter={StaticResource FileNameToVisibilityConverter}}">
          <Label Content="{x:Static properties:Resources.NewScreenName}"
              DockPanel.Dock="Left" HorizontalAlignment="Left" MinWidth="120"/>
          <ComboBox x:Name="ScreenNameTxt" IsEditable="True" MinWidth="202" 
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding ScreenName}" >
            <ComboBoxItem Content="_Layout_Top"/>
            <ComboBoxItem Content="_Layout_Left"/>
            <ComboBoxItem Content="_Layout_Right"/>
            <ComboBoxItem Content="_Layout_Bottom"/>
            <ComboBoxItem Content="_AppBar_Top"/>
            <ComboBoxItem Content="_AppBar_Bottom"/>
          </ComboBox>
        </DockPanel>
      </StackPanel>
    </Grid>
</UserControl>
