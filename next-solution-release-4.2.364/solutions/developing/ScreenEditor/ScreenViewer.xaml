<UserControl x:Class="ScreenManager.ScreenViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="http://schemas.microsoft.com/surface/2008"
    xmlns:k="http://schemas.microsoft.com/kinect/2013"
    xmlns:effects="clr-namespace:ShaderEffects;assembly=ShaderEffects"
    xmlns:properties="clr-namespace:ScreenManager.Properties"
    xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:self="clr-namespace:ScreenManager" Background="Transparent"
                   KeyboardNavigation.IsTabStop="False"
                   FocusManager.FocusedElement="{Binding ElementName=MainSurface}"
             
    xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             PreviewKeyDown="ScreenViewerControl_PreviewKeyDown"
             PreviewKeyUp="ScreenViewerControl_PreviewKeyUp"
             
    x:Name="ScreenViewerControl" PreviewMouseWheel="MainSurface_PreviewMouseWheel" 
                                 PreviewMouseLeftButtonDown="MainSurface_MouseLeftButtonDown"
                                 Loaded="ScreenViewerControl_Loaded">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
          <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/ScreenViewer.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Storyboard x:Key="MouseOverOpacity">
          <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
            <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
          </DoubleAnimationUsingKeyFrames>
          <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
            <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="50" KeySpline="0,0,0.5,1" />
          </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="MouseLeaveOpacity">
          <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
            <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
          </DoubleAnimationUsingKeyFrames>
          <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
            <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="5" KeySpline="0,0,0.5,1" />
          </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--<Storyboard x:Key="sbMouseOver">
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="sbMouseLeave">
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>-->

        <DataTemplate x:Key="ItemTemplate">
          <Button x:Name="btn" ClipToBounds="False" Width="64" Height="64" Margin="10,10,10,10" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                              PreviewMouseDown="IconizerButton_PreviewMouseDown" PreviewTouchDown="IconizerButton_PreviewTouchDown"
                              HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button.Resources>
              <Storyboard x:Key="MouseOver">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                  <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                  <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                  <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                  <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>

              <Storyboard x:Key="MouseLeave">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                  <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                  <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </Button.Resources>
            <Button.Triggers>
              <EventTrigger RoutedEvent="Mouse.MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
              </EventTrigger>
              <EventTrigger RoutedEvent="Mouse.MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
              </EventTrigger>
            </Button.Triggers>
            <Button.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1" />
                <SkewTransform AngleX="0" AngleY="0" />
                <RotateTransform Angle="0" />
                <TranslateTransform X="0" Y="0" />
              </TransformGroup>
            </Button.RenderTransform>
            <Button.Effect>
              <effects:ReflectionEffect InputHeight="{Binding ElementName=btn, Path=ActualHeight}" />
            </Button.Effect>
          </Button>
        </DataTemplate>

        <ContextMenu HasDropShadow="True" Opacity=".8" x:Key="SharedContextMenu" x:Shared="False">
          <MenuItem Command="{x:Static self:UIGeneralCommands.FillMode}"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=ScreenViewerControl, Path=IsInFillMode, Mode=OneWay}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <!--<MenuItem Command="{x:Static self:UIGeneralCommands.ZoomMode}"
                      IsCheckable="True"
                      IsChecked="{Binding ElementName=ScreenViewerControl, Path=IsInZoomMode, Mode=OneWay}"
                      CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>-->
          <MenuItem Command="{x:Static self:UIGeneralCommands.ResetManipulation}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.LayoutEdit}"
                    IsCheckable="True"
                    IsChecked="{Binding ElementName=layoutItems, Path=IsCustomization}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <Separator/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.LoginUser}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.LogoutUser}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <Separator/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.ZoomControl}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.IconControl}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.EnableManipulationControl}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
          <MenuItem Command="{x:Static self:UIGeneralCommands.ResetManipulationControl}"
                    CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
        </ContextMenu>

        <self:UriToTextConverter x:Key="UriToTextConverter"/>
        <self:UriToUriImageConverter x:Key="UriToUriImageConverter"/>
        <self:ViewBoxHeightConverter x:Key="ViewBoxHeightConverter"/>

        <Grid x:Key="WaitingRepositoryItem" Width="100" Height="60" x:Shared="False">
          <Grid.RowDefinitions>
            <RowDefinition MaxHeight="10"/>
            <RowDefinition />
          </Grid.RowDefinitions>
          <ProgressBar Grid.Row="0" Opacity="0.5" IsIndeterminate="True" MaxHeight="10"/>
          <TextBlock  Grid.Row="1" Text="{x:Static properties:Resources.ScreanViewLoading}" />
        </Grid>

        <Grid x:Key="ErrorRepositoryItem" Width="100" Height="60" x:Shared="False">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="??????" Foreground="Red" Background="DarkGray" FontSize="30"/>
          <TextBlock  Grid.Row="1" Text="{x:Static properties:Resources.ScreanViewNotFound}" />
        </Grid>

        <DataTemplate x:Key="Data">
          <Grid>
            <StackPanel>
              <dxe:ImageEdit IsPrintingMode="True" Source="{Binding Content}" />
            </StackPanel>
          </Grid>
        </DataTemplate>

      </ResourceDictionary>
    </UserControl.Resources>
    
    <!--<UserControl.ContextMenu>
        <ContextMenu HasDropShadow="True" Opacity=".8">
            <MenuItem Command="{x:Static self:UIGeneralCommands.FillMode}"
                      IsCheckable="True"
                      IsChecked="{Binding ElementName=ScreenViewerControl, Path=IsInFillMode, Mode=OneWay}"
                      CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
            <MenuItem Command="{x:Static self:UIGeneralCommands.ResetManipulation}"
                      CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
            <MenuItem Command="{x:Static self:UIGeneralCommands.LayoutEdit}"
                      IsCheckable="True"
                      IsChecked="{Binding ElementName=layoutItems, Path=IsCustomization}"
                      CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
            <Separator/>
            <MenuItem Command="{x:Static self:UIGeneralCommands.LoginUser}" 
                      CommandTarget="{Binding PlacementTarget,
                        RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type ContextMenu}}}"/>
