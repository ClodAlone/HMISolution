<UserControl x:Class="ScreenManager.ObjectBrowseTreeItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:self="clr-namespace:ScreenManager" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="UserControl_Loaded" Background="Transparent">
    <StackPanel Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Label Margin="1" x:Name="lbTitle" VerticalAlignment="Top" IsHitTestVisible="False">---</Label>
        <CheckBox Margin="1" x:Name="cbVisible" Checked="cbVisible_Checked" Unchecked="cbVisible_Checked" VerticalAlignment="Center"></CheckBox>
    </StackPanel>
</UserControl>
