<UserControl x:Class="DBControls.PivotGrid"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:self="clr-namespace:DBControls.Converters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:DBControls.Properties"
             mc:Ignorable="d" xmlns:cc="http://progea.com/CommonControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxpg="http://schemas.devexpress.com/winfx/2008/xaml/pivotgrid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             Height="835" Width="865">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <dxe:TextEditSettings x:Key="dateSettings" MaskType="DateTime" Mask="G" />
            <DataTemplate x:Key="ColumnHeaderTemplate">
                <Border BorderThickness="0" Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    <TextBlock Margin="2" Name="textBlock" Text="{Binding Path=DisplayText, Mode=OneWay}" Style="{Binding Path=ActualHeaderContentStyle}" 
                               Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               HorizontalAlignment="{Binding HorizontalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               VerticalAlignment="{Binding VerticalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               TextBlock.FontFamily="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontSize="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontWeight="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontStyle="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="CellTemplate">
                <Border BorderThickness="0"  Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    <TextBlock Margin="2" Name="textBlock" Text="{Binding Path=DisplayText, Mode=OneWay}" Style="{Binding Path=ActualCellContentStyle}" 
                               Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               HorizontalAlignment="{Binding HorizontalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               VerticalAlignment="{Binding VerticalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               TextBlock.FontFamily="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontSize="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontWeight="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontStyle="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="CellValueTemplate">
                <Border BorderThickness="0"  Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    <TextBlock Margin="2" Name="textBlock" Text="{Binding Path=DisplayText, Mode=OneWay}" Style="{Binding Path=ActualCellContentStyle}" 
                               Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               HorizontalAlignment="{Binding HorizontalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               VerticalAlignment="{Binding VerticalContentAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               TextBlock.FontFamily="{Binding RowAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontSize="{Binding RowAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontWeight="{Binding RowAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               TextBlock.FontStyle="{Binding RowAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <DockPanel.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertionVisibilityConverter" />
            <self:ErrorInfoToBooleanConverter x:Key="ErrorInfoToBooleanConverter" />
            <self:ErrorInfoToVisibilityConverter x:Key="ErrorInfoToVisibilityConverter" />
            <Style TargetType="{x:Type Button}" x:Key="ButtonReloadData">
                <Setter Property="Command" Value="{Binding ReloadData, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="ButtonInsertRow">
                <Setter Property="Command" Value="{Binding InsertRow, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="ButtonDeleteRow">
                <Setter Property="Command" Value="{Binding DeleteRow, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="ButtonSaveData">
                <Setter Property="Command" Value="{Binding SaveData, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
        </DockPanel.Resources>

        <dxb:BarContainerControl ContainerType="Top"  DockPanel.Dock="Top" x:Name="toolbar">
            <dxb:ToolBarControl UseWholeRow="True" dxb:MergingProperties.Name="mainPivotGridToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False">
              <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                  <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                        <dxe:ComboBoxEdit 
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>

                    <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" x:Name="clearSmall" Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"/>
                    <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" x:Name="saveSmall" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}"/>
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}"/>
                </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit" />
                <dxb:BarButtonItem x:Name="expandAll" Content="{x:Static properties:Resources.ExpandAll}" ItemClick="Click_ExpandAll" />
                <dxb:BarButtonItem x:Name="collapseAll" Content="{x:Static properties:Resources.CollapseAll}" ItemClick="Click_CollapseAll" />
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="commandGrid" MinHeight="40" DockPanel.Dock="Bottom" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="2" Grid.Column="0" x:Name="ReloadButton"
    		MinWidth="16"
    		ToolTip="{x:Static properties:Resources.ReloadData}"
    		Command="{Binding ReloadData, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    		Tag="ButtonReloadData">
                    <Border x:Name="borderReload" BorderThickness="0">
                        <StackPanel x:Name="stackReload">
                            <TextBlock Text="{x:Static properties:Resources.ReloadData}" Background="{x:Null}" x:Name="txtReload"
            				Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    				Source="{DynamicResource RefreshSmall}" x:Name="refreshSmall" Width="16" Height="16" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button  Grid.Row="2" Grid.Column="1"
    		MinWidth="100" x:Name="exportDataButton" 
    		ToolTip="{x:Static properties:Resources.ExportDataCommand}"
    		Command="{Binding Path=ExportDataCommand, ElementName=pivotGridControl}" CommandParameter="1"
    		Tag="ButtonExportData">
                    <Border x:Name="borderExport" BorderThickness="0">
                        <StackPanel x:Name="stackExportData">
                            <TextBlock Text="{x:Static properties:Resources.ExportDataCommand}" 
                               Background="{x:Null}" x:Name="txtExport"
                        Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                      <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        Source="{DynamicResource ExportDataSmall}" x:Name="exportSmall" Width="16" Height="16" />
                        </StackPanel>
                    </Border>
                </Button>
                <ComboBox MinWidth="90" Visibility="Visible" Grid.Column="2" x:Name="cmbExportType" />
            </Grid>
            <Grid  x:Name="mainGrid" Grid.Row="0">
                <dxpg:PivotGridControl  MinHeight="10" MinWidth="10" Visibility="Visible"
			                 Tag="DataSourceStyle"
                             x:Name="gridDataControl1"
                             AllowDrop="True"
                             DataFieldWidth="90" 
                             ShowFilterHeaders="{Binding ShowFilterHeaders, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowRowGrandTotals="{Binding ShowRowGrandTotals, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowRowTotals="{Binding ShowRowTotals, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowRowHeaders="{Binding ShowRowHeaders, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowColumnGrandTotals="{Binding ShowColumnGrandTotals, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowColumnGrandTotalHeader="{Binding ShowColumnGrandTotalHeader, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowColumnTotals="{Binding ShowColumnTotals, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowColumnHeaders="{Binding ShowColumnHeaders, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowTotalsForSingleValues="{Binding ShowTotalsForSingleValues, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowPrefilterPanelMode="{Binding ShowPrefilterPanel, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ShowDataHeaders="{Binding ShowDataHeaders, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             RowTreeWidth="225" ShowBorder="False" 
                             dx:DXSerializer.SerializationID="gridDataControl1" 
                             dx:DXSerializer.StoreLayoutMode="All" 
                             dxpg:PivotSerializationOptions.AddNewFields="False" 
    		                 dxpg:PivotSerializationOptions.RemoveOldFields="False">
                    <dxpg:PivotGridControl.Fields>
                        <dxpg:PivotGridField />
                    </dxpg:PivotGridControl.Fields>
                </dxpg:PivotGridControl>
                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="13" Grid.RowSpan="13" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.ColumnSpan="13" Grid.RowSpan="13"
    		    HorizontalAlignment="Center" Visibility="Collapsed" />
                <Border Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BorderThickness="1" BorderBrush="Gray" Background="Black" x:Name="errorWindow"
                    Visibility="{Binding ElementName=errorInfo, Path=Text, Converter={StaticResource ErrorInfoToVisibilityConverter}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=gridDataControl1, Mode=OneWay}" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2" Text="{x:Static properties:Resources.GridControlError}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Foreground="Red" />
                        <Button Grid.Column="1" Margin="2" Width="24" HorizontalAlignment="Right" Click="errorInfo_ClearMessage">
                            <Button.Content>
                                <Image Source="{DynamicResource Acknowledge}" Height="14" Width="14" />
                            </Button.Content>
                        </Button>
                        <TextBlock x:Name="errorInfo" Grid.Row="1" Grid.ColumnSpan="2" 
                                Margin="2" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Text="" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

    