<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate DataType="{x:Type ValidationError}">
        <StackPanel Orientation="Horizontal">
            <Image Source="..\Images\Common\Diamond.png" ToolTip="{Binding Path=ErrorContent}" Width="16" Height="16"/>
            <TextBlock FontStyle="Italic" Foreground="Red" HorizontalAlignment="Right" Margin="0,1"
                            Text="?" ToolTip="{Binding Path=ErrorContent}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
