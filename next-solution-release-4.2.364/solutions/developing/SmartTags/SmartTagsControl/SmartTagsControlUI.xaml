    xmlns:properties="clr-namespace:SmartTagsControl.Properties"
    xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
    x:Name="SmartTagsControl"
    Height="300" Width="300" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SmartTags.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <local:BoolToVisibilityHideConverter x:Key="BoolToVisibilityHideConverter"/>

