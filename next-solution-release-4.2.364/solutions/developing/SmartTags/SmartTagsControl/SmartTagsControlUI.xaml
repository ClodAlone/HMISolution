        </ResourceDictionary>
        
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Toolbar-->
        <dxb:BarContainerControl ContainerType="Top" x:Name="toolbarSelection" Grid.Row="0">
            <dxb:ToolBarControl BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                <dxb:BarCheckItem Glyph="{StaticResource STOkButton}" GlyphSize="Custom" CustomGlyphSize="14,14" x:Name="btnOK" ToolTip="Accept Changes" IsEnabled="False"/>
                <dxb:BarCheckItem Glyph="{StaticResource STCancelButton}" GlyphSize="Custom" CustomGlyphSize="14,14" x:Name="btnCancel" ToolTip="Cancel Changes" IsEnabled="False"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!-- Display message if not selection occurs -->
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 10, 0, 0"
                    Visibility="{Binding Path=IsAnyEditableObjects, 
                                Mode=OneWay, Converter={StaticResource BoolToVisibilityHideConverter}, ConverterParameter='True', 
                                UpdateSourceTrigger=PropertyChanged}"
                    Text="{x:Static properties:Resources.NotEditableObjectSelected}" />

        <!-- User Control for Smart Tags -->
        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Margin="5" >
          <dxnav:NavBarControl x:Name="tabNavControl" Grid.Row="1"
                               SelectedItem="{Binding Path=SelectedObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Visibility="{Binding Path=IsAnyEditableObjects, 
                                                        Mode=OneWay, Converter={StaticResource BoolToVisibilityHideConverter},
                                                        UpdateSourceTrigger=PropertyChanged}"
                                  Background="{x:Null}">
            <dxnav:NavBarControl.View>
              <dxnav:NavigationPaneView x:Name="navigationPane"
                                        IsExpandButtonVisible="False" MaxVisibleGroupCount="0"
                                        IsOverflowPanelVisible="False" IsSplitterVisible="False"
                                        ItemsPanelOrientation="Horizontal"/>
            </dxnav:NavBarControl.View>
          </dxnav:NavBarControl>
        </ScrollViewer>
    </Grid>
</UserControl>
