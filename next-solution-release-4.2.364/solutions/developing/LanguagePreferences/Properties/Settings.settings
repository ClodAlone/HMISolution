<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="LanguagePreferences.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="AllowMatchWindowsOption" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="Languages" Type="System.String" Scope="Application">
      <Value Profile="(Default)">en-US|it-IT|de-DE</Value>
    </Setting>
  </Settings>
</SettingsFile>