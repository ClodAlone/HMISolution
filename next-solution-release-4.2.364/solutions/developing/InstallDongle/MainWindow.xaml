<dx:ThemedWindow x:Class="InstallDongle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:properties="clr-namespace:InstallDongle.Properties"
        xmlns:local="clr-namespace:InstallDongle"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="{x:Static properties:Resources.Title}" Height="95" Width="610">
  <dx:ThemedWindow.Resources>
    <ResourceDictionary Source="/SharedResources;component/Resources/StartupWelcome.xaml" />
  </dx:ThemedWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Button Margin="5,5" FontSize="16" Click="Button_Click_3">
        <DockPanel LastChildFill="True">
          <Image Source="{StaticResource SWDongleOptions}" Width="32" Height="32" DockPanel.Dock="Left"/>
          <Label Margin="4,0" Content="{x:Static properties:Resources.DongleOptions}"/>
        </DockPanel>
      </Button>
      <Button Margin="5,5" FontSize="16" Grid.Column="1" Click="Button_Click_4">
        <DockPanel LastChildFill="True">
          <Image Source="{StaticResource SWDongleSettings}" Width="32" Height="32" DockPanel.Dock="Left"/>
          <Label Margin="4,0" Content="{x:Static properties:Resources.LicenceManager}"/>
        </DockPanel>
      </Button>
      <Button Margin="5,5" FontSize="16" Grid.Column="2" Click="Button_Click_5">
        <DockPanel LastChildFill="True">
          <Image Source="{StaticResource SWDongleService}" Width="32" Height="32" DockPanel.Dock="Left"/>
          <Label Margin="4,0" Content="{x:Static properties:Resources.DongleServiceText}"/>
        </DockPanel>
      </Button>
    </Grid>
  </Grid>
</dx:ThemedWindow>
