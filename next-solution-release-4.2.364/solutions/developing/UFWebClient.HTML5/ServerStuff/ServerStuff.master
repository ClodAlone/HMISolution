<body>
    <div class="metro appnavbar" runat="server" id="appnavbar">
        <ul>
            <li>
                <a class="backbutton" href="javascript:closeApp()" >
                    <img src="~/img/Left.png" runat="server" />
                </a>
            </li>
            <li>
                <h2 class="start">
                    <asp:ContentPlaceHolder ID="Header" runat="server"></asp:ContentPlaceHolder>
                </h2>
            </li>
            </ul>
    </div>

    <div class="appnavbar_space" runat="server" id="appnavbar_space"></div>
        
    <form id="Form1" runat="server">
        <div id="mainDiv" class="main" style="width:100%; height:100%">
            <asp:ContentPlaceHolder ID="body" runat="server">

