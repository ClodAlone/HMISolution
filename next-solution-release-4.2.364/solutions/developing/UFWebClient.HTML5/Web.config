  <appSettings>
    <add key="Uri" value="" />
    <add key="ClientSessionName" value="ScreenSinkHTML5" />
    <add key="RefreshPollingTime" value="100" />
    <add key="RefreshPollingTimeCount" value="10" />
    <add key="DelayBroadcaster" value="250" />
    <add key="SessionTimeout" value="60" />
    <add key="ConcurrentRenderingPipeline" value="5" />
    <add key="DisableStaticOptimization" value="False" />
    <add key="Theme" value="Blend" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <add key="log4net.Internal.Emit" value="false" />
  </appSettings>
  <connectionStrings>
    <remove name="LocalSqlServer" />
    <add name="LocalSqlServer" connectionString="Server=(local);Database=Movicon.Membership;Integrated Security=SSPI" />
  </connectionStrings>
