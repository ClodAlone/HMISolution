<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:EmptyProjectWizardPlugin.Properties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfc="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    x:Class="EmptyProjectWizardPlugin.ProjectArchitecture"
    mc:Ignorable="d"
    HorizontalAlignment="Left" VerticalAlignment="Top">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:DateTimeToTimeSpanConverter x:Key="DateTimeToTimeSpanConverter"/>
      <converters:UriToPartConverter x:Key="UriToPartConverter"/>           
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid HorizontalAlignment="Left">
    <DockPanel Margin="10" LastChildFill="True">
      <DockPanel x:Name="serverList" DockPanel.Dock="Right"  Visibility="Collapsed"
    VerticalAlignment="Top" Margin="10" MinWidth="250">
        <TextBlock Margin="10,10,10,0" x:Name="redundancyFullSynchronizationStartTime"
 DockPanel.Dock="Top" VerticalAlignment="Top"
 Text="{x:Static properties:Resources.RedundancyFullSynchronizationStartTime}"/>
        <dxe:ButtonEdit  Margin="10,0" DockPanel.Dock="Top" VerticalAlignment="Top"
          x:Name="textEditFullSynchronizationStartTime"
          Text="{Binding RedundancyFullSynchronizationStartTime, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
          EditValue="{Binding RedundancyFullSynchronizationStartTime, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" AllowDefaultButton="False" AllowSpinOnMouseWheel="False"
          MaskType="DateTimeAdvancingCaret" Mask="T" AllowUpdateTwoWayBoundPropertiesOnSynchronization="True" AllowUpdateTextBlockWhenPrinting="True" DisplayFormatString="T" >
                <dxe:ButtonEdit.Buttons>
                  <dxe:SpinButtonInfo SpinStyle="Vertical"
                   SpinDownCommand="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:ButtonEdit}}, Path=SpinDownCommand}"
                   SpinUpCommand="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:ButtonEdit}}, Path=SpinUpCommand}"
                 />
                </dxe:ButtonEdit.Buttons>
              </dxe:ButtonEdit>
        <TextBlock Margin="10,10,10,0"
   DockPanel.Dock="Top" VerticalAlignment="Top"
   Text="{x:Static properties:Resources.RedundancyFullSynchronizationTimeSpan}"/>
        <wpfc:TimeSpanEdit   Margin="10,0"
     DockPanel.Dock="Top" VerticalAlignment="Top"
     x:Name="textEditFullSynchronizationTimeSpan"
     TimeSpan="{Binding RedundancyFullSynchronizationTimeSpan, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
     Validation.ErrorTemplate="{x:Null}"
     ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />
        <TextBlock  x:Name="serversLabel"
    Margin="10,53,10,0"
    DockPanel.Dock="Top" VerticalAlignment="Top"
    Text="{x:Static properties:Resources.ServerList}"/>
        <Grid Margin="10,0" DockPanel.Dock="Top" VerticalAlignment="Top" Height="140">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10*"/>
          </Grid.RowDefinitions>
          <TextBox x:Name="txtName"/>
          <ListBox Grid.Row="1" x:Name="listBoxServer" Margin="0,2"/>
          <Grid Grid.Column="1" Grid.RowSpan="2" Margin="0,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Click="redundancyServersAdd_Click" Margin="2,0">
              <Button.Content>
                <Image Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
              </Button.Content>
            </Button>
            <Button Click="redundancyServersRemove_Click" Margin="2,0" Grid.Row="1">
              <Button.Content>
                <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
              </Button.Content>
            </Button>
            <Button Click="redundancyServersMoveUp_Click" Margin="2,0" Grid.Row="2">
              <Button.Content>
                <Image Source="{StaticResource MoveUpSmall}" Height="16" Width="16" />
              </Button.Content>
            </Button>
            <Button Click="redundancyServersMoveDown_Click" Margin="2,0" Grid.Row="3">
              <Button.Content>
                <Image Source="{StaticResource MoveDownSmall}" Margin="2,0" Height="16" Width="16" />
              </Button.Content>
            </Button>
            <Button Click="redundancyServersClear_Click" Margin="2,0" Grid.Row="4">
              <Button.Content>
                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16" />
              </Button.Content>
            </Button>
          </Grid>
        </Grid>
      </DockPanel>
      <DockPanel VerticalAlignment="Top">
        <DockPanel x:Name="transportList"
    DockPanel.Dock="Bottom" VerticalAlignment="Top" Margin="10,0" Visibility="Collapsed" >
          <Label  Margin="10,10,10,0"  x:Name="transportLabel" DockPanel.Dock="Top" VerticalAlignment="Top" Content="{x:Static properties:Resources.TransportType}"/>
          <ComboBox Margin="10,0" x:Name="transport" MinWidth="200" 
                    SelectedIndex="0" DisplayMemberPath="Scheme" DockPanel.Dock="Top" VerticalAlignment="Top"/>
          <Label  Margin="10,10,10,0"  x:Name="serverNameLabel" DockPanel.Dock="Top" VerticalAlignment="Top" Content="{x:Static properties:Resources.ServerName}"/>
          <TextBox x:Name="txtServerName" Margin="10,0" DockPanel.Dock="Top" VerticalAlignment="Top" 
                   Text="{Binding SelectedValue, ElementName=transport, Mode=OneWay, Converter={StaticResource UriToPartConverter}, ConverterParameter=Host}" />
          <Label  Margin="10,10,10,0"  x:Name="portNumberLabel" DockPanel.Dock="Top" VerticalAlignment="Top" Content="{x:Static properties:Resources.PortNumber}"/>
          <TextBox x:Name="txtPortNumber" Margin="10,0" DockPanel.Dock="Top" VerticalAlignment="Top" 
                   Text="{Binding SelectedValue, ElementName=transport, Mode=OneWay, Converter={StaticResource UriToPartConverter}, ConverterParameter=Port}" />
        </DockPanel>
        <ListBox Grid.Row="0" Grid.Column="2" x:Name="listBoxLink" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Height="250" Width="550"
    DockPanel.Dock="Left" VerticalAlignment="Top" SelectedIndex="0"
    Background="{x:Null}"
    BorderBrush="{x:Null}"
    AlternationCount="1"
    Margin="5"
    HorizontalAlignment="Center"
    PreviewMouseLeftButtonUp="listBoxLink_PreviewMouseLeftButtonUp">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Tag="{Binding}"
                  MinHeight="100"
                  MinWidth="120"
                  Margin="5">
                <Grid.RowDefinitions>
                  <RowDefinition Height="8*"/>
                  <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Image Stretch="Uniform" Source="{Binding Image}" Width="64" Height="64"/>
                <TextBlock Grid.Row="1" Text="{Binding Description}"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Center"
                 TextWrapping="WrapWithOverflow"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>
