<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="ReportManager.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultFileExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.report</Value>
    </Setting>
    <Setting Name="TypeLabel" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Report</Value>
    </Setting>
    <Setting Name="DefaultReportName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Report</Value>
    </Setting>
    <Setting Name="UseEditorWPF" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="SaveAsFileExtensions" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.bmp;.png;.gif;.tif;.jpg;.jpeg;.tiff;.ico;.emf;.wmf;.svg</Value>
    </Setting>
    <Setting Name="MaxPendingOperations" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">10</Value>
    </Setting>
    <Setting Name="MaxWaitPendingOperationsOnClosing" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">30000</Value>
    </Setting>
  </Settings>
</SettingsFile>