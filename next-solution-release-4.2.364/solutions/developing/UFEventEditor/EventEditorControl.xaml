<UserControl x:Class="UFEventEditor.EventEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFEventEditor"
             xmlns:Controls="clr-namespace:UFEventEditor.Controls"
             xmlns:properties="clr-namespace:UFEventEditor.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewEvent}" 
                    Executed="OnAddNewEvent" 
                    CanExecute="CanAddNewEvent" />

        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

        <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    Executed="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />
            
        <CommandBinding Command="ApplicationCommands.Redo"
                    Executed="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewFolder}" 
                    Executed="OnAddNewFolder" 
                    CanExecute="CanAddNewFolder" />
        
    </UserControl.CommandBindings>
    <Grid x:Name="PluginGrid">
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="98*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="98*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Rectangle  RadiusX="10" Grid.ColumnSpan="3" Grid.RowSpan="3"
                    RadiusY="10" 
                    Stroke="#99000000" 
                    StrokeDashArray="2"
                    Margin="12,10,12,12" />-->
        <Grid x:Name="inEventsGrid" Margin="10" />
    </Grid>
</UserControl>
