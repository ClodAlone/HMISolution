<UserControl x:Class="AnimationExplorer.Controls.GridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"      
             xmlns:self="clr-namespace:AnimationExplorer" 
             xmlns:properties="clr-namespace:AnimationExplorer.Properties" 
             DataContextChanged="control_DataContextChanged" 
             DragOver="UserControl_DragOver" Drop="UserControl_Drop" QueryContinueDrag="UserControl_QueryContinueDrag"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Delete" Executed="DeleteCommandBinding_Executed" CanExecute="DeleteCommandBinding_CanExecute" />
        <CommandBinding Command="EditingCommands.MoveUpByLine" Executed="MoveUpCommandBinding_Executed" CanExecute="MoveUpCommandBinding_CanExecute" />
        <CommandBinding Command="EditingCommands.MoveDownByLine" Executed="MoveDownCommandBinding_Executed" CanExecute="MoveDownCommandBinding_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyCommandBinding_Executed" CanExecute="CopyCommandBinding_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="PasteCommandBinding_Executed" CanExecute="PasteCommandBinding_CanExecute" />
        <CommandBinding Command="{x:Static self:UIAnimationCommands.CopyAll}" 
                    Executed="CopyAllCommandBinding_Executed" 
                    CanExecute="CopyAllCommandBinding_CanExecute" />
    </UserControl.CommandBindings>



    <Grid x:Name="gridList">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--Toolbar-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static properties:Resources.AvailableAnimations}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <StackPanel x:Name="toolbar" LayoutUpdated="toolbar_LayoutUpdated" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical">
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <dxg:GridControl Name="gridControl" Grid.Row="1" Width="Auto">
            <dxg:GridControl.Columns>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" Header="{x:Static properties:Resources.TitleColumnHeader}" />
                <!--<dxg:GridColumn DisplayMemberBinding="{Binding Path=AnimationSummary,UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Header="{x:Static properties:Resources.AnimationTag}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=AnimationTime, Mode=OneWay}" Header="{x:Static properties:Resources.AnimationTimeColumnHeader}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Repeatable, Mode=OneWay}" Header="{x:Static properties:Resources.RepeatableTimeColumnHeader}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=AnimationBehavior, Mode=OneWay}" Header="{x:Static properties:Resources.AnimationBehaviorTimeColumnHeader}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=AnimationEquation, Mode=OneWay}" Header="{x:Static properties:Resources.AnimationEquationTimeColumnHeader}" />-->
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowGroupPanel="False" SelectionChanged="tableView_SelectionChanged" FocusedRowHandleChanged="tableView_FocusedRowChanged" VerticalScrollbarVisibility="Auto" />
            </dxg:GridControl.View>
        </dxg:GridControl>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0">
                <Button BorderThickness="0" Command="EditingCommands.MoveUpByLine"  ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                    Path=Command.Text}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource RoadForward}"  Stretch="None" Width="16" Height="16" />
                    </StackPanel>
                    <!--<Image Source="{StaticResource RoadForward}" Stretch="Fill"/>-->
                </Button>
                <Button BorderThickness="0" Command="EditingCommands.MoveDownByLine" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                        Path=Command.Text}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource RoadBackward}"  Stretch="None" Width="16" Height="16" />
                    </StackPanel>
                    <!--<Image Source="{StaticResource RoadBackward}" Width="16" Height="16"/>-->
                </Button>
                <Separator Margin="5"/>
                <Button BorderThickness="0" Command="ApplicationCommands.Copy" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                    Path=Command.Text}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CopySelected}"  Stretch="None" Width="16" Height="16" />
                    </StackPanel>
                    <!--<Image Source="{StaticResource CopySmall}" Width="16" Height="16"/>-->
                </Button>
                <Button BorderThickness="0" Command="{x:Static self:UIAnimationCommands.CopyAll}"  
                        ToolTip="{x:Static properties:UICommandResource.CopyAllTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource CopyAll}"  Stretch="None" Width="16" Height="16" />
                    </StackPanel>
                    <!--<Image Source="{StaticResource CopySmall}"/>-->
                </Button>

                <Button BorderThickness="0" Command="ApplicationCommands.Paste" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                    Path=Command.Text}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource PasteSmall}" Stretch="None"  Width="16" Height="16" />
                    </StackPanel>
                    <!--<Image Source="{StaticResource PasteSmall}" Width="16" Height="16"/>-->
                </Button>
                <Separator Margin="5"/>
                <Button BorderThickness="0" x:Name="btnDelete" Command="ApplicationCommands.Delete" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                    Path=Command.Text}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Delete}"  Stretch="Uniform" Width="16" Height="16" />
                    </StackPanel>
                    <!--<Image Source="{StaticResource Delete}" Width="16" Height="16"/>-->
                </Button>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
