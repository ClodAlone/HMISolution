<UserControl x:Class="UFUAServiceLibrary.InstallServiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:UFUAServiceLibrary.Properties"
             xmlns:self="clr-namespace:UFUAServiceLibrary" 
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/UFUAServiceLibrary.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
    <UserControl.CommandBindings>

        <CommandBinding Command="{x:Static self:InstallServiceControl.InstallAsService}" 
                    Executed="OnInstallAsService" 
                    CanExecute="CanInstallAsService" />

        <CommandBinding Command="{x:Static self:InstallServiceControl.UninstallAsService}" 
                    Executed="OnUninstallAsService" 
                    CanExecute="CanUninstallAsService" />

        <CommandBinding Command="{x:Static self:InstallServiceControl.StartService}" 
                    Executed="OnStartService" 
                    CanExecute="CanStartService" />

        <CommandBinding Command="{x:Static self:InstallServiceControl.StopService}" 
                    Executed="OnStopService" 
                    CanExecute="CanStopService" />

    </UserControl.CommandBindings>

    <Grid Name="maingrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition/>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

      <TextBlock Margin="10"  Text="{x:Static properties:Resources.Title}" Grid.Row="0" HorizontalAlignment="Left" />
      <Grid Margin="20, 10" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.Username}" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" />
        <TextBox Margin="5,0" Name="Username" Grid.Column="1" Grid.Row="0" Text="{Binding UserName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
        <ContentPresenter Grid.Row="0" Grid.Column="2"
            Content="{Binding ElementName=Username, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Margin="2,2,2,2" Text="{x:Static properties:Resources.Password}" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right"/>
        <cc:BindablePasswordBox Margin="5,0" Grid.Row="1" Grid.Column="1" Password="{Binding Password, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="Password" />
        <ContentPresenter Grid.Row="1" Grid.Column="2"
            Content="{Binding ElementName=Password, Path=(Validation.Errors).CurrentItem}"/>
      </Grid>
      <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="5"
                Command="{x:Static self:InstallServiceControl.InstallAsService}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFUASLServiceInstalled}" Width="16" Height="16"/>
                    <TextBlock Text="{x:Static properties:Resources.InstallServiceButtonText}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Margin="5"
                Command="{x:Static self:InstallServiceControl.UninstallAsService}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFUASLServiceUninstalled}"  Width="16" Height="16"/>
                    <TextBlock Text="{x:Static properties:Resources.UninstallServiceButtonText}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Margin="5"
                Command="{x:Static self:InstallServiceControl.StartService}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFUASLServiceStarted}" Width="16" Height="16"/>
                    <TextBlock Text="{x:Static properties:Resources.StartServiceButtonText}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Margin="5"
                Command="{x:Static self:InstallServiceControl.StopService}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFUASLServiceStopped}" Width="16" Height="16"/>
                    <TextBlock Text="{x:Static properties:Resources.StopServiceButtonText}" />
                </StackPanel>
            </Button>

        </Grid>
    </Grid>

</UserControl>
