<UserControl x:Class="AnimatedObjects.Controls.UriImageListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnimatedObjects.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:AnimatedObjects.Properties"
             xmlns:converters="clr-namespace:AnimatedObjects.Controls"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:UriToVisualBrushConverter x:Key="UriToVisualBrushConverter" />
            <utilities:UriToUriAbsoluteImageConverter x:Key="uriToUriAbsoluteImageConverter" x:Shared="True"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
            <Button Grid.Row="1" Grid.Column="0" Click="OnAdd" Margin="0"  ToolTip="{x:Static properties:Resources.AddImageButtonTitle}">
            <Button.Content>
                    <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
            </Button.Content>

        </Button>
            <Button Grid.Row="1" Grid.Column="1" x:Name="btnDelete" ToolTip="{x:Static properties:Resources.DeleteImageButtonTitle}"
                            Click="OnDelete" Margin="0">
            <Button.Content>
                    <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
            <Button Grid.Row="1" Grid.Column="2"  Margin="0"  Click="OnMoveDown"  ToolTip="{x:Static properties:Resources.MoveDownButtonTitle}">
                <Image Source="{StaticResource MoveDownSmall}" Height="16" Width="16" />
        </Button>
            <Button Grid.Row="1" Grid.Column="3"  Margin="0"  Click="OnMoveUp"  ToolTip="{x:Static properties:Resources.MoveUpButtonTitle}">
                <Image Source="{StaticResource MoveUpSmall}" Height="16" Width="16" />
        </Button>
        </Grid>
    <dxg:GridControl MaxHeight="360" AllowDrop="False" Grid.Row="7" Grid.ColumnSpan="2" Name="gridControl" Height="275">
            <dxg:GridControl.Columns>
                <dxg:GridColumn AllowDrop="False" DisplayMemberBinding="{Binding Path=Value, Mode=TwoWay}" AllowMoving="False" Width="80"  Header="{x:Static properties:Resources.ImageColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <DockPanel.ToolTip>
                                    <TextBlock  DockPanel.Dock="Bottom" MaxWidth="250" Height="Auto" TextWrapping="Wrap" HorizontalAlignment="Left" Text="{Binding Path=Data.Value}"/>
                                </DockPanel.ToolTip>
                                <Button Width="64" Height="64" DockPanel.Dock="Right" Click="ButtonImageClear_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Width="64" Height="64" Tag="{Binding Path=Data.Value}" x:Name="buttonTag" DockPanel.Dock="Right" Click="ButtonImage_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Rectangle  Width="64" Height="64" Fill="{Binding Data.Value, Mode=OneWay,Converter={StaticResource UriToVisualBrushConverter}}">
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Data.Value, Mode=OneWay,Converter={StaticResource UriToVisualBrushConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                                   AllowSorting="False"/>

            </dxg:GridControl.View>
        </dxg:GridControl>

    </StackPanel>
</UserControl>
