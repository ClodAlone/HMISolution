<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             x:Class="AnimatedObjects.Controls.ImageSmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:properties="clr-namespace:AnimatedObjects.Properties" 
             xmlns:converters="clr-namespace:AnimatedObjects.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:UriToVisualBrushConverter x:Key="UriToVisualBrushConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <StackPanel x:Name="OptionsB" Margin="0,2" >
            <Grid  x:Name="Options5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Button Grid.Row="1" Grid.Column="0" Click="OnAdd" Margin="0">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                    </Button.Content>

                </Button>
                <Button Grid.Row="1" Grid.Column="1" IsEnabled="False" x:Name="btnDelete" 
                            Click="OnDelete" Margin="0">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <!--CustomColumnSort="grid_CustomColumnSort"-->
            <dxg:GridControl MaxHeight="360" AllowDrop="False" Grid.Row="7" Grid.ColumnSpan="2" Name="gridControl">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Value" SortOrder="Ascending" SortMode="Value" Width="50" Header="{x:Static properties:Resources.ValueColumnHeader}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="d" HorizontalContentAlignment="Right" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="AnimationTime" Width="50" Header="{x:Static properties:Resources.AnimationTimeColumnHeader}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="d" HorizontalContentAlignment="Right" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn AllowDrop="False" AllowMoving="False" Width="80"  Header="{x:Static properties:Resources.ImageColumnHeader}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button DockPanel.Dock="Right" Click="ButtonImageClear_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Button.Content>
                                            <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                        </Button.Content>
                                    </Button>
                                    <Button Tag="{Binding Data.BackImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Click="ButtonImage_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Button.Content>
                                            <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                        </Button.Content>
                                    </Button>
                                    <Rectangle Width="16"  Fill="{Binding Data.BackImage, Mode=OneWay,Converter={StaticResource UriToVisualBrushConverter}}">
                                        <Rectangle.ToolTip>
                                            <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Data.BackImage, Mode=OneWay,Converter={StaticResource UriToVisualBrushConverter}}" />
                                        </Rectangle.ToolTip>
                                    </Rectangle>
                                </DockPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="ImageStretch" DisplayMemberBinding="{Binding Path=ImageStretch, Mode=TwoWay}" Header="{x:Static properties:Resources.ImageStretchColumnHeader}">
                        <dxg:GridColumn.EditTemplate>
                            <ControlTemplate>
                                <dxe:ComboBoxEdit Name="PART_Editor" 
                                          HorizontalContentAlignment="Left"                                        
                                          EditValue="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}" 
                                          SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                                          Text="{Binding Path=EditValue, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          EditorActivated="STRETCH_Editor_DropDownOpened"
                                          IsTextEditable="False"
                                          AllowNullInput="False" 
                                          AcceptsReturn="False"
                                          AutoComplete="False" 
                                          ImmediatePopup="True" SelectedIndexChanged="PART_Editor_SelectedIndexChanged">
                                </dxe:ComboBoxEdit>
                            </ControlTemplate>
                        </dxg:GridColumn.EditTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                                   AllowSorting="False" EnableImmediatePosting="True" AllowBestFit="True"
                                   FocusedRowChanged="tableView_FocusedRowChanged" ValidateRow="tableView_ValidateRow" 
                                   InvalidRowException="tableView_InvalidRowException" CellValueChanged="tableView_CellValueChanged" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </StackPanel>
    </StackPanel>
</UserControl>
