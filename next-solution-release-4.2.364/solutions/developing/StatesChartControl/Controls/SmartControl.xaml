<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             x:Class="StatesChartControl.Controls.SmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:properties="clr-namespace:StatesChartControl.Properties" 
             xmlns:converters="clr-namespace:StatesChartControl.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:smartutils="clr-namespace:SmartControlUtilities.Controls;assembly=SmartControlUtilities">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--<converters:ValueItemToVisualBrushConverter x:Key="ValueItemToVisualBrushConverter" />-->
            <converters:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Click="OnAdd" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                </Button.Content>

            </Button>
            <Button Grid.Column="1" IsEnabled="False" x:Name="btnDelete" Click="OnDelete" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
          <Button Click="OnMoveUp" Grid.Column="2"
                  ToolTip="{x:Static properties:Resources.MoveUp}" Margin="5,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource MoveUpSmall}" Height="16" Width="16" />
            </Button.Content>

          </Button>
          <Button Click="OnMoveDown" Grid.Column="3"
                  ToolTip="{x:Static properties:Resources.MoveDown}" Margin="5,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource MoveDownSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
        </Grid>
        <!--CustomColumnSort="grid_CustomColumnSort"-->
        <dxg:GridControl AllowDrop="False" Grid.Row="1" Name="gridControl">
            <dxg:GridControl.Columns>
                <!-- Pen Name -->
                <dxg:GridColumn MinWidth="50" Header="{x:Static properties:Resources.Title}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <smartutils:PenNameSelector PropName="title" 
                                OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <!-- Variable Selection-->
                <dxg:GridColumn MinWidth="50" AllowDrop="False" AllowEditing="False" DisplayMemberBinding="{Binding Path=tagName, Mode=TwoWay}" Header="{x:Static properties:Resources.TagName}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <smartutils:TagSelector RuntimeVersion="False" ReferencedTag="tagReference" HistoricalPropName="HistoricalDlrName" ColumnPropName="ColuName" DlrsourcePropName="Dlrsource"
                                OnlyHistoricalTags="True" OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <!--<dxg:GridColumn DisplayMemberBinding="{Binding Data.ArrayIndex, Mode=TwoWay}" Header="{x:Static properties:Resources.ArrayIndexTitle}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>-->
                <dxg:GridColumn  Header="{x:Static properties:Resources.Dlrsource}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <CheckBox Click="CheckBox_Click" HorizontalAlignment="Center" IsChecked="{Binding Data.Dlrsource, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn AllowDrop="False" Name="historicalName" AllowEditing="False" DisplayMemberBinding="{Binding Path=HistoricalDlrName, Mode=TwoWay}" Header="{x:Static properties:Resources.HistoricalDlrName}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" ToolTip="{Binding Data.HistoricalDlrName}" Grid.Column="1" Grid.Row="1"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBox IsReadOnly="False" x:Name="historical" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                 ToolTip="{Binding Data.HistoricalDlrName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Data.HistoricalDlrName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <!-- Value/Color pairs -->
                <dxg:GridColumn AllowDrop="False" AllowMoving="False" Width="80"  Header="{x:Static properties:Resources.ImageColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Click="ButtonImageClear_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Tag="{Binding Data.ValueItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Click="ButtonImage_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Rectangle Fill="{Binding Data.FirstBackground, Mode=OneWay}">
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Data.FirstBackground, Mode=OneWay}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <!-- Animation (eventually, it will be moved to PenValuesListEditor) -->
                <!--<dxg:GridColumn  Width="50" Header="{x:Static properties:Resources.AnimationTimeColumnHeader}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:TextEdit HorizontalContentAlignment="Right" MaskType="Numeric" Mask="d" EditValue="{Binding Data.AnimationTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EditValueChanged="TextEdit_EditValueChanged"/>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>-->
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                                   AllowSorting="False"
                                   FocusedRowChanged="tableView_FocusedRowChanged"
                                   CellValueChanged="tableView_CellValueChanged" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
