<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             x:Class="StatesChartControl.Controls.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"  Width="500" Height="370"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:self="clr-namespace:StatesChartControl.Controls"
             xmlns:enum="clr-namespace:StatesChartControl"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:smartutils="clr-namespace:SmartControlUtilities.Controls;assembly=SmartControlUtilities"
             xmlns:properties="clr-namespace:StatesChartControl.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="itemstyle" TargetType="{x:Type ListViewItem}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True" >
                        <Setter Property="Background" Value="Gray" />
                        <Setter Property="Foreground" Value="Black" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#797979"/>
                        <Setter Property="Foreground" Value="Black" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1"  x:Name="commands">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddPen}">
                    <Button.Content>
                        <Image Margin="2" Source="{DynamicResource AddNewSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="1" IsEnabled="False" x:Name="btnDelete" 
                        ToolTip="{x:Static properties:Resources.RemovePen}" Click="OnDelete">
                    <Button.Content>
                        <Image Margin="2" Source="{DynamicResource RemoveMinusSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2" IsEnabled="True" x:Name="btnClearAll" 
                        ToolTip="{x:Static properties:Resources.ClearAll}" Click="ClearAll_Click">
                    <Button.Content>
                        <Image Margin="2" Source="{DynamicResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <dxg:GridControl Visibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AllowDrop="False" MinWidth="2" Grid.Row="0" x:Name="gridControl">
                <dxg:GridControl.Columns>
                    <!-- Pen Name -->
                    <dxg:GridColumn MinWidth="50" Header="{x:Static properties:Resources.Title}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <smartutils:PenNameSelector PropName="title" 
                                OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <!-- Variable Selection-->
                    <dxg:GridColumn MinWidth="50" AllowDrop="False" AllowEditing="False" DisplayMemberBinding="{Binding Path=tagName, Mode=TwoWay}" Header="{x:Static properties:Resources.TagName}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <smartutils:TagSelector NodeID="NodeId" RuntimeVersion="True" ReferencedTag="tagReference" HistoricalPropName="HistoricalDlrName" ColumnPropName="ColuName" DlrsourcePropName="Dlrsource"
                                OnlyHistoricalTags="True" OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn  Header="{x:Static properties:Resources.Dlrsource}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <CheckBox Click="CheckBox_Click" HorizontalAlignment="Center" IsChecked="{Binding Data.Dlrsource, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn AllowDrop="False" Name="historicalName" AllowEditing="False" DisplayMemberBinding="{Binding Path=HistoricalDlrName, Mode=TwoWay}" Header="{x:Static properties:Resources.HistoricalDlrName}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" ToolTip="{Binding Data.HistoricalDlrName}" Grid.Column="1" Grid.Row="1"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <TextBox IsReadOnly="False" x:Name="historical" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                 ToolTip="{Binding Data.HistoricalDlrName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Data.HistoricalDlrName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <!-- Value/Color pairs -->
                    <dxg:GridColumn AllowDrop="False" AllowMoving="False" Width="80"  Header="{x:Static properties:Resources.ImageColumnHeader}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button DockPanel.Dock="Right" Click="ButtonImageClear_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Button.Content>
                                            <Image Source="{DynamicResource CancelSmall}" Height="16" Width="16" />
                                        </Button.Content>
                                    </Button>
                                    <Button Tag="{Binding Data.ValueItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Click="ButtonImage_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <Button.Content>
                                            <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                                        </Button.Content>
                                    </Button>
                                    <Rectangle Fill="{Binding Data.FirstBackground, Mode=OneWay}">
                                        <Rectangle.ToolTip>
                                            <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Data.FirstBackground, Mode=OneWay}" />
                                        </Rectangle.ToolTip>
                                    </Rectangle>
                                </DockPanel>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AllowMoveColumnToDropArea="False" 
                                       Name="tableView" ShowTotalSummary="False"  
                                       FocusedRowChanged="tableView_FocusedRowChanged"
                                       CellValueChanged="tableView_CellValueChanged"  
                                       AutoWidth="true" ShowGroupPanel="False" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
