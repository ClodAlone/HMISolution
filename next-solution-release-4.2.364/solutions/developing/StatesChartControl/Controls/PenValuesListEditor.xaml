<UserControl x:Class="StatesChartControl.Controls.PenValuesListEditor"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StatesChartControl.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:StatesChartControl.Properties" 
             xmlns:converters="clr-namespace:StatesChartControl.Controls"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             mc:Ignorable="d" 
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             d:DesignHeight="300" d:DesignWidth="300"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ValueItemToVisualBrushConverter x:Key="ValueItemToVisualBrushConverter" />
            <utilities:BrushToNameConverter x:Key="BrushNameConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <TextBlock TextWrapping="Wrap" Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.ValueNotFoundBackground}"/>
            <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <!--<Button Width="32" Height="32" Tag="{Binding ValueNotFoundBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="buttonVNFTag" DockPanel.Dock="Right" Click="ButtonVNF_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Rectangle DataContext="{Binding ElementName=root}" x:Name="rowBrushVNF" Height="32" Fill="{Binding ValueNotFoundBackground, Mode=OneWay}"/>-->
                <commoncontrols:CustomPopupColorEdit x:Name="popupColorEditVNF" OnlySolidColors="False"
                    Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" DockPanel.Dock="Right"
                    SelectedBrush="{Binding ValueNotFoundBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Row="1" Grid.Column="0" Click="OnAdd" Margin="0"  ToolTip="{x:Static properties:Resources.AddImageButtonTitle}">
                <Button.Content>
                    <Image Margin="2" Source="{DynamicResource AddNewSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" x:Name="btnDelete" ToolTip="{x:Static properties:Resources.DeleteImageButtonTitle}"
                            Click="OnDelete" Margin="0">
                <Button.Content>
                    <Image Margin="2" Source="{DynamicResource RemoveMinusSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Row="1" Grid.Column="2"  Margin="0"  Click="OnMoveDown"  ToolTip="{x:Static properties:Resources.MoveDownButtonTitle}">
                <Image Source="{DynamicResource MoveDownSmall}" Height="16" Width="16" />
            </Button>
            <Button Grid.Row="1" Grid.Column="3"  Margin="0"  Click="OnMoveUp"  ToolTip="{x:Static properties:Resources.MoveUpButtonTitle}">
                <Image Source="{DynamicResource MoveUpSmall}" Height="16" Width="16" />
            </Button>
        </Grid>
        <dxg:GridControl MaxHeight="360" AllowDrop="False" Grid.Row="7" Grid.ColumnSpan="2" Name="gridControl" Height="275" SelectionMode="MultipleRow">
            <dxb:BarManager.DXContextMenu>
                <dxb:PopupMenu x:Name="contextMenu">
                    <dxb:PopupMenu.Items>
                        <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}"/>
                        <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}"/>
                        <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}"/>
                    </dxb:PopupMenu.Items>
                </dxb:PopupMenu>
            </dxb:BarManager.DXContextMenu>
            <dxg:GridControl.CommandBindings>
                <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />
                <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />
                <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />
            </dxg:GridControl.CommandBindings>
            <dxg:GridControl.Columns>
                <dxg:GridColumn AllowDrop="False" DisplayMemberBinding="{Binding Path=Value, Mode=TwoWay}" AllowMoving="False" Header="{x:Static properties:Resources.ImageColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <DockPanel.ToolTip>
                                    <TextBlock  DockPanel.Dock="Bottom" MaxWidth="250" Height="Auto" TextWrapping="Wrap" HorizontalAlignment="Left" Text="{Binding Path=Data.Value}"/>
                                </DockPanel.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" LastChildFill="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <TextBlock Padding="5,5,5,0" Width="Auto" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static properties:Resources.LabelColumnHeader}"/>
                                        <DockPanel LastChildFill="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Button VerticalAlignment="Stretch" DockPanel.Dock="Right" Click="DlgButtonClear_Click" HorizontalAlignment="Stretch">
                                                <Button.Content>
                                                    <Image Source="{DynamicResource CancelSmall}" Height="16" Width="16" />
                                                </Button.Content>
                                            </Button>
                                            <Button VerticalAlignment="Stretch" DockPanel.Dock="Right" Click="DlgButton_Click" HorizontalAlignment="Stretch">
                                                <Button.Content>
                                                    <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                                                </Button.Content>
                                            </Button>
                                            <dxe:TextEdit Padding="5" x:Name="text" HorizontalContentAlignment="Right" MaskType="None" EditValue="{Binding Data.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </DockPanel>
                                    <DockPanel Grid.Column="1" LastChildFill="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <TextBlock Padding="5,5,5,0" Width="Auto" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static properties:Resources.ValueColumnHeader}"/>
                                        <dxe:TextEdit Padding="5" HorizontalContentAlignment="Right" MaskType="Numeric" Mask="d" CausesValidation="True" Validate="ItemValue_Validate" EditValue="{Binding Data.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    </DockPanel>
                                    <DockPanel Grid.Column="2" LastChildFill="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <commoncontrols:CustomPopupColorEdit x:Name="popupColorEdit" OnlySolidColors="False"
                                            Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" DockPanel.Dock="Right"
                                            SelectedBrush="{Binding Data.ControlBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView ShowIndicator="False" ShowCheckBoxSelectorColumn="True" NavigationStyle="Row" Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                                   AllowSorting="False"/>

            </dxg:GridControl.View>
        </dxg:GridControl>
    </StackPanel>
</UserControl>
