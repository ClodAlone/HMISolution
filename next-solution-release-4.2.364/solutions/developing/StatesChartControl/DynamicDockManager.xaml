<UserControl 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:StatesChartControl.Properties"
             mc:Ignorable="d" 
             x:Class="StatesChartControl.DynamicDockManager"         
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:ve="http://schemas.devexpress.com/winfx/2008/xaml/docking/visualelements"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/docking/themekeys"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:converters="clr-namespace:StatesChartControl.Converters"
    d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TextToVisibilityConverter x:Key="TextToVisibilityConverter" /> 
            <!-- Below: hiding the autohidden labels -->
            <!--<Style TargetType="ve:AutoHideTray">
                <Setter Property="Width" Value="0"/>
            </Style>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <AdornerDecorator>
    <dxd:DockLayoutManager x:Name="dockManager" DockItemHidden="OnDockItemHidden" ClosedPanelsBarVisibility="Auto" Background="{Binding Background}">
            <dxd:LayoutGroup x:Name="groupGeneral">
                <dxd:LayoutPanel BorderThickness="0" ShowCaption="False" x:Name="chartPanel">
                <dxd:LayoutPanel.Resources>
                    <ControlTemplate x:Key="{dxt:DockPaneElementsThemeKey ResourceKey=Template, IsThemeIndependent=true}" TargetType="ve:DockPane">
                        <Grid ve:DockPane.HitTestType="Bounds" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ve:DockPaneHeaderPresenter x:Name="PART_Header" Grid.Row="0" Content="{TemplateBinding Header}" Margin="{DynamicResource {dxt:DockPaneElementsThemeKey ResourceKey=HeaderMargin}}" />
                                <ve:DockPaneContentPresenter x:Name="PART_Content" Grid.Row="1" Content="{TemplateBinding Content}" Margin="{Binding Path=LayoutItem.ActualPadding, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </dxd:LayoutPanel.Resources>
            </dxd:LayoutPanel>
            </dxd:LayoutGroup>
        <dxd:DockLayoutManager.AutoHideGroups>
            <dxd:AutoHideGroup DockType="Left" AutoHideSize="200,200" x:Name="autoHideLeft">
                <dxd:LayoutPanel ShowCaption="True" Caption="{x:Static properties:Resources.TimeRange}" x:Name="timeRangePanel">
                    <Grid x:Name="timeRangeGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="docked_startdate" Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.StartDate}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="True">
                                <Button Grid.Row="0" x:Name="todayButton" DockPanel.Dock="Right" Click="FromToday_Click">
                                    <Button.Content>
                                        <Image Margin="2" x:Name="refreshSmall1" Source="{DynamicResource RefreshSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <dxe:TextEdit x:Name="startTime" Grid.Row="0" Grid.Column="1" EditValue="{Binding DateTimeStart}" VerticalAlignment="Center"
                                          MaskType="DateTime"  DisplayFormatString="" />
                            </DockPanel>
                            <TextBlock x:Name="docked_enddate" Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.EndDate}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="1" Grid.Column="1" LastChildFill="True">
                                <Button Grid.Row="0" x:Name="tomorrowButton" DockPanel.Dock="Right" Click="TillTomorrow_Click">
                                    <Button.Content>
                                        <Image Margin="2" x:Name="refreshSmall2" Source="{DynamicResource RefreshSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <dxe:TextEdit x:Name="endTime" Grid.Row="1" Grid.Column="1" EditValue="{Binding DateTimeEnd}" VerticalAlignment="Center"
                                          MaskType="DateTime" DisplayFormatString="" />
                            </DockPanel>
                            <Grid Grid.Row="2" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" x:Name="btnFetchData" Content="{x:Static properties:Resources.FetchTitle}" Click="OnDataFetchRequest"/>
                                <Button Grid.Row="1" Grid.Column="1" x:Name="btnClearRecent"  Content="{x:Static properties:Resources.ClearRecent}" Click="Button_ClearRecent"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="recentTimeRanges" Text="{x:Static properties:Resources.RecentTimeRanges}" VerticalAlignment="Center" />
                            <ListBox  Grid.Row="1" HorizontalAlignment="Stretch" x:Name="listBoxRecent" 
                                      ItemsSource="{Binding ListRanges}" MouseDoubleClick="OnLoadRangeRequest"
                                      VerticalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Text1" Grid.Column="0" Text="{ Binding StartDateTitle, RelativeSource = { RelativeSource AncestorType ={ x:Type UserControl}, Mode = FindAncestor}}" VerticalAlignment="Center" />
                                            <dxe:TextEdit Margin="2,0,2,0" Grid.Column="1" EditValue="{Binding DateTimeStart}" VerticalAlignment="Center"
                                               MaskType="DateTime" DisplayFormatString=""  IsReadOnly="True"/>
                                            <TextBlock x:Name="Text2" Grid.Column="2" Text="{ Binding EndDateTitle, RelativeSource = { RelativeSource AncestorType ={ x:Type UserControl}, Mode = FindAncestor}}" VerticalAlignment="Center" />
                                            <dxe:TextEdit Margin="2,0,2,0" Grid.Column="3" EditValue="{Binding DateTimeEnd}" VerticalAlignment="Center"
                                               MaskType="DateTime" DisplayFormatString=""  IsReadOnly="True"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </dxd:LayoutPanel>
            </dxd:AutoHideGroup>
                <dxd:AutoHideGroup DockType="Bottom" AutoHideSize="200,200" x:Name="autoHideBottom">
                <dxd:LayoutPanel ShowCaption="True" Caption="{x:Static properties:Resources.LegendTitle}" x:Name="legendPanel">
                    <Grid x:Name="legendGrid" Grid.Row="3" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="legendScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Row="1">
                            <StackPanel Orientation="Vertical">
                                <dxg:GridControl x:Name="legendListBox" MaxHeight="{Binding Path=ActualHeight, ElementName=legendScrollViewer}">
                                        <dxg:GridControl.Resources>
                                            <Style TargetType="{x:Type dxg:GridColumnHeader}">
                                                <Setter Property="Foreground" Value="{Binding LegendAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                <Setter Property="FontFamily" Value="{Binding FontFamily, Mode=OneWay, ElementName=legendScrollViewer}" />
                                                <Setter Property="FontSize" Value="{Binding FontSize, Mode=OneWay, ElementName=legendScrollViewer}" />
                                                <Setter Property="FontWeight" Value="{Binding FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}, AncestorLevel=2}}" />
                                                <Setter Property="FontStyle" Value="{Binding FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}, AncestorLevel=2}}" />
                                            </Style>
                                        </dxg:GridControl.Resources>
                                        <dxg:GridControl.Columns>
                                        <dxg:GridColumn x:Name="penTitle" Header="{x:Static properties:Resources.Title}" Width="200" ReadOnly="True" AllowEditing="False" Tag="Name">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                            <TextBlock Name="translatedTextElement" Grid.Row="0" Text="{Binding Path=Data.TranslatedTitle}" Visibility="{Binding ElementName=translatedTextElement, Path=Text, Mode=OneWay, Converter={StaticResource TextToVisibilityConverter}}" Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding LegendAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                                                        <Canvas Height="30" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                                            <ItemsControl Padding="5,5,0,0" VerticalAlignment="Center" ItemsSource="{Binding Data.Valuelist}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                                                            <Rectangle Width="15" Height="15" Fill="{Binding ControlBackground}" VerticalAlignment="Center"/>
                                                                                <TextBlock Padding="5,0,0,0" Text="{Binding TranslatedLabel}" VerticalAlignment="Center" Foreground="{Binding LegendAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel></WrapPanel>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </Canvas>
                                                    </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                            <dxg:GridColumn x:Name="tagNameTitle" Header="{x:Static properties:Resources.TagName}" Width="200" ReadOnly="True" AllowEditing="False" Tag="Variable">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center">
                                                        <!--<Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>-->
                                                            <TextBlock Text="{Binding Path=Data.ColuName}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding LegendAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                                                        </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                            <dxg:GridColumn x:Name="historianTitle" Header="{x:Static properties:Resources.HistoricalDlrName}" Width="200" ReadOnly="True" AllowEditing="False" Tag="HistorianDatalogger">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center">
                                                        <!--<Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>-->
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Path=Data.HistoricalDlrName}" VerticalAlignment="Center" Foreground="{Binding LegendAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                                                        </Grid>
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView IsSynchronizedWithCurrentItem="True" AllowGrouping="False" ShowGroupPanel="False" VerticalScrollbarVisibility="Auto" AllowFilterEditor="False" ShowAutoFilterRow="False" ShowSearchPanelMode="Never" AllowColumnFiltering="False" AllowSorting="False" NavigationStyle="Row">

                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </dxd:LayoutPanel>
            </dxd:AutoHideGroup>
        </dxd:DockLayoutManager.AutoHideGroups>
    </dxd:DockLayoutManager>
    </AdornerDecorator>
</UserControl>
