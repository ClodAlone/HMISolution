<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StatesChartControl"
             xmlns:properties="clr-namespace:StatesChartControl.Properties"
             mc:Ignorable="d"
             x:Class="StatesChartControl.StatesChartControl"
             xmlns:utilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:ve="http://schemas.devexpress.com/winfx/2008/xaml/docking/visualelements"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxct="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/docking/themekeys"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             Background="{dxi:ThemeResource {dxct:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             Foreground="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
            >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToScrollbarConverter x:Key="BooleanToScrollbarConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertedVisibilityConverter" />
            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="{Binding DefToolbarHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="5" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="ShowHideErrorMessage">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="errorMessageContent">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.5" Value="{x:Static Visibility.Visible}"/>
                    <DiscreteObjectKeyFrame KeyTime="0:0:4" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="errorMessageContent">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:3" Value="1"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:4" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Style TargetType="Line">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="mainBorder" ClipToBounds="False"
                            Background="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                            BorderThickness="{Binding BorderThickness,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
        <Grid x:Name="outerGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" x:Name="maybeLayoutManagerGrid"
                  Grid.Row="1">
                <Grid x:Name="mainGrid" ClipToBounds="True">
                    <Grid x:Name="plotGridContainer" ClipToBounds="True" Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" CanContentScroll="True" x:Name="plotVerticalScrollViewer" VerticalScrollBarVisibility="Hidden">
                            <DockPanel Margin="10" LastChildFill="True">
                                <Grid x:Name="labelsGrid" DockPanel.Dock="Left">

                                </Grid>
                                <Grid x:Name="plotGrid" ClipToBounds="True">

                                </Grid>
                            </DockPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" x:Name="timeAxisGrid" ClipToBounds="True" Margin="0,0,0,5">
                        </Grid>
                    </Grid>
                    <!--<TextBlock TextWrapping="Wrap" x:Name="designLabel" Visibility="Collapsed" Text="{x:Static properties:Resources.ChartDesignLabel}" TextAlignment="Center" FontSize="20" Foreground="DarkGray" VerticalAlignment="Top" Margin="0,20,0,0"/>-->
                </Grid>
            </Grid>
            <dxb:BarContainerControl ContainerType="Top" x:Name="toolbar" VerticalAlignment="Top">
                <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" dxb:MergingProperties.Name="mainStateChartToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False"  x:Name="toolbarSettings">
                    <dxb:BarLinkContainerItem x:Name="configMemory_Toolbar" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                      <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                      <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                      UseLightweightTemplates="False" EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                        <dxb:BarEditItem.EditTemplate>
                          <DataTemplate>
                            <dxe:ComboBoxEdit
                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                            Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                          </DataTemplate>
                        </dxb:BarEditItem.EditTemplate>
                      </dxb:BarEditItem>

                        <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall"  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource EditGeneralSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="editGeneralSmall"  Command="{Binding EditCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.EditSettings}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmall" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall"  Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}"/>
                    </dxb:BarLinkContainerItem>
                    <dxb:BarLinkContainerItem x:Name="toolbarSettings1" IsVisible="{Binding AllowRuntimeChanges, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                        <dxb:BarCheckItem Glyph="{DynamicResource Expand}" GlyphSize="Custom" CustomGlyphSize="16,16" IsEnabled="{Binding NotNestedInDockManager, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                              ItemClick="ExpandCollapse_Click" x:Name="btnExpand" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ExpandTitle}"/>
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Glyph="{DynamicResource Previous}" GlyphSize="Custom" CustomGlyphSize="16,16" ItemClick="Prev_Click" x:Name="btnPrev" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.PrevTitle}"/>
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="cmbTimeRange">
                          <dxb:BarEditItem.EditTemplate>
                            <DataTemplate>
                             <dxe:ComboBoxEdit 
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                              Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonDateSpanMinWidth}"
                                              IsTextEditable="False">
                                <dxe:ComboBoxEdit.ItemContainerStyle>
                                  <Style TargetType="{x:Type dxe:ComboBoxEditItem}">
                                    <Setter Property="IsEnabled" Value="{Binding DataContext.IsEnabled, Mode=OneWay}" />
                                  </Style>
                                </dxe:ComboBoxEdit.ItemContainerStyle>
                              </dxe:ComboBoxEdit>
                            </DataTemplate>
                          </dxb:BarEditItem.EditTemplate>
                        </dxb:BarEditItem>
                        <dxb:BarButtonItem Glyph="{DynamicResource Next}" GlyphSize="Custom" CustomGlyphSize="16,16" ItemClick="Next_Click" x:Name="btnNext" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.NextTitle}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource ReloadSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnRefresh" ItemClick="Refresh_Click" IsEnabled="True" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.RefreshTitle}"/>
                        <dxb:BarButtonItem IsVisible="{Binding DockManagerAllowed, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Content="{x:Static properties:Resources.AddDockManager}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.AddDockManager}" x:Name="btnNestInDockMgr" ItemClick="NestMainGridInsideDockManager" IsEnabled="{Binding NotNestedInDockManager, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                        <dxb:BarItemSeparator />
                        <dxb:BarCheckItem ToolTipService.ShowOnDisabled="True" IsEnabled="{Binding UseAbsoluteRangesEnabled, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Content="{x:Static properties:Resources.UseAbsoluteRangesTitle}"  x:Name="chkUseAbsoluteRanges"  IsChecked="{Binding UseAbsoluteRanges, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <dxb:BarButtonItem Content="{x:Static properties:Resources.ZoomBackTitle}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ZoomBackTitle}" x:Name="btnZoomBack" ItemClick="ZoomOutCell" IsEnabled="{Binding ZoomBackEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource Minute}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnMin" ItemClick="Min_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.MinTitle}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource Hour}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnHour" ItemClick="Hour_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.HourTitle}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource Day}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnDay" ItemClick="Day_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DayTitle}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource Week}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnWeek" ItemClick="Week_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.WeekTitle}"/>
                        <dxb:BarButtonItem Glyph="{DynamicResource Month}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnMonth" ItemClick="Month_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.MonthTitle}"/>
                        <dxb:BarItemSeparator />
                        <dxb:BarEditItem UseLightweightTemplates="False" EditValue="{Binding DateTimeStart}" x:Name="startText" IsReadOnly="True" Content="{x:Static properties:Resources.StartDate}">
                          <dxb:BarEditItem.EditTemplate>
                            <DataTemplate>
                              <dxe:TextEdit
                                MaskType="DateTime" MaskUseAsDisplayFormat="True" 
                                MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
                                Name="PART_Editor" MinWidth="140"/>
                            </DataTemplate>
                          </dxb:BarEditItem.EditTemplate>
                        
                      </dxb:BarEditItem>
                        <dxb:BarEditItem UseLightweightTemplates="False" EditValue="{Binding DateTimeEnd}" x:Name="endText" IsReadOnly="True" Content="{x:Static properties:Resources.EndDate}">
                          <dxb:BarEditItem.EditTemplate>
                            <DataTemplate>
                              <dxe:TextEdit
                                MaskType="DateTime" MaskUseAsDisplayFormat="True"
                                MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
                                Name="PART_Editor" MinWidth="140"/>
                            </DataTemplate>
                          </dxb:BarEditItem.EditTemplate>
                        </dxb:BarEditItem>
                    </dxb:BarLinkContainerItem>
                </dxb:ToolBarControl>
            </dxb:BarContainerControl>
            <Grid>
                <TextBlock x:Name="errorMessageContent" Margin="0,20,0,0" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
