<UserControl x:Class="OPCUAViewModel.PropertyDataTemplate.AlarmsSourcePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:converters="clr-namespace:OPCUAViewModel.Converters"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <converters:AlarmsSourcePropertyConverter x:Key="AlarmsSourcePropertyConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image x:Name="cancelImg" Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click">
                <Button.Content>
                    <Image x:Name="editImg" Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <dxe:ComboBoxEdit
                    x:Name="uriLabel" 
                    Text="{Binding Path=Tag, ElementName=uriButton, Mode=TwoWay, Converter={StaticResource AlarmsSourcePropertyConverter}, UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                    PopupOpening="uriLabel_PopupOpening" PreviewKeyDown="uriLabel_KeyDown" 
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
            </dxe:ComboBoxEdit>
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=uriButton, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
