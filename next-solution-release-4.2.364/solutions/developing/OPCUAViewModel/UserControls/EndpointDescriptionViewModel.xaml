<UserControl x:Class="OPCUAViewModel.UserControls.EndpointDescriptionViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"      
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    FocusManager.FocusedElement="{Binding ElementName=EndpointUrlTxt}"
    Height="120" Width="500">

    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="EncodingSupportEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:BinaryEncodingSupport" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="MessageSecurityModeEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:MessageSecurityMode" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock 
          FontStyle="Italic"
          Foreground="Red"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>

        <!-- Url-->
        <Label 
      Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.EndpointDescriptionView_EndpointUrl}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=firstNameTxt}"
      />
        <TextBox 
      x:Name="EndpointUrlTxt"
      Grid.Row="1" Grid.Column="2" 
      Text="{Binding Path=EndpointUrl, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left"
      Content="{Binding ElementName=EndpointUrlTxt, Path=(Validation.Errors).CurrentItem}"
      />


        <!-- Econding Support-->
        <Label Visibility="Collapsed"
      Grid.Row="3" Grid.Column="0" 
      Content="{x:Static properties:Resource.EndpointDescriptionView_EcodingSupport}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=secondNameTxt}"
      />

        <ComboBox x:Name="EcodingSupportTxt" Grid.Row="3" Grid.Column="2" IsEnabled="False" Visibility="Collapsed"
                            ItemsSource="{Binding Source={StaticResource EncodingSupportEnums}}"
                            SelectedItem="{Binding Path=EncodingSupport, ValidatesOnDataErrors=True, 
                                Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                            Validation.ErrorTemplate="{x:Null}"
            >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Label x:Name="lbl"  
                                        Content="{Binding   Path=.,Mode=OneWay, 
                                        Converter={StaticResource enumItemsConverter}}"
                                        FontSize="11"
                                        Height="25"
                                        Margin="2,0,0,0" 
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"/>
                    <DataTemplate.Triggers>
                        <DataTrigger 
                                            Binding="{Binding Path=IsHighlighted, 
                                                RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                            Value="True">
                            <Setter TargetName="lbl" Property="Foreground" Value="Red"/>
                            <Setter TargetName="lbl" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="lbl" Property="BitmapEffect" >
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="White" GlowSize="5" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ContentPresenter Visibility="Collapsed"
      Grid.Row="4" Grid.Column="2"
      Content="{Binding ElementName=EcodingSupportTxt, Path=(Validation.Errors).CurrentItem}"
      />





        <!-- Message Security Mode-->
        <Label Visibility="Collapsed"
      Grid.Row="5" Grid.Column="0" 
      Content="{x:Static properties:Resource.EndpointDescriptionView_MessageSecurityMode}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=thirdNameTxt}"
      />

        <ComboBox x:Name="MessageSecurityModeTxt" Grid.Row="5" Grid.Column="2" Visibility="Collapsed"
                            ItemsSource="{Binding Source={StaticResource MessageSecurityModeEnums}}"
                            SelectedItem="{Binding Path=MessageSecurityMode, ValidatesOnDataErrors=True, 
                                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                            Validation.ErrorTemplate="{x:Null}"
            >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Label x:Name="lbl"  
                                        Content="{Binding   Path=.,Mode=TwoWay, 
                                        Converter={StaticResource enumItemsConverter}}"
                                        FontSize="11"
                                        Height="25"
                                        Margin="2,0,0,0" 
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"/>
                    <DataTemplate.Triggers>
                        <DataTrigger 
                                            Binding="{Binding Path=IsHighlighted, 
                                                RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                            Value="True">
                            <Setter TargetName="lbl" Property="Foreground" Value="Red"/>
                            <Setter TargetName="lbl" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="lbl" Property="BitmapEffect" >
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="White" GlowSize="5" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ContentPresenter Visibility="Collapsed"
      Grid.Row="6" Grid.Column="2"
      Content="{Binding ElementName=EcodingSupportTxt, Path=(Validation.Errors).CurrentItem}"
      />

        <CheckBox Grid.Row="7" Grid.Column="2" VerticalAlignment="Center"
                  Content="{x:Static properties:Resource.EndpointDescriptionView_UseSecurity}" IsChecked="{Binding UseSecurity}"/>
    </Grid>
</UserControl>
