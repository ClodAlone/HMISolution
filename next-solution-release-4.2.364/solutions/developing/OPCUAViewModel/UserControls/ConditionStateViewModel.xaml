<UserControl x:Class="OPCUAViewModel.UserControls.ConditionStateViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"      
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"  
    Width="100">

    <StackPanel Orientation="Vertical">
        <Button Content="{x:Static properties:Resource.ConditionStateView_AddComment}" Command="{Binding Path=AddCommentCommand}" />
        <Button Content="{x:Static properties:Resource.ConditionStateView_Acknowledge}" Command="{Binding Path=AcknowledgeCommand}" />
        <Button Content="{x:Static properties:Resource.ConditionStateView_Confirm}" Command="{Binding Path=ConfirmCommand}" />
        <Button Content="{x:Static properties:Resource.ConditionStateView_Enable}" Command="{Binding Path=EnableCommand}" />
        <Button Content="{x:Static properties:Resource.ConditionStateView_Disable}" Command="{Binding Path=DisableCommand}" />
        <Button Content="{x:Static properties:Resource.ConditionStateView_Shelve}" Command="{Binding Path=ShelveCommand}" />
        <Button Content="{x:Static properties:Resource.ConditionStateView_Unshelve}" Command="{Binding Path=UnshelveCommand}" />
    </StackPanel>    
</UserControl>
