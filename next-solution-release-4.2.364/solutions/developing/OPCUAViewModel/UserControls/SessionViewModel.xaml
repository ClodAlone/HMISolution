<UserControl x:Class="OPCUAViewModel.UserControls.SessionViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"  
    Width="400">

    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="ServerStateEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:ServerState" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="138" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock FontStyle="Italic"
          Foreground="Red"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>

        <Label Grid.Row="0" Grid.Column="0" 
      FontWeight="Bold"
      Content="{x:Static properties:Resource.SessionView_Server}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="0" Grid.Column="2" 
      Content="{Binding Path=Title}" 
      />

        <Label Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_ServerState}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="1" Grid.Column="2" 
      Content="{Binding Path=CurrentState, Converter={StaticResource enumItemsConverter}}" 
      />

        <Label Grid.Row="3" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_LastContactTime}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="3" Grid.Column="2" 
      Content="{Binding Path=LastCurrentTime}" 
      />


        <Label Grid.Row="4" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_KeepAliveInterval}" 
      HorizontalAlignment="Right"
      />

      <dxe:SpinEdit  Grid.Column="2" Grid.Row="4" MinValue="1" MaxValue="10000" x:Name="keepAliveEditor" MaskType="Numeric" Mask="n0"
                   EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                   Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                   EditValue="{Binding Path=KeepAliveInterval, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

      <Label Grid.Row="5" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_DefunctRequest}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="5" Grid.Column="2" 
      Content="{Binding Path=DefunctRequestCount}" 
      />

        <Label Grid.Row="6" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_GoodPublishRequest}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="6" Grid.Column="2" 
      Content="{Binding Path=GoodPublishRequestCount}" 
      />

        <Label Grid.Row="7" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_OutstandingRequest}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="7" Grid.Column="2" 
      Content="{Binding Path=OutstandingRequestCount}" 
      />

        <Label Grid.Row="8" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_SessionTimeout}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="8" Grid.Column="2" 
      Content="{Binding Path=SessionTimeout}" 
      />

        <Label Grid.Row="9" Grid.Column="0" 
      Content="{x:Static properties:Resource.SessionView_SubscriptionCount}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="9" Grid.Column="2" 
      Content="{Binding Path=SubscriptionCount}" 
      />

    </Grid>
</UserControl>
