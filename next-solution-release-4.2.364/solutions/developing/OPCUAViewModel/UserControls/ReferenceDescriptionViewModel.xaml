<UserControl x:Class="OPCUAViewModel.UserControls.ReferenceDescriptionViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"      
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"  
    Width="400">

    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="NodeClassEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:NodeClass" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>


        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock 
          FontStyle="Italic"
          Foreground="Red"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>

        <Label 
      Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_BrowseName}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=firstNameTxt}"
      />
        <TextBox 
      x:Name="BrowseNameTxt"
      Grid.Row="1" Grid.Column="2" 
      Text="{Binding Path=BrowseName, Converter={StaticResource QualifiedNameToStringConv}, Mode=OneWay
            , ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="2" Grid.Column="2"
      Content="{Binding ElementName=BrowseNameTxt, Path=(Validation.Errors).CurrentItem}"
      />


        <Label 
      Grid.Row="3" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_RelativePath}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=secondNameTxt}"
      />
        <TextBox 
      x:Name="RelativePathTxt"
      Grid.Row="3" Grid.Column="2" 
      Text="{Binding Path=RelativePath, Mode=OneWay,
            ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="4" Grid.Column="2"
      Content="{Binding ElementName=RelativePathTxt, Path=(Validation.Errors).CurrentItem}"
      />



        <Label 
      Grid.Row="5" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_Type}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=thirdNameTxt}"
      />
        <TextBox 
      x:Name="TypeDefinitionTxt"
      Grid.Row="5" Grid.Column="2" 
      Text="{Binding Path=NodeReferences[0].DisplayName, Mode=OneWay, Converter={StaticResource LocalizedTextToStringConv},
            ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="6" Grid.Column="2"
      Content="{Binding ElementName=TypeDefinitionTxt, Path=(Validation.Errors).CurrentItem}"
      />


        <Label 
      Grid.Row="6" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_CompletePath}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=FourthNameTxt}"
      />
        <TextBox 
      x:Name="CompletePathTxt"
      Grid.Row="6" Grid.Column="2" 
      Text="{Binding Path=CompletePath, Mode=OneWay, 
            ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="7" Grid.Column="2"
      Content="{Binding ElementName=CompletePathTxt, Path=(Validation.Errors).CurrentItem}"
      />


        <!-- Econding Support-->
        <Label 
      Grid.Row="7" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_NodeClass}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=thirdNameTxt}"
      />
        
        <ComboBox x:Name="NodeClassTxt" Grid.Row="7" Grid.Column="2" IsEnabled="False"
                            ItemsSource="{Binding Source={StaticResource NodeClassEnums}}"
                            SelectedItem="{Binding Path=NodeClass, ValidatesOnDataErrors=True, 
                                Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                            Validation.ErrorTemplate="{x:Null}"
            >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Label x:Name="lbl"  
                                        Content="{Binding   Path=.,Mode=OneWay, 
                                        Converter={StaticResource enumItemsConverter}}"
                                        FontSize="11"
                                        Height="25"
                                        Margin="2,0,0,0" 
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"/>
                    <DataTemplate.Triggers>
                        <DataTrigger 
                                            Binding="{Binding Path=IsHighlighted, 
                                                RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                            Value="True">
                            <Setter TargetName="lbl" Property="Foreground" Value="Red"/>
                            <Setter TargetName="lbl" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="lbl" Property="BitmapEffect" >
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="White" GlowSize="5" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ContentPresenter 
      Grid.Row="8" Grid.Column="2"
      Content="{Binding ElementName=NodeClassTxt, Path=(Validation.Errors).CurrentItem}"
      />


        <Label 
      Grid.Row="9" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_Alias}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=FifthNameTxt}"
      />
        <TextBox 
      x:Name="AliasTxt"
      Grid.Row="9" Grid.Column="2" 
      Text="{Binding Path=Alias, Mode=OneWay, 
            ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="10" Grid.Column="2"
      Content="{Binding ElementName=AliasTxt, Path=(Validation.Errors).CurrentItem}"
      />


        <Label 
      Grid.Row="11" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_NodeId}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=FifthNameTxt}"
      />
        <TextBox 
      x:Name="NodeIdTxt"
      Grid.Row="11" Grid.Column="2" 
      Text="{Binding Path=NodeId, Mode=OneWay, 
            ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="12" Grid.Column="2"
      Content="{Binding ElementName=NodeIdTxt, Path=(Validation.Errors).CurrentItem}"
      />



        <Label 
      Grid.Row="13" Grid.Column="0" 
      Content="{x:Static properties:Resource.ReferenceDescriptionView_ParentTypeDef}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=FifthNameTxt}"
      />
        <TextBox 
      x:Name="ParentTypeDefTxt"
      Grid.Row="13" Grid.Column="2" 
      Text="{Binding Path=ParentedTypeDefinitionName, Mode=OneWay, 
            ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter 
      Grid.Row="14" Grid.Column="2"
      Content="{Binding ElementName=ParentTypeDefTxt, Path=(Validation.Errors).CurrentItem}"
      />

    </Grid>
</UserControl>
