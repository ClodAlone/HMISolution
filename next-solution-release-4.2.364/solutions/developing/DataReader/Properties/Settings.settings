<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="DataReader.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="SQLServerCatalogUpdateTime" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">5000</Value>
    </Setting>
    <Setting Name="MSSQLBackupDirectoryQuery" Type="System.String" Scope="Application">
      <Value Profile="(Default)">EXECUTE xp_instance_regread N'HKEY_LOCAL_MACHINE', N'SOFTWARE\Microsoft\MSSQLServer\MSSQLServer', N'BackupDirectory'</Value>
    </Setting>
    <Setting Name="MSSQLFullBackupExistsQuery" Type="System.String" Scope="Application">
      <Value Profile="(Default)">SELECT COUNT(database_name) FROM msdb.dbo.backupmediafamily
INNER JOIN msdb.dbo.backupset ON msdb.dbo.backupmediafamily.media_set_id = msdb.dbo.backupset.media_set_id
WHERE msdb.dbo.backupset.database_name = '{0}' AND type = 'D' AND recovery_model = 'FULL'</Value>
    </Setting>
    <Setting Name="MySQLLiteralPrefixForStringType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">'</Value>
    </Setting>
    <Setting Name="MySQLLiteralSuffixForStringType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">'</Value>
    </Setting>
  </Settings>
</SettingsFile>