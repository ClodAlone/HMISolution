<UserControl x:Class="AuthenticationCredentialsProvider.LoginControl"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:AuthenticationCredentialsProvider.Properties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:utilities="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             FocusManager.FocusedElement="{Binding ElementName=txtUser}"
             Width="500"
             FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogFontSize}" 
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/RuntimeUsers.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="10,10,10,10" CornerRadius="10">
        <StackPanel Margin="10,10,10,10">

            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource RTUUserLogin}" x:Name="usrLoginImage"/>
                <StackPanel x:Name="gridInfoRequested" VerticalAlignment="Bottom">
                    <Grid x:Name="gridRole">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="requestedRole" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                                     Text="{x:Static properties:Resources.RequestedRole}" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" Margin="10,10,10,10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                                     x:Name="txtRequestedRole" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" Margin="10,10,10,10"/>
                    </Grid>
                    <Grid x:Name="gridLevel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="requestedLevel" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                                     Text="{x:Static properties:Resources.RequestedLevel}" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" Margin="10,10,10,10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" x:Name="txtRequestedLevel" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" Margin="10,10,10,10"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="10,10,10,10">
                <StackPanel Orientation="Vertical">
                    <Label x:Name="userName" 
                           FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                           Content="{x:Static properties:Resources.UserNameLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox  x:Name="txtUser" 
                                  Text="{Binding UserName}" 
                                  Height="Auto" 
                                  FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}" 
                                  VerticalContentAlignment="Center" 
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                        <Button x:Name="selectButton1" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                                     VerticalContentAlignment="Center" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Content="..." Grid.Column="1" Click="Button_Click"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label x:Name="password" 
                           FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                           Content="{x:Static properties:Resources.PasswordLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <cc:BindablePasswordBox x:Name="passwordBox" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"/>
                        <Button x:Name="selectButton2" 
                                     Height="{Binding ElementName=txtUser, Path=ActualHeight}" 
                                     FontSize="{Binding ElementName=txtUser, Path=FontSize}" 
                                     VerticalContentAlignment="Center" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Content="..." Grid.Column="1" Click="Button_Click_1"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>

    </Border>

</UserControl>
