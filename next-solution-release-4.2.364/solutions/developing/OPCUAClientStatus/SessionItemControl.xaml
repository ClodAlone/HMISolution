<UserControl x:Class="OPCUAClientStatus.SessionItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:cc="clr-namespace:CommonControls;assembly=CommonControls">
    
    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <StackPanel Orientation="Horizontal">
        <Expander x:Name="expanderAudit" Expanded="expanderAudit_Expanded" IsExpanded="False" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="headerName" Text="{Binding Name}" Margin="2,0,2,0" FontWeight="Bold" ToolTip="{Binding LastMessage}"/>
                    <dxe:TextEdit Margin="2,0,0,0"  BorderBrush="Transparent"
                          x:Name="dateTime" IsReadOnly="True"
                          EditValue="{Binding LastCurrentTime, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                          MaskType="DateTime" DisplayFormatString="" MaskUseAsDisplayFormat="True" MaskCulture="{x:Static glob:CultureInfo.CurrentCulture}" IsEnabled="False" ShowNullText="False" ShowNullTextForEmptyValue="False" ShowTooltipForTrimmedText="False" AllowSpinOnMouseWheel="False" CausesValidation="False" SelectAllOnGotFocus="False" MaskShowPlaceHolders="False" />
                </StackPanel>
            </Expander.Header>
        </Expander>
    </StackPanel>
</UserControl>
