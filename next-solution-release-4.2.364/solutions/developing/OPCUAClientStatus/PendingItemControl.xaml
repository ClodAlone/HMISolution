<UserControl x:Class="OPCUAClientStatus.PendingItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:CommonControls;assembly=CommonControls"
    xmlns:properties="clr-namespace:OPCUAClientStatus.Properties">
    
    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{x:Static properties:Resources.PendingItemControlTitle}" Margin="2,0,2,0" FontWeight="Normal" />
        <TextBlock Text="{Binding EndpointUrl}" Margin="2,0,2,0" FontWeight="Bold" />
        <TextBlock Text="{Binding LastMessage}" Margin="2,0,2,0" FontStyle="Italic" />
    </StackPanel>
</UserControl>
