<UserControl x:Class="NewDriverWizard.UserControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" xmlns:properties="clr-namespace:NewDriverWizard.Properties"
             d:DesignHeight="50" d:DesignWidth="690" Background="AliceBlue">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/CustomWizard.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="normalButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                      <Storyboard>
                        <DoubleAnimation Duration="0" To="1"
                                         Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DisabledVisualElement" />
                        <DoubleAnimation Duration="0" To="1"
                                         Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="contentPresenter" />
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="MouseOver">
                      <Storyboard>
                        <DoubleAnimation Duration="0" To="0.5"
                                         Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DisabledVisualElement" />
                        <DoubleAnimation Duration="0" To="0.5"
                                         Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="contentPresenter" />
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <DoubleAnimation Duration="0" To="0.5"
                                         Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="DisabledVisualElement" />
                        <DoubleAnimation Duration="0" To="0.5"
                                         Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="contentPresenter" />
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused"/>
                    <VisualState x:Name="Unfocused"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Background" BorderBrush="Black" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
                  <Grid Margin="1">
                    <Rectangle x:Name="BackgroundGradient"/>
                  </Grid>
                </Border>
                <Rectangle x:Name="DisabledVisualElement" Fill="#252525" IsHitTestVisible="false" Opacity="0.2" RadiusY="1" RadiusX="1"/>
                <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>

  </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="25*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal">

            <!-- {Binding PreviousCommand, ElementName=wizardControl} -->

            <Button  VerticalAlignment="Center"  ToolTip="{x:Static properties:Resources.PreviousBtn}" x:Name="previousCommand" 
                 HorizontalAlignment="Center" Width="60"  
                 Style="{StaticResource normalButtonStyle}" Height="30" Command="{Binding PrevStep, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Content="{x:Static properties:Resources.Prev}"/>
            <Viewbox Margin="10,0,0,0" Stretch="Fill" Width="4">
                <Grid Height="50" Width="4">
                    <Border BorderBrush="#FFCDBFBF" BorderThickness="1,0,0,0" HorizontalAlignment="Center" Height="50" VerticalAlignment="Bottom" Width="2" Margin="0,0,2,0"/>
                    <Border BorderBrush="#FFCDBFBF" BorderThickness="1,0,0,0" HorizontalAlignment="Center" Height="50" VerticalAlignment="Top" Width="2" Background="#FF353131" Margin="2,0,0,0"/>
                </Grid>
            </Viewbox>
            <Canvas Margin="0,10,0,0" HorizontalAlignment="Center" Height="60" Width="60" VerticalAlignment="Center">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="0.9" ScaleX="0.9"/>
                        <SkewTransform/>
                        <RotateTransform/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Image VerticalAlignment="Center" Source="{StaticResource CWNext}" Height="48" Width="48" Canvas.Top="1" Canvas.Left="7"/>
            </Canvas>
            <Viewbox  Margin="0,0,10,0" Stretch="Fill" Width="4">
                <Grid Height="50" Width="4">
                    <Border BorderBrush="#FFCDBFBF" BorderThickness="1,0,0,0" HorizontalAlignment="Center" Height="50" VerticalAlignment="Bottom" Width="2" Margin="0,0,2,0"/>
                    <Border BorderBrush="#FFCDBFBF" BorderThickness="1,0,0,0" HorizontalAlignment="Center" Height="50" VerticalAlignment="Top" Width="2" Background="#FF353131" Margin="2,0,0,0"/>
                </Grid>
            </Viewbox>
            <!-- {Binding NextCommand, ElementName=wizardControl} -->
            <Button x:Name="nextCommand"  ToolTip="{x:Static properties:Resources.NextBtn}" HorizontalAlignment="Center" 
                Width="60" VerticalAlignment="Center" Style="{StaticResource normalButtonStyle}" 
                Height="30" Command="{Binding NextStep, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="1" Content="{x:Static properties:Resources.Next}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button ToolTip="{x:Static properties:Resources.FinishBtn}" x:Name="finishButton" 
                HorizontalAlignment="Center" Width="60" VerticalAlignment="Center"
                Style="{StaticResource normalButtonStyle}" Height="30" Grid.Column="1" 
                Content="{x:Static properties:Resources.Ok}" />
            <Button Margin="10,0,0,0" ToolTip="{x:Static properties:Resources.CancelBtn}" 
        	    x:Name="cancelButton" 
        	    Width="70" VerticalAlignment="Center"
        	    Style="{StaticResource normalButtonStyle}" Height="30" 
        	    Command="{Binding CancelCommand, ElementName=wizardcontrol}" 
        	    Content="{x:Static properties:Resources.Cancel}" />
        </StackPanel>
    </Grid>
</UserControl>
