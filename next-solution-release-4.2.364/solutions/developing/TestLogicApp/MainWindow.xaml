<Window x:Class="TestLogicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestLogicApp"
        xmlns:go="http://schemas.nwoods.com/GoXam"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    <Window.Resources>
        <ResourceDictionary>

            <go:BooleanBrushConverter x:Key="theValueConverter"
                              FalseBrush="Red" TrueBrush="Green" />
            <go:BooleanBrushConverter x:Key="theSelectionConverter"
                              FalseBrush="Black" TrueBrush="Cyan" />

            <DataTemplate x:Key="Wire">
                <go:LinkPanel>
                    <go:Link.Route>
                        <go:Route Routing="AvoidsNodes" Curve="JumpOver"
                        RelinkableTo="True" RelinkableFrom="True" />
                    </go:Link.Route>
                    <go:LinkShape StrokeThickness="2"
                          Stroke="{Binding Path=Link.FromNode.Data.Value,
                                   Converter={StaticResource theValueConverter}}" />
                    <Path Fill="Black" go:LinkPanel.ToArrow="Standard" />
                </go:LinkPanel>
            </DataTemplate>

            <DataTemplate x:Key="paletteDataTemplate">
                <go:Palette Padding="10">
                    <go:Diagram.Layout>
                        <go:GridLayout CellSize="100 30" Spacing="5 5" Sorting="Forward" />
                    </go:Diagram.Layout>
                </go:Palette>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" x:Name="stackPalettes">
            
        </StackPanel>

        <go:Diagram x:Name="myDiagram" Grid.Column="1"
                LinkTemplate="{StaticResource Wire}"
                Padding="10"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AllowDrop="True"
                InitialDiagramBoundsSpot="None"
                GridSnapEnabled="True" >
            <go:Diagram.LayoutManager>
                <go:LayoutManager Initial="ValidateAll" />
            </go:Diagram.LayoutManager>
        </go:Diagram>
    </Grid>
</Window>
