<dxb:BarSubItem
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="UFCrossReferenceEditor.MenuControls.BarCommonItems"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFCrossReferenceEditor"
             xmlns:properties="clr-namespace:UFCrossReferenceEditor.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/UFCrossReference.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewCrossReference" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="110" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="110" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectCrossReference" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="85" x:Name="biCrossReference" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <dxb:BarButtonItem  x:Name="biUpdateCRDoc" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.UpdateCRDoc}" Content="{x:Static properties:UICommandResource.UpdateCRDocText}" Glyph="{StaticResource UFCREditor}"/>
            <dxb:BarButtonItem  x:Name="biClearCRDoc" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.ClearCRDoc}" Content="{x:Static properties:UICommandResource.ClearCRDocText}" Glyph="{StaticResource UFCRClear}"/>
            <dxb:BarButtonItem  x:Name="biRenameReferences" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.RenameReferences}" Content="{x:Static properties:UICommandResource.RenameReferencesText}" Glyph="{StaticResource RenameSmall}"/>
        </dxb:BarSubItem>
    </dxb:BarSubItem>
</dxb:BarSubItem>
