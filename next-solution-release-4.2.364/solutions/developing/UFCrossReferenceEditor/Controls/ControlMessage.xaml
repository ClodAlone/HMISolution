<UserControl x:Class="UFCrossReferenceEditor.Controls.ControlMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFCrossReferenceEditor"
             xmlns:properties="clr-namespace:UFCrossReferenceEditor.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="scroll" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto">
            <TextBox x:Name="textBox" Margin="10" Text="{Binding TextMessage}" IsReadOnly="True" 
                     Background="Transparent" FontFamily="Segoe UI" FontWeight="Normal" FontSize="18" TextWrapping="NoWrap"
                     TextChanged="textBox_TextChanged"/>
        </ScrollViewer>
        <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="13" Grid.RowSpan="1" />
    </Grid>
</UserControl>
