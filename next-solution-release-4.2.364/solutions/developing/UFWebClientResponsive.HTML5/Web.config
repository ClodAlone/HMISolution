  <appSettings>
    <add key="Uri" value="" />
    <add key="ClientSessionName" value="ScreenSinkHTML5" />
    <add key="RefreshPollingTime" value="1000" />
    <add key="RefreshPollingTimeCount" value="10" />
    <add key="DelayBroadcaster" value="250" />
    <add key="SessionTimeout" value="60" />
    <add key="ConcurrentRenderingPipeline" value="5" />
    <add key="DisableStaticOptimization" value="True" />
    <add key="DisableAlertOnCommandExecution" value="False" />
    <add key="AllowReportScriptExecution" value="True" />
    <add key="AllowReportCodeFormat" value="False" />
    <add key="SwitchToViewerDashboard" value="False" />
    <add key="ShowPopupCloseBtn" value="True" />
    <add key="Theme" value="VS2017Dark" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="ChartImageHandler" value="storage=file;timeout=20;dir=c:\TempImageFiles\;" />
    <add key="vs:EnableBrowserLink" value="false" />
    <add key="log4net.Internal.Emit" value="false" />
  </appSettings>
  <connectionStrings>
    <remove name="ApplicationServices" />
    <add name="ApplicationServices" connectionString="Server=(local);Database=Movicon.Membership;Integrated Security=SSPI" providerName="System.Data.SqlClient" />
  </connectionStrings>
