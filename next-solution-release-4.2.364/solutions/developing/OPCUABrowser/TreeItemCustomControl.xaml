<UserControl x:Class="OPCUABrowser.TreeItemCustomControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="{Binding ElementName=TreeViewItem, Path=Width}"
    Height="{Binding ElementName=TreeViewItem, Path=Height}"
    xmlns:cc="clr-namespace:CommonControls;assembly=CommonControls" >
    
    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" 

                        Visibility="{Binding IsBusy, 
                        Converter={StaticResource BoolToVisibilityConv}, 
                        ConverterParameter=false}" >
                        
            <cc:CircularProgressBar />
        </Viewbox>
        <TextBlock Text="{Binding Title}" />
    </StackPanel>
</UserControl>
