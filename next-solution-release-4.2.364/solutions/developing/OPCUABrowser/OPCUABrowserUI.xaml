
<UserControl x:Class="OPCUABrowser.OPCUABrowserUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar" 
    xmlns:local="clr-namespace:OPCUABrowser"
    xmlns:cc="clr-namespace:CommonControls;assembly=CommonControls"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    PreviewKeyDown="treeViewDiscovering_KeyDown" 
    PreviewMouseRightButtonDown="treeViewDiscovering_MouseRightButtonDown"
    Width="500">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/OPCUABrowser.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
    </ResourceDictionary>
  </UserControl.Resources>
    <dxn:NavBarControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <dxn:NavBarControl.Groups>
            <dxn:NavBarGroup Header="{x:Static local:Properties.Resources.NetworkDiscovering}" IsExpanded="True">
                <dxn:NavBarItem>
                    <dxn:NavBarItem.Content>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>


                            <!--Toolbar-->
                            <dxb:BarContainerControl ContainerType="Top" x:Name="toolbarDiscovering" Grid.Row="0">
                                <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                                    <dxb:BarButtonItem Glyph="{StaticResource OPCBadd}" GlyphSize="Small" CustomGlyphSize="14,14" Name="startSearching" ToolTip="{x:Static local:Properties.Resources.StartSearching}" Content="{x:Static local:Properties.Resources.StartSearching}" ItemClick="startSearching_Click"/>
                                    <dxb:BarButtonItem Glyph="{StaticResource OPCBadd}" GlyphSize="Small" Content="{x:Static local:Properties.Resources.Login}" CustomGlyphSize="14,14" Name="login" ToolTip="{x:Static local:Properties.Resources.LoginTooltip}" ItemClick="LoginHandler"/>
                                    <dxb:BarButtonItem Glyph="{StaticResource OPCBadd}" GlyphSize="Small" CustomGlyphSize="14,14" Name="addHost" Content="{x:Static local:Properties.Resources.AddHost}" ToolTip="{x:Static local:Properties.Resources.AddHost}" ItemClick="addHost_Click" />
                                    <dxb:BarButtonItem Glyph="{StaticResource OPCBadd}" GlyphSize="Small" CustomGlyphSize="14,14" Name="addEndpoint" Content="{x:Static local:Properties.Resources.AddEndpoint}" ToolTip="{x:Static local:Properties.Resources.AddEndpoint}" ItemClick="addEndpoint_Click"/>
                                    <dxb:BarButtonItem Glyph="{StaticResource OPCBhelp}" GlyphSize="Small" CustomGlyphSize="14,14" ToolTip="{x:Static local:Properties.Resources.Help}"/>
                                </dxb:ToolBarControl>
                            </dxb:BarContainerControl>

                            <dxg:TreeListControl x:Name="treeListControl" SelectionMode="Row" dx:DXSerializer.SerializationID="OPCUABUITree"
                                                     Grid.Row="1" SelectionChanged="treeListControl_SelectionChanged">
                            <dxg:TreeListControl.Columns>
                              <dxg:TreeListColumn FieldName="InnerControl" >
                                <dxg:TreeListColumn.CellTemplate>
                                  <DataTemplate>
                                    <ContentControl Content="{Binding Data.InnerControl}" />
                                  </DataTemplate>
                                </dxg:TreeListColumn.CellTemplate>
                              </dxg:TreeListColumn>
                            </dxg:TreeListControl.Columns>
                            <dxg:TreeListControl.View>
                              <dxg:TreeListView x:Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                                      MultiSelectMode="None"  RowDoubleClick="OnRowDoubleClick"
                                                      ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                                      AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                                      ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                                      BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch"  VerticalAlignment="Top"
                                                      IsSynchronizedWithCurrentItem="True" AllowDragDrop="False"
                                                      NodeExpanding="OnTreeNodeExpanding"  NodeCollapsing="OnTreeNodeCollapsing"
                                                      AutoWidth="True">
                                <dxg:TreeListView.RowStyle>
                                  <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                      </MultiDataTrigger>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding Path=Connected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="Transparent" />
                                      </MultiDataTrigger>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding Path=Connected}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="Red" />
                                      </MultiDataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </dxg:TreeListView.RowStyle>
                                <dxg:TreeListView.CellStyle>
                                  <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                    <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                                  </Style>
                                </dxg:TreeListView.CellStyle>
                              </dxg:TreeListView>
                            </dxg:TreeListControl.View>
                          </dxg:TreeListControl>
                            <Grid x:Name="IsBusyGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                                Margin="0" Grid.Row="1">

                                <DockPanel LastChildFill="True">

                                    <Label DockPanel.Dock="Top" Height="40" FontSize="25" FontWeight="Bold" 
                                       FontFamily="Arial Black" 
                                       Margin="10,0,0,0"
                                       Foreground="Black" VerticalContentAlignment="Center"
                                       HorizontalAlignment="Stretch" Background="Transparent" 
                                       Content="{x:Static local:Properties.Resources.OPCUABrowser_PleaseWait}" />


                                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <cc:CircularProgressBar />
                                    </Viewbox>
                                </DockPanel>
                            </Grid>

                        </Grid>
                    </dxn:NavBarItem.Content>
                </dxn:NavBarItem>
            </dxn:NavBarGroup>

            <dxn:NavBarGroup Header="{x:Static local:Properties.Resources.RecentEndpoints}" IsExpanded="True">
                <dxn:NavBarItem>
                    <dxn:NavBarItem.Content>
                      <dxg:TreeListControl x:Name="treeListRecentControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged"
                                                 Grid.Row="1" dx:DXSerializer.SerializationID="OPCUABUIRecentTree">
                        <dxg:TreeListControl.Columns>
                          <dxg:TreeListColumn FieldName="InnerControl" >
                            <dxg:TreeListColumn.CellTemplate>
                              <DataTemplate>
                                <ContentControl Content="{Binding Data.InnerControl}" />
                              </DataTemplate>
                            </dxg:TreeListColumn.CellTemplate>
                          </dxg:TreeListColumn>
                        </dxg:TreeListControl.Columns>
                        <dxg:TreeListControl.View>
                          <dxg:TreeListView x:Name="treeListViewRecent" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                                  MultiSelectMode="None"  RowDoubleClick="OnRowDoubleClick"
                                                  ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                                  AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                                  ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                                  BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch"  VerticalAlignment="Top"
                                                  IsSynchronizedWithCurrentItem="True" AllowDragDrop="False"
                                                  AutoWidth="True">
                            <dxg:TreeListView.RowStyle>
                              <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                  </MultiDataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding Path=Connected}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="Transparent" />
                                  </MultiDataTrigger>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding Path=Connected}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="Red" />
                                  </MultiDataTrigger>
                                </Style.Triggers>
                              </Style>
                            </dxg:TreeListView.RowStyle>
                            <dxg:TreeListView.CellStyle>
                              <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                              </Style>
                            </dxg:TreeListView.CellStyle>
                          </dxg:TreeListView>
                        </dxg:TreeListControl.View>
                      </dxg:TreeListControl>
                    </dxn:NavBarItem.Content>
                </dxn:NavBarItem>
            </dxn:NavBarGroup>
        </dxn:NavBarControl.Groups>
    </dxn:NavBarControl>

</UserControl>
