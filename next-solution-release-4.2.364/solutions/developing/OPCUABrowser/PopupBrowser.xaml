<UserControl x:Class="OPCUABrowser.PopupBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    Height="300" Width="300" DataContextChanged="UserControl_DataContextChanged">
    <Grid>
      <dxdo:DockLayoutManager x:Name="dockingManager" DockingStyle="VS2010"
                                DockItemClosing="OnDockItemClosing" AutoHideExpandMode="MouseDown">
        <!-- ClosingBehavior="ImmediatelyRemove" -->
        <dxdo:LayoutGroup x:Name="rootLayoutGroup" DestroyOnClosingChildren="False">
          <dxdo:DocumentGroup x:Name="ChildDocumentGroup" MDIStyle="Tabbed" DestroyOnClosingChildren="False" ClosePageButtonShowMode="InAllTabPageHeaders">
          </dxdo:DocumentGroup>
        </dxdo:LayoutGroup>
      </dxdo:DockLayoutManager>
    </Grid>
</UserControl>
