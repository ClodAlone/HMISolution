<project outputDir="..\..\..\UFSolution\bin\Retail.obfuscated\" baseDir=".\UFSolution\bin\Retail" xmlns="http://confuser.codeplex.com">
  <rule pattern="true" preset="normal">
    <protection id="rename" action="remove" />
    <protection id="resources" action="remove" />
    <protection id="constants" action="remove" />
    <protection id="anti debug" action="remove" />
  </rule>
  <rule pattern="namespace(&quot;WPFUtilities.CryptString&quot;)" preset="aggressive" inherit="false">
    <protection id="resources" action="remove" />
    <protection id="anti debug" action="remove" />
  </rule>
  <rule pattern="namespace(&quot;DataProtection.Common&quot;)" preset="aggressive" inherit="false">
    <protection id="resources" action="remove" />
    <protection id="anti debug" action="remove" />
  </rule>
  <rule pattern="namespace(&quot;DataProtection.DataSet&quot;)" preset="aggressive" inherit="false">
    <protection id="resources" action="remove" />
    <protection id="anti debug" action="remove" />
  </rule>
  <rule pattern="namespace(&quot;DataProtection.Historian&quot;)" preset="aggressive" inherit="false">
    <protection id="resources" action="remove" />
    <protection id="anti debug" action="remove" />
  </rule>

