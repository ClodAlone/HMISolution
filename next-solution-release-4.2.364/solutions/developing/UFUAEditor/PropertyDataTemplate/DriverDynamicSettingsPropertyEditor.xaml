<UserControl x:Class="UFUAEditor.PropertyDataTemplate.DriverDynamicSettingsPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Button x:Name="btnClear" DockPanel.Dock="Right" 
                    IsEnabled="{Binding Value.IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                    Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button DockPanel.Dock="Right" Click="DlgButton_Click"
                    IsEnabled="{Binding Value.IsReadOnly, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="textBoxDynamic" IsReadOnly="False" LostFocus="textBoxDynamic_LostFocus"
                     IsEnabled="{Binding Value.IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                     Text="{Binding Value.DynamicSettingsForEditing, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" 
                     Validation.ErrorTemplate="{x:Null}" />
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
            Content="{Binding ElementName=textBoxDynamic, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
