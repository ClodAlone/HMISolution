<UserControl x:Class="UFUAEditor.PropertyDataTemplate.BytesSizePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BytesSizeConverter x:Key="BytesSizeConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel LastChildFill="True">
            <TextBlock x:Name="unitMeasureLabel" Width="Auto" Margin="0 0 3 0" DockPanel.Dock="Left" />
            <dxe:SpinEdit DockPanel.Dock="Right"
                MinValue="{Binding Path=MinValue, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                MaxValue="{Binding Path=MaxValue, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                MaskType="Numeric" Mask="#########.0" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Decimal}" Name="updown" 
                Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" 
                EditValue="{Binding Path=Value, Converter={StaticResource BytesSizeConverter}, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
            </dxe:SpinEdit>
        </DockPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding ElementName=updown, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
