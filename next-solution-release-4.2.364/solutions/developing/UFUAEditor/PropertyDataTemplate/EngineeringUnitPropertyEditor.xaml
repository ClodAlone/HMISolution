<UserControl x:Class="UFUAEditor.PropertyDataTemplate.EngineeringUnitPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--<converters:PropertyGridManyValueConverter x:Key="ManyValueConverter" />-->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="comboPrototype" IsEditable="True" IsReadOnly="True"
                      Text="{Binding Value, Mode=OneTime}" 
                      SelectedValue="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                      Validation.ErrorTemplate="{x:Null}"
                      DropDownOpened="comboPrototype_DropDownOpened" />
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=comboPrototype, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
