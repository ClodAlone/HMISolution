<UserControl x:Class="UFUAEditor.PropertyDataTemplate.TagEntityReferencePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:UFUACommonControls.Converters;assembly=UFUACommonControls"
             xmlns:convutilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:TagEntityReferenceConverter x:Key="TagConverter"/>
            <convutilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <!--<converters:PropertyGridManyValueConverter x:Key="ManyValueConverter" />-->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <DockPanel>
            <Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uri" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <dxe:ComboBoxEdit
                        x:Name="uriLabel" 
                        Text="{Binding Path=Tag,ElementName=uri,Converter={StaticResource TagConverter}, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" 
                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                        PopupOpening="uriLabel_PopupOpening"
                        LostFocus="uriLabel_LostFocus" PreviewKeyDown="uriLabel_KeyDown" GotFocus="uriLabel_GotFocus"
                        SelectedIndexChanged="uriLabel_SelectedIndexChanged"
                        ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"/>
            <!--<TextBox x:Name="text" Text="{Binding Value, Mode=OneWay, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}" />-->
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=text, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
