<UserControl x:Class="UFUAEditor.PropertyDataTemplate.ListDynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CommonControls.Converters;assembly=CommonControls"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:self="clr-namespace:UFUAEditor.PropertyDataTemplate"
             Height="300" Width="300"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ActualWidthConverter x:Key="ActualWidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>

        <CommandBinding Command="{x:Static self:ListDynamicSettingsEditor.EditCommand}"
                    Executed="OnEditCommandExecuted" 
                    CanExecute="OnCanExecuteEditCommand" />

        <CommandBinding Command="{x:Static self:ListDynamicSettingsEditor.RemoveCommand}"
                    Executed="OnRemoveCommandExecuted" 
                    CanExecute="OnCanExecuteRemoveCommand" />

        <CommandBinding Command="{x:Static self:ListDynamicSettingsEditor.MoveUpCommand}"
                    Executed="OnMoveUpCommandExecuted" 
                    CanExecute="OnCanExecuteMoveUpCommand" />

        <CommandBinding Command="{x:Static self:ListDynamicSettingsEditor.MoveDownCommand}"
                    Executed="OnMoveDownCommandExecuted" 
                    CanExecute="OnCanExecuteMoveDownCommand" />

        <CommandBinding Command="{x:Static self:ListDynamicSettingsEditor.AddNewCommand}"
                    Executed="OnAddNewCommandExecuted" 
                    CanExecute="OnCanExecuteAddNewCommand" />

        <CommandBinding Command="{x:Static self:ListDynamicSettingsEditor.RemoveAllCommand}"
                    Executed="OnRemoveAllCommandExecuted" 
                    CanExecute="OnCanExecuteRemoveAllCommand" />

    </UserControl.CommandBindings>

    <Grid x:Name="layoutGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="90*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        
        <ListBox x:Name="listBoxControl" 
                 ItemsSource="{Binding}"
                 IsSynchronizedWithCurrentItem="False" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid 
                        Width="{Binding Path=ActualWidth, 
                        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}},
                        Converter={StaticResource ResourceKey=ActualWidthConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="textEnum" Tag="{Binding}" 
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                 Validation.ErrorTemplate="{x:Null}" />
                        <Button Grid.Column="1" Tag="{Binding}"
                                Command="{x:Static self:ListDynamicSettingsEditor.EditCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="2" Tag="{Binding}"
                                Command="{x:Static self:ListDynamicSettingsEditor.RemoveCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="3" Tag="{Binding}"
                                Command="{x:Static self:ListDynamicSettingsEditor.MoveUpCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource MoveUpSmall}"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="4" Tag="{Binding}"
                                Command="{x:Static self:ListDynamicSettingsEditor.MoveDownCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource MoveDownSmall}"/>
                            </Button.Content>
                        </Button>
                        <ContentPresenter Grid.Column="5" Content="{Binding ElementName=textEnum, Path=(Validation.Errors).CurrentItem}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static properties:Resources.NewEnumDynamicSettingsAddNew}" Command="{x:Static self:ListDynamicSettingsEditor.AddNewCommand}" />
            <Button Content="{x:Static properties:Resources.NewEnumDynamicSettingsRemoveAll}" Grid.Column="2" Command="{x:Static self:ListDynamicSettingsEditor.RemoveAllCommand}" />
        </Grid>
        
    </Grid>
</UserControl>
