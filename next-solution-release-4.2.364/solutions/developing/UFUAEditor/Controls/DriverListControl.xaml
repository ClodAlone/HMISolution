<dxg:GridControl x:Class="UFUAEditor.Controls.DriverListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d"
             MinHeight="10" MinWidth="10"
             AutoExpandAllGroups="True"
             AutoGenerateColumns="AddNew"
             AutoPopulateColumns="False"
             AllowDrop="True"
             AllowLiveDataShaping="False"
             dx:DXSerializer.StoreLayoutMode="All"
             dxg:DataControlSerializationOptions.AddNewColumns="False"
             dxg:DataControlSerializationOptions.RemoveOldColumns="False">

  <dxg:GridControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxg:GridControl.Resources>
  
            <dxg:GridControl.Columns>
              <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="False" DisplayMemberBinding="{Binding Path=FriendlyName, Mode=OneWay}" FieldName="FriendlyName" Header="{x:Static properties:Resources.DriverFriendlyName}"/>
              <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Factory, Mode=OneWay}" FieldName="Factory" Header="{x:Static properties:Resources.DriverFactory}"/>
              <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=PackageType, Mode=OneWay}" FieldName="PackageType" Header="{x:Static properties:Resources.DriverPackageType}"/>
              <dxg:GridColumn x:Name="win32Col" Visible="False" ReadOnly="True" AllowEditing="False" AllowGrouping="True" Header="{x:Static properties:Resources.Win32}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Data.Win32}" IsHitTestVisible="False"/>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>
              <dxg:GridColumn x:Name="win64Col" Visible="False" ReadOnly="True" AllowEditing="False" AllowGrouping="True" Header="{x:Static properties:Resources.Win64}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Data.Win64}" IsHitTestVisible="False"/>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>
              <dxg:GridColumn x:Name="linuxCol" Visible="False" ReadOnly="True" AllowEditing="False" AllowGrouping="True" Header="{x:Static properties:Resources.Linux}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Data.Linux}" IsHitTestVisible="False"/>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>
              <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="False" DisplayMemberBinding="{Binding Path=Help, Mode=OneWay}" FieldName="Help" Header="{x:Static properties:Resources.DriverHelp}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <Button Click="Help_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                      <Button.Content>
                        <Image Margin="2" Source="{StaticResource Info}" Height="16" Width="16" />
                      </Button.Content>
                    </Button>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
              <dxg:TableView x:Name="tableView" AllowEditing="True"
                          FadeSelectionOnLostFocus="False" AutoWidth="True"
                          BestFitMode="VisibleRows"
                          AllowBestFit="True"
                          AllowResizing="True"
                          ShowGroupPanel="True"
                          ShowSearchPanelMode="Always" SearchPanelFindMode="Always"
                          ShowSearchPanelMRUButton="True"
                          ShowFilterPanelMode="ShowAlways"
                          NavigationStyle="Row"
                          MultiSelectMode="None">
              </dxg:TableView>
            </dxg:GridControl.View>
</dxg:GridControl>