<helpers:TreeViewEditorHelper x:Class="UFUAEditor.Controls.AddressSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFUAEditor"
             xmlns:controls="clr-namespace:UFUAEditor.Controls"                              
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:helpers="clr-namespace:UFUAEditor.Helpers"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:ufuamodel="clr-namespace:UFUAModel;assembly=UFUAModel"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
             xmlns:dxeh="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"  
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            <ResourceDictionary Source="/SharedResources;component/Resources/UFUAServer.xaml" />
          </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <converters:AlarmsThresholdsConverter x:Key="AlarmsThresholdsConverter"/>
            <converters:ViewsConverter x:Key="ViewsConverter"/>
            <converters:StringToBooleanConverter x:Key="StringToBooleanConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="ApplicationCommands.Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="ApplicationCommands.Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    Executed="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />

        <CommandBinding Command="ApplicationCommands.Redo"
                    Executed="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="NavigationCommands.Refresh"
                    Executed="OnRefresh" 
                    CanExecute="CanRefresh" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewTag}" 
                    Executed="OnAddNewTag" 
                    CanExecute="CanAddNewTag" />
        
        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewFolder}" 
                    Executed="OnAddNewFolder" 
                    CanExecute="CanAddNewFolder" />

        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssociateView}" 
                    Executed="OnAssignView" 
                    CanExecute="CanAssignView" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssignHistoricalSettings}" 
                    Executed="OnAssignHistoricalSettings" 
                    CanExecute="CanAssignHistoricalSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssignAlarmDefinition}" 
                    Executed="OnAssignAlarmDefinition" 
                    CanExecute="CanAssignAlarmDefinition" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.RemoveAlarmDefinitions}" 
                    Executed="OnRemoveAlarmDefinitions" 
                    CanExecute="CanRemoveAlarmDefinitions" />

    </UserControl.CommandBindings>

    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <dxb:BarManager.DXContextMenu>
            <dxb:PopupMenu x:Name="contextMenu">
                <dxb:PopupMenu.Items>
                    
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewTag}" Content="{x:Static properties:UICommandResource.AddNewTagText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewFolder}" Content="{x:Static properties:UICommandResource.AddNewFolderText}"/>

                    <dxb:BarItemLinkSeparator />

                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AssociateView}" Content="{x:Static properties:UICommandResource.AssociateViewText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AssignHistoricalSettings}" Content="{x:Static properties:UICommandResource.AssignHistoricalSettingsText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AssignAlarmDefinition}" Content="{x:Static properties:UICommandResource.AssignAlarmDefinitionText}"/>

                    <dxb:BarItemLinkSeparator />

                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.RemoveAlarmDefinitions}" Content="{x:Static properties:UICommandResource.RemoveAlarmDefinitionsText}"/>

                    <dxb:BarItemLinkSeparator />

                    <dxb:BarSubItem Content="{x:Static self:Properties.UICommandResource.EditMenuText}">
                        <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                        <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}"/>

                        <dxb:BarItemLinkSeparator />

                        <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}"/>
                        <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                        <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}"/>
                        <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                        
                        <dxb:BarItemLinkSeparator />
                        
                        <dxb:BarButtonItem Command="Properties" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                    </dxb:BarSubItem>

                    <dxb:BarItemLinkSeparator />

                    <dxb:BarButtonItem Command="NavigationCommands.Refresh" Content="{x:Static appproperties:ApplicationCommandsResource.Refresh}" />

                </dxb:PopupMenu.Items>
            </dxb:PopupMenu>
        </dxb:BarManager.DXContextMenu>

        <!--Toolbar-->
        <dxb:BarContainerControl ContainerType="Top" Grid.Row="0" Grid.Column="0" x:Name="toolbar" Visibility="Collapsed">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                <dxb:BarButtonItem Glyph="{StaticResource OpenFolderSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                        Command="{x:Static self:UIGeneralCommands.AddNewFolder}"/>
                <dxb:BarButtonItem Glyph="{StaticResource UFUASVariableSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                        Command="{x:Static self:UIGeneralCommands.AddNewTag}"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!-- Workaround: forcing resourcedictionary required assembly load otherwise an exception is thrown on DXTabItem show -->
        <dxa:AccordionControl Visibility="Collapsed"/>
        
        <dx:DXTabControl Grid.Row="1" Grid.Column="0" x:Name="tabAddressSpaceTabControl" Padding="0">
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Bottom" />
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="treeListTab" Header="{x:Static properties:Resources.Hierarchical}">

                <dxg:TreeListControl Name="treeListControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged">
                    <dxg:TreeListControl.Columns>
                        <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="ItemHeader" Validate="OnTreeHeaderValidate" Header="{x:Static self:Properties.Resources.ASName}" />
                        <!-- Validate="OnTreeHeaderValidate" -->
                    </dxg:TreeListControl.Columns>
                    <dxg:TreeListControl.View>
                        <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                        ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                        AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False" PreviewKeyDown="View_PreviewKeyDown"
                                        ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                        IsSynchronizedWithCurrentItem="True" AllowDragDrop="True" AllowSortedDataDragDrop="True"
                                        NodeChanged="OnTreeNodeChanged" NodeExpanding="OnTreeNodeExpanding" NodeCollapsing="OnTreeNodeCollapsing"
                                        RowDoubleClick="OnRowDoubleClick" AutoWidth="True" CanSelectRow="OnCanSelectRow"
                                        StartRecordDrag="TreeListControl_DragStart" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"
                                        DropRecord="TreeListControl_DragEnd" HiddenEditor="OnHiddenEditor">
                            <!-- DragRecordOver="TreeListControl_DragRecordOver" HiddenEditor="OnHiddenEditor" -->
                            <!--<dxg:TreeListView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TreeListView.RowStyle>-->
                            <dxg:TreeListView.CellStyle>
                                <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                  <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                                </Style>
                            </dxg:TreeListView.CellStyle>
                        </dxg:TreeListView>
                    </dxg:TreeListControl.View>
                    <dxg:TreeListControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:TreeListControl.CommandBindings>
                </dxg:TreeListControl>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="gridControlTab" Header="{x:Static properties:Resources.Flat}">
                <dxg:GridControl MinHeight="10" MinWidth="10"
                                    SelectionChanged="OnGridSelectionChanged"
                                    FilterChanged="OnFilterChanged"
                                    AutoExpandAllGroups="True"
                                    AutoGenerateColumns="AddNew"
                                    Name="gridDataControl" 
                                    AutoPopulateColumns="False" 
                                    AllowDrop="True" 
                                    AllowLiveDataShaping="False"                         
                                    dx:DXSerializer.SerializationID="gridDataControl" 
                                    dx:DXSerializer.StoreLayoutMode="All" 
                                    dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                    dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                    <dxg:GridControl.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="/UFUAEditor;component/Resources/SearchPanelResources.xaml"/>
                            </ResourceDictionary.MergedDictionaries>
                            <controls:CustomChildrenSelector x:Key="childrenSelector"/>
                        </ResourceDictionary>
                    </dxg:GridControl.Resources>
                    <dxg:GridControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:GridControl.CommandBindings>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn AllowEditing="True" FieldName="Name" Header="{x:Static properties:Resources.ASName}">
                            <dxg:GridColumn.CellDisplayTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="3,0,0,0" VerticalAlignment="Center" Text="{Binding RowData.Row.Name}" dxeh:TextBlockService.EnableTextHighlighting="True" dxeh:TextBlockService.HighlightedText="{Binding View.SearchString}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellDisplayTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" FieldName="FolderPath" Header="{x:Static properties:Resources.ASPath}"/>
                        <dxg:GridColumn AllowEditing="True" FieldName="DataType" Header="{x:Static properties:Resources.ASDataType}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType=ufuamodel:DataType}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="True" FieldName="ModelType" Header="{x:Static properties:Resources.ASModel}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType=ufuamodel:ModelType}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="True" FieldName="PrototypeName" Header="{x:Static properties:Resources.ASPrototype}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="True" FieldName="DynamicSettings" Header="{x:Static properties:Resources.ASDynamic}"/>
                        <dxg:GridColumn AllowEditing="False" FieldName="ScriptCode" Binding="{Binding Path=ScriptCode, Converter={StaticResource StringToBooleanConverter}, Mode=TwoWay}" Header="{x:Static properties:Resources.ASScriptCode}"/>
                        <dxg:GridColumn AllowEditing="True" FieldName="Description" Header="{x:Static properties:Resources.ASDescription}"/>
                        <!--<dxg:GridColumn ReadOnly="True" AllowEditing="False" FieldName="Alarms" Header="{x:Static properties:Resources.ASAlarms}"/>-->
                        <dxg:GridColumn AllowEditing="True" x:Name="ViewsColumn" Binding="{Binding Path=Views, Converter={StaticResource ViewsConverter}, Mode=TwoWay}" Header="{x:Static properties:Resources.ASViews}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings SeparatorString=",">
                                    <dxe:ComboBoxEditSettings.StyleSettings>
                                        <dxe:CheckedComboBoxStyleSettings />
                                    </dxe:ComboBoxEditSettings.StyleSettings>
                                </dxe:ComboBoxEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="True" FieldName="HistorianSettings" Header="{x:Static properties:Resources.ASHistorianSettings}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="True" FieldName="UFUAEngineeringUnit" Header="{x:Static properties:Resources.ASUFUAEngineeringUnit}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem SummaryType="Count" Alignment="Left" Visible="True" dxg:TreeListSummarySettings.IsRecursive="False"
                                        DisplayFormat="{x:Static properties:Resources.TotalTags}" FieldName="Name"/>
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.View>
                        <dxg:TreeListView Name="tableView"  FilterMode="Extended"
                                        KeyFieldName="Members" ParentFieldName="UFUATagOwner"
                                        TreeDerivationMode="ChildNodesSelector" ChildNodesSelector="{StaticResource childrenSelector}" FetchSublevelChildrenOnExpand="True"
                                        AllowEditing="True" ShowingEditor="tableView_ShowingEditor" ShownEditor="OnShownEditor" HiddenEditor="OnHiddenEditor" ValidateCell="OnValidateCell"
                                        PreviewKeyDown="View_PreviewKeyDown" 
                                        SearchPanelHorizontalAlignment="Stretch" 
                                        NodeExpanding="OnGridTreeNodeExpanding" EnableDynamicLoading="True"
                                        FadeSelectionOnLostFocus="False" 
                                        BestFitMode="VisibleRows" ShowFixedTotalSummary="True"
                                        AllowBestFit="True" 
                                        AllowResizing="True"
                                        ItemsSourceErrorInfoShowMode="None"
                                        EditorShowMode="MouseDownFocused"
                                        ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                                        ShowSearchPanelMRUButton="True"
                                        SearchStringToFilterCriteria="OnSearchStringChanged"
                                        RowDoubleClick="OnRowDoubleClick" CanSelectRow="OnCanSelectRow"
                                        ShowFilterPanelMode="ShowAlways" 
                                        NavigationStyle="Cell" 
                                        MultiSelectMode="Row"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</helpers:TreeViewEditorHelper>
