<UserControl x:Class="UFUAEditor.Controls.SetMemberPosition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             mc:Ignorable="d" Width="300" Height="300"
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.SetMemberPositionTitle}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.SetMemberPositionNewPosition}" VerticalAlignment="Center" />
            <dxe:SpinEdit x:Name="textPosition" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          HorizontalContentAlignment="Left" MaskType="Numeric" Mask="d" InvalidValueBehavior="AllowLeaveEditor" ShowError="False"
                          Value="{Binding MemberOrderId, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          Validation.ErrorTemplate="{x:Null}" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
                              Content="{Binding ElementName=textPosition, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
