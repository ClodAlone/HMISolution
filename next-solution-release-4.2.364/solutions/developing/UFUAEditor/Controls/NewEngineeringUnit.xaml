<UserControl x:Class="UFUAEditor.Controls.NewEngineeringUnit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" Width="300" Height="350"
             d:DesignHeight="350" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.EUProperties}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.EUName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.EUUnit}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UnitName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditUnitName" />
            <ContentPresenter Grid.Row="2" Grid.Column="2" 
            Content="{Binding ElementName=textEditUnitName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.EURangeLow}" VerticalAlignment="Center" />
            <dxe:SpinEdit Grid.Column="1" Grid.Row="3" Name="textEURangeLow" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}"  
                           MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                           EditValue="{Binding EURangeLow, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>

            <ContentPresenter Grid.Row="3" Grid.Column="2" 
            Content="{Binding ElementName=textEURangeLow, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.EURangeHigh}" VerticalAlignment="Center" />
            <dxe:SpinEdit Grid.Column="1" Grid.Row="4" Name="textEURangeHigh" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}"
                           MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                           EditValue="{Binding EURangeHigh, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>

            <ContentPresenter Grid.Row="4" Grid.Column="2"  
            Content="{Binding ElementName=textEURangeHigh, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.EUInstrRangeLow}" VerticalAlignment="Center" />
            <dxe:SpinEdit Grid.Column="1" Grid.Row="5" Name="textInstrumentRangeLow" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Validation.ErrorTemplate="{x:Null}"
                           MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                           EditValue="{Binding InstrumentRangeLow, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>

            <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=textInstrumentRangeLow, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.EUInstrRangeHigh}" VerticalAlignment="Center" />
            <dxe:SpinEdit Grid.Column="1" Grid.Row="6" Name="textInstrumentRangeHigh" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}"
                           MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                           EditValue="{Binding InstrumentRangeHigh, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>

            <ContentPresenter Grid.Row="6" Grid.Column="2" 
            Content="{Binding ElementName=textInstrumentRangeHigh, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </ScrollViewer>
</UserControl>
