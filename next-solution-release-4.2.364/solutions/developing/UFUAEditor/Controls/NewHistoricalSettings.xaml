<UserControl x:Class="UFUAEditor.Controls.NewHistoricalSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:editors="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:Propertydatatemplate="clr-namespace:UFUAEditor.PropertyDataTemplate"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Width="400" Height="660" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.HisProperties}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.HisName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.HisEnabled}" VerticalAlignment="Center" />
            <CheckBox x:Name="checkBoxEnabled" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" 
                  IsChecked="{Binding Enabled}" />

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.HisEnabledTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="3" Grid.Column="1">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textHisEnabledTag"/>
            </Grid>
            <ContentPresenter Grid.Row="3" Grid.Column="2" 
            Content="{Binding ElementName=uriEnabledTag, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.HisDeviation}" VerticalAlignment="Center" x:Name="textDeviationType"/>
            <ComboBox Grid.Column="1" Grid.Row="4" SelectedValue="{Binding ExceptionDeviationFormat}" x:Name="comboDeviationType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False"/>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.HisValue}" VerticalAlignment="Center" x:Name="textBlockActivationValue"/>
          <dxe:SpinEdit Grid.Column="1" Grid.Row="5" Name="textDeviationValue" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}" 
                               MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor" MinValue="0"
                           EditValue="{Binding ExceptionDeviation, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.HisMinInterval}" VerticalAlignment="Center" />
            <editors:TimeSpanEdit  Grid.Row="6" Grid.Column="1" Mask="hh:mm:ss" TimeSpan="{Binding MinTimeInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" ValidateOnTextInput="False" AllowSpinOnMouseWheel="False"
                 x:Name="textEditMinInterval"  />
            <ContentPresenter Grid.Row="6" Grid.Column="2" 
            Content="{Binding ElementName=textEditMinInterval, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.HisMaxInterval}" VerticalAlignment="Center" />
          <editors:TimeSpanEdit Grid.Row="7" Grid.Column="1" Mask="hh:mm:ss" TimeSpan="{Binding MaxTimeInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" ValidateOnTextInput="False" AllowSpinOnMouseWheel="False"
                 x:Name="textEditMaxInterval"  />
            <ContentPresenter Grid.Row="7" Grid.Column="2" 
            Content="{Binding ElementName=textEditMaxInterval, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.HisConnectionString}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Grid.Row="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox  Text="{Binding ConnectionSettings, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditConnection" />
                <Button Grid.Column="1" Click="textEditConnection_DefaultButtonClick" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <ContentPresenter Grid.Row="9" Grid.Column="2" 
            Content="{Binding ElementName=textEditConnection, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.HisMaxAge}" VerticalAlignment="Center" />
          <editors:TimeSpanEdit Grid.Row="10" Grid.Column="1" Mask="hh:mm:ss" TimeSpan="{Binding MaxAge, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" ValidateOnTextInput="False" AllowSpinOnMouseWheel="False"
                 x:Name="textEditMaxAge"  />
            <ContentPresenter Grid.Row="10" Grid.Column="2" 
            Content="{Binding ElementName=textEditMaxAge, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.HisWaitRetry}" VerticalAlignment="Center" x:Name="textBlockWaitRetryValue"/>
          <dxe:SpinEdit Grid.Column="1" Grid.Row="12" Name="textWaitRetryValue" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                        MaskType="Numeric" EditValueType="{x:Type sys:UInt16}"
                        MaskUseAsDisplayFormat="True" Mask="N0"
                        EditValue="{Binding WaitRetryTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.HisMaxRetries}" VerticalAlignment="Center" x:Name="textBlockMaxRetriesValue"/>
          <dxe:SpinEdit Grid.Column="1" Grid.Row="13" Name="textMaxRetriesValue" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                        MaskType="Numeric" EditValueType="{x:Type sys:Byte}"
                        MaskUseAsDisplayFormat="True" Mask="N0"
                        EditValue="{Binding MaxErrorBeforeFlush, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.HisCacheSize}" VerticalAlignment="Center" x:Name="textBlockCacheSizeValue"/>
          <dxe:SpinEdit Grid.Column="1" Grid.Row="14" Name="textCacheSizeValue" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                           MaskType="Numeric" EditValueType="{x:Type sys:UInt16}"
                        MaskUseAsDisplayFormat="True" Mask="N0"
                           EditValue="{Binding MaxErrorCacheSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.HisRecordOnlyQualityGood}" VerticalAlignment="Center" />
            <CheckBox x:Name="checkBoxOnlyQualityGood" Grid.Column="1" Grid.Row="16" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" 
                  IsChecked="{Binding RecordOnlyOnQualityGood}" />

            <GroupBox Header="{x:Static properties:Resources.HisAggregationSettings}" Background="{x:Null}"
                  Grid.Row="17" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Static properties:Resources.HisPercentDataGood}" VerticalAlignment="Center" x:Name="textBlockPercentDataGood" />
                  <dxe:SpinEdit Grid.Column="1" Name="textPercentDataGood" MinValue="0" MaxValue="100" Increment="1"
                           MaskType="Numeric" Mask="##0 %%" EditValueType="{x:Type sys:Byte}" MaskUseAsDisplayFormat="True"
                           EditValue="{Binding PercentDataGood, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"/>

                    <TextBlock Text="{x:Static properties:Resources.HisPercentDataBad}" VerticalAlignment="Center" x:Name="textBlockPercentDataBad" Grid.Row="1" />
                  <dxe:SpinEdit Grid.Row="1" Grid.Column="1" Name="textPercentDataBad" MinValue="0" MaxValue="100" Increment="1"
                           MaskType="Numeric" Mask="##0 %%" EditValueType="{x:Type sys:Byte}" MaskUseAsDisplayFormat="True" 
                           EditValue="{Binding PercentDataBad, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"/>

                    <TextBlock Text="{x:Static properties:Resources.HisTreatUncertainAsBad}" VerticalAlignment="Center" Grid.Row="2" />
                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding TreatUncertainAsBad}" 
                          HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

                    <TextBlock Text="{x:Static properties:Resources.HisUseSlopedExtrapolation}" VerticalAlignment="Center" Grid.Row="3" />
                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding UseSlopedExtrapolation}" 
                          HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

                    <TextBlock Text="{x:Static properties:Resources.HisStepped}" VerticalAlignment="Center" Grid.Row="4" />
                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Stepped}" 
                          HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

                </Grid>
            </GroupBox>

        </Grid>
    </ScrollViewer>
</UserControl>
