<UserControl x:Class="UFUAEditor.Controls.NewAlarmDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dt="clr-namespace:UFUAEditor.PropertyDataTemplate"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Height="700" Width="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.ADProperties}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.ADName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.ADType}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Grid.Row="2" SelectedValue="{Binding AlarmType}" x:Name="comboAlarmType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboAlarmType_SelectionChanged" />

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.ADCondition}" VerticalAlignment="Center" x:Name="textConditionType"/>
            <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding ConditionType}" x:Name="comboConditionType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboConditionType_SelectionChanged" />

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.ADValue}" VerticalAlignment="Center" x:Name="textBlockActivationValue"/>
          

            <dxe:SpinEdit Grid.Column="1" Grid.Row="4" Name="textActivationValue" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}" 
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                           MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           InvalidValueBehavior="AllowLeaveEditor"
                           EditValue="{Binding ActivationValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=textActivationValue, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.ADLowValue}" VerticalAlignment="Center" x:Name="textBlockActivationLowValue"/>
            <dxe:SpinEdit Grid.Column="1" Grid.Row="5" Name="textActivationLowValue" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}"  
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                           MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                           InvalidValueBehavior="AllowLeaveEditor"
                           EditValue="{Binding ActivationLowValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=textActivationLowValue, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.ADDeviation}" VerticalAlignment="Center" x:Name="textDeviationType"/>
            <ComboBox Grid.Column="1" Grid.Row="7" SelectedValue="{Binding DeviationType}" x:Name="comboDeviationType" 
                  VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False"
                  SelectionChanged="comboDeviationType_SelectionChanged"/>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.ADHH}" VerticalAlignment="Center" x:Name="textBlockHighHighLimit"/>
            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.ADHHLevel}" VerticalAlignment="Center" x:Name="textBlockHighHighLevel" Visibility="Collapsed"/>
            <Grid Grid.Row="8" Grid.Column="1" Name="gridHighHighLimit" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkHighHighLimit" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableHighHighLimit, UpdateSourceTrigger=PropertyChanged}" />
              <dxe:SpinEdit Name="textHighHighLimit" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Validation.ErrorTemplate="{x:Null}"  
                               AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                               InvalidValueBehavior="AllowLeaveEditor"
                               IsEnabled="{Binding Path=IsChecked, ElementName=checkHighHighLimit}"
                               MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                               EditValue="{Binding HighHighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
              <!-- Percent limit is hidden by default -->
              <dxe:SpinEdit Grid.Column="1" Name="textHighHighPercentLimit" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Validation.ErrorTemplate="{x:Null}" Increment="1"
                                     IsEnabled="{Binding Path=IsChecked, ElementName=checkHighHighLimit}"
                                     MaskType="Numeric" Mask="##0 %%" EditValueType="{x:Type sys:Double}" MaskUseAsDisplayFormat="True"
                                     EditValue="{Binding HighHighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <ContentPresenter Grid.Row="8" Grid.Column="2" Content="{Binding ElementName=textHighHighLimit, Path=(Validation.Errors).CurrentItem}"/>


            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.ADH}" VerticalAlignment="Center" x:Name="textBlockHighLimit"/>
            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.ADHLevel}" VerticalAlignment="Center" x:Name="textBlockHighLevel" Visibility="Collapsed"/>
            <Grid Grid.Row="9" Grid.Column="1" Name="gridHighLimit" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkHighLimit" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" 
                      IsChecked="{Binding EnableHighLimit, UpdateSourceTrigger=PropertyChanged}" />
              <dxe:SpinEdit Name="textHighLimit" Grid.Column="1"
                               Validation.ErrorTemplate="{x:Null}"  
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                           InvalidValueBehavior="AllowLeaveEditor"
                               IsEnabled="{Binding Path=IsChecked, ElementName=checkHighLimit}"
                               MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                               EditValue="{Binding HighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
              <!-- Percent limit is hidden by default -->
              <dxe:SpinEdit Grid.Column="1" Name="textHighPercentLimit" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Validation.ErrorTemplate="{x:Null}" Increment="1"
                                     IsEnabled="{Binding Path=IsChecked, ElementName=checkHighLimit}"
                                     MaskType="Numeric" Mask="##0 %%" EditValueType="{x:Type sys:Double}" MaskUseAsDisplayFormat="True"
                                     EditValue="{Binding HighLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <ContentPresenter Grid.Row="9" Grid.Column="2" Content="{Binding ElementName=textHighLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.ADL}" VerticalAlignment="Center" x:Name="textBlockLowLimit"/>
            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.ADLLevel}" VerticalAlignment="Center" x:Name="textBlockLowLevel" Visibility="Collapsed"/>
            <Grid Grid.Row="10" Grid.Column="1" Name="gridLowLimit" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkLowLimit" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableLowLimit, UpdateSourceTrigger=PropertyChanged}" />
              <dxe:SpinEdit Name="textLowLimit" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Validation.ErrorTemplate="{x:Null}" 
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                           InvalidValueBehavior="AllowLeaveEditor"
                               IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLimit}"
                               MaskType="Numeric" EditValueType="{x:Type sys:Double}" 
                               EditValue="{Binding LowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
              <!-- Percent limit is hidden by default -->
              <dxe:SpinEdit Grid.Column="1" Name="textLowPercentLimit" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Validation.ErrorTemplate="{x:Null}" Increment="1"
                                     IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLimit}"
                                     MaskType="Numeric" Mask="##0 %%" EditValueType="{x:Type sys:Double}" MaskUseAsDisplayFormat="True"
                                     EditValue="{Binding LowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <ContentPresenter Grid.Row="10" Grid.Column="2" Content="{Binding ElementName=textLowLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.ADLL}" VerticalAlignment="Center" x:Name="textBlockLowLowLimit"/>
            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.ADLLLevel}" VerticalAlignment="Center" x:Name="textBlockLowLowLevel" Visibility="Collapsed"/>
            <Grid Grid.Row="11" Grid.Column="1" Name="gridLowLowLimit" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkLowLowLimit" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5"
                      IsChecked="{Binding EnableLowLowLimit, UpdateSourceTrigger=PropertyChanged}" />
              <dxe:SpinEdit Name="textLowLowLimit" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Validation.ErrorTemplate="{x:Null}"  
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                           InvalidValueBehavior="AllowLeaveEditor"
                               IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLowLimit}"
                               MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                               EditValue="{Binding LowLowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
              <!-- Percent limit is hidden by default -->
              <dxe:SpinEdit Grid.Column="1" Name="textLowLowPercentLimit" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Validation.ErrorTemplate="{x:Null}" Increment="1"
                                     IsEnabled="{Binding Path=IsChecked, ElementName=checkLowLowLimit}"
                                     MaskType="Numeric" Mask="##0 %%" EditValueType="{x:Type sys:Double}" MaskUseAsDisplayFormat="True"
                                     EditValue="{Binding LowLowLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <ContentPresenter Grid.Row="11" Grid.Column="2" Content="{Binding ElementName=textLowLowLimit, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.ADSeverity}" VerticalAlignment="Center" x:Name="textBlockSeverity"/>
          <dxe:SpinEdit Grid.Column="1" Grid.Row="13" Name="textSeverity" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Validation.ErrorTemplate="{x:Null}" 
                           AllowSpinOnMouseWheel="False" ValidateOnTextInput="False" ShowError="False"
                           InvalidValueBehavior="AllowLeaveEditor" EditValueChanged="textSeverity_ValueChanged"
                           MaskType="Numeric" EditValueType="{x:Type sys:Int32}"
                           EditValue="{Binding Severity, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
            <ContentPresenter Grid.Row="13" Grid.Column="2" 
            Content="{Binding ElementName=textSeverity, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.ADEnableQualityGood}" VerticalAlignment="Center" x:Name="textEnableQualityGood" />
            <CheckBox x:Name="checkEnableQualityGood" Grid.Column="1" Grid.Row="14" IsChecked="{Binding EnableQualityGood}" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.ADSaveEventsLog}" VerticalAlignment="Center" x:Name="textBlockSaveEventsLog" />
            <CheckBox x:Name="checkSaveEventsLog" Grid.Column="1" Grid.Row="15" IsChecked="{Binding SaveEventsLog}" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.ADSupportAck}" VerticalAlignment="Center" x:Name="textBlockSupportAck" />
            <CheckBox x:Name="checkBoxSupportAck" Grid.Column="1" Grid.Row="16" IsChecked="{Binding SupportAck}" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="17" Text="{x:Static properties:Resources.ADSupportReset}" VerticalAlignment="Center" x:Name="textBlockSupportReset" />
            <CheckBox x:Name="checkBoxSupportReset" Grid.Column="1" Grid.Row="17" IsChecked="{Binding SupportReset}" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="18" Text="{x:Static properties:Resources.ADBeep}" VerticalAlignment="Center" x:Name="textBlockBeep" />
            <CheckBox x:Name="checkBoxBeep" Grid.Column="1" Grid.Row="18" IsChecked="{Binding Beep}" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="19" Text="{x:Static properties:Resources.ADBranches}" VerticalAlignment="Center" x:Name="textBlockBranches" />
            <CheckBox x:Name="checkBoxBranches" Grid.Column="1" Grid.Row="19" IsChecked="{Binding SaveBranches}" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="21" Text="{x:Static properties:Resources.ADTimeUnit}" VerticalAlignment="Center" x:Name="textBlockTimeUnit" />
            <dt:TimeDelayPropertyEditor Grid.Row="21" Grid.Column="1" x:Name="textEditTimeUnit" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" />

            <TextBlock Grid.Row="23" Text="{x:Static properties:Resources.ADDelayOn}" VerticalAlignment="Center" x:Name="textBlockDelayOn" />
            <dt:TimeDelayPropertyEditor Grid.Row="23" Grid.Column="1" x:Name="textEditDelayTimeOn"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"  />

            <TextBlock Grid.Row="24" Text="{x:Static properties:Resources.ADDelayOff}" VerticalAlignment="Center" x:Name="textBlockDelayOff" />
            <dt:TimeDelayPropertyEditor Grid.Row="24" Grid.Column="1" x:Name="textEditDelayTimeOff" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" />
        </Grid>
    </ScrollViewer>
</UserControl>
