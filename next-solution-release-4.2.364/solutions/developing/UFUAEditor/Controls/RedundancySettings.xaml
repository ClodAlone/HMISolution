<UserControl x:Class="UFUAEditor.Controls.RedundancySettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:wpfc="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DateTimeToTimeSpanConverter x:Key="DateTimeToTimeSpanConverter"/>
            <Style x:Key="HorizontalTile" TargetType="dxlc:Tile">
                <Setter Property="VerticalHeaderAlignment" Value="Top" />
                <Setter Property="HorizontalHeaderAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{x:Null}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=dxlc:Tile}}" />
                                <Image Grid.Column="1" Margin="1" Source="{StaticResource TileMaximizeSmall}" Height="16" Width="16" />
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Expander x:Name="ExpanderSettings" Header="{x:Static properties:Resources.RedundancySettings}" IsExpanded="True">
            <Grid Margin="2,5,2,15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="redundancySettingsContent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static properties:Resources.RedundancyStartupTimeout}" VerticalAlignment="Center" />
                            <wpfc:TimeSpanEdit x:Name="textEditStartupTimeout" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TimeSpan="{Binding RedundancyStartupTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                               Validation.ErrorTemplate="{x:Null}" 
                                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

                            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.RedundancySynchronizeTimeout}" VerticalAlignment="Center" />
                            <wpfc:TimeSpanEdit x:Name="textEditSynchronizeTimeout" Grid.Row="1" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TimeSpan="{Binding RedundancySynchronizeTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                               Validation.ErrorTemplate="{x:Null}" 
                                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

                            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.RedundancyTimeout}" VerticalAlignment="Center" />
                            <wpfc:TimeSpanEdit x:Name="textEditTimeout" Grid.Row="2" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TimeSpan="{Binding RedundancyTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                               Validation.ErrorTemplate="{x:Null}" 
                                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

                            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.RedundancyFullSynchronizationStartTime}" VerticalAlignment="Center" />
                            <wpfc:TimeSpanEdit x:Name="textEditFullSynchronizationStartTime" Grid.Row="3" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TimeSpan="{Binding RedundancyFullSynchronizationStartTime, Converter={StaticResource DateTimeToTimeSpanConverter}, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                               Mask="hh:mm:ss"
                                               Validation.ErrorTemplate="{x:Null}" 
                                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

                            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.RedundancyFullSynchronizationTimeSpan}" VerticalAlignment="Center" />
                            <wpfc:TimeSpanEdit x:Name="textEditFullSynchronizationTimeSpan" Grid.Row="4" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TimeSpan="{Binding RedundancyFullSynchronizationTimeSpan, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                               Validation.ErrorTemplate="{x:Null}" 
                                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

                            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.RedundancyPortNumber}" VerticalAlignment="Center" />
                            <dxe:SpinEdit x:Name="textEditPortNumber" Grid.Row="5" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left" AllowSpinOnMouseWheel="False" 
                                          MaskType="Numeric" Mask="d" 
                                          Value="{Binding RedundancyPortNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                          Validation.ErrorTemplate="{x:Null}" />

                            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.RedundancyKeepActiverServerActive}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="6" Grid.Column="1" Margin="5,0,0,0" x:Name="keepActive"
                                      IsChecked="{Binding RedundancyKeepActiveServerActive, ValidatesOnDataErrors=True}" 
                                      VerticalAlignment="Center" HorizontalAlignment="Left" Width="Auto" 
                                      Validation.ErrorTemplate="{x:Null}" />
                            <ContentPresenter Grid.Row="6" Grid.Column="2" 
                                              Content="{Binding ElementName=keepActive, Path=(Validation.Errors).CurrentItem}"/>

                            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.RedundancySkipHistoryDataSynchronization}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="7" Grid.Column="1" Margin="5,0,0,0" x:Name="skipHistoryData"
                                      IsChecked="{Binding RedundancySkipHistoryDataSynchronization}" 
                                      VerticalAlignment="Center" HorizontalAlignment="Left" Width="Auto" />
                        </Grid>
                    </ScrollViewer>
                
            </Grid>
        </Expander>
        <Expander x:Name="expanderServers" Grid.Row="1" Header="{x:Static properties:Resources.RedundancyServers}" IsExpanded="True">
            <Grid Margin="2,5,2,2">
                
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10*"/>
                            </Grid.RowDefinitions>
                            <dxe:TextEdit x:Name="txtName" Margin="4"/>
                            <ListBox Grid.Row="1" x:Name="listBox" Margin="4" />
                            <Grid Grid.Column="1" Grid.RowSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Click="redundancyServersAdd_Click" Margin="4">
                                    <Button.Content>
                                        <Image Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Click="redundancyServersRemove_Click" Grid.Row="1" Margin="4">
                                    <Button.Content>
                                        <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Click="redundancyServersMoveUp_Click" Grid.Row="2" Margin="4">
                                    <Button.Content>
                                        <Image Source="{StaticResource MoveUpSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Click="redundancyServersMoveDown_Click" Grid.Row="3" Margin="4">
                                    <Button.Content>
                                        <Image Source="{StaticResource MoveDownSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Click="redundancyServersClear_Click" Grid.Row="4" Margin="4">
                                    <Button.Content>
                                        <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
