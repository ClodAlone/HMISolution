<helpers:TreeViewEditorHelper x:Class="UFUAEditor.Controls.AlarmPrototypeList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFUAEditor" 
             xmlns:helpers="clr-namespace:UFUAEditor.Helpers"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:ufuamodel="clr-namespace:UFUAModel;assembly=UFUAModel"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             Width="500" Height="500"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
      <converters:CommandListConverter x:Key="CommandListConverter"/>
      <converters:TagPathConverter x:Key="TagPathConverter"/>
    </ResourceDictionary>
  </UserControl.Resources>

        <dxb:BarManager.DXContextMenu>
            <dxb:PopupMenu x:Name="contextMenu">
                <dxb:PopupMenu.Items>

                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewAlarmArea}" Content="{x:Static properties:UICommandResource.AddNewAlarmAreaText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewAlarmSource}" Content="{x:Static properties:UICommandResource.AddNewAlarmSourceText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewAlarmDefinition}" Content="{x:Static properties:UICommandResource.AddNewAlarmDefinitionText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewMessageDefinition}" Content="{x:Static properties:UICommandResource.AddNewMessageDefinitionText}"/>
                    <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AssignTag}" Content="{x:Static properties:UICommandResource.AssignTagText}"/>

                    <dxb:BarItemLinkSeparator />

                    <dxb:BarSubItem Content="{x:Static self:Properties.UICommandResource.EditMenuText}">
                        <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                        <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                        <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                        <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                        <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItem Command="Properties"  Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                    </dxb:BarSubItem>
                </dxb:PopupMenu.Items>
            </dxb:PopupMenu>
        </dxb:BarManager.DXContextMenu>

        <Grid x:Name="mainGrid">
        <dx:DXTabControl Grid.Row="0" Grid.Column="0" x:Name="tabAlarmPrototypesTabControl" Padding="0">
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Bottom" />
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="treeListTab" Header="{x:Static properties:Resources.Hierarchical}">
                <dxg:TreeListControl Name="treeListControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged">
                    <dxg:TreeListControl.Columns>
                        <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="ItemHeader" Header="{x:Static self:Properties.Resources.ASName}" />
                        <dxg:TreeListColumn x:Name="TagPathColumn" FilterPopupMode="Excel" Header="{x:Static self:Properties.Resources.Path}" />
                        <!-- Validate="OnTreeHeaderValidate" -->
                    </dxg:TreeListControl.Columns>
                    <dxg:TreeListControl.View>
                        <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                    ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                    AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                    ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                    IsSynchronizedWithCurrentItem="True" AllowDragDrop="True" 
                    NodeChanged="OnTreeNodeChanged" NodeExpanding="OnTreeNodeExpanding"
                    RowDoubleClick="OnRowDoubleClick" AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing" 
                    StartRecordDrag="TreeListControl_DragStart"
                    PreviewDragOver="treeListControl_PreviewDragOver" 
                    PreviewQueryContinueDrag="addressSpaceTree_PreviewQueryContinueDrag"
                    DropRecord="TreeListControl_DragEnd"
                    >
                            <!-- 
                    PreviewDragOver="treeListControl_PreviewDragOver" 
                    PreviewQueryContinueDrag="addressSpaceTree_PreviewQueryContinueDrag"
                    DropRecord="TreeListControl_DragEnd" PreviewDrop="treeListControl_PreviewDrop"
                    DragRecordOver="TreeListControl_DragRecordOver" HiddenEditor="OnHiddenEditor" 
                    StartRecordDrag="TreeListControl_DragStart" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"
                     -->
                            <dxg:TreeListView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                    <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                                </Style>
                            </dxg:TreeListView.RowStyle>
                            <dxg:TreeListView.CellStyle>
                                <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                  <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                                </Style>
                            </dxg:TreeListView.CellStyle>
                        </dxg:TreeListView>
                    </dxg:TreeListControl.View>
                    <dxg:TreeListControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:TreeListControl.CommandBindings>
                </dxg:TreeListControl>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="gridControlTab" Header="{x:Static properties:Resources.Flat}">
                <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
                    SelectedItemChanged="OnGridSelectedItemChanged"
                    AutoExpandAllGroups="True"
                    AutoGenerateColumns="AddNew"
                    Name="gridDataControl" 
                    MasterRowExpanded="OnMasterRowExpanded"
                    MasterRowCollapsed="OnMasterRowCollapsed"
                    AutoPopulateColumns="False" 
                    AllowDrop="True" 
                    AllowLiveDataShaping="False" 
                    dx:DXSerializer.SerializationID="gridDataControl" 
                    dx:DXSerializer.StoreLayoutMode="All" 
                    dxg:DataControlSerializationOptions.AddNewColumns="False" 
                    dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                    <dxg:GridControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:GridControl.CommandBindings>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn AllowEditing="True" AllowGrouping="True" FieldName="Name" Header="{x:Static properties:Resources.APName}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=SourcePath, Mode=OneWay}" FieldName="SourcePath" Header="{x:Static properties:Resources.APSourcePath}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=AlarmType, Mode=OneWay}" FieldName="AlarmType" Header="{x:Static properties:Resources.APType}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ConditionType, Mode=OneWay}" FieldName="ConditionType" Header="{x:Static properties:Resources.APCondition}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ActivationValue, Mode=OneWay}" FieldName="ActivationValue" Header="{x:Static properties:Resources.APValue}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=DeviationType, Mode=OneWay}" FieldName="DeviationType" Header="{x:Static properties:Resources.APDeviation}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=HighHighLimit, Mode=OneWay}" FieldName="HighHighLimit" Header="{x:Static properties:Resources.APHH}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=HighLimit, Mode=OneWay}" FieldName="HighLimit" Header="{x:Static properties:Resources.APH}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=LowLimit, Mode=OneWay}" FieldName="LowLimit" Header="{x:Static properties:Resources.APL}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=LowLowLimit, Mode=OneWay}" FieldName="LowLowLimit" Header="{x:Static properties:Resources.APLL}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=DelayTimeOn, Mode=OneWay}" FieldName="DelayTimeOn" Header="{x:Static properties:Resources.ADDelayOn}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=DelayTimeOff, Mode=OneWay}" FieldName="DelayTimeOff" Header="{x:Static properties:Resources.ADDelayOff}"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>

                        <dxg:TableView x:Name="tableView" AllowEditing="True"
                            ValidateCell="OnValidateCell" ItemsSourceErrorInfoShowMode="None"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Cell" 
                            EditorShowMode="MouseDownFocused"
                            RowDoubleClick="OnRowDoubleClick"
                            MultiSelectMode="Row">
                            <!--<dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                            <Setter Property="Background" Value="LightGray" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TableView.RowStyle>-->
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridControl.DetailDescriptor>
                        <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding UFUAAlarmThresholds}">
                            <dxg:DataControlDetailDescriptor.DataControl>
                                <dxg:GridControl x:Name="gridDetailsControl" AutoGenerateColumns="None" SelectedItemChanged="OnGridSelectedItemChanged">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" SortIndex="0" DisplayMemberBinding="{Binding Path=UFUATagAss[0].Name, Mode=OneWay}" Header="{x:Static properties:Resources.ASName}"/>
                                        <dxg:GridColumn AllowEditing="True" AllowGrouping="True" FieldName="AlarmText" Header="{x:Static properties:Resources.AlarmText}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" FieldName="ComposedAlarmText" Header="{x:Static properties:Resources.ComposedAlarmText}"/>
                                        <dxg:GridColumn AllowEditing="True" AllowGrouping="True" FieldName="AddTagDescription" Header="{x:Static properties:Resources.AddTagDescription}"/>
                                        <dxg:GridColumn AllowEditing="True" AllowGrouping="True" FieldName="Enabled" Header="{x:Static properties:Resources.ThresholdEnabled}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=EnableTag.StringRepresentationWithProject, Mode=OneWay}" Header="{x:Static properties:Resources.CREnabledThresholdTag}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ActivationValueTag.StringRepresentationWithProject, Mode=OneWay}" Header="{x:Static properties:Resources.CRActivationValueThresholdTag}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=HighLimitTag.StringRepresentationWithProject, Mode=OneWay}" Header="{x:Static properties:Resources.CRHighLimitThresholdTag}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=HighHighLimitTag.StringRepresentationWithProject, Mode=OneWay}" Header="{x:Static properties:Resources.CRHighHighLimitThresholdTag}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=LowLimitTag.StringRepresentationWithProject, Mode=OneWay}" Header="{x:Static properties:Resources.CRLowLimitThresholdTag}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=LowLowLimitTag.StringRepresentationWithProject, Mode=OneWay}" Header="{x:Static properties:Resources.CRLowLowLimitThresholdTag}"/>
                                        <dxg:GridColumn AllowEditing="True" AllowGrouping="True" FieldName="EnableQualityGood" Header="{x:Static properties:Resources.ALEnableQualityGood}">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType=ufuamodel:ThreeStateType}" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" FieldName="Beep" Header="{x:Static properties:Resources.ALBeep}">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{dxe:EnumItemsSource EnumType=ufuamodel:ThreeStateType}" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="True" AllowGrouping="True" FieldName="Expression" Header="{x:Static properties:Resources.AlarmThresholdExpression}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=CommandsOn, Mode=OneWay, Converter={StaticResource CommandListConverter}}" Header="{x:Static properties:Resources.UFUAAlarmThresholdCommandsOn}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=CommandsOff, Mode=OneWay, Converter={StaticResource CommandListConverter}}" Header="{x:Static properties:Resources.UFUAAlarmThresholdCommandsOff}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=CommandsAck, Mode=OneWay, Converter={StaticResource CommandListConverter}}" Header="{x:Static properties:Resources.UFUAAlarmThresholdCommandsAck}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=CommandsReset, Mode=OneWay, Converter={StaticResource CommandListConverter}}" Header="{x:Static properties:Resources.UFUAAlarmThresholdCommandsReset}"/>
                                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=CommandsDbClick, Mode=OneWay, Converter={StaticResource CommandListConverter}}" Header="{x:Static properties:Resources.UFUAAlarmThresholdCommandsDbClick}"/>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView HiddenEditor="OnHiddenEditor" ValidateCell="OnValidateCell" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxg:DataControlDetailDescriptor.DataControl>
                        </dxg:DataControlDetailDescriptor>
                    </dxg:GridControl.DetailDescriptor>
                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</helpers:TreeViewEditorHelper>
