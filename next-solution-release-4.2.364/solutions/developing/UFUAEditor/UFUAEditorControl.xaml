<UserControl x:Class="UFUAEditor.UFUAEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFUAEditor"
             xmlns:Controls="clr-namespace:UFUAEditor.Controls"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:tabhelper="clr-namespace:UFUAEditor.TabHelper"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    PreviewExecuted="OnCommandUndo"
                    CanExecute="CanCommandUndo" />

        <CommandBinding Command="ApplicationCommands.Redo"
                    PreviewExecuted="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportAddressSpace}" 
                    Executed="OnImportExportAddressSpace" 
                    CanExecute="CanImportExportAddressSpace" />
        
        <!--<CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewLocalTag}" 
                    Executed="OnAddNewTempTag" 
                    CanExecute="CanAddNewTempTag" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewLocalFolder}" 
                    Executed="OnAddNewTempFolder" 
                    CanExecute="CanAddNewTempFolder" />-->


      <!--<CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewGeneralTag}"
                  Executed="OnAddNewGeneralTag"
                  CanExecute="CanAddNewGeneralTag" />

      <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewGeneralFolder}"
                  Executed="OnAddNewGeneralFolder"
                  CanExecute="CanAddNewGeneralFolder" />-->
      
        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewTag}" 
                    Executed="OnAddNewTag" 
                    CanExecute="CanAddNewTag" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewMember}" 
                    Executed="OnAddNewTag" 
                    CanExecute="CanAddNewTag" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewFolder}" 
                    Executed="OnAddNewFolder" 
                    CanExecute="CanAddNewFolder" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewPrototype}" 
                    Executed="OnAddNewPrototype" 
                    CanExecute="CanAddNewPrototype" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportTags}" 
                    Executed="OnImportExportTags" 
                    CanExecute="CanImportExportTags" />

        
        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewView}" 
                    Executed="OnAddNewView" 
                    CanExecute="CanAddNewView" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssociateView}" 
                    Executed="OnAssociateView" 
                    CanExecute="CanAssociateView" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StartServer}" 
                    Executed="OnStartServer" 
                    CanExecute="CanStartServer" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StopServer}" 
                    Executed="OnStopServer" 
                    CanExecute="CanStopServer" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AttachDebugger}" 
                    Executed="OnAttachDebugger" 
                    CanExecute="CanAttachDebugger" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CertificateChecker}" 
                    Executed="OnCertificateChecker" 
                    CanExecute="CanCertificateChecker" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ServiceManager}" 
                    Executed="OnServiceManager" 
                    CanExecute="CanServiceManager" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewDriver}" 
                    Executed="OnAddDriver" 
                    CanExecute="CanAddNewDriver" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.OpenDriverSettings}" 
                    Executed="OnOpenDriverSettings" 
                    CanExecute="CanOpenDriverSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportTagsDriver}" 
                    Executed="OnImportTagsDriver" 
                    CanExecute="CanImportTagsDriver" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.MoveMemberUp}" 
                    Executed="OnMoveMemberUp" 
                    CanExecute="CanMoveMemberUp" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.MoveMemberDown}" 
                    Executed="OnMoveMemberDown" 
                    CanExecute="CanMoveMemberDown" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.SetMemberPosition}" 
                    Executed="OnSetMemberPosition" 
                    CanExecute="CanSetMemberPosition" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewEngineeringUnits}" 
                    Executed="OnAddNewEngineeringUnits" 
                    CanExecute="CanAddNewEngineeringUnits" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportEUnits}" 
                    Executed="OnImportExportEUnits" 
                    CanExecute="CanImportExportEUnits" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewHistoricalSettings}" 
                    Executed="OnAddNewHistoricalSettings" 
                    CanExecute="CanAddNewHistoricalSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssignHistoricalSettings}" 
                    Executed="OnAssignHistoricalSettings" 
                    CanExecute="CanAssignHistoricalSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ManteinanceHistoricalSettings}" 
                    Executed="OnManteinanceHistoricalSettings" 
                    CanExecute="CanManteinanceHistoricalSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewDataLoggerSettings}" 
                    Executed="OnAddNewDataLoggerSettings" 
                    CanExecute="CanAddNewDataLoggerSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssignTag}" 
                    Executed="OnAssignTag" 
                    CanExecute="CanAssignTag" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AggregateTables}" 
                    Executed="OnAggregateTables" 
                    CanExecute="CanAggregateTables" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewAlarmArea}" 
                    Executed="OnAddNewAlarmArea" 
                    CanExecute="CanAddNewAlarmArea" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewAlarmSource}" 
                    Executed="OnAddNewAlarmSource" 
                    CanExecute="CanAddNewAlarmSource" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewAlarmDefinition}" 
                    Executed="OnAddNewAlarmDefinition" 
                    CanExecute="CanAddNewAlarmDefinition" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewMessageDefinition}" 
                    Executed="OnAddNewMessageDefinition" 
                    CanExecute="CanAddNewMessageDefinition" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssignTag}" 
                    Executed="OnAssignTag" 
                    CanExecute="CanAssignTag" />


        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportPrototypes}" 
                    Executed="OnImportExportPrototypes" 
                    CanExecute="CanImportExportPrototypes" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportAlarms}" 
                    Executed="OnImportExportAlarms" 
                    CanExecute="CanImportExportAlarms" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportHistoricals}" 
                    Executed="OnImportExportHistoricals" 
                    CanExecute="CanImportExportHistoricals" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportExportDataloggers}" 
                    Executed="OnImportExportDataloggers" 
                    CanExecute="CanImportExportDataloggers" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AssignAlarmDefinition}" 
                    Executed="OnAssignAlarmDefinition" 
                    CanExecute="CanAssignAlarmDefinition" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddWholeStringId}" 
                    Executed="OnAddWholeStringId" 
                    CanExecute="CanAddWholeStringId" />

    </UserControl.CommandBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/UFUAServer.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HorizontalTile" TargetType="dxlc:Tile">
                <Setter Property="VerticalHeaderAlignment" Value="Top" />
                <Setter Property="HorizontalHeaderAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Padding="3,0,0,0" Text="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=dxlc:Tile}}" />
                                <Image Grid.Column="1" Margin="1" Source="{StaticResource TileMaximizeSmall}" Height="16" Width="16" />
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!--<self:MenuControlGeneral/>
        <self:MenuControlPrototypes/>
        <self:MenuControlHistoricals/>
        <self:MenuControlDrivers/>
        <self:MenuControlAlarms/>
        <self:MenuControlAddressSpace/>-->
        <dx:DXTabControl x:Name="tabControlExt">
            <dx:DXTabControl.View>
                <dx:TabControlMultiLineView />
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="tabAddressSpace" Tag="{x:Static tabhelper:ControlTabEnum.AddressSpace}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASAddressSpace}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.AddressSpaceHeader}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="addressSpaceGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabGeneralSettings" Tag="{x:Static tabhelper:ControlTabEnum.GeneralSettings}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASGeneralSettingsSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.GeneralSettings}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <dxb:BarManager.DXContextMenu>
                    <dxb:PopupMenu x:Name="contextMenu">
                        <dxb:PopupMenu.Items>

                            <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.StartServer}" Content="{x:Static properties:UICommandResource.StartServerText}"/>
                            <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.StopServer}" Content="{x:Static properties:UICommandResource.StopServerText}"/>
                            <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AttachDebugger}" Content="{x:Static properties:UICommandResource.AttachDebuggerText}"/>

                            <dxb:BarItemLinkSeparator />

                            <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CertificateChecker}" Content="{x:Static properties:UICommandResource.CertificateCheckerText}"/>
                            <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.ServiceManager}" Content="{x:Static properties:UICommandResource.ServiceManagerText}"/>
                        </dxb:PopupMenu.Items>
                    </dxb:PopupMenu>
                </dxb:BarManager.DXContextMenu>
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Expander x:Name="expanderSettings" Grid.Row="0" Header="{x:Static properties:Resources.Settings}" IsExpanded="True">
                        <Grid x:Name="Row1" VerticalAlignment="Top" Margin="2,15,2,10">
                            <!-- Settings Area-->
                            <Controls:NewConfigurationSettings x:Name="configurationSettings"/>
                        </Grid>
                    </Expander>
                    <Expander x:Name="expanderTransport" Grid.Row="1" Header="{x:Static properties:Resources.Transports}" IsExpanded="True" >
                        <Grid Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" x:Name="Row03" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Name="btnAddTr" Content="{x:Static properties:Resources.AddTransports}" Click="TransportAdd_Click" Height="50" />
                                <Button Grid.Column="1" Name="btnEditTr" Content="{x:Static properties:Resources.EditTransports}" Click="TransportEdit_Click" Height="50" />
                                <Button Grid.Column="2" Name="btnDelTr" Content="{x:Static properties:Resources.DeleteTransports}"  Click="TransportDelete_Click" Height="50" />
                            </Grid>
                            <Grid x:Name="Row3" Grid.Row="1" Margin="2,2,2,2">
                                <!-- Transports Area-->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                </Grid.RowDefinitions>
                                <dxg:GridControl Grid.Row="1" Name="TransportGrid" MouseDoubleClick="TransportEdit_Click" >
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="{x:Static properties:Resources.NameTransports}" FieldName="Path" Width="300"/>
                                        <dxg:GridColumn Header="{x:Static properties:Resources.EnabledTransports}" FieldName="Enabled" Width="100" ReadOnly="True" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView  VerticalScrollbarVisibility="Auto" HorizontalScrollbarVisibility="Auto" ShowGroupPanel="False" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </Grid>
                        </Grid>
                    </Expander>
                    <Expander x:Name="expanderStatus" Grid.Row="2" Header="{x:Static properties:Resources.Status}" IsExpanded="True">
                        <Grid x:Name="Row5" Margin="2,10,2,0">
                            <!-- Events Area-->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Auto"
                                        Name="Scroll">
                                <TextBlock Name="txtevent"/>
                            </ScrollViewer>
                        </Grid>
                    </Expander>
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabDrivers" Tag="{x:Static tabhelper:ControlTabEnum.Drivers}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASDriver}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.Drivers}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="driverGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabPrototypes" Tag="{x:Static tabhelper:ControlTabEnum.Prototypes}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASPrototypesSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.Prototypes}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="prototypeGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabViews" Tag="{x:Static tabhelper:ControlTabEnum.Views}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASViewsSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.Views}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="viewGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabHistoricalPrototypes" Tag="{x:Static tabhelper:ControlTabEnum.Historicals}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASHistoricalPrototypesSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.HistoricalRibbonTitle}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="historicalPrototypeGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabDataLoggerSettings" Tag="{x:Static tabhelper:ControlTabEnum.DataLoggers}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASDataLoggerSettingsSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.DataLoggerSettings}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="dataLoggerSettingsGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabAlarmPrototypes" Tag="{x:Static tabhelper:ControlTabEnum.Alarms}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASAlarmPrototypeSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.AlarmRibbonTitle}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="alarmPrototypeGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabEngineeringUnitPrototypes" Tag="{x:Static tabhelper:ControlTabEnum.EngineeringUnits}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASEngineeringUnitSmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.EngineeringUnitPrototypes}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="engineeringUnitPrototypeGrid" />
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="tabRedundancy" Tag="{x:Static tabhelper:ControlTabEnum.Redundancy}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASRedundancySmall}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.Redundancy}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="redundancyGrid" />
            </dx:DXTabItem>
            <!--<dx:DXTabItem x:Name="tabTempVariables" Tag="{x:Static tabhelper:ControlTabEnum.TempVariables}">
                <dx:DXTabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource UFUASAddressSpace}" Height="16" Width="16" Margin="2"/>
                        <TextBlock Text="{x:Static properties:Resources.TempVariables}" Margin="2"/>
                    </StackPanel>
                </dx:DXTabItem.Header>
                <Grid x:Name="tempVariablesGrid" />
            </dx:DXTabItem>-->
        </dx:DXTabControl>
    </Grid>
</UserControl>
