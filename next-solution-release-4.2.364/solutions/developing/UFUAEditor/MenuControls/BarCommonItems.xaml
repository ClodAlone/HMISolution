<dxb:BarSubItem
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="UFUAEditor.MenuControls.BarCommonItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFUAEditor.MenuControls"
             xmlns:self="clr-namespace:UFUAEditor"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/UFUAServer.xaml" />
        <!--<ResourceDictionary Source="/SharedResources;component/Resources/Recipe.xaml" />-->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewIOServer" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="40" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="40" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                Command="{x:Static self:UIGeneralCommands.ShowToolbar}" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectIOServer" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="130" x:Name="biServer" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems">

            <dxb:BarSubItem MergeOrder="10" x:Name="biServerTags" Content="{x:Static properties:Resources.TagHeaderTitle}" MergeType="MergeItems">
                <dxb:BarButtonItem x:Name="biAddFolder" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource OpenFolder}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewFolder}" />
                <dxb:BarButtonItem x:Name="biAddTag"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASVariable}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewTag}" />
                <!--<dxb:BarButtonItem x:Name="biAddPrototype"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAddPrototypesList}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewPrototype}" />-->
                <!--<dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem  x:Name="biAddFolderLocal" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource OpenFolder}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewLocalFolder}" />
                <dxb:BarButtonItem x:Name="biAddTagLocal"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASVariable}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewLocalTag}" />-->
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem  x:Name="biAddNewDataLoggerColumn" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                    Glyph="{StaticResource UFUASAddDataLoggerColumn}"  
                    Command="{x:Static self:UIGeneralCommands.AssignTag}" />
            </dxb:BarSubItem>

            <dxb:BarSubItem MergeOrder="20" x:Name="biServerPrototypes" Content="{x:Static properties:Resources.PrototypeRibbonTitle}" MergeType="MergeItems">
                <dxb:BarButtonItem   x:Name="biAddNewPrototype" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAddPrototypesList}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewPrototype}" />
                <dxb:BarButtonItem  x:Name="biAddNewFolder"  Content="{x:Static properties:UICommandResource.AddNewPrototypeFolderText}"
                             Glyph="{StaticResource OpenFolder}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewFolder}" />
                <dxb:BarButtonItem x:Name="biAddNewMember"   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASVariableMember}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewMember}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem x:Name="biMoveMemberUp"   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASMoveMemberUp}"  
                             Command="{x:Static self:UIGeneralCommands.MoveMemberUp}" />
                <dxb:BarButtonItem  x:Name="biMoveMemberDown"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASMoveMemberDown}"
                             Command="{x:Static self:UIGeneralCommands.MoveMemberDown}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem  x:Name="biSetMemberPosition"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASSetMemberPosition}"  
                             Command="{x:Static self:UIGeneralCommands.SetMemberPosition}" />
            </dxb:BarSubItem>

            <dxb:BarButtonItem MergeOrder="30" x:Name="biAddEUnit" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASEngineeringUnit}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewEngineeringUnits}" />

            <dxb:BarSubItem MergeOrder="40" x:Name="biServerView" Content="{x:Static properties:Resources.ViewRibbonHeader}" MergeType="MergeItems">
                <dxb:BarButtonItem  x:Name="biAddView" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASView}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewView}" />
                <dxb:BarButtonItem x:Name="biAssociateView" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAssignView}"  
                             Command="{x:Static self:UIGeneralCommands.AssociateView}" />
            </dxb:BarSubItem>

            <dxb:BarSubItem MergeOrder="50" x:Name="biServerAlarms" Content="{x:Static properties:Resources.AlarmRibbonTitle}" MergeType="MergeItems">
                <dxb:BarButtonItem x:Name="biAlarmArea"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAlarmArea}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewAlarmArea}" />
                <dxb:BarButtonItem x:Name="biAlarmSource"   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAlarmSource}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewAlarmSource}" />
                <dxb:BarButtonItem x:Name="biAlarmPrototype"   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAlarmPrototype}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewAlarmDefinition}" />
                <dxb:BarButtonItem x:Name="biMessagePrototype"   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASMessagePrototypeSmall}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewMessageDefinition}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem x:Name="biAssignAlarmDefinition"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAssignAlarmDef}"  
                             Command="{x:Static self:UIGeneralCommands.AssignAlarmDefinition}" />
                <dxb:BarButtonItem x:Name="biRemoveAlarmDefinitions"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASRemoveAlarmDef}"  
                             Command="{x:Static self:UIGeneralCommands.RemoveAlarmDefinitions}" />
            </dxb:BarSubItem>

            <dxb:BarSubItem MergeOrder="60" x:Name="biServerHistoricals" Content="{x:Static properties:Resources.HistoricalRibbonTitle}" MergeType="MergeItems">
                <dxb:BarButtonItem  x:Name="biAddNewHistoricalSettings" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASHistoricalPrototypes}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewHistoricalSettings}" />
                <!--<dxb:BarButtonItem x:Name="biManteinanceHistoricalSettings"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASEditHistoricalPrototypes}"  
                             Command="{x:Static self:UIGeneralCommands.ManteinanceHistoricalSettings}" />-->
                <dxb:BarButtonItem x:Name="biAssignHistoricalSettings" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAssignHistoricalPrototypes}"  
                             Command="{x:Static self:UIGeneralCommands.AssignHistoricalSettings}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem  x:Name="biAddNewDataLoggerSettings" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAddDataLoggerSettings}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewDataLoggerSettings}" />
                <dxb:BarButtonItem x:Name="biAggregateTables"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAggregateTables}"  
                             Command="{x:Static self:UIGeneralCommands.AggregateTables}" />
            </dxb:BarSubItem>

            <dxb:BarSubItem MergeOrder="70" x:Name="biServerServer" Content="{x:Static properties:Resources.ServerRibbonHeader}" MergeType="MergeItems">
                <dxb:BarButtonItem  x:Name="biStartServer" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASServerStarted}"  
                             Command="{x:Static self:UIGeneralCommands.StartServer}" />
                <dxb:BarButtonItem x:Name="biStopServer"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASServerStopped}"  
                             Command="{x:Static self:UIGeneralCommands.StopServer}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem x:Name="biAttachDebugger"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASAttachDebugger}"  
                             Command="{x:Static self:UIGeneralCommands.AttachDebugger}" />
              <dxb:BarButtonItem x:Name="biCertificateChecker"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                   Glyph="{StaticResource UFUASCertificate}"
                                   Command="{x:Static self:UIGeneralCommands.CertificateChecker}" />
            </dxb:BarSubItem>

            <!--<dxb:BarItemLinkSeparator MergeOrder="75" />-->

            <dxb:BarSubItem MergeOrder="80" Content="{x:Static properties:Resources.DriversRibbonTitle}" MergeType="MergeItems">
                <dxb:BarButtonItem x:Name="biAddNewDriver" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASDriver}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewDriver}" />

                <dxb:BarButtonItem x:Name="biOpenDriverSettings"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASEditDriver}"  
                             Command="{x:Static self:UIGeneralCommands.OpenDriverSettings}" />
            </dxb:BarSubItem>

            <dxb:BarButtonItem x:Name="biServiceManager" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource UFUASServiceManager}"  
                             Command="{x:Static self:UIGeneralCommands.ServiceManager}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biToolsIOServer" Content="{x:Static translatableMenu:Resources.ToolsHeaderTitle}">
        <dxb:BarButtonItem MergeOrder="10" x:Name="biImportExport"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource CSVSmall}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportTags}" />
        <dxb:BarButtonItem MergeOrder="20" x:Name="biImportExportPrototypes"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource CSVSmall}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportPrototypes}" />
        <dxb:BarButtonItem MergeOrder="30" x:Name="biImportExportEU" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource CSVSmall}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportEUnits}" />
        <dxb:BarButtonItem MergeOrder="40" x:Name="biImportExportAlarms"   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource CSVSmall}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportAlarms}" />
        <dxb:BarButtonItem MergeOrder="50" x:Name="biImportExportHistoricals" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource CSVSmall}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportHistoricals}" />
        <dxb:BarButtonItem MergeOrder="60" x:Name="biImportExportDataloggers" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource CSVSmall}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportDataloggers}" />
        <dxb:BarItemLinkSeparator MergeOrder="85" />
        <dxb:BarButtonItem MergeOrder="90" x:Name="biImportExportAddressSpace" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASImportExportUANodeSet}"  
                             Command="{x:Static self:UIGeneralCommands.ImportExportAddressSpace}" />
        <dxb:BarItemLinkSeparator MergeOrder="95"/>
        <dxb:BarButtonItem MergeOrder="100" x:Name="biImportTagsDrivers"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UFUASImport}"  
                             Command="{x:Static self:UIGeneralCommands.ImportTagsDriver}" />
        <dxb:BarItemLinkSeparator MergeOrder="105"/>
    </dxb:BarSubItem>
</dxb:BarSubItem>
