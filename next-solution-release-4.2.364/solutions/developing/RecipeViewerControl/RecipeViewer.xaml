<UserControl x:Class="RecipeViewerControl.RecipeViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:RecipeViewerControl.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/GlassButton.xaml"/>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/RecipeViewerControl.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="view">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
            <ContentControl Name="recipeLayout" />
        </ScrollViewer>

        <cc:CircularProgressBar x:Name="uriLoading" Background="Black" Opacity="0.5" Visibility="Collapsed" />
        <TextBlock Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding Visibility, ElementName=uriLoading}"
                   FontFamily="Segoe UI" FontWeight="Light" Margin="5,0,0,0" Foreground="White" FontSize="16" />
        <Border BorderThickness="1" BorderBrush="Gray" Background="{x:Null}" Visibility="{Binding Visibility, ElementName=uriLoading}" />
        
        <Border x:Name="uriError" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  BorderThickness="1" BorderBrush="#FFA9A9A9"  Visibility="Collapsed">
            <Grid  VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <Image Source="{DynamicResource Diamond}" Width="16" Height="16" Margin="2,2,2,2" />
                    <TextBlock x:Name="txtUriError" Margin="5,0,0,0" Text="{x:Static properties:Resources.EmptyRecipeUri}" VerticalAlignment="Center"
                TextWrapping="Wrap" FontFamily="Segoe UI" FontWeight="Light" HorizontalAlignment="Left" Foreground="White" FontSize="16" />
                </DockPanel>
                <Button Grid.Row="1" x:Name="uriRefresh" Visibility="Collapsed"
                      VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,5,0,0"
                      Click="RefreshLayout_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource RVCRefresh}" Width="32" Height="32"/>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>

        <ToggleButton Content="•" HorizontalAlignment="Right" VerticalAlignment="Top" x:Name="btnShow" Visibility="Hidden" />

        <Popup IsOpen="{Binding ElementName=btnShow, Path=IsChecked}"
                PlacementTarget="{Binding ElementName=btnShow}" 
                StaysOpen="False"
                Placement="Bottom" ClipToBounds="False"
                AllowsTransparency="True"
                PopupAnimation="Slide" >

            <StackPanel Background="{x:Null}" VerticalAlignment="Center" ClipToBounds="False"
                        HorizontalAlignment="Right" x:Name="panelButtons" Margin="10,10,10,10">

                <ToggleButton x:Name="btnEditLayout" Margin="2,2,2,2" ToolTip="{x:Static properties:Resources.EditLayoutTooltip}"
                                Click="EditLayout_Click"
                                VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <ToggleButton.Content>
                        <Image Width="32" Height="32" Source="{DynamicResource RVCEditLayout}" />
                    </ToggleButton.Content>
                    <ToggleButton.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                    </ToggleButton.Effect>

                </ToggleButton>

                <Button x:Name="btnRejectChanges" Margin="2,2,2,2" ToolTip="{x:Static properties:Resources.RejectLayoutTooltip}"
                        Click="RejectChanges_Click"
                        VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <Button.Content>
                        <Image Width="32" Height="32" Source="{DynamicResource RVCRejectChanges}" />
                    </Button.Content>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                    </Button.Effect>

                </Button>

                <Button x:Name="btnRestoreLayout" Margin="2,2,2,2" ToolTip="{x:Static properties:Resources.RestoreLayoutTooltip}"
                        Click="RestoreLayout_Click"
                        VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <Button.Content>
                        <Image Width="32" Height="32" Source="{DynamicResource RVCRestoreDefault}" />
                    </Button.Content>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                    </Button.Effect>

                </Button>
            </StackPanel>
        </Popup>
            
    </Grid>
 </UserControl>
