<UserControl x:Class="RecipeViewerControl.RecipeGrid" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:local="clr-namespace:RecipeViewerControl.ViewModel"
             xmlns:self="clr-namespace:RecipeViewerControl.Converters"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:properties="clr-namespace:RecipeViewerControl.Properties"
             xmlns:layoutcontrols="clr-namespace:UFRecipeLayout.LayoutItemControls;assembly=UFRecipeLayout"
             xmlns:layoutproperties="clr-namespace:UFRecipeLayout.Properties;assembly=UFRecipeLayout"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             PreviewKeyDown="RecipeGrid_PreviewKeyDown"
             mc:Ignorable="d" Height="450" Width="800"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/UFRecipeLayout.xaml" />
            </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />

            <local:RecipeGridEditorTemplateSelector x:Key="cellTemplateSelector">
                <local:RecipeGridEditorTemplateSelector.ContentControlTemplate>
                    <DataTemplate>
                        <ContentControl x:Name="PART_Editor" />
                    </DataTemplate>
                </local:RecipeGridEditorTemplateSelector.ContentControlTemplate>
            </local:RecipeGridEditorTemplateSelector>

            <converters:MultiVisibilityToInvertionBooleanConverter x:Key="MultiVisibilityToInvertionBooleanConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertionVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <self:BooleanToGroupIndexConverter x:Key="BooleanToGroupIndexConverter" />
            <self:StringValueConverter x:Key="StringValueConverter" />
            <self:ConditionalStyleConverter x:Key="ConditionalStyleConverter" />
            <self:BooleanToGridColumnWidthConverter x:Key="BooleanToGridColumnWidthConverter" />

            <local:RecipeGridViewModel x:Key="vm"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" x:Name="thisControl" DataContext="{StaticResource vm}" DataContextChanged="OnDataContextChanged">
        <Grid MinHeight="40" DockPanel.Dock="Bottom">
            <Grid.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiVisibilityToInvertionBooleanConverter}">
                    <Binding ElementName="newRecipeWindow" Path="Visibility" />
                    <Binding ElementName="lastErrorWindow" Path="Visibility" />
                </MultiBinding>
            </Grid.IsEnabled>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ShowReloadButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowSaveButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowAddButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowRemoveButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowImportButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowExportButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowReadButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
                <ColumnDefinition Width="{Binding ShowWriteButton, 
                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                    Converter={StaticResource BooleanToGridColumnWidthConverter}}" />
            </Grid.ColumnDefinitions>

            <Button x:Name="reloadButton" Visibility="{Binding ShowReloadButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeReloadCommandToolTip}"
                    Command="{Binding ReloadCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                <StackPanel>
                    <TextBlock x:Name="reloadBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeReloadCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32"
                           Source="{DynamicResource UFRLReload}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="saveButton" Visibility="{Binding ShowSaveButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeSaveCommandToolTip}"
                    Command="{Binding SaveCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="1">
                <StackPanel>
                    <TextBlock x:Name="saveBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeSaveCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32"
                           Source="{DynamicResource UFRLSave}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="newButton" Visibility="{Binding ShowAddButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeNewCommandToolTip}"
                    Command="{Binding AddCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="2">
                <StackPanel>
                    <TextBlock x:Name="newBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeNewCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32"
                           Source="{DynamicResource UFRLAdd}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="removeButton" Visibility="{Binding ShowRemoveButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeRemoveCommandToolTip}"
                    Command="{Binding RemoveCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="3">
                <StackPanel>
                    <TextBlock x:Name="removeBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeRemoveCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32"
                           Source="{DynamicResource UFRLRemove}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="importButton" Visibility="{Binding ShowImportButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeImportCommandTooltip}"
                    Command="{Binding ImportCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="4">
                <StackPanel>
                    <TextBlock x:Name="importBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeImportCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32"
                           Source="{DynamicResource UFRLImport}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="exportButton" Visibility="{Binding ShowExportButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeExportCommandTooltip}"
                    Command="{Binding ExportCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="5">
                <StackPanel>
                    <TextBlock x:Name="exportBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeExportCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32"
                           Source="{DynamicResource UFRLExport}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="readButton"
                    Visibility="{Binding ShowReadButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeReadCommandToolTip}"
                    Command="{Binding ReadCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="6">
                <StackPanel>
                    <TextBlock x:Name="readBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeReadCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32" x:Name="readBtnImage"
                           Source="{DynamicResource UFRLRead}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
            <Button x:Name="writeButton"
                    Visibility="{Binding ShowWriteButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                    ToolTip="{x:Static layoutproperties:Resources.LayoutRecipeWriteCommandToolTip}"
                    Command="{Binding WriteCommand, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="7">
                <StackPanel>
                    <TextBlock x:Name="writeBtnText"
                               Text="{x:Static layoutproperties:Resources.LayoutRecipeWriteCommand}" 
                               Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    <Image Width="32" Height="32" x:Name="writeBtnImage"
                           Source="{DynamicResource UFRLWrite}"
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    </Image>
                </StackPanel>
            </Button>
        </Grid>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.IsEnabled>
                    <MultiBinding Converter="{StaticResource MultiVisibilityToInvertionBooleanConverter}">
                        <Binding ElementName="newRecipeWindow" Path="Visibility" />
                        <Binding ElementName="lastErrorWindow" Path="Visibility" />
                    </MultiBinding>
                </Grid.IsEnabled>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="recipeNameLabel" Text="{x:Static properties:Resources.RecipeNameLabel}" IsReadOnly="True" IsHitTestVisible="False" />
                <layoutcontrols:ItemControlRecipeIndex x:Name="recipeIndexUI" Grid.Column="1" ShowUnsavedMarker="False"
                                                       RecipeSelectionChanged="RecipeIndexUI_RecipeSelectionChanged" 
                                                       RecipeTextChanged="RecipeIndexUI_RecipeTextChanged"
                                                       IsEnabled="{Binding DataContext.IsReady, Mode=OneWay, ElementName=thisControl}"
                                                       DataContext="{Binding DataContext.DataSet, ElementName=thisControl}"
                                                       RunningOnServer="{Binding RunningOnServer, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Grid>
            <dxg:GridControl x:Name="gridControl" MinHeight="10" MinWidth="10" Grid.Row="1" 
                             SelectionMode="Cell" AllowLiveDataShaping="False" ShowBorder="False" 
                             dx:DXSerializer.SerializationID="gridControl" 
                             dx:DXSerializer.StoreLayoutMode="All" 
                             dxg:DataControlSerializationOptions.AddNewColumns="False" 
    		                 dxg:DataControlSerializationOptions.RemoveOldColumns="False"
                             ItemsSource="{Binding DataValues}">
                <dxg:GridControl.Resources>
                    <Style TargetType="dxg:GridColumnHeader">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HeaderBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                <Setter Property="Background" Value="{Binding HeaderBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxg:GridControl.Resources>
                <dxg:GridControl.IsEnabled>
                        <MultiBinding Converter="{StaticResource MultiVisibilityToInvertionBooleanConverter}">
                            <Binding ElementName="newRecipeWindow" Path="Visibility" />
                            <Binding ElementName="lastErrorWindow" Path="Visibility" />
                        </MultiBinding>
                </dxg:GridControl.IsEnabled>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn MinWidth="10" AllowEditing="False" FieldName="GroupName" Header="{x:Static properties:Resources.GroupColumnName}" 
                                    GroupIndex="{Binding GroupByName, Mode=OneWay, Converter={StaticResource BooleanToGroupIndexConverter}, ConverterParameter=0, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="2,0" TextWrapping="WrapWithOverflow"
                                               Text="{Binding Data.GroupName, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringValueConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn MinWidth="10" AllowEditing="False" FieldName="Name" Header="{x:Static properties:Resources.ItemColumnName}" >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="2,0" TextWrapping="WrapWithOverflow"
                                               Text="{Binding Data.Name, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringValueConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>

                    <dxg:GridColumn MinWidth="10" AllowEditing="True" FieldName="Value" Header="{x:Static properties:Resources.ValueColumnName}"
                                    CellTemplateSelector="{StaticResource cellTemplateSelector}" />
                    <dxg:GridColumn MinWidth="10" AllowEditing="False" FieldName="Description" Header="{x:Static properties:Resources.DescriptionColumnName}" >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="2,0" TextWrapping="WrapWithOverflow"
                                               Text="{Binding Data.Description, Converter={StaticResource StringValueConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView" 
                                   IsColumnMenuEnabled="False" IsGroupPanelMenuEnabled="False" IsRowCellMenuEnabled="False"
                                   ShowGroupPanel="False" ShowGroupedColumns="false" AllowGrouping="False"
                                   ShowSearchPanelMode="Always" SearchPanelFindMode="Always" ShowSearchPanelMRUButton="True"
                                   AllowColumnMoving="True" AllowColumnFiltering="false" AllowEditing="True" AllowResizing="True">
                        <dxg:TableView.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="Resources\CellStyles.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </dxg:TableView.Resources>
                        <dxg:TableView.ColumnHeaderContentStyle>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeaderForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding HeaderForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </Style>
                        </dxg:TableView.ColumnHeaderContentStyle>
                        <dxg:TableView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="TextBlock.Foreground" Value="{Binding RowAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CellBorderColor, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{Binding CellBorderColor, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                    <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                        <Setter Property="Background" Value="{Binding FocusedRowBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        <Setter Property="Foreground" Value="{Binding FocusedRowForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </Trigger>
                                </Style.Triggers>
                                <Setter Property="TextBlock.FontFamily" Value="{Binding RowAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontSize" Value="{Binding RowAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontWeight" Value="{Binding RowAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontStyle" Value="{Binding RowAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </Style>
                        </dxg:TableView.RowStyle>
                        <dxg:TableView.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowMinHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="MinHeight" Value="{Binding RowMinHeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CellBorderColor, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{Binding CellBorderColor, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=(dxg:GridViewBase.IsFocusedCell), RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding FocusedCellBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Background" Value="{Binding FocusedCellBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=(dxg:GridViewBase.IsFocusedCell), RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding FocusedCellForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Foreground" Value="{Binding FocusedCellForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                              <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                            </Style>
                        </dxg:TableView.CellStyle>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <Border x:Name="newRecipeWindow" HorizontalAlignment="Center" VerticalAlignment="Center" 
                BorderThickness="1" BorderBrush="Gray" Background="Black" Visibility="Collapsed" Grid.Row="1">
                <Grid Margin="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=gridControl, Mode=OneWay}" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="newRecipeWindowTitle" 
                               Margin="2" Text="{x:Static layoutproperties:Resources.EnterNewRecipeNameWindowTitle}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" />
                    <Button Grid.Column="1" HorizontalAlignment="Right" Click="newRecipe_Ok" >
                        <Button.Content>
                            <Image Source="{DynamicResource OkSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="2" HorizontalAlignment="Right" Click="newRecipe_Cancel" >
                        <Button.Content>
                            <Image Source="{DynamicResource CancelSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <ContentControl x:Name="newRecipeControl" Grid.Row="1" />
                </Grid>
            </Border>
            <Border x:Name="lastErrorWindow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    BorderThickness="1" Background="Black" Opacity="0.5" Grid.RowSpan="2"
                    Visibility="{Binding LastError, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <Image Source="{DynamicResource Diamond}" Width="16" Height="16" Margin="2,2,2,2" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="lastErrorText"
                               Text="{Binding LastError}" TextWrapping="Wrap" FontFamily="Segoe UI" FontWeight="Light" FontSize="16" />
                    <Button Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="lastError_Ok" >
                        <Button.Content>
                            <Image Source="{DynamicResource OkSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                </DockPanel>
            </Border>
            <Grid x:Name="busyControl" Grid.RowSpan="2"
                Visibility="{Binding IsBusy, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                <cc:CircularProgressBar Background="Black" Opacity="0.5" />
                <TextBlock Text="{Binding WaitText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextWrapping="Wrap" FontFamily="Segoe UI" FontWeight="Light" Margin="5,0,0,0" Foreground="White" FontSize="16" />
                <Border BorderThickness="1" BorderBrush="Gray" Background="{x:Null}"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
