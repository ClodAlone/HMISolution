<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="Log4NetViewer.Log4NetViewer"
             xmlns:properties="clr-namespace:Log4NetViewer.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:local="clr-namespace:Log4NetViewer.Converters"
             xmlns:controls="clr-namespace:Log4NetViewer"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <remoteconverters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <dxe:TextEditSettings x:Key="dateSettings" MaskType="DateTime" Mask="G" />
            <local:ColorValueConverter x:Key="ColorValueConverter" />
            <Style TargetType="{x:Type Button}" x:Key="ButtonRowCommandStyle">
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <DataTemplate x:Key="cellDefaultTemplate">
                <Grid x:Name="grid"  Background="{Binding Data.Level, Converter={StaticResource ColorValueConverter}}"
                  HorizontalAlignment="Stretch">
                    <dxe:TextEdit x:Name="PART_Editor" Grid.Row="1"
                         VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                         Foreground="White" Background="Transparent"
                         Margin="2,2,2,2"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="cellTemplate">
            <Grid x:Name="grid"  Background="{Binding Data.Level, Converter={StaticResource ColorValueConverter}}"
                  HorizontalAlignment="Stretch">
              <dxe:TextEdit x:Name="PART_Editor" Grid.Row="1"
                         VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                         Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                         Background="Transparent"
                         Margin="2,2,2,2"/>
            </Grid>
          </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <dxb:BarContainerControl ContainerType="Top"  DockPanel.Dock="Top" x:Name="toolbar">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False">
              <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                    <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  UseLightweightTemplates="False" EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                                <dxe:ComboBoxEdit
                                  Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" 
                                        IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>
                    <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall"  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"/>
                    <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmall" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}"/>
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}"/>
                </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem Content="{x:Static properties:Resources.PathExpl}" x:Name="txtExpl" ItemClick="Click_OpenLogFile" ToolTipService.ShowOnDisabled="True" IsVisible="{Binding IsExternalWpfApp, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
              <dxb:BarStaticItem ShowBorder="False" x:Name="fileLogTitle" Content="{x:Static properties:Resources.Path}" IsVisible="{Binding IsExternalWpfApp, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                <dxb:BarEditItem x:Name="fileLog" Content="{x:Static properties:Resources.Path}" IsVisible="{Binding IsExternalWpfApp, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                    UseLightweightTemplates="False"     EditValueChanged="fileLog_SelectionChanged">
                  <dxb:BarEditItem.EditTemplate>
                    <DataTemplate>
                            <dxe:ComboBoxEdit
                                  Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                      Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" 
                                      IsTextEditable="False" />
                    </DataTemplate>
                  </dxb:BarEditItem.EditTemplate>
                </dxb:BarEditItem>
                <dxb:BarButtonItem Glyph="{DynamicResource RefreshSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="refreshButton" ToolTipService.ShowOnDisabled="True" ItemClick=" ButtonBase_OnClick"/>
                <dxb:BarButtonItem Glyph="{DynamicResource AddNewSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="forceNewLog" ToolTipService.ShowOnDisabled="True" ItemClick="Click_forceNewLog" ToolTip="{x:Static properties:Resources.ForceNewLog}" IsVisible="{Binding IsExternalWpfApp, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                <dxb:BarItemSeparator />
              <dxb:BarStaticItem ShowBorder="False" x:Name="cmbLoggerFilterTitle" Content="{x:Static properties:Resources.Loggers}"/>
                <dxb:BarEditItem x:Name="cmbLoggerFilter" Content="{x:Static properties:Resources.Loggers}"
                    UseLightweightTemplates="False" EditValueChanged="cmbLoggerFilter_SelectionChanged">
                  <dxb:BarEditItem.EditTemplate>
                    <DataTemplate>
                            <dxe:ComboBoxEdit
                                  Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                      Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}"
                                      IsTextEditable="False" />
                    </DataTemplate>
                  </dxb:BarEditItem.EditTemplate>
                </dxb:BarEditItem>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="{x:Static properties:Resources.BestFit}" x:Name="bestFit" ItemClick="Click_BestFit"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Content="{x:Static properties:Resources.SelectLast}" x:Name="selectLast" ItemClick="Click_SelectLast" />
                <dxb:BarButtonItem Content="{x:Static properties:Resources.SelectFirst}" x:Name="selectFirst" ItemClick="Click_SelectFirst"/>
                <dxb:BarButtonItem Content="{x:Static properties:Resources.SelectAll}" x:Name="selectAll" ItemClick="Click_SelectAll"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <Grid PreviewKeyDown="Control_PreviewKeyDown" x:Name="borderTop">
            <!-- List View -->
            <dxg:GridControl AllowDrop="False"  PreviewKeyDown="Control_PreviewKeyDown" 
                             AllowLiveDataShaping="False"
                             MinHeight="40" MinWidth="20" Name="gridControl">
                <dxg:GridControl.Resources>
                    <Style TargetType="{x:Type dxg:BaseGridHeader}"/>
                    <Style x:Key="columnStyle" BasedOn="{StaticResource {x:Type dxg:BaseGridHeader}}" TargetType="{x:Type dxg:BaseGridHeader}">
                        <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    </Style>
                </dxg:GridControl.Resources>
                <dxg:GridControl.View>
                    <dxg:TableView AllowFilterEditor="True" AllowEditing="False" 
                                   AllowBestFit="True" BestFitMaxRowCount="15" 
                                   BestFitArea="All" 
                                   BestFitMode="DistinctValues"  PreviewKeyDown="Control_PreviewKeyDown"
                                   HorizontalScrollbarVisibility="Auto"
                                   VerticalScrollbarVisibility="Auto"
                                   AutoWidth="False" 
                                   AutoMoveRowFocus="True"
                                   AllowResizing="True" 
                                   ShowGroupPanel="False"
                                   ShowSearchPanelMode="Always" SearchPanelFindMode="Always" ShowSearchPanelMRUButton="True"
                                   ShowFilterPanelMode="ShowAlways"
                                   NavigationStyle="Cell" 
                                   MultiSelectMode="Cell" 
                                   AllowMoveColumnToDropArea="True" 
                                   x:Name="tableView" ShowTotalSummary="False" 
                                   ShowSearchPanelFindButton="True" ShowSearchPanelCloseButton="True">
                        <dxg:TableView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <!--<Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                        <Setter Property="Background" Value="Gray" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsSelected}" Value="False">-->
                              <!--<Setter Property="Background" Value="{Binding Path=DataContext.Level, Converter={StaticResource ColorValueConverter}}" />
                                  <Setter Property="Foreground" Value="White" />-->
                              <!--</DataTrigger>
                                </Style.Triggers>
                                <Style.Triggers>
                                    <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush EndPoint="0.5,-0.002" 
                                                 StartPoint="0.5,1.002">
                                                    <GradientStop Color="#454444" Offset="0"/>
                                                    <GradientStop Color="#FFE0DEDE" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="TextBlock.Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>-->
                            </Style>
                        </dxg:TableView.RowStyle>
                    </dxg:TableView>

                </dxg:GridControl.View>
            </dxg:GridControl>
            <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="13" Grid.RowSpan="13"/>
            <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center"  Grid.ColumnSpan="13" Grid.RowSpan="13"
    		HorizontalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
