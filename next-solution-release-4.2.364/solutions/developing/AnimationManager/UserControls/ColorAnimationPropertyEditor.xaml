<UserControl x:Class="AnimationManager.UserControls.ColorAnimationPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:AnimationManager.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             Height="300" Width="300" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <ContentControl Grid.Column="0" x:Name="content">
        </ContentControl>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
        
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <dxg:GridControl Name="gridControl">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=Value, Mode=TwoWay}" Header="{x:Static properties:Resources.ValueColumnHeader}" x:Name="valueCol"/>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=Color, Mode=TwoWay}" Header="{x:Static properties:Resources.ColorColumnHeader}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <commoncontrols:CustomPopupColorEdit Name="PART_Editor" Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Color="{Binding RowData.Row.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=BlinkTime, Mode=TwoWay}" Header="{x:Static properties:Resources.BlinkTimeColumnHeader}" />
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=BlinkColor, Mode=TwoWay}" Header="{x:Static properties:Resources.BlinkColorColumnHeader}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <commoncontrols:CustomPopupColorEdit Name="PART_Editor" Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Color="{Binding RowData.Row.BlinkColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=Text, Mode=TwoWay}" Header="{x:Static properties:Resources.TextColumnHeader}" x:Name="columnText"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Name="tableView" FocusedRowChanged="tableView_FocusedRowChanged" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False"/>
                </dxg:GridControl.View>
            </dxg:GridControl>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Click="OnAdd" Margin="5,5,5,5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>

                <Button IsEnabled="False" Grid.Column="1" x:Name="btnDelete" Click="OnDelete" Margin="5,5,5,5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
