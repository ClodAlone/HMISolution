<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:go="http://schemas.nwoods.com/GoXam"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <go:BooleanBrushConverter x:Key="theValueConverter"
                              FalseBrush="Red" TrueBrush="Green" />
    <go:BooleanBrushConverter x:Key="theSelectionConverter"
                              FalseBrush="Black" TrueBrush="Cyan" />

    <go:DataTemplateDictionary x:Key="NodeTemplateDictionary">

        <DataTemplate x:Key="Add">
            <go:SpotPanel go:Node.Location="{Binding Path=Data.Location, Mode=TwoWay}">
                <ToolTipService.ToolTip>
                    <TextBlock Text="{Binding Path=Data.Key}" />
                </ToolTipService.ToolTip>
                <go:NodePanel>
                    <Grid>

                        <go:NodeShape Width="100" Height="100"
                            go:NodePanel.Figure="Rectangle"
                            Fill="{Binding Path=Data.Value,
                                   Converter={StaticResource theValueConverter}}" 
                            Stroke="{Binding Path=Node.IsSelected,
                                     Converter={StaticResource theSelectionConverter}}" 
                            StrokeThickness="2" />

                        <go:NodeShape Width="100" Height="100"
                            go:NodePanel.Figure="PlusLine"
                            Fill="{Binding Path=Data.Value,
                                   Converter={StaticResource theValueConverter}}" 
                            Stroke="{Binding Path=Node.IsSelected,
                                     Converter={StaticResource theSelectionConverter}}" 
                            StrokeThickness="2" />
                    </Grid>
                    <TextBlock Text="{Binding Path=Data.Text, Mode=TwoWay}" Foreground="Black"
                   TextWrapping="Wrap" Cursor="Arrow" TextAlignment="Center" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   go:Node.LinkableFrom="False" go:Node.LinkableTo="False"
                   go:Part.TextEditable="True" />
                </go:NodePanel>
                <Rectangle go:SpotPanel.Spot="MiddleLeft"
                   Width="8" Height="8" Fill="Black"
                   go:Node.PortId="" go:Node.LinkableTo="True"
                   go:Node.ToSpot="MiddleLeft" Cursor="Hand" />
            </go:SpotPanel>
        </DataTemplate>

        <DataTemplate x:Key="Subtract">
            <go:SpotPanel go:Node.Location="{Binding Path=Data.Location, Mode=TwoWay}">
                <ToolTipService.ToolTip>
                    <TextBlock Text="{Binding Path=Data.Key}" />
                </ToolTipService.ToolTip>
                <go:NodePanel>
                    <Grid>
                        <go:NodeShape Width="100" Height="100"
                            go:NodePanel.Figure="Rectangle"
                            Fill="{Binding Path=Data.Value,
                                   Converter={StaticResource theValueConverter}}" 
                            Stroke="{Binding Path=Node.IsSelected,
                                     Converter={StaticResource theSelectionConverter}}" 
                            StrokeThickness="2" />

                        <go:NodeShape Width="100" Height="100"
                        go:NodePanel.Figure="LineH"
                        Fill="{Binding Path=Data.Value,
                               Converter={StaticResource theValueConverter}}" 
                        Stroke="{Binding Path=Node.IsSelected,
                                 Converter={StaticResource theSelectionConverter}}" 
                        StrokeThickness="2" />
                    </Grid>
                    
                    <TextBlock Text="{Binding Path=Data.Text, Mode=TwoWay}" Foreground="Black"
                   TextWrapping="Wrap" Cursor="Arrow" TextAlignment="Center" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   go:Node.LinkableFrom="False" go:Node.LinkableTo="False"
                   go:Part.TextEditable="True" />
                </go:NodePanel>
                <Rectangle go:SpotPanel.Spot="MiddleLeft"
                   Width="8" Height="8" Fill="Black"
                   go:Node.PortId="" go:Node.LinkableTo="True"
                   go:Node.ToSpot="MiddleLeft" Cursor="Hand" />
            </go:SpotPanel>
        </DataTemplate>

        <DataTemplate x:Key="Multiply">
            <go:SpotPanel go:Node.Location="{Binding Path=Data.Location, Mode=TwoWay}">
                <ToolTipService.ToolTip>
                    <TextBlock Text="{Binding Path=Data.Key}" />
                </ToolTipService.ToolTip>
                <go:NodePanel>
                    <Grid>
                        <go:NodeShape Width="100" Height="100"
                            go:NodePanel.Figure="Rectangle"
                            Fill="{Binding Path=Data.Value,
                                   Converter={StaticResource theValueConverter}}" 
                            Stroke="{Binding Path=Node.IsSelected,
                                     Converter={StaticResource theSelectionConverter}}" 
                            StrokeThickness="2" />

                        <go:NodeShape Width="100" Height="100"
                        go:NodePanel.Figure="XLine"
                        Fill="{Binding Path=Data.Value,
                               Converter={StaticResource theValueConverter}}" 
                        Stroke="{Binding Path=Node.IsSelected,
                                 Converter={StaticResource theSelectionConverter}}" 
                        StrokeThickness="2" />
                    </Grid>
                    
                    <TextBlock Text="{Binding Path=Data.Text, Mode=TwoWay}" Foreground="Black"
                   TextWrapping="Wrap" Cursor="Arrow" TextAlignment="Center" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   go:Node.LinkableFrom="False" go:Node.LinkableTo="False"
                   go:Part.TextEditable="True" />
                </go:NodePanel>
                <Rectangle go:SpotPanel.Spot="MiddleLeft"
                   Width="8" Height="8" Fill="Black"
                   go:Node.PortId="" go:Node.LinkableTo="True"
                   go:Node.ToSpot="MiddleLeft" Cursor="Hand" />
            </go:SpotPanel>
        </DataTemplate>

        <DataTemplate x:Key="Divide">
            <go:SpotPanel go:Node.Location="{Binding Path=Data.Location, Mode=TwoWay}">
                <ToolTipService.ToolTip>
                    <TextBlock Text="{Binding Path=Data.Key}" />
                </ToolTipService.ToolTip>
                <go:NodePanel>
                    <Grid>
                        <go:NodeShape Width="100" Height="100"
                            go:NodePanel.Figure="Rectangle"
                            Fill="{Binding Path=Data.Value,
                                   Converter={StaticResource theValueConverter}}" 
                            Stroke="{Binding Path=Node.IsSelected,
                                     Converter={StaticResource theSelectionConverter}}" 
                            StrokeThickness="2" />

                        <go:NodeShape Width="100" Height="100"
                        go:NodePanel.Figure="Line2"
                        Fill="{Binding Path=Data.Value,
                               Converter={StaticResource theValueConverter}}" 
                        Stroke="{Binding Path=Node.IsSelected,
                                 Converter={StaticResource theSelectionConverter}}" 
                        StrokeThickness="2" />
                    </Grid>
                    
                    <TextBlock Text="{Binding Path=Data.Text, Mode=TwoWay}" Foreground="Black"
                   TextWrapping="Wrap" Cursor="Arrow" TextAlignment="Center" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   go:Node.LinkableFrom="False" go:Node.LinkableTo="False"
                   go:Part.TextEditable="True" />
                </go:NodePanel>
                <Rectangle go:SpotPanel.Spot="MiddleLeft"
                   Width="8" Height="8" Fill="Black"
                   go:Node.PortId="" go:Node.LinkableTo="True"
                   go:Node.ToSpot="MiddleLeft" Cursor="Hand" />
            </go:SpotPanel>
        </DataTemplate>

    </go:DataTemplateDictionary>

</ResourceDictionary>
