<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="MSZUtils.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6"/>
    </startup>
    <applicationSettings>
        <MSZUtils.Properties.Settings>
            <setting name="FontSize" serializeAs="String">
                <value>14</value>
            </setting>
            <setting name="ExpiredLogin" serializeAs="String">
                <value>00:15:00</value>
            </setting>
            <setting name="OperationTimeOut" serializeAs="String">
                <value>00:10:00</value>
            </setting>
            <setting name="ThemeName" serializeAs="String">
                <value>Office2007Silver</value>
            </setting>
            <setting name="Filters" serializeAs="String">
                <value>LicensesFilters.txt</value>
            </setting>
            <setting name="TemporaryLicenseDaysLimit" serializeAs="String">
                <value>365</value>
            </setting>
            <setting name="DefaultCulture" serializeAs="String">
                <value>en-US</value>
            </setting>
            <setting name="MinSerialPerLimitedLicenses" serializeAs="String">
                <value>50000000</value>
            </setting>
        </MSZUtils.Properties.Settings>
    </applicationSettings>
    <system.serviceModel>
      <bindings>
        <basicHttpBinding>
          <binding name="MSZUServiceBinding" maxBufferSize="4194304" maxReceivedMessageSize="4194304">
            <security mode="Transport">
              <transport clientCredentialType="None" />
            </security>
          </binding>
        </basicHttpBinding>
      </bindings>
      <behaviors>
        <endpointBehaviors>
          <behavior name="EndpointBehavior">
            <clientCredentials>
            </clientCredentials>
          </behavior>
        </endpointBehaviors>
      </behaviors>
      <client>
        <!--behaviorConfiguration="EndpointBehavior"-->
        <endpoint address="https://licmng.progea.com:63916/MSZUtilsWService"
          binding="basicHttpBinding"
          bindingConfiguration="MSZUServiceBinding" contract="MSZServiceCMS.IMSZWUServiceCMS"
          name="MSZUtilsWServiceEndPoint">
          <identity>
            <dns value="licmng.progea.com" />
            <certificateReference x509FindType="FindBySubjectName" findValue="licmng.progea.com"
              isChainIncluded="true" />
          </identity>
        </endpoint>
      </client>
    </system.serviceModel>
</configuration>
