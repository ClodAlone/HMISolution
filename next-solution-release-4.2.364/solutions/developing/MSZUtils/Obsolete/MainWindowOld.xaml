<Window x:Class="MSZUtils.MainWindowOld"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
        xmlns:helpers="clr-namespace:MSZUtilsServiceHelper;assembly=MSZUtilsServiceHelper"
        Title="MainWindow" Height="796.798" Width="1100" Background="White">
    <Grid>
        <Grid.Resources>
            <LinearGradientBrush x:Key="main_background" EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF2384C6" Offset="1"/>
                <GradientStop Color="#FF9C9C9C"/>
                <GradientStop Color="White"/>
                <GradientStop Color="#FFA5D5F5"/>
                <GradientStop Color="#FFF0F0F0" Offset="0.83"/>
                <GradientStop Color="#FFC2D1E2" Offset="0.019"/>
                <GradientStop Color="#FFA6DAFF" Offset="0.952"/>
            </LinearGradientBrush>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="16*"/>
            <RowDefinition Height="296*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="sglockCheck" Visibility="Collapsed" TextWrapping="Wrap" Text="Chiave non ancora inizializzata" Foreground="Red" Margin="200,0"
                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />

        <Border Grid.Row="1" Background="{DynamicResource main_background}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="63*"/>
                    <RowDefinition Height="63*"/>
                    <RowDefinition Height="316*"/>
                    <RowDefinition Height="137*"/>
                    <RowDefinition Height="34*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="9"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.6*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Customer" Background="Transparent" Margin="33,0"/>
                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="Licence Type" Background="Transparent" Margin="33,0"/>

                    <ComboBox x:Name="customers" Grid.Row="1" Background="White" Margin="33,4" TextSearch.TextPath="Name" IsTextSearchEnabled="True" 
                              IsSynchronizedWithCurrentItem="False" Grid.ColumnSpan="2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type helpers:Customer}" >
                                <TextBlock Grid.Column="1" HorizontalAlignment="Stretch" TextAlignment="Justify" Text="{Binding Name}" Background="Transparent"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="licencetype" 
                              SelectionChanged="licencetype_SelectionChanged"
                              Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Background="White" Margin="33,4,35,4" IsEditable="False" IsTextSearchEnabled="True" 
                              IsSynchronizedWithCurrentItem="False" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type helpers:LicenceType}" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Grid.Column="1"  HorizontalAlignment="Stretch" Text="{Binding Name}" Background="Transparent"/>
                                    <TextBlock Grid.Column="1"  HorizontalAlignment="Stretch" Text=" - " Background="Transparent"/>
                                    <TextBlock Grid.Column="1"  HorizontalAlignment="Stretch" Text="{Binding Description}" Background="Transparent"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.6*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200*"/>
                        <ColumnDefinition Width="218*"/>
                        <ColumnDefinition Width="219*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="66*"/>
                        <ColumnDefinition Width="26*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Site Code" Background="Transparent" Margin="33,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="Serial Number" Background="Transparent" Margin="32,0" />
                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="Removing Number" Background="Transparent" Margin="32,0" />
                    <TextBlock Grid.Column="4" Text="MovApp" Background="Transparent"  HorizontalAlignment="Left"  Width="52"/>
                    <TextBlock Grid.Column="5" Text="MovTrace" Background="Transparent"  HorizontalAlignment="Left"  Width="52"/>
                    <TextBlock Grid.Column="6" Text="MovBA" Background="Transparent"  HorizontalAlignment="Left"  Width="52"/>

                    <TextBox x:Name="siteCode" Grid.Row="1" TextWrapping="NoWrap" Text="" Background="White" Margin="33,4,10,4"/>
                    <DockPanel Grid.Column="1"  Grid.Row="1" >
                        <Button x:Name="btn14" DockPanel.Dock="Right" ToolTip="preleva il primo Serial Number utile" Click="btn13_Click_1" Grid.Row="1" Grid.Column="2" Width="30" HorizontalAlignment="Left">
                            <Image Source="Images/new_32x32.png"/>
                        </Button>
                        <dxe:SpinEdit Value="0" MinValue="0" MaxValue="99999999999"  x:Name="numSerial" MaskType="Numeric" Mask="d"  Margin="5,4,5,4"/>
                    </DockPanel>
                    <!--<ms:SpinDecorator Grid.Column="1"  Grid.Row="1"  HorizontalAlignment="Stretch" Change="1" Margin="33,4,10,4">
                        <ms:NumericTextBox x:Name="numSerial" DecimalPlaces="0" Background="White"  BorderBrush="Transparent"
                                          Minimum="0"
                                          Maximum="999999999999"
                                          Value="0"
                                          Validation.ErrorTemplate="{x:Null}" RangeConstraintMode="OnLostFocusOrReturn" Text="9999999" />
                    </ms:SpinDecorator>-->
                    <RadioButton GroupName="AppName" x:Name="MovApp" IsChecked="True" Grid.Row="1" Grid.Column="4" Content="" 
                              Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="17" Height="16" Margin="0,8"/>
                    <RadioButton GroupName="AppName" x:Name="MovTrace" Grid.Row="1" Grid.Column="5" Content="" 
                              Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="17" Height="16" Margin="0,8" IsEnabled="False"/>
                    <RadioButton GroupName="AppName" x:Name="MovBa" Grid.Row="1" Grid.Column="6" Content="" 
                              Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="17" Height="16" Margin="0,8" IsEnabled="False"/>
                    <Button x:Name="btn10" ToolTip="Ricarica dati da DB" Click="ReloadAndInitValues" Grid.Row="1" Grid.Column="7" Width="30" HorizontalAlignment="Left">
                        <Image Source="Images/restore.gif"/>
                    </Button>
                    <DockPanel Grid.Column="2"  Grid.Row="1" >
                        <Button x:Name="btnCheck" DockPanel.Dock="Right" ToolTip="verifica che il codice di rimozione sia valido per il Serial Number inserito" Click="btnCheck_Click" Width="30" HorizontalAlignment="Left">
                            <Image Source="Images/check_32x32.png"/>
                        </Button>
                        <dxe:TextEdit Text="" x:Name="numRemoved" MaskType="None" Grid.Column="2"  Grid.Row="1" Margin="5,4,5,4"/>
                    </DockPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Row="0" x:Name="boolOptionList" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <CheckBox  IsEnabled="{Binding Enabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="160" Height="30" Grid.Column="1"  IsChecked="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="White">
                                        <TextBlock Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="0" x:Name="intOptionList" Grid.Column="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Width="140" Height="30" Grid.Column="0" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent"/>
                                    <!--<TextBox Width="100" Height="30" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Background="White"/>-->
                                    <dxe:SpinEdit IsEnabled="{Binding Enabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="99999999999" Width="100" Height="30" Grid.Column="1" Value="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="d" Grid.Row="1"  Background="White" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Grid Grid.Row="3" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Licenze Software" FontSize="14" FontWeight="Bold" Foreground="#FF01FF01" Grid.Column="0" Grid.RowSpan="5" Margin="0,0,0,-18"/>
                    <GroupBox Header="Licenze Hardware" FontSize="14" FontWeight="Bold" Foreground="#FFFF6901" Grid.Column="1" Grid.RowSpan="5" Margin="0,0,0,-18"/>
                    <Button x:Name="btn1" Content="Genera Licenza Software" Grid.Column="0" Grid.Row="1" Margin="10,2" Click="btn1_Click"/>
                    <Button x:Name="btn2" Content="Leggi Licenza Software" Grid.Column="0" Grid.Row="2" Margin="10,2" Click="btn2_Click"/>
                    <Button x:Name="btn333" Content="Genera + Aggiorna" Grid.Column="0" Grid.Row="4" Margin="10,2" Click="scriviaggiorna_Click"/>
                    <Button x:Name="btn3" Content="Scrivi Chiave Hardware" Grid.Column="1" Grid.Row="1" Margin="10,2" Click="btn3_Click"/>
                    <Button x:Name="btn4" Content="Leggi Chiave Hardware" Grid.Column="1" Grid.Row="2" Margin="10,2" Click="btn4_Click"/>
                    <Button x:Name="btn5" Content="Genera File Aggiornamento" Grid.Column="1" Grid.Row="3" Margin="10,2" Click="btn5_Click"/>
                    <Button x:Name="btn16" Content="Scrivi + Stampa + Aggiorna" Grid.Column="1" Grid.Row="4" Margin="10,2" Click="btn16_Click"/>
                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="Expiring Date" Background="Transparent" VerticalAlignment="Bottom" />

                    <dxe:DateEdit x:Name="dateTimePicker1" IsEnabled="False" Grid.Row="1" Grid.Column="2" Background="White"          
                    Validation.ErrorTemplate="{x:Null}"  HorizontalAlignment="Left"
                    MaskType="DateTime" Width="190" Height="25"
                    MaskUseAsDisplayFormat="True"
                    ShowClearButton="False"
                    ShowToday="True"
                    Mask="G"
                    ShowWeekNumbers="True"/>

                    <Button x:Name="btn11" Content="Apri File di Log" Grid.Column="2" Grid.Row="2" Margin="0,2,10,2" Click="btn11_Click"/>

                    <CheckBox x:Name="Unlimited" IsChecked="True" Grid.Row="1" Grid.Column="2" 
                              Click="Unlimited_Click" Content="Unlimited"
                              Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" Width="79" Height="16"/>
                    <Button x:Name="btn6" Content="Leggi da DB" Grid.Column="3" Grid.Row="1" Margin="10,2" Click="ReadDB_Click"/>
                    <Button x:Name="btn8" Content="Clear" Grid.Column="3" Grid.Row="3" Margin="10,2" Click="Clear_Click"/>
                    <Button x:Name="btn12" Content="Stampa Etichette" Grid.Column="3" Grid.Row="4" Margin="10,2" Click="Print_Click"/>
                </Grid>
                <Grid Grid.Row="5" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="1" Content="Order. Nr.:" HorizontalContentAlignment="Right" Width="263"/>
                    <Label Grid.Row="1" Grid.Column="1" Content="Bill. Nr.:" HorizontalContentAlignment="Right" Width="263"/>
                    <Label Grid.Row="2" Grid.Column="1" Content="Notes:" HorizontalContentAlignment="Right" Width="263"/>
                    <TextBox Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" x:Name="Order" Margin="10,2" HorizontalAlignment="Left" Width="253"/>
                    <TextBox Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" x:Name="Bill" Margin="10,2" HorizontalAlignment="Left" Width="253"/>
                    <TextBox Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" x:Name="logNote" Margin="10,2" HorizontalAlignment="Left" Width="253"/>
                    <Button x:Name="btn7" Content="Aggiungi a DB" Grid.Column="3" Grid.Row="1" Margin="10,2" Click="AddToDB_Click"/>
                    <Button x:Name="btn13" Content="Sovrascrivi DB" Grid.Column="3" Grid.Row="2" Margin="10,2" Click="OverrideDB_Click"/>
                </Grid>
            </Grid>
        </Border>
        <Image Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Source="Images/logo_progea_header.png" Height="35"/>

    </Grid>
</Window>
