<dx:DXWindow x:Class="MSZUtils.Controls.NewCustomer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:properties="clr-namespace:MSZUtils.Properties" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             mc:Ignorable="d" Height="300" Width="300">
    <DockPanel LastChildFill="True" x:Name="view">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,10">
            <Button Content="{x:Static properties:Resources.OkLabel}" Click="Button_Click" Margin="12,2,2,2" Width="120" Height="50" />
            <Button Content="{x:Static properties:Resources.CancelLabel}" Click="Button1_Click" Margin="12,2,2,2" Width="120" Height="50" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="5,0,5,5" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Name: " />
                <TextBox Text="{Binding ShortName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="Name" Grid.Column="1" />
            </Grid>
            <Grid Margin="5,0,5,5" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="PIva: " />
                <dxe:TextEdit Text="{Binding PIva,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="PIva" Grid.Column="1" />
            </Grid>
            <Grid Margin="5,0,5,5" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Area: " />
                <ComboBox SelectedValue="{Binding Area,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="areaCombo" Grid.Column="1" />
            </Grid>
        </Grid>
    </DockPanel>
</dx:DXWindow>
