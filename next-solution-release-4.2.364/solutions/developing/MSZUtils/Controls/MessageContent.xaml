<UserControl x:Class="MSZUtils.Controls.MessageContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:MSZUtils.Properties" 
             mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>
        <Image Margin="0,20" VerticalAlignment="Bottom" x:Name="error" Stretch="Uniform" Visibility="Collapsed" Source="..\Images\Error.png" Width="32" Height="32"/>
        <Image VerticalAlignment="Bottom" x:Name="request" Stretch="Uniform" Visibility="Collapsed" Source="..\Images\About.png" Width="32" Height="32"/>
        <Image VerticalAlignment="Bottom" x:Name="warning" Stretch="Uniform" Visibility="Collapsed" Source="..\Images\Warning.png" Width="32" Height="32"/>
        <Image VerticalAlignment="Bottom" x:Name="info" Stretch="Uniform" Visibility="Collapsed" Source="..\Images\Info.png" Width="32" Height="32"/>
        <TextBlock x:Name="content" Margin="10" Text="message text" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Center" TextWrapping="Wrap" Grid.Row="1" />
  </Grid>
</UserControl>
