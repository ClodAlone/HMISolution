<dx:DXWindow x:Class="MSZUtils.Controls.LicenceSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:properties="clr-namespace:MSZUtils.Properties" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             mc:Ignorable="d" Height="835" Width="1100">
    <dx:DXWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <dxe:TextEditSettings x:Key="dateSettings" DisplayFormat="" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </dx:DXWindow.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,10">
            <Button Click="Exit" Margin="12,2,2,2" Width="180" Height="50">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.ExitLabel}" />
            </Button>
            <Button Click="SaveOptionsToDBAndExit" Margin="12,2,2,2" Width="180" Height="50">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.SaveAndOkLabel}" />
            </Button>
            <Button Click="SaveOptionsToDB" Margin="12,2,2,2" Width="180" Height="50">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.SaveLabel}" />
            </Button>
            <Button Click="ReloadAndInitValues" Margin="12,2,2,2" Width="180" Height="50">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.ReInitDatas}" />
            </Button>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>-->
                <RowDefinition Height="90*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="90*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!--<Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>-->
                <TextBlock FontSize="16" Grid.Row="0" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{x:Static properties:Resources.LicenceType}" Background="Transparent" Margin="33,0" />
                <dxe:ListBoxEdit Grid.ColumnSpan="5" FontSize="14" Grid.Row="1" SelectedIndexChanged="licencetype_SelectedIndexChanged"
                    x:Name="licencetype" IncrementalSearch="False"
                    ShowCustomItems="False" AllowItemHighlighting="False"
                    IsSynchronizedWithCurrentItem="False">
                    <dxe:ListBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="hiddenField" Checked="hiddenField_Checked" Unchecked="hiddenField_Checked" Grid.Column="0" GotFocus="EditValue_GotFocus"  
                                          HorizontalAlignment="Stretch" IsChecked="{Binding Hidden}" Background="Transparent" />
                                <TextBox IsEnabled="{Binding Hidden, Converter={StaticResource InverseBooleanConverter}}" 
                                         IsReadOnly="{Binding Hidden}" MinWidth="100"
                                         Grid.Column="1" GotFocus="EditValue_GotFocus" HorizontalAlignment="Stretch" Text="{Binding Name}" Background="Transparent" BorderBrush="Transparent" />
                                <TextBox IsEnabled="{Binding Hidden, Converter={StaticResource InverseBooleanConverter}}" 
                                         IsReadOnly="{Binding Hidden}" MinWidth="100"
                                         Grid.Column="2" GotFocus="EditValue_GotFocus" HorizontalAlignment="Stretch" Text="{Binding Description}" Background="Transparent" BorderBrush="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </dxe:ListBoxEdit.ItemTemplate>
                </dxe:ListBoxEdit>
            </Grid>
            <Grid Grid.Row="1">
                <Button Grid.Column="1" Click="Add_Click" Margin="12,2" ToolTip="{x:Static properties:Resources.AddLabel}">
                    <Button.Content>
                        <Image Margin="2" x:Name="addSmallImg" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" />

            <!--  Details  -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Row="1" x:Name="boolOptionList" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <CheckBox IsEnabled="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="30" Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock FontSize="12" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                </CheckBox>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Grid.Row="1" x:Name="intOptionList" Grid.Column="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" Width="140" Height="30" Grid.Column="0" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent" />
                                <dxe:SpinEdit FontSize="12" IsEnabled="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="99999999999" Width="100" Height="30" Grid.Column="1" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="d" Grid.Row="1" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.LicenceOptions}" Margin="33,0" />
            </Grid>
            <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.RowSpan="13" />
            <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.RowSpan="13"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</dx:DXWindow>
