<dx:DXWindow x:Class="MSZUtils.Controls.Customers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:properties="clr-namespace:MSZUtils.Properties" 
             xmlns:local="clr-namespace:MSZUtils.Converters" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             mc:Ignorable="d" Height="835" Width="865">
    <dx:DXWindow.Resources>
        <ResourceDictionary>
            <local:ValueToTextConverter x:Key="ValueToTextConverter" />
            <dx:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverterInverted" Invert="True" />
            <dx:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" Invert="False" />
            <dxe:TextEditSettings x:Key="dateSettings" DisplayFormat="" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" />
            <ControlTemplate x:Key="CheckEditTemplate">
                <Grid>
                    <Label Name="Checked" Content="Yes" Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Label Name="UnChecked" Content="No" Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverterInverted}}" />
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </dx:DXWindow.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,10">
            <Button Content="{x:Static properties:Resources.OkLabel}" Click="Exit_Click" Margin="12,2,2,2" Width="120" Height="50" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Add new Customer" Click="NewCustomer_Click" Grid.Row="1" MinHeight="50" />
            <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
			                 Tag="DataSourceStyle" 
                             AutoExpandAllGroups="True"
                             AutoPopulateColumns="False" AutoGenerateColumns="None" 
			                 x:Name="gridControl"
                             AllowDrop="True" 
                             AllowLiveDataShaping="False"                         
                             dx:DXSerializer.SerializationID="gridControl" 
                             dx:DXSerializer.StoreLayoutMode="All" 
                             dxg:DataControlSerializationOptions.AddNewColumns="False" 
    		                 dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="ID" />
                    <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="Code" />
                    <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="Name" />
                    <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="PIva" />
                    <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="Area" />
                    <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="Editable">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:CheckEdit Name="PART_Editor" DisplayTemplate="{StaticResource CheckEditTemplate}" EditTemplate="{StaticResource CheckEditTemplate}" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView" AllowEditing="False"
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows" PreviewMouseDoubleClick="tableView_MouseDoubleClick"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        ShowGroupPanel="True"
                        ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row">
                        <dxg:TableView.GroupValueTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Column.FieldName}" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Value, Converter={StaticResource ValueToTextConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </dxg:TableView.GroupValueTemplate>
                        <dxg:TableView.FormatConditions>
                            <dxg:FormatCondition ApplyToRow="True" Expression="[Editable] = 1" FieldName="Editable" PredefinedFormatName="GreenFillWithDarkGreenText" />
                        </dxg:TableView.FormatConditions>
                    </dxg:TableView>
                </dxg:GridControl.View>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
                </dxg:GridControl.TotalSummary>
            </dxg:GridControl>
            <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.RowSpan="3" />
            <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.RowSpan="3"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</dx:DXWindow>
