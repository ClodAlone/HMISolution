<UserControl x:Class="UFRecipeLayout.LayoutItemControls.ItemControlCommandButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Width="Auto" Height="Auto">
    
    <Button x:Name="btnRecipeCommand">
        <Button.Content>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="btnText" HorizontalAlignment="Center" Visibility="Collapsed" />
                <Image x:Name="btnImage" HorizontalAlignment="Center" Visibility="Visible"
                       Width="24" Height="24" IsHitTestVisible="False" />
            </StackPanel>
            
        </Button.Content>
    </Button>
</UserControl>