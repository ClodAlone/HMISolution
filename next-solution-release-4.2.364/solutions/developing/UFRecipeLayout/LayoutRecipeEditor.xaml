<UserControl x:Class="UFRecipeLayout.LayoutRecipeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
             xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:cc="http://progea.com/CommonControls" 
             xmlns:self="clr-namespace:UFRecipeLayout"
             xmlns:properties="clr-namespace:UFRecipeLayout.Properties" 
             PreviewKeyDown="LayoutRecipeEditor_PreviewKeyDown"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
          <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/UFRecipeLayout.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <self:RecipeLayoutControl x:Name="layoutItems" ReadElementFromXML="OnReadElementFromXML" WriteElementToXML="OnWriteElementToXML" />
        <Border x:Name="newRecipeWindow" HorizontalAlignment="Center" VerticalAlignment="Center" 
                BorderThickness="1" BorderBrush="Gray" Background="Black" Visibility="Collapsed" >
            <Grid Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=layoutItems, Mode=OneWay}" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Margin="2" Text="{x:Static properties:Resources.EnterNewRecipeNameWindowTitle}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" />
                <Button Grid.Column="1" HorizontalAlignment="Right" Click="newRecipe_Ok" >
                    <Button.Content>
                        <Image Source="{StaticResource OkSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Right" Click="newRecipe_Cancel" >
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <ContentControl x:Name="newRecipeControl" Grid.Row="1" />
            </Grid>
        </Border>

        <cc:CircularProgressBar x:Name="busyPanel" Background="Black" Opacity="0.5" Visibility="Collapsed" />
        <TextBlock Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding Visibility, ElementName=busyPanel}"
                   FontFamily="Segoe UI" FontWeight="Light" Margin="5,0,0,0" Foreground="White" FontSize="16" />

        <Viewbox Stretch="Fill" Visibility="Collapsed" x:Name="txtMode" IsHitTestVisible="False"
                   KeyboardNavigation.IsTabStop="False"
                 Width="{Binding ElementName=layoutItems, Path=Width}" Height="{Binding ElementName=layoutItems, Path=Height}" >
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" 
                   KeyboardNavigation.IsTabStop="False"
                       Text="{x:Static properties:Resources.NoRecipeLicense}" FontSize="48" Opacity="0.1">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-45"/>
                </TextBlock.LayoutTransform>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </TextBlock.Effect>
            </TextBlock>
        </Viewbox>
    </Grid>
</UserControl>
