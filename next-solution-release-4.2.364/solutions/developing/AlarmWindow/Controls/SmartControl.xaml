<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             x:Class="AlarmWindow.Controls.SmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:properties="clr-namespace:AlarmWindow.Properties" 
             xmlns:converters="clr-namespace:AlarmWindow.Converters"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:commoncontrols="http://progea.com/CommonControls">
    
    <UserControl.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
          </ResourceDictionary.MergedDictionaries>
            <converters:ColorToBackgroundConverter x:Key="ColorToBackgroundConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddButtonTitle}" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="1" IsEnabled="False" x:Name="btnDelete" 
                    ToolTip="{x:Static properties:Resources.DeleteButtonTitle}" Click="OnDelete" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
        </Grid>
        <dxg:GridControl AllowDrop="False" Name="gridControl" Grid.Row="1" >
            <dxg:GridControl.Columns>
                <dxg:GridColumn AllowDrop="False" AllowMoving="False"  Width="50"  SortOrder="Ascending" DisplayMemberBinding="{Binding Path=ThresholdValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.ValueColumnHeader}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

              <dxg:GridColumn AllowDrop="False" AllowMoving="False" Header="{x:Static properties:Resources.ActiveThresholdColumnHeader}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <dxe:PopupBaseEdit Name="PART_Editor" MouseDown="PART_Editor_MouseDown" 
                                       PopupClosing="Popup_Closing">
                      <dxe:PopupBaseEdit.PopupContentTemplate>
                        <ControlTemplate>
                          <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdBackground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdForeground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdForeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                          </StackPanel>
                        </ControlTemplate>
                      </dxe:PopupBaseEdit.PopupContentTemplate>
                      <dxe:PopupBaseEdit.DisplayTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                    <dxe:ButtonEdit DockPanel.Dock="Right" Width="16" AllowDefaultButton="False">
                                      <dxe:ButtonInfo GlyphKind="Down"/>
                                    </dxe:ButtonEdit>
                                    <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                    Foreground="{Binding Data.ThresholdForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                    Background="{Binding Data.ThresholdColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.DisplayTemplate>  
                      <dxe:PopupBaseEdit.EditTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                            <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                            Foreground="{Binding RowData.Row.ThresholdForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                            Background="{Binding RowData.Row.ThresholdColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.EditTemplate>  
                    </dxe:PopupBaseEdit>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

              <dxg:GridColumn AllowDrop="False" AllowMoving="False" Header="{x:Static properties:Resources.ActiveOffThresholdColumnHeader}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <dxe:PopupBaseEdit Name="PART_Editor" MouseDown="PART_Editor_MouseDown"
                                       PopupClosing="Popup_Closing">
                      <dxe:PopupBaseEdit.PopupContentTemplate>
                        <ControlTemplate>
                          <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdBackground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdOffColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdForeground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdOffForeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                          </StackPanel>
                        </ControlTemplate>
                      </dxe:PopupBaseEdit.PopupContentTemplate>
                      <dxe:PopupBaseEdit.DisplayTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                  <dxe:ButtonEdit DockPanel.Dock="Right" Width="16" AllowDefaultButton="False">
                                    <dxe:ButtonInfo GlyphKind="DropDown"/>
                                  </dxe:ButtonEdit>
                                  <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                    Foreground="{Binding Data.ThresholdOffForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                    Background="{Binding Data.ThresholdOffColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.DisplayTemplate>  
                      <dxe:PopupBaseEdit.EditTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                            <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                            Foreground="{Binding RowData.Row.ThresholdOffForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                            Background="{Binding RowData.Row.ThresholdOffColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.EditTemplate>  
                    </dxe:PopupBaseEdit>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>

              <dxg:GridColumn AllowDrop="False" AllowMoving="False" Header="{x:Static properties:Resources.AckThresholdColumnHeader}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <dxe:PopupBaseEdit Name="PART_Editor" MouseDown="PART_Editor_MouseDown"
                                       PopupClosing="Popup_Closing">
                      <dxe:PopupBaseEdit.PopupContentTemplate>
                        <ControlTemplate>
                          <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdBackground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdAckColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdForeground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdAckForeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                          </StackPanel>
                        </ControlTemplate>
                      </dxe:PopupBaseEdit.PopupContentTemplate>
                      <dxe:PopupBaseEdit.DisplayTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                  <dxe:ButtonEdit DockPanel.Dock="Right" Width="16" AllowDefaultButton="False">
                                    <dxe:ButtonInfo GlyphKind="DropDown"/>
                                  </dxe:ButtonEdit>
                                  <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                    Foreground="{Binding Data.ThresholdAckForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                    Background="{Binding Data.ThresholdAckColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.DisplayTemplate>  
                      <dxe:PopupBaseEdit.EditTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                            <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                            Foreground="{Binding RowData.Row.ThresholdAckForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                            Background="{Binding RowData.Row.ThresholdAckColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.EditTemplate>  
                    </dxe:PopupBaseEdit>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>    
              </dxg:GridColumn>

              <dxg:GridColumn AllowDrop="False" AllowMoving="False" Header="{x:Static properties:Resources.AckOffThresholdColumnHeader}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <dxe:PopupBaseEdit Name="PART_Editor" MouseDown="PART_Editor_MouseDown"
                                       PopupClosing="Popup_Closing">
                      <dxe:PopupBaseEdit.PopupContentTemplate>
                        <ControlTemplate>
                          <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdBackground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdOffAckColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,2">
                              <Label Content="{x:Static properties:Resources.ThresholdForeground}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                              <commoncontrols:CustomPopupColorEdit Margin="6,0" OnlySolidColors="True"
                                      Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                      BrushSelected="OnBrushSelected" MoreColorsClicked="OnMoreColorsClicked"
                                      Color="{Binding RowData.Row.ThresholdOffAckForeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                          </StackPanel>
                        </ControlTemplate>
                      </dxe:PopupBaseEdit.PopupContentTemplate>
                      <dxe:PopupBaseEdit.DisplayTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                  <dxe:ButtonEdit DockPanel.Dock="Right" Width="16" AllowDefaultButton="False">
                                    <dxe:ButtonInfo GlyphKind="DropDown"/>
                                  </dxe:ButtonEdit>
                                  <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                    Foreground="{Binding Data.ThresholdOffAckForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                    Background="{Binding Data.ThresholdOffAckColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.DisplayTemplate>  
                      <dxe:PopupBaseEdit.EditTemplate>  
                            <ControlTemplate>  
                                <DockPanel LastChildFill="True">
                                            <TextBlock Text="{x:Static properties:Resources.ThAlarmText}"
                                            Foreground="{Binding RowData.Row.ThresholdOffAckForeColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}" 
                                            Background="{Binding RowData.Row.ThresholdOffAckColor,Converter={StaticResource ColorToBackgroundConverter}, Mode=OneWay}"/>
                                </DockPanel>
                            </ControlTemplate>  
                      </dxe:PopupBaseEdit.EditTemplate>  
                    </dxe:PopupBaseEdit>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>    
              </dxg:GridColumn>

            </dxg:GridControl.Columns>
                                <!--FocusedColumnChanged="tableView_FocusedColumnChanged"-->
            <dxg:GridControl.View>
                <dxg:TableView ShowingEditor="tableView_ShowingEditor" Name="tableView" 
                                ShowGroupPanel="False" ShowTotalSummary="False" AutoWidth="true" 
                                CellValueChanged="tableView_CellValueChanged" 
                                FocusedRowChanged="tableView_FocusedRowChanged"
                                ValidateRow="tableView_ValidateRow" 
                                InvalidRowException="tableView_InvalidRowException" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
