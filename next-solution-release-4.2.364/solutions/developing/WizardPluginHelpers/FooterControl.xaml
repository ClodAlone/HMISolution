<UserControl x:Class="WizardPluginHelpers.FooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="{x:Null}"
             mc:Ignorable="d" xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:comand="clr-namespace:WizardPluginHelpers"
             xmlns:properties="clr-namespace:WizardPluginHelpers.Properties" >
  <UserControl.CommandBindings>
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.NextStep}"
                Executed="OnNextStep"
                CanExecute="CanNextStep" />
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.PrevStep}"
                Executed="OnPrevStep"
                CanExecute="CanPrevStep" />
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.CancelCommand}"
                Executed="OnCancelCommand"
                CanExecute="CanAlwaysExecute" />
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.FinishCommand}"
                Executed="OnFinishCommand"
                CanExecute="CanFinishCommand" />
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.HelpCommand}"
                Executed="OnHelpCommand"
                CanExecute="CanAlwaysExecute" />
  </UserControl.CommandBindings>
 <Grid HorizontalAlignment="Stretch" Background="{x:Null}">
        <Rectangle Grid.Row="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#19000000" Offset="0"/>
                    <GradientStop Color="#19000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
     <DockPanel  HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Background="{x:Null}">
      <Button x:Name="cancelButton" Height="35"
              Margin="10,0" Width="120" IsCancel="True"
              DockPanel.Dock="Left"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Command="{x:Static comand:UIGeneralCommands.CancelCommand}"
              Content="{x:Static properties:Resources.Cancel}"/>
      <Button x:Name="finishButton" Height="35"
              Margin="10,0" Width="120"
              DockPanel.Dock="Left"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Command="{x:Static comand:UIGeneralCommands.FinishCommand}"
              Content="{x:Static properties:Resources.Finish}"/>
       <Button x:Name="helpButton" Height="35"
               Margin="10,0" Width="120"
               DockPanel.Dock="Left"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Command="{x:Static comand:UIGeneralCommands.HelpCommand}"
               Content="{x:Static properties:Resources.Help}"/>
       <Button x:Name="nextCommand" Height="35"
              Margin="10,0" Width="120"
              DockPanel.Dock="Right"
              ToolTip="{x:Static properties:Resources.NextBtn}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Command="{x:Static comand:UIGeneralCommands.NextStep}"
              FontWeight="Bold">
        <!---->
        <TextBlock Text=">" Margin="0,0,0,4"/>
      </Button>
      <Button x:Name="previousCommand" Height="35"
              Margin="10,0" Width="120"
              DockPanel.Dock="Right"
              ToolTip="{x:Static properties:Resources.PreviousBtn}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Command="{x:Static comand:UIGeneralCommands.PrevStep}"
              FontWeight="Bold">
        <!---->
        <TextBlock Text="&lt;" Margin="0,0,0,4"/>
      </Button>
    </DockPanel>
 </Grid>
</UserControl>