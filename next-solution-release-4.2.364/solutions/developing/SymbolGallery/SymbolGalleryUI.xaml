<UserControl x:Class="SymbolGallery.SymbolGalleryUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:SymbolGallery.Properties"
    xmlns:localconverters="clr-namespace:SymbolGallery"
    xmlns:comand="clr-namespace:SymbolGallery"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    xmlns:converters="clr-namespace:Converters;assembly=Converters"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             x:Name="symbolGallery" 
    Height="300" Width="500">
  <UserControl.CommandBindings>
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.ZoomIn}"
                Executed="OnZoomIn"
                CanExecute="CanZoomIn" />
    <CommandBinding Command="{x:Static comand:UIGeneralCommands.ZoomOut}"
                Executed="OnZoomOut"
                CanExecute="CanZoomOut" />
  </UserControl.CommandBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SymbolGallery.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ItemTemplate">
                    <Border CornerRadius="0" BorderThickness="1" BorderBrush="Gray">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe UI" FontSize="16" 
                                   VerticalAlignment="Center"
                                   FontWeight="Light"/>
                            <Button Click="btnClose_Click" Margin="2,2,2,2" VerticalAlignment="Center" 
                                    ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.CloseLibrary}"
                                    BorderThickness="0" BorderBrush="Transparent">
                                <Button.Content>
                                    <Image Source="{StaticResource DeleteSmall}" Height="14" Width="14" />
                                </Button.Content>
                            </Button>
                    </StackPanel>
                    </Border>
            </DataTemplate>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <localconverters:GridViewToContentConverter x:Key="GridViewToContentConverter"/>
            <Storyboard x:Key="MouseOverOpacity">
              <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="bottomGrid">
                  <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="bottomGrid">
                  <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="50" KeySpline="0,0,0.5,1" />
              </DoubleAnimationUsingKeyFrames>
          </Storyboard>
          <Storyboard x:Key="MouseLeaveOpacity">
              <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="bottomGrid">
                  <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="bottomGrid">
                  <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="20" KeySpline="0,0,0.5,1" />
              </DoubleAnimationUsingKeyFrames>
          </Storyboard>
            <SolidColorBrush x:Key="HilightThemeButton" Color="#FF3C7FB1"/>
            <Style x:Key="RadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid x:Name="templateRoot" Background="Transparent">
                                <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" x:Name="button"
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Background="{TemplateBinding Background}" 
                                          IsEnabled="{Binding IsEnabled, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=RadioButton,Mode=FindAncestor}}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=RadioButton,Mode=FindAncestor}}">
                                </ToggleButton>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="button" Value="{StaticResource HilightThemeButton}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="BorderBrush" TargetName="button" Value="{StaticResource HilightThemeButton}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ContentControl x:Name="splitterPageLibraries">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <dxb:BarContainerControl ContainerType="Top" x:Name="toolbarTabLibrary" Grid.Row="0" Visibility="Collapsed">
                <dxb:ToolBarControl UseWholeRow="True"  BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                    <dxb:BarButtonItem Content="{x:Static properties:Resources.OpenLibrary}" x:Name="btnOpenLibrary" ItemClick="btnLibrary_Click"/>
                    <dxb:BarButtonItem Content="{x:Static properties:Resources.NewFolder}" x:Name="btnNewFolder" ItemClick="btnNewFolder_Click"/>
                    <dxb:BarButtonItem Content="{x:Static properties:Resources.DeleteFolder}" x:Name="btnDeleteFolder" ItemClick="btnDeleteFolder_Click"/>
                    <dxb:BarItemSeparator />
                    <dxb:BarEditItem x:Name="txtSearch" EditWidth="100" EditValue="{Binding TextSearch, Mode=TwoWay}">
                        <dxb:BarEditItem.EditSettings>
                            <dxe:TextEditSettings />
                        </dxb:BarEditItem.EditSettings>
                    </dxb:BarEditItem>
                    <dxb:BarButtonItem Glyph="{StaticResource FindSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" ToolTipService.ShowOnDisabled="True"
                        ToolTip="{x:Static properties:Resources.SearchLabel}" ItemClick="ClickSearch"/>
                </dxb:ToolBarControl>
              </dxb:BarContainerControl>

              <dx:DXTabControl x:Name="tabControl"
                               Grid.Row="1"
                               SelectionChanged="tabControl_SelectionChanged">
                <dx:DXTabControl.View>
                  <dx:TabControlMultiLineView />
                </dx:DXTabControl.View>
              </dx:DXTabControl>
            </Grid>
          </ContentControl>
          <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListBox Visibility="Collapsed" Background="Transparent" BorderBrush="Transparent" SelectedIndex="0" Foreground="White" x:Name="list">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Opacity" Value="0.6"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentControl Content="{TemplateBinding Content}" Cursor="Hand"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>

                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>

            <dxnav:NavBarControl x:Name="navigationControl" Grid.Row="1" PreviewMouseWheel="navigationControl_PreviewMouseWheel"
                                    Background="{x:Null}">
              <dxnav:NavBarControl.View>
                <dxnav:NavigationPaneView x:Name="navigationPane"
                                          IsExpandButtonVisible="False" MaxVisibleGroupCount="0"
                                          IsOverflowPanelVisible="False" IsSplitterVisible="False"
                                          ItemsPanelOrientation="Horizontal"/>
              </dxnav:NavBarControl.View>
            </dxnav:NavBarControl>

            <TextBlock FontSize="30" Grid.RowSpan="30"
            VerticalAlignment="Center" TextWrapping="WrapWithOverflow"
            HorizontalAlignment="Center" x:Name="txtNoLibrary"
            FontWeight="Light" Text="{x:Static properties:Resources.NeedSelectLibrary}"/>

          </Grid>
        </Grid>
      <ScrollViewer Grid.Row="1"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="btnGrid" Margin="2,0,0,0" MinWidth="80" HorizontalAlignment="Left"
              Content="{Binding IsGridMode, Mode=OneWay, 
                          Converter={StaticResource GridViewToContentConverter}, 
                          ConverterParameter=0}"
              ToolTip="{Binding IsGridMode, Mode=OneWay, 
                          Converter={StaticResource GridViewToContentConverter}, 
                          ConverterParameter=1}"
              IsChecked="{Binding IsGridMode, Mode=TwoWay}"/>
          <RepeatButton x:Name="btnZoomOut" Margin="2,0,0,0" HorizontalAlignment="Left"
                        Command="{x:Static comand:UIGeneralCommands.ZoomOut}"
                        Delay="{Binding Source={x:Static properties:Settings.Default},Path=ZoomingDelay}"
                        Interval="{Binding Source={x:Static properties:Settings.Default},Path=ZoomingInterval}"
                        ToolTip="{x:Static properties:Resources.ZoomOut}">
            <Image Source="{StaticResource SGZoomOut}" Stretch="Uniform" Width="32" Height="32" VerticalAlignment="Center"
              ToolTip="{x:Static properties:Resources.ZoomOut}"
              HorizontalAlignment="Center" IsHitTestVisible="False"/>
          </RepeatButton>
          <RepeatButton x:Name="btnZoomIn" Margin="2,0,0,0" HorizontalAlignment="Left"
                        Command="{x:Static comand:UIGeneralCommands.ZoomIn}"
                        Delay="{Binding Source={x:Static properties:Settings.Default},Path=ZoomingDelay}" 
                        Interval="{Binding Source={x:Static properties:Settings.Default},Path=ZoomingInterval}"
                        ToolTip="{x:Static properties:Resources.ZoomIn}">
            <Image Source="{StaticResource SGZoomIn}" Stretch="Uniform" Width="32" Height="32" VerticalAlignment="Center"
              ToolTip="{x:Static properties:Resources.ZoomIn}"
              HorizontalAlignment="Center" IsHitTestVisible="False"/>
          </RepeatButton>

           <RadioButton x:Name="btnCopyLink" GroupName="mergeCode" Margin="2,0,0,0" MinWidth="80" Grid.Column="2" HorizontalAlignment="Left"
                        Padding="4"
                        IsChecked="{Binding IsMergable, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                        Click="btnDropLink_Click" Style="{DynamicResource RadioButtonStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="{StaticResource SGLink}" Stretch="None" VerticalAlignment="Center" ToolTip="{x:Static properties:Resources.Linked}"
              HorizontalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock HorizontalAlignment="Center" Text="{x:Static properties:Resources.DropLink}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="btnMergeCode"  GroupName="mergeCode" Margin="2,0,0,0" MinWidth="80" Grid.Column="3" HorizontalAlignment="Left"
                         Padding="4"
                         Content="{x:Static properties:Resources.Merge}"
                         IsChecked="{Binding IsMergable, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         Click="btnMergeCode_Click"  Style="{DynamicResource RadioButtonStyle}"/>
          <Button x:Name="btnProtectKey" Margin="2,0,0,0" MinWidth="80" Grid.Column="4"
                         Content="{x:Static properties:Resources.ProtectKey}"
                         Click="btnProtectKey_Click"/>

        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
