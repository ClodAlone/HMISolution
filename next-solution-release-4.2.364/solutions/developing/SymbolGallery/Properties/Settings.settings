<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="SymbolGallery.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultSymbolFolder" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Project Symbols</Value>
    </Setting>
    <Setting Name="MaxZoomGallery" Type="System.Double" Scope="Application">
      <Value Profile="(Default)">200</Value>
    </Setting>
    <Setting Name="MinZoomGallery" Type="System.Double" Scope="Application">
      <Value Profile="(Default)">20</Value>
    </Setting>
    <Setting Name="ZoomingStep" Type="System.Double" Scope="Application">
      <Value Profile="(Default)">5</Value>
    </Setting>
    <Setting Name="ZoomingDelay" Type="System.Double" Scope="Application">
      <Value Profile="(Default)">500</Value>
    </Setting>
    <Setting Name="ZoomingInterval" Type="System.Double" Scope="Application">
      <Value Profile="(Default)">33</Value>
    </Setting>
  </Settings>
</SettingsFile>