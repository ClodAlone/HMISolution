<UserControl x:Class="SymbolGallery.Controls.KeyControlMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Height="200" Width="400">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SymbolGallery.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock  Margin="20,10,10,0" x:Name="textBox" FontFamily="Segoe UI" FontWeight="Normal" FontSize="18" TextWrapping="WrapWithOverflow"
                   Text="" VerticalAlignment="Top" Height="180" />
        <Image x:Name="image" Margin="10,10,10,10" Source="{StaticResource SGSprotected}" Grid.Column="1" VerticalAlignment="Top" Width="32" Height="32"/>
    </Grid>
</UserControl>
