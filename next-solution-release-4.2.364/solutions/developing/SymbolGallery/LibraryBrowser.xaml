<UserControl x:Class="SymbolGallery.LibraryBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:local="clr-namespace:SymbolGallery"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <local:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <dxb:BarContainerControl ContainerType="Top" x:Name="toolbarTabLibrary" Margin="2,0,0,0">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
              <dxb:BarButtonItem Content="{x:Static local:Properties.Resources.NewFolder}" x:Name="btnNewFolder" ItemClick="btnNewFolder_Click"/>
              <dxb:BarItemSeparator />
              <dxb:BarButtonItem Content="{x:Static local:Properties.Resources.DeleteFolder}" x:Name="btnDeleteFolder" ItemClick="btnDeleteFolder_Click"/>
              <dxb:BarCheckItem IsVisible="False" Content="{x:Static local:Properties.Resources.DropLink}" x:Name="btnCopyLink" ItemClick="btnDropLink_Click"/>
                <dxb:BarCheckItem IsVisible="False" Content="{x:Static local:Properties.Resources.Merge}" x:Name="btnMergeCode"  IsEnabled="{Binding bIsEditable, UpdateSourceTrigger=PropertyChanged}" ItemClick="btnMergeCode_Click"/>
              <dxb:BarCheckItem IsVisible="False" Content="{x:Static local:Properties.Resources.ProtectKey}" x:Name="btnProtectKey" ItemClick="btnProtectKey_Click"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>
            
      <dxg:TreeListControl x:Name="treeListControl" SelectionMode="Row" x:Shared="False" Grid.Row="1"
                                       SelectionChanged="treeListControl_SelectionChanged">
        <dxg:TreeListControl.Columns>
          <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="ItemHeader" />
          <!-- Validate="OnTreeHeaderValidate" -->
        </dxg:TreeListControl.Columns>
        <dxg:TreeListControl.View>
          <dxg:TreeListView x:Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                  MultiSelectMode="None" RowDoubleClick="OnRowDoubleClick"
                                  ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                  AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                  ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                  BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch"  VerticalAlignment="Top"
                                  IsSynchronizedWithCurrentItem="True" AllowDragDrop="False"
                                  NodeExpanding="OnTreeNodeExpanding"  NodeCollapsing="OnTreeNodeCollapsing"
                                  AutoWidth="True">
            <!--DropRecord="TreeListControl_DragEnd" DragRecordOver="TreeListControl_DragRecordOver"
            StartRecordDrag="TreeListControl_DragStart" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"
            NodeExpanding="OnTreeNodeExpanding"  NodeCollapsing="OnTreeNodeCollapsing"-->
            <!--<dxg:TreeListView.RowStyle>
              <Style TargetType="{x:Type dxg:RowControl}">
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </dxg:TreeListView.RowStyle>-->
            <dxg:TreeListView.CellStyle>
              <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
              </Style>
            </dxg:TreeListView.CellStyle>
          </dxg:TreeListView>
        </dxg:TreeListControl.View>
      </dxg:TreeListControl>

      <ListBox Grid.Row="1" HorizontalAlignment="Stretch" Name="listBoxFound" VerticalAlignment="Stretch" 
                 Background="{x:Null}" SelectionChanged="listBoxRecent_SelectionChanged" Visibility="Collapsed">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource UriConverter}}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Height="20" Width="15" Click="btnClose_Click" Margin="2,2,2,2" x:Name="btnClose"
                VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button.Content>
                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>

        <ProgressBar x:Name="progressBar" IsIndeterminate="True" Visibility="Collapsed" Minimum="10"
                     Height="10" VerticalAlignment="Bottom" Margin="2,2,2,2"/>
    </Grid>
</UserControl>
