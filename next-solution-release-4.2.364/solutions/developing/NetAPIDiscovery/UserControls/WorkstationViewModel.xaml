<UserControl x:Class="NetAPIDiscovery.UserControls.WorkstationViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:NetAPIDiscovery.Properties"
    FocusManager.FocusedElement="{Binding ElementName=HostNameTxt}"
    Height="80" Width="300">
    
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock FontStyle="Italic"
          Foreground="Red"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>

        <!-- Url-->
        <Label Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.WorkStationHostName}" 
      HorizontalAlignment="Right"
      Target="{Binding ElementName=firstNameTxt}"
      />
        <TextBox x:Name="HostNameTxt"
      Grid.Row="1" Grid.Column="2" 
      Text="{Binding Path=Title, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
      Validation.ErrorTemplate="{x:Null}"
      />
        <ContentPresenter Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left"
      Content="{Binding ElementName=HostNameTxt, Path=(Validation.Errors).CurrentItem}"
      />

    </Grid>
</UserControl>
