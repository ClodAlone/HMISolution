<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UFProjectWizard"
    x:Class="UFProjectWizard.WizardUI"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:command="clr-namespace:WizardPluginHelpers;assembly=WizardPluginHelpers"
    Height="500" MinHeight="50" MinWidth="50" Width="690">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/SharedResources;component/Resources/UFProjectWizard.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>
    <DockPanel  Grid.Row="0"
                      HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
      <command:HeaderControl x:Name="headerControl"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </DockPanel>
        <ListBox Grid.Row="1" Grid.Column="2" x:Name="listBoxPlugins" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Background="{x:Null}"
            BorderBrush="{x:Null}"
            AlternationCount="1"
            Margin="2"
            HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
                <ContentControl PreviewMouseLeftButtonUp="listBoxPlugins_PreviewMouseLeftButtonUp" MouseDoubleClick="listBoxPlugins_MouseDoubleClick">
                    <Grid Tag="{Binding}" MinHeight="90" MinWidth="90" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <Image Stretch="Uniform" Source="{Binding Image}" Width="64" Height="64"/>
                        <TextBlock Grid.Row="1" Text="{Binding Description}"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Center"
                                        TextWrapping="WrapWithOverflow"/>
                    </Grid>
                </ContentControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
    </ListBox>
    <DockPanel  Grid.Row="2"
                 HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
      <command:FooterControl x:Name="footerControl" 
                             ShowHelpButton="True"
                             ShowNavButtons="False"
                             ShowFinishButton="True"
                             Help="footerControl_Help"
                             Cancel="footerControl_Cancel"
                             Finish="footerControl_Finish"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </DockPanel>
  </Grid>
</UserControl>
