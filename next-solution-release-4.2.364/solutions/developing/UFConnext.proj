<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<Import Project=".\MSBuild.Tasks\MSBuild.Mercurial.Tasks" />
	<Import Project=".\MSBuild.Tasks\MSBuild.Community.Tasks.Targets" />

 	<PropertyGroup>
  		<BuildOutputDir>.\UFSolution\bin\Connext_Release</BuildOutputDir>
		<BuildRetailDir>.\UFSolution\bin\Retail.Connext</BuildRetailDir>
		<BuildPublishDir>.\UFSolution\bin\NetCore.Connext</BuildPublishDir>
	  	<SolutionToCompile>UFSolution.sln</SolutionToCompile>
		<MSBuildMercurialPath>.</MSBuildMercurialPath>
		<!-- Set this property to true to build without incrementing the assembly version. -->
		<SkipIncrementAssemblyVersion Condition=" '$(SkipIncrementAssemblyVersion)' == '' " >false</SkipIncrementAssemblyVersion>
		<!-- Set this property to empty string to skip the singing of compiled files -->
		<CertFriendlyName>PROGEA SRL</CertFriendlyName>
		<CoreFlagsTool>C:\Program Files (x86)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools\CorFlags.exe</CoreFlagsTool>		
 	</PropertyGroup>

	<Target Name="GetHgVersion">
		<HgVersion LocalPath="$(MSBuildProjectDirectory)" Timeout="30000">
			<Output TaskParameter="Revision" PropertyName="HgRevision" />
			<Output TaskParameter="Changeset" PropertyName="HgChangeset" />
		</HgVersion>
		<Message Text="Last revision (changeset) from Kiln: $(HgRevision) ($(HgChangeset))" />
	</Target>

	<Target Name="SetVersionInfo">
	<Attrib Files="AssemblyVersionInfo.txt" ReadOnly="false"/>
    	<Version	
		Condition=" '$(SkipIncrementAssemblyVersion)' == 'true' "
		VersionFile="AssemblyVersionInfo.txt"
	         BuildType="None"
		RevisionType="None">
		<Output TaskParameter="Major" PropertyName="Major" />
		<Output TaskParameter="Minor" PropertyName="Minor" />
		<Output TaskParameter="Build" PropertyName="Build" />
		<Output TaskParameter="Revision" PropertyName="Revision" />
	</Version>

	<Version 
		Condition=" '$(SkipIncrementAssemblyVersion)' != 'true' "
		VersionFile="AssemblyVersionInfo.txt"
		BuildType="Increment"
		RevisionType="None">
		<Output TaskParameter="Major" PropertyName="Major" />
		<Output TaskParameter="Minor" PropertyName="Minor" />
		<Output TaskParameter="Build" PropertyName="Build" />
		<Output TaskParameter="Revision" PropertyName="Revision" />
	</Version>

	<PropertyGroup>
		<BuildNumber>$(Major).$(Minor).$(Build).$(HgRevision)</BuildNumber>
	</PropertyGroup>
		<Message Importance="high" Text="Build number set to &quot;$(BuildNumber)&quot;" />

	<AssemblyInfo
                  CodeLanguage="CS"
                  OutputFile="AssemblyVersionInfo.cs"
                  AssemblyFileVersion="$(BuildNumber)" />

	<PropertyGroup>
		<VersionNumber>$(Major).$(Minor).0.0</VersionNumber>
	</PropertyGroup>

	<FileUpdate Files="SharedAssemblyInfo.cs"
            Regex="AssemblyVersion\(&quot;.*&quot;\)\]"
            ReplacementText="AssemblyVersion(&quot;$(VersionNumber)&quot;)]" />
	
	</Target>

	<Target Name="Clean">
		<RemoveDir Directories="$(BuildOutputDir)" />
		<RemoveDir Directories="$(BuildRetailDir)" />
		<RemoveDir Directories="$(BuildPublishDir)" />
		<RemoveDir Directories="$(BuildOutputDir).obfuscated" />
		<RemoveDir Directories="$(BuildRetailDir).obfuscated" />
		<RemoveDir Directories="$(BuildPublishDir).obfuscated" />
	</Target>
	
	<Target Name="Restore">
		<MSBuild Projects="$(SolutionToCompile)" Targets="Restore" StopOnFirstFailure="false" ContinueOnError="true" 
				Properties="Configuration=Release;Platform=Any CPU" />
		<Exec Command="dotnet.exe restore $(SolutionToCompile)" ContinueOnError="WarnAndContinue" />
	</Target>

	<Target Name="PreBuild">
		<!-- Tile has been removed on new WebClient HTML5 responsive version
		<Exec Command="CALL .\UFWebClient.HTML5\js\CombineJS.bat" ContinueOnError="WarnAndContinue" />
		-->
	</Target>

	<Target Name="AfterBuild">
		<!-- replace 'OPCUAClient.Config.xml' with release version -->
		<!--<Exec Command="XCOPY /Y $(BuildOutputDir)\OPCUAClient.Config.Release.xml $(BuildOutputDir)\OPCUAClient.Config.xml" ContinueOnError="WarnAndContinue" />
		<Exec Command="DEL /Q $(BuildOutputDir)\OPCUAClient.Config.Release.xml" />-->
		
		<Exec Command="XCOPY /Y $(BuildOutputDir)\net48\Utilities.dll $(BuildOutputDir)\" ContinueOnError="WarnAndContinue" />

		<!-- create retail folder and move files inside -->
		<MakeDir Directories="$(BuildRetailDir)" />
		<MakeDir Directories="$(BuildRetailDir)\WizardPlugins" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\Connext.* $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\ConnextIOServer.* $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\UFUAServerBase.* $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\SystemTrayService.* $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\Utilities.* $(BuildRetailDir)\" ContinueOnError="WarnAndContinue" />
		<Exec Command="XCOPY /Y $(BuildOutputDir)\WizardPlugins\EmptyProjectWizardPlugin.* $(BuildRetailDir)\WizardPlugins\" ContinueOnError="WarnAndContinue" />
		
		<!-- copy NetCore assemblies -->
		<MakeDir Directories="$(BuildPublishDir)" />
		<Exec Command="XCOPY /Y .\UFUAServerApp.Core\bin\Connext_Release\netcoreapp2.0\ConnextIOServer.Core.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />		
		<Exec Command="XCOPY /Y .\UFUAServerApp.Core\bin\Connext_Release\netcoreapp2.0\UFUAServerBase.* $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />	
		<Exec Command="XCOPY /Y $(BuildOutputDir)\netstandard2.0\Utilities.dll $(BuildPublishDir)\" ContinueOnError="WarnAndContinue" />

		<!-- add/remove files to delete changing 'FileToDelete.txt" file -->
		<ReadLinesFromFile File="FilesToDelete.txt">
			<Output TaskParameter="Lines" ItemName="FilesToDelete" />
		</ReadLinesFromFile>

		<CombinePath BasePath="$(BuildRetailDir)" Paths="@(FilesToDelete)">
		            <Output TaskParameter="CombinedPaths" ItemName="FilesToDeleteWithPath" />
		</CombinePath >
		
		<Exec Command="DEL /F /S /Q @(FilesToDeleteWithPath)" ContinueOnError="WarnAndContinue" />

	</Target>
	
	<Target Name="PreCompile">
	<!-- Nothing to do -->
	</Target>
	
	<Target Name="AfterCompile">
		<Exec Command="dotNET_Reactor.Console.exe -project &quot;NetHashing-Connext.nrproj&quot; -cert_friendly_name &quot;$(CertFriendlyName)&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command="dotNET_Reactor.Console.exe -project &quot;DotNetHashing-Connext.nrproj&quot; -cert_friendly_name &quot;$(CertFriendlyName)&quot;" ContinueOnError="ErrorAndStop" />
		
		<!-- ArrayIndex Hashing (32 bits) -->
		<Exec Command="XCOPY /Y .\UFSolution\bin\Obfuscated.Connext\net48\Connext.exe .\UFSolution\bin\Obfuscated.Connext\net48_x86\" ContinueOnError="ErrorAndStop" />
		<Exec Command="&quot;$(CoreFlagsTool)&quot; .\UFSolution\bin\Obfuscated.Connext\net48_x86\Connext.exe /32BITREQ+" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash3_x86&quot; /S&quot;.\UFSolution\bin\Obfuscated.Connext\net48_x86\Connext.exe&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		
		<!-- ArrayIndex Hashing -->
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash3&quot; /S&quot;.\UFSolution\bin\Obfuscated.Connext\net48\Connext.exe&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash4_1&quot; /S&quot;.\UFSolution\bin\Obfuscated.Connext\net48\UFUAServerBase.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />
		<Exec Command=".\GenerateHash\bin\Release\GenerateHash.exe /C /V&quot;ohash4_2&quot; /S&quot;.\UFSolution\bin\Obfuscated.Connext\netstandard2.0\UFUAServerBase.dll&quot; /D&quot;.\Utilities\AssemblyInfo.cs&quot;" ContinueOnError="ErrorAndStop" />

		<MSBuild Projects=".\Utilities\Utilities.csproj" ContinueOnError="ErrorAndStop" 
		     Properties="Configuration=Connext_Release;Platform=AnyCPU;DebugType=none;GenerateDocumentation=false;DefineTrace=false;RunCodeAnalysis=False;BaseOutputPath=C:\Temp\bin\Release\" />
	</Target>
	
	<Target Name="Compile">
		<MakeDir Directories="$(OutputDirectory)" />
		<CallTarget Targets="PreBuild"/>
		<CallTarget Targets="PreCompile"/>
		<MSBuild Projects="$(SolutionToCompile)" ContinueOnError="ErrorAndContinue" 
		     Properties="Configuration=Connext_Release;Platform=Any CPU;DebugType=none;GenerateDocumentation=false;DefineTrace=false;DeployOnBuild=true;DeployTarget=Package;AutoParameterizationWebConfigConnectionStrings=False;RunCodeAnalysis=False" />
		<CallTarget Targets="AfterCompile"/>			 
		<CallTarget Targets="AfterBuild"/>			 
	</Target>

	<Target Name="Build" DependsOnTargets="Clean;Restore;Compile">
		<Message Text="Finish to build version $(BuildNumber)"/>
	</Target>
</Project>