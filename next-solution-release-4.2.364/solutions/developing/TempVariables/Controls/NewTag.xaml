<UserControl x:Class="TempVariablesManager.Controls.NewTag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="300" Height="219" d:DesignWidth="300" 
             xmlns:properties="clr-namespace:TempVariablesManager.Properties"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <utilities:ItemsCountConverter x:Key="ItemsCountConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
                <!--<RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.TagProperties}" VerticalAlignment="Center" FontWeight="Bold" />

        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.TagName}" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
        <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.TagDescription}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Description}" x:Name="textEditDesc" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.TagData}" VerticalAlignment="Center" Visibility="Visible" x:Name="textDataType" />
        <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding DataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                x:Name="comboDataType" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboDataType_SelectionChanged" />
        <ContentPresenter Grid.Row="3" Grid.Column="2" 
        Content="{Binding ElementName=comboDataType, Path=(Validation.Errors).CurrentItem}"/>

            <!--<TextBlock Grid.Row="5" Text="{x:Static properties:Resources.TagData}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textDataType" />
            <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding DataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                  x:Name="comboDataType" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboDataType_SelectionChanged" />
            <ContentPresenter Grid.Row="3" Grid.Column="2" 
            Content="{Binding ElementName=comboDataType, Path=(Validation.Errors).CurrentItem}"/>-->
        
            <!--<TextBlock Grid.Row="4" Text="{x:Static properties:Resources.TagModel}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" Grid.Row="4" SelectedValue="{Binding ModelType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                  x:Name="comboModelType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboModelType_SelectionChanged" />
        <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=comboModelType, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.TagData}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textDataType" />
        <ComboBox Grid.Column="1" Grid.Row="5" SelectedValue="{Binding DataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                  x:Name="comboDataType" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboDataType_SelectionChanged" />
        <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=comboDataType, Path=(Validation.Errors).CurrentItem}"/>-->

         <!--<TextBlock x:Name="textBlockRetentive" Grid.Row="4" Text="{x:Static properties:Resources.TagRetentive}" VerticalAlignment="Center" />
        <CheckBox x:Name="checkBoxRetentive" Grid.Column="1" Grid.Row="4" IsChecked="{Binding IsRetentive}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>-->

        <TextBlock x:Name="textBlockArrayDimension" Grid.Row="4" Text="{x:Static properties:Resources.TagArray}" VerticalAlignment="Center" />
        <dxe:SpinEdit Grid.Row="4" Grid.Column="1" MinValue="0" MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding ArrayDimension, UpdateSourceTrigger=PropertyChanged}" />
            <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=textArrayDimension, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock x:Name="textBlockInitialValue" Grid.Row="5" Text="{x:Static properties:Resources.TagInitial}" VerticalAlignment="Center" />
        <TextBox x:Name="textInitialValue" Grid.Column="1" Grid.Row="5" 
                 Text="{Binding InitialValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=textInitialValue, Path=(Validation.Errors).CurrentItem}"/>

       <!--<TextBlock Grid.Row="12" Text="{x:Static properties:Resources.TagEnum}" VerticalAlignment="Center" x:Name="textEnumStrings"/>
            <DockPanel x:Name="dockEnumStrings" Grid.Column="1" Grid.Row="12" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <TextBox Text="{Binding EnumStringsFlat, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" x:Name="textEditEnumStrings" 
                         VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </DockPanel>
            <ContentPresenter Grid.Row="12" Grid.Column="2" 
                Content="{Binding ElementName=textEditEnumStrings, Path=(Validation.Errors).CurrentItem}"/>-->
        </Grid>
    </ScrollViewer>
</UserControl>
