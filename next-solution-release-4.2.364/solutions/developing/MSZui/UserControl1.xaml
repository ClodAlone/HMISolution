<UserControl x:Class="MSZui.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:MSZui.Properties"
             mc:Ignorable="d" d:DesignHeight="420" d:DesignWidth="720"

             Width="{Binding Path=ActualWidth, ElementName=splashContent, Mode=OneWay}" Height="{Binding Path=ActualHeight, ElementName=splashContent, Mode=OneWay}">
    <Grid>
        <ContentControl x:Name="splashContent" />
        <Label FontWeight="Bold" Margin="0,0,0,115" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="{x:Static properties:Resources.EvaluationMode}" FontSize="27" FontFamily="Arial"  Foreground="WhiteSmoke" 
              x:Name="evaluationLabel" />
        <Button FontSize="12" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,60" Width="120" Height="50" x:Name="btnClose" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsEnabled="False" IsCancel="True" />
    </Grid>
</UserControl>
