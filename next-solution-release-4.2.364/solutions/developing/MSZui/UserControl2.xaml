    </UserControl.Resources>    
    <Grid x:Name="layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="90*" />
            <!--<RowDefinition Height="10*" />-->
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">
            <StackPanel Margin="10,10" Orientation="Vertical">
                <TextBlock Grid.Row="0" Foreground="White" x:Name="txtText" Text="{x:Static properties:Resources.KeyTitle}"/>
            </StackPanel>
            <StackPanel Margin="10,20" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                <TextBlock TextWrapping="Wrap" x:Name="txtLabelLicence" MaxWidth="300" Foreground="White" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.licenseNotFound}"/>
                <Label x:Name="txtLabelExpiringDate" Foreground="White" HorizontalAlignment="Stretch" Content=""/>
                <Label x:Name="txtSerial" Foreground="White" HorizontalAlignment="Stretch" Content=""/>
                <Label x:Name="txtNetState" Foreground="White" HorizontalAlignment="Stretch" Content=""/>
            </StackPanel>
            <StackPanel Margin="10,20" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <Label x:Name="txtLabelKey" Foreground="White" HorizontalAlignment="Stretch" Content="{x:Static properties:Resources.SiteCode}"/>
                <TextBox Margin="20,0" x:Name="txtBox" Width="Auto" MinWidth="250" IsReadOnly="True" PreviewMouseLeftButtonDown="SelectAll_onMouseDown" GotKeyboardFocus="SelectAll_onFocus" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Grid  Margin="20">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Button x:Name="btnGet"  Margin="5" MinHeight="26" MinWidth="140" Click="btnGet_Click" Content="{x:Static properties:Resources.GetLicence}" Visibility="Collapsed"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="White" x:Name="txtLabel" Width="Auto" Text="{x:Static properties:Resources.GetLicenceDesc}" Visibility="Collapsed" />

              <Button Grid.Row="1" Margin="5" x:Name="btnGet1" MinHeight="26" MinWidth="140" Click="btnActivate_Click" Content="{x:Static properties:Resources.ActivateLicence}"/>
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Grid.Column="1" Margin="20,0,0,0" Foreground="White" x:Name="txtLabel1" Width="Auto" HorizontalAlignment="Left" Text="{x:Static properties:Resources.ActivateLicenceDesc}"/>
              
              <Button Grid.Row="2" Margin="5" x:Name="btnSuspend" MinHeight="26" MinWidth="140" Click="btnSuspend_Click" Content="{x:Static properties:Resources.DongleSuspendLicence}"/>
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Grid.Column="1" Margin="20,0,0,0" Foreground="White" x:Name="txtSuspend" Width="Auto" HorizontalAlignment="Left" Text="{x:Static properties:Resources.DongleSuspendLicenceHelp}"/>

              <Button Grid.Row="3" Margin="5" x:Name="btnRemove" MinHeight="26" MinWidth="140" Click="btnRemove_Click" Content="{x:Static properties:Resources.DongleRemoveLicence}"/>
              <TextBlock Grid.Row="3" VerticalAlignment="Center" Grid.Column="1" Margin="20,0,0,0" TextWrapping="Wrap" Foreground="White" x:Name="txtRemove" Width="Auto" HorizontalAlignment="Left" Text="{x:Static properties:Resources.DongleRemoveLicenceHelp}"/>
            </Grid>

        </StackPanel>
        <!--<Button Style="{StaticResource normalButtonStyle}"  Grid.Row="1" Margin="0,0,0,12" IsEnabled="False" x:Name="finishButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="100" Height="30" Content="Ok" Click="finishButton_Click" />-->
        <cc:CircularProgressBar Grid.RowSpan="2"  Background="Black" Visibility="Collapsed" x:Name="busyControl" Opacity="0.3"/>
        <TextBlock x:Name="busyContent"  Visibility="Collapsed"  Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" 
                       Grid.RowSpan="2" Grid.ColumnSpan="2"  HorizontalAlignment="Center" Foreground="White" />
    </Grid>
</UserControl>
