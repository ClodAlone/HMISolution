<UserControl x:Class="MSZui.UserControl3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:MSZui.Properties"
             xmlns:options="clr-namespace:MSZui"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:conv="clr-namespace:MSZui.Converters"
             x:Name="userControl"
             mc:Ignorable="d" 
             Height="650" Width="530">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:ExpiringDateConverter x:Key="ExpiringDateConverter" />
        <conv:NetStateConverter x:Key="NetStateConverter" />
        <conv:SerialNumberConverter x:Key="SerialNumberConverter" />
        <conv:IOTagsNumberConverter x:Key="IOTagsNumberConverter" />
    </UserControl.Resources>

    <ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel x:Name="mainGroup" Orientation="Vertical">
                <TextBlock x:Name="optionTitle" Text="{x:Static properties:Resources.OptionsTitle}"/>
                <Grid Margin="10" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Orientation="Vertical">
                        <Label x:Name="txtLabelLicence" HorizontalAlignment="Stretch">
                            <Label.Content>
                                <MultiBinding Converter="{StaticResource NetStateConverter}">
                                    <Binding Path="NetState" Mode="OneWay" />
                                    <Binding Path="MSZMSZViewCheckState" Mode="OneWay" />
                                </MultiBinding>
                            </Label.Content>
                        </Label>
                        <Label x:Name="txtLabelExpiringDate" Visibility="{DXBinding '!MSZMSZViewCheckState', Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch" Content="{Binding ExpiringDate, Mode=OneWay, Converter={StaticResource ExpiringDateConverter}}" />
                        <Label x:Name="txtSerial" Visibility="{DXBinding '!MSZMSZViewCheckState and !string.IsNullOrEmpty(SerialNumber) and !SerialNumber.Equals(`0`)', Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch" Content="{Binding SerialNumber, Mode=OneWay, Converter={StaticResource SerialNumberConverter}}" />
                        <Grid x:Name="remoteLicenseInfo" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Label x:Name="lblLicenseType" Content="{x:Static properties:Resources.RemoteLicenseType}" />
                                <Label Margin="5,0,0,0" Content="{Binding LicenseType, Mode=OneWay}" />
                            </StackPanel>
                            <Label Grid.Row="1" x:Name="lblSiteCode" Content="{x:Static properties:Resources.SiteCode}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="20,0" Text="{Binding SiteCode, Mode=OneWay}" Width="Auto" MinWidth="250" IsReadOnly="True" PreviewMouseLeftButtonDown="SelectAll_onMouseDown" GotKeyboardFocus="SelectAll_onFocus" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <!--<Label x:Name="txtNetState" FontSize="14px" HorizontalAlignment="Stretch" Visibility="Visible"/>-->
                    </StackPanel>
                    <Separator Grid.Row="1" Margin="0,10,0,10" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- COLUMN0 -->
                        <Grid Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TIOption1" Text="{x:Static options:OptionResources.IOption1}" Margin="2" />
                            <TextBox IsHitTestVisible="False" x:Name="IOption1" Text="{Binding IOTagsNumber, Mode=OneWay, Converter={StaticResource IOTagsNumberConverter}}" IsReadOnly="True" Grid.Column="1" Margin="2" />
                            <!--<TextBlock x:Name="TIOption2" Text="{x:Static options:OptionResources.IOption2}" Grid.Row="1" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption2" IsReadOnly="True" Grid.Row="1" Grid.Column="1" Margin="2" />-->
                            <TextBlock x:Name="TIOption3" Text="{x:Static options:OptionResources.IOption3}" Grid.Row="2" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption3" Text="{Binding DriversEnabled, Mode=OneWay}" IsReadOnly="True" Grid.Row="2" Grid.Column="1" Margin="2" />
                            <TextBlock x:Name="TIOption4" Text="{x:Static options:OptionResources.IOption4}" Grid.Row="3" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption4" Text="{Binding ChildProjectsNo, Mode=OneWay}" IsReadOnly="True" Grid.Row="3" Grid.Column="1" Margin="2" />
                            <TextBlock x:Name="TIOption5" Text="{x:Static options:OptionResources.IOption5}" Grid.Row="4" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption5" Text="{Binding NumberOfScreens, Mode=OneWay}" IsReadOnly="True" Grid.Row="4" Grid.Column="1" Margin="2" />
                            <TextBlock x:Name="TIOption6" Text="{x:Static options:OptionResources.IOption6}" Grid.Row="5" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption6" Text="{Binding NumberOfAlarms, Mode=OneWay}" IsReadOnly="True" Grid.Row="5" Grid.Column="1" Margin="2" />
                            <TextBlock x:Name="TIOption7" Text="{x:Static options:OptionResources.IOption7}" Grid.Row="6" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption7" Text="{Binding WebClientUsers, Mode=OneWay}" IsReadOnly="True" Grid.Row="6" Grid.Column="1" Margin="2" />
                            <TextBlock x:Name="TIOption11" Text="{x:Static options:OptionResources.IOption11}" Grid.Row="7" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption11" Text="{Binding ConcurrentIODataServers, Mode=OneWay}" IsReadOnly="True" Grid.Row="7" Grid.Column="1" Margin="2" />
                            <TextBlock x:Name="TIOption8" Text="{x:Static options:OptionResources.IOption8}" Grid.Row="8" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption8" Text="{Binding NETLicenseUsers, Mode=OneWay}" IsReadOnly="True" Grid.Row="8" Grid.Column="1" Margin="2" />
                            <Separator x:Name="sepProOptions" Visibility="{Binding ClientOptions, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="9" Grid.ColumnSpan="2"  Margin="5,10,5,10" />
                            <TextBlock x:Name="TIOption9" Visibility="{Binding ClientOptions, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{x:Static options:OptionResources.IOption9}" Grid.Row="10" Margin="2" />
                            <TextBox IsHitTestVisible="False"  x:Name="IOption9" Visibility="{Binding ClientOptions, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding ProEnergyPoints, Mode=OneWay}" IsReadOnly="True" Grid.Row="10" Grid.Column="1" Margin="2" />
                            <TextBlock  x:Name="TIOption10" Visibility="{Binding ClientOptions, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{x:Static options:OptionResources.IOption10}" Grid.Row="11" Margin="2" />
                            <TextBox x:Name="IOption10" Visibility="{Binding ClientOptions, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding ProLeanOEE, Mode=OneWay}" IsReadOnly="True" Grid.Row="11" Grid.Column="1" Margin="2" />
                            <Separator Grid.Row="12" Grid.ColumnSpan="2" Margin="5,10,5,10" />
                            <TextBlock HorizontalAlignment="Left" Text="{x:Static properties:Resources.SpecialDrivers}" Grid.Row="13" Margin="2" />
                            <CheckBox IsHitTestVisible="False" x:Name="BOption17" IsChecked="{Binding DriverBasic, Mode=OneWay}" Content="{x:Static options:OptionResources.BOption17}" Grid.Row="14" Grid.Column="1" Margin="2" />
                            <CheckBox IsHitTestVisible="False" x:Name="BOption18" IsChecked="{Binding DriverAutomation, Mode=OneWay}" Content="{x:Static options:OptionResources.BOption18}" Grid.Row="15" Grid.Column="1" Margin="2" />
                            <CheckBox IsHitTestVisible="False" x:Name="BOption19" IsChecked="{Binding DriverTelemetry, Mode=OneWay}" Content="{x:Static options:OptionResources.BOption19}" Grid.Row="16" Grid.Column="1" Margin="2" />
                            <CheckBox IsHitTestVisible="False" x:Name="BOption20" IsChecked="{Binding DriverFacilities, Mode=OneWay}" Content="{x:Static options:OptionResources.BOption20}" Grid.Row="17" Grid.Column="1" Margin="2" />
                            <CheckBox IsHitTestVisible="False" x:Name="BOption21" IsChecked="{Binding DriverIoT, Mode=OneWay}" Content="{x:Static options:OptionResources.BOption21}" Grid.Row="18" Grid.Column="1" Margin="2" />
                        </Grid>
                        <!-- COLUMN1 -->
                        <Grid Grid.Column="1" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static properties:Resources.OptionsEnabled}" />
                            <Grid Grid.Row="1" x:Name="iOptionContainer1">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <CheckBox IsHitTestVisible="False" x:Name="BOption2" IsChecked="{Binding LicenseEditor, Mode=OneWay}" Content="{x:Static options:OptionResources.BOption2}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption3" IsChecked="{Binding LicenseServerRT, Mode=OneWay}" Grid.Row="1" Content="{x:Static options:OptionResources.BOption3}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption4" IsChecked="{Binding LicenseClientRT, Mode=OneWay}" Grid.Row="2" Content="{x:Static options:OptionResources.BOption4}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption23" IsChecked="{Binding LicenseNetCore, Mode=OneWay}" Grid.Row="3" Content="{x:Static options:OptionResources.BOption23}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption5" IsChecked="{Binding LicenseHistorianDatalogger, Mode=OneWay}" Grid.Row="4" Content="{x:Static options:OptionResources.BOption5}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption6" IsChecked="{Binding LicenseRecipes, Mode=OneWay}" Grid.Row="5" Content="{x:Static options:OptionResources.BOption6}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption7" IsChecked="{Binding LicenseVBNET, Mode=OneWay}" Grid.Row="6" Content="{x:Static options:OptionResources.BOption7}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption8" IsChecked="{Binding LicenseScheduler, Mode=OneWay}" Grid.Row="7" Content="{x:Static options:OptionResources.BOption8}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption9" IsChecked="{Binding LicenseNetworking, Mode=OneWay}" Grid.Row="8" Content="{x:Static options:OptionResources.BOption9}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption12" IsChecked="{Binding LicenseReports, Mode=OneWay}" Grid.Row="9" Content="{x:Static options:OptionResources.BOption12}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption13" IsChecked="{Binding LicenseAlarmDispatcher, Mode=OneWay}" Grid.Row="10" Content="{x:Static options:OptionResources.BOption13}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption14" IsChecked="{Binding LicenseDowntimeAnalyzer, Mode=OneWay}" Grid.Row="11" Content="{x:Static options:OptionResources.BOption14}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption15" IsChecked="{Binding LicenseOPCUAServer, Mode=OneWay}" Grid.Row="12" Content="{x:Static options:OptionResources.BOption15}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption16" IsChecked="{Binding LicenseRedundancy, Mode=OneWay}" Grid.Row="13" Content="{x:Static options:OptionResources.BOption16}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption10" IsChecked="{Binding LicenseGeoScada, Mode=OneWay}" Grid.Row="14" Content="{x:Static options:OptionResources.BOption10}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption11" IsChecked="{Binding License3D, Mode=OneWay}" Grid.Row="15" Content="{x:Static options:OptionResources.BOption11}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption22" IsChecked="{Binding LicenseAR, Mode=OneWay}" Grid.Row="16" Content="{x:Static options:OptionResources.BOption22}" Margin="2" />
                                <CheckBox IsHitTestVisible="False" x:Name="BOption24" IsChecked="{Binding LicenseArray1, Mode=OneWay}" Grid.Row="17" Content="{x:Static options:OptionResources.BOption24}" Margin="2" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>
            <Viewbox Stretch="Fill" Visibility="{Binding MSZMSZViewCheckState, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="txtMode" IsHitTestVisible="False"
                 Width="{Binding ElementName=userControl, Path=Width}" Height="{Binding ElementName=userControl, Path=Height}" >
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" 
                       Text="{x:Static properties:Resources.ModeText}" Opacity="0.1">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-45"/>
                    </TextBlock.LayoutTransform>
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                    </TextBlock.Effect>
                </TextBlock>
            </Viewbox>
            <cc:CircularProgressBar  Grid.RowSpan="2" Background="Black" Visibility="Collapsed" x:Name="busyControl" Opacity="0.3"/>
            <TextBlock x:Name="busyContent" Visibility="Collapsed"  Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" 
                       Grid.RowSpan="2" Grid.ColumnSpan="2"  HorizontalAlignment="Center" Foreground="White" />
        </Grid>
    </ScrollViewer>
</UserControl>
