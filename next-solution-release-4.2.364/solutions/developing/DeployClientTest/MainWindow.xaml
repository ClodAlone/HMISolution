<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployClientTest"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" x:Class="DeployClientTest.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="User" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="textboxUser" Text="admin@progea.com"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Password" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="textboxPassword" Text="Ciccio@bello1"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Host" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="textboxHost" Text="https://localhost:44319"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Company Name" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="textboxCompanyName" Text="Progea"/>
        <Label Grid.Row="4" Grid.Column="0" Content="Application Name" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="textboxAppName" Text="Connext"/>


        <Button Grid.Row="5" Grid.Column="0" Content="Connect" Click="Button_Click" x:Name="btnConnect"/>
        <Button Grid.Row="5" Grid.Column="1" Content="Disconnect" Click="btnDisconnect_Click" x:Name="btnDisconnect" IsEnabled="False"/>
        <Button Grid.Row="6" Grid.Column="0" Content="Add Process" Click="Button_AddProcess_Click" x:Name="btnAddProcess" IsEnabled="False"/>
        <Button Grid.Row="6" Grid.Column="1" Content="Remove Process" Click="Button_RemoveProcess_Click" x:Name="btnRemoveProcess" IsEnabled="False"/>
        <Button Grid.Row="7" Grid.Column="0" Content="Platform Version" Click="btnPlatformVersion_Click" x:Name="btnPlatformVersion" IsEnabled="False"/>
        <Button Grid.Row="7" Grid.Column="1" Content="Process File Version" Click="btnProcessFileVersion_Click" x:Name="btnProcessFileVersion" IsEnabled="False"/>
        <Button Grid.Row="8" Grid.Column="0" Content="Install License" Click="btnInstallLicense_Click" x:Name="btnInstallLicense" IsEnabled="False"/>
        <Button Grid.Row="8" Grid.Column="1" Content="Check License" Click="btnCheckLicense_Click" x:Name="btnCheckLicense" IsEnabled="False"/>
        <dxg:GridControl Grid.Row="9" Grid.ColumnSpan="2" x:Name="dataGrid">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="name"
                                Header="Name"
                                Width="200"/>
                <dxg:GridColumn FieldName="cpuUsage"
                                Header="CPUUsage"
                                Width="200"/>
                <dxg:GridColumn FieldName="pagedMemorySize"
                                Header="PagedMemorySize"
                                Width="200"/>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView ShowTotalSummary="True"/>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</Window>
