<UserControl x:Class="UFProjectManager.ChildProjectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Path=Width}"
             Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Path=Height}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SharedResources;component/Resources/UFProject.xaml" />
          </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="stackButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="stackButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>

    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource MouseOverOpacity}" x:Name="MouseOver_BeginStoryboard" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource MouseLeaveOpacity}" x:Name="MouseLeave_BeginStoryboard" />
        </EventTrigger>
    </UserControl.Triggers>

    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu" ShowKeyGestures="True">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem x:Name="btnAddChildProject_ContextMenu" BarItemDisplayMode="ContentAndGlyph" Content="{x:Static properties:Resources.ChildProjectControlAdd}" ToolTip="{x:Static properties:Resources.ChildProjectControlAdd}" Glyph="{StaticResource UFPRJnew_16x16}" ToolTipService.ShowOnDisabled="True" GlyphSize="Custom" CustomGlyphSize="14,14"/>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{x:Static properties:Resources.ChildProjectControlTitle}" x:Name="Title" Margin="2,0,2,0" VerticalAlignment="Center" Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, Path=IsTitleVisible}" />
        <StackPanel Orientation="Horizontal" x:Name="stackButtons" Opacity="0">
            <Button x:Name="btnAddChildProject">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="2" Source="{StaticResource UFPRJnew_16x16}" Height="14" Width="14" />
                        <TextBlock Text="{x:Static properties:Resources.ChildProjectControlAdd}" FontSize="8" VerticalAlignment="Center" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
