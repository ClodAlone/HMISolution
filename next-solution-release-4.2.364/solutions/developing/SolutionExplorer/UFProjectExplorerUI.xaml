<UserControl x:Class="UFProjectManager.UFProjectExplorerUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:self="clr-namespace:UFProjectManager"
    xmlns:conv="clr-namespace:UFProjectManager.Converters"
    xmlns:properties="clr-namespace:UFProjectManager.Properties"
    xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
    x:Name="UFProjectExplorerUIControl"
    Height="300" Width="305" 
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"

    xmlns:commands="clr-namespace:Utilities.Commands;assembly=Utilities" PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            <ResourceDictionary Source="/SharedResources;component/Resources/UFProject.xaml" />
          </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <conv:TagToContextMenuConverter x:Key="TagToContextMenuConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

        
    <UserControl.CommandBindings>

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CreateWebClientApp}" 
                    Executed="OnCreateWebApp" 
                    CanExecute="CanCreateWebApp" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CreateWebClientExpress}" 
                    Executed="OnCreateWebExpress" 
                    CanExecute="CanCreateWebExpress" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CreateRuntimeShortcut}" 
                    Executed="OnCreateRuntimeShortcut" 
                    CanExecute="CanCreateRuntimeShortcut" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.DeployWebClientExpress}" 
                    Executed="OnDeployWebExpress" 
                    CanExecute="CanDeployWebExpress" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StartupRuntime}" 
                    Executed="OnStartupRuntime" 
                    CanExecute="CanStartupRuntime" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StopRuntime}" 
                    Executed="OnStopRuntime" 
                    CanExecute="CanStopRuntime" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.OpenServicesPanel}" 
                    Executed="OnOpenServicesPanel" 
                    CanExecute="CanOpenServicesPanel" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddGeoLocation}"
                    Executed="OnAddGeoLocation" 
                    CanExecute="CanAddGeoLocation" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CreateQRCode}"
                    Executed="OnCreateQRCode" 
                    CanExecute="CanCreateQRCode" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.CloseAll}"
                    Executed="OnCloseAll" 
                    CanExecute="CanCloseAll" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ApplicationClose}"
                    Executed="OnClose" 
                    CanExecute="CanClose" />
        
        <CommandBinding Command="ApplicationCommands.Close"
                    Executed="OnClose" 
                    CanExecute="CanClose" />

        <CommandBinding Command="ApplicationCommands.Replace"
                    Executed="OnRename" 
                    CanExecute="CanRename" />

        <CommandBinding Command="NavigationCommands.Refresh"
                    Executed="OnRefresh" 
                    CanExecute="CanRefresh" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.SaveAll}"
                    Executed="OnSaveAll" 
                    CanExecute="CanSaveAll" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddPasswordProject}" 
                    Executed="OnAddPasswordProject" 
                    CanExecute="CanAddPasswordProject" />

       <CommandBinding Command="{x:Static self:UIGeneralCommands.EditAppNameSettings}"
                   Executed="OnEditAppNameSettings"
                   CanExecute="CanEditAppNameSettings" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewScreenFromTemplate}"
              Executed="OnAddNewScreenFromTemplate"
              CanExecute="OnAddNewCanExecute" />
      <!--<CommandBinding Command="ApplicationCommands.Cut"
                Executed="OnCutEvent" 
                CanExecute="CanExecuteCut" />
        <CommandBinding Command="ApplicationCommands.Delete"
                Executed="OnDeleteEvent" 
                CanExecute="CanExecuteDelete" />
        <CommandBinding Command="ApplicationCommands.Paste"
                Executed="OnPasteEvent" 
                CanExecute="CanExecutePaste" />
        <CommandBinding Command="ApplicationCommands.Copy"
                Executed="OnCopyEvent" 
                CanExecute="CanExecuteCopy" />-->

        <CommandBinding Command="ApplicationCommands.Undo"  
                Executed="OnUndoEvent" 
                CanExecute="CanExecuteUndo" />
        <CommandBinding Command="ApplicationCommands.Redo"
                Executed="OnRedoEvent" 
                CanExecute="CanExecuteRedo" />

        <CommandBinding Command="ApplicationCommands.SaveAs"
                Executed="OnSaveAs" 
                CanExecute="CanSaveAs" />

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddStringId}"
            Executed="OnAddStringId"
            CanExecute="CanAddStringId" />

    </UserControl.CommandBindings>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Alt" 
                Key="F"
                Command="{Binding ElementName=treeListControl, Path=SelectedItem.TreeItemInnerObject.NewFolderCommand}"/>
        <KeyBinding Modifiers="Alt" 
                Key="N"
                Command="{Binding ElementName=treeListControl, Path=SelectedItem.TreeItemInnerObject.NewCommand}"/>
        <KeyBinding
                Key="Return"
                Command="{Binding ElementName=UFProjectExplorerUIControl, Path=OpenResourceCommand}"/>
    </UserControl.InputBindings>

    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="cm" Opacity=".8">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.StartupRuntime}" Content="{x:Static properties:UICommandResource.StartupRuntimeText}" Glyph="{StaticResource UFPRJRun32}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CreateWebClientApp}" Content="{x:Static properties:UICommandResource.CreateWebClientAppText}" Glyph="{StaticResource UFPRJHTML5_Logo_32}" />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CreateWebClientExpress}" Content="{x:Static properties:UICommandResource.CreateWebClientExpressText}" Glyph="{StaticResource UFPRJWebExpressToSvg}" />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CreateRuntimeShortcut}" Content="{x:Static properties:UICommandResource.CreateRuntimeShortcutText}" Glyph="{StaticResource UFPRJRuntimeShortcut}" />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddGeoLocation}" Content="{x:Static properties:UICommandResource.EditGeoLocationText}" Glyph="{StaticResource UFPRJweb_32x32}" />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CreateQRCode}" Content="{x:Static properties:UICommandResource.CreateQRCodeText}" Glyph="{StaticResource UFPRJQRCode_32x32}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CloseAll}" Content="{x:Static properties:UICommandResource.CloseAllText}"  Glyph="{StaticResource UFPRJCloseAll_16x16}"  />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.SaveAll}" Content="{x:Static properties:UICommandResource.SaveAllText}" Glyph="{StaticResource UFPRJSaveAll_16x16}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.EditAppNameSettings}" Content="{x:Static properties:UICommandResource.EditAppNameSettingsText}" Glyph="{StaticResource UFPRJEditAppName}"/>
                <!--<dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.EditAppNameChildProjectSettings}" />-->
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="ApplicationCommands.Undo" KeyGesture="CTRL+Z" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Redo" KeyGesture="CTRL+Y" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="ApplicationCommands.Copy" KeyGesture="CTRL+C" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Paste" KeyGesture="CTRL+V" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Cut" KeyGesture="CTRL+X" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Delete" KeyGesture="Del" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="Properties" KeyGesture="F4" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="NavigationCommands.Refresh" KeyGesture="F5" Content="{x:Static appproperties:ApplicationCommandsResource.Refresh}"/>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

    <!-- TreeListControl DevExpress -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0" x:Name="rowSplitter"/>
            <RowDefinition Height="Auto" x:Name="rowDetails"/>
        </Grid.RowDefinitions>
        <dxg:TreeListControl Name="treeListControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged">
            <dxg:TreeListControl.Columns>
                <!--<dxg:TreeListColumn Width="*">
                    <dxg:TreeListColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <dxe:TextEdit Grid.Row="0" Grid.Column="0" Text="{Binding RowData.Row.ItemHeader}" x:Name="PART_Editor" />
                                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding RowData.Row.InnerControl}" />
                            </Grid>
                        </DataTemplate>
                    </dxg:TreeListColumn.CellTemplate>
                </dxg:TreeListColumn>-->
                <dxg:TreeListColumn FieldName="ItemHeader" Validate="OnTreeHeaderValidate" />
                <dxg:TreeListColumn FieldName="InnerControl" Visible="False">
                    <dxg:TreeListColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Data.InnerControl}" />
                        </DataTemplate>
                    </dxg:TreeListColumn.CellTemplate>
                </dxg:TreeListColumn>
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                    ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                    AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False" CellValueChanged="OnCellValueChanged"
                    ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                    NodeChanged="OnTreeNodeChanged" NodeExpanding="OnTreeNodeExpanding" NodeCollapsing="OnTreeNodeCollapsing" RowDoubleClick="OnRowDoubleClick"
                    HiddenEditor="OnHiddenEditor" IsSynchronizedWithCurrentItem="True" PreviewKeyDown="View_PreviewKeyDown"
                    AllowDragDrop="True" DropRecord="TreeListControl_DragEnd" DragRecordOver="TreeListControl_DragRecordOver"
                    StartRecordDrag="TreeListControl_DragStart" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"
                >
                    <!-- AutoWidth="True" -->
                    <dxg:TreeListView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                            <Setter Property="dxb:BarManager.DXContextMenu">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource TagToContextMenuConverter}">
                                        <Binding Path="Row.InnerControl" UpdateSourceTrigger="PropertyChanged" />
                                        <Binding Path="Row.TreeItemInnerObject" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </dxg:TreeListView.RowStyle>
                    <dxg:TreeListView.CellStyle>
                        <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                          <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                        </Style>
                    </dxg:TreeListView.CellStyle>
                </dxg:TreeListView>
            </dxg:TreeListControl.View>
            <dxg:TreeListControl.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Cut"
                Executed="OnCutEvent" 
                CanExecute="CanExecuteCut" />
                <CommandBinding Command="ApplicationCommands.Delete"
                Executed="OnDeleteEvent" 
                CanExecute="CanExecuteDelete" />
                <CommandBinding Command="ApplicationCommands.Paste"
                Executed="OnPasteEvent" 
                CanExecute="CanExecutePaste" />
                <CommandBinding Command="ApplicationCommands.Copy"
                Executed="OnCopyEvent" 
                CanExecute="CanExecuteCopy" />
            </dxg:TreeListControl.CommandBindings>
        </dxg:TreeListControl>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
        <Expander x:Name="expanderDetails" Grid.Row="2" Header="Details" IsExpanded="False" Expanded="Expander_Expanded"  Collapsed="Expander_Collapsed">

            <dxg:GridControl Name="gridControl" SelectionMode="Row">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=TypeIcon, Mode=OneWay}" Header="" Width="16" 
                                    AllowEditing="False" AllowResizing="False">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ImageEditSettings ShowMenu="False" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=TypeTitle, Mode=OneWay}" Header="Name" Width="*" 
                                    AllowEditing="False"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Name="detailsTableView" AllowDragDrop="True" CompleteRecordDragDrop="{DXEvent Handler='@args.Handled = true'}"
                                   ShowGroupPanel="False" MultiSelectMode="Row" />
                </dxg:GridControl.View>
            </dxg:GridControl>

        </Expander>
    </Grid>
</UserControl>
