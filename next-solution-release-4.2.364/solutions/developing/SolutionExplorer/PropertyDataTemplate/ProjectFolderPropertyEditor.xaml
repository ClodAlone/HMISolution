<UserControl x:Class="UFProjectManager.PropertyDataTemplate.ProjectFolderPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFProjectManager"
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             xmlns:conv="clr-namespace:UFProjectManager.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:PathToIsEnableConverter x:Key="PathToIsEnableConverter" />
            <utilities:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Button x:Name="uri"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=OneWay, ValidatesOnDataErrors=True}" IsEnabled="{Binding Value, Converter={StaticResource PathToIsEnableConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" Click="DlgButton_Click">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <TextBox IsEnabled="False" IsHitTestVisible="False" x:Name="text" ToolTip="{x:Static properties:Resources.OpenProjectLocationTooltip}" 
                 Text="{Binding Value, Mode=OneWay, ValidatesOnDataErrors=True}" />
    </DockPanel>
</UserControl>
