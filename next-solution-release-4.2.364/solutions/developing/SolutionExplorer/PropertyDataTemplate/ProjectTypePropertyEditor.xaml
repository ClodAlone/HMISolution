<UserControl x:Class="UFProjectManager.PropertyDataTemplate.ProjectTypePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
      <DockPanel>
        <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click_Clear">
          <Button.Content>
            <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
          </Button.Content>
        </Button>
        <dxe:ComboBoxEdit
                    x:Name="cmbEnum" IsTextEditable="False"
                    PopupOpening="cmbEnum_PopupOpening"
                    Text="{Binding Path=Tag,ElementName=uriButton, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                    SelectedIndexChanged="cmbEnum_SelectedIndexChanged"
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"/>
      </DockPanel>
      <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=combo, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
