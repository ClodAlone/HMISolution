<UserControl x:Class="UFProjectManager.PropertyDataTemplate.ListScreenEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFProjectManager.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:self="clr-namespace:UFProjectManager.PropertyDataTemplate"
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             x:Name="listUriEditor"
             Height="300" Width="300"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <utilities:UriConverter x:Key="UriConverter" />
            <utilities:UriToRelativeConverter x:Key="UriToRelativeConverter"/>
            <local:ActualWidthConverter x:Key="ActualWidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        
        <CommandBinding Command="{x:Static self:ListUriEditor.EditCommand}"
                    Executed="OnEditCommandExecuted" 
                    CanExecute="OnCanExecuteEditCommand" />

        <CommandBinding Command="{x:Static self:ListUriEditor.RemoveCommand}"
                    Executed="OnRemoveCommandExecuted" 
                    CanExecute="OnCanExecuteRemoveCommand" />
        
        <CommandBinding Command="{x:Static self:ListUriEditor.MoveUpCommand}"
                    Executed="OnMoveUpCommandExecuted" 
                    CanExecute="OnCanExecuteMoveUpCommand" />

        <CommandBinding Command="{x:Static self:ListUriEditor.MoveDownCommand}"
                    Executed="OnMoveDownCommandExecuted" 
                    CanExecute="OnCanExecuteMoveDownCommand" />

    </UserControl.CommandBindings>

    <Grid x:Name="layoutGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="90*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        
        <ListBox x:Name="listUriControl" 
                 ItemsSource="{Binding}"
                 IsSynchronizedWithCurrentItem="False" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding Path=ActualWidth, 
                        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}},
                        Converter={StaticResource ResourceKey=ActualWidthConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Content="{Binding ElementName=executionMode, Path=(Validation.Errors).CurrentItem}"/>
                        <TextBox Grid.Column="1" x:Name="textUri" IsReadOnly="True" Text="{Binding Path=Uri, Converter={StaticResource UriConverter}}" />

                        <Button x:Name="uriEdit" Grid.Column="2" Tag="{Binding}"
                                Command="{x:Static self:ListUriEditor.EditCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="3" Tag="{Binding}"
                                Command="{x:Static self:ListUriEditor.RemoveCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="4" Tag="{Binding}"
                                Command="{x:Static self:ListUriEditor.MoveUpCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource MoveUpSmall}"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="5" Tag="{Binding}"
                                Command="{x:Static self:ListUriEditor.MoveDownCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource MoveDownSmall}"/>
                            </Button.Content>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static properties:Resources.ListUriAddNew}" Command="{Binding Path=AddNew, ElementName=listUriEditor}" />
            <Button Content="{x:Static properties:Resources.ListUriRemoveAll}" Grid.Column="1" Command="{Binding Path=RemoveAll, ElementName=listUriEditor}" />
        </Grid>
        
    </Grid>
</UserControl>
