<UserControl x:Class="UFProjectManager.Service.ServicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFProjectManager.Controls"
             xmlns:converters="clr-namespace:UFProjectManager.Converters"
             xmlns:properties="clr-namespace:UFProjectManager.Properties" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             x:Name="this" Height="300" Width="600"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/UFProject.xaml" />
      </ResourceDictionary.MergedDictionaries>
        <converters:ServiceModelConverter x:Key="ServiceModelConverter"/>
    </ResourceDictionary>
  </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxg:GridControl x:Name="gridControl" >
            <dxg:GridControl.Columns>
                <dxg:GridColumn AllowBestFit="True" 
                                DisplayMemberBinding="{Binding Path=FriendlyName, Mode=OneWay}" 
                                Header="{x:Static properties:Resources.ServiceTypeColumnHeaderader}" />
                <dxg:GridColumn AllowBestFit="True" 
                                DisplayMemberBinding="{Binding Path=DisplayName, Mode=OneWay}" 
                                Header="{x:Static properties:Resources.ServiceNameColumnHeaderader}" />
                <dxg:GridColumn AllowBestFit="True" 
                                DisplayMemberBinding="{Binding Path=Status, Mode=OneWay, Converter={StaticResource ServiceModelConverter}}" 
                                Header="{x:Static properties:Resources.ServiceStatusColumnHeaderader}" >
                </dxg:GridColumn>
                <dxg:GridColumn AllowBestFit="True" 
                                DisplayMemberBinding="{Binding Path=StartMode, Mode=OneWay, Converter={StaticResource ServiceModelConverter}}" 
                                Header="{x:Static properties:Resources.ServiceStartModeColumnHeaderader}">
                </dxg:GridColumn>
                <dxg:GridColumn AllowBestFit="True" 
                                DisplayMemberBinding="{Binding Path=UserName, Mode=OneWay}"
                                Header="{x:Static properties:Resources.ServiceAccountColumnHeaderader}" />
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView AutoWidth="True" NavigationStyle="Row" 
                               ShowGroupPanel="False" ShowColumnHeaders="True"
                               ShowHorizontalLines="True" AllowEditing="False" />
            </dxg:GridControl.View>
        </dxg:GridControl>
        <CheckBox Grid.Row="1" x:Name="checkShowAllServices"
                  IsChecked="{Binding Path=ShowAllServices, ElementName=this}" 
                  Content="{x:Static properties:Resources.ServicesPanelShowAllServices}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2">
            <Button Margin="5" MinWidth="100" Command="{Binding Path=Install, ElementName=this}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFPRJServiceInstall32x32}"  Width="16" Height="16"/>
                    <TextBlock Text="{x:Static properties:Resources.ServicesPanelInstallService}" />
                </StackPanel>
            </Button>

            <Button Margin="5" MinWidth="100" Command="{Binding Path=Start, ElementName=this}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFPRJServiceStart32x32}"  Width="16" Height="16"/>
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static properties:Resources.ServicesPanelStartService}" />
                </StackPanel>
            </Button>

            <Button Margin="5" MinWidth="100" Command="{Binding Path=Stop, ElementName=this}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFPRJServiceStop32x32}"  Width="16" Height="16"/>
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static properties:Resources.ServicesPanelStopService}" />
                </StackPanel>
            </Button>

            <Button Margin="5" MinWidth="100" Command="{Binding Path=Uninstall, ElementName=this}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFPRJServiceUninstall32x32}" Width="16" Height="16" />
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static properties:Resources.ServicesPanelUninstallService}" />
                </StackPanel>
            </Button>

            <Button Margin="5" MinWidth="100" Command="{Binding Path=LogIn, ElementName=this}" >
                <StackPanel Orientation="Vertical" Margin="5" >
                    <Image Source="{StaticResource UFPRJLoginUser}" Width="16" Height="16"  />
                    <TextBlock HorizontalAlignment="Center" Text="{x:Static properties:Resources.ServicesPanelLogInUser}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
