<UserControl x:Class="UFProjectManager.Controls.EnterKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:local="clr-namespace:UFProjectManager"
             FocusManager.FocusedElement="{Binding ElementName=keyBox}"
             Height="200" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:Properties.Resources.ProtectionKey}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <cc:BindablePasswordBox x:Name="keyBox" Margin="10,10,10,10" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
        
        <TextBlock Grid.Row="1" FontFamily="Segoe UI" FontSize="30" TextWrapping="WrapWithOverflow"
                   Text="{x:Static local:Properties.Resources.ProjectProtected}"
                                   VerticalAlignment="Center"
                                   FontWeight="Light"/>

    </Grid>
</UserControl>
