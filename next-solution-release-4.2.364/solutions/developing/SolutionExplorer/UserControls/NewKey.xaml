<UserControl x:Class="UFProjectManager.Controls.NewKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             FocusManager.FocusedElement="{Binding ElementName=keyBox}"
             Height="120" Width="400">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.ProtectionKey}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>
        <cc:BindablePasswordBox x:Name="keyBox" Margin="10,10,10,10" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.ProtectionVerifyKey}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>
        <cc:BindablePasswordBox Grid.Row="1" x:Name="verifykeyBox" Margin="10,10,10,10" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBlock x:Name="txtToHide" Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.LeaveBlankToCancelPassword}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,0,0,0"/>
    </Grid>
</UserControl>
