<dx:DXWindow x:Class="UFUAInstallDeployServerService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:self="clr-namespace:UFUAInstallDeployServerService"
        xmlns:properties="clr-namespace:UFUAInstallDeployServerService.Properties"
        xmlns:uc="clr-namespace:UFUAServiceLibrary;assembly=UFUAServiceLibrary"
        xmlns:cc="http://progea.com/CommonControls"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        WindowStartupLocation="CenterScreen" BorderEffect="Default"
        Background="{x:Null}" SizeToContent="WidthAndHeight"
        Title="{x:Static properties:Resources.AppTitle}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />          
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static self:MainWindow.SaveSettings}" 
                    Executed="OnSaveSettings" 
                    CanExecute="CanSaveSettings" />

        <CommandBinding Command="{x:Static self:MainWindow.ReloadSettings}" 
                    Executed="OnReloadSettings" 
                    CanExecute="CanReloadSettings" />

    </Window.CommandBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Auto"
                                        Name="Scroll">
        <Grid Name="maingrid">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <uc:InstallServiceControl x:Name="serviceControl"/>

          <TextBlock Margin="10"  Text="{x:Static properties:Resources.SettingsHeader}" Grid.Row="1" HorizontalAlignment="Left" />
          <Grid Margin="20, 10" Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />                
              <RowDefinition Height="Auto" />                
              <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="10*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="32*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.UserName}" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" />
                <TextBox Margin="5,0" Name="userName" Grid.Column="2" Grid.Row="1" Text="{Binding Settings.UserName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3"
            Content="{Binding ElementName=userName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.Password}" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" />
            <cc:BindablePasswordBox Margin="5,0" x:Name="password" Grid.Column="2" Grid.Row="2"
                         Password="{Binding Settings.Password, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"/>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=password, Path=(Validation.Errors).CurrentItem}"/>
              
            <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.ConfirmPassword}" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Right" />
            <cc:BindablePasswordBox Margin="5,0" x:Name="confirmPassword" Grid.Column="2" Grid.Row="3"
                         Password="{Binding Settings.ConfirmPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"/>
            <ContentPresenter Grid.Row="3" Grid.Column="3"
            Content="{Binding ElementName=confirmPassword, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.ProjectPath}" Grid.Column="0" Grid.Row="4" HorizontalAlignment="Right" />
            <DockPanel LastChildFill="True"  Margin="5,0" Grid.Column="2" Grid.Row="4" >
              <Button Margin="5,0,0,0" DockPanel.Dock="Right" HorizontalAlignment="Left"  MinWidth="40" x:Name="btnBrowse" Click="btnBrowse_Click">
                <Button.Content>
                  <Image Source="{StaticResource OpenFolder}" Height="16" Width="16" />
                </Button.Content>
              </Button>
              <TextBox Margin="0" Name="projectPath" Text="{Binding Settings.ProjectPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"></TextBox>
            </DockPanel>
            <ContentPresenter Grid.Row="4" Grid.Column="3"
            Content="{Binding ElementName=projectPath, Path=(Validation.Errors).CurrentItem}"/>

          </Grid>
            <Grid Grid.Row="5" x:Name="commands" Visibility="Visible" MinHeight="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button  Margin="5" 
                    Command="{x:Static self:MainWindow.SaveSettings}" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.SaveSettingsText}" />
                    </StackPanel>
                </Button>
                <Button  Margin="5" Grid.Column="1" 
                    Command="{x:Static self:MainWindow.ReloadSettings}" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.ReloadSettingsText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</dx:DXWindow>
