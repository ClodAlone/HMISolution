<dx:DXWindow x:Class="UFUACertificateChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ms="http://namespaces.mindscape.co.nz/wpf"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        WindowStartupLocation="CenterScreen" BorderEffect="Default" 
        xmlns:properties="clr-namespace:UFUACertificateChecker.Properties"
        Title="{x:Static properties:Resources.AppTitle}" Height="350" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="2,2,2,2" Text="{x:Static properties:Resources.ConfigFile}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="2,2,2,2" Text="{Binding Path=ExePath}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="2,2,2,2" Text="{x:Static properties:Resources.Section}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="2,2,2,2" Text="{Binding SectionName}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Margin="10,10,10,10" Name="btnCheck" Content="{x:Static properties:Resources.CheckAndCreate}" Click="CheckAndCreate_Click"></Button>

            <Button Grid.Row="1" Grid.Column="0" Margin="10,10,10,10" Name="btnCreateNew" Content="{x:Static properties:Resources.CreateNew}" Click="CreateNew_Click"></Button>

            <Button Grid.Row="2" Grid.Column="0" Margin="10,10,10,10" Name="btnSelect" Content="{x:Static properties:Resources.Select}" Click="Select_Click"></Button>

            <StackPanel Grid.Column="1" Grid.RowSpan="5" >
                <TextBlock Text="{x:Static properties:Resources.CertificateProperties}"/>
                <ms:PropertyGrid x:Name="propertyGrid" IsToolBarVisible="True" AllowModifyCollections="False" Height="200" Margin="2,2,2,2"/>
            </StackPanel>            
        </Grid>
    </Grid>
</dx:DXWindow>
