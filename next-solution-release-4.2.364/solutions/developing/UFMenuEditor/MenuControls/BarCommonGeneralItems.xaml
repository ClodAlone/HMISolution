<dxb:BarSubItem
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="UFMenuEditor.MenuControls.BarCommonGeneralItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:self="clr-namespace:UFMenuEditor"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:properties="clr-namespace:UFMenuEditor.Properties"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
  <dxb:BarSubItem x:Name="biOptionsMenuEditor" Content="{x:Static translatableMenu:Resources.OptionsRibbonHeader}">
    <dxb:BarButtonItem MergeOrder="45" ToolTipService.ShowOnDisabled="True" x:Name="biMEAddStringId"
                             Command="{x:Static self:UIGeneralCommands.AddStringId}"
                             Glyph="{StaticResource AddStringId}" IsVisible="False"
                             Content="{x:Static translatableMenu:Resources.AddStringIdName}"/>
  </dxb:BarSubItem>
</dxb:BarSubItem>
