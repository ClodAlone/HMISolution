<UserControl x:Class="UFMenuEditor.Controls.NewMenuItemDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFMenuEditor.Properties" 
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:common="clr-namespace:CommonControls.PropertyDataTemplate;assembly=CommonControls"
             xmlns:commontemplate="clr-namespace:OPCUAViewModel.PropertyDataTemplate;assembly=OPCUAViewModel"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Height="700" Width="500"
             d:DesignHeight="700" d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  DockPanel.Dock="Top" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewMenuItemDefinitionTitle}" VerticalAlignment="Center" FontWeight="Bold" />

                <TextBlock Grid.Row="1" x:Name="lblEditName" Text="{x:Static properties:Resources.NewMenuItemDefinitionName}" VerticalAlignment="Center" />
                <DockPanel x:Name="gridText" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button Click="textEditName_Clear" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                            DockPanel.Dock="Right">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <Button Click="textEditName_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                            DockPanel.Dock="Right">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <TextBox x:Name="textEditName" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                            BorderBrush="Black" HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" />
                </DockPanel>
                <ContentPresenter Grid.Row="1" Grid.Column="2" 
                                  Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="2" x:Name="lblEditDesc" Text="{x:Static properties:Resources.NewMenuItemDefinitionDescription}" VerticalAlignment="Center" />
                <TextBox BorderBrush="Black" Grid.Column="1" Grid.Row="2" Text="{Binding Description}" x:Name="textEditDesc" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="3" x:Name="lblMenuType" Text="{x:Static properties:Resources.NewMenuItemType}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding MenuItemType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" x:Name="comboMenuType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboMenuType_SelectionChanged" />
                <ContentPresenter Grid.Row="3" Grid.Column="2" Content="{Binding ElementName=comboMenuType, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="4" x:Name="lblEditEnable" Text="{x:Static properties:Resources.NewMenuItemEnableTag}" VerticalAlignment="Center" />
                <DockPanel x:Name="TagEnableGrid" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textEditEnable"/>
                </DockPanel>
                <ContentPresenter Grid.Row="4" Grid.Column="2" Content="{Binding ElementName=textEditEnable, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock x:Name="lblEditMark" Grid.Row="5" Text="{x:Static properties:Resources.NewMenuItemMarkTag}" VerticalAlignment="Center" />
                <DockPanel x:Name="TagMarkGrid" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textEditMark"/>
                </DockPanel>
                <ContentPresenter Grid.Row="5" Grid.Column="2" Content="{Binding ElementName=textEditMark, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock x:Name="lblEditImage" Grid.Row="6" Text="{x:Static properties:Resources.NewMenuItemImage}" VerticalAlignment="Center" />
                <DockPanel x:Name="gridEditImage" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <!--<Button Name="btnDelImage" Click="btnDelImage_Click" 
                            DockPanel.Dock="Right">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="14" Width="14" />
                        </Button.Content>
                    </Button>
                    <Button Name="btnImage" Click="btnImage_Click" 
                            DockPanel.Dock="Right">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="14" Width="14" />
                        </Button.Content>
                    </Button>-->
                    <common:SourceFilePropertyEditor x:Name="textEditImage" DefaultFolder="Images"/>
                    <!--<TextBox x:Name="textEditImage" Text="{Binding Image, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" />-->
                </DockPanel>
                <ContentPresenter Grid.Row="6" Grid.Column="2" Content="{Binding ElementName=textEditImage, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </ScrollViewer>
        <Grid x:Name="gridCommandCtrl" DockPanel.Dock="Bottom">
            <!--<TextBlock x:Name="lblCommandCtrl" Text="{x:Static properties:Resources.NewMenuItemDefinitionCommand}" VerticalAlignment="Center" />-->
            <ContentControl x:Name="CommandCtrl" />
        </Grid>
    </DockPanel>
</UserControl>
