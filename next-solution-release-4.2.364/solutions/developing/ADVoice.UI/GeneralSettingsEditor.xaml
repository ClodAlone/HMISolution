<UserControl x:Class="ADVoice.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ADVoice.UI.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:self="clr-namespace:ADVoice.UI"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary >
            <self:OpacityConverter x:Key="OpacityConverter"/>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static properties:Resources.Title}" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>

            <TextBlock Text="{x:Static properties:Resources.WelcomeMsg}" Grid.Column="0" Grid.Row="1" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="WelcomeMsg" Grid.Column="2" Grid.Row="1" Margin="0,5" Text="{Binding WelcomeMsg, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=WelcomeMsg, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.FarewellMsg}" Grid.Column="0" Grid.Row="2" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="FarewellMsg" Grid.Column="2" Grid.Row="2" Margin="0,5" Text="{Binding FarewellMsg, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=FarewellMsg, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.NextMsg}" Grid.Column="0" Grid.Row="3" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="NextMsg" Grid.Column="2" Grid.Row="3" Margin="0,5" Text="{Binding NextMsg, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=NextMsg, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.TimeOut}" Grid.Column="0" Grid.Row="4" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="TimeOut" Grid.Column="2" Grid.Row="4" Margin="0,5" Text="{Binding TimeOut, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="4" Grid.Column="3" 
                Content="{Binding ElementName=TimeOut, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.MaxRetry}" Grid.Column="0" Grid.Row="5" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="MaxRetry" Grid.Column="2" Grid.Row="5" Margin="0,5" Text="{Binding MaxRetry, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="5" Grid.Column="3" 
                Content="{Binding ElementName=MaxRetry, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Multiplex}" Grid.Column="0" Grid.Row="6" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center"  Margin="0,5"
                                  Content="" IsChecked="{Binding Multiplex, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                  x:Name="chkMultiplex" />

            <TextBlock Text="{x:Static properties:Resources.ForceSharpACK}" Grid.Column="0" Grid.Row="7" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="7" Grid.Column="2" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center" Margin="0,5"
                                  Content="" IsChecked="{Binding ForceSharpACK, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                  x:Name="chkForceSharpACK" />

            <TextBlock Text="{x:Static properties:Resources.EnableSIPServer}" Grid.Column="0" Grid.Row="8" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="8" Grid.Column="2" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center" Margin="0,5" 
                                  Content="" IsChecked="{Binding EnableSIPServer, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                  x:Name="chkEnableSIPServer" />

            <TextBlock Text="{x:Static properties:Resources.RegistrationRequired}" Grid.Column="0" Grid.Row="9" Margin="0,1" VerticalAlignment="Center" Opacity="{Binding EnableSIPServer, Converter={StaticResource OpacityConverter}, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger = PropertyChanged}"/>
            <CheckBox Grid.Row="9" Grid.Column="2" Margin="0,5" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center" IsEnabled="{Binding EnableSIPServer}"
                                  Content="" IsChecked="{Binding RegistrationRequired, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                  x:Name="chkRegistrationRequired" />

            <TextBlock Text="{x:Static properties:Resources.DisplayName}" Grid.Column="0" Grid.Row="10" VerticalAlignment="Center" Opacity="{Binding EnableSIPServer, Converter={StaticResource OpacityConverter}, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger = PropertyChanged}"/>
            <TextBox Name="DisplayName" Grid.Column="2" Grid.Row="10" Margin="0,5" Text="{Binding DisplayName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding EnableSIPServer}"></TextBox>
            <ContentPresenter Grid.Row="10" Grid.Column="3" 
                Content="{Binding ElementName=DisplayName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.UserName}" Grid.Column="0" Grid.Row="11" Margin="0,1" VerticalAlignment="Center" Opacity="{Binding EnableSIPServer, Converter={StaticResource OpacityConverter}, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger = PropertyChanged}"/>
            <TextBox Name="UserName" Grid.Column="2" Grid.Row="11" Margin="0,5" Text="{Binding UserName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding EnableSIPServer}"></TextBox>
            <ContentPresenter Grid.Row="11" Grid.Column="3" 
                Content="{Binding ElementName=UserName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RegisterName}" Grid.Column="0" Grid.Row="12" Margin="0,1" VerticalAlignment="Center" Opacity="{Binding EnableSIPServer, Converter={StaticResource OpacityConverter}, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger = PropertyChanged}"/>
            <TextBox Name="RegisterName" Grid.Column="2" Grid.Row="12" Margin="0,5" Text="{Binding RegisterName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding EnableSIPServer}"></TextBox>
            <ContentPresenter Grid.Row="12" Grid.Column="3" 
                Content="{Binding ElementName=RegisterName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RegisterPassword}" Grid.Column="0" Grid.Row="13" Margin="0,1" VerticalAlignment="Center" Opacity="{Binding EnableSIPServer, Converter={StaticResource OpacityConverter}, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger = PropertyChanged}"/>
            <cc:BindablePasswordBox Grid.Row="13" Grid.Column="2" Margin="0,5" Password="{Binding RegisterPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" IsEnabled="{Binding EnableSIPServer}"
                     x:Name="RegisterPassword" />
            <ContentPresenter Grid.Row="13" Grid.Column="3" 
                Content="{Binding ElementName=RegisterPassword, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RegistrationTimeOut}" Grid.Column="0" Grid.Row="14" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="RegistrationTimeOut" Grid.Column="2" Grid.Row="14" Margin="0,5" Text="{Binding RegistrationTimeOut, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="14" Grid.Column="3" 
                Content="{Binding ElementName=RegistrationTimeOut, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Host}" Grid.Column="0" Grid.Row="15" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Host" Grid.Column="2" Grid.Row="15" Margin="0,5" Text="{Binding Host, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="15" Grid.Column="3" 
                Content="{Binding ElementName=Host, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Port}" Grid.Column="0" Grid.Row="16" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Port" Grid.Column="2" Grid.Row="16" Margin="0,5" Text="{Binding Port, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="16" Grid.Column="3" 
                Content="{Binding ElementName=Port, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.SelectedVoice}" Grid.Column="0" Grid.Row="17" Margin="0,1" VerticalAlignment="Center"/>
            <!--<TextBox Name="SelectedVoice" Grid.Column="2" Grid.Row="17" Text="{Binding SelectedVoice, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>-->
            <ComboBox Grid.Column="2" Grid.Row="17" Margin="0,5" SelectedValue="{Binding SelectedVoice, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                      x:Name="SelectedVoice" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="SelectedVoice_SelectionChanged" />
            <ContentPresenter Grid.Row="17" Grid.Column="3" 
                Content="{Binding ElementName=SelectedVoice, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Volume}" Grid.Column="0" Grid.Row="18" Margin="0,1" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox Name="Volume" Grid.Column="2" Grid.Row="18" Margin="0,5" Text="{Binding Volume, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Visibility="Collapsed"></TextBox>
            <ContentPresenter Grid.Row="18" Grid.Column="3" 
                Content="{Binding ElementName=Volume, Path=(Validation.Errors).CurrentItem}" Visibility="Collapsed"/>

            <TextBlock Text="{x:Static properties:Resources.Rate}" Grid.Column="0" Grid.Row="19" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Rate" Grid.Column="2" Grid.Row="19" Margin="0,5" Text="{Binding Rate, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="19" Grid.Column="3" 
                Content="{Binding ElementName=Rate, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Pitch}" Grid.Column="0" Grid.Row="20" Visibility="Collapsed" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Pitch" Grid.Column="2" Grid.Row="20" Margin="0,5" Text="{Binding Pitch, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Visibility="Collapsed"></TextBox>
            <ContentPresenter Grid.Row="20" Grid.Column="3" 
                Content="{Binding ElementName=Pitch, Path=(Validation.Errors).CurrentItem}" Visibility="Collapsed"/>

            <TextBlock Text="{x:Static properties:Resources.ACKServerAlarm}" Grid.Column="0" Grid.Row="21" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="21" Grid.Column="2" Margin="0,5" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center"
                                  Content="" IsChecked="{Binding ACKServerAlarm, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                  x:Name="chkACKServerAlarm" />

        </Grid>
    </ScrollViewer>
</UserControl>
