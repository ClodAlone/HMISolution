<UserControl x:Class="Gauges.DigitalClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:converters="clr-namespace:Gauges.Converters" Foreground="Black" 
             FontSize="28"
             mc:Ignorable="d" d:DesignHeight="62" d:DesignWidth="62">
    <UserControl.Resources>
        <converters:BoolToSymbolCountConverter x:Key="BoolToSymbolCountConverter" />
        <dxga:SymbolStateToVisibilityConverter x:Key="VisibilityConverter"/>
        <converters:CustomVisibilityConverter x:Key="CustomVisibilityConverter" />
      
        <dxga:CustomSevenSegmentsPresentation x:Key="customPresentation">
        <dxga:CustomSevenSegmentsPresentation.SymbolTemplate>
          <ControlTemplate>
              <Grid>
                <TextBlock Background="Transparent" Text="{Binding Path=SymbolState, Converter={StaticResource CustomVisibilityConverter}}"
                           TextAlignment="Justify" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Grid>
          </ControlTemplate>
        </dxga:CustomSevenSegmentsPresentation.SymbolTemplate>
      </dxga:CustomSevenSegmentsPresentation>
      <dxga:DefaultSevenSegmentsPresentation  x:Key="defaultPresentation"
              FillInactive="{Binding Path=FillInactive, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
              FillActive="{Binding Path=FillActive, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" />
    </UserControl.Resources>
    <!--<Viewbox Stretch="Fill"  x:Name ="view">-->
    <Grid x:Name ="view">
        <dxga:DigitalGaugeControl x:Name="time7Segment" FlowDirection="LeftToRight" 
                                  SymbolCount="{Binding ShowSeconds, Converter={StaticResource BoolToSymbolCountConverter}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" 
                                  Text="" TextDirection="RightToLeft">
            <dxga:DigitalGaugeControl.Model>
                <dxga:DigitalCleanWhiteModel/>
            </dxga:DigitalGaugeControl.Model>
            <dxga:DigitalGaugeControl.Layers>
                <dxga:DigitalGaugeLayer x:Name="backgroundLayer" Visible="False"/>
            </dxga:DigitalGaugeControl.Layers>
            <dxga:DigitalGaugeControl.SymbolView>
              <!--<dxga:MatrixView8x14 x:Name="labelLayer">
                --><!--region #MatrixOptions--><!--
                <dxga:MatrixView8x14.Options>
                  <dxga:SymbolOptions SkewAngleX="5" SkewAngleY="5" />
                </dxga:MatrixView8x14.Options>
                --><!--endregion #MatrixOptions--><!--
                --><!--region #MatrixAnimation--><!--
                <dxga:MatrixView8x14.Animation>
                  <dxga:CreepingLineAnimation RefreshTime="00:00:00.2000000"
                                              Repeat="True" />
                </dxga:MatrixView8x14.Animation>
                --><!--endregion #MatrixAnimation--><!--
              </dxga:MatrixView8x14>-->
              <dxga:SevenSegmentsView x:Name="labelLayer">
                    <dxga:SevenSegmentsView.Presentation>
                        <dxga:DefaultSevenSegmentsPresentation 
                            FillInactive="{Binding Path=FillInactive, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                            FillActive="{Binding Path=FillActive, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" />
                    </dxga:SevenSegmentsView.Presentation>              
            </dxga:SevenSegmentsView>
            </dxga:DigitalGaugeControl.SymbolView>
        </dxga:DigitalGaugeControl>
    </Grid>
    <!--</Viewbox>-->
</UserControl>
