<UserControl x:Class="UFShortcutEditor.Controls.NewKeyCommandDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFShortcutEditor.Properties" 
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:commontemplate="clr-namespace:OPCUAViewModel.PropertyDataTemplate;assembly=OPCUAViewModel"
             mc:Ignorable="d" Height="700" Width="500"
             d:DesignHeight="700" d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  DockPanel.Dock="Top" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewKeyCommandDefinitionTitle}" VerticalAlignment="Center" FontWeight="Bold" />

                <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewKeyCommandDefinitionName}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeyName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                         x:Name="textEditName" />
                <ContentPresenter Grid.Row="1" Grid.Column="2" Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewKeyCommandDefinitionDescription}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Description}" x:Name="textEditDesc" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewKeyCommandDefinitionKey}" VerticalAlignment="Center" />
                <DockPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click_Clear" 
                            DockPanel.Dock="Right">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="14" Width="14" />
                        </Button.Content>
                    </Button>
                    <Button Click="Button_Click" DockPanel.Dock="Right">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="14" Width="14" />
                        </Button.Content>
                    </Button>
                    <TextBox x:Name="textEditKey" Text="{Binding ShortcutKey, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" />
                </DockPanel>
                <ContentPresenter Grid.Row="3" Grid.Column="2" Content="{Binding ElementName=textEditKey, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewKeyCommandDefinitionSpeech}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding SpeechCommand}" x:Name="textEditSpeech" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.NewKeyCommandDefinitionEnable}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Grid.Row="5" x:Name="checkBoxEnable"  IsChecked="{Binding Enabled}"  HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5"/>

                <TextBlock Grid.Row="6" x:Name="lblEditEnable" Text="{x:Static properties:Resources.NewKeyCommaNewKeyCommandDefinitionEnableTag}" VerticalAlignment="Center" />
                <DockPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textEditEnable"/>
                </DockPanel>
                <ContentPresenter Grid.Row="6" Grid.Column="2" Content="{Binding ElementName=textEditEnable, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.NewKeyCommandDefinitionDown}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Grid.Row="7" x:Name="checkBoxDown" IsChecked="{Binding Down}"  HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" Margin="5"/>
            </Grid>
        </ScrollViewer>
        <Grid DockPanel.Dock="Bottom">
            <!--<TextBlock Text="{x:Static properties:Resources.NewKeyCommandDefinitionCommand}" VerticalAlignment="Center" />-->
            <ContentControl x:Name="CommandCtrl" />
        </Grid>
    </DockPanel>
</UserControl>
