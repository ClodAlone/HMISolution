<Window x:Class="UFShortcutEditor.Controls.SimpleWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFShortcutEditor.Properties" 
             mc:Ignorable="d" WindowStartupLocation="CenterOwner"
             d:DesignHeight="300" d:DesignWidth="300" Width="300" Height="300"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentPresenter x:Name="SimpleContent" Grid.Row="0" />
        <StackPanel Visibility="Collapsed" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button HorizontalAlignment="Center" x:Name="btnClose" Margin="5,5,5,5" Content="{x:Static properties:Resources.Close}" Click="btnClose_Click"/>
        <Button HorizontalAlignment="Center" IsCancel="True" Margin="5,5,5,5">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
