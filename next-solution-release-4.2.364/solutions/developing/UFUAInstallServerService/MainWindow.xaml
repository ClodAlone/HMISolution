<dx:DXWindow x:Class="UFUAInstallServerService.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:uc="clr-namespace:UFUAServiceLibrary;assembly=UFUAServiceLibrary"
        xmlns:properties="clr-namespace:UFUAInstallServerService.Properties"
        xmlns:cc="http://progea.com/CommonControls"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        WindowStartupLocation="CenterScreen" BorderEffect="Default" 
        Background="{x:Null}" SizeToContent="WidthAndHeight"
        Title="{x:Static properties:Resources.AppTitle}">
    
    <Grid Name="maingrid">
        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock Grid.Column="4" FontStyle="Italic"
          Foreground="Red" FontSize="12"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>
        <uc:InstallServiceControl x:Name="serviceControl"/>
    </Grid>
</dx:DXWindow>
