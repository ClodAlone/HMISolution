                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Metro Foreground Brush"/>
                    <ComboBox x:Name="FgBrushes" SelectionChanged="FgBrushes_SelectionChanged"
                                Height="30" Width="200" Margin="10" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="25" Height="25" Fill="{Binding Brush}" Margin="1"/>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MetroForeground}" Text="{Binding Name}" Grid.Column="1" Margin="3"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </tools:RibbonBar>-->
                
            </tools:RibbonTab>

        </tools:Ribbon>

        <Grid VerticalAlignment="Center" x:Name="MenuGrid" Visibility="Collapsed" Grid.ColumnSpan="2" Margin="0,72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu x:Name="MainMenu" ClipToBounds="True" SnapsToDevicePixels="True"
                  VerticalAlignment="Center" HorizontalContentAlignment="Stretch" IsMainMenu="True">
                <Menu.Resources>
                    <Style TargetType="{x:Type Menu}" x:Key="{x:Type Menu}" BasedOn="{StaticResource {x:Type Menu}}">
                        <EventSetter Event="GotFocus" Handler="OnGotFocus" />
                        <EventSetter Event="LostFocus" Handler="OnLostFocus" />
                    </Style>
                </Menu.Resources>

                <MenuItem Header="{x:Static self:UIGeneralCommands.FileMenuText}">
                    <MenuItem Command="ApplicationCommands.New" Header="{x:Static appproperties:ApplicationCommandsResource.New}"/>
                    <MenuItem Command="ApplicationCommands.Open"  Header="{x:Static appproperties:ApplicationCommandsResource.Open}"/>
                    <MenuItem Command="ApplicationCommands.Save"  Header="{x:Static appproperties:ApplicationCommandsResource.Save}"/>
                    <MenuItem Command="ApplicationCommands.SaveAs" Header="{x:Static appproperties:ApplicationCommandsResource.SaveAs}" />
                    <Separator />
                    <MenuItem Command="{x:Static self:UIGeneralCommands.Exit}" />
                </MenuItem>
                <MenuItem Header="{x:Static self:UIGeneralCommands.ViewMenuText}">
                    <MenuItem Header="{x:Static self:UIGeneralCommands.StatusbarText}"
                        x:Name="_viewStatusBar"
                        IsCheckable="True"
                        IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=StatusbarVisible, Mode=TwoWay}" />
                    <MenuItem Header="{x:Static self:UIGeneralCommands.MagnifierToolText}"
                        x:Name="_magnifierTool"
                        IsCheckable="True"
                        IsChecked="{Binding ElementName=MainWnd, Path=MagnifierTool, Mode=TwoWay}" />
                </MenuItem>
                <MenuItem Header="Windows" Name="menuitem2">
                </MenuItem>
            </Menu>
            <Menu Grid.Column="1">
                <MenuItem Header="Skins" Name="SkinChange">
                    <MenuItem Header="Default" IsCheckable="True"
                        Click="skin_change">
                        <MenuItem.Icon>
                            <Image Source="Images\Default.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Blend" IsCheckable="True"
                        Click="skin_change">
                        <MenuItem.Icon>
                            <Image Source="Images\Blend.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Office2007Blue" IsCheckable="True"
                        IsChecked="True" Click="skin_change">
                        <MenuItem.Icon>
                            <Image Source="Images\Blue.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Office2007Silver" IsCheckable="True"
                        Click="skin_change">
                        <MenuItem.Icon>
                            <Image Source="Images\Silver.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Office2007Black" IsCheckable="True"
                        Click="skin_change">
                        <MenuItem.Icon>
                            <Image Source="Images\Black.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="SyncOrange" IsCheckable="True"
                        Click="skin_change">
                        <MenuItem.Icon>
                            <Image Source="Images\Black.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </Grid>

        <!-- StatusBar -->
        <StatusBar x:Name="statusbar" Grid.Row="1" Visibility="{Binding Path=IsChecked, Converter={StaticResource BoolToVisibilityConv}, ConverterParameter=false, ElementName=_viewStatusBar}" Grid.ColumnSpan="2">
            <ProgressBar x:Name="progressStatusbar" Height="20" Width="100" Value="100" Visibility="Collapsed" />
            <Separator />
            <StatusBarItem x:Name="StatusBarText" Content="{Binding ElementName=MainWnd, Path=StatusText}" />
        </StatusBar>

        <!-- Docking Window Area -->
        <tools:DockingManager x:Name="dockingManager" Grid.Row="1"
                              UseDocumentContainer="True"
                                                            
                              SizetoContentInFloat="True"
                              DockFill="False"
                              
                              MinimizeButtonEnabled="True"
                              MaximizeButtonEnabled="True"
                              EnableScrollableSidePanel="True"
                              IsAnimationEnabledOnMouseOver="False"
                              IsTabPreviewEnabled="True"
                              IsEnableHotTracking="True"
                              
                              ContainerMode="TDI" 
                              SwitchMode="Immediate"
                              
                              UseInteropCompatibilityMode="False"
                              PersistState="False"
                              WindowVisibilityChanged="DockingManager_WindowVisibilityChanged"
                              WindowActivated="DockingManager_WindowActivated"
                              WindowDeactivated="DockingManager_WindowDeactivated"
                              WindowDragEnd="DockingManager_WindowDragEnd"
                              WindowDragStart="DockingManager_WindowDragStart"
                              ActiveWindowChanging="DockingManager_ActiveWindowChanging"
                              ActiveWindowChanged="DockingManager_ActiveWindowChanged"
                              BeforeContextMenuOpen="DockingManager_BeforeContextMenuOpen"

                              CloseAllTabs="DockingManager_CloseAllTabs"
                              CloseButtonClick="DockingManager_CloseButtonClick"
                              CloseOtherTabs="DockingManager_CloseOtherTabs"
                              DockStateChanged="DockingManager_DockStateChanged"
                              ElementHidden="DockingManager_ElementHidden"
                              ElementShown="DockingManager_ElementShown"

                              Grid.ColumnSpan="2">

            <!--<tools:DockingManager.DocumentTabControlStyle>
                <Style TargetType="{x:Type tools:TabControlExt}">
                    <Setter Property="CloseButtonType" Value="IndividualOnMouseOver" />
                </Style>
            </tools:DockingManager.DocumentTabControlStyle>-->

            <Grid tools:DockingManager.Header="{x:Static properties:Resources.LogTitle}"
                  tools:DockingManager.SideInDockedMode="Bottom"
				  tools:DockingManager.State="AutoHidden" x:Name="gridLogView"
				  tools:DockingManager.DesiredHeightInDockedMode="300"
				  tools:DockingManager.DesiredWidthInDockedMode="500"
				  tools:DockingManager.CanClose="False">
                <tools:DockingManager.Icon>
                    <!--<ImageBrush ImageSource="{StaticResource Search}" />-->
                    <ImageBrush ImageSource="Images\trace.png" />
                </tools:DockingManager.Icon>

                <!--<LogViewer:LogViewer />-->
            </Grid>

        </tools:DockingManager>

        <!--<Grid x:Name="gridWait" Background="Black" Opacity="0.5" Grid.RowSpan="5" Visibility="Collapsed">
            
        </Grid>-->
    </Grid>

</tools:RibbonWindow>