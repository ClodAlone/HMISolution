<tools:RibbonWindow xmlns:LogViewer="clr-namespace:LogViewer;assembly=LogViewer"  x:Class="UFSolution.UFMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tools="http://schemas.syncfusion.com/wpf"
    xmlns:properties="clr-namespace:UFSolution.Properties"
    xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
    xmlns:TraceTextBox="clr-namespace:TraceTextBox"
    xmlns:self="clr-namespace:UFSolution"
    xmlns:cc="http://progea.com/CommonControls"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontWeight="Light"
    WindowState="Normal"
    Width="800"
    Height="600"
    
    IsGlassActive="False"
    AutoPersist="False"
    Icon="App.ico" Office2010Icon="App.ico"
    Title="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitle, Mode=OneWay}"
    x:Name="MainWnd"
    Closing="Window_Closing" Closed="Window_Closed" Loaded="Window_Loaded" ContentRendered="MainWnd_ContentRendered">

    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />-->
                <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
                <ResourceDictionary Source="Resources\FillingBrushes.xaml" />
                <ResourceDictionary Source="Resources\Storyboards.xaml" />
                <ResourceDictionary Source="/Syncfusion.VectorImages.WPF;component/Icons/BlendIcons.xaml" />
                <ResourceDictionary Source="/Syncfusion.VectorImages.WPF;component/Icons/General.xaml" />
                <ResourceDictionary Source="/Syncfusion.VectorImages.WPF;component/Icons/Computer.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DockingTabStyle" TargetType="{x:Type tools:TabControlExt}">
                <Setter Property="CloseButtonType" Value="Individual" />
            </Style>

            <ControlTemplate x:Key="MiniToolbarTemplate">
                <Border x:Name="PART_Border" Height="51" BorderThickness="2" CornerRadius="3">
                    <ItemsPresenter Margin="2"></ItemsPresenter>
                </Border>
            </ControlTemplate>

        </ResourceDictionary>

    </Window.Resources>

    <!--<tools:RibbonWindow.StatusBar>
        <tools:RibbonStatusBar Grid.Row="2" Visibility="{Binding Path=IsChecked, Converter={StaticResource BoolToVisibilityConv}, ConverterParameter=false, ElementName=_viewStatusBar}">
            <ProgressBar x:Name="progressStatusbar"  Height="20"  Width="100" Value="100" Visibility="Collapsed"/>
            <Separator/>
            <StatusBarItem x:Name="StatusBarText" Content="{Binding ElementName=MainWnd, Path=StatusText}" />
        </tools:RibbonStatusBar>
    </tools:RibbonWindow.StatusBar>-->

    <!-- Command Binding section -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static self:UIGeneralCommands.Exit}"
                    Executed="OnFileExit"
                    CanExecute="CanAlwaysExecute" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.FullScreen}"
                    Executed="OnFullScreen"
                    CanExecute="CanExecuteFullScreen" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.LanguagePreferences}"
                    Executed="OnLanguagePreferences"
                    CanExecute="CanAlwaysExecute" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.EasyMode}"
                    Executed="OnEasyMode"
                    CanExecute="CanAlwaysExecute" />
    </Window.CommandBindings>

    <Grid Name="MainGrid" Background="{DynamicResource Metro}">
        <Grid.RowDefinitions>
            <RowDefinition ToolTip="properties" Height="Auto" />
            <RowDefinition ToolTip="controls" Height="*" />
            <RowDefinition ToolTip="statusbar" Height="Auto" />
        </Grid.RowDefinitions>

        <self:NotificationAreaIcon x:Name="notifyIcon"
                      Text="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitle, Mode=OneWay}"
                      Icon="App.ico"
                      MouseDoubleClick="OnNotificationAreaIconDoubleClick" Grid.ColumnSpan="2">
            <!--<self:NotificationAreaIcon.MenuItems>
                <forms:MenuItem Text="Open" Click="OnMenuItemOpenClick" DefaultItem="True" />
                <forms:MenuItem Text="-" />
                <forms:MenuItem Text="Exit" Click="OnMenuItemExitClick" />
            </self:NotificationAreaIcon.MenuItems>-->
        </self:NotificationAreaIcon>

        <!--<tools:NotifyIcon Name="notifyIcon"
                               BalloonTipHidden="NotifyIcon_BalloonTipHidden"
                               BalloonTipHiding="NotifyIcon_BalloonTipHiding"
                               BalloonTipOpened="NotifyIcon_BalloonTipOpened"
                               BalloonTipOpening="NotifyIcon_BalloonTipOpening"
							   BalloonTipHeaderVisibility="Visible"
							   BalloonTipIcon="Info"
							   BalloonTipShape="Balloon"
                               BalloonTipAnimationEffect="Fade"
							   ShowBalloonTipTime="1000"
							   HideBalloonTipTime="1000">
        </tools:NotifyIcon>-->

        <!--<*********************************************************************
            Ribbons
             ****************************************************************>-->

        <tools:Ribbon x:Name="Ribbons" VerticalAlignment="Top" RibbonState="Normal" 
                      RibbonBarCollapseImage="{StaticResource FolderIcon}" RibbonContextMenuOpening="Ribbon_RibbonContextMenuOpening"
                      SelectionChanged="Ribbons_SelectionChanged" AutoPersist="False" Grid.ColumnSpan="2">

            <!--Applicaton Menu-->
            <tools:Ribbon.ApplicationMenu>
                <tools:ApplicationMenu Width="38" Height="38" tools:Ribbon.KeyTip="F" HorizontalContentAlignment="Left"
						ApplicationButtonImage="Images\Next.png" ApplicationButtonImageHeight="28" ApplicationButtonImageWidth="28" IsPopupOpen="False" >
                    <tools:ApplicationMenu.ToolTip>
                        <tools:ScreenTip MinWidth="150" Description="Application Menu" ImageSource="Images\Next.png" VerticalOffset="10">
                            <TextBlock TextWrapping="Wrap" Width="180">
								Click here to open, save or print, and to see everything you can do with your document
                            </TextBlock>
                        </tools:ScreenTip>
                    </tools:ApplicationMenu.ToolTip>
                    <!--Application Recent Document list Area-->
                    <tools:ApplicationMenu.MenuItems>
                        <TextBlock MinWidth="300" FontWeight="Bold" Text="{Binding Source={x:Static properties:Resources.ApplicationMenuToolTip}}" />
                        <Separator Padding="0" />
                    </tools:ApplicationMenu.MenuItems>
                </tools:ApplicationMenu>
            </tools:Ribbon.ApplicationMenu>

            <!--<tools:Ribbon.BackStage>
                <tools:Backstage Name="RibbonBackStage" />
            </tools:Ribbon.BackStage>-->

                <tools:Ribbon.QuickAccessToolBar>
                <tools:QuickAccessToolBar AutoPersist="False">
                    <tools:RibbonButton tools:Ribbon.KeyTip="1" Command="{x:Static self:UIGeneralCommands.FullScreen}"
                                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                        SizeForm="ExtraSmall" SmallIcon="Images/FullScreen.png" tools:RibbonCommandManager.SynchronizedItem="FullScreen" />

                    <tools:RibbonButton tools:Ribbon.KeyTip="2" Command="ApplicationCommands.Save" tools:RibbonCommandManager.SynchronizedItem="Save"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.Save}"
                                        SizeForm="ExtraSmall" SmallIcon="Images/Save.png" />
                    <tools:RibbonButton tools:Ribbon.KeyTip="2" Command="ApplicationCommands.SaveAs" tools:RibbonCommandManager.SynchronizedItem="SaveAs"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.SaveAs}"
                                        SizeForm="ExtraSmall" SmallIcon="Images/saveas_16x16.png" />
                    <tools:RibbonButton tools:Ribbon.KeyTip="3" Command="ApplicationCommands.Copy" tools:RibbonCommandManager.SynchronizedItem="Copy"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.Copy}"
                                          SizeForm="ExtraSmall" SmallIcon="Images/Copy.png" />
                    <tools:RibbonButton tools:Ribbon.KeyTip="4" Command="ApplicationCommands.Paste" tools:RibbonCommandManager.SynchronizedItem="Paste"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.Paste}"
                                          SizeForm="ExtraSmall" SmallIcon="Images/Paste.png" />
                    <tools:RibbonButton tools:Ribbon.KeyTip="5" Command="ApplicationCommands.Undo" tools:RibbonCommandManager.SynchronizedItem="Undo"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.Undo}"
                                          SizeForm="ExtraSmall" SmallIcon="Images/Undo.png" />
                    <tools:RibbonButton tools:Ribbon.KeyTip="6" Command="ApplicationCommands.Redo" tools:RibbonCommandManager.SynchronizedItem="Redo"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.Redo}"
                                          SizeForm="ExtraSmall" SmallIcon="Images/Redo.png" />

                    <tools:RibbonButton tools:Ribbon.KeyTip="7" Command="ApplicationCommands.Print" tools:RibbonCommandManager.SynchronizedItem="Print"
                                        ToolTip="{x:Static appproperties:ApplicationCommandsResource.Print}"
                                          SizeForm="ExtraSmall" SmallIcon="Images/Print.png" />
                </tools:QuickAccessToolBar>
            </tools:Ribbon.QuickAccessToolBar>
            <!-- Ribbon Tab-->
            <tools:RibbonTab Caption="{x:Static properties:Resources.EditRibbonTitle}" tools:Ribbon.KeyTip="H" IsChecked="False">

                <!-- Ribbon Bar for Clipboard-->
                <tools:RibbonBar Header="{x:Static properties:Resources.ClipboardRibbonTitle}" x:Name="barClipboard" tools:Ribbon.KeyTip="FN">

                    <tools:RibbonButton Label="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" SizeForm="Small" SmallIcon="Images/Paste.png" Command="ApplicationCommands.Paste" tools:RibbonCommandManager.SynchronizedItem="Paste" />
                    <tools:RibbonButton Label="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" SizeForm="Small" SmallIcon="Images/Cut.png" Command="ApplicationCommands.Cut" tools:RibbonCommandManager.SynchronizedItem="Cut" />
                    <tools:RibbonButton Label="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" SizeForm="Small" SmallIcon="Images/Copy.png" Command="ApplicationCommands.Copy" tools:RibbonCommandManager.SynchronizedItem="Copy" />
                    <tools:RibbonButton Label="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" SizeForm="Small" SmallIcon="Images/Delete.png" Command="ApplicationCommands.Delete" tools:RibbonCommandManager.SynchronizedItem="Delete" />

                </tools:RibbonBar>

            </tools:RibbonTab>

            <tools:RibbonTab Caption="{x:Static properties:Resources.SettingsRibbonTitle}" tools:Ribbon.KeyTip="S" IsChecked="False">

                <tools:RibbonBar Header="{x:Static properties:Resources.CertificateRibbonTitle}">
                    <tools:RibbonButton Label="{x:Static properties:Resources.ApplicationCertificateRibbonTitle}" 
                                        Content="{x:Static properties:Resources.CheckCertificateRibbonTitle}" SizeForm="Large"  
                                        LargeIcon="Images\certificate.png" Click="CheckCertificate_Click"/>
                </tools:RibbonBar>

                <tools:RibbonBar Header="{x:Static properties:Resources.LanguagePreferencesRibbonTitle}">
                    <tools:RibbonButton Label="{x:Static properties:Resources.LanguagePreferencesCommandTitle}" 
                                        Content="{x:Static properties:Resources.LanguagePreferencesCommandTitle}" SizeForm="Large"  
                                        LargeIcon="Images\LanguagePreferences_32x32.png" 
                                        Command="{x:Static self:UIGeneralCommands.LanguagePreferences}"/>
                </tools:RibbonBar>

                <tools:RibbonBar Header="{x:Static properties:Resources.EasyModeRibbonTitle}">
                    <tools:RibbonButton Label="{x:Static properties:Resources.EasyModeCommandTitle}" x:Name="rbEasyMode"
                                        Content="{x:Static properties:Resources.EasyModeCommandTitle}"
                                        Command="{x:Static self:UIGeneralCommands.EasyMode}" 
                                        LargeIcon="Images\EasyMode_32x32.png" SizeForm="Large" />
                </tools:RibbonBar>



                <!--<tools:RibbonBar Header="Theme" >

                    <TextBlock Text="Theme"/>
                    <ComboBox x:Name="comboTheme" SelectionChanged="Theme_SelectionChanged"
                                    Height="30" Width="200" Margin="10" >
                        <ComboBoxItem Content="None"/>
