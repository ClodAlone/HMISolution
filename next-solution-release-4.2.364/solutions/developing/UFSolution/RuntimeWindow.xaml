<Window x:Class="UFSolution.RuntimeWindow" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" Closed="Window_Closed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:self="clr-namespace:UFSolution" AllowsTransparency="True"
        xmlns:properties="clr-namespace:UFSolution.Properties" Background="{x:Null}"  
        Title="RuntimeWindow" Width="720" Height="420" Icon="/MoviconNeXT;component/App.ico" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None" SizeToContent="WidthAndHeight" ShowInTaskbar="False">
    <Grid>
        <self:NotificationAreaIcon x:Name="notifyIcon"
                      Text="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitleRuntime, Mode=OneWay}"
                      Icon="App.ico"
                      MouseDoubleClick="OnNotificationAreaIconDoubleClick">
            <!--<self:NotificationAreaIcon.MenuItems>
                <forms:MenuItem Text="Open" Click="OnMenuItemOpenClick" DefaultItem="True" />
                <forms:MenuItem Text="-" />
                <forms:MenuItem Text="Exit" Click="OnMenuItemExitClick" />
            </self:NotificationAreaIcon.MenuItems>-->
        </self:NotificationAreaIcon>

        <ContentControl x:Name="splashContent" />
        <Label Margin="0,0,32,101" x:Name="versionLabel" Content="Version {0}" FontSize="18" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="Black" />
        <Label Margin="0,0,32,88" x:Name="revisionLabel" Content="Version {0}" FontSize="12" FontWeight="Normal" FontStyle="Italic" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="Black" />
        <Label x:Name="terminatingLabel" Content="{x:Static properties:Resources.IsTerminatingText}" FontSize="45" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" Visibility="Collapsed" />
    </Grid>
</Window>
