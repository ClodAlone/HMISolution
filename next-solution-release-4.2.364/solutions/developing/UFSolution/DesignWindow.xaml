<Window x:Class="UFSolution.DesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" AllowsTransparency="True"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{x:Null}"  
        Width="720" Height="420" Icon="/MoviconNExT;component/App.ico" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None" SizeToContent="WidthAndHeight" ShowInTaskbar="False">

    <Grid>
        <ContentControl x:Name="splashContent" />
        <Label Margin="0,0,32,101" x:Name="versionLabel" Content="Version {0}" FontSize="18" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="Black" />
        <Label Margin="0,0,32,88" x:Name="revisionLabel" Content="Version {0}" FontSize="12" FontWeight="Normal" FontStyle="Italic" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="Black" />
    </Grid>
</Window>
