<UserControl x:Class="UFSolutionNext.DXSplashScreen.WaitWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFSolutionNext.DXSplashScreen"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:UFSolutionNext.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <dx:WaitIndicator DeferedVisibility="True" Content="{Binding WaitIndicatorText}">
            <!-- DeferedVisibility="{Binding IsBusy}"-->
            <dx:WaitIndicator.ContentTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.WaitIndicatorTitle}" FontSize="20"/>
                        <TextBlock Text="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </dx:WaitIndicator.ContentTemplate>
        </dx:WaitIndicator>
    </Grid>
</UserControl>
