<dxb:BarSubItem
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="MSEditor.MenuControls.BarCommonItems"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:MSEditor"
             xmlns:properties="clr-namespace:MSEditor.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/SchedulerServer.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewScheduler" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="70" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="70" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectScheduler" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="30" x:Name="biScheduler" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <dxb:BarButtonItem  x:Name="biAddNewEventText" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.AddNewEvent}" 
                                   Content="{x:Static properties:UICommandResource.AddNewEventText}" Glyph="{StaticResource SSAddNewEvent}"/>
            <dxb:BarButtonItem x:Name="biAddNewFolderText" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.AddNewFolder}" 
                                   Content="{x:Static properties:UICommandResource.AddNewFolderText}" Glyph="{StaticResource AddFolderSmall}"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarSubItem Content="{x:Static properties:Resources.ServerRibbonTitle}">
                <dxb:BarButtonItem x:Name="biStartServerText" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                       RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.StartServer}"
                                       Content="{x:Static properties:UICommandResource.StartServerText}" Glyph="{StaticResource SSStartServerSmall}"/>
                <dxb:BarButtonItem x:Name="biStopServerText" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                       RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.StopServer}"
                                       Content="{x:Static properties:UICommandResource.StopServerText}" Glyph="{StaticResource SSStopServerSmall}"/>
                
            </dxb:BarSubItem>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItem x:Name="biServiceManager" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource UFUASServiceManager}"  
                             Command="{x:Static self:UIGeneralCommands.ServiceManager}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
</dxb:BarSubItem>
