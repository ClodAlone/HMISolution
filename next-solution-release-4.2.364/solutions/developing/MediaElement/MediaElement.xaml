<UserControl x:Class="MediaElement.MediaElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:properties="clr-namespace:MediaElement.Properties"
             xmlns:converters="clr-namespace:Converters;assembly=Converters" Foreground="White" Background="#FF333333"
             mc:Ignorable="d" Height="695" Width="788">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/MediaElement.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseTransformConverter x:Key="InverseTransformConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#2D2D2D">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="1" x:Name="controls">
            <Grid HorizontalAlignment="Left" 
				Grid.Row="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Play button. -->
              <Button Click="OnClickPlayMedia" Width="60" Height="60">
                <Image x:Name="play" Source="{DynamicResource MELPlay}" Margin="5" />
              </Button>

              <!-- Pause button. -->
              <Button Grid.Column="1" Click="OnClickPauseMedia"  Width="60" Height="60">
                <Image x:Name="pause" Source="{DynamicResource MELPause}" Margin="5" />
              </Button>

                  <!-- Stop button. -->
              <Button Grid.Column="2" Click="OnClickStopMedia"  Width="60" Height="60">
                <Image x:Name="stop" Source="{DynamicResource MELStop}" Margin="5" />
              </Button>
              <!-- Volume slider. This slider allows a Volume range between 0 and 1. -->
                <TextBlock  Grid.Column="4" Foreground="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"  FontSize="20" x:Name="volumeSliderTextBlock" VerticalAlignment="Center" Margin="20,0" Text="{x:Static properties:Resources.Volume}" />
                <Slider  Grid.Column="5" x:Name="volumeSlider" VerticalAlignment="Center" ValueChanged="ChangeMediaVolume" 
					Minimum="0" Maximum="1" Value="0.5" Width="120" Margin="0"/>

                <!-- Volume slider. This slider allows you to change the speed of the media playback. -->
                <TextBlock Grid.Column="6" Foreground="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" x:Name="speedRatioSliderTextBlock" FontSize="20" Margin="20,0"  VerticalAlignment="Center" Text="{x:Static properties:Resources.Speed}" Width="65" />
                <Slider Grid.Column="7" x:Name="speedRatioSlider" HorizontalAlignment="Stretch" VerticalAlignment="Center" ValueChanged="ChangeMediaSpeedRatio" 
					Value="1" Width="120" Margin="0" />
                <TextBlock Grid.Column="8" FontSize="20" x:Name="timelineSliderTextBlock" Foreground="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="20,0"  VerticalAlignment="Center" Text="{x:Static properties:Resources.Seek}" Width="79" />
                <Slider Grid.Column="9" x:Name="timelineSlider"  HorizontalAlignment="Stretch" VerticalAlignment="Center"  ValueChanged="SeekToMediaPosition" Width="120" Margin="0,0,20,0"/>

                <!-- Seek to slider. Ths slider allows you to jump to different parts of the media playback. -->

            </Grid>
        </Viewbox>
        <TextBlock x:Name="disabledControlContent" Text="{x:Static properties:Resources.DisabledControlText}" VerticalAlignment="Center"
				HorizontalAlignment="Center" Grid.Row="1" Visibility="Collapsed"/>
        <TextBlock x:Name="errorContent" Text="{x:Static properties:Resources.NotSupportedFormat}" VerticalAlignment="Center"
				Grid.Row="0" HorizontalAlignment="Stretch" TextAlignment="Center" FontSize="16" Visibility="Collapsed"/>
        <MediaElement Grid.Row="0" x:Name="mediaElement" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
				LoadedBehavior="Manual" 
				UnloadedBehavior="Close" 
				Stretch="Fill"
				MediaOpened="Element_MediaOpened" MediaEnded="Element_MediaEnded">
            <MediaElement.LayoutTransform>
                <MultiBinding Converter="{StaticResource InverseTransformConverter}">
                    <Binding Path="KeepAspectRatio" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="." RelativeSource="{RelativeSource AncestorType=Canvas}" />
                    <Binding Path="ActualWidth" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=Window}" />
                    <Binding Path="ActualHeight" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </MediaElement.LayoutTransform>
        </MediaElement>
    </Grid>
</UserControl>
