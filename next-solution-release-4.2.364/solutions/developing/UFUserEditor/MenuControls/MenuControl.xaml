<wpfutilities:BarManagerBase
    xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities" x:Class="UFUserEditor.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:self="clr-namespace:UFUserEditor"
             xmlns:menucontrols="clr-namespace:UFUserEditor.MenuControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="UsersBarManager"
             mc:Ignorable="d">
    <dxb:BarManager.CommandBindings>
        <CommandBinding Command="{x:Static self:UIGeneralCommands.ShowToolbar}" 
                    Executed="OnShowToolbar" 
                    CanExecute="CanAlwaysExecute" />
    </dxb:BarManager.CommandBindings>
    <dxb:BarManager.Items>
        <menucontrols:BarCommonItems x:Name="menuItems" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}" />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="UserMngMenu">
            <dxb:BarSubItemLink BarItemName="biViewUsers" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="biProjectUsers" MergeType="MergeItems" />
        </dxb:Bar>
    </dxb:BarManager.Bars>
</wpfutilities:BarManagerBase>
