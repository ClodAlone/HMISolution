<UserControl x:Class="UFUserEditor.Controls.NewRole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUserEditor.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Width="300" Height="300"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="50*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--<TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                       Height="Auto" 
                       x:Name="roleProperties" 
                       VerticalAlignment="Center" FontWeight="Bold" />-->

            <TextBlock Height="Auto" Grid.Row="1" x:Name="roleName" VerticalAlignment="Center" />
            <DockPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditName}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            </DockPanel>
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" x:Name="roleAccessLevel" VerticalAlignment="Center" />
            <DockPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditAccessLevel}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Name="textEditAccessLevel" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 Text="{Binding AccessLevel, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            </DockPanel>
            <ContentPresenter Grid.Row="2" Grid.Column="2" 
            Content="{Binding ElementName=textEditAccessLevel, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="3" x:Name="roleAccessMask" VerticalAlignment="Center" />
            <DockPanel Grid.Row="3" Grid.Column="1" x:Name="editAccesMask" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button x:Name="bitmask" DockPanel.Dock="Right" 
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding AccessMask, Mode=TwoWay}" Click="AMButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox x:Name="text" IsReadOnly="False" Text="{Binding Path=Tag, ElementName=bitmask, UpdateSourceTrigger=LostFocus, StringFormat=X8}" />
            </DockPanel>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=editAccesMask, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" x:Name="roleCultureName" VerticalAlignment="Center" />
            <!--<ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding CultureName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="cmbCultures" IsEditable="False" />-->

            <dxe:ComboBoxEdit Grid.Row="4" Grid.Column="1" SelectedItem="{Binding CultureName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 BorderBrush="{Binding ElementName=textEditName, Path=BorderBrush}"
                 IsTextEditable="False"
                 x:Name="cmbCultures">
                <dxe:ComboBoxEdit.BorderTemplate>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <Border BorderThickness="1" BorderBrush="{Binding ElementName=textEditName, Path=BorderBrush}" 
                                Background="{Binding ElementName=textEditName, Path=Background}" 
                            CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </dxe:ComboBoxEdit.BorderTemplate>
                <dxe:ComboBoxEdit.Resources>
                    <Style TargetType="dxe:ButtonInfo">
                        <Setter Property="Template">
                            <Setter.Value>
                                <DataTemplate>
                                    <Button x:Name="PART_Item" Content="▼" MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </dxe:ComboBoxEdit.Resources>
            </dxe:ComboBoxEdit>
            <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=cmbCultures, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="5" x:Name="roleTelegramID" VerticalAlignment="Center" />
            <DockPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" x:Name="roleTelegramIDeditBtn"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textTelegramGroupChatID}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Name="textTelegramGroupChatID" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 Text="{Binding TelegramGroupChatID, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            </DockPanel>
            <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=textTelegramGroupChatID, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </ScrollViewer>
</UserControl>
