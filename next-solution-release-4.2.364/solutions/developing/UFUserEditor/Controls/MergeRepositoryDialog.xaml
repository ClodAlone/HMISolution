<UserControl x:Class="UFUserEditor.Controls.MergeRepositoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFUserEditor.Controls"
             xmlns:properties="clr-namespace:UFUserEditor.Properties"
             Height="120" Width="280">
    <Grid>
        <GroupBox Header="{x:Static properties:Resources.MoveToSharedRepositoryOptionsTitle}" HorizontalAlignment="Stretch" Margin="10,10,10,10" VerticalAlignment="Top" >
            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="20" />
                    <RowDefinition MinHeight="20" />
                    <RowDefinition MinHeight="20" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center"
                  Content="{x:Static properties:Resources.MoveToSharedRepositoryAllSettingsOption}"
                  IsChecked="{Binding CopyAllSettings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="1" Grid.ColumnSpan="2"  VerticalAlignment="Center"
                  Content="{x:Static properties:Resources.MoveToSharedRepositoryAllUsersOption}"
                  IsChecked="{Binding CopyUsersAndGroups, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="2" Grid.Column="1"  VerticalAlignment="Center"
                  Content="{x:Static properties:Resources.MoveToSharedRepositoryReplaceUsersOption}"
                  IsChecked="{Binding ReplaceExistingsUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  IsEnabled="{Binding CopyUsersAndGroups, Mode=OneWay}" />
            </Grid>

        </GroupBox>
    </Grid>
</UserControl>
