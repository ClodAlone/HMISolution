    <Setting Name="sp_removemembership" Type="System.String" Scope="Application">
      <Value Profile="(Default)">CREATE PROCEDURE [dbo].[sp_removemembership] @applicationName nvarchar(max), @serverName nvarchar(max) = NULL
AS
BEGIN
	DECLARE @applicationId uniqueidentifier
	DECLARE @linkedServerName nvarchar(255) = N''
	DECLARE @sqlQuery nvarchar(max)	

	IF @serverName IS NOT NULL
	BEGIN
		DECLARE @instanceServerName nvarchar(255)
		SET @instanceServerName = @@SERVERNAME
		IF @instanceServerName IS NULL SELECT @instanceServerName = CAST(SERVERPROPERTY('servername') AS nvarchar(255))
		IF @serverName != @instanceServerName SET @linkedServerName = N'[' + @serverName + '].'
	END

	SET @sqlQuery = 'SELECT @applicationIdOut = ApplicationId FROM ' + @linkedServerName + '[Movicon.Membership].[dbo].[aspnet_Applications] WHERE [LoweredApplicationName] = @applicationNameIn'
	EXEC sp_executesql @sqlQuery,
		N'@applicationNameIn nvarchar(max), @applicationIdOut uniqueidentifier OUTPUT', 
		@applicationNameIn = @applicationName, @applicationIdOut = @applicationId OUTPUT

	SET @sqlQuery = 'DELETE FROM ' + @linkedServerName + '[Movicon.Membership].[dbo].[aspnet_Membership] WHERE [ApplicationId] = @applicationIdIn'
	EXEC sp_executesql @sqlQuery, 
		N'@applicationIdIn uniqueidentifier',
		@applicationIdIn = @applicationId
END</Value>
    </Setting>
    <Setting Name="tr_removemembership" Type="System.String" Scope="Application">
      <Value Profile="(Default)">CREATE TRIGGER [dbo].[{0}_UFUser_Trigger] ON [dbo].[UFUser]
AFTER INSERT, UPDATE, DELETE
AS 
SET XACT_ABORT ON
EXEC sp_removemembership N'{1}', N'{0}'
--newline--
CREATE TRIGGER [dbo].[{0}_UFRole_Trigger] ON [dbo].[UFRole]
AFTER INSERT, UPDATE, DELETE
AS 
SET XACT_ABORT ON
EXEC sp_removemembership N'{1}', N'{0}'
</Value>
    </Setting>
    <Setting Name="sp_addlinkedserver" Type="System.String" Scope="Application">
      <Value Profile="(Default)">BEGIN TRY
EXEC master.dbo.sp_addlinkedserver @server=N'{0}', @srvproduct=N'SQL Server'
EXEC master.dbo.sp_addlinkedsrvlogin @rmtsrvname=N'{0}', @useself=N'{1}', @rmtuser=N'{2}', @rmtpassword=N'{3}'
END TRY
BEGIN CATCH
END CATCH</Value>
    </Setting>
    <Setting Name="sp_addlinkedsrvlogin" Type="System.String" Scope="Application">
      <Value Profile="(Default)">EXEC master.dbo.sp_addlinkedsrvlogin @rmtsrvname=N'{0}', @useself=N'{1}', @rmtuser=N'{2}', @rmtpassword=N'{3}'</Value>
    </Setting>
    <Setting Name="tr_removemembership_drop" Type="System.String" Scope="Application">
      <Value Profile="(Default)">IF OBJECT_ID (N'dbo.{0}_UFUser_Trigger', N'TR') IS NOT NULL DROP TRIGGER [dbo].[{0}_UFUser_Trigger]
--newline--
IF OBJECT_ID (N'dbo.{0}_UFRole_Trigger', N'TR') IS NOT NULL DROP TRIGGER [dbo].[{0}_UFRole_Trigger]</Value>
    </Setting>
    <Setting Name="sp_removemembership_drop" Type="System.String" Scope="Application">
      <Value Profile="(Default)">IF OBJECT_ID (N'dbo.sp_removemembership', N'P') IS NOT NULL DROP PROCEDURE [dbo].[sp_removemembership]</Value>
    </Setting>
    <Setting Name="sp_dropserver" Type="System.String" Scope="Application">
      <Value Profile="(Default)">BEGIN TRY
EXEC master.dbo.sp_dropserver @server=N'{0}'
END TRY
BEGIN CATCH
END CATCH</Value>
    </Setting>
    <Setting Name="sp_droplinkedsrvlogin" Type="System.String" Scope="Application">
      <Value Profile="(Default)">BEGIN TRY
EXEC master.dbo.sp_droplinkedsrvlogin @rmtsrvname=N'{0}'
END TRY
BEGIN CATCH
END CATCH</Value>
    </Setting>
    <Setting Name="AuditMessageCache" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">1000</Value>
    </Setting>
  </Settings>
