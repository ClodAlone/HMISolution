<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="UFRecipeSettings.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultRecipeName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Recipe</Value>
    </Setting>
    <Setting Name="DefaultGroupName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Group</Value>
    </Setting>
    <Setting Name="DefaultDataValueName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">DataValue</Value>
    </Setting>
    <Setting Name="UseUniqueRecipeNameVersion" Type="System.String" Scope="Application">
      <Value Profile="(Default)">4.1</Value>
    </Setting>
    <Setting Name="MaxUndoRedoActions" Type="System.Int16" Scope="Application">
      <Value Profile="(Default)">50</Value>
    </Setting>
    <Setting Name="AppNameSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">RecipeService</Value>
    </Setting>
    <Setting Name="DefaultUAFileName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">RecipeSettings</Value>
    </Setting>
    <Setting Name="DefaultUAFileExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.UAServer</Value>
    </Setting>
    <Setting Name="TypeLabel" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Recipe</Value>
    </Setting>
    <Setting Name="CertificateCheckerArgs" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"/SPlatform.NExT RecipeUAServer" "/E{0}" /I "/A{1}" "/Y{2}"</Value>
    </Setting>
    <Setting Name="CertificateChecker" Type="System.String" Scope="Application">
      <Value Profile="(Default)">CertificateChecker.exe</Value>
    </Setting>
    <Setting Name="DefaultFileExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.UFRecipe</Value>
    </Setting>
    <Setting Name="SaveAsFileExtensions" Type="System.String" Scope="Application">
      <Value Profile="(Default)" />
    </Setting>
  </Settings>
</SettingsFile>