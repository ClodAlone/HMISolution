<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="LogicServiceCMS.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultServerExe" Type="System.String" Scope="Application">
      <Value Profile="(Default)">LogicService.exe</Value>
    </Setting>
    <Setting Name="HttpPortNumber" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">64535</Value>
    </Setting>
    <Setting Name="ServiceArguments" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"-conn={0}"</Value>
    </Setting>
    <Setting Name="SysTrayApp" Type="System.String" Scope="Application">
      <Value Profile="(Default)">LogicService\LogicServiceSysTray.exe</Value>
    </Setting>
  </Settings>
</SettingsFile>