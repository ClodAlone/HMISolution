<UserControl x:Class="ReportSettings.PropertyDataTemplate.ItemControlSourceProperties"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:ReportSettings.Properties"
    Height="200" Width="300" VerticalContentAlignment="Top">
    <Grid>
        <StackPanel>
            <TextBlock Text="{x:Static properties:Resources.ItemControlSourceHelper}"/>
            <TextBox Text="{Binding Path=ListItemSources, UpdateSourceTrigger=PropertyChanged}" x:Name="TextEditor" AcceptsReturn="True" AcceptsTab="True" />
            <Button Content="{x:Static properties:Resources.ItemControlDataSourceEditor}" Click="DataEditor_Click"/>
            <Button Content="{x:Static properties:Resources.ItemControlClearDataSource}" Click="ClearDataSource_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
