<Application
    x:Class="NExTIoTShell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NExTIoTShell"
    RequestedTheme="Light">

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\LinearGradient.xaml"/>
                <ResourceDictionary Source="Resources\SolidColor.xaml"/>
                <ResourceDictionary Source="Resources\VisualBrush.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
    
</Application>
