<UserControl x:Class="test.Toolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <ToolBarTray Name="toolTray" VerticalAlignment="Top">
        <ToolBar Name="toolBar" VerticalAlignment="Top">
            <Button Command="New">
                <Image Width="16" Height="16" Source="../Image/document_new.png" />
            </Button>
            <Button Command="Save">
                <Image Width="16" Height="16" Source="../Image/save.png" />
            </Button>
            <Button Command="Open">
                <Image Width="16" Height="16" Source="../Image/document_open.png" />
            </Button>
            <Separator />
            <Button Command="Print">
                <Image Width="16" Height="16" Source="../Image/print.png" />
            </Button>
            <Button Command="PrintPreview">
                <Image Width="16" Height="16" Source="../Image/print_preview.png" />
            </Button>
            <Separator />
            <Button Command="Undo">
                <Image Width="16" Height="16" Source="../Image/undo_round.png" />
            </Button>
            <Button Command="Redo">
                <Image Width="16" Height="16" Source="../Image/redo_round.png" />
            </Button>
            <Separator />
            <Button Command="Cut">
                <Image Width="16" Height="16" Source="../Image/clipboard_cut.png" />
            </Button>
            <Button Command="Copy">
                <Image Width="16" Height="16" Source="../Image/clipboard_copy.png" />
            </Button>
            <Button Command="Paste">
                <Image Width="16" Height="16" Source="../Image/clipboard_paste.png" />
            </Button>

        </ToolBar>
    </ToolBarTray>
</UserControl>
