<UserControl x:Class="DriverCodeBase.UI.Controls.UDPChannelSettingsUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBase.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="UDPStack" Orientation="Vertical">
        <Grid x:Name="udpGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="6" HorizontalAlignment="Stretch" Background="Transparent" />-->
            <TextBlock Name="TxBLocalHostName" Text="{x:Static properties:Resources.LocalHostName}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="LocalHostName" Grid.Column="2" Grid.Row="0"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" x:FieldModifier="public" Margin="0,5"
                 Text="{Binding UdpChannelSettingsLocalHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=LocalHostName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBLocalHostPort" Text="{x:Static properties:Resources.LocalHostPort}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="LocalHostPort" Grid.Column="2" Grid.Row="1"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" x:FieldModifier="public" Margin="0,5"
                 Text="{Binding UdpChannelSettingsLocalHostPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=LocalHostPort, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBHostName" Text="{x:Static properties:Resources.HostName}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="HostName" Grid.Column="2" Grid.Row="2"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" x:FieldModifier="public" Margin="0,5"
                 Text="{Binding UdpChannelSettingsHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=HostName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBHostPort" Text="{x:Static properties:Resources.HostPort}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="HostPort" Grid.Column="2" Grid.Row="3"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" x:FieldModifier="public" Margin="0,5"
                 Text="{Binding UdpChannelSettingsHostPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=HostPort, Path=(Validation.Errors).CurrentItem}"/>
            
        </Grid>
    </StackPanel>
</UserControl>
