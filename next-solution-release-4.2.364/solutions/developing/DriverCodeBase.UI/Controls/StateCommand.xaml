<UserControl x:Class="DriverCodeBase.UI.Controls.StateCommand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBase.UI.Properties"
			 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
			 xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:localConv="clr-namespace:DriverCodeBase.Converters;assembly=DriverCodeBase"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
			<utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <localConv:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKPStateCommandVariable">
		<Button DockPanel.Dock="Right" Click="DlgButton_Click_Clear"  Margin="0,5">
			<Button.Content>
				<Image x:Name="cancelImg" Source="{StaticResource CancelSmall}" Height="16" Width="16" />
			</Button.Content>
		</Button>
		<Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding StateCommandTag, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click"  Margin="0,5">
			<Button.Content>
				<Image x:Name="editImg" Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
			</Button.Content>
		</Button>
		<ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
        <dxe:ComboBoxEdit
			x:Name="uriLabel" 
			Text="{Binding Path=Tag, ElementName=uriButton, Converter={StaticResource UriConverter}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
			ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
			PopupOpening="uriLabel_PopupOpening"
			LostFocus="uriLabel_LostFocus" PreviewKeyDown="uriLabel_KeyDown" GotFocus="uriLabel_GotFocus"
			SelectedIndexChanged="uriLabel_SelectedIndexChanged"
			ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"
			Margin="0,5">
        </dxe:ComboBoxEdit>
    </DockPanel>
</UserControl>
