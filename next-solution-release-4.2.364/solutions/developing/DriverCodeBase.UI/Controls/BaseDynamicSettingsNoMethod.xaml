<UserControl x:Class="DriverCodeBase.UI.Controls.BaseDynamicSettingsNoMethod"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBase.UI.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="600"                                       
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>        
    </UserControl.Resources>    
        <StackPanel x:Name="stackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Static properties:Resources.MethodNotSupported}" TextWrapping="Wrap" Margin="2,2,2,2"/>
            <!--Use textbox validationerror to block button Ok in DialogBox -->
            <TextBox Text="{Binding IsMethodSupported, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                Validation.ErrorTemplate="{x:Null}" Visibility="Hidden"></TextBox>
        </StackPanel>
</UserControl>
