<UserControl x:Class="ReportViewerControl.ReportViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxpbars="http://schemas.devexpress.com/winfx/2008/xaml/printing/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             xmlns:System="clr-namespace:System;assembly=mscorlib" 
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:cc="http://progea.com/CommonControls" 
             xmlns:properties="clr-namespace:ReportViewerControl.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1024">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/ReportViewerControl.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="mainGrid">
        <AdornerDecorator>
            <dxp:DocumentPreviewControl x:Name="preview" CommandBarStyle="None" Visibility="Collapsed" 
                                        dxb:BarNameScope.IsScopeOwner="True" >
                <dxp:DocumentPreviewControl.CommandProvider>
                    <dxp:DocumentCommandProvider>
                    </dxp:DocumentCommandProvider>
                </dxp:DocumentPreviewControl.CommandProvider>
            </dxp:DocumentPreviewControl>
        </AdornerDecorator>
        
        <cc:CircularProgressBar x:Name="uriLoading" Background="Black" Opacity="0.5" Visibility="Collapsed" />
        <TextBlock Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding Visibility, ElementName=uriLoading}"
                   FontFamily="Segoe UI" FontWeight="Light" Margin="5,0,0,0" Foreground="White" FontSize="16" />

        <Border x:Name="uriError" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                BorderThickness="1" BorderBrush="#FFA9A9A9" Visibility="Collapsed">
            <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Source="{DynamicResource Diamond}" Width="16" Height="16" Margin="2,2,2,2" />
                <TextBlock x:Name="txtUriError" Margin="5,0,0,0" Text="{x:Static properties:Resources.EmptyReportUri}" VerticalAlignment="Center"
            TextWrapping="Wrap" FontFamily="Segoe UI" FontWeight="Light" HorizontalAlignment="Left" Foreground="White" FontSize="16" />
            </DockPanel>
        </Border>

        <Viewbox Stretch="Fill" Visibility="Collapsed" x:Name="txtMode" IsHitTestVisible="False" 
                   KeyboardNavigation.IsTabStop="False" >
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" 
                   KeyboardNavigation.IsTabStop="False"
                       Text="{x:Static properties:Resources.NoReportLicense}" FontSize="48" Opacity="0.1">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-45"/>
                </TextBlock.LayoutTransform>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </TextBlock.Effect>
            </TextBlock>
        </Viewbox>
    </Grid>
</UserControl>
