<Window x:Class="UFCrypterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UF String De-Crypter" Height="350" Width="525">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Seed" Grid.Column="0" Grid.Row="0" Margin="5" VerticalAlignment="Center" />
        <ComboBox x:Name="cmbSeed" Grid.Column="1" Grid.Row="0" Margin="5" />

        <TextBlock Text="Clear String" Grid.Column="0" Grid.Row="1" Margin="5" VerticalAlignment="Center" />
        <TextBox x:Name="txtClearBox" Grid.Column="1" Grid.Row="1" Margin="5" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" AcceptsReturn="True" AcceptsTab="True" />
        <Button Content="Encrypt" Grid.Column="2" Grid.Row="1" Click="Encrypt_Click" Margin="5" VerticalAlignment="Center" />

        <TextBlock Text="Crypted String" Grid.Column="0" Grid.Row="2" Margin="5" VerticalAlignment="Center" />
        <TextBox x:Name="txtCryptBox" Grid.Column="1" Grid.Row="2" Margin="5" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"  VerticalAlignment="Stretch" AcceptsReturn="True" AcceptsTab="True"/>
        <Button Content="Decrypt" Grid.Column="2" Grid.Row="2" Margin="5" Click="Decrypt_Click" VerticalAlignment="Center" />
    </Grid>
</Window>
