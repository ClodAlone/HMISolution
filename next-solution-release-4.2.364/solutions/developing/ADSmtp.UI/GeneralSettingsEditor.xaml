<UserControl x:Class="ADSmtp.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:ADSmtp.UI"
             xmlns:properties="clr-namespace:ADSmtp.UI.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="600">
    
    <UserControl.Resources>
        <ResourceDictionary >
            <self:ServerPortVisibilityConverter x:Key="ServerPortVisibilityConverter" />
            <self:OpacityConverter x:Key="OpacityConverter"/>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static properties:Resources.Title}" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>

            <TextBlock Text="{x:Static properties:Resources.ServerAddress}" Grid.Column="0" Grid.Row="1" Margin="0,1" VerticalAlignment="Center"/>
                <TextBox Name="ServerAddress" Grid.Column="2" Grid.Row="1" Margin="0,5" Text="{Binding ServerAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=ServerAddress, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.ServerPort}" Grid.Column="0" Grid.Row="2" Margin="0,1" VerticalAlignment="Center"/>
                <TextBox Name="ServerPort" Grid.Column="2" Grid.Row="2" Margin="0,5" Text="{Binding ServerPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
                Content="{Binding ElementName=ServerPort, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Username}" Grid.Column="0" Grid.Row="3" Margin="0,1" VerticalAlignment="Center"/>
                <TextBox Name="Username" Grid.Column="2" Grid.Row="3" Margin="0,5" Text="{Binding User, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=Username, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Password}" Grid.Column="0" Grid.Row="4" Margin="0,1" VerticalAlignment="Center"/>


                <cc:BindablePasswordBox Grid.Row="4" Grid.Column="2" Margin="0,5" Password="{Binding Password, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     x:Name="Password" />
        
            <ContentPresenter Grid.Row="4" Grid.Column="3" 
                Content="{Binding ElementName=Password, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.From}" Grid.Column="0" Grid.Row="5" x:Name="txtFrom" Margin="0,1" VerticalAlignment="Center"/>
                <TextBox Name="From" Grid.Column="2" Grid.Row="5" Margin="0,5" Text="{Binding From, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="5" Grid.Column="3" 
                Content="{Binding ElementName=From, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RASEnable}" Grid.Column="0" Grid.Row="8" Margin="0,1" VerticalAlignment="Center"/>

                <CheckBox Grid.Row="8" Grid.Column="2" Margin="0,5" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center" 
                                  Content="" IsChecked="{Binding RASEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                  x:Name="chkRASEnable" />
            <ContentPresenter Grid.Row="8" Grid.Column="3" 
                Content="{Binding ElementName=chkRASEnable, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.DialupEntry}" Grid.Column="0" Grid.Row="9" x:Name="txtDialUp" Margin="0,1" VerticalAlignment="Center" Opacity="{Binding RASEnable, Converter={StaticResource OpacityConverter}, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger = PropertyChanged}"/>
                <TextBox Name="Entry" Grid.Column="2" Grid.Row="9" Margin="0,5" Text="{Binding DialupEntry, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="9" Grid.Column="3" 
                Content="{Binding ElementName=Entry, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.PhoneNumber}" Grid.Column="0" Grid.Row="10" Margin="0,1" VerticalAlignment="Center" x:Name="txtPhone" />
                <TextBox Name="PhoneNumber" Grid.Column="2" Grid.Row="10" Margin="0,5" Text="{Binding PhoneNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="10" Grid.Column="3" 
                Content="{Binding ElementName=PhoneNumber, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RASUser}" Grid.Column="0" Grid.Row="11" Margin="0,1" VerticalAlignment="Center" x:Name="txtUser" />
                <TextBox Name="RASUser" Grid.Column="2" Grid.Row="11" Margin="0,5" Text="{Binding RASUser, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="11" Grid.Column="3" 
                Content="{Binding ElementName=RASUser, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RASPassword}" Grid.Column="0" Grid.Row="12" Margin="0,1" VerticalAlignment="Center" x:Name="txtPassword" />

                <cc:BindablePasswordBox Grid.Row="12" Grid.Column="2" Margin="0,5" Password="{Binding RASPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" IsEnabled="{Binding RASEnable}"
                     x:Name="RASPassword" />
            <ContentPresenter Grid.Row="12" Grid.Column="3" 
                Content="{Binding ElementName=RASPassword, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RetryTime}" Grid.Column="0" Grid.Row="13" Margin="0,1" VerticalAlignment="Center" x:Name="txtRetryTO" />
                <TextBox Name="RetryTime" Grid.Column="2" Grid.Row="13" Margin="0,5" Text="{Binding RetryTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="13" Grid.Column="3" 
                Content="{Binding ElementName=RetryTime, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.DisconnectAfter}" Grid.Column="0" Grid.Row="14" Margin="0,1" VerticalAlignment="Center" x:Name="txtDisconnect" />
                <TextBox Name="DisconnectAfter" Grid.Column="2" Grid.Row="14" Margin="0,5" Text="{Binding DisconnectAfter, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="14" Grid.Column="3" 
                Content="{Binding ElementName=DisconnectAfter, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Retries}" Grid.Column="0" Grid.Row="15" Margin="0,1" VerticalAlignment="Center" x:Name="txtRetry" />
                <TextBox Name="Retries" Grid.Column="2" Grid.Row="15" Margin="0,5" Text="{Binding Retries, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="15" Grid.Column="3" 
                Content="{Binding ElementName=Retries, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.PhonebookPath}" Grid.Column="0" Grid.Row="16" Margin="0,1" VerticalAlignment="Center" x:Name="txtPhPath" />
                <TextBox Name="PhonebookPath" Grid.Column="2" Grid.Row="16" Margin="0,5" Text="{Binding PhonebookPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" IsEnabled="{Binding RASEnable}"></TextBox>
            <ContentPresenter Grid.Row="16" Grid.Column="3" 
                Content="{Binding ElementName=PhonebookPath, Path=(Validation.Errors).CurrentItem}"/>        
        
        </Grid>
    </ScrollViewer>
</UserControl>
