<UserControl x:Class="SmartControlUtilities.Controls.PenNameSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Button DockPanel.Dock="Right" Click="BtnClear" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Button.Content>
                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Button DockPanel.Dock="Right" Click="BtnEdit" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <TextBox IsReadOnly="False" IsHitTestVisible="True" x:Name="uriLabel" HorizontalAlignment="Stretch" 
                                                 Text="" TextChanged="textChanged" VerticalAlignment="Center"/>
    </DockPanel>
</UserControl>
