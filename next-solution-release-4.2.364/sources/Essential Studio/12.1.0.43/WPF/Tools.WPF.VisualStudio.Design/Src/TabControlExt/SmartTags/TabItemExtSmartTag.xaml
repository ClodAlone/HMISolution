<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.TabItemExtSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="TabItemExt Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <Grid Background="#FFDCEBFE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold"  Grid.Row="0">Appearance</TextBlock>

                    <TextBlock Text="Header Text" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="2"/>
                    <TextBox Name="HeaderTextBox"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>
                    

                    <TextBlock Text="Height" VerticalAlignment="Center"  Grid.Row="3" Grid.Column="0" Margin="2"/>
                    <syncfusion:DoubleTextBox Name="heighttextbox"  Margin="3,3,3,3" Width="115" Grid.Row="3" Grid.Column="1"/>


                    <TextBlock Text="Width" VerticalAlignment="Center"  Grid.Row="4" Grid.Column="0" Margin="2"/>
                    <syncfusion:DoubleTextBox Name="widthtextbox"  Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>
                   
                    <!--<TextBlock VerticalAlignment="Center" Text="Image Alignment" Grid.Row="4" Grid.Column="0"/>
                    <ComboBox Name="cmbImageAlignment" Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>-->



                    <Border Margin="0,7,0,0"  Grid.Row="6" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="7">Behavior</TextBlock>


                    <StackPanel Grid.Row="8" Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="IsSelectedCheckBox" Margin="0,1,0,0"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                 Selected Tab Item
                        </TextBlock>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Grid>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>