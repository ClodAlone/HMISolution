<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.TabControlExtSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="TabControlExt Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Background="#FFDCEBFE">
            <TextBlock Grid.Row="0" Margin="5,5" FontWeight="Bold">Essential Tools - TabControlExt</TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border  Margin="5,5" Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" />
                <TextBlock Text="Name" Margin="5,5" Grid.Row="1" Grid.Column="0" />
                <TextBox x:Name="txtName" Margin="5,5" Grid.Row="1" Grid.Column="1"/>

                <Border Margin="5,5" Grid.Row="2" BorderBrush="Black"  BorderThickness=".5" Grid.ColumnSpan="2"/>

                <TextBlock Margin="5,5" FontWeight="Bold" Grid.Row="3">Actions</TextBlock>

                <TextBlock Margin="5,5" Grid.Row="4" Grid.ColumnSpan="2">
                     <Hyperlink  Tag="{x:Type syncfusion:TabItemExt}" Click="AddChildControls">Add New TabItem</Hyperlink>
                </TextBlock>

                <Border  Margin="5,5" Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" />

                <TextBlock Margin="5,5" FontWeight="Bold" Grid.Row="6" Grid.ColumnSpan="2">Appearance</TextBlock>

                <TextBlock Text="Tab Strip Placement " Grid.Row="7" Grid.Column="0" Margin="5,5" />
                <ComboBox Name="StripPlacementSelector" Margin="5,5" Grid.Row="7" Grid.Column="1" />

                <TextBlock Text="Tab Scrolling Style " Grid.Row="8" Grid.Column="0" Margin="5,5"/>
                <ComboBox Name="ScrollStyleSelector" Margin="5,5" Grid.Row="8" Grid.Column="1"/>

                <TextBlock Text="Tab Item Size Mode " Grid.Row="9" Grid.Column="0" Margin="5,5"/>
                <ComboBox Name="SizeModeSelector" Margin="5,5" Grid.Row="9" Grid.Column="1"/>

                <TextBlock Text="Scroll Button Visibility " Grid.Row="10" Grid.Column="0" Margin="5,5"/>
                <ComboBox Name="ScrollVisibilitySelector" Margin="5,5" Grid.Row="10" Grid.Column="1"/>

                <TextBlock Text="Close Button Type Selector " Grid.Row="11" Grid.Column="0" Margin="5,5"/>
                <ComboBox Name="CloseButtonTypeSelector" Margin="5,5" Grid.Row="11" Grid.Column="1"/>

                <TextBlock Text="Tab Item Layout Type" Grid.Row="12" Grid.Column="0" Margin="5,5"/>
                <ComboBox Name="TabItemLayoutTypeSelector" Margin="5,5" Grid.Row="12" Grid.Column="1"/>

            </Grid>

            <Border  Margin="5,5" BorderBrush="Black" BorderThickness=".5" HorizontalAlignment="Stretch" />
            <TextBlock Margin="5,5" FontWeight="Bold" >Behavior</TextBlock>

            <CheckBox Name="chkShowTabItemContextMenu" Content="Show Tab Item Context Menu" Margin="5,5"/>
            <CheckBox Name="chkShowTabListContextMenu" Content="Show Tab List Context Menu" Margin="5,5"/>
            <CheckBox Name="chkEnableLabelEdit" Content="Enable Label Edit" Margin="5,5"/>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>