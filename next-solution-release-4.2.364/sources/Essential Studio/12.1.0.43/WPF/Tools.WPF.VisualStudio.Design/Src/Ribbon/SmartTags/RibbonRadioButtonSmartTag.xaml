<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.RibbonRadioButtonSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf" syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    
    <syncfusion:SmartTagPresenter Title="RibbonRadioButton Tasks">


        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Content" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="ContentTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

                <TextBlock FontWeight="Bold">Appearance</TextBlock>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="Click Mode" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                         <ComboBox Name="ClickModeSelector" Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock VerticalAlignment="Center" Text="Horizontal Alignment" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                        <ComboBox Name="HorizontalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>


                        <TextBlock VerticalAlignment="Center" Text="Vertical Alignment" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0"/>
                        <ComboBox Name="VerticalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock VerticalAlignment="Center" Text="Horizontal Content Alignment" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                        <ComboBox Name="HorizontalContentAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock VerticalAlignment="Center" Text="Vertical Content Alignment" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                        <ComboBox Name="VerticalContentAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>



                    </Grid>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />


                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Behavior</TextBlock>
               

                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="IsCheckedCheckBox"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                           Is Checked
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="IsEnabledCheckBox"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                           IsEnabled
                        </TextBlock>
                    </StackPanel>

            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
