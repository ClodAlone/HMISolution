<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.WizardPageSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="WizardPage Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
             </Grid.RowDefinitions>
            <TextBlock FontWeight="Bold" Margin="7">Essential Tools - Wizard Page</TextBlock>

            <StackPanel Orientation="Horizontal" Background="#FFDCEBFE" Grid.Row="1">
                <StackPanel Margin="7" Name="panel1" Orientation="Vertical">
                    <TextBlock FontWeight="Bold">Actions</TextBlock>
                    <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>

                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Tag="Exterior" Click="AddWizardPage">Add New Exterior Page</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Tag="Interior" Click="AddWizardPage">Add New Interior Page</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Tag="Blank" Click="AddWizardPage">Add New Blank Page</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Click="RemovePage">Remove This Page</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink Tag="Next" Click="BrowseTo">Go Next</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Tag="Back" Click="BrowseTo">Go Previous</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Tag="First" Click="BrowseTo">Go First</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,7,0,0">
                        <Hyperlink Tag="Last" Click="BrowseTo">Go Last</Hyperlink>
                    </TextBlock>

                </StackPanel>
                <Border BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.InactiveBorderBrushKey}}" BorderThickness="0.5"  Margin="2,10,2,10"/>
                <StackPanel Margin="7" Name="panel2" Orientation="Vertical">
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontWeight="Bold">Button Settings</TextBlock>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock>Help Button</TextBlock>
                            <CheckBox IsThreeState="True" Name="helpVisibleCB" Margin="15,0,0,0">Visible</CheckBox>
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock>Cancel Button</TextBlock>
                            <CheckBox IsThreeState="True" Name="cancelVisibleCB" Margin="5,0,0,0">Visible /</CheckBox>
                            <CheckBox Name="cancelEnabledCB" IsThreeState="True" Margin="5,0,0,0">Enabled</CheckBox>
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock>Back Button</TextBlock>
                            <CheckBox IsThreeState="True" Name="backVisibleCB" Margin="15,0,0,0">Visible /</CheckBox>
                            <CheckBox Name="backEnabledCB" IsThreeState="true" Margin="5,0,0,0">Enabled</CheckBox>
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock>Next Button</TextBlock>
                            <CheckBox IsThreeState="True" Name="nextVisibleCB" Margin="15,0,0,0">Visible /</CheckBox>
                            <CheckBox Name="nextEnabledCB" IsThreeState="true" Margin="5,0,0,0">Enabled</CheckBox>
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock>Finish Button</TextBlock>
                            <CheckBox IsThreeState="True" Name="finishVisibleCB" Margin="10,0,0,0">Visible /</CheckBox>
                            <CheckBox Name="finishEnabledCB" IsThreeState="true" Margin="5,0,0,0">Enabled</CheckBox>
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.InactiveBorderBrushKey}}" BorderThickness="0.5"  Margin="5,7,5,7"/>
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontWeight="Bold">Appearance</TextBlock>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="200"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,7,0,0" Grid.Row="0" Grid.Column="0" Text="Page Type" TextAlignment="Right"></TextBlock>
                            <ComboBox Margin="7,7,0,0" Grid.Row="0" Grid.Column="1" Name="pageTypeCombo"></ComboBox>

                            <TextBlock Margin="0,7,0,0" Grid.Row="1" Grid.Column="0" Text="Title" TextAlignment="Right"></TextBlock>
                            <TextBox Margin="7,7,0,0" Grid.Row="1" Grid.Column="1" Name="pageTitle"></TextBox>

                            <TextBlock Margin="0,7,0,0" Grid.Row="2" Grid.Column="0" Text="Description" TextAlignment="Right"></TextBlock>
                            <TextBox Margin="7,7,0,0" Grid.Row="2" Grid.Column="1" Name="pageDesc"></TextBox>


                        </Grid>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
