<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.GroupBarSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" x:Name="one" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="GroupBar Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">

            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">


                <TextBlock FontWeight="Bold">Essential Tools - GroupBar</TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />


                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Actions</TextBlock>
                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:GroupBarItem}" Click="AddChildControls">Add New GroupBarItem</Hyperlink>
                </TextBlock>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>


                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>


            </StackPanel>


            <StackPanel  Margin="7" Name="Panel2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                       
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>





                    <TextBlock VerticalAlignment="Center" Text="Orientation" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" />
                    <ComboBox Name="OrientationSelector" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1" />



                    <TextBlock VerticalAlignment="Center" Text="Visual Mode" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VisualModeSelector" Margin="0,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>




                    <TextBlock VerticalAlignment="Center" Text="Groupbar Text Alignment" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="GroupBarTextAlignment" Margin="0,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>



                    <TextBlock VerticalAlignment="Center" Text="Animation Mode" Grid.Row="5" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="AnimationMode" Margin="0,7,0,0" Width="115" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Pop-up Window Resize Direction" Grid.Row="6" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="PopupResizeDirection" Margin="0,7,0,0" Width="115" Grid.Row="6" Grid.Column="1"/>


                    <Border BorderBrush="Black"  Grid.Row="7" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>



                    <TextBlock FontWeight="Bold" Grid.Row="8" Margin="0,7,0,0">Behavior</TextBlock>

                    <StackPanel Grid.Row="9"  Margin="0,7,0,0">

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="AllowCollapseCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Allow Collapse in Stack Mode
                            </TextBlock>
                        </StackPanel>


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="ShowContextMenu"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Show Context Menu
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="ShowGripper"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Show Gripper
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>


                </Grid>

            </StackPanel>



        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
    