<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.TaskBarItemSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"         
                     Height="24" Width="24" x:Name="one">
    <syncfusion:SmartTagPresenter Title="TaskBarItem Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - TaskBarItem</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>
            </StackPanel>
			<StackPanel Margin="7">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock Text="Name" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
					<TextBox Name="NameTextBox" HorizontalAlignment="Right"  Margin="3" Width="115" Grid.Row="0" Grid.Column="1"/>
					<Border BorderBrush="Black"  Grid.Row="1" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
				</Grid>
			</StackPanel>
			<StackPanel  Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>



                    <TextBlock Text="Header Text" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="2"/>
                    <TextBox Name="HeaderTextBox"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>




                    <TextBlock VerticalAlignment="Center" Text="Horizontal Content Alignment" Grid.Row="2" Grid.Column="0"/>
                    <ComboBox Name="HorizontalContentSelector" Margin="3,3,3,3" Width="115" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Vertical Alignment" Grid.Row="3" Grid.Column="0"/>
                    <ComboBox Name="VerticalContentSelector" Margin="3,3,3,3" Width="115" Grid.Row="3" Grid.Column="1"/>
                  
                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>