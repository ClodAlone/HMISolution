<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.Expression.Design.RibbonGallerySmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="RibbonGallery Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                   </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Label" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="CaptionTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>


                </Grid>


                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Actions</TextBlock>
                
                
                 <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonGalleryItem}" Click="AddChildControl">Add New GalleryItem</Hyperlink>
                </TextBlock>

                


            </StackPanel>

            <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

            <StackPanel  Margin="7">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>


                    <TextBlock VerticalAlignment="Center" Text="Visual Mode" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VisualModeSelector" Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="Resize Direction" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="resizeDirection" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="SizeForm" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="sizeForm" Margin="0,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>

                    

                    <TextBlock VerticalAlignment="Center" Text="Horizontal Alignment" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="HorizontalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Vertical Alignment" Grid.Row="5" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VerticalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Horizontal Content Alignment" Grid.Row="6" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="HorizontalContentAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Vertical Content Alignment" Grid.Row="7" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VerticalContentAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="7" Grid.Column="1"/>


                    <TextBlock Text="Expand Height" VerticalAlignment="Center"  Grid.Row="8" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="expandHeight"  Margin="0,7,0,0" Width="115" Grid.Row="8" Grid.Column="1"/>


                    <TextBlock Text="Expand Width" VerticalAlignment="Center"  Grid.Row="9" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="expandWidth"  Margin="0,7,0,0" Width="115" Grid.Row="9" Grid.Column="1"/>


                    <TextBlock Text="Item Width" VerticalAlignment="Center"  Grid.Row="10" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="itemWidth"  Margin="0,7,0,0" Width="115" Grid.Row="10" Grid.Column="1"/>


                    <TextBlock Text="Item Height" VerticalAlignment="Center"  Grid.Row="11" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="itemHeight"  Margin="0,7,0,0" Width="115" Grid.Row="11" Grid.Column="1"/>
                    

                    <Border BorderBrush="Black"  Grid.Row="12" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                    <TextBlock FontWeight="Bold" Grid.Row="13" Margin="0,7,0,0">Behavior</TextBlock>

                    <StackPanel Grid.Row="14"  Margin="0,7,0,0">
                     
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="isEnabled"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                            Is Enabled
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="menuicon"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                             Menu IconBar Enabled
                            </TextBlock>
                        </StackPanel>


                    </StackPanel>

                
               </Grid>
            
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>