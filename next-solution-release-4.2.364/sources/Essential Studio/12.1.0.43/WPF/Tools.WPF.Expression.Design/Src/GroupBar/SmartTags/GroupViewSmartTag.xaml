<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.Expression.Design.GroupViewSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="GroupView Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">
                <TextBlock FontWeight="Bold">Actions</TextBlock>
                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:GroupViewItem}" Click="AddChildControl">Add New GroupViewItem</Hyperlink>
                </TextBlock>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>


                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>


            </StackPanel>
            <StackPanel Grid.Row="2" Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
					</Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

                    <TextBlock VerticalAlignment="Center" Text="Orientation" Grid.Row="1" Grid.Column="0" Margin="2" />
                    <ComboBox Name="OrientationSelector" Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1" />

                    <TextBlock VerticalAlignment="Center" Text="Text Alignment" Grid.Row="2" Grid.Column="0"/>
                    <ComboBox Name="TextAlignmentSelector" Margin="3,3,3,3" Width="115" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Group View Item Cursor Type" Grid.Row="3" Grid.Column="0"/>
                    <ComboBox Name="GroupViewItemCursorType" Margin="3,3,3,3" Width="115" Grid.Row="3" Grid.Column="1"/>

					<Border BorderBrush="Black" BorderThickness="0.5" Grid.Row="4" Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
					<TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="5">Behavior</TextBlock>

                    <StackPanel Grid.Row="6"  Margin="7">

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsShowText"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Show Text
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsListViewMode"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Is InListViewMode
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="ShowToolTip"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                Show ToolTip
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>


                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>