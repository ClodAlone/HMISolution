<syncfusion:SmartTagBase x:Class=" Syncfusion.Tools.WPF.Expression.Design.DockingSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="DockingManager Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Background="#FFDCEBFE">
            <TextBlock Grid.Row="0" Margin="5,5" FontWeight="Bold">Essential Tools - DockingManager</TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border  Margin="5,5" Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" />
                <TextBlock Text="Name" Margin="5,5" Grid.Row="1" Grid.Column="0" />
                <TextBox x:Name="txtName" Margin="5,5" Grid.Row="1" Grid.Column="1"/>

                <Border Margin="5,5" Grid.Row="2" BorderBrush="Black"  BorderThickness=".5" Grid.ColumnSpan="2"/>

                <TextBlock Margin="5,5" FontWeight="Bold" Grid.Row="3">Actions</TextBlock>

                <TextBlock Margin="5,5" Grid.Row="4" Grid.ColumnSpan="2">
                     <Hyperlink  Tag="{x:Type Grid}" Click="AddChildControls">Add New Child</Hyperlink>
                </TextBlock>
                <Border Margin="5,5" Grid.Row="5" BorderBrush="Black"  BorderThickness=".5" Grid.ColumnSpan="2"/>

                <TextBlock Margin="5,5" FontWeight="Bold" Grid.Row="6" >Appearence</TextBlock>

                <TextBlock Margin="5,5"  Grid.Row="7" >TabStrip Placement</TextBlock>
                <ComboBox Name="tabstripplace" Margin="5,5" Grid.Row="7" Grid.Column="1" />

                <TextBlock Margin="5,5"  Grid.Row="8" >Dragging Type</TextBlock>
                <ComboBox Name="draggingtype" Margin="5,5" Grid.Row="8" Grid.Column="1" />
                
                <TextBlock Margin="5,5" Grid.Row="9" >Animation Type</TextBlock>
                <ComboBox Name="animtype" Margin="5,5" Grid.Row="9" Grid.Column="1" />

                <TextBlock Margin="5,5"  Grid.Row="10" >AutoHidde Tabs Mode</TextBlock>
                <ComboBox Name="autohidetabsmode" Margin="5,5" Grid.Row="10" Grid.Column="1" />

                <TextBlock Margin="5,5" Grid.Row="11" >Close Tabs Mode</TextBlock>
                <ComboBox Name="closetabsmode" Margin="5,5" Grid.Row="11" Grid.Column="1" />

                <TextBlock Margin="5,5"  Grid.Row="12" >Switch Mode</TextBlock>
                <ComboBox Name="switchmode" Margin="5,5" Grid.Row="12" Grid.Column="1" />

                <TextBlock Margin="5,5"  Grid.Row="13" >Container Mode</TextBlock>
                <ComboBox Name="containermode" Margin="5,5" Grid.Row="13" Grid.Column="1" />

            </Grid>

            <Border  Margin="5,5" BorderBrush="Black" BorderThickness=".5" HorizontalAlignment="Stretch"/>
            <TextBlock Margin="5,5" FontWeight="Bold" >Behavior</TextBlock>
            <CheckBox Name="chkusedocumentcontainer" Content="UseDocumentContainer" Margin="5,5"/>
            <CheckBox Name="chkuseintrop" Content="UseInteropCompatibilityMode" Margin="5,5"/>
            <CheckBox Name="chkpersiststate" Content="PersistState" Margin="5,5"/>
            <CheckBox Name="chkShowTabItemContextMenu" Content="Show Tab Item Context Menu" Margin="5,5"/>
            <CheckBox Name="chkShowTabListContextMenu" Content="Show Tab List Context Menu" Margin="5,5"/>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>