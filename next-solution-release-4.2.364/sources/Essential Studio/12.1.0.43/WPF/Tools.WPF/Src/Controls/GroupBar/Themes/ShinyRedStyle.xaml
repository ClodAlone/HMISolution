                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder2" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder1" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedHoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedHoverBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedHoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedHoverBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
		<Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
			<Grid Name="HeaderGrid"
				  Grid.Row="0"
				  ClipToBounds="True"
				  Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				  Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}">
				<Grid.RowDefinitions>
					<RowDefinition Height="0.5*"/>
					<RowDefinition Height="0.5*"/>
				</Grid.RowDefinitions>               

                <Border Name="HeaderHost"
Style="{Binding Path=HeaderStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
						Grid.Row="0"
						Grid.RowSpan="2"
						Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
						BorderBrush="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}"
						BorderThickness="0,0,0,1">
                    <Grid>
                        <Border Grid.Row="0"
						Grid.RowSpan="2" Background="{StaticResource SelectedBrushKey.ShinyRed}" BorderBrush="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}" BorderThickness="0,0,0,1"  Opacity="0" x:Name="SelectedBorder"/>
                        <Border Grid.Row="0"
						Grid.RowSpan="2" x:Name="HoverBorder1" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" BorderBrush="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}" BorderThickness="0,0,0,1" />
                        <Border Grid.Row="0"
						Grid.RowSpan="2" x:Name="HoverBorder2" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" BorderBrush="{x:Null}" BorderThickness="0,0,0,1" />
                        <Border Grid.Row="0"
						Grid.RowSpan="2" x:Name="SelectedHoverBorder" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" BorderBrush="{x:Null}" BorderThickness="0,0,0,1"/>

                        <ContentPresenter Content="{TemplateBinding Header}"
									  ContentTemplate="{TemplateBinding HeaderTemplate}"
									  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
									  KeyboardNavigation.IsTabStop="False"
									  KeyboardNavigation.TabNavigation="Continue"
									  KeyboardNavigation.ControlTabNavigation="Continue"
									  KeyboardNavigation.DirectionalNavigation="Continue"/>
                    </Grid>
                </Border>
			</Grid>
		</Grid>
		<ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOff}" x:Name="SelectedHoverOff_BeginStoryboard"/>
                </MultiTrigger.ExitActions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOn}" x:Name="SelectedHoverOn_BeginStoryboard"/>
                </MultiTrigger.EnterActions>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </MultiTrigger>
            <!--<MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False"/>
                    <Condition Property="IsMouseOver" SourceName="HeaderHost" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="HoverOff_BeginStoryboard" Storyboard="{StaticResource HoverOff}"/>
                </MultiTrigger.ExitActions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="HoverOn_BeginStoryboard" Storyboard="{StaticResource HoverOn}"/>
                </MultiTrigger.EnterActions>
            </MultiTrigger>-->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOff}" x:Name="SelectedHoverOff_BeginStoryboard1"/>
                </MultiTrigger.ExitActions>
                    <MultiTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOn}" x:Name="SelectedHoverOn_BeginStoryboard1"/>
                </MultiTrigger.EnterActions>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </MultiTrigger>
			<!--<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="HeaderHost" Property="Background" Value="{utilsOuter:SkinObject GroupBarItem_OverBrush}" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsSelected" Value="True"/>
					<Condition Property="IsMouseOver" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter TargetName="HeaderHost" Property="Background" Value="{utilsOuter:SkinObject GroupBarItem_OverSelectedBrush}" />
			</MultiTrigger>-->
			<Trigger Property="IsContextMenuOpened" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOff}" x:Name="SelectedHoverOff_BeginStoryboard2"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOn}" x:Name="SelectedHoverOn_BeginStoryboard2"/>
                </Trigger.EnterActions>
                <!--<Setter TargetName="HeaderHost" Property="Background" Value="{utilsOuter:SkinObject GroupBarItem_OverBrush}" />-->
			</Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.3"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

    <Style x:Key="ShinyRedGroupBarItemStyle" TargetType="{x:Type local:GroupBarItem}">
       <Setter Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
		<Setter Property="AllowDrop" Value="True"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="SelectedAnimation" Value="{StaticResource GroupBarItem_SelectedAnimation}"/>
		<Setter Property="UnselectedAnimation" Value="{StaticResource GroupBarItem_UnselectedAnimation}"/>
		<Style.Triggers>
            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
                <!--<Setter Property="ContextMenu" Value="{StaticResource GroupBar_ContextMenu}"/>-->
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Blend_Selected_Foreground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Blend_Selected_Foreground}"/>
            </Trigger>
			
			
	<Trigger Property="local:GroupBar.VisualMode" Value="Default">
                <Setter Property="Template" Value="{StaticResource GroupBarItemNonStackedTemplateKey.ShinyRed}"/>
            </Trigger>
	
	<Trigger Property="local:GroupBar.VisualMode" Value="StackMode">
               <Setter Property="Template" Value="{StaticResource GroupBarItemStackedTemplateKey.ShinyRed}"/>
            </Trigger>
			<Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
                <Setter Property="Template" Value="{StaticResource GroupBarItemMultipleExpansionTemplateKey.ShinyRed}"/>
            </Trigger>			
			
			<Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>	
			</Style.Triggers>
	</Style>


    <Style BasedOn="{StaticResource ShinyRedGroupBarItemStyle}" TargetType="{x:Type local:GroupBarItem}"/>

    <!-- GroupBarItemHeader Template -->
	<Style  TargetType="{x:Type local:GroupBarItemHeader}">
		<Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
		<Setter Property="Focusable" Value="True"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="TextHorizontalAlignment" Value="{Binding Path=TextAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
		<Setter Property="ImageMargin" Value="0,0,5,0"/>
      <Setter Property="Template">
            <Setter.Value>
	<ControlTemplate TargetType="{x:Type local:GroupBarItemHeader}">
		<DockPanel Name="MainGrid"
				   SnapsToDevicePixels="True"
				   Margin="5,0,0,0">
			<Border Name="ImageHost"
					DockPanel.Dock="Left"
					Height="{TemplateBinding ImageHeight}"
					Width="{TemplateBinding ImageWidth}"
					HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}"
					VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"
					Margin="{TemplateBinding ImageMargin}">
				<Image Name="Image"
					   Source="{TemplateBinding ImageSource}"
					   Visibility="Visible"
					   Stretch="Fill"/>
			</Border>
			<Border Name="TextHost"
					DockPanel.Dock="Top"
					Margin="{TemplateBinding TextMargin}"
					HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
					VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
					TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}">
				<StackPanel>
					<TextBlock Name="Text"
							   HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
							   VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
							   Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItemHeader}}}"
							   FontWeight="Bold"
							   Margin="1,1,1,1"
							   TextTrimming="CharacterEllipsis"/>
					<TextBox Name="TextEditor"
							 Visibility="Collapsed"
							 Width="{Binding ActualWidth, ElementName=TextHost}"
							 Height="14"
							 Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItemHeader}}}"
							 FontSize="10"
							 Margin="1,0,0,0"
							 Padding="0,0,0,0"
							 BorderThickness="0"/>
				</StackPanel>
			</Border>
		</DockPanel>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
				<Setter Property="Visibility" TargetName="Image" Value="Collapsed"/>
				<Setter Property="Margin" TargetName="MainGrid" Value="0"/>
				<Setter Property="Width" TargetName="ImageHost" Value="0"/>
			</Trigger>-->
			<Trigger Property="IsInEditMode" Value="True">
				<Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
				<Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="ImageHost" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="TextHost" Property="HorizontalAlignment" Value="Stretch"/>
			</Trigger>
            <DataTrigger Binding="{Binding Path=(local:GroupBar.IsCollapsed), RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
					               Value="True" >
                <Setter TargetName="ImageHost" Property="Margin" Value="2"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>
</Setter.Value>
        </Setter>
    </Style>
	
	
	
	
	<!-- GroupView MultipleExpansion Template -->
	<ControlTemplate x:Key="GroupViewMultipleExpansionTemplateKey.ShinyRed" TargetType="{x:Type local:GroupView}">
		<StackPanel Name="MainHost"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}">					
			<ItemsPresenter ClipToBounds="True"/>
		</StackPanel>
	</ControlTemplate>
	
	<!-- GroupView Default Template -->
	<ControlTemplate x:Key="GroupViewDefaultTemplateKey.ShinyRed" TargetType="{x:Type local:GroupView}">
		<ScrollViewer Name="MainHost"
					  Focusable="False"
					  Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					  Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					  VerticalScrollBarVisibility="Auto"
					  Style="{StaticResource ScrollViewerStyle}">
			<Border Name="ItemsHost" Padding="0,0,0,0">
				<ItemsPresenter ClipToBounds="True"/>
			</Border>
		</ScrollViewer>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=(local:GroupBarItem.IsAnimating)}"
						 Value="True" >
				<Setter TargetName="MainHost" Property="VerticalScrollBarVisibility" Value="Hidden"/>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
    <ControlTemplate x:Key="GroupViewStackModeTemplateKey.ShinyRed" TargetType="{x:Type local:GroupView}">
        <Border Name="ItemsHost" Padding="0,0,0,0">
            <ItemsPresenter ClipToBounds="True"/>
        </Border>
    </ControlTemplate>
    <Style  TargetType="{x:Type local:GroupView}">
		<Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="VerticalContentAlignment" Value="Stretch"/>
         <Setter Property="Background" Value="{StaticResource BackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
							   VerticalAlignment="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
							   KeyboardNavigation.TabNavigation="Cycle"
							   KeyboardNavigation.DirectionalNavigation="Continue"
							   KeyboardNavigation.ControlTabNavigation="None"
                 Orientation="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
        

        <Style.Triggers>
			<Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
				<!--<Setter Property="ContextMenu" Value="{StaticResource GroupBar_ContextMenu}"/>-->
			</Trigger>

                    <Trigger Property="local:GroupBar.VisualMode" Value="Default">
                 <Setter Property="Template" Value="{StaticResource GroupViewDefaultTemplateKey.ShinyRed}"/>
            </Trigger>
			
			 <Trigger Property="local:GroupBar.VisualMode" Value="StackMode">
                <Setter Property="Template" Value="{StaticResource GroupViewStackModeTemplateKey.ShinyRed}"/>
            </Trigger>
			
			 <Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
                 <Setter Property="Template" Value="{StaticResource GroupViewMultipleExpansionTemplateKey.ShinyRed}"/>
            </Trigger>
			
			 
			 <Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>
			<Trigger Property="local:GroupView.IsListViewMode" Value="False">
				<Setter Property="IsShowText" Value="False"/>
			</Trigger>
	 </Style.Triggers>
	 </Style>
	
	
	
	
	
	<!-- GroupViewItem Template -->

	<ControlTemplate x:Key="GroupViewItemTemplateKey.ShinyRed" TargetType="{x:Type local:GroupViewItem}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="SelectedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder2" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder1" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0.5"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder2" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder1" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedHoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedHoverBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedHoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedHoverBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Border Name="MainGrid"
				Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}"
				BorderBrush="{StaticResource ItemBackgroundBrushKey.ShinyRed}"
				BorderThickness="1"
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}">
            <Grid>
                <Border ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" Background="{Binding Path=SelectedItemColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}" BorderBrush="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}" BorderThickness="1"  Opacity="0" x:Name="SelectedBorder"/>
                <Border ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" x:Name="HoverBorder1" Opacity="0" Background="{Binding Path=MouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}" BorderBrush="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}" BorderThickness="1" />
                <Border ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" x:Name="HoverBorder2" Opacity="0" Background="{Binding Path=MouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}" BorderBrush="{x:Null}" BorderThickness="1" />
                <Border ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" x:Name="SelectedHoverBorder" Opacity="0" Background="{Binding Path=SelectedItemMouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}" BorderBrush="{x:Null}" BorderThickness="1"/>


                <Grid>
                <Grid.Resources>
                    <local:ContentToVisibilityConverter x:Key="ContentToVisibility"/>
                </Grid.Resources>
                <DockPanel Name="ContentHost" Visibility="{Binding Path=Content,ElementName=contentpresenter, Converter={StaticResource ContentToVisibility}}" Margin="3"
					   Width="{Binding Path=InternalContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
					   HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}">
                    <Border Name="ImageHost"
						DockPanel.Dock="Left"
						Width="{TemplateBinding ImageWidth}"
						Height="{TemplateBinding ImageHeight}"
						HorizontalAlignment="Left"
						Background="Transparent">
                        <Image Name="Image"
						   Stretch="Fill"
						   Source="{TemplateBinding ImageSource}"/>
                    </Border>
                    <Border Name="TextHost"
						DockPanel.Dock="Top"
						Padding="3,2,3,2"
						HorizontalAlignment="{Binding Path=TextAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
						TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}" >
                        <StackPanel>
                            <TextBlock Name="Text"
								   Visibility="Visible"
								   TextTrimming="CharacterEllipsis"
								   Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                            <TextBox Name="TextEditor"
								 Visibility="Collapsed"
								 Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"
								 Background="{TemplateBinding Background}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Border >
                    <DockPanel>
                        <ContentControl x:Name="contentpresenter"
                            Content="{TemplateBinding Content}" ContentTemplateSelector="{Binding Path=ItemTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                         ContentTemplate="{Binding Path=ItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                            Width="{Binding Path=InternalContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                            HorizontalContentAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"/>
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>
        </Border>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=IsShowText, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" Value="False">
				<Setter TargetName="TextHost" Property="Visibility" Value="Collapsed"/>
			</DataTrigger>
			<Trigger Property="IsInEditMode" Value="True">
				<Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
				<Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="TextHost" Property="HorizontalAlignment" Value="Stretch"/>
				<Setter TargetName="TextHost" Property="Visibility" Value="Visible"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition SourceName="MainGrid" Property="IsMouseOver" Value="True"/>
					<Condition Property="IsSelected" Value="False"/>
				</MultiTrigger.Conditions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="HoverOff_BeginStoryboard" Storyboard="{StaticResource HoverOff}"/>
                </MultiTrigger.ExitActions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="HoverOn_BeginStoryboard" Storyboard="{StaticResource HoverOn}"/>
                </MultiTrigger.EnterActions>
                <Setter Property="Background" TargetName="MainGrid">
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=MouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
            </MultiTrigger>
			<Trigger Property="IsPressed" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOff}" x:Name="SelectedHoverOff_BeginStoryboard"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOn}" x:Name="SelectedHoverOn_BeginStoryboard"/>
                </Trigger.EnterActions>
				<Setter Property="Background" TargetName="MainGrid">
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=MouseDownColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
            </Trigger>
			<Trigger Property="IsSelected" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOff}" x:Name="SelectedHoverOff_BeginStoryboard11"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOn}" x:Name="SelectedHoverOn_BeginStoryboard11"/>
                </Trigger.EnterActions>
                <Setter Property="Background" TargetName="MainGrid">
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=SelectedItemColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
            </Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition SourceName="MainGrid" Property="IsMouseOver" Value="True"/>
					<Condition Property="IsSelected" Value="True"/>
				</MultiTrigger.Conditions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="HoverOff_BeginStoryboard1" Storyboard="{StaticResource HoverOff}"/>
                </MultiTrigger.ExitActions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="HoverOn_BeginStoryboard1" Storyboard="{StaticResource HoverOn}"/>
                </MultiTrigger.EnterActions>
                <Setter Property="Background" TargetName="MainGrid">
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=SelectedItemMouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
				<!--<Setter Property="Background" TargetName="MainGrid" Value="{Binding Path=(local:GroupViewItem.SelectedItemMouseHoverColor),RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>-->
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
            </MultiTrigger>
			<Trigger Property="IsDragging" Value="True">
                <Setter TargetName="MainGrid" Property="Background" Value="{StaticResource GroupViewItemHighlightBrushKey.ShinyRed}"/>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
			</Trigger>
			<DataTrigger Binding="{Binding Path=(local:GroupView.IsListViewMode), RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
						 Value="False">
				<Setter TargetName="ContentHost" Property="Width" Value="{Binding Path=Width}" />
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	
	<Style x:Key="ShinyRedGroupViewItemStyle"  TargetType="{x:Type local:GroupViewItem}" >
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<!--<Setter Property="Background" Value="{utilsOuter:SkinObject GroupViewItem_BackgroundBrush}"/>-->
		
		<Setter Property="Background" Value="{StaticResource ItemBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="SelectedItemColor" Value="{StaticResource GroupViewItemSelectedColor.ShinyRed}"/>
                <Setter Property="MouseDownColor" Value="{StaticResource GroupViewItemPressedColor.ShinyRed}"/>
                <Setter Property="SelectedItemMouseHoverColor" Value="{StaticResource GroupViewItemHighlightColor.ShinyRed}"/>
                <Setter Property="Margin" Value="{StaticResource OfficeGroupViewItemMargin}"/>
                <Setter Property="Template" Value="{StaticResource GroupViewItemTemplateKey.ShinyRed}"/>              
        
        <Setter Property="ToolTipService.IsEnabled" Value="True"/>
		<Setter Property="ToolTipService.Placement" Value="Mouse"/>       
        
        <Style.Triggers>
            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
               <Setter Property="MouseHoverColor" Value="{StaticResource Blend_GroupViewItem_OverBackgroundColor}"/>
            </Trigger>
			
			 <Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>
			<Trigger Property="ShowToolTip" Value="False">
				<Setter Property="ToolTipService.IsEnabled" Value="False"/>
			</Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>                
            </Trigger>
		</Style.Triggers>
	</Style>

    <Style BasedOn="{StaticResource ShinyRedGroupViewItemStyle}" TargetType="{x:Type local:GroupViewItem}"/>

    <!-- Naviagation Toolbar Template -->
	<ControlTemplate x:Key="NavigationToolbar.ShinyRed" TargetType="{x:Type local:NavigationToolbar}">
		<Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
			<Grid.Resources>
				<ResourceDictionary>
					<Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
						<Setter Property="Template" Value="{StaticResource ToggleButtonKeyTemplate}"/>
					</Style>
                    <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type CheckBox}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                        <ContentPresenter ContentSource="Content"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True" >
                                <Setter Property="Background" Value="#FFBD69"/>
                                <Setter Property="BorderBrush" Value="#FFAB3F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
				</ResourceDictionary>
			</Grid.Resources>
			<Border Name="MainHost"
              CornerRadius="{Binding Path=ToolbarBottomCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
          Background="{TemplateBinding Background}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}">
				<WrapPanel Name="MainPanel"
						   Orientation="Horizontal"
						   FlowDirection="RightToLeft">
                    <Menu Name="Menu" Margin="{Binding Path=ToolbarMenuMarginRight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
						  FlowDirection="LeftToRight"
						  Background="Transparent">
                        <MenuItem Name="TopMenuItem" Height="{TemplateBinding Height}" 											
								  Padding="0" Template="{StaticResource MenuItemKey.ShinyRed}" 
								  Margin="0" Width="{Binding Path=MenuDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"											
								  Background="Transparent"
								 >
                            <!--Template="{StaticResource MenuItemSubmenuTemplateKey}"
								  ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
                            <MenuItem.Header>
                               <DockPanel Name="MenuImageHost"
										   Background="{Binding Background, ElementName=TopMenuItem}">                                   
                                        <Canvas Width="5" Name="MenuImage"
												Height="3" 
												VerticalAlignment="Center"
												HorizontalAlignment="Left">
                                        <Path HorizontalAlignment="Left" Margin="-11,0,0,0" x:Name="Arrow" VerticalAlignment="Center" Fill="{StaticResource GlyphBrushKey.ShinyRed}" Data="M 0 0 L 4 4 L 8 0 Z" />

                                      </Canvas>
                                   
                                </DockPanel>
                            </MenuItem.Header>
                            <MenuItem Name="SplitterUpMenuItem"
									  Command="local:GroupBar.SplitterUpCommand"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Showmorebuttons}"
									  StaysOpenOnClick="True">
								<MenuItem.Icon>
									<StaticResource ResourceKey="Office_NavigationToolBar_UpMenuItemHeader"/>
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Name="SplitterDownMenuItem"
									  Command="local:GroupBar.SplitterDownCommand"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Showfewerbuttons}"
									  StaysOpenOnClick="True">
								<MenuItem.Icon>
									<StaticResource ResourceKey="Office_NavigationToolBar_DownMenuItemHeader"/>
								</MenuItem.Icon>
							</MenuItem>
							<Separator />
							<!--Style="{StaticResource SeparatorKeyStyle}"-->
							<MenuItem Name="OptionsMenu"
									  Command="local:GroupBar.OpenOptionsCommand"
									  Header="{Binding Path=NavigationOptionsMenuItemHeader, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
							<Separator />
							<!--Style="{StaticResource SeparatorKeyStyle}"-->
							<MenuItem Name="ButtonsMenu"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Buttons}"
									 />
							<!--ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
						</MenuItem>
					</Menu>
					<ItemsPresenter Name="ItemsPresenter"/>
				</WrapPanel>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
      <DataTrigger
				Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="True">
        <Setter TargetName="Menu" Property="Margin" Value="0"/>
      </DataTrigger>      
			<Trigger SourceName="MenuImage" Property="IsMouseOver" Value="True">
                <Setter TargetName="TopMenuItem" Property="Background"  Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
            </Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
					<Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter TargetName="Menu" Property="LayoutTransform">
					<Setter.Value>
						<RotateTransform Angle="-90" />
					</Setter.Value>
				</Setter>
				<Setter TargetName="MenuImageHost" Property="LayoutTransform">
					<Setter.Value>
						<TransformGroup>
							<RotateTransform Angle="-90"/>
						</TransformGroup>
					</Setter.Value>
				</Setter>
			</MultiDataTrigger>

			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
					<Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="LeftToRight"/>
				</MultiDataTrigger.Conditions>
				<Setter TargetName="Menu" Property="LayoutTransform">
					<Setter.Value>
						<RotateTransform Angle="-90" />
					</Setter.Value>
				</Setter>
				<Setter TargetName="MenuImageHost" Property="LayoutTransform">
					<Setter.Value>
						<TransformGroup>
							<RotateTransform Angle="-90" />
						</TransformGroup>
					</Setter.Value>
				</Setter>
            </MultiDataTrigger>
			
			<DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="RightToLeft">
				<Setter TargetName="MainPanel" Property="FlowDirection" Value="LeftToRight"/>
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</DataTrigger>

			<DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="LeftToRight">
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style  TargetType="{x:Type local:NavigationToolbar}">
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" />
		<Setter Property="ItemMargin" Value="1"/>
        <Setter Property="MenuDefaultWidth" Value="{StaticResource NavigationMenuDefaultWidth}"/>
        <Setter Property="ItemDefaultWidth" Value="22"/>
        <Setter Property="Template"  Value="{StaticResource  NavigationToolbar.ShinyRed}"/>
        </Style>
	
	
	<!-- NaviagationToolbarItem Template -->
	<ControlTemplate x:Key="NaviagationToolbarItemTemplateKey.ShinyRed" TargetType="{x:Type local:NavigationToolbarItem}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="SelectedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder2" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder1" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0.5"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder2" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverBorder1" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedHoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedHoverBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedHoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedHoverBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
		<Grid SnapsToDevicePixels="True" ClipToBounds="True">
            <Border Name="ImageHost" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyRed}"
					Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					Background="{TemplateBinding Background}"
					BorderThickness="1"
					Margin="0">
                <Grid>
                    <Border Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					BorderThickness="1"
					Margin="0" Background="{StaticResource SelectedBrushKey.ShinyRed}" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyRed}" Opacity="0" x:Name="SelectedBorder"/>
                    <Border Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					BorderThickness="1"
					Margin="0" x:Name="HoverBorder1" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyRed}"  />
                    <Border Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					BorderThickness="1"
					Margin="0" x:Name="HoverBorder2" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" BorderBrush="{x:Null}"  />
                    <Border Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					BorderThickness="1"
					Margin="0" x:Name="SelectedHoverBorder" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" BorderBrush="{x:Null}" />

                    <StackPanel HorizontalAlignment="Center"
							VerticalAlignment="Center">
                        <Image Name="Image"
						   Source="{TemplateBinding ImageSource}"
						   Visibility="Visible"
						   Height="20"
						   Width="20"
						   Stretch="Fill"/>
                        <Border Name="EmptyImage"
							Visibility="Collapsed"
							BorderBrush="Black"
                               BorderThickness="1"
							Height="20"
							Width="20"/>
                    </StackPanel>
                </Grid>
            </Border>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger SourceName="ImageHost" Property="IsMouseOver" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="HoverOff_BeginStoryboard1" Storyboard="{StaticResource HoverOff}"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="HoverOn_BeginStoryboard1" Storyboard="{StaticResource HoverOn}"/>
                </Trigger.EnterActions>
                <Setter Property="Background" Value="{StaticResource HighlightBrushKey.ShinyRed}"/>
				<Setter Property="Cursor" Value="Hand"/>
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOff}" x:Name="SelectedHoverOff_BeginStoryboard11"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedHoverOn}" x:Name="SelectedHoverOn_BeginStoryboard11"/>
                </Trigger.EnterActions>
                <Setter TargetName="ImageHost" Property="Background" Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
            </Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsMouseOver" Value="True"/>
					<Condition Property="IsSelected" Value="True"/>
				</MultiTrigger.Conditions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="HoverOff_BeginStoryboard" Storyboard="{StaticResource SelectedHoverOff}"/>
                </MultiTrigger.ExitActions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="HoverOn_BeginStoryboard" Storyboard="{StaticResource SelectedHoverOn}"/>
                </MultiTrigger.EnterActions>
                <!--<Setter TargetName="ImageHost" Property="Background" Value="{utilsOuter:SkinObject NavigationToolbarItem_SelectedOverBackgroundBrush}"/>-->
			</MultiTrigger>
			<Trigger SourceName="Image" Property="Source" Value="{x:Null}">
				<Setter TargetName="EmptyImage" Property="Visibility" Value="Visible"/>
				<Setter TargetName="Image" Property="Visibility" Value="Collapsed"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	
		<Style  TargetType="{x:Type local:NavigationToolbarItem}">
		<Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"  Value="{StaticResource NaviagationToolbarItemTemplateKey.ShinyRed}"/>
	</Style>
	
	
	<!-- Splitter Template -->
	<ControlTemplate x:Key="GroupBarSplitterTemplateKey.ShinyRed" TargetType="{x:Type local:GroupBarSplitter}">
		<Border BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{StaticResource SpliiterBrushKey.ShinyRed}">
			<Border Width="18" Height="2" HorizontalAlignment="Center">
				<Canvas>
					<Line X1="1" Y1="1" X2="3" Y2="1" Stroke="White" StrokeThickness="2"/>
					<Line X1="5" Y1="1" X2="7" Y2="1" Stroke="White" StrokeThickness="2"/>
					<Line X1="9" Y1="1" X2="11" Y2="1" Stroke="White" StrokeThickness="2"/>
					<Line X1="13" Y1="1" X2="15" Y2="1" Stroke="White" StrokeThickness="2"/>
					<Line X1="17" Y1="1" X2="19" Y2="1" Stroke="White" StrokeThickness="2"/>

                    <Line X1="0" Y1="0" X2="2" Y2="0" Stroke="{StaticResource GlyphBrushKey.ShinyRed}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="4" Y1="0" X2="6" Y2="0" Stroke="{StaticResource GlyphBrushKey.ShinyRed}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="8" Y1="0" X2="10" Y2="0" Stroke="{StaticResource GlyphBrushKey.ShinyRed}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="12" Y1="0" X2="14" Y2="0" Stroke="{StaticResource GlyphBrushKey.ShinyRed}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="16" Y1="0" X2="18" Y2="0" Stroke="{StaticResource GlyphBrushKey.ShinyRed}" StrokeThickness="2" Opacity="0.5"/>
				</Canvas>
			</Border>
		</Border>
	</ControlTemplate>
    
		<Style  TargetType="{x:Type local:GroupBarSplitter}">
		<Setter Property="MinWidth" Value="4"/>
		<Setter Property="MinHeight" Value="4"/>
		<Setter Property="Height" Value="8" />
		<Setter Property="Margin" Value="1"/>
		<Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template"  Value="{StaticResource GroupBarSplitterTemplateKey.ShinyRed}"/>
	 </Style>
	
	
</ResourceDictionary>