<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"  xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
	            >
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />
    <Thickness x:Key="XP.Margin" >1</Thickness>
    <Thickness x:Key="Vista.Margin">0</Thickness>
    <SolidColorBrush x:Key="White" Color="White" />
    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="Default.Foreground" Color="Black" />
    <SolidColorBrush x:Key="Black" Color="Black" />
    <SolidColorBrush x:Key="Royale.Normalcolor.Background" Color="White" />
    <SolidColorBrush x:Key="Royale.Normalcolor.BorderBrush" Color="#7A9FBC" />
    <LinearGradientBrush x:Key="Royale.Normalcolor.DropDownButton.Background" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#F1F5FA" Offset="1" />
        <GradientStop Color="#C5D7EB" Offset="0" />
    </LinearGradientBrush>
    <CornerRadius x:Key="ToggleButtonCornerRadius">0</CornerRadius>
    <LinearGradientBrush x:Key="Royale.Normalcolor.DropDownButton.HighlightBorder" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#B3C0DA" Offset="1" />
        <GradientStop Color="#96ADD0" Offset="0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Default.DropDownButton.Pressed.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFC2E4F6" Offset="0" />
        <GradientStop Color="#FF98D0ED" Offset="1" />
        <GradientStop Color="#FFC2E4F6" Offset="0.5" />
        <GradientStop Color="#FF9ED3EF" Offset="0.5" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Default.FocusedBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Default.PressedBackground" Color="#FFFFFFFF" />
    <Style x:Key="ToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="{StaticResource XP.Margin}" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Royale.Normalcolor.DropDownButton.Background}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}"
                                CornerRadius="{StaticResource ToggleButtonCornerRadius}"
>
                        <ContentPresenter RecognizesAccessKey="True"
                              Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ClipToBounds="True" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Royale.Normalcolor.DropDownButton.HighlightBorder}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Royale.Normalcolor.DropDownButton.Background}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Default.DropDownButton.Pressed.Background}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Royale.Normalcolor.DropDownButton.HighlightBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <Style x:Key="RoyaleNormalThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFFFFFFF"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FFA0A0B4"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Type local:AutoComplete}" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource Royale.Normalcolor.Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Royale.Normalcolor.BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Default.Foreground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource ToggleButtonCornerRadius}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{StaticResource Default.Foreground}">
                        <Grid Name="ContentGrid"
>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>
                            <local:VistaSpecificProgressBar Name="PART_VistaProgressBar" Grid.Column="0" />
                            <Border Name="PART_Cursor" Width="2" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left"
							Background="Black" Height="16" />
                            <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0"
                 Margin="1,0,1,0"
				 VerticalAlignment="Center"
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}"
                 BorderThickness="0"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
                 Padding="{TemplateBinding Padding}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1"
                              SnapsToDevicePixels="True"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource ToggleDropDownButtonStyle}"
>
                                <Path Name="PART_Arrow"
                Data="M0,1 L3,4 6,1"
                Stroke="{StaticResource Black}" StrokeThickness="2"
                Fill="{StaticResource Transparent}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               VerticalOffset="-2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw">
                                    <Border BorderThickness="1" BorderBrush="#FF828790">
                                        <Grid Background="White">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_Container"    KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True" BorderThickness="0"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}"
                   Focusable="True">
                                            </ListBox>
                                            <Border BorderBrush="#FFB5BECE" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFF7F8FD" Offset="0.101" />
                                                        <GradientStop Color="#FFDFE3F1" Offset="0.671" />
                                                        <GradientStop Color="#FFC4CBDB" Offset="0.986" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource RoyaleNormalThumbStyle}" Grid.Row="1" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                            <Popup Name="HistoryPopup"
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw1">
                                    <Border BorderThickness="1" BorderBrush="#FF828790">
                                        <Grid Background="White">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_HistoryContainer"    KeyboardNavigation.DirectionalNavigation="Cycle"
                              SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"  BorderThickness="0"
                   SnapsToDevicePixels="True"
			       Height="{TemplateBinding HistoryListHeight}"
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
>
                                            </ListBox>
                                            <Border BorderBrush="#FFB5BECE" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFF7F8FD" Offset="0.101" />
                                                        <GradientStop Color="#FFDFE3F1" Offset="0.671" />
                                                        <GradientStop Color="#FFC4CBDB" Offset="0.986" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="HistoryThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource RoyaleNormalThumbStyle}" Grid.Row="1" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Royale.Normalcolor.BorderBrush}" />

                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.FocusedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Default.FocusedBackground}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">

                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Royale.Normalcolor.BorderBrush}" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.PressedBackground}" />
                            <Setter TargetName="MainBorder" Property="CornerRadius" Value="{StaticResource ToggleButtonCornerRadius}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Default.PressedBackground}" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw" Value="#FFA5AFB9" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="HistoryPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw1" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw1" Value="#FFA5AFB9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="EnableDropDown" Value="false">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                            <Border  BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{TemplateBinding Foreground}"
>

                                <Grid
            Focusable="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <local:VistaSpecificProgressBar Name="PART_VistaProgressBar" Grid.Column="0" />
                                    <Border Name="PART_Cursor" Width="2" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left"
							Background="Black" Height="16" />
                                    <TextBox Name="PART_EditableTextBox"
						 Grid.Column="0"
						 Margin="0" Background="Transparent"
						 VerticalAlignment="Center"
						 BorderThickness="0"
						 Foreground="{TemplateBinding Foreground}"
						 FontFamily="{TemplateBinding FontFamily}"
						 FontSize="{TemplateBinding FontSize}"
						 FontStretch="{TemplateBinding FontStretch}"
						 FontStyle="{TemplateBinding FontStyle}"
						 FontWeight="{TemplateBinding FontWeight}"
                         Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                                    <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
					   VerticalOffset="-2"
					   HorizontalOffset="1"
					   SnapsToDevicePixels="True"
					   AllowsTransparency="True"
					   Focusable="True"
					   PopupAnimation="Slide">
                                        <Border>
                                            <Grid Background="{TemplateBinding Background}">
                                                <ListBox  Name="PART_Container"
                              SelectionMode="{TemplateBinding SelectionMode}"

							 IsSynchronizedWithCurrentItem="True"
							 SnapsToDevicePixels="True"
							 MaxHeight="{TemplateBinding MaxDropHeight}"
							 Focusable="True"
							 Width="{Binding Path=ActualWidth, ElementName=PART_EditableTextBox}"
>
                                                </ListBox>
                                                <Thumb x:Name="ContainerThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource RoyaleNormalThumbStyle}" />
                                            </Grid>
                                        </Border>
                                    </Popup>
                                    <Popup Name="HistoryPopup"
					   SnapsToDevicePixels="True"
					   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   AllowsTransparency="True"
					   Focusable="True"
					   PopupAnimation="Slide"
					   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                        <ListBox Name="PART_HistoryContainer"
                              SelectionMode="{TemplateBinding SelectionMode}"
							 IsSynchronizedWithCurrentItem="True"
						     SnapsToDevicePixels="True"
							 Height="{TemplateBinding HistoryListHeight}"
							 Width="{TemplateBinding ActualWidth}"
							 Focusable="True"
>
                                        </ListBox>
                                    </Popup>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>