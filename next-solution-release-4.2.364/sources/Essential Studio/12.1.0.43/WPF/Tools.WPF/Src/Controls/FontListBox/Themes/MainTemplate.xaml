                <Setter TargetName="Border" Property="TextBlock.Foreground" Value="{StaticResource Blend.ItemMouseOverForegroundBrush}"/>
				<Setter TargetName="Border" Property="Opacity" Value="1"/>
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Blend.ItemBorderBrush}"/>
				<Setter TargetName="Border" Property="BorderThickness" Value="1"/>
			</Trigger>
