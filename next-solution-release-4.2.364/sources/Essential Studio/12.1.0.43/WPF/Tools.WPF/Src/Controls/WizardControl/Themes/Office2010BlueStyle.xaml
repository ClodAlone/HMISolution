<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:classic="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Classic"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <!--Brushes-->    

    <LinearGradientBrush x:Key="Office2010BlueWizardNavigationAreaBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF5F9FF" Offset="0.039"/>
        <GradientStop Color="#FFDCE8F6" Offset="0.042"/>
        <GradientStop Color="#FFB5C5D9" Offset="0.865"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueWizardNavigationAreaBorderBrush" Color="#FF849DBD"/>


    <LinearGradientBrush x:Key="Office2010BlueWizardControlBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCEDCED" Offset="0"/>
        <GradientStop Color="#FFC2D4E8" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueWizardControlBorderBrush" Color="#FF849DBD"/>   

    <LinearGradientBrush x:Key="Office2010BlueWizardBannerBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDCE8F6"/>
        <GradientStop Color="#FFB5C5D9" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueWizardBannerBorderBrush" Color="#FF849DBD"/>

    <LinearGradientBrush x:Key="Office2010BlueWizardBannerExteriorBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDCE8F6"/>
        <GradientStop Color="#FFB5C5D9" Offset="1"/>
    </LinearGradientBrush>    

    

    <RelativeSource x:Key="wizardAncestor" Mode="FindAncestor" AncestorType="{x:Type syncfusion:WizardControl}"/>
    <syncfusion:WizardPageVisibility x:Key="pageVisibilityConverter"/>
    <syncfusion:VisibilityResolver x:Key="visibilityResolver"/>


    <Style x:Key="Office2010BlueWizardControlStyle" TargetType="{x:Type syncfusion:WizardControl}">
        <Setter Property="Background" Value="{StaticResource Office2010BlueWizardControlBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueWizardControlBorderBrush}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid  SnapsToDevicePixels="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:WizardControl}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsPresenter Name="PART_PagesPresenter"  />
                        <syncfusion:WizardNavigationArea Grid.Row="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueWizardControlStyle}" TargetType="{x:Type syncfusion:WizardControl}"/>


    <Style x:Key="Office2010BlueWizardPageStyle" TargetType="{x:Type syncfusion:WizardPage}">
        <Setter Property="HelpVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="HelpVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="HelpVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="CancelVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="CancelVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="CancelVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BackVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="BackVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="BackVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="NextVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="NextVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="NextVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FinishVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="FinishVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="FinishVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type syncfusion:WizardNavigationArea}">
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueWizardNavigationAreaBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource Office2010BlueWizardNavigationAreaBackground}"/>
        <Setter Property="BorderThickness" Value="0,2,0,0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:WizardNavigationArea}">
                    <classic:ClassicBorderDecorator BorderStyle="Etched" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <StackPanel Background="{TemplateBinding Background}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Name="PART_HelpButton" MinWidth="75" Command="syncfusion:WizardCommands.Help" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=HelpText}" Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.HelpVisibility)}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Name="PART_CancelButton" Margin="0,0,7,0" MinWidth="75" Command="syncfusion:WizardCommands.Cancel" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=CancelText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.CancelVisibility)}"
                                            />
                                    <Button Name="PART_BackButton" MinWidth="75" Command="syncfusion:WizardCommands.Previous" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=BackText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.BackVisibility)}"
                                            />
                                    <Button Name="PART_NextButton" Margin="2,0,0,0" MinWidth="75" Command="syncfusion:WizardCommands.Next" IsDefault="{Binding RelativeSource={StaticResource wizardAncestor}, Path=NextFocused}" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=NextText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.NextVisibility)}"
                                            />
                                    <Button Name="PART_FinishButton" Margin="7,0,0,0" MinWidth="75" Command="syncfusion:WizardCommands.Finish" IsDefault="{Binding RelativeSource={StaticResource wizardAncestor}, Path=FinishFocused}" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=FinishText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.FinishVisibility)}"
                                            />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </classic:ClassicBorderDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueWizardPageStyle}" TargetType="{x:Type syncfusion:WizardPage}">
        <Setter Property="BorderBrush"  Value="{StaticResource Office2010BlueWizardBannerBorderBrush}"/>
        <Setter Property="BannerBackground" Value="{StaticResource Office2010BlueWizardBannerBackground}"/>
        <Style.Triggers>

            <Trigger Property="PageType" Value="Interior">
                <Setter Property="BorderThickness" Value="0,2,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type syncfusion:WizardPage}">
                            <Grid Visibility="{TemplateBinding IsSelected, Converter={StaticResource pageVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Name="PART_Header" Row="0" Background="{TemplateBinding BannerBackground}" MinHeight="{Binding RelativeSource={StaticResource wizardAncestor}, Path=InteriorPageHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Name="title" Margin="16, 9, 0, 1" TextWrapping="Wrap" FontWeight="Bold" Text="{TemplateBinding Title}" />
                                        <TextBlock Name="description" Margin="32, 0, 0, 9" TextWrapping="Wrap" Text="{TemplateBinding Description}" />
                                    </StackPanel>
                                    <!-- <Image Grid.Column="1" Margin="4" Source="{TemplateBinding BannerImage}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" /> -->
									<Image Grid.Column="1" Margin="4" Source="{TemplateBinding BannerImage}" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Width="{TemplateBinding BannerImageWidth}" Height="{TemplateBinding BannerImageHeight}"/>
                                </Grid>
                                <classic:ClassicBorderDecorator Grid.Row="1" BorderStyle="Etched" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                    <Grid Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="14" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                    </Grid>
                                </classic:ClassicBorderDecorator>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            
            <Trigger Property="PageType" Value="Exterior">
                <Setter Property="BorderThickness" Value="0,0,2,0" />
                <Setter Property="BannerBackground" Value="{StaticResource Office2010BlueWizardBannerExteriorBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type syncfusion:WizardPage}">
                            <Grid Background="{TemplateBinding Background}"
              Visibility="{TemplateBinding IsSelected, Converter={StaticResource pageVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <classic:ClassicBorderDecorator BorderStyle="Etched" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                    <Grid Name="PART_Header" Grid.Column="0" 
                      Background="{TemplateBinding BannerBackground}" 
                      MinWidth="{Binding RelativeSource={StaticResource wizardAncestor}, Path=ExteriorPageBannerImageMinWidth}">
                                        <!-- <Image Margin="0" Source="{TemplateBinding BannerImage}" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Top" /> -->
										<Image Margin="0" Source="{TemplateBinding BannerImage}" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Width="{TemplateBinding BannerImageWidth}" Height="{TemplateBinding BannerImageHeight}"/>
                                    </Grid>
                                </classic:ClassicBorderDecorator>
                                <Grid Column="1" Margin="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Name="PART_TitleTextBlock" Grid.Row="0" TextWrapping="Wrap" Margin="0, 0, 0, 14" FontSize="16" FontWeight="Bold" Text="{TemplateBinding Title}" />
                                    <TextBlock Name="PART_DescriptionTextBlock" Grid.Row="1" TextWrapping="Wrap" Margin="0, 0, 0, 14" Text="{TemplateBinding Description}" />
                                    <ContentPresenter Grid.Row="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Value="" Property="Title">
                                    <Setter TargetName="PART_TitleTextBlock" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Value="" Property="Description">
                                    <Setter TargetName="PART_DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>                      

            <Trigger Property="PageType" Value="Blank">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type syncfusion:WizardPage}">
                            <Grid Background="{TemplateBinding Background}"
              Visibility="{TemplateBinding IsSelected, Converter={StaticResource pageVisibilityConverter}}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>