<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <!--Brushes-->
    <LinearGradientBrush x:Key="NormalBackgroundBrushKey.ShinyRed"
                       EndPoint="0.5,1"
                       StartPoint="0.5,0">
        <GradientStop Color="#FFF1BCBE"
                  Offset="0" />
        <GradientStop Color="#FFCE6865"
                  Offset="0.41800001263618469" />
        <GradientStop Color="#FFAF231E"
                  Offset="0.418" />
        <GradientStop Color="#FF601818"
                  Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NormalBorderBrushKey.ShinyRed"
                       EndPoint="0.5,1"
                       StartPoint="0.5,0">
        <GradientStop Color="#FFBBBBBB" />
        <GradientStop Color="#FF737373"
                  Offset="0.38" />
        <GradientStop Color="#FF646464"
                  Offset="0.384" />
        <GradientStop Color="#FF000000"
                  Offset="1" />
    </LinearGradientBrush>



    <!--<Color x:Key="SelectedBackgroundGradient1">#FFBBBBBB</Color>
    <Color x:Key="SelectedBackgroundGradient2">#FF737373</Color>
    <Color x:Key="SelectedBackgroundGradient3">#FF646464</Color>
    <Color x:Key="SelectedBackgroundGradient4">#FFA1A1A1</Color>-->

    <LinearGradientBrush x:Key="SelectedBrushKey.ShinyRed"
                       EndPoint="0.5,1"
                       StartPoint="0.5,0">
        <GradientStop Color="#FFBBBBBB" />
        <GradientStop Color="#FF737373"
                  Offset="0.38" />
        <GradientStop Color="#FF646464"
                  Offset="0.384" />
        <GradientStop Color="#FFA1A1A1"
                  Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextBrushKey.ShinyRed" Color="#FFFFFFFF"/>

    <RadialGradientBrush x:Key="HighlightBrushKey.ShinyRed">
        <RadialGradientBrush.RelativeTransform>
            <TransformGroup>
                <ScaleTransform CenterX="0.5"
                        CenterY="0.5"
                        ScaleX="1.804"
                        ScaleY="0.743" />
                <SkewTransform CenterX="0.5"
                       CenterY="0.5" />
                <RotateTransform CenterX="0.5"
                         CenterY="0.5" />
                <TranslateTransform Y="0.47999998927116394" />
            </TransformGroup>
        </RadialGradientBrush.RelativeTransform>
        <GradientStop Color="#FFFFC398"
                  Offset="0.209" />
        <GradientStop Color="#00FFB598"
                  Offset="1" />
        <GradientStop Color="#FFFFFFFF"
                  Offset="0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="PanelBackgroundBrushKey.ShinyRed" Color="#FFBF7D81"/>
    
    <LinearGradientBrush x:Key="NormalBackgroundBrushKey.ShinyBlue" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFBAE4FF" Offset="0" />
        <GradientStop Color="#FF398FDF" Offset="0.41800001263618469" />
        <GradientStop Color="#FF006DD4" Offset="0.418" />
        <GradientStop Color="#FF0A3E69" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HighlightBrushKey.ShinyBlue">
        <RadialGradientBrush.RelativeTransform>
            <TransformGroup>
                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.804" ScaleY="0.743" />
                <SkewTransform CenterX="0.5" CenterY="0.5" />
                <RotateTransform CenterX="0.5" CenterY="0.5" />
                <TranslateTransform Y="0.47999998927116394" />
            </TransformGroup>
        </RadialGradientBrush.RelativeTransform>
        <GradientStop Color="#FF98DAFF" Offset="0.209" />
        <GradientStop Color="#0098DAFF" Offset="1" />
        <GradientStop Color="#FFFFFFFF" Offset="0" />
    </RadialGradientBrush>
    
    <SolidColorBrush x:Key="PanelBackgroundBrushKey.ShinyBlue" Color="#FF8394A8"/>

    <!--GalleryItem style-->
    <Style x:Key="ShinyBlueGalleryItemStyle" TargetType="{x:Type local:GalleryItem}">
        <Setter Property="ContentTemplate" Value="{Binding Path=ItemContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="ContentTemplateSelector" Value="{Binding Path=ItemContentTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="VisualMode" Value="{Binding Path=VisualMode, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="IsAlwaysShownCaption" Value="{Binding Path=IsAlwaysShownCaption, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="AllowDrop" Value="{Binding Path=AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="Margin" Value="{Binding Path=ItemMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="Detailed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryItem}">
                            <ControlTemplate.Resources>
                                <Storyboard x:Key="HoverOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="HoverOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOn">
                                    <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00.1000000" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </ControlTemplate.Resources>
                            <Border Name="border" MinHeight="75"  
                BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                        BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"  
                        CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                        Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" >

                                <Grid>
                                    <Border x:Name="Hover" Opacity="0"/>
                                    <Border x:Name="FocusVisualElement" Opacity="0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Name="InnerBorder" Grid.Column="0" Margin="7.5,4,7.5,4" Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" BorderThickness="1" BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <Border Margin="1">
                                                <ContentPresenter MinWidth="0" ContentSource="Content" Margin="2,1,1,1"
														ContentTemplate="{TemplateBinding Property=local:GalleryItem.ContentTemplate}"
														ContentTemplateSelector="{TemplateBinding Property=local:GalleryItem.ContentTemplateSelector}"/>
                                            </Border>
                                        </Border>
                                        <Border Name="HeaderTextBorder" Grid.Column="1" Margin="2"
                        CornerRadius="{Binding Path=CaptionCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderThickness="{Binding Path=CaptionBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderBrush="{Binding Path=CaptionBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        Background="{Binding Path=CaptionBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <TextBlock Name="HeaderText" Foreground="{Binding Path=ItemForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" Grid.Column="1" Margin="3,3,3,20" DockPanel.Dock="Top"
						 Text="{Binding Path=Caption, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}"
						 FontSize="14" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Name="DescrText" Foreground="{Binding Path=ItemForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" Grid.Column="1" DockPanel.Dock="Bottom" Margin="5,30,3,3"
										 Text="{Binding Path=Description, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}"
										 FontSize="11" FontStyle="Normal"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>


                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="BorderBrush" Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>

                                <Trigger Property="HasFocus" Value="True">
                                    <Setter TargetName="FocusVisualElement"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="HasFocus" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="Background"  Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOff}"/>
                                    </MultiTrigger.ExitActions>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </MultiTrigger.ExitActions>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="HasFocus" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=FocusedItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=FocusedItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>

                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="border" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="Background"  Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOff}"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=ItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="Standard"/>
                    <Condition Property="IsAlwaysShownCaption" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryItem}">
                            <ControlTemplate.Resources>
                                <Storyboard x:Key="HoverOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="HoverOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="contentBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="contentBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOn">
                                    <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00.1000000" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </ControlTemplate.Resources>
                            <utilsOuter:TrippleBorder Name="contentBorder"                              
                             BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
							 Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"                            
                             MinWidth="0" CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             SnapsToDevicePixels="False">
                                <Grid>
                                    <Border x:Name="Hover" Opacity="0"/>
                                    <Border x:Name="FocusVisualElement" Opacity="0"/>
                                    <ContentPresenter MinWidth="0" ContentSource="Content" TextBlock.Foreground="{TemplateBinding Foreground}"
                        Margin="{Binding Path=ItemPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
										    ContentTemplate="{TemplateBinding Property=local:GalleryItem.ContentTemplate}"
										    ContentTemplateSelector="{TemplateBinding Property=local:GalleryItem.ContentTemplateSelector}"/>
                                </Grid>
                            </utilsOuter:TrippleBorder>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>

                                <Trigger Property="HasFocus" Value="true">
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="HasFocus" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="FocusVisualElement" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>
                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="FocusVisualElement"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard x:Name="FocusedOff_BeginStoryboard" Storyboard="{StaticResource FocusedOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>


                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="IsMouseOver" Value="true"/>

                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="Background" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="HasFocus" Value="True"/>

                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="Background" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="Standard"/>
                    <Condition Property="IsAlwaysShownCaption" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryItem}">
                            <ControlTemplate.Resources>
                                <Storyboard x:Key="HoverOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="HoverOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="contentBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="contentBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOn">
                                    <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00.1000000" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </ControlTemplate.Resources>
                            <utilsOuter:TrippleBorder Name="contentBorder"  CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"                             
                             BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
							 Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"                            
                             MinWidth="0"
                             SnapsToDevicePixels="False">
                                <Grid>
                                    <Border x:Name="Hover" Opacity="0"/>
                                    <Border x:Name="FocusVisualElement" Opacity="0"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0" Name="contentGridColumn0"></ColumnDefinition>
                                            <ColumnDefinition Width="0" Name="contentGridColumn1"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="0" Name="contentGridColumn3"></ColumnDefinition>
                                            <ColumnDefinition Width="0" Name="contentGridColumn4"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0" Name="contentGridRow0"></RowDefinition>
                                            <RowDefinition Height="0" Name="contentGridRow1"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="0" Name="contentGridRow3"></RowDefinition>
                                            <RowDefinition Height="0" Name="contentGridRow4"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Border Name="headerTextBorder" Grid.Column="2" Grid.Row="0" Margin="1"
                        CornerRadius="{Binding Path=CaptionCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderThickness="{Binding Path=CaptionBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderBrush="{Binding Path=CaptionBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        Background="{Binding Path=CaptionBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <TextBlock Text="{Binding Path=Caption, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}" 
                               FontSize="9" FontWeight="Bold" TextAlignment="Center" Grid.Row="0" Grid.Column="2" Name="headerTextBlock"/>
                                        </Border>
                                        <ContentPresenter MinWidth="0" MinHeight="0" ContentSource="Content"
										    ContentTemplate="{TemplateBinding Property=local:GalleryItem.ContentTemplate}"
										    ContentTemplateSelector="{TemplateBinding Property=local:GalleryItem.ContentTemplateSelector}"
                                  Grid.Column="2" Grid.Row="2"/>
                                        <Border Name="descriptionTextBorder" Grid.Column="2" Grid.Row="4" Margin="1"
                        CornerRadius="{Binding Path=CaptionCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderThickness="{Binding Path=CaptionBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderBrush="{Binding Path=CaptionBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        Background="{Binding Path=CaptionBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <TextBlock Text="{Binding Path=Description, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}" 
                               FontSize="8" TextAlignment="Center" Grid.Row="4" Grid.Column="2" Name="descriptionTextBlock"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </utilsOuter:TrippleBorder>

                            <ControlTemplate.Triggers>

                                <!--CaptionAlignment and DescriptionAlignment related triggers-->
                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Top">
                                    <Setter TargetName="contentGridRow0" Property="Height" Value="16"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Bottom">
                                    <Setter TargetName="contentGridRow3" Property="Height" Value="16"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Row" Value="3"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Row" Value="3"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Left">
                                    <Setter TargetName="contentGridColumn0" Property="Width" Value="16"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="headerTextBlock" Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter TargetName="headerTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Right">
                                    <Setter TargetName="contentGridColumn3" Property="Width" Value="16"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Column" Value="3"/>
                                    <Setter TargetName="headerTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Top">
                                    <Setter TargetName="contentGridRow1" Property="Height" Value="14"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Row" Value="1"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Bottom">
                                    <Setter TargetName="contentGridRow4" Property="Height" Value="14"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Left">
                                    <Setter TargetName="contentGridColumn1" Property="Width" Value="14"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="descriptionTextBlock" Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter TargetName="descriptionTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Right">
                                    <Setter TargetName="contentGridColumn4" Property="Width" Value="14"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Column" Value="4"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Column" Value="4"/>
                                    <Setter TargetName="descriptionTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>

                                <Trigger Property="HasFocus" Value="true">
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="HasFocus" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="FocusVisualElement" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>
                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="FocusVisualElement"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="FocusVisualElement"  Property="BorderBrush" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource FocusedOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>


                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="IsMouseOver" Value="true"/>

                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="Background" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="HasFocus" Value="True"/>

                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="Background" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </MultiTrigger.ExitActions>

                                </MultiTrigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource ShinyBlueGalleryItemStyle}" TargetType="{x:Type local:GalleryItem}"/>

    <!--GalleryGroup style-->
    <Style TargetType="{x:Type local:GalleryGroup}">
        <Setter Property="ItemContentTemplate" Value="{Binding Path=ItemContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="ItemContentTemplateSelector" Value="{Binding Path=ItemContentTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="AllowDrop" Value="{Binding Path=AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="IsAlwaysShownCaption" Value="{Binding Path=IsAlwaysShownCaption, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="CaptionAlignment" Value="{Binding Path=CaptionAlignment, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="DescriptionAlignment" Value="{Binding Path=DescriptionAlignment, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GalleryGroup}">
                    <DockPanel Name="GroupStandardPanel" MinHeight="50" Background="Transparent">
                        <Border  Name="headerBorder" DockPanel.Dock="Top" MinHeight="15" 
                             Margin="{Binding Path=GroupMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Background="{Binding Path=GroupBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 BorderBrush="{Binding Path=GroupBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             BorderThickness="{Binding Path=GroupBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             CornerRadius="{Binding Path=GroupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Padding="{Binding Path=GroupPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 Visibility="{Binding Path=IsHeaderVisible
					 , RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Gallery}}
					 , Converter={StaticResource BooleanToVisibility}}"
					 >
                            <ContentPresenter Name="GroupHeaderText" Margin="2,1,1,1" TextBlock.Foreground="{Binding Path=GroupForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"  ContentSource="Header" />
                        </Border>
                        <Border Name="groupStandardBorder" 
					Margin="{Binding Path=GroupStandardBorderMargin, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					BorderBrush="{Binding Path=PanelBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					Background="{Binding Path=PanelBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
					BorderThickness="{Binding Path=PanelBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            Padding="{Binding Path=PanelPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            CornerRadius="{Binding Path=PanelCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                            <ItemsPresenter/>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:Gallery.IsSelected" Value="True">
                            <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                        </Trigger>
                        <Trigger Property="IsDragOver" Value="true">
                            <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:WrapPanelExt ItemWidth="{Binding Path=ItemWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"
                                        ItemHeight="{Binding Path=ItemHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                         ItemMinWidth="{Binding Path=ItemMinWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMaxWidth="{Binding Path=ItemMaxWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMinHeight="{Binding Path=ItemMinHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMaxHeight="{Binding Path=ItemMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
   VerticalAlignment="{Binding Path=VerticalAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"
                             ClipToBounds="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryGroup}">
                            <ControlTemplate.Resources>
                                <Storyboard x:Key="HoverOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="HoverOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="headerBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="headerBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOn">
                                    <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00.1000000" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </ControlTemplate.Resources>
                            <DockPanel Name="GroupStandardPanel" MinHeight="50" Background="Transparent">
                                <Border  Name="headerBorder" DockPanel.Dock="Top" MinHeight="15" 
                             Margin="{Binding Path=GroupMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Background="{Binding Path=GroupBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 BorderBrush="{Binding Path=GroupBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             BorderThickness="{Binding Path=GroupBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             CornerRadius="{Binding Path=GroupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Padding="{Binding Path=GroupPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 Visibility="{Binding Path=IsHeaderVisible
					 , RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Gallery}}
					 , Converter={StaticResource BooleanToVisibility}}"
					 >
                                    <Grid>
                                        <Border x:Name="Hover" Opacity="0"/>
                                        <Border x:Name="FocusVisualElement" Opacity="0"/>
                                        <ContentPresenter Name="GroupHeaderText" Margin="2,1,1,1" TextBlock.Foreground="{Binding Path=GroupForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"  ContentSource="Header" />
                                    </Grid>
                                </Border>
                                <Border Name="groupStandardBorder" 
					Margin="{Binding Path=GroupStandardBorderMargin, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					BorderBrush="{Binding Path=PanelBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					Background="{Binding Path=PanelBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
					BorderThickness="{Binding Path=PanelBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            Padding="{Binding Path=PanelPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            CornerRadius="{Binding Path=PanelCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                    <ItemsPresenter/>
                                </Border>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="local:Gallery.IsSelected" Value="True">
                                    <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>
                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=GroupMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=GroupMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="VisualMode" Value="Detailed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryGroup}">
                            <ControlTemplate.Resources>
                                <Storyboard x:Key="HoverOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="HoverOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOn">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="headerDetailedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="PressedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="headerDetailedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOn">
                                    <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00.1000000" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="FocusedOff">
                                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </ControlTemplate.Resources>
                            <StackPanel Background="Transparent" MinHeight="50">
                                <Border  Name="headerDetailedBorder" DockPanel.Dock="Top" 
					 MinHeight="15" 
                             Margin="{Binding Path=GroupMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Background="{Binding Path=GroupBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 BorderBrush="{Binding Path=GroupBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             BorderThickness="{Binding Path=GroupBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             CornerRadius="{Binding Path=GroupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Padding="{Binding Path=GroupPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					>
                                    <Grid>
                                        <Border x:Name="Hover" Opacity="0"/>
                                        <Border x:Name="FocusVisualElement" Opacity="0"/>

                                        <ContentPresenter Name="GroupHeaderText" TextBlock.Foreground="{Binding Path=GroupForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" ContentSource="Header"/>
                                    </Grid>
                                </Border>
                                <Border Name="groupDetailedBorder" Margin="{Binding Path=GroupStandardBorderMargin, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					BorderBrush="{Binding Path=PanelBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					Background="{Binding Path=PanelBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
					BorderThickness="{Binding Path=PanelBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            Padding="{Binding Path=PanelPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            CornerRadius="{Binding Path=PanelCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" MinHeight="30">
                                    <ItemsPresenter/>
                                </Border>
                            </StackPanel>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="groupDetailedBorder"  Property="Background"  Value="{Binding Path=PanelMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="groupDetailedBorder"  Property="BorderBrush" Value="{Binding Path=PanelMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="Background"  Value="{Binding Path=GroupMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="Hover"  Property="BorderBrush" Value="{Binding Path=GroupMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>
                                <Trigger Property="local:Gallery.IsSelected" Value="True">
                                    <Setter TargetName="groupDetailedBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="groupDetailedBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerDetailedBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerDetailedBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--GalleryDeterminedStyle-->
    <Style x:Key="GalleryDeterminedStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="BorderThickness" Value="{Binding Path=BorderThickness, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="CornerRadius" Value="{Binding Path=GalleryCornerRadius, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="Padding" Value="{Binding Path=Padding, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="Margin" Value="{Binding Path=Margin, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
    </Style>

    <!--Gallery  style-->
    <Style x:Key="ShinyBlueGalleryStyle" TargetType="{x:Type local:Gallery}">
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="ItemBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
        <Setter Property="ItemBorderBrush" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="ItemSelectedBackground"  Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
        <Setter Property="ItemMouseOverBackground" Value="{StaticResource HighlightBrushKey.ShinyBlue}"/>
        <Setter Property="FocusedItemBackground" Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
        <Setter Property="FocusedItemBorderBrush" Value="{StaticResource TextBrushKey.ShinyRed}"/>

        <Setter Property="FocusedItemMouseOverBackground" Value="{StaticResource HighlightBrushKey.ShinyBlue}"/>
        <Setter Property="ItemSelectedForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="ItemSelectedBorderBrush" Value="{StaticResource TextBrushKey.ShinyRed}"/>

        <Setter Property="ItemForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="ItemMouseOverForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="ItemMouseOverBorderBrush" Value="{StaticResource TextBrushKey.ShinyRed}"/>

        <Setter Property="FocusedItemMouseOverForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="FocusedItemMouseOverBorderBrush" Value="{StaticResource TextBrushKey.ShinyRed}"/>

        <Setter Property="GroupBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
        <Setter Property="GroupBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
        <Setter Property="GroupForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="PanelBackground" Value="{StaticResource PanelBackgroundBrushKey.ShinyBlue}"/>
        <Setter Property="PanelBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
        <Setter Property="GroupSelectedBackground" Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
        <Setter Property="GroupSelectedBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
        <Setter Property="PanelSelectedBackground" Value="{StaticResource PanelBackgroundBrushKey.ShinyBlue}"/>
        <Setter Property="PanelSelectedBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
        <Setter Property="GroupMouseOverBackground" Value="{StaticResource HighlightBrushKey.ShinyBlue}"/>
        <Setter Property="GroupMouseOverBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
        <Setter Property="PanelMouseOverBackground" Value="{StaticResource PanelBackgroundBrushKey.ShinyBlue}"/>
        <Setter Property="GroupMouseOverForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
        <Setter Property="GroupSelectedForeground" Value="{StaticResource TextBrushKey.ShinyRed}"/>

        <Setter Property="PanelMouseOverBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>

        <Setter Property="PanelBorderThickness" Value="1"/>
        <Setter Property="GroupMargin" Value="0"/>
        <Setter Property="GroupBorderThickness" Value="1"/>
        <Setter Property="GroupCornerRadius" Value="0"/>
        <Setter Property="GroupPadding" Value="0"/>
        <Setter Property="PanelCornerRadius" Value="0"/>
        <Setter Property="PanelPadding" Value="0"/>
        <Setter Property="FocusedItemBorderThickness" Value="1"/>
        <Setter Property="SelectedItemBorderThickness" Value="1"/>
        <Setter Property="ItemBorderThickness" Value="1"/>
        <Setter Property="ItemCornerRadius" Value="0"/>
        <Setter Property="ItemPadding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="AllowDrop" Value="{Binding Path=AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Gallery}">
                    <Border Style="{StaticResource GalleryDeterminedStyle}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:GalleryStackPanel Background="Transparent"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ShinyBlueGalleryStyle}" TargetType="{x:Type local:Gallery}"/>
    
</ResourceDictionary>