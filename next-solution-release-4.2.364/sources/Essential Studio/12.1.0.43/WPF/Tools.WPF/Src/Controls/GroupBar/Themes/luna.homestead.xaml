<ResourceDictionary 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syscoll="clr-namespace:System.Collections;assembly=mscorlib"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
	xmlns:utils="clr-namespace:Syncfusion.Windows.Tools"
	xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

	<ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/BaseStyle.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!-- GroupBar Style -->
	<Style x:Key="{x:Type local:GroupBar}" TargetType="{x:Type local:GroupBar}" BasedOn="{StaticResource GroupBarBaseStyle}">
        
    </Style>

    <Style x:Key="{x:Type local:GroupView}" BasedOn="{StaticResource GroupViewStyle}" TargetType="{x:Type local:GroupView}">
       
    </Style>





</ResourceDictionary>