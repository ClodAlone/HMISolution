    <!--styles-->

    <Style x:Key="OrangeToggleDropDownButtonStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle"
                Value="true" />
        <Setter Property="IsTabStop"
                Value="false" />
        <Setter Property="Focusable"
                Value="false" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="Chrome"
							SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ComboBoxButton" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Name="Chrome1" Grid.Column="0" Background="{StaticResource ToggleButtonChromeBrush1.Orange}">
                            </Border>
                            <Border Name="Chrome2" Margin="-1,0,0,0"
                                    Grid.Column="1" Width="40"  Grid.Row="0" Background="{StaticResource ToggleButtonChromeBrush2.Orange}">
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome2" Property="Background" Value="{StaticResource DropDownButton.Highlight.Orange}" />
                            <Setter TargetName="Chrome1" Property="Background" Value="{StaticResource TextBoxBackgroundHighlight.Orange}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SyncOrangeFontListComboBoxStyle" TargetType="{x:Type local:FontListComboBox}">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush.Orange}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush.Orange}" />
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrushKey.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FontListComboBox}">
                    <Grid Name="MainGrid"
                          SnapsToDevicePixels="true">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition MinWidth="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}"
                                              Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Popup Placement="Bottom" Grid.ColumnSpan="2"
                       Name="PART_Popup"
			           TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       Height="{Binding Path=PopupDropDownHeight, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       Focusable="False"
                       AllowsTransparency="True"
			           StaysOpen="True"
                       IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       PopupAnimation="Fade">
                            <Border BorderThickness="1.5" BorderBrush="{StaticResource ListBoxBorderBrush.Orange}" CornerRadius="2" Background="{StaticResource BackgroundBrush1.Orange}" ClipToBounds="True">
                                <DockPanel Name="FontListBoxPanel"  LastChildFill="True" Background="White"
                                   Height="{Binding ElementName=bt, Path=Offset}">
                                    <local:BottomThumb  x:Name="bt"  Height="10" DockPanel.Dock="Bottom"
                                            Offset="{Binding Path=PopupDropDownHeight, Mode=TwoWay, Converter={ StaticResource PopupHeightToThumbOffsetConverter},
                                            ConverterParameter=6,  RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}" />

                                    <ScrollViewer>
                                        <local:FontListBox x:Name="FontListBoxElement" BorderThickness="0,0,1,1" DockPanel.Dock="Top"
                                    Width="{Binding Path=Width, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedFontFamily="{Binding Path=SelectedFontFamily, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    FocusedFontFamily="{Binding Path=FocusedFontFamily, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    FontsSource="{Binding Path=FontsSource, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ThemeFonts="{Binding Path=ThemeFonts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    RecentlyUsedFonts="{Binding Path=RecentlyUsedFonts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    HasFocus="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayFontNamesInSystemFont="{Binding Path=DisplayFontNamesInSystemFont, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    GroupHeaderStyle="{Binding Path=GroupHeaderStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ItemTemplate="{Binding Path=ItemTemplate, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ItemContainerStyle="{Binding Path=ItemContainerStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
 />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                        <ToggleButton Name="toggleButton" TextBlock.Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                                      Grid.ColumnSpan="2"
                          Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                                      Style="{StaticResource OrangeToggleDropDownButtonStyle}" />

                        <ContentPresenter Name="textBox"
                                          Margin="{TemplateBinding Control.Padding}"
                                          HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                          Content="{Binding Path=SelectedFontFamily, Converter={StaticResource FontToStringConverter},
                                                    Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
 />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="{x:Static SystemColors.GrayTextBrushKey}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Panel.Background" TargetName="MainGrid" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="textBox" Property="Content" Value="{Binding Path=FocusedFontFamily, Converter={StaticResource FontToStringConverter}, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SyncOrangeFontListComboBoxStyle}" TargetType="{x:Type local:FontListComboBox}" />

    <Style x:Key="{x:Type local:BottomThumb}" TargetType="{x:Type local:BottomThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BottomThumb}">
                    <Border Name="Border" SnapsToDevicePixels="True" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  Background="{StaticResource BottomThumbBackground.Orange}"
            BorderThickness="0,1,0,0" BorderBrush="{StaticResource FontListComboBoxBorderBrush.Orange}">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Name="B1" Background="{StaticResource ArrowFill.Orange}" Width="3" Height="3" CornerRadius="5" Margin="1" />
                            <Border Name="B2" Background="{StaticResource ArrowFill.Orange}" Width="3" Height="3" CornerRadius="5" Margin="1" />
                            <Border Name="B3" Background="{StaticResource ArrowFill.Orange}" Width="3" Height="3" CornerRadius="5" Margin="1" />
                            <Border Name="B4" Background="{StaticResource ArrowFill.Orange}" Width="3" Height="3" CornerRadius="5" Margin="1" />
                        </WrapPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>