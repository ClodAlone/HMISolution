<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Office2007Silver_GroupBar_BorderBrush" Color="#FF6F7074"/>
	<LinearGradientBrush x:Key="Office2007Silver_GroupBar_HeaderBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFEBEEFA"/>
				<GradientStop Offset="0.4" Color="#FFD6DAE4"/>
				<GradientStop Offset="0.4" Color="#FFC5C7D1"/>
				<GradientStop Offset="1" Color="#FFD4D8E2"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Silver_GroupBar_Content" Color="#FFD1D3E1"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Office2007Silver_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFEBEEFA"/>
			<GradientStop Offset="0.4" Color="#FFD6DAE4"/>
			<GradientStop Offset="0.4" Color="#FFC5C7D1"/>
			<GradientStop Offset="1" Color="#FFD4D8E2"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Silver_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFD9AA"/>
			<GradientStop Offset="0.4" Color="#FFFFBB6E"/>
			<GradientStop Offset="0.4" Color="#FFFFAB3F"/>
			<GradientStop Offset="1" Color="#FFFEE17A"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Silver_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFEE4"/>
			<GradientStop Offset="0.4" Color="#FFFFE8A7"/>
			<GradientStop Offset="0.4" Color="#FFFFD767"/>
			<GradientStop Offset="1" Color="#FFFFE69E"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Silver_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFBD69"/>
			<GradientStop Offset="0.4" Color="#FFFFAC42"/>
			<GradientStop Offset="0.4" Color="#FFFB8C3C"/>
			<GradientStop Offset="1" Color="#FFFED364"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_SeparatorBrush" Color="#FF6F7074"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Office2007Silver_GroupView_Background" Color="#FFD1D3E1"/>

	<!-- GroupViewItem -->
	<Color x:Key="Office2007Silver_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Office2007Silver_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Office2007Silver_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Office2007Silver_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_BackgroundBrush" Color="#FFD1D3E1"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_BorderBrush" Color="#FFD1D3E1"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Silver_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

	<!-- Splitter -->
	<LinearGradientBrush x:Key="Office2007Silver_Splitter_BackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFA8A7BF"/>
			<GradientStop Offset="1" Color="#FF777697"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Silver_PointBrush" Color="#FF7C7C7C"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Office2007Silver_NavigationToolbar_BackgroundBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFEBEEFA"/>
				<GradientStop Offset="0.4" Color="#FFD6DAE4"/>
				<GradientStop Offset="0.4" Color="#FFC5C7D1"/>
				<GradientStop Offset="1" Color="#FFD4D8E2"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Office2007Silver_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFD9AA"/>
			<GradientStop Offset="0.4" Color="#FFFFBB6E"/>
			<GradientStop Offset="0.4" Color="#FFFFAB3F"/>
			<GradientStop Offset="1" Color="#FFFEE17A"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Silver_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFEE4"/>
			<GradientStop Offset="0.4" Color="#FFFFE8A7"/>
			<GradientStop Offset="0.4" Color="#FFFFD767"/>
			<GradientStop Offset="1" Color="#FFFFE69E"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Silver_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFBD69"/>
			<GradientStop Offset="0.4" Color="#FFFFAC42"/>
			<GradientStop Offset="0.4" Color="#FFFB8C3C"/>
			<GradientStop Offset="1" Color="#FFFED364"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Silver_NavigationToolbarItem_ArrowBrush1" Color="#FF656870"/>
	<SolidColorBrush x:Key="Office2007Silver_NavigationToolbarItem_ArrowBrush2" Color="#FFEAF2F9"/>

	<!-- MenuItem -->
	<SolidColorBrush x:Key="Office2007Silver_MenuItem_Brush" Color="#FFE9EEEE"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuItem_OverBrush" Color="#FFFFE7A2"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuItem_OverBorderBrush" Color="#FFFFBD69"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuItem_SelectedBackgroundBrush" Color="#FFFFAB3F"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuItem_SelectedOverBackgroundBrush" Color="#FFFFAB3F"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuItem_SeparatorBrush" Color="#FF9AC6FF"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="Office2007Silver_Menu_BackgroundBrush" Color="#FFF6F6F6"/>
	<SolidColorBrush x:Key="Office2007Silver_Menu_BorderBrush" Color="#FF6593CF"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="Office2007Silver_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Silver_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="Office2007Silver_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Silver_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Office2007Silver_CollapseArrowColor" Color="#656870"/>
    <SolidColorBrush x:Key="Office2007Silver_PopupBorderFillColor" Color="#C9CBD5"/>
    <SolidColorBrush x:Key="Office2007Silver_NavigationPaneColor" Color="#E5E8F4"/>
    <SolidColorBrush x:Key="Office2007Silver_NavigationPaneMouseOverColor" Color="#FFC06F"/>
    <SolidColorBrush x:Key="Office2007Silver_NavigationPaneTextColor" Color="#6F7074"/>
    <SolidColorBrush x:Key="Office2007Silver_NavigationPaneBorderColor" Color="#6F7074"/>
    <SolidColorBrush x:Key="Office2007Silver_NavigationPaneCheckedBorderColor" Color="#6F7074"/>

</ResourceDictionary>