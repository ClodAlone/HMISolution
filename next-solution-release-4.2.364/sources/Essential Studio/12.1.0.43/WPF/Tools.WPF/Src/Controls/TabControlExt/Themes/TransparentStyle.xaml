    <Style BasedOn="{StaticResource TransparentTabControlExtStyle}" TargetType="{x:Type local:TabControlExt}"/>

    <Style TargetType="{x:Type local:TabItemExt}" x:Key="TransparentTabItemExtStyle">
        <Setter Property="TextElement.Foreground" 
				Value="{StaticResource TransparentThemeForegroundBrush}"/>
