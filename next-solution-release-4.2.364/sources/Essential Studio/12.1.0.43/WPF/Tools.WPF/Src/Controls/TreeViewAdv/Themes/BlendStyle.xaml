                            </MultiTrigger.Conditions>
                            <!--<Setter Property="Fill" TargetName="path" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />-->
                            <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            <Setter Property="Fill" TargetName="PART_SelectRectangle" Value="{Binding Path=SelectionUnfocussedBackcolor, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type des:TreeViewAdv}}}" />
                        </MultiTrigger>
                        <Trigger Property="des:TreeViewItemAdv.IsDraging" Value="True">
