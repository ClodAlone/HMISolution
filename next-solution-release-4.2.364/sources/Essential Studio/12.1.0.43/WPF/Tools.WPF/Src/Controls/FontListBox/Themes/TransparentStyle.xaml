<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:conv="clr-namespace:Syncfusion.Windows.Tools"
xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Converters-->
    <conv:IsSymbolFontConverter x:Key="IsSymbolFontConverter" />
    <conv:MergeCollectionsConverter x:Key="MergeCollectionsConverter" />
    <conv:FontToRecordConverter x:Key="FontToRecordConverter" />

    <!--Brushes-->
    <SolidColorBrush x:Key="FontListBoxBackgroundBrushKey" Color="White" Opacity="0.5" />
    <SolidColorBrush x:Key="FontListBoxBorderBrush" Color="#FF000000" Opacity="0.5" />
    <SolidColorBrush x:Key="CheckListBoxItemPressedBrushKey" Color="Black" Opacity="0.295" />
    <SolidColorBrush x:Key="FontListBoxForegroundBrushKey" Color="#FF333333" />
    <SolidColorBrush x:Key="FontListBoxHighlightedForegroundBrushKey" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Office2007Blue.ItemBrush" Color="#FFFBFF" />
    <LinearGradientBrush x:Key="GroupHeaderBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.6">
        <GradientStop Color="#FFFAFAFA" Offset="0" />
        <GradientStop Color="#FFC8C8C8" Offset="0.491" />
        <GradientStop Color="#FF999999" Offset="0.531" />
        <GradientStop Color="#FFB6B6B6" Offset="0.789" />
        <GradientStop Color="#FFD5D5D5" Offset="0.996" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TransparentThemeFontListBoxHoverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#99FAFAFA" Offset="0" />
        <GradientStop Color="#99FFFFFF" Offset="0.491" />
        <GradientStop Color="#99E2E2E2" Offset="0.531" />
        <GradientStop Color="#99B6B6B6" Offset="0.789" />
        <GradientStop Color="#99D5D5D5" Offset="0.996" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentThemeFontListBoxHoverBorderBrush" Color="#7F000000" />
    <SolidColorBrush x:Key="InnerBorderBrush" Color="#CCFFFFFF" />
    <SolidColorBrush Color="#CCFFFFFF"  x:Key="TransparentfontLsitBoxItemhoverBorderBrush" />

    <!--DataTemplate for FontFamilyRecord -->
    <DataTemplate x:Key="FontFamilyRecordTemplate" DataType="{x:Type local:FontFamilyRecord}">
        <Border MinHeight="20" Name="border">
            <DockPanel ClipToBounds="True">
                <Border Name="icon"  Height="18" Width="18" Margin="1,0,1,0" Opacity="1">
                    <Border.Background>
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/FontListBox/Images/tt.png"></BitmapImage>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock Margin="2,0,2,0" Name="tb"  VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"  Text="{Binding Path=Name}" FontFamily="{Binding Path=Family}">
                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                </TextBlock>
                <TextBlock Margin="2,0,2,0"  Name="tbName" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}">
                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                </TextBlock>
                <TextBlock Margin="2,0,2,0" Name="tbPurpose" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" DockPanel.Dock="Right"
                   HorizontalAlignment="Right" Text="{Binding Path=Purpose}" Opacity="0">
                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                </TextBlock>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true">
                <Setter TargetName="tbName" Property="Text" Value="{Binding Path=Name}" />
                <Setter TargetName="tb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="tb" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="tb" Property="Text" Value="abcde123" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tb" Property="Opacity" Value="0" />
                <Setter TargetName="tb" Property="Text" Value="" />
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="false" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=DisplayFontNamesInSystemFont, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" Value="True">
                <Setter TargetName="tb" Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TouchFontFamilyRecordTemplate" DataType="{x:Type local:FontFamilyRecord}">
        <Border MinHeight="45" Name="border">
            <DockPanel ClipToBounds="True">
                <Border Name="icon"  Height="25" Width="25" Margin="1" Opacity="1">
                    <Border.Background>
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/FontListBox/Images/tt.png"></BitmapImage>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock Margin="2" Name="tb"  VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"  Text="{Binding Path=Name}" FontFamily="{Binding Path=Family}">
                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                </TextBlock>
                <TextBlock Margin="2"  Name="tbName" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}">
                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                </TextBlock>
                <TextBlock Margin="2" Name="tbPurpose" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" DockPanel.Dock="Right"
                   HorizontalAlignment="Right" Text="{Binding Path=Purpose}" Opacity="0">
                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                </TextBlock>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true">
                <Setter TargetName="tbName" Property="Text" Value="{Binding Path=Name}" />
                <Setter TargetName="tb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="tb" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="tb" Property="Text" Value="abcde123" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tb" Property="Opacity" Value="0" />
                <Setter TargetName="tb" Property="Text" Value="" />
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="false" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=DisplayFontNamesInSystemFont, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" Value="True">
                <Setter TargetName="tb" Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--FontListBox template-->
    <Style x:Key="TransparentFontListBoxStyle" TargetType="{x:Type local:FontListBox}">
        <Setter Property="Background" Value="{StaticResource FontListBoxBackgroundBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource FontListBoxForegroundBrushKey}" />
        <Setter Property="BorderBrush" Value="{StaticResource FontListBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:FontListBox}">
                    <Border Name="Border"
				Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}"
				BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"
>
                        <Border x:Name="InnerBorder" BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <local:FontListBoxInternal>
                                <local:FontListBoxInternal.ItemsSource>
                                    <MultiBinding Converter="{StaticResource MergeCollectionsConverter}">
                                        <Binding Path="ThemeFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                        <Binding Path="RecentlyUsedFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                        <Binding Path="AllFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                    </MultiBinding>
                                </local:FontListBoxInternal.ItemsSource>

                                <local:FontListBoxInternal.SelectedItem>
                                    <Binding Path="SelectedFontFamily" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Converter="{StaticResource FontToRecordConverter}" Mode="TwoWay" />
                                </local:FontListBoxInternal.SelectedItem>

                                <local:FontListBoxInternal.FocusedItem>
                                    <Binding Path="FocusedFontFamily" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Converter="{StaticResource FontToRecordConverter}" Mode="TwoWay" />
                                </local:FontListBoxInternal.FocusedItem>

                                <local:FontListBoxInternal.HasFocus>
                                    <Binding Path="HasFocus" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                                </local:FontListBoxInternal.HasFocus>

                                <local:FontListBoxInternal.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:InternalPanel Margin="-1,0,-1,0" x:Name="iternalPanel" GroupHeaderStyle="{Binding Path=GroupHeaderStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
																 Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </ItemsPanelTemplate>
                                </local:FontListBoxInternal.ItemsPanel>

                                <local:FontListBoxInternal.ItemTemplate>
                                    <Binding Path="ItemTemplate" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                                </local:FontListBoxInternal.ItemTemplate>

                                <local:FontListBoxInternal.ItemContainerStyle>
                                    <Binding Path="ItemContainerStyle" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                                </local:FontListBoxInternal.ItemContainerStyle>
                            </local:FontListBoxInternal>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="FontSize" Value="18" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentFontListBoxStyle}" TargetType="{x:Type local:FontListBox}" />

    <Style TargetType="{x:Type local:FontListBoxInternalItem}">
        <Setter Property="Background" Value="{StaticResource Office2007Blue.ItemBrush}" />
        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="ContentTemplate" Value="{StaticResource FontFamilyRecordTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:FontListBoxInternalItem}">
                    <Grid>
                        <Border Name="Border" TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                Background="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"
                BorderBrush="Transparent"
                Margin="0"
>
                            <Border BorderThickness="1" x:Name="innerborder">
                                <ContentPresenter MinWidth="0" ContentSource="Content"
					          ContentTemplate="{TemplateBinding ContentTemplate}" TextBlock.FontSize="{TemplateBinding FontSize}"
				              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Border>
                        <Rectangle x:Name="BottomBorder" Fill="{StaticResource FontListBoxBorderBrush}" Height="1" Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter TargetName="Border" Property="CornerRadius" Value="0" />
                            <Setter TargetName="Border" Property="Margin" Value="0,-1,0,0" />
                            <Setter TargetName="BottomBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasFocus" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource TransparentThemeFontListBoxHoverBrush}" />
                            <Setter TargetName="Border" Property="Opacity" Value="1" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource TransparentThemeFontListBoxHoverBorderBrush}" />
                            <Setter TargetName="innerborder" Property="BorderBrush" Value="{StaticResource TransparentfontLsitBoxItemhoverBorderBrush}" />
                            <Setter TargetName="BottomBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Margin" Value="0" />
                <Setter Property="ContentTemplate" Value="{StaticResource TouchFontFamilyRecordTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:GroupHeader}">
        <Setter Property="Background" Value="{StaticResource GroupHeaderBackground}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:GroupHeader}">
                    <Border Name="Border" Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            Background="{TemplateBinding Background}"
            BorderThickness="0,0,0,1"
            BorderBrush="{StaticResource FontListBoxBorderBrush}">
                        <Border x:Name="InnerBorder" BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1,0,1,1">
                            <TextBlock Text="{TemplateBinding Text}"
                       FontSize="{TemplateBinding FontSize}"
                       FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}"
                       FontStyle="{TemplateBinding FontStyle}"
                       VerticalAlignment="{TemplateBinding VerticalAlignment}"
                       HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                       FlowDirection="{TemplateBinding FlowDirection}"
                       FontWeight="{TemplateBinding FontWeight}">
                                 <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35" />
                                        </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="20" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>