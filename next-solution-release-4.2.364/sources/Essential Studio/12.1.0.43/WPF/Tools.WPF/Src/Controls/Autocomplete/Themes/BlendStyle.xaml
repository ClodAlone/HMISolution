<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"  xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
	                >

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!--#Brushes-->
    <SolidColorBrush x:Key="TextboxMouseOverBorderBrush" Color="#FF707070" />
    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />
    <SolidColorBrush x:Key="Blend.Background" Color="#FF333333" />
    <SolidColorBrush x:Key="Black" Color="Black" />
    <SolidColorBrush x:Key="White" Color="White" />
    <SolidColorBrush x:Key="Blend.BorderBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="Blend.DropDownButton.HighlightBackground" Color="#ADAAAD" />
    <SolidColorBrush x:Key="Blend.DropDownButton.Background" Color="#848284" />
    <SolidColorBrush x:Key="Blend.Foreground" Color="#FFFFFFFF" />

    <Style x:Key="BlendToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Blend.DropDownButton.Background}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}"
                                CornerRadius="3">
                        <ContentPresenter RecognizesAccessKey="True"
                              Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ClipToBounds="True" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Blend.DropDownButton.HighlightBackground}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Blend.DropDownButton.HighlightBackground}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Blend.DropDownButton.Background}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Blend.DropDownButton.HighlightBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <Style x:Key="BlendThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFAAAAAA"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FF3A3A3A"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlendAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource Blend.Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Blend.Foreground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                		CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}" TextBlock.Foreground="{StaticResource Blend.Foreground}">
                        <Grid Name="ContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>
                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <Border Name="PART_Cursor" Width="2" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left"
							Background="White" Height="16" />
                            <TextBox Name="PART_EditableTextBox" Grid.Column="0" Margin="0" VerticalAlignment="Center" Padding="{TemplateBinding Padding}"
								  	 Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0"
									 FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontStretch="{TemplateBinding FontStretch}"
								     FontStyle="{TemplateBinding FontStyle}" FontWeight="{TemplateBinding FontWeight}" Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1" SnapsToDevicePixels="True" Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
								     IsChecked="False" Style="{StaticResource BlendToggleDropDownButtonStyle}">
                                <Path Name="PART_Arrow" Data="M0,1 L3,4 6,1" Stroke="{StaticResource White}" StrokeThickness="2" Fill="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   					IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               					VerticalOffset="-2" HorizontalOffset="1" SnapsToDevicePixels="True" AllowsTransparency="True" Focusable="True" PopupAnimation="Slide">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw">
                                    <Border BorderThickness="1" BorderBrush="#FF595959">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_Container" KeyboardNavigation.DirectionalNavigation="Cycle" SelectionMode="{TemplateBinding SelectionMode}" IsSynchronizedWithCurrentItem="True" BorderThickness="0"
												SnapsToDevicePixels="True" Width="{Binding Path=ActualWidth, ElementName=ContentGrid}" MaxHeight="{TemplateBinding MaxDropHeight}" Focusable="True" Grid.Row="0" />
                                            <Border Background="#FF595959" BorderBrush="Black" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">

                                                <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource BlendThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                            <Popup Name="HistoryPopup" SnapsToDevicePixels="True" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
								AllowsTransparency="True" Focusable="True" PopupAnimation="Slide" IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw1">
                                    <Border BorderThickness="1" BorderBrush="#FF595959">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_HistoryContainer" KeyboardNavigation.DirectionalNavigation="Cycle" SelectionMode="{TemplateBinding SelectionMode}" IsSynchronizedWithCurrentItem="True" SnapsToDevicePixels="True" BorderThickness="0"
									Height="{TemplateBinding HistoryListHeight}" Width="{TemplateBinding ActualWidth}" Focusable="True" Grid.Row="0" />
                                            <Border Background="#FF595959" BorderBrush="Black" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Thumb x:Name="HistoryThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource BlendThumbStyle}" Grid.Row="1" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Blend.Background}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Blend.BorderBrush}" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Blend.Background}" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw" Value="Black" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="HistoryPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw1" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw1" Value="Black" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>