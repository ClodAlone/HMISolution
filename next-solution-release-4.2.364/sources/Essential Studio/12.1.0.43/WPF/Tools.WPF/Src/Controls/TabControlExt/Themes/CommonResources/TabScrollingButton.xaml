    <Style x:Key="VS2010TabScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <shared:Border3D x:Name="PART_Border" VerticalAlignment="Center" HorizontalAlignment="Center"
				Margin="1,0,0,0"
                Padding="1"
                Width="15"
                Height="15"
                BorderThickness="1"
                BorderBrush="{StaticResource ButtonInactiveBorderBrush}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0">
                        <Canvas Width="8" Height="7">
                            <Path Data="M0,0L4,3.5 0,7" HorizontalAlignment="Center" Stroke="{StaticResource ButtonInactivePathBrush}" Fill="{StaticResource ButtonInactivePathBrush}" Name="PART_Path1" VerticalAlignment="Center"/>
                            <Path Data="M4,0L8,3.5 4,7" HorizontalAlignment="Center" Stroke="{StaticResource ButtonInactivePathBrush}" Fill="{StaticResource ButtonInactivePathBrush}" Name="PART_Path2" VerticalAlignment="Center"/>
                            <Path Data="M5,0L5,7" HorizontalAlignment="Center" Stroke="{StaticResource ButtonInactivePathBrush}" Fill="{StaticResource ButtonInactivePathBrush}" Name="PART_Path3" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Canvas>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="LastTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="FirstTab">
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,7"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="PrevPage">
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="PrevTab">
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="NextTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource ButtonBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="#FFFBE695"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource  ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource  ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource ButtonActivePathBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
