<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:conv="clr-namespace:Syncfusion.Windows.Tools" xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <conv:IsSymbolFontConverter x:Key="IsSymbolFontConverter" />
    <conv:MergeCollectionsConverter x:Key="MergeCollectionsConverter" />
    <conv:FontToRecordConverter x:Key="FontToRecordConverter" />

    <!-- Brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Office2003.BackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Office2003.ItemForegroundBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="Office2003.ItemMouseOverForegroundBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="Office2003.ItemBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Office2003.HeaderBrush" Color="#FFEBF4FF" />
    <!--<SolidColorBrush x:Key="Office2003.ItemMouseOverBrush" Color="#FFFDE6BC" />-->
    <LinearGradientBrush x:Key="Office2003.ItemMouseOverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#FFFFFFDC" />
            <GradientStop Offset="1" Color="#FFF7C05B" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <Thickness x:Key="Office2003.ItemMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <SolidColorBrush x:Key="Office2003.ItemBorderBrush" Color="#FFFDE6BC" />
    <Thickness x:Key="Office2003.HeaderBorderThickness" Left="0" Top="0" Right="0" Bottom="1" />
    <SolidColorBrush x:Key="Office2003.HeaderBorderBrush" Color="#FFBCD2EB" />

    <CornerRadius x:Key="BorderCornerRadius.Default">0</CornerRadius>

    <!--DataTemplate for FontFamilyRecord -->
    <DataTemplate x:Key="FontFamilyRecordTemplate" DataType="{x:Type local:FontFamilyRecord}">
        <Border Height="28" Name="border">
            <DockPanel ClipToBounds="True">
                <Border Name="icon"  Height="25" Width="25" Margin="1" Opacity="1">
                    <Border.Background>
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/FontListBox/Images/tt.png"></BitmapImage>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock Margin="2"  Name="tb"  VerticalAlignment="Center" FontSize="16"  Text="{Binding Path=Name}" FontFamily="{Binding Path=Family}" />
                <TextBlock Margin="2"  Name="tbName" VerticalAlignment="Center" FontSize="16" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
                <TextBlock Margin="2" Name="tbPurpose" VerticalAlignment="Center" FontSize="12" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" DockPanel.Dock="Right"
                   HorizontalAlignment="Right" Text="{Binding Path=Purpose}" Opacity="0" />
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true">
                <Setter TargetName="tbName" Property="Text" Value="{Binding Path=Name}" />
                <Setter TargetName="tb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="tb" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="tb" Property="Text" Value="abcde123" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tb" Property="Opacity" Value="0" />
                <Setter TargetName="tb" Property="Text" Value="" />
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="false" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=DisplayFontNamesInSystemFont, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" Value="True">
                <Setter TargetName="tb" Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--FontListBox template-->
    <Style x:Key="Office2003FontListBoxStyle" TargetType="{x:Type local:FontListBox}">
        <Setter Property="Background" Value="{StaticResource Office2003.BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Office2003.ItemForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:FontListBox}">
                    <Border Name="Border"
				Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}"
				BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                BorderThickness="{TemplateBinding BorderThickness}"
>
                        <local:FontListBoxInternal>
                            <local:FontListBoxInternal.ItemsSource>
                                <MultiBinding Converter="{StaticResource MergeCollectionsConverter}">
                                    <Binding Path="ThemeFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                    <Binding Path="RecentlyUsedFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                    <Binding Path="AllFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                </MultiBinding>
                            </local:FontListBoxInternal.ItemsSource>

                            <local:FontListBoxInternal.SelectedItem>
                                <Binding Path="SelectedFontFamily" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Converter="{StaticResource FontToRecordConverter}" Mode="TwoWay" />
                            </local:FontListBoxInternal.SelectedItem>

                            <local:FontListBoxInternal.FocusedItem>
                                <Binding Path="FocusedFontFamily" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Converter="{StaticResource FontToRecordConverter}" Mode="TwoWay" />
                            </local:FontListBoxInternal.FocusedItem>

                            <local:FontListBoxInternal.HasFocus>
                                <Binding Path="HasFocus" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                            </local:FontListBoxInternal.HasFocus>

                            <local:FontListBoxInternal.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:InternalPanel x:Name="iternalPanel" GroupHeaderStyle="{Binding Path=GroupHeaderStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
																 Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                </ItemsPanelTemplate>
                            </local:FontListBoxInternal.ItemsPanel>

                            <local:FontListBoxInternal.ItemTemplate>
                                <Binding Path="ItemTemplate" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                            </local:FontListBoxInternal.ItemTemplate>

                            <local:FontListBoxInternal.ItemContainerStyle>
                                <Binding Path="ItemContainerStyle" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                            </local:FontListBoxInternal.ItemContainerStyle>
                        </local:FontListBoxInternal>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2003FontListBoxStyle}" TargetType="{x:Type local:FontListBox}" />

    <Style TargetType="{x:Type local:FontListBoxInternalItem}">
        <Setter Property="Background" Value="{StaticResource Office2003.ItemBrush}" />
        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ContentTemplate" Value="{StaticResource FontFamilyRecordTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:FontListBoxInternalItem}">
                    <Border Name="Border" TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource BorderCornerRadius.Default}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Margin="{StaticResource Office2003.ItemMargin}"
>
                        <ContentPresenter MinWidth="0" ContentSource="Content"
					          ContentTemplate="{TemplateBinding ContentTemplate}"
				              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="HasFocus" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Office2003.ItemMouseOverBrush}" />
                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="{StaticResource Office2003.ItemMouseOverForegroundBrush}" />
                            <Setter TargetName="Border" Property="Opacity" Value="1" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Office2003.ItemBorderBrush}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:GroupHeader}">
        <Setter Property="Background" Value="{StaticResource Office2003.HeaderBrush}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:GroupHeader}">
                    <Border Name="Border" Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            Background="{TemplateBinding Background}"
            BorderThickness="{StaticResource Office2003.HeaderBorderThickness}"
            BorderBrush="{StaticResource Office2003.HeaderBorderBrush}">
                        <TextBlock Text="{TemplateBinding Text}"
                       FontSize="{TemplateBinding FontSize}"
                       FontFamily="{TemplateBinding FontFamily}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                       FontStyle="{TemplateBinding FontStyle}"
                       VerticalAlignment="{TemplateBinding VerticalAlignment}"
                       HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                       FlowDirection="{TemplateBinding FlowDirection}"
                       FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>