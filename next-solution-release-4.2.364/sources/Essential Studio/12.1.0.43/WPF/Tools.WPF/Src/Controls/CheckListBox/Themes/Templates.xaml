                <Setter TargetName="firstColumn" Property="Width"
                                    Value="*"/>
                <Setter TargetName="secondColumn" Property="Width"
                                    Value="Auto"/>
                <Setter TargetName="PART_CheckBox" Property="Margin"
                                    Value="5,1,1,1"/>
            </DataTrigger>


            <Trigger Property="IsFocused"
                                 Value="true">

                <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush.Blue}"/>
                <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource SelectedBorderBrush.Blue}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource SelectedForeground.Blue}"/>
                <Setter TargetName="Bd" Property="CornerRadius" Value="2"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="IsFocused" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush.Black}"/>
                <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource SelectedBorderBrush.Black}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource SelectedForeground.Black}"/>
                <Setter TargetName="Bd" Property="CornerRadius" Value="2"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="IsFocused" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush.Silver}"/>
                <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource SelectedBorderBrush.Silver}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource SelectedForeground.Silver}"/>
                <Setter TargetName="Bd" Property="CornerRadius" Value="2"/>
            </MultiTrigger>
            <Trigger Property="IsMouseOver"
                                 Value="true">
                <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource CheckListBoxItemHoverBrush.Blue}"/>
                <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource CheckListBoxItemHoverBorder.Blue}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource CheckListBoxItemHoverForeground.Blue}"/>
                <Setter TargetName="Bd" Property="CornerRadius" Value="2"/>

            </Trigger>

            <Trigger Property="IsEnabled"
                                 Value="false">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

