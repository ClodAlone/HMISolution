<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupBar_BorderBrush" Color="#FFACA899"/>
	<LinearGradientBrush x:Key="VisualStudio2005Homestead_GroupBar_HeaderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFB6C392"/>
				<GradientStop Offset="1" Color="#FF91A075"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupBar_Content" Color="#FFE6E3D3"/>

	<!--GroupBarItem-->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupBarItem_NormalStateBrush" Color="#FFDEE3CE"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupBarItem_BorderBrush" Color="#FFDEE3CE"/>
	
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupBarItem_SelectedBrush" Color="#FFC2CF9E"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupBarItem_SelectedBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_SeparatorBrush" Color="#FFD3DABD"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupView_Background" Color="#FFE9E7D8"/>

	<!-- GroupViewItem -->
	<Color x:Key="VisualStudio2005Homestead_GroupViewItem_OverBackgroundColor">#FFB6C68D</Color>
	<Color x:Key="VisualStudio2005Homestead_GroupViewItem_PressedBackgroundColor">#FFC2CF9E</Color>
	<Color x:Key="VisualStudio2005Homestead_GroupViewItem_SelectedBackgroundColor">#FFC2CF9E</Color>
	<Color x:Key="VisualStudio2005Homestead_GroupViewItem_SelectedOverBackgroundColor">#FF93A070</Color>

	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_BackgroundBrush" Color="#FFE9E7D8"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_BorderBrush" Color="#FFE9E7D8"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_OverBackgroundBrush" Color="#FFB6C68D"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_OverBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_PressedBackgroundBrush" Color="#FFC2CF9E"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_PressedBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_SelectedBackgroundBrush" Color="#FFC2CF9E"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_SelectedBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_GroupViewItem_SelectedOverBackgroundBrush" Color="#FF93A070"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="VisualStudio2005Homestead_NavigationToolbar_BackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFB6C392"/>
				<GradientStop Offset="1" Color="#FF91A075"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_OverBrush" Color="#FFB6C68D"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_OverBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_PressedBackgroundBrush" Color="#FFC2CF9E"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_PressedBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_SelectedBackgroundBrush" Color="#FFC2CF9E"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_SelectedBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_NavigationToolbarItem_SelectedOverBackgroundBrush" Color="#FF93A070"/>
	
	<!-- MenuItem -->
	<LinearGradientBrush x:Key="VisualStudio2005Homestead_MenuItem_Brush"
						 EndPoint="1,0"
						 StartPoint="0,0">
		<GradientStop Color="#FFC9C498" Offset="1"/>
		<GradientStop Color="#FFFCFBF8" Offset="0"/>
		<GradientStop Color="#FFD1CCB7" Offset="0.875"/>
	</LinearGradientBrush>

	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuItem_OverBrush" Color="#FFB6C68D"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuItem_OverBorderBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuItem_SelectedBackgroundBrush" Color="#FFC2CF9E"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuItem_SelectedOverBackgroundBrush" Color="#FF93A070"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuItem_SeparatorBrush" Color="#FF93A070"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_Menu_BackgroundBrush" Color="#FFE9E7D8"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_Menu_BorderBrush" Color="#FFACA899"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="VisualStudio2005Homestead_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Homestead_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Luna.Homestead_CollapseArrowColor" Color="Black"/>
    <SolidColorBrush x:Key="Luna.Homestead_PopupBorderFillColor" Color="#B3C090"/>
    <SolidColorBrush x:Key="Luna.Homestead_NavigationPaneColor" Color="#E6E3D3"/>
    <SolidColorBrush x:Key="Luna.Homestead_NavigationPaneMouseOverColor" Color="#C2CF9E"/>
    <SolidColorBrush x:Key="Luna.Homestead_NavigationPaneTextColor" Color="Black"/>
    <SolidColorBrush x:Key="Luna.Homestead_NavigationPaneBorderColor" Color="#ACA899"/>
    <SolidColorBrush x:Key="Luna.Homestead_NavigationPaneCheckedBorderColor" Color="#93A070"/>

</ResourceDictionary>