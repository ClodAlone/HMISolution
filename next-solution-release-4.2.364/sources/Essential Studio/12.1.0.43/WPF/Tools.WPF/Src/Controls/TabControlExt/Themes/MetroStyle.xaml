                                                        Grid.IsSharedSizeScope="true">
                                            <Grid Margin="0,0,0,0" Grid.IsSharedSizeScope="true">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="24"
