<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syscoll="clr-namespace:System.Collections;assembly=mscorlib"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
	xmlns:utils="clr-namespace:Syncfusion.Windows.Tools"
	xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">
	
	<ResourceDictionary.MergedDictionaries >
		 <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/blend.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/office2003.normal.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/office2007.black.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/office2007.blue.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/office2007.silver.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/ShinyBlue.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/ShinyRed.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/syncorange.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/visualstudio2005.resources.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/visualstudio2005.metallic.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/visualstudio2005.homestead.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/office2003.metallic.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/office2003.homestead.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/visualstudio2005.resources.xaml"/>		
		
		
	</ResourceDictionary.MergedDictionaries>
	
	
	
	
    <!-- Collapse button Template -->
    <ControlTemplate x:Key="CollapseButtonTemplateKey" TargetType="{x:Type ToggleButton}">
        <Border x:Name="PART_Border" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Width="16"
                Height="15"
                Padding="0,1,0,0"
                Background="Transparent"
                SnapsToDevicePixels="True"
                ToolTip="{Binding Path=CollapseButtonToolTip, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}">
            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="7" SnapsToDevicePixels="False">
                <Path Data="M 3, 0 L 0, 3 3, 6" HorizontalAlignment="Center" Stroke="{StaticResource Office2007Blue_CollapseArrowColor}" Name="PART_Path1" VerticalAlignment="Center"/>
                <Path Data="M 7, 0 L 4, 3 7, 6" HorizontalAlignment="Center" Stroke="{StaticResource Office2007Blue_CollapseArrowColor}" Name="PART_Path2" VerticalAlignment="Center"/>
            </Canvas>
        </Border>
        <ControlTemplate.Triggers>

            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource Blend_CollapseArrowColor}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource Blend_CollapseArrowColor}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource Office2003_CollapseArrowColor}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource Office2003_CollapseArrowColor}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource Office2007Blue_CollapseArrowColor}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource Office2007Blue_CollapseArrowColor}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource Office2007Silver_CollapseArrowColor}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource Office2007Silver_CollapseArrowColor}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource Office2007Black_CollapseArrowColor}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource Office2007Black_CollapseArrowColor}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource Orange_CollapseArrowColor}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource Orange_CollapseArrowColor}"/>
            </Trigger>            
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource GlyphBrushKey.ShinyRed}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource GlyphBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter TargetName="PART_Path1" Property="Stroke" Value="{StaticResource GlyphBrushKey.ShinyBlue}"/>
                <Setter TargetName="PART_Path2" Property="Stroke" Value="{StaticResource GlyphBrushKey.ShinyBlue}"/>
            </Trigger>

            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="PART_Path1" Property="Data" Value="M 1, 0 L 4, 3 1, 6"/>
                <Setter TargetName="PART_Path2" Property="Data" Value="M 5, 0 L 8, 3 5, 6"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="False">
                <Setter TargetName="PART_Border"
                        Property="Background" 
                        Value="{Binding Path=CollapseButtonBackground, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Border"
                        Property="Background" 
                        Value="{Binding Path=CollapseButtonMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=(local:GroupBar.IsCollapsed), RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
					                             Value="True">
                <Setter TargetName="PART_Border" Property="ToolTip" Value="{Binding Path=ExpandButtonToolTip, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


</ResourceDictionary>