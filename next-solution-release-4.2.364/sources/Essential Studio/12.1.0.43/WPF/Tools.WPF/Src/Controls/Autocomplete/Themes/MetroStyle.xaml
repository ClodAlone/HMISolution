<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"    
                    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
	                xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />

    <Style x:Key="MetroToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}" Margin="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,0,0">
                        <ContentPresenter RecognizesAccessKey="True"
                              Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ClipToBounds="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <Style x:Key="MetroThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Height="3"   Width="1" Grid.Column="1" Grid.Row="1" Margin="1">
                            <Rectangle Fill="#FF939598" />
                            <Rectangle Fill="#FF939598" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <SkewTransform />
                                        <RotateTransform Angle="90" />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <Grid Height="3"   Width="1" Grid.Column="0" Grid.Row="1" Margin="1,1,2,1">
                            <Rectangle Fill="#FF939598" />
                            <Rectangle Fill="#FF939598" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <SkewTransform />
                                        <RotateTransform Angle="90" />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Height="3"   Width="1" Grid.Column="1" Grid.Row="0"  Margin="1,1,1,0">
                            <Rectangle Fill="#FF939598" />
                            <Rectangle Fill="#FF939598" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <SkewTransform />
                                        <RotateTransform Angle="90" />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{TemplateBinding Foreground}">
                        <Grid Name="ContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>

                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0"
                 Margin="0"
				 VerticalAlignment="Center"
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}"
                 BorderThickness="0"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
                 Padding="{TemplateBinding Padding}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />

                            <ToggleButton Name="PART_CheckButton" Grid.Column="1" SnapsToDevicePixels="True"  Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"  IsChecked="False"  Style="{StaticResource MetroToggleDropDownButtonStyle}">
                                <Path Name="PART_Arrow"    Data="M0,0 L3.5,4 7,0" Fill="{DynamicResource MetroForegroundBrush}"   VerticalAlignment="Center"  HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}" IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"  VerticalOffset="-2" HorizontalOffset="1" SnapsToDevicePixels="True" AllowsTransparency="True"  Focusable="True"  PopupAnimation="Slide">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  Opacity="1"  x:Name="Shdw" Color="#FFDDDEE1">

                                    <Border BorderThickness="1" BorderBrush="{DynamicResource MetroBorderBrush}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_Container"  KeyboardNavigation.DirectionalNavigation="Cycle" SelectionMode="{TemplateBinding SelectionMode}" IsSynchronizedWithCurrentItem="True" SnapsToDevicePixels="True" Width="{Binding Path=ActualWidth, ElementName=ContentGrid}" MaxHeight="{TemplateBinding MaxDropHeight}" Focusable="True" Grid.Row="0" BorderThickness="0">
                                            </ListBox>
                                            <Thumb x:Name="ContainerThumb" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource MetroThumbStyle}" Grid.Row="1" />
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                            <Popup Name="HistoryPopup" SnapsToDevicePixels="True" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"  AllowsTransparency="True" Focusable="True" PopupAnimation="Slide"  IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  Opacity="1"  x:Name="Shdw1" Color="#FFDDDEE1">
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource MetroBorderBrush}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_HistoryContainer" KeyboardNavigation.DirectionalNavigation="Cycle" SelectionMode="{TemplateBinding SelectionMode}" IsSynchronizedWithCurrentItem="True" SnapsToDevicePixels="True" Height="{TemplateBinding HistoryListHeight}"  Width="{TemplateBinding ActualWidth}" Focusable="True" Grid.Row="0" BorderThickness="0">
                                            </ListBox>
                                            <Thumb x:Name="HistoryThumb" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource MetroThumbStyle}" Grid.Row="1" />
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource MetroHoverBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_CheckButton">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{DynamicResource MetroHoverBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderThickness" Value="1,0,0,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver"  Value="True" SourceName="PART_CheckButton" />
                                <Condition Property="IsChecked"  Value="True" SourceName="PART_CheckButton" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MainBorder" Property="Background" Value="White" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderThickness" Value="1,0,0,0" />
                        </MultiTrigger>
                        <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw" Value="#FFA5AFB9" />
                            <Setter Property="Opacity" TargetName="Shdw" Value="1" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="HistoryPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw1" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw1" Value="#FFA5AFB9" />
                            <Setter Property="Opacity" TargetName="Shdw1" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_CheckButton" Property="IsChecked" Value="True">
                            <Setter Property="Background" TargetName="PART_CheckButton" Value="{DynamicResource MetroBrush}" />
                            <Setter Property="BorderBrush" TargetName="PART_CheckButton" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter Property="BorderThickness" TargetName="PART_CheckButton" Value="1,0,0,0" />
                            <Setter Property="Fill" TargetName="PART_Arrow" Value="{DynamicResource MetroHighlightedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource MetroAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>