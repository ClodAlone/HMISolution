<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" 
                    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <LinearGradientBrush x:Key="Office2007.Blue.MouseOverBorderBrush" StartPoint="0,0" EndPoint="0,20" MappingMode="Absolute">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="0.05" />
            <GradientStop Color="#FFFFE69E" Offset="0.07" />
            <GradientStop Color="#FFFFE69E" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />
    <SolidColorBrush x:Key="Office2007.Blue.Background" Color="#FFEAF2FB" />
    <Thickness x:Key="XP.Margin" >1</Thickness>
    <Thickness x:Key="Vista.Margin">0</Thickness>
    <SolidColorBrush x:Key="White" Color="White" />
    <SolidColorBrush x:Key="Office2007Blue.ButtonArrowFill" Color="Black" />
    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />
    <SolidColorBrush x:Key="Office2007.Blue.BorderBrush" Color="#FFABC1DE" />
    <SolidColorBrush x:Key="Default.Foreground" Color="Black" />
    <LinearGradientBrush x:Key="Office2007.HighlightBackground" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1" />
            <GradientStop Color="#FFFFE8A7" Offset="0.4" />
            <GradientStop Color="#FFFFD767" Offset="0.4" />
            <GradientStop Color="#FFFFFCDE" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Black" Color="Black" />
    <SolidColorBrush x:Key="Office2007.HighlightBorderBrush" Color="#FFFB8C3C" />

    <LinearGradientBrush x:Key="Office2007.PressedBackground" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFF3B277" Offset="0" />
        <GradientStop Color="#FFF4B378" Offset="0.4" />
        <GradientStop Color="#FFF4A770" Offset="0.4" />
        <GradientStop Color="#FFF37E24" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Default.FocusedBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Default.PressedBackground" Color="#FFFFFFFF" />
    <Style x:Key="OfficeToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Office2007.Blue.Background}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}" BorderThickness="1,0,0,0" BorderBrush="Transparent">
                        <Path Name="PART_Arrow"
                Data="M0,0 L3,4 6,0"

                Fill="{StaticResource Office2007Blue.ButtonArrowFill}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2007.Blue.MouseOverBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2007.HighlightBackground}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2007.PressedBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2007.HighlightBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <SolidColorBrush x:Key="Office2007BlueAutoCompleteThumbFillcolor" Color="#FFBCC6D1" />
    <Style x:Key="Office2007BlueThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{StaticResource Office2007BlueAutoCompleteThumbFillcolor}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFF7FFFF"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FFBCC6D1"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2007BlueAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource Office2007.Blue.Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2007.Blue.BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Default.Foreground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{StaticResource Default.Foreground}">
                        <Grid Name="ContentGrid"
>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>

                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <TextBox Name="PART_EditableTextBox" Style="{x:Null}"
                 Grid.Column="0"
                 Margin="0"
				 VerticalAlignment="Center"
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}"
                 BorderThickness="0"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
                 Padding="{TemplateBinding Padding}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1"
                              SnapsToDevicePixels="True"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource OfficeToggleDropDownButtonStyle}"
>
                               
                                <Path Name="PART_Arrow"
                Data="M0,0 L3,4 6,0"

                Fill="{StaticResource Office2007Blue.ButtonArrowFill}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               VerticalOffset="-2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw">
                                    <Border SnapsToDevicePixels="True" BorderThickness="1"  BorderBrush="#FFA7ABB0" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_Container"   KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True" BorderThickness="0"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}"
                   Focusable="True">
                                            </ListBox>
                                            <Border BorderBrush="#FFDDE7EE" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFECF5FD" Offset="0.185" />
                                                        <GradientStop Color="#FFDDEBF9" Offset="0.798" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Office2007BlueThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                            <Popup Name="HistoryPopup"
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw1">
                                    <Border SnapsToDevicePixels="True" BorderThickness="1"  BorderBrush="#FFA7ABB0" Background="White">
                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_HistoryContainer"  Grid.Row="0"   KeyboardNavigation.DirectionalNavigation="Cycle"
                              SelectionMode="{TemplateBinding SelectionMode}"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"  BorderThickness="0"
			       Height="{TemplateBinding HistoryListHeight}"
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
>
                                            </ListBox>
                                            <Border BorderBrush="#FFDDE7EE" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFECF5FD" Offset="0.185" />
                                                        <GradientStop Color="#FFDDEBF9" Offset="0.798" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="HistoryThumb" Margin="0,0,2,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Office2007BlueThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Office2007.Blue.MouseOverBorderBrush}" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.FocusedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Default.FocusedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{StaticResource Office2007.Blue.MouseOverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Office2007.HighlightBorderBrush}" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.PressedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Default.PressedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{StaticResource Office2007.HighlightBorderBrush}" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw" Value="#FFA5AFB9" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="HistoryPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw1" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw1" Value="#FFA5AFB9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2007BlueAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>