    <!-- Custom Template for Horizontal Thumb-->

    <ControlTemplate x:Key="ThumbTemplateKey" TargetType="Thumb">
        <Grid>
            <Path Stretch="Fill" x:Name="paththumb" Stroke="{StaticResource HorizontalThumbBorderBrush}" StrokeThickness="1"  Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z" Fill="{StaticResource RepeatButtonLeft}">
            </Path>
            <Path Stretch="Fill" x:Name="paththumb1" Stroke="Transparent" StrokeThickness="1"  Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z" Fill="{StaticResource RepeatButtonLeft1}">
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumb" Property="Stroke" Value="#FFF1D03A" />
                <Setter TargetName="paththumb1" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#FFF6E6A2" />
                            <GradientStop Color="#FFFAF5D5" Offset="1" />
                            <GradientStop Color="#FFF6E397" Offset="0.5" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="paththumb" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Silver" Offset="0" />
                            <GradientStop Color="#FF585858" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="true">
                <Setter TargetName="paththumb" Property="Stroke" Value="#FFF1D03A" />
                <Setter TargetName="paththumb1" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#FFF6E6A2" />
                            <GradientStop Color="#FFFAF5D5" Offset="1" />
                            <GradientStop Color="#FFF6E397" Offset="0.5" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="paththumb" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Silver" Offset="0" />
                            <GradientStop Color="#FF585858" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

