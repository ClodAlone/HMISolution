    <!--AutoComplete template-->

    <ControlTemplate  x:Key="HistoryAutoCompleteTemplate" TargetType="{x:Type local:AutoComplete}">
        <Border  BorderBrush="{TemplateBinding BorderBrush}" 
                Background="{TemplateBinding Background}"                             
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{TemplateBinding Foreground}"
                >
            
            <Grid  
            Focusable="False">
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <!--<ColumnDefinition Width="1*" MinWidth="13"/>-->
                </Grid.ColumnDefinitions>
                <local:VistaSpecificProgressBar Name="PART_VistaProgressBar" Grid.Column="0" />
                <Border Name="PART_Cursor" Width="2" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" 
							Background="White" Height="16" />
                <TextBox Name="PART_EditableTextBox" 
						 Grid.Column="0" 
						 Margin="0" Background="Transparent"
						 VerticalAlignment="Center"
						 BorderThickness="0"
						 Foreground="{TemplateBinding Foreground}"                          
						 FontFamily="{TemplateBinding FontFamily}"
						 FontSize="{TemplateBinding FontSize}" 
						 FontStretch="{TemplateBinding FontStretch}"
						 FontStyle="{TemplateBinding FontStyle}" 
						 FontWeight="{TemplateBinding FontWeight}"
						 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
						 />
                <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
					   VerticalOffset="-2"
					   HorizontalOffset="1"
					   SnapsToDevicePixels="True"
					   AllowsTransparency="True" 
					   Focusable="True" 
					   PopupAnimation="Slide">
                    <ListBox  Name="PART_Container" 
                              SelectionMode="{TemplateBinding SelectionMode}"
                              ItemTemplate="{TemplateBinding ItemTemplate}"
                              ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                              ItemContainerStyleSelector="{TemplateBinding ItemTemplate}"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"                              
							 IsSynchronizedWithCurrentItem="True"
							 SnapsToDevicePixels="True"
							 MaxHeight="{TemplateBinding MaxDropHeight}" 
							 Focusable="True" 
							 Width="{Binding Path=ActualWidth, ElementName=PART_EditableTextBox}"
							 >

                    </ListBox>
                </Popup>
                <Popup Name="HistoryPopup"                
					   SnapsToDevicePixels="True"
					   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   AllowsTransparency="True" 
					   Focusable="True" 
					   PopupAnimation="Slide"
					   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                    <ListBox Name="PART_HistoryContainer" 
                              SelectionMode="{TemplateBinding SelectionMode}"
							 IsSynchronizedWithCurrentItem="True" 
						     SnapsToDevicePixels="True"
							 Height="{TemplateBinding HistoryListHeight}"
							 Width="{TemplateBinding ActualWidth}"
							 Focusable="True"                            
							 >
                       
                    </ListBox>
                </Popup>
            </Grid>
        </Border>

        
    </ControlTemplate>

    <ControlTemplate x:Key="AutoCompleteTemplate" TargetType="{x:Type local:AutoComplete}">
        <Border Name="MainBorder" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                Background="{TemplateBinding Background}"                             
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{StaticResource Default.Foreground}" >
            <Grid Name="ContentGrid"  >
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="Auto" MinWidth="13"/>
                </Grid.ColumnDefinitions>
               
                <local:VistaSpecificProgressBar Name="PART_VistaProgressBar" Grid.Column="0" />
                <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0" 
                 Margin="0"
				 VerticalAlignment="Center" 
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}" 
                 BorderThickness="0"                         
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}" 
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}" 
                 FontWeight="{TemplateBinding FontWeight}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
				 />
                <ToggleButton Name="PART_CheckButton" Grid.Column="1"
                              SnapsToDevicePixels="True"                              
							        Visibility="{Binding Path=IsHistory, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
							        Style="{StaticResource ToggleDropDownButtonStyle}"
                               >
                    <Path Name="PART_Arrow"
                Data="M0,1 L3,4 6,1" 
                Stroke="{StaticResource Black}" StrokeThickness="2"
                Fill="{StaticResource Black}"  
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"/>
                </ToggleButton>
                <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" 
               VerticalOffset="-2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">
                    <ListBox Name="PART_Container"   
                             SelectionMode="{TemplateBinding SelectionMode}"                              
                   IsSynchronizedWithCurrentItem="True" 
                   SnapsToDevicePixels="True"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}" 
                   Focusable="True">
                    </ListBox>
                </Popup>
                <Popup Name="HistoryPopup"                
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True" 
               Focusable="True" 
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                    <ListBox Name="PART_HistoryContainer"    
                              SelectionMode="{TemplateBinding SelectionMode}"
                   IsSynchronizedWithCurrentItem="True" 
                   SnapsToDevicePixels="True" 
			       Height="{TemplateBinding HistoryListHeight}"                 
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
				   >                     
                    </ListBox>
                </Popup>
            </Grid>
        </Border>        
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">                
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Aero.Normalcolor.BorderBrush}"/>                
                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}"/>
                <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">                
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Aero.Normalcolor.BorderBrush}"/>
                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.DropDownButton.Pressed.Background}"/>
               <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Default.DropDownButton.Pressed.Background}"/>          
            </Trigger>          
            
        </ControlTemplate.Triggers>
    </ControlTemplate>
   

