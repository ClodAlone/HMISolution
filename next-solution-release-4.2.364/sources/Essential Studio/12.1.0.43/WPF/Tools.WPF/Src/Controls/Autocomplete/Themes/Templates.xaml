                </ToggleButton>
                <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" 
               VerticalOffset="-2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">
                    <ListBox Name="PART_Container"   
                             SelectionMode="{TemplateBinding SelectionMode}"                              
                   IsSynchronizedWithCurrentItem="True" 
                   SnapsToDevicePixels="True"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}" 
                   Focusable="True">
                    </ListBox>
                </Popup>
                <Popup Name="HistoryPopup"                
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True" 
               Focusable="True" 
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                    <ListBox Name="PART_HistoryContainer"    
                              SelectionMode="{TemplateBinding SelectionMode}"
                   IsSynchronizedWithCurrentItem="True" 
                   SnapsToDevicePixels="True" 
			       Height="{TemplateBinding HistoryListHeight}"                 
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
				   >
                    </ListBox>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Blend.BorderBrush}"/>
                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Blend.Background}"/>
                <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Blend.Background}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Blend.BorderBrush}"/>
                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Blend.Background}"/>
                <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Blend.Background}"/>
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

   



</ResourceDictionary>