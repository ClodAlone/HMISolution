	</ControlTemplate>
	
	<!-- Up arrow for menu of the NavigationToolbar -->
	<WrapPanel x:Key="NavigationToolBar_UpMenuItemHeader"
			   Margin="0,0,0,0"
			   Orientation="Horizontal">
		<RepeatButton Height="16"
					  Width="16"
					  Command="local:GroupBar.SplitterUpCommand">
			<DockPanel>
				<Border Height="4"
						Width="4"
						VerticalAlignment="Center"
						HorizontalAlignment="Center">
					<Canvas>
						<Path Stroke="Black"
							  StrokeThickness="1"
							  Fill="Black"
							  Data="M 2 0 L 0 4 L 4 4 Z">
						</Path>
					</Canvas>
				</Border>
			</DockPanel>
		</RepeatButton>
	</WrapPanel>

