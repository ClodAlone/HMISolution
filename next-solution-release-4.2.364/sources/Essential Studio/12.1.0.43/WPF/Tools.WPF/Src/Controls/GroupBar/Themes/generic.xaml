        <Setter  Property="Height" Value="{Binding Path=HeaderHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
        <Setter  Property="BorderThickness" Value="1,1,1,1"/>
        <Setter  Property="CornerRadius" Value="{Binding Path=HeaderTopCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
        <!--<Setter  Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>-->
        <Setter  Property="TextElement.FontWeight" Value="Bold"/>
		</Style>


<!-- GroupBar StackedMode Template -->
	<ControlTemplate x:Key="GroupBarStackedTemplateKey" TargetType="{x:Type local:GroupBar}">
		<Grid Name="MainHost"
			  SnapsToDevicePixels="True"			  
			  Background="Transparent">
			<Grid.LayoutTransform>
				<TransformGroup>
                    <RotateTransform Angle="{Binding Path=RotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}, Converter={StaticResource AngleConverter}}" />
                </TransformGroup>
			</Grid.LayoutTransform>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="{Binding Path=ItemContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Border Name="HeaderHost"  
					Grid.Row="0"
					Style="{Binding Path=GroupBarHeaderStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					KeyboardNavigation.IsTabStop="False" BorderBrush="{StaticResource GroupBarItemNormalBorderBrush}" BorderThickness="1">
                <DockPanel Name="HeaderDockPanel"
                  Margin="{Binding Path=HeaderMarginRight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                    <Border DockPanel.Dock="Right"
                            Width="5"/>
                    <ToggleButton Name="CloseButton" 
                                  DockPanel.Dock="Right"
                                  Grid.Column="1"
								  ClickMode="Press"
                                  Margin="2"
                                  Width="16"
                                  Height="15"
                                  Visibility="Collapsed"                                  
                                  Command="local:GroupBar.m_closeButtonCommand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Name="CloseButtonContentBorder"
                                                    Background="{Binding Path=CollapseButtonBackground, 
                                                                 RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
                                                    BorderBrush="Transparent">
                                                <Path Name="pathButton" SnapsToDevicePixels="False" Stretch="Fill" StrokeThickness="1.5"
                                                      Stroke="{StaticResource Luna.Normalcolor_CollapseArrowColor}"
                                                      Data="M109,51 L216,142 M215,52 L109,142"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="8"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger SourceName="CloseButtonContentBorder" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseButtonContentBorder" Property="Background" 
                                                            Value="{Binding Path=CollapseButtonMouseOverBackground, 
                                                                    RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>                        
                    </ToggleButton>                    
                    <ToggleButton Name="CollapseButton" 
                                  DockPanel.Dock="Right"
                                  Grid.Column="1"
								  ClickMode="Press" 
                                  Template="{Binding Path=CollapseButtonTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
								  IsChecked="{Binding Path=IsCollapsed, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="FrameworkElement.Focusable" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(local:GroupBar.AllowCollapse), RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
					                             Value="False" >
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ContentPresenter Name="HeaderContent"
                                      VerticalAlignment="Center"
				                      ContentSource="SelectedHeader"
                                      Content="{TemplateBinding SelectedHeader}"
                                      ContentTemplateSelector="{StaticResource HeaderTrimmingTemplate}"/>

                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1">                
                <Border Name="ContentHostBorder"					
					Height="{TemplateBinding ItemContentLength}"
					BorderThickness="{TemplateBinding BorderThickness}"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					KeyboardNavigation.IsTabStop="False"
					KeyboardNavigation.TabNavigation="None">
                    <ScrollViewer Name="ScrollViewer" 
                                  Background="{TemplateBinding Background}"
                                  Focusable="false"
                                  CanContentScroll="false"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                        <ContentPresenter Name="ContentHost" ContentSource="SelectedContent">
                            <ContentPresenter.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="{Binding Path=ContentRotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}, Converter={StaticResource AngleConverter}}" />
                                </TransformGroup>
                            </ContentPresenter.LayoutTransform>
                        </ContentPresenter>
                    </ScrollViewer>
                </Border>
                <ToggleButton Name="CollapsedContentToggleButton"					
					Height="{TemplateBinding ItemContentLength}"
                    Command="local:GroupBar.m_popupCommand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="CollapsedContentHostBorder"
                                            Background="{StaticResource Luna.Normalcolor_NavigationPaneColor}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource Luna.Normalcolor_NavigationPaneBorderColor}">
                                            <TextBlock Name="ToggleButtonText"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Path=NavigationPaneText,
                                                                 RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
                                                Foreground="{StaticResource Luna.Normalcolor_NavigationPaneTextColor}"
                                                FontSize="14">
                                                <TextBlock.LayoutTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="270"/>
                                                    </TransformGroup>
                                                </TextBlock.LayoutTransform>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="CollapsedContentHostBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CollapsedContentHostBorder" Property="ToolTip" Value="Click to expand groupbar item header"/>
                                                <Setter TargetName="CollapsedContentHostBorder" Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CollapsedContentHostBorder" Property="Background" Value="{StaticResource Luna.Normalcolor_NavigationPaneMouseOverColor}"/>
                                                <Setter TargetName="CollapsedContentHostBorder" Property="BorderBrush" Value="{StaticResource Luna.Normalcolor_NavigationPaneCheckedBorderColor}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Path=(local:GroupBar.Orientation), 
                                                RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" Value="Horizontal" >
                                                <Setter TargetName="ToggleButtonText" Property="LayoutTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>                                            
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
            <Border Name="SplitterBorder"
                    Grid.Row="2"
					BorderThickness="1,0,1,0"
          Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
				<local:GroupBarSplitter Name="Splitter"
										Height="6"
										DragIncrement="{TemplateBinding ItemHeaderHeight}"
										KeyboardNavigation.IsTabStop="False"
										Focusable="True"/>
			</Border>
			<Border Name="StackItemsHost"
					Grid.Row="3"
          Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					Height="Auto"
					Focusable="False">
				<ItemsPresenter/>
			</Border>
			<local:NavigationToolbar
				Height="{TemplateBinding StackItemHostHeight}"
				Width="{Binding ElementName=MainHost, Path=ActualWidth}"
				BorderThickness="1,0,1,1"
				Grid.Row="4"
				Background="{StaticResource Office2007Blue_NavigationToolbar_BackgroundBrush}"
				Name="NavigationToolbar"
				KeyboardNavigation.IsTabStop="False"
				Focusable="False"/>
			<Popup Name="PART_Popup"
                       Focusable="False"
                       AllowsTransparency="True"
			           StaysOpen="False"                       
                       IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, 
                               RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
                       PopupAnimation="Fade">
                <Border Name="PopupResizePart"
                           Background="{StaticResource Luna.Normalcolor_PopupBorderFillColor}"
                           BorderThickness="1"
                           BorderBrush="{StaticResource Luna.Normalcolor_NavigationPaneBorderColor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10" Name="PopupGripperRow"/>
                        </Grid.RowDefinitions>
                        <Border Name="PopupInnerBorder" Grid.Row="0"
                               Margin="5,5,5,0"
                               BorderThickness="1"
                               BorderBrush="{StaticResource Luna.Normalcolor_NavigationPaneBorderColor}">
                            <ScrollViewer Name="popup_ScrollViewer" 
                                  Background="{TemplateBinding Background}"
                                  Focusable="false"
                                  CanContentScroll="false"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                                <ContentPresenter Name="PopupContentHost" Focusable="True" />
                            </ScrollViewer>
                        </Border>
                        <Canvas Name="PopupGripper" Grid.Row="1"
                                Height="10" RenderTransformOrigin="0.5,0.5" 
                                Visibility="{Binding Path=ShowGripper, RelativeSource={RelativeSource TemplatedParent}, 
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="180"/>
                            </Canvas.RenderTransform>
                            <Line Stroke="{StaticResource Luna.Normalcolor_NavigationPaneBorderColor}"
                                  StrokeThickness="1" 
                                  X1="1" Y1="3" X2="3" Y2="1"/>
                            <Line Stroke="{StaticResource Luna.Normalcolor_NavigationPaneBorderColor}"
                                  StrokeThickness="1" 
                                  X1="1" Y1="6" X2="6" Y2="1"/>
                            <Line Stroke="{StaticResource Luna.Normalcolor_NavigationPaneBorderColor}"
                                  StrokeThickness="1" 
                                  X1="1" Y1="9" X2="9" Y2="1"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="SplitterBorder" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
                <Setter TargetName="StackItemsHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="ContentHostBorder" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="HeaderHost" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="ContentHostBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="SplitterBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="StackItemsHost" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
			</Trigger>-->
            <Trigger Property="ShowGripper" Value="False">
                <Setter TargetName="PopupGripperRow" Property="Height" Value="5"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
				<Setter TargetName="Splitter" Property="Cursor" Value="SizeWE"/>
            </Trigger>
            <Trigger Property="IsCollapsed" Value="False">
                <Setter TargetName="CollapsedContentToggleButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ContentHostBorder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsCollapsed" Value="True">
                <Setter TargetName="HeaderDockPanel" Property="Margin" Value="0"/>
                <Setter TargetName="HeaderContent" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="CollapsedContentToggleButton" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ContentHostBorder" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsToolBarEnabled" Value="True">
                <Setter TargetName="SplitterBorder" Property="Visibility" Value="Visible"/>
                <!--<Setter TargetName="StackItemsHost" Property="Visibility" Value="Visible"/>-->
                <!--<Setter TargetName="NavigationToolbar" Property="Visibility" Value="Visible"/>-->
            </Trigger>
            <Trigger Property="IsToolBarEnabled" Value="False">
                <Setter TargetName="SplitterBorder" Property="Visibility" Value="Collapsed"/>
                <!--<Setter TargetName="StackItemsHost" Property="Visibility" Value="Collapsed"/>-->
                <!--<Setter TargetName="NavigationToolbar" Property="Visibility" Value="Collapsed"/>-->
                <Setter TargetName="HeaderHost" Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter TargetName="HeaderHost" Property="Padding" Value="5,1,1,1"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>                    
                    <Condition Property="IsCloseButtonEnabled" Value="True"/>
                    <Condition Property="IsToolBarEnabled" Value="False"/>
                    <Condition Property="IsCollapsed" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger SourceName="CloseButton" Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

  
    <!-- GroupBar MultipleExpansion Template -->
	<ControlTemplate x:Key="GroupBarMultipleExpansionTemplateKey" TargetType="{x:Type local:GroupBar}">
		<Grid Name="MainHost"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
			<Grid.LayoutTransform>
				<TransformGroup>
                    <RotateTransform Angle="{Binding Path=RotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}, Converter={StaticResource AngleConverter}}" />
                </TransformGroup>
			</Grid.LayoutTransform>
			<Border Name="ItemsHost"
              CornerRadius="{TemplateBinding CornerRadius}"
              Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
				<ScrollViewer Name="ScrollViewer"  
                      Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"  
							  Focusable="False" 
							  VerticalScrollBarVisibility="Auto">
					<ItemsPresenter/>
				</ScrollViewer>
			</Border>
		</Grid>
		<!--<ControlTemplate.Triggers>
			<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="ItemsHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="ItemsHost" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
			</Trigger>
		</ControlTemplate.Triggers>-->
    </ControlTemplate>

	<!-- GroupBar NonStackedMode Template -->
	<ControlTemplate x:Key="GroupBarNonStackedTemplateKey" TargetType="{x:Type local:GroupBar}">
		<Grid Name="MainHost"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
			<Grid.LayoutTransform>
				<TransformGroup>
                    <RotateTransform Angle="{Binding Path=RotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}, Converter={StaticResource AngleConverter}}" />
                </TransformGroup>
			</Grid.LayoutTransform>
			<Border Name="ItemsHost"
              CornerRadius="{TemplateBinding CornerRadius}"
              Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                <ScrollViewer Name="ScrollViewer"  
                      Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"  
							  Focusable="False" 
							  VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
                </ScrollViewer>
            </Border>
		</Grid>
		<!--<ControlTemplate.Triggers>
			<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="ItemsHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="ItemsHost" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
			</Trigger>
		</ControlTemplate.Triggers>-->
	</ControlTemplate>

	
	<!-- GroupBar Style -->
	<Style  TargetType="{x:Type local:GroupBar}">
		<Setter Property="ItemHeaderHeight" Value="32"/>
		<Setter Property="HeaderHeight" Value="32"/>
        <Setter Property="GroupBarHeaderStyle" Value="{StaticResource HeaderStyle}"/>
		<Setter Property="StackItemHostHeight" Value="32"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="FocusManager.IsFocusScope" Value="True"/>
		<Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
		<Setter Property="KeyboardNavigation.ControlTabNavigation" Value="None"/>
		<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel
						KeyboardNavigation.TabNavigation="Local"
						KeyboardNavigation.DirectionalNavigation="Cycle"
						KeyboardNavigation.ControlTabNavigation="None"/>
					</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="VerticalAlignment" Value="Top"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{StaticResource Office2007Blue_GroupBar_Content}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue_GroupBar_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
		<!--<Setter Property="BorderThickness" Value="{utilsOuter:SkinObject BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{utilsOuter:SkinObject CornerRadius}"/>-->
        <Setter Property="TextElement.Foreground" Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
       <!--<Setter Property="DefaultItemImage" Value="{StaticResource DefaultItemImage}"/>-->
		<Setter Property="VerticalOrientationStoryboard" Value="{StaticResource GroupBar_VerStoryboard}"/>
		<Setter Property="HorizontalOrientationStoryboard" Value="{StaticResource GroupBar_HorStoryboard}"/>
		<Setter Property="OrientationChangedContentStoryboard" Value="{StaticResource OrientationChangedContentStoryboard}"/>
        <Setter Property="CollapseButtonBackground" Value="Transparent"/>
        <Setter Property="CollapseButtonMouseOverBackground" Value="Transparent"/>
        <Setter Property="CollapseButtonTemplate" Value="{StaticResource CollapseButtonTemplateKey}"/>
        
        <Style.Triggers>
            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
                <Setter Property="ContextMenu" Value="{StaticResource GroupBar_ContextMenu}"/>
            </Trigger>
			
			 <Trigger Property="local:GroupBar.VisualMode" Value="Default">
                <Setter Property="Template" Value="{StaticResource GroupBarNonStackedTemplateKey}"/>
            </Trigger>
			
			 <Trigger Property="local:GroupBar.VisualMode" Value="StackMode">
                <Setter Property="Template" Value="{StaticResource GroupBarStackedTemplateKey}"/>
            </Trigger>
			
			  <Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
				<Setter Property="ItemHeaderHeight" Value="18"/>
                <Setter Property="Template" Value="{StaticResource GroupBarMultipleExpansionTemplateKey}"/>
            </Trigger>
			
			<Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>

            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="HeaderHeight" Value="45"/>
                <Setter Property="ItemHeaderHeight" Value="45"/>
                <Setter Property="StackItemHostHeight" Value="45"/>
            </Trigger>

        </Style.Triggers>
</Style>


	<!-- GroupBarItem NonStackedMode Template -->
	<ControlTemplate x:Key="GroupBarItemNonStackedTemplateKey" TargetType="{x:Type local:GroupBarItem}">
		<Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid Name="HeaderGrid"
				  Grid.Row="0"
				  ClipToBounds="True"
				  Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				  Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}">
				<Grid.RowDefinitions>
					<RowDefinition Height="1"/>
					<RowDefinition Height="0.5*"/>
					<RowDefinition Height="0.5*"/>
					<RowDefinition Height="1"/>
				</Grid.RowDefinitions>
				<Border Name="HeaderHost"
Style="{Binding Path=HeaderStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
					Grid.Row="1"
					Grid.RowSpan="2"
					Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="0,0,0,1">
					<Border Name="SelectBorder"
							BorderBrush="Transparent"
							BorderThickness="1">
						<ContentPresenter Content="{TemplateBinding Header}" x:Name="contentText"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"/>
					</Border>
				</Border>
			</Grid>
			<Border Name="ContentHostBorder"
					Grid.Row="1"					
					BorderThickness="0"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					Visibility="Visible">
				<Border.LayoutTransform>
					<TransformGroup>
						<RotateTransform Angle="{Binding Path=ContentRotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}, Converter={StaticResource AngleConverter}}" />
					</TransformGroup>
				</Border.LayoutTransform>
				<ContentPresenter Name="ContentHost"								  
								  Content="{TemplateBinding Content}"
								  ContentTemplate="{TemplateBinding ContentTemplate}"
								  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="ContentHostBorder" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="HeaderHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}" />
			</Trigger>-->
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="Background" Value="{StaticResource Office2007Blue_GroupBarItem_NormalStateBrush}"/>
				</MultiTrigger.Conditions>
				<MultiTrigger.EnterActions>
					<BeginStoryboard Storyboard="{StaticResource GroupBarItem_SelectedStoryboard}"/>
				</MultiTrigger.EnterActions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Office2003_GroupBarItem_NormalStateBrush}"/>
                <Setter TargetName="HeaderHost" Property="BorderBrush" Value="#FF3399FF"/>
                <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" TargetName="SelectBorder" Value="Transparent"/>
			</MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.3"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Margin" TargetName="contentText" Value="5"/>
                <Setter Property="VerticalAlignment" TargetName="contentText" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="18"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	<!-- GroupBarItem MultipleExpansion Template -->
	<ControlTemplate x:Key="GroupBarItemMultipleExpansionTemplateKey" TargetType="{x:Type local:GroupBarItem}">
		<Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<StackPanel>
				<Border Name="HeaderHost"
Style="{Binding Path=HeaderStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
						Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						ClipToBounds="True"
						Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="0,0,0,1">
					<Border Name="SelectBorder"
							BorderBrush="Transparent"
							BorderThickness="1">
						<DockPanel>
							<ToggleButton Name="Expander" DockPanel.Dock="Left"
										  ClickMode="Press"
										  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Style>
									<Style TargetType="ToggleButton">
										<Setter Property="FrameworkElement.Focusable" Value="False"/>
										<Setter Property="FrameworkElement.Width" Value="19"/>
										<Setter Property="FrameworkElement.Height" Value="13"/>
										<Setter Property="Control.Template">
											<Setter.Value>
												<ControlTemplate TargetType="ToggleButton">
													<Border Height="13" Width="19" Background="#00FFFFFF">
                                                        <Border Height="9" BorderBrush="#FF919191" CornerRadius="1" Width="9" BorderThickness="1" SnapsToDevicePixels="True">
															<Border.Background>
                                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                                    <GradientStop Color="#FFFAFBFB" Offset="0.569"/>
                                                                    <GradientStop Color="#FFEDEDEC" Offset="0.588"/>
                                                                    <GradientStop Color="#FFEDEDEC" Offset="0.719"/>
                                                                    <GradientStop Color="#FFE3E3E3" Offset="0.738"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Path Margin="1,1,1,1" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" Fill="#FF4B63A7" Name="ExpandPath" />
														</Border>
													</Border>
													<ControlTemplate.Triggers>
														<Trigger Property="ToggleButton.IsChecked" Value="True">
															<Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
														</Trigger>
													</ControlTemplate.Triggers>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</ToggleButton.Style>
							</ToggleButton>

							<ContentPresenter DockPanel.Dock="Top" x:Name="contentText"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontStyle="{TemplateBinding FontStyle}"
											  Content="{TemplateBinding Header}"
											  ContentTemplate="{TemplateBinding HeaderTemplate}"
											  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"/>
						</DockPanel>
					</Border>
				</Border>

                <Border x:Name="BottomBorder" Background="{StaticResource VisualStudio2005_GroupViewItem_SeparatorBrush}"
						Width="{TemplateBinding ActualWidth}"
						Height="1"/>
			</StackPanel>

			<Border Name="ContentHostBorder"
					Grid.Row="1"
					Height="0"
					Width="0"
					BorderThickness="0"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					Visibility="Visible">
				<Border.LayoutTransform>
					<TransformGroup>
						<RotateTransform Angle="{Binding Path=ContentRotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}, Converter={StaticResource AngleConverter}}" />
					</TransformGroup>
				</Border.LayoutTransform>
				<ContentPresenter Name="ContentHost"
								  Height="{Binding Height, ElementName=ContentHostBorder, UpdateSourceTrigger=PropertyChanged}"
								  Width="{Binding Width, ElementName=ContentHostBorder, UpdateSourceTrigger=PropertyChanged}"
								  Content="{TemplateBinding Content}"
								  ContentTemplate="{TemplateBinding ContentTemplate}"
								  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
								  KeyboardNavigation.IsTabStop="False"
								  KeyboardNavigation.TabNavigation="Continue"
								  KeyboardNavigation.ControlTabNavigation="Continue"
								  KeyboardNavigation.DirectionalNavigation="Continue"/>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="ContentHostBorder" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}" />
				<Setter TargetName="HeaderHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}" />
			</Trigger>-->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="Background" Value="{StaticResource Office2007Blue_GroupBarItem_NormalStateBrush}"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
					<BeginStoryboard Storyboard="{StaticResource GroupBarItem_SelectedStoryboard}"/>
                </MultiTrigger.EnterActions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Office2003_GroupBarItem_NormalStateBrush}"/>
                <Setter TargetName="BottomBorder" Property="Background" Value="Transparent"/>
                <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1"/>
                <Setter TargetName="HeaderHost" Property="BorderBrush" Value="#FF3399FF"/>
                <Setter Property="BorderBrush" TargetName="SelectBorder" Value="Transparent"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.3"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Margin" TargetName="contentText" Value="5"/>
                <Setter Property="VerticalAlignment" TargetName="contentText" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="18"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	<!-- GroupBarItem StackedMode Template -->
	<ControlTemplate x:Key="GroupBarItemStackedTemplateKey" TargetType="{x:Type local:GroupBarItem}">
		<Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
			<Grid Name="HeaderGrid"
				  Grid.Row="0"
				  ClipToBounds="True"
				  Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				  Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}">
				<Grid.RowDefinitions>
					<RowDefinition Height="1"/>
					<RowDefinition Height="0.5*"/>
					<RowDefinition Height="0.5*"/>
					<RowDefinition Height="1"/>
				</Grid.RowDefinitions>
				<Border Name="HeaderHost"
Style="{Binding Path=HeaderStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
						Grid.Row="1"
						Grid.RowSpan="2"
						Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="0,0,0,1">
					<Border Name="SelectBorder"
							BorderBrush="Transparent"
							BorderThickness="1">
						<ContentPresenter x:Name="contentText"
							Content="{TemplateBinding Header}"
							ContentTemplate="{TemplateBinding HeaderTemplate}"
							ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
							KeyboardNavigation.IsTabStop="False"
							KeyboardNavigation.TabNavigation="Continue"
							KeyboardNavigation.ControlTabNavigation="Continue"
							KeyboardNavigation.DirectionalNavigation="Continue"/>
					</Border>
				</Border>
			</Grid>
		</Grid>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="HeaderHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}" />
			</Trigger>-->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="Background" Value="{StaticResource Office2007Blue_GroupBarItem_NormalStateBrush}"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Office2003_GroupBarItem_NormalStateBrush}"/>
                <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1"/>
                <Setter TargetName="HeaderHost" Property="BorderBrush" Value="#FF3399FF"/>
                <Setter Property="BorderBrush" TargetName="SelectBorder" Value="Transparent"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.3"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Margin" TargetName="contentText" Value="5"/>
                <Setter Property="VerticalAlignment" TargetName="contentText" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="18"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	
	<!-- GroupBarItem Style -->
	<Style  TargetType="{x:Type local:GroupBarItem}">
        <Setter Property="Background" Value="{StaticResource Office2007Blue_GroupBarItem_NormalStateBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
		<Setter Property="AllowDrop" Value="True"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="SelectedAnimation" Value="{StaticResource GroupBarItem_SelectedAnimation}"/>
		<Setter Property="UnselectedAnimation" Value="{StaticResource GroupBarItem_UnselectedAnimation}"/>
		<Style.Triggers>
            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
                <Setter Property="ContextMenu" Value="{StaticResource GroupBar_ContextMenu}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Blend_Selected_Foreground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Blend_Selected_Foreground}"/>
            </Trigger>
			
			<Trigger Property="local:GroupBar.VisualMode" Value="Default">
                <Setter Property="Template" Value="{StaticResource GroupBarItemNonStackedTemplateKey}"/>
            </Trigger>
			
			            <Trigger Property="local:GroupBar.VisualMode" Value="StackMode">
                <Setter Property="Template" Value="{StaticResource GroupBarItemStackedTemplateKey}"/>
            </Trigger>

            <Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
                <Setter Property="Template" Value="{StaticResource GroupBarItemMultipleExpansionTemplateKey}"/>
            </Trigger>
			<Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>	
	</Style.Triggers>
	</Style>
	
	<!-- GroupBarItemHeader Template -->
		<Style  TargetType="{x:Type local:GroupBarItemHeader}">
		<Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
		<Setter Property="Focusable" Value="True"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="TextHorizontalAlignment" Value="{Binding Path=TextAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
		<Setter Property="ImageMargin" Value="0,0,5,0"/>
		<Setter Property="Template">
            <Setter.Value>
	<ControlTemplate  TargetType="{x:Type local:GroupBarItemHeader}">
		<DockPanel Name="MainGrid"
				   SnapsToDevicePixels="True"
				   Margin="5,0,0,0">
			<Border Name="ImageHost"
					DockPanel.Dock="Left"
					Height="{TemplateBinding ImageHeight}"
					Width="{TemplateBinding ImageWidth}"
					HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}"
					VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"
					Margin="{TemplateBinding ImageMargin}">
				<Image Name="Image"
					   Source="{TemplateBinding ImageSource}"
					   Visibility="Visible"
					   Stretch="Fill"/>
			</Border>
			<Border Name="TextHost"
					DockPanel.Dock="Top"
					Margin="{TemplateBinding TextMargin}"
					HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
					VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
					TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}">
				<StackPanel>
					<TextBlock Name="Text"
							   HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
							   VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
							   Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItemHeader}}}"
							   FontWeight="Bold"
							   Margin="1,1,1,1"
							   TextTrimming="CharacterEllipsis"/>
					<TextBox Name="TextEditor"
							 Visibility="Collapsed"
							 Width="{Binding ActualWidth, ElementName=TextHost}"
							 Height="14"
							 Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItemHeader}}}"
							 FontSize="10"
							 Margin="1,0,0,0"
							 Padding="0,0,0,0" 
							 BorderThickness="0"/>
				</StackPanel>
			</Border>
		</DockPanel>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="TextHost" Property="TextBlock.Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}" />
			</Trigger>-->
			<Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
				<Setter Property="Visibility" TargetName="Image" Value="Collapsed"/>
				<Setter Property="Margin" TargetName="MainGrid" Value="0"/>
				<Setter Property="Width" TargetName="ImageHost" Value="0"/>
			</Trigger>
			<Trigger Property="IsInEditMode" Value="True">
				<Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
				<Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="ImageHost" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="TextHost" Property="HorizontalAlignment" Value="Stretch"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	</Setter.Value>
	        </Setter>
    </Style>

	<!-- GroupView MultipleExpansion Template -->
	<ControlTemplate x:Key="GroupViewMultipleExpansionTemplateKey" TargetType="{x:Type local:GroupView}">
		<StackPanel Name="MainHost"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}">
			<ItemsPresenter ClipToBounds="True"/>
		</StackPanel>
		<!--<ControlTemplate.Triggers>
			<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="MainHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}" />
				<Setter TargetName="MainHost" Property="TextBlock.Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}" />
			</Trigger>
		</ControlTemplate.Triggers>-->
	</ControlTemplate>

	<!-- GroupView Default Template -->
	<ControlTemplate x:Key="GroupViewDefaultTemplateKey" TargetType="{x:Type local:GroupView}">
		<ScrollViewer Name="MainHost" 
					  Focusable="False"
					  Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					  Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					  VerticalScrollBarVisibility="Auto"
					  Style="{StaticResource ScrollViewerStyle}">
			<Border Name="ItemsHost" Padding="0,0,0,0">
				<ItemsPresenter ClipToBounds="True"/>
			</Border>
		</ScrollViewer>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="MainHost" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}" />
				<Setter TargetName="MainHost" Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}" />
			</Trigger>-->
			<DataTrigger Binding="{Binding Path=(local:GroupBarItem.IsAnimating)}"
						 Value="True" >
				<Setter TargetName="MainHost" Property="VerticalScrollBarVisibility" Value="Hidden"/>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
    <ControlTemplate x:Key="GroupViewStackModeTemplateKey" TargetType="{x:Type local:GroupView}">
        <Border Name="ItemsHost" Padding="0,0,0,0">
            <ItemsPresenter ClipToBounds="True"/>
        </Border>
    </ControlTemplate>
    <Style   TargetType="{x:Type local:GroupView}">
		<Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{StaticResource Office2007Blue_GroupView_Background}"/>
        <Setter Property="Foreground" Value="{StaticResource VisualStudio2005Metallic_ItemText_Brush}"/>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
							   VerticalAlignment="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
							   KeyboardNavigation.TabNavigation="Cycle"
							   KeyboardNavigation.DirectionalNavigation="Continue"
							   KeyboardNavigation.ControlTabNavigation="None"
                 Orientation="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
        

        <Style.Triggers>
			<Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
				<Setter Property="ContextMenu" Value="{StaticResource GroupBar_ContextMenu}"/>
			</Trigger>

			 <Trigger Property="local:GroupBar.VisualMode" Value="Default">
                <Setter Property="Template" Value="{StaticResource GroupViewDefaultTemplateKey}"/>
            </Trigger>
			
			 <Trigger Property="local:GroupBar.VisualMode" Value="StackMode">
                <Setter Property="Template" Value="{StaticResource GroupViewStackModeTemplateKey}"/>
            </Trigger>
			
			  <Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
                <Setter Property="Template" Value="{StaticResource GroupViewMultipleExpansionTemplateKey}"/>
            </Trigger>
			
			<Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>
			<Trigger Property="local:GroupView.IsListViewMode" Value="False">
				<Setter Property="IsShowText" Value="False"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	
	<!-- GroupViewItem Template -->
	<ControlTemplate x:Key="GroupViewItemTemplateKey" TargetType="{x:Type local:GroupViewItem}">
		<Border Name="MainGrid"
				Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}"
				BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}"
				BorderThickness="1"
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}">
            <Grid>
                <Grid.Resources>
                    <local:ContentToVisibilityConverter x:Key="ContentToVisibility"/>
                </Grid.Resources>
                <DockPanel Name="ContentHost" Visibility="{Binding Path=Content,ElementName=contentpresenter, Converter={StaticResource ContentToVisibility}}" Margin="3"
					   Width="{Binding Path=InternalContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
					   HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}">
                    <Border Name="ImageHost"
						DockPanel.Dock="Left"
						Width="{TemplateBinding ImageWidth}"
						Height="{TemplateBinding ImageHeight}"
						HorizontalAlignment="Left"
						Background="Transparent">
                        <Image Name="Image"
						   Stretch="Fill"
						   Source="{TemplateBinding ImageSource}"/>
                    </Border>
                    <Border Name="TextHost"
						DockPanel.Dock="Top"
						Padding="3,2,3,2"
						HorizontalAlignment="{Binding Path=TextAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
						TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}" >
                        <StackPanel>
                            <TextBlock Name="Text"
								   Visibility="Visible"
								   TextTrimming="CharacterEllipsis"
								   Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                            <TextBox Name="TextEditor"
								 Visibility="Collapsed"
								 Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"
								 Background="{TemplateBinding Background}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Border >
                    <DockPanel>
                        <ContentControl x:Name="contentpresenter"
                            Content="{TemplateBinding Content}" ContentTemplateSelector="{Binding Path=ItemTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                         ContentTemplate="{Binding Path=ItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                            Width="{Binding Path=InternalContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                            HorizontalContentAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"/>
                    </DockPanel>
                </Border>
            </Grid>
		</Border>
		<ControlTemplate.Triggers>
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="MainGrid" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}" />
				<Setter TargetName="TextHost" Property="TextBlock.Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}" />
			</Trigger>-->
			<DataTrigger Binding="{Binding Path=IsShowText, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" Value="False">
				<Setter TargetName="TextHost" Property="Visibility" Value="Collapsed"/>
			</DataTrigger>
			<Trigger Property="IsInEditMode" Value="True">
				<Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
				<Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="TextHost" Property="HorizontalAlignment" Value="Stretch"/>
				<Setter TargetName="TextHost" Property="Visibility" Value="Visible"/>
			</Trigger>           
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition SourceName="MainGrid" Property="IsMouseOver" Value="True"/>
					<Condition Property="IsSelected" Value="False"/>
				</MultiTrigger.Conditions>
				<Setter Property="Background" >
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=MouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <Setter Property="BorderBrush" Value="{StaticResource VisualStudio2005_GroupViewItem_OverBorderBrush}"/>
            </MultiTrigger>
			<Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" >
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=MouseDownColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <Setter Property="BorderBrush"  Value="{StaticResource VisualStudio2005_GroupViewItem_PressedBorderBrush}"/>
            </Trigger>
			<Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" >
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=SelectedItemColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <Setter Property="BorderBrush" Value="{StaticResource VisualStudio2005_GroupViewItem_SelectedBorderBrush}"/>
            </Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition SourceName="MainGrid" Property="IsMouseOver" Value="True"/>
					<Condition Property="IsSelected" Value="True"/>
				</MultiTrigger.Conditions>
                <Setter Property="Background" >
					<Setter.Value>
						<SolidColorBrush Color="{Binding Path=SelectedItemMouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
					</Setter.Value>
				</Setter>
                <!--<Setter Property="Background" TargetName="MainGrid" Value="{Binding Path=(local:GroupViewItem.SelectedItemMouseHoverColor),RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>-->
                <Setter Property="BorderBrush" Value="{StaticResource VisualStudio2005_GroupViewItem_PressedBorderBrush}"/>
            </MultiTrigger>
			<Trigger Property="IsDragging" Value="True">
                <Setter TargetName="MainGrid" Property="Background" Value="{StaticResource VisualStudio2005_GroupViewItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource VisualStudio2005_GroupViewItem_PressedBorderBrush}"/>
			</Trigger>
			<DataTrigger Binding="{Binding Path=(local:GroupView.IsListViewMode), RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
						 Value="False">
				<Setter TargetName="ContentHost" Property="Width" Value="{Binding Path=Width}" />
			</DataTrigger>
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Padding" TargetName="MainGrid" Value="1,8"/>
                <Setter Property="FontSize" TargetName="Text" Value="18"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	
	<!-- GroupViewItem Style -->
	<Style  TargetType="{x:Type local:GroupViewItem}" >
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<!--<Setter Property="Background" Value="{utilsOuter:SkinObject GroupViewItem_BackgroundBrush}"/>-->
        <Setter Property="Background"  Value="{StaticResource VisualStudio2005_GroupViewItem_BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
		<!--<Setter Property="Template" Value="{StaticResource GroupViewItemTemplateKey}"/>-->
        <Setter Property="SelectedItemColor" Value="{StaticResource VisualStudio2005_GroupViewItem_SelectedBackgroundColor}"/>
        <Setter Property="MouseDownColor" Value="{StaticResource VisualStudio2005_GroupViewItem_PressedBackgroundColor}"/>
        <Setter Property="SelectedItemMouseHoverColor" Value="{StaticResource VisualStudio2005_GroupViewItem_SelectedOverBackgroundColor}"/>
        <Setter Property="ToolTipService.IsEnabled" Value="True"/>
		<Setter Property="ToolTipService.Placement" Value="Mouse"/>
        <Setter Property="Margin" Value="{StaticResource DefaultGroupViewItemMargin}"/>
        <Setter Property="Template" Value="{StaticResource GroupViewItemTemplateKey}"/>
        
        <Style.Triggers>
            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="False">
                <Setter Property="MouseHoverColor" Value="{StaticResource VisualStudio2005_GroupViewItem_OverBackgroundColor}"/>
            </Trigger>
			
			<Trigger Property="local:GroupBar.IsEnabledContextMenu" Value="False">
				<Setter Property="ContextMenuService.IsEnabled" Value="False"/>
			</Trigger>
			<Trigger Property="ShowToolTip" Value="False">
				<Setter Property="ToolTipService.IsEnabled" Value="False"/>
			</Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>                
            </Trigger>
		</Style.Triggers>
	</Style>
	
	
	
	<!-- Naviagation Toolbar Template -->
	<ControlTemplate x:Key="NavigationToolbar" TargetType="{x:Type local:NavigationToolbar}">
		<Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
			<Grid.Resources>
				<ResourceDictionary>
					<Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
                        <Setter Property="TextElement.Foreground" Value="{StaticResource VisualStudio2005_MenuText_Brush}"/>
                        <Setter Property="Template" Value="{StaticResource ToggleButtonKeyTemplate}"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding Path=IsHighlighted, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
										 Value="True" >
                                <Setter Property="TextElement.Foreground" Value="{StaticResource VisualStudio2005_MenuText_SelectedBrush}"/>
                            </DataTrigger>
						</Style.Triggers>
					</Style>
                    <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type CheckBox}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                        <ContentPresenter ContentSource="Content"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True" >
                                <Setter Property="Background" Value="#FFBD69"/>
                                <Setter Property="BorderBrush" Value="#FFAB3F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
				</ResourceDictionary>
			</Grid.Resources>
			<Border Name="MainHost" 
          CornerRadius="{Binding Path=ToolbarBottomCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
          Background="{TemplateBinding Background}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}">
				<WrapPanel Name="MainPanel"
						   Orientation="Horizontal"
						   FlowDirection="RightToLeft">
					<Menu Name="Menu" Margin="{Binding Path=ToolbarMenuMarginRight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
						  FlowDirection="LeftToRight"
						  Background="Transparent">
						<MenuItem Name="TopMenuItem"
								  Padding="0"
								  Margin="0"
								  Background="Transparent"
								 >
							<!--Template="{StaticResource MenuItemSubmenuTemplateKey}"
								  ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
							<MenuItem.Header>
								<DockPanel Name="MenuImageHost"
										   Background="{Binding Background, ElementName=TopMenuItem}">
									<Border Name="MenuImage"
											Height="{TemplateBinding Height}"
											Width="{Binding Path=MenuDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
											VerticalAlignment="Center"
											HorizontalAlignment="Center">
										<Canvas Width="7"
												Height="10"
												VerticalAlignment="Center"
												HorizontalAlignment="Center">
											<Line X1="0" Y1="0" X2="2" Y2="0" StrokeThickness="1" Stroke="Black"/>
											<Line X1="1" Y1="1" X2="3" Y2="1" StrokeThickness="1" Stroke="Black"/>
											<Line X1="2" Y1="2" X2="4" Y2="2" StrokeThickness="1" Stroke="Black"/>
											<Line X1="1" Y1="3" X2="3" Y2="3" StrokeThickness="1" Stroke="Black"/>
											<Line X1="0" Y1="4" X2="2" Y2="4" StrokeThickness="1" Stroke="Black"/>

											<Line X1="3" Y1="0" X2="5" Y2="0" StrokeThickness="1" Stroke="Black"/>
											<Line X1="4" Y1="1" X2="6" Y2="1" StrokeThickness="1" Stroke="Black"/>
											<Line X1="5" Y1="2" X2="7" Y2="2" StrokeThickness="1" Stroke="Black"/>
											<Line X1="4" Y1="3" X2="6" Y2="3" StrokeThickness="1" Stroke="Black"/>
											<Line X1="3" Y1="4" X2="5" Y2="4" StrokeThickness="1" Stroke="Black"/>

											<Line X1="1" Y1="8" X2="6" Y2="8" StrokeThickness="1" Stroke="Black"/>
											<Line X1="2" Y1="9" X2="5" Y2="9" StrokeThickness="1" Stroke="Black"/>
											<Line X1="3" Y1="10" X2="4" Y2="10" StrokeThickness="1" Stroke="Black"/>
										</Canvas>
									</Border>
								</DockPanel>
							</MenuItem.Header>
							<MenuItem Name="SplitterUpMenuItem"
									  Command="local:GroupBar.SplitterUpCommand"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Showmorebuttons}"
									  StaysOpenOnClick="True">
								<MenuItem.Icon>
									<StaticResource ResourceKey="NavigationToolBar_UpMenuItemHeader"/>
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Name="SplitterDownMenuItem" 
									  Command="local:GroupBar.SplitterDownCommand"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Showfewerbuttons}"
									  StaysOpenOnClick="True">
								<MenuItem.Icon>
									<StaticResource ResourceKey="NavigationToolBar_DownMenuItemHeader"/>
								</MenuItem.Icon>
							</MenuItem>
							<Separator />
							<!--Style="{StaticResource SeparatorKeyStyle}"-->
							<MenuItem Name="OptionsMenu"
									  Command="local:GroupBar.OpenOptionsCommand"
									  Header="{Binding Path=NavigationOptionsMenuItemHeader, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
							<Separator />
							<!--Style="{StaticResource SeparatorKeyStyle}"-->
							<MenuItem Name="ButtonsMenu"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Buttons}"
									 />
							<!--ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
						</MenuItem>
					</Menu>
					<ItemsPresenter Name="ItemsPresenter"/>
				</WrapPanel>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
      <DataTrigger
				Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="True">
        <Setter TargetName="Menu" Property="Margin" Value="0"/>
      </DataTrigger>
    
			<!--<Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Default">
				<Setter TargetName="MainHost" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
			</Trigger>-->
			<Trigger SourceName="TopMenuItem" Property="IsMouseOver" Value="True">
				<!--<Setter TargetName="TopMenuItem" Property="Background" Value="{StaticResource Office2007Blue_NavigationToolbarItem_OverBrush}"/>-->						
			</Trigger>

			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
					<Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter TargetName="Menu" Property="LayoutTransform">
					<Setter.Value>
						<RotateTransform Angle="-90" />
					</Setter.Value>
				</Setter>
				<Setter TargetName="MenuImageHost" Property="LayoutTransform">
					<Setter.Value>
						<TransformGroup>
							<RotateTransform Angle="-90"/>
						</TransformGroup>
					</Setter.Value>
				</Setter>
			</MultiDataTrigger>

			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
					<Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="LeftToRight"/>
				</MultiDataTrigger.Conditions>
				<Setter TargetName="Menu" Property="LayoutTransform">
					<Setter.Value>
						<RotateTransform Angle="-90" />
					</Setter.Value>
				</Setter>
				<Setter TargetName="MenuImageHost" Property="LayoutTransform">
					<Setter.Value>
						<TransformGroup>
							<RotateTransform Angle="-90" />
						</TransformGroup>
					</Setter.Value>
				</Setter>
			</MultiDataTrigger>

			<DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="RightToLeft">
				<Setter TargetName="MainPanel" Property="FlowDirection" Value="LeftToRight"/>
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</DataTrigger>

			<DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="LeftToRight">
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</DataTrigger>

            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="ItemDefaultWidth" Value="30"/>
                <Setter Property="MenuDefaultWidth" Value="25"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	
	<!-- Naviagation Toolbar Style -->
	<Style  TargetType="{x:Type local:NavigationToolbar}">
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" />
		<Setter Property="ItemMargin" Value="1"/>
        <Setter Property="MenuDefaultWidth" Value="{StaticResource DefaultNavigationMenuDefaultWidth}"/>
        <Setter Property="ItemDefaultWidth" Value="22"/>
        <Setter Property="Template" Value="{StaticResource NavigationToolbar}"/>	
    </Style>
	
	
	<!-- NaviagationToolbarItem Template -->
	<ControlTemplate x:Key="NaviagationToolbarItemTemplateKey" TargetType="{x:Type local:NavigationToolbarItem}">
		<Grid SnapsToDevicePixels="True" ClipToBounds="True">
			<Border Name="ImageHost"
					Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					Background="{TemplateBinding Background}"
					BorderBrush="{TemplateBinding BorderBrush}"
					BorderThickness="1"
					Margin="0,5,0,5">
				<StackPanel HorizontalAlignment="Center"
							VerticalAlignment="Center">
					<Image Name="Image"
						   Source="{TemplateBinding ImageSource}"
						   Visibility="Visible"
						   Height="20"
						   Width="20"
						   Stretch="Fill"/>
					<Border Name="EmptyImage"
							Visibility="Collapsed"
							BorderBrush="Black"
                            BorderThickness="1"
							Height="20"
							Width="20"/>
				</StackPanel>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger SourceName="ImageHost" Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource VisualStudio2005_NavigationToolbarItem_OverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource VisualStudio2005_NavigationToolbarItem_OverBorderBrush}"/>
				<Setter Property="Cursor" Value="Hand"/>
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ImageHost" Property="Background" Value="{StaticResource VisualStudio2005_NavigationToolbarItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="ImageHost" Property="BorderBrush" Value="{StaticResource VisualStudio2005_NavigationToolbarItem_SelectedBorderBrush}"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsMouseOver" Value="True"/>
					<Condition Property="IsSelected" Value="True"/>
				</MultiTrigger.Conditions>
                <Setter TargetName="ImageHost" Property="Background" Value="{StaticResource VisualStudio2005_NavigationToolbarItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="ImageHost" Property="BorderBrush" Value="{StaticResource VisualStudio2005_NavigationToolbarItem_SelectedBorderBrush}"/>
			</MultiTrigger>
			<Trigger SourceName="Image" Property="Source" Value="{x:Null}">
				<Setter TargetName="EmptyImage" Property="Visibility" Value="Visible"/>
				<Setter TargetName="Image" Property="Visibility" Value="Collapsed"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<!-- NaviagationToolbarItem Style -->
	<Style  TargetType="{x:Type local:NavigationToolbarItem}">
		<Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource NaviagationToolbarItemTemplateKey}"/>	
    </Style>

    <LinearGradientBrush x:Key="SplitterBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFBBBBBB" Offset="0.013"/>
        <GradientStop Color="#FFD5D5D5" Offset="0.027"/>
        <GradientStop Color="#FFD5D5D5" Offset="0.067"/>
        <GradientStop Color="#FFE5E5E5" Offset="0.08"/>
        <GradientStop Color="#FFF0F0F0" Offset="0.616"/>
        <GradientStop Color="#FFE5E5E5" Offset="0.96"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SplitterPointBrush" Color="#FFA0A0A0"/>
    <!-- Splitter Template -->
    <ControlTemplate x:Key="GroupBarSplitterTemplateKey" TargetType="{x:Type local:GroupBarSplitter}">
        <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{StaticResource SplitterBackgroundBrush}">
            <Border Width="18" Height="2" HorizontalAlignment="Center">
                <Canvas>
                    <Line X1="1" Y1="1" X2="3" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="5" Y1="1" X2="7" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="9" Y1="1" X2="11" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="13" Y1="1" X2="15" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="17" Y1="1" X2="19" Y2="1" Stroke="White" StrokeThickness="2"/>

                    <Line X1="0" Y1="0" X2="2" Y2="0" Stroke="{StaticResource SplitterPointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="4" Y1="0" X2="6" Y2="0" Stroke="{StaticResource SplitterPointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="8" Y1="0" X2="10" Y2="0" Stroke="{StaticResource SplitterPointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="12" Y1="0" X2="14" Y2="0" Stroke="{StaticResource SplitterPointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="16" Y1="0" X2="18" Y2="0" Stroke="{StaticResource SplitterPointBrush}" StrokeThickness="2" Opacity="0.5"/>
                </Canvas>
            </Border>
        </Border>
    </ControlTemplate>
    <!--<ControlTemplate x:Key="GroupBarSplitterTemplateKey" TargetType="{x:Type local:GroupBarSplitter}">
		<Border Name="border"
				CornerRadius="2.5"
				Margin="1"
				BorderThickness="1"
				BorderBrush="Gray"
				Background="{TemplateBinding Background}"/>
		<ControlTemplate.Triggers>
			<Trigger Property="local:GroupBarSplitter.IsPressed" Value="True">
				<Setter TargetName="border" Property="Background" Value="LightBlue"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>-->
	
	<!-- Splitter Style -->
	<Style  TargetType="{x:Type local:GroupBarSplitter}">
		<Setter Property="MinWidth" Value="4"/>
		<Setter Property="MinHeight" Value="4"/>
		<Setter Property="Height" Value="6" />
		<Setter Property="Margin" Value="0"/>
		<Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template" Value="{StaticResource GroupBarSplitterTemplateKey}"/>
    </Style>
	
</ResourceDictionary>