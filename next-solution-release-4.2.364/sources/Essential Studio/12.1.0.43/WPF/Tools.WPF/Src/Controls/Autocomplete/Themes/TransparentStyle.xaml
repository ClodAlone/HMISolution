<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools">

    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!--Brushes start-->
    <SolidColorBrush x:Key="Black" Color="Black" />
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />
    <Thickness x:Key="XP.Margin" >1</Thickness>
    <Thickness x:Key="Vista.Margin">0</Thickness>
    <SolidColorBrush x:Key="White" Color="White" />
    <CornerRadius x:Key="ToggleButtonCornerRadius">0</CornerRadius>
    <!--End of Brushes-->

    <!-- Transparent Brushes -->
    <SolidColorBrush x:Key="AutoCompleteBackground" Color="#99FFFFFF" />

    <SolidColorBrush x:Key="AutoCompleteBorderBrush" Color="#99000000" />
    <SolidColorBrush x:Key="AutoCompleteForeground" Color="#FF000000" />

    <SolidColorBrush x:Key="TransparentToggleButtonBackground" Color="#7FFFFFFF" />

    <SolidColorBrush x:Key="TransparentToggleButtonInnerBorderBrush" Color="#CCFFFFFF" />

    <SolidColorBrush x:Key="TransparentToggleButtonBorderBrush" Color="#99000000" />

    <SolidColorBrush x:Key="TransparentInnerBorderBrush" Color="#CCFFFFFF" />

    <LinearGradientBrush x:Key="TransparentToggleButtonCheckedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF" />
        <GradientStop Color="#7EFFFFFF" Offset="0.032" />
        <GradientStop Color="#A5FFFFFF" Offset="0.649" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentToggleButtonCheckedBorderBrush" Color="#99000000" />

    <LinearGradientBrush x:Key="TransparentToggleButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1" />
        <GradientStop Color="#7EE5E5E5" Offset="0.968" />
        <GradientStop Color="#A5FFFFFF" Offset="0.504" />
        <GradientStop Color="White" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentToggleButtonMouseOverBorderBrush" Color="#99000000" />

    <SolidColorBrush x:Key="TransparentToggleButtonForeground" Color="#FF000000" />

    <SolidColorBrush x:Key="TransparentTextBoxHoverBorderBrush" Color="#FFFFFFFF" Opacity="0.5" />

    <SolidColorBrush x:Key="TransparentTextBoxBackground" Color="#FFA5A5A5" Opacity="0.40" />

    <SolidColorBrush x:Key="TransparentComboBoxItemBackground" Color="#D9FFFFFF" />

    <SolidColorBrush x:Key="TransparentComboBoxItemBorderBrush" Color="#99000000" />

    <SolidColorBrush x:Key="TransparentComboBoxItemInnerBorderBrush" Color="#CCFFFFFF" />

    <SolidColorBrush x:Key="TransparentComboBoxItemForeground" Color="#FF000000" />

    <LinearGradientBrush x:Key="TransparentComboBoxItemMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1" />
        <GradientStop Color="#7EE5E5E5" Offset="0.968" />
        <GradientStop Color="#A5FFFFFF" Offset="0.504" />
        <GradientStop Color="White" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentComboBoxItemMouseOverBorderBrush" Color="#99000000" />

    <SolidColorBrush x:Key="TransparentThumbBrush" Color="#FF434343" Opacity="0.5" />

    <!--Toggle Button Style-->
    <Style x:Key="ToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="{StaticResource XP.Margin}" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource TransparentToggleButtonBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource TransparentToggleButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TransparentToggleButtonForeground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ToggleButtonCornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border x:Name="InnerBodrer" BorderBrush="{StaticResource TransparentToggleButtonInnerBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter RecognizesAccessKey="True" Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" ClipToBounds="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource TransparentToggleButtonMouseOverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource TransparentToggleButtonCheckedBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <Style x:Key="ThumbStyle1" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#FFFFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFFFFFFF"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="Black"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="thumbBorderBrush" Color="#FF000000" Opacity=".6" />
    <!--Auto Complete Style-->
    <Style x:Key="TransparentAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource AutoCompleteBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource AutoCompleteBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AutoCompleteForeground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" CornerRadius="0" BorderThickness="{TemplateBinding BorderThickness}" TextBlock.Foreground="{TemplateBinding Foreground}">
                        <Grid Name="ContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>
                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <Border Name="PART_Cursor" Width="2" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" Background="Black" Height="16" />
                            <TextBox Name="PART_EditableTextBox" Grid.Column="0" Margin="1,0,1,0" VerticalAlignment="Center"
                                     Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                     FontStretch="{TemplateBinding FontStretch}" FontStyle="{TemplateBinding FontStyle}"
                                     FontWeight="{TemplateBinding FontWeight}"
                                     Padding="{TemplateBinding Padding}"
				                     Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1" SnapsToDevicePixels="True" Margin="0,-1,-1,-1"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource ToggleDropDownButtonStyle}">
                                <Path Name="PART_Arrow" Data="M0,0 L3,4 6,0" Fill="{StaticResource Black}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			                    IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
                                VerticalOffset="-1" HorizontalOffset="0" SnapsToDevicePixels="True" AllowsTransparency="True" Focusable="True" PopupAnimation="Slide">
                                <Border Background="{StaticResource TransparentComboBoxItemBackground}" BorderBrush="{StaticResource TransparentComboBoxItemBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                    <!--<Border x:Name="InnerBorder" Background="{StaticResource TransparentInnerBorderBrush}" BorderThickness="1">-->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="13"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ListBox Name="PART_Container" KeyboardNavigation.DirectionalNavigation="Cycle"  Grid.Row="0" SelectionMode="{TemplateBinding SelectionMode}" IsSynchronizedWithCurrentItem="True" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                             SnapsToDevicePixels="True" Width="{Binding Path=ActualWidth, ElementName=ContentGrid}" Height="{TemplateBinding MaxDropHeight}" Focusable="True">
                                        </ListBox>
                                        <Border BorderBrush="{StaticResource thumbBorderBrush}" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                            <Border.Background>
                                                <LinearGradientBrush  EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".6">
                                                    <GradientStop Color="#FFFAFAFA" Offset="0" />
                                                    <GradientStop Color="#FFDEDEDE" Offset="0.491" />
                                                    <GradientStop Color="#FFA5A5A5" Offset="0.531" />
                                                    <GradientStop Color="#FFB6B6B6" Offset="0.789" />
                                                    <GradientStop Color="#FFD5D5D5" Offset="0.996" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ThumbStyle1}" Grid.Row="1" />
                                        </Border>
                                    </Grid>
                                    <!--</Border>-->
                                </Border>
                            </Popup>
                            <Popup Name="HistoryPopup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
                                    IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
                                   SnapsToDevicePixels="True" AllowsTransparency="True" Focusable="True" PopupAnimation="Slide">
                                <Border Background="{StaticResource TransparentComboBoxItemBackground}" BorderBrush="{StaticResource TransparentComboBoxItemBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="13"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ListBox Name="PART_HistoryContainer" KeyboardNavigation.DirectionalNavigation="Cycle"  BorderThickness="0" Grid.Row="0" SelectionMode="{TemplateBinding SelectionMode}" IsSynchronizedWithCurrentItem="True" Background="Transparent" BorderBrush="Transparent"
                                         SnapsToDevicePixels="True" Height="{TemplateBinding HistoryListHeight}" Width="{TemplateBinding ActualWidth}" Focusable="True">
                                        </ListBox>
                                        <Border BorderBrush="{StaticResource thumbBorderBrush}" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                            <Border.Background>
                                                <LinearGradientBrush  EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".6">
                                                    <GradientStop Color="#FFFAFAFA" Offset="0" />
                                                    <GradientStop Color="#FFDEDEDE" Offset="0.491" />
                                                    <GradientStop Color="#FFA5A5A5" Offset="0.531" />
                                                    <GradientStop Color="#FFB6B6B6" Offset="0.789" />
                                                    <GradientStop Color="#FFD5D5D5" Offset="0.996" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Thumb x:Name="HistoryThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ThumbStyle1}" Grid.Row="1" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource TransparentToggleButtonCheckedBackground}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="EnableDropDown" Value="false">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate   TargetType="{x:Type local:AutoComplete}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}" TextBlock.Foreground="{TemplateBinding Foreground}">
                                <Grid Focusable="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                                    <Border Name="PART_Cursor" Width="2" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left"
							                Background="White" Height="16" />
                                    <TextBox Name="PART_EditableTextBox" Grid.Column="0" Margin="0" Background="Transparent" VerticalAlignment="Center"
						                     BorderThickness="0" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
						                     FontSize="{TemplateBinding FontSize}" FontStretch="{TemplateBinding FontStretch}" FontStyle="{TemplateBinding FontStyle}"
						                     FontWeight="{TemplateBinding FontWeight}"
                                             Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                                    <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					                       IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
					                       VerticalOffset="-2" HorizontalOffset="1" SnapsToDevicePixels="True" AllowsTransparency="True"
					                       Focusable="True" PopupAnimation="Slide">
                                        <Border>
                                            <Grid Background="{TemplateBinding Background}">
                                                <ListBox Grid.Row="0" Margin="1" Name="PART_Container" SelectionMode="{TemplateBinding SelectionMode}"
							                      IsSynchronizedWithCurrentItem="True" SnapsToDevicePixels="True" Height="{TemplateBinding MaxDropHeight}" Focusable="True"
							                      Width="{Binding Path=ActualWidth, ElementName=PART_EditableTextBox}">
                                                </ListBox>
                                                <Thumb x:Name="ContainerThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ThumbStyle1}" />
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource TransparentAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>