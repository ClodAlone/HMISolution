    <!--Brushes-->

    <SolidColorBrush x:Key="SliderBarFill" Color="#FFBCC7D8" />

    <LinearGradientBrush x:Key="RepeatButtonMouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFBEDBE" Offset="0.099" />
        <GradientStop Color="#FFFAE9B6" Offset="0.317" />
        <GradientStop Color="#FFFBDE89" Offset="0.337" />
        <GradientStop Color="#FFFBDE89" Offset="0.397" />
        <GradientStop Color="#FFFED04F" Offset="0.417" />
        <GradientStop Color="#FFFED976" Offset="0.96" />
    </LinearGradientBrush>

    <SolidColorBrush  x:Key="RepeatButtonLeftBorder" Color="#FF2B3C59" />

    <LinearGradientBrush x:Key="RangeSliderRepeatButtonBackgroundGradientPressedBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE8A6" Offset="0" />
        <GradientStop Color="#FFFFE8A6" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush  x:Key="RangeSliderRepeatButtonBackgroundGradientPressedBorderBrushKey" Color="#FFE9C356" />

    <LinearGradientBrush x:Key="RangeSliderRepeatButtonMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF2" Offset="0.027" />
        <GradientStop Color="#FFFFF4D1" Offset="0.462" />
        <GradientStop Color="#FFFFEEBA" Offset="0.471" />
        <GradientStop Color="#FFFFEEBA" Offset="0.52" />
        <GradientStop Color="#FFFFE8A6" Offset="0.529" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="RepeatButtonLeft" RadiusY="0.627" RadiusX="0.627">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="#FF697A97" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="RangeSliderRepeatButtonMouseOverBorderBrushKey" Color="#FFE9CC76" />

    <LinearGradientBrush x:Key="HorizontalThumbBackground"  EndPoint="0.873,0.603" MappingMode="RelativeToBoundingBox" StartPoint="-0.049,0.62">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="#FF697A97" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HorizontalthumbBorderBrush" Color="#FF53657C" />

    <LinearGradientBrush x:Key="VerticalThumbBackground"  EndPoint="0.873,0.603" MappingMode="RelativeToBoundingBox" StartPoint="-0.049,0.62">
        <GradientStop Color="White" Offset="0" />
        <GradientStop Color="#FF697A97" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="VerticalthumbBorderBrush" Color="#FF53657C" />

    <!--Custom Template for Horizontal Thumb-->
    <ControlTemplate x:Key="ThumbTemplateKey" TargetType="Thumb">
        <Grid>
            <Path Stretch="Fill" x:Name="paththumb" Stroke="{StaticResource HorizontalthumbBorderBrush}" Fill="{StaticResource HorizontalThumbBackground}" StrokeThickness="1"   Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z">
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumb" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush  RadiusY="0.627" RadiusX="0.627">
                            <GradientStop Color="#FFFFFBF1" Offset="0.006" />
                            <GradientStop Color="#FFFFF4D3" Offset="0.42" />
                            <GradientStop Color="#FFFFECB5" Offset="0.563" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="paththumb" Property="Stroke">
                    <Setter.Value>

                        <SolidColorBrush  Color="#FFE6C569" />
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="paththumb" Property="Fill">
                    <Setter.Value>
                        <RadialGradientBrush  RadiusY="0.627" RadiusX="0.627">
                            <GradientStop Color="#FFFFFBF1" Offset="0.006" />
                            <GradientStop Color="#FFFFF4D3" Offset="0.42" />
                            <GradientStop Color="#FFFFECB5" Offset="0.563" />
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="paththumb" Property="Stroke">
                    <Setter.Value>

                        <SolidColorBrush  Color="#FFE6C569" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

