<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="VisualStudio2005_GroupBar_BorderBrush" Color="Black"/>
	<LinearGradientBrush x:Key="VisualStudio2005_GroupBar_HeaderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFDDDCCB"/>
				<GradientStop Offset="1" Color="#FFC4C1B0"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005_GroupBar_Content" Color="#FFE6E4D4"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="VisualStudio2005_GroupBarItem_NormalStateBrush" 
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFDDDCCB"/>
			<GradientStop Offset="1" Color="#FFC4C1B0"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005_GroupBarItem_SelectedBrush" Color="#FFE1E6E8"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupBarItem_BorderBrush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupBarItem_SelectedBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_SeparatorBrush" Color="#FFDEDCCB"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="VisualStudio2005_GroupView_Background" Color="#FFE6E4D4"/>

	<!-- GroupViewItem -->
	<Color x:Key="VisualStudio2005_GroupViewItem_OverBackgroundColor">#FFC1D2EE</Color>
	<Color x:Key="VisualStudio2005_GroupViewItem_PressedBackgroundColor">#FF98B5E2</Color>
	<Color x:Key="VisualStudio2005_GroupViewItem_SelectedBackgroundColor">#FFE1E6E8</Color>
	<Color x:Key="VisualStudio2005_GroupViewItem_SelectedOverBackgroundColor">#FF98B5E2</Color>

	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_BackgroundBrush" Color="#FFE6E4D4"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_BorderBrush" Color="#FFE6E4D4"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_OverBackgroundBrush" Color="#FFC1D2EE"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_OverBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_PressedBackgroundBrush" Color="#FF98B5E2"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_PressedBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_SelectedBackgroundBrush" Color="#FFE1E6E8"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_SelectedBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_GroupViewItem_SelectedOverBackgroundBrush" Color="#FF98B5E2"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="VisualStudio2005_NavigationToolbar_BackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFDDDCCB"/>
				<GradientStop Offset="1" Color="#FFC4C1B0"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_OverBrush" Color="#FFC1D2EE"/>
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_OverBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_PressedBackgroundBrush" Color="#FF98B5E2"/>
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_PressedBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_SelectedBackgroundBrush" Color="#FFE1E6E8"/>
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_SelectedBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_NavigationToolbarItem_SelectedOverBackgroundBrush" Color="#FF98B5E2"/>

	<!-- MenuItem -->
	<LinearGradientBrush x:Key="VisualStudio2005_MenuItem_Brush"
						 StartPoint="0,0"
						 EndPoint="1,0">
		<GradientStop Color="#FFC9C498" Offset="1"/>
		<GradientStop Color="#FFFCFBF8" Offset="0"/>
		<GradientStop Color="#FFD1CCB7" Offset="0.875"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005_MenuItem_OverBrush" Color="#FFC1D2EE"/>
	<SolidColorBrush x:Key="VisualStudio2005_MenuItem_OverBorderBrush" Color="#FF316AC5"/>
	<SolidColorBrush x:Key="VisualStudio2005_MenuItem_SelectedBackgroundBrush" Color="#FFE1E6E8"/>
	<SolidColorBrush x:Key="VisualStudio2005_MenuItem_SelectedOverBackgroundBrush" Color="#FF98B5E2"/>
	<SolidColorBrush x:Key="VisualStudio2005_MenuItem_SeparatorBrush" Color="#FFC5C2B8"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="VisualStudio2005_Menu_BackgroundBrush" Color="#FFE9E7D8"/>
	<SolidColorBrush x:Key="VisualStudio2005_Menu_BorderBrush" Color="#FFACA899"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="VisualStudio2005_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005_MenuText_DisabledBrush" Color="Gray"/>
	
	<!-- Text -->
	<SolidColorBrush x:Key="VisualStudio2005_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005_ItemText_Brush" Color="Black"/>

	<!-- Royal, Zuna and Aero resources-->
	<LinearGradientBrush x:Key="Royal.GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FF7DA5E0"/>
			<GradientStop Offset="1" Color="#FF3A68B0"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Royal.GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FF7DA5E0"/>
			<GradientStop Offset="1" Color="#FF6FA1D9"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
    <SolidColorBrush x:Key="Royale_CollapseArrowColor" Color="Black"/>
    <SolidColorBrush x:Key="Royale_PopupBorderFillColor" Color="#A5C4EE"/>
    <SolidColorBrush x:Key="Royale_NavigationPaneColor" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="Royale_NavigationPaneMouseOverColor" Color="#C2CFE5"/>
    <SolidColorBrush x:Key="Royale_NavigationPaneTextColor" Color="Black"/>
    <SolidColorBrush x:Key="Royale_NavigationPaneBorderColor" Color="#002D96"/>
    <SolidColorBrush x:Key="Royale_NavigationPaneCheckedBorderColor" Color="#335EA8"/>

    <SolidColorBrush x:Key="Luna.Normalcolor_CollapseArrowColor" Color="#000000"/>
    <SolidColorBrush x:Key="Luna.Normalcolor_PopupBorderFillColor" Color="#CECCBB"/>
    <SolidColorBrush x:Key="Luna.Normalcolor_NavigationPaneColor" Color="#E6E4D4"/>
    <SolidColorBrush x:Key="Luna.Normalcolor_NavigationPaneMouseOverColor" Color="#E1E6E8"/>
    <SolidColorBrush x:Key="Luna.Normalcolor_NavigationPaneTextColor" Color="#000000"/>
    <SolidColorBrush x:Key="Luna.Normalcolor_NavigationPaneBorderColor" Color="#000000"/>
    <SolidColorBrush x:Key="Luna.Normalcolor_NavigationPaneCheckedBorderColor" Color="#316AC5"/>

    <LinearGradientBrush x:Key="Luna.GroupBarItemMEToggleButtonBackground" EndPoint="1,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
            <GradientStop Offset="1" Color="#FFC0B7A6"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Luna.ToggleButtonBorderBrush" Color="#FF7898B5"/>
    <SolidColorBrush x:Key="Luna.ToggleButtonBackground" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Luna.ToggleButtonPathFill" Color="#FF000000"/>
    <SolidColorBrush x:Key="Luna.NavigationCheckBoxBackground" Color="#FFBD69"/>
    <SolidColorBrush x:Key="Luna.NavigationCheckBoxBorder" Color="#FFAB3F"/>
    <SolidColorBrush x:Key="Luna.GroupBarSplitterIsPressed" Color="#FFADD8E6"/>

    <Thickness x:Key="DefaultGroupViewItemMargin">5</Thickness>
    <Thickness x:Key="OfficeGroupViewItemMargin">1</Thickness>

    <sys:Double x:Key="DefaultNavigationMenuDefaultWidth">16</sys:Double>
    <sys:Double x:Key="NavigationMenuDefaultWidth">18</sys:Double>
    <sys:Double x:Key="NavigationItemDefaultWidth">22</sys:Double>

    
</ResourceDictionary>