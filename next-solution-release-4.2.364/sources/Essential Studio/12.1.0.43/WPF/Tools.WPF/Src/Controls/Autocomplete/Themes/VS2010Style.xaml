<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"    
                    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
	  >

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <LinearGradientBrush x:Key="VS2010.MouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF2" Offset="0" />
        <GradientStop Color="#FFFFF4D1" Offset="0.414" />
        <GradientStop Color="#FFFFE8A6" Offset="0.523" />
        <GradientStop Color="#FFFFE8A6" Offset="0.936" />
        <GradientStop Color="#FFFFEFC1" Offset="0.968" />
        <GradientStop Color="#FFFAFBFC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MouseOverBorderBrush" StartPoint="0,0" EndPoint="0,20" MappingMode="Absolute">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="0.05" />
            <GradientStop Color="#FFFFE69E" Offset="0.07" />
            <GradientStop Color="#FFFFE69E" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Transparent" Color="Transparent" />
    <SolidColorBrush x:Key="VS2010.Background" Color="#FFF1F3F8" />

    <Thickness x:Key="XP.Margin" >1</Thickness>
    <Thickness x:Key="Vista.Margin">0</Thickness>
    <SolidColorBrush x:Key="White" Color="White" />
    <SolidColorBrush x:Key="VS2010.ButtonArrowFill" Color="#FF1B293E" />
    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />
    <SolidColorBrush x:Key="VS2010.BorderBrush" Color="#FF8591A2" />
    <SolidColorBrush x:Key="Default.Foreground" Color="Black" />

    <LinearGradientBrush x:Key="VS2010.HighlightBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF9E5" Offset="0.278" />
        <GradientStop Color="#FFFCEDC1" Offset="0.98" />
        <GradientStop Color="#FFF2DA98" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Black" Color="Black" />
    <SolidColorBrush x:Key="VS2010.HighlightBorderBrush" Color="#FFE8C86F" />

    <SolidColorBrush x:Key="VS2010.PressedBackground" Color="#FFFFE8A6" />
    <SolidColorBrush x:Key="VS2010.PressedBorder" Color="#FFE5C365" />

    <LinearGradientBrush x:Key="PressedBackgroundBrushKey.VS2010" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCE4A0" Offset="0" />
        <GradientStop Color="#FFFFE8A6" Offset="0.021" />
        <GradientStop Color="#FFFFE8A6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PressedBorderBrushKey.VS2010" Color="#FFD2B564" />

    <SolidColorBrush x:Key="Default.FocusedBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Default.PressedBackground" Color="#FFFFFFFF" />

    <Style x:Key="OfficeToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource VS2010.Background}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}" Margin="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter RecognizesAccessKey="True"
                              Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ClipToBounds="True" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource VS2010.PressedBorder}" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource VS2010.MouseOverBorderBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="Green" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource VS2010.PressedBorder}" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource VS2010.PressedBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <Style x:Key="VS2010ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFC9D2E1"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FF60728C"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VS2010AutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource VS2010.Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Default.Foreground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{StaticResource Default.Foreground}">
                        <Grid Name="ContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="10" />
                            </Grid.ColumnDefinitions>

                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0"
                 Margin="0"
				 VerticalAlignment="Center"
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}"
                 BorderThickness="0"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
                 Padding="{TemplateBinding Padding}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1"
                              SnapsToDevicePixels="True"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource OfficeToggleDropDownButtonStyle}"
>
                                
                                <Path Name="PART_Arrow"
                Data="M0,0 L3,4 6,0"
                Fill="{StaticResource VS2010.ButtonArrowFill}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               VerticalOffset="-2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">
                                <Border  BorderThickness="1" BorderBrush="#FF9BA7B7">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="13"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ListBox Name="PART_Container"   BorderThickness="0" KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}"   Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}"
                   Focusable="True">
                                        </ListBox>
                                        <Border BorderBrush="#FFC9D2E1" Background="#FFBCC7D8" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">

                                            <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource VS2010ThumbStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                            <Popup Name="HistoryPopup"
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Border BorderThickness="1" BorderBrush="#FF9BA7B7">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="13"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ListBox Name="PART_HistoryContainer"   BorderThickness="0"  KeyboardNavigation.DirectionalNavigation="Cycle"
                              SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"
			       Height="{TemplateBinding HistoryListHeight}"
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True">
                                        </ListBox>
                                        <Border BorderBrush="#FFC9D2E1" Background="#FFBCC7D8" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                            <Thumb x:Name="HistoryThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource VS2010ThumbStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource VS2010.PressedBorder}" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.PressedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource VS2010.MouseOverBorderBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{StaticResource MouseOverBorderBrush}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderThickness" Value="1,0,0,0" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>

                        <Trigger SourceName="PART_CheckButton" Property="IsChecked" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource VS2010.PressedBorder}" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Default.PressedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource VS2010.PressedBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{StaticResource VS2010.PressedBorder}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderThickness" Value="1,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource VS2010AutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>