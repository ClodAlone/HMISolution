<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:classic="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Classic"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <!--Brushes-->

    <LinearGradientBrush x:Key="WizardControlBackgroundBrush.Aero"  StartPoint="0.500001,-0.00404378" EndPoint="0.500001,0.998081">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFDBEFFF" Offset="0"/>
            <GradientStop Color="#FFFFFFFF" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WizardNavigationAreaBrush.Aero" StartPoint="0.00486165,0.500009" EndPoint="0.982119,0.500009">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFF8FDFF" Offset="0"/>
            <GradientStop Color="#FFBCD8EF" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WizardBannerBackgroundBrush.Aero" StartPoint="0.499998,-0.00306613" EndPoint="0.499998,0.993851">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FF85C5E3" Offset="0"/>
            <GradientStop Color="#FF3593C0" Offset="0.498993"/>
            <GradientStop Color="#FF1072AF" Offset="0.5"/>
            <GradientStop Color="#FF02AFF4" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WizardBannerBackgroundBrushExterior.Aero"  StartPoint="1,1" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FF85C5E3" Offset="0"/>
            <GradientStop Color="#FF3593C0" Offset="0.498993"/>
            <GradientStop Color="#FF1072AF" Offset="0.5"/>
            <GradientStop Color="#FF02AFF4" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WizardBorderBrush.Aero" Color="#FF93B8D9"/>

    <RelativeSource x:Key="wizardAncestor" Mode="FindAncestor" AncestorType="{x:Type syncfusion:WizardControl}"/>
    <syncfusion:WizardPageVisibility x:Key="pageVisibilityConverter"/>
    <syncfusion:VisibilityResolver x:Key="visibilityResolver"/>

    <!--Styles-->



    <Style x:Key="pageButtonVisibilityResolver" TargetType="{x:Type syncfusion:WizardPage}">
        <Setter Property="HelpVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="HelpVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="HelpVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="CancelVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="CancelVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="CancelVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BackVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="BackVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="BackVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="NextVisibility">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="NextVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="NextVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="FinishVisibility" >
            <Setter.Value>
                <MultiBinding Converter="{StaticResource visibilityResolver}">
                    <Binding RelativeSource="{StaticResource wizardAncestor}" Path="FinishVisible" />
                    <Binding RelativeSource="{x:Static RelativeSource.Self}"  Path="FinishVisible" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syncfusion:WizardNavigationArea}">
        <Setter Property="BorderBrush" Value="{StaticResource WizardBorderBrush.Aero}"/>
        <Setter Property="Background" Value="{StaticResource WizardNavigationAreaBrush.Aero}"/>
        <Setter Property="BorderThickness" Value="0,2,0,0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:WizardNavigationArea}">
                    <classic:ClassicBorderDecorator BorderStyle="Etched" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <StackPanel Background="{TemplateBinding Background}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Name="PART_HelpButton" MinWidth="75" Command="syncfusion:WizardCommands.Help" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=HelpText}" Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.HelpVisibility)}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Name="PART_CancelButton" Margin="0,0,7,0" MinWidth="75" Command="syncfusion:WizardCommands.Cancel" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=CancelText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.CancelVisibility)}"
                                            />
                                    <Button Name="PART_BackButton" MinWidth="75" Command="syncfusion:WizardCommands.Previous" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=BackText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.BackVisibility)}"
                                            />
                                    <Button Name="PART_NextButton" Margin="2,0,0,0" MinWidth="75" Command="syncfusion:WizardCommands.Next" IsDefault="{Binding RelativeSource={StaticResource wizardAncestor}, Path=NextFocused}" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=NextText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.NextVisibility)}"
                                            />
                                    <Button Name="PART_FinishButton" Margin="7,0,0,0" MinWidth="75" Command="syncfusion:WizardCommands.Finish" IsDefault="{Binding RelativeSource={StaticResource wizardAncestor}, Path=FinishFocused}" Content="{Binding RelativeSource={StaticResource wizardAncestor}, Path=FinishText}" 
                                            Visibility="{Binding RelativeSource={StaticResource wizardAncestor}, Path=(syncfusion:WizardControl.SelectedWizardPage).(syncfusion:WizardPage.FinishVisibility)}"
                                            />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </classic:ClassicBorderDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

