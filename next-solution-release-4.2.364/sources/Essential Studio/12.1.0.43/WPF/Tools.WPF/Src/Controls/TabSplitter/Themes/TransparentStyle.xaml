    <SolidColorBrush x:Key="ButtonCheckedBorderBrush" Color="White" Opacity="0.6"/>
    <Style x:Key="{x:Type local:TabSplitterItem}" TargetType="{x:Type local:TabSplitterItem}" >
        <Setter Property="TextElement.Foreground" 
				Value="{StaticResource TransparentThemeForegroundBrush}"/>

        <Setter Property="FrameworkElement.FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="IFrameworkInputElement">
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <!--<ControlTemplate>
                                <Rectangle Stroke="#FF000000" StrokeThickness="1" StrokeDashArray="1 2" Margin="3,3,3,1" SnapsToDevicePixels="True" />
                            </ControlTemplate>-->
                            <x:Null/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource TransparentThemeForegroundBrush}"/>
        <Setter Property="Margin" Value="3,2,3,0"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,2,2,0"/>
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" >
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabSplitterItem}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"  CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" Background="{TemplateBinding Background}" MinHeight="18" Name="Bd">
                        <Border BorderThickness="1" x:Name="innerborder" CornerRadius="4,4,0,0">

                            <DockPanel x:Name="PART_DockPanel" LastChildFill="True">
                                <Image x:Name="PART_Image" Source="{TemplateBinding local:TabSplitter.Image}" Stretch="None" Margin="0,0,0,4" SnapsToDevicePixels="True" VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                                <ContentPresenter x:Name="Content" ContentSource="Header"
								Margin="6,2,10,2" TextBlock.Foreground="{TemplateBinding Foreground}"
								  RecognizesAccessKey="True" 
								  Content="{TemplateBinding HeaderedContentControl.Header}"
								  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"
								  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                            </DockPanel>
                        </Border>

                    </Border>
                    <ControlTemplate.Triggers>
                        <!--End Initial section-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FrameworkElement.Margin" Value="2,2,0,0"/>
                        </MultiDataTrigger>
                        <!--IsSelected Section-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="FrameworkElement.Margin" Value="-12,-2,0,-1"/>-->
                        </MultiDataTrigger>
                        <!--<MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FrameworkElement.Margin" Value="0,-2,-2,-1"/>
                        </MultiDataTrigger>-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, ElementName=Bd}" Value="True"/>
                                <Condition Binding="{Binding Path=HotTrackingEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="Panel.Background" TargetName="Bd" Value="{Binding Path=(local:TabControlExt.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>-->
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, ElementName=Bd}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="#CCFFFFFF"/>

                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemExtHoverBorderBrush}"/>
                        </MultiDataTrigger>

                        <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="#CCFFFFFF"/>
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemSelectedBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemSelectedBorderBrush}"/>
                            <!--<Setter Property="Margin" TargetName="Bd" Value="0,0,0,-1"/>-->

                            <Setter Property="TextElement.FontWeight" TargetName="Content"
						Value="{Binding Path=SelectedItemFontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" />
                            <!--Value="SemiBold"/>-->
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemSelectedBrush}"/>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="#CCFFFFFF"/>


                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemExtHoverBorderBrush}"/>

                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, ElementName=Bd}" Value="True"/>
                                <Condition Binding="{Binding Path=HotTrackingEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                            </MultiDataTrigger.Conditions>


                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource TransparentThemeTabItemExtHoverBorderBrush}"/>
                        </MultiDataTrigger>
                        <!--End VS 2008 specifies section-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SplitScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <!--<Setter Property="Visibility" Value="Visible"/>-->
        <Setter Property="Template" >
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <shared:Border3D x:Name="PART_Border" VerticalAlignment="Center" HorizontalAlignment="Center"
				            Margin="1,0,1,0"
                            Padding="4,1,1,1"
                            Width="15"
                            Height="15"
                            BorderThickness="1"
                            BorderBrush="Transparent" 
				            Opacity="{TemplateBinding Opacity}"
				            IsEnabled="{TemplateBinding IsEnabled}"
				            SnapsToDevicePixels="True"
				            CornerRadius="0">
                        <Canvas Width="8" Height="7">
                            <Path Data="M0,0L4,3.5 0,7" HorizontalAlignment="Center" Stroke="{StaticResource TransparentThemePathFillBrush}" Fill="{StaticResource TransparentThemePathFillBrush}" Name="PART_Path1" VerticalAlignment="Center"/>
                            <Path Data="M4,0L8,3.5 4,7" HorizontalAlignment="Center" Stroke="{StaticResource TransparentThemePathFillBrush}" Fill="{StaticResource TransparentThemePathFillBrush}" Name="PART_Path2" VerticalAlignment="Center"/>
                        </Canvas>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="PrevTab">
                            <!--<Setter TargetName="PART_Border" Property="Background" Value="Red"/>-->
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="NextTab">
                            <!--<Setter TargetName="PART_Border" Property="Background" Value="Green"/>-->
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource ButtonPressedBackgroundBrush}"/>

                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{StaticResource ButtonPressedBorderBrush}"/>

                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource ButtonHoverBackgroundBrush}"/>

                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{StaticResource ButtonHoverBorderBrush}"/>

                        </Trigger>


                        <DataTrigger Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Bottom">
                            <Setter Property="FlowDirection" Value="RightToLeft"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style TargetType="{x:Type local:SplitterPage}">
        <Setter Property="FrameworkElement.FocusVisualStyle" >
            <Setter.Value>
                <Style TargetType="IFrameworkInputElement">
                    <Setter Property="Control.Template" Value="{x:Null}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="Foreground" Value="{StaticResource TransparentThemeForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource TransparentMenuItemHoverBorderBrush}"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SplitterPage}">
                    <local:VS2008SplitterItemBorder   Name="Bd" BorderBrush="{TemplateBinding BorderBrush}"
										Background="Transparent"  Margin="0,0,0,-1"
                    ToolTip="{TemplateBinding HeaderedContentControl.Header}">
                        <DockPanel x:Name="PART_DockPanel" LastChildFill="True">
                            <Image x:Name="PART_Image" Source="{TemplateBinding Image}" Width="11" Height="11"  Margin="0,0,0,4" SnapsToDevicePixels="True" VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                            <ContentPresenter     TextBlock.Foreground="{TemplateBinding Foreground}"   ContentSource="Header" x:Name="Content" Margin="5,0,10,0"
                                          RecognizesAccessKey="True" 
                                          Content="{TemplateBinding HeaderedContentControl.Header}"
                                          ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />

                        </DockPanel>
                    </local:VS2008SplitterItemBorder >
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Bottom">
                            <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,1,0"/>
                            <Setter Property="Margin" TargetName="Content" Value="5,0,0,1"/>
                            <Setter Property="Margin" TargetName="PART_Image" Value="5,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="PART_DockPanel"/>
                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                            <Setter Property="Margin" TargetName="Bd" Value="0,0,0,-0.7"/>
                            <Setter Property="LayoutTransform" TargetName="PART_DockPanel">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <Trigger Property="Image" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="PART_Image" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True">

                            <Setter Property="TextElement.Foreground"    Value="{Binding Path=SelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:TabSplitter}}}"/>

                            <Setter Property="Background"  Value="{Binding Path=SelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:TabSplitter}}}"/>
                            <Setter Property="TextElement.FontWeight" TargetName="Content" Value="Thin"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Right"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="PART_DockPanel"/>
                            <Setter Property="Margin" Value="6,-2,10,0" TargetName="Content"/>

                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Left"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" TargetName="Bd" Value="0,0.5,0,0"/>
                            <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,1,0"/>
                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="PART_DockPanel"/>
                            <Setter Property="Height" Value="18" TargetName="Bd"/>
                            <Setter Property="Margin" Value="6,4,10,1" TargetName="Content"/>
                            <Setter Property="Margin" TargetName="PART_Image" Value="10,10,0,0"/>
                            <Setter TargetName="Content" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="LayoutTransform" TargetName="PART_DockPanel">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Right"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,1,0"/>
                            <!--<Setter Property="Margin" Value="-2,1,-8,0"/>-->
                            <Setter Property="Content" TargetName="Content" Value=" ">
                            </Setter>
                        </MultiDataTrigger>
                        <!--RotateTextWhenVertical = FALSE-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Bottom"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="Margin" Value="0,2,-10,0"/>-->
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Left"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="Margin" Value="-2,0,-8,0"/>-->
                            <Setter Property="Content" TargetName="Content" Value=" ">
                            </Setter>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Top"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FrameworkElement.Margin" Value="2,2,0,0"/>
                        </MultiDataTrigger>

                        <!--<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
					<Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Right"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="FrameworkElement.Margin" Value="2,0,0,0"/>
			</MultiDataTrigger>-->

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Bottom"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="FrameworkElement.Margin" Value="0,2,2,0"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Left"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="FrameworkElement.Margin" Value="-2,0,0,0"/>-->
                        </MultiDataTrigger>

                        <!--IsSelected Section-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Top"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="FrameworkElement.Margin" Value="-12,2,0,-1"/>-->
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Top"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="FrameworkElement.Margin" Value="0,2,1,-1"/>-->
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Right"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="FrameworkElement.Margin" Value="-2,0,-12,-1"/>-->

                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Path=(local:SplitterPage.TabStripPlacement),RelativeSource={RelativeSource Self}}" Value="Bottom"/>
                            </MultiDataTrigger.Conditions>
                            <!--<Setter Property="FrameworkElement.Margin" Value="2,2,-12,-1"/>-->
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
