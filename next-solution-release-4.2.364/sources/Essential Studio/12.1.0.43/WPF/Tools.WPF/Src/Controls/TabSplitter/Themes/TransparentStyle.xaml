    <SolidColorBrush Color="#FF3D3D3D" Opacity="0.5" x:Key="TranspaentThemeMenuButtonHoverBorderBrush"/>
    <LinearGradientBrush Opacity="0.5" x:Key="TransparentThemeMenuButtonPressedBrush" EndPoint="0.5,1" StartPoint="0.5,0">
