    <!--Custom Template for Horizontal Thumb-->

    <ControlTemplate x:Key="ThumbTemplateVertical" TargetType="Thumb">
        <Grid x:Name="thumb" Height="15" VerticalAlignment="Top" SnapsToDevicePixels="True">
            <Path Stretch="Fill"  Fill="White"    SnapsToDevicePixels="True"  x:Name="paththumb"  StrokeThickness="0.75"   Data="M0.12499999,-0.00018239323 L0.125,9.25 L5.3268228,13.957948 L10.75,9 L10.75,0 z">
                <Path.Stroke>
                    <LinearGradientBrush EndPoint="0.487,1.006" StartPoint="0.5,0">
                        <GradientStop Color="#FF787878" Offset="0" />
                        <GradientStop Color="#FF858585" Offset="1" />
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <Path Stretch="Fill" x:Name="paththumb1"  SnapsToDevicePixels="True"  Margin="1"  Stroke="White"   StrokeThickness="1"   Data="M0.125,0.125 L0.125,9.25 L5.2032738,13.628232 L10.75,9 L10.75,0 z">
                <Path.Fill>
                    <LinearGradientBrush EndPoint="1.029,0.257" StartPoint="0,0.257">
                        <GradientStop Color="#FFE0E0E0" Offset="0" />
                        <GradientStop Color="#FFD2D2D2" Offset="0.083" />
                        <GradientStop Color="#FFF1F1F1" Offset="0.543" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Grid.LayoutTransform>
                <RotateTransform Angle="-90"></RotateTransform>
            </Grid.LayoutTransform>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Height" TargetName="thumb" Value="40" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumb1" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="1.029,0.257" StartPoint="0,0.257">
                            <GradientStop Color="#FFDDF1FB" Offset="0" />
                            <GradientStop Color="#FFAEDEF8" Offset="0.147" />
                            <GradientStop Color="#FFE6F4FC" Offset="0.69" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="paththumb" Property="Stroke">
                    <Setter.Value>

                        <LinearGradientBrush EndPoint="0.487,1.006" StartPoint="0.5,0">
                            <GradientStop Color="#FF4F8BB8" Offset="0" />
                            <GradientStop Color="#FF93B3CA" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="paththumb1" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="1.029,0.257" StartPoint="0,0.257">
                            <GradientStop Color="#FFDDF1FB" Offset="0" />
                            <GradientStop Color="#FFAEDEF8" Offset="0.147" />
                            <GradientStop Color="#FFE6F4FC" Offset="0.69" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="paththumb" Property="Stroke">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.487,1.006" StartPoint="0.5,0">
                            <GradientStop Color="#FF4F8BB8" Offset="0" />
                            <GradientStop Color="#FF93B3CA" Offset="1" />
