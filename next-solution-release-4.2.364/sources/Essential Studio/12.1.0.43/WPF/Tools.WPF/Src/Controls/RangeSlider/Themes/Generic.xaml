                            <GradientStop Color="#FF4F8BB8" Offset="1" />
                            <GradientStop Color="#FF93B3CA" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="BackgroundGradient1" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.48,0.069" StartPoint="0.461,0.99">
                            <GradientStop Color="#FFDDF1FB" Offset="0" />
                            <GradientStop Color="#FFAEDEF8" Offset="0.147" />
                            <GradientStop Color="#FFE6F4FC" Offset="0.69" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>

            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="BackgroundGradient" Property="Stroke">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.486999988555908,1.00600004196167" StartPoint="0.5,0">
                            <GradientStop Color="#FF376B92" Offset="0" />
                            <GradientStop Color="#FF7D9BB2" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="BackgroundGradient1" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.471,0.059" StartPoint="0.471,0.985">
                            <GradientStop Color="#FF62A9CF" Offset="0" />
                            <GradientStop Color="#FF53A1CC" Offset="0.033" />
                            <GradientStop Color="#FF64B2DD" Offset="0.233" />
                            <GradientStop Color="#FF99D3F1" Offset="0.433" />
                            <GradientStop Color="#FFD5EDF9" Offset="1" />
