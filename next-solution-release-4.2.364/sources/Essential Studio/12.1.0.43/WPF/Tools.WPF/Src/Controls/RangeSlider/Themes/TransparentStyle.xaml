    <ControlTemplate x:Key="RepeatButtonTemplate4" TargetType="RepeatButton">
        <Grid>
            <Border x:Name="Background" CornerRadius="12" Opacity="1" Background="{StaticResource RepeatButtonBackground}" BorderThickness="1" BorderBrush="{StaticResource ButtonAdvBorderBrush}" SnapsToDevicePixels="True">
                <Border CornerRadius="12"  BorderThickness="1" BorderBrush="{StaticResource ButtonInnerBorderBrush}"></Border>
