<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
                    xmlns:sample="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <SolidColorBrush Color="White" Opacity="0.495" x:Key="RepeatButtonBackground" />
    <SolidColorBrush x:Key="RepeatButtonBorder" Color="Black" Opacity="0.495" />
    <LinearGradientBrush  x:Key="RepeatButtonMouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EF6F8F4" Offset="1" />
        <GradientStop Color="#7EEAF0E6" Offset="0.968" />
        <GradientStop Color="#A5CBD2B2" Offset="0.604" />
        <GradientStop Color="White" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RepeatButtonMouseOverBorder" Color="White" />
    <LinearGradientBrush x:Key="RepeatButtonPressedBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7E3D3D3D" />
        <GradientStop Color="#7E454545" Offset="0.032" />
        <GradientStop Color="#A5FFFFFF" Offset="0.649" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RepeatButtonPressedBorder" Color="White" />
    <SolidColorBrush Color="White" Opacity="0.8" x:Key="HorizontalThumbBackground" />
    <SolidColorBrush x:Key="HorizontalThumbBorderBrush" Color="Black" Opacity="0.5" />
    <LinearGradientBrush x:Key="TransparentThumbHoverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7E878787" />
        <GradientStop Color="#7E727272" Offset="0.032" />
        <GradientStop Color="#80FFFFFF" Offset="0.649" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>

    <!-- Template for Horizontal Thumb-->

    <ControlTemplate x:Key="ThumbTemplateKey" TargetType="Thumb">
        <Grid>
            <Path Stretch="Fill" x:Name="paththumb" Fill="{StaticResource HorizontalThumbBackground}" Stroke="{StaticResource HorizontalThumbBorderBrush}" StrokeThickness="1"   Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z">
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumb" Property="Fill" Value="{StaticResource TransparentThumbHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="true">
                <Setter TargetName="paththumb" Property="Fill" Value="{StaticResource TransparentThumbHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--Custom Template for vertical Thumb-->

    <ControlTemplate x:Key="ThumbTemplateVertical" TargetType="Thumb">
        <Grid>

            <Path Stretch="Fill" x:Name="paththumbsecond"  Stroke="{StaticResource HorizontalThumbBorderBrush}" Fill="{StaticResource HorizontalThumbBackground}" StrokeThickness="1"   Data="M261,231 L290.5,230.5 290.5,258 259.5,259 237.5,246 z">
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumbsecond" Property="Fill" Value="{StaticResource TransparentThumbHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="true">
                <Setter TargetName="paththumbsecond" Property="Fill" Value="{StaticResource TransparentThumbHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--Custom Template for Repeat Button-->

    <SolidColorBrush x:Key="ButtonAdvBackgroundBrush" Color="White" Opacity="0.495" />
    <SolidColorBrush x:Key="ButtonAdvBorderBrush" Color="#99000000" />
    <SolidColorBrush x:Key="ButtonAdvForeground" Color="Black" />

    <LinearGradientBrush  x:Key="ButtonAdvHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1" />
        <GradientStop Color="#7EE5E5E5" Offset="0.968" />
        <GradientStop Color="#A5FFFFFF" Offset="0.504" />
        <GradientStop Color="White" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvHoverBorderBrush" Color="White" Opacity="0.8" />

    <LinearGradientBrush x:Key="ButtonAdvPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF" />
        <GradientStop Color="#7EFFFFFF" Offset="0.032" />
        <GradientStop Color="#A5FFFFFF" Offset="0.649" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvPressedBorderBrush" Color="White" Opacity="0.6" />

    <LinearGradientBrush x:Key="ButtonAdvCheckedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.6">
        <GradientStop Color="#FFFAFAFA" Offset="0" />
        <GradientStop Color="#FFDEDEDE" Offset="0.491" />
        <GradientStop Color="#FFA5A5A5" Offset="0.531" />
        <GradientStop Color="#FFB6B6B6" Offset="0.789" />
        <GradientStop Color="Gray" Offset="0.996" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvCheckedBorderBrush" Color="White" Opacity="0.6" />
    <SolidColorBrush Color="#CCFFFFFF" x:Key="ButtonInnerBorderBrush" />

    <ControlTemplate x:Key="RepeatButtonTemplate1" TargetType="RepeatButton">
        <Grid>
            <Border x:Name="Background" CornerRadius="12" Opacity="1" Background="{StaticResource RepeatButtonBackground}" SnapsToDevicePixels="True" BorderThickness="1" BorderBrush="{StaticResource ButtonAdvBorderBrush}">
                <Border CornerRadius="12"  BorderThickness="1" BorderBrush="{StaticResource ButtonInnerBorderBrush}"></Border>
            </Border>

            <ContentControl IsTabStop="False"
                              x:Name="contentPresenter"
                              VerticalAlignment="Center" FontSize="16"
                              HorizontalAlignment="Center"
                              Margin="1,1,0,0" Foreground="Black"
>
                <ContentControl.Content>
                    <Viewbox x:Name="viewBox1" Height="8" Width="8"  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="upbuttonpath" Width="8" Height="8" Stretch="Uniform" Fill="Black" Data="M 0 0 L 3.5 4 L 7 0 Z"  RenderTransformOrigin=".5,.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <SkewTransform />
                                    <RotateTransform Angle="90" />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Viewbox>
                </ContentControl.Content>
            </ContentControl>

            <Rectangle x:Name="DisabledVisualElement" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" Opacity="0" IsHitTestVisible="false" />
            <Rectangle x:Name="FocusVisualElement" RadiusX="2" RadiusY="2" Margin="1" Stroke="Black" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                <Setter TargetName="contentPresenter" Property="FontSize" Value="30" />
                <Setter Property="Width" TargetName="viewBox1" Value="18" />
                <Setter Property="Height" TargetName="viewBox1" Value="18" />
                <Setter Property="Width" TargetName="upbuttonpath" Value="18" />
                <Setter Property="Height" TargetName="upbuttonpath" Value="18" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Background" Property="Background" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"></Setter>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="Background" Property="Background" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"></Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

