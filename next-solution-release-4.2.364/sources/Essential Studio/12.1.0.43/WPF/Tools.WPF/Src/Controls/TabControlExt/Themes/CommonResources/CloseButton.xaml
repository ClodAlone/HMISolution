        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/TabControlExt/Themes/Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultCloseButtonTemplate" TargetType="{x:Type ButtonBase}">
		<shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Luna.Normalcolor.ButtonInactiveBorderBrush}">
			<Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource Luna.Normalcolor.ButtonInactivePathBrush}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
		</shared:Border3D>
		<ControlTemplate.Triggers>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Luna.Normalcolor.ButtonBackgroundBrush}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Luna.Normalcolor.ButtonActiveBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource Luna.Normalcolor.ButtonActivePathBrush}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

