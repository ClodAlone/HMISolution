    <SolidColorBrush x:Key="Luna.Normalcolor.TabHoverBorderInnerBrush" Color="White"/>
    <SolidColorBrush x:Key="Luna.Normalcolor.TabHoverBorderBrush" Color="#FF98B5E2"/>
    <SolidColorBrush x:Key="Luna.Normalcolor.TabSelectedBottomBorderBrush" Color="#FFC1D2EE"/>
