                                                                    <GradientStop Color="#FF979797" Offset="0.914"/>
                                                                    <GradientStop Color="#FF9D9D9D" Offset="0.708"/>
                                                                    <GradientStop Color="#FFFEFEFE" Offset="0.043"/>
                                                                    <GradientStop Color="#FF756A5F"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Path Margin="1,1,1,1" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" Fill="{StaticResource TransparentGroupBarItemForegroundBrush}" Name="ExpandPath"/>
                                                        </Border>
