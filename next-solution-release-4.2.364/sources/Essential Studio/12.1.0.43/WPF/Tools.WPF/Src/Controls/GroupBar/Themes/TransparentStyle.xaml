                            <ControlTemplate.Triggers>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Visibility" TargetName="GlyphPanel" Value="Visible"/>
                                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                                </Trigger>

                                <Trigger Property="IsHighlighted" Value="true">


                                    <Setter Property="Fill" TargetName="HoverBorder" Value="{StaticResource TransparentThemeMenuItemHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Visibility" TargetName="HoverBorder" Value="Collapsed"/>
                                    <Setter Property="Stroke" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemSelectedBorderBrush}"/>
                                    <Setter Property="Fill" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemSelectedBrush}"/>

                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Visibility" TargetName="HoverBorder" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{StaticResource TransparentThemeMenuDisabledForegroundBrush}"/>
                                    <Setter Property="Fill" TargetName="GlyphPanel" Value="#848589"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
                            <Grid SnapsToDevicePixels="true">

                                <Rectangle x:Name="Bg" Fill="{TemplateBinding Background}" StrokeThickness="1"/>
                                <Rectangle x:Name="Innerborder" StrokeThickness="1" Margin="1"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="24" SharedSizeGroup="MenuItemIconColumnGroup" Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="37"/>
                                        <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto"/>
                                        <ColumnDefinition Width="17"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon"  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                    <Border x:Name="GlyphPanel" HorizontalAlignment="Center"  BorderBrush="{StaticResource TransparentThemeChkBoxBorderBrush}" BorderThickness="1" Background="{StaticResource TransparentThemeChkBoxBackground}"  Height="16" Margin="1" Visibility="Hidden" Width="16">
                                        <Path x:Name="Glyph" Data="{StaticResource Checkmark}" Fill="{StaticResource TransparentThemeChkBoxPathFill}" FlowDirection="LeftToRight" Height="11" Width="9"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="2" x:Name="headerpresenter" TextBlock.Foreground="{TemplateBinding Foreground}" ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <TextBlock Grid.Column="4" Margin="{TemplateBinding Padding}" x:Name="gesturepresenter" Text="{TemplateBinding InputGestureText}" Visibility="Collapsed"/>
                                    <Path Grid.Column="5" x:Name="arrow" Data="{StaticResource RightArrow}" Fill="{TemplateBinding Foreground}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" HorizontalOffset="-2" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" Placement="Right" VerticalOffset="-3">

                                    <ContentControl x:Name="SubMenuBorder" IsTabStop="false" Template="{DynamicResource {ComponentResourceKey ResourceId=SubmenuContent, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <ScrollViewer x:Name="SubMenuScrollViewer" CanContentScroll="true" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                            <Grid>
                                                <Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                    <Rectangle Fill="{StaticResource TransparentBrush}"    Height="{Binding ActualHeight, ElementName=SubMenuBorder}" Width="{Binding ActualWidth, ElementName=SubMenuBorder}"/>
                                                </Canvas>
                                                <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="true" Margin="2" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </ContentControl>

                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSuspendingPopupAnimation" Value="true">
                                    <Setter Property="PopupAnimation" TargetName="PART_Popup" Value="None"/>
                                </Trigger>

                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Visibility" TargetName="GlyphPanel" Value="Visible"/>
                                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="true">
                                    <Setter Property="Fill" TargetName="Bg" Value="{StaticResource TransparentThemeSubMenuItemHoverBrush}"/>
                                    <Setter Property="Stroke" TargetName="Bg" Value="{StaticResource TransparentSubMenuItemHoverBorderBrush}"/>
                                    <Setter Property="Stroke" TargetName="Innerborder" Value="{StaticResource TransparentMenuiteminnerBorderBrush}"/>
                                    <!--<Setter Property="TextBlock.Foreground" TargetName="headerpresenter" Value="White" />
                            <Setter Property="TextElement.Foreground" TargetName="headerpresenter" Value="White" />
                            <Setter Property="Fill" TargetName="arrow" Value="White" />
                            <Setter TargetName="gesturepresenter" Property="Foreground" Value="White"/>-->
                                    <!--<Setter Property="Foreground" Value="White" />-->
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="gesturepresenter" Property="Foreground" Value="{StaticResource TransparentThemeMenuDisabledForegroundBrush}"/>
                                    <Setter Property="TextBlock.Foreground" TargetName="headerpresenter" Value="{StaticResource TransparentThemeMenuDisabledForegroundBrush}"/>

                                    <Setter Property="Fill" TargetName="arrow" Value="{StaticResource TransparentThemeMenuDisabledForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <Style  TargetType="{x:Type MenuItem}">
                            <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                            <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                            <Style.Triggers>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter Property="Padding" Value="7,2,8,3"/>
                                    <Setter Property="Foreground"  Value="Black" />
                                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelItem">
                                    <Setter Property="Padding" Value="7,2,8,3"/>
                                    <Setter Property="Foreground"  Value="Black"  />
                                    <Setter Property="Template" Value="{StaticResource TopLevelItemTemplate}"/>
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter Property="Padding" Value="2,4,2,4"/>
                                    <Setter Property="Foreground"  Value="Black"/>
                                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuItem">
                                    <Setter Property="Foreground"  Value="Black"/>
                                    <Setter Property="Padding" Value="2,4,2,4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </ControlTemplate.Resources>

                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                    
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                      
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="TransparentNavigationToolbarStyle" TargetType="{x:Type local:NavigationToolbar}">
            <Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
                <Grid.Resources>
                    <ResourceDictionary>
                        <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">

                            <Setter Property="Template" Value="{StaticResource ToggleButtonKeyTemplate}"/>
                        </Style>
                        <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                        <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                            <ContentPresenter ContentSource="Content"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True" >
                                    <Setter Property="Background" Value="#FFBD69"/>
                                    <Setter Property="BorderBrush" Value="#FFAB3F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>
                <Border Name="MainHost"
              CornerRadius="{Binding Path=ToolbarBottomCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
          Background="{StaticResource  NavigationToolBarBackgroundBrush}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}">
                <Border BorderThickness="1" BorderBrush="{StaticResource TransparentInnerBorderBrush}">
                    <WrapPanel Name="MainPanel"
						   Orientation="Horizontal"
						   FlowDirection="RightToLeft">
                        <Menu Name="Menu" Margin="{Binding Path=ToolbarMenuMarginRight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
						  FlowDirection="LeftToRight" Style="{StaticResource TransparentMenuStyle}"
						  Background="Transparent" BorderBrush="Transparent"  >
                            <MenuItem Name="TopMenuItem"
								  Padding="0"
								  Margin="0"
								  Background="Transparent"
								 >
                                <!--Template="{StaticResource MenuItemSubmenuTemplateKey}"
								  ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
                                <MenuItem.Header>
                                    <DockPanel Name="MenuImageHost"
										   Background="{Binding Background, ElementName=TopMenuItem}">
                                        <Border Name="MenuImage"
											Height="{TemplateBinding Height}" 
											Width="{Binding Path=MenuDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
											VerticalAlignment="Center"
											HorizontalAlignment="Center">
                                            <Path Data="M0,0L4.5,4.5 9,0z" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" >
                                                <Path.Effect>
                                                    <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="White"/>
                                                </Path.Effect>
                                            </Path>

                                            <!--<Canvas Width="5"
												Height="3" 
												VerticalAlignment="Center"
												HorizontalAlignment="Center">
                                                            <Line X1="0" Y1="1" X2="5" Y2="1" StrokeThickness="1" Stroke="{StaticResource Office2007Blue_NavigationToolbarItem_ArrowBrush2}"/>
                                                            <Line X1="1" Y1="2" X2="4" Y2="2" StrokeThickness="1" Stroke="{StaticResource Office2007Blue_NavigationToolbarItem_ArrowBrush2}"/>
                                                            <Line X1="2" Y1="3" X2="3" Y2="3" StrokeThickness="1" Stroke="{StaticResource Office2007Blue_NavigationToolbarItem_ArrowBrush2}"/>

                                                            <Line X1="0" Y1="0" X2="5" Y2="0" StrokeThickness="1" Stroke="{StaticResource Office2007Blue_NavigationToolbarItem_ArrowBrush1}"/>
                                                            <Line X1="1" Y1="1" X2="4" Y2="1" StrokeThickness="1" Stroke="{StaticResource Office2007Blue_NavigationToolbarItem_ArrowBrush1}"/>
                                                            <Line X1="2" Y1="2" X2="3" Y2="2" StrokeThickness="1" Stroke="{StaticResource Office2007Blue_NavigationToolbarItem_ArrowBrush1}"/>
                                                        </Canvas>-->
                                        </Border>
                                    </DockPanel>
                                </MenuItem.Header>
                                <MenuItem Name="SplitterUpMenuItem"
									  Command="local:GroupBar.SplitterUpCommand"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Showmorebuttons}"
									  StaysOpenOnClick="True">
                                    <MenuItem.Icon>
                                        <StaticResource ResourceKey="Office_NavigationToolBar_UpMenuItemHeader"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Name="SplitterDownMenuItem"
									  Command="local:GroupBar.SplitterDownCommand"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Showfewerbuttons}"
									  StaysOpenOnClick="True">
                                    <MenuItem.Icon>
                                        <StaticResource ResourceKey="Office_NavigationToolBar_DownMenuItemHeader"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <!--Style="{StaticResource SeparatorKeyStyle}"-->
                                <MenuItem Name="OptionsMenu"
									  Command="local:GroupBar.OpenOptionsCommand"
									  Header="{Binding Path=NavigationOptionsMenuItemHeader, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
                                <Separator />
                                <!--Style="{StaticResource SeparatorKeyStyle}"-->
                                <MenuItem Name="ButtonsMenu"
									  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=Buttons}"
									 />
                                <!--ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
                            </MenuItem>
                        </Menu>
                        <ItemsPresenter Name="ItemsPresenter"/>
                    </WrapPanel>
                </Border>
            </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <DataTrigger
				Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="True">
                    <Setter TargetName="Menu" Property="Margin" Value="0"/>
                </DataTrigger>

                <Trigger SourceName="TopMenuItem" Property="IsMouseOver" Value="True">
                <Setter TargetName="TopMenuItem" Property="Background" Value="{DynamicResource  TransparentNavigationTopMenuitemHoverBrush}"/>
                <Setter TargetName="TopMenuItem" Property="BorderBrush" Value="{DynamicResource  TransparentNavigationToolBarItemHoverBorderBrush}"/>
            </Trigger>


                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
                        <Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="RightToLeft"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Menu" Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="-90" />
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="MenuImageHost" Property="LayoutTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <RotateTransform Angle="-90"/>
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
                        <Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="LeftToRight"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Menu" Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="-90" />
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="MenuImageHost" Property="LayoutTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <RotateTransform Angle="-90" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>

                <DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="RightToLeft">
                    <Setter TargetName="MainPanel" Property="FlowDirection" Value="LeftToRight"/>
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="LeftToRight">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="ItemDefaultWidth" Value="30"/>
                <Setter Property="MenuDefaultWidth" Value="25"/>
                <Setter Property="Height"  TargetName="SplitterUpMenuItem" Value="45"/>
                <Setter Property="Height"  TargetName="SplitterDownMenuItem" Value="45"/>
                <Setter Property="Height"  TargetName="OptionsMenu" Value="45"/>
                <Setter Property="Height"  TargetName="ButtonsMenu" Value="45"/>
                <Setter Property="FontSize" TargetName="SplitterUpMenuItem" Value="18"/>
                <Setter Property="FontSize" TargetName="SplitterDownMenuItem" Value="18"/>
                <Setter Property="FontSize" TargetName="OptionsMenu" Value="18"/>
                <Setter Property="FontSize" TargetName="ButtonsMenu" Value="18"/>
            </Trigger>
        </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style  TargetType="{x:Type local:NavigationToolbar}" >
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{StaticResource NavigationToolBarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" />
            <Setter Property="ItemMargin" Value="1"/>
            <Setter Property="MenuDefaultWidth" Value="{StaticResource NavigationMenuDefaultWidth}"/>
            <Setter Property="ItemDefaultWidth" Value="22"/>
        <Setter Property="Template"  Value="{StaticResource TransparentNavigationToolbarStyle}"/>
            <Style.Triggers>

            </Style.Triggers>
        </Style>


        <!-- NaviagationToolbarItem Template -->
        <LinearGradientBrush Opacity="0.5" x:Key="TransparentNavigationToolBarItemHoverBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF767676"/>
            <GradientStop Color="#FFFEFEFE" Offset="0.043"/>
            <GradientStop Color="#FF979797" Offset="0.086"/>
            <GradientStop Color="#FF9B9B9B" Offset="0.292"/>
            <GradientStop Color="#FFFEFEFE" Offset="0.631"/>
            <GradientStop Color="White" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush Color="Black" Opacity="0.5" x:Key="TransparentNavigationToolBarItemHoverBorderBrush"/>
        <LinearGradientBrush  Opacity="0.5" x:Key="TransparentNavigationToolBarItemSelectedBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF767676" Offset="1"/>
            <GradientStop Color="#FFFEFEFE" Offset="0.957"/>
            <GradientStop Color="#FF979797" Offset="0.914"/>
            <GradientStop Color="#FF9B9B9B" Offset="0.708"/>
            <GradientStop Color="#FFFEFEFE" Offset="0.369"/>
            <GradientStop Color="White"/>
        </LinearGradientBrush>
        <ControlTemplate x:Key="TransparentNaviagationToolbarItemTemplateKey" TargetType="{x:Type local:NavigationToolbarItem}">
            <Grid SnapsToDevicePixels="True" ClipToBounds="True">
                <Border Name="ImageHost"
					Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					Background="{TemplateBinding Background}" 
					BorderThickness="1"
					Margin="0,2,0,2">
                    <StackPanel HorizontalAlignment="Center"
							VerticalAlignment="Center">
                        <Image Name="Image"
						   Source="{TemplateBinding ImageSource}"
						   Visibility="Visible"
						   Height="20"
						   Width="20"
						   Stretch="Fill"/>
                        <Border Name="EmptyImage"
							Visibility="Collapsed"
							BorderBrush="Black"
                            BorderThickness="1"
							Height="20"
							Width="20"/>
                    </StackPanel>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger SourceName="ImageHost" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ImageHost"  Property="Background" Value="{StaticResource TransparentNavigationToolBarItemHoverBrush}"/>
                    <Setter TargetName="ImageHost" Property="BorderBrush" Value="{StaticResource TransparentNavigationToolBarItemHoverBorderBrush}"/>
                    <Setter TargetName="ImageHost"  Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ImageHost"  Property="Background" Value="{StaticResource TransparentNavigationToolBarItemSelectedBrush}"/>
                    <Setter TargetName="ImageHost"  Property="BorderBrush" Value="{StaticResource TransparentNavigationToolBarItemHoverBorderBrush}"/>
                    <!--<Setter TargetName="ImageHost" Property="Background" Value="{StaticResource Office2007Blue_NavigationToolbarItem_SelectedBackgroundBrush}"/>-->
                </Trigger>
                <!--<MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ImageHost" Property="Background" Value="{StaticResource Office2007Blue_NavigationToolbarItem_SelectedOverBackgroundBrush}"/>
                            </MultiTrigger>-->
                <Trigger SourceName="Image" Property="Source" Value="{x:Null}">
                    <Setter TargetName="EmptyImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Image" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style  TargetType="{x:Type local:NavigationToolbarItem}">
            <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"  Value="{StaticResource TransparentNaviagationToolbarItemTemplateKey}"/>
        </Style>

        <!-- Splitter Template -->
        <ControlTemplate x:Key="TransparentGroupBarSplitterTemplateKey" TargetType="{x:Type local:GroupBarSplitter}">
            <Border BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}">
                <Border Width="18" Height="2" HorizontalAlignment="Center">
                    <Canvas>
                        <Line X1="1" Y1="1" X2="3" Y2="1" Stroke="White" StrokeThickness="2"/>
                        <Line X1="5" Y1="1" X2="7" Y2="1" Stroke="White" StrokeThickness="2"/>
                        <Line X1="9" Y1="1" X2="11" Y2="1" Stroke="White" StrokeThickness="2"/>
                        <Line X1="13" Y1="1" X2="15" Y2="1" Stroke="White" StrokeThickness="2"/>
                        <Line X1="17" Y1="1" X2="19" Y2="1" Stroke="White" StrokeThickness="2"/>

                    <Line X1="0" Y1="0" X2="2" Y2="0" Stroke="{StaticResource TransparentThemeSeparatorBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="4" Y1="0" X2="6" Y2="0" Stroke="{StaticResource TransparentThemeSeparatorBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="8" Y1="0" X2="10" Y2="0" Stroke="{StaticResource TransparentThemeSeparatorBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="12" Y1="0" X2="14" Y2="0" Stroke="{StaticResource TransparentThemeSeparatorBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="16" Y1="0" X2="18" Y2="0" Stroke="{StaticResource TransparentThemeSeparatorBrush}" StrokeThickness="2" Opacity="0.5"/>
                    </Canvas>
                </Border>
            </Border>
        </ControlTemplate>

        <LinearGradientBrush Opacity="0.7" x:Key="TransparentGroupBarGridSplitterBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF767676" Offset="1"/>
            <GradientStop Color="#FFFEFEFE" Offset="0.957"/>
            <GradientStop Color="#FF979797" Offset="0.914"/>
            <GradientStop Color="#FF9B9B9B" Offset="0.708"/>
            <GradientStop Color="#FFFEFEFE" Offset="0.369"/>
            <GradientStop Color="White"/>
        </LinearGradientBrush>
        <SolidColorBrush Color="Black" Opacity="0.5" x:Key="TransparentGroupBarSplitterBorderBrush"/>
        <Style  TargetType="{x:Type local:GroupBarSplitter}">
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="MinHeight" Value="4"/>
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentGroupBarSplitterBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource TransparentGroupBarGridSplitterBackgroundBrush}"/>
        <Setter Property="Template"  Value="{StaticResource TransparentGroupBarSplitterTemplateKey}"/>
        </Style>



    
</ResourceDictionary>