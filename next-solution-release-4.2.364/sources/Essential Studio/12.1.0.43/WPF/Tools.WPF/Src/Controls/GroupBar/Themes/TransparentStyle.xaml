                                                        <Setter Property="Width" TargetName="OuterBorder" Value="35"/>
                                                        <Setter Property="Height" TargetName="InnerData" Value="24"/>
                                                        <Setter Property="Width" TargetName="InnerData" Value="24"/>
                                                        <Setter Property="Height" TargetName="ExpandPath" Value="17"/>
                                                        <Setter Property="Width" TargetName="ExpandPath" Value="17"/>
                                                        <Setter Property="HorizontalAlignment" TargetName="ExpandPath" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" TargetName="ExpandPath" Value="Center"/>
