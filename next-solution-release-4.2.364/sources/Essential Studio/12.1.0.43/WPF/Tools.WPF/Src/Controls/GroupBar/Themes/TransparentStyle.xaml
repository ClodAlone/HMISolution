                                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Visibility" TargetName="GlyphPanel" Value="Visible"/>
                                    <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                                </Trigger>

                                <Trigger Property="IsHighlighted" Value="true">
                                    <!--<Setter Property="Stroke" TargetName="HoverBorder" Value="transparent"/>-->
                                    <!--<Setter Property="Margin" TargetName="Bg" Value="-1,-1,-1,-3"/>-->
                                    <Setter Property="Stroke" Value="{StaticResource TrasparentMenuInnerBorderbrush}" TargetName="InnerBorder"/>
                                    <Setter Property="Fill" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemHoverBrush}"/>
                                    <Setter Property="Stroke" TargetName="Bg" Value="#99000000"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Visibility" TargetName="HoverBorder" Value="Collapsed"/>
                                    <Setter Property="Stroke" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemSelectedBorderBrush}"/>
                                    <Setter Property="Stroke" Value="{StaticResource TrasparentMenuInnerBorderbrush}" TargetName="InnerBorder"/>
                                    <Setter Property="Fill" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemSelectedBrush}"/>

                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="true">
                                    <Setter Property="Visibility" TargetName="HoverBorder" Value="Collapsed"/>
                                    <Setter Property="Stroke" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemSelectedBorderBrush}"/>
                                    <Setter Property="Stroke" Value="{StaticResource TrasparentMenuInnerBorderbrush}" TargetName="InnerBorder"/>
                                    <Setter Property="Fill" TargetName="Bg" Value="{StaticResource TransparentThemeMenuItemSelectedBrush}"/>

                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="{StaticResource TransparentThemeMenuDisabledForegroundBrush}"/>

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <ControlTemplate x:Key="TopLevelItemTemplate" TargetType="{x:Type MenuItem}">
                            <Grid SnapsToDevicePixels="true">
                                <Rectangle x:Name="HoverBorder" StrokeThickness="0" Margin="0,0,0,-1"/>
                                <Rectangle x:Name="Bg" Fill="{TemplateBinding Background}"  SnapsToDevicePixels="True"  Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>

                                <DockPanel>
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="4,0,6,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                    <Path x:Name="GlyphPanel" Data="{StaticResource Checkmark}" Fill="{TemplateBinding Foreground}" FlowDirection="LeftToRight" Margin="7,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
