            <Setter Property="MouseDownColor" Value="{StaticResource Office2007Blue_GroupViewItem_PressedBackgroundColor}"/>
            <Setter Property="SelectedItemMouseHoverColor" Value="{StaticResource Office2007Blue_GroupViewItem_SelectedOverBackgroundColor}"/>
            <Setter Property="Margin" Value="{StaticResource OfficeGroupViewItemMargin}"/>
        <Setter Property="Template" Value="{StaticResource TransparentGroupViewItemTemplateKey}"/>

            <Setter Property="ToolTipService.IsEnabled" Value="True"/>
