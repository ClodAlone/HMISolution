                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="sfshared:SkinStorage.EnableTouch" Value="True"/>
                                                            <Condition Property="ToggleButton.IsChecked" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                                                        <Setter Property="Height" TargetName="ExpandPath" Value="5"/>
                                                        <Setter Property="Width" TargetName="ExpandPath" Value="17"/>
                                                        <Setter Property="HorizontalAlignment" TargetName="ExpandPath" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" TargetName="ExpandPath" Value="Center"/>
                                                        <Setter Property="Shape.Stretch" TargetName="ExpandPath" Value="Fill"/>
                                                    </MultiTrigger>
