        </ControlTemplate>
        <SolidColorBrush Color="Transparent"   x:Key="TransparentGroupViewBackgroundBrush"/>
        <SolidColorBrush Color="Black" Opacity="0.5" x:Key="TransparentGroupViewBorderBrush"/>
