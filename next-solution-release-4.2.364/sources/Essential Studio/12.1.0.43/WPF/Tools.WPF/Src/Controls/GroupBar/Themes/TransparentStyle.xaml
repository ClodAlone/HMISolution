                                </Grid>
                            </Border>
                        </ControlTemplate>
                        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="{x:Type MenuItem}">
                            <Grid SnapsToDevicePixels="true">
                                <Rectangle x:Name="HoverBorder" StrokeThickness="0" Margin="0,0,0,-1"/>
                                <Rectangle x:Name="Bg" SnapsToDevicePixels="True"  Fill="{TemplateBinding Background}"  Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
