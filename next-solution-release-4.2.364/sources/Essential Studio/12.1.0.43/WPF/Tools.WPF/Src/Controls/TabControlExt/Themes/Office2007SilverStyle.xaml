<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
                      xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:Sync_Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF" >
   
    <!-- Brushes -->
    <Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey"/>
    <SolidColorBrush x:Key="Office2007.Silver.TabControlBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Office2007.Silver.TabPanelBackgroundBrush" Color="#CCCFD8" />
    <Thickness x:Key="Office2007.Silver.TabPanelPadding" Left="3" Top="3" Right="0" Bottom="0" />
    <Thickness x:Key="Office2007.Silver.TabPanelMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Office2007.Silver.ContentPanelBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <CornerRadius x:Key="Office2007.Silver.ContentPanelBorderCornerRadius" TopLeft="2" TopRight="2" BottomRight="2" BottomLeft="2" />
    <Thickness x:Key="Office2007.Silver.ContentPanelInnerBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Office2007.Silver.ContentPanelInnerBorderMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Office2007.Silver.ContentPanelOuterBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />
    <Thickness x:Key="Office2007.Silver.TabItemBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />
  <SolidColorBrush x:Key="BackgroundBrushes.Office2007" Color="Transparent"/>   
   
    <SolidColorBrush x:Key="Office2007.Silver.ActiveForeground" Color="Black"/>
    <SolidColorBrush x:Key="Office2007.Silver.InactiveForeground" Color="Black"/>
    <SolidColorBrush x:Key="Office2007.Silver.TabHoverBorderBrush" Color="#BDBEC1"/>
    <!--<SolidColorBrush x:Key="Office2007.Silver.TabSelectedBorderBrush" Color="#8DB2E3"/>-->
    <SolidColorBrush x:Key="Office2007.Silver.TabSelectedBorderBrush" Color="#BDBEC1"/>
    <SolidColorBrush x:Key="Office2007.Silver.TabHoverSelectedBorderBrush" Color="#E6C47B"/>
    <SolidColorBrush x:Key="Office2007.Silver.TabSubLineBorderBrush" Color="#E4E8EF"/>
    <SolidColorBrush x:Key="Office2007.Silver.TabBottomBorderBrush" Color="#F3F8FF"/>
    <SolidColorBrush x:Key="Office2007.Silver.ButtonActivePathBrush" Color="Gray"/>
    <SolidColorBrush x:Key="Office2007.Silver.ButtonInactivePathBrush" Color="Gray"/>
    <SolidColorBrush x:Key="Office2007.Silver.ButtonInactiveBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Office2007.Silver.ButtonActiveBorderBrush" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="Office2007.Silver.ContentPanelBorderBrush" Color="#B4B4B4"/>
    <!--<SolidColorBrush x:Key="Office2007.Silver.ContentPanelBorderBrush" Color="#8DB2E3"/>-->
    <!--<SolidColorBrush x:Key="Office2007.Silver.ContentPanelBackgroundBrush" Color="Transparent"/>-->
    <!--<SolidColorBrush x:Key="Office2007.Silver.ContentPanelBackgroundBrush" Color="#B4B4B4"/>-->
    <SolidColorBrush x:Key="Office2007.Silver.ContentPanelInnerBorderBrush" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="Office2007.Silver.ContextMenuBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Office2007.Silver.ContextMenuBorderBrush" Color="#868686"/>
    <SolidColorBrush x:Key="Office2007.Silver.ContextMenuBarBorderBrush" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="Office2007.Silver.ContextMenuBarInnerBorderBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Office2007.Silver.MenuItemBorderBrush" Color="#CAB583"/>
  <LinearGradientBrush x:Key="TabBackground.Silver" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFF1F4F8" Offset="0"/>
        <GradientStop Color="#FFE9EDF3" Offset="0.2"/>
        <GradientStop Color="#FFD6DCE7" Offset="0.2"/>
        <GradientStop Color="#FFF1F8F9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2007.Silver.ButtonBackgroundBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFF9D1" Offset="1" />
            <GradientStop Color="#FFFFEAA3" Offset="0.65" />
            <GradientStop Color="#FFFFD75C" Offset="0.6" />
            <GradientStop Color="#FFFFD456" Offset="0.25" />
            <GradientStop Color="#FFFFE395" Offset="0.05" />
            <GradientStop Color="#FFFFEAAD" Offset="0" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007.Silver.TabHoverBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
        <GradientStop Color="#CED1DA" Offset="0"/>
        <GradientStop Color="#DDD0AA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007.Silver.TabSelectedBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
        <GradientStop Color="#E2E7EF" Offset="0"/>
        <GradientStop Color="#F6F8EA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007.Silver.MenuItemBackgroundBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFF9D1" Offset="1" />
            <GradientStop Color="#FFFFEAA3" Offset="0.65" />
            <GradientStop Color="#FFFFD75C" Offset="0.6" />
            <GradientStop Color="#FFFFD456" Offset="0.25" />
            <GradientStop Color="#FFFFE395" Offset="0.05" />
            <GradientStop Color="#FFFFEAAD" Offset="0" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007.Silver.ContextMenuBarBackgroundBrush" Color="#E9EEEE"/>

    <LinearGradientBrush x:Key="Office2007SilverButtonPressedBackground" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFF3B277" Offset="0"/>
        <GradientStop Color="#FFF4B378" Offset="0.4"/>
        <GradientStop Color="#FFF4A770" Offset="0.4"/>
        <GradientStop Color="#FFF37E24" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007SilverButtonMouseOverBackground" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007SilverButtonMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDBCE99" Offset="0"/>
        <GradientStop Color="#FFCEC0A4" Offset="0.996"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007SilverButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFA78E66" Offset="0"/>
        <GradientStop Color="#FFB9AE93" Offset="1"/>
    </LinearGradientBrush>

    <local:ImageAlignmentToDockConverter x:Key="ImageAlignmentToDockConverter"/>

    <DataTemplate x:Key="HeaderDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBlock Focusable="False" Text="{Binding FallbackValue=''}" TextTrimming="CharacterEllipsis" 
				   IsHitTestVisible="False" Padding="4,0,4,1" />
    </DataTemplate>

    <DataTemplate x:Key="EditableDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBox x:Name="EditableHeader" Focusable="True" Style="{Binding Path=EditHeaderItemStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}"
				 Text="{Binding Path=Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabItemExt}}, Mode=TwoWay}"  
				 IsReadOnly="False" Padding="4,1,4,1" />
    </DataTemplate>

    <LinearGradientBrush x:Key="background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFCFDFD" Offset="0"/>
        <GradientStop Color="#FFE5EAF5" Offset="0.3"/>
        <GradientStop Color="#FFCFD7EB" Offset="0.3"/>
        <GradientStop Color="#FFE0E5F5" Offset="0.7"/>
        <GradientStop Color="#FFECEEFC" Offset="1"/>
    </LinearGradientBrush>

    <ControlTemplate TargetType="{x:Type TabItem}" 
                                     x:Key="newtabitem">
        <Border BorderThickness="0" 
                                Margin="2,0,0,0"  Name="Bd"
                                BorderBrush="AliceBlue" 
                                Background="{StaticResource background}"
                                CornerRadius="5,5,0,0">
        </Border>
    </ControlTemplate>


    <local:CloseButtonTypeToVisibilityConverter x:Key="CloseButtonTypeToVisibilityConverter"/>
    <shared:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx"/>

    <ControlTemplate x:Key="Office2007SilverCloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Office2007.Silver.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource Office2007.Silver.ButtonInactivePathBrush}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                <Setter Property="Height" Value="13" TargetName="pathButton"/>
                <Setter Property="Width" Value="13" TargetName="pathButton"/>
                <Setter Property="Data" Value="M1,1 L12,12 M1,12 L12,1" TargetName="pathButton"/>
                <Setter Property="StrokeThickness" Value="2.5" TargetName="pathButton"/>



            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2007SilverButtonPressedBackground}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Office2007SilverButtonPressedBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2007SilverButtonMouseOverBackground}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Office2007SilverButtonMouseOverBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                </MultiTrigger.Conditions>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="Office2007SilverMenuButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Office2007.Silver.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Fill="{StaticResource Office2007.Silver.ButtonInactivePathBrush}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                <LineSegment Point="8,1"/>
                                <LineSegment Point="8,3"/>
                                <LineSegment Point="0,3"/>
                            </PathFigure>
                        </PathGeometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                <LineSegment Point="4,8"/>
                                <LineSegment Point="8,4"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </shared:Border3D>
        <ControlTemplate.Triggers>

            <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                <Setter Property="Height" Value="13" TargetName="pathButton"/>
                <Setter Property="Width" Value="13" TargetName="pathButton"/>

                <Setter TargetName="pathButton" Property="Data">
                    <Setter.Value>
                        <GeometryGroup>
                            <PathGeometry>
                                <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                    <LineSegment Point="12,1"/>
                                    <LineSegment Point="12,4"/>
                                    <LineSegment Point="0,4"/>
                                </PathFigure>
                            </PathGeometry>
                            <PathGeometry>
                                <PathFigure StartPoint="0,6" IsFilled="True" IsClosed="True">
                                    <LineSegment Point="6,12"/>
                                    <LineSegment Point="12,6"/>
                                </PathFigure>
                            </PathGeometry>
                        </GeometryGroup>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions >
                    <Condition Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    <Condition Binding="{Binding Path=(shared:SkinStorage.EnableTouch),RelativeSource={RelativeSource AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="false"/>
                </MultiDataTrigger.Conditions>

                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L4,8 L8,4 z"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions >
                    <Condition Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    <Condition Binding="{Binding Path=(shared:SkinStorage.EnableTouch),RelativeSource={RelativeSource AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="true"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="14" TargetName="pathButton"/>
                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L8,12 L14,4 z"/>
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2007SilverButtonPressedBackground}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Office2007SilverButtonPressedBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>

            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                </MultiTrigger.Conditions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2007SilverButtonMouseOverBackground}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Office2007SilverButtonMouseOverBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Office2007SilverTabScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <shared:Border3D x:Name="PART_Border" VerticalAlignment="Center" HorizontalAlignment="Center"
				Margin="1,0,0,0"
                Padding="1" Background="Transparent"
                Width="15"
                Height="15"
                BorderThickness="1"
                BorderBrush="{StaticResource Office2007.Silver.ButtonInactiveBorderBrush}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0">
                        <Canvas Width="8" Height="7" x:Name="canvas" VerticalAlignment="Center" HorizontalAlignment="Center"  >
                            <Path Data="M0,0L4,3.5 0,7" HorizontalAlignment="Center" Stroke="{StaticResource Office2007.Silver.ButtonInactivePathBrush}" Fill="{StaticResource Office2007.Silver.ButtonInactivePathBrush}" Name="PART_Path1" VerticalAlignment="Center"/>
                            <Path Data="M4,0L8,3.5 4,7" HorizontalAlignment="Center" Stroke="{StaticResource Office2007.Silver.ButtonInactivePathBrush}" Fill="{StaticResource Office2007.Silver.ButtonInactivePathBrush}" Name="PART_Path2" VerticalAlignment="Center"/>
                            <Path Data="M5,0L5,7" HorizontalAlignment="Center" Stroke="{StaticResource Office2007.Silver.ButtonInactivePathBrush}" Fill="{StaticResource Office2007.Silver.ButtonInactivePathBrush}" Name="PART_Path3" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Canvas>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                            <Setter Property="Data" TargetName="PART_Path1" Value="M0,0 L8,6 0,12"/>
                            <Setter Property="Height" TargetName="PART_Border" Value="24"/>
                            <Setter Property="Width" TargetName="PART_Border" Value="24"/>
                            <Setter Property="Data" TargetName="PART_Path2" Value="M4,0L12,6 4,12"/>
                            <Setter Property="Margin" TargetName="canvas" Value="0,0,0,4"/>
                        </Trigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="LastTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="LastTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M9,0L9,12"/>
                            <Setter TargetName="PART_Path3" Property="StrokeThickness" Value="2"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="FirstTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,7"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="FirstTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M12,0L4,5.5 12,11"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,12"/>
                            <Setter TargetName="PART_Path3" Property="StrokeThickness" Value="2"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="PrevPage"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="PrevPage"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M8,0L0,6 8,11"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M12,0L4,6 12,11"/>
                        </MultiTrigger>

                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="PrevTab"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="PrevTab"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M8,0L0,6 8,12"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="NextTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>

                        </Trigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource Office2007.Silver.ButtonBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{StaticResource Office2007.Silver.ButtonActiveBorderBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2007SilverButtonPressedBackground}"/>
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2007SilverButtonPressedBorderBrush}"/>

                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource Office2007.Silver.ButtonActivePathBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" TargetName="PART_Path1" Value=".4"/>
                            <Setter Property="Opacity" TargetName="PART_Path2" Value=".4"/>
                            <Setter Property="Opacity" TargetName="PART_Path3" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2007SilverTabPanelAdvStyle" TargetType="{x:Type local:TabPanelAdv}">
        <Setter Property="Padding" Value="3,3,0,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabPanelAdv}">
                    <Border Name="Bord" Background="{Binding TabPanelBackground,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}},FallbackValue=Transparent}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}"
							CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">


                        <DockPanel LastChildFill="True">
                            <Border Name="BottomBorder" Height="0" DockPanel.Dock="Bottom" Background="Transparent"/>


                            <ContentPresenter x:Name="PART_CustomItems"  AllowDrop="False" ContentSource="TabPanelItem"
