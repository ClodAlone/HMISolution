                                    <Setter TargetName="Bg"
                        Property="Stroke"
                        Value="{StaticResource BorderBrush.Blue}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                     Value="false">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
