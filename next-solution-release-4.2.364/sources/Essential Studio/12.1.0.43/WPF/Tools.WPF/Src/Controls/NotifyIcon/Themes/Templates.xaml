    <DataTemplate x:Key="ToolTipContentTemplate">
		<Border Background="{TemplateBinding Border.Background}"
				BorderBrush="{TemplateBinding Border.BorderBrush}"
				BorderThickness="{TemplateBinding Border.BorderThickness}"
				TextBlock.Foreground="{TemplateBinding TextBlock.Foreground}">
			<TextBlock Name="PART_TextBlock" TextWrapping="Wrap"
					   Text="{Binding Path=Text, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NotifyIcon}}}" />
		</Border>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=Text, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NotifyIcon}}}" Value="{x:Null}">
				<Setter TargetName="PART_TextBlock" Property="Text" Value="{Binding Path=ToolTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NotifyIcon}}}" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

