                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Office2007Silver.BorderBrush}"/>
                <Setter Property="TextBlock.Foreground" TargetName="Bd" Value="{StaticResource Office2007Silver.Foreground}"/>
            </Trigger>
