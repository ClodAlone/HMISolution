		</Border>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Office2007Blue.Background}"/>
