                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Office2003.Background}"/>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Office2003.BorderBrush}"/>
                <Setter Property="TextBlock.Foreground" TargetName="Bd" Value="{StaticResource Office2003.Foreground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Blend.Background}"/>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Blend.BorderBrush}"/>
                <Setter Property="TextBlock.Foreground" TargetName="Bd" Value="{StaticResource Blend.Foreground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Orange.Background}"/>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Orange.BorderBrush}"/>
                <Setter Property="TextBlock.Foreground" TargetName="Bd" Value="{StaticResource Orange.Foreground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	<DataTemplate x:Key="BalloonTipHeaderContentTemplate">
		<Border Name="PART_Border" HorizontalAlignment="Left" VerticalAlignment="Center">
			<TextBlock Name="TextBlock" TextWrapping="Wrap" TextTrimming="WordEllipsis"
				Text="{Binding Path=BalloonTipTitle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" />
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="BalloonTipContentTemplate">
		<TextBlock Name="TextBlock" Margin="0,5,5,5" TextWrapping="Wrap" TextTrimming="WordEllipsis"
			Text="{Binding Path=BalloonTipText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" />
	</DataTemplate>

	<DataTemplate x:Key="BalloonTipContentIconTemplate">
		<Border Name="PART_ContentInternalBorder"
			Margin="20,5,5,5" Width="20" Height="20">
			<Image Name="PART_ContentImage" Source="{x:Null}" />
		</Border>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=BalloonTipIcon, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" Value="Error">
				<Setter TargetName="PART_ContentInternalBorder" Property="Background" Value="{StaticResource ErrorImage}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=BalloonTipIcon, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" Value="Warning">
				<Setter TargetName="PART_ContentInternalBorder" Property="Background" Value="{StaticResource WarningImage}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=BalloonTipIcon, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" Value="Info">
				<Setter TargetName="PART_ContentInternalBorder" Property="Background" Value="{StaticResource InfoImage}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=BalloonTipIcon, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" Value="Custom">
				<Setter TargetName="PART_ContentImage" Property="Source" Value="{Binding Path=Icon, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NotifyIcon}}}" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<ControlTemplate x:Key="HeaderButtonTemplate" TargetType="{x:Type Button}">
		<Border
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            BorderBrush="{TemplateBinding BorderBrush}"
            Background="{TemplateBinding Background}" />
	</ControlTemplate>

	<Style x:Key="HeaderButtonBaseStyle" TargetType="{x:Type Button}">
		<Setter Property="Width" Value="16"/>
		<Setter Property="Margin" Value="3,1,1,1" />
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Border.CornerRadius" Value="2" />
		<Setter Property="BorderBrush" Value="{StaticResource Aero.NormalColor.HeaderButtonBorderBrush}"/>
		<Setter Property="Background" Value="{StaticResource Aero.NormalColor.HeaderButtonBackground}"/>
		<Setter Property="Template" Value="{StaticResource HeaderButtonTemplate}" />
		<Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.HeaderButtonBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderButtonBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.HeaderButtonBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2007Black.HeaderButtonBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.HeaderButtonBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2007Silver.HeaderButtonBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.HeaderButtonBorderBrush}"/>
                <Setter Property="Background"  Value="{StaticResource Office2003.HeaderButtonBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="BorderBrush" Value="{StaticResource Blend.HeaderButtonBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Blend.HeaderButtonBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="BorderBrush" Value="{StaticResource Orange.HeaderButtonBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Orange.HeaderButtonBackground}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource Aero.NormalColor.HeaderButtonHighlightBackground}"/>
				<Setter Property="BorderBrush" Value="{StaticResource Aero.NormalColor.HeaderButtonHighlightBorderBrush}"/>
			</Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderButtonHighlightBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.HeaderButtonHighlightBorderBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Black.HeaderButtonHighlightBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.HeaderButtonHighlightBorderBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Silver.HeaderButtonHighlightBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.HeaderButtonHighlightBorderBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2003.HeaderButtonHighlightBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.HeaderButtonHighlightBorderBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Blend.HeaderButtonHighlightBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.HeaderButtonHighlightBorderBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="SyncOrange"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Orange.HeaderButtonHighlightBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Orange.HeaderButtonHighlightBorderBrush}"/>
            </MultiTrigger>
        </Style.Triggers>
	</Style>
    
    <ControlTemplate x:Key="BalloonTipHeaderTemplate" TargetType="{x:Type local:BalloonTipHeader}">
		<Border Name="PART_Border"
			Background="{TemplateBinding Background}"
			TextBlock.Foreground="{TemplateBinding Foreground}">
			<DockPanel Height="18" LastChildFill="True">
				<Button Name="PART_CloseButton"
						DockPanel.Dock="Right"
						Style="{StaticResource HeaderButtonBaseStyle}" />
				<Border Name="PART_HeaderIconBorder" DockPanel.Dock="Left" Margin="1,1,3,1">
					<Image Width="16"
						   Source="{TemplateBinding HeaderImage}" />
				</Border>
				<ContentPresenter Margin="1" VerticalAlignment="Center"
								  Content="{Binding Path=Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}"
								  ContentTemplate="{Binding Path=HeaderTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}"
								  ContentTemplateSelector="{Binding Path=HeaderTemplateSelector, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}"
								  />
			</DockPanel>
		</Border>
		<ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Style" TargetName="PART_CloseButton" Value="{StaticResource HeaderButtonBaseStyle.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Style" TargetName="PART_CloseButton" Value="{StaticResource HeaderButtonBaseStyle.ShinyRed}"/>
            </Trigger>
			<DataTrigger Binding="{Binding Path=HeaderImage, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
				<Setter TargetName="PART_HeaderIconBorder" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=BalloonTipShape, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" Value="Balloon">
				<Setter TargetName="PART_Border" Property="CornerRadius" Value="7, 7, 0, 0" />
				<Setter TargetName="PART_Border" Property="Padding" Value="7, 0, 7, 0" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=BalloonTipShape, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BalloonTip}}}" Value="RoundedRectangle">
				<Setter TargetName="PART_Border" Property="CornerRadius" Value="20, 20, 0, 0" />
				<Setter TargetName="PART_Border" Property="Padding" Value="10, 0, 10, 0" />
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="BalloonTipTemplate" TargetType="{x:Type local:BalloonTip}">
		<local:BalloonTipBorder Name="PART_Border" Margin="1"
			Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}"
			BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
			BorderThickness="{TemplateBinding BorderThickness}"
			CornerRadius="{TemplateBinding Border.CornerRadius}"
			Opacity="{TemplateBinding Opacity}">
			<DockPanel Name="PART_DockPanel" LastChildFill="True">
				<local:BalloonTipHeader Name="PART_Header"
										Background="{Binding Path=HeaderBackground, RelativeSource={RelativeSource TemplatedParent}}"
										Foreground="{Binding Path=HeaderForeground, RelativeSource={RelativeSource TemplatedParent}}"
										DockPanel.Dock="Top"
										HeaderImage="{TemplateBinding HeaderImage}"
										Visibility="{TemplateBinding BalloonTipHeaderVisibility, Converter={StaticResource HeaderVisibilityToVisibilityConverter}}"/>
				<Border Name="PART_ContentBorder"
						HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}"
						TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<ContentPresenter Name="PART_IconColumn"
							Grid.Column="0"							
							ContentTemplate="{TemplateBinding IconTemplate}" />
						<ContentPresenter Grid.Column="1"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
							/>
						<Border Name="PART_DownBorder" Height="5" Grid.Row="1" Grid.ColumnSpan="2"
							Background="{StaticResource Aero.NormalColor.DownBorderBackground}"
							Visibility="{TemplateBinding BalloonTipHeaderVisibility, Converter={StaticResource HeaderVisibilityToVisibilityConverter}}" />
					</Grid>
				</Border>
			</DockPanel>
		</local:BalloonTipBorder>
		<ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource Office2007Blue.DownBorderBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource Office2007Black.DownBorderBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource Office2007Silver.DownBorderBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource Office2003.DownBorderBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource Blend.DownBorderBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource Orange.DownBorderBackground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" TargetName="PART_DownBorder" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="Visibility" SourceName="PART_DownBorder" Value="Visible">
				<Setter TargetName="PART_DownBorder" Property="Background">
					<Setter.Value>
						<LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
							<LinearGradientBrush.GradientStops>
								<GradientStop Offset="0" Color="{Binding ElementName=PART_ContentBorder, Path=Background, Converter={StaticResource BrushToColorConverter}}" />
								<GradientStop Offset="1" Color="{Binding ElementName=PART_Border, Path=BorderBrush, Converter={StaticResource BrushToColorConverter}}" />
							</LinearGradientBrush.GradientStops>
						</LinearGradientBrush>
					</Setter.Value>
				</Setter>
			</Trigger>
			<Trigger Property="BalloonTipIcon" Value="None">
				<Setter TargetName="PART_IconColumn" Property="Visibility" Value="Collapsed" />
			</Trigger>
			<Trigger Property="BalloonTipShape" Value="Balloon">
				<Setter TargetName="PART_ContentBorder" Property="CornerRadius" Value="15" />
				<Setter TargetName="PART_DownBorder" Property="Visibility" Value="Collapsed" />
			</Trigger>
			<Trigger Property="BalloonTipShape" Value="RoundedRectangle">
				<Setter TargetName="PART_ContentBorder" Property="CornerRadius" Value="20" />
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding Path=BalloonTipShape, RelativeSource={RelativeSource TemplatedParent}}" Value="Balloon" />
					<Condition Binding="{Binding Path=BalloonTipHeaderVisibility, RelativeSource={RelativeSource TemplatedParent}}" Value="Visible" />
				</MultiDataTrigger.Conditions>
				<Setter TargetName="PART_ContentBorder" Property="CornerRadius" Value="0, 0, 20, 20" />
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding Path=BalloonTipShape, RelativeSource={RelativeSource TemplatedParent}}" Value="RoundedRectangle" />
					<Condition Binding="{Binding Path=BalloonTipHeaderVisibility, RelativeSource={RelativeSource TemplatedParent}}" Value="Visible" />
				</MultiDataTrigger.Conditions>
				<Setter TargetName="PART_DownBorder" Property="Margin" Value="7, 0, 7, 0" />
				<Setter TargetName="PART_DownBorder" Property="CornerRadius" Value="0, 0, 20, 20" />
				<Setter TargetName="PART_ContentBorder" Property="CornerRadius" Value="0, 0, 20, 20" />
			</MultiDataTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="BalloonTipShape" Value="Balloon" />
					<Condition Property="TaskBarDirection" Value="Left" />
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_Border" Property="LayoutTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
				<Setter TargetName="PART_DockPanel" Property="LayoutTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="BalloonTipShape" Value="Balloon" />
					<Condition Property="TaskBarDirection" Value="Top" />
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_Border" Property="LayoutTransform">
					<Setter.Value>
						<ScaleTransform ScaleY="-1" />
					</Setter.Value>
				</Setter>
				<Setter TargetName="PART_DockPanel" Property="LayoutTransform">
					<Setter.Value>
						<ScaleTransform ScaleY="-1" />
					</Setter.Value>
				</Setter>
			</MultiTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="NotifyIconTemplate" TargetType="{x:Type local:NotifyIcon}">
		<Border Name="PART_Border">
			<Border.ToolTip>
				<ToolTip Placement="Absolute" Name="tooltip"
					IsOpen="{Binding Path=IsToolTipOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
					Template="{StaticResource ToolTipTemplate}"/>
			</Border.ToolTip>
			<shared:NonStickingPopup Name="PART_BalloonTipPopup" StaysOpen="True"
				   Placement="Absolute" AllowsTransparency="True"
				   IsOpen="{Binding ElementName=PART_BalloonTip, Path=IsOpen}"
				   >
				<local:BalloonTip Name="PART_BalloonTip"
								  Background="{TemplateBinding Background}"
								  BorderBrush="{TemplateBinding BorderBrush}"
								  Foreground="{TemplateBinding Foreground}"
								  HeaderBackground="{TemplateBinding HeaderBackground}"
								  HeaderForeground="{TemplateBinding HeaderForeground}"
								  BorderThickness="{TemplateBinding BorderThickness}"
								  Width="{TemplateBinding Width}"
								  Height="{TemplateBinding Height}"
								  ShowBalloonTipTime="{TemplateBinding ShowBalloonTipTime}"
								  HideBalloonTipTime="{TemplateBinding HideBalloonTipTime}"
								  BalloonTipHeaderVisibility="{TemplateBinding BalloonTipHeaderVisibility}"
								  BalloonTipLocation="{TemplateBinding BalloonTipLocation}"
								  BalloonTipSize="{TemplateBinding BalloonTipSize}"
								  BalloonTipIcon="{TemplateBinding BalloonTipIcon}"
								  BalloonTipText="{TemplateBinding BalloonTipText}"
								  BalloonTipTitle="{TemplateBinding BalloonTipTitle}"
								  BalloonTipShape="{TemplateBinding BalloonTipShape}"
								  BalloonTipAnimationEffect="{TemplateBinding BalloonTipAnimationEffect}"
								  CustomShowingAnimation="{TemplateBinding CustomShowingAnimation}"
								  CustomHidingAnimation="{TemplateBinding CustomHidingAnimation}"
								  CustomAnimatedProperty="{TemplateBinding CustomAnimatedProperty}"
								  Content="{TemplateBinding Content}"
								  ContentTemplate="{TemplateBinding ContentTemplate}"
								  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
								  IconTemplate="{TemplateBinding IconTemplate}"
								  HeaderImage="{TemplateBinding HeaderImage}"
								  Header="{TemplateBinding Header}"
								  HeaderTemplate="{TemplateBinding HeaderTemplate}"
								  HeaderTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
								  />
			</shared:NonStickingPopup>
		</Border>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" TargetName="tooltip" Value="{StaticResource ToolTipTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" TargetName="tooltip" Value="{StaticResource ToolTipTemplate.ShinyRed}"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

</ResourceDictionary>