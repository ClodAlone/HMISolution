<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:conv="clr-namespace:Syncfusion.Windows.Tools"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
		xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
>

    <!--Brushes-->

    <SolidColorBrush x:Key="Aero.FontListComboBoxBorderBrush" Color="#ADC3DE" />

    <SolidColorBrush x:Key="Black" Color="Black" />

    <SolidColorBrush x:Key="Aero.ListBoxBorderBrush" Color="#ADC3DE" />

    <SolidColorBrush x:Key="Aero.Normalcolor.Background" Color="White" />

    <LinearGradientBrush x:Key="Aero.Normalcolor.Highlight.DropDownButton" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#E5F6FF" Offset="1" />
        <GradientStop Color="#CBE9F8" Offset="0.53" />
        <GradientStop Color="#80C1E6" Offset="0.5" />
        <GradientStop Color="#6EB4DF" Offset="0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Aero.Normalcolor.Highlight.BorderOutside" Color="#29618C" />

    <SolidColorBrush x:Key="TextBoxBorderBrushKey.Default" Color="Transparent" />

    <!--Converter-->

    <conv:FontToStringConverter x:Key="FontToStringConverter" />

    <conv:PopupHeightToThumbOffsetConverter x:Key="PopupHeightToThumbOffsetConverter" />

    <!--styles-->

    <Style x:Key="ToggleDropDownButtonStyle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="1" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="15" />
        <Setter Property="FrameworkElement.Height" Value="Auto" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Aero.Normalcolor.Background}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <utilsOuter:TrippleBorder Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}"
                                InsideBorderThickness="1"
                                BorderThickness="1"
                                OutsideBorderThickness="1"
                                InsideBorderBrush="{StaticResource Aero.Normalcolor.Background}"
                                BorderBrush="{StaticResource Aero.Normalcolor.Background}"
                                OutsideBorderBrush="{StaticResource Aero.Normalcolor.Background}">
                        <ContentPresenter RecognizesAccessKey="True"
                              Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ClipToBounds="True" />
                    </utilsOuter:TrippleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="utilsOuter:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FrameworkElement.Width" Value="35" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="utilsOuter:SkinStorage.EnableTouch" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="InsideBorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                            <Setter TargetName="PART_Border" Property="OutsideBorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.BorderOutside}" />
                            <Setter Property="Background" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="InsideBorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                            <Setter TargetName="PART_Border" Property="OutsideBorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.BorderOutside}" />
                            <Setter Property="Background" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Aero.Normalcolor.Highlight.DropDownButton}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:FontListComboBox}">
        <Setter Property="Background" Value="{StaticResource Aero.Normalcolor.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Black}" />
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrushKey.Default}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FontListComboBox}">
                    <Border SnapsToDevicePixels="True"
				BorderThickness="1" Name="Bd1"
				BorderBrush="{StaticResource Aero.FontListComboBoxBorderBrush}">
                        <Grid SnapsToDevicePixels="True">
                            <Border Name="Bd"
                        BorderThickness="{TemplateBinding Border.BorderThickness}"
						BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                        Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
						TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}">
                                <Grid Grid.IsSharedSizeScope="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="{TemplateBinding Control.Padding}"
                                Name="SelectedItemBorder"
                                Grid.ColumnSpan="2" />
                                    <ContentPresenter Name="textBox"
                                          Margin="{TemplateBinding Control.Padding}"
                                          HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                          Content="{Binding Path=SelectedFontFamily, Converter={StaticResource FontToStringConverter},
                                                    Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                                          Grid.Column="1" />
                                    <ToggleButton Name="toggleButton"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                                      Grid.Column="3"
                                      Style="{StaticResource ToggleDropDownButtonStyle}">
                                        <Path Name="PART_Arrow"
                                Data="M0,0L3.5,3 7,0"
                                Stroke="{StaticResource Black}"
                                Fill="{StaticResource Black}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,0" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom"
                       Name="PART_Popup"
			           TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       Height="{Binding Path=PopupDropDownHeight, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       Focusable="False"
                       AllowsTransparency="True"
			           StaysOpen="True"
                       IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       PopupAnimation="Fade">
                                <Border BorderThickness="1.5" Name="listBorder" BorderBrush="{StaticResource Aero.ListBoxBorderBrush}" CornerRadius="2" Background="{StaticResource Aero.Normalcolor.Background}" ClipToBounds="True">
                                    <DockPanel Name="FontListBoxPanel"  LastChildFill="True" Background="White"
                                   Height="{Binding ElementName=bt, Path=Offset}">
                                        <local:BottomThumb  Name="bt"  Height="10" DockPanel.Dock="Bottom"
                                            Offset="{Binding Path=PopupDropDownHeight, Mode=TwoWay, Converter={ StaticResource PopupHeightToThumbOffsetConverter},
                                            ConverterParameter=6,  RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}" />
                                        <!--Style="{utilsOuter:SkinObject ScrollViewerStyle}"-->
                                        <ScrollViewer>
                                            <local:FontListBox x:Name="FontListBoxElement" DockPanel.Dock="Top"
                                    Width="{Binding Path=Width, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedFontFamily="{Binding Path=SelectedFontFamily, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    FocusedFontFamily="{Binding Path=FocusedFontFamily, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    FontsSource="{Binding Path=FontsSource, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ThemeFonts="{Binding Path=ThemeFonts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    RecentlyUsedFonts="{Binding Path=RecentlyUsedFonts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    HasFocus="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayFontNamesInSystemFont="{Binding Path=DisplayFontNamesInSystemFont, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    GroupHeaderStyle="{Binding Path=GroupHeaderStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ItemTemplate="{Binding Path=ItemTemplate, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ItemContainerStyle="{Binding Path=ItemContainerStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
 />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="utilsOuter:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Padding" Value="10,11,10,11" />
                            <Setter Property="Effect" TargetName="Bd">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".3" Direction="315" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Data" Value="M 0 0 L 7 7 L 14 0 Z" TargetName="PART_Arrow" />
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="{x:Static SystemColors.GrayTextBrushKey}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Panel.Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="textBox" Property="Content" Value="{Binding Path=FocusedFontFamily, Converter={StaticResource FontToStringConverter}, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>