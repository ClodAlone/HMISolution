<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
  xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
	xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>

    </ResourceDictionary.MergedDictionaries>

    

    <Style x:Key="ItemsControlInternalItemStyle" TargetType="shared:ItemsControlInternalItem">
        <Setter Property="Background" Value="{StaticResource Blue.ApplicationFooterItem.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.ApplicationFooterItem.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="5,4,5,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:ItemsControlInternalItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter DataContext="{Binding Path=DataContext,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type shared:ItemsControlInternal}}}" Content="{TemplateBinding Content}" Margin="-1"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Black.ComboBox.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Black.ComboBox.BorderBrush}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Silver.ComboBox.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver.ComboBox.BorderBrush}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.ApplicationFooterItem.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.ApplicationFooterItem.Border}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.ApplicationFooterItem.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.ApplicationFooterItem.Border}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <ControlTemplate x:Key="ApplicationMenuTemplate.Office2007Black" TargetType="{x:Type local:ApplicationMenu}">
        <Grid x:Name="PART_ButtonGrid" Height="38" Width="38" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
            <Ellipse Height="37" Width="37" Name="OB"
               Fill="{StaticResource Black.AppButton.OutterBorderFill}"
               Stroke="{StaticResource Black.AppButton.OutterBorder}"
               StrokeThickness="1"
               SnapsToDevicePixels="True" />
            <Ellipse Height="37" Width="37"
               Stroke="{StaticResource Black.AppButton.OutterBorder}"
               Opacity="0.6"
               StrokeThickness="1"
               SnapsToDevicePixels="True">
                <Ellipse.RenderTransform>
                    <TranslateTransform X="1" Y="0.4" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Height="35" Width="35"
               Fill="{StaticResource Black.AppButton.InnerBorderFill}"
               Name="IB"
               Stroke="{StaticResource Black.AppButton.InnerBorder}"
               SnapsToDevicePixels="True" />
            <Ellipse Height="33" Width="33"
               Fill="{StaticResource Black.AppButton.TopHighlight}"
               Name="TH"
               SnapsToDevicePixels="True" />
            <Ellipse Height="33" Width="33"
               Fill="{StaticResource Black.AppButton.BottomHighlight}"
               Name="BH"
               SnapsToDevicePixels="True" />
            <Image Name="PART_ApplicationButtonImage"
             Margin="1.5,1,0,0"
             HorizontalAlignment="Center"             
             VerticalAlignment="Center"             
             Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
             Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
             Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
             SnapsToDevicePixels="True"/>
            <local:CustomPopup StaysOpen="False" PopupAnimation="Fade" Placement="Bottom" HorizontalOffset="-3" VerticalOffset="-16" x:Name="PART_Popup" Focusable="False" AllowsTransparency="True" IsOpen="{Binding Path=IsPopupOpen, Mode=TwoWay, UpdateSourceTrigger=Explicit, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" >
                <mwt:SystemDropShadowChrome Name="Shdw" Margin="0">
                    <Grid>
                        <Border BorderBrush="{StaticResource Black.AppMenu.OutterBorderBrush}" CornerRadius="{StaticResource Default.AppMenuCornerRadius}" BorderThickness="1,1,1,1">
                            <Border BorderBrush="{StaticResource Black.AppMenu.InnerBorderBrush}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderThickness="1,1,1,1" Background="{StaticResource Black.AppMenu.Background}">
                                <DockPanel LastChildFill="True">
                                    <Border Height="15" CornerRadius="2,2,2,2" Background="{StaticResource Black.AppMenu.BackgroundTop}" DockPanel.Dock="Top" />
                                    <DockPanel LastChildFill="True">
                                        <Border Height="Auto" CornerRadius="0,0,2,2" Background="{StaticResource Black.AppMenu.BackgroundBottom}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                                            <shared:ItemsControlInternal x:Name="PART_AppItems" 
                                                   Margin="0,-2,0,-1" 
                                                   Visibility="Visible" 
                                                   HorizontalAlignment="Right" 
                                                   Padding="1,3,1,3"
                                                   ItemContainerStyle="{StaticResource ItemsControlInternalItemStyle}">
                                                <shared:ItemsControlInternal.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel KeyboardNavigation.DirectionalNavigation="Contained" IsItemsHost="True" Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </shared:ItemsControlInternal.ItemsPanel>
                                            </shared:ItemsControlInternal>
                                        </Border>
                                        <Border Margin="2,0,2,1" BorderBrush="{StaticResource Black.AppMenu.BorderBrush1}" BorderThickness="1,1,1,1" Grid.Row="1">
                                            <Border BorderBrush="{StaticResource Black.AppMenu.BorderBrush2}" BorderThickness="1,1,1,1" Background="{StaticResource Black.AppMenu.Background2}">
                                                <DockPanel LastChildFill="True">
                                                    <Border x:Name="PART_Border" BorderBrush="{StaticResource Black.AppMenu.BorderBrush3}" Visibility="Visible" BorderThickness="1,0,0,0" Background="{StaticResource Black.AppMenu.Background3}" DockPanel.Dock="Right">
                                                        <Border BorderBrush="{StaticResource Black.AppMenu.BorderBrush4}" BorderThickness="1,0,0,0" Padding="2,2,2,2">
                                                            <ItemsControl x:Name="PART_MenuItems" ItemTemplate="{x:Null}" Foreground="{StaticResource Black.Foreground}" />
                                                        </Border>
                                                    </Border>
                                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,-5,-5" HorizontalScrollBarVisibility="Hidden">
                                                        <ItemsPresenter Margin="0,0,5,5" x:Name="PART_Items" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </Border>
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                        </Border>
                        <Grid Name="PART_FakeAppButton"
                              Height="38" Width="38"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Ellipse Height="37" Width="37"
                                    Fill="{StaticResource AppButtonExpandedOutterBorderFill}"
                                    Stroke="{StaticResource Black.AppButton.OutterBorder}"
                                    StrokeThickness="1"/>
                            <Ellipse Height="37" Width="37"
                                Stroke="{StaticResource AppButtonExpandedOutterBorder}"
                                Opacity="0.6"
                                StrokeThickness="1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="1"  Y="0.4"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Height="35" Width="35"
                                Fill="{StaticResource AppButtonExpandedInnerBorderFill}"
                                Stroke="{StaticResource Black.AppButton.InnerBorder}" />
                            <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedTopHighlight}"/>
                            <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedBottomHighlight}"/>
                            <Image Margin="1.5,1,0,0"                               
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
                                 SnapsToDevicePixels="True"/>
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="-22" />
                            </Grid.RenderTransform>
                        </Grid>
                    </Grid>
                </mwt:SystemDropShadowChrome>
            </local:CustomPopup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="Shdw" Property="Margin" Value="0,0,4,4"/>
            </Trigger>
            <Trigger Property="IsBelowAppButton" Value="False">
                <Setter TargetName="PART_FakeAppButton" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonHoverOutterBorderFill}"/>
                <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonHoverOutterBorder}"/>
                <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonHoverInnerBorderFill}"/>
                <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonHoverInnerBorder}"/>
                <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonHoverTopHighlight}"/>
                <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonHoverBottomHighlight}"/>
            </Trigger>
            <Trigger Property="IsPopupOpen" Value="True">
                <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonExpandedOutterBorderFill}"/>
                <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonExpandedOutterBorder}"/>
                <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonExpandedInnerBorderFill}"/>
                <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonExpandedInnerBorder}"/>
                <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonExpandedTopHighlight}"/>
                <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonExpandedBottomHighlight}"/>
            </Trigger>
            <Trigger Property="IsKeyTipShown" Value="True">
                <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonExpandedOutterBorderFill}"/>
                <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonExpandedOutterBorder}"/>
                <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonExpandedInnerBorderFill}"/>
                <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonExpandedInnerBorder}"/>
                <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonExpandedTopHighlight}"/>
                <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonExpandedBottomHighlight}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

