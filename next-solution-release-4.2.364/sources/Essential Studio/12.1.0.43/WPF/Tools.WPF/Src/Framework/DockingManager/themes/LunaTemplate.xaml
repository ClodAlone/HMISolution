    <ControlTemplate x:Key="DefaultCustomMenuItemTemplate" TargetType="{x:Type Syncfusion:CustomMenuItem}" >
            <Border  Name="Bd" 
				 Background="Transparent" 
                 SnapsToDevicePixels="True">
			<Grid ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition SharedSizeGroup="MenuItemIconColumnGroup" Width="26" MinWidth="17" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto" />
					<ColumnDefinition Width="18" />
				</Grid.ColumnDefinitions>
				<Border Name="grad" 
                        BorderBrush="{StaticResource Default.MenuItemSeparatorBackground}" 
                        BorderThickness="0, 0, 1, 0" 
                        SnapsToDevicePixels="True" 
                        Background="{StaticResource Default.MenuItemLeftBarBrush}">
				</Border>
				<Border Name="back" 
                        CornerRadius="4" 
                        BorderThickness="1" 
                        SnapsToDevicePixels="True" 
                        Grid.ColumnSpan="4" 
                        Margin="2, 0, 2, 0"
                        BorderBrush="{StaticResource Default.MenuItemBorderBrush}" 
                        Opacity="0"/>
				<ContentPresenter ContentSource="Icon" 
                                  ContentTemplate="{TemplateBinding Syncfusion:CustomMenuItem.IconTemplate}"
                                  Margin="0,2,0,0" 
                                  Name="Icon" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center" 
                                  Content="{TemplateBinding MenuItem.Icon}" />
				<Border 
					Visibility="Hidden" 
					HorizontalAlignment="Left" 
					Margin="4,0,0,0" 
					BorderThickness="1"
					BorderBrush="{StaticResource Default.MenuItemGlyphBorderBrush}"
					Background="{StaticResource Default.MenuItemGlyphBackBrush}"
					VerticalAlignment="Center" 
					Width="20" Height="20" 
					Name="GlyphPanel" >
					<Path Stretch="Fill" 
						  Stroke="{StaticResource Default.MenuItemGlyphForegroundBrush}" 
						  HorizontalAlignment="Center" 
						  Margin="0" 
						  VerticalAlignment="Center" 
						  Width="7.5" 
						  Height="5.875" 
						  Data="M5.375,11.125 L7.75,13.25 11.875,8.375"/>
				</Border>
                <ContentPresenter ContentSource="Header" Margin="4,2,4,2" Name="HeaderHost" TextBlock.Foreground="{StaticResource Default.MenuItemForeground}"
								  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"
								  RecognizesAccessKey="True" VerticalAlignment="Center" Grid.Column="1" >
				</ContentPresenter>
				<TextBlock Margin="5,2,0,2" Text="{TemplateBinding MenuItem.InputGestureText}" Grid.Column="2" DockPanel.Dock="Right"
						   Foreground="{StaticResource Default.MenuItemForeground}"/>
