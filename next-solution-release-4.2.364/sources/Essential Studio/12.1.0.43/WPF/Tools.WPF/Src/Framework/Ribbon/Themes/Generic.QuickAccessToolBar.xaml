                        <ItemsPanelTemplate>
                            <local:QuickAccessToolBarPanel						  
						HorizontalAlignment="Left"  
						ClipToBounds="True" 
						Background="Transparent"                                        
						GeometryBackground="{Binding Path=GeometryBackground, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                        
						GeometryStroke="{Binding Path=GeometryStroke, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                         
						GeometryStrokeThickness="1"                                                                                                 
						HasGeometry="{Binding Path=HasGeometry, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid>
                    <local:DropDownButton Style="{StaticResource QuickAccessPopupButtonStyle.Blend}"  Name="PART_PopupButton" DockPanel.Dock="Right">
                        <local:DropDownButton.PathGeometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                <PathGeometry>
                                    <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="8,10"/>
                                        <LineSegment Point="6.5,12.5"/>
                                    </PathFigure>
                                </PathGeometry>
                            </GeometryGroup>
                        </local:DropDownButton.PathGeometry>

                        <Border BorderThickness="0.5" BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}" Padding="2" Width="220">
                            <Grid>
                                <DockPanel>
                                    <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blend.QATContextMenuLeftBarBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" />
                                </DockPanel>
                                <StackPanel>

                                    <Border Background="{StaticResource Blend.QATContextMenuTopBarBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" Margin="0,0,0,1" Height="22">
                                        <TextBlock x:Uid="CustomizeQATTextBlock"  Margin="3,0,0,0"  Foreground="{StaticResource Blend.QATContextMenuForeground}" Text="{StaticResource CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl Name="PART_QATMenu" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle.Blend}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Separator Name="TopSeperator" Visibility="Collapsed" Background="{StaticResource Blend.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
                                    <local:RibbonButton Name="PART_MoreCommands"  Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Label="{StaticResource QATMoreCommands}" Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource Blend.Foreground2}"/>
                                    <local:RibbonButton Name="PART_AboveButton" Visibility="Collapsed"  Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Label="{StaticResource QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blend.Foreground2}"/>
                                    <local:RibbonButton Name="PART_BelowButton" Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Label="{StaticResource QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blend.Foreground2}"/>
                                    <Separator Background="{StaticResource Blend.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
                                    <local:RibbonButton Name="PART_MinimizeButton"  Style="{StaticResource RibbonButtonPopupItemStyle.Blend}"  Command="local:RibbonCommands.MinimizeRibbon"  Label="{StaticResource MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blend.Foreground2}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </local:DropDownButton>

                    <local:DropDownButton  
            Grid.Column="1"
            Name="PART_OverflowButton"
            Style="{StaticResource QuickAccessPopupButtonStyle.Blend}"                           
            Visibility="Collapsed" 
            DockPanel.Dock="Right">
                        <local:DropDownButton.PathGeometry>
                            <GeometryGroup>
                                <PathGeometry>
                                    <PathFigure StartPoint="3.5,8" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="4.5,9"/>
                                        <LineSegment Point="3.5,10"/>
                                    </PathFigure>
                                </PathGeometry>

                                <PathGeometry>
                                    <PathFigure StartPoint="7.5,8" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="8.5,9"/>
                                        <LineSegment Point="7.5,10"/>
                                    </PathFigure>
                                </PathGeometry>

                            </GeometryGroup>
                        </local:DropDownButton.PathGeometry>

                        <StackPanel Orientation="Horizontal" Background="{StaticResource Blend.QuickAccessActiveBrush}" MaxHeight="21">
                            <ItemsControl Name="PART_PopupItemsControl" >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <local:DropDownButton Name="PART_PopupButtonOverflowed"   Style="{StaticResource QuickAccessPopupButtonStyle.Blend}">
                                <local:DropDownButton.PathGeometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                        <PathGeometry>
                                            <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                                <LineSegment Point="8,10"/>
                                                <LineSegment Point="6.5,12.5"/>
                                            </PathFigure>

                                        </PathGeometry>
                                    </GeometryGroup>
                                </local:DropDownButton.PathGeometry>

                                <Border BorderThickness="0.5" BorderBrush="Gray" Padding="2" Width="220">
                                    <Grid>
                                        <DockPanel>
                                            <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blend.QATContextMenuLeftBarBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" />
                                        </DockPanel>
                                        <StackPanel>

                                            <Border Background="{StaticResource Blend.QATContextMenuTopBarBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" Margin="0,0,0,1" Height="22">
                                                <TextBlock x:Uid="CustomizeQATTextBlock" Margin="3,0,0,0"  Foreground="{StaticResource Blend.QATContextMenuForeground}" Text="{StaticResource CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" />
                                            </Border>
                                            <ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle.Blend}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Separator Name="TopSeperatorOverFlow" Visibility="Collapsed" Background="{StaticResource Blend.QuickDropDownSeparator}" Margin="2,0,0,0" Height="2"></Separator>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Label="{StaticResource QATMoreCommands}" Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource Blend.Foreground2}"/>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{StaticResource QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blend.Foreground2}"/>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{StaticResource QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blend.Foreground2}"/>
                                            <Separator Background="{StaticResource Blend.QuickDropDownSeparator}" Margin="2,0,0,0" Height="2"></Separator>
                                            <local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle.Blend}" Label="{StaticResource MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blend.Foreground2}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </local:DropDownButton>
                        </StackPanel>
                    </local:DropDownButton>

                </Grid>
            </local:TwoItemsLayoutPanelEx>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="HasOverflowChildren" Value="True">
                <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
            </Trigger>

            <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
                <Setter Property="Visibility" TargetName="TopSeperator" Value="Visible" />
            </Trigger>
            <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenuOverFlow">
                <Setter Property="Visibility" TargetName="TopSeperatorOverFlow" Value="Visible" />
            </Trigger>

            <Trigger Property="HasGeometry" Value="False">
                <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--QuickAccessToolBar style-->
    <Style x:Key="{x:Type local:QuickAccessToolBar}" TargetType="{x:Type local:QuickAccessToolBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="GeometryBackground" Value="{StaticResource Blue.QuickAccessActiveBrush}"/>
        <Setter Property="GeometryStroke" Value="{StaticResource Blue.ActiveGeometryStroke}"/>        
        <Setter Property="Control.Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.Office2007Blue}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="GeometryBackground" Value="{StaticResource Black.QuickAccessActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Black.ActiveGeometryStroke}"/>
                <Setter Property="Control.Foreground" Value="{StaticResource Black.Foreground}"/>
                <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.Office2007Black}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="GeometryBackground" Value="{StaticResource Silver.QuickAccessActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Silver.ActiveGeometryStroke}"/>
                <Setter Property="Control.Foreground" Value="{StaticResource Silver.Foreground}"/>
                <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="GeometryBackground" Value="{StaticResource Office2003.QuickAccessActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Office2003.ActiveGeometryStroke}"/>
                <Setter Property="Control.Foreground" Value="{StaticResource Blue.Foreground}"/>
                <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="GeometryBackground" Value="{StaticResource Blend.QuickAccessActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Blend.ActiveGeometryStroke}"/>
                <Setter Property="Control.Foreground" Value="{StaticResource Blend.Foreground2}"/>
                <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="GeometryBackground" Value="{StaticResource QuickAccessActiveBrush.ShinyRed}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Control.Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="GeometryBackground" Value="{StaticResource QuickAccessActiveBrush.ShinyBlue}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Control.Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate.ShinyBlue}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False">
                <Setter Property="GeometryBackground" Value="{StaticResource Blue.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Blue.GeometryStroke}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2007Black"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="GeometryBackground" Value="{StaticResource Black.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Black.GeometryStroke}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2007Silver"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="GeometryBackground" Value="{StaticResource Silver.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Silver.GeometryStroke}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2003"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="GeometryBackground" Value="{StaticResource Office2003.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Office2003.GeometryStroke}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Blend"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="GeometryBackground" Value="{StaticResource Blend.QuickAccessBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Blend.GeometryStroke}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="ShinyRed"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="GeometryBackground" Value="{StaticResource QuickAccessBrush.ShinyRed}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="ShinyBlue"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="GeometryBackground" Value="{StaticResource QuickAccessBrush.ShinyBlue}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
            </MultiDataTrigger>            
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                     Value="True">
                <Setter Property="GeometryBackground" Value="Transparent"/>                
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
