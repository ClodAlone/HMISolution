    <ControlTemplate x:Key="RibbonBarPresenterTemplate.ShinyRed" TargetType="{x:Type local:RibbonBar}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HoverOn">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.4000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOn1">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation1" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff1">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation1" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.4000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

        </ControlTemplate.Resources>
        <Border Background="{TemplateBinding Background}" 
            CornerRadius="3"
					  BorderBrush="{TemplateBinding BorderBrush}" ClipToBounds="True" 
					  BorderThickness="{TemplateBinding BorderThickness}">

            <Grid ClipToBounds="True" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"></RowDefinition>
                    <RowDefinition Height="17"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Name="PART_RibbonBarBorder"
              BorderBrush="{StaticResource RibbonbarBorderBrushKey.ShinyRed}"
              BorderThickness="0" ClipToBounds="True"
              CornerRadius="3,3,0,0">
                    <Border Name="PART_presenterBorder"
                    Grid.Row="0" ClipToBounds="True" CornerRadius="3,3,0,0"
                    Background="{StaticResource RibbonBarBackgroundBrushKey1.ShinyRed}">
                        <Grid>
                            <Border x:Name="BackgroundAnimation1" Opacity="0" Background="{StaticResource RibBackgroundBrushKey.ShinyRed}" CornerRadius="3,3,0,0"/>

                            <ItemsPresenter/>
                        </Grid>
                    </Border>
                </Border>

                <!--<Border Name="PART_hoverHeaderBorder" Grid.Row="1" Opacity="0" Background="{shared:SkinObject RibbonBarHeaderBackgroundHover}"/>-->

                <Border Name="PART_headerBorder"  ClipToBounds="True" CornerRadius="0,0,3,3" Grid.Row="1" Background="{StaticResource RibbonBarHeader.ShinyRed}">
                    <Grid>
                        <Border x:Name="BackgroundAnimation" ClipToBounds="True"  Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyRed}" CornerRadius="0,0,3,3"/>

                        <DockPanel>
                            <!--<ContentPresenter Width="15" Height="14" DockPanel.Dock="Right" Content="{TemplateBinding Launcher}"/>-->
                            <local:RibbonButton Name="PART_DialogLauncherButton" 
										              Style="{StaticResource RibbonBarLauncherButton}"  
                                  DockPanel.Dock="Right" 
                                  SizeForm="ExtraSmall" 
								  SmallIcon="{TemplateBinding CollapseImage}" 
                                  Width="15" 
                                  Height="14"                                										 
								  Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommand }"
                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandParameter }"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandTarget }"
                                  ToolTip="{TemplateBinding LauncherToolTip}"
                                  Visibility="{TemplateBinding IsLauncherButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            </local:RibbonButton>
                            <TextBlock Foreground="{StaticResource TextBrushKey.ShinyRed}" Name="header"  TextAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Header}"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOff}" x:Name="HoverOff_BeginStoryboard"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOn}" x:Name="HoverOn_BeginStoryboard"/>
                </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOff1}" x:Name="HoverOff_BeginStoryboard1"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOn1}" x:Name="HoverOn_BeginStoryboard1"/>
                </Trigger.EnterActions>
            </Trigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
             Value="True">
                <Setter TargetName="PART_RibbonBarBorder" Property="BorderBrush" Value="{StaticResource RibbonBar.Context.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RibbonBar.Context.BorderBrush}"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                     Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_presenterBorder"  Property="Background" Value="{StaticResource RibbonBar.Context.Hover.BackgroundBrush}"/>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

