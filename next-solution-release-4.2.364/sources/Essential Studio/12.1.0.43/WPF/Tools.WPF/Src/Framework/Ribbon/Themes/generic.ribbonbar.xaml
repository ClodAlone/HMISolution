                            CornerRadius="3,3,0,0">
                                <Border Name="PART_PresenterBorder" Grid.Row="0">
                                    <ItemsPresenter/>
                                </Border>
                            </Border>


                            <Border Grid.Row="1" Name="PART_headerBorder"
                                                    Background="{StaticResource RibbonBarHeader.ShinyBlue}">
                                <DockPanel>
                                    <local:RibbonButton Name="PART_DialogLauncherButton" 
                                            Style="{StaticResource RibbonBarLauncherButton}"  
                                            DockPanel.Dock="Right" 
                                            SizeForm="ExtraSmall" 
                                            Width="15" 
                                            Height="14"
                                            SmallIcon="{TemplateBinding CollapseImage}" 
											Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandParameter }"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandTarget }"
                                            ToolTip="{TemplateBinding LauncherToolTip}"
                                            Visibility="{TemplateBinding IsLauncherButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    </local:RibbonButton>
                                    <TextBlock Foreground="{StaticResource TextBrushKey.ShinyBlue}"  
                                   TextAlignment="Center" 
								   VerticalAlignment ="Center"
                                   Text="{TemplateBinding Header}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <!--</Border>-->
                    </Border>
                </local:DropDownButton>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
             Value="True">
                <Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="{StaticResource RibbonBar.Context.BorderBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RibbonBarButton.Context.BackgroundBrush}"/>
            </DataTrigger>



            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                     Value="True"/>
                    <Condition Binding="{Binding ElementName=PART_RibbonDropDownButton, Path=IsDropDownOpen}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="{StaticResource RibbonBar.Context.BorderBrush}"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                     Value="True"/>
                    <Condition Binding="{Binding ElementName=PART_PopupBorder, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_PresenterBorder"  Property="Background" Value="{StaticResource RibbonBar.Context.Hover.BackgroundBrush}"/>
            </MultiDataTrigger>

            <Trigger Property="PanelState" Value="Collapsed">
                <Setter TargetName="PART_RibbonDropDownButton" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>




    <!--RibbonBar style-->
    <Style TargetType="{x:Type local:RibbonBar}">        
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="CollapseImage"  Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt16.png"/>
        <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.Office2007Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>     
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="1,2,1,2"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:GroupPanel 
                 PanelState="{Binding RelativeSource={RelativeSource FindAncestor
                 , AncestorType={x:Type local:RibbonBar}}, Path=PanelState, Mode=OneWay}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="BorderBrush" Value="{StaticResource Black.Ribbon.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.Office2007Black}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="BorderBrush" Value="{StaticResource Silver.Ribbon.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.Ribbon.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="BorderBrush" Value="{StaticResource Blend.Ribbon.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="PanelState" Value="ExtraSmall">
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.Office2007Blue}"/>
                <Setter Property="Margin" Value="0"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="PanelState" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.Office2007Black}"/>
                <Setter Property="Margin" Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="PanelState" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.Office2007Silver}"/>
                <Setter Property="Margin" Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="PanelState" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.Office2003}"/>
                <Setter Property="Margin" Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="PanelState" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.Blend}"/>
                <Setter Property="Margin" Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="PanelState" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.ShinyRed}"/>
                <Setter Property="Margin" Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="PanelState" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate.ShinyBlue}"/>
                <Setter Property="Margin" Value="0"/>
            </MultiTrigger>
            <Trigger Property="PanelState" Value="Collapsed">
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.Office2007Blue}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="PanelState" Value="Collapsed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.Office2007Black}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="PanelState" Value="Collapsed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.Office2007Silver}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="PanelState" Value="Collapsed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.Office2003}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="PanelState" Value="Collapsed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.Blend}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="PanelState" Value="Collapsed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.ShinyRed}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="PanelState" Value="Collapsed"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate.ShinyBlue}"/>
            </MultiTrigger>
            <Trigger Property="IsLargeButtonPanel" Value="true">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:LargeButtonPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>