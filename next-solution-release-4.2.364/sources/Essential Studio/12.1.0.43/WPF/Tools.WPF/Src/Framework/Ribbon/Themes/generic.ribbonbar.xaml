    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    >
    <ResourceDictionary.MergedDictionaries>       
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.RibbonLauncherButton.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Converters.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <ControlTemplate x:Key="RibbonBarPresenterTemplate.Office2007Blue" TargetType="{x:Type local:RibbonBar}">
        <Border Background="{TemplateBinding Background}" 
            CornerRadius="3,3,3,3"
					  BorderBrush="{TemplateBinding BorderBrush}"
					  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"></RowDefinition>
                    <RowDefinition Height="17"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Name="PART_RibbonBarBorder"
              BorderBrush="{StaticResource RibbonBarBorderBrush}"
              BorderThickness="1,1,1,0"
              CornerRadius="3,3,0,0">
                    <Border Name="PART_presenterBorder"
                    Grid.Row="0"
                    Background="{StaticResource RibbonBarBackgroundBrush1}">
                        <ItemsPresenter/>
                    </Border>
                </Border>

                <!--<Border Name="PART_hoverHeaderBorder" Grid.Row="1" Opacity="0" Background="{shared:SkinObject RibbonBarHeaderBackgroundHover}"/>-->

                <Border Name="PART_headerBorder" CornerRadius="0,0,2,2" Grid.Row="1" Background="{StaticResource Blue.RibbonBarHeader.BackgroundBrush}">

                    <DockPanel>
                        <!--<ContentPresenter Width="15" Height="14" DockPanel.Dock="Right" Content="{TemplateBinding Launcher}"/>-->
                        <local:RibbonButton Name="PART_DialogLauncherButton" 
										              Style="{StaticResource RibbonBarLauncherButton}"  
                                  DockPanel.Dock="Right" 
                                  SizeForm="ExtraSmall" 
								  SmallIcon="{TemplateBinding CollapseImage}" 
                                  Width="15" 
                                  Height="14"                                										 
								  Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommand }"
                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandParameter }"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandTarget }"
                                  ToolTip="{TemplateBinding LauncherToolTip}"
                                  Visibility="{TemplateBinding IsLauncherButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        </local:RibbonButton>
                        <TextBlock Foreground="{StaticResource Blue.Foreground2}" Name="header"  TextAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Header}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_headerBorder" Property="Background" Value="{StaticResource Blue.RibbonBarHeader.BackgroundHoverBrush}"/>
                <Setter TargetName="PART_presenterBorder" Property="Background" Value="{StaticResource Blue.RibbonBar.BackgroundHoverBrush}"/>
                <Setter TargetName="header" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>

            </Trigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
             Value="True">
                <Setter TargetName="PART_RibbonBarBorder" Property="BorderBrush" Value="{StaticResource RibbonBar.Context.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RibbonBar.Context.BorderBrush}"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                     Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_presenterBorder"  Property="Background" Value="{StaticResource RibbonBar.Context.Hover.BackgroundBrush}"/>
            </MultiDataTrigger>


        </ControlTemplate.Triggers>
    </ControlTemplate>
