    <Style x:Key="HeaderThemedCloseButtonStyle" TargetType="{x:Type Button}"
            BasedOn="{StaticResource HeaderClassicButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Default.HeaderCloseButtonInactiveBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource Default.HeaderCloseButtonInactiveBackground}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Default.HeaderCloseButtonActiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Default.HeaderCloseButtonActiveBackground}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Default.HeaderCloseButtonHighlightBorderBrush}"/>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Default.HeaderCloseButtonActiveHighlightBackground}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="False" />
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Default.HeaderCloseButtonInactiveHighlightBackground}"/>
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Default.HeaderCloseButtonPressedBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

