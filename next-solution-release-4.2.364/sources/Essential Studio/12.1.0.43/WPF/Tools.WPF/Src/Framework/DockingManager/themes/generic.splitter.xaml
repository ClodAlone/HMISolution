<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls">
    

  <ControlTemplate x:Key="SplitterAdornerTemplate">
    <StackPanel x:Name="stPanel" Orientation="Horizontal">
      <Border MinWidth="4" MinHeight="4" 
			  >
        <Border.Background>
          <SolidColorBrush Color="Gray" Opacity="0.6" />
        </Border.Background>
      </Border>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="Syncfusion:SplitterAdorner.Orientation" Value="Horizontal">
        <Setter TargetName="stPanel" Property="LayoutTransform">
          <Setter.Value>
            <RotateTransform Angle="-90"/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

    <ControlTemplate x:Key="SplitterAdornerTemplate.ShinyRed">
        <StackPanel x:Name="stPanel" Orientation="Horizontal">
            <Border MinWidth="4" MinHeight="4" 
			  >
                <Border.Background>
                    <SolidColorBrush Color="#FF7B1C1A" Opacity="0.6" />
                </Border.Background>
            </Border>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Syncfusion:SplitterAdorner.Orientation" Value="Horizontal">
                <Setter TargetName="stPanel" Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SplitterAdornerTemplate.ShinyBlue">
        <StackPanel x:Name="stPanel" Orientation="Horizontal">
            <Border MinWidth="4" MinHeight="4" 
			  >
                <Border.Background>
                    <SolidColorBrush Color="#FF0C4475" Opacity="0.6" />
                </Border.Background>
            </Border>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Syncfusion:SplitterAdorner.Orientation" Value="Horizontal">
                <Setter TargetName="stPanel" Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SplitterTemplate" TargetType="{x:Type Syncfusion:Splitter}">
    <Border Name="border" Margin="1" Background="{TemplateBinding Background}" />
	</ControlTemplate>

</ResourceDictionary>