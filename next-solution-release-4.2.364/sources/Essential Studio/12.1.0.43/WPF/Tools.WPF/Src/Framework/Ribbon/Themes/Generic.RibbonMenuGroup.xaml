    <Style x:Key="{x:Type local:RibbonMenuGroup}" TargetType="{x:Type local:RibbonMenuGroup}">
      
        <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.Office2007Blue}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.Office2007Blue}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.ShinyRed}"/>                
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource RibbonMenuGroupTemplate.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
            
    </Style>
