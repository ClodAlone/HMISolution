<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Converters.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="RibbonMenuGroupTemplate.Office2007Blue" TargetType="{x:Type local:RibbonMenuGroup}">
        <!--Width="{TemplateBinding ActualWidth}"-->
        <local:LayoutPanel x:Name="PART_LayoutPanel" Width="{TemplateBinding ActualWidth}">
            <StackPanel Margin="1,0,1,1" HorizontalAlignment="Stretch">
                <Border Name="PART_Header"  Height="21"  HorizontalAlignment="Stretch" Margin="0,0,0,2"  SnapsToDevicePixels="True" Background="{StaticResource Blue.MenuItems.HeaderBackground}" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0" Padding="7,0,5,0" >
                    <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{StaticResource Blue.Foreground}" VerticalAlignment="Center"/>
                </Border>
                <ItemsPresenter KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" x:Name="PART_Presenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,1"/>
            </StackPanel>
            <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BoolToVisibilityConverter}}"  Margin="1,1,1,1" Background="{StaticResource Blue.MenuItems.HeaderBackground}" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
        </local:LayoutPanel>

        <ControlTemplate.Triggers>
            <Trigger Property="HasHeader" Value="False">
                <Setter TargetName="PART_Header" Property="Height" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
