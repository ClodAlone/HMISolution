<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"		 
					xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"					
          xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"    
					xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/generic.CustomScrollViewer.xaml"/>

    </ResourceDictionary.MergedDictionaries>



    <ControlTemplate x:Key="MenuButtonTemplate.ShinyRed" TargetType="{x:Type local:MenuButton}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HighlightedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HighlightedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Border x:Name="PART_OutterBorder"
		   BorderThickness="1"
		   BorderBrush="{TemplateBinding BorderBrush}"
		   Background="{TemplateBinding Background}"
		   Opacity="{TemplateBinding Opacity}"
		   IsEnabled="{TemplateBinding IsEnabled}" >
            <Grid>
                <Border Background="{StaticResource NormalBackgroundBrushKey.ShinyRed}"  
		    Opacity="0" x:Name="border"/>

                <Grid>
                    <Border x:Name="PART_InnerBorder" BorderThickness="1">
                        <DockPanel LastChildFill="True" MaxWidth="{TemplateBinding ActualWidth}" >
                            <Path Fill="{StaticResource GlyphBrushKey.ShinyRed}" Margin="5,16,4,0" DockPanel.Dock="Right"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="M 0 0 L 4 4 L 8 0 Z">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Path.RenderTransform>
                            </Path>
                            <DockPanel DockPanel.Dock="Left" HorizontalAlignment="Stretch" Margin="1,3,3,1">
                                <Image	   Margin="5,1,5,3" 
									   DockPanel.Dock="Left"
									   Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
									   MinWidth="16" MinHeight="16" MaxHeight="32" MaxWidth="32" Stretch="None" />
                                <StackPanel Orientation="Vertical" Margin="0,0,0,2" VerticalAlignment="Center" DockPanel.Dock="Right">
                                    <TextBlock x:Name="PART_Label"
										   TextWrapping="Wrap" TextAlignment="Center"
										   Foreground="{StaticResource TextBrushKey.ShinyRed}"
										   VerticalAlignment="Center" HorizontalAlignment="Left"
										   Margin="0,0,0,2"
										   FontWeight="Bold"
										   Text="{TemplateBinding Label}"
										   DockPanel.Dock="Bottom"/>
                                    <local:TwoLinesLayoutPanel HorizontalAlignment="Left">
                                        <TextBlock x:Name="PART_Description" TextWrapping="Wrap" Margin="0,0,10,0" TextAlignment="Left" 
									   Foreground="{StaticResource TextBrushKey.ShinyRed}"
									   VerticalAlignment="Center" HorizontalAlignment="Left"
									   Text="{TemplateBinding Description}"/>
                                    </local:TwoLinesLayoutPanel>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <local:CustomPopup Name="PART_Popup"
					  Placement="Custom"
					  PlacementTarget ="{Binding Path=PlacementBorder, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ApplicationMenu}}}"
					  Focusable="False"
					  PopupAnimation="Fade"
					  AllowsTransparency="True"
					  StaysOpen="True"
					  IsOpen="{Binding Path=IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true" Margin="0">
                            <Border Background="{StaticResource MenuBackgroundBrushKey.ShinyRed}" BorderThickness="1" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyRed}" >
                                <ScrollViewer x:Name="PART_ScrollViwer" Style="{StaticResource CustomScrollViewerStyle}" >
                                    <ItemsPresenter
								  Margin="{TemplateBinding Control.Padding}"
								  HorizontalAlignment="Stretch"
								  VerticalAlignment="Stretch"
								  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Microsoft_Windows_Themes:SystemDropShadowChrome>
                    </local:CustomPopup>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,3,3"/>
            </Trigger>

            <Trigger Property="IsFocused" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOff}" x:Name="HighlightedOff_BeginStoryboard"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOn}"/>
                </Trigger.EnterActions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOff}" x:Name="HighlightedOff_BeginStoryboard1"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOn}"/>
                </Trigger.EnterActions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=Description, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_Label" Property="FontWeight" Value="Normal"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
