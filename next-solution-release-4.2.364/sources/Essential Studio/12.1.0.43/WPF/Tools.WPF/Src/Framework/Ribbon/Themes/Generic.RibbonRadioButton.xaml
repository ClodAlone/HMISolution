  <Style x:Key="TextBoxStyle1" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Blue.CheckBox.BorderBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    <Setter Property="BorderThickness" Value="1"/>        
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="AllowDrop" Value="true"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="BorderBrush" Value="{StaticResource Black.CheckBox.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
            </Trigger>
           
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="BorderBrush" Value="{StaticResource Silver.CheckBox.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Silver.Foreground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.CheckBoxBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="BorderBrush" Value="{StaticResource Blend.CheckBoxBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="RibbonRadioButtonTemplate.Office2007Blue" TargetType="{x:Type local:RibbonRadioButton}">
        <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
                <Canvas Width="13" Height="13">
                    <Ellipse x:Name="ellipse1" Width="13" Height="13" Fill="{StaticResource Blue.CheckBoxBackground}" Stroke="{StaticResource Blue.CheckBox.BorderBrush}">
                    </Ellipse>
                    <Ellipse x:Name="ellipse2" Fill="{StaticResource Blue.CheckBox.InnerBorderBrush}" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                    </Ellipse>
                    <Ellipse x:Name="ellipse3" Fill="{StaticResource CheckRadioInnerFillBrush}" Canvas.Left="3" Canvas.Top="3" Width="7" Height="7">
                    </Ellipse>
                    <Ellipse x:Name="ellipse" Canvas.Left="4" Canvas.Top="4" Width="5" Height="5">
                    </Ellipse>
                </Canvas>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="6,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </BulletDecorator>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Fill" TargetName="ellipse" Value="{StaticResource Blue.CheckBox.BorderBrushHover}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ellipse1" Property="Stroke" Value="{StaticResource Blue.CheckBox.BorderBrushHover}" />
                <Setter TargetName="ellipse2" Property="Fill" Value="{StaticResource Blue.CheckBox.InnerBorderBrush}" />
                <Setter TargetName="ellipse3" Property="Fill" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
