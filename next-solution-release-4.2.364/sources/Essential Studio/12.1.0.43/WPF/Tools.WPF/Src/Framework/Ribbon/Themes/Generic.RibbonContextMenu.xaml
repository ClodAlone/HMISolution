<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"                   
                    xmlns:s="clr-namespace:System;assembly=mscorlib"                   
                    xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Themes/LangDictionary.xaml" />        
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SeparatorStyle" TargetType="Separator">
        <Setter Property="Border.BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FrameworkElement.MinHeight" Value="2"/>
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="30,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource Default.QuickDropDownSeparator}"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Margin="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Default.QuickDropDownSeparator}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Default.QuickDropDownSeparator}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Default.QuickDropDownSeparator}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.QuickDropDownSeparator}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource SeparatorBackgroundBrushKey.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="CheckableItemTemplate" TargetType="{x:Type local:RibbonMenuItem}">
        <Border BorderThickness="{TemplateBinding BorderThickness}"
            BorderBrush="{TemplateBinding BorderBrush}"
            Background="{TemplateBinding Panel.Background}"
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            MinWidth="{TemplateBinding MinWidth}"
            MaxWidth="{TemplateBinding MaxWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            MaxHeight="{TemplateBinding MaxHeight}"
            Margin="{TemplateBinding Margin}"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True"
                Name="Bd"  >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="21"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" Margin="-5,0,0,0"
                      Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Default.QuickCheckedButtonBorderBrush}"  
                      Background="{StaticResource Default.QuickCheckedButtonBackgroundBrush}" CornerRadius="2"
                      >
                    <Path Name="path" Stroke="{StaticResource Blue.Foreground}" StrokeThickness="1.4">
                        <Path.Data>
                            <GeometryGroup>
                                <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                                <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Border>

                <TextBlock Grid.Column="1" Margin="7,2,0,2" Text="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="BorderBrush" TargetName="PART_CheckBorder"  Value="{StaticResource Default.QuickCheckedButtonBorderBrush}"/>
                <Setter Property="CornerRadius" TargetName="PART_CheckBorder"  Value="2"/>
                <Setter Property="Background" TargetName="PART_CheckBorder"  Value="{StaticResource Default.QuickCheckedButtonBackgroundBrush}"/>
                <Setter Property="Stroke" TargetName="path"  Value="{StaticResource Black.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="BorderBrush" TargetName="PART_CheckBorder"  Value="{StaticResource Default.QuickCheckedButtonBorderBrush}"/>
                <Setter Property="CornerRadius" TargetName="PART_CheckBorder"  Value="2"/>
                <Setter Property="Background" TargetName="PART_CheckBorder"  Value="{StaticResource Default.QuickCheckedButtonBackgroundBrush}"/>
                <Setter Property="Stroke" TargetName="path"  Value="{StaticResource Silver.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="BorderBrush" TargetName="PART_CheckBorder"  Value="{StaticResource Default.QuickCheckedButtonBorderBrush}"/>
                <Setter Property="CornerRadius" TargetName="PART_CheckBorder"  Value="2"/>
                <Setter Property="Background" TargetName="PART_CheckBorder"  Value="{StaticResource Default.QuickCheckedButtonBackgroundBrush}"/>
                <Setter Property="Stroke" TargetName="path"  Value="{StaticResource Blue.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="BorderBrush" TargetName="PART_CheckBorder"  Value="{StaticResource Blend.QuickCheckedButtonBorderBrush}"/>
                <Setter Property="CornerRadius" TargetName="PART_CheckBorder"  Value="0"/>
                <Setter Property="Background" TargetName="PART_CheckBorder"  Value="{StaticResource Blend.QuickCheckedButtonBackgroundBrush}"/>
                <Setter Property="Stroke" TargetName="path"  Value="{StaticResource Blend.Foreground2}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="BorderBrush" TargetName="PART_CheckBorder"  Value="{StaticResource TransparentBorderBrush.ShinyRed}"/>
                <Setter Property="CornerRadius" TargetName="PART_CheckBorder"  Value="2"/>
                <Setter Property="Background" TargetName="PART_CheckBorder"  Value="{StaticResource TransparentBorderBrush.ShinyRed}"/>
                <Setter Property="Stroke" TargetName="path"  Value="{StaticResource TextBrushKey.ShinyRed}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="BorderBrush" TargetName="PART_CheckBorder"  Value="{StaticResource TransparentBorderBrush.ShinyBlue}"/>
                <Setter Property="CornerRadius" TargetName="PART_CheckBorder"  Value="2"/>
                <Setter Property="Background" TargetName="PART_CheckBorder"  Value="{StaticResource TransparentBorderBrush.ShinyBlue}"/>
                <Setter Property="Stroke" TargetName="path"  Value="{StaticResource TextBrushKey.ShinyBlue}" />
            </Trigger>
            <Trigger Property="MenuItem.IsChecked" Value="True">
                <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>  
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Office2003.MenuButton.MouseOverBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Blend.HoverBorderBrush}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource TransparentBorderBrush.ShinyRed}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource TransparentBorderBrush.ShinyBlue}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
            </MultiTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ItemsControl x:Key="RibbonContextMenuItems">
        <local:RibbonMenuItem Header="{StaticResource RemoveFromQAT}" Visibility="Collapsed" Command="local:RibbonCommands.RemoveItemFromQAT" Tag="Remove" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}"/>
        <local:RibbonMenuItem Header="{StaticResource AddToQAT}" Visibility="Collapsed" Tag="Item_One" Command="local:RibbonCommands.AddItemToQAT" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}"/>
        <Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Two"></Separator>
        <local:RibbonMenuItem Header="{StaticResource CustomizeQAT...}" Tag="Item_Three" Command="local:RibbonCommands.QATMoreCommands" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <local:RibbonMenuItem x:Name="PART_AboveButton" Visibility="Collapsed"  Tag="Item_Four" Header="{StaticResource QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <local:RibbonMenuItem x:Name="PART_BelowButton" Header="{StaticResource QATShowBelow}" Tag="Item_Five" Command="local:RibbonCommands.PlaceQATBelow"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Six"></Separator>
        <local:RibbonMenuItem Margin="0,0,0,0" Tag="Item_Seven" Template="{StaticResource CheckableItemTemplate}"  Header="{StaticResource MinimizeRibbon}" IsCheckable="True" Command="local:RibbonCommands.MinimizeRibbon"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}">
            <local:RibbonMenuItem.Icon>
                <Path Stroke="Black" StrokeThickness="1.4">
                    <Path.Data>
                        <GeometryGroup>
                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>               
            </local:RibbonMenuItem.Icon>
        </local:RibbonMenuItem>
    </ItemsControl>

   
