                                            <Storyboard>
                                                <DoubleAnimation x:Name="PART_LeftHideAnimation"
													Storyboard.TargetProperty="ContentRenderTransformX" To="1"
													Duration="{Binding Path=(TabControl.SelectedItem).(Syncfusion:DockingManager.AnimationDelay)
														, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:SidePanel}}}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Syncfusion:SidePanel.Triggers>
                        </Syncfusion:SidePanel>
                        <Syncfusion:SidePanel Name="PART_RightPanel" PanelSide="Right" Grid.Row="1" Grid.Column="2"
							  TabStripPlacement="Right" ContentRenderTransformX="1"
								  >
