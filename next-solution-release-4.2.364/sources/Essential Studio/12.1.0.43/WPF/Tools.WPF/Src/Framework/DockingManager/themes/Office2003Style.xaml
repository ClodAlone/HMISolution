                <Setter TargetName="BottomRow" Property="Height" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowBottomBorderHeight), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
                <Setter TargetName="LeftCol" Property="Width" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowLeftBorderWidth), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
                <Setter TargetName="RightCol" Property="Width" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowRightBorderWidth), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
