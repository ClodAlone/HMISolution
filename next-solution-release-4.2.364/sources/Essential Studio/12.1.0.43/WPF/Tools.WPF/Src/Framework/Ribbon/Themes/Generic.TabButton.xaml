<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Converters.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="TabButtonTemplate.Default" TargetType="{x:Type local:TabButton}">
        <Border Height="23" 
                  Background="Transparent">

            <Grid  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="7"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Path Fill="{TemplateBinding BorderBrush}" Name="left_path" Grid.Column="0">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,30">
                                <LineSegment Point="0,21.5" />
                                <ArcSegment Point="2,19" Size="2,2" RotationAngle="0" SweepDirection="Counterclockwise"/>
                                <LineSegment Point="2,5" />
                                <ArcSegment Point="7,0" Size="5,5" RotationAngle="0" SweepDirection="Clockwise"/>
                                <LineSegment Point="7,30" />
                                <LineSegment Point="0,30" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Path Name="PART_leftPath"  Fill="{TemplateBinding Background}" Grid.Column="0">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,23">
                                <ArcSegment Point="3,21" Size="3,3" RotationAngle="0" SweepDirection="Counterclockwise"/>
                                <LineSegment Point="3,5" />
                                <ArcSegment Point="7,1" Size="4,4" RotationAngle="0" SweepDirection="Clockwise"/>
                                <LineSegment Point="7,23" />
                                <LineSegment Point="0,23" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <Border Name="PART_highlightBorder"
                      Grid.Column="1"
                      Panel.ZIndex="200"
                      Margin="-5.7,-3.5,-5.7,0"
                      BorderThickness="2,2,2,0"
                      CornerRadius="4,4,0,0"
                      Height="20"
                      Opacity="0.75"/>

                <Border Name="PART_highlightContour" Grid.Column="1"/>

                <Border Panel.ZIndex="100"
                      Height="22.83" Name="center_Path"
                      Margin="-1,0,-1,0"
                      Grid.Column="1"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      Background="{TemplateBinding Background}">

                    <shared:TrippleBorder>
                        <Grid>
                            <ContentPresenter  Content="{TemplateBinding Content}" 
                                              ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=ItemTemplate}"
                                               ContentTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=ItemTemplateSelector}"/>
                            <TextBlock Name="PART_Caption"
                             Text="{TemplateBinding Caption}" 
                             TextAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </shared:TrippleBorder>
                </Border>

                <Path Fill="{TemplateBinding BorderBrush}" Name="right_path" Grid.Column="2">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="7,28">
                                <LineSegment Point="7,21.5"/>
                                <ArcSegment Point="5,19" Size="2,2" RotationAngle="0" SweepDirection="Clockwise"/>
                                <LineSegment Point="5,5" />
                                <ArcSegment Point="0,0" Size="5,5" RotationAngle="0" SweepDirection="Counterclockwise"/>
                                <LineSegment Point="0,28" />
                                <LineSegment Point="7,28" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Path Name="PART_rightPath" Fill="{TemplateBinding Background}" Grid.Column="2">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="7,23">
                                <ArcSegment Point="4,21" Size="3,3" RotationAngle="0" SweepDirection="Clockwise"/>
                                <LineSegment Point="4,5" />
                                <ArcSegment Point="0,1" Size="4,4" RotationAngle="0" SweepDirection="Counterclockwise"/>
                                <LineSegment Point="0,23" />
                                <LineSegment Point="7,23" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" 
                           Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" TargetName="center_Path"
                      Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}},
                      Converter={StaticResource ColorToTabButtonContextBrush}, ConverterParameter={StaticResource TabButtonBlendContextGradient},
                      Path=ContextColor}" />
                <Setter Property="BorderBrush" TargetName="center_Path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter Property="Fill" TargetName="PART_rightPath"
                      Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}},
                      Converter={StaticResource ColorToTabButtonContextBrush}, ConverterParameter={StaticResource TabButtonBlendContextGradient},
                      Path=ContextColor}" />
                <Setter Property="Fill" TargetName="right_path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter Property="Fill" TargetName="PART_leftPath"
                      Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}},
                      Converter={StaticResource ColorToTabButtonContextBrush}, ConverterParameter={StaticResource TabButtonBlendContextGradient},
                      Path=ContextColor}" />
                <Setter Property="Fill" TargetName="left_path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>              
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" 
                           Value="False"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" TargetName="center_Path" Value="{StaticResource Blue.TabButton.SelectedBrush}"/>
                <Setter Property="BorderBrush" TargetName="center_Path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter Property="Fill" TargetName="PART_rightPath" Value="{StaticResource Blue.TabButton.SelectedBrush}"/>
                <Setter Property="Fill" TargetName="right_path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter Property="Fill" TargetName="PART_leftPath" Value="{StaticResource Blue.TabButton.SelectedBrush}"/>
                <Setter Property="Fill" TargetName="left_path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>               
            </MultiDataTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Caption" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                <Setter TargetName="PART_highlightBorder" Property="BorderBrush" Value="{StaticResource Blue.TabButtonCheckedBrush}"/>
            </MultiTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, 
                           Path=HasContextTabGroup}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>

                <Setter Property="BorderBrush" TargetName="center_Path" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter Property="Background" TargetName="center_Path">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop Offset="0.2" Color="#FBE0A2" />
                            <GradientStop Offset="0.2" Color="#FBE0A2" />
                            <GradientStop Offset="1" Color="#FDF1D3" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="right_path" Property="Fill" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter TargetName="PART_rightPath" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop Offset="0.2" Color="#FBE0A2" />
                            <GradientStop Offset="0.2" Color="#FBE0A2" />
                            <GradientStop Offset="1" Color="#FDF1D3" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="left_path" Property="Fill" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter TargetName="PART_leftPath" Property="Fill">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop Offset="0.2" Color="#FBE0A2" />
                            <GradientStop Offset="0.2" Color="#FBE0A2" />
                            <GradientStop Offset="1" Color="#FDF1D3" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>               
                <Setter TargetName="PART_Caption" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>

            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, 
                           Path=HasContextTabGroup}" Value="False"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_highlightBorder" Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter TargetName="PART_highlightBorder" Property="BorderThickness" Value="1,1,1,1"/>
                <Setter TargetName="PART_highlightBorder" Property="Height" Value="22.83"/>
                <Setter TargetName="PART_highlightBorder" Property="Margin" Value="-5.7,0,-5.7,0"/>
                <Setter  TargetName="PART_highlightBorder" Property="Panel.ZIndex" Value="100" />
                <Setter  TargetName="PART_highlightBorder" Property="Background" Value="{StaticResource Blue.TabButton.HoverTabHighlight}" />

                <Setter TargetName="PART_highlightContour" Property="Height" Value="21"/>
                <Setter TargetName="PART_highlightContour" Property="CornerRadius" Value="3,3,0,0"/>
                <Setter TargetName="PART_highlightContour" Property="BorderThickness" Value="0.7,0.7,0.7,0"/>
                <Setter TargetName="PART_highlightContour" Property="BorderBrush" Value="{StaticResource Blue.TabButton.HighlightBorder}"/>
                <Setter TargetName="PART_highlightContour" Property="Margin" Value="-4.7,0,-4.7,0"/>
                <Setter TargetName="PART_Caption" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>

            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}},
                           Path=HasContextTabGroup}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_highlightBorder" Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
                <Setter TargetName="PART_highlightBorder" Property="BorderThickness" Value="1,1,1,1"/>
                <Setter TargetName="PART_highlightBorder" Property="Height" Value="22.83"/>
                <Setter TargetName="PART_highlightBorder" Property="Margin" Value="-5.7,0,-5.7,0"/>
                <Setter  TargetName="PART_highlightBorder" Property="Panel.ZIndex" Value="100" />
                <Setter  TargetName="PART_highlightBorder" Property="Background" Value="{StaticResource Blue.TabButton.HoverTabHighlight}" />
                <Setter  TargetName="PART_highlightBorder" Property="Background" Value="{Binding Converter={StaticResource colorToTransparentBrushConverter1}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=ContextColor}" />

                <Setter TargetName="PART_highlightContour" Property="Height" Value="21"/>
                <Setter TargetName="PART_highlightContour" Property="CornerRadius" Value="3,3,0,0"/>
                <Setter TargetName="PART_highlightContour" Property="BorderThickness" Value="0.7,0.7,0.7,0"/>
                <Setter TargetName="PART_highlightContour" Property="BorderBrush" Value="{StaticResource Blue.TabButton.HighlightBorder}"/>
                <Setter TargetName="PART_highlightContour" Property="Margin" Value="-4.7,0,-4.7,0"/>
                <Setter TargetName="PART_Caption" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>

            </MultiDataTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

