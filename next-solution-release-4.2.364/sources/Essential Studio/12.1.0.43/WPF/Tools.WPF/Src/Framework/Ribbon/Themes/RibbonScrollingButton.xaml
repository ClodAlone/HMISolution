    <!--RibbonScrollingButton style-->
    <ControlTemplate x:Key="Office2007BlueRibbonScrollingButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="PART_Border" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0,3,3,0"
					>
            <Border x:Name="PART_InnerBorder" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{StaticResource Blue.CheckBoxBackground}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
        CornerRadius="0,3,3,0">
                <Path x:Name="PART_Path" Stroke="{StaticResource Blend.PathFill1}" StrokeThickness="2" Fill="{StaticResource Blue.Path.Fill}" Margin="3,16,-2,0"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="{StaticResource Default.PathData}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Path.RenderTransform>
                </Path>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Left">
                <Setter TargetName="PART_Path" Property="Margin" Value="6,0,-5,0"/>
                <Setter TargetName="PART_Path" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="90"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PART_Border" Property="CornerRadius" Value="3,0,0,3"/>
                <Setter TargetName="PART_InnerBorder" Property="CornerRadius" Value="3,0,0,3"/>
                <Setter TargetName="PART_Border" Property="BorderThickness" Value="0,0,1,0"/>
                <Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="0,0,1,0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

