    <Style x:Key="RibbonScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="shared:SkinStorage.VisualStyle" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=(shared:SkinStorage.VisualStyle), Mode=OneWay}"/>
        <Setter Property="Template" Value="{StaticResource Office2007BlueRibbonScrollingButtonTemplate}"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource Blue.Ribbon.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.ImageBorder.BorderBrush}"/>
        <Style.Triggers> 
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                <Setter Property="Background" Value="{StaticResource Black.Ribbon.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Black.ImageBorder.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackRibbonScrollingButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Foreground" Value="{StaticResource Silver.Foreground}"/>
                <Setter Property="Background" Value="{StaticResource Silver.Ribbon.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver.ImageBorder.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007SilverRibbonScrollingButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                <Setter Property="Background" Value="{StaticResource Office2003.RibbonBarBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.ImageBorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2003RibbonScrollingButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
                <Setter Property="Background" Value="{StaticResource Blend.RibbonBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.ImageBorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource BlendRibbonScrollingButtonTemplate}"/>
            </Trigger>           
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource RibBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource RibbonScrollingButtonTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
                <Setter Property="Background" Value="{StaticResource WindowBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource RibbonScrollingButtonTemplate.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
       
    </Style>

