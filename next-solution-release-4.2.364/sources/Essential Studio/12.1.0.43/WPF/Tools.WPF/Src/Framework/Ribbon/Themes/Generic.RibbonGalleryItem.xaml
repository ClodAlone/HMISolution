    <ControlTemplate x:Key="RibbonGalleryItemTemplate.Office2007Blue" TargetType="{x:Type local:RibbonGalleryItem}">
        <shared:TrippleBorder    Name="PART_TrippleBorder"
                                   BorderThickness="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderThickness}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   Background="Transparent"
                                   OutsideBorderThickness="1"
                                   OutsideBorderBrush="Transparent"
                                   CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderCornerRadius}"
                                   MinWidth="0"
                                   SnapsToDevicePixels="True">

            <ContentPresenter MinWidth="0"
                              ContentSource="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                />
        </shared:TrippleBorder>

        <ControlTemplate.Triggers>

            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.SelectedBrush.Default}"/>
                <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource RibbonGalleryItem.IsChecked.BorderBrush.Outside}"/>
                <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource RibbonGalleryItem.IsMouseOver.BorderBrush}"/>
                <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.HoverSelectedBrush.Default}"/>
                <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource Default.QuickDropDownBorderBrush}"/>
            </MultiTrigger>

            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.PressedBrush.Default}"/>
                <Setter TargetName="PART_TrippleBorder"  
                      Property="OutsideBorderBrush" Value="{StaticResource RibbonGalleryItem.IsPressed.BorderBrush.Outside}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
