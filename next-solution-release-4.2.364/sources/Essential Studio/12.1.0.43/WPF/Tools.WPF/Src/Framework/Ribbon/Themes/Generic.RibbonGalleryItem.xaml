            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource RibbonGalleryItemTemplate.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
  
    
