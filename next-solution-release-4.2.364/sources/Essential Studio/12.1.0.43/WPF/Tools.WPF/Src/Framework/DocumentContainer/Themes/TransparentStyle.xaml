	<Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="MinWidth" Value="30" />
		<Setter Property="MinHeight" Value="25" />
		<Setter Property="Background" Value="#00ffffff" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Name="WrappBorder" Padding="2" SnapsToDevicePixels="True"	BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}" BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}" 
                            CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"	Background="#00FFFFFF"	Margin="2">
                        <StackPanel Orientation="Horizontal" >
							<Border Name="IconBorder" Background="{Binding Path=(local:DocumentContainer.Icon), Converter={StaticResource TestConverter}}" Margin="1" Width="16"/>
							<ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header)}" Name="content"  ContentTemplate="{Binding Path=(FrameworkElement.DataContext).(local:DocumentContainer.HeaderTemplate), ElementName=WrappBorder}" TextBlock.Foreground="{TemplateBinding Foreground}"/>
						</StackPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="WrappBorder" Property="BorderBrush"	Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
							<Setter TargetName="WrappBorder" Property="BorderThickness"	Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
							<Setter TargetName="WrappBorder" Property="Background"	Value="{StaticResource ListBoxItemMouseOverBrushKey}"/>
                        </Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="WrappBorder" Property="BorderBrush"	Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
                            <Setter TargetName="WrappBorder" Property="BorderThickness"	Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
							<Setter TargetName="WrappBorder" Property="Background"	Value="{Binding Path=SelectedItemBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsSelected" Value="True"/>
								<Condition Property="IsMouseOver" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="WrappBorder" Property="BorderBrush"	Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
							<Setter TargetName="WrappBorder" Property="BorderThickness"	Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
							<Setter TargetName="WrappBorder" Property="Background"	Value="{Binding Path=SelectedItemBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="TransparentListSwicthPreviewControlStyle" TargetType="{x:Type local:ListSwicthPreviewControl}" >
		<Setter Property="BorderBrush" Value="{StaticResource ListBoxBorderBrushKey}" />
		<Setter Property="BorderThickness" Value="1.5" />
		<Setter Property="Background" Value="{StaticResource ListBoxBackgroundBrushKey}" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="ItemBorderBrush" Value="#00FFFFFF" />
		<Setter Property="ItemBorderThickness" Value="1" />
		<Setter Property="SelectedItemBorderBrush" Value="{StaticResource ListBoxItemMouseOverBorderBrushKey}" />
		<Setter Property="SelectedItemBorderThickness" Value="1" />
		<Setter Property="SelectedItemBackground" Value="{StaticResource ListBoxItemSelectedBrushKey}" />
		<Setter Property="ItemCornerRadius" Value="0" />
		<Setter Property="ItemWidth" Value="0" />
		<Setter Property="ItemHeight" Value="0" />
		<Setter Property="MinWidth" Value="550" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:ListSwicthPreviewControl}" >
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
						<ListBox Name="PART_ListBox" Template="{StaticResource ListBoxTemplate}" ItemContainerStyle="{StaticResource ListBoxItemStyle}"	/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True">
				<Setter Property="BorderBrush" Value="{StaticResource ListBoxBorderBrushKey}" />
				<Setter Property="Background" Value="{StaticResource ListBoxBackgroundBrushKey}" />
				<Setter Property="SelectedItemBorderBrush" Value="{StaticResource ListBoxItemMouseOverBorderBrushKey}" />
				<Setter Property="SelectedItemBackground" Value="{StaticResource ListBoxItemSelectedBrushKey}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style BasedOn="{StaticResource TransparentListSwicthPreviewControlStyle}" TargetType="{x:Type local:ListSwicthPreviewControl}" />

	<Style x:Key="{x:Type local:CornerPanel}" TargetType="{x:Type local:CornerPanel}" >
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:CornerPanel}">
					<StackPanel Orientation="Horizontal" >
						<Button Name="btnMinimize" DockPanel.Dock="Right" Margin="2,2,0,2"
					Command="{x:Static local:DocumentContainer.MinimizeDocumentCommand}"
					CommandTarget="{local:FindWindow}"
					>
							<Border Name="btnMinimizeBorder" Height="10" Width="10" SnapsToDevicePixels="True"
						Background="{StaticResource brushMinimizeButtonBlack}"
						/>
						</Button>
						<Button Name="btnRestore" DockPanel.Dock="Right" Margin="0,2,0,2"
					Command="{x:Static local:DocumentContainer.RestoreDocumentCommand}"
					CommandTarget="{local:FindWindow}"
					>
							<Border Name="btnRestoreBorder" Height="10" Width="10" SnapsToDevicePixels="True"
						Background="{StaticResource brushRestoreButtonBlack}"
						/>
						</Button>
						<Button Name="btnClose" DockPanel.Dock="Right" Margin="2,2,2,2"
					Command="{x:Static local:DocumentContainer.HideDocumentCommand}"
					CommandTarget="{local:FindWindow}"
					>
							<Border Name="btnCloseBorder" Height="10" Width="10" SnapsToDevicePixels="True"
						Background="{StaticResource brushCloseButtonBlack}" />
						</Button>
					</StackPanel>
				</ControlTemplate>

			</Setter.Value>
		</Setter>
	</Style>

	<!--Style CutawayAdorner-->
    <Style x:Key="TransparentCutAwayAdornerStyle" TargetType="{x:Type Control}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Control}">
					<Border BorderBrush="Black" BorderThickness="0.5" Background="DarkGray"	CornerRadius="5" MinWidth="150">
						<TextBlock Name="PART_TextCutAway" Text="RredCat" Margin="5" Foreground="Red"  HorizontalAlignment="Center"  VerticalAlignment="Center" FontStyle="Italic"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
    
    <Style BasedOn="{StaticResource TransparentCutAwayAdornerStyle}" TargetType="{x:Type Control}"/>

	<Style x:Key="TransparentMenuItemStyle" TargetType="{x:Type local:DocMenuItem}" >
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:DocMenuItem}" >
					<Border SnapsToDevicePixels="True"    Background="{StaticResource DocumentContextMenuBorderBrush}" >
						<Grid ShowGridLines="False">
							<Grid.ColumnDefinitions>
								<ColumnDefinition SharedSizeGroup="MenuItemIconColumnGroup" Width="26" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto" />
								<ColumnDefinition Width="18" />
							</Grid.ColumnDefinitions>
							<Border Name="iconBorder" BorderThickness="0, 0, 1, 0" Grid.Column="0" SnapsToDevicePixels="True" BorderBrush="{StaticResource VS2010.MenuItemSeparatorBackground}" Background="{StaticResource VS2010.MenuItemIconInactiveBackground}" />
                            <Border Name="backBorder" CornerRadius="0" BorderThickness="1"	Margin="1, 0, 1, 0"	SnapsToDevicePixels="True" Grid.ColumnSpan="4" BorderBrush="{StaticResource DocumentContextMenuBorderBrush}" Background="Transparent">
                                <Rectangle x:Name="InnerBorder" Stroke="Transparent" StrokeThickness="1" SnapsToDevicePixels="True"/>
                            </Border>
							<Border Name="Icon" Height="10" Width="10" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0, 2, 0, 0">
								<shared:DrawingHelper Name="mnuHelper" DrawingBrush="{TemplateBinding IconBrush}" />
							</Border>
							<Border Name="GlyphBorder"	Grid.Column="0"	Visibility="Hidden"	HorizontalAlignment="Left" Margin="4,0,0,0"	VerticalAlignment="Center" Width="20" Background="{StaticResource VS2010.MenuItemGlyphBackBrush}" BorderThickness="1" BorderBrush="{StaticResource VS2010.MenuItemGlyphBorderBrush}" Height="20">
								<Path Stretch="Fill"  Stroke="{StaticResource VS2010.MenuItemGlyphForegroundBrush}"  HorizontalAlignment="Center"  Margin="0" VerticalAlignment="Center"  Width="7.5" Height="5.875" Data="M5.375,11.125 L7.75,13.25 11.875,8.375"/>
                            </Border>
							<ContentPresenter ContentSource="Header"  Grid.Column="1"  Margin="6, 2, 4, 2"  Name="Header" TextBlock.Foreground="{StaticResource VS2010.MenuItemInactiveForeground}" />
							<TextBlock Name="IGT" Margin="5,2,0,2" Text="{TemplateBinding MenuItem.InputGestureText}"   Grid.Column="2" DockPanel.Dock="Right" Foreground="{StaticResource VS2010.MenuItemInactiveForeground}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="iconBorder" Property="Background" Value="{StaticResource DocumentContextMenuBackground}"/>
                            <Setter TargetName="backBorder" Property="BorderBrush" Value="{StaticResource TransparentMenuItemHoverBorderBrush}"/>
                            <Setter TargetName="backBorder" Property="Background" Value="{StaticResource TransparentThemeMenuItemHoverBrush}"/>
                            <Setter TargetName="InnerBorder" Property="Stroke" Value="{StaticResource TransparentInnerBorderBrush}"/>
                            <Setter TargetName="Header" Property="TextBlock.Foreground" Value="{StaticResource TransparentDocumentContainerForeground}" />
                            <Setter TargetName="IGT" Property="TextBlock.Foreground" Value="{StaticResource TransparentDocumentContainerForeground}" />						
							<Setter TargetName="mnuHelper" Property="DrawingBrush"	Value="{Binding Path=ActiveIconBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DocMenuItem}}}"/>
						</Trigger>
						<Trigger Property="MenuItem.IsChecked" Value="True">
							<Setter TargetName="GlyphBorder" Property="UIElement.Visibility" Value="{x:Static Visibility.Visible}"/>
							<Setter TargetName="Icon" Property="UIElement.Visibility" Value="{x:Static Visibility.Collapsed}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Header" Property="Opacity" Value="0.5" />
							<Setter TargetName="IGT" Property="Opacity" Value="0.5" />
							<Setter TargetName="mnuHelper" Property="Opacity" Value="0.5"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource TransparentMenuItemStyle}" TargetType="{x:Type local:DocMenuItem}" />

</ResourceDictionary>

