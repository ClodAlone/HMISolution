							</MultiTrigger.Conditions>
							<Setter TargetName="WrappBorder" Property="BorderBrush"	Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:VS2005SwitchPreviewControl}}}"/>
                            <Setter TargetName="WrappBorder" Property="BorderThickness"	Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:VS2005SwitchPreviewControl}}}"/>
							<Setter TargetName="WrappBorder" Property="Background" Value="{Binding Path=SelectedItemBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:VS2005SwitchPreviewControl}}}"/>
                            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource TransparentInnerBorderBrush}"/>
