	<Style x:Key="TransparentDocumentHeaderStyle" TargetType="{x:Type local:DocumentHeader}">
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="BorderBrush" Value="{StaticResource TransparentMDIWindowBorderBrush}"/>
		<Setter Property="Background" Value="{StaticResource TransparentMDIWindowHeaderBackground}"/>
		<Setter Property="Foreground" Value="{StaticResource TransparentMDIWindowForeground}"/>
		<Setter Property="Border.CornerRadius" Value="3,3,0,0"/>
		<Setter Property="CloseButtonStyle" Value="{StaticResource HeaderThemedCloseButtonStyle}"/>
		<Setter Property="MaximizeButtonStyle" Value="{StaticResource HeaderThemedButtonStyle}"/>
		<Setter Property="MinimizeButtonStyle" Value="{StaticResource HeaderThemedButtonStyle}"/>
		<Setter Property="RestoreButtonStyle" Value="{StaticResource HeaderThemedButtonStyle}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:DocumentHeader}">
					<shared:Border3D Name="Border" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Border.CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
						<Border x:Name="InnerBorder" BorderBrush="{StaticResource TransparentInnerBorderBrush}" BorderThickness="1">
							<DockPanel LastChildFill="True" VerticalAlignment="{TemplateBinding VerticalAlignment}">
							<Button Name="btnClose" DockPanel.Dock="Right" Margin="2,2,2,2" Visibility="{local:ContainerButtonVisibility}" Command="{x:Static local:DocumentContainer.HideDocumentCommand}" CommandTarget="{local:FindWindow}" Style="{TemplateBinding CloseButtonStyle}">
								<Border Name="btnCloseBorder" Height="10" Width="10" SnapsToDevicePixels="True">
									<shared:DrawingHelper Name="btnCloseHelper" DrawingBrush="{StaticResource brushCloseButtonNormal}" />
								</Border>
							</Button>
							<Button Name="btnMaximize" DockPanel.Dock="Right" Margin="0,2,0,2"  Visibility="{local:ContainerButtonVisibility}" Command="{x:Static local:DocumentContainer.MaximizeDocumentCommand}" CommandTarget="{local:FindWindow}" Style="{TemplateBinding MaximizeButtonStyle}">
								<Border Name="btnMaximizeBorder" Height="10" Width="10" SnapsToDevicePixels="True">
									<shared:DrawingHelper Name="btnMaximizeHelper" DrawingBrush="{StaticResource brushMaximizeButtonWhite}" />
								</Border>
							</Button>
							<Button Name="btnRestore" DockPanel.Dock="Right" Margin="0,2,0,2"	Visibility="Collapsed"	Command="{x:Static local:DocumentContainer.RestoreDocumentCommand}"	CommandTarget="{local:FindWindow}"	Style="{TemplateBinding RestoreButtonStyle}" >
								<Border Name="btnRestoreBorder" Height="10" Width="10" SnapsToDevicePixels="True">
									<shared:DrawingHelper Name="btnRestoreHelper" DrawingBrush="{StaticResource brushRestoreButtonWhite}" />
								</Border>
							</Button>
							<Button Name="btnMinimize" DockPanel.Dock="Right" Margin="2,2,0,2"  Visibility="{local:ContainerButtonVisibility}" Command="{x:Static local:DocumentContainer.MinimizeDocumentCommand}" CommandTarget="{local:FindWindow}" Style="{TemplateBinding MinimizeButtonStyle}">
								<Border Name="btnMinimizeBorder" Height="10" Width="10" SnapsToDevicePixels="True">
									<shared:DrawingHelper Name="btnMinimizeHelper" DrawingBrush="{StaticResource brushMinimizeButtonGray}" />
								</Border>
							</Button>
							<Border Name="IconBorder"  Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" DockPanel.Dock="Left" Background="{TemplateBinding Icon}" Margin="1" />
							 <ContentPresenter Content="{TemplateBinding Header}" Name="content" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" Margin="5,0,0,0" TextBlock.Foreground="{TemplateBinding Foreground}" ContentTemplateSelector="{StaticResource DocumentHeaderTrimmingTemplate}"/>
						</DockPanel>
						</Border>
					</shared:Border3D>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="False">
							<Setter Property="Background" Value="{StaticResource TransparentMDIWindowHeaderSelectedBackgroundBrush}"/>
							<Setter Property="Foreground" Value="{StaticResource TransparentMDIWindowHeaderSelectedForeground}"/>
							<Setter Property="BorderBrush" Value="{StaticResource TransparentMDIWindowSelectedBorderBrush}"/>
							<Setter Property="Style" TargetName="btnClose" Value="{StaticResource HeaderThemedCloseButtonStyle}"/>
							<Setter Property="Style" TargetName="btnMaximize" Value="{StaticResource HeaderThemedButtonStyle}"/>
							<Setter Property="Style" TargetName="btnMinimize" Value="{StaticResource HeaderThemedButtonStyle}"/>
							<Setter Property="Style" TargetName="btnRestore" Value="{StaticResource HeaderThemedButtonStyle}"/>
						</DataTrigger>
                        
						<DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True">
							<Setter Property="TextBlock.Foreground" TargetName="content" Value="Black"/>
						</DataTrigger>
                        
						<DataTrigger Binding="{Binding ElementName=IconBorder, Path=(local:DocumentContainer.Icon)}" Value="{x:Null}">
							<Setter TargetName="IconBorder" Property="Visibility" Value="Collapsed"/>
						</DataTrigger>
                        
						<DataTrigger Binding="{Binding Path=Content.(local:DocumentContainer.MDIWindowState),RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="Minimized">
							<Setter TargetName="btnMinimize" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="btnRestore" Property="Visibility" Value="{local:ContainerButtonVisibility}" />
							<Setter	TargetName="btnMinimizeHelper" Property="Margin" Value="0, 1, 0, 0" />
							<Setter	TargetName="btnMaximizeHelper" Property="Margin" Value="0, 1, 0, 0" />
							<Setter	TargetName="btnRestoreHelper" Property="Margin" Value="0, 1, 0, 0" />
