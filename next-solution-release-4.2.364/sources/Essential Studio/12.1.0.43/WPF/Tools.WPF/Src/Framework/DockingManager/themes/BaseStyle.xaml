	<Style x:Key="SplitterBaseStyle" TargetType="{x:Type Syncfusion:Splitter}">
		<Setter Property="MinWidth" Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.SplitterSize)
								, RelativeSource={RelativeSource Self}}"/>
		<Setter Property="MinHeight" Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.SplitterSize)
								, RelativeSource={RelativeSource Self}}"/>
		<Setter Property="Margin" Value="0"/>
		<Setter Property="Background" Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.SplitterBackground)
								, RelativeSource={RelativeSource Self}}"/>
		<Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="AdornerTemplate" Value="{StaticResource SplitterAdornerTemplate}"/>
		<Setter Property="Template" Value="{StaticResource SplitterTemplate}"/>
        <Style.Triggers>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource SplitterAdornerTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource SplitterAdornerTemplate.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
	</Style>

