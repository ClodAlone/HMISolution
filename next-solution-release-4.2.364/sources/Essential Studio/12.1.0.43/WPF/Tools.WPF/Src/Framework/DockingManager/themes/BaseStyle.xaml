<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:Syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls"
	xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    >

    <ResourceDictionary.MergedDictionaries>       
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DockingManager/Themes/LunaTemplate.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DockingManager/Themes/generic.adorners.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DockingManager/Themes/ShinyBlueTemplate.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DockingManager/Themes/ShinyRedTemplate.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DockingManager/Themes/generic.splitter.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DockingManager/Themes/Brushes.xaml"/>       
    </ResourceDictionary.MergedDictionaries>

    <!--helper style-->
	<Style x:Key="SideTabItemStyle" TargetType="{x:Type TabItem}">
		<Setter Property="Header" Value="{Binding Path=(Syncfusion:DockingManager.Header)}" />
        <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
		<Setter Property="Syncfusion:DockingManager.ListenTabItemEvents" Value="True" />
		<Setter Property="MinWidth" Value="21" />
		<Setter Property="MinHeight" Value="21" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource DefaultSideTabItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource Office2007BlueSideTabItemTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource Office2007BlackSideTabItemTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource Office2007SilverSideTabItemTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource Office2003SideTabItemTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource BlendSideTabItemTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource SideTabItemTemplate.ShinyRed}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Foreground" Value="{StaticResource Default.TabItemForeground}" />
                <Setter Property="Template" Value="{StaticResource SideTabItemTemplate.ShinyBlue}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Foreground" Value="{StaticResource TabItemForeground.Orange}" />
                <Setter Property="Template" Value="{StaticResource SyncOrangeSideTabItemTemplate}" />
            </Trigger>
        </Style.Triggers>
	</Style>

	<Style x:Key="DockTabControlStyle" TargetType="{x:Type TabControl}" >
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource Default.TabControlBackground}" />
		<Setter Property="ItemContainerStyle" 
				Value="{Binding Path=(Syncfusion:DockedElementTabbedHost.DockingManager).(Syncfusion:DockingManager.TabItemStyle)
								, RelativeSource={RelativeSource  AncestorType={x:Type Syncfusion:DockedElementTabbedHost}}}"
				 />
        <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}" />
    <Style.Triggers>
      <Trigger Property="Visibility" Value="Visible">
        <Setter Property="Background" 
				Value="{Binding Path=(Syncfusion:DockedElementTabbedHost.DockingManager).(Syncfusion:DockingManager.TabPanelBackground)
								, RelativeSource={RelativeSource  AncestorType={x:Type Syncfusion:DockedElementTabbedHost}}}" />
      </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Office2007Black.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackTabControlTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Office2007Silver.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background"  Value="{StaticResource Blend.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" Value="{StaticResource TabControlBackground.Orange}"/>
                <Setter Property="Template" Value="{StaticResource SyncOrangeTabControlTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource TabPanelBackgroundBrushKey.ShinyRed}" />
                <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource TabPanelBackgroundBrushKey.ShinyBlue}" />
                <Setter Property="Template" Value="{StaticResource DefaultTabControlTemplate}" />
            </Trigger>
        </Style.Triggers>
  </Style>

	<Style x:Key="DockedElementTabbedHostStyle" TargetType="{x:Type Syncfusion:DockedElementTabbedHost}">
		<Setter Property="Syncfusion:DockingManager.InternalDataContext"
		  Value="{Binding Path=(Syncfusion:DockedElementTabbedHost.HostedElement), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template" Value="{StaticResource DefaultDockedElementTabbedHostTemplate}" />
		<Style.Triggers>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Template" Value="{StaticResource Office2007BlueDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource Office2007BlackDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource Office2007SilverDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource Office2003DockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource BlendDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Template" Value="{StaticResource SyncOrangeDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource ShinyRedDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource ShinyBlueDockedElementTabbedHostTemplate}" />
            </Trigger>
            <Trigger Property="ShowTabs" Value="True">
                <Setter Property="Template" Value="{StaticResource DefaultDockedElementTabbedHostTabbedTemplate}" />
			</Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007BlueDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007BlackDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007SilverDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2003DockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource BlendDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource SyncOrangeDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ShinyRedDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="ShowTabs" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ShinyBlueDockedElementTabbedHostTabbedTemplate}" />
            </MultiTrigger>
        </Style.Triggers>
	</Style>

	<Style x:Key="SidePanelStyle" TargetType="{x:Type Syncfusion:SidePanel}">
		<Setter Property="ItemContainerStyle" Value="{Binding Path=SideItemStyle
				, RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:DockingManager}}}" />
		<Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Background" Value="{StaticResource Default.TabControlBackground}" />
        <Setter Property="Syncfusion:DockingManager.InternalDataContext" Value="{Binding Path=SelectedItem, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template" Value="{StaticResource DefaultSidePanelTemplate}" />
		<Style.Triggers>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlueSidePanelTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Office2007Black.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackSidePanelTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Office2007Silver.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource Office2007SilverSidePanelTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource Office2003SidePanelTemplate}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background"  Value="{StaticResource Blend.TabControlBackground}"/>
                <Setter Property="Template" Value="{StaticResource BlendSidePanelTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" Value="{StaticResource TabControlBackground.Orange}"/>
                <Setter Property="Template" Value="{StaticResource SyncOrangeSidePanelTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource TabPanelBackgroundBrushKey.ShinyRed}" />
                <Setter Property="Template" Value="{StaticResource ShinyRedSidePanelTemplate}" />
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource TabPanelBackgroundBrushKey.ShinyBlue}" />
                <Setter Property="Template" Value="{StaticResource ShinyBlueSidePanelTemplate}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=HasItems, RelativeSource={RelativeSource Self}}" Value="True" >
				<Setter Property="Visibility" Value="Visible" />
			</DataTrigger>
      <Trigger Property="Visibility" Value="Visible">
        <Setter Property="Background" Value="{Binding Path=SidePanelBackground, RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:DockingManager}}}" />
      </Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="DocumentContainerKey" TargetType="{x:Type Syncfusion:DocumentContainer}">      
		<Setter Property="SwitchMode" 
				Value="{Binding Path=SwitchMode, 
				RelativeSource={RelativeSource FindAncestor
				, AncestorType={x:Type Syncfusion:DockingManager}}}" />
		<Setter Property="Mode"
				Value="{Binding Path=ContainerMode, 
				RelativeSource={RelativeSource FindAncestor
				, AncestorType={x:Type Syncfusion:DockingManager}}}" />
		<Setter Property="ShowTabListContextMenu"
				Value="{Binding Path=ShowTabListContextMenu, 
				RelativeSource={RelativeSource FindAncestor
				, AncestorType={x:Type Syncfusion:DockingManager}}}" />
		<Setter Property="ShowTabItemContextMenu"
				Value="{Binding Path=ShowTabItemContextMenu, 
				RelativeSource={RelativeSource FindAncestor
				, AncestorType={x:Type Syncfusion:DockingManager}}}" />
		<Setter Property="UseInteropCompatibility"
				Value="{Binding Path=UseInteropCompatibilityMode, 
				RelativeSource={RelativeSource FindAncestor
				, AncestorType={x:Type Syncfusion:DockingManager}}}" />
		<Setter Property="IsInMDIMaximizedState"
				Value="{Binding Path=IsInMDIMaximizedState, 
				RelativeSource={RelativeSource FindAncestor
				, AncestorType={x:Type Syncfusion:DockingManager}}}" />
	</Style>

