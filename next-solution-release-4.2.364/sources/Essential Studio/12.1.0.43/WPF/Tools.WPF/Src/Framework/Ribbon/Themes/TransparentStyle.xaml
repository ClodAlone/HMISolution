    <!--DropDownButton style for QuickAccessToolBar-->
    <Style x:Key="QuickAccessPopupButtonStyle" TargetType="{x:Type local:DropDownButton}">
        <Setter  Property="OverridesDefaultStyle"     Value="true"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter  Property="IsTabStop" Value="false"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter  Property="ButtonBase.ClickMode">
            <Setter.Value>
                <x:Static
            Member="ClickMode.Press" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DropDownButton}">
                    <Border Name="PART_ToggleButton" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Panel.Background}" Width="13"  Height="{TemplateBinding Height}"  CornerRadius="0">
                        <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Viewbox Height="6" Width="6" Stretch="Fill" SnapsToDevicePixels="True">
                                    <Path Fill="{DynamicResource DropDownPathFill}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" Data="{StaticResource PathData}"/>
                                </Viewbox>
                                <Popup Name="PART_Popup" Placement="Bottom" Focusable="False" PopupAnimation="Fade" AllowsTransparency="True" StaysOpen="False"  IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}">
                                    <Border>
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Width" Value="30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuickAccessPopupButtonOverflowStyle" TargetType="{x:Type local:DropDownButton}">
        <Setter  Property="OverridesDefaultStyle"     Value="true"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter  Property="IsTabStop" Value="false"/>
        <Setter  Property="ButtonBase.ClickMode">
            <Setter.Value>
                <x:Static
            Member="ClickMode.Press" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DropDownButton}">
                    <Border Name="PART_ToggleButton" 
           BorderThickness="{TemplateBinding BorderThickness}"
           BorderBrush="{TemplateBinding BorderBrush}" 
           Background="{TemplateBinding Panel.Background}"
           Width="{TemplateBinding Width}" 
           Height="{TemplateBinding Height}" 
           SnapsToDevicePixels="True"
           CornerRadius="0">
                        <Grid>
                            <Path 
                    Stroke="{DynamicResource DropDownPathFill}" 
                    Fill="{DynamicResource DropDownPathFill}"              
                    StrokeThickness="1"
                    Data="{TemplateBinding PathGeometry}"/>
                            <Popup Name="PART_Popup"  
                Placement="Bottom"                  
                Focusable="False"                       
                PopupAnimation="Fade"
                AllowsTransparency="True"     
                StaysOpen="False"
                IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}">
                                <Border Background="{StaticResource ComboBoxPopupBackground}" BorderBrush="{StaticResource ComboBoxPopupBorderBrush}" BorderThickness="1" >
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource RibbonButtonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource RibbonButtonPressedBorderdBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonButtonPopupItemStyle-->
    <Style x:Key="RibbonButtonPopupItemStyle" TargetType="{x:Type local:RibbonButton}">
        <Setter  Property="OverridesDefaultStyle"     Value="true"/>
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{DynamicResource RibbonTitleForeground}"/>
        <Setter Property="BorderThickness"            Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Name="OuterBorder" Background="{TemplateBinding Panel.Background}" Width="{TemplateBinding Width}"                                                      
                  Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" CornerRadius="0" MinHeight="{TemplateBinding MinHeight}" MaxHeight="{TemplateBinding MaxHeight}" 
                            Margin="{TemplateBinding Margin}"  SnapsToDevicePixels="True">
                        <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="19" Height="19" BorderThickness="1" BorderBrush="{StaticResource TransparentThemeChkBoxBorderBrush}" 
                      Background="{StaticResource TransparentThemeChkBoxBackground}">
                                    <Path Fill="{StaticResource TransparentThemeChkBoxPathFill}"  SnapsToDevicePixels="True" Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Width="9" Height="11"/>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonMenuItemHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonMenuItemHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="16,9,16,9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ContentControl x:Key="Path">
        <ContentControl.Style>
            <Style>
                <Setter Property="Control.OverridesDefaultStyle"  Value="True"/>
                <Setter Property="Control.HorizontalAlignment" Value="Center"/>
                <Setter Property="Control.VerticalAlignment" Value="Top"/>
                <Setter Property="Control.Height" Value="14"/>
                <Setter Property="Control.Margin" Value="0,-1,0,0"/>
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,4,0,0"  HorizontalAlignment="Center" Fill="{StaticResource Blue.Path.Fill}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <!--DropDownButton style for RibbonBar-->
    <Style x:Key="RibbonDropDownToggleButton" TargetType="{x:Type local:DropDownButton}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTextForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonBorderBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DropDownButton}">
                    <Border Name="PART_ToggleButton"             
              BorderThickness="{TemplateBinding BorderThickness}"
              BorderBrush="Transparent" 
              Background="{TemplateBinding Background}">
                        <Grid>
                            <DockPanel Margin="0,3,0,0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top">
                                <Border DockPanel.Dock="Top"
						  Name="PART_ImageBorder"						 
						  BorderThickness="1"
						  BorderBrush="{StaticResource RibbonBorderBrush}"
						  Background="Transparent"  
						  HorizontalAlignment="Center" >
                                    <Grid MinWidth="31" MinHeight="31">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="7"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Row="0"  Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
								 Width="16" Height="16" />
                                        <Border Grid.Row="1" Background="Transparent" />
                                    </Grid>
                                </Border>
                                <local:CustomItemsControl Focusable="False" Margin="3,1,3,1" DockPanel.Dock="Bottom" Path="{StaticResource Path}" ItemsSource="{Binding Path=Label, Mode=OneWay, Converter={StaticResource TextWrappingConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:MultilinePanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </local:CustomItemsControl>
                                <Popup Name="PART_Popup"
						 HorizontalAlignment="Center"
						 VerticalAlignment="Center"
						 Placement="Bottom"
						 PlacementTarget="{Binding ElementName=PART_ToggleButton}"
						 Focusable="False"
						 AllowsTransparency="True"
						 StaysOpen="False"
						 IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}"
						 PopupAnimation="Fade">
                                    <!--<Microsoft_Windows_Themes:SystemDropShadowChrome  Name="PART_Shadow" Margin="0" SnapsToDevicePixels="true">-->
                                    <ItemsPresenter/>
                                    <!--</Microsoft_Windows_Themes:SystemDropShadowChrome>-->
                                </Popup>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CollapseImage}" Value="{x:Null}">
                            <Setter TargetName="PART_ImageBorder" Property="Opacity" Value="0"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=PART_ToggleButton, Path=IsMouseOver}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background"  Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush"  Value="{DynamicResource RibbonButtonHoverBorderBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self},  Path=IsDropDownOpen}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background"  Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush"  Value="{DynamicResource RibbonButtonPressedBorderBrush}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonBarLauncherButton style-->
    <Style x:Key="RibbonBarLauncherButton" TargetType="{x:Type local:RibbonButton}">
