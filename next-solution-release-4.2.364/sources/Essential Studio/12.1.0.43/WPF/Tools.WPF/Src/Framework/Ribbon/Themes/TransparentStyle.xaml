    <!--CheckRadioFocusVisual-->
    <Style x:Key="CheckRadioFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle SnapsToDevicePixels="true" Stroke="Black" StrokeDashArray="1 2" StrokeThickness="1" Margin="14,0,0,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:RibbonCheckBox}"  x:Key="TransparentRibbonCheckBoxStyle">
        <Setter Property="Foreground" Value="{StaticResource CheckBoxForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource CheckBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckBoxStroke}"/>
        <Setter Property="Margin" Value="3,3,3,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyCheckBoxFocusVisual}"/>
        <Setter Property="Content"  Value="New CheckBox"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="true">
                        <BulletDecorator.Bullet>
                            <Border x:Name="border1" Width="13" Height="13" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Path x:Name="Path" Data="M4279.875,659 L4283,662.5 L4289.625,653.25" Stroke="{StaticResource CheckBoxForegroundBrush}" StrokeThickness="1.5" FlowDirection="LeftToRight" Height="8" Opacity="0" Stretch="Fill" Width="8.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="true">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource CheckRadioFocusVisual}"/>
                            <Setter Property="Padding" Value="4,-1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border1" Property="Background" Value="White"/>
                            <Setter TargetName="border1" Property="Opacity" Value=".295"/>
                            <Setter Property="Foreground" Value="{StaticResource CheckBoxDisabledForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" TargetName="Path" Value="1"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource CheckBoxMouseHoverBackground}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource CheckBoxCheckedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Path" Property="Data" Value="M0,0 L6,0 L6,2 L0,2 z" />
                            <Setter TargetName="Path" Property="Opacity" Value=".3"/>
                            <Setter TargetName="Path" Property="Height" Value="7"/>
                            <Setter TargetName="Path" Property="Width" Value="7"/>
                            <Setter TargetName="Path" Property="Fill" Value="#FF333333"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonCheckBoxStyle}" TargetType="{x:Type local:RibbonCheckBox}"/>

    <SolidColorBrush x:Key="TransparentToggleButtonInnerBorderBrush" Color="#FFFFFFFF" Opacity="0.90"/>
    <LinearGradientBrush x:Key="ComboBoxToggleButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.3">
        <GradientStop Color="#FFF6F2ED" Offset="0"/>
        <GradientStop Color="#FFEDE3D6" Offset="0.253"/>
        <GradientStop Color="#FFC6C6C6" Offset="0.483"/>
        <GradientStop Color="#FF8B8B8B" Offset="0.513"/>
        <GradientStop Color="#FFBABABA" Offset="1"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>
    <!--Combobox ToggleButton Style-->
    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ComboBoxToggleButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TransparentComboBoxBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TransparentComboBoxForeground}"/>
        <Setter Property="OverridesDefaultStyle"   Value="true"/>
        <Setter Property="IsTabStop"     Value="false"/>
        <Setter Property="Focusable"   Value="false"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ClickMode"    Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="Chrome1"  BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ComboBoxButton"/>
                            </Grid.ColumnDefinitions>
                            <!--<Border Name="Chrome"  Background="{StaticResource  TransparentToggleButtonBackground}" BorderThickness="1" Margin="-1" BorderBrush="{StaticResource TransparentToggleButtonBorderBrush}"  Grid.Column="1" Width="18" SnapsToDevicePixels="True">-->
                            <Border Name="Chrome"  Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"  Grid.Column="1" Width="15" Margin="-1">
                                <Border x:Name="InnerBorder" BorderBrush="{StaticResource TransparentToggleButtonInnerBorderBrush}" BorderThickness="1">
                                    <Path Name="Arrow" Fill="{StaticResource  TransparentComboBoxForeground}" Data="M 0 0 L 3.5 3.5 L 7 0 Z"  HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="White"/>
                                        </Path.Effect>
                                    </Path>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" SourceName="Chrome1" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource  TransparentToggleButtonSelectedBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TransparentComboBoxBorderBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" SourceName="Chrome" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TransparentToggleButtonMouseOverBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TransparentComboBoxBorderBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" SourceName="Chrome1" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TransparentToggleButtonMouseOverBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TransparentComboBoxBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked"  Value="true">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource  TransparentToggleButtonSelectedBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TransparentComboBoxBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"  Value="false">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ComboBoxEditableTextBox Style-->
    <Style x:Key="ComboBoxEditableTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer Focusable="False" x:Name="PART_ContentHost" Background="{TemplateBinding Background}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonComboBoxItem style-->
    <Style x:Key="TransparentRibbonComboBoxItemStyle" TargetType="{x:Type local:RibbonComboBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonComboBoxItem}">
                    <Border Name="Bd" Margin="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                        <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="2,1,2,1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="true">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource RibbonMenuItemHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource RibbonMenuItemHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="3" />
                            <Setter Property="FontSize" Value="18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonComboBoxItemStyle}" TargetType="{x:Type local:RibbonComboBoxItem}"/>

    <!--RibbonComboBox Style-->
    <Style TargetType="{x:Type local:RibbonComboBox}" x:Key="TransparentRibbonComboBoxStyle">
        <Setter Property="BorderBrush" Value="{StaticResource TransparentComboBoxBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource TransparentComboBoxBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TransparentComboBoxForeground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="true">
                        <Border x:Name="Bd" CornerRadius="0" MinHeight="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" SnapsToDevicePixels="True" BorderThickness="{TemplateBinding BorderThickness}" >
                            <Grid Grid.IsSharedSizeScope="true">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Margin="{TemplateBinding Padding}" x:Name="SelectedItemBorder" Grid.ColumnSpan="2"/>
                                <ContentPresenter RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <ToggleButton Style="{StaticResource ToggleButtonStyle}" Grid.ColumnSpan="3" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="-1" Background="Transparent"/>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True" Margin="0,0,5,5">
                                <Border x:Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource ComboBoxPopupBorderBrush}" BorderThickness="1" CornerRadius="0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".5" Direction="315"/>
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer x:Name="PART_ScrollViewer" Margin="4,6,4,6" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="false">
                            <Setter Property="MinHeight" Value="95" TargetName="DropDownBorder"/>
                        </Trigger>
                        <!--<Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="Transparent"/>
                        </Trigger>-->
                        <Trigger Property="IsGrouping" Value="true">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                        </Trigger>
                        <Trigger Property="AllowsTransparency" SourceName="Popup" Value="true">
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="DropDownBorder"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Height" Value="28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEditable" Value="true">
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bd" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0" SnapsToDevicePixels="True">
                                    <Grid Grid.IsSharedSizeScope="true" SnapsToDevicePixels="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Background="Transparent" Margin="{TemplateBinding Padding}" x:Name="PART_EditableTextBox" Style="{StaticResource ComboBoxEditableTextBox}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Grid.Column="1" IsReadOnly="{Binding Path=IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <ToggleButton Style="{StaticResource ToggleButtonStyle}" Grid.ColumnSpan="3" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="-1" Background="Transparent"/>
                                    </Grid>
                                </Border>

                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True" Margin="0,0,5,5">
                                        <Border x:Name="DropDownBorder" Background="{StaticResource ComboBoxPopupBackground}" BorderBrush="{StaticResource ComboBoxPopupBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".5" Direction="325"/>
                                            </Border.Effect>
                                        </Border>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="false">
                                    <Setter Property="MinHeight" Value="95" TargetName="DropDownBorder"/>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="Transparent"/>
                                </Trigger>-->
                                <Trigger Property="IsGrouping" Value="true">
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                                </Trigger>
                                <Trigger Property="AllowsTransparency" SourceName="Popup" Value="true">
                                    <Setter Property="Margin" Value="0,0,0,0" TargetName="DropDownBorder"/>
                                    <!--<Setter Property="CornerRadius" TargetName="DropDownBorder" Value="3,3,3,3"/>-->
                                </Trigger>
                                <Trigger Property="IsEditable" Value="true">
                                    <Setter Property="IsTabStop" Value="false"/>
                                    <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox"/>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Height" Value="28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonComboBoxStyle}" TargetType="{x:Type local:RibbonComboBox}"/>

    <!--SeparatorStyle-->
    <Style x:Key="SeparatorStyle" TargetType="Separator">
        <Setter Property="Border.BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FrameworkElement.MinHeight" Value="2"/>
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="30,2,0,2"/>
        <Setter Property="Background" Value="{StaticResource Default.QuickDropDownSeparator}"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Margin="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonContextMenuItems-->
    <ItemsControl x:Key="RibbonContextMenuItems">
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=RemoveFromQAT}" Visibility="Collapsed" Command="local:RibbonCommands.RemoveItemFromQAT" Tag="Remove" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}"/>
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=AddToQAT}" Visibility="Collapsed" Tag="Item_One" Command="local:RibbonCommands.AddItemToQAT" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}"/>
        <Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Two"></Separator>
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQATContextMenu}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Tag="Item_Three" Command="local:RibbonCommands.QATMoreCommands" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <local:RibbonMenuItem Visibility="Collapsed"  Tag="Item_Four" Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Tag="Item_Five" Command="local:RibbonCommands.PlaceQATBelow"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Six"></Separator>
        <local:RibbonMenuItem Margin="0,0,0,0" Tag="Item_Seven"   Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}"  Command="local:RibbonCommands.MinimizeRibbon"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}">
            <local:RibbonMenuItem.Icon>
                <Path Stroke="Black" StrokeThickness="1.4">
                    <Path.Data>
                        <GeometryGroup>
                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
            </local:RibbonMenuItem.Icon>
        </local:RibbonMenuItem>
    </ItemsControl>

    <!--RibbonContextMenu Style-->
    <Style x:Key="TransparentRibbonContextMenuStyle"  TargetType="{x:Type local:RibbonContextMenu}">
        <Setter Property="Panel.Background" Value="{StaticResource ComboBoxPopupBackground}"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="StaysOpen"  Value="False"/>
        <Setter Property="MenuItem.Foreground" Value="{StaticResource RibbonTextForeground}"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTextForeground}"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
        <Setter Property="Border.BorderThickness" Value="1,1,1,1"/>
        <Setter Property="Border.BorderBrush" Value="{StaticResource ComboBoxPopupBorderBrush}"/>
        <Setter Property="Control.Padding" Value="1,1,1,1"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="ContextMenuService.HasDropShadow" Value="True"/>
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource TransparentRibbonMenuItemStyle}"/>
        <Setter Property="ItemsSource" Value="{Binding Source={StaticResource RibbonContextMenuItems}, Path=Items}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonContextMenu}">
                    <Border BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" Background="{TemplateBinding Panel.Background}" Margin="0,0,5,5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".5" Direction="315"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle Margin="1,1,1,1" Width="25" HorizontalAlignment="Left" Fill="{StaticResource ContextMenuPopupLeftBarBackground}"/>
                            <ScrollViewer Margin="1,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                <ItemsPresenter Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonContextMenuStyle}" TargetType="{x:Type local:RibbonContextMenu}"/>

    <!--GalleryFilterSelector Style-->
    <Style x:Key="{x:Type local:GalleryFilterSelector}" TargetType="{x:Type local:GalleryFilterSelector}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="{DynamicResource  RibbonTitleForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GalleryFilterSelector}">
                    <Grid>
                        <Border Height="15" 
                    Name="PART_DropDownButton" 
                    Background="{StaticResource RibbonBackgroundBrush}"
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{StaticResource RibbonBorderBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" 
                            
                           FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
                           FontStyle="Normal"                            
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},                  
                                          Path=SelectedFilter.Label}"/>
                                <Path Fill="{TemplateBinding Foreground}"
					            HorizontalAlignment="Center"
					            VerticalAlignment="Center"
					            Data="M 0 0 L 4 4 L 8 0 Z"
					            Margin="1"/>
                            </StackPanel>
                        </Border>
                        <Popup Name="PART_Popup"                   
                   Placement="Bottom"
                   Focusable="False"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   IsOpen="{Binding Path=IsDropDownOpen, 
                                    Mode=TwoWay, 
                                    RelativeSource={RelativeSource AncestorType={x:Type local:GalleryFilterSelector}}}">
                            <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
                                <local:RibbonButtonChecker
                  ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
                                        Converter={StaticResource GalleryFilterConverter}, 
                                        ConverterParameter={StaticResource RibbonButtonPopupItemStyle},
                                        Path=Filters}"
                  
                  CheckedButton="{Binding Mode=TwoWay,
                                          RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
                                          Converter={StaticResource FilterToRibbonButtonConverter},
                                          Path=SelectedFilter}"/>
                            </mwt:SystemDropShadowChrome>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=HasFilters}" Value="True">
                <Setter Property="Filters" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=GalleryFilters}"/>
                <Setter Property="SelectedFilter" Value="{Binding Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=CurrentFilter}"/>
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--RibbonButtonChecker Style-->
    <Style x:Key="{x:Type local:RibbonButtonChecker}" TargetType="{x:Type local:RibbonButtonChecker}">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTextForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButtonChecker}">
                    <Border Background="{StaticResource Default.RibbonButtonChecked}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--PopupResizeThumb Style-->
	<ControlTemplate TargetType="{x:Type local:PopupResizeThumb}" x:Key="VerticalPopupResizeThumbTemplate">
		<Border Width="20" Height="10" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
			<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
				<Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#C0C6D6" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
				<Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#5574A7" Margin="0,0,1,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Grid>
		</Border>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Cursor" Value="SizeNS"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
    <Style x:Key="{x:Type local:PopupResizeThumb}" TargetType="{x:Type local:PopupResizeThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PopupResizeThumb}">
                    <Border Width="10" Height="10" Background="Transparent" VerticalAlignment="Center"  HorizontalAlignment="Center">
                        <Path Margin="0,0,2,2" Data="M7,0L7,7 0,7 0,4 4,4 4,0z" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#FFFFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FF000000"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FF000000"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="SizeNWSE"/>
                        </Trigger>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter Property="Cursor" Value="SizeNESW"/>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        
    </Style>

    <!--LabelTextBlock Style-->
    <Style x:Key="{x:Type local:LabelTextBlock}" TargetType="{x:Type local:LabelTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,-2,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <!--<Setter Property="Effect" Value="{StaticResource TextBlockEffect1}"/>-->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--GalleryRepeatButtonStyle-->
    <Style x:Key="GalleryRepeatButtonStyle" TargetType="Button">
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource RibbonButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonButtonBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Name="OuterBorder"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Opacity="{TemplateBinding Opacity}"
                  BorderThickness="{TemplateBinding BorderThickness}">
                        <Border Name="PART_InnerBorder"
                    BorderBrush="White"
                    BorderThickness="1"
                    Opacity="{TemplateBinding Opacity}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--GalleryItem template-->
    <Style x:Key="{x:Type local:RibbonGalleryItem}" TargetType="{x:Type local:RibbonGalleryItem}">
        <Setter Property="ClickMode" Value="Release"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonGalleryItem}">
                    <shared:TrippleBorder    Name="PART_TrippleBorder"
                                   BorderThickness="1"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   Background="Transparent" InsideBorderThickness="1"
                                   OutsideBorderThickness="1"
                                   OutsideBorderBrush="Transparent"
                                   CornerRadius="0"
                                   MinWidth="0"
                                   SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle Name="InnerPath"  Fill="Transparent"  Margin="1"/>
                            <ContentPresenter MinWidth="0"  Margin="1,0,1,0"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  
                              ContentSource="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Grid>
                    </shared:TrippleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="OutsideBorderBrush" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="Transparent"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="OutsideBorderBrush" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="Transparent"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="OutsideBorderBrush" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="Transparent"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonStatusBar Style-->
    <Style x:Key="TransparentRibbonStatusBarStyle" TargetType="{x:Type local:RibbonStatusBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonStatusBar}">
                    <Border Height="{TemplateBinding Height}" 
                  ClipToBounds="True"                  
                  BorderThickness="{TemplateBinding BorderThickness}" 
                  BorderBrush="{TemplateBinding BorderBrush}" 
                  Background="{TemplateBinding Background}">
                        <ItemsPresenter x:Name="PART_Presenter"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource StatusBarForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WindowTopBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource StatusBarBackground}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Height" Value="22"/>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonStatusBarStyle}" TargetType="{x:Type local:RibbonStatusBar}"/>

    <!--RibbonGallery Style-->
    <Style x:Key="{x:Type local:RibbonGallery}" TargetType="{x:Type local:RibbonGallery}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemMouseOverBorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueGalleryBorderBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonGallery}">
                    <Border BorderThickness="1"
            CornerRadius="0,2,2,0"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            Height="{TemplateBinding Height}"
            MaxHeight="62">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Button Name="PART_ScrollUpButton"
                        Grid.Row="0" Margin="0,-1,-1,0" BorderThickness="1"
                        Style="{StaticResource GalleryRepeatButtonStyle}">
                                    <Path Data="M3.5,0L0,4 7,4z" Fill="{StaticResource GalleryButtonPathFill}"/>
                                </Button>

                                <Button Name="PART_ScrollDownButton"
                        Grid.Row="1" BorderThickness ="1" Margin="0,-1,-1,-1"
                        Style="{StaticResource GalleryRepeatButtonStyle}">
                                    <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource GalleryButtonPathFill}" />
                                </Button>

                                <Border Grid.Row="2"
                  Name="PART_ToggleButton"
                  Width="16"
                  Height="20.5"
                  Background="{StaticResource RibbonButtonBackgroundBrush}"
                  BorderBrush="{StaticResource  RibbonButtonBorderBrush}"                  
                  BorderThickness="1" Margin="0,0,-1,-1"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border BorderBrush="White" Name="InnerBorder" Padding="2.5,4,2.5,3"
                    BorderThickness="1">
                                        <Grid>
                                            <!--<Rectangle x:Name="highlightRect" StrokeThickness="0" Visibility="Collapsed">
                                                <Rectangle.Fill>
                                                    <RadialGradientBrush Center="0.503,1" GradientOrigin="0.503,1" RadiusY="0.202">
                                                        <GradientStop Color="#7FFFFFFF" Offset="0"/>
                                                        <GradientStop Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>-->
                                            <StackPanel>
                                                <Path Margin="0,0,0,2" Data="M0,0.5L7,0.5" Stroke="{StaticResource GalleryButtonPathFill}" />
                                                <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource GalleryButtonPathFill}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                            <local:InRibbonItemsPresenter Margin="1" Name="PART_ScrollPresenter" ClipToBounds="True"/>
                            <Popup Name="PART_Popup"
               Placement="Custom"
               Focusable="False"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">
                                <!--<mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">-->
                                <Grid Margin="0,0,5,5">
                                    <Border Background="{StaticResource ComboBoxPopupBackground}" 
                    BorderThickness="1"                   SnapsToDevicePixels="True"
                    BorderBrush="{StaticResource ComboBoxPopupBorderBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="3" Opacity=".3" Direction="325"/>
                                        </Border.Effect>
                                        <DockPanel SnapsToDevicePixels="True">

                                            <Border Name="PART_ThumbBorder"
                        DockPanel.Dock="Bottom"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource StatusBarBorderBrush}"
                        Background="{StaticResource StatusBarBackground}">
                                                <local:PopupResizeThumb IsTabStop="False" Name="PART_ResizeThumb"/>
                                            </Border>
                                            <local:GalleryFilterSelector DockPanel.Dock="Top"/>
                                            <Grid DockPanel.Dock="Top">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ScrollViewer Name="PART_ScrollViewer" Grid.Row="0">
                                                    <StackPanel>
                                                        <ItemsControl Name="PART_PopupItemsControl">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel
                              IsItemsHost="True"
                              ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
                              ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                    Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                    ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                                <!--</mwt:SystemDropShadowChrome>-->
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                        </Trigger>-->
                        <Trigger SourceName="PART_ToggleButton"  Property="IsMouseOver" Value="True">
                            <!--<Setter Property="BorderBrush" TargetName="InnerBorder" Value="{DynamicResource ButtonHoverInnerBorderBrush}"/>
                            <Setter Property="Background" TargetName="InnerBorder" Value="{DynamicResource ButtonHoverInnerBackgroundBrush}"/>-->
                            <Setter Property="Background" TargetName="PART_ToggleButton" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <!--<Setter Property="Visibility" TargetName="highlightRect" Value="Visible"/>-->
                        </Trigger>
                        <Trigger Property="HasGroups" Value="True">
                            <Setter TargetName="PART_PopupItemsControl" Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <local:GalleryGroupPanel/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                            <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                            <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="VerticalOnly">
                            <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
							<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalPopupResizeThumbTemplate}" />
							<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                        <Trigger Property="PopupPosition" Value="Above">
                            <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
                            <Setter TargetName="PART_ScrollViewer"   Property="DockPanel.Dock" Value="Bottom"/>
							<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
                                <Setter.Value>
                                    <RotateTransform Angle="270" CenterX="5" CenterY="5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
                        </Trigger>
						<Trigger Property="ResizeDirection" Value="NoResize">
							<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
						</Trigger>
						<MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
                                <Setter.Value>
                                    <RotateTransform Angle="270" CenterX="5" CenterY="5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel 
            Background="Transparent"
            ClipToBounds="True"
            ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
            ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="SizeForm" Value="Large"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonGallery}">
                            <Border Name="PART_OuterBorder" BorderThickness="1" CornerRadius="1" BorderBrush="Transparent">
                                <StackPanel>
                                    <Border Name="PART_ToggleButton"
              BorderBrush="{TemplateBinding BorderBrush}"
						  Background="{TemplateBinding Background}"
              BorderThickness="1"
              Height="{TemplateBinding Height}"
              CornerRadius="2">
                                        <StackPanel>
                                            <Image  Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Width="32" Height="32"
                 Margin="0,1,0,0"/>
                                            <local:CustomItemsControl Path="{StaticResource Path}" ItemsSource="{Binding Path=Label, Mode=OneWay, Converter={StaticResource TextWrappingConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:MultilinePanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </local:CustomItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Popup Name="PART_Popup"
             MinWidth="{TemplateBinding ExpandWidth}"
             MinHeight="{TemplateBinding ExpandHeight}"
             Placement="Custom"
             Focusable="False"
             AllowsTransparency="True"
             StaysOpen="False"
             PopupAnimation="Fade"
             IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                                        <mwt:SystemDropShadowChrome x:Name="PART_Shadow"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="True">

                                            <Border Background="{StaticResource Default.QuickDropDownBackground}"
                  BorderThickness="1"
                  CornerRadius="2"
                  BorderBrush="{StaticResource QuickDropDownBorderBrush}">

                                                <DockPanel LastChildFill="True"                       
                       SnapsToDevicePixels="True">

                                                    <Border Name="PART_ThumbBorder"
                         DockPanel.Dock="Bottom"
                         BorderThickness="0,1,0,0"
                         BorderBrush="#DDE7EE"
                         Background="{StaticResource Blue.Gallery.Bottom.Background}">
                                                        <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                                    </Border>

                                                    <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                                    <Grid DockPanel.Dock="Top">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                            <RowDefinition Height="Auto" MinHeight="0"/>
                                                        </Grid.RowDefinitions>
                                                        <ScrollViewer Grid.Row="0">
                                                            <ItemsPresenter VerticalAlignment="Top"/>
                                                        </ScrollViewer>

                                                        <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                    Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                    ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                        </mwt:SystemDropShadowChrome>
                                    </Popup>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                                    <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                                </Trigger>

                                <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                                    <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                                    <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
                                </Trigger>

                                <Trigger Property="ResizeDirection" Value="VerticalOnly">
                                    <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
									<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalPopupResizeThumbTemplate}" />
									<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
                                </Trigger>

                                <Trigger Property="PopupPosition" Value="Above">
                                    <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
									<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
										<Setter.Value>
											<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
										</Setter.Value>
									</Setter>
									<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blue.MouseOver.BorderBrush}" />
                                    <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Default.GalleryOuterHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Default.GalleryHoverBorderBrush}"/>
                                </Trigger>
								<Trigger Property="ResizeDirection" Value="NoResize">
									<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
								</Trigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
										<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
									</MultiDataTrigger.Conditions>
									<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
										<Setter.Value>
											<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
										</Setter.Value>
									</Setter>
									<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
								</MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="SizeForm" Value="Small"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonGallery}">
                            <Border Name="PART_OuterBorder" BorderThickness="1" CornerRadius="1" BorderBrush="Transparent"  Opacity="{TemplateBinding Opacity}" IsEnabled="{TemplateBinding IsEnabled}">
                                <Border Name="PART_ToggleButton"
		  CornerRadius="2"
				BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
		  Background="{TemplateBinding Background}"
		  Opacity="{TemplateBinding Opacity}"
		  IsEnabled="{TemplateBinding IsEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
								VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image Margin="2" Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
									 Width="16" Height="16" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                        <Path Grid.Column="2"
							  Fill="{StaticResource Blue.Path.Fill}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 0 L 4 4 L 8 0 Z"
							  Margin="1"/>
                                        <Popup Name="PART_Popup"
             MinWidth="{TemplateBinding ExpandWidth}"
             MinHeight="{TemplateBinding ExpandHeight}"
             Placement="Custom"
             Focusable="False"
             AllowsTransparency="True"
             StaysOpen="False"
             PopupAnimation="Fade"
             IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                                            <mwt:SystemDropShadowChrome x:Name="PART_Shadow"
                                      SnapsToDevicePixels="True"
                                      ClipToBounds="True">

                                                <Border Background="{StaticResource Default.QuickDropDownBackground}"
                    BorderThickness="1"
                    CornerRadius="2"
                    BorderBrush="{StaticResource QuickDropDownBorderBrush}">

                                                    <DockPanel LastChildFill="True"
                         SnapsToDevicePixels="True">

                                                        <Border Name="PART_ThumbBorder"
                           DockPanel.Dock="Bottom"
                           BorderThickness="0,1,0,0"
                           BorderBrush="#DDE7EE"
                           Background="{StaticResource Blue.Gallery.Bottom.Background}">
                                                            <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                                        </Border>

                                                        <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                                        <Grid DockPanel.Dock="Top">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                                <RowDefinition Height="Auto" MinHeight="0"/>
                                                            </Grid.RowDefinitions>
                                                            <ScrollViewer Grid.Row="0">
                                                                <ItemsPresenter VerticalAlignment="Top"/>
                                                            </ScrollViewer>

                                                            <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                      Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                      ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </mwt:SystemDropShadowChrome>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                                    <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                                </Trigger>

                                <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                                    <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                                    <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
                                </Trigger>

                                <Trigger Property="ResizeDirection" Value="VerticalOnly">
                                    <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
									<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalPopupResizeThumbTemplate}" />
									<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
                                </Trigger>

                                <Trigger Property="PopupPosition" Value="Above">
                                    <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
									<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
										<Setter.Value>
											<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
										</Setter.Value>
									</Setter>
									<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />

                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blue.MouseOver.BorderBrush}" />
                                    <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Default.GalleryOuterHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Default.GalleryHoverBorderBrush}"/>
                                </Trigger>
								<Trigger Property="ResizeDirection" Value="NoResize">
									<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
								</Trigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
										<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
									</MultiDataTrigger.Conditions>
									<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
										<Setter.Value>
											<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
										</Setter.Value>
									</Setter>
									<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
								</MultiDataTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="SizeForm" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonGallery}">
                            <Border Name="PART_OuterBorder" BorderThickness="1" Height="23" Width="33" CornerRadius="1" BorderBrush="Transparent">
                                <Border Name="PART_ToggleButton"
                  Height="23" CornerRadius="1" Width="33"
                  BorderThickness="{TemplateBinding BorderThickness}"
						      BorderBrush="{TemplateBinding BorderBrush}"
						      Background="{TemplateBinding Panel.Background}">
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
						    VerticalAlignment="Center"
                HorizontalAlignment="Center">
                                            <Image Margin="1" 
                 Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
								 Width="16"
                 Height="16" />
                                        </Border>
                                        <Path Grid.Column="1"
					    Fill="{StaticResource Blue.Path.Fill}"
					    HorizontalAlignment="Center"
					    VerticalAlignment="Center"
					    Data="M 0 0 L 4 4 L 8 0 Z"
					    Margin="1"/>
                                        <Popup Name="PART_Popup"
             MinWidth="{TemplateBinding ExpandWidth}"
             MinHeight="{TemplateBinding ExpandHeight}"
             Placement="Bottom"
             Focusable="False"
             AllowsTransparency="True"
             StaysOpen="False"
             PopupAnimation="Fade"
             IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                                            <mwt:SystemDropShadowChrome x:Name="PART_Shadow"
                                      SnapsToDevicePixels="True"
                                      ClipToBounds="True">

                                                <Border Background="{StaticResource Default.QuickDropDownBackground}" VerticalAlignment="Stretch"
                    BorderThickness="1"                 
                    BorderBrush="{StaticResource QuickDropDownBorderBrush}">

                                                    <DockPanel  VerticalAlignment="Stretch"
                         SnapsToDevicePixels="True">

                                                        <Border Name="PART_ThumbBorder"
                           DockPanel.Dock="Bottom"
                           BorderThickness="0,1,0,0"
                           BorderBrush="#DDE7EE"
                           Background="{StaticResource Blue.Gallery.Bottom.Background}">
                                                            <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                                        </Border>

                                                        <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                                        <Grid DockPanel.Dock="Top">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                                <RowDefinition Height="Auto" MinHeight="0"/>
                                                            </Grid.RowDefinitions>
                                                            <ScrollViewer Grid.Row="0">
                                                                <ItemsPresenter VerticalAlignment="Top"/>
                                                            </ScrollViewer>
                                                            <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                      Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                      ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </mwt:SystemDropShadowChrome>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                                    <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blue.MouseOver.BorderBrush}" />
                                    <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Default.GalleryOuterHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Default.GalleryHoverBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                                    <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                                    <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
                                </Trigger>
                                <Trigger Property="ResizeDirection" Value="VerticalOnly">
                                    <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
									<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalPopupResizeThumbTemplate}" />
									<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
                                </Trigger>
                                <Trigger Property="PopupPosition" Value="Above">
                                    <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
									<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
										<Setter.Value>
											<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
										</Setter.Value>
									</Setter>
									<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />

                                </Trigger>
								<Trigger Property="ResizeDirection" Value="NoResize">
									<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
								</Trigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
										<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
									</MultiDataTrigger.Conditions>
									<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
										<Setter.Value>
											<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
										</Setter.Value>
									</Setter>
									<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
								</MultiDataTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Blue.MouseOver.BorderBrush}" />
                <!--<Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}" />-->
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="IsDropDownOpen" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Default.GalleryHoverBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource DropDownButton.IsDropDownOpen.BackgroundBrush}"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="HasGroups" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:GalleryGroupPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsEnabled.BackgroundBrush}" />
            </MultiTrigger>

        </Style.Triggers>
    </Style>

    <!--UpButtonStyle Style-->
    <Style x:Key="UpButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border  BorderThickness="1,1,1,1" Name="RepeatBorder">
                        <Border BorderThickness="1" x:Name="innerborder">
                            <Grid>
                                <Path Data="M 0 4 L 7 4 L 3.5 0 Z" Fill="{StaticResource GalleryButtonPathFill}" Name="RepeatSign" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="UIElement.IsMouseOver" Value="True">                            
                            <Setter Property="Background" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="White"/>
                        </Trigger>
                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                            <Setter Property="BorderBrush" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter Property="Background" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--DownButtonStyle Style-->
    <Style x:Key="DownButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border BorderThickness="1,1,1,1" Name="RepeatBorder" >
                        <Border BorderThickness="1" x:Name="innerborder">
                            <Grid>                                
                                <Path Data="M 0 0 L 3.5 4 L 7 0 Z" Fill="{StaticResource GalleryButtonPathFill}" Name="RepeatSign" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="UIElement.IsMouseOver" Value="True">                            
                            <Setter Property="Background" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="White"/>
                        </Trigger>
                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                            <Setter Property="BorderBrush" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter Property="Background" TargetName="RepeatBorder" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="White"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonListBox Style-->
    <Style TargetType="{x:Type local:RibbonListBox}" x:Key="TransparentRibbonListBoxStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource  RibbonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="3,7,3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource RibbonTitleForeground}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border SnapsToDevicePixels="true" x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="1">
                        <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                            <ScrollViewer.Style>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Rectangle Fill="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" x:Name="Corner" Grid.Column="1" Grid.Row="1"/>
                                                    <ScrollContentPresenter Margin="{TemplateBinding Padding}" x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False"/>
                                                    <ScrollBar Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Cursor="Arrow" x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" ViewportSize="{TemplateBinding ViewportHeight}" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding Path=VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.AutomationId="VerticalScrollBar">
                                                        <ScrollBar.Style>
                                                            <Style TargetType="{x:Type ScrollBar}">
                                                                <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
                                                                <Setter Property="Background" Value="{StaticResource Blue.TextBoxBackgroundHover}"/>
                                                                <Setter Property="Width" Value="16" />
                                                                <Setter Property="MinWidth" Value="16" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                </Grid.RowDefinitions>
                                                                                <RepeatButton Grid.Row="0" Style="{StaticResource UpButtonStyle}" Command="ScrollBar.LineUpCommand"/>
                                                                                <RepeatButton Grid.Row="2" Style="{StaticResource DownButtonStyle}" Command="ScrollBar.LineDownCommand"/>
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ScrollBar.Style>
                                                    </ScrollBar>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="true">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonListBoxStyle}" TargetType="{x:Type local:RibbonListBox}"/>

    <!--RibbonMenuGroup Style-->
    <Style x:Key="TransparentRibbonMenuGroupStyle"  TargetType="{x:Type local:RibbonMenuGroup}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonMenuGroup}">
                    <local:LayoutPanel x:Name="PART_LayoutPanel" Width="{TemplateBinding ActualWidth}">
                        <StackPanel Margin="1,0,1,1" HorizontalAlignment="Stretch">
                            <Border Name="PART_Header"  Height="21"  HorizontalAlignment="Stretch" Margin="0,0,0,2"  SnapsToDevicePixels="True" Background="{StaticResource ContextMenuBackground}" BorderBrush="{StaticResource ContextMenuBorderBrush}" BorderThickness="0,0,0,1" Padding="7,0,5,0" >
                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold"  Foreground="{StaticResource RibbonTitleForeground}" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" x:Name="PART_Presenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,1"/>
                        </StackPanel>
                        <Border BorderThickness="0,0,1,0"  Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"  Margin="1,1,1,1" Background="{DynamicResource ContextMenuBackground}" BorderBrush="Transparent" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
                    </local:LayoutPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="PART_Header" Property="Height" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonMenuGroupStyle}" TargetType="{x:Type local:RibbonMenuGroup}"/>
    <Style x:Key="TransparentRibbonGalleryGroupStyle" TargetType="{x:Type local:RibbonGalleryGroup}">

        <Setter Property="Background" Value="{StaticResource QATTopBarBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ContextMenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="Height" Value="21"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonGalleryGroup}">
                    <Border Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  Background="{TemplateBinding  Background}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Padding="7,0,0,0">
                        <TextBlock Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}" 
                       FontSize="{TemplateBinding FontSize}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontStyle="{TemplateBinding FontStyle}"
                       VerticalAlignment="{TemplateBinding VerticalAlignment}"
                       HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                       FlowDirection="{TemplateBinding FlowDirection}"
                       FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TransparentRibbonGalleryGroupStyle}" TargetType="{x:Type local:RibbonGalleryGroup}"/>
    <!--RibbonPage Style-->
    <Style TargetType="{x:Type local:RibbonPage}">
        <Setter Property="Margin" Value="0,25,0,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonPage}">
                    <AdornerDecorator x:Name="PART_Adorner">
                        <Grid>
                            <Border Name="PART_MainBorder"
                  Background="{StaticResource Window.BackgroundBrush}"
                  BorderBrush="{StaticResource Window.BorderBrush}"
                  BorderThickness="1" 
                  CornerRadius="5">
                                <DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
                                    <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>
                                    <AdornerDecorator DockPanel.Dock="Top" Panel.ZIndex="100">
                                        <ContentPresenter Content="{TemplateBinding Ribbon}"/>
                                    </AdornerDecorator>
                                    <ContentPresenter  DockPanel.Dock="Bottom" Content="{TemplateBinding Content}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </AdornerDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonRadioButton Style-->
    <Style TargetType="{x:Type local:RibbonRadioButton}"  x:Key="TransparentRibbonRadioButtonStyle">
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource  CheckBoxForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource CheckBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckBoxStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid>
                                <Ellipse x:Name="border1" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="12" Height="12" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                                <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center"  x:Name="ellipse" Width="6" Height="6" SnapsToDevicePixels="True"/>
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="true">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource CheckRadioFocusVisual}"/>
                            <Setter Property="Padding" Value="4,-1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border1" Property="Fill" Value="White"/>
                            <Setter TargetName="border1" Property="Opacity" Value=".3"/>
                            <Setter Property="Foreground" Value="{StaticResource CheckBoxDisabledForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Fill" TargetName="ellipse" Value="{StaticResource CheckBoxForegroundBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border1" Property="Fill" Value="{StaticResource CheckBoxMouseHoverBackground}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border1" Property="Fill" Value="{StaticResource CheckBoxCheckedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonRadioButtonStyle}" TargetType="{x:Type local:RibbonRadioButton}"/>

    <!--RibbonScrollingButton style-->
    <Style x:Key="RibbonScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_Border" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0,3,3,0"
					>
                        <Border x:Name="PART_InnerBorder" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{StaticResource Blue.CheckBoxBackground}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
        CornerRadius="0,3,3,0">
                            <Path x:Name="PART_Path" Stroke="Transparent" StrokeThickness="2" Fill="{StaticResource Blue.Path.Fill}" Margin="3,16,-2,0"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="{StaticResource Default.PathData}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Left">
                            <Setter TargetName="PART_Path" Property="Margin" Value="6,0,-5,0"/>
                            <Setter TargetName="PART_Path" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Border" Property="CornerRadius" Value="3,0,0,3"/>
                            <Setter TargetName="PART_InnerBorder" Property="CornerRadius" Value="3,0,0,3"/>
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="0,0,1,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource  ButtonHoverInnerBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="Background" Value="{StaticResource RibbonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--RibbonSeparator Style-->
    <Style TargetType="{x:Type local:RibbonSeparator}">
        <Setter Property="Focusable"   Value="False"/>
        <Setter Property="Width" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonSeparator}">
                    <Border HorizontalAlignment="Left" Width="1" Height="55" Background="{StaticResource SeparatorBrush}" Grid.Column="1"  Grid.RowSpan="2" SnapsToDevicePixels="True">
                    </Border>
                    <!--<Rectangle  Height="55" Width="2" >
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush EndPoint="4.826,0.129" StartPoint="4.957,1.018">
                                <GradientStop Color="Black" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="-0.157,0.5" StartPoint="1.268,0.5">
                                <GradientStop Color="#FFEBF1F7" Offset="0"/>
                                <GradientStop Color="#FFEBF1F7" Offset="0.056"/>
                                <GradientStop Color="#FFB0B0B0" Offset="0.387"/>
                                <GradientStop Color="#FF93A7C3" Offset="0.389"/>
                                <GradientStop Color="#FF93A7C3" Offset="0.667"/>
                                <GradientStop Color="#FFEBF1F7" Offset="0.674"/>
                                <GradientStop Color="#FFECF1F7" Offset="0.383"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="3,5,3,0"/>
    </Style>

    <Style TargetType="{x:Type local:RibbonTextBox}">
        <Setter Property="Foreground" Value="{StaticResource TextBoxForeground}"/>
        <Setter Property="Background" Value="{StaticResource TextBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrush}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonTextBox}">
                    <Border SnapsToDevicePixels="true" x:Name="Bd" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource TextBoxDisabledBackground}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TextBoxDisabledBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="{StaticResource TextBoxFocusedBackground}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TextBoxFocusedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBoxMouseOverBorderBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TextBoxMouseOverBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Type local:TitleButtonAdorner}" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <Border Background="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleButtonAdorner}}, Converter={StaticResource correctingBrushConverter}, Path=Color, Mode=OneWay}">
                        <Border Name="PART_Border"  
                    Height="{TemplateBinding Height}"                  
                    Width="{TemplateBinding Width}" >
                            <ContentPresenter IsHitTestVisible="False" Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleButtonAdorner}}, Path=Content}"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:WindowTitleBarButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Focusable" Value="false" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WindowTitleBarButton}">
                    <Border Background="{TemplateBinding Background}" 
                  BorderBrush="{TemplateBinding BorderBrush}" x:Name="border"
                  BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter  Content="{TemplateBinding Content}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" RecognizesAccessKey="False"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger  Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger  Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="WindowButtonsPathBrush" Color="Black" Opacity=".5"/>
    <!--TitleBar Style-->
    <Style x:Key="TitleBarStyleKey" TargetType="{x:Type local:TitleBar}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowTopBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TitleBar}">
                    <Border Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}"
                >
                        <Grid Name="GlassActive" Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="{Binding Path=QATColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding Path=SysButtonsColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid.ColumnDefinitions>

                            <Grid  Grid.Column="2" Margin="10,0,10,10">
                                <Rectangle x:Name="rectangle" Fill="#7FFFFFFF" Stroke="{x:Null}" StrokeThickness="0" 
                               HorizontalAlignment="{Binding HorizontalAlignment,ElementName=PART_Title,Mode=TwoWay}" 
                               VerticalAlignment="Top" Margin="5,5,0,0" Width="{Binding ActualWidth, ElementName=PART_Title, Mode=Default}" 
                               Height="{Binding ActualHeight, ElementName=PART_Title, Mode=Default}" RadiusX="2" RadiusY="2"
                               Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive,Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Rectangle.Effect>
                                        <BlurEffect Radius="10"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                                <TextBlock Name="PART_Title"                            
                           Grid.Column="2"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=TitleTextAlignment}" 
                           VerticalAlignment="Top"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           Text="{TemplateBinding Title}"
                           Margin="5,5,0,0"
                           MaxWidth="{TemplateBinding TitleMaxWidth}">
                                </TextBlock>
                            </Grid>
                            <Image Source="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=Office2010Icon}"  shell:WindowChrome.IsHitTestVisibleInChrome="True" Height="16" Width="16" x:Name="Part_SysIcon" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,5,-3,0" />

                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Top"  Grid.Column="3" x:Name="stack">
                                <local:WindowTitleBarButton x:Name="MinButton" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path= MinimizeTooltip}" Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="9" Height="9">
                                        <Line X1="0" X2="8"  Y1="6" Y2="6" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Line X1="0" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Line X1="0" X2="8"  Y1="8" Y2="8" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="MaxButton" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=MaximizeTooltip}"  Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="9" Height="9">
                                        <Border BorderThickness="1,3,1,1" Width="9" Margin="0,1,0,0" Height="7" BorderBrush="{StaticResource WindowButtonsPathBrush}"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="NormalButton" Width="25" Height="25" Visibility="Hidden" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=RestoreTooltip}" Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="9" Height="8">
                                        <Line X1="2" X2="9"  Y1="1.5" Y2="1.5" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="2"  Stroke="{StaticResource WindowButtonsPathBrush}" Width="3" Height="5" StrokeThickness="1"/>
                                        <Line X1="3" X2="8"  Y1="3" Y2="3" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Line X1="2" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Line X1="0" X2="7"  Y1="2.5" Y2="2.5" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="3" Stroke="{StaticResource WindowButtonsPathBrush}" Width="7" Height="5" StrokeThickness="1"/>
                                        <Line X1="1" X2="6"  Y1="4" Y2="4" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Line X1="0" X2="6"  Y1="8" Y2="8" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="CloseButton" Command="Close" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseTooltip}"  Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="11" Height="10">
                                        <Path Data="M1,0.5L4,0.5 5,2.5 7,0.5 10,0.5" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                        <Path Data="M1,0L4,0 5,2 7,0 10,0 7,4 7,5 10,8 7,8 5,6 4,8 1,8 4,5 4,4z" Fill="{StaticResource WindowButtonsPathBrush}"  StrokeThickness="1"/>
                                        <Path Data="M0,8L4,8 5,6 7,8 11,8" Stroke="{StaticResource WindowButtonsPathBrush}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                            </StackPanel>

                            <Rectangle VerticalAlignment="Stretch"  Name="BlurRect" HorizontalAlignment="Stretch"  Grid.ColumnSpan="4"  >
                                <Rectangle.Effect>
                                    <BlurEffect Radius="8"/>
                                </Rectangle.Effect>
                                <Rectangle.OpacityMask>
                                    <!--<LinearGradientBrush EndPoint="-0.005,0.5" StartPoint="1.013,0.5">
                                        <GradientStop Color="Black" Offset="0.1"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                        <GradientStop Offset="0.017"/>
                                        <GradientStop Color="#FFDFDFDF" Offset="0.919"/>
                                    </LinearGradientBrush>-->
                                    <LinearGradientBrush EndPoint="-0.005,0.5" StartPoint="1,0.5">
                                        <GradientStop Color="Black" Offset="0.1"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                        <GradientStop Offset="0.017"/>
                                        <GradientStop Color="#FFDFDFDF" Offset="0.919"/>
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                                <Rectangle.Fill>
                                    <!--<SolidColorBrush Color="White"     Opacity=".5"                             />-->
                                    <LinearGradientBrush EndPoint="0.517,1.139" StartPoint="0.517,0.273">
                                        <GradientStop Color="White" Offset="0.543"/>
                                        <GradientStop Color="#21F4FAFF" Offset="0.004"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=Office2010Icon}" Value="{x:Null}">
                            <Setter TargetName="Part_SysIcon" Property="Visibility" Value="Collapsed"></Setter>
                        </DataTrigger>
						<MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Part_SysIcon" Property="Margin" Value="3,3,-3,0"></Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Part_SysIcon" Property="Margin" Value="3,8,-3,0"></Setter>
							<Setter TargetName="stack" Property="Margin" Value="1,1,0,0"></Setter>
                        </MultiDataTrigger>
                        
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Normal">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Minimized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>

                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanMinimize">
                            <Setter TargetName="MaxButton" Property="IsEnabled" Value="False"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Normal" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Title" Property="BitmapEffect">
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="#FFFFFFFF" GlowSize="14" Opacity="1"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=MaximizedMode}" Value="KioskStyle" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="None" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BlurRect"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="None" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GlassActive"/>
                        </MultiDataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False">
                <Setter Property="SysButtonsColumnWidth" Value="75"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="NoResize">
                <Setter Property="SysButtonsColumnWidth" Value="26"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="26"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanResize" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="90"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanResizeWithGrip" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="94"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="20"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="None" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="0"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--RibbonWindow style-->
    <Style x:Key="TransparentRibbonWindowStyle" TargetType="{x:Type local:RibbonWindow}">
        <Setter Property="RibbonStatusBarStyle" Value="{StaticResource TransparentRibbonStatusBarStyle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MinHeight" Value="150"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>
        
        <Setter Property="Background" Value="{StaticResource WindowBackground}" />
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="2" />
        <Style.Triggers>

            <Trigger Property="IsGlassActive" Value="True">

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid >
                                   
                                    <DockPanel HorizontalAlignment="Stretch" Background="Transparent"  VerticalAlignment="Stretch">

                                        <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}"  DockPanel.Dock="Top" Height="52"  Style ="{StaticResource TitleBarStyleKey}"/>

                                        <Grid Background="{TemplateBinding Background}">
                                            <DockPanel>
                                                <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding StatusBar}"/>

                                                <Border Name="PART_ContentBorder"  DockPanel.Dock="Bottom"  Margin="0"  
								  Padding="0,1,0,0"   BorderThickness="1,0,1,1"
								  BorderBrush="#FFB6B6B6" IsHitTestVisible="True" >
                                                    <Grid >
                                                        <ContentPresenter Content="{TemplateBinding Content}"/>
                                                        <ContentControl Content="{TemplateBinding BackStage}" x:Name="BackStageContent"  Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>
                                            </DockPanel>

                                            <Label x:Name="PART_ResizeGrip"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Visibility="Collapsed"
								IsTabStop="False"
								Cursor="SizeNWSE">
                                                <Grid SnapsToDevicePixels="True" Background="Transparent">
                                                    <Path Fill="{StaticResource Blue.ResizeGripperForegroundLight}"
										Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"/>

                                                    <Path Fill="{StaticResource Blue.ResizeGripperForegroundDark}" 
										Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" />
                                                </Grid>
                                            </Label>
                                        </Grid>
                                    </DockPanel>
                                </Grid>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsGlassActive" Value="True">
                                    <Setter TargetName="PART_TitleBar" Property="Background" Value="Transparent">
                                        <!--<Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Offset="0"/>
                                                <GradientStop Color="White" Offset="1"/>
                                                <GradientStop Color="#FF8B8B8B" Offset="0.763"/>
                                                <GradientStop Color="#FF838383" Offset="0.886"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>-->
                                    </Setter>
                                    <Setter TargetName="PART_TitleBar" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="PART_TitleBar" Property="Foreground" Value="#FF000000"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsGlassActive}"  Value="True" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}" Value="Maximized" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Margin" Value="0,6,0,0"/>
                                    <Setter TargetName="PART_TitleBar" Property="Height" Value="48"/>
                                    <!--<Setter TargetName="PART_ContentBorder" Property="Margin" Value="0,8,0,0"/>-->
                                </MultiDataTrigger>
                                <!--<MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
                                </MultiTrigger>-->
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Margin" TargetName="BackStageContent" Value="0,20,0,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <Trigger Property="IsGlassActive" Value="False">
               
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid>
                                    <Border Name="PART_MainBorder"
						    Background="{TemplateBinding Background}"
						    BorderBrush="{TemplateBinding BorderBrush}"
						    BorderThickness="{TemplateBinding BorderThickness}"
						    CornerRadius="2,2,0,0"
						    Padding="{TemplateBinding Padding}">
                                        <Border>
                                            <Border x:Name="PART_Border">
                                                <Border.Margin>
                                                    <Thickness Top="1" Bottom="{x:Static  SystemParameters.ResizeFrameHorizontalBorderHeight}" Left="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}" Right="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}"/>
                                                </Border.Margin>
                                                <DockPanel HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
                                            <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Height="52" Margin="2,0,0,0"
                             Style ="{StaticResource TitleBarStyleKey}"/>
                                            <Grid >
                                                <DockPanel Background="{TemplateBinding Background}">
                                                    <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding StatusBar}"/>
                                                            <Border Name="PART_ContentBorder1"  DockPanel.Dock="Bottom"  Margin="0,0,0,0"  
								  Padding="0,0,0,0"   Background="{TemplateBinding Background}"
								   BorderBrush="#FFB6B6B6" BorderThickness="1,0,1,1" IsHitTestVisible="True" >
                                                                <Grid   DockPanel.Dock="Bottom" >
                                                                    <ContentPresenter 	Content="{TemplateBinding Content}"/>
                                                                    <ContentControl Content="{TemplateBinding BackStage}" x:Name="BackStageContent" Visibility="Collapsed"/>

                                                                </Grid>
                                                            </Border>
                                                        </DockPanel>

                                                <Label x:Name="PART_ResizeGrip"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Visibility="Collapsed"
								IsTabStop="False"
								Cursor="SizeNWSE">
                                                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                                                        <Path Fill="{StaticResource Blue.ResizeGripperForegroundLight}" Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"/>
                                                        <Path Fill="{StaticResource Blue.ResizeGripperForegroundDark}" 
										Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z"
										 />
                                                    </Grid>
                                                </Label>
                                            </Grid>
                                        </DockPanel>
                                            </Border>
                                    </Border>
                                    </Border>
                                </Grid>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsActive" Value="True">
                                    <Setter TargetName="PART_TitleBar" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="PART_TitleBar" Property="BorderBrush" Value="{StaticResource WindowTopBorderBrush}"/>
                                    <Setter TargetName="PART_MainBorder" Property="Background" Value="{StaticResource ActiveTitleBarBackgroundBrush}"/>
                                    <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="MaximizedMode" Value="KioskStyle" />
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
									<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                                </MultiTrigger>
									<Trigger Property="WindowState" Value="Maximized">
                                    <Setter Property="Margin" TargetName="PART_Border">
                                        <Setter.Value>
                                            <Thickness Top="4" 
											Bottom="{x:Static  SystemParameters.ResizeFrameHorizontalBorderHeight}" 
											Left="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}" 
											Right="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Margin" TargetName="BackStageContent" Value="0,20,0,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonWindowStyle}" TargetType="{x:Type local:RibbonWindow}"/>

    <!--ScreenTip Style-->
    <Style x:Key="TransparentScreenTipStyle" TargetType="{x:Type local:ScreenTip}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ScreenTipBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource ScreenTipBackground}" />
        <Setter Property="Padding" Value="1,1,3,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
            
           
                <ControlTemplate TargetType="{x:Type local:ScreenTip}">
                   
                        <Border MinHeight="20"
								CornerRadius="2"
								Background="{TemplateBinding Background}"
								BorderThickness="{TemplateBinding BorderThickness}"
								BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition  />
                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" FontFamily="Calibri"  Margin="4,4,1,4" Foreground="Black"
										 Text="{TemplateBinding Description}" Name="Desc" />
                                <StackPanel Orientation="Horizontal" Grid.Row="1">
                                    <Border  Margin="6" Name="Image" VerticalAlignment="Center">
                                        <Image  Source="{Binding Path=ImageSource, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <ContentPresenter Margin="2,1,4,6" Grid.Row="1"  Name="Text" 
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextBlock.Foreground="#FF4C4C4C"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </StackPanel>
                                <Border Name="PART_Seperator" Margin="4,1,4,0" Background="Black" Grid.Row="2" Height="1" SnapsToDevicePixels="True"  Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition  />
                                    </Grid.ColumnDefinitions>
                                    <Border  HorizontalAlignment="Left"   Grid.Column="0" Margin="4,4,0,4" x:Name="HelpImage">
                                        <Image Height="16" x:Name="helpImage" Width="16"  Source="{Binding Path=HelpIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <TextBlock HorizontalAlignment="Left"  Name="PART_HelpText" Text="{TemplateBinding HelpText}"  Grid.ColumnSpan="2" Grid.Column="0"
                                               FontSize="12" FontWeight="Bold" FontFamily="Calibri"  Margin="28,4,1,4" Foreground="Black" />
                                </Grid>
                            </Grid>
                        </Border>
                  

                    <ControlTemplate.Triggers>
                       
                        <Trigger Property="HelpIcon" Value="{x:Null}" >
                            <Setter TargetName="helpImage" Property="Source" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/HelpSmall.png" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="4,1,4,1" />
                        </Trigger>
                        <Trigger Property="HelpText" Value="">

                            <Setter TargetName="HelpImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Seperator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HelpText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentScreenTipStyle}" TargetType="{x:Type local:ScreenTip}"/>

    <!--TabButton Style-->
    <Style TargetType="{x:Type local:TabButton}"  x:Key="TransparentTabButtonStyle">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Background" Value="{StaticResource TabItemBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TabItemForeground}"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabButton}">
                    <Border Height="25" x:Name="border" Background="{TemplateBinding Background}" Margin="0,0,0,-3">
                        <Grid  ClipToBounds="True">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="7"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Border 
                      Height="24" Name="center_Path"
                      Margin="0"
                      Grid.Column="1"
                      BorderThickness="1,1,1,0" CornerRadius="5,5,0,0"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      Background="{TemplateBinding Background}">

                                <shared:TrippleBorder>
                                    <Grid>
                                        <ContentPresenter  Content="{TemplateBinding Content}" x:Name="PART_CaptionContent"
                                              ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=ItemTemplate}"
                                               ContentTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=ItemTemplateSelector}"/>
                                        <TextBlock Name="PART_Caption"
                             Text="{TemplateBinding Caption}" 
                             TextAlignment="Center"
                             VerticalAlignment="Center" Margin="2,-1.1,2,2"
                             Foreground="{TemplateBinding Foreground}"/>
                                    </Grid>
                                </shared:TrippleBorder>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                                     Value="True">
                            <Setter Property="Margin" TargetName="border" Value="0,0,0,-1"/>
                        </DataTrigger>
                        <!--  Context  Tab Group Checked -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}"  Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" TargetName="center_Path" Value="{DynamicResource TabItemSelectedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="center_Path" Value="{DynamicResource TabItemSelectedBorderBrush}"/>
                            <!--<Setter Property="Margin" TargetName="border" Value="0,0,0,-3"/>-->
                        </MultiDataTrigger>
                        <!--  Tab Checked -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}"  Value="False"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" TargetName="center_Path" Value="{DynamicResource TabItemSelectedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="center_Path" Value="{DynamicResource TabItemSelectedBorderBrush}"/>
                            <!--<Setter Property="Margin" TargetName="border" Value="0,0,0,-3"/>-->
                        </MultiDataTrigger>
                        <!-- Context Tab Group Checked MouseOver-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}},  Path=HasContextTabGroup}" Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" TargetName="center_Path" Value="{DynamicResource TabItemSelectedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="center_Path" Value="{DynamicResource TabItemSelectedBorderBrush}"/>
                            <!--<Setter Property="Margin" TargetName="border" Value="0,0,0,-3"/>-->
                        </MultiDataTrigger>
                        <!-- Tab Mouse Over -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" TargetName="center_Path" Value="{StaticResource TabItemHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="center_Path" Value="{StaticResource TabItemHoverBorderBrush}"/>
                            <!--<Setter Property="Margin" TargetName="border" Value="0,0,0,-3"/>-->
                        </MultiDataTrigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentTabButtonStyle}" TargetType="{x:Type local:TabButton}"/>

    <!--QuickAccessToolBar style-->
    <Style x:Key="{x:Type local:QuickAccessToolBar}" TargetType="{x:Type local:QuickAccessToolBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="GeometryBackground" Value="Transparent"/>
        <Setter Property="GeometryStroke" Value="Transparent"/>
        <Setter Property="Control.Foreground" Value="{StaticResource RibbonTextForeground}"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Focusable" Value="False"/>
             
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:QuickAccessToolBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle VerticalAlignment="Center" Fill="{StaticResource SeparatorBrush}" SnapsToDevicePixels="True" Width="1" StrokeThickness="0" Grid.Column="0" HorizontalAlignment="Left" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=IsQATBelow, Converter={StaticResource BooleanToVisibilityConvertor}}">
                            <Rectangle.Style>
                                <Style TargetType="{x:Type Rectangle}">
                                    <Setter Property="Height" Value="15"/>
                                    <Style.Triggers>
                                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                            <Setter Property="Height" Value="35"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Border Grid.Column="1" Height="{TemplateBinding Height}" Width="{TemplateBinding  Width}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <local:TwoItemsLayoutPanelEx Name="PART_PanelEx" shell:WindowChrome.IsHitTestVisibleInChrome="True"  MinRightWidth="30" MaxRightWidth="30">
                                <ItemsControl Name="PART_Main"
                        Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:QuickAccessToolBarPanel	HorizontalAlignment="Left"	ClipToBounds="True" Background="Transparent"                                        
						GeometryBackground="{Binding Path=GeometryBackground, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                        
						GeometryStroke="{Binding Path=GeometryStroke, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                         
						GeometryStrokeThickness="{Binding Path=GeometryStrokeThickness, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                                                                                
						HasGeometry="{Binding Path=HasGeometry, Mode=TwoWay, RelativeSource={RelativeSource  AncestorType={x:Type local:QuickAccessToolBar}}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource SeparatorBrush}" Width="1" IsHitTestVisible="False" StrokeThickness="0" HorizontalAlignment="Left" Grid.Column="0" VerticalAlignment="Center"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=IsQATBelow, Converter={StaticResource BooleanToVisibilityConvertor}}">
                                        <Rectangle.Style>
                                            <Style TargetType="{x:Type Rectangle}">
                                                <Setter Property="Height" Value="15"/>
                                                <Style.Triggers>
                                                    <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                        <Setter Property="Height" Value="35"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <local:DropDownButton Grid.Column="1" Style="{StaticResource QuickAccessPopupButtonStyle}"  Name="PART_PopupButton" Width="23" >
                                        <Grid Margin="0,0,5,5">
                                            <Border BorderThickness="1" Background="{StaticResource ComboBoxPopupBackground}" BorderBrush="{StaticResource ComboBoxPopupBorderBrush}" Width="Auto" SnapsToDevicePixels="True">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".5" Direction="325"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <DockPanel>
                                                        <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource ContextMenuPopupLeftBarBackground}" BorderThickness="0,0,1,0" BorderBrush="Transparent" />
                                                    </DockPanel>
                                                    <StackPanel>
                                                        <Border Background="{StaticResource QATTopBarBackground}"   Margin="0" Height="22" Width="Auto" >
                                                            <TextBlock x:Uid="CustomizeQATTextBlock"  Margin="13,0,30,0" FontFamily="Calibri"  Foreground="{StaticResource RibbonTitleForeground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQAT}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto"/>
                                                        </Border>
                                                        <ItemsControl Name="PART_QATMenu">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                                                        <StackPanel.Resources>
                                                                            <Style TargetType="{x:Type local:RibbonButton}">
                                                                                <Setter  Property="OverridesDefaultStyle"     Value="true"/>
                                                                                <Setter Property="Background"                 Value="Transparent"/>
                                                                                <Setter Property="Foreground"                 Value="{DynamicResource RibbonTitleForeground}"/>
                                                                                <Setter Property="BorderThickness"            Value="1"/>
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                                                                                            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Name="OuterBorder" Background="{TemplateBinding Panel.Background}" Width="{TemplateBinding Width}"                                                      
                  Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" CornerRadius="0" MinHeight="{TemplateBinding MinHeight}" MaxHeight="{TemplateBinding MaxHeight}" 
                            Margin="{TemplateBinding Margin}"  SnapsToDevicePixels="True">
                                                                                                <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                                                                                                    <Grid>
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                            <ColumnDefinition Width="Auto" MinWidth="22"/>
                                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="19" Height="19" BorderThickness="1" BorderBrush="{StaticResource TransparentThemeChkBoxBorderBrush}" 
                      Background="{StaticResource TransparentThemeChkBoxBackground}">
                                                                                                            <Path Fill="{StaticResource TransparentThemeChkBoxPathFill}"  SnapsToDevicePixels="True" Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Width="9" Height="11"/>
                                                                                                        </Border>
                                                                                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                                                                    </Grid>
                                                                                                </Border>
                                                                                            </Border>
                                                                                            <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                                    <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                    <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonMenuItemHoverBackgroundBrush}"/>
                                                                                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonMenuItemHoverBorderBrush}"/>
                                                                                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                                                                    <Setter Property="FontSize" Value="18"/>
                                                                                                    <Setter Property="Padding" Value="16,9,16,9"/>
                                                                                                </Trigger>
                                                                                            </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </StackPanel.Resources>
                                                                    </StackPanel>
                                                                                
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                        <Rectangle Name="TopSeperator" Visibility="Collapsed" Fill="{StaticResource SeparatorBrush}" Stroke="{StaticResource SeparatorBrush}" Margin="30,0,0,0" Height="1" StrokeDashArray="3,5" StrokeThickness="1"/>
                                                        <local:RibbonButton Name="PART_MoreCommands" Margin="0,1"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Command="local:RibbonCommands.QATMoreCommands" Foreground="{DynamicResource RibbonTitleForeground}" Width="auto"/>
                                                        <local:RibbonButton Name="PART_AboveButton"  Margin="0,1" Visibility="Collapsed"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{DynamicResource RibbonTitleForeground}" Width="auto"/>
                                                        <local:RibbonButton Name="PART_BelowButton"  Margin="0,1" Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{DynamicResource RibbonTitleForeground}" Width="auto"/>
                                                        <Rectangle  Fill="{StaticResource SeparatorBrush}" Stroke="{StaticResource SeparatorBrush}" Margin="30,1,0,1" Height="1" StrokeDashArray="3,5" StrokeThickness="1"/>
                                                        <local:RibbonButton Name="PART_MinimizeButton" Margin="0,1"  Style="{StaticResource RibbonButtonPopupItemStyle}"  Command="local:RibbonCommands.MinimizeRibbon"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{DynamicResource RibbonTitleForeground}" Width="auto"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </local:DropDownButton>
                                    <local:DropDownButton Grid.Column="1"  x:Name="PART_OverflowButton" Style="{StaticResource QuickAccessPopupButtonOverflowStyle}" Visibility="Collapsed" DockPanel.Dock="Right">
                                        <local:DropDownButton.PathGeometry>
                                            <GeometryGroup>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="3.5,8" IsFilled="True" IsClosed="True">
                                                        <LineSegment Point="4.5,9"/>
                                                        <LineSegment Point="3.5,10"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="7.5,8" IsFilled="True" IsClosed="True">
                                                        <LineSegment Point="8.5,9"/>
                                                        <LineSegment Point="7.5,10"/>
                                                    </PathFigure>
                                                </PathGeometry>
                                            </GeometryGroup>
                                        </local:DropDownButton.PathGeometry>
                                        <StackPanel Orientation="Horizontal" Background="Transparent" MaxHeight="21">
                                            <ItemsControl Name="PART_PopupItemsControl" >
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <local:DropDownButton Name="PART_PopupButtonOverflowed" Style="{StaticResource QuickAccessPopupButtonStyle}"
																Visibility="{TemplateBinding QATDropDownVisiblity}">
                                                <local:DropDownButton.PathGeometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                                        <PathGeometry>
                                                            <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </local:DropDownButton.PathGeometry>
                                                <Border BorderThickness="0.5" BorderBrush="Gray" Padding="2" Width="220">
                                                    <Grid>
                                                        <DockPanel>
                                                            <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blue.QATContextMenu.LeftBar.Backgound}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" />
                                                        </DockPanel>
                                                        <StackPanel>
                                                            <Border Background="{StaticResource Blue.QATContextMenu.TopBar.Backgound}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" Margin="0,0,0,1" Height="22">
                                                                <TextBlock x:Uid="CustomizeQATTextBlock" Margin="3,0,0,0"  Foreground="{StaticResource Blue.QATContextMenu.Foreground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                            <Separator Name="TopSeperatorOverFlow" Visibility="Collapsed" Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource RibbonTextForeground}"/>
                                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource RibbonTextForeground}"/>
                                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource RibbonTextForeground}"/>
                                                            <Separator Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                                            <local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource RibbonTextForeground}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </local:DropDownButton>
                                        </StackPanel>
                                    </local:DropDownButton>
                                </Grid>
                            </local:TwoItemsLayoutPanelEx>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowChildren" Value="True">
                            <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
                            <Setter Property="Visibility" TargetName="TopSeperator" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenuOverFlow">
                            <Setter Property="Visibility" TargetName="TopSeperatorOverFlow" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasGeometry" Value="False">
                            <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FrameworkElement.Height" Value="40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False">
                <Setter Property="GeometryBackground" Value="Transparent"/>
                <Setter Property="GeometryStroke" Value="Transparent"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                     Value="True">
                <Setter Property="GeometryBackground" Value="Transparent"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--CustomScrollViewerStyle-->
    <Style x:Key="CustomScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="1">
                            <ScrollContentPresenter Margin="{TemplateBinding Control.Padding}" CanVerticallyScroll="False" CanHorizontallyScroll="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                        </Border>
                        <RepeatButton x:Name="PART_TopButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineUpCommand" Grid.Column="0" Grid.Row="0">
                            <RepeatButton.Style>
                                <Style TargetType="{x:Type RepeatButton}">
                                    <Setter Property="ButtonBase.ClickMode" Value="Hover"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Margin="1,1,1,1" BorderBrush="{StaticResource Default.MenuCustomScrollBorderBrush}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource Default.MenuCustomScrollBrush}">
                                                    <ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ButtonBase.IsPressed" Value="True">
                                                        <Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBorderBrush}" />
                                                        <Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RepeatButton.Style>
                            <Path Data="M0,4L3.5,0 7,4z" Fill="{StaticResource RibbonTextForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </RepeatButton>
                        <RepeatButton x:Name="PART_BottomButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineDownCommand" Grid.Column="0" Grid.Row="2">
                            <RepeatButton.Style>
                                <Style TargetType="{x:Type RepeatButton}">
                                    <Setter Property="ButtonBase.ClickMode" Value="Hover"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Margin="1,1,1,1" BorderBrush="{StaticResource Default.MenuCustomScrollBorderBrush}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource Default.MenuCustomScrollBrush}">
                                                    <ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ButtonBase.IsPressed" Value="True">
                                                        <Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBorderBrush}" />
                                                        <Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RepeatButton.Style>
                            <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource RibbonTextForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </RepeatButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
                            <Setter TargetName="PART_BottomButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_TopButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ButtonPanel-->
    <Style  TargetType="{x:Type local:ButtonPanel}">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Background" Value="{StaticResource RibbonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonPanelBorderBrush}"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ButtonPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                        </Grid.ColumnDefinitions>
                        <Border  Grid.Column="0"
                            Height="{TemplateBinding Height}" ClipToBounds="True" 
                            BorderThickness="0"                           
                            Background="Transparent">
                            <ItemsPresenter/>
                        </Border>
                        <!-- Separator Border-->
                        <Rectangle HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Stretch" Visibility="{TemplateBinding SeparatorVisibility}" Width="1" Fill="{StaticResource SeparatorBrush}">
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Height"  Value="42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:ButtonLayoutPanel SeparatorBrush="Transparent"  ClipToBounds="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonButton style-->
    <Style x:Key="TransparentRibbonButtonStyle"  TargetType="{x:Type local:RibbonButton}">
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Label" Value="New Button"/>
        <Setter Property="LargeIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt32.png"/>
        <Setter Property="SmallIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt16.png"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="22"/>
        <Style.Triggers>
            <Trigger Property="SizeForm" Value="ExtraSmall">
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                            <Border CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Opacity="{TemplateBinding Opacity}" IsEnabled="{TemplateBinding IsEnabled}"  MinHeight="22"  Name="OuterBorder">
                                <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                                    <Image x:Name="PART_Image" Width="16" Height="16" Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled " Value="False">
                                    <Setter TargetName="PART_Image" Property="Effect" Value="{StaticResource DisableEffect}"/>
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Height" TargetName="PART_Image" Value="20"/>
                                    <Setter Property="Width" TargetName="PART_Image" Value="20"/>
                                    <Setter Property="Width" TargetName="OuterBorder" Value="47"/>
                                    <Setter Property="Height" TargetName="OuterBorder" Value="30"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="SizeForm" Value="Small">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                            <Grid VerticalAlignment="{TemplateBinding VerticalAlignment}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                                <Border CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Opacity="{TemplateBinding Opacity}" IsEnabled="{TemplateBinding IsEnabled}" MinHeight="22" Name="OuterBorder">
                                    <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                                        <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border Name="PART_ImageBorder" Grid.Column="0" Margin="1">
                                                <Image x:Name="PART_Image"  Width="16" Height="16" Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Border>
                                            <TextBlock x:Name="label" Grid.Column="1" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"  Margin="2,3,4,0" Effect="{StaticResource TextBlockEffect}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSmallImageVisible" Value="False">
                                    <Setter TargetName="PART_ImageBorder" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="OuterBorder" Value="{DynamicResource RibbonButtonHoverBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{DynamicResource RibbonButtonHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" TargetName="OuterBorder" Value="{DynamicResource RibbonButtonHoverBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{DynamicResource RibbonButtonHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled " Value="False">
                                    <Setter TargetName="PART_Image" Property="Effect" Value="{StaticResource DisableEffect}"/>
                                    <Setter TargetName="label" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Padding" Value="5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="SizeForm" Value="Large">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                            <Border CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}"  BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Opacity="{TemplateBinding Opacity}"  Name="OuterBorder" >
                                <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1">
                                    <Grid VerticalAlignment="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonButton}}}" HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonButton}}}">
                                        <StackPanel Orientation="Vertical">
                                            <Border Name="PART_ImageBorder" Margin="3" SnapsToDevicePixels="True">
                                                <Image x:Name="PART_Image" Width="32" Height="32" Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                            </Border>
                                            <ItemsControl Margin="0,3,0,2" Focusable="False" Foreground ="{TemplateBinding Foreground}"	FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" x:Name="PART_Label">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:MultilinePanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{Binding Path=Foreground,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"/>
                                                        <Setter Property="FontSize" Value="{Binding Path=FontSize,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"/>
                                                        <Setter Property="FontFamily" Value="{Binding Path=FontFamily,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"/>
                                                        <Setter Property="Effect" Value="{StaticResource TextBlockEffect}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsLargeImageVisible" Value="False">
                                    <Setter TargetName="PART_ImageBorder" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                                    <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
