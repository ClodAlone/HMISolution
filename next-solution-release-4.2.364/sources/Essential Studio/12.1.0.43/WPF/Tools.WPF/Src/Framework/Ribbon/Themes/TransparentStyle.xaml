    <Style TargetType="{x:Type local:RibbonMenuItem}" x:Key="TransparentRibbonMenuItemStyle">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonMenuItem}">
                    <Border  Name="Bd" Padding="{TemplateBinding Padding}">
                        <Grid Grid.ColumnSpan="3">
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" HorizontalAlignment="Left" Fill="{StaticResource ContextMenuPopupLeftBarBackground}"/>
                            <Border BorderThickness="{TemplateBinding BorderThickness}"  Background="{TemplateBinding Panel.Background}" Margin="1" Name="Border" SnapsToDevicePixels="True">
                                <Border x:Name="InnerBorder" BorderThickness="1" BorderBrush="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="17"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Name="IconBorder" Grid.Column="0" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ContentPresenter Margin="1" Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                        </Border>
                                        <Border Name="PART_CheckBorder" Background="{StaticResource TransparentThemeChkBoxBackground}" BorderBrush="{StaticResource TransparentThemeChkBoxBorderBrush}"  Grid.Column="0" BorderThickness="1" CornerRadius="0" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" Width="20" Height="20">
                                            <Path VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1,0,0,0" Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="{StaticResource TransparentThemeChkBoxPathFill}" x:Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight"/>
                                        </Border>
                                        <ContentPresenter ContentSource="Header" Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                            <ContentPresenter.Style>
                                                <Style>
                                                    <Style.Triggers>
                                                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                            <Setter Property="TextElement.FontSize" Value="18"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentPresenter.Style>
                                        </ContentPresenter>
                                        <ContentPresenter Content="{TemplateBinding InputGestureText}" VerticalAlignment="Center" Grid.Column="2"></ContentPresenter>
                                        <Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="3" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <Popup Name="PART_Popup" 
                               StaysOpen="False" 
                               PopupAnimation="Fade" 
                               MinWidth="10" 
                               MinHeight="10" 
                               HorizontalOffset="1" 
                               VerticalOffset="0" 
                               AllowsTransparency="true" 
                               Placement="Right" 
                               Focusable="false" 
                               IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Border Background="{StaticResource ComboBoxPopupBackground}" BorderBrush="{StaticResource ComboBoxPopupBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" HorizontalAlignment="Left" Fill="{StaticResource ContextMenuPopupLeftBarBackground}"/>
                                                    <ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                                        <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter TargetName="IconBorder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Border" Value="{StaticResource RibbonMenuItemHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource RibbonMenuItemHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" TargetName="Border" Value="{StaticResource RibbonMenuItemCheckedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource RibbonMenuItemCheckedBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="TextElement.FontSize" Value="18"/>
                            <Setter Property="Padding" Value="16,9,16,9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonMenuItemStyle}" TargetType="{x:Type local:RibbonMenuItem}"/>

    <SolidColorBrush x:Key="BackStageBackground" Color="White" />
    <!-- BackStage Style -->
    <Style  TargetType="{x:Type local:Backstage}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
            <Setter.Value >
                <ControlTemplate  TargetType="{x:Type local:Backstage}">
                    <Grid Background="{StaticResource BackStageBackground}" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="137" Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Column 2 -->
                        <Grid Height="Auto" Grid.Column="1" Margin="-1 0 0 0">
                            <Border Panel.ZIndex="1" HorizontalAlignment="Right" Margin="-100,0,0,0" Background="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}" Visibility="{Binding Path=BackStageCornerImageVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}" VerticalAlignment="Bottom" Width="343" Height="181"  BorderThickness="0" SnapsToDevicePixels="True">
                                <Image x:Name="image" FlowDirection="{Binding Path=FlowDirection, RelativeSource={RelativeSource TemplatedParent}}" Source="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/BackstageCorner.png" Stretch="None" Visibility="{Binding Path=BackStageCornerImageVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="343" Height="181" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Border>
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Grid.Column="1" ContentTemplate="{TemplateBinding ItemTemplate}" ContentSource="SelectedTabContent"/>
                            </Border>
                        </Grid>
                        <!-- Column 1 -->
                        <!--<Grid Margin="0" VerticalAlignment="Stretch" Background="{StaticResource BackStageLeftPaneBackground}">                           
                            <ItemsPresenter />
                            <Border BorderThickness="0,0,1,0" Margin="0" BorderBrush="#7F000000"/>
                        </Grid>-->
                        <Grid Margin="0" VerticalAlignment="Stretch" Background="{StaticResource BackStageLeftPaneBackground}">

                            <!--<Rectangle Fill="{StaticResource BackStageLeftPaneRadialBackground}"/>-->
                            <ItemsPresenter />
                            <Border BorderThickness="0,0,1,0" Margin="0,0,1,0" Panel.ZIndex="-9999" BorderBrush="#FFB0B0B0">
                                <Border.Effect>
                                    <DropShadowEffect Opacity="0.4" ShadowDepth="3"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <!-- Top Row -->
                        <Border Margin="0 -2 0 0" VerticalAlignment="Top" Height="2" Grid.ColumnSpan="3" >
                            <Rectangle StrokeThickness="0" Fill="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush EndPoint="1.002,0.556" StartPoint="-0.003,0.511">
                                        <GradientStop Color="Black"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BackStage Button Style -->
    <Style TargetType="{x:Type local:BackStageButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource RectBrush}"/>
        <Setter Property="Template" >
            <Setter.Value >
                <ControlTemplate TargetType="{x:Type local:BackStageButton}">
                    <Border Background="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="border2" MinWidth="56" Height="23" SnapsToDevicePixels="True"
                            CornerRadius="3,3,0,0" Margin="0,2,0,0">
                        <Grid>
                            <TextBlock x:Name="contentPresenter" Margin="0,5" TextBlock.Foreground="{TemplateBinding Foreground}" FontFamily="Calibri" Text="{TemplateBinding Header}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True">
                                        <!--<TextBlock.Effect>
                                            <DropShadowEffect Opacity="0.605" ShadowDepth="0" BlurRadius="4"/>
                                        </TextBlock.Effect>-->
                            </TextBlock>
                            <Border x:Name="border1" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" SnapsToDevicePixels="True">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#4B000000"/>
                                </Border.BorderBrush>
                                <Border x:Name="border" BorderThickness="1,1,1,0" CornerRadius="2,2,0,0" Opacity="0.79" SnapsToDevicePixels="True">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#72FFFFFF" Offset="0"/>
                                            <GradientStop Color="#1BFFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#5CFFFFFF"/>
                                            <GradientStop Color="#002866BF" Offset="0.49"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Rectangle Opacity="0.79" StrokeThickness="0" SnapsToDevicePixels="True" x:Name="rectangle">
                                            <Rectangle.Fill>
                                                <RadialGradientBrush Center="0.493,0.995" GradientOrigin="0.493,0.995" RadiusY="0.568" RadiusX="0.718">
                                                    <GradientStop Color="#9EFFFFFF"/>
                                                    <GradientStop Color="#002866BF" Offset="0.847"/>
                                                </RadialGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="border">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#61FFFFFF"/>
                                        <GradientStop Color="#002866BF" Offset="0.49"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" TargetName="border" Value="0.9"/>
                            <Setter Property="Opacity" TargetName="rectangle" Value="0.8"/>
                            <Setter Property="BorderBrush" TargetName="border">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Offset="0" Color="#7CFFFFFF"/>
                                        <GradientStop Offset="1" Color="#96FFFFFF"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Fill" TargetName="rectangle">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.473,0.962" GradientOrigin="0.473,0.962" RadiusY="0.746" RadiusX="1.063">
                                        <GradientStop Color="#AFFFFFFF"/>
                                        <GradientStop Color="#002866BF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" TargetName="border2" Value="0.5"/>

                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter Property="Margin" TargetName="border2" Value="0"/>
                            <Setter Property="Visibility" TargetName="rectangle" Value="Collapsed"/>
                            <Setter Property="Background" TargetName="border">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#43FFFFFF" Offset="1"/>
                                        <GradientStop Color="#3B000000" Offset="0.376"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderBrush" TargetName="border">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Offset="0"/>
                                        <GradientStop Color="#01FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsOpen" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="border">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#7BFFFFFF" Offset="1"/>
                                        <GradientStop Color="#00000000"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BackStage TabItem Style -->
    <Style  TargetType="{x:Type local:BackstageTabItem}">
        <Setter Property="Foreground" Value="{StaticResource BackStageTabItemForeground}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,2,0,1"/>
        <Setter Property="Template">
            <Setter.Value >
                <ControlTemplate   TargetType="{x:Type local:BackstageTabItem}">
                    <Grid x:Name="layoutRoot" Background="#00000000" >
                        <Border x:Name="hoverBorder" Visibility="Collapsed" Margin="0,0,1,0" Background="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderBrush="{x:Null}" BorderThickness="0">
                            <Border BorderBrush="#4C000000" BorderThickness="0,1" Background="#BFFFFFFF"/>
                        </Border>
                        <Border x:Name="selectedBorder" Background="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}" Visibility="Collapsed" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderBrush="#FF000463" BorderThickness="0">
                            <Grid HorizontalAlignment="Stretch"  Width="Auto">
                                <Border BorderBrush="#7F000000" BorderThickness="0,1">
                                    <Border.Background>
                                        <RadialGradientBrush RadiusY="1.193" Center="0.5,0.972" GradientOrigin="0.5,0.972" RadiusX="0.662">

                                            <GradientStop Color="#A5FFFFFF" Offset="0"/>
                                            <GradientStop Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Path Fill="White" Stretch="Fill" Stroke="White" StrokeThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="15" Height="27" Data="M1,0L0,1 1,2z" Margin="0,0,-1,0"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="controlLabel" HorizontalAlignment="Left"  Margin="19,0" VerticalAlignment="Center" 
                                          ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"
                                          ContentTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Backstage}}, Path=ItemTemplateSelector}"
                                         ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Backstage}}, Path=TabHeaderTemplate}"/>
                     
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" TargetName="hoverBorder" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" TargetName="hoverBorder" Value="Hidden"/>
                            <Setter Property="Opacity" TargetName="controlLabel" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" TargetName="selectedBorder" Value="Visible"/>
                            <Setter Property="TextElement.Foreground"  TargetName="controlLabel" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Backstage}}, Path=SelectedTabItemForeground}"/>
                            <!--<Setter Property="Margin" TargetName="selectedBorder" Value="0,0,-2,0"/>-->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BackStage CommandButton Style -->
    <Style TargetType="{x:Type local:BackStageCommandButton}">
        <Setter Property="Foreground" Value="{StaticResource BackStageCmdBtnForegroundBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="130"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BackStageCommandButton}">
                    <Grid Background="#00000000" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" >
                        <Border x:Name="border" Visibility="Collapsed" 
                                BorderBrush="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}" 
                                 
                                BorderThickness="0" Margin="1,2" CornerRadius="2" Background="{Binding Path=BackStageColor, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}">
                            <Border Margin="0" CornerRadius="2" BorderThickness="1" BorderBrush="#19000000" Background="#BFFFFFFF">
                                <Border BorderBrush="#7FFFFFFF" BorderThickness="1" CornerRadius="1" Background="#33FFFFFF"/>
                            </Border>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="16,0,15,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image x:Name="iconImage" Source="{TemplateBinding Icon}" HorizontalAlignment="Left" Height="16" VerticalAlignment="Center"  Width="16" SnapsToDevicePixels="True"/>
                            <TextBlock Text="{TemplateBinding Header}" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" x:Name="controlLabel"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers >
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" TargetName="border" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" TargetName="iconImage" Value="0.5"/>
                            <Setter Property="Opacity" TargetName="controlLabel" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon Minimize Button -->
    <Style TargetType="{x:Type local:RibbonToggleButton}" x:Key="MinimizeToggleButtonStyle">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Template" >
            <Setter.Value >
                <ControlTemplate TargetType="{x:Type local:RibbonToggleButton}">
                    <Border x:Name="border" BorderThickness="1" Background="Transparent"  BorderBrush="Transparent"  Height="22" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="22">
                        <Border x:Name="InnerBorder" BorderThickness="1" BorderBrush="Transparent">
                            <Image x:Name="iconImage" HorizontalAlignment="Center" Height="Auto" Stretch="None" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/RibbonHide.png" Width="Auto" Margin="2"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}},  Path=RibbonState}" Value="Normal">
                            <Setter Property="Source" TargetName="iconImage" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/RibbonHide.png"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}},  Path=RibbonState}" Value="Hide">
                            <Setter Property="Source" TargetName="iconImage" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/RibbonNormal.png"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}},  Path=RibbonState}" Value="Adorner">
                            <Setter Property="Source" TargetName="iconImage" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/RibbonHide.png"/>
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter Property="Background" TargetName="border" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsPressed" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="border" Value="{StaticResource RibbonButtonHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RibbonButtonHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                <Condition Property="IsPressed" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RibbonButtonPressedBorderBrush}"/>
                            <Setter Property="Background" TargetName="border" Value="{StaticResource RibbonButtonPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource RibbonButtonInnerBorderBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
	
	<!-- Ribbon ToggleButton Style  -->
	
	<SolidColorBrush x:Key="RibbonToggleButtonBackgroundBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="RibbonToggleButtonBorderBrush" Color="#7F000000"/>
    <SolidColorBrush x:Key="RibbonToggleButtonForeground" Color="Black"/>

    <LinearGradientBrush x:Key="RibbonToggleButtonHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RibbonToggleButtonPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF"/>
        <GradientStop Color="#7EFFFFFF" Offset="0.032"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.649"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RibbonToggleButtonCheckedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#A5FFFFFF" Offset="0.008"/>
        <GradientStop Color="#CFFFFFFF" Offset="0.487"/>
        <GradientStop Color="#72C2C2C2" Offset="0.531"/>
        <GradientStop Color="#A7FFFFFF" Offset="0.788"/>
        <GradientStop Color="#B2FFFFFF" Offset="1"/>
    </LinearGradientBrush>
      
    <SolidColorBrush x:Key="RibbonToggleButtonCheckedBorderBrush" Color="White" Opacity="0.6"/>
    <SolidColorBrush Color="#CCFFFFFF" x:Key="TransparentButtonInnerBorderBrush"/>

    <Style x:Key="TransparentRibbonToggleButtonStyle" TargetType="local:RibbonToggleButton">
        <Setter Property="Foreground" Value="{StaticResource RibbonToggleButtonForeground}" />
        <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
        <Setter Property="Label" Value="RibbonToggleButton"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource RibbonToggleButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonToggleButtonBorderBrush}"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonToggleButton">
                    <ControlTemplate.Triggers>                        
                        <Trigger Property="IsMouseOver" Value="true">                            
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonHoverBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonPressedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonCheckedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonCheckedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                            <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    <Grid>                        
                        <Border x:Name="ItemCheckedBorder" Opacity="0"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{StaticResource RibbonToggleButtonCheckedBackgroundBrush}" 
                                BorderBrush="{StaticResource RibbonToggleButtonCheckedBorderBrush}"/>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True">
                            <Border BorderThickness="{TemplateBinding BorderThickness}" x:Name="innerborder" BorderBrush="{StaticResource TransparentButtonInnerBorderBrush}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Name="PART_ImageBorder" Grid.Column="0">
                                        <Image Margin="2" x:Name="smallImage"
						            Width="{Binding Path=IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonToggleButton}}}" Height="{Binding Path=IconHeight,RelativeSource={RelativeSource AncestorType={x:Type local:RibbonToggleButton}}}"   
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <AccessText Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                           Margin="2,0,4,0">
                                        <AccessText.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                        </AccessText.Effect>
                                    </AccessText>
                                </Grid>
                            </Border>
                        </Border>
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True">
                            <Border BorderThickness="{TemplateBinding BorderThickness}" x:Name="innerborder1" BorderBrush="{StaticResource TransparentButtonInnerBorderBrush}">
                                <StackPanel Margin="{TemplateBinding Padding}">
                                    <Border Name="PART_ImageBorderLarge">
                                        <Image Margin="2" x:Name="LargeImage"
						            Width="26" Height="26"   
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <ItemsControl x:Name="PART_TextAreaLarge"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               Margin="2,0,4,0"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentRibbonToggleButtonStyle}" TargetType="local:RibbonToggleButton"/>

</ResourceDictionary>

    