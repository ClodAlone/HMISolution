<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Syncfusion.Windows.Tools"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">
    <Style TargetType="{x:Type local:RibbonColorPicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonColorPicker}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Name="Tpanel">
                            <Label Name="ThemeHeader" Margin="0,5,0,5" Padding="5,0,0,0" Content="Theme Colors" FontWeight="Bold">
                            <Label.Background>
                                <LinearGradientBrush StartPoint="0,0.95" EndPoint="0,1">
                                <GradientStop Color="#FFDCE6F0"/>
                                <GradientStop Color="Black"/>
                                </LinearGradientBrush>
                            </Label.Background>
                            <Label.Foreground>
                                <SolidColorBrush Color="MediumBlue"/>
                            </Label.Foreground>
                        </Label>
                            <Grid Name="ThemeGrid"/>
                            <Label Name="StdHeader" Margin="0,5,0,5" Padding="5,0,0,0" Content="Standard Colors" FontWeight="Bold">
                                <Label.Background>
                                    <LinearGradientBrush StartPoint="0,0.95" EndPoint="0,1">
                                        <GradientStop Color="#FFDCE6F0"/>
                                        <GradientStop Color="Black"/>
                                    </LinearGradientBrush>
                                </Label.Background>
                                <Label.Foreground>
                                    <SolidColorBrush Color="MediumBlue"/>
                                </Label.Foreground>
                            </Label>
                            <Grid Name="StdGrid"/>
                            <Label Name="RctHeader" Margin="0,5,0,5" Padding="5,0,0,0" Content="Recent Colors" FontWeight="Bold">
                                <Label.Background>
                                    <LinearGradientBrush StartPoint="0,0.95" EndPoint="0,1">
                                        <GradientStop Color="#FFDCE6F0"/>
                                        <GradientStop Color="Black"/>
                                    </LinearGradientBrush>
                                </Label.Background>
                                <Label.Foreground>
                                    <SolidColorBrush Color="MediumBlue"/>
                                </Label.Foreground>
                            </Label>
                            <Grid Name="RctGrid"/>
                            <Button Name="CPDlg" Margin="2" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                    Content="More Colors..."/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Hexagon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Hexagon}">
                    <!--<Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                    </Border>-->
                    <Canvas x:Name="Part_Panel"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- For Color Editor-->
    <Style x:Key="ToolTip_CustomStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush>
                    <SolidColorBrush.Color>
                        <Color A="200"  R="255" G="255" B="255"/>
                    </SolidColorBrush.Color>
                </SolidColorBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThumbVerticalStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Polygon Points="0,0 0,10 10,10 15,5 10,0" Stroke="Black" Fill="White"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider_CustomStyleVertical" TargetType="{x:Type Slider}">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="IsMoveToPointEnabled" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid ClipToBounds="false">
                        <Border Margin="5,4,5,4"  CornerRadius="3" Background="{TemplateBinding Background}"
                            BorderBrush="Black" BorderThickness="1"/>
                        <Track Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbVerticalStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <conv:xValueToStringConverter x:Key="FloatToString"></conv:xValueToStringConverter>
    <conv:xColorToStringConverter x:Key="ColorToString"></conv:xColorToStringConverter>
    <!--<conv:ColorToValueConverter x:Key="ColorToValue"></conv:ColorToValueConverter>-->
    <conv:xColorToBrushConverter x:Key="ColorToBrush"></conv:xColorToBrushConverter>
    <conv:xColorToWordKnownColorsConverter x:Key="ColorToWordKnownColors"></conv:xColorToWordKnownColorsConverter>
    <!--<conv:RGBToStringConverter x:Key="RGBToString"></conv:RGBToStringConverter>-->
    <conv:xRangedFloatToStringConverter x:Key="RangedFloatToString"></conv:xRangedFloatToStringConverter>
    <ControlTemplate TargetType="{x:Type local:xColorEdit}" x:Key="HSV">
        <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}">
            <Grid ClipToBounds="True" 
                    Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="30"/>
                    <!--<ColumnDefinition Width="120"/> -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Grid.RowSpan="1">
                    <Label.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000"  Offset="0.0" />
                            <GradientStop Color="#FFFFFF00"  Offset="0.16" />
                            <GradientStop Color="#FF00FF00"  Offset="0.33" />
                            <GradientStop Color="#FF00FFFF"  Offset="0.49" />
                            <GradientStop Color="#FF0000FF"  Offset="0.66" />
                            <GradientStop Color="#FFFF00FF"  Offset="0.82" />
                            <GradientStop Color="#FFFF0000"  Offset="0.99" />
                        </LinearGradientBrush>
                    </Label.Background>
                </Label>
                <Label Grid.Column="0" Grid.Row="0" Grid.RowSpan="1">
                    <Label.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#FF000000"  Offset="1.0"/>
                        </LinearGradientBrush>
                    </Label.Background>
                </Label>
                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="1" Name="ColorPalitte"
                            Background="Transparent"/>
                <!--Background="{syncfusion:HSVBackgroundBrush Background}">-->

                <Canvas Grid.Column="0" Grid.Row="0"  Grid.RowSpan="2" ClipToBounds="True">
                    <Ellipse
                    Canvas.Left="{Binding Path=SelectorPositionX,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:xColorEdit}}}"
                    Canvas.Top="{Binding Path=SelectorPositionY,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:xColorEdit}}}"
                    Stroke="White"  Width="10" Height="10">
                    </Ellipse>
                    <Popup Name="WordKnownColorsPopup" PlacementRectangle="0,0,0,0" AllowsTransparency="True" Visibility="Hidden"
                    HorizontalOffset="{Binding Path=WordKnownColorsPositionX,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:xColorEdit}}}"
                    VerticalOffset="{Binding Path=WordKnownColorsPositionY,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:xColorEdit}}}"
                    IsOpen="{Binding Path=IsKeyboardFocusWithin, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border CornerRadius="2" ClipToBounds="True" BorderThickness="1" BorderBrush="Black" Visibility="Hidden">
                            <Border.Background>
                                <SolidColorBrush>
                                    <SolidColorBrush.Color>
                                        <Color A="200"  R="255" G="255" B="255"/>
                                    </SolidColorBrush.Color>
                                </SolidColorBrush>
                            </Border.Background>
                            <TextBox Name="WordKnownColorsTextBox" IsReadOnly="True" BorderBrush="Transparent" Foreground="Black" Background="Transparent"
                        Text="{TemplateBinding Color, Converter={StaticResource ColorToWordKnownColors}}" BorderThickness="0" >
                            </TextBox>
                        </Border>
                    </Popup>
                </Canvas>
                <Slider Grid.Column="1"
                        Grid.RowSpan="1"
                        Margin="5,0,0,0"
                        Orientation="Vertical"
                        Grid.Row="0"
                        Minimum="0.001"
                        Maximum="{Binding Path=SliderMaxValueHSV, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource Slider_CustomStyleVertical}"
                        Value="{Binding Path=SliderValueHSV, RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{local:xHSVBackgroundBrush VerticalSlider}"/>
                <!--Background="{syncfusion:HSVBackgroundBrush VerticalSlider}"/>-->
                <TextBox Grid.Column="2" Name="PART_ColorStringEditor" Visibility="Hidden"
                         Grid.Row="1" 
                         Height="20" 
                         Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorToString}, RelativeSource={RelativeSource TemplatedParent}}" >
                </TextBox>
                <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="10" HorizontalAlignment="Center"  Margin="10,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Bottom" Height="21" HorizontalAlignment="Center">
					          Color Model:
                    </TextBlock>
                    <ComboBox Grid.Column="1" Grid.Row="1" Name="ColorModeListBox">
                        <ComboBoxItem IsSelected="True" Name="RGBMode">RGB
                        </ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Name="HSVMode">HSV
                        </ComboBoxItem>
                    </ComboBox>
                </Grid>
                <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!--<ColumnDefinition Width="29"/>-->
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="29" Name="HSVLabel" MaxWidth="0"/>
                        <ColumnDefinition Width="64" Name="HSVText" MaxWidth="0"/>
                        <ColumnDefinition Width="29" Name="RGBLabel"/>
                        <ColumnDefinition Width="64" Name="RGBText"/>
                        <!--<ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="29"/>-->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                    </Grid.RowDefinitions>
                    
                    
                    <RadioButton Grid.Column="0" Grid.Row="1" Foreground="{TemplateBinding Foreground}" Content="H" Name="ButtomH" IsChecked="True">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
                                <TextBlock>Hue.</TextBlock>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton Grid.Column="0" Grid.Row="2" Content="S" Foreground="{TemplateBinding Foreground}"  IsChecked="False"  Name="ButtomS">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
                                <TextBlock>Saturation.</TextBlock>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton Grid.Column="0" Grid.Row="3" Content="V" Foreground="{TemplateBinding Foreground}" x:Name="ButtomV" >
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
                                <TextBlock>Value/Brightness.</TextBlock>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" Height="21" HorizontalAlignment="Center">
					          H:
					          <TextBlock.ToolTip>
					            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
						          <TextBlock>Hue.</TextBlock>
					            </ToolTip>
					          </TextBlock.ToolTip>
				            </TextBlock>
                    <TextBlock Grid.Column="1" Grid.Row="2" VerticalAlignment="Bottom" Height="21" HorizontalAlignment="Center">
					          S:
					          <TextBlock.ToolTip>
					            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
						          <TextBlock>Saturation.</TextBlock>
					            </ToolTip>
					          </TextBlock.ToolTip>
				            </TextBlock>
                    <TextBlock Grid.Column="1" Grid.Row="3" VerticalAlignment="Bottom" Height="21" HorizontalAlignment="Center">
					          V:
					          <TextBlock.ToolTip>
					            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
						          <TextBlock>Value/Brightness.</TextBlock>
					            </ToolTip>
					          </TextBlock.ToolTip>
				            </TextBlock>
                    <Grid Grid.Column="2" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox  Name="Hval" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="1,1,1,1" Text="{Binding H,Mode=TwoWay, Converter={StaticResource FloatToString}, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Name="HUp" Grid.Column="1" Grid.Row="0" BorderBrush="Transparent">
                            <Polygon Points="0 2.5,2.5 0,5 2.5" Stroke="Black" Fill="Black"/>
                        </Button>
                        <Button Name="HDown" Grid.Column="1" Grid.Row="1" BorderBrush="Transparent">
                            <Polygon Points="0 0,2.5 2.5,5 0" Stroke="Black" Fill="Black"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox Name="Sval" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="1,1,1,1" Text="{Binding S,Mode=TwoWay, Converter={StaticResource FloatToString}, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Name="SUp" Grid.Column="1" Grid.Row="0" BorderBrush="Transparent">
                            <Polygon Points="0 2.5,2.5 0,5 2.5" Stroke="Black" Fill="Black"/>
                        </Button>
                        <Button Name="SDown" Grid.Column="1" Grid.Row="1" BorderBrush="Transparent">
                            <Polygon Points="0 0,2.5 2.5,5 0" Stroke="Black" Fill="Black"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox  Name="Vval" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="1,1,1,1" Text="{Binding V,Mode=TwoWay, Converter={StaticResource FloatToString}, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Name="VUp" Grid.Column="1" Grid.Row="0" BorderBrush="Transparent">
                            <Polygon Points="0 2.5,2.5 0,5 2.5" Stroke="Black" Fill="Black"/>
                        </Button>
                        <Button Name="VDown" Grid.Column="1" Grid.Row="1" BorderBrush="Transparent">
                            <Polygon Points="0 0,2.5 2.5,5 0" Stroke="Black" Fill="Black"/>
                        </Button>
                    </Grid>
                   
                    <TextBlock Visibility="Hidden" Grid.Column="3" Grid.Row="1" VerticalAlignment="Bottom" Height="21" HorizontalAlignment="Center">
					          A:
					          <TextBlock.ToolTip>
					            <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
						          <TextBlock>Alpha.</TextBlock>
					            </ToolTip>
					          </TextBlock.ToolTip>
				            </TextBlock>
                    <TextBlock Grid.Column="3" Grid.Row="1" HorizontalAlignment="Center">
						        R:
						        <TextBlock.ToolTip>
							        <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
								        <TextBlock>Red.</TextBlock>
							        </ToolTip>
						        </TextBlock.ToolTip>
					        </TextBlock>
                    <TextBlock Grid.Column="3" Grid.Row="2" HorizontalAlignment="Center">
						        G:
						        <TextBlock.ToolTip>
							        <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
								        <TextBlock>Green.</TextBlock>
							        </ToolTip>
						        </TextBlock.ToolTip>
					        </TextBlock>
                    <TextBlock Grid.Column="3" Grid.Row="3" HorizontalAlignment="Center">
						        B:
						        <TextBlock.ToolTip>
							        <ToolTip Style="{StaticResource ToolTip_CustomStyle}">
								        <TextBlock>Blue.</TextBlock>
							        </ToolTip>
						        </TextBlock.ToolTip>
					        </TextBlock>
                    <TextBox Visibility="Hidden" Grid.Column="3" Grid.Row="0" Name="AlphaVal" Text="{Binding A, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RangedFloatToString},UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" Height="21" />
                    
                    
                    <!--<TextBox Grid.Column="3" Grid.Row="0" Text="{Binding A, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RangedFloatToString}}" VerticalAlignment="Bottom" Height="21" />-->
                    <Grid Grid.Column="4" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!--<Border Background="Transparent" BorderBrush="Black" BorderThickness="1" Grid.ColumnSpan="10" Grid.RowSpan="10"></Border>-->
                        <TextBox Name="Rval" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="{Binding R,Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RangedFloatToString}}" />
                        <Button Name="RUp" Grid.Column="1" Grid.Row="0" BorderBrush="Transparent">
                            <Polygon Points="0 2.5,2.5 0,5 2.5" Stroke="Black" Fill="Black"/>
                        </Button>
                        <Button Name="RDown" Grid.Column="1" Grid.Row="1" BorderBrush="Transparent">
                            <Polygon Points="0 0,2.5 2.5,5 0" Stroke="Black" Fill="Black"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Column="4" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox Name="Gval" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="{Binding G,Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RangedFloatToString}}" />
                        <Button Name="GUp" Grid.Column="1" Grid.Row="0" BorderBrush="Transparent">
                            <Polygon Points="0 2.5,2.5 0,5 2.5" Stroke="Black" Fill="Black"/>
                        </Button>
                        <Button Name="GDown" Grid.Column="1" Grid.Row="1" BorderBrush="Transparent">
                            <Polygon Points="0 0,2.5 2.5,5 0" Stroke="Black" Fill="Black"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Column="4" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox Name="Bval" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="{Binding B,Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RangedFloatToString}}" />
                        <Button Name="BUp" Grid.Column="1" Grid.Row="0" BorderBrush="Transparent">
                            <Polygon Points="0 2.5,2.5 0,5 2.5" Stroke="Black" Fill="Black"/>
                        </Button>
                        <Button Name="BDown" Grid.Column="1" Grid.Row="1" BorderBrush="Transparent">
                            <Polygon Points="0 0,2.5 2.5,5 0" Stroke="Black" Fill="Black"/>
                        </Button>
                    </Grid>
                   
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>
    
    <!-- For Color Editor -->
    <Style TargetType="{x:Type local:ColorPickerDockPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPickerDockPanel}">
                    <DockPanel>
                        <TabControl DockPanel.Dock="Left" Margin="10" Name="tabcontrol1" >
                            <TabItem Header="Standard" Name="tab_HSV" IsSelected="True">
                                <local:Hexagon></local:Hexagon>
                            </TabItem>
                            <TabItem  Header="Custom" Name="tab_RGB"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel Name="asdf" Orientation="Vertical"  HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
                                    <!--<syncfusion:ColorEdit   Name="RGBColorPicker"  BorderBrush="#67FFFFFF"  BorderThickness="1"  VerticalAlignment="Center" HorizontalAlignment="Stretch" VisualizationStyle="RGB"/>-->
                                    <local:xColorEdit Background="White" Template="{StaticResource HSV}" Name="HSVColorPicker" BorderBrush="#67FFFFFF"  BorderThickness="1"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VisualizationStyle="HSV"  IsScRGBColor="True" IsEnabled="True" />
                                    <!--<Button Name="removeme" Height="100" Unloaded="ChangeMode">x</Button>-->
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <DockPanel  MaxWidth="100" MinWidth="100" DockPanel.Dock="Right" VerticalAlignment="Stretch">
                            <StackPanel DockPanel.Dock="Top"  Orientation="Vertical">
                                <Button Margin="5" Name="BtnOk">OK</Button>
                                <Button Margin="5" Name="BtnCancel">Cancel</Button>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Label HorizontalAlignment="Center">New</Label>
                                <Label Name="lblNew" BorderBrush="Black" BorderThickness="1,1,1,0" Background="Black" Height="30" Width="80"></Label>
                                <Label Name="lblCurrent" BorderBrush="Black" BorderThickness="1,0,1,1" Background="Black" Height="30" Width="80"></Label>
                                <Label HorizontalAlignment="Center">Current</Label>
                            </StackPanel>
                            <Label DockPanel.Dock="Bottom"></Label>

                        </DockPanel>
                        
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
