        <Setter Property="Foreground" Value="{StaticResource InactiveForeground.Orange}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MenuItemsPanelTemplate" Value="{Binding Path=DefaultMenuItemsPanelTemplate, RelativeSource={RelativeSource Self}}" />
<Setter Property="local:DocumentContainer.DocumentMDIHeaderStyle" Value="{StaticResource SyncOrangeDocumentHeaderStyle}"/>
