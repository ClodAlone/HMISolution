				Background="{TemplateBinding Background}"
				ClipToBounds="True">
                                <Grid>
                                    <local:TDILayoutPanel x:Name="PART_TabControl" />
                                    <local:VistaFlipSwitchPreviewControl Name="PART_VistaFlip" Visibility="Collapsed"
