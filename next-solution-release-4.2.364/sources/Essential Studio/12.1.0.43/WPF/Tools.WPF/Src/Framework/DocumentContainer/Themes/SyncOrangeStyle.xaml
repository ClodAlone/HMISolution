								VerticalScrollBarVisibility="{TemplateBinding IsEnabledScroll
									, Converter={StaticResource BoolToScrollBarVisibility}}">
                                    <local:MDILayoutPanel x:Name="PART_Layouter" ClipToBounds="True" />
                                </ScrollViewer>
