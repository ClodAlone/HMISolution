            BasedOn="{StaticResource HeaderClassicButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource HeaderButtonInactiveBorderBrush.Orange}"/>
        <Setter Property="Background" Value="{StaticResource HeaderThemedButtonInactiveBackground.Orange}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource HeaderButtonActiveBorderBrush.Orange}" />
                <Setter Property="Background" Value="{StaticResource HeaderThemedButtonActiveBackground.Orange}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource HeaderButtonHighlightBorderBrush.Orange}"/>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource HeaderThemedButtonActiveHighlightBackground.Orange}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="False" />
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource HeaderThemedButtonInactiveHighlightBackground.Orange}"/>
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource HeaderThemedButtonPressedBackground.Orange}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SyncOrangeDocumentHeaderStyle" TargetType="{x:Type local:DocumentHeader}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActiveHeaderBrush.Orange}"/>
        <Setter Property="Background" Value="{StaticResource ActiveHeaderBrush.Orange}"/>
        <Setter Property="Foreground" Value="{StaticResource ActiveForeground.Orange}"/>
        <Setter Property="Border.CornerRadius" Value="7,7,0,0"/>
        <Setter Property="CloseButtonStyle" Value="{StaticResource HeaderThemedCloseButtonStyle}"/>
        <Setter Property="MaximizeButtonStyle" Value="{StaticResource HeaderThemedButtonStyle}"/>
        <Setter Property="MinimizeButtonStyle" Value="{StaticResource HeaderThemedButtonStyle}"/>
        <Setter Property="RestoreButtonStyle" Value="{StaticResource HeaderThemedButtonStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DocumentHeader}">
                    <shared:Border3D Name="Border" 
                         Padding="{TemplateBinding Padding}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="{TemplateBinding Border.CornerRadius}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         Background="{TemplateBinding Background}"
						 >
                        <DockPanel LastChildFill="True" VerticalAlignment="{TemplateBinding VerticalAlignment}">
                            <Button Name="btnClose" DockPanel.Dock="Right" Margin="2,2,2,2"
                    Visibility="{local:ContainerButtonVisibility}"
                    Command="{x:Static local:DocumentContainer.HideDocumentCommand}"
                    CommandTarget="{local:FindWindow}"
                    Style="{TemplateBinding CloseButtonStyle}">
                                <Border Name="btnCloseBorder" Height="10" Width="10" SnapsToDevicePixels="True">
                                    <shared:DrawingHelper Name="btnCloseHelper" DrawingBrush="{StaticResource closeorange}" />
                                </Border>
                            </Button>
                            <Button Name="btnMaximize" DockPanel.Dock="Right" Margin="0,2,0,2"
                    Visibility="{local:ContainerButtonVisibility}"
                    Command="{x:Static local:DocumentContainer.MaximizeDocumentCommand}"
                    CommandTarget="{local:FindWindow}"
                    Style="{TemplateBinding MaximizeButtonStyle}">
                                <Border Name="btnMaximizeBorder" Height="10" Width="10" SnapsToDevicePixels="True">
                                    <shared:DrawingHelper Name="btnMaximizeHelper" DrawingBrush="{StaticResource maximizeorange}" />
                                </Border>
                            </Button>
                            <Button Name="btnRestore" DockPanel.Dock="Right" Margin="0,2,0,2"
						Visibility="Collapsed"
						Command="{x:Static local:DocumentContainer.RestoreDocumentCommand}"
						CommandTarget="{local:FindWindow}"
						Style="{TemplateBinding RestoreButtonStyle}" >
                                <Border Name="btnRestoreBorder" Height="10" Width="10" SnapsToDevicePixels="True">
                                    <shared:DrawingHelper Name="btnRestoreHelper" DrawingBrush="{StaticResource restoreorange}" />
                                </Border>
                            </Button>
                            <Button Name="btnMinimize" DockPanel.Dock="Right" Margin="2,2,0,2"
                    Visibility="{local:ContainerButtonVisibility}"
                    Command="{x:Static local:DocumentContainer.MinimizeDocumentCommand}"
                    CommandTarget="{local:FindWindow}"
                    Style="{TemplateBinding MinimizeButtonStyle}">
                                <Border Name="btnMinimizeBorder" Height="10" Width="10" SnapsToDevicePixels="True">
                                    <shared:DrawingHelper Name="btnMinimizeHelper" DrawingBrush="{StaticResource minimizeorange}" />
                                </Border>
                            </Button>
                            <Border Name="IconBorder"  Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"
							           DockPanel.Dock="Left" Background="{TemplateBinding Icon}" Margin="1" />
                             <ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header), RelativeSource={RelativeSource AncestorType={x:Type local:DocumentContainer}}}" Name="content"
							  ContentTemplate="{Binding Path=(local:DocumentContainer.HeaderTemplate), RelativeSource={RelativeSource AncestorType={x:Type local:DocumentContainer}}}"
							  VerticalAlignment="Center"
							  TextBlock.Foreground="{TemplateBinding Foreground}"
							  ContentTemplateSelector="{StaticResource DocumentHeaderTrimmingTemplate}"
									  />
                        </DockPanel>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="False">
                            <Setter Property="Background" Value="{StaticResource InactiveHeaderBrush.Orange}"/>
                            <Setter Property="Foreground" Value="{StaticResource InactiveForeground.Orange}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource InactiveHeaderBrush.Orange}"/>
                            <Setter Property="Style" TargetName="btnClose" Value="{StaticResource HeaderThemedCloseButtonStyle}"/>
                            <Setter Property="Style" TargetName="btnMaximize" Value="{StaticResource HeaderThemedButtonStyle}"/>
                            <Setter Property="Style" TargetName="btnMinimize" Value="{StaticResource HeaderThemedButtonStyle}"/>
                            <Setter Property="Style" TargetName="btnRestore" Value="{StaticResource HeaderThemedButtonStyle}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=IconBorder, Path=(local:DocumentContainer.Icon)}" Value="{x:Null}">
                            <Setter TargetName="IconBorder" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Content.(local:DocumentContainer.MDIWindowState),
					 RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type local:MDIWindow}}}" Value="Minimized" >
                            <Setter TargetName="btnMinimize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="btnRestore" Property="Visibility" Value="{local:ContainerButtonVisibility}" />
                            <Setter	TargetName="btnMinimizeHelper" Property="Margin" Value="0, 1, 0, 0" />
                            <Setter	TargetName="btnMaximizeHelper" Property="Margin" Value="0, 1, 0, 0" />
                            <Setter	TargetName="btnRestoreHelper" Property="Margin" Value="0, 1, 0, 0" />
                            <Setter	TargetName="btnCloseHelper" Property="Margin" Value="0, 1, 0, 0" />
                        </DataTrigger>

                        <!--btnMinimize-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                                <Condition Binding="{Binding Path=IsEnabled, ElementName=btnMinimize}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="btnMinimizeHelper" Property="DrawingBrush" Value="{StaticResource minimizeorange}"/>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="btnMinimize" Property="IsEnabled" Value="True"/>
                                <Condition SourceName="btnMinimize" Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="btnMinimizeHelper" Property="DrawingBrush" Value="{StaticResource minimizeorange}"/>
                        </MultiTrigger>
                        <Trigger SourceName="btnMinimize" Property="IsEnabled" Value="False">
                            <Setter TargetName="btnMinimizeHelper" Property="DrawingBrush" Value="{StaticResource Desableminimizeorange}"/>
                        </Trigger>

                        <!--btnMaximize-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                                <Condition Binding="{Binding Path=IsEnabled, ElementName=btnMaximize}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="btnMaximizeHelper" Property="DrawingBrush" Value="{StaticResource maximizeorange}"/>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="btnMaximize" Property="IsEnabled" Value="True"/>
                                <Condition SourceName="btnMaximize" Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="btnMaximizeHelper" Property="DrawingBrush" Value="{StaticResource maximizeorange}"/>
                        </MultiTrigger>
                        <Trigger SourceName="btnMaximize" Property="IsEnabled" Value="False">
                            <Setter TargetName="btnMaximizeHelper" Property="DrawingBrush" Value="{StaticResource Desablemaximizeorange}"/>
                        </Trigger>
                        <!--btnRestore-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                                <Condition Binding="{Binding Path=IsEnabled, ElementName=btnRestore}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="btnRestoreHelper" Property="DrawingBrush" Value="{StaticResource restoreorange}"/>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="btnRestore" Property="IsEnabled" Value="True"/>
                                <Condition SourceName="btnRestore" Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="btnRestoreHelper" Property="DrawingBrush" Value="{StaticResource restoreorange}"/>
                        </MultiTrigger>
                        <Trigger SourceName="btnRestore" Property="IsEnabled" Value="False">
                            <Setter TargetName="btnRestoreHelper" Property="DrawingBrush" Value="{StaticResource Desablerestoreorange}"/>
                        </Trigger>
                        <!--btnClose-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                                <Condition Binding="{Binding Path=IsEnabled, ElementName=btnClose}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="btnCloseHelper" Property="DrawingBrush" Value="{StaticResource closeorange}"/>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="btnClose" Property="IsEnabled" Value="True"/>
                                <Condition SourceName="btnClose" Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="btnCloseHelper" Property="DrawingBrush" Value="{StaticResource closeorange}"/>
                        </MultiTrigger>
                        <Trigger SourceName="btnClose" Property="IsEnabled" Value="False">
                            <Setter TargetName="btnCloseHelper" Property="DrawingBrush" Value="{StaticResource Desablecloseorange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Icon" Value="{Binding Path=(local:DocumentContainer.Icon)}"/>
        <Setter Property="Header" Value="{Binding Path=(local:DocumentContainer.Header)}"/>
        <Setter Property="HeaderTemplate" Value="{Binding Path=(local:MDIWindow.Content).(local:DocumentContainer.HeaderTemplate), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}"/>
    </Style>

