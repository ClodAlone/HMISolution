        <Setter Property="Template" Value="{StaticResource WindowMovingClassicAdorner}"/>
    </Style>-->


    <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource ActiveForeground.Orange}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}" >
                    <Border SnapsToDevicePixels="True"
                Background="{StaticResource  MenuItemRightBarBrush.Orange}" >
                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="MenuItemIconColumnGroup" Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Border Name="iconBorder"
                        BorderThickness="0, 0, 1, 0"
                        Grid.Column="0"
                        SnapsToDevicePixels="True"
                        BorderBrush="{StaticResource MenuSeparatorBrush.Orange}"
                        Background="{StaticResource MenuItemLeftBarBrush.Orange}" />
                            <Border Name="backBorder"
                        CornerRadius="0"
                        BorderThickness="1"
                        Margin="2, 0, 2, 0"
                        SnapsToDevicePixels="True"
                        Grid.ColumnSpan="4"
                        BorderBrush="{StaticResource MenuItemInactiveBorderBrush.Orange}"
                        Background="Transparent" />
                            <ContentPresenter ContentSource="Icon"
                                  Name="Icon"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0, 2, 0, 0"
                                  Content="{TemplateBinding MenuItem.Icon}" />
                            <Border Name="GlyphBorder"
                        Grid.Column="0"
                        Visibility="Hidden"
                        HorizontalAlignment="Left"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Width="20"
                        Background="{StaticResource MenuItemCheckedBrush.Orange}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource MenuBorderBrush.Orange}"
                        Height="20">
                                <Path Stretch="Fill"
                          Stroke="{StaticResource MenuItemCheckedForeground.Orange}"
                          HorizontalAlignment="Center"
                          Margin="0"
                          VerticalAlignment="Center"
                          Width="7.5"
                          Height="5.875"
                          Data="M5.375,11.125 L7.75,13.25 11.875,8.375"/>
                            </Border>
                            <ContentPresenter ContentSource="Header"
                                  Grid.Column="1"
                                  Margin="4, 2, 4, 2"
                                  Name="Header"
                                  TextBlock.Foreground="{StaticResource MenuItemInactiveForeground.Orange}" />
                            <TextBlock Name="IGT" Margin="5,2,0,2"
                           Text="{TemplateBinding MenuItem.InputGestureText}"
                           Grid.Column="2" DockPanel.Dock="Right"
						   Foreground="{StaticResource MenuItemInactiveForeground.Orange}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="MenuItem.IsHighlighted" Value="True">
                            <Setter TargetName="iconBorder" Property="Background" Value="{StaticResource  MenuItemRightBarBrush.Orange}"/>
                            <Setter TargetName="backBorder" Property="BorderBrush" Value="{StaticResource MenuBorderBrush.Orange}"/>
                            <Setter TargetName="backBorder" Property="Background" Value="{StaticResource MenuItemHoverBrush.Orange}"/>
                            <Setter TargetName="Header" Property="TextBlock.Foreground" Value="{StaticResource MenuItemActiveForeground.Orange}" />
                            <Setter TargetName="IGT" Property="TextBlock.Foreground" Value="{StaticResource MenuItemActiveForeground.Orange}" />
                            <Setter TargetName="GlyphBorder" Property="Background" Value="{StaticResource MenuItemCheckedBrush.Orange}"/>
                            <Setter TargetName="GlyphBorder" Property="BorderBrush" Value="{StaticResource MenuItemGlyphBorderMouseOver.Orange}"/>
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter TargetName="GlyphBorder" Property="UIElement.Visibility" Value="{x:Static Visibility.Visible}"/>
                            <Setter TargetName="Icon" Property="UIElement.Visibility" Value="{x:Static Visibility.Collapsed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!--<Setter TargetName="Header" Property="TextBlock.Foreground" Value="Gray" />
				<Setter TargetName="IGT" Property="TextBlock.Foreground" Value="Gray" />-->
                            <Setter TargetName="Header" Property="Opacity" Value="0.5" />
                            <Setter TargetName="IGT" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="TDISeparatorTemplate" TargetType="{x:Type Separator}" >
        <Border
            Margin="0, -2, 0, -2"
            SnapsToDevicePixels="True"
            Background="{StaticResource  MenuItemRightBarBrush.Orange}">
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Name="iconBorder"
                        BorderThickness="0, 0, 1, 0"
                        Grid.Column="0"
                        SnapsToDevicePixels="True" />
                <Border Name="lineBorder"
                        BorderThickness="0.5"
                        Grid.Column="1"
                        Height="1"
                        Margin="3, 2, 2, 2"
                        SnapsToDevicePixels="True"
                        BorderBrush="{StaticResource MenuSeparatorBrush.Orange}" />
            </Grid>
        </Border>
    </ControlTemplate>
	
	
 
    <Style x:Key="SeparatorStyle" TargetType="{x:Type Separator}" >
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Background" Value="{StaticResource  MenuItemRightBarBrush.Orange}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}" >
                     <Border SnapsToDevicePixels="True" Margin="0,-2,0,-2" Background="Transparent">
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Name="iconBorder" BorderThickness="0, 0, 1, 0"
                        Grid.Column="0" SnapsToDevicePixels="True"
                        BorderBrush="{StaticResource MenuSeparatorBrush.Orange}"
                        Background="{StaticResource MenuItemLeftBarBrush.Orange}" />

                <Border Margin="4,2,2,2" Grid.Column="1" Height="1" Background="{StaticResource MenuSeparatorBrush.Orange}"/>
            </Grid>
        </Border>       
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>



    <Style  TargetType="{x:Type local:DocumentContextMenu}">
        <Setter Property="CustomItemStyle" Value="{StaticResource MenuItemStyle}" />
        <Setter Property="CustomSeparatorStyle" Value="{StaticResource SeparatorStyle}" />
        <Setter Property="Background" Value="{StaticResource  MenuItemRightBarBrush.Orange}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DocumentContextMenu}">
                    <Border BorderThickness="1" BorderBrush="{StaticResource MenuBorderBrush.Orange}"
				Background="{TemplateBinding Background}" >
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <ControlTemplate x:Key="ListBoxTemplate" TargetType="{x:Type ListBox}" >
        <Border SnapsToDevicePixels="True" Name="bd" Padding="1,1,1,1" 
                BorderBrush="FF6B2603" 
                BorderThickness="1">
            <ScrollViewer Padding="{TemplateBinding Control.Padding}" Focusable="False" >
                <DockPanel LastChildFill="True" >
                    <Border BorderThickness="1" Name="border" BorderBrush="FF6B2603" DockPanel.Dock="Right">
                        <local:TrackContainer VerticalAlignment="Center">
                            <shared:PreviewBorder Name="PART_PreviewBorder"
											  BorderBrush="#FF6B2603" BorderThickness="1"
											  Width="75" Height="75" />
                        </local:TrackContainer>
                    </Border>
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </DockPanel>
            </ScrollViewer>
        </Border>       
    </ControlTemplate>

    <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="Background" Value="#00ffffff" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type ListBoxItem}">
                    <Border Name="WrappBorder" Padding="2" SnapsToDevicePixels="True"
				BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				Background="#00FFFFFF"
				Margin="2"
				>
                        <StackPanel Orientation="Horizontal" >
                            <Border Name="IconBorder" Background="{Binding Path=(local:DocumentContainer.Icon), Converter={StaticResource TestConverter}}" Margin="1" Width="16"/>
                            <ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header)}" Name="content"
								  ContentTemplate="{Binding Path=(FrameworkElement.DataContext).(local:DocumentContainer.HeaderTemplate)
										, ElementName=WrappBorder}"
								  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="WrappBorder" Property="BorderBrush" Value="#FFF3B766" />
                            <Setter TargetName="WrappBorder" Property="Background" Value="#FF5F1A11" />
                            <Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="1"/>
                            <Setter TargetName="content" Property="TextBlock.Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                       
                       
                       

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="WrappBorder" Property="BorderBrush"
						Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
                            <Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}
							}"/>
                            <!--, diagnostics:PresentationTraceSources.TraceLevel=High-->
                            <Setter TargetName="WrappBorder" Property="Background"
						Value="{Binding Path=SelectedItemBackground, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SyncOrangeListSwicthPreviewControlStyle" TargetType="{x:Type local:ListSwicthPreviewControl}" >
        <Setter Property="BorderBrush" Value="{StaticResource MenuItemInactiveBorderBrush.Orange}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{StaticResource  MenuItemRightBarBrush.Orange}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ItemBorderBrush" Value="#00FFFFFF" />
        <Setter Property="ItemBorderThickness" Value="1" />
        <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrush.Orange}" />
        <Setter Property="SelectedItemBorderThickness" Value="1" />
        <Setter Property="SelectedItemBackground" Value="{StaticResource MenuItemHoverBrush.Orange}" />
        <Setter Property="ItemCornerRadius" Value="0" />
        <Setter Property="ItemWidth" Value="0" />
        <Setter Property="ItemHeight" Value="0" />
        <Setter Property="MinWidth" Value="550" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ListSwicthPreviewControl}" >
                    <Border Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
			>
                        <ListBox Name="PART_ListBox"
					Template="{StaticResource ListBoxTemplate}"
					ItemContainerStyle="{StaticResource ListBoxItemStyle}"
				/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource MenuItemBackground.Orange}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuItemBorder.Orange}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource MenuItemOverBackground.Orange}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource SyncOrangeListSwicthPreviewControlStyle}" TargetType="{x:Type local:ListSwicthPreviewControl}" />

    <Style x:Key="{x:Type local:CornerPanel}" TargetType="{x:Type local:CornerPanel}" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CornerPanel}">
                    <StackPanel Orientation="Horizontal" >
                        <Button Name="btnMinimize" DockPanel.Dock="Right" Margin="2,2,0,2"
					Command="{x:Static local:DocumentContainer.MinimizeDocumentCommand}"
					CommandTarget="{local:FindWindow}"
					>
                            <Border Name="btnMinimizeBorder" Height="10" Width="10" SnapsToDevicePixels="True"
						Background="{StaticResource brushMinimizeButtonBlack}"
						/>
                        </Button>
                        <Button Name="btnRestore" DockPanel.Dock="Right" Margin="0,2,0,2"
					Command="{x:Static local:DocumentContainer.RestoreDocumentCommand}"
					CommandTarget="{local:FindWindow}"
					>
                            <Border Name="btnRestoreBorder" Height="10" Width="10" SnapsToDevicePixels="True"
						Background="{StaticResource brushRestoreButtonBlack}"
						/>
                        </Button>
                        <Button Name="btnClose" DockPanel.Dock="Right" Margin="2,2,2,2"
					Command="{x:Static local:DocumentContainer.HideDocumentCommand}"
					CommandTarget="{local:FindWindow}"
					>
                            <Border Name="btnCloseBorder" Height="10" Width="10" SnapsToDevicePixels="True"
						Background="{StaticResource brushCloseButtonBlack}" />
                        </Button>
                    </StackPanel>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <!--Style CutawayAdorner-->
    <Style x:Key="{x:Type local:CutawayAdorner}" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border BorderBrush="Black" BorderThickness="0.5" Background="DarkGray"
							CornerRadius="5" MinWidth="150"
							>
                        <TextBlock Name="PART_TextCutAway"
							Text="RredCat" Margin="5"
								   Foreground="WhiteSmoke"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   FontStyle="Italic"
								   />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SyncOrangeDocMenuItemStyle" TargetType="{x:Type local:DocMenuItem}" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:DocMenuItem}" >
                    <Border SnapsToDevicePixels="True"
                Background="Transparent" >
                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="MenuItemIconColumnGroup" Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Border Name="iconBorder"
                        BorderThickness="0, 0, 1, 0"
                        Grid.Column="0"
                        SnapsToDevicePixels="True"
                        BorderBrush="{StaticResource MenuSeparatorBrush.Orange}"
                        Background="{StaticResource MenuItemLeftBarBrush.Orange}" />
                            <Border Name="backBorder"
                        CornerRadius="0"
                        BorderThickness="1"
                        Margin="2, 0, 2, 0"
                        SnapsToDevicePixels="True"
                        Grid.ColumnSpan="4"
                        BorderBrush="Transparent" 
                        Background="Transparent" />
                            <Border Name="Icon" Height="10" Width="10" SnapsToDevicePixels="True" 
						VerticalAlignment="Center" HorizontalAlignment="Center"
						Margin="0, 2, 0, 0"
						>
                                <shared:DrawingHelper Name="mnuHelper" DrawingBrush="{TemplateBinding IconBrush}" />
                            </Border>
                            <Border Name="GlyphBorder"
                        Grid.Column="0"
                        Visibility="Hidden"
                        HorizontalAlignment="Left"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Width="20"
                        Background="{StaticResource MenuItemCheckedBrush.Orange}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource MenuBorderBrush.Orange}"
                        Height="20">
                                <Path Stretch="Fill"
                          Stroke="{StaticResource MenuItemCheckedForeground.Orange}"
                          HorizontalAlignment="Center"
                          Margin="0"
                          VerticalAlignment="Center"
                          Width="7.5"
                          Height="5.875"
                          Data="M5.375,11.125 L7.75,13.25 11.875,8.375"/>
                            </Border>
                            <ContentPresenter ContentSource="Header"
                                  Grid.Column="1"
                                  Margin="6, 2, 4, 2"
                                  Name="Header"
                                  TextBlock.Foreground="{StaticResource MenuItemInactiveForeground.Orange}" />
                            <TextBlock Name="IGT" Margin="5,2,0,2"
                           Text="{TemplateBinding MenuItem.InputGestureText}"
                           Grid.Column="2" DockPanel.Dock="Right"
						   Foreground="{StaticResource MenuItemInactiveForeground.Orange}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="iconBorder" Property="Background" Value="{StaticResource  MenuItemRightBarBrush.Orange}"/>
                            <Setter TargetName="backBorder" Property="BorderBrush" Value="{StaticResource MenuBorderBrush.Orange}"/>
                            <Setter TargetName="backBorder" Property="Background" Value="{StaticResource MenuItemHoverBrush.Orange}"/>
                            <Setter TargetName="Header" Property="TextBlock.Foreground" Value="{StaticResource MenuItemActiveForeground.Orange}" />
                            <Setter TargetName="IGT" Property="TextBlock.Foreground" Value="{StaticResource MenuItemActiveForeground.Orange}" />
                            <Setter TargetName="GlyphBorder" Property="Background" Value="{StaticResource MenuItemCheckedBrush.Orange}"/>
                            <Setter TargetName="GlyphBorder" Property="BorderBrush" Value="{StaticResource MenuItemGlyphBorderMouseOver.Orange}"/>
                            <Setter TargetName="mnuHelper" Property="DrawingBrush"
						Value="{Binding Path=ActiveIconBrush
						, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type local:DocMenuItem}}}"/>
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter TargetName="GlyphBorder" Property="UIElement.Visibility" Value="{x:Static Visibility.Visible}"/>
                            <Setter TargetName="Icon" Property="UIElement.Visibility" Value="{x:Static Visibility.Collapsed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Header" Property="Opacity" Value="0.5" />
                            <Setter TargetName="IGT" Property="Opacity" Value="0.5" />
                            <Setter TargetName="mnuHelper" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SyncOrangeDocMenuItemStyle}" TargetType="{x:Type local:DocMenuItem}" />

</ResourceDictionary>