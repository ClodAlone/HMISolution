                <Setter TargetName="PART_Label" Property="FontWeight" Value="Normal"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:SimpleMenuButton}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="Template" Value="{StaticResource Office2007BlueSimpleMenuButtonTemplate}">
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource Office2007BlackSimpleMenuButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource Office2007SilverSimpleMenuButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource Office2003SimpleMenuButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource BlendSimpleMenuButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource SimpleMenuButtonTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource SimpleMenuButtonTemplate.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>