    <ControlTemplate x:Key="Office2013CloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <utilsOuter:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Office2013.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource ButtonPathBrushKey}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
        </utilsOuter:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Stroke" TargetName="pathButton" Value="{StaticResource Office2013ForegroundBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Office2013CloseButtonTemplate1" TargetType="{x:Type ButtonBase}">
        <utilsOuter:Border3D x:Name="brdBack" BorderThickness="1" SnapsToDevicePixels="True" 
                BorderBrush="{StaticResource Office2013.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource ButtonPathBrushKey}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
        </utilsOuter:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Stroke" TargetName="pathButton" Value="{StaticResource Office2013HighlightedForegroundBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Office2013MenuButtonTemplate" TargetType="{x:Type ButtonBase}">
        <utilsOuter:Border3D x:Name="brdBack" BorderThickness="0" Background="Transparent">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Fill="{StaticResource Office2013ForegroundBrush}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                <LineSegment Point="8,1"/>
                                <LineSegment Point="8,3"/>
                                <LineSegment Point="0,3"/>
                            </PathFigure>
                        </PathGeometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                <LineSegment Point="4,8"/>
                                <LineSegment Point="8,4"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </utilsOuter:Border3D>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L4,8 L8,4 z"/>
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2013HoverBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

