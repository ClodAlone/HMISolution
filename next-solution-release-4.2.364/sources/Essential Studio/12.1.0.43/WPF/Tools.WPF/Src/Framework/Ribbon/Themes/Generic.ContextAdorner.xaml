<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <local:ColorToTransparentBrushConverter x:Key="colorToTransparentBrushConverter"/>

    <Style x:Key="{x:Type local:ContextAdorner}" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" 
                Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ContextAdorner}},
                                Path=ContextTabGroup.Visibility}"/>
        <Setter Property="Background" 
                Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ContextAdorner}},
                                Converter={StaticResource colorToTransparentBrushConverter},                                
                                Path=ContextTabGroup.BackColor}"/>
        <Setter Property="Height" Value="57"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}" />
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.4" Color="#E081ADA3" />
                        <GradientStop Offset="0.6" Color="#E081ADA3" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <Border Width="{TemplateBinding Width}" 
                            Height="{TemplateBinding Height}"
                  		    BorderThickness="1,0,1,0" 
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <Border CornerRadius="1" 
                                BorderThickness="0,0,0,1" 
                                BorderBrush="#B9BC66" 
                                Height="31" 
                                VerticalAlignment="Top"
                    		    Background="{TemplateBinding Background}">
                            <TextBlock x:Name="PART_Label"
		                               Margin="8,10,3,0"
		                               FontSize="11" 
		                               Foreground="{TemplateBinding Foreground}" 
		                               HorizontalAlignment="Left"                          
		                               TextAlignment="Center"
		                               Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ContextAdorner}}, 
                                                      Path=ContextTabGroup.Label}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                                     Value="True">
                            <Setter TargetName="PART_Label" Property="FontSize" Value="11.5"/>
                            <Setter TargetName="PART_Label" Property="Foreground" Value="#FF000000"/>
                            <Setter TargetName="PART_Label" Property="FontFamily" Value="Segoe UI"/>
                        </DataTrigger>
                        
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Normal" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Label" Property="BitmapEffect">
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="#FFFFFFFF" GlowSize="10" Opacity="1"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Label" Property="Foreground" Value="#FFFFFFFF" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Foreground" Value="{StaticResource Silver.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}" />           
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>