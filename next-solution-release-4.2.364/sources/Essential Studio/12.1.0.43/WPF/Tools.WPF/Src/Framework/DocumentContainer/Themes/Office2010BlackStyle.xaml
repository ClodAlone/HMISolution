                        </MultiTrigger>
                        <Trigger SourceName="btnRestore" Property="IsEnabled" Value="False">
                            <Setter TargetName="btnRestoreHelper" Property="DrawingBrush" Value="{StaticResource brushRestoreButtonGray}"/>
