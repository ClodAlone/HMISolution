    <Style TargetType="{x:Type local:RibbonTextBox}">
    <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
    <Setter Property="Background" Value="{StaticResource Blue.TextBoxBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Blue.CheckBox.BorderBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="2"/>        
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="AllowDrop" Value="true"/>
    <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.Office2007Blue}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Blue.TextBoxBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Black.CheckBox.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.Office2007Black}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Blue.TextBoxBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver.CheckBox.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Silver.Foreground}"/>
                <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.TextBoxBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.CheckBoxBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.TextBoxBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.CheckBoxBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
                <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource RibbonTextBoxTemplate.ShinyBlue}"/>
            </Trigger>
           
        </Style.Triggers>

    </Style>
