                                    <ToggleButton  x:Name="Restorebutton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource N_RestoreButton}" Margin="0,4,2,0" Padding="0" Command="Syncfusion:NativeFloatWindow.RestoreCommand"/>
                                    <ToggleButton  x:Name="m_button" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource N_MaximizeKeyStyle}" Margin="0,4,2,0" Padding="0" Command="Syncfusion:NativeFloatWindow.MaximizeCommand"/>
