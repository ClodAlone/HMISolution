<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Converters.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ContentControl x:Key="Path">
        <ContentControl.Style>
            <Style>
                <Setter Property="Control.Focusable" Value="False"/>
                <Setter Property="Control.OverridesDefaultStyle"  Value="True"/>
                <Setter Property="Control.HorizontalAlignment" Value="Center"/>
                <Setter Property="Control.VerticalAlignment" Value="Top"/>
                <Setter Property="Control.Height" Value="14"/>
                <Setter Property="Control.FontSize" Value="11.5"/>
                <Setter Property="Control.Margin" Value="0,-1,0,0"/>
                <Setter Property="Control.FontFamily" Value="Segoe UI"/>
                <Setter Property="Control.Foreground" Value="{StaticResource Blue.Foreground}"/>
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border>
                                <Path Data="{StaticResource Default.PathData}" Name="path" Margin="0,4,0,0" Stroke="{StaticResource Blend.PathFill1}" StrokeThickness="2" HorizontalAlignment="Center" Fill="{StaticResource Blue.Path.Fill}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                                    <Setter Property="Data" TargetName="path" Value="{StaticResource Default.PathData}"/>
                                    <Setter Property="Fill" TargetName="path" Value="{StaticResource Black.Path.Fill}"/>
                                    <Setter Property="Stroke" TargetName="path" Value="{StaticResource Blend.PathFill1}"/>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                                    <Setter Property="Data" TargetName="path" Value="{StaticResource Default.PathData}"/>
                                    <Setter Property="Fill" TargetName="path" Value="{StaticResource Silver.Path.Fill}"/>
                                    <Setter Property="Stroke" TargetName="path" Value="{StaticResource Blend.PathFill1}"/>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                                    <Setter Property="Data" TargetName="path" Value="{StaticResource Default.PathData}"/>
                                    <Setter Property="Fill" TargetName="path" Value="{StaticResource Silver.Path.Fill}"/>
                                    <Setter Property="Stroke" TargetName="path" Value="{StaticResource Blend.PathFill1}"/>
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                                    <Setter Property="Data" TargetName="path" Value="{StaticResource Blend.PathData}"/>
                                    <Setter Property="Fill" TargetName="path" Value="{StaticResource Blend.PathFill1}"/>
                                    <Setter Property="Stroke" TargetName="path" Value="{StaticResource Blend.PathFill}"/>
                                </Trigger>
                                
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                        <Setter Property="Control.Foreground" Value="{StaticResource Black.Foreground}"/>
                    </Trigger>
                    <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                        <Setter Property="Control.Foreground" Value="{StaticResource Silver.Foreground}"/>
                    </Trigger>
                    <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                        <Setter Property="Control.Foreground" Value="{StaticResource Blue.Foreground}"/>
                    </Trigger>
                    <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                        <Setter Property="Control.Foreground" Value="{StaticResource Blend.Foreground2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <ContentControl x:Key="Path.ShinyRed">
        <ContentControl.Style>
            <Style>
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border>
                                <Path HorizontalAlignment="Center" x:Name="Arrow" VerticalAlignment="Center" Fill="#FFFFFFFF" Data="M 0 0 L 4 4 L 8 0 Z" Margin="-2,2,0,0"/>

                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ContentControl.Style>
    </ContentControl>







    <!--Simple ExtraSmall Template-->
    <ControlTemplate x:Key="DDExtraSmallTemplate.Office2007Blue" TargetType="{x:Type local:DropDownButton}">
        <Border Name="PART_ToggleButton"      
            Height="22"
            BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Panel.Background}">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
					VerticalAlignment="Center" 
					HorizontalAlignment="Center">
                    <Image Margin="2" 
                           Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
                <Path Grid.Column="1"
                      Fill="{StaticResource Blue.Path.Fill}"
                      Stroke="{StaticResource Blend.PathFill1}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{StaticResource Default.PathData}"
                      Focusable="False"/>
                <Popup Name="PART_Popup" 
                       Placement="Bottom"
                       Focusable="False"
                       PopupAnimation="Fade"
                       AllowsTransparency="True"
                       StaysOpen="False"               
                       IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}">
                    <Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" Margin="0" SnapsToDevicePixels="true">
                        <Border Background="{StaticResource Default.QuickDropDownBackground}" MinHeight="14" MinWidth="28" BorderThickness="1" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">
                            <ItemsPresenter/>
                        </Border>
                    </Microsoft_Windows_Themes:SystemDropShadowChrome>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="10,10,4,4"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="ToolTipService.IsEnabled" Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
