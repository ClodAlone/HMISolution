    <!--RibbonButtonExtraSmallTemplate-->
    <ControlTemplate x:Key="RibbonButtonExtraSmallTemplate.Office2007Blue" TargetType="{x:Type local:RibbonButton}">
        <Border 
                CornerRadius="{TemplateBinding CornerRadius}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                Background="{TemplateBinding Background}" 
                Opacity="{TemplateBinding Opacity}" 
                IsEnabled="{TemplateBinding IsEnabled}" 
                Height="22" Name="Bd">
            <Image Margin="2" 
                   Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                   />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>
            
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Luna.SelectedBrush.Default}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Luna.HoverSelectedBrush.Default}"/>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Luna.PressedBrush.Default}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
