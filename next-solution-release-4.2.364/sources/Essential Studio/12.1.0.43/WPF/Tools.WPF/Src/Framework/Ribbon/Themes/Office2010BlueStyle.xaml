                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{StaticResource Blue.Foreground}" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" x:Name="PART_Presenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,1"/>
                        </StackPanel>
                        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GroupPanelSeperatorBrush}" Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"  Margin="1,1,1,1" Background="{DynamicResource  ContextMenuBackground}"   Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
