                <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" Margin="-5,0,0,0" Width="20" Height="20" BorderThickness="1" BorderBrush="{StaticResource  QuickCheckedButtonBorderBrush}" Background="{StaticResource QuickCheckedButtonBackground}" CornerRadius="1">
                    <Path Fill="#FF31347C"  SnapsToDevicePixels="True" Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Width="9" Height="11">
                        <!--<Path.Data>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                                                <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                                            </GeometryGroup>
