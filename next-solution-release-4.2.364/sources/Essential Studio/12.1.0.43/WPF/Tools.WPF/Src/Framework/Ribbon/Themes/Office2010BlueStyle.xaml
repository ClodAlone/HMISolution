                        <Border BorderThickness="0,0,1,0"  Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"  Margin="1,1,1,1" Background="{DynamicResource ContextMenuBackground}" BorderBrush="{DynamicResource IconBarSeperatorBrush}" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
                    </local:LayoutPanel>
