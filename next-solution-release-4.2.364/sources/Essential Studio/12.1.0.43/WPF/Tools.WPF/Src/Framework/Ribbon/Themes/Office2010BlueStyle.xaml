                                                    <ItemsPanelTemplate>
                                                        <local:MultilinePanel	VerticalAlignment="{TemplateBinding VerticalAlignment}"	HorizontalAlignment="{TemplateBinding HorizontalAlignment}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </local:CustomItemsControl>
                                            </Grid>
                                        </Border>

