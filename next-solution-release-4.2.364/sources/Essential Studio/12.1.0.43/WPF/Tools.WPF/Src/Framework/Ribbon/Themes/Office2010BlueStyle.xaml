                                    <Setter Property="Stroke" TargetName="InnerPath" Value="{DynamicResource ButtonHoverInnerBorderBrush}"/>
                                    <Setter Property="Background" TargetName="PART_Button" Value="{DynamicResource ButtonHoverInnerBackgroundBrush}"/>                                   
                                    <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{DynamicResource ButtonHoverOuterBorderBrush}"/>
                                </MultiTrigger>

