                            BorderThickness="0"                           
                            Background="Transparent">
                        <ItemsPresenter/>                        
                        </Border>
                        <!-- Separator Border-->                       
                        <Rectangle HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Stretch" Visibility="{TemplateBinding SeparatorVisibility}" Width="3" Stroke="#FFF0F6FA">
