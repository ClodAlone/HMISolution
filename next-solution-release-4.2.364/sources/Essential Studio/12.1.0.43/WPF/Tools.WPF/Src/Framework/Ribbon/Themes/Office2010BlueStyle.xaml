                        <GeometryGroup>
                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
            </local:RibbonMenuItem.Icon>
        </local:RibbonMenuItem>
    </ItemsControl>

