                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self},  Path=IsDropDownOpen}"             Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource RibbonDropDownToggleButtonPressed}"/>
