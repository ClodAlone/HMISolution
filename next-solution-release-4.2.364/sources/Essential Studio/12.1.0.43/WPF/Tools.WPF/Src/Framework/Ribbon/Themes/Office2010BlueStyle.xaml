                                                    <local:RibbonButton Name="PART_BelowButton"  Margin="0,1" Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{DynamicResource RibbonTitleForeground}" Width="auto"/>
