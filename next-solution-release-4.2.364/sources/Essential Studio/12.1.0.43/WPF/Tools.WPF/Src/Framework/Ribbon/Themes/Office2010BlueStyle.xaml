<Style BasedOn="{StaticResource Office2010BlueRibbonBarStyle}" TargetType="{x:Type local:RibbonBar}"/>

    <!--TextBoxStyle-->
    <Style x:Key="TextBoxStyle1" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
    </Style>

    <!--EmptyCheckBoxFocusVisual-->
    <Style x:Key="EmptyCheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle SnapsToDevicePixels="true" Stroke="Black" StrokeDashArray="1 2" StrokeThickness="1" Margin="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--CheckRadioFocusVisual-->
    <Style x:Key="CheckRadioFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle SnapsToDevicePixels="true" Stroke="Black" StrokeDashArray="1 2" StrokeThickness="1" Margin="14,0,0,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="CheckBoxNormalOuterBorderBrush" Color="#FF898B8C"/>
    <SolidColorBrush x:Key="CheckBoxNormalInnerBorderBrush" Color="#FFF2F3F5"/>
    <SolidColorBrush x:Key="CheckBoxNormalInner1BorderBrush" Color="#FFB6B8BA"/>


    <LinearGradientBrush  x:Key="CheckBoxNormalBackground" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFE8E9EB" Offset="0"/>
            <GradientStop Color="#FFF0F1F2" Offset="0.859"/>
            <GradientStop Color="#FFF3F3F4" Offset="1"/>
        </LinearGradientBrush>


    <SolidColorBrush x:Key="CheckBoxCheckedOuterBorderBrush" Color="#FFC26D1D"/>
    <SolidColorBrush x:Key="CheckBoxCheckedInnerBorderBrush" Color="#FFFCE7BD"/>
    <SolidColorBrush x:Key="CheckBoxCheckedInner1BorderBrush" Color="#FFFCA558"/>


    <LinearGradientBrush  x:Key="CheckBoxCheckedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFAE0A2" Offset="0.564"/>
            <GradientStop Color="#FFFBE9BC" Offset="0.571"/>
            <GradientStop Color="#FFFDF2D7" Offset="0.872"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CheckBoxMouseOverOuterBorderBrush" Color="#FFCF9037"/>
    <SolidColorBrush x:Key="CheckBoxMouseOverInnerBorderBrush" Color="#FFFCF1C2"/>
    <SolidColorBrush x:Key="CheckBoxMouseOverInner1BorderBrush" Color="#FFFDBD7D"/>


    <LinearGradientBrush  x:Key="CheckBoxMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFAECC8" Offset="0.567"/>
            <GradientStop Color="#FFFDF6E4" Offset="0.88"/>
        </LinearGradientBrush>
    
        <!--RibbonCheckBox Style-->
    <Style TargetType="{x:Type local:RibbonCheckBox}"  x:Key="Office2010BlueRibbonCheckBoxStyle">
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="Margin" Value="3,3,3,3"/>
        <Setter Property="Background" Value="{StaticResource CheckBoxNormalBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckBoxNormalOuterBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyCheckBoxFocusVisual}"/>
        <Setter Property="Content"  Value="New CheckBox"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonCheckBox}">
                    <BulletDecorator SnapsToDevicePixels="true" Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="border1" Width="13" Height="13"  BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border x:Name="border2" BorderBrush="{DynamicResource  CheckBoxNormalInnerBorderBrush}" BorderThickness="1">
                                    <Border x:Name="border3" BorderThickness="1"  BorderBrush="{StaticResource CheckBoxNormalInner1BorderBrush}" Background="{DynamicResource CheckBoxNormalBackground}">
                                        <Canvas SnapsToDevicePixels="True">
                                            <Path x:Name="path" Stretch="Fill" Data="F1 M 424.575,325.964L 426.491,324.964L 428.158,327.297L 431.741,320.214L 433.574,321.464L 429.158,330.131L 427.074,330.131L 424.575,325.964 Z">                                               
                                            </Path>
                                        </Canvas>
                                    </Border>
                                </Border>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Name="content" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="6,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="true">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource CheckRadioFocusVisual}"/>
                            <Setter Property="Padding" Value="2,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Fill" TargetName="path" Value="#FF15428B"/>                           
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource CheckBoxMouseOverOuterBorderBrush}" />
                            <Setter TargetName="border2" Property="BorderBrush" Value="{StaticResource CheckBoxMouseOverInnerBorderBrush}" />
                            <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource CheckBoxMouseOverInner1BorderBrush}" />
                            <Setter TargetName="border3" Property="Background" Value="{StaticResource CheckBoxMouseOverBackground}" />
                            <Setter Property="TextBlock.Foreground" TargetName="content" Value="{StaticResource RibbonTitleForeground}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource CheckBoxCheckedOuterBorderBrush}" />
                            <Setter TargetName="border2" Property="BorderBrush" Value="{StaticResource CheckBoxCheckedInnerBorderBrush}" />
                            <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource CheckBoxCheckedInner1BorderBrush}" />
                            <Setter TargetName="border3" Property="Background" Value="{StaticResource CheckBoxCheckedBackground}" />
                        </Trigger>
                        
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="TextBlock.Foreground" TargetName="content" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2010BlueRibbonCheckBoxStyle}" TargetType="{x:Type local:RibbonCheckBox}"/>
	    
    <SolidColorBrush x:Key="UIElementGeneralBackground" Color="#FFF2F7FC"/>
    <LinearGradientBrush  x:Key="comboBoxDropDownbuttonHoverBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCF4D7" Offset="0.651"/>
        <GradientStop Color="#FFFCFBF3" Offset="0.964"/>
    </LinearGradientBrush>

    <!--ToggleButtonStyle-->
    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <!--<Setter Property="Margin" Value="-1"/>-->
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
        <Setter Property="UIElement.Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="BorderBrush" Value="transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid SnapsToDevicePixels="true" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" Grid.Column="1" CornerRadius="{StaticResource Blue.ComboCornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Name="PART_ComboThumb" Background="{StaticResource Default.ComboBoxItemBrush}">
                            <Border Name="PART_ComboThumbInner">
                                <Grid>
                                    <Rectangle Name="InnerPath" Fill="{TemplateBinding Background}"  Margin="1" RadiusX="1.667" RadiusY="1.667"/>
                                    <Path x:Name="Arrow" Data="M0,0 L100.25,0 100.25,20 80,20 80,39.75 60.5,39.75 60.5,60 39.75,60 39.75,39.75 20.75,39.75 20.75,20 0,20 z" HorizontalAlignment="Center" Height="3"  Stretch="Fill" VerticalAlignment="Center" Width="5">
                                        <Path.Fill>
                                            <LinearGradientBrush EndPoint="0.5,0.831" StartPoint="0.026,0.039">
                                                <GradientStop Color="#FF999EA5" Offset="0"/>
                                                <GradientStop Color="#FF55595F" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter Property="BorderThickness" TargetName="PART_ComboThumb" Value="1,0,0,0"/>-->
                            <Setter Property="Background" TargetName="PART_ComboThumb" Value="#FFE0EDFA"/>
                            <Setter Property="BorderBrush" TargetName="PART_ComboThumb" Value="{DynamicResource RibbonBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsMouseOver" SourceName="PART_ComboThumb" Value="True">
                            <!--<Setter Property="BorderThickness" TargetName="PART_ComboThumb" Value="1"/>-->
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource ComboboxDropDownButtonHoverInnerBackgroundBrush}"/>
                            <Setter Property="Background" TargetName="PART_ComboThumb" Value="{DynamicResource comboBoxDropDownbuttonHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_ComboThumb" Value="{DynamicResource ButtonHoverOuterBorderBrush}"/>
                            <Setter Property="BorderThickness" TargetName="PART_ComboThumbInner" Value="0"/>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <!--<Setter Property="BorderThickness" TargetName="PART_ComboThumb" Value="1"/>-->
                            <Setter Property="BorderBrush" TargetName="PART_ComboThumb" Value="{DynamicResource ButtonPressedInnerBorderBrush}"/>
                            <Setter Property="Background" TargetName="PART_ComboThumb" Value="{DynamicResource ButtonPressedOuterBackgroundBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource ButtonPressedInnerBackgroundBrush}"/>
                            <Setter Property="BorderThickness" TargetName="PART_ComboThumbInner" Value="0"/>                            
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="Fill" TargetName="Arrow" Value="#FFAFAFAF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--ComboBoxEditableTextBox Style-->
    <Style x:Key="ComboBoxEditableTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer Focusable="False" x:Name="PART_ContentHost" Background="{TemplateBinding Background}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonComboBoxItem style-->
    <Style x:Key="Office2010BlueRibbonComboBoxItemStyle" TargetType="{x:Type local:RibbonComboBoxItem}">
        <Setter Property="Background" Value="{StaticResource Default.ComboBoxItemBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonComboBoxItem}">
                    <Border Name="Bd" CornerRadius="2" Margin="1,0,1,0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                        <Grid>
                            <Rectangle Name="InnerPath" Fill="{TemplateBinding Background}"  Margin="1" RadiusX="1.667" RadiusY="1.667"/>                       
                              <ContentPresenter Margin="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="true">
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource ComboboxDropDownButtonHoverInnerBackgroundBrush}"/>
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource comboBoxDropDownbuttonHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ButtonHoverOuterBorderBrush}"/>
                            <Setter Property="ComboBoxItem.Foreground" Value="{StaticResource RibbonTitleForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="3" />
                            <Setter Property="FontSize" Value="18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueRibbonComboBoxItemStyle}" TargetType="{x:Type local:RibbonComboBoxItem}"/>

    <!--RibbonComboBox Style-->
    <Style TargetType="{x:Type local:RibbonComboBox}" x:Key="Office2010BlueRibbonComboBoxStyle">
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="Background" Value="#FFEDF5FD"/>
        <Setter Property="BorderBrush" Value="#FFB1C0D6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="true">
                        <Border x:Name="Bd" CornerRadius="0" MinHeight="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" SnapsToDevicePixels="True" BorderThickness="{TemplateBinding BorderThickness}" >
                            <Grid Grid.IsSharedSizeScope="true">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Margin="{TemplateBinding Padding}" x:Name="SelectedItemBorder" Grid.ColumnSpan="2"/>
                                 <ContentPresenter RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <ToggleButton Style="{StaticResource ToggleButtonStyle}" Grid.ColumnSpan="3" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="-1" Background="Transparent"/>
                            </Grid>
                        </Border>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                <Border x:Name="DropDownBorder" Background="{StaticResource Default.QuickDropDownBackground}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="1">
                                 <Border.Effect>
                                      <DropShadowEffect Opacity="0.25" ShadowDepth="4"/>
                                 </Border.Effect>
                                </Border>
                                <ScrollViewer x:Name="PART_ScrollViewer" Margin="4,6,4,6" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <!--<Setter TargetName="PART_EditableTextBox" Property="Background" Value="White"/>-->
                            <Setter TargetName="SelectedItemBorder" Property="Background" Value="{DynamicResource UIElementGeneralBackground}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="false">
                            <Setter Property="MinHeight" Value="95" TargetName="DropDownBorder"/>
                        </Trigger>
                        <!--<Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="Transparent"/>
                        </Trigger>-->
                        <Trigger Property="IsGrouping" Value="true">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                        </Trigger>
                        <Trigger Property="AllowsTransparency" SourceName="Popup" Value="true">
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="DropDownBorder"/>
                            <Setter Property="CornerRadius" TargetName="DropDownBorder" Value="3,3,3,3"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Height" Value="28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEditable" Value="true">
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bd" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0" SnapsToDevicePixels="True">
                                    <Grid Grid.IsSharedSizeScope="true" SnapsToDevicePixels="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                                        </Grid.ColumnDefinitions>                                      
                                        <TextBox Background="Transparent" Margin="{TemplateBinding Padding}" x:Name="PART_EditableTextBox" Style="{StaticResource ComboBoxEditableTextBox}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Grid.Column="1" IsReadOnly="{Binding Path=IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <ToggleButton Style="{StaticResource ToggleButtonStyle}" Grid.ColumnSpan="3" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="-1" Background="Transparent"/>
                                    </Grid>
                                </Border>

                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border x:Name="DropDownBorder" Background="{StaticResource Default.QuickDropDownBackground}" BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect Opacity="0.25" ShadowDepth="4"/>
                                            </Border.Effect>
                                        </Border>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">                                  
                                    <Setter TargetName="PART_EditableTextBox" Property="Background" Value="{DynamicResource UIElementGeneralBackground}"/>                                  
                                </Trigger>
                                <Trigger Property="HasItems" Value="false">
                                    <Setter Property="MinHeight" Value="95" TargetName="DropDownBorder"/>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="Transparent"/>
                                </Trigger>-->
                                <Trigger Property="IsGrouping" Value="true">
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                                </Trigger>
                                <Trigger Property="AllowsTransparency" SourceName="Popup" Value="true">
                                    <Setter Property="Margin" Value="0,0,0,0" TargetName="DropDownBorder"/>
                                    <Setter Property="CornerRadius" TargetName="DropDownBorder" Value="3,3,3,3"/>
                                </Trigger>
                                <Trigger Property="IsEditable" Value="true">
                                    <Setter Property="IsTabStop" Value="false"/>
                                    <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox"/>                                   
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Height" Value="28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueRibbonComboBoxStyle}" TargetType="{x:Type local:RibbonComboBox}"/>


