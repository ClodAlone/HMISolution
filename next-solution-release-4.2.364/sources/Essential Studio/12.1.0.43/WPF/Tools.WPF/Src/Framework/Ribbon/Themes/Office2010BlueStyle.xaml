                <ControlTemplate TargetType="{x:Type local:RibbonContextMenu}">
                    <Microsoft_Windows_Themes:SystemDropShadowChrome Name="Shdw" SnapsToDevicePixels="True" Color="#00FFFFFF">
                        <Border BorderBrush="{TemplateBinding Border.BorderBrush}" CornerRadius="{StaticResource QuickDropDownCornerRadius}" BorderThickness="{TemplateBinding Border.BorderThickness}" Background="{TemplateBinding Panel.Background}">
                         <Border.Effect>
                              <DropShadowEffect Opacity="0.25" ShadowDepth="4"/>
                         </Border.Effect>
                            <Grid>
                                <Rectangle Margin="1,1,1,1" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{StaticResource ContextMenuBackground}" RadiusX="2" />
                                <Rectangle Margin="26,1,0,1" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource GroupPanelSeperatorBrush}" />
                                <Rectangle Margin="27,1,0,1" Width="1" HorizontalAlignment="Left" Fill="{StaticResource ContextMenuBackground}" />
                                <ScrollViewer Margin="1,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
