                                                        <ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
