    <!--RibbonMenuItem style-->
    <Style TargetType="{x:Type local:RibbonMenuItem}"   x:Key="Office2010BlueRibbonMenuItemStyle">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonTitleForeground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonMenuItem}">
                    <Border  Name="Bd" Padding="{TemplateBinding Padding}">
                        <Grid Grid.ColumnSpan="3">

                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="0" HorizontalAlignment="Left" Fill="White" RadiusX="0" />
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blue.QATContextMenu.BorderBrush}" />
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="Transparent" />

                            <Border BorderThickness="{TemplateBinding BorderThickness}"  Background="{TemplateBinding Panel.Background}" Margin="1"   CornerRadius="3" Name="Border" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="17"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Name="InnerPath" Grid.ColumnSpan="4"  RadiusX="2" RadiusY="2" SnapsToDevicePixels="True"/>

                                    <Border Name="IconBorder" Grid.Column="0" BorderThickness="1" CornerRadius="{StaticResource QuickDropDownCornerRadius}">
                                        <ContentPresenter Margin="1" Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                    </Border>
                                    <Border Name="PART_CheckBorder" Background="{StaticResource QuickCheckedButtonBackground}" BorderBrush="{StaticResource QuickCheckedButtonBorderBrush}"  Grid.Column="0" BorderThickness="1" CornerRadius="1" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" Width="20" Height="20">
                                        <Path x:Name="CheckIcon" Margin="2"
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource CheckIconPathFillBrush}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                    </Border>
                                    <ContentPresenter ContentSource="Header" Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <ContentPresenter.Style>
                                            <Style>
                                                <Style.Triggers>
                                                    <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                        <Setter Property="TextElement.FontSize" Value="18"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>
                                    <ContentPresenter Content="{TemplateBinding InputGestureText}" VerticalAlignment="Center" Grid.Column="2"></ContentPresenter>
                                    <Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="3" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    <Popup Name="PART_Popup" 
                               StaysOpen="False" 
                               PopupAnimation="Fade" 
                               MinWidth="10" 
                               MinHeight="10" 
                               HorizontalOffset="1" 
                               VerticalOffset="0" 
                               AllowsTransparency="true" 
                               Placement="Right" 
                               Focusable="false" 
                               IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" SnapsToDevicePixels="true">
                                            <Border BorderBrush="#FF9EB0D1" CornerRadius="2" BorderThickness="1" Background="White">
                                                <Border.Effect>
                                                    <DropShadowEffect Opacity="0.25" ShadowDepth="4"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="White"  RadiusX="2" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blue.QATContextMenu.BorderBrush}" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="0" HorizontalAlignment="Left" Fill="{StaticResource Blue.QATContextMenu.BorderBrush}" />
                                                    <ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                                        <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Microsoft_Windows_Themes:SystemDropShadowChrome>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter TargetName="IconBorder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" TargetName="InnerPath" Value="{StaticResource RibbonMenuItemHoverBackgroundBrush}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                            <!--<Setter Property="Background" TargetName="Border" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>-->
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource RibbonMenuItemHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Fill" TargetName="InnerPath" Value="{StaticResource RibbonMenuItemHoverBackgroundBrush}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>
                            <!--<Setter Property="Background" TargetName="Border" Value="{StaticResource RibbonMenuItemHoverInnerBorderBrush}"/>-->
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource RibbonMenuItemHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="TextElement.FontSize" Value="18"/>
                            <Setter Property="Padding" Value="16,9,16,9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueRibbonMenuItemStyle}" TargetType="{x:Type local:RibbonMenuItem}"/>
