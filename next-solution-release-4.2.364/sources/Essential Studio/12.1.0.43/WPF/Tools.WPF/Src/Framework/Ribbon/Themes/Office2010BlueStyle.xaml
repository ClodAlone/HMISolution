                                                        <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blue.Foreground}"/>
                                                        <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blue.Foreground}"/>
                                                        <Separator Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                                        <local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blue.Foreground}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </local:DropDownButton>
                                    </StackPanel>
                                </local:DropDownButton>
                            </Grid>
                        </local:TwoItemsLayoutPanelEx>
                            
                    </Border>
                        
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowChildren" Value="True">
                            <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
                            <Setter Property="Visibility" TargetName="TopSeperator" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenuOverFlow">
                            <Setter Property="Visibility" TargetName="TopSeperatorOverFlow" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasGeometry" Value="False">
                            <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FrameworkElement.Height" Value="40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False">
                <Setter Property="GeometryBackground" Value="{StaticResource Blue.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Blue.GeometryStroke}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                     Value="True">
