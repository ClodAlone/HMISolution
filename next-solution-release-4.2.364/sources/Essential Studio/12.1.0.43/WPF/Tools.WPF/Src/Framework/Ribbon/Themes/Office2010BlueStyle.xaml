                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.4" Color="{TemplateBinding SelectedContextTabGroupBackColor}" Direction="265" BlurRadius="6" ShadowDepth="2"/>
                            </Border.Effect>
