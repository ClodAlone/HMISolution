                                                                                                <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{DynamicResource RibbonMenuItemHoverInnerBorderBrush}"/>
                                                                                                <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{DynamicResource RibbonMenuItemHoverBorderBrush}"/>
                                                                                               
