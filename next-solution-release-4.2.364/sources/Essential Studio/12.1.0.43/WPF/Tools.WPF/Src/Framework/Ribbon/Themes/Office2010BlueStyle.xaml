    <!--ApplicationMenu Style-->
    <Style TargetType="{x:Type local:ApplicationMenu}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ApplicationMenu}">
                 <Grid x:Name="PART_ButtonGrid" Height="38" Width="38" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
                        <Ellipse Height="37" Width="37" Name="OB"
               Fill="{StaticResource Blue.AppButton.OutterBorderFill}"
               Stroke="{StaticResource Blue.AppButton.OutterBorder}"
               StrokeThickness="1"
               SnapsToDevicePixels="True" />
                        <Ellipse Height="37" Width="37"
               Stroke="{StaticResource Blue.AppButton.OutterBorder}"
               Opacity="0.6"
               StrokeThickness="1"
               SnapsToDevicePixels="True">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="1" Y="0.4" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Height="35" Width="35"
               Fill="{StaticResource Blue.AppButton.InnerBorderFill}"
               Name="IB"
               Stroke="{StaticResource Blue.AppButton.InnerBorder}"
               SnapsToDevicePixels="True" />
                        <Ellipse Height="33" Width="33"
               Fill="{StaticResource Blue.AppButton.TopHighlight}"
               Name="TH"
               SnapsToDevicePixels="True" />
                        <Ellipse Height="33" Width="33"
               Fill="{StaticResource Blue.AppButton.BottomHighlight}"
               Name="BH"
               SnapsToDevicePixels="True" />
                        <Image Name="PART_ApplicationButtonImage"
             Margin="1.5,1,0,0"
             HorizontalAlignment="Center"             
             VerticalAlignment="Center"             
             Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
             Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
             Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
             SnapsToDevicePixels="True"/>
                        <local:CustomPopup StaysOpen="False" PopupAnimation="Fade" Placement="Bottom" HorizontalOffset="-3" VerticalOffset="-16" x:Name="PART_Popup" Focusable="False" AllowsTransparency="True" IsOpen="{Binding Path=IsPopupOpen, Mode=TwoWay, UpdateSourceTrigger=Explicit, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" >
                            <mwt:SystemDropShadowChrome Name="Shdw" Margin="0">
                                <Grid>
                                    <Border BorderBrush="{StaticResource Blue.AppMenu.OutterBorderBrush}" CornerRadius="{StaticResource Default.AppMenuCornerRadius}" BorderThickness="1,1,1,1">
                                        <Border BorderBrush="{StaticResource Blue.AppMenu.InnerBorderBrush}" CornerRadius="{StaticResource QuickDropDownCornerRadius}" BorderThickness="1,1,1,1" Background="{StaticResource Blue.AppMenu.Background}">
                                            <DockPanel LastChildFill="True">
                                                <Border Height="15" CornerRadius="2,2,2,2" Background="{StaticResource Blue.AppMenu.BackgroundTop}" DockPanel.Dock="Top" />
                                                <DockPanel LastChildFill="True">
                                                    <Border Height="Auto" CornerRadius="0,0,2,2" Background="{StaticResource Blue.AppMenu.BackgroundBottom}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                                                        <shared:ItemsControlInternal x:Name="PART_AppItems" 
                                                   Margin="0,-2,0,-1" 
                                                   Visibility="Visible" 
                                                   HorizontalAlignment="Right" 
                                                   Padding="1,3,1,3"
                                                   ItemContainerStyle="{StaticResource ItemsControlInternalItemStyle}">
                                                            <shared:ItemsControlInternal.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Contained" IsItemsHost="True" Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </shared:ItemsControlInternal.ItemsPanel>
                                                        </shared:ItemsControlInternal>
                                                    </Border>
                                                    <Border Margin="2,0,2,1" BorderBrush="{StaticResource Blue.AppMenu.BorderBrush1}" BorderThickness="1,1,1,1" Grid.Row="1">
                                                        <Border BorderBrush="{StaticResource Blue.AppMenu.BorderBrush2}" BorderThickness="1,1,1,1" Background="{StaticResource Blue.AppMenu.Background2}">
                                                            <DockPanel LastChildFill="True">
                                                                <Border x:Name="PART_Border" BorderBrush="{StaticResource Blue.AppMenu.BorderBrush3}" Visibility="Visible" BorderThickness="1,0,0,0" Background="{StaticResource Blue.AppMenu.Background3}" DockPanel.Dock="Right">
                                                                    <Border BorderBrush="{StaticResource Blue.AppMenu.BorderBrush4}" BorderThickness="1,0,0,0" Padding="2,2,2,2">
                                                                        <ItemsControl x:Name="PART_MenuItems" ItemsSource="{TemplateBinding internalMenuItems}"  ItemTemplate="{x:Null}" Foreground="{StaticResource Blue.Foreground}" />
                                                                    </Border>
                                                                </Border>
                                                                <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,-5,-5" HorizontalScrollBarVisibility="Hidden">
                                                                    <ItemsPresenter Margin="0,0,5,5" x:Name="PART_Items" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                </ScrollViewer>
                                                            </DockPanel>
                                                        </Border>
                                                    </Border>
                                                </DockPanel>
                                            </DockPanel>
                                        </Border>
                                    </Border>
                                    <Grid Name="PART_FakeAppButton"
                              Height="38" Width="38"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                                        <Ellipse Height="37" Width="37"
                                    Fill="{StaticResource AppButtonExpandedOutterBorderFill}"
                                    Stroke="{StaticResource Blue.AppButton.OutterBorder}"
                                    StrokeThickness="1"/>
                                        <Ellipse Height="37" Width="37"
                                Stroke="{StaticResource AppButtonExpandedOutterBorder}"
                                Opacity="0.6"
                                StrokeThickness="1">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="1"  Y="0.4"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Height="35" Width="35"
                                Fill="{StaticResource AppButtonExpandedInnerBorderFill}"
                                Stroke="{StaticResource Blue.AppButton.InnerBorder}" />
                                        <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedTopHighlight}"/>
                                        <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedBottomHighlight}"/>
                                        <Image Margin="1.5,1,0,0"                               
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
                                 SnapsToDevicePixels="True"/>
                                        <Grid.RenderTransform>
                                            <TranslateTransform X="0" Y="-22" />
                                        </Grid.RenderTransform>
                                    </Grid>
                                </Grid>
                            </mwt:SystemDropShadowChrome>
                        </local:CustomPopup>
                    </Grid> 
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="Shdw" Property="Margin" Value="0,0,4,4"/>
                        </Trigger>
                        <Trigger Property="IsBelowAppButton" Value="False">
                            <Setter TargetName="PART_FakeAppButton" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonHoverOutterBorderFill}"/>
                            <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonHoverOutterBorder}"/>
                            <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonHoverInnerBorderFill}"/>
                            <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonHoverInnerBorder}"/>
                            <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonHoverTopHighlight}"/>
                            <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonHoverBottomHighlight}"/>
                        </Trigger>
                        <Trigger Property="IsPopupOpen" Value="True">
                            <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonExpandedOutterBorderFill}"/>
                            <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonExpandedOutterBorder}"/>
                            <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonExpandedInnerBorderFill}"/>
                            <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonExpandedInnerBorder}"/>
                            <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonExpandedTopHighlight}"/>
                            <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonExpandedBottomHighlight}"/>
                        </Trigger>
                        <Trigger Property="IsKeyTipShown" Value="True">
                            <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonExpandedOutterBorderFill}"/>
                            <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonExpandedOutterBorder}"/>
                            <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonExpandedInnerBorderFill}"/>
                            <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonExpandedInnerBorder}"/>
                            <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonExpandedTopHighlight}"/>
                            <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonExpandedBottomHighlight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                  
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
