    <!--GalleryItem template-->
    <Style x:Key="{x:Type local:RibbonGalleryItem}" TargetType="{x:Type local:RibbonGalleryItem}">
        <Setter Property="ClickMode" Value="Release"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonGalleryItem}">
                    <shared:TrippleBorder    Name="PART_TrippleBorder"
                                   BorderThickness="1"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   Background="Transparent" InsideBorderThickness="1"
                                   OutsideBorderThickness="1"
                                   OutsideBorderBrush="Transparent"
                                   CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderCornerRadius}"
                                   MinWidth="0"
                                   SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle Name="InnerPath"  Fill="Transparent"  Margin="1" RadiusX="1.667" RadiusY="1.667"/>
                            <ContentPresenter MinWidth="0"  Margin="1,0,1,0"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  
                              ContentSource="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                />
                        </Grid>
                    </shared:TrippleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{DynamicResource Office2010BlueGalleryItemCheckedBackgroundBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="OutsideBorderBrush" Value="{DynamicResource Ofice2010BlueGalleryItemCheckedBorderBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemCheckedBackgroundBrush}"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemCheckedBackgroundBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource Office2010BlueGalleryItemCheckedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{DynamicResource ButtonHoverOuterBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverOuterBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>

                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{DynamicResource ButtonHoverOuterBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverOuterBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{DynamicResource Ofice2010BlueGalleryItemCheckedBorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverOuterBackgroundBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource Office2010BlueGalleryItemMouseOverBrush}"/>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{DynamicResource Office2010BluePressedBackgroundBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="OutsideBorderBrush" Value="{DynamicResource Office2010BluePressedBorderBrush}"/>
                            <Setter Property="InsideBorderBrush" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BluePressedBackgroundBrush}"/>
                            <Setter Property="Background" TargetName="PART_TrippleBorder" Value="{DynamicResource Office2010BluePressedBackgroundBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{DynamicResource Office2010BluePressedBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

