    <SolidColorBrush x:Key="StatusBar.BorderBrush" Color="#54000000"/>
    
    <!--RibbonStatusBar Style-->
    <Style x:Key="Office2010BlueRibbonStatusBarStyle" TargetType="{x:Type local:RibbonStatusBar}">
