<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.Expression.Design.TileViewSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="Tile View Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Tools - Tile View Control</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                 
                    
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Width="120"  HorizontalAlignment="Left" />

                    
                <TextBlock Text="Minimized Item Orientation" Grid.Row="1" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="OrientationSelector" Margin="5,5,0,0" Width="115" Grid.Row="1" Grid.Column="1" />
                
             
            </Grid>
        </StackPanel>

        
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>