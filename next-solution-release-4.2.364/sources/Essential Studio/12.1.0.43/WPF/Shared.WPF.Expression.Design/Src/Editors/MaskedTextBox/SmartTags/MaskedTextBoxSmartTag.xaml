<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.Expression.Design.MaskedTextBoxSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="MaskedEditTextBox Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Tools - MaskedEditTextBox</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="25" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>

                <TextBlock Text="Text" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtText" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Mask" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtMask" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Watermark Text" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtWatermarkText" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Watermark Text Mode" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboWatermarkTextMode" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Horizontal Content Alignment" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboHorizontalContentAlignment" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />

            </Grid>

            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" />
            <TextBlock FontWeight="Bold" Margin="5,5,0,0">Behavior</TextBlock>
            <CheckBox Name="checkWatermarkTextIsVisible" Content="Watermark Text Is Visible" Margin="5,5,0,0" />
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>