<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.Expression.Design.CalendarEditSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    <syncfusion:SmartTagPresenter Title="CalendarEdit Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <Grid Background="#FFDCEBFE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
           
            <StackPanel Margin="7" Grid.Row="0" >
                <TextBlock FontWeight="Bold">Essential Tools - CalendarEdit</TextBlock>

                
               
            </StackPanel>
            
            <StackPanel  Margin="7" Grid.Row="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <Border   BorderBrush="Black" Grid.Row="0" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                  
                    <TextBlock Text="Name" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                    <TextBox Name="Name1"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>
               
                     <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="2" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    
                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="3">Appearance</TextBlock>
               
                    <TextBlock Text="Calendar Style" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" />
                    <ComboBox Name="CalendarStyle"  Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>
                    
                    <TextBlock Text="Selection Range Mode" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" />
                    <ComboBox Name="SelectionRangeMode"  Margin="3,3,3,3" Width="115" Grid.Row="5" Grid.Column="1"/>
                    
                    
                    <TextBlock Text="Month Change Direction" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0" />
                    <ComboBox Name="MonthChangeDirection"  Margin="3,3,3,3" Width="115" Grid.Row="6" Grid.Column="1"/>
                    
                    
                     <TextBlock VerticalAlignment="Center" Text="Background Brush" Grid.Row="7" Grid.Column="0" Margin="2" />
                        <ComboBox Name="BackgroundBrush"  Margin="3,3,3,3" Width="115" Grid.Row="7" Grid.Column="1" />
                     
                    <TextBlock VerticalAlignment="Center" Text="Foreground Brush" Grid.Row="8" Grid.Column="0" Margin="2" />
                        <ComboBox Name="ForegroundBrush"  Margin="3,3,3,3" Width="115" Grid.Row="8" Grid.Column="1" />
                    
                    
                        <TextBlock VerticalAlignment="Center" Text="Selection Border Brush" Grid.Row="9" Grid.Column="0" Margin="2" />
                        <ComboBox Name="SelectionBorderBrush"  Margin="3,3,3,3" Width="115" Grid.Row="9" Grid.Column="1" />
                    
                    
                        <TextBlock VerticalAlignment="Center" Text="Header Foreground" Grid.Row="10" Grid.Column="0"/>
                        <ComboBox Name="HeaderForeground" Margin="3,3,3,3" Width="115" Grid.Row="10" Grid.Column="1"/>
                    
                 
                       <TextBlock VerticalAlignment="Center" Text="Header Background" Grid.Row="11" Grid.Column="0"/>
                        <ComboBox Name="HeaderBackground" Margin="3,3,3,3" Width="115" Grid.Row="11" Grid.Column="1"/>
                    
                        <TextBlock VerticalAlignment="Center" Text="Date" Grid.Row="12" Grid.Column="0"/>
                        <TextBox Name="Date" LostFocus="Date_LostFocus"  Margin="3,3,3,3" Width="115" Grid.Row="12" Grid.Column="1"/>

                    <Border Margin="0,7,0,0" BorderBrush="Black" Grid.Row="13" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                        <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="14">Behavior</TextBlock>

                        <StackPanel Grid.Row="15"  Margin="7">
                        
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="AllowSelection"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                         Allow Selection
                        </TextBlock>
                        </StackPanel>


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="AllowMultiplySelection"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                         Allow Multiple Selection 
                            </TextBlock>
                        </StackPanel>
                        
                      <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="IsDayNamesAbbreviated"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Is DayNameAbbreviated
                        </TextBlock>
                    </StackPanel>
                        
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="IsMonthNameAbbreviated"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is MonthNameAbbreviated
                        </TextBlock>
                    </StackPanel>
                  

                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="TodayRowIsVisible"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Today Row Is Visible
                        </TextBlock>
                    </StackPanel>
                    
                     <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="IsShowWeekNumbers"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is ShowWeekNumbers
                        </TextBlock>
                    </StackPanel>
                    
                       <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="ShowPreviousMonthDays"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    Show Previous Month Days
                        </TextBlock>
                    </StackPanel>
                     
                    
                     <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="ScrollToDateEnabled"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Scroll To Date Enabled
                        </TextBlock>
                    </StackPanel>
                    
                     <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="IsAllowYearSelection"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    Is AllowYearSelection
                        </TextBlock>
                    </StackPanel>
                    
                     <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                        <CheckBox Name="ShowNextMonthDays"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    Show Next Month Days
                        </TextBlock>
                    </StackPanel>
                    
                    </StackPanel>
<TextBlock Text="Frame Moving Time" VerticalAlignment="Center" Grid.Row="16" Grid.Column="0" />
              <TextBox Name="FrameMovingTime"  Margin="3,3,3,3" Width="115" Grid.Row="16" Grid.Column="1"/>
            
                    
                    <TextBlock Text="Change Mode Time" VerticalAlignment="Center" Grid.Row="17" Grid.Column="0" />
              <TextBox Name="ChangeModeTime"  Margin="3,3,3,3" Width="115" Grid.Row="17" Grid.Column="1"/>
                    
                  
                </Grid>
            </StackPanel>
        </Grid>

        
   
        </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>

