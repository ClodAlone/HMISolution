    <!-- Scroll Bar Button Styles-->

    <Style x:Key="ScrollBarDownButtonBlack" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Name="PART_Repeat" Background="{TemplateBinding Background}">
                        <Border Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="0" Name="innerBorder">
                            <Path Data="M0,0L3.5,4 7,0z" HorizontalAlignment="Center" Height="5" Width="8" Stretch="Fill" Fill="{StaticResource Office2010BlackScrollBarPathFill}" Name="Arrow" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_Repeat" Property="Background" Value="{StaticResource Office2010BlackVerticalRepeatButtonPressedBackground}"/>
                            <Setter TargetName="PART_Repeat" Property="BorderBrush" Value="{StaticResource Office2010BlackVerticalRepeatButtonPressedBorderBrush}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Office2010BlackScrollBarPathFill}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Repeat" Property="BorderBrush" Value="{StaticResource Office2010BlackVerticalRepeatButtonMouseOverBorderBrush}"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="{StaticResource Office2010BlackVerticalRepeatButtonInnerBorderMouseOverBackground}"/>
                            <Setter TargetName="PART_Repeat" Property="Background" Value="{StaticResource Office2010BlackVerticalRepeatButtonMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="Fill" TargetName="Arrow" Value="{StaticResource Office2010BlackScrollBarPathFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

