    <!-- Scroll Bar Button Styles-->
    <Style x:Key="ScrollBarDownButtonBlue" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Name="PART_Repeat" Background="{TemplateBinding Background}">
                        <Border Background="Transparent" BorderThickness="1" CornerRadius="1" Name="InnerBorderBrush">
                            <Path Data="M0,0L3.5,4 7,0z" HorizontalAlignment="Center" Height="5" Width="8" Stretch="Fill" Fill="{StaticResource Office2010BlueScrollFill}" Name="Arrow" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_Repeat" Property="Background" Value="{StaticResource Office2010BlueVerticalRepeatButtonPressedBackground}"/>
                            <Setter TargetName="PART_Repeat" Property="BorderBrush" Value="{StaticResource Office2010BlueVerticalRepeatButtonPressedBorderBrush}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="#FF404C6B"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Repeat" Property="BorderBrush" Value="{StaticResource Office2010BlueVerticalRepeatButtonMouseOverBorderBrush}"/>
                            <Setter TargetName="InnerBorderBrush" Property="BorderBrush" Value="{StaticResource Office2010BlueVerticalRepeatButtonInnerBorderMouseOverBackground}"/>
                            <Setter TargetName="PART_Repeat" Property="Background" Value="{StaticResource Office2010BlueVerticalRepeatButtonMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="Fill" TargetName="Arrow" Value="{StaticResource TriangleInner}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

