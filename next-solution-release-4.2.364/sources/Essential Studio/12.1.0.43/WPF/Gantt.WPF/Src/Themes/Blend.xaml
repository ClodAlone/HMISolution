    <!-- Gantt Control Style-->
    
    <Style TargetType="local:GanttControl"
           x:Key="GanttControlStyle">
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="{StaticResource ganttBorderBrush}" />
        <Setter Property="Background"
                Value="{StaticResource chartBackground}" />
        <Setter Property="ScheduleBackground"
                Value="{StaticResource scheduleheaderbg}" />
        <Setter Property="ScheduleBorderBrush"
                Value="{StaticResource scheduleborderbrush}" />
        <Setter Property="ScheduleBorderThickness"
                Value="0,0,0,1" />
        <Setter Property="ScheduleForeground"
                Value="{StaticResource scheduleheaderfg}"/>
        <Setter Property="NonWorkingHoursBackground" Value="#FF535352"/>
        <!--<Setter Property="TaskNodeBackground" Value="#FF7D8793"/>-->
        <Setter Property="TaskNodeBackground" Value="#FFF4F4F5"/>
        <Setter Property="ProgressIndicatorBackground" Value="Black"/>
        <Setter Property="ConnectorStroke" Value="White"/>
        <Setter Property="ResourceContainerTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource resourceNamebBrush}"  />
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GanttControl}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClipToBounds="True" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{TemplateBinding GridWidth}"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="{TemplateBinding ChartWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Grid:GanttGrid x:Name="PART_GanttGrid" 
												VisualStyle="Blend"
                                                ScrollViewerStyle="{StaticResource BlendScrollViewerStyle}" 
                                                HeaderBackground ="{TemplateBinding GridHeaderBackground}"
                                                HeaderForeground="{TemplateBinding GridHeaderForeground}"
                                                ShowAddNewColumn="{TemplateBinding ShowAddNewColumn}"
                                                ShowDateWithTime ="{TemplateBinding ShowDateWithTime}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0" Background="{StaticResource chartBackground}"
                                                Grid.IsSharedSizeScope="True"
                                                Grid.Column="0"  />
                            <GridSplitter Grid.Column="1" 
                                              Width="5" 
                                              Background="#FF808080"
                                              BorderBrush="Transparent"
                                              BorderThickness="1,0,1,0"
                                              ShowsPreview="True"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch"
                                              x:Name="PART_GanttGridSplitter">
                            </GridSplitter>
                            <ScrollViewer x:Name="PART_ScheduleViewScrollViewer"
                                              Grid.Column="2"                                          
                                              Style="{StaticResource BlendScrollViewerStyle}"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Auto">
                                <Grid Margin="-1,-1,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <schedule:GanttSchedule x:Name="PART_GantSchedule" Grid.Row="0" ClipToBounds="True"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                 StartTime="{TemplateBinding StartTime}" SnapsToDevicePixels="True"
                                                                 IsUIVirtualizaionEnabled="{TemplateBinding UseOnDemandSchedule}"
                                                                 EndTime="{TemplateBinding EndTime}"
                                                                 BorderBrush="{TemplateBinding ScheduleBorderBrush}"
                                                                 BorderThickness="{TemplateBinding ScheduleBorderThickness}"
                                                                 Foreground="{TemplateBinding ScheduleForeground}"
                                                                 Background="{TemplateBinding ScheduleBackground}" />

                                    <Chart:GanttChart x:Name="PART_GanttChart" Grid.Row="1"  TaskNodeBackground="{TemplateBinding TaskNodeBackground}"
                                                                 HighlightItemBrush="{TemplateBinding HighlightItemBrush}"
                                                                 ConnectorStroke="{TemplateBinding ConnectorStroke}" BorderBrush="Transparent"
                                                                 ToolTipTemplate="{TemplateBinding ToolTipTemplate}" SnapsToDevicePixels="True"
                                                                 ResourceNameVisibility="{TemplateBinding ResourceNameVisibility}"
                                                                 HorizontalAlignment="Left" BorderThickness="0"
                                                                 StartTime="{TemplateBinding StartTime}"
                                                                 EndTime="{TemplateBinding EndTime}"
                                                                 CurrentDateLine="{TemplateBinding CurrentDateLine}"
                                                                 StickCurrentDateLineTo="{TemplateBinding StickCurrentDateLineTo}"
                                                                 NonWorkingHoursBackground="{TemplateBinding NonWorkingHoursBackground}"
                                                                 ProgressIndicatorBackground="{TemplateBinding ProgressIndicatorBackground}"
                                                                 ShowResizingTooltip="{TemplateBinding ShowResizingTooltip}"
                                                                 ShowNonWorkingHoursBackground="{TemplateBinding ShowNonWorkingHoursBackground}"
                                                                 ShowChartLines="{TemplateBinding ShowChartLines}"
								 								 ShowGridLinesOnZooming="{TemplateBinding ShowGridLinesOnZooming}"
                                                                 RowHeight="{TemplateBinding RowHeight}"
                                                                 ResourceNamePlacement="{TemplateBinding ResourceNamePlacement}"
                                                                 Width="{Binding ElementName=PART_GantSchedule, Path=Width}"
                                                                 ResourceNameForeground="{StaticResource resourceNamebBrush}"
                                                                 Background="{StaticResource chartBackground}" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
   
    <Style TargetType="local:GanttControl"
           BasedOn="{StaticResource GanttControlStyle}">
    </Style>

</ResourceDictionary>