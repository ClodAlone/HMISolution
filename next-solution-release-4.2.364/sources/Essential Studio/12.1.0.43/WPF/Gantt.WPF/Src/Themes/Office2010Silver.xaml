    <!-- Scroll Bar Button Styles-->
    
    <Style x:Key="ScrollBarDownButtonSilver" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Name="PART_Repeat" Background="{TemplateBinding Background}">
                        <Border Background="Transparent" BorderThickness="1" CornerRadius="1" Name="InnerBorderBrush">
                            <Path Data="M0,0L3.5,4 7,0z" HorizontalAlignment="Center" Height="5" Width="8" Stretch="Fill" Fill="{StaticResource Office2010SilverScrollFill}" Name="Arrow" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_Repeat" Property="Background" Value="{StaticResource Office2010SilverVerticalRepeatButtonPressedBackground}"/>
                            <Setter TargetName="PART_Repeat" Property="BorderBrush" Value="{StaticResource Office2010SilverVerticalRepeatButtonPressedBorderBrush}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="#FF404C6B"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Repeat" Property="BorderBrush" Value="{StaticResource Office2010SilverVerticalRepeatButtonMouseOverBorderBrush}"/>
                            <Setter TargetName="InnerBorderBrush" Property="BorderBrush" Value="{StaticResource Office2010SilverVerticalRepeatButtonInnerBorderMouseOverBackground}"/>
                            <Setter TargetName="PART_Repeat" Property="Background" Value="{StaticResource Office2010SilverVerticalRepeatButtonMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="Fill" TargetName="Arrow" Value="{StaticResource Office2010SilverScrollFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

