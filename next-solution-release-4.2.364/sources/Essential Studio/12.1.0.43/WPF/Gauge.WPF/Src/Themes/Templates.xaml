                                            <GradientStop Color="sc#1, 0.889821649, 0.899297059, 0.948288" Offset="0.12542985692198272"/>
                                            <GradientStop Color="sc#1, 0.848573148, 0.8615959, 0.928928137" Offset="0.21881345384463202"/>
                                            <GradientStop Color="sc#1, 0.8204778, 0.8359168, 0.9157416" Offset="0.38083238867693581"/>
                                            <GradientStop Color="sc#1, 0.8148466, 0.8307699, 0.913098633" Offset="0.75518798828125"/>
                                            <GradientStop Color="#FFE9EBF5" Offset="0.75518798828125"/>
                                            <GradientStop Color="#FFDCE0F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.OpacityMask>
                                        <LinearGradientBrush EndPoint="1.003,0.787" StartPoint="0.43,-0.062">
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="Black" Offset="0.056210434064269066"/>
                                            <GradientStop Color="Black" Offset="0.12542985692198272"/>
                                            <GradientStop Color="Black" Offset="0.21881345384463202"/>
