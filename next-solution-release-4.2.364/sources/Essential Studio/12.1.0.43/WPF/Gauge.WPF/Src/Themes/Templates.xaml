            <Border Name="PART_ContainerBorder" CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"   
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <Border Name="FirstCircleBorder"   CornerRadius="{TemplateBinding CornerRadius}"              
                    Style="{TemplateBinding FirstFrameStyle}"                 
                BorderBrush="{TemplateBinding BorderBrush}"  
                BorderThickness="0" SnapsToDevicePixels="True">
                    <Border Name="SecondCircleBorder" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}" Margin="{TemplateBinding FirstFrameThickness}" Style="{TemplateBinding SecondFrameStyle}" SnapsToDevicePixels="True">
                        <Border Name="InnerCircleBorder" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}" Margin="{TemplateBinding SecondFrameThickness}" Style="{TemplateBinding InnerFrameStyle}" SnapsToDevicePixels="True">
                            <Canvas>
                                <Path x:Name="GlassPath"  Stretch="Fill" Data="F1M1312.287,823.31C1304.858,823.31,1298.813,829.354,1298.813,836.783L1298.813,836.783L1298.813,842.123C1344.804,888.706,1404.4,987.421,1434.415,1194.948L1434.415,1194.948L1434.415,836.783C1434.415,829.354,1428.371,823.31,1420.942,823.31L1420.942,823.31z" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" >
