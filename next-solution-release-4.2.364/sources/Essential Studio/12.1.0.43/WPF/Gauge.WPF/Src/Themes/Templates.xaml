<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Gauge"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF" 
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <local:RadiusConverter x:Key="RadiusConverter"/>
    <local:ThicknessConverter x:Key="ThicknessConverter"/>
    <local:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>


    <Style x:Key="FirstBorderFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}}"/>
    </Style>

    <Style x:Key="SecondBorderFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}}"/>
        <!--<Setter Property="Margin" Value="17"/>-->
    </Style>

    <Style x:Key="InnerCircleStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}}"/>
        <!--<Setter Property="Margin" Value="7"/>-->
    </Style>

    <Style x:Key="HalfCircleFirstStyle" TargetType="{x:Type local:HalfCircleBorder}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderWidth" Value="5" />
    </Style>

    <Style x:Key="HalfCircleSecondStyle" TargetType="{x:Type local:HalfCircleBorder}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="BorderWidth" Value="2" />
        <!--<Setter Property="Margin" Value="17,17,17,0"/>-->
    </Style>

    <Style x:Key="HalfCircleInnerStyle" TargetType="{x:Type local:HalfCircleBorder}">
        <Setter Property="HorizontalAlignment"   Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>

        <!--<Setter Property="Margin" Value="7,7,7,0"/>-->
    </Style>

    <Style x:Key="FirstBorderLinearFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="SecondBorderLinearFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="9"/>
    </Style>

    <Style x:Key="InnerBorderLinearStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style x:Key="FirstBorderDigitalFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="SecondBorderDigitalFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="InnerBorderDigitalStyle" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="CustomFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="19,0,0,0"
                               StrokeThickness="0.5"
                               Stroke="Transparent"           
                              />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:CircularPointer}" x:Key="listItem">
        <Setter Property="FocusVisualStyle"  Value="{StaticResource CustomFocusVisualStyle}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="FocusVisualStyle"  Value="{StaticResource CustomFocusVisualStyle}"/>
            </Trigger>
        </Style.Triggers>

    </Style>


    <!--Circular gauge template-->
    <ControlTemplate x:Key="CircularGaugeTemplate" TargetType="{x:Type local:CircularGauge}">
        <AdornerDecorator>
            <Border Name="PART_ContainerBorder">
                <Border Name="FirstCircleBorder"    Style="{TemplateBinding FirstFrameStyle}"                 
                BorderBrush="{TemplateBinding BorderBrush}"   
                BorderThickness="{TemplateBinding BorderThickness}"                  
                   Width="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}, Converter={StaticResource RadiusConverter}}" 
                   Height="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}, Converter={StaticResource RadiusConverter}}">
                    <Border Name="SecondCircleBorder" Margin="{TemplateBinding FirstFrameThickness}" Style="{TemplateBinding SecondFrameStyle}">
                        <Border Name="InnerCircleBorder" Margin="{TemplateBinding SecondFrameThickness}" Style="{TemplateBinding InnerFrameStyle}">
                            <Canvas>
                                <Path x:Name="GlassPath" Stretch="Fill" Data="F1M282.135,394.512C337.16,413.935,407.94,425.628,485.167,425.628L485.167,425.628C574.645,425.628,655.457,409.936,713.152,384.694L713.152,384.694C675.129,305.147,593.913,250.179,499.855,250.179L499.855,250.179C401.98,250.179,317.999,309.697,282.135,394.512" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" >
                                    <Path.Fill>
                                        <LinearGradientBrush EndPoint="0.5,0.916" StartPoint="0.503,0.01">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#00E9EBF5" Offset="0.25757099390029907"/>
                                            <GradientStop Color="#00DCE0F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.OpacityMask>
                                        <LinearGradientBrush EndPoint="0.5,0.916" StartPoint="0.503,0.01">
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="sc#0, 0, 0, 0" Offset="0.55757099390029907"/>
                                            <GradientStop Color="sc#0, 0, 0, 0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.OpacityMask>
                                </Path>
                                <Path x:Name="SecondPath" Fill="White" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" Stretch="Fill" Opacity="0.69999700784683228" Data="M23.813,48.523994 L23.059002,71.669014 L0.018982558,102.494 L0,89.092018 C1.8840039,80.06501 23.813,48.523994 23.813,48.523994 z M97.926033,0 L98.409035,20.007011 C98.409035,20.007011 69.127037,26.323996 29.690039,65.467995 L31.881046,40.099995 C31.881046,40.099995 55.803032,10.439999 97.926033,0 z"/>
                                <ContentPresenter ContentSource="InnerFrameContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Canvas>
                        </Border>
                    </Border>
                </Border>
            </Border>
        </AdornerDecorator>
    </ControlTemplate>

    <!--Half circle gauge template-->
    <ControlTemplate x:Key="HalfCircleGaugeTemplate" TargetType="{x:Type local:CircularGauge}">
        <AdornerDecorator>
            <Border Name="PART_ContainerBorder">

                <local:HalfCircleBorder InnerCircleRadius="{TemplateBinding HalfCircleInnerRadius}" CircleSweepDirection="{TemplateBinding HalfCircleSweepDirection}"  InnerCircleSweepDirection="{TemplateBinding HalfCircleInnerSweepDirection}"   Name="HalfCircleFirstBorder" Style="{TemplateBinding FirstFrameStyle}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderWidth="{Binding Path=BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}, Converter={StaticResource ThicknessConverter}}"
                                    Width="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}, 
                                        Converter={StaticResource RadiusConverter}}"
                                    Height="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGauge}}}">
                    <local:HalfCircleBorder Name="HalfCircleSecondBorder" InnerCircleRadius="{TemplateBinding HalfCircleInnerRadius}" CircleSweepDirection="{TemplateBinding HalfCircleSweepDirection}"  InnerCircleSweepDirection="{TemplateBinding HalfCircleInnerSweepDirection}" Margin="{TemplateBinding FirstFrameThickness}" Style="{TemplateBinding SecondFrameStyle}">
                        <local:HalfCircleBorder Name="HalfCircleInnerBorder" InnerCircleRadius="{TemplateBinding HalfCircleInnerRadius}" CircleSweepDirection="{TemplateBinding HalfCircleSweepDirection}"  InnerCircleSweepDirection="{TemplateBinding HalfCircleInnerSweepDirection}" Margin="{TemplateBinding SecondFrameThickness}" Style="{TemplateBinding InnerFrameStyle}">
                            <Canvas>
                                <Path x:Name="GlassPath" Stretch="Fill" Data="F1M282.135,394.512C337.16,413.935,407.94,425.628,485.167,425.628L485.167,425.628C574.645,425.628,655.457,409.936,713.152,384.694L713.152,384.694C675.129,305.147,593.913,250.179,499.855,250.179L499.855,250.179C401.98,250.179,317.999,309.697,282.135,394.512" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" >
                                    <Path.Fill>
                                        <LinearGradientBrush EndPoint="0.5,0.916" StartPoint="0.503,0.01">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#FFE9EBF5" Offset="0.55757099390029907"/>
                                            <GradientStop Color="#FFDCE0F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.OpacityMask>
                                        <LinearGradientBrush EndPoint="0.5,0.916" StartPoint="0.503,0.01">
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="sc#0, 0, 0, 0" Offset="0.55757099390029907"/>
                                            <GradientStop Color="sc#0, 0, 0, 0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.OpacityMask>
                                </Path>
                                <Path x:Name="SecondPath" Fill="White" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" Stretch="Fill" Opacity="0.69999700784683228" Canvas.Left="151.506" Canvas.Top="150.583" Data="M23.813,48.523994 L23.059002,71.669014 L0.018982558,102.494 L0,89.092018 C1.8840039,80.06501 23.813,48.523994 23.813,48.523994 z M97.926033,0 L98.409035,20.007011 C98.409035,20.007011 69.127037,26.323996 29.690039,65.467995 L31.881046,40.099995 C31.881046,40.099995 55.803032,10.439999 97.926033,0 z"/>

                                <ContentPresenter ContentSource="InnerFrameContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Canvas>

                        </local:HalfCircleBorder>
                    </local:HalfCircleBorder>
                </local:HalfCircleBorder>
            </Border>

        </AdornerDecorator>
    </ControlTemplate>

    <!--Linear gauge template-->
