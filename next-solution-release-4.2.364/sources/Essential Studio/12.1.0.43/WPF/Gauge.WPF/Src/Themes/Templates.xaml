        </AdornerDecorator>
    </ControlTemplate>

    <!--Digital gauge template-->
    <ControlTemplate x:Key="DigitalGaugeTemplate" TargetType="{x:Type local:DigitalGauge}">
        <AdornerDecorator>
            <Border Name="PART_ContainerBorder" CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{TemplateBinding BorderBrush}"   
                BorderThickness="{TemplateBinding BorderThickness}">
                <Border Name="FirstCircleBorder"   CornerRadius="{TemplateBinding CornerRadius}"              
                    Style="{TemplateBinding FirstFrameStyle}"                 
                BorderBrush="{TemplateBinding BorderBrush}"  
                BorderThickness="0">
                    <Border Name="SecondCircleBorder" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}" Margin="{TemplateBinding FirstFrameThickness}" Style="{TemplateBinding SecondFrameStyle}">
                        <Border Name="InnerCircleBorder" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}" Margin="{TemplateBinding SecondFrameThickness}" Style="{TemplateBinding InnerFrameStyle}">
                            <Canvas VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Path x:Name="GlassPath" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" Fill="White" Stretch="Fill" Opacity="0.4" Data="F1M6715.3052,7470.4629C6715.3052,7471.8589,6716.6032,7472.9919,6718.2042,7472.9919L7062.4512,7472.9919C7064.0542,7472.9919,7065.3532,7471.8589,7065.3532,7470.4629L7065.3532,7390.8089C7065.3532,7389.4979,7064.2062,7388.4349,7062.7422,7388.3059C6987.7532,7457.1769,6773.6622,7386.2859,6715.3052,7468.3669z"/>
                                <Path x:Name="SecondGlassPath" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableEffects,Mode=OneWay,Converter={StaticResource BooleanToVisibility}}" Fill="White" Stretch="Fill"  Opacity="0.4" Data="F1M6718.8335,7379.0537C6718.8335,7377.8267,6722.3825,7376.8327,6726.7605,7376.8327L7055.7205,7376.8327C7060.0995,7376.8327,7063.6475,7377.8267,7063.6475,7379.0537L7063.6475,7398.1127C7063.6475,7399.3387,7060.0995,7400.3327,7055.7205,7400.3327L6726.7605,7400.3327C6722.3825,7400.3327,6718.8335,7399.3387,6718.8335,7398.1127z"/>
                                <ContentPresenter ContentSource="InnerFrameContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Canvas>
                        </Border>
                    </Border>
                </Border>
            </Border>
        </AdornerDecorator>
    </ControlTemplate>

    <Style x:Key="CircularScaleAdornerStyle" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <ItemsControl Name="AdornerBorder"
                                  Width="{Binding Path=AdornerWidth, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGaugeAdorner}}}"
                                  Height="{Binding Path=AdornerHeight, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGaugeAdorner}}}"
                                  ItemsSource="{Binding Path=ChildrenCollection, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGaugeAdorner}}}"                                  
                                  >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:ScalesLayoutPanel
                                    Name="ScalesLayoutPanel" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    PanelSize="{Binding Path=Radius, RelativeSource={RelativeSource AncestorType={x:Type local:CircularGaugeAdorner}}}"
                                    IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinearScaleAdornerStyle" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <ItemsControl Name="AdornerBorder"
                                  Width="{Binding Path=AdornerWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                  Height="{Binding Path=AdornerHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                  ItemsSource="{Binding Path=ChildrenCollection, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:LinearScaleLayoutPanel
                                    Name="LinearScalesLayoutPanel" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    PanelWidth="{Binding Path=AdornerWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                    PanelHeight="{Binding Path=AdornerHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                    IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DigitalScaleAdornerStyle" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <ItemsControl Name="AdornerBorder" Background="Transparent"
                                  Width="{Binding Path=AdornerWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                  Height="{Binding Path=AdornerHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                  ItemsSource="{Binding Path=ChildrenCollection, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:DigitalGaugeLayoutPanel 
                                    Name="CharactersLayoutPanel"                                    
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" 
                                    GaugeParent="{Binding Path=GaugeParent, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                    PanelWidth="{Binding Path=AdornerWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                    PanelHeight="{Binding Path=AdornerHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GaugeAdorner}}}"
                                    IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Rolling Gauge Template-->
    <ControlTemplate x:Key="RollingGaugeTemplate" TargetType="{x:Type local:RollingGauge}">
        <AdornerDecorator>
            <Border Name="PART_ContainerBorder" 
                    BorderBrush="{TemplateBinding BorderBrush}"  
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    
                    >
                <Grid Name="SegmentGrid">
                    <StackPanel Name="SegmentFrame"  
                                Orientation="Horizontal" 
                                Background="{TemplateBinding Background}" 
                                >
                    </StackPanel>
                </Grid>
            </Border>
        </AdornerDecorator>
    </ControlTemplate>

    <!--Rolling Character Template-->
    <ControlTemplate   x:Key="RollingCharacterTemplate" TargetType="{x:Type local:RollingCharacter}" >
        <Border Name="SegmentBorder"
                Margin="{TemplateBinding Margin}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" 
                Background="{TemplateBinding Background}" 
                >
            <ContentPresenter Name="ContentPresenter" 
                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              ContentTemplate="{Binding Path=SegmentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:RollingGauge}}}"
                              />
        </Border>
    </ControlTemplate>
</ResourceDictionary>
