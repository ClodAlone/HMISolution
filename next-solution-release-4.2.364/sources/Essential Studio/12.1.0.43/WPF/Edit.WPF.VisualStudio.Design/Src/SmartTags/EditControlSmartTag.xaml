<syncfusion:SmartTagBase x:Class="Syncfusion.Edit.Wpf.VisualStudio.Design.EditControlSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="EditControl Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.Wpf;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="0">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Edit</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="4" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock FontWeight="Bold" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="Background" Grid.Row="2" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbBackground" Grid.Row="2" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Foreground" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbForeground" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
                <Border BorderBrush="Black" BorderThickness="0.4" Margin="4" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Language Settings</TextBlock>
                
                <TextBlock Text="Document Language" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbLanguage" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
                <CheckBox x:Name="chkintellisense" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="Enable Intellisense" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
                <TextBlock Text="Intellisense Mode" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbintellisense" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0" IsEnabled="{Binding ElementName=chkintellisense, Path=IsChecked, Mode=TwoWay}" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <CheckBox x:Name="chkoutline" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="Enable Outlining" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="4" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Behavior</TextBlock>
                
                <CheckBox x:Name="chktab" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="Accepts Tab" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
                <CheckBox x:Name="chkline" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="Show Line Number" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <CheckBox x:Name="chkreadonly" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="Is ReadOnly" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <CheckBox x:Name="chkshwcm" Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="Show Default Context Menu" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
    