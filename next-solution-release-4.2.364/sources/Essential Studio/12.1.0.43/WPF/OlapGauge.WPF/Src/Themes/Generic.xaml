        <ResourceDictionary Source="/Syncfusion.OlapGauge.WPF;component/Themes/Generic.Brushes.Office2007Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.OlapGauge.WPF;component/Themes/Generic.Brushes.Office2007Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.OlapGauge.WPF;component/Themes/Generic.Brushes.Blend.xaml"/>
    </ResourceDictionary.MergedDictionaries>

