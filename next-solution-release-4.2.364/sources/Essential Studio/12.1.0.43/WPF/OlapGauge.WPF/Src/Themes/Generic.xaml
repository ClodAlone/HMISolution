        <ResourceDictionary Source="/Syncfusion.OlapGauge.WPF;component/Themes/Generic.Brushes.Classic.xaml"/>
        <ResourceDictionary Source="/Syncfusion.OlapGauge.WPF;component/Themes/Generic.Brushes.Office2003.xaml"/>
