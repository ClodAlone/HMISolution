<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.VisualStudio.Design.StateIndicatorSmartTag"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="State Indicator Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


       <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Text="pointercap1" Width="120" Height="22" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="Indicator Height" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtIndicatorHeight" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Indicator Width" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtIndicatorWidth" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Indicator Style" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboIndicatorStyle" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Width="160" Height="22" HorizontalAlignment="Stretch" />

            </Grid>            
        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
