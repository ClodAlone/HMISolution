<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    xmlns:design="clr-namespace:Syncfusion.Windows.Design">

    <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="ToolTip" Value="Close Smart Tag" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="PART_Border" BorderThickness="1" BorderBrush="Transparent">
                        <Grid>
                            <Rectangle Name="PART_Background" Fill="Transparent" Opacity="0.3" />
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="#3399FF"  />
                            <Setter TargetName="PART_Background" Property="Fill" Value="#3399FF"  />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="#3399FF"  />
                            <Setter TargetName="PART_Background" Property="Fill" Value="#3399FF"  />
                            <Setter TargetName="PART_Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArrowButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="Background" Value="LightGray"/>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border BorderBrush="{TemplateBinding Control.BorderBrush}" 
                            BorderThickness="{TemplateBinding Control.BorderThickness}" 
                            Background="{TemplateBinding Control.Background}" 
                            Opacity="{TemplateBinding Control.Opacity}"
                            CornerRadius="1">
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#3399FF"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#3399FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>



    <ControlTemplate x:Key="SmartTagPresenterTempate" TargetType="{x:Type design:SmartTagPresenter}">
        <Border Width="{TemplateBinding Control.Width}"
                Height="{TemplateBinding Control.Height}">
            <Grid>
                <ToggleButton 
                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press"
                          BorderThickness="1"
                          Opacity="0.75"
                          Style="{StaticResource ArrowButtonStyle}">
                    <Path Name="PART_DropDownArrow" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          Data="F0 M 0,0 L 5.4,5 0,9 Z"  
                          Fill="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" 
                          SnapsToDevicePixels="true"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </ToggleButton>

                <Popup Name="PART_Popup"
                   Placement="Right"
                   Focusable="True"
                   PopupAnimation="Fade"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   Margin="1"
                   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <mwt:SystemDropShadowChrome Margin="0" SnapsToDevicePixels="true">
                        <Border Background="#FAFAFA" MinHeight="14" MinWidth="28" BorderThickness="1" CornerRadius="2" BorderBrush="Gray">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="true" Grid.Row="0" Background="LightGray">
                                    <Button Name="PART_CloseButton" 
                                            Width="15"
                                            Height="15"
                                            Margin="2"
                                            DockPanel.Dock="Right"                                             
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource CloseButtonStyle}">
                                        <Path SnapsToDevicePixels="True" 
                                              Stretch="Fill" 
                                              StrokeThickness="1.5"
				                              Stroke="Black"
                                              Data="M109,51 L216,142 M215,52 L109,142"
				                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Width="8" 
                                              Height="8"/>
                                    </Button>
                                    <TextBlock Margin="7,3,7,3" FontWeight="Bold" Text="{TemplateBinding Title}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ContentPresenter Grid.Row="1" />

                                <!--Support information-->
                                <Grid Grid.Row="2" Background="LightGray">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock  Margin="5,7,5,5" FontWeight="Bold" Grid.Row="1">Documentation and Support Resources</TextBlock>

                                    <design:HyperLinkControl Uri="http://help.syncfusion.com" Margin="5,7,5,5" Focusable="False" Grid.Row="2">
                                        <TextBlock>
                                            <Hyperlink Name="OnlineDocumentation"  Focusable="False" 
                                                       TargetName="_blank" 
                                                       >
                                                Online Documentation
                                            </Hyperlink>
                                        </TextBlock>
                                    </design:HyperLinkControl>
                                    <design:HyperLinkControl Uri="http://www.syncfusion.com/support/forums/forum.aspx?ForumID=27" Margin="5,7,5,5" Focusable="False" Grid.Row="3">
                                        <TextBlock>
                                            <Hyperlink Name="ForumSupport"   Focusable="False"
                                                       TargetName="_blank" 
                                                       >
                                                Forum Support
                                            </Hyperlink>
                                        </TextBlock>
                                    </design:HyperLinkControl>
                                                                  
                                    <design:HyperLinkControl Uri="http://www.syncfusion.com/Account/Logon?ReturnUrl=%2fsupport%2fdirecttrac" Margin="5,7,5,5" Focusable="False" Grid.Row="4">
                                        <TextBlock>
                                        <Hyperlink Name="DirectTracSupport"  Focusable="False"
                                                   TargetName="_blank" 
                                                   >
                                            Direct-Trac Support
                                        </Hyperlink>
                                        </TextBlock>
                                    </design:HyperLinkControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </mwt:SystemDropShadowChrome>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PART_DropDownArrow" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="{x:Type design:SmartTagPresenter}" TargetType="{x:Type design:SmartTagPresenter}">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Template" Value="{StaticResource SmartTagPresenterTempate}"/>
    </Style>
    <Style  TargetType="{x:Type design:HyperLinkControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type design:HyperLinkControl}">
                    <Border>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>