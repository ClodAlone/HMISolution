<syncfusion:ChromelessWindow
    Name="measureEditorWindow"
    x:Class="Syncfusion.Windows.Tools.Olap.MeasureEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Olap"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Tools.Olap.Resources"
    Width="250" Height="325" MinHeight="325" MinWidth="250"
    DataContext="{Binding RelativeSource={RelativeSource self}}"
    Icon="../../Images/App.ico"
    ResizeMode="CanResizeWithGrip" WindowStyle="ToolWindow"  FontSize="12"
    Title="{Binding ElementName=textBlockTitle, Path=Text}" AllowsTransparency="True" >
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
                <ResourceDictionary Source="/Syncfusion.OlapTools.WPF;component/Themes/ToolsDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--Image convertor-->
            <local:ImageConverter x:Key="imageConverter"/>

            <!--Image height and width convertor-->
            <local:WidthHeightConvertor x:Key="widthHeightConvertor"/>

            <!--FontSize for the member editor items-->
            <System:Double x:Key="FontSize">12
            </System:Double>

            <ControlTemplate x:Key="buttonTemplate"/>

            <resources:MeasureEditorResourceWrapper x:Key="ResourceWrapperKeys" />
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35px" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="32px"/>
        </Grid.RowDefinitions>

        <!-- Since, Resource wrapper is added as resource of the window. We can't bind the title directly. 
            So, we are binding this text block with the title. The Title will bind to this text block-->
        <TextBlock x:Name="textBlockTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsMeasureEditorTitle}" Visibility="Collapsed" />

        <CheckBox x:Name="btnCheck" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="btnCheck_Click" Margin="12,1,1,1"
                  Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapMeasureEditorCheckOrUncheckAll}"
                  ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapMeasureEditorCheckOrUncheckAll}" />
        <Button x:Name="Delete" Height="23" Width="27" HorizontalAlignment="Right" Margin="0,3,5,3" Grid.Row="0" Click="Delete_Click"
                ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorDelete}">
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 14.8931,2.56871C 13.7204,2.34169 10.995,3.70179 8.34505,5.5491C 6.35546,3.1386 4.20413,1.2481 2.91151,1.39577C -0.0886315,1.73865 1.79717,4.05304 1.79717,4.05304C 3.44522,3.99612 5.23358,5.10977 6.88935,6.62091C 4.11774,8.77122 1.73103,12.0288 1.77824,13.4676C 1.86396,16.0821 4.00692,14.0248 4.00692,14.0248C 4.94982,13.2105 5.33555,10.1514 8.06999,7.78144C 10.8627,10.7257 13.0263,14.3392 13.0263,14.3392C 13.2849,13.0032 11.4845,9.65253 9.24945,6.69388C 11.9767,4.31455 14.8931,2.56871 14.8931,2.56871 Z">
                <Path.Fill>
                    <RadialGradientBrush RadiusX="1.63722" RadiusY="1.62028" Center="0.272662,0.0251297" GradientOrigin="0.272662,0.0251297">
                        <RadialGradientBrush.GradientStops>
                            <GradientStop Color="#FFF50000" Offset="0"/>
                            <GradientStop Color="#FF820000" Offset="1"/>
                        </RadialGradientBrush.GradientStops>
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <SkewTransform CenterX="0.272662" CenterY="0.0251297" AngleX="1.00263" AngleY="0"/>
                                <RotateTransform CenterX="0.272662" CenterY="0.0251297" Angle="60.6717"/>
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>
        </Button>
        <Button x:Name="MoveDown" Height="23" Width="27" HorizontalAlignment="Right" Margin="0,3,35,3" Grid.Row="0" Click="UpDown_Click"
                ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorMoveDown}">
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 1.72079,9.20409L 5.62049,9.19964L 5.62049,1.13207L 10.8085,1.13207L 10.8085,9.1937L 14.4013,9.18959L 8.08485,14.9903L 1.72079,9.20409 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FFA8C8EE" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF6A9BF0" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FF1243A4" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF233F70" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Button>
        <Button x:Name="MoveUp" Height="23" Width="27" HorizontalAlignment="Right" Margin="0,3,65,3" Grid.Row="0" Click="UpDown_Click"
                ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorMoveUp}">
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 14.4015,6.9183L 10.5018,6.92275L 10.5018,14.9903L 5.31371,14.9903L 5.31371,6.92869L 1.72093,6.9328L 8.03739,1.13211L 14.4015,6.9183 Z ">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FFA8C8EE" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF6A9BF0" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FF1243A4" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF233F70" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Button>

        <!--Measures list template-->
        <Grid Grid.Row="1" Margin="2,2,2,0">
            <ListBox Name="listBoxMeasureElements" Margin="2" SelectionChanged="listBoxMeasureElements_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox
                            Grid.Column="0"
                            Margin="1,3,1,1"
                            ClickMode="Press"
                            IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                            Tag="{Binding}"/>
                            <!--Measure icon-->
                            <Image
                                Width="{Binding Converter={StaticResource widthHeightConvertor}}"
                                Height="{Binding Converter={StaticResource widthHeightConvertor}}"
                                Margin="2,2,2,2"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Source="{Binding Converter={StaticResource imageConverter}}"/>
                            <!--Measure caption-->
                            <TextBlock VerticalAlignment="Center" Text="{Binding Path=Caption}">
                                <TextBlock.ContextMenu>
    <!--Remove measure context menu-->
                                    <ContextMenu>
                                        <MenuItem Click="MenuItem_Remove_Click" Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsMeasureEditorRemoveContextMenu}" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <!--Finally OK and Cancel buttons-->
        <Grid Height="30" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,9,7" VerticalAlignment="Bottom">
            <!--OK Button-->
            <Button
                x:Name="btnPopupOK"
                Width="60"
                HorizontalAlignment="Right"
                Margin="0,0,75,0"
                VerticalAlignment="Bottom"
                Click="btnPopupOK_Click"
                Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorOk}"
                IsDefault="True"/>
            <!--Cancel Button-->
            <Button
                x:Name="btnPopupCancel"
                Width="65px"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="btnPopupCancel_Click"
                Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorCancel}"
                IsCancel="True"/>
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>