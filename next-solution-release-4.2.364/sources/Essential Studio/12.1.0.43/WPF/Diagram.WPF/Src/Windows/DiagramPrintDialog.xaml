<Window x:Class="Syncfusion.Windows.Diagram.DiagramPrintDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Diagram"
     Height="400" Width="500"
    WindowStartupLocation="CenterScreen" Name="printdiaglog"
    
    >
    <Window.Resources>
        <ObjectDataProvider x:Key="StretchEnums" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:TypeExtension TypeName="Stretch" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="15" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 Fill="Gray">
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="3" Y="3"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderThickness="1" BorderBrush="Black"
                        Background="White">
                    <Viewbox Stretch="Uniform" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle x:Name="PreviewRect" Margin="10"
                                   Stroke="Black" StrokeThickness="1" StrokeDashArray="4, 2, 4, 2"/>
                    </Viewbox>
                </Border>
            </Grid>
            <StackPanel Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center" Name="PageInfo" Grid.Row="1" Orientation="Horizontal">
                <Button Click="PageDecrease_Click" Name="PageDecrease" Margin="5,0,2,0" MinWidth="25" Content="&lt;"></Button>
                <TextBox Name="CurrentPageBox" Text="{Binding CurrentPage, Mode=TwoWay, FallbackValue=1}"  TextChanged="CurrentPage_TextChanged"  MinWidth="30" MinHeight="10"></TextBox>
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding PageCount,StringFormat=' of {0}'}" ></TextBlock>
                <Button Click="PageIncrease_Click"  Name="PageIncrease" Margin="2,0,5,0" MinWidth="25" Content="&gt;" ></Button>
            </StackPanel>
        </Grid>

        <Grid Margin="0,15,15,15" Grid.Column="1">
            <StackPanel Grid.Row="0">
                <Border BorderThickness="1" BorderBrush="Gray">
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <RadioButton Margin="10" IsChecked="True" Click="OnColorClick">
                            <TextBlock Name="diagram_color" />
                        </RadioButton>
                        <RadioButton Margin="10" Click="OnBlackAndWhiteClick">
                            <TextBlock Name="diagram_BlackandWhite" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,10,0,0" Name="diagram_Stretch" />
                <ComboBox Name="Print_Stretch" SelectedIndex="2" SelectionChanged="PrintStrech_SelectionChanged">
                    <ComboBoxItem Name="diagarm_None"></ComboBoxItem>
                    <ComboBoxItem Name="diagram_Fill"></ComboBoxItem>
                    <ComboBoxItem Name="diagram_Uniform"></ComboBoxItem>
                    <ComboBoxItem Name="diagram_UniformtoFill"></ComboBoxItem>
                </ComboBox>

                <Button Margin="0,10,0,0" HorizontalAlignment="Right" 
                Width="100" Height="24"                  
                Click="OnAdvancedClick" Name="diagram_advanced">

                </Button>

            </StackPanel>
            <Grid VerticalAlignment="Bottom" Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="3" Click="OnPrintClick" Name="diagram_print"></Button>
                <Button Grid.Column="1" Margin="3" Click="OnCancelClick" Name="diagram_cancel" IsCancel="True"></Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
