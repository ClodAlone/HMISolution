<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.Expression.Design.CircularGaugeSmartTag"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Circular Gauge Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Gauge - Circular Gauge</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Text="pointercap1" Width="180" Height="22" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Action</TextBlock>

                <TextBlock Margin="5,5" Grid.Row="3">
                    <Hyperlink Tag="{x:Type syncfusion:CircularGauge}" Click="AddChildControl">Add Scale</Hyperlink>
                </TextBlock>
                
                <TextBlock Margin="5,5" Grid.Row="4">
                    <Hyperlink Tag="{x:Type syncfusion:StateIndicator}" Click="AddStateIndicators">Add State Indicators</Hyperlink>
                </TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="First Frame Fill Color" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboFirstFrameFillColor" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

                <TextBlock Text="First Frame Thickness" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFirstFrameThickness" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0" Width="180" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Second Frame Fill Color" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboSecondFrameFillColor" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

                <TextBlock Text="Second Frame Thickness" Grid.Row="10" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSecondFrameThickness" Grid.Row="10" Grid.Column="1" Margin="5,5,0,0" Width="180" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Center Frame Fill Color" Grid.Row="11" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboCenterFrameColorSelector" Grid.Row="11" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

                <TextBlock Text="Radius" Grid.Row="12" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtRadius" Grid.Row="12" Grid.Column="1" Margin="5,5,0,0" Width="180" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Half Circle Inner Radius" Grid.Row="13" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtHalfCircleInnerRadius" Grid.Row="13" Grid.Column="1" Margin="5,5,0,0" Width="180" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Half Circle Inner Sweep Direction" Grid.Row="14" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboHalfCircleInnerSweepDirection" Grid.Row="14" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

                <TextBlock Text="Half Circle Sweep Direction" Grid.Row="15" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboHalfCircleSweepDirection" Grid.Row="15" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

                <TextBlock Text="Frame Type" Grid.Row="16" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboFrameType" Grid.Row="16" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

            </Grid>

            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" />
            <TextBlock FontWeight="Bold" Margin="5,5,0,0">Behavior</TextBlock>
            <CheckBox Name="checkApplyFrameStyles" Content="Apply Frame Styles" Margin="5,5,0,0" />           
        </StackPanel>



    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
