<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.Expression.Design.CircularRangeSmartTag"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Circular Range Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


       <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="1" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Text="pointercap1" Width="120" Height="22" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" />

                <TextBlock FontWeight="Bold" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="Distance From Scale" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDistanceFromScale" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Range Position" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboRangePosition" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

                <TextBlock Text="Start Value" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtStartValue" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="End Value" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEndValue" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Start Width" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtStartWidth" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="End Width" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEndWidth" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
            </Grid>
        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
