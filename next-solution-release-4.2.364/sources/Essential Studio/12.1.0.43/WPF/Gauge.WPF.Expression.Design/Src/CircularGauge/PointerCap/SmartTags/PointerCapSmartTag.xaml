<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.Expression.Design.PointerCapSmartTag"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Pointer Cap Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


       <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="1" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Text="pointercap1" Width="120" Height="22" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="Pointer Cap Radius" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPointerCapRadius" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Pointer Cap Type" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboPointerCapType" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />

            </Grid>

            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" />
            <TextBlock FontWeight="Bold" Margin="5,5,0,0">Behavior</TextBlock>
            <CheckBox Name="checkPointerOnTop" Content="Pointer On Top" Margin="5,5,0,0" />            
        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
