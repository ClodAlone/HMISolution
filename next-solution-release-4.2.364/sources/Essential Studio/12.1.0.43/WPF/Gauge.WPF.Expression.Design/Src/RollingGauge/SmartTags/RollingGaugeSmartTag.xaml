<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.Expression.Design.RollingGaugeSmartTag "
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    
    <syncfusion:SmartTagPresenter Title="Rolling Gauge Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        
        <StackPanel Orientation="Vertical" Margin="2" Background="#FFDCEBFE">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Gauge - Rolling Gauge</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Text="rollingGauge1"/>

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
                
                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="SegmentCount" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox Name="txtsegmentCount" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="Segment Foreground" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboSegForeground" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="Segment Background" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboSegBackground" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="Value" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox Name="txtValue" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="Unit" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox Name="txtUnit" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="UnitPosition" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboUnitPosition" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="Direction" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboDirection" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0"/>

                <CheckBox Name="IsAutomaticSegmentCountEnabled"  Content="IsAutomaticSegmentCountEnabled" Grid.Row="10" Grid.ColumnSpan="2" Margin="5,5,0,0"/>

                <CheckBox Name="IsNumeric" Content="IsNumeric" Grid.Row="11" Grid.ColumnSpan="2" Margin="5,5,0,0"/>

                <TextBlock Text="MinValue" Grid.Row="12" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox Name="MinValue" Grid.Row="12" Grid.Column="1" Margin="5,5,0,0"/>
                
                <TextBlock Text="MaxValue" Grid.Row="13" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox Name="MaxValue" Grid.Row="13" Grid.Column="1" Margin="5,5,0,0"/>
            </Grid>
        </StackPanel>
    
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
