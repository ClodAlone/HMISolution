<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.Expression.Design.DigitalGaugeSmartTag"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Digital Gauge Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


       <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
			<TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Gauge - Digital Gauge</TextBlock>
			<Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />

			<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="1" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Text="pointercap1" Width="120" Height="22" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="Character Count" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCharacterCount" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Character Height" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCharacterHeight" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Character Spacing" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCharacterSpacing" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="CharacterType" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <ComboBox Name="comboCharacterType" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0" Width="Auto" Height="22" HorizontalAlignment="Stretch" />
                
                <TextBlock Text="Segment Spacing" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSegmentSpacing" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Segment Width" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSegmentWidth" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Skew AngleX" Grid.Row="10" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSkewAngleX" Grid.Row="10" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Skew AngleY" Grid.Row="11" Grid.Column="0" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSkewAngleY" Grid.Row="11" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />

            </Grid>
        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
