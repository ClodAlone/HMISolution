<UserControl x:Class="Syncfusion.Windows.Tools.Controls.HighlightColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" >
    
    <Grid x:Name="LayoutRoot" Background="White">
        <StackPanel Orientation="Vertical" x:Name="ParentStack">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="3"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="BorderBrush" Value="#FFE2E4E7"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Background" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="0" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                        <Grid x:Name="grid" Background="Transparent" >
                                            <Border x:Name="BackgroundGradient" Background="{TemplateBinding Background}" Margin="1"/>
                                        </Grid>
                                    </Border>
                                    <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <Rectangle x:Name="DisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" />
                                    <Rectangle x:Name="FocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" TargetName="Background" Value="#FFF29436"/>
                                        <Setter Property="Background" TargetName="BackgroundGradient" Value="#FFFFE294"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="BorderBrush" TargetName="Background" Value="#FFF29436"/>
                                        <Setter Property="Background" TargetName="BackgroundGradient" Value="#FFFFE294"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Opacity" TargetName="FocusVisualElement" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal">
                <Button Width="30" Height="30" Margin="3" Background="Yellow"/>
                <Button Width="30" Height="30" Margin="3" Background="Lime"/>
                <Button Width="30" Height="30" Margin="3" Background="Turquoise"/>
                <Button Width="30" Height="30" Margin="3" Background="Magenta"/>
                <Button Width="30" Height="30" Margin="3" Background="Blue"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="30" Height="30" Margin="3" Background="Red" />
                <Button Width="30" Height="30" Margin="3" Background="DarkBlue"/>
                <Button Width="30" Height="30" Margin="3" Background="Teal"/>
                <Button Width="30" Height="30" Margin="3" Background="Green"/>
                <Button Width="30" Height="30" Margin="3" Background="Purple"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="30" Height="30" Margin="3" Background="DarkRed" />
                <Button Width="30" Height="30" Margin="3" Background="Olive"/>
                <Button Width="30" Height="30" Margin="3" Background="Gray"/>
                <Button Width="30" Height="30" Margin="3" Background="Silver"/>
                <Button Width="30" Height="30" Margin="3" Background="Black"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <MenuItem HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="180">
                    <MenuItem.Icon>
                        <Rectangle Fill="White" Stroke="Goldenrod" Height="15" Width="15" />
                     </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock Margin="5,2" VerticalAlignment="Center" Text="No Color" FontSize="14"/>
                    </MenuItem.Header>
                </MenuItem>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
