<Window x:Class="Syncfusion.Windows.Shared.Olap.DesignerWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:Olap="clr-namespace:Syncfusion;assembly=Syncfusion.Olap.Base"
    xmlns:Tools="clr-namespace:Syncfusion;assembly=Syncfusion.Tools.WPF"
    sfshared:SkinStorage.VisualStyle="Office2007Blue" 
    Title="Designer Wizard" Icon="App.ico"
    WindowStartupLocation="CenterScreen" 
    Height="410" Width="410" MinHeight="200" MinWidth="410"
    ResizeMode="NoResize"
    Name="connectOptionWindow" >
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <syncfusion:WizardControl Background="AliceBlue" Name="ConnectionWizardDesigner"  HorizontalAlignment="Stretch"  Finish="ConnectOptionWizard_Finish"  Cancel="ConnectOptionWizard_Cancel" >
        <syncfusion:WizardPage  Name="wizPage1"  HorizontalAlignment="Stretch"   BackVisible="False" 
                            FinishEnabled="false"   CancelVisible="True" FinishVisible="False" HelpVisible="false" PageType="Blank"
                                Selected="wizPage1_Loaded" NextPage="{Binding ElementName=wizPage2}"  NextEnabled="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="8"  BorderThickness="1" >
                    <TextBlock HorizontalAlignment ="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" >Server options</TextBlock>
                </Border>
                <GroupBox Grid.Row="1">
                    <GroupBox.Header>
                        <TextBlock Text="Data source" FontSize="14" FontWeight="Bold"/>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <!--<CheckBox Grid.Row="1" Margin="11,4,2,2" Name="chkSyncfusionSampleSource"  Checked="chkSyncfusionSampleSource_Checked" Unchecked="chkSyncfusionSampleSource_Unchecked">
                    <TextBlock Text="Syncfusion sample source"  VerticalAlignment="Top" FontSize="14"  Height="20" />
                </CheckBox>-->
                        <StackPanel Name="stpCustomDatasource" Margin="2,11,2,82" Grid.RowSpan="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition/>

                                </Grid.RowDefinitions>
                            </Grid>
                            <GroupBox Grid.Row="0" BorderThickness=".5">
                                <GroupBox.Header>
                                    <CheckBox Name="chkCustomOfflineCube" Content="Offline Cube" Checked="chkCustomOfflineCube_Checked" Unchecked="chkCustomOfflineCube_Unchecked" />
                                </GroupBox.Header>
                                <Grid Name="grdCustomOfflineCube">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126*"/>
                                        <ColumnDefinition Width="126*" />
                                        <ColumnDefinition Width="108*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Margin="2,2,2,2" Name="txtOfflineCubeFilePath" IsReadOnly="True" Grid.ColumnSpan="2" />
                                    <Button Margin="2,2,2,2" Name="btnBrowser" Grid.Column="2" Content="Browse" Click="btnBrowser_Click" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Margin="0,8,0,0" BorderThickness=".5" >
                                <GroupBox.Header>
                                    <CheckBox Name="chkCutomServer" Content="Server" Checked="chkCutomServer_Checked" Unchecked="chkCutomServer_Unchecked"/>
                                </GroupBox.Header>
                                <StackPanel Name="stpCutomServer">
                                    <Grid Name="grdCustomSampleServer">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="2,2,2,2" Grid.Row="0" Grid.Column="0" Text="Server Name :"/>
                                        <ComboBox Margin="2,2,2,2" Grid.Row="0" Grid.Column="1" Name="cmbServerName" IsEditable="True"/>
                                        <TextBlock Margin="2,2,2,2" Grid.Row="1" Grid.Column="0" Text="Database Name :"/>
                                        <ComboBox Margin="2,2,2,2"  Grid.Row="1" Grid.Column="1" Name="cmbDatabaseName" IsEditable="True"/>
                                    </Grid>
                                    <Expander Header="Credential" IsExpanded="False" Name="CredentialExpander"  Expanded="Expander_Expanded" Collapsed="CredentialExpander_Collapsed" >
                                        <GroupBox Grid.Row="2" Margin="0,6,0,9" BorderThickness=".5" Height="72" >
                                            <GroupBox.Header>
                                                <TextBlock >Enter Credentials</TextBlock>
                                            </GroupBox.Header>
                                            <Grid Name="userInfoContainer">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="3,2,3,2" Grid.Row="0" Grid.Column="0" Text="User Name :"/>
                                                <TextBox Margin="3,2,3,2" Grid.Row="0" Grid.Column="1" Name="txtUsername"/>
                                                <TextBlock Margin="3,2,3,2" Grid.Row="1" Grid.Column="0" Text="Password :"/>
                                                <PasswordBox Margin="3,2,3,2"  Grid.Row="1" Grid.Column="1" Name="txtPassword"/>
                                            </Grid>
                                        </GroupBox>
                                    </Expander>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <GroupBox Grid.Row="1" BorderThickness=".5" Margin="0,17,0,35" Grid.RowSpan="2">
                            <GroupBox.Header>
                                <CheckBox Name="chkCustomConnectionString" Content="Connection String" Checked="chkCustomConnectionString_Checked" Unchecked="chkCustomConnectionString_Unchecked" />
                            </GroupBox.Header>
                            <Grid Name="grdconnectionString">
                                <TextBox Margin="2,2,2,2" Name="txtconnectionString" TextWrapping="WrapWithOverflow" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxLines="100"/>
                            </Grid>
                        </GroupBox>
                        <Grid  Grid.Row="2" Margin="0,-2,0,-1">
                            <Button x:Name="btnTestConnection" Content="TestConnection" Width="100" Height="25" HorizontalAlignment="Left" Click="btnTestConnection_Click" />
                       
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>

        </syncfusion:WizardPage>
        <syncfusion:WizardPage  HorizontalAlignment="Stretch" Name="wizPage2" HelpVisible="False" Selected="wizPage2_Loaded" PageType="Blank"
                                   BackVisible="True" FinishVisible="True" NextVisible="False" >

            <GroupBox Grid.Row="1" Margin="3,3,3,3"  BorderBrush="Black" >
                <GroupBox.Header>
                    <TextBlock Text="Cube Selection" FontSize="13" FontWeight="Bold"/>
                </GroupBox.Header>
                <Grid Grid.Row="1" Name="mainGrid" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border  CornerRadius="0,15,0,0" BorderThickness="4,4,4,4"  HorizontalAlignment="Left" Width="195">
                        <Grid  VerticalAlignment="Top"  >
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition  Height="240"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition  />
                                    <RowDefinition   />
                                </Grid.RowDefinitions>
                                <Label Content="Cubes" Grid.Row="0" FontWeight="Bold"/>
                                <syncfusion:CubeSelector x:Name="cubeSelector"  Grid.Row="1" Margin="1,0,3,0" HorizontalAlignment="Stretch" Style="{StaticResource {x:Type ComboBox}}" VerticalAlignment="Stretch" SelectionChanged="cubeSelector_SelectionChanged" />
                            </Grid>
                            <Grid Grid.Row="1"  VerticalAlignment="Top" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"  />
                                    <RowDefinition Height="220" />
                                </Grid.RowDefinitions>
                                <Label Content="Meta Tree" Grid.Row="0" FontWeight="Bold"/>
                                <syncfusion:CubeDimensionBrowser Height="218"   Grid.Row="1" x:Name="cubeDimensionBrowser" IncludeMembers="False" AllowNodeDragging="True"   Background="Transparent" VerticalAlignment="Top"  />
                            </Grid>
                        </Grid>
                    </Border>
                    <GridSplitter Width="4" Name="spliterVertical" Opacity=".7"  Margin="{DynamicResource SpliterMargin}" VerticalAlignment="Stretch" HorizontalAlignment="Right" />
                    <Border Margin="1,1,1,1" Grid.Column="1" BorderThickness="3,3,3,3" CornerRadius="15,0,0,0" >
                        <Grid  Height="350" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="70" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="55" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="70" />

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  />
                            </Grid.ColumnDefinitions>


                            <Label Content="Columns (Categorical)"  Grid.Row="0" FontWeight="Bold"/>
                            <syncfusion:AxisElementBuilder x:Name="axisBuilderColumn" Axis="Categorical" Grid.Row="1"  Margin="1,1,1,1" />



                            <Label Content="Rows (Series)" Grid.Row="2" FontWeight="Bold"/>
                            <syncfusion:AxisElementBuilder x:Name="axisBuilderRow" Axis="Series" Grid.Row="3" Margin="1,1,1,1" Grid.RowSpan="2" />



                            <Label Content="Slicer" Grid.Row="5" FontWeight="Bold"/>
                            <syncfusion:AxisElementBuilder x:Name="axisBuilderSlicer" Axis="Slicer" Grid.Row="6"  Margin="1,1,1,1" />

                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>
        </syncfusion:WizardPage>
    </syncfusion:WizardControl>
</Window>
