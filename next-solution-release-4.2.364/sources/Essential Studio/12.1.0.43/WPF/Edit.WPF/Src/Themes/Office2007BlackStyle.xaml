                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Black.QATContextMenu.BorderBrush}" />
                            <Border BorderThickness="{TemplateBinding BorderThickness}"
									Background="{TemplateBinding Panel.Background}"
									Width="{TemplateBinding Width}"
									Height="{TemplateBinding Height}"
									MinWidth="{TemplateBinding MinWidth}"
									MaxWidth="{TemplateBinding MaxWidth}"
									MinHeight="{TemplateBinding MinHeight}"
									MaxHeight="{TemplateBinding MaxHeight}"
									Margin="{TemplateBinding Margin}"
									Padding="{TemplateBinding Padding}"
									CornerRadius="2"
									Name="Border"
									SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="17" />
                                    </Grid.ColumnDefinitions>

                                    <Border Name="PART_CheckBorder" Grid.Column="0" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="2">
                                        <ContentPresenter Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
													Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                    </Border>
                                    <Label Grid.Column="1" Margin="11,0,10,0" Padding="-5"  Content="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    <Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
										  Grid.Column="2" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    <Popup Name="PART_Popup"
										   StaysOpen="False"
										   PopupAnimation="Fade"
										   MinWidth="10"
										   MinHeight="10"
										   HorizontalOffset="1"
										   VerticalOffset="0"
										   AllowsTransparency="true"
										   Placement="Right"
										   Focusable="false"
										   IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" SnapsToDevicePixels="true">
                                            <Border BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}" CornerRadius="0" BorderThickness="1" Background="{StaticResource QuickDropDownBackground}">
                                                <Grid>
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{StaticResource Black.QATContextMenu.LeftBar.Backgound}" RadiusX="2" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Black.QATContextMenu.BorderBrush}" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Black.QATContextMenu.BorderBrush}" />
                                                    <ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                                        <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Microsoft_Windows_Themes:SystemDropShadowChrome>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5" />
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter TargetName="PART_CheckBorder" Property="Background" Value="{StaticResource Default.QuickCheckedButtonBackgroundBrush}" />
                            <Setter TargetName="PART_CheckBorder" Property="BorderBrush" Value="{StaticResource Default.QuickCheckedButtonBorderBrush}" />
