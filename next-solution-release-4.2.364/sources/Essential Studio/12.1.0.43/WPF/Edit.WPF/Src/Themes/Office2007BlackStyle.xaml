            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Comment Lines" Command="{x:Static local:EditCommands.CommentSelection}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:EditControl}}}">
