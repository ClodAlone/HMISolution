                <Image Source="pack://application:,,,/Syncfusion.Edit.Wpf;component/Resources/Comment.png" MaxHeight="16" MaxWidth="16" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Uncomment Lines" Command="{x:Static local:EditCommands.UncommentSelection}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:EditControl}}}">
