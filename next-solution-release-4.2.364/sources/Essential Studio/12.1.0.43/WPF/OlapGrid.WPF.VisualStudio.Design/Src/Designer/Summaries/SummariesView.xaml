<UserControl x:Class="Syncfusion.OlapGrid.WPF.VisualStudio.Design.SummariesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid Margin="11,11,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="4*" />
            <RowDefinition Height="84*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Text="Create or edit MDX query." FontSize="12pt"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="40*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="MDX Query:" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right">
                <Hyperlink Name="hyperlinkCreateOrEdit" Click="hyperlinkCreateOrEdit_Click">Create/Edit</Hyperlink>
            </TextBlock>
        </Grid>
        <TextBox x:Name="txtQuery" AcceptsReturn="True" Grid.Row="4" TextWrapping="WrapWithOverflow" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  />
    </Grid>
</UserControl>
