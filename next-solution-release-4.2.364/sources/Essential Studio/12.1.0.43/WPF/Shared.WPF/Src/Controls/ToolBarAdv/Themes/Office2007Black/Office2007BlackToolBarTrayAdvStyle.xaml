<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					 xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
					
				
    <LinearGradientBrush  x:Key="TrayBackColor" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC6CAD0" Offset="0.438"/>
        <GradientStop Color="#FF9CA3AD" Offset="0.983"/>
        <GradientStop Color="#FFC4CAD2" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="ToolBarTrayAdvStyle" TargetType="tools:ToolBarTrayAdv">
        <Setter Property="Background" Value="{StaticResource TrayBackColor}"/>       
    </Style>
    
    <Style BasedOn="{StaticResource ToolBarTrayAdvStyle}" TargetType="tools:ToolBarTrayAdv"/>    
    
</ResourceDictionary>