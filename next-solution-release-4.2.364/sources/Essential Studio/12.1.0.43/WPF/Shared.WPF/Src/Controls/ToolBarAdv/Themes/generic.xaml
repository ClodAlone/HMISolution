<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:vsm="clr-namespace:Syncfusion.Windows" xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared"
                    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#CAB583" />
   

    <LinearGradientBrush x:Key="CloseButton_NormalBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF4CAC2" Offset="0"/>
        <GradientStop Color="#FFCC7D6D" Offset="0.5"/>
        <GradientStop Color="#FFB94630" Offset="0.5"/>
        <GradientStop Color="#FFF4B19C" Offset="1"/>
        <GradientStop Color="#FFBE7360" Offset="0.85"/>
    </LinearGradientBrush>    

    <SolidColorBrush x:Key="TitleBarBackground" Color="#FF808080" />

    <SolidColorBrush x:Key="TrayBackColor" Color="#FFF4F7FC"/>  

    <LinearGradientBrush x:Key="ToolBarBackBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFB5BECE" Offset="1"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverflowButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCDD2E0" Offset="0.473"/>
        <GradientStop Color="#FFF4F7FC" Offset="0.995"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OverflowPopupBackground" Color="#FFF0F0F0"/>

    <SolidColorBrush x:Key="OverflowPopupBorderBrush" Color="#FFA0A0A0"/>  

    <SolidColorBrush x:Key="Foreground" Color="#FF000000"/>
    
    <LinearGradientBrush x:Key="DropDownButtonAdvBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFBFBFB" Offset="0.26"/>
        <GradientStop Color="#FFCDD4D9" Offset="0.992"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DropDownMenuGroupBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD7DBE9" Offset="0"/>
        <GradientStop Color="#FFD5DAE8" Offset="0.376"/>
        <GradientStop Color="#FFD5DAE8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DropDownButtonAdvBorder" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFA1ADB8" Offset="0"/>
        <GradientStop Color="#FF617583" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE9F2F9" Offset="0.05"/>
        <GradientStop Color="#FFCFE6F1" Offset="0.511"/>
        <GradientStop Color="#FF6FCAF0" Offset="0.975"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="MouseOverBorderBrush" Color="Transparent"/>

    <LinearGradientBrush x:Key="PressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7ECFF1" Offset="0.02"/>
        <GradientStop Color="#FFB6E4F7" Offset="0.434"/>
        <GradientStop Color="#FFCEEDFA" Offset="0.967"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="PressedBorderBrush" Color="Transparent"/>

    <LinearGradientBrush x:Key="CheckedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7ECFF1" Offset="0.02"/>
        <GradientStop Color="#FFB6E4F7" Offset="0.434"/>
        <GradientStop Color="#FFCEEDFA" Offset="0.967"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="CheckedBorderBrush" Color="Transparent"/>

    <Style x:Key="DropDownMenuGroupStyle1" TargetType="{x:Type tools:DropDownMenuGroup}">
        <Setter Property="Background" Value="{StaticResource OverflowPopupBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OverflowPopupBorderBrush}"/>
        <Setter Property="Foreground" Value="#FF1B293E"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tools:DropDownMenuGroup}">
                    <Grid x:Name="gri" Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <tools:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                            <tools:TextToVisibilityConverter x:Key="TextConverter"/>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="White" BorderThickness="0,0,0,1" Background="Transparent" Height="22" Margin="1,0,1,1" Grid.Row="0">
                            <Border.Visibility>
                                <Binding Path="Header" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <tools:TextToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <Grid>
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Background="Transparent"/>
                                <ContentControl Content="{TemplateBinding Header}" Foreground="Black" FontWeight="Bold" HorizontalContentAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>
                                <Border x:Name="IconTray" BorderBrush="#FFA0A0B4" BorderThickness="0,0,1,0" Background="{StaticResource DropDownMenuGroupBackground}" HorizontalAlignment="Left" Margin="0,0,0,1" Width="44">
                                    <Border.Visibility>
                                        <Binding Path="IconBarEnabled" RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                    <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0"/>
                                </Border>
                                <Border>
                                    <ScrollViewer KeyboardNavigation.DirectionalNavigation="Cycle" Padding="1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                                        <ScrollViewer.BorderThickness>
                                            <Binding Path="ScrollBarVisibility" RelativeSource="{RelativeSource TemplatedParent}">
                                                <Binding.Converter>
                                                    <tools:VisibilityToThicknessConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </ScrollViewer.BorderThickness>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border BorderBrush="White" BorderThickness="0,0,2,0" Background="Transparent" HorizontalAlignment="Left" Width="22">
                                    <Border.Visibility>
                                        <Binding Path="IsMoreItemsIconTrayEnabled" RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                </Border>
                                <ItemsControl/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Background="Transparent" HorizontalAlignment="Stretch" Margin="1,0" Grid.Row="3" Width="{Binding ActualWidth, ElementName=PART_ResizeThumb}">
                            <Border.Visibility>
                                <Binding Path="IsResizable" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <Grid>
                                <Border BorderBrush="White" BorderThickness="0,1,0,0">
                                    <Border HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Width="3"/>
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Margin="3,0,0,0" SnapsToDevicePixels="True" Width="3"/>
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Margin="3,0,0,0" SnapsToDevicePixels="True" Width="3"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Cursor="SizeNS" Opacity="0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DropDownButtonAdvStyle" TargetType="{x:Type shared:DropDownButtonAdv}">
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="Label" Value="Drop Down Button"/>
        <Setter Property="Background" Value="{StaticResource DropDownButtonAdvBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DropDownButtonAdvBorder}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:DropDownButtonAdv}">
                    <Grid>
                        <Grid.Resources>
                            <shared:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonButtonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Duration="0" To="#FFC2E0FF" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Storyboard.TargetName="border"/>
                                        <ColorAnimation Duration="0" To="#FF3399FF" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Storyboard.TargetName="border"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed"/>
                                <vsm:VisualState x:Name="UnChecked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemCheckedBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".5"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="ItemBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" MinHeight="22">
                            <Grid>
                                <Border x:Name="border"  BorderThickness="1" Background="Transparent" BorderBrush="Transparent"/>
                                <Border x:Name="InnerBorder" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="2" x:Name="PART_Text" Grid.Column="1" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="True"
                                                   FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" 
                                                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                                                   Text="{TemplateBinding Label}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                                        <Path Grid.Column="2" Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z " Fill="{StaticResource Foreground}" HorizontalAlignment="Center" Height="4" Margin="3" Stretch="Uniform" VerticalAlignment="Center" Width="8"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw" Color="Transparent" >
                                <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                <Border Background="White" BorderThickness="1" BorderBrush="{StaticResource OverflowPopupBorderBrush}" CornerRadius="0">                                    
                                        <ContentPresenter/>                                 
                                </Border>
                            </Grid>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" SourceName="PART_DropDown" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5"/>
                            <Setter Property="Color" TargetName="Shdw" Value="#71000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="DefaultMenuItemHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEFF7FA" Offset="0.053"/>
        <GradientStop Color="#FFBEE5F6" Offset="0.947"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FF96D9F9" x:Key="DefaultMenuItemHoverBorderBrush"/>
    <Style TargetType="shared:DropDownMenuItem" x:Key="MenuItemStyle">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:DropDownMenuItem">
                    <Grid Margin="1">
                        <Grid.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>                        

                        <Border CornerRadius="2" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <Grid Margin="0,0,0,-2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <ContentControl Content="{TemplateBinding Header}" Grid.Column="2" Margin="6 2 2 2"/>
                                <ContentControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="3" Margin="3" FontSize="14"/>
                                <Border Margin="2" CornerRadius="2" Grid.Column="1">
                                    <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                                </Border>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" CornerRadius="0" Background="#FFCEEDFA" BorderBrush="#FF307FB1" BorderThickness="1">
                                    <Path x:Name="CheckIcon" 
                                          Data="M92,307 L106,322 136.61635,291.20421 132.61635,286.20421 107,311.5 98,302 z" 
                                          Fill="#FF000000" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                            <Grid Opacity="0" x:Name="PART_poup">
                                <Border Background="White" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <ItemsPresenter />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource DefaultMenuItemHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource DefaultMenuItemHoverBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

