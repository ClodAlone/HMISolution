<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
					
	
    <LinearGradientBrush x:Key="TrayBackColor" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE6F0FA" Offset="0.102"/>
        <GradientStop Color="#FFD8E5F3" Offset="0.728"/>
    </LinearGradientBrush>
    <Style x:Key="ToolBarTrayAdvStyle" TargetType="{x:Type tools:ToolBarTrayAdv}">
        <Setter Property="Background" Value="{StaticResource TrayBackColor}"/>       
    </Style>

    <Style BasedOn="{StaticResource ToolBarTrayAdvStyle}" TargetType="tools:ToolBarTrayAdv"/>
    
</ResourceDictionary>