    <!-- Brushes -->
    <SolidColorBrush x:Key="TileViewItemHeaderBackgroundBrushKey.Blend" Color="#FF5A595A"/>
    <SolidColorBrush x:Key="TileViewItemHeaderBorderBrushKey.Blend" Color="#FF5A595A"/>
    <SolidColorBrush x:Key="TileViewItemBorderBrushKey.Blend" Color="#FF5A595A"/>
    <SolidColorBrush x:Key="TileViewItemTextBrushKey.Blend" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileViewItemBackgroundBrushKey.Blend" Color="#FF808080"/>
