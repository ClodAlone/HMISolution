                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Name="OuterBorder" VerticalAlignment="Center" Height="30"  HorizontalAlignment="Center" CornerRadius="2" Margin="0,0,0,0" Background="Transparent" BorderBrush="Transparent" Width="30" BorderThickness="1" SnapsToDevicePixels="True">
