                                            <Path Stretch="Uniform" x:Name="path1" Fill="{DynamicResource  MetroForegroundBrush}" Height="4" Width="7" Data="F1 M 531.107,321.943L 541.537,321.943L 536.322,328.042L 531.107,321.943 Z " HorizontalAlignment="Center" VerticalAlignment="Center" />
