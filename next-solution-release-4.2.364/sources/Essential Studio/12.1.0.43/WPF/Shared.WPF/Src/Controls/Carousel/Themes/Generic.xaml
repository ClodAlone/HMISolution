<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Shared">


    <Style x:Key="CarouselItemStyle" TargetType="local:CarouselItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CarouselItem">
                    <Grid>
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}" 
                				ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource CarouselItemStyle}" TargetType="local:CarouselItem"/>

    <Style x:Key="CarouselStyle" TargetType="local:Carousel">
        <Style.Triggers>
            <Trigger Property="VisualMode" Value="CustomPath">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:CustomPathCarouselPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger >
            <Trigger Property="VisualMode" Value="Standard">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:CarouselPanel RotationSpeed="{Binding RotationSpeed, RelativeSource={RelativeSource AncestorType={x:Type local:Carousel}}}" RadiusX="{Binding RadiusX, RelativeSource={RelativeSource AncestorType={x:Type local:Carousel}}}"
                                          RadiusY="{Binding RadiusY, RelativeSource={RelativeSource AncestorType={x:Type local:Carousel}}}" ScaleFraction="{Binding ScaleFraction, RelativeSource={RelativeSource AncestorType={x:Type local:Carousel}}}" OpacityFraction="{Binding OpacityFraction, RelativeSource={RelativeSource AncestorType={x:Type local:Carousel}}}"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

        </Style.Triggers>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Carousel">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter x:Name="ItemsPresenter" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:CustomPathCarouselPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style BasedOn="{StaticResource CarouselStyle}" TargetType="local:Carousel"/>

</ResourceDictionary>
