<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <LinearGradientBrush x:Key="ButtonAdvBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDBE2E4" Offset="0.395"/>
        <GradientStop Color="#FFD2D9DB" Offset="0.401"/>
        <GradientStop Color="#FFE0E5E7" Offset="0.952"/>
        <GradientStop Color="#FFEDF0F1" Offset="0.959"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonAdvBorderBrush" Color="#FFB0B8BB"/>

    <SolidColorBrush x:Key="ButtonAdvForeground" Color="#FF464646"/>

    <LinearGradientBrush x:Key="ButtonAdvHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCD9" Offset="0.027"/>
        <GradientStop Color="#FFFFE790" Offset="0.368"/>
        <GradientStop Color="#FFFFD74C" Offset="0.37"/>
        <GradientStop Color="#FFFFD448" Offset="0.596"/>
        <GradientStop Color="#FFFFE693" Offset="0.953"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonAdvHoverBorderBrush" Color="#FFDDCF9B"/>
    <SolidColorBrush x:Key="ButtonAdvHoverForeground" Color="#FF464646"/>

    <LinearGradientBrush x:Key="ButtonAdvPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF3C799" Offset="0.011"/>
        <GradientStop Color="#FFFCD3A7" Offset="0.013"/>
        <GradientStop Color="#FFFAA85B" Offset="0.371"/>
        <GradientStop Color="#FFF98E2A" Offset="0.373"/>
        <GradientStop Color="#FFFCDF94" Offset="0.939"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonAdvPressedBorderBrush" Color="#FF8E8165"/>

    <LinearGradientBrush x:Key="ButtonAdvCheckedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFC973D" Offset="0.04"/>
        <GradientStop Color="#FFFFAB3F" Offset="0.544"/>
        <GradientStop Color="#FFFFB85E" Offset="0.993"/>
        <GradientStop Color="#FFFB8C3C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvCheckedBorderBrush" Color="#FFFB8C3C"/>
<LinearGradientBrush x:Key="Office2007BlueButtonAdvCheckedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFEDBB2" Offset="0.089"/>
        <GradientStop Color="#FFFCCE86" Offset="0.486"/>
        <GradientStop Color="#FFFABA55" Offset="0.491"/>
        <GradientStop Color="#FFFDE597" Offset="0.948"/>
        <GradientStop Color="#FFFCD17C" Offset="0.996"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFA78E66" x:Key="Office2007BlueCheckedBorderBrush"/>
    <Style x:Key="Office2007BlackButtonAdvStyle" TargetType="local:ButtonAdv">
        <Setter Property="Foreground" Value="{StaticResource ButtonAdvForeground}" />
        <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
        <Setter Property="Label" Value="ButtonAdv"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource ButtonAdvBackgroundBrush}"/>
        
        <Setter Property="BorderBrush" Value="{StaticResource ButtonAdvBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ButtonAdv">
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">

                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="11,8,11,8"/>
                            <Setter Property="IconHeight" Value="20"/>
                            <Setter Property="IconWidth" Value="20"/>
                            <Setter Property="Border.CornerRadius"  TargetName="ItemBorder" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder1" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder1" Value="6"/>
                            <Setter Property="Border.Margin" TargetName="smallImage" Value="0,2,2,2"/>

                            <Setter Property="Image.Height" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Width" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Border.Effect" TargetName="ItemBorder">
                                <Setter.Value>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Border.Effect" TargetName="ItemBorder1">
                                <Setter.Value>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Border.Margin" TargetName="PART_Text" Value="5,0,2,0"/>

                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            </MultiTrigger.Conditions>

                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource ButtonAdvHoverBorderBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvHoverBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                        </Trigger>
                        
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
								<Condition Property="IsCheckable" Value="True"/>
                                <Condition Property="IsChecked" Value="True"></Condition>
                                <Condition Property="IsEnabled" Value="True"></Condition>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource Office2007BlueButtonAdvCheckedBackgroundBrush}"/>
                                <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource Office2007BlueCheckedBorderBrush}"/>
                                <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource Office2007BlueButtonAdvCheckedBackgroundBrush}"/>
                                <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource Office2007BlueButtonAdvCheckedBackgroundBrush}"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>


                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                            <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <Border x:Name="ItemCheckedBorder" CornerRadius="3" Opacity="0"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{StaticResource ButtonAdvCheckedBackgroundBrush}" 
                                BorderBrush="{StaticResource ButtonAdvCheckedBorderBrush}"/>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True" CornerRadius="3">
                            <Grid Margin="{TemplateBinding Padding}" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Name="PART_ImageBorder" Grid.Column="0">
                                    <Image Margin="2" x:Name="smallImage"
						            Width="{Binding Path=IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ButtonAdv}}}" Height="{Binding Path=IconHeight,RelativeSource={RelativeSource AncestorType={x:Type local:ButtonAdv}}}"   
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <AccessText Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" Margin="2,0,4,0"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           />
                            </Grid>
                        </Border>
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True">
                            <StackPanel Margin="{TemplateBinding Padding}">
                                <Border Name="PART_ImageBorderLarge">
                                    <Image Margin="2" x:Name="LargeImage"
						            Width="26" Height="26"   
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <ItemsControl x:Name="PART_TextAreaLarge" Margin="2,0,4,0"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}" IsTabStop="False"
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2007BlackButtonAdvStyle}" TargetType="local:ButtonAdv"/>

</ResourceDictionary>