<UserControl x:Class="Syncfusion.Windows.Tools.Controls.PrintPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"   
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" d:DesignHeight="336" d:DesignWidth="540">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="MainGrid" Height="Auto" Margin="0,0,0,0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="toolBarGridRow" Height="28"/>
                <RowDefinition x:Name="parameterGridRow" Height="Auto"/>
                <RowDefinition x:Name="viewerContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!--Toolbar-->
            <StackPanel Name="toolBar" Height="28" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0">
                <StackPanel.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFFEFBF4" Offset="0.027"/>
                        <GradientStop Color="#FFEAEEEF" Offset="0.029"/>
                        <GradientStop Color="#FFDCE4F1" Offset="0.498"/>
                        <GradientStop Color="#FFE6EAF3" Offset="0.966"/>
                        <GradientStop Color="FloralWhite" Offset="0.968"/>
                        <GradientStop Color="#FFD4DBEB" Offset="0.503"/>
                    </LinearGradientBrush>
                </StackPanel.Background>

                <!--Print-->
                <Button Style="{StaticResource ButtonStyle}" Name="buttonPrint" Width="22" Height="22" IsEnabled="True" Margin="2,3,2,3"  Click="buttonprint_Click">
                    <Image Source="{StaticResource PrintDisabled}" Stretch="None"/>
                    <!--PrintDisabled-->
                </Button>

                <Rectangle HorizontalAlignment="Center"  Height="21.599" VerticalAlignment="Center" Width="1.6">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.662,0.5" StartPoint="0.338,0.5">
                            <GradientStop Color="#FFBCBCBC" Offset="0.508"/>
                            <GradientStop Color="White" Offset="0.525"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--Navigate to First-->
                <Button Style="{StaticResource ButtonStyle}" Name="buttonFirst" Width="22" Height="22"  IsEnabled="False" Margin="0,3,0,3" Click="buttonFirst_Click">
                    <Image Source="{StaticResource First_NavDisabled}" Stretch="None"/>
                    <!--First_NavDisabled-->
                </Button>

                <!--Navigate to Previous-->
                <Button Style="{StaticResource ButtonStyle}" Name="buttonPrevious" Width="22" Height="22" IsEnabled="False" Margin="2,3,2,3" Click="buttonPrevious_Click">
                    <Image Source="{StaticResource Previous_NavDisabled}"/>
                    <!--Previous_NavDisabled-->
                </Button>

                <!--Current Page-->
                <TextBox Name="textBoxCurrentPage" Width="60" Height="22" IsReadOnly="False" IsEnabled="False" BorderBrush="Gray" Margin="2,3,2,3" >
                </TextBox>
                <TextBlock Name="labelOf" Width="Auto" VerticalAlignment="Center" Margin="2,3,5,3">of</TextBlock>

                <!--Totla number of pages-->
                <TextBlock Name="textBoxTotalPages" Width="Auto" xml:space="preserve"  Margin="2,3,5,3" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

                <!--Navigate to Next-->
                <Button Style="{StaticResource ButtonStyle}" Name="buttonNext" Width="22" Height="22" IsEnabled="False" Margin="2,3,2,3" Click="buttonNext_Click">
                    <Image Source="{StaticResource Next_Nav}" Stretch="None"/>
                    <!--Next_NavDisabled-->
                </Button>

                <!--Navigate to Last-->
                <Button Style="{StaticResource ButtonStyle}" Name="buttonLast" Width="22" Height="22" IsEnabled="False" Margin="2,3,2,3" Click="buttonLast_Click">
                    <Image Source="{StaticResource Last_Nav}" Stretch="None"/>
                    <!--Last_NavDisabled-->
                </Button>

                <Rectangle HorizontalAlignment="Center"  Height="21.599" VerticalAlignment="Center" Width="1.6">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.662,0.5" StartPoint="0.338,0.5">
                            <GradientStop Color="#FFBCBCBC" Offset="0.508"/>
                            <GradientStop Color="White" Offset="0.525"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--Zooming-->
                <Border Name="comboBoxExternalBorder" BorderBrush="Gray" Width="70" Height="22" BorderThickness="0" Margin="2,3,2,3">
                    <ComboBox Name="comboBoxPageZoom" Width="70" Height="22"  SelectedIndex="3">
					    <ComboBoxItem>25%</ComboBoxItem>
                        <ComboBoxItem>50%</ComboBoxItem>
                        <ComboBoxItem>75%</ComboBoxItem>
                        <ComboBoxItem>100%</ComboBoxItem>
                        <ComboBoxItem>125%</ComboBoxItem>
                        <ComboBoxItem>150%</ComboBoxItem>
                        <ComboBoxItem>200%</ComboBoxItem>
                        <ComboBoxItem>300%</ComboBoxItem>
                        <ComboBoxItem>400%</ComboBoxItem>
                    </ComboBox>
                </Border>

                <!--Print Setup-->
                <Button Style="{StaticResource ButtonStyle}" Name="PageLayout" Width="22" Height="22" IsEnabled="True"  Visibility="Visible" Click="PageLayout_Click">
                    <Image Source="{StaticResource PageLayout}" Stretch="None"/>
                    <!--PrintSetupDisabled-->
                </Button>
                
        </StackPanel>
            <Grid Name="gridRenderingRegion" Background="LightGray" Grid.Row="2" Height="Auto" Margin="0,0,0,0">
                <!--Viewer Page-->
                <ScrollViewer x:Name="scrollViewer" Grid.Row="0" Height="Auto" Width="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Vertical" Name="PageView" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20" Height="300" Width="400">
                        <StackPanel.LayoutTransform>
                            <ScaleTransform x:Name="Zoom"></ScaleTransform>
                        </StackPanel.LayoutTransform>
                        <Grid x:Name="renderArea">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                       
                        <ContentControl x:Name="renderHeader" Background="Transparent" Grid.Row="0"/>
                        <ContentControl x:Name="renderCanvas" Background="Transparent" Grid.Row="1"/>
                        <ContentControl x:Name="renderFooter" Background="Transparent" Grid.Row="2"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>