<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Shared"
                    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
>

    <local:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <LinearGradientBrush x:Key="Office2010BlackRepeatButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE2E2E2" Offset="0.078" />
        <GradientStop Color="#FFC4C4C4" Offset="0.968" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2010BlackRepeatButtonBorderBrush" Color="#FF6A6A6A" />

    <SolidColorBrush x:Key="Office2010BlackRepeatButtonForeground" Color="#FF3B3B3B" />
    <LinearGradientBrush x:Key="Office20010BlackRepeateButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFECDB98" Offset="0.043" />
        <GradientStop Color="#FFECD37B" Offset="0.351" />
        <GradientStop Color="#FFEED885" Offset="0.594" />
        <GradientStop Color="#FFF3E7B0" Offset="0.723" />
        <GradientStop Color="#FFF6F3D9" Offset="0.969" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office20010BlackRepeatButtonMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDEB745" Offset="0.088" />
        <GradientStop Color="#FFE4C538" Offset="0.852" />
    </LinearGradientBrush>

    <SolidColorBrush Color="#FFFFE48A" x:Key="Office20010BlackRepeatButtonPressedBackground" />

    <LinearGradientBrush x:Key="Office20010BlackRepeatButtonPressedBorderBrush"   EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC2762B" Offset="0" />
        <GradientStop Color="#FFC29E47" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office20010BlackRepeatButtonPathBackground" Color="#FF586585" />

    <LinearGradientBrush x:Key="Office2010BlackRepeatButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFECDB98" Offset="0.043" />
        <GradientStop Color="#FFECD37B" Offset="0.351" />
        <GradientStop Color="#FFEED885" Offset="0.594" />
        <GradientStop Color="#FFF3E7B0" Offset="0.723" />
        <GradientStop Color="#FFF6F3D9" Offset="0.969" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackRepeatButtonMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDEB745" Offset="0.088" />
        <GradientStop Color="#FFE4C538" Offset="0.852" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office20010BlackRepeatButtonPathBorderBrush" Color="White" />
    <ControlTemplate x:Key="RepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
        <Border Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="true">
            <Border Name="innerBorder" BorderBrush="{TemplateBinding Background}"  Margin="1" BorderThickness="0" CornerRadius="0" SnapsToDevicePixels="True">

                <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Office2010BlackRepeatButtonMouseOverBorderBrush}" />
                <Setter TargetName="Chrome" Property="Background" Value="#FFFDF9E8" />

                <Setter TargetName="innerBorder" Property="Background" Value="{StaticResource Office2010BlackRepeatButtonMouseOverBackground}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Office20010BlackRepeatButtonPressedBorderBrush}" />
                <Setter TargetName="innerBorder" Property="Background" Value="{StaticResource Office20010BlackRepeatButtonPressedBackground}" />
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Office20010BlackRepeatButtonPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Repeat Button Style -->
    <Style x:Key="RepeatButtonStyle"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Background"
                Value="{StaticResource Office2010BlackRepeatButtonBackground}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource Office2010BlackRepeatButtonBorderBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource Office2010BlackRepeatButtonForeground}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="1" />
        <Setter Property="Template" Value="{StaticResource RepeatButtonTemplate}" />
    </Style>
    <SolidColorBrush x:Key="Office2010BlackTimeSpanEditBorderBrush" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="Office2010BlackTimeSpanEditBackground" Color="#FFC6C6C6" />
    <SolidColorBrush x:Key="Office2010BlackTimeSpanEditForeground" Color="Black" />
    <LinearGradientBrush x:Key="Office2010BlackPathFillBrush" EndPoint="0.614,0.647" StartPoint="0.129,0.118">
        <GradientStop Color="#FF757779" Offset="0" />
        <GradientStop Color="#FF505153" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Office2010BlackTimeSpanEditStyle" TargetType="{x:Type  local:TimeSpanEdit}">
        <Setter Property="Foreground" Value="{StaticResource Office2010BlackTimeSpanEditForeground}" />
        <Setter Property="Background" Value="{StaticResource Office2010BlackTimeSpanEditBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlackTimeSpanEditBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="AllowDrop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeSpanEdit}">

                    <Border  x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"  SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <RepeatButton x:Name="upbutton" IsTabStop="False" Visibility="{Binding ShowArrowButtons, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding Path=UpCommand, RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="0"   Style="{StaticResource RepeatButtonStyle}" Width="17">
                                    <Path Stretch="Uniform" x:Name="upbuttonpath" Width="8" Height="4" Fill="{StaticResource Office2010BlackPathFillBrush}" Data="F1 M 541.537,173.589L 531.107,173.589L 536.322,167.49L 541.537,173.589 Z " HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
                                    </Path>
                                </RepeatButton>
                                <RepeatButton x:Name="downbutton" IsTabStop="False" Visibility="{Binding ShowArrowButtons, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding Path=DownCommand, RelativeSource={RelativeSource TemplatedParent}}"  Grid.Row="1" Style="{StaticResource RepeatButtonStyle}" Width="17">
                                    <Path Stretch="Uniform" x:Name="downbuttonpath" Fill="{StaticResource Office2010BlackPathFillBrush}" Height="4" Width="8" Data="F1 M 531.107,321.943L 541.537,321.943L 536.322,328.042L 531.107,321.943 Z " HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
                                    </Path>
                                </RepeatButton>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" TargetName="Bd" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="White" />
                        </Trigger>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="1,8" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Width" TargetName="upbutton" Value="40" />
                            <Setter Property="Width" TargetName="downbutton" Value="40" />
                            <Setter Property="Height" TargetName="upbutton" Value="25" />
                            <Setter Property="Height" TargetName="downbutton" Value="25" />
                            <Setter Property="Width" TargetName="upbuttonpath" Value="12" />
                            <Setter Property="Width" TargetName="downbuttonpath" Value="12" />
                            <Setter Property="Height" TargetName="downbuttonpath" Value="8" />
                            <Setter Property="Height" TargetName="upbuttonpath" Value="8" />
                            <Setter Property="EnableTouch" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2010BlackTimeSpanEditStyle}" TargetType="{x:Type local:TimeSpanEdit}" />
</ResourceDictionary>