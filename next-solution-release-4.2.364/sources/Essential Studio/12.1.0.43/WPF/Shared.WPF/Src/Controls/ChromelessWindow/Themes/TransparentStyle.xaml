    <ControlTemplate x:Key="TransparentTitleBarTemplate" TargetType="{x:Type local:TitleBar}">
        <Border Name="border"  Height="25"  CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius,Converter={StaticResource CRConvert},ConverterParameter=Top}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter x:Name="content" VerticalAlignment="Bottom"  Margin="0,0,0,0" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="true">
                <Setter TargetName="content" Property="VerticalAlignment" Value="Center" />
                <Setter TargetName="border" Property="Height" Value="50" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <SolidColorBrush Color="#FFDEDEDE" x:Key="TransparentTitleBarInActiveBackground" />
