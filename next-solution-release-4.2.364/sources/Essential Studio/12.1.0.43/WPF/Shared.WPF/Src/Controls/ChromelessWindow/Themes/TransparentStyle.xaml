        <Setter Property="ResizeGripStyle" Value="{StaticResource ResizeStyle}" />
        <Setter Property="ResizeBorderThickness" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Icon" Value="..\Resources\app.png" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="TitleBarForeground" Value="{StaticResource  TransparentWindowForeground}" />
        <Setter Property="Foreground" Value="{StaticResource  TransparentWindowForeground}" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="TitleBarBackground" Value="{StaticResource TransparentTitleBarBackground}" />
        <Setter Property="Background" Value="{StaticResource TransparentWindowBackground}" />
        <Setter Property="BorderBrush" Value="#FFCCCCCC" />
