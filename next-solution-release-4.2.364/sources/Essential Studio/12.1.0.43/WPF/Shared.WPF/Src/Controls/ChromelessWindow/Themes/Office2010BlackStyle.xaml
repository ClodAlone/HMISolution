                    <Path Stretch="Fill" Fill="#FFDADEE1" Data="F1 M 786.838,345.628L 786.838,351.15L 792.359,351.15L 792.359,345.628L 786.838,345.628 Z M 790.497,349.295L 788.671,349.295L 788.671,348.375L 790.497,348.375L 790.497,349.295 Z " Height="5.522"  Width="5.522" Canvas.Left="0.921" Canvas.Top="3.666" />
                    <Path Stretch="Fill" Fill="#FF505860" Data="F1 M 787.758,347.454L 787.758,350.215L 791.425,350.215L 791.425,347.454L 787.758,347.454 Z M 790.497,349.295L 788.671,349.295L 788.671,348.375L 790.497,348.375L 790.497,349.295 Z " Height="2.761"  Width="3.667" Canvas.Left="1.841" Canvas.Top="5.492" />
                </Canvas>
                <Grid Margin="0,3,0,0" x:Name="touchpath" Visibility="Collapsed">
                    <Path Data="M9.5,7.4999999 L9.5,12.5 20.5,12.5 20.5,7.4999999 z M0.5,0.5 L29.5,0.5 29.5,19.5 0.5,19.5 z" Fill="#FFD5D5D5" HorizontalAlignment="Center" Height="10" Stretch="Fill" Stroke="#FF525565" VerticalAlignment="Center" Width="12" Margin="5,-6,0,0" SnapsToDevicePixels="True" />
                    <Path Data="M9.5,7.4999999 L9.5,12.5 20.5,12.5 20.5,7.4999999 z M0.5,0.5 L29.5,0.5 29.5,19.5 0.5,19.5 z" Fill="#FFD5D5D5" Height="10" Width="12" Stretch="Fill" Stroke="#FF525565" VerticalAlignment="Center" Margin="5.5,0.7,15.5,0" SnapsToDevicePixels="True" />
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger  Property="local:SkinStorage.EnableTouch" Value="true">
