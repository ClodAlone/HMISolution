        <Border Name="maxborder" BorderThickness="1" CornerRadius="0" Background="Transparent" Margin="0,1,0,2" Height="25" Width="25" SnapsToDevicePixels="True">
            <Grid>
                <Canvas x:Name="path" HorizontalAlignment="Center" Height="10" VerticalAlignment="Center" Width="11" SnapsToDevicePixels="True" Margin="2,0,0,0">
                    <Path Stretch="Fill" Fill="#FF525565" Data="F1 M 650.498,303.533L 650.498,312.455L 661.497,312.455L 661.497,303.533L 650.498,303.533 Z M 657.498,308.494L 654.498,308.494L 654.498,307.494L 657.498,307.494L 657.498,308.494 Z " Height="8.922"  Width="10.999" />
                    <Path Stretch="Fill" Fill="#FFD5D5D5" Data="F1 M 651.466,304.494L 651.466,311.494L 660.529,311.494L 660.529,304.494L 651.466,304.494 Z M 657.498,308.494L 654.498,308.494L 654.498,307.494L 657.498,307.494L 657.498,308.494 Z " Height="7"  Width="9.063" Canvas.Left="0.968" Canvas.Top="0.961" />
                    <Path Stretch="Fill" Fill="#FF525565" Data="F1 M 653.498,306.494L 653.498,309.494L 658.498,309.494L 658.498,306.494L 653.498,306.494 Z M 657.498,308.479L 654.498,308.479L 654.498,307.479L 657.498,307.479L 657.498,308.479 Z " Height="3"  Width="5" Canvas.Left="3" Canvas.Top="2.961" />
                </Canvas>
                <Path Visibility="Collapsed"  x:Name="touchpath" Data="M9.5,7.4999999 L9.5,12.5 20.5,12.5 20.5,7.4999999 z M0.5,0.5 L29.5,0.5 29.5,19.5 0.5,19.5 z" Fill="#FFD5D5D5" HorizontalAlignment="Center" Height="15" Stretch="Fill" Stroke="#FF525565" VerticalAlignment="Center" Width="20" SnapsToDevicePixels="True" Margin="0,-1,0,0" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger  Property="local:SkinStorage.EnableTouch" Value="true">
                <Setter Property="Height" TargetName="maxborder" Value="35" />
                <Setter Property="Width" TargetName="maxborder" Value="35" />
                <Setter Property="Visibility" Value="Visible" TargetName="touchpath" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="path" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="maxborder" Property="Background" Value="{StaticResource Office2010BlackMouseOverBackground}" />
                <Setter TargetName="maxborder" Property="BorderBrush" Value="{StaticResource Office2010BlackMouseOverBorderBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="maxborder" Property="Background" Value="{StaticResource Office2010BlackPressedBackground}" />
                <Setter TargetName="maxborder" Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

