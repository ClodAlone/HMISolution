<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">



    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/MetroThemeBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>



    <Style x:Key="MetroButtonAdvStyle" TargetType="local:ButtonAdv">
            <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
            <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
            <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
            <Setter Property="Label" Value="ButtonAdv"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource MetroBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:ButtonAdv">
                        <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">

                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="IconHeight" Value="20"/>
                            <Setter Property="IconWidth" Value="20"/>
                            <Setter Property="Border.CornerRadius"  TargetName="ItemBorder" Value="0"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder1" Value="0"/>
                       
                            <Setter Property="Border.Margin" TargetName="smallImage" Value="0,2,2,2"/>

                            <Setter Property="Image.Height" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Width" TargetName="LargeImage" Value="30"/>
                           
                            <Setter Property="Border.Margin" TargetName="PART_Text" Value="5,0,0,0"/>

                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IconHeight" Value="0"/>
                                <Condition Property="IconWidth" Value="0"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            </MultiTrigger.Conditions>

                            <Setter Property="Border.Margin" TargetName="PART_Text" Value="0"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            </MultiTrigger.Conditions>

                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroHoverBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroHoverBrush}"/>



                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{DynamicResource MetroFocusedBorderBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{DynamicResource MetroFocusedBorderBrush}"/>
                            <Setter Property="TextElement.Foreground" TargetName="PART_Text" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <Setter Property="TextElement.Foreground" TargetName="PART_TextAreaLarge" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <Setter Property="Foreground"  Value="{DynamicResource MetroHighlightedForegroundBrush}"/>

                        </Trigger>
                         <MultiTrigger>
                            <MultiTrigger.Conditions>
								<Condition Property="IsCheckable" Value="True"/>
                                <Condition Property="IsChecked" Value="True"></Condition>
                                <Condition Property="IsEnabled" Value="True"></Condition>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroBrush}"/>
                                <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroBrush}"/>
                                <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{DynamicResource MetroFocusedBorderBrush}"/>
                                <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{DynamicResource MetroFocusedBorderBrush}"/>
                                <Setter Property="TextElement.Foreground" TargetName="PART_Text" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                                <Setter Property="TextElement.Foreground" TargetName="PART_TextAreaLarge" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            </MultiTrigger.Setters>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                                <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                        <Grid >
                            <Grid.Resources>
                                <local:MultiLineConverter x:Key="TextConverter"/>
                            </Grid.Resources>
                            <Border x:Name="ItemCheckedBorder"  Opacity="0"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{DynamicResource  MetroBrush}" 
                                BorderBrush="{DynamicResource  MetroFocusedBorderBrush}"/>
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True">
                              
                                    <Grid Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Name="PART_ImageBorder" Grid.Column="0">
                                            <Image Margin="2" x:Name="smallImage"
						            Width="{Binding Path=IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ButtonAdv}}}" Height="{Binding Path=IconHeight,RelativeSource={RelativeSource AncestorType={x:Type local:ButtonAdv}}}"   
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Border>
                                        <AccessText Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           Margin="2,0,4,0"/>
                                    </Grid>
                          
                            </Border>
                            <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True">
                                
                                    <StackPanel Margin="{TemplateBinding Padding}">
                                        <Border Name="PART_ImageBorderLarge">
                                            <Image Margin="2" x:Name="LargeImage"
						            Width="26" Height="26"   
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Border>
                                        <ItemsControl x:Name="PART_TextAreaLarge" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}" IsTabStop="False"
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               Margin="2,0,4,0"/>
                                    </StackPanel>
                      
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource MetroButtonAdvStyle}" TargetType="local:ButtonAdv"/>


    

</ResourceDictionary>