    <SolidColorBrush x:Key="VS2010ToolBarOuterBackgroundBrush" Color="#FFD5DCE8"/>
    <SolidColorBrush Color="#FFBCC7D8" x:Key="VS2010ToolBarAdvBackground" />
    <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}" x:Key="VerticalTemplate">
        <Border x:Name="mainborder" Background="{StaticResource VS2010ToolBarOuterBackgroundBrush}" CornerRadius="3" BorderThickness="1" BorderBrush="#FFB5BECE">
            <vsm:VisualStateManager.VisualStateGroups>
                <vsm:VisualStateGroup x:Name="Orientation">                   
                </vsm:VisualStateGroup>
            </vsm:VisualStateManager.VisualStateGroups>
            <Grid>               
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="row0"  Height="*"></RowDefinition>
                   
                    <RowDefinition x:Name="row1" Height="10"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Background="{TemplateBinding Background}" BorderThickness="0" BorderBrush="{StaticResource VS2010ToolBarOuterBackgroundBrush}" CornerRadius="3">
                    <Grid>
 <Grid.RowDefinitions>
                    <RowDefinition   Height="8"></RowDefinition>
                    <RowDefinition  Height="*"></RowDefinition>

                </Grid.RowDefinitions>
                    <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="2 3 4 2" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                    <Path x:Name="verticalGripper" SnapsToDevicePixels="True"  Data="M12.5,0.5 L13.5,0.5 L13.5,1.5 L12.5,1.5 z M8.5,0.5 L9.5,0.5 L9.5,1.5 L8.5,1.5 z M4.5,0.5 L5.5,0.5 L5.5,1.5 L4.5,1.5 z M0.5,0.5 L1.5,0.5 L1.5,1.5 L0.5,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="2" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="14"/>
                    </Grid>
                        
                <shared:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Row="1"></shared:ToolBarPanelAdv>
                    </Grid>
                </Border>
                <ToggleButton x:Name="PART_OverflowButton"   Grid.Row="1" Style="{StaticResource OverflowButtonStyle1}">
