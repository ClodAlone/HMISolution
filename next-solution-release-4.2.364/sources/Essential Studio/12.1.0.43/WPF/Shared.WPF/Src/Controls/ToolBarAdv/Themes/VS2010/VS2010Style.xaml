                        <Grid x:Name="verticalPath">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="verticalDownPath" Data="M0.5,20.5 L0.5,0.5 L13.499992,10.582473 z" Grid.Column="2" Fill="#FF1B293E" HorizontalAlignment="Left" Margin="0,0,4,0" Height="4.6" Stretch="Fill" Stroke="#FF1B293E" Width="3"/>
                            <Path x:Name="verticalDownPath1" Data="M0.5,0.5 L0.5,20" Fill="#FF1B293E" Grid.Column="1" HorizontalAlignment="Right" Height="6" Margin="0,0,2,0" Stretch="Fill" Stroke="#FF1B293E" Width="1"/>
                            <Path x:Name="verticalTopOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="#FF1B293E" Margin="3,0,3,2" HorizontalAlignment="Left" Height="2" Stretch="Fill" Stroke="#FF1B293E" VerticalAlignment="Top" Width="2.5"/>
                            <Path x:Name="verticalBottomOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="#FF1B293E" Margin="3,4,3,0" HorizontalAlignment="Left" Height="2" Stretch="Fill" Stroke="#FF1B293E" VerticalAlignment="Bottom"  Width="2.5"/>
