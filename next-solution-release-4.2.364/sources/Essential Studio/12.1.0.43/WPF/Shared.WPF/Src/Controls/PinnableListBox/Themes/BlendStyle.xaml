<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Shared">

    <SolidColorBrush x:Key="BlendBackground" Color="#FF333333"/>
    
    <SolidColorBrush x:Key="BlendBorderBrush" Color="#FF333333"/>
    
    <SolidColorBrush x:Key="BlendForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="BlendHoverBrush" Color="#FF4A4A4A"/>

    <SolidColorBrush x:Key="BlendPressedBrush" Color="#FFBDBDBD"/>
    
    <SolidColorBrush x:Key="BlendSelectedText" Color="#FF000000"/>

    <local:StringToVisibility x:Key="strconv"/>

    <local:CountToVisibilityConverter x:Key="countconv"/>

    <!--<ContextMenu x:Key="UnpinContextMenu">
        <MenuItem Header="Pin to list" Command="{x:Static local:PinnableListBoxItem.PinCommand}"/>
        <MenuItem Header="_Remove from list" Command="{x:Static local:PinnableListBoxItem.RemoveCommand}"/>
        <MenuItem Header="Cl_ear unpinned Documents" Command="{x:Static local:PinnableListBoxItem.ClearCommand}"/>
    </ContextMenu>-->

    <Style x:Key="BlendPinnableListBoxStyle" TargetType="{x:Type local:PinnableListBox}">
        <Setter Property="Background" Value="{StaticResource BlendBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlendBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BlendForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PinnableListBox}">
                    <Grid x:Name="PART_Grid">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Header}" Margin="2" FontWeight="Bold"/>

                                <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" 
                                      Stroke="#FF4D4949" StrokeThickness="1" Margin="2" Grid.Row="1" Stretch="Uniform" Opacity="0"
                                      Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource strconv}}"/>

                                <ScrollViewer Grid.Row="2" Margin="2" Padding="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <local:PinnableItemsControl ItemsSource="{Binding PinnedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    x:Name="PART_PinnedItems" IsPinnedContainer="True">

                                        </local:PinnableItemsControl>

                                        <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" StrokeDashArray="1.7"
                                                  Stroke="#FF4D4949" StrokeThickness="1" Margin="2" Grid.Row="1" Stretch="Uniform" Opacity="0.3"
                                                  x:Name="pinline" 
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PinnedItems.Count, Converter={StaticResource countconv}}"/>

                                        <local:PinnableItemsControl Grid.Row="2" ItemsSource="{Binding UnpinnedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    x:Name="PART_UnpinnedItems">

                                        </local:PinnableItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendPinnableListBoxStyle}" TargetType="{x:Type local:PinnableListBox}"/>

    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OuterBorder"                               
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            >
                            <Grid >
                                <Rectangle x:Name="InnerPath" RadiusX="3" RadiusY="3"/>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                    </Grid>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource BlendHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource BlendPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>

        </Setter>
    </Style>

    <Style x:Key="BlendPinnableListBoxItemStyle" TargetType="{x:Type local:PinnableListBoxItem}">
        <Setter Property="Padding" Value="2"/>
        <!--<Setter Property="ContextMenu" Value="{StaticResource UnpinContextMenu}"/>-->
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PinnableListBoxItem}">
                    <Border x:Name="OuterBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Rectangle x:Name="InnerPath" RadiusX="3" RadiusY="3" Grid.RowSpan="2" Grid.Column="1"/>
                                <Grid  Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{TemplateBinding Icon}" Grid.RowSpan="2" Margin="2 2 18 2"/>
                                    <ContentPresenter VerticalAlignment="Center" Grid.Column="1" Margin="1 2 2 1"/>
                                    <TextBlock TextTrimming="WordEllipsis" Text="{TemplateBinding Description}" Grid.Row="1" Margin="1 1 2 2"
                                               Foreground="{StaticResource BlendForeground}" VerticalAlignment="Center" Grid.Column="1" x:Name="textContent"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Description, Converter={StaticResource strconv}}"/>
                                </Grid>
                            </Grid>
                            <Button Grid.Column="1" BorderThickness="1" BorderBrush="Transparent" x:Name="pinnedButton"
                                                 Command="{x:Static local:PinnableListBoxItem.PinCommand}"
                                                 Style="{StaticResource ButtonStyle}" Width="20" Padding="0 10">
                                <Image Source="/Syncfusion.Shared.Wpf;component/Controls/PinnableListBox/unpinned.png" Width="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" x:Name="pin"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="OuterBorder"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource BlendHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="pinnedButton"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource BlendHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource BlendPressedBrush}"/>
                            <!--<Setter Property="Foreground" TargetName="textContent" Value="{StaticResource BlendSelectedText}"/>-->
                            <Setter Property="Foreground" Value="{StaticResource BlendSelectedText}"/>
                        </Trigger>
                        <Trigger Property="IsPinned" Value="True">
                            <Setter Property="Source" Value="/Syncfusion.Shared.Wpf;component/Controls/PinnableListBox/pinnedblend.png" TargetName="pin"/>
                        </Trigger>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="1,8,1,8"/>
                            <Setter Property="Width" Value="20" TargetName="pin"/>
                            <Setter Property="Width" Value="45" TargetName="pinnedButton"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>

        </Setter>

    </Style>

    <Style BasedOn="{StaticResource BlendPinnableListBoxItemStyle}" TargetType="{x:Type local:PinnableListBoxItem}"/>


</ResourceDictionary>