    <SolidColorBrush x:Key="Office2010BlackPopupBorderBrush" Color="#FFA7ABB0" />

    <LinearGradientBrush x:Key="Office2010BlackColorPickerPaletteBackground" EndPoint="0.5,1" StartPoint="0.5,0">
