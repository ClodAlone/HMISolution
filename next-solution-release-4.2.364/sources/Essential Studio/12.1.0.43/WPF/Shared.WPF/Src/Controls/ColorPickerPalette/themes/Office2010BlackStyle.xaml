    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackColorPickerPaletteMoreColorBackground" EndPoint=".5,1" StartPoint=".5,0">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
