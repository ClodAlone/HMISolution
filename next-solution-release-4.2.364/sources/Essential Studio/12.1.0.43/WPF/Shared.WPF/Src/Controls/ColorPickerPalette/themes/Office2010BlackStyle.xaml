    <SolidColorBrush x:Key="Office2010BlackColorPickerPaletteAutomaticColorMouseOverBorderBrush" Color="#FFF7C840" />

    <LinearGradientBrush x:Key="Office2010BlackColorPickerPaletteAutomaticColorBackground" EndPoint=".5,1" StartPoint=".5,0">
