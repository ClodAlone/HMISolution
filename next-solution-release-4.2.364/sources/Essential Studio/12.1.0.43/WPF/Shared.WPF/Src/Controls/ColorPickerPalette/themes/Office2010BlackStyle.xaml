        <GradientStop Color="#FFFFFFFF" Offset="0.971" />
        <GradientStop Color="#FFFFFFFF" Offset="0.427" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlackColorPickerPaletteAutoBoderMouseOverBorderBrush" Color="Orange" />

    <SolidColorBrush x:Key="Office2010BlackColorPickerPaletteAutoBoder1MouseOverBackground" Color="#FFFFFFE6" />

    <!-- MouseOver Brushes-->

    <LinearGradientBrush x:Key="Office2010ColorPickerPaletteUpDownMouseOverBackground"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFAEAAA" Offset="0.046" />
        <GradientStop Color="#FFFAE287" Offset="0.447" />
        <GradientStop Color="#FFFAEAAD" Offset="0.845" />
        <GradientStop Color="#FFFBF5DC" Offset="0.966" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010ColorPickerPaletteUpDownMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC2782D" Offset="0" />
        <GradientStop Color="#FFC29C46" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackColorPickerPaletteMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC2772C" Offset="0" />
        <GradientStop Color="#FFC29D46" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackColorPickerPaletteMoreColorMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFAEAAA" Offset="0.046" />
        <GradientStop Color="#FFFAE287" Offset="0.447" />
        <GradientStop Color="#FFFAEAAD" Offset="0.845" />
        <GradientStop Color="#FFFBF5DC" Offset="0.966" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlackColorPickerPaletteMoreColorMouseOverBorderBrush" Color="#FFEEC757" />
    <SolidColorBrush x:Key="Office2010BlueColorGroupItemSelectedOuterBorderBrushKey" Color="#FFEF4810" />
    <SolidColorBrush x:Key="Office2010BlueColorGroupItemSelectedInnerBorderBrushKey" Color="#FFFFE294" />

    <Style x:Key="Office2010BlackButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <!--<Setter Property="Foreground" Value="{StaticResource Office2010BlackButtonForeground}" />-->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}">
                        <!--<Border x:Name="innerBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">-->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <!--</Border>-->
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource Office2010BlackColorPickerPaletteAutomaticColorMouseOverBorderBrush}" />
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource Office2010BlackColorPickerPaletteAutomaticColorMouseOver}" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                        <!--<Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource Office2010BlackButtonPressedBackground}" />
                            <Setter Property="BorderBrush" TargetName="innerBorder" Value="{StaticResource Office2010BlackButtonInnerBorderPressedBackground}" />
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource Office2010BlackButtonPressedBorderBrush}" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>-->
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="#ADADAD" />
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="local:ColorGroupItem"  TargetType="local:ColorGroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorGroupItem">
                    <Grid>
                        <Border>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ItemBorder" BorderThickness="1" BorderBrush="{StaticResource Office2010BlackColorGroupItemBorderBrush}" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Color}" Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BorderWidth}" Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BorderHeight}" HorizontalAlignment="Left" Margin="{TemplateBinding BorderMargin}"  Grid.Row="0">
                                    <Border x:Name="InnerBorder" Margin="1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Color}">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{TemplateBinding ColorName}"></TextBlock>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </Border>
                                <ItemsControl  x:Name="Ic1" Grid.Row="1" Margin="{TemplateBinding ItemMargin}"   HorizontalAlignment="Left"></ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="ItemBorder" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="ItemBorder" Value="{StaticResource Office2010BlueColorGroupItemSelectedInnerBorderBrushKey}" />
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{StaticResource Office2010BlackColorGroupItemMouseOverBorderBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{StaticResource Office2010BlueColorGroupItemSelectedOuterBorderBrushKey}" />
                            <Setter Property="Background" TargetName="ItemBorder" Value="{StaticResource Office2010BlueColorGroupItemSelectedInnerBorderBrushKey}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorGroupItem" BasedOn="{StaticResource local:ColorGroupItem}" />

    <Style x:Key="local:ColorGroup" TargetType="local:ColorGroup">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorGroup">
                    <Grid Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=PanelVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition  Height="*" />
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" x:Name="CGHeaderName" HorizontalAlignment="Stretch" Visibility="{TemplateBinding HeaderVisibility}" Fill="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ThemeHeaderBackGround}" Margin="0">
                        </Rectangle>
                        <TextBlock x:Name="CGTextBox" Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=HeaderName}" Visibility="{TemplateBinding HeaderVisibility}" Grid.Row="0" VerticalAlignment="Center" FontWeight="bold" Margin="8,2,2,2"  Foreground="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ThemeHeaderForeGround}" HorizontalAlignment="Left"  FontSize="{TemplateBinding FontSize}" />

                        <ItemsControl  x:Name="Ic"  Grid.Row="1" ItemsSource="{TemplateBinding DataSource}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel  Orientation="Horizontal" ></StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                            <Setter TargetName="CGTextBox" Property="Margin" Value="8,6,4,6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorGroup" BasedOn="{StaticResource local:ColorGroup}" />

    <Style x:Key="local:PolygonItem" TargetType="local:PolygonItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PolygonItem">
                    <Grid>
                        <Grid>
                            <Polygon x:Name="polygon" Fill="{Binding RelativeSource={RelativeSource TemplatedParent},Path=color}" Stroke="{StaticResource GlyphBrushKey}"  StrokeThickness="0"  Points="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Points}">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="{TemplateBinding ColorName}"></TextBlock>
                                </ToolTipService.ToolTip>
                            </Polygon>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PolygonItem" BasedOn="{StaticResource local:PolygonItem}" />
    <LinearGradientBrush x:Key="ButtonAdvHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFAEAA8" Offset="0.055" />
        <GradientStop Color="#FFFAE48C" Offset="0.546" />
        <GradientStop Color="#FFFCF9E0" Offset="0.945" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvHoverBorderBrush" Color="#FFEEC858" />
    <!--<SolidColorBrush x:Key="ButtonAdvHoverInnerBorderBrush" Color="#FFFCF9E8" />-->

    <LinearGradientBrush x:Key="ButtonAdvHoverInnerBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCF9E8" Offset="0" />
        <GradientStop Color="#FFFDFDEB" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Office2010BlackColorPickerPaletteStyle" TargetType="local:ColorPickerPalette">
        <Setter Property="Background" Value="{StaticResource Office2010BlackColorPickerPaletteBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlackColorPickerPaletteBorderBrush}" />
        <Setter Property="ThemeHeaderBackGround" Value="#FFF0F2F5" />
        <Setter Property="ThemeHeaderForeGround" Value="#FF3B3B3B" />
        <!--<Setter Property="Icon" Value="/Syncfusion.Shared.WPF;component/Images/Label.png" />-->
        <Setter Property="MoreColorsIcon" Value="/Syncfusion.Shared.WPF;component/Images/MoreColorsIcon.png" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MoreColorsIconSize" Value="16,16" />
        <Setter Property="MouseOverBackground" Value="{StaticResource Office2010ColorPickerPaletteUpDownMouseOverBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorPickerPalette">
                    <Grid>
                        <Border Visibility="Collapsed" Width="Auto" Background="{StaticResource Office2010BlackPopupBackground}" BorderBrush="{StaticResource Office2010BlackPopupBorderBrush}" x:Name="b_Expanded" CornerRadius="1">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="Automatic1_Expanded" Margin="2,2,2,2" Grid.Row="0" Visibility="{TemplateBinding AutomaticColorVisibility}" BorderThickness="1"  CornerRadius="1">
                                        <Border.Background>
                                            <LinearGradientBrush EndPoint=".5,1" StartPoint=".5,0">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#FFFFFFFF" Offset="0.54" />
                                                <GradientStop Color="#FFFFFFFF" Offset="0.971" />
                                                <GradientStop Color="#FFFFFFFF" Offset="0.427" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AutoBorder1_Expanded" Grid.Column="0" Background="#FFFCF1C2"  BorderBrush="#FFF29536" CornerRadius="2" BorderThickness="1" SnapsToDevicePixels="True" Margin="1,2,2,2">
                                                <Border x:Name="AutoBorder2_Expanded" BorderBrush="#FFE2E4E7" Grid.Column="0" BorderThickness="1" SnapsToDevicePixels="True" Margin="1">
                                                    <Border x:Name="aborder_Expanded" Grid.Column="0" Height="{TemplateBinding BorderHeight}" Width="{TemplateBinding BorderWidth}"  BorderThickness="1" Background="{TemplateBinding AutomaticColor}" BorderBrush="{TemplateBinding AutomaticColor}" SnapsToDevicePixels="True" />
                                                </Border>
                                            </Border>
                                            <Rectangle x:Name="splitter1" Width="1" MinHeight="23" Fill="#FFC5C5C5" Grid.Column="1" SnapsToDevicePixels="True" Margin="3,0,3,0" />
                                            <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=AutomaticText}" Foreground="{TemplateBinding Foreground}" Padding="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}"></TextBlock>
                                        </Grid>
                                    </Border>

                                    <ItemsControl x:Name="ColorArea_Expanded" Grid.Row="1" Margin="2,2,2,0">
                                        <local:ColorGroup x:Name="item1_Expanded"  HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=ThemeColorsText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                        <local:ColorGroup x:Name="item2_Expanded" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=StandardColorsText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                        <local:ColorGroup x:Name="item3_Expanded" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=RecentlyUsedText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                    </ItemsControl>
                                    <Border BorderBrush="#FFDDE7EE" BorderThickness=".5" Margin="2,2,2,0" Grid.Row="2"></Border>

                                    <Border Grid.Row="3" Background="{StaticResource Office2010BlackColorPickerPaletteMoreColorBackground}" Visibility="{TemplateBinding MoreColorOptionVisibility}" BorderThickness="1" Margin="2,1,2,1" CornerRadius="1" x:Name="MoreColors1_Expanded">
                                        <Grid x:Name="MoreColorsGrid1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{TemplateBinding MoreColorsIcon}" Grid.Column="0"  Width="{Binding Path=MoreColorsIconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Height="{Binding Path=MoreColorsIconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" x:Name="morecolorsimage1" Margin="1,3,4,0" />
                                            <Border x:Name="splitterborder1" BorderBrush="#FFDDE7EE" BorderThickness=".5" Grid.Column="1" Margin="0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=MoreColorsText}" Foreground="{TemplateBinding Foreground}"  Padding="2" VerticalAlignment="Center" HorizontalAlignment="Left"  FontSize="{TemplateBinding FontSize}" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <!--<Border Grid.Row="3" Visibility="{TemplateBinding MoreColorOptionVisibility}" Margin="2">
                                        <Button BorderBrush="Transparent" Content="{Binding Source={StaticResource ResourceWrapperKey}, Path=MoreColorsText}" Foreground="Black" Background="{StaticResource Office2010BlackColorPickerPaletteMoreColorBackground}" x:Name="MoreColors1_Expanded" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Style="{StaticResource Office2010BlackButtonStyle}">
                                        </Button>
                                    </Border>-->
                                </Grid>
                            </Border>
                        </Border>

                        <Border x:Name="ColorPaletteBorder" SnapsToDevicePixels="True" BorderBrush="Transparent">
                            <Grid x:Name="lay">
                                <Grid.Resources>
                                    <ItemsPanelTemplate x:Key="ItemPanelTemplate">
                                        <StackPanel  Orientation="Horizontal" ></StackPanel>
                                    </ItemsPanelTemplate>
                                    <ItemsPanelTemplate x:Key="ItemPanelTemplate2">
                                        <StackPanel  Orientation="Vertical" ></StackPanel>
                                    </ItemsPanelTemplate>
                                </Grid.Resources>

                                <Border x:Name="ColorPickerBorder" CornerRadius="2" BorderBrush="#FF6A6A6A" Background="{StaticResource Office2010BlackColorPickerPaletteOuterBorderBackground}"  BorderThickness="1" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--<Border x:Name="OutBorder" BorderBrush="#FF6A6A6A" Background="{StaticResource Office2010BlackColorPickerPaletteOuterBorderBackground}"  BorderThickness="0" Grid.ColumnSpan="2" SnapsToDevicePixels="True">
                                        </Border>-->
                                        <Border x:Name="ColorBorder" CornerRadius="1,0,0,1" BorderBrush="Transparent" BorderThickness="1" Grid.Column="0" SnapsToDevicePixels="True">
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="Transparent" Offset="0.835" />
                                                    <GradientStop Color="Transparent" Offset="0.129" />
                                                    <GradientStop Color="Transparent" Offset="0.5" />
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid Margin="2" x:Name="IconGrid">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" x:Name="colorborder_row" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{TemplateBinding Icon}"  Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" x:Name="image" />
                                                <Border Name="color_border" Grid.Row="1" ></Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="UpDownBorder" CornerRadius="0,2,2,0" BorderBrush="Transparent" BorderThickness="1" Grid.Column="1" Margin="0,-1,-1,-1">
                                            <Border BorderThickness="1" CornerRadius="0,2,2,0" x:Name="updowninnerborder">
                                                <TextBlock Text="6" x:Name="Txt"   FontFamily="Webdings" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0,0,0"></TextBlock>
                                            </Border>
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="Transparent" Offset="0.835" />
                                                    <GradientStop Color="Transparent" Offset="0.129" />
                                                    <GradientStop Color="Transparent" Offset="0.5" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Popup x:Name="pop" AllowsTransparency="True">
                                    <Border>
                                        <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw" Color="#71000000" Margin="0,0,5,5">
                                            <Border BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource Office2010BlackPopupBackground}" BorderBrush="{StaticResource Office2010BlackPopupBorderBrush}" x:Name="b" CornerRadius="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="Automatic1" Background="{StaticResource Office2010BlackColorPickerPaletteAutomaticColorBackground}" Margin="2,2,2,0"  Grid.Row="0" Visibility="{TemplateBinding AutomaticColorVisibility}" BorderThickness="1" CornerRadius="2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Border x:Name="AutoBorder1" Grid.Column="0" Background="#FFFCF1C2"  BorderBrush="#FFF29536" CornerRadius="2" BorderThickness="1" SnapsToDevicePixels="True" Margin="1,2,2,2">
                                                                <Border x:Name="AutoBorder2" BorderBrush="#FFE2E4E7" Grid.Column="0" BorderThickness="1" SnapsToDevicePixels="True" Margin="1">
                                                                    <Border x:Name="aborder" Grid.Column="0" Height="{TemplateBinding BorderHeight}" Width="{TemplateBinding BorderWidth}"  BorderThickness="1" Background="{TemplateBinding AutomaticColor}" BorderBrush="{TemplateBinding AutomaticColor}" SnapsToDevicePixels="True" />
                                                                </Border>
                                                            </Border>
                                                            <Rectangle x:Name="splitter" Width="1" MinHeight="23" Fill="#FFF0F2F5" Grid.Column="1" SnapsToDevicePixels="True" />
                                                            <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=AutomaticText}" Padding="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" Margin="2,0,0,0"></TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <ItemsControl x:Name="ColorArea" Grid.Row="1" Margin="2,2,2,0">
                                                        <local:ColorGroup x:Name="item1" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=ThemeColorsText}"  ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                        <local:ColorGroup x:Name="item2" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=StandardColorsText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                        <local:ColorGroup x:Name="item3" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=RecentlyUsedText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                    </ItemsControl>
                                                    <Border BorderBrush="#FFDDE7EE" BorderThickness=".5" Margin="2,2,2,0" Grid.Row="2"></Border>
                                                    <Border Grid.Row="3" Background="{StaticResource Office2010BlackColorPickerPaletteMoreColorBackground}" Visibility="{TemplateBinding MoreColorOptionVisibility}" BorderThickness="1" Margin="2,1,2,1" Height="{Binding ElementName=Automatic1, Path=Height , Mode=OneWay}"  x:Name="MoreColors1" CornerRadius="1">
                                                        <Grid x:Name="MoreColorsGrid">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
