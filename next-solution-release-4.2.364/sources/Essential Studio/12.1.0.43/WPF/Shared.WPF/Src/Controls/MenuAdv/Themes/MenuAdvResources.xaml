<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Shared"
                    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:vsm="clr-namespace:Syncfusion.Windows">

    <!--Brushes-->

    <LinearGradientBrush x:Key="MenuBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF6F6F6" Offset="0.249"/>
        <GradientStop Color="#FFE8E6E6" Offset="0.318"/>
        <GradientStop Color="#FFDCD9D9" Offset="0.917"/>
        <GradientStop Color="#FFEBE9E9" Offset="0.986"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuItemHoverBackgroundBrushKey" Color="Transparent"/>

    <LinearGradientBrush x:Key="MenuItemSelectedBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="Gainsboro" Offset="0.127"/>
        <GradientStop Color="#FFD4D3D3" Offset="0.133"/>
        <GradientStop Color="#FFBDBBBB" Offset="0.8"/>
        <GradientStop Color="#FFB1AFAF" Offset="0.873"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuItemSelectedBorderBrushKey" Color="#FF807F7F"/>
    <SolidColorBrush x:Key="MenuItemSelectedInnerBorderBrushKey" Color="#FF9B9A9A"/>  

    <SolidColorBrush x:Key="ExtendButtonFillKey" Color="Black"/>

    <SolidColorBrush x:Key="MenuBorderBrushKey" Color="Transparent"/>

    <SolidColorBrush x:Key="MenuItemForegroundBrushKey" Color="Black"/>

    <SolidColorBrush x:Key="MenuItemDisabledForegroundBrush" Color="Gray"/>

    <LinearGradientBrush x:Key="MenuItemMouseHoverBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4381C2" Offset="0"/>
        <GradientStop Color="#FF3399FF" Offset="0.028"/>
        <GradientStop Color="#FF3399FF" Offset="0.972"/>
        <GradientStop Color="#FF6D98C3" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuItemMouseHoverBorderBrushKey" Color="#FFABAAAA"/>

    <LinearGradientBrush x:Key="SubItemMouseHoverBackgroundBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#34C5EBFF" Offset="0"/>
        <GradientStop Color="#3481D8FF" Offset="1"/>
    </LinearGradientBrush>  

    <SolidColorBrush x:Key="SubItemMouseHoverBorderBrushKey" Color="#FFAEDFF4"/>

    <SolidColorBrush x:Key="PopUpBackgroundBrush" Color="#FFF5F5F5"/>

    <SolidColorBrush x:Key="PopUpBorderBrush" Color="#FF959595"/>

    <SolidColorBrush x:Key="PopUpLeftBackgroundBrush" Color="#FFF1F1F1"/>

    <SolidColorBrush x:Key="SeparatorBrushKey" Color="LightGray"/>

    <SolidColorBrush x:Key="SeparatorBrushKey1" Color="White"/>

    <SolidColorBrush x:Key="PopUpShadowBrushKey" Color="DarkGray"/>

    <SolidColorBrush x:Key="ScrollerBackgroundBrush" Color="#FFC8CBD1"/>

    <SolidColorBrush x:Key="ScrollBtnPathFillKey" Color="Black"/>

    <SolidColorBrush x:Key="ChkBoxBackgroundBrushKey" Color="#EDF2F7"/>

    <SolidColorBrush x:Key="ChkBoxBorderBrushKey" Color="#AECFF7"/>

    <SolidColorBrush x:Key="ChkBoxPathFillKey" Color="#FF0C12A1"/>

    <SolidColorBrush x:Key="RadioBtnBackgroundBrushKey" Color="#EDF2F7"/>

    <SolidColorBrush x:Key="RadioBtnBorderBrushKey" Color="#AECFF7"/>

    <!--Style-->

    <!--Top Scroll Button Style-->
    <Style x:Key="TopScrollButtonStyleKey" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TopButtonScroll" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemMouseHoverBackgroundBrushKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border Background="{StaticResource ScrollerBackgroundBrush}" x:Name="TopButtonScroll" BorderThickness="1" BorderBrush="{StaticResource ScrollerBackgroundBrush}">
                            <Path Fill="{StaticResource ScrollBtnPathFillKey}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="180"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Bottom Scroll Button Style-->
    <Style x:Key="BottomScrollButtonStyleKey" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BottomButtonScroll" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemMouseHoverBackgroundBrushKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border Background="{StaticResource ScrollerBackgroundBrush}" x:Name="BottomButtonScroll"  BorderThickness="1" BorderBrush="{StaticResource ScrollerBackgroundBrush}">
                            <Path Fill="{StaticResource ScrollBtnPathFillKey}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z">
                            </Path>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Check Box Style-->
    <Style x:Key="CheckBoxStyleKey" TargetType="CheckBox">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChkBoxBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChkBoxBackgroundBrushKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChkBoxBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChkBoxBorderBrushKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ChkBoxPathFillKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChkBoxBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="ChkBoxBorder"  BorderThickness="1" CornerRadius="3" Height="22" Width="22" BorderBrush="{StaticResource ChkBoxBorderBrushKey}" Background="{StaticResource ChkBoxBackgroundBrushKey}">
                            <Path Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="{StaticResource ChkBoxPathFillKey}" x:Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Radion BUtton Style-->
    <Style x:Key="RadioButtonStyleKey" TargetType="RadioButton">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RadioBtnBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RadioBtnBackgroundBrushKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RadioBtnBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RadioBtnBorderBrushKey}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RadioBtnBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EllipsePath" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="RadioBtnBorder" BorderThickness="1" CornerRadius="3" Height="22" Width="22" BorderBrush="{StaticResource RadioBtnBorderBrushKey}" Background="{StaticResource RadioBtnBackgroundBrushKey}">
                            <Ellipse x:Name="EllipsePath" StrokeThickness="1" Height="8" Margin="1" Width="8">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.65625,0.218746" GradientOrigin="0.65625,0.218746">
                                        <RadialGradientBrush.GradientStops>
                                            <GradientStop Color="#FFCCCCED" Offset="0"/>
                                            <GradientStop Color="#FF16186D" Offset="1"/>
                                        </RadialGradientBrush.GradientStops>
                                        <RadialGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <RotateTransform CenterX="0.65625" CenterY="0.218746" Angle="120.379"/>
                                            </TransformGroup>
                                        </RadialGradientBrush.RelativeTransform>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>    
    
<!--MenuAdv Style-->
    <Style TargetType="{x:Type local:MenuAdv}">
        <Setter Property="Background" Value="{StaticResource MenuBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuAdv">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter></ItemsPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--<Style TargetType="{x:Type local:MenuAdv}" BasedOn="{StaticResource SampleMenu}"/>-->

    <!--MenuItemAdv Style-->
    <Style TargetType="{x:Type local:MenuItemAdv}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
		<Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{StaticResource PopUpBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MenuItemForegroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>        
        <Setter Property="BottomScrollButtonStyle" Value="{StaticResource BottomScrollButtonStyleKey}"/>
        <Setter Property="TopScrollButtonStyle" Value="{StaticResource TopScrollButtonStyleKey}"/>
        <Setter Property="CheckBoxStyle" Value="{StaticResource CheckBoxStyleKey}"/>
        <!--<Setter Property="Rol"-->
        <Setter Property="RadioButtonStyle" Value="{StaticResource RadioButtonStyleKey}"/>
        <Setter Property="Padding" Value="6,2,64,2"/>       
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuItemAdv">
                    <Grid x:Name="menuItemAdvGrid">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSelectedBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimation Duration="0" To="#FF808080" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="MenuItemContent"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GestureTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExtendButton" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.5"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="MenuItemSelected">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSelectedBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="MenuItemFocused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="SubMenuItemFocused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemContent" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="7,2,37,2" />
                                        </ObjectAnimationUsingKeyFrames>-->
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="MenuItemHoverBorder" Grid.ColumnSpan="5" Background="{StaticResource MenuItemHoverBackgroundBrushKey}" BorderBrush="{StaticResource MenuItemMouseHoverBorderBrushKey}" BorderThickness="1" Opacity="0" CornerRadius="1" Margin="1,1,0,0">                            
                        </Border>
                        <Border x:Name="MenuItemSelectedBorder" Grid.ColumnSpan="5" BorderBrush="{StaticResource MenuItemSelectedBorderBrushKey}" BorderThickness="1" Opacity="0" CornerRadius="1" Margin="1,1,0,0">
                            <Border Background="{StaticResource MenuItemSelectedBackgroundBrushKey}" BorderBrush="{StaticResource MenuItemSelectedInnerBorderBrushKey}" BorderThickness="1"/>
                        </Border>
                        <Border x:Name="SubItemHoverBorder" Margin="3,1,2,1" Grid.ColumnSpan="5" Background="{StaticResource SubItemMouseHoverBackgroundBrushKey}" BorderBrush="{StaticResource SubItemMouseHoverBorderBrushKey}" BorderThickness="1" Opacity="0" CornerRadius="1"/>
                        <Border x:Name="MenuItemBorder" Grid.ColumnSpan="5" Background="Transparent" BorderBrush="Transparent"/>

                        <Grid x:Name="IconGrid" Grid.Column="0" MinWidth="28" MinHeight="24" Margin="1,0,0,0">
                            <ContentControl IsTabStop="False" x:Name="IconContent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Content="{TemplateBinding Icon}"/>
                            <CheckBox x:Name="CheckBoxPanel" IsTabStop="False" Visibility="{TemplateBinding CheckBoxVisibility}" Style="{TemplateBinding CheckBoxStyle}"/>
                            <RadioButton x:Name="RadioButtonPanel" IsTabStop="False" Visibility="{TemplateBinding RadioButtonVisibility}" Style="{TemplateBinding RadioButtonStyle}"/>
                        </Grid>

                         <ContentPresenter  Grid.Column="2" x:Name="MenuItemContent"  Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               ContentSource="Header" TextBlock.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                      
                        <TextBlock x:Name="GestureTextBlock" Grid.Column="3" VerticalAlignment="Center" Background="Transparent" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding InputGestureText}" Visibility="Collapsed" Margin="-15,0,15,0"/>                     

                        <Border Grid.Column="4" Visibility="{TemplateBinding ExtendButtonVisibility}">
                            <Path Name="ExtendButton" Fill="{StaticResource ExtendButtonFillKey}" Stretch="Fill" Grid.Column="5" Stroke="{StaticResource ExtendButtonFillKey}" HorizontalAlignment="Right" Width="3" Height="5" Margin="10,0,10,0" 
                                      Data="M129,173 L129,282 L246,222 z" />
                        </Border>

                        <Popup x:Name="SubMenuPopup" AllowsTransparency="True">
                            <Border x:Name="PopUpBorder" SnapsToDevicePixels="True">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome Margin="0,0,5,5" Color="#71000000">
                                    <Border x:Name="border" Background="{StaticResource PopUpBackgroundBrush}" BorderBrush="{StaticResource PopUpBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Height="{TemplateBinding ScrollerHeight}" Visibility="Collapsed" Grid.Row="0" x:Name="PART_TopScroll" Style="{TemplateBinding TopScrollButtonStyle}"/>
                                            <Grid Grid.Row="1" x:Name="PopUpGrid">
                                                <Rectangle RadiusX="2" RadiusY="2" Fill="{StaticResource PopUpLeftBackgroundBrush}" Width="30" Margin="0,0,0,4" HorizontalAlignment="Left"/>
                                                <Rectangle Fill="LightGray" Width="1" Margin="30,0,0,0" HorizontalAlignment="Left"/>
                                                <Rectangle Fill="White" Width="1" Margin="31,0,0,0" HorizontalAlignment="Left"/>
                                                <ScrollViewer x:Name="PART_ScrollViewer" BorderBrush="Transparent" Margin="1"
                                                VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                                    <ItemsPresenter Margin="0"/>
                                                </ScrollViewer>
                                            </Grid>
                                            <Button Height="{TemplateBinding ScrollerHeight}" Visibility="Collapsed" Grid.Row="2" x:Name="PART_BottomScroll" Style="{TemplateBinding BottomScrollButtonStyle}"/>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Padding" Value="7,2,7,2"/>                           
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter Property="Padding" Value="7,2,7,2"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCheckable" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconContent" Property="Visibility" Value="Hidden"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
        <Trigger Property="local:SkinStorage.EnableTouch" Value="true">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="17,8,17,8"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PopUpBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:MenuItemAdv">
                        <Grid x:Name="menuItemAdvGrid">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSelectedBorder" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ColorAnimation Duration="0" To="#FF808080" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="MenuItemContent"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GestureTextBlock" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExtendButton" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0" Value="0.5"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="MenuItemSelected">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSelectedBorder" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="MenuItemFocused">
                                        <Storyboard>
                                            <!--<DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                        </DoubleAnimationUsingKeyFrames>-->
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="SubMenuItemFocused">
                                        <Storyboard>
                                            <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PopUpBackgroundBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>-->
                                        </Storyboard>
                                    </vsm:VisualState>

                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Opacity="0" x:Name="BottomBorder" BorderBrush="{TemplateBinding BorderBrush}" Grid.ColumnSpan="5"  BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="MenuItemHoverBorder" Grid.ColumnSpan="5" Background="{StaticResource MenuItemHoverBackgroundBrushKey}" BorderBrush="{StaticResource MenuItemMouseHoverBorderBrushKey}" BorderThickness="1,1,1,0" Opacity="0" CornerRadius="1,1,0,0" Margin="1,1,0,0">
                            </Border>
                            <Border x:Name="MenuItemSelectedBorder" Grid.ColumnSpan="5" BorderBrush="{StaticResource MenuItemSelectedBorderBrushKey}" BorderThickness="1,1,1,0" Opacity="0" CornerRadius="1,1,0,0" Margin="1,1,0,0">
                                <Border Background="{StaticResource MenuItemSelectedBackgroundBrushKey}" BorderBrush="{StaticResource MenuItemSelectedInnerBorderBrushKey}" BorderThickness="1"/>
                            </Border>
                            <Border x:Name="SubItemHoverBorder" Margin="0,-1,0,0" Grid.ColumnSpan="5" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderThickness="0" Opacity="0" />
                            <Border x:Name="MenuItemBorder" Grid.ColumnSpan="5" Background="Transparent" BorderBrush="Transparent"/>

                            <Grid x:Name="IconGrid" Grid.Column="0" MinWidth="32" MinHeight="24" Margin="1,0,0,0">
                                <ContentControl IsTabStop="False" x:Name="IconContent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Content="{TemplateBinding Icon}"/>
                                <CheckBox x:Name="CheckBoxPanel" IsTabStop="False" Visibility="{TemplateBinding CheckBoxVisibility}" Style="{TemplateBinding CheckBoxStyle}"/>
                                <RadioButton x:Name="RadioButtonPanel" IsTabStop="False" Visibility="{TemplateBinding RadioButtonVisibility}" Style="{TemplateBinding RadioButtonStyle}"/>
                            </Grid>

                             <ContentPresenter  Grid.Column="2" x:Name="MenuItemContent"  Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               ContentSource="Header" TextBlock.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />

                            <TextBlock x:Name="GestureTextBlock" Grid.Column="3" VerticalAlignment="Center" Background="Transparent" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding InputGestureText}" Visibility="Collapsed" Margin="-15,0,15,0"/>

                            <Border Grid.Column="4" Visibility="{TemplateBinding ExtendButtonVisibility}">
                                <Path Name="ExtendButton" SnapsToDevicePixels="True"  Fill="{StaticResource ExtendButtonFillKey}" Stretch="Fill" Grid.Column="5" Stroke="{StaticResource ExtendButtonFillKey}" HorizontalAlignment="Right" Width="7" Height="11" Margin="10,0,10,0" 
                                      Data="M129,173 L129,282 L246,222 z" />
                            </Border>

                            <Popup x:Name="SubMenuPopup" AllowsTransparency="True">
                                <Border x:Name="PopUpBorder" SnapsToDevicePixels="True">
                                    <Microsoft_Windows_Themes:SystemDropShadowChrome Margin="0,0,5,5" Color="#71000000">
                                        <Border x:Name="border" Background="{StaticResource PopUpBackgroundBrush}" BorderBrush="{StaticResource PopUpBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Button Height="{TemplateBinding ScrollerHeight}" Visibility="Collapsed" Grid.Row="0" x:Name="PART_TopScroll" Style="{TemplateBinding TopScrollButtonStyle}"/>
                                                <Grid Grid.Row="1" x:Name="PopUpGrid">
                                                    <Rectangle RadiusX="2" RadiusY="2" Fill="Transparent"  Width="40" Margin="0,0,0,4" HorizontalAlignment="Left"/>

                                                    <ScrollViewer x:Name="PART_ScrollViewer" BorderBrush="Transparent" 
                                                VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                                        <ItemsPresenter Margin="0,0,0,-1"/>
                                                    </ScrollViewer>
                                                </Grid>
                                                <Button Height="{TemplateBinding ScrollerHeight}" Visibility="Collapsed" Grid.Row="2" x:Name="PART_BottomScroll" Style="{TemplateBinding BottomScrollButtonStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Microsoft_Windows_Themes:SystemDropShadowChrome>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubMenuHeader">
                                <Setter Property="Padding" Value="14,9,80,11"/>
                                <Setter Property="Opacity" TargetName="BottomBorder" Value="1"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubMenuItem">
                                <Setter Property="Padding" Value="14,9,80,11"/>
                                <Setter Property="Opacity" TargetName="BottomBorder" Value="1"/>
                            </Trigger>

                            <Trigger  Property="IsPressed" Value="true">

                                <Setter TargetName="SubItemHoverBorder" Property="Opacity" Value="1"/>
                                <!--<Setter Property="Background" TargetName="SubItemHoverBorder" Value="Red"/>-->
                                <Setter Property="TextBlock.Foreground" TargetName="MenuItemContent" Value="White"/>
                                <Setter Property="Foreground" TargetName="GestureTextBlock" Value="White"/>

                                <Setter Property="Fill" TargetName="ExtendButton" Value="White"/>
                                <Setter Property="Stroke" TargetName="ExtendButton" Value="White"/>
                            </Trigger>



                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsCheckable" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="IconContent" Property="Visibility" Value="Hidden"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Trigger>
        </Style.Triggers>
    </Style>
    <!--<Style TargetType="{x:Type local:MenuItemAdv}" BasedOn="{StaticResource MenuItemKey}"/>-->

    <!--MenuItemSeparator Style-->
    <Style x:Key="MenuItemSeparator" TargetType="{x:Type local:MenuItemSeparator}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Margin" Value="30,6,0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuItemSeparator">
                    <StackPanel>
                        <Border BorderThickness="0.75" BorderBrush="{StaticResource SeparatorBrushKey}" Background="{StaticResource SeparatorBrushKey}" Height="1"/>
                        <Border BorderThickness="0.75" BorderBrush="{StaticResource SeparatorBrushKey1}" Background="{StaticResource SeparatorBrushKey1}" Height="1"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MenuItemSeparator}" TargetType="{x:Type local:MenuItemSeparator}"/>

</ResourceDictionary>