    <SolidColorBrush x:Key="TransparentInnerBorderBrush" Color="#CCFFFFFF"/>

    <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#4C000000"/>
    <SolidColorBrush x:Key="TextBoxDisabledBorderBrush" Color="#7F000000"/>

    <SolidColorBrush x:Key="TextBoxMouseOverBackground" Color="#4CFFFFFF"/>
    <SolidColorBrush x:Key="TextBoxMouseOverBorderBrush" Color="#7F000000"/>

