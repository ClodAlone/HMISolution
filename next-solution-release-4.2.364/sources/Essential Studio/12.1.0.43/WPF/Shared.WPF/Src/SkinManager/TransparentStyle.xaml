                            <Setter Property="Padding" Value="4,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border1" Property="Background" Value="White"/>
                            <Setter TargetName="border1" Property="Opacity" Value=".295"/>
                            <Setter Property="Foreground" Value="{StaticResource CheckBoxDisabledForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" TargetName="Path" Value="1"/>
