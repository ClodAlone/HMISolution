                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource  TransparentListBoxItemHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="innerborder" Value="{StaticResource  InnerBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource  TransparentTListBoxItemHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource  TransparentListBoxItemHoverBorderBrush}"/>
