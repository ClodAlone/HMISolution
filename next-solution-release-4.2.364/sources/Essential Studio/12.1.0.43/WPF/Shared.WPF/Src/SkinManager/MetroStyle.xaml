    <SolidColorBrush x:Key="MetroGridViewColumnHeaderBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush Color="White" x:Key="MetroGridViewColoumnHeaderBorderBrush"/>
    <SolidColorBrush Color="#FF333333" x:Key="MetroGridViewColumnHeaderForeground"/>
    <SolidColorBrush Color="#FFD8D8D9" x:Key="MetroGridViewColumnHeaderHoverBrush"/>
