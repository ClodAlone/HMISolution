            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Padding" Value="5,2,0,0"/>
                <Setter Property="Template" Value="{StaticResource TouchCheckBoxTemplate}"/>
            </Trigger>
