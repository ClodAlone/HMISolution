                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource CheckBoxMouseHoverBorderBrush}" />
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource CheckBoxMouseHoverBackground}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource CheckBoxPressedBorderBrush}" />
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource CheckBoxPressedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
