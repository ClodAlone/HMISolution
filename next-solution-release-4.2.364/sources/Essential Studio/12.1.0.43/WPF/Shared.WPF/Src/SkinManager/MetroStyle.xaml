    <Style x:Key="ScrollBarDownButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="Background" Value="{StaticResource RepeatButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RepeatButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border  Width="12" Height="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Name="PART_Repeat" Background="{TemplateBinding Background}">
                        <Path Data="M0,0L3.5,4 7,0z" HorizontalAlignment="Center" Height="3" Width="5"  Stretch="Fill" StrokeThickness="1" Stroke="#FF7F7F7F" Fill="#FF7F7F7F" Name="Arrow" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="sfshared:SkinStorage.EnableTouch" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource RepeatButtonPressedArrowFill}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource RepeatButtonPressedArrowFill}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="sfshared:SkinStorage.EnableTouch" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource RepeatButtonPressedArrowFill}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource RepeatButtonPressedArrowFill}"/>
                            <Setter Property="Effect" TargetName="Arrow">
                                <Setter.Value>
                                    <DropShadowEffect Direction="562" Opacity="0.5" BlurRadius="4" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="Fill" TargetName="Arrow" Value="{StaticResource TriangleInner}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
