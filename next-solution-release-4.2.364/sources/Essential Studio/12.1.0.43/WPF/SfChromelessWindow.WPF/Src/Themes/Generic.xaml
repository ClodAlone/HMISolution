<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls">

    <Style TargetType="Button" x:Key="CaptionButtonStyle">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Opacity" To="0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Opacity" To="0.4"/>
                                    </Storyboard>
                                </VisualState>
                                
                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>

                        <Grid Background="Transparent">
                            <Border x:Name="BackgroundAnimation" Background="{TemplateBinding Background}" />
                            <Rectangle x:Name="BackgroundGradient" Opacity="0" Fill="Black"/>
                        </Grid>

                        <ContentPresenter
                              x:Name="contentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              Margin="{TemplateBinding Padding}"/>
                        <Rectangle x:Name="FocusVisualElement" RadiusX="2" RadiusY="2" Margin="1" Stroke="#FF6DBDD1" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <DrawingImage x:Key="DefaultIcon" >
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M -6.10352e-005,8.75355L 21.6666,8.75355L 21.6666,30.4202L -6.10352e-005,30.4202L -6.10352e-005,8.75355 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 0.333282,32.0869L 21.9999,32.0869L 21.9999,53.7536L 0.333282,53.7536L 0.333282,32.0869 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 0.666626,55.7536L 22.3333,55.7536L 22.3333,77.4202L 0.666626,77.4202L 0.666626,55.7536 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 23.6668,8.92012L 45.3335,8.92012L 45.3335,30.5868L 23.6668,30.5868L 23.6668,8.92012 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 64.14,-3.43323e-005L 81.6968,12.6965L 69.0002,30.2534L 51.4434,17.5568L 64.14,-3.43323e-005 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 24.0002,32.2534L 45.6668,32.2534L 45.6668,53.9201L 24.0002,53.9201L 24.0002,32.2534 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 24.3335,55.9201L 46.0002,55.9201L 46.0002,77.5868L 24.3335,77.5868L 24.3335,55.9201 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 47.6668,32.2201L 69.3335,32.2201L 69.3335,53.8868L 47.6668,53.8868L 47.6668,32.2201 Z "/>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="F1 M 48.0002,55.8868L 69.6668,55.8868L 69.6668,77.5535L 48.0002,77.5535L 48.0002,55.8868 Z "/>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style TargetType="{x:Type local:SfChromelessWindow}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Icon" Value="{StaticResource DefaultIcon}"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="BorderBrush" Value="#FF007ACC"/>
        <Setter Property="CaptionBackground" Value="#FF007ACC"/>
        <Setter Property="CaptionForeground" Value="White"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SfChromelessWindow}">
                    <AdornerDecorator>
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding CaptionHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <!--Title area-->
                                <Grid Background="{TemplateBinding CaptionBackground}" Name="TitleBarBorder">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{TemplateBinding Icon}" 
                                       Stretch="Uniform" Width="16" Margin="3 1"/>
                                    <TextBlock Text="{TemplateBinding Title}" Grid.Column="1"
                                           Foreground="{TemplateBinding CaptionForeground}"
                                           VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding CaptionAlignment}"
                                           FontSize="{TemplateBinding CaptionFontSize}"/>

                                    <Viewbox Grid.Column="2" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Stretch="Uniform" Height="20">
                                        <StackPanel Orientation="Horizontal" x:Name="PART_WindowsButton">
                                            <Button x:Name="PART_Minimize" Command="{x:Static local:SfChromelessWindow.Minimize}"
                                                    Style="{StaticResource CaptionButtonStyle}" Background="Transparent">
                                                <Image Source="/Syncfusion.SfChromelessWindow.WPF;component/Resources/minimize.png"/>
                                            </Button>
                                            <Button x:Name="PART_Restore"  Command="{x:Static local:SfChromelessWindow.Restore}"
                                                    Style="{StaticResource CaptionButtonStyle}" Background="Transparent">
                                                <Image Source="/Syncfusion.SfChromelessWindow.WPF;component/Resources/restore.png"/>
                                            </Button>
                                            <Button x:Name="PART_Maximize"  Command="{x:Static local:SfChromelessWindow.Maximize}"
                                                    Style="{StaticResource CaptionButtonStyle}" Background="Transparent">
                                                <Image Source="/Syncfusion.SfChromelessWindow.WPF;component/Resources/maximize.png"/>
                                            </Button>
                                            <Button x:Name="PART_Close"  Command="{x:Static local:SfChromelessWindow.Close}"
                                                    Style="{StaticResource CaptionButtonStyle}" Background="Transparent" Foreground="red">
                                                <Image Source="/Syncfusion.SfChromelessWindow.WPF;component/Resources/close.png"/>
                                            </Button>
                                        </StackPanel>
                                    </Viewbox>
                                </Grid>

                                <!--Content area-->
                                <ContentPresenter Grid.Row="1"/>
                                
                                <!--Resize area-->
                                <ResizeGrip Grid.Row="1" HorizontalAlignment="Right"
                                            x:Name="Grip" Visibility="Collapsed"
                                            VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
                            </Grid>

                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter Property="Visibility" TargetName="Grip" Value="Visible"/>
                        </Trigger>
                        <Trigger  Property="WindowStyle" Value="None">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TitleBarBorder"/>
                        </Trigger>
                        <Trigger  Property="WindowStyle" Value="ToolWindow">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PART_Minimize"/>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PART_Restore"/>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PART_Maximize"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
     
    </Style>

</ResourceDictionary>
