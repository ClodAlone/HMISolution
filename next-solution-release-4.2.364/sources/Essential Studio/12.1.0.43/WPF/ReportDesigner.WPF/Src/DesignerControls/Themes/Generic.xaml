<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Controls"              
    xmlns:user="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs" 
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>   
   
    <Style TargetType="{x:Type local:TextBoxControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TextBoxControl}">
                    <Grid>
                        <RichTextBox Name="PART_InnerTextBox"  IsDocumentEnabled="True"   HorizontalContentAlignment="Stretch"
                             AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <RichTextBox.ContextMenu>
                                <ContextMenu x:Name="cm">
                                    <MenuItem x:Name="PART_TextBoxHeader" Header="Text Box" IsHitTestVisible="False" Background="White" Foreground="Black" Margin="-20,0,0,0" />
                                    <MenuItem x:Name="PART_Cut" Header="{x:Static prop:Resources.labelCut}" />
                                    <MenuItem x:Name="PART_Copy" Header="{x:Static prop:Resources.labelCopy}" />
                                    <MenuItem x:Name="PART_Paste" Header="{x:Static prop:Resources.labelPaste}" />
                                    <MenuItem x:Name="PART_TextProperty" Header="{x:Static prop:Resources.titleTextProperties}"/>
                                    <MenuItem x:Name="PART_CreatePlaceHolder" Header="{x:Static prop:Resources.titleCreatePlaceHolder}"/>
                                    <MenuItem x:Name="PART_Expression" Header="{x:Static prop:Resources.titleTextBoxExpression}"/>
                                    <MenuItem x:Name="PART_TextBoxProperty" Header="{x:Static prop:Resources.titleTextBoxProperties}"/>
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                            <FlowDocument x:Name="TextBox_FlowDocument" >
                                <FlowDocument.Blocks>
                                    <Paragraph x:Name="Part_Paragraph">
                                        <Run>
                                        </Run>
                                    </Paragraph>
                                </FlowDocument.Blocks>
                            </FlowDocument>
                        </RichTextBox>
                        <local:DesignerDashStyleBorder x:Name="PART_InnerBorder"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type local:ChartControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartControl}">
                    <Grid>
                        <Grid.Resources>                            
                            <local:LineColorConverter x:Key="LineColor"></local:LineColorConverter>
                            <local:VisibilityConverter x:Key="visible"></local:VisibilityConverter>
                            <local:LegendPosionConverter x:Key="LegendPosition"></local:LegendPosionConverter>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Gray" x:Name="PART_ValueInnerBorder"  Height="30" Visibility="Collapsed" Margin="0"
                                BorderThickness="2,2,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="White">
                            <Grid Background="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PART_ValuePanel" Grid.Column="0" Background="White" 
                                            Orientation="Horizontal" HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Stretch"/>
                                <Label x:Name="PART_ValueDataField" Grid.Column="1" Height="13" Width="13"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{StaticResource SmartTag}"/>
                            </Grid>
                         </Border>
                        <syncfusion:Chart x:Name="PART_InnerChart" HorizontalAlignment="Stretch" ToolTip="Chart ToolTip"
                                          VerticalAlignment="Stretch" Background="White" BorderThickness="0" BorderBrush="Transparent">                           
                            <syncfusion:Chart.Header>
                                <TextBox x:Name="ChartHeader" Style="{StaticResource TextBoxStyle}">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="PART_DeleteTitle" Header="{x:Static prop:Resources.headerDeleteChartTitle}" HorizontalAlignment="Left">
                                                <MenuItem.Icon>
                                                    <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/delete prop.gif" Height="16" Width="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Name="PART_Seperator"></Separator>
                                            <MenuItem x:Name="PART_TitleProperties" Header="{x:Static prop:Resources.headerChartTitleProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>                                
                            </syncfusion:Chart.Header>                              
                            
                            <syncfusion:Chart.Legends>
                                <syncfusion:ChartLegend Visibility="Visible" x:Name="PART_ChartLegand"  syncfusion:Chart.Dock="{Binding Position,Converter={StaticResource LegendPosition}}" Foreground="{Binding FontColor,Converter={StaticResource LineColor}}">
                                    <syncfusion:ChartLegend.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="PART_DeleteLegend1" Header="Hide Legend">

                                            </MenuItem>
                                            <Separator Name="PART_Seperator1"></Separator>
                                            <MenuItem x:Name="PART_ShowLegendTitle" Header="Show Legend Title"  IsCheckable="True" IsChecked="False"/>
                                            <Separator Name="PART_seperator2"></Separator>
                                            <MenuItem Header="{x:Static prop:Resources.headerLegendProperties}" x:Name="PART_LegendProperties1">
                                                <MenuItem.Icon>
                                                    <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </syncfusion:ChartLegend.ContextMenu>
                                </syncfusion:ChartLegend>
                            </syncfusion:Chart.Legends>
                            
                            <syncfusion:Chart.ContextMenu>
                                <ContextMenu x:Name="PART_ContextMenu">
                                    <MenuItem Header="{x:Static prop:Resources.headerConvertToFullChart}" x:Name="PART_MenuConvertToFullChart">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerChartProperties}" x:Name="PART_MenuChartProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerSeriesProperties}" x:Name="PART_SeriesProperties" Visibility="Collapsed">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerLegendProperties}" x:Name="PART_LegendProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerValueAxisProperties}" x:Name="PART_ValueAxisProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerCategoryAxisProperties}" x:Name="PART_CategoryAxisProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerChartTitleProperties}" x:Name="PART_ChartTitleProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerCategoryAxisTitleProperties}" 
                                              x:Name="PART_CategoryTitleProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static prop:Resources.headerValueAxisTitleProperties}" x:Name="PART_ValueTitleProperties">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator x:Name="PART_Separetor1"/>
                                    <MenuItem x:Name="PART_AddChartTitle" Header="Show Chart Title"  IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="PART_AddLegend" Header="Show Legend" Visibility="Collapsed"/>
                                    <MenuItem x:Name="PART_ShowCategoryTitle" Header="{x:Static prop:Resources.headerShowCategoryTitle}" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="PART_ShowValueTitle" Header="{x:Static prop:Resources.headerShowValueTitle}" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="PART_ShowDataLabels" Header="{x:Static prop:Resources.headerShowDataLabels}" IsChecked="False" IsCheckable="True"></MenuItem>
                                    <Separator x:Name="PART_Separator2"/>
                               
                                    <MenuItem Header="{x:Static prop:Resources.headerDelete}" x:Name="PART_DeleteProperty">
                                        <MenuItem.Icon>
                                            <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/delete prop.gif" Height="16" Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </syncfusion:Chart.ContextMenu>
                        </syncfusion:Chart>
                        <local:DesignerDashStyleBorder x:Name="PART_InnerBorder" BorderBrush="LightGray" BorderThickness="1"/>                        
                        <Border BorderBrush="Gray" x:Name="PART_ColumnInnerBorder" BorderThickness="2,2,2,2" Height="30" Width="Auto" Margin="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="White" Visibility="Collapsed">
                            <Grid Background="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PART_ColumnPanel" Grid.Column="0" Background="White" 
                                        Orientation="Horizontal" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                                <Label x:Name="PART_ColumnDataField" Grid.Column="1" Height="13" Width="13"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{StaticResource SmartTag}"></Label>
                            </Grid>
                        </Border>
                        <Border BorderBrush="Gray" x:Name="PART_SeriesInnerBorder" Width="100" Margin="0"
                                BorderThickness="2,2,2,2" HorizontalAlignment="Right"  VerticalAlignment="Stretch" Background="White" Visibility="Collapsed">
                            <Grid Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Label x:Name="PART_SeriesDataField" Height="13" Width="13"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                                        Background="{StaticResource SmartTag}"/>

                                <StackPanel x:Name="PART_SeriesPanel" Grid.Row="1" Background="White" 
                                            Orientation="Vertical" HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>                                
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type local:ImageControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageControl}">
                    <Grid>

                        <local:DesignerDashStyleBorder x:Name="PART_ImageBorder" BorderThickness="1">
                                <Grid Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Image x:Name="PART_InternalImage" />

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="PART_DataMenuDelete" Header="{x:Static prop:Resources.headerDelete}">
                                                <MenuItem.Icon>
                                                    <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/delete prop.gif" Height="16" Width="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuProperty" Header="{x:Static prop:Resources.headerImageProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                        </local:DesignerDashStyleBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type local:MapControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MapControl}">
                    <Grid>
                        <Grid>
                            <TextBlock x:Name="PART_DataMapTitle" VerticalAlignment="Top" HorizontalAlignment="Center"  >Map Title</TextBlock>
                        </Grid>
                        <local:DesignerDashStyleBorder x:Name="PART_MapBorder" >
                            
                            <Grid x:Name="PART_InternalMapGrid"  Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">


                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="PART_DataAddLayer" Header="{x:Static prop:Resources.headerAddLayer}">
                                            
                                        </MenuItem>
                                        <Separator Name="PART_Seperator"></Separator>
                                        <MenuItem x:Name="PART_DataMenuDelete" Header="{x:Static prop:Resources.headerDelete}">
                                            <MenuItem.Icon>
                                                <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/delete prop.gif" Height="16" Width="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="PART_DataMenuProperty" Header="{x:Static prop:Resources.headerMapProperties}">
                                            <MenuItem.Icon>
                                                <Image Source="/Syncfusion.ReportDesigner.WPF;component/Images/properties.png" Height="16" Width="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </local:DesignerDashStyleBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type local:GaugeControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GaugeControl}">
                    <Grid>
                        <Grid.Resources>
                            <local:RadiusConvertor x:Key="RadiusConv"></local:RadiusConvertor>
                        </Grid.Resources>                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="Gray" x:Name="PART_ValueInnerBorder" Margin="0"
                                BorderThickness="2,2,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="WhiteSmoke"  Height="30">                                                 
                            <Grid x:Name="PART_DataField" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>

                        <StackPanel x:Name="PART_ValuePanel" Grid.Column="0" Background="White" 
                        Orientation="Horizontal" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        </StackPanel>

                        <Label x:Name="PART_ValuePanelField" Grid.Column="1" Height="13" Width="13"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Background="{StaticResource SmartTag}">
                        </Label>
                        </Grid>
                        </Border>
                        <Grid>
                            <local:DesignerDashStyleBorder x:Name="PART_GaugePanel" />
                            <syncfusion:CircularGauge x:Name="PART_InternalGauge" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <syncfusion:CircularGauge.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="PART_DataMenuAdd1" Header="{x:Static prop:Resources.headerAddScale}" Visibility="Visible">
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuAdd2" Header="{x:Static prop:Resources.headerAddPointer}" Visibility="Visible">
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuAdd3" Header="{x:Static prop:Resources.headerAddRange}" Visibility="Visible">
                                            </MenuItem>
                                            <Separator x:Name="PART_DataMenuSep1" Visibility="Collapsed"/>
                                            <MenuItem x:Name="PART_DataMenuProperty1" Header="{x:Static prop:Resources.headerScaleProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/properties.png" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuProperty2" Header="{x:Static prop:Resources.headerPointerProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/properties.png" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuProperty3" Header="{x:Static prop:Resources.headerRangeProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/properties.png" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuProperty4" Header="{x:Static prop:Resources.headerGaugeProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/properties.png" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuProperty5" Header="{x:Static prop:Resources.headerGaugePanelProperties}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/properties.png" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator x:Name="PART_DataMenuSep2"/>
                                            <MenuItem x:Name="PART_DataMenuDelete1" Header="{x:Static prop:Resources.headerDeleteRange}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/delete prop.gif" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuDelete2" Header="{x:Static prop:Resources.headerDeletePointer}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/delete prop.gif" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuDelete3" Header="{x:Static prop:Resources.headerDeleteScale}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/delete prop.gif" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="PART_DataMenuDelete4" Header="{x:Static prop:Resources.headerDeleteGauge}">
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/delete prop.gif" Width="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </syncfusion:CircularGauge.ContextMenu>
                                    <syncfusion:CircularGauge.Radius>
                                        <MultiBinding Converter="{StaticResource RadiusConv}">
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" ></Binding>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" ></Binding>
                                        </MultiBinding>
                                    </syncfusion:CircularGauge.Radius>
                                </syncfusion:CircularGauge>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
   
</ResourceDictionary>