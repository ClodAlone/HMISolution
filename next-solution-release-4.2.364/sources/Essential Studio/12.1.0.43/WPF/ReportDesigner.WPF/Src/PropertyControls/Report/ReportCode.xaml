<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ReportCode" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="400" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="265*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Write custom code for this report." VerticalAlignment="Bottom" FontSize="14" Margin="10,0,0,0"></TextBlock>
        <TextBlock x:Name="txt_Name" Text="Custom code:" VerticalAlignment="Center"  Grid.Row="1" Margin="10,0,292,316"></TextBlock>
        <RichTextBox Grid.Row="1" Height="280" HorizontalAlignment="Left" Margin="10,40,0,0" Name="Richtxt_CustomCode" VerticalAlignment="Top" Width="380" VerticalScrollBarVisibility="Visible" />
        </Grid>
</UserControl>
