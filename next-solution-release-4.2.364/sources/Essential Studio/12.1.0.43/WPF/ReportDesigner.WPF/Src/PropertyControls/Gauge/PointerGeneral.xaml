<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.PointerGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>          
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>          
        </Grid.RowDefinitions>
        
        <TextBlock Text="{x:Static prop:Resources.textBlockPointerGeneralInfo}"
                   VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock> 
        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockPointerWidth}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="1" x:Name="updwn_PointerWidth" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25"></syncfusion:UpDown>
            <TextBlock Text="Pointer Value:"  HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <TextBox  x:Name="pointervalue" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25" ></TextBox>            
        </StackPanel>          
        
        <StackPanel Margin="15,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockPointerType}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0" />
            <ComboBox TabIndex="2" Name="cmb_PointerType" SelectedIndex="0" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25" >
                <ComboBox.Items>
                    <ComboBoxItem Content="Needle" />
                    <ComboBoxItem Content="Marker" />
                    <!--<ComboBoxItem Content="Bar" />-->
                </ComboBox.Items>
            </ComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockNeedleType}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <ComboBox TabIndex="3" Name="cmb_NeedleType" SelectedIndex="0" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25">
                <ComboBox.Items>
                    <ComboBoxItem Content="Triangle" />
                    <ComboBoxItem Content="Rectangle" />                    
                    <ComboBoxItem Content="Arrow" />
                </ComboBox.Items>
            </ComboBox>
        </StackPanel>     
        
        <StackPanel Margin="15,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockMarkerStyle}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <ComboBox TabIndex="5" Name="cmb_MarkerStyle" SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25" >
                <ComboBox.Items>
                    <ComboBoxItem Content="Triangle" />
                    <ComboBoxItem Content="Diamond" />
                    <ComboBoxItem Content="Rectangle" />
                    <ComboBoxItem Content="Trapezoid" />
                    <ComboBoxItem Content="Pentagon" />
                </ComboBox.Items>
            </ComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockMarkerPlacement}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <ComboBox TabIndex="6" Name="cmb_MarkerPlacement" SelectedIndex="1" IsEnabled="False" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25" >
                <ComboBox.Items>
                    <ComboBoxItem Content="Inside" />
                    <ComboBoxItem Content="Cross" />
                    <ComboBoxItem Content="Outside" />
                </ComboBox.Items>
            </ComboBox>
        </StackPanel>      

        <StackPanel Margin="15,0,0,0" Grid.Row="4" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockCapRadius}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="7" x:Name="updwn_CapRadius" Width="150" IsEnabled="True" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25"></syncfusion:UpDown>
            <TextBlock Text="{x:Static prop:Resources.textBlockCapColor}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:ColorPicker TabIndex="8" x:Name="clrpkr_CapColor" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="25"/>
        </StackPanel>       
       
    </Grid>
</UserControl>
