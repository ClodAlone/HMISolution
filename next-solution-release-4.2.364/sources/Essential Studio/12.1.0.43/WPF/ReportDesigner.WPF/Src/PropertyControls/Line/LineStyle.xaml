<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.LineStyle" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="350" Width="350"
             x:Name="TextBoxFontUser">
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="EffectsType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:EffectsType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grd_Font">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="190*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change the line style, width, background" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <Grid Grid.Row="1" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="LineStyle:"/>
                <designerlocal:ExpressionComboBox ComboType="LineStyle" TabIndex="1" x:Name="cmb_style" Margin="5,2,0,0" SelectedIndex="1"></designerlocal:ExpressionComboBox>                             
            </StackPanel>
        </Grid>
        
                <StackPanel Orientation="Vertical">
                    <StackPanel Margin="5,10,0,0" x:Name="stpnl_Left" Grid.Row="0" Grid.Column="0" Orientation="Vertical"></StackPanel>
                </StackPanel>
            
                <StackPanel VerticalAlignment="Bottom" Height="Auto" Width="Auto" Orientation="Vertical" Grid.Row="3" Margin="0,0,0,64"></StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Grid Height="70" Width="184">
                <TextBlock Text="LineWidth:" Margin="20,18,94,36" />
                <designerlocal:ExpressionComboBox ComboType="LineWidth" TabIndex="9" x:Name="updwn_Custom" Margin="25,41,0,4"></designerlocal:ExpressionComboBox>
            </Grid>
        </StackPanel>
        <Border Margin="25,33,195,132" Grid.Row="3">
            <designerlocal:CustomUIEditorDropDown TabIndex="1" Height="25" x:Name="cpkr_Font" Margin="0,0,-31,0"/>
        </Border>
        <TextBlock HorizontalAlignment="Left" Text="Color:" Margin="20,11,0,163" Grid.Row="3" />
        <!--<StackPanel x:Name="stpnl_Vertical" Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical">
                <TextBlock Text="Color:" HorizontalAlignment="Left" ></TextBlock>
                <syncfusion:ColorPicker x:Name="cpkr_Font" Color="Black" Height="20" BorderBrush="Black" BorderThickness="1"  VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Text="Effects:" Margin="0,10,0,0" />
                <ComboBox x:Name="cmb_Effects" Width="100" HorizontalAlignment="Left"/>
            </StackPanel>-->
        
    </Grid>
</UserControl>
