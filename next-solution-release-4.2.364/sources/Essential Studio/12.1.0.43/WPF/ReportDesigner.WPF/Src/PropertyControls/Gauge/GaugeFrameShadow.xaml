<UserControl x:Class="Syncfusion.Windows.Reports.PropertyControls.GaugeFrameShadow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Wizard"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid x:Name="grd_FrameShadow">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>            
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Set the Shadow option." VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="15,0,0,0"></TextBlock>

        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Shadow Offset:" HorizontalAlignment="Left" Width="200"></TextBlock>
            <StackPanel Orientation="Horizontal">
                <syncfusion:UpDown x:Name="updwn_ShadowOffset" Width="100" HorizontalAlignment="Left"></syncfusion:UpDown>
                <TextBlock Name="ShadowOffset_RightUnit" Text="pt" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
            </StackPanel>
        </StackPanel>        
    </Grid>
</UserControl>
