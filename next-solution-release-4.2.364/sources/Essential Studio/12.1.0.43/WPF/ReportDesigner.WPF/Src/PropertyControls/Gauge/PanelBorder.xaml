<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.PanelBorder" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
   
        <Grid x:Name="grd_Font">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40" />
            <RowDefinition Height="140*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockBorderOptions}" VerticalAlignment="Center"
                   FontSize="16" Margin="15,0,0,0" />
        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                <TextBlock Text="{x:Static prop:Resources.textBlockTextStyle}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"  />
            <ComboBox TabIndex="1" x:Name="cmb_BorderStyle" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23">
                    <ComboBox.Items>
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Solid"/>
                    </ComboBox.Items>
                </ComboBox>
            </StackPanel>
        <StackPanel Margin="15,-100,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                <TextBlock Text="{x:Static prop:Resources.textBlockWidth}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0" />
            <syncfusion:UpDown TabIndex="2" x:Name="updwn_BorderWidth" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>

                <TextBlock Text="{x:Static prop:Resources.textBlockColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"></TextBlock>
            <syncfusion:ColorPicker TabIndex="3" x:Name="cpkr_BorderColor" Color="Black" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" />
            </StackPanel>
        </Grid>
    
</UserControl>
