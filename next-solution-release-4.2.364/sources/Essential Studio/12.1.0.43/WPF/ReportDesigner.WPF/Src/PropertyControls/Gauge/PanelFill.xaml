<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.PanelFill" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="33"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="217*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockPanelColorInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0" ></TextBlock>

        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center" Orientation="Vertical" Height="50" Grid.Row="1">
            <TextBlock Text="{x:Static prop:Resources.textBlockBackFill}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" />
            <syncfusion:ColorPicker TabIndex="1" x:Name="clrpkr_PanelBackground" Width="150" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left" />

        </StackPanel>
    </Grid>
</UserControl>
