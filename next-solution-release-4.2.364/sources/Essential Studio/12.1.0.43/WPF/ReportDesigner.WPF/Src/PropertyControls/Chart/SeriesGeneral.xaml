<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.SeriesGeneral1" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"  
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="450" >
    <Grid Height="472" Width="452">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="195"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockSeriesInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,2,0,16"></TextBlock>

        <GroupBox Margin="5,-50,5,76" Grid.Row="1" VerticalAlignment="Center" Height="110" BorderThickness="0.2" Width="200" HorizontalAlignment="Left">
            <GroupBox.Header>Series</GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,0,0,0" Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                    <TextBlock Text="{x:Static prop:Resources.textBlockBorderWidth}" HorizontalAlignment="Left" Width="200"
                       VerticalAlignment="Center" Margin="0,-30,0,0"></TextBlock>
                    <designerlocal:ExpressionComboBox ComboType="BorderWidth"  TabIndex="2" x:Name="updwn_SeriesBorderWidth" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,-7,0,-15" Height="23"></designerlocal:ExpressionComboBox>
                </StackPanel>

                <StackPanel Margin="10,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                    <TextBlock Text="{x:Static prop:Resources.textBlockBorderColor}" HorizontalAlignment="Left" Width="200" 
                       VerticalAlignment="Center" Margin="0,-20,0,0"/>
                    <designerlocal:CustomUIEditorDropDown TabIndex="4" x:Name="clrpkr_SeriesBorderColor"
                                            HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>                    
                </StackPanel>


            </Grid>
        </GroupBox>
        <StackPanel Margin="215,-130,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="110">
            <StackPanel Margin="10,-80,0,0" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                <TextBlock Text="{x:Static prop:Resources.textBlockColor}"  HorizontalAlignment="Left" Width="200"
                       VerticalAlignment="Center" Margin="0,15,0,0"/>
                <designerlocal:CustomUIEditorDropDown TabIndex="3" Height="23" x:Name="clrpkr_SeriesColor" 
                                           HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,38,0,-15"></designerlocal:CustomUIEditorDropDown>
            </StackPanel>
            <StackPanel Margin="-200,50,0,0" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                    <TextBlock Text="Type:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-20,0,0"/>
                    <designerlocal:ExpressionComboBox ComboType="ChartType" TabIndex="2" x:Name="cmb_ChartType" SelectedIndex="4" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,2,0,-15" Height="23"></designerlocal:ExpressionComboBox>
            </StackPanel>
        </StackPanel>
        <GroupBox Name="groupBox_Adorner" Margin="5,-210,5,64" Grid.Row="2" VerticalAlignment="Center" Height="130" Grid.RowSpan="2" BorderThickness="0.2" Width="439">
            <GroupBox.Header>Adorner</GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,-60,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="40">
                    <TextBlock Text="{x:Static prop:Resources.textBlockType}" HorizontalAlignment="Left" Width="200"
                       VerticalAlignment="Center" Margin="0,-30,0,0"/>
                    
                    <ComboBox TabIndex="5" Name="cmb_MarkerType" SelectedIndex="0" Width="150 " IsEnabled="True"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23">
                        <ComboBox.Items>
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Cross"/>
                            <ComboBoxItem Content="Diamond"/>
                            <ComboBoxItem Content="Square"/>                            
                            <ComboBoxItem Content="Triangle"/>
                        </ComboBox.Items>
                    </ComboBox>
                    <TextBlock Text="{x:Static prop:Resources.textBlockTextSize}" HorizontalAlignment="Left" Width="200"
                       VerticalAlignment="Center" Margin="0,-30,0,0"/>
                    <StackPanel Orientation="Horizontal">                        
                        <designerlocal:ExpressionComboBox TabIndex="6" x:Name="updwn_MarkerSize" Width="150" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
                        </StackPanel>
                </StackPanel>

                <StackPanel Margin="10,-40,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                    <TextBlock Text="{x:Static prop:Resources.textBlockColor}" HorizontalAlignment="Left" Width="200"
                       VerticalAlignment="Center" Margin="0,-30,0,0"/>
                    <designerlocal:CustomUIEditorDropDown TabIndex="7" Height="23" x:Name="clrpkr_MarkerColor" Width="150"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-15"></designerlocal:CustomUIEditorDropDown>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Margin="5,-50,0,94" Grid.Row="1" VerticalAlignment="Center" Height="100" BorderThickness="0.2" Width="439" HorizontalAlignment="Left" Grid.RowSpan="2">
            <GroupBox.Header>Data Label</GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="30"/>                    
                </Grid.RowDefinitions>
                <StackPanel Margin="10,-50,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="20">
                    <CheckBox x:Name="chk_ShowDataLabels" IsChecked="False" HorizontalAlignment="Left" Width="200"  VerticalAlignment="Center" Margin="0,-30,0,0" Click="chk_ShowDataLabels_Click">Show Data Labels</CheckBox>
                </StackPanel>
                <StackPanel Margin="10,-10,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
                <TextBlock Text="Position:" HorizontalAlignment="Left" Width="200"
                       VerticalAlignment="Center" Margin="0,-30,0,0"/>
                    <ComboBox TabIndex="5" Name="cmb_DatalabelPosition" SelectedIndex="0" Width="150 " IsEnabled="True"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23">
                        <ComboBox.Items>
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Top"/>
                            <ComboBoxItem Content="TopLeft"/>
                            <ComboBoxItem Content="TopRight"/>
                            <ComboBoxItem Content="Left"/>
                            <ComboBoxItem Content="Center"/>
                            <ComboBoxItem Content="Right"/>
                            <ComboBoxItem Content="BottomRight"/>
                            <ComboBoxItem Content="Bottom"/>
                            <ComboBoxItem Content="BottomLeft"/>
                            <ComboBoxItem Content="OutSide"></ComboBoxItem>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
