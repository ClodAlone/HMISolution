<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.PanelGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="220*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockPanelGeneralInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0" ></TextBlock>
        <StackPanel x:Name="stpnl_Name" Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockName}" HorizontalAlignment="Left" Width="50" ></TextBlock>
            <TextBox TabIndex="1" Name="txt_GeneralName" HorizontalAlignment="Left" Width="350" Height="23" />
        </StackPanel>
        
        <StackPanel  Margin="15,10,0,0" x:Name="stpnl_Value" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBLockDatasetName}" HorizontalAlignment="Left" Width="300" ></TextBlock>
            <ComboBox TabIndex="2" Name="cmb_datasetName" HorizontalAlignment="Left" Width="350" Height="23">

            </ComboBox>
        </StackPanel>
        <StackPanel Margin="15,65,80,0" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
            <StackPanel Height="26" Background="#FFD3E2EE"  Width="350">
                <TextBlock FontWeight="Bold" Text="{x:Static prop:Resources.textBlockPageBreakOptions}" Height="23" Width="350" />
            </StackPanel>
            <CheckBox TabIndex="4" Name="chk_AddPageBreakBefore" Margin="20,5,0,0" Content="{x:Static prop:Resources.chkBoxAddPageBreakBefore}" HorizontalAlignment="Left" Width="300" />
            <CheckBox TabIndex="5" Name="chk_AddPageBreakAfter" Margin="20,5,0,0" Content="{x:Static prop:Resources.chkBoxAddPageBreakAfter}" HorizontalAlignment="Left" Width="300" />
        </StackPanel>
    </Grid>
</UserControl>
