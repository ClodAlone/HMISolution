<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TextBoxAlignment" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="300" Width="366">
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="HorizontalAlignmentType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:HorizontalAlignmentType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="VerticalAlignmentType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:VerticalAlignmentType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grd_Alignment" Width="366">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="20"/>
            <!--<RowDefinition Height="40"/>-->
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockTextAlignInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="20,0,20,0" Grid.Row="1" Height="20" Background="CornflowerBlue">
            <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="{x:Static prop:Resources.textBlockHorizontalAlignments}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="30,0,0,0" x:Name="stpnl_Horizontal" Grid.Column="0" VerticalAlignment="Top" Orientation="Vertical">
                <TextBlock Text="{x:Static prop:Resources.textBlockHorizontal}" HorizontalAlignment="Left" ></TextBlock>
                <designerlocal:ExpressionComboBox TabIndex="1" x:Name="cmb_HorizontalValue" ComboType="HorizontalAlignment"  SelectedIndex="0" Height="23" HorizontalAlignment="Left" Width="100" />
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>-->

            </StackPanel>
            <StackPanel Margin="30,0,0,0" x:Name="stpnl_Vertical" Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical">
                <TextBlock Text="{x:Static prop:Resources.textBlockVertical}" HorizontalAlignment="Left" ></TextBlock>
                <designerlocal:ExpressionComboBox TabIndex="2" x:Name="cmb_VerticalValue" ComboType="VerticalAlignment" SelectedIndex="0" HorizontalAlignment="Left" Height="23" Width="100"/>
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>-->

            </StackPanel>
        </Grid>
        <Grid x:Name="PaddingGrid" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Margin="20,0,20,0" Grid.Row="0" Grid.ColumnSpan="2" Height="20" Background="CornflowerBlue">
                <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="{x:Static prop:Resources.textBlockPaddingOptions}" />
            </StackPanel>
            <StackPanel Margin="30,0,0,0" x:Name="stpnl_Left" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Orientation="Vertical">
                <TextBlock Text="Left:" HorizontalAlignment="Left" ></TextBlock>
                <StackPanel Orientation="Horizontal">
                    <designerlocal:ExpressionComboBox TabIndex="3" x:Name="updwn_Left" ComboType="BorderWidth"  IsEnabled="True" Height="25" Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="30,0,0,0" Orientation="Vertical" VerticalAlignment="Top" Grid.Column="1" Grid.Row="1">
                <TextBlock HorizontalAlignment="Left" Text="Right:" />
                <StackPanel Orientation="Horizontal">
                    <designerlocal:ExpressionComboBox ComboType="BorderWidth" HorizontalAlignment="Left" IsEnabled="True" x:Name="updwn_Right" TabIndex="3" Height="25" Width="100" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="30,0,0,0" Orientation="Vertical" VerticalAlignment="Top" Grid.Row="2">
                <TextBlock HorizontalAlignment="Left" Text="Top:" />
                <StackPanel Orientation="Horizontal">
                    <designerlocal:ExpressionComboBox ComboType="BorderWidth" HorizontalAlignment="Left" IsEnabled="True" x:Name="updwn_Top" TabIndex="3" Height="25" Width="100" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="30,0,0,0"  Orientation="Vertical" VerticalAlignment="Top" Grid.Column="1" Grid.Row="2">
                <TextBlock HorizontalAlignment="Left" Text="Bottom:" />
                <StackPanel Orientation="Horizontal">
                    <designerlocal:ExpressionComboBox ComboType="BorderWidth" HorizontalAlignment="Left" IsEnabled="True" x:Name="updwn_Bottom" TabIndex="3" Height="25" Width="100" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
