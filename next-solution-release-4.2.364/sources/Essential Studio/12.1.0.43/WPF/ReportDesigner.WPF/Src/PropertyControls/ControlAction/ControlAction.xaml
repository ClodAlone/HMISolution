<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ControlAction" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"              
    Height="400" Width="400">
    <Grid x:Name="grd_Action" Height="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="30*" />
            <RowDefinition Height="75*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="280*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change hyperlink options." VerticalAlignment="Center" FontSize="14" Margin="10,5,0,0" />
        <RadioButton Content="None" Grid.Row="1" Height="23" HorizontalAlignment="Left" Margin="20,0,0,0" Name="rbtn_None" VerticalAlignment="Top" Width="250" IsChecked="True" />
        <RadioButton Content="Go to Report" Height="23" HorizontalAlignment="Left" Margin="20,25,0,0" Name="rbtn_goToReport" VerticalAlignment="Top" Width="250" Grid.Row="1" />
        <RadioButton Content="Go to URL" Height="23" HorizontalAlignment="Left" Margin="20,50,0,0" Name="rbtn_goToUrl" VerticalAlignment="Top" Width="250" Grid.Row="1" />
        <StackPanel Grid.Row="3" Height="50" HorizontalAlignment="Left" Margin="20,0,0,0" Name="stpnl_Url" VerticalAlignment="Top" Width="380" Visibility="Hidden">
            <TextBlock Height="23" Name="txt_Name" Text="Select an Url." Width="160" HorizontalAlignment="Left"/>
            <ComboBox Height="23" Name="cmbx_UrlPath" Width="380" HorizontalAlignment="Left" IsEditable="True" />
        </StackPanel>
        <StackPanel Grid.Row="3" Height="350" HorizontalAlignment="Left" Margin="20,0,0,0" Name="stpnl_Report" VerticalAlignment="Top" Width="380" Visibility="Hidden">
            <TextBlock Height="23" Text="Select a report." Width="160" HorizontalAlignment="Left" />
            <TextBox Height="23" Name="txt_reportName" Width="380" HorizontalAlignment="Left" />
            <Button Content="Browse" Height="23" Name="btn_browse" Width="80" HorizontalAlignment="right" Margin="0,5,0,0"/>
            <TextBlock Height="20" Text="Use these parameters to run report." Width="300" HorizontalAlignment="Left" />
            <StackPanel Margin="0,0,0,0" Orientation="Horizontal" Height="35" VerticalAlignment="Top">
                <Button Content="{x:Static prop:Resources.btnAdd}" x:Name="btn_Add" Margin="0,10,10,5" Width="50" Click="btn_Add_Click"/>
                <Button Content="{x:Static prop:Resources.btnDelete}" x:Name="btn_Delete" Margin="0,10,10,5" Width="50" IsEnabled="False" Click="btn_Delete_Click" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lbx_Parameters" Height="150" Width="380">
                        <ListBoxItem IsSelected="False" IsHitTestVisible="False">
                            <StackPanel Width="360" Orientation="Horizontal">
                                <TextBlock Text="Name" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"></TextBlock>
                                <TextBlock Text="Value" Margin="160,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"></TextBlock>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
