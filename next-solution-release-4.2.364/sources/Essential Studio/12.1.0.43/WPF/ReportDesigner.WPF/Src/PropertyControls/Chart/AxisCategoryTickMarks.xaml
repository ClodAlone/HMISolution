<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.AxisCategoryTickMarks" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="450" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockMajorMinorTickInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,2,0,16"></TextBlock>

        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockTickStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="TickStyle" TabIndex="2" x:Name="cmb_MajorStyle" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockTickWidth}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="BorderWidth" TabIndex="2" x:Name="updwn_MajorWidth" SelectedIndex="1" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockTickColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="4" x:Name="clrpkr_MajorColor"
                                            HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>
        </StackPanel>



        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Center">
            <TextBlock Text="{x:Static prop:Resources.textBlockMajorTick}" HorizontalAlignment="Left" Width="405" Background="CornflowerBlue"
                       VerticalAlignment="Center" ></TextBlock>
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="4" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.chkBoxHideMajorTick}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-15,0,15"/>
            <designerlocal:ExpressionComboBox ComboType="Hidden" TabIndex="2" x:Name="cmb_HideMajorTick" SelectedIndex="2" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockTickLength}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-15,0,15"/>
            <designerlocal:ExpressionComboBox ComboType="BorderWidth"  TabIndex="2" x:Name="updwn_MajorLength" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" SelectedIndex="1"></designerlocal:ExpressionComboBox>
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="5" VerticalAlignment="Center">
            <TextBlock Text="{x:Static prop:Resources.textBlockMinorTick}" HorizontalAlignment="Left" Width="405" Background="CornflowerBlue"
                       VerticalAlignment="Center" ></TextBlock>
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="6" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="{x:Static prop:Resources.chkBoxHideMinorTick}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-20,0,15"/>
            <designerlocal:ExpressionComboBox ComboType="Hidden" TabIndex="2" x:Name="cmb_HideMinorTick" SelectedIndex="2" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockTickLength}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-20,0,15"/>
            <designerlocal:ExpressionComboBox ComboType="BorderWidth"  TabIndex="2" x:Name="updwn_MinorLength" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" SelectedIndex="1"></designerlocal:ExpressionComboBox>
        </StackPanel>

    </Grid>
</UserControl>
