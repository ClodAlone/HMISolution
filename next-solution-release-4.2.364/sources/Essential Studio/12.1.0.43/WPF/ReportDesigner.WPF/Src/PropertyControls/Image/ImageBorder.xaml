<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ImageBorder" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"              
    Height="400" Width="400">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40*" />
            <RowDefinition Height="240*" />
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="txt_HeaderText" Text="Change border color,style and width options." VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Width" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100"/>
            <Border Height="25"  HorizontalAlignment="Left">
                <designerlocal:ExpressionComboBox x:Name="updwn_BorderThickness"  ComboType="BorderWidth" Width="175" Height="25"></designerlocal:ExpressionComboBox>
            </Border>
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Color" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100"/>
            <Border HorizontalAlignment="Left">
                <designerlocal:CustomUIEditorDropDown TabIndex="1" x:Name="clrpkr_BorderColor" Height="25" Width="175"/>
            </Border>
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Style" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100"/>
            <Border HorizontalAlignment="Left">
                <designerlocal:ExpressionComboBox x:Name="updwn_borderstyle"  ComboType="BorderStyle" Width="175" Height="25"></designerlocal:ExpressionComboBox>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
