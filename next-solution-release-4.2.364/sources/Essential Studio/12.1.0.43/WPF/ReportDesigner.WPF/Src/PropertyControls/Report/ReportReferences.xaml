<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ReportReferences" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="400" Width="400" >    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="180*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="180*" />
        </Grid.RowDefinitions>
        <TextBlock Height="25" HorizontalAlignment="Left" Margin="10,5,0,0" Name="txt_HeaderText" Text="Set refernces to assemblies and classes." FontSize="14" VerticalAlignment="Top" Width="330" />
        <Grid Margin="0,0,0,0" Grid.Row="1" x:Name="grd_AddAssembly" Visibility="Visible">
            <TextBlock Height="20" HorizontalAlignment="Left" Margin="20,0,0,0" Name="txt_Assembly" Text="Add or remove assemblies." VerticalAlignment="Top" Width="150" />
            <StackPanel Margin="20,18,0,0" Orientation="Horizontal" Height="20" VerticalAlignment="Top">
                <Button Content="{x:Static prop:Resources.btnAdd}" x:Name="btn_Add" Margin="0,0,10,0" Width="50" Click="btn_Add_Click" />
                <Button Content="{x:Static prop:Resources.btnDelete}" x:Name="btn_Delete" Margin="0,0,10,0" Width="50" IsEnabled="False" Click="btn_Delete_Click" />
                <Button Margin="0,0,10,0" Width="25"  x:Name="btn_UpArrow" IsEnabled="False" Click="btn_UpArrow_Click">
                    <Image Source="../../Images/UpArrow.png" Width="15" Height="15"/>
                </Button>
                <Button Margin="0,0,10,0" Width="25" x:Name="btn_DownArrow" IsEnabled="False" Click="btn_DownArrow_Click">
                    <Image Source="../../Images/DownArrow.png" Width="15" Height="15"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,40,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lbx_Assemblies" Height="140" Width="360">                                               
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" x:Name="grd_AddClasses" Visibility="Visible" Grid.RowSpan="2">
            <TextBlock Height="20" HorizontalAlignment="Left" Margin="20,0,0,0" Name="txt_Classes" Text="Add or remove classes." VerticalAlignment="Top" Width="150" />
            <StackPanel Margin="20,18,0,0" Orientation="Horizontal" Height="20" VerticalAlignment="Top">
                <Button Content="{x:Static prop:Resources.btnAdd}" x:Name="btn_Class_Add" Margin="0,0,10,0" Width="50" Click="btn_Class_Add_Click" />
                <Button Content="{x:Static prop:Resources.btnDelete}" x:Name="btn_Class_Delete" Margin="0,0,10,0" Width="50" IsEnabled="False" Click="btn_Class_Delete_Click" />
                <Button Margin="0,0,10,0" Width="25"  x:Name="btn_Class_UpArrow" IsEnabled="False" Click="btn_Class_UpArrow_Click">
                    <Image Source="../../Images/UpArrow.png" Width="15" Height="15"/>
                </Button>
                <Button Margin="0,0,10,0" Width="25" x:Name="btn_Class_DownArrow" IsEnabled="False" Click="btn_Class_DownArrow_Click">
                    <Image Source="../../Images/DownArrow.png" Width="15" Height="15"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,40,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lbx_Classes" Height="140" Width="360">
                        <ListBoxItem IsSelected="False" IsHitTestVisible="False">
                            <StackPanel Width="340" Orientation="Horizontal">
                                <TextBlock Text="Class Name" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"></TextBlock>
                                <TextBlock Text="Instance Name" Margin="140,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"></TextBlock>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
