<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.RangeBorder" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>            
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static prop:Resources.textBlockRangeBorderInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        
        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockBorderWidth}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="1" x:Name="updwn_RangeBorderWidth" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
            <TextBlock Text="{x:Static prop:Resources.textBlockBorderColor}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:ColorPicker TabIndex="2" x:Name="clrpkr_BorderColor" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>
        </StackPanel>           
    </Grid>
</UserControl>
