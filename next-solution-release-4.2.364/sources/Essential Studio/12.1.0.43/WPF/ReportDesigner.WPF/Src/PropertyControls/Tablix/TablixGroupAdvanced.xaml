<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixGroupAdvanced" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue" 
    Height="400" Width="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="80" />
            <RowDefinition Height="80" />
            <RowDefinition Height="188*" />
        </Grid.RowDefinitions>
        <TextBlock Height="20" FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,0" Name="textBlock1" Text="Set additional group properties." VerticalAlignment="Center" Width="200" />
        <StackPanel Grid.Row="1" Margin="10,0,0,0">
            <StackPanel Height="20" Background="CornflowerBlue">
                <TextBlock FontWeight="Bold" Margin="10,0,0,0" Text="Recursive parent" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="30,10,0,0">
                <ComboBox Height="25" Name="cmb_RecursiveParent" Width="250" />
                <Button Content="fx" FontStyle="Italic" Height="25" Margin="10,0,0,0" Width="40" Click="RecursiveButton_Click" FontFamily="Bodoni MT" FontWeight="Bold" FontSize="11" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="10,0,0,0">
            <StackPanel Height="20" Background="CornflowerBlue">
                <TextBlock FontWeight="Bold" Margin="10,0,0,0" Text="Document map" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="30,10,0,0">
                <ComboBox Name="cmb_DocumentMap" Height="25" Width="250" />
                <Button Height="25" Width="40" Margin="10,0,0,0" Content="fx" FontStyle="Italic" Click="DocumentMapButton_Click" FontSize="11" FontFamily="Bodoni MT" FontWeight="Bold" />
            </StackPanel>            
        </StackPanel>
    </Grid>
</UserControl>
