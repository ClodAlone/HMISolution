<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ScaleMajorTick" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>            
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockMajorTickInfo}" 
                   VerticalAlignment="Center" Margin="15,0,0,0" FontSize="16"></TextBlock>
         
        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockTickLength}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="1" x:Name="updwn_MajorTickLength" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>
            <TextBlock Text="{x:Static prop:Resources.textBlockTickWidth}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="2" x:Name="updwn_MajorTickWidth" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>
        </StackPanel>       
     
        
        <StackPanel Margin="15,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockTickShape}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0" ></TextBlock>
            <ComboBox TabIndex="3" Name="cmb_MajorTickShape" SelectedIndex="0" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" >
                <ComboBox.Items>
                    <ComboBoxItem Content="Rectangle"/>
                    <ComboBoxItem Content="Rounded rectangle"/>
                    <ComboBoxItem Content="Ellipse"/>
                    <ComboBoxItem Content="Triangle"/>
                </ComboBox.Items>
            </ComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockTickColor}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:ColorPicker TabIndex="5" x:Name="clrpkr_MajorTickColor" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>        
        </StackPanel>
        
        <StackPanel Margin="15,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockPlacement}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0" />
            <ComboBox TabIndex="4" Name="cmb_MajorTickPlacement" SelectedIndex="0" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" >
                <ComboBox.Items>
                    <ComboBoxItem Content="Cross"/>
                    <ComboBoxItem Content="Inside"/>
                    <ComboBoxItem Content="Outside"/>
                </ComboBox.Items>
            </ComboBox>
        </StackPanel>       
    </Grid>
</UserControl>
