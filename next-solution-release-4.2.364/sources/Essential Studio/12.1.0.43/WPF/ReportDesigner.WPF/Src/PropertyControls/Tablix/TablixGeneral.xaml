<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="400">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="300*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change name and value" VerticalAlignment="Center" FontSize="14" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="Name:" HorizontalAlignment="Left" Width="50"></TextBlock>
            <TextBox TabIndex="1" Name="txt_GeneralName" HorizontalAlignment="Left" Width="300" Height="25" />
        </StackPanel> 
        <Grid Grid.Row="2" HorizontalAlignment="Left" Name="grd_TablixGeneral" Width="400"  VerticalAlignment="Top" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="50" />
                <RowDefinition Height="90" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <StackPanel Margin="20,0,0,0" Grid.Row="0" VerticalAlignment="Top" Orientation="Vertical" Grid.RowSpan="2">
                <TextBlock Text="ToolTip:" HorizontalAlignment="Left" Width="300"></TextBlock>
                <TextBox TabIndex="2" Name="txt_ToolTip" HorizontalAlignment="Left" Width="300" Height="25" />
            </StackPanel>
            <StackPanel Margin="20,0,0,0" x:Name="stpnl_Value" Grid.Row="1" VerticalAlignment="Top" Orientation="Vertical">
                <TextBlock Text="Dataset name:" HorizontalAlignment="Left" Width="300"></TextBlock>
                <ComboBox TabIndex="3" Name="cmb_DatasetName" HorizontalAlignment="Left" Width="300" Height="25">
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="20,0,80,0" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
                <StackPanel Height="20" Background="CornflowerBlue">
                    <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="Page break options:" />
                </StackPanel>
                <CheckBox Name="chk_BreakBefore" Margin="10,5,0,0" Content="Add a page break before" HorizontalAlignment="Left" Width="300" />
                <CheckBox Name="chk_BreakAfter" Margin="10,5,0,0" Content="Add a page break after" HorizontalAlignment="Left" Width="300" />
                <CheckBox Name="chk_Keeptogether" Margin="10,5,0,0" Content="Keep together on one page if possible" HorizontalAlignment="Left" Width="300" />
            </StackPanel>
            <StackPanel Margin="20,0,80,0" Grid.Row="3" VerticalAlignment="Top" Orientation="Vertical">
                <StackPanel Height="20" Background="CornflowerBlue">
                    <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="Row Headers:" />
                </StackPanel>
                <CheckBox Name="chk_RepeatRowHeaders" Margin="10,5,0,0" Content="Repeat header rows on each page" HorizontalAlignment="Left" Width="300" />
                <CheckBox Name="chk_KeepRowHeaderVisible" Margin="10,5,0,0" Content="Keep header visible while scrolling" HorizontalAlignment="Left" Width="300" />
            </StackPanel>
            <StackPanel Margin="20,0,80,0" Grid.Row="4" VerticalAlignment="Top" Orientation="Vertical">
                <StackPanel Height="20" Background="CornflowerBlue">
                    <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="Column Headers:" />
                </StackPanel>
                <CheckBox Name="chk_RepeatColHeaders" Margin="10,5,0,0" Content="Repeat header columns on each page" HorizontalAlignment="Left" Width="300" />
                <CheckBox Name="chk_KeepColHeaderVisible" Margin="10,5,0,0" Content="Keep header visible while scrolling" HorizontalAlignment="Left" Width="300" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Height="300" Margin="0,10,0,0" HorizontalAlignment="Left" Name="grd_GroupGeneral" VerticalAlignment="Top" Width="400" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="250*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="20,0,80,0" Text="Group expressions:"/>
            <StackPanel Margin="20,0,0,0" Orientation="Horizontal" Height="35" VerticalAlignment="Top" Grid.Row="1">
                <Button Content="Add" x:Name="btn_Add" Margin="0,5,10,5" Width="65" Click="btn_Add_Click" />
                <Button Content="Delete" x:Name="btn_Delete" Margin="0,5,10,5" Width="65" IsEnabled="False" Click="btn_Delete_Click" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,35,0,0" Grid.Row="2">
                    <ListBox x:Name="lbx_GroupExpression" Height="150" Width="360">
                    </ListBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
