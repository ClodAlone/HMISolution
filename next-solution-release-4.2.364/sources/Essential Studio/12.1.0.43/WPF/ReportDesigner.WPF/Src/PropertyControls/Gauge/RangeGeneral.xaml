<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.RangeGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="450" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>           
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static prop:Resources.textBlockRangeGeneralInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>

        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockStartRange}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="1" x:Name="updwn_StartRange" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
            <TextBlock Text="{x:Static prop:Resources.textBlockEndRange}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="2" x:Name="updwn_EndRange" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
        </StackPanel>      

        <StackPanel Margin="15,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockStartWidth}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="3" x:Name="updwn_RangeStartWidth" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
            <TextBlock Text="{x:Static prop:Resources.textBlockEndWidth}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0" />
            <syncfusion:UpDown TabIndex="4" x:Name="updwn_RangeEndWidth" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
        </StackPanel>       
      
        
        <StackPanel Margin="15,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockDistanceFromScale}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0" />
            <syncfusion:UpDown TabIndex="5" x:Name="updwn_RangeDistanceScale" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
            <TextBlock Text="{x:Static prop:Resources.textBlockPlacement}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <ComboBox TabIndex="6" Name="cmb_RangePlacement" SelectedIndex="1" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23">
                <ComboBox.Items>
                    <ComboBoxItem Content="Cross"/>
                    <ComboBoxItem Content="Inside"/>
                    <ComboBoxItem Content="Outside"/>
                </ComboBox.Items>
            </ComboBox>
        </StackPanel>     
        
        <StackPanel Margin="15,0,0,0" Grid.Row="4" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockBackFill}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:ColorPicker TabIndex="7" x:Name="clrpkr_RangeColor" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>
        </StackPanel>
    </Grid>
</UserControl>
