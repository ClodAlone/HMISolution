<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TextBoxFont" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="350" Width="350" 
             x:Name="TextBoxFontUser">
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="EffectsType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:EffectsType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grd_Font">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockTextFontInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <Grid Grid.Row="1" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="{x:Static prop:Resources.textBlockTextFont}" />
                <designerlocal:ExpressionComboBox TabIndex="1" x:Name="cmb_FontName" ComboType="FontFamily" Height="25"  Margin="5,2,5,2" SelectedIndex="7"/>
                <!--<ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>-->
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>-->

                <!--<TextBox x:Name="txt_FontName" Width="150" HorizontalAlignment="Left"/>
                <syncfusion:FontListBox x:Name="lst_FontName" Height="60" Width="150" HorizontalAlignment="Left"/>-->
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Column="1">
                <TextBlock Text="{x:Static prop:Resources.textBlockTextSize}" />
                <designerlocal:ExpressionComboBox TabIndex="2" x:Name="cmb_FontSize" Height="25" ComboType="FontSize" Margin="5,2,2,2" IsEditable="True" Width="154" HorizontalAlignment="Left"   SelectedIndex="3"/>
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>-->
                <!--<ComboBox.Items>
                        <ComboBoxItem Content="8pt" />
                        <ComboBoxItem Content="9pt" />
                        <ComboBoxItem Content="10pt" />
                        <ComboBoxItem Content="11pt" />
                        <ComboBoxItem Content="12pt" />
                        <ComboBoxItem Content="14pt" />
                        <ComboBoxItem Content="16pt" />
                        <ComboBoxItem Content="18pt" />
                        <ComboBoxItem Content="20pt" />
                        <ComboBoxItem Content="22pt" />
                        <ComboBoxItem Content="24pt" />
                        <ComboBoxItem Content="26pt" />
                        <ComboBoxItem Content="28pt" />
                        <ComboBoxItem Content="36pt" />
                        <ComboBoxItem Content="48pt" />
                        <ComboBoxItem Content="72pt" />
                    </ComboBox.Items>-->
                
               
                <!--<TextBox x:Name="txt_FontSize" Width="150" HorizontalAlignment="Left"/>
                <ListBox x:Name="lst_FontSize" Height="60" Width="150" HorizontalAlignment="Left"/>-->
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="20,0,0,163" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Margin="5,5,5,5" >
                <GroupBox.Header>Style</GroupBox.Header>
                <StackPanel Orientation="Vertical">
                    <CheckBox TabIndex="3" Margin="10,8,0,0" x:Name="chk_Bold" Content="{x:Static prop:Resources.chkBoxBold}"  />
                    <CheckBox TabIndex="4" Margin="10,10,0,0" x:Name="chk_Italic" Content="{x:Static prop:Resources.chkBoxItalic}" />
                </StackPanel>
            </GroupBox>
            <StackPanel x:Name="stpnl_Vertical" Margin="5,5,5,0" Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical" Height="92">
                <TextBlock Text="{x:Static prop:Resources.textBlockColor}" HorizontalAlignment="Left" ></TextBlock>
                <Border Margin="0,3,0,0" Width="154" Height="25"  HorizontalAlignment="Left">
                    <designerlocal:CustomUIEditorDropDown TabIndex="1" x:Name="cpkr_Font"/>
                </Border>
                <TextBlock Text="{x:Static prop:Resources.textBlockTextEffects}" Margin="0,2,0,0" />
                <designerlocal:ExpressionComboBox TabIndex="6" x:Name="cmb_Effects" Width="154" ComboType="FontEffects" SelectedIndex="0" HorizontalAlignment="Left"/>
                <!--<ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>-->

            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Margin="5,5,5,5" >
                <GroupBox.Header>Line spacing</GroupBox.Header>
                <StackPanel Orientation="Vertical">
                    <RadioButton TabIndex="7" Margin="10,8,0,0" GroupName="LineSpacing" IsChecked="True" x:Name="rbtn_UseFontSize" Content="{x:Static prop:Resources.optionUseFontSize}" />
                    <StackPanel Margin="10,10,0,0" x:Name="stpnl_Left" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Orientation="Vertical">
                        <RadioButton TabIndex="8" x:Name="rbtn_Custom" GroupName="LineSpacing" Content="{x:Static prop:Resources.optionCustom}" />
                        <StackPanel Margin="20,5,0,0" Orientation="Horizontal">
                            <syncfusion:UpDown TabIndex="9" x:Name="updwn_Custom" Height="25" Width="100" HorizontalAlignment="Left"></syncfusion:UpDown>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Margin="5,5,5,5" >
                <GroupBox.Header>Sample</GroupBox.Header>
                <StackPanel VerticalAlignment="Bottom" Height="Auto" Width="Auto" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,10" Text="{x:Static prop:Resources.textBlockAaBbCc}" x:Name="tblk_Sample" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
            <!--<StackPanel x:Name="stpnl_Vertical" Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical">
                <TextBlock Text="Color:" HorizontalAlignment="Left" ></TextBlock>
                <syncfusion:ColorPicker x:Name="cpkr_Font" Color="Black" Height="20" BorderBrush="Black" BorderThickness="1"  VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Text="Effects:" Margin="0,10,0,0" />
                <ComboBox x:Name="cmb_Effects" Width="100" HorizontalAlignment="Left"/>
            </StackPanel>-->
        </Grid>
    </Grid>
</UserControl>
