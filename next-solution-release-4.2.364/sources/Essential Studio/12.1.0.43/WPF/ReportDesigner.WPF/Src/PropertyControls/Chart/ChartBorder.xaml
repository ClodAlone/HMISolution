<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ChartBorder" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"   
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="180*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockChartBorderInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,2,0,16"></TextBlock>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="Width:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <StackPanel Orientation="Horizontal">
                <designerlocal:ExpressionComboBox ComboType="BorderWidth" TabIndex="1" x:Name="updwn_BorderWidth" Width="150" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="-200,0,0,-10" Height="23"></designerlocal:ExpressionComboBox>
            </StackPanel>
            <TextBlock Text="Color:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="2" x:Name="clrpkr_BorderColor" Width="150" 
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-200,0,0,-10" Height="23"></designerlocal:CustomUIEditorDropDown>
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal">
            
        </StackPanel>
    </Grid>
</UserControl>
