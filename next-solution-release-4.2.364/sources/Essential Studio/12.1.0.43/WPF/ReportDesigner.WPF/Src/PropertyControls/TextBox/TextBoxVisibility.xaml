<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TextBoxVisibility" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="300" Width="400">
    <Grid x:Name="grd_Visibility">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockTextVisibilityInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockWhenRun}" Margin="0,0,0,5" HorizontalAlignment="Left" ></TextBlock>
            <RadioButton TabIndex="1" x:Name="rbtn_Show" IsChecked="True" Margin="10,0,0,5" GroupName="ControlVisibility" Content="{x:Static prop:Resources.optionShow}" />
            <RadioButton TabIndex="2" x:Name="rbtn_Hide" Margin="10,0,0,5" GroupName="ControlVisibility" Content="{x:Static prop:Resources.optionHide}" />
        </StackPanel>
    </Grid>
</UserControl>
