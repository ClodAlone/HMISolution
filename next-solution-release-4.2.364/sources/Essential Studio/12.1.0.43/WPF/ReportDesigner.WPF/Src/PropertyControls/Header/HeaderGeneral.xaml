<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.HeaderGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"              
    Height="300" Width="300">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change header properties for the page" VerticalAlignment="Center" FontSize="14" Margin="15,0,0,0"></TextBlock>
        <CheckBox TabIndex="1" x:Name="chk_DisplayHeader" Grid.Row="1" Margin="20,20,0,0" Content="Display header for this page" />
        <StackPanel Margin="35,0,0,0" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="Print options:" HorizontalAlignment="Left" Width="300"></TextBlock>
            <CheckBox TabIndex="2" x:Name="chk_PrintOnFirstPage" Margin="0,3,0,0" Content="Print on first page" />
            <CheckBox TabIndex="3" x:Name="chk_PringOnLastPage" Margin="0,3,0,0" Content="Print on last page" />
        </StackPanel>
        <StackPanel Margin="35,15,0,0" x:Name="stpnl_Left" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="Height:" HorizontalAlignment="Left" ></TextBlock>
            <StackPanel Orientation="Horizontal">
                <syncfusion:UpDown TabIndex="4" x:Name="updwn_Height" Width="100" HorizontalAlignment="Left" Height="25"></syncfusion:UpDown>
                <TextBlock Name="txt_HeightUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
