<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Editors.CustomUIEditorDropDown" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:sync="http://schemas.syncfusion.com/wpf"
             Height="Auto" Width="Auto"
             BorderBrush="#BEBEBE" Padding="1" BorderThickness="1">
    <Grid Name="dropDownControl">
        <Border>
            <Grid >
                <Grid.Resources>
                    <Geometry x:Key="DownArrowGeometry">M 0 0 L 3.5 4 L 7 0 Z</Geometry>                    
                </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
                <Border BorderBrush="Black" Name="backGroundColorBox" Padding="2" Height="16" Width="16"></Border>
                    <TextBox Grid.Column="1" Name="colorBox" Width="Auto" BorderThickness="0" />
                <ToggleButton Name="popupButton"  Grid.Column="2"  Padding="2" BorderThickness="0" Background="Transparent">
                    <Path Data="{StaticResource DownArrowGeometry}" Fill="Black"></Path> 
                </ToggleButton>
            </Grid>
        </Border>
        <Popup Name="popupContainer" Placement="Bottom" StaysOpen="False">
            <Border BorderThickness="1" BorderBrush="LightGray" Background="White">
            <Grid>
                    <Grid.Resources>
                        <DataTemplate x:Key="BrushTemplate">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Height="15" Width="30" Fill="{Binding Brush}" Stroke="LightGray" StrokeThickness="1"/>
                                <TextBlock Text="{Binding Name}" Margin="3 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </Grid.Resources>
                    <ListBox Name="colorListBox" ItemTemplate="{StaticResource BrushTemplate}" Height="158" Padding="2,2,2,2" HorizontalAlignment="Left" Margin="-1,-1,0,0" VerticalAlignment="Top" Width="294" />
                    <Label Margin="6,155,158,3" Padding="2,2,2,2" Name="hyperLinkBlock"><Hyperlink FontSize="13" Name="Expression">Expression</Hyperlink></Label>
            </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
