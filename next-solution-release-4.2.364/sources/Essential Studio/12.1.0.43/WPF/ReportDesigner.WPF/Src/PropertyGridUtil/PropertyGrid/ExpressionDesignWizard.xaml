<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Editors.ExpressionDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
        WindowStartupLocation="CenterOwner" Title="Expression" TitleTextAlignment="Center" ResizeMode="NoResize" Height="572" Width="691" ShowIcon="False" ShowInTaskbar="False" PreviewKeyDown="ChromelessWindow_PreviewKeyDown" >
    <Window.Resources>
        <Style x:Key="SelectorAutoSelectStyle"
       TargetType="{x:Type Selector}">
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="SelectedItem"
                           Value="{x:Null}" />
                        <Condition Property="HasItems"
                           Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="SelectedIndex"
                    Value="0" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <!--<Style BasedOn="{StaticResource SelectorAutoSelectStyle}"
       TargetType="{x:Type ListBox}" />-->

    </Window.Resources>
    <Border BorderBrush="Gray" BorderThickness="0.5" Margin="5,5,5,5">
        <Grid Name="grid" >
            <TextBlock Height="17" HorizontalAlignment="Left" Margin="16,13,0,0" Name="tool_tip" Text="Set Expression for :" VerticalAlignment="Top" Width="100" />
            <TextBox Height="192" SpellCheck.IsEnabled="True" HorizontalAlignment="Left" Margin="15,30,0,0" Name="expressionTextBox" VerticalAlignment="Top" Width="640" TextWrapping="Wrap" Text="{Binding Path=Text,Mode=OneWay}" />
            <TextBlock Height="18" HorizontalAlignment="Left" Margin="18,235,0,0" Name="_category" Text="Category" VerticalAlignment="Top" Width="70" />
            <TextBlock Height="15" HorizontalAlignment="Left" Margin="230,235,0,0" Name="_item" Text="Item" VerticalAlignment="Top" Width="86" />
            <ListBox Height="217"  HorizontalAlignment="Left" Margin="230,255,0,0" Name="list" SelectionChanged="changevalue"  VerticalAlignment="Top" Width="200" >
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TreeView Height="217" HorizontalAlignment="Left" Margin="15,255,0,0" Name="treeView1" VerticalAlignment="Top" Width="200" >
                <!--<TreeView.Resources>
                    <LinearGradientBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#FFD9F4FF" Offset="0"/>
                        <GradientStop Color="#FF9BDDFB" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="{x:Static SystemColors.ControlBrushKey}" EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#FFEEEDED" Offset="0"/>
                        <GradientStop Color="#FFDDDDDD" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black" />
                </TreeView.Resources>-->
                <!--<TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#adc6e5"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="LightGray"/>
                            </MultiTrigger>
                        </Style.Triggers>
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="2"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>-->

                <TreeViewItem Header="Constants" TreeViewItem.Selected="SelectConst"/>
                <TreeViewItem Header="Built-in Fields" TreeViewItem.Selected="built"/>
                <TreeViewItem Header="Parameters" TreeViewItem.Selected="param"/>
                <TreeViewItem Header="Fields" TreeViewItem.Selected="field"/>
                <TreeViewItem Header="Datasets" TreeViewItem.Selected="dataset"/>
                <TreeViewItem Header="Variables" TreeViewItem.Selected="variable" />
                <TreeViewItem Header="Operators" TreeViewItem.Selected="TreeViewItem_Selected">
                    <TreeViewItem Header="Arithmetic" TreeViewItem.Selected="arith"></TreeViewItem>
                    <TreeViewItem Header="Comparison" TreeViewItem.Selected="compare" ></TreeViewItem>
                    <TreeViewItem Header="Concatenation" TreeViewItem.Selected="concate" ></TreeViewItem>
                    <TreeViewItem Header="Logical/Bitwise" TreeViewItem.Selected="logical" ></TreeViewItem>
                    <TreeViewItem Header="Bit Shift" TreeViewItem.Selected="bitshift"></TreeViewItem>
                </TreeViewItem>
                <TreeViewItem   Header="Common Functions" TreeViewItem.Selected="TreeViewItem_Selected">
                    <TreeViewItem Header="Text" TreeViewItem.Selected="text"/>
                    <TreeViewItem Header="Date &amp; Time" TreeViewItem.Selected="dateandtime"/>
                    <TreeViewItem Header="Math" TreeViewItem.Selected="math"></TreeViewItem>
                    <TreeViewItem Header="Inspection" TreeViewItem.Selected="inspection"></TreeViewItem>
                    <TreeViewItem Header="Program Flow" TreeViewItem.Selected="programflow"></TreeViewItem>
                    <TreeViewItem Header="Aggregate" TreeViewItem.Selected="aggregate"></TreeViewItem>
                    <TreeViewItem Header="Financial" TreeViewItem.Selected="financial"></TreeViewItem>
                    <TreeViewItem Header="Conversion" TreeViewItem.Selected="conversion"></TreeViewItem>
                    <TreeViewItem Header="Miscellaneous" TreeViewItem.Selected="miscellaneous"></TreeViewItem>
                </TreeViewItem>
            </TreeView>
            <Button Content="Help" Height="27" HorizontalAlignment="Left" Margin="16,485,0,0" Name="help" VerticalAlignment="Top" Width="100" />
            <GroupBox Header="Description" Height="105" HorizontalAlignment="Left" Margin="451,255,0,0" Name="description" VerticalAlignment="Top" Width="200">
                <TextBox Name="desc" TextWrapping="Wrap" IsReadOnly="True" />
            </GroupBox>
            <GroupBox Header="Example" Height="106" HorizontalAlignment="Left" Margin="451,363,0,0" Name="example" VerticalAlignment="Top" Width="200">
                <TextBox Name="exam" TextWrapping="Wrap" IsReadOnly="True" />
            </GroupBox>
            <Button Content="OK" Height="27" HorizontalAlignment="Left" Margin="450,485,0,0" Name="ok" VerticalAlignment="Top" Width="90" Click="ok_Click" />
            <Button Content="Cancel" Height="27" HorizontalAlignment="Left" Margin="565,485,0,0" Name="cancel" VerticalAlignment="Top" Width="90" Click="cancel_Click" />
            <ListBox Height="217" HorizontalAlignment="Left" Margin="442,255,0,0" Name="consts" VerticalAlignment="Top" Width="213">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <EventSetter Event="Control.MouseDoubleClick" Handler="Values_MouseDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Height="15" HorizontalAlignment="Left" Margin="442,235,0,0" Name="values" Text="Values:" VerticalAlignment="Top" Width="86" />
            <TextBlock Height="17" HorizontalAlignment="Left" Margin="123,13,0,0" Name="Title"  VerticalAlignment="Top" Width="204" />
            <ListBox Height="217" HorizontalAlignment="Left" Margin="442,255,0,0" Name="parameters"  VerticalAlignment="Top" Width="213">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" >
                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBox Height="217" HorizontalAlignment="Left" IsReadOnly="True" Margin="442,255,0,0" Name="noConsts" TextWrapping="Wrap" VerticalAlignment="Top" Width="213"/>
        </Grid>
    </Border>
</syncfusion:ChromelessWindow>