<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.DataSetClient" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        syncfusion:SkinStorage.VisualStyle="Office2007Blue"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Height="547" Width="896" ResizeMode="NoResize"
        Title="Dataset Properties"  ShowIcon="False" Margin="0">
    <Grid Margin="0,0,0,-1">

        <Grid Margin="0,0,663,-26">
            <ListBox Height="405" SelectedIndex="0"  HorizontalAlignment="Left" Name="listBox1" VerticalAlignment="Top" Width="147" Margin="6,6,0,0">
                <ListBox.Items>
                    <Label Content="General"/>
                </ListBox.Items>
            </ListBox>
        </Grid>
        <StackPanel Margin="114,0,262,74">
            <TextBlock Height="25" Name="Title" Text="Choose the Dataset"  FontSize="15" Margin="10,20" Width="360" />
            <Label Height="27" Name="objectTextBlockName"  Target="{Binding ElementName=nameText}" Width="360" >
                <AccessText Width="50" Height="20">
                    Na_me:
                </AccessText>
            </Label>
            <TextBox Height="23" Name="nameTextBox" Width="351" />
            <Grid Width="370">
                <Label Height="27" Name="datasource"  Target="{Binding ElementName=datsourceBox}" Margin="5,40,10,40" >
                    <AccessText Width="98" Height="20">
                        _Data source:
                    </AccessText>
                </Label>
                <ComboBox Height="23" Name="datasourceComboBox" Margin="10,60,86,20" MaxWidth="274" SelectionChanged="datasourceBox_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="{x:Type Popup}">
                            <Setter Property="Width" Value="290"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
                <Button  Height="23" HorizontalAlignment="Center" Content="New..." Margin="285,62,0,0" Name="newButton" VerticalAlignment="Top" Width="75" Click="configWizardButton_Click">
                </Button>
            </Grid>
            <Grid Width="370">
                <Label Height="27" Name="datasets"  Target="{Binding ElementName=datasetBox}" Margin="5,40,10,40" >
                    <AccessText Width="159" Height="20">
                        _Available datasets:
                    </AccessText>
                </Label>
                <syncfusion:ComboBoxAdv Height="23" Name="datasetComboBox" Width="Auto"  Margin="10,60,9,20" MaxWidth="350" >
                    <syncfusion:ComboBoxAdv.Resources>
                        <Style TargetType="{x:Type Popup}">
                            <Setter Property="Width" Value="365"/>
                        </Style>
                    </syncfusion:ComboBoxAdv.Resources>
                </syncfusion:ComboBoxAdv>
            </Grid>
        </StackPanel>
        <Grid Margin="551,0,-43,70">

            <TextBlock Name="textBlock1" Text="Fields:" Margin="19,67,54,201" />
            <syncfusion:GridDataControl HorizontalAlignment="Left" ColumnSizer="Star" Margin="19,83,0,0" ShowAddNewRow="False" Name="gridControl" VerticalAlignment="Top" Height="306" Width="255" >
                <syncfusion:GridDataControl.VisibleColumns>
                    <syncfusion:GridDataVisibleColumn MappingName="FieldName" HeaderText="Field Name" />
                    <syncfusion:GridDataVisibleColumn MappingName="TypeName" HeaderText="Type Name" />
                </syncfusion:GridDataControl.VisibleColumns>
            </syncfusion:GridDataControl>

        </Grid>
        <Grid Margin="10,406,-10,10">
            <StackPanel >
                <Button Content="OK" x:Name="okButton" Margin="562,10,189,4" Click="configWizardOKButton_Click" Height="25"/>
            </StackPanel>
            <StackPanel>
                <Button Content="Cancel" x:Name="cancelButton" Margin="706,10,43,4" Click="configWizardCancelButton_Click" Height="25"/>
            </StackPanel>
            <StackPanel>
                <Button Content="Help" x:Name="helpButton" Margin="10,10,739,4" RenderTransformOrigin="0.5,0.5" Height="25"/>
            </StackPanel>
        </Grid>
        <Line
    X1="170" Y1="410"
    X2="860" Y2="410"
    Stroke="Gray"
    StrokeThickness="1" Margin="0,-9,0,0" />
    </Grid>
</syncfusion:ChromelessWindow>
