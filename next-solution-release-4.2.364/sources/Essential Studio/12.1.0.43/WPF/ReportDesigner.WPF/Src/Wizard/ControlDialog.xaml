<syncfusion:ChromelessWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:converter="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"  
                             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ControlDialog" x:ClassModifier="internal"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"  ShowIcon="False" Margin="0"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" 
    Title="{x:Static prop:Resources.titleControlDialog}" TitleTextAlignment="Center" Height="600" Width="750" x:Name="wnd_ControlDialog" ResizeMode="NoResize" Loaded="wnd_ControlDialog_Loaded">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="TableJoinType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="converter:TableJoinType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <!--Root Grid-->
    <Grid>
        <Grid.Resources>
            <converter:FolderTypeConverter x:Key="folderTypeConverter" />
            <converter:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
            <HierarchicalDataTemplate x:Key="treeTemplate" ItemsSource="{Binding SchemaInfos}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chck_TableNode" ClickMode="Press" Margin="2,0,0,0" VerticalAlignment="Center"  Click="chck_TableNode_Click" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding TreeNodeType, Converter={StaticResource boolToVisibilityConverter}}"/>
                    <Image Source="{Binding ImageSource}" Margin="2,0,0,0" VerticalAlignment="Center"  Height="16" Width="16" SnapsToDevicePixels="True" Visibility="{Binding Path=TreeNodeType, Converter={StaticResource folderTypeConverter}}"/>
                    <TextBlock Text="{Binding Key}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </Grid.Resources>
        <!--Wizard Control-->
        <syncfusion:WizardControl x:Name="wizardControl" SelectedWizardPage="{Binding SelectedItem, ElementName=selPages, Mode=TwoWay}"                                      
			HelpText="{x:Static prop:Resources.btnHelp}"
			CancelText="{x:Static prop:Resources.btnCancel}"
			BackText="{x:Static prop:Resources.btnBack}" 
			NextText="{x:Static prop:Resources.btnNext}"
			FinishText="{x:Static prop:Resources.btnFinish}"
			InteriorPageHeaderMinHeight="{Binding Text, ElementName=txtIntHeader, Mode=TwoWay}"
			ExteriorPageBannerImageMinWidth="{Binding Text, ElementName=txtImgMinWidth, Mode=TwoWay}"
			Help="wizardControl_Help"
			CancelVisible="{Binding IsChecked, ElementName=visiblecancelbutton, Mode=TwoWay}"
			CancelEnabled="{Binding IsChecked, ElementName=enablecancelbutton, Mode=TwoWay}"
			BackVisible="{Binding IsChecked, ElementName=visiblebackbutton, Mode=TwoWay}" 
			BackEnabled="{Binding IsChecked, ElementName=enablebackbutton, Mode=TwoWay}"
			HelpVisible="{Binding IsChecked, ElementName=visiblehelpbutton, Mode=TwoWay}"
			NextVisible="{Binding IsChecked, ElementName=visblenextbutton, Mode=TwoWay}"
			NextEnabled="{Binding IsChecked, ElementName=enablenextbutton, Mode=TwoWay}"
			FinishVisible="{Binding IsChecked, ElementName=visiblefinishbutton, Mode=TwoWay}"
			FinishEnabled="{Binding IsChecked, ElementName=enablefinishbutton, Mode=TwoWay}"
			Cancel="wizardControl_Cancel"
			Finish="wizardControl_Finish">
            <!-- Page 1 Hidden Page -->
            <syncfusion:WizardPage x:Name="Wiz_ControlDataSetBinder" PageType="Blank" TabIndex="0"
				BackVisible="False" CancelVisible="True" FinishVisible="False" HelpVisible="True" NextEnabled="False">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="400*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockChooseDataSet}" />
                    <TextBlock x:Name="txt_wizardInfo" Grid.Row="1" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockChooseDataSetInfo}"/>
                    <RadioButton  TabIndex="0" Grid.Row="2" Margin="30,0,0,0"  x:Name="optionChooseDataSet" VerticalAlignment="Bottom" Content="{x:Static prop:Resources.optionChooseDataSet}"  GroupName="DataSetOption" />
                    <ScrollViewer  TabIndex="1" Grid.Row="3" Margin="0,0,0,36" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
                        <ListBox  TabIndex="2" x:Name="lvw_DataSets" Grid.Row="3" Margin="40,5,1,0" Grid.RowSpan="2" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Margin="30,0,0,0" Height="25" Orientation="Horizontal"/>
                    <RadioButton  TabIndex="3" Content="{x:Static prop:Resources.optionCreateDataSet}" x:Name="optionCreateDataSet" HorizontalAlignment="Left" Margin="30,6,0,18" Grid.Row="5" Width="102" GroupName="DataSetOption" />
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 1-->
            <syncfusion:WizardPage x:Name="wiz_ControlDataSourceBinder" PageType="Blank"
				CancelVisible="True" FinishVisible="False" HelpVisible="True" NextEnabled="False" 
				NextPage="{Binding ElementName=wiz_QueryDesigner}">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="300*" />
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockChooseConnection}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockChooseConnectionInfo}"/>
                    <TextBlock Grid.Row="2" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.controlDialogTextBlock1}" />
                    <ListBox  TabIndex="0" x:Name="lvw_DataSources" Grid.Row="3" Margin="30,5,1,0"/>
                    <StackPanel Grid.Row="4" Margin="30,0,0,0" Height="25" Orientation="Horizontal">
                        <!--<Button Name="btn_Browse" Content="Browse..."  Width="80"></Button>-->
                        <Button  TabIndex="1" x:Name="btn_New" Content="{x:Static prop:Resources.btnNew}" Margin="6,0,0,0" Width="80"/>
                    </StackPanel>
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 2-->
            <syncfusion:WizardPage x:Name="wiz_QueryDesigner" PageType="Blank"
				BackVisible="True" FinishVisible="False"
				CancelVisible="True" HelpVisible="True"
				NextVisible="True" NextEnabled="True" Selected="wiz_QueryDesigner_Selected">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="15*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockDesignQuery}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockBuildQueryInfo}"/>
                    <StackPanel Margin="30,0,0,0" Grid.Row="2" Orientation="Horizontal">
                        <ToggleButton  TabIndex="8" Margin="0,0,10,0" Width="80" Height="23"  x:Name="tgbtn_EditText" Content="{x:Static prop:Resources.btnEditAsText}" Click="tgbtn_EditText_Click"/>
                        <!--<Button Margin="0,0,10,0" Content="Import..." Width="80" VerticalContentAlignment="Center"></Button>-->
                        <Button  TabIndex="9" Content="{x:Static prop:Resources.btnRunQuery}" Width="80" Height="23" VerticalContentAlignment="Center" x:Name="btn_RunQuery" Click="btn_RunQuery_Click" />
                    </StackPanel>
                    <Grid Grid.Row="3" x:Name="grd_TreeView" Height="Auto" Margin="30,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{x:Static prop:Resources.textBlockDatabaseView}" />
                            <TreeView  TabIndex="0" x:Name="trvw_Schemas" Grid.Row="1" ItemTemplate="{StaticResource treeTemplate}" SnapsToDevicePixels="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <GridSplitter  TabIndex="1" Width="1" x:Name="spliterVertical" Opacity=".7" VerticalAlignment="Stretch" HorizontalAlignment="Right" />
                        <Grid Grid.Column="1" Height="Auto"  Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="0.8*"/>
                                <!--<RowDefinition Height="0.9*"/>-->
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{x:Static prop:Resources.textBlockSelectedFields}"/>
                                <ListBox  TabIndex="2" Grid.Row="1" x:Name="lvw_SelectedFields" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>
                            <Expander  TabIndex="3" x:Name="expnd_RelationShips" Grid.Row="1" IsExpanded="False" Header="{x:Static prop:Resources.headerLeftTable}">
                                <ListView  TabIndex="4" x:Name="ListViewRelationships" ItemsSource="{Binding}">
                                    <ListView.Resources>
                                        <!--<Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>-->
                                    </ListView.Resources>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static prop:Resources.headerLeftTable}" DisplayMemberBinding="{Binding LeftTable}" Width="170"/>
                                            <GridViewColumn Header="{x:Static prop:Resources.headerRelationships}" DisplayMemberBinding="{Binding RelationShip}" Width="150">
                                                <!--<GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Source={StaticResource TableJoinType}}"/>
                                                        <TextBlock Text="{Binding RelationShip}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>-->
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static prop:Resources.headerRightTable}" DisplayMemberBinding="{Binding RightTable}" Width="170"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <!--<Grid Grid.Row="1" Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Left Table" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                    <TextBlock Text="Relationship" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Text="Right Table" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" />
                                </Grid>-->
                            </Expander>
                            <!--<Expander Grid.Row="2" IsExpanded="True" Header="Applied filters">
                                <Grid Grid.Row="1" Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Field Name" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                    <TextBlock Text="Operator" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Text="Value" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" />
                                    <TextBlock Text="Parameter" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="3" />
                                </Grid>
                            </Expander>-->
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3" x:Name="grd_TextView" Visibility="Collapsed"  Height="Auto" Margin="30,0,0,0">
                        <TextBox x:Name="rtbox_TextView" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                    <GridSplitter  TabIndex="5" Grid.Row="4" x:Name="spliterHorizontal" Margin="0,0,0,0" Opacity=".7" ResizeDirection="Rows" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="2" />
                    <Expander  TabIndex="6" x:Name="queryResultExpander" Grid.Row="5" IsExpanded="True" Header="{x:Static prop:Resources.headerQueryResults}" Margin="30,0,0,0" >
                        <syncfusion:GridDataControl Grid.Row="1" AllowEdit="False" x:Name="dgrd_QueryResults" AutoPopulateColumns="True" AutoPopulateRelations="False" ShowAddNewRow="False" IsHitTestVisible="False"/>
                    </Expander>
                    <Grid Grid.Row="5" x:Name="grd_TextQueryResults" Margin="30,0,0,0" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{x:Static prop:Resources.headerQueryResults}" VerticalAlignment="Center" />
                        <syncfusion:GridDataControl  TabIndex="7" Grid.Row="1" AllowEdit="False" x:Name="dgrd_TextQueryResults" AutoPopulateColumns="True" AutoPopulateRelations="False" ShowAddNewRow="False"/>
                    </Grid>
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 3 Hidden page-->
            <syncfusion:WizardPage x:Name="wiz_ChartTypes" PageType="Blank"
				BackVisible="True" Visibility="Collapsed"
				CancelVisible="True" FinishVisible="False" HelpVisible="True"
				NextPage="{Binding ElementName=wiz_ArrangeChartFields}" NextEnabled="True">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="300*" />
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockChooseChartType}" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockChooseChartTypeInfo}"/>
                    <TextBlock Margin="40,0,0,4" VerticalAlignment="Bottom" Grid.Row="2" Text="Chart type:" />
                    <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="40,0,10,10">
                        <Grid>
                            <Grid.RowDefinitions >
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Image Width="25" Grid.Row="0" Grid.Column="0" Height="25" Source="{StaticResource Chart}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{x:Static prop:Resources.textBlockColumn}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static prop:Resources.textBlockColumnChartInfo}" FontSize="9"/>
                            </StackPanel>
                            <Image Width="25" Grid.Row="1" Grid.Column="0" Height="25" Source="{StaticResource Chart}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{x:Static prop:Resources.textBlockLine}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static prop:Resources.textBlockLineChartInfo}" FontSize="9"/>
                            </StackPanel>
                            <Image Width="25" Grid.Row="2" Grid.Column="0" Height="25" Source="{StaticResource Chart}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{x:Static prop:Resources.textBlockPie}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static prop:Resources.textBlockPieChartInfo}" FontSize="9"/>
                            </StackPanel>
                            <Image Width="25" Grid.Row="3" Grid.Column="0" Height="25" Source="{StaticResource Chart}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{x:Static prop:Resources.textBlockBar}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static prop:Resources.textBlockBarChartInfo}" FontSize="9"/>
                            </StackPanel>
                            <Image Width="25" Grid.Row="4" Grid.Column="0" Height="25" Source="{StaticResource Chart}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{x:Static prop:Resources.textBlockArea}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Text="{x:Static prop:Resources.textBlockAreaChartInfo}" FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <CheckBox Margin="40,0,0,4" VerticalAlignment="Center" Grid.Row="4" Content="{x:Static prop:Resources.chkBoxChartInof1}" />
                    <CheckBox Margin="40,0,0,4" VerticalAlignment="Center" Grid.Row="5" Content="{x:Static prop:Resources.chkBoxChartInof2}" />
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 3-->
            <syncfusion:WizardPage x:Name="wiz_ArrangeFields" PageType="Blank"
				BackVisible="True" 
				CancelVisible="True" FinishVisible="True" HelpVisible="True" FinishEnabled="True"
				NextPage="{Binding ElementName=wiz_ChooseLayout}" NextVisible="False" NextEnabled="False" Selected="wiz_ArrangeFields_Selected">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="300*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockArrangeFields}" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockArrangeFieldsInfo}"/>
                    <Grid Grid.Row="2" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="80*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockAvailableFields}" />
                        <ListBox  TabIndex="0" PreviewMouseLeftButtonDown="lvw_DataSetFields_PreviewMouseLeftButtonDown" AllowDrop="False" Grid.Row="1" Grid.Column="0" x:Name="lvw_DataSetFields" Margin="30,4,10,4">
                            <!--<ListBoxItem Height="20" Content="DepartmentID"></ListBoxItem>
                            <ListBoxItem Height="20" Content="Name"></ListBoxItem>
                            <ListBoxItem Height="20" Content="GroupName"></ListBoxItem>
                            <ListBoxItem Height="20" Content="ModifiedDate"></ListBoxItem>-->
                        </ListBox>
                        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="30*"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="30*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TopLabel" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockColumnGroups}" />
                            <ListBox  TabIndex="1" Grid.Row="1" Grid.Column="1" AllowDrop="True" Drop="lvw_ColumnGroups_Drop" x:Name="lvw_ColumnGroups" Margin="10,4,10,4" >
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="lvw_ColGroupMenuItem" Header="{x:Static prop:Resources.textBlockRemove}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <TextBlock x:Name="LeftLabel" Grid.Row="2" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockRowGroups}" />
                            <ListBox  TabIndex="2" Grid.Row="3" Grid.Column="0" AllowDrop="True" Drop="lvw_RowGroups_Drop" x:Name="lvw_RowGroups" Margin="10,4,10,4">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="lvw_RowGroupMenuItem" Header="{x:Static prop:Resources.textBlockRemove}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <TextBlock x:Name="CenterLabel" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockValues}" />
                            <ListBox  TabIndex="3" Grid.Row="3" Grid.Column="1" AllowDrop="True" Drop="lvw_MeasureGroups_Drop" x:Name="lvw_MeasureGroups" Margin="10,4,10,4">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="lvw_MeasureGroupsMenuItem" Header="{x:Static prop:Resources.textBlockRemove}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 3-->
            <syncfusion:WizardPage x:Name="wiz_ArrangeChartFields" PageType="Blank"
				BackVisible="True" Visibility="Collapsed"
				CancelVisible="True" FinishVisible="True" HelpVisible="True" FinishEnabled="True"
				NextPage="{Binding ElementName=wiz_ChooseStyle}" NextVisible="False" NextEnabled="False">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="300*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockArrangeChartFields}" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockArrangeChartFieldsInfo}"/>
                    <Grid Grid.Row="2" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="80*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockAvailableFields}" />
                        <ListView  TabIndex="0" Grid.Row="1" Grid.Column="0" x:Name="lvw_ChartDataSets" Margin="30,4,10,4"/>
                        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="30*"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="30*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockColumnGroups}" />
                            <ListView  TabIndex="1" Grid.Row="1" Grid.Column="1" AllowDrop="True" x:Name="lvw_ChartColumnGroups" Margin="10,4,10,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockRowGroups}" />
                            <ListView  TabIndex="2" Grid.Row="3" Grid.Column="0" AllowDrop="True" x:Name="lvw_ChartRowGroups" Margin="10,4,10,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockValues}" />
                            <ListView  TabIndex="3" Grid.Row="3" Grid.Column="1" AllowDrop="True" x:Name="lvw_ChartMeasureGroups" Margin="10,4,10,4"/>
                        </Grid>
                    </Grid>
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 4-->
            <syncfusion:WizardPage x:Name="wiz_ChooseLayout" PageType="Blank"
				BackVisible="True"
				CancelVisible="True" FinishVisible="False" HelpVisible="True"
				NextPage="{Binding ElementName=wiz_ChooseStyle}" NextEnabled="True">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="300*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockChooseLayout}" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockChooseLayoutInfo}"/>
                    <Grid Grid.Row="2" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="80*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="Options:" />
                        <Grid Grid.Row="1" Grid.Column="0" Margin="20,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="chk_SubGrandTotals" Content="Show subtotals and grand totals" Grid.Row="0"/>
                            <RadioButton x:Name="rbtn_BlockSubTotBelow" Margin="20,0,0,0" Content="Show subtotals and grand totals" Grid.Row="1"/>
                            <RadioButton x:Name="rbtn_BlockSubTotAbove" Margin="20,0,0,0" Content="Show subtotals and grand totals" Grid.Row="2"/>
                            <RadioButton x:Name="rbtn_SteppedSubTotAbove" Margin="20,0,0,0" Content="Show subtotals and grand totals" Grid.Row="3"/>
                            <CheckBox x:Name="chk_ExpCollapseGroups"  Content="Expand/collapse groups" IsChecked="True" Grid.Row="4"/>
                        </Grid>
                        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="Preview" />
                        <Border Grid.Row="1" Grid.Column="1" Margin="10,4,10,4" BorderThickness="1" BorderBrush="Gray" />
                    </Grid>
                </Grid>
            </syncfusion:WizardPage>

            <!--Page 5-->
            <syncfusion:WizardPage x:Name="wiz_ChooseStyle" PageType="Blank"
				BackVisible="True"
				CancelVisible="True" FinishVisible="True" FinishEnabled="True" HelpVisible="True"
				NextVisible="False" NextEnabled="False">
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="300*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockChooseStyle}" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="25,0,0,0" Text="{x:Static prop:Resources.textBlockChooseStyleInfo}"/>
                    <Grid Grid.Row="2" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="80*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockStyles}" />
                        <ListBox TabIndex="0" x:Name="lbox_Styles" Grid.Row="1" Grid.Column="0" Margin="10,4,4,4">
                            <ListBoxItem Content="Corporate"/>
                            <ListBoxItem Content="Forest"/>
                            <ListBoxItem Content="Generic"/>
                            <ListBoxItem Content="Mahogany"/>
                            <ListBoxItem Content="Ocean"/>
                            <ListBoxItem Content="Slate" d:IsHidden="True"/>
                        </ListBox>
                        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="30,0,0,0" VerticalAlignment="Bottom" Text="{x:Static prop:Resources.textBlockPreview}" />
                        <Border Grid.Row="1" Grid.Column="1" Margin="4,4,10,4" BorderThickness="1" BorderBrush="Gray" />
                    </Grid>
                </Grid>
            </syncfusion:WizardPage>
            <StackPanel Visibility="Hidden">
                <CheckBox x:Name="cancelButton" Content="{x:Static prop:Resources.chkBoxCancel}"/>
                <CheckBox x:Name="finishButton" Content="{x:Static prop:Resources.chkBoxFinish}" />
            </StackPanel>

        </syncfusion:WizardControl>
    </Grid>
</syncfusion:ChromelessWindow>
