<sync:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.Credentials"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sync="http://schemas.syncfusion.com/wpf"
    sync:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CredentialsWindow" Height="160" Width="400" ResizeMode="NoResize"
    Background="#FFF0F0F0" WindowStartupLocation="CenterScreen" UseNativeChrome="True" ShowIcon="False" >
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="tBlock_CreadentialInfo" Text="Specify a user name and password" Grid.ColumnSpan="2" Margin="5"/>
        <TextBlock Text="User Name" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="textBox_UserName" Grid.Row="1" Grid.Column="1" Margin="5"></TextBox>
        <TextBlock Text="Password" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <PasswordBox x:Name="pass_Password" Grid.Row="2" Grid.Column="1" Margin="5"/>   
        <Button x:Name="btn_OK" Content="OK" Width="80" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="60,5,0,5" IsDefault="True"></Button>
        <Button x:Name="btn_Cancel" Content="Cancel" Width="80" Grid.Row="3" Grid.Column="1" Margin="120,5,0,5" ></Button>
    </Grid>
</sync:ChromelessWindow>
