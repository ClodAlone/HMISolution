    <DataTemplate x:Key="MovalbleNodeTemplate">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ContentPresenter 
                                x:Name="PART_Content" 
                                Content="{Binding}"
                                ContentTemplate="{Binding}"
                                ContentTemplateSelector="{Binding}"/>
            <Thumb Margin="5,-10,0,0" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>
   
    <DataTemplate x:Key="seriesselectionTemplate">
        <Ellipse Height="8" Width="8" Fill="Green"/>
    </DataTemplate>
    
    <DataTemplate x:Key="dataTemplate">
        <TextBlock Visibility="Collapsed"></TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="datalabelTemplate">
        <TextBlock Name="txtdatalabels" Text ="{Binding}" FontSize="13" Foreground="Black" TextAlignment="Justify" Margin="2"  VerticalAlignment="Center" FontWeight="Bold" />
