<UserControl x:Class="Syncfusion.Windows.Reports.Designer.ReportDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sfdesigner="clr-namespace:Syncfusion.Windows.Reports.Designer" 
             xmlns:sfviewer="clr-namespace:Syncfusion.Windows.Reports.Viewer;assembly=Syncfusion.ReportViewer.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Loaded="DesingerPanel_load">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/DesignerControls/Themes/Generic.xaml"/>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/DesignerControls/Themes/DictionaryDesignPanel.xaml"/>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
                <ResourceDictionary Source="/Syncfusion.ReportViewer.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="MDIDocument" Visibility="Visible">
            <syncfusion:TabControlExt x:Name="TabControl"/>
        </Grid>
        <ContentControl x:Name="SingleDocument" Visibility="Collapsed"/>
        <Grid Visibility="Hidden" x:Name="GridViewerPanel" >
            <sfviewer:ReportViewer x:Name="reportViewerControl" ShowToolBar="False"/>
        </Grid>
    </Grid>
</UserControl>
