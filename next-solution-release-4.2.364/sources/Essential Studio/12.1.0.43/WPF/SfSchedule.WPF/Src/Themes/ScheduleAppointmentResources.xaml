<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.UI.Xaml.Schedule">

    <local:IsAlldaytoWordellipseConverter x:Key="alldaytotrim"/>

    <Style TargetType="local:ScheduleDaysAppointmentViewControl">
        <Setter Property="Background" Value="#FF2671EB"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0.5,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border BorderThickness="0,1,1,0" BorderBrush="White">
                            <Border Name="PART_DayAppointmentBorder" BorderBrush="{Binding AppointmentSelectionBrush}" BorderThickness="2.5" >
                                <Grid>
                                    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    Visibility="{Binding CustomTemplateVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="{Binding CustomTemplateDataContext, RelativeSource={RelativeSource TemplatedParent}}" 
                                                    ContentTemplate="{Binding AppointmentTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Grid Visibility="{Binding DefaultTemplateVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{Binding AppointmentBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.5*"/>
                                            <RowDefinition Height="0.5*"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.RowSpan="2" Fill="{Binding Status.Brush}" />
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"  VerticalAlignment="Top"  Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                                            <TextBlock Margin="5" Width="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=AppWidth}"  
                                                       FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Foreground="White"  
                                                       Text="{Binding Subject}" TextWrapping="NoWrap" TextTrimming="{Binding AllDay, Converter={StaticResource alldaytotrim}}"/>
                                            <TextBlock Name="PART_StartTime" Margin="5" Foreground="White" TextTrimming="WordEllipsis"   
                                                       FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" 
                                                       Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragDropStartTime}" TextWrapping="NoWrap" 
                                                       Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragRectangleVisibility}"   />
                                        </StackPanel>
                                        <TextBlock Name="PART_EndTime" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5" Foreground="White" TextTrimming="WordEllipsis"  
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" 
                                                   Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragDropEndTime}" TextWrapping="NoWrap" 
                                                   Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragRectangleVisibility}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                        <TextBlock Name="PART_Events" Text="{Binding EventCount}" Width="{TemplateBinding Width}" 
                                   Padding="0,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="14" FontFamily="Segoe UI" Foreground="White" FontWeight="Normal"/>
                        <Border Visibility="{Binding ReadOnlyVisibility}">
                            <Rectangle Fill="White" Opacity="0.5"/>
                        </Border>
                        <ToolTipService.ToolTip>
                            <ToolTip x:Name="PART_DayAppointmentToolTip" Visibility="{Binding AppointmentTooltipVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                     Template="{Binding AppointmentToolTipTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ToolTipService.ToolTip>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:AllDayAppointmentItemscontrol">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=Background}"  BorderBrush="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=DayViewVerticaLineStroke}" BorderThickness="1,0,0,0">
                        <Grid>
                            <ScrollViewer FocusVisualStyle="{x:Null}" x:Name="AllDayScrollViewer">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ScheduleMonthAppointmentViewControl">
        <Setter Property="Background" Value="#FF2671EB"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="#FFB0B6BE"/>
        <Setter Property="Margin" Value="0.5,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthAppointmentViewControl">
                    <Grid x:Name="maingrid">
                        <Border BorderBrush="White" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border x:Name="PART_MonthAppointmentBorder" BorderBrush="{Binding Path=AppointmentSelectionBrush}" BorderThickness="2.5" >
                                <Grid>
                                    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    Visibility="{Binding CustomTemplateVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="{Binding CustomTemplateDataContext, RelativeSource={RelativeSource TemplatedParent}}" 
                                                    ContentTemplate="{Binding AppointmentTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Grid Visibility="{Binding DefaultTemplateVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{Binding AppointmentBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.5*"/>
                                            <RowDefinition Height="0.5*"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.RowSpan="2" Fill="{Binding Status.Brush}"/>
                                        <!--TextBlock margin is removed for fix of subject text is cropped when appointment size becomes small-->
                                        <TextBlock x:Name="PART_SubjectText" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Foreground="White" Text="{Binding Subject}" TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="PART_Events" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Text="{Binding EventCount}" TextWrapping="NoWrap"
                                                   Foreground="{Binding TextForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Rectangle x:Name="dragrect" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="4" Fill="Transparent" 
                                                   Visibility="{Binding DragRectangleVisibility, RelativeSource={RelativeSource TemplatedParent}}" 
                                                   Stroke="White" StrokeDashArray="4,4" StrokeThickness="1" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                        <Border Visibility="{Binding ReadOnlyVisibility}">
                            <Rectangle Fill="White" Opacity="0.5"/>
                        </Border>
                        <ToolTipService.ToolTip>
                            <ToolTip x:Name="PART_MonthAppointmentToolTip"  Visibility="{Binding AppointmentTooltipVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                     Template="{Binding AppointmentToolTipTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ToolTipService.ToolTip>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ScheduleHorizontalAppointmentViewControl">
        <Setter Property="BorderBrush" Value="#FFB0B6BE"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleHorizontalAppointmentViewControl">
                    <Grid>
                        <Border BorderBrush="White" BorderThickness="1,0,0,1">
                            <Border Name="PART_TimeLineAppointmentBorder" BorderBrush="{Binding AppointmentSelectionBrush}" BorderThickness="2.5">
                                <Grid>
                                    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    Visibility="{Binding CustomTemplateVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="{Binding CustomTemplateDataContext, RelativeSource={RelativeSource TemplatedParent}}" 
                                                    ContentTemplate="{Binding AppointmentTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Grid Visibility="{Binding DefaultTemplateVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{Binding AppointmentBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="20*"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.RowSpan="2" Fill="{Binding Status.Brush}"/>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left"  VerticalAlignment="Top" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                                            <TextBlock Name="PART_StartTime" Margin="5" Foreground="White" TextTrimming="WordEllipsis"   FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragDropStartTime}"   TextWrapping="NoWrap" Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragRectangleVisibility}" />
                                            <TextBlock x:Name="PART_SubjectText" HorizontalAlignment="Stretch" Foreground="White" Margin="5"  FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Text="{Binding Subject}" TextWrapping="NoWrap"/>
                                            <TextBlock x:Name="PART_LocationText" HorizontalAlignment="Stretch" Margin="5" FontFamily="Verdana" FontSize="{TemplateBinding FontSize}" Foreground="White" Text="{Binding Location}" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <TextBlock Name="PART_EndTime" Margin="5" Foreground="White" TextTrimming="WordEllipsis"  HorizontalAlignment="Right"  VerticalAlignment="Bottom" Grid.Row="0"  Grid.RowSpan="2" Grid.Column="1"   FontFamily="Segoe UI" FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragDropEndTime}" TextWrapping="NoWrap"  Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=DragRectangleVisibility}"  />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                        <ToolTipService.ToolTip>
                            <ToolTip x:Name="PART_TimeLineAppointmentToolTip" Visibility="{Binding AppointmentTooltipVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                     Template="{Binding AppointmentToolTipTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ToolTipService.ToolTip>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
