<Window x:Class="Syncfusion.UI.Xaml.Schedule.ScheduleReminderControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reminders" Height="340" Width="470" WindowStartupLocation="CenterScreen" 
        BorderThickness="1" BorderBrush="LightGray"  ResizeMode="NoResize" WindowStyle="None"
        xmlns:input="http://schemas.syncfusion.com/wpf" input:SkinStorage.VisualStyle="Metro">

    <Grid Height="340" Width="470">
        <StackPanel>
            <Border x:Name="TitleBar" Background="White" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="65"/>
                        <RowDefinition Height="155"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.4*"/>
                            <ColumnDefinition Width="0.6*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Name="backgroundGrid" Margin="10,0,0,0" Width="16" Height="16" Grid.Column="0" HorizontalAlignment="Left" Visibility="Visible">
                            <Path Data="M24.0459,1.9940863C22.090275,1.9940867 20.500435,3.7837088 20.500435,5.9828703 20.500435,6.1765296 20.516533,6.3649871 20.544119,6.5493176L20.566452,6.6729229 21.214073,6.5807907C22.010324,6.4840838 22.830551,6.4340002 23.671194,6.4340002 24.791801,6.4340002 25.895575,6.5230377 26.969215,6.6929114L27.504127,6.7882234 27.547319,6.5493176C27.574993,6.3649871 27.591267,6.1765296 27.591267,5.9828703 27.591267,3.7837088 26.001427,1.9940867 24.0459,1.9940863z M24.0459,0C26.98259,0 29.364,2.6789484 29.364,5.9828703 29.364,6.3631696 29.325602,6.7308398 29.264404,7.0909998L28.877613,7.0909998 29.328443,7.2080796C35.709423,8.9988019 40.523598,13.706933 40.523598,19.33026 40.523598,21.050928 40.106197,22.693295 39.350994,24.196766 38.85799,29.539064 38.904289,37.866304 43.231216,41.710627 49.871159,47.612917 48.025444,52.03993 47.287838,53.515001L26.629612,53.515001 24.924,53.515001 24.924,58.230986 25.194012,58.329767C26.253155,58.777498 26.997999,59.825701 26.997999,61.047651 26.997999,62.677813 25.673832,64.000002 24.046049,64.000002 22.416367,64.000002 21.094,62.677813 21.094,61.047651 21.094,59.825701 21.837831,58.777498 22.897268,58.329767L23.167,58.231127 23.167,53.515001 21.464781,53.515001 0.80445221,53.515001C0.066837148,52.03993 -1.7768643,47.612917 4.8625169,41.710627 9.6535063,37.450312 9.1963033,27.6856 8.5694999,22.580198 8.2367983,21.541218 8.0603571,20.453138 8.0603571,19.33026 8.0603571,13.706933 12.115521,8.9988019 18.165386,7.2080796L18.817469,7.0300756 18.785555,6.8193915C18.748995,6.5462154 18.727001,6.2680947 18.727001,5.9828703 18.727001,2.6789484 21.108511,0 24.0459,0z" Stretch="Uniform" Fill="#FF292929" Width="16" Height="16" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="15" />
                                            <ScaleTransform ScaleX="-1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock Grid.Column="0" x:Name="count" Foreground="Gray" HorizontalAlignment="Right" Text="{Binding ReminderAppointmentCollection.Count}"  VerticalAlignment="Center" />
                        <TextBlock Margin="3,0,0,0" Text="Reminder(s)" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray"/>
                        <Grid Margin="0,5,15,0" MouseDown="Grid_MouseDown" Grid.Column="1" HorizontalAlignment="Right">
                            <Line Stroke="Gray"  X1="0" X2="10" Y1="5" Y2="15" StrokeThickness="2.5"/>
                            <Line Stroke="Gray"  X1="0" X2="10" Y1="15" Y2="5" StrokeThickness="2.5"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Image Margin="20 0" Source="/Syncfusion.SfSchedule.WPF;component/Assets/ReminderBig.png" Height="26" Width="26"/>
                        <TextBlock x:Name="subject" VerticalAlignment="Bottom" Foreground="Gray" FontSize="22" Grid.Column="1" Grid.Row="0"/>
                        <TextBlock x:Name="time" Grid.Row="1" Grid.Column="1" Foreground="Gray" VerticalAlignment="Top"/>
                        <TextBlock x:Name="location" Grid.Row="2" Grid.Column="1" Foreground="Gray" VerticalAlignment="Top"/>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="listbox" Margin="15 10" SelectionChanged="ListBox_SelectionChanged" SelectedIndex="0"  ItemsSource="{Binding ReminderAppointmentCollection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="250"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Syncfusion.SfSchedule.WPF;component/Assets/ReminderSmall.png" Width="16" Height="16"/>
                                    <TextBlock Grid.Column="1" Margin="3 0" Text="{Binding Subject}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding ReminderDeliveryTime}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="Dismiss" Height="22" Width="90" BorderBrush="#808080" Click="Dismiss_Click" Background="White" HorizontalAlignment="Right" VerticalAlignment="Top" IsCancel="True" FontFamily="Segoe UI" FontWeight="Normal" Margin="0,0,15,0">Dismiss</Button>

                    <Grid Grid.Row="4" Background="#F1F1F1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Click Snooze to be remined in:" Margin="15 5" Grid.Column="0" FontFamily="Segoe UI" Grid.Row="0" FontWeight="Normal" Foreground="#5B5B5B" />
                        <ComboBox Width="180" VerticalAlignment="Center" x:Name="snooze" Margin="15 0" Grid.Column="0" Grid.Row="1"  FontFamily="Segoe UI" FontWeight="Normal" Background="White" HorizontalAlignment="Left" />
                        <Button Click="setsnooze_Click" Width="90" Grid.Column="1" BorderBrush="#808080" Content="Snooze"  Grid.Row="1" HorizontalAlignment="Left" x:Name="setsnooze" Background="White" FontFamily="Segoe UI" FontWeight="Normal"/>
                        <Button x:Name="DismissAll" Width="90" Margin="15 0" BorderBrush="#808080" Click="DismissAll_Click" HorizontalAlignment="Right" Background="White" Grid.Row="1" Grid.Column="2" IsCancel="True" FontFamily="Segoe UI" FontWeight="Normal">Dismiss All</Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>

</Window>
