<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:sync="http://schemas.syncfusion.com/wpf"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syncfusion.Windows.PropertyGrid">

  <local:TypeToNameConverter x:Key="NameConverter"/>
  <local:LevelToThicknessConverter x:Key="LevelConverter"/>
  <local:BooleanToTooltipConverter x:Key="TooltipConverter"/>
  <DataTemplate x:Key="DefaultTemplate">
    <Border>
      <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.ToolTip>
          <Binding Path="EnableToolTip" Converter="{StaticResource TooltipConverter}">
            <Binding.ConverterParameter>
              <StackPanel Orientation="Horizontal" Margin="4" >
                <TextBlock Text="{Binding Name, Mode=OneWay}" />
                <TextBlock Text=" : "/>
                <TextBlock Text="{Binding Path=PropertyType, Mode=OneWay, Converter={StaticResource NameConverter}}" FontWeight="Bold"/>
              </StackPanel>
            </Binding.ConverterParameter>
          </Binding>
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*"/>
          <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Border BorderThickness="0.3,0.3,0.3,0.3" Margin="0,0,0,0" BorderBrush="LightGray" x:Name="PART_Name" SnapsToDevicePixels="True">

          <!--<ContentControl Content="{Binding Name}" IsTabStop="False" VerticalAlignment="Center" Margin="0,2,0,2"/>-->
          <TextBlock Text="{Binding DisplayName}" Name="PART_Text" TextTrimming="WordEllipsis" VerticalAlignment="Center" Margin="{Binding PropertyLevel, Mode=OneWay, Converter={StaticResource LevelConverter}}"/>
        </Border>

        <Border BorderThickness="0.3" BorderBrush="LightGray" x:Name="PART_Editor"  Grid.Column="1" SnapsToDevicePixels="True">
          <ContentControl Content="{Binding PropertyEditor}" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" IsTabStop="False"  Margin="0,2,0,2"/>
        </Border>
      </Grid>
    </Border>
    <!--<DataTemplate.Triggers>
      <Trigger Property="sync:SkinStorage.VisualStyle" Value="Blend">
        <Setter TargetName="PART_Editor" Property="Background" Value="#FF333333"/>
      </Trigger>
    </DataTemplate.Triggers>-->
  </DataTemplate>

</ResourceDictionary>