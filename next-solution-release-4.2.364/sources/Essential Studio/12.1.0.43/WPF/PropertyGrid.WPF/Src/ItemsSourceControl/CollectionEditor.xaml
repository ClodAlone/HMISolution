<Window x:Class="Syncfusion.Windows.PropertyGrid.CollectionEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Syncfusion.Windows.PropertyGrid"
        Title="CollectionEditor" Height="450" Width="450">
    <Grid Margin="5,20,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="217*" />
            <RowDefinition Height="44*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="94*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="92*" />
        </Grid.ColumnDefinitions>        
        
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox Grid.Row="0" x:Name="Part_Combo" ItemsSource="{Binding ItemType}" />
            <ListBox x:Name="Part_ListBox" Grid.Row="1"  SelectedItem="{Binding SelectedObject, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,20,0,0" Grid.RowSpan="1">
            <Button Content="Add" Margin="10"  Click="AddBtn_Click"/>
        <Button Content="Remove"  Margin="10"  Click="RemoveBtn_Click"/>
        </StackPanel>

        <local:PropertyGrid SelectedObject="{Binding SelectedObject}" Grid.Column="2" Grid.RowSpan="1" />
         
        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Height="25">
            <Button Content="OK" Margin="2" Click="OkBtn_Click" Width="43" />
            <Button Content="Cancel" Margin="22,2,2,2"  Click="CancelBtn_Click" Width="67" />
        </StackPanel>
        
    </Grid>
</Window>
