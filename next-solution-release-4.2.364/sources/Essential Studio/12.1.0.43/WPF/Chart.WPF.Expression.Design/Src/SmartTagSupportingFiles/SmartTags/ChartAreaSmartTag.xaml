<syncfusion:SmartTagBase x:Class="Syncfusion.Chart.Wpf.Expression.Design.ChartAreaSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"                    
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf" syncfusion:SkinStorage.VisualStyle="Office2007Blue"
 Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Chart Area Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.Wpf;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="7" Grid.Row="0">
                    <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:ChartSeries}" Click="AddChartSeries">Add Chart Series</Hyperlink>
                </TextBlock>
                    <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:ChartLegend}" Click="AddChartAreaLegend">Add Chart Area Legend</Hyperlink>
                </TextBlock>
                    <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel  Margin="7,0,7,7" Grid.Row="2">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                           
                            </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition Width="13" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" />
                    <TextBox Name="NameTextBox"  Margin="3,3,3,3" Width="115" Grid.Row="0" Grid.Column="1"/>
        
                     <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                        <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,5,0,5" />
                    </StackPanel>
                    
                    <!--Appearance Header-->
                    <TextBlock FontWeight="Bold" Grid.Row="2">Appearance</TextBlock>
                    
                    <TextBlock VerticalAlignment="Center" Text="Background" Grid.Row="3" Grid.Column="0"/>
                    <ComboBox Name="BackgroundSelector" Margin="3,3,3,3" Width="115" Grid.Row="3" Grid.Column="1"/>
                
                     <TextBlock VerticalAlignment="Center" Text="Foreground" Grid.Row="4" Grid.Column="0"/>
                    <ComboBox Name="ForegroundSelector" Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>
                
                     <TextBlock VerticalAlignment="Center" Text="Border" Grid.Row="5" Grid.Column="0"/>
                    <ComboBox Name="BorderSelector" Margin="3,3,3,3" Width="115" Grid.Row="5" Grid.Column="1"/>
                
                      <TextBlock VerticalAlignment="Center" Text="BorderThickness" Grid.Row="6" Grid.Column="0"/>
                    <TextBox Name="BorderThicknessTxtBox" Margin="3,3,3,3" Width="115" Grid.Row="6" Grid.Column="1"/>
                
                      <TextBlock VerticalAlignment="Center" Text="CornerRadius" Grid.Row="7" Grid.Column="0"/>
                    <TextBox Name="CornerRadiusTxtBox" Margin="3,3,3,3" Width="115" Grid.Row="7" Grid.Column="1"/>
                
                    
                     <StackPanel Grid.Row="8" Grid.ColumnSpan="3">
                        <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,3,0,3" />
                    </StackPanel>
                        
                           <!--Behavior Header-->
                    <TextBlock FontWeight="Bold" Grid.Row="9">Behavior</TextBlock>
                 
                    
                 <StackPanel Grid.Row="10" Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="ShowContextMenuCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Show ContextMenu
                            </TextBlock>
                        </StackPanel>
           

                    


                </Grid>

                </StackPanel>
            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>

