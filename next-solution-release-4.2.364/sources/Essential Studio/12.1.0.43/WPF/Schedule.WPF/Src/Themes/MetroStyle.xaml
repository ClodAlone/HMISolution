                        <Path Data="M0,4 L7,4 3.5,0z" HorizontalAlignment="Center" Height="4" Width="8" Stretch="Fill" Fill="#FF7F7F7F" Name="Arrow" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="true">
