    <!-- Schedule Brushes -->
    <SolidColorBrush x:Key="MetroScheduleBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroScheduleBorderBrush" Color="#FFC5C5C5"/>
    <SolidColorBrush x:Key="MetroStrokeLine" Color="#FFC5C5C5"/>
    <Thickness x:Key="MetroStrokeThickness" Top="0.5" Left="0.5" Right="0.5" Bottom="0.5"/>
    <SolidColorBrush x:Key="MetroSelectionBackground" Color="#FF2AABCF"/>
    <SolidColorBrush x:Key="MetroScheduleForeground" Color="#FF8A8A8A"/>    
    <SolidColorBrush x:Key="TextBlockForeground" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroScheduleCalendarViewBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroScheduleRowSelectionBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TodayHeaderBrush" Color="#FF2ABFF1"/>
