                                        <TextBox Margin="4,0,4,4" FontFamily="Syncfusion.Schedule.Wpf;component/Fonts/segoeui.ttf#Segoe UI" FontSize="12" Text="{Binding Appointment.Notes, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="1" Style="{StaticResource MetroThemeTextBoxStyle}"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                            <Border BorderBrush="#FF929292" BorderThickness="0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroScheduleHeaderTitleBarStyle" TargetType="{x:Type schedule:ScheduleHeaderTitleBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type schedule:ScheduleHeaderTitleBar}">
                    <Grid Visibility="{TemplateBinding Visibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="27"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PART_DateText" Margin="5,2,0,0" VerticalAlignment="Center" Grid.Column="2" FontFamily="/Syncfusion.Schedule.Wpf;component/Fonts/segoeui.ttf#Segoe UI" FontSize="16" Foreground="#FF333333" Text="{TemplateBinding Text}"/>
                        <Button x:Name="PART_NextButton" Style="{StaticResource NextNavigationButtonStyle}" Width="18" Height="18" Grid.Column="1"/>
                        <Button x:Name="PART_PrevButton" Style="{StaticResource PrevNavigationButtonStyle}" Width="18" Height="18" Grid.Column="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>   
    
    <Style x:Key="MetroScheduleDaysViewStyle" TargetType="{x:Type schedule:ScheduleDaysView}">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type schedule:ScheduleDaysView}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="65" />
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Background="{TemplateBinding Background}" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetroScrollViewerStyle}">
                            <schedule:MaxHeightPanel>
                                <schedule:ScheduleDaysHeaderViewItemsControl x:Name="PART_DaysHeaderControl" >
                                    <schedule:ScheduleDaysHeaderViewItemsControl.ContextMenu  >
                                        <ContextMenu x:Name="ContextMenuDaysHeaderControl" Style="{StaticResource MetroContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </schedule:ScheduleDaysHeaderViewItemsControl.ContextMenu>
                                </schedule:ScheduleDaysHeaderViewItemsControl>
                                <schedule:ScheduleAllDaysAppointmentItemsControl  x:Name="PART_AllDaysAppointmentsLayout" >
                                    <schedule:ScheduleAllDaysAppointmentItemsControl.ContextMenu>
                                        <ContextMenu x:Name="ContextMenuAllDaysAppointmentsLayout" Style="{StaticResource MetroContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </schedule:ScheduleAllDaysAppointmentItemsControl.ContextMenu>
                                </schedule:ScheduleAllDaysAppointmentItemsControl>
                            </schedule:MaxHeightPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="PART_TimeSlotScrollViewer" Background="{TemplateBinding Background}" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource MetroScrollViewerStyle}">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <schedule:ScheduleTimeLineItemsControl x:Name="PART_TimeLineItemsControl" VerticalAlignment="Top" LinesStroke="#FFA9B0B8" Background="White" BorderBrush="#FFA9B0B8" TimelineHourDivisionVisibility="{TemplateBinding TimelineHourDivisionVisibility}" FontWeight="Light" FontStretch="Condensed" HorizontalAlignment="Left" Width="55" Grid.Column="0">
                                    <schedule:ScheduleTimeLineItemsControl.ContextMenu>
                                        <ContextMenu x:Name="ContextMenuTimeLineItemsControl" Style="{StaticResource MetroContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </schedule:ScheduleTimeLineItemsControl.ContextMenu>
                                </schedule:ScheduleTimeLineItemsControl>
                                <schedule:ScheduleTimeSlotItemsControl x:Name="PART_TimeSlot" VerticalAlignment="Top" Grid.Column="1">
                                    <schedule:ScheduleTimeSlotItemsControl.ContextMenu>
                                        <ContextMenu x:Name="ContextMenuTimeSlot"  FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI"   Style="{StaticResource MetroContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </schedule:ScheduleTimeSlotItemsControl.ContextMenu>
                                </schedule:ScheduleTimeSlotItemsControl>
                                <schedule:ScheduleDaysAppointmentLayoutItemsControl x:Name="PART_AppointmentsLayout" Grid.Column="1" >
                                    <schedule:ScheduleDaysAppointmentLayoutItemsControl.ContextMenu>
                                        <ContextMenu x:Name="ContextMenuAppointmentsLayout" Style="{StaticResource MetroContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </schedule:ScheduleDaysAppointmentLayoutItemsControl.ContextMenu>
                                </schedule:ScheduleDaysAppointmentLayoutItemsControl>
                                <Grid x:Name="PART_AppointmentPopup" Grid.Column="1" />
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="CurrentDateGrid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,18,0"/>
                        <schedule:ScheduleAppointmentNavigatorControl x:Name="PART_AppointmentNavigatorControl" Grid.Row="1"  Grid.Column="1" Margin="0,0,18,0"></schedule:ScheduleAppointmentNavigatorControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type schedule:ScheduleDaysHeaderViewControl}">
        <Setter Property="HeaderBrush" Value="{StaticResource MetroScheduleHeaderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type schedule:ScheduleDaysHeaderViewControl}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStateGroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Current">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_CurrentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Storyboard.TargetName="Foreground" BeginTime="00:00:00" Duration="00:00:00.0000000" Storyboard.TargetProperty="Color" To="Black"/>
                                        <ColorAnimation Storyboard.TargetName="Foreground1" BeginTime="00:00:00" Duration="00:00:00.0000000" Storyboard.TargetProperty="Color" To="Black"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SelectedRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CurrentAndSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_CurrentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Storyboard.TargetName="Foreground" BeginTime="00:00:00" Duration="00:00:00.0000000" Storyboard.TargetProperty="Color" To="Black"/>
                                        <ColorAnimation Storyboard.TargetName="Foreground1" BeginTime="00:00:00" Duration="00:00:00.0000000" Storyboard.TargetProperty="Color" To="Black"/>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SelectedRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="border" Margin="0,0,-2,-1" Background="{TemplateBinding HeaderBrush}" BorderBrush="{TemplateBinding StrokeLine}" BorderThickness="{TemplateBinding StrokeThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="20" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="PART_CurrentRectangle" Height="20" Fill="{StaticResource TodayHeaderBrush}" VerticalAlignment="Top" Visibility="Collapsed" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"/>
                                <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" Text="{TemplateBinding DateText}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush x:Name="Foreground" Color="White"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Border VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" >
                                    <TextBlock HorizontalAlignment="Center" x:Name="DaysTextBlock" VerticalAlignment="Center" Text="{TemplateBinding DayText}" TextWrapping="Wrap">
                                     <TextBlock.Foreground>
                                        <SolidColorBrush x:Name="Foreground1" Color="White"/>
                                    </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                                <Rectangle x:Name="PART_HeaderRectangle" Fill="{TemplateBinding HeaderBrush}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" />
                                <Rectangle x:Name="PART_SelectedRectangle" Fill="{TemplateBinding SelectionBackground}" Stroke="{StaticResource MetroScheduleRowSelectionBorderBrush}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="schedule:ScheduleRectangleBorderExt">
        <Setter Property="LeftBrush" Value="{StaticResource MetroStrokeLine}"/>
        <Setter Property="RightBrush" Value="{StaticResource MetroStrokeLine}"/>
        <Setter Property="TopBrush" Value="{StaticResource MetroStrokeLine}"/>
        <Setter Property="BottomBrush" Value="{StaticResource MetroStrokeLine}"/>
      <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="schedule:ScheduleRectangleBorderExt">
                    <Grid x:Name="grid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStateGroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>                                        
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Selectedrectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>                                       
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Marked">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <SplineColorKeyFrame KeyTime="00:00:00" Value="#FFC5C5C5"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Line Stretch="Fill" Stroke="{TemplateBinding LeftBrush}" StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Y2="1"/>
                        <Line Stretch="Fill" Stroke="{TemplateBinding RightBrush}" StrokeThickness="{Binding BorderThickness.Right, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" Y2="1"/>
                        <Line Stretch="Fill" Stroke="{TemplateBinding TopBrush}" StrokeThickness="{Binding BorderThickness.Top, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Top" X2="1"/>
                        <Line Stretch="Fill" Stroke="{TemplateBinding BottomBrush}" StrokeThickness="{Binding BorderThickness.Bottom, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Bottom" X2="1"/>
                        <Rectangle x:Name="rectangle" Margin="{TemplateBinding BorderThickness}" Fill="Transparent" />
                        <Rectangle x:Name="Selectedrectangle" Fill="{TemplateBinding SelectionBackground}" Stroke="{StaticResource RowSelectionBorderBrush}" Margin="{TemplateBinding BorderThickness}" Visibility="Collapsed" />
                        <!--<Rectangle x:Name="Selectedrectangle" Fill="Transparent" Margin="{TemplateBinding BorderThickness}" />-->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroScheduleStyle" TargetType="{x:Type schedule:Schedule}">
        <Setter Property="ScheduleBackground" Value="{StaticResource MetroScheduleBackground}"/>
        <Setter Property="StrokeLine" Value="{StaticResource MetroStrokeLine}"/>
        <Setter Property="StrokeThickness" Value="{StaticResource MetroStrokeThickness}"/>
        <Setter Property="SelectionBackground" Value="{StaticResource MetroSelectionBackground}"/>     
        <Setter Property="HeaderBrush" Value="{StaticResource MetroScheduleHeaderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type schedule:Schedule}">
                    <Grid x:Name="PART_MainGrid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BdrCalendar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BdrCalendar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_BdrCalendar" Visibility="{TemplateBinding CalendarVisibility}" Background="{StaticResource MetroScheduleCalendarViewBackground}" Grid.Column="0">
                            <schedule:ScheduleCalendarViewItemsControl x:Name="PART_CalendarView" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" CalendarStyle="{DynamicResource MetroCalendarStyle}" CalendarDayButtonStyle="{DynamicResource MetroCalendarDayButtonStyle}"/>
                        </Border>
                        <GridSplitter Grid.Column="0" Visibility="{TemplateBinding CalendarVisibility}" Background="Transparent" Width="0.5" />
                        <Grid Grid.Column="1" Background="{TemplateBinding Background}">
                            <Border BorderBrush="{StaticResource MetroScheduleBorderBrush}" BorderThickness="0" Background="{StaticResource MetroScheduleBackground}"/>
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <schedule:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" SelectedDatesConverter="{TemplateBinding TitleBarTextConverter}" Visibility="{TemplateBinding TitleBarVisibility}" Style="{DynamicResource MetroScheduleHeaderTitleBarStyle}"/>
                                <schedule:ContentViewItemsControl x:Name="PART_MainViewItems" Margin="2" Grid.Row="1" SelectedIndex="0">
                                    <schedule:ScheduleDaysView Style="{StaticResource MetroScheduleDaysViewStyle}"  x:Name="PART_DaysView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentScheduleWindowStyle="{DynamicResource MetroChildWindowStyle}" AppointmentEditorStyle="{DynamicResource MetroScheduleAppointmentEditorControlStyle}" />
                                    <schedule:ScheduleMonthView x:Name="PART_MonthView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentScheduleWindowStyle="{DynamicResource MetroChildWindowStyle}" AppointmentEditorStyle="{DynamicResource MetroScheduleAppointmentEditorControlStyle}"/>
                                    <schedule:ScheduleHorizontalView x:Name="PART_HorizontalView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{DynamicResource MetroScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{DynamicResource MetroChildWindowStyle}"/>
                                </schedule:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>