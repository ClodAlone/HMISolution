    <SolidColorBrush x:Key="MetroScheduleHeaderBrush" Color="#FF2ABFF1"/>

    <SolidColorBrush x:Key="MetroScheduleTitleButtonBorderBrush" Color="#FFC1C1C1"/>
    <SolidColorBrush x:Key="MetroScheduleTitleButtonBackground" Color="#FF6F6F6F"/>
    <SolidColorBrush x:Key="MetroScheduleTitleButtonMouseOverBorderBrush" Color="#FF838383"/>
    <SolidColorBrush x:Key="MetroScheduleTitleButtonPressedBorderBrush" Color="#FFADADAD"/>
    <SolidColorBrush x:Key="MetroScheduleTitleButtonPressedBackground" Color="#FFC6C6C6"/>
    
    
    <!-- ContextMenu Brushes -->
    <SolidColorBrush x:Key="MetroContextMenuBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroContextMenuBorderBrush" Color="#FFBDBDBD"/>    
    
    
    <!-- Calendar Brushes -->

    <SolidColorBrush x:Key="CalendarBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CalendarForeground" Color="#FF333333"/>
    <SolidColorBrush x:Key="CalendarBorderBrush" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="CalendarButtonBorderBrush" Color="#FFC1C1C1"/>
    <SolidColorBrush x:Key="CalendarButtonPathFill" Color="#FF6F6F6F"/>
    <SolidColorBrush x:Key="CalendarButtonMouseOverBorderBrush" Color="#FF838383"/>
    <SolidColorBrush x:Key="CalendarButtonPressedBorderBrush" Color="#FFADADAD"/>
    <SolidColorBrush x:Key="CalendarDayButtonHoverBackground" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="CalendarDayButtonHoverBorderBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="CalendarTodayButtonBorderBrush" Color="#FF26A4DA"/>
    <SolidColorBrush x:Key="CalendarDayButtonSelectedBackground" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="CalendarDayButtonSelectedBorderBrush" Color="#FF26A4DA"/>
