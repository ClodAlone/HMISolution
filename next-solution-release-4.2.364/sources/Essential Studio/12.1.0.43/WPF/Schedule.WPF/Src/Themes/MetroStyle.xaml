    <!-- Schedule Button Brushes -->
    <!-- Button Brushes -->
    <SolidColorBrush x:Key="ScheduleButtonNormalBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="ScheduleButtonNormalBorder" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="ScheduleButtonNormalForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="ScheduleButtonMouseHoverBackground" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="ScheduleButtonMouseHoverBorderBrush" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="ScheduleButtonMouseHoverForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="ScheduleButtonPressedBackground" Color="#FF5EC8F5"/>
    <SolidColorBrush x:Key="ScheduleButtonPressedBorderBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="ScheduleButtonPressedForeground" Color="#FFFFFFFF"/>
    
    <!-- Toggle Button Brushes -->
    <SolidColorBrush x:Key="ScheduleToggleButtonNormalBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="ScheduleToggleButtonNormalBorder" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="ScheduleToggleButtonNormalForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="ScheduleToggleButtonMouseHoverBackground" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="ScheduleToggleButtonMouseHoverBorderBrush" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="ScheduleToggleButtonMouseHoverForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="ScheduleToggleButtonPressedBackground" Color="#FF5EC8F5"/>
    <SolidColorBrush x:Key="ScheduleToggleButtonPressedBorderBrush" Color="#FF2ABFF1"/>
