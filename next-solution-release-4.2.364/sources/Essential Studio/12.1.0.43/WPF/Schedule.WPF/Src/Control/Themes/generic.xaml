    <local:SelectedIndexToVisibilityConverter x:Key="IndexConverter" />
    <Style TargetType="{x:Type local:Schedule}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Schedule}">

                    <Grid x:Name="PART_MainGrid" Background="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible"/>                                   
                            </VisualStateGroup>                               
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>                  
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Name="PART_BdrCalendar" Visibility="{TemplateBinding CalendarVisibility}" Grid.Column="0" Background="#FFE1E5EA">
                            <local:ScheduleCalendarViewItemsControl Margin="10,5,0,0" x:Name="PART_CalendarView" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" />                           
                        </Border>
                        <GridSplitter Grid.Column="0" Visibility="{TemplateBinding CalendarVisibility}" Background="Transparent" Width="2.5" />
                        <Grid Grid.Column="1">
                            <Border BorderBrush="#FFC1CEDE" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFC5D3E3" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <local:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" SelectedDatesConverter="{TemplateBinding TitleBarTextConverter}"  Visibility="{TemplateBinding TitleBarVisibility}" Background="{StaticResource Office14BlackBackgroundBrush}" Foreground="{StaticResource Office14BlackForegroundBrush}" BorderBrush="{StaticResource Office14BlackBorderBrush}" FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="16" VerticalAlignment="Center" />
                                <local:ContentViewItemsControl x:Name="PART_MainViewItems" SelectedIndex="0" Grid.Row="1" Margin="2">
                                    <local:ContentViewItemsControl.Items>
                                        <local:ScheduleDaysView x:Name="PART_DaysView" TimelineVisibility="{TemplateBinding TimelineVisibility}" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" TimelineHourDivisionVisibility="{TemplateBinding TimelineHourDivisionVisibility}" />
                                        <local:ScheduleMonthView x:Name="PART_MonthView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        <local:ScheduleHorizontalView x:Name="PART_HorizontalView" TimelineVisibility="{TemplateBinding TimelineVisibility}" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </local:ContentViewItemsControl.Items>
                                </local:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
