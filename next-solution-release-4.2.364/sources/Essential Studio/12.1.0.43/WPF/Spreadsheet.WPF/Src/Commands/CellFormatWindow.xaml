<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.CellFormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        x:Name="formatWindow"   WindowStartupLocation="CenterOwner" 
        Width="190" Height="105" Title="Cell Format" ResizeMode="NoResize">


    <Grid x:Name="LayoutRoot" Background="#F0F0F0">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <Grid>
            <StackPanel>
                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" Margin="3" Width="80" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <syncfusion:DoubleTextBox Name="DoubleTextBox" Margin="3" Value="{Binding Path=Value,Mode=TwoWay,ElementName=formatWindow}" Height="20" Width="80"/>
                </StackPanel>
                <StackPanel Margin="5" Orientation="Horizontal" >
                    <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  Margin="3" Width="80" Click="OnOkButtonClick"/>
                    <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="3" Width="80" Click="OnCancelButtonClick"/>
                </StackPanel>
            </StackPanel>
            <!--<Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"  Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" Margin="5"   VerticalAlignment="Center"  HorizontalAlignment="Left" />
                <syncfusion:DoubleTextBox Name="DoubleTextBox"  Value="{Binding Path=Value,Mode=TwoWay,ElementName=formatWindow}" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Height="25" Width="75"/>
            </StackPanel>
            <StackPanel Grid.Row="1"  Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"  Width="70" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Width="70" Click="OnCancelButtonClick"/>
            </StackPanel>-->
        </Grid>
        </Grid>
</Window>
