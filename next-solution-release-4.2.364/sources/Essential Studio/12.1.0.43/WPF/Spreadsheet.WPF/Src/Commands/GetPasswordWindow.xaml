<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.GetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources" x:Name="PasswordWindow"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
        Title="Password" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Height="120" Width="280">
    <Grid>
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" >
                <TextBlock Margin="5" Text="{Binding Path=FileName,Mode=TwoWay,ElementName=PasswordWindow}"/>
                <!--<TextBlock  Margin="5" Text="is Protected"/>-->
            </StackPanel>
            <StackPanel Orientation="Horizontal" >
                <TextBlock Margin="5" Text="{Binding Source={StaticResource ribbonResources},Path=Password}"/>
                <PasswordBox Margin="5" Width="205" x:Name="passwordBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  HorizontalAlignment="Right" Margin="5" Width="70" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5,5,5,5" HorizontalAlignment="Left" Grid.Column="1" Width="70" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
