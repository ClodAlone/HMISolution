<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.InsertCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  x:Name="commentWindow"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
         Width="275" Height="180"  WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Title="New Comment">
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0" Margin="0,5,2,0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Comment}" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            <TextBox Name="CommentTextBox" Margin="5" Height="100" Width="200" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  VerticalAlignment="Top"
                 Text="{Binding ElementName=commentWindow,Path=Comment,Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1"  HorizontalAlignment="Right">
        <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  HorizontalAlignment="Right" Margin="5" Width="70" Click="OnOkButtonClick"/>
        <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5" HorizontalAlignment="Left" Grid.Column="1" Width="70" Click="OnCancelButtonClick"/>
        </StackPanel>
    </Grid>
</Window>
