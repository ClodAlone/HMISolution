<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.EncryptCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="encryptWindow"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        Width="290" Height="160"  WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Title="Table">
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=encryptWindow}" Margin="5" Height="20" Width="275" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Path=DescriptionText,Mode=TwoWay,ElementName=encryptWindow}" Margin="5" Height="20" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <PasswordBox HorizontalAlignment="Left"  x:Name="txtValue" Margin="5" Width="270"/>
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
