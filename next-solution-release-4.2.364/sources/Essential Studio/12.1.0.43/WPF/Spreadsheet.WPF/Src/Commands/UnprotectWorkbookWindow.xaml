<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.UnprotectWorkbookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources" x:Name="unprotectWindow"
        Title="Unprotect Window" Height="120" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=unprotectWindow}" Margin="3" Width="70"/>
                <PasswordBox x:Name="txtValue" Margin="3" Width="190"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5" >
                <Button  Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
