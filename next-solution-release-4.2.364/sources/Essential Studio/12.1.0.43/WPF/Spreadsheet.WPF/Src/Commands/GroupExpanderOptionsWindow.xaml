<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.GroupOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Name="LaunchWindow"   
        Height="150" Width="350">
    
    <Grid>
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <StackPanel  Grid.Row="0"  Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Direction}" Margin="10,0,0,5"/>
            <CheckBox Name="SummaryRow"  IsChecked="{Binding Path=IsSummaryRowBelow,Mode=TwoWay,ElementName=LaunchWindow}" Content="{Binding Source={StaticResource ribbonResources},Path=IsSummaryRowBelow}" Margin="10,0,0,5"/>
            <CheckBox Name="SummaryColumn" IsChecked="{Binding Path=IsSummaryColumnAtRight,Mode=TwoWay,ElementName=LaunchWindow}" Content="{Binding Source={StaticResource ribbonResources},Path=IsSummaryColumnAtRight}" Margin="10,0,0,5"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1"  HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Click="OnOkButtonClick"   Margin="10" Width="70" Height="25" />
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Click="OnCancelButtonClick"   Margin="10" Width="70" Height="25" />
        </StackPanel>
    </Grid>
</Window>
