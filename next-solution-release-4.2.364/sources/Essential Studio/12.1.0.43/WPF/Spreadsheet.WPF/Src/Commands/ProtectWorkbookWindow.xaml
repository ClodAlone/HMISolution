<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.ProtectWorkbookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="protectWindow"
        Width="300" Height="190" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Title="Protect Structure and Windows">
    <Grid>
        <Grid.Resources>
        <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=protectWindow}" Margin="10,5,5,5" Height="20" Width="270" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="30,0,0,0">
                <CheckBox Margin="3" Name="Structure_Check" Content="{Binding Source={StaticResource ribbonResources},Path=Structure}" IsChecked="{Binding Path=IsStructure,Mode=TwoWay,ElementName=protectWindow}"/>
                <CheckBox Margin="3" Content="{Binding Source={StaticResource ribbonResources},Path=Windows}" IsChecked="{Binding Path=IsWindows,Mode=TwoWay,ElementName=protectWindow}"/>
            </StackPanel>
           
            <TextBlock Text="{Binding Path=DescriptionText,Mode=TwoWay,ElementName=protectWindow}" Margin="10,5,5,0" Height="20" Width="270" VerticalAlignment="Center" HorizontalAlignment="Left" />
           
            <PasswordBox Name="txtValue" Margin="5,0,5,5" Width="270"/>
           
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  Margin="5,5,7,5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5,5,7,5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
