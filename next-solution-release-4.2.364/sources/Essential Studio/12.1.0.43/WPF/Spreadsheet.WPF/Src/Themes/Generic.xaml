<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:tools ="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Spreadsheet.Wpf;component/SpreadsheetRibbon/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Spreadsheet.Wpf;component/Helpers/FillSeries/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Spreadsheet.Wpf;component/Helpers/CopyPaste/Themes/Generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ImageSource x:Key="CancelEditIcon">/Syncfusion.Spreadsheet.Wpf;component/SpreadsheetRibbon/ExcelUI/FormulaBar/CancelEditIcon.PNG</ImageSource>
    <ImageSource x:Key="EndEditIcon">/Syncfusion.Spreadsheet.Wpf;component/SpreadsheetRibbon/ExcelUI/FormulaBar/EndEditIcon.PNG</ImageSource>

    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <local:CurrentCellStyleToReadOnlyConverter x:Key="CurrentCellStyleToReadOnlyConverter"/>

    <Style TargetType="local:SpreadsheetGroupButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SpreadsheetGroupButton">
                    <Border Name="border" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Path1"
                                                Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed
                                                    </Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Path1"
                                                Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible
                                                    </Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>


                        <Grid>
                            <Grid Name="backgroundGrid" Width="20" Height="20" Visibility="Visible">
                                <Rectangle Fill="#FFBCD0E8" Stroke="#FF727F8C" Name="Rect" Visibility="Visible" />
                            </Grid>
                            <Path Name="Path1" Data="M19.833,0L32.501,0 32.501,19.833999 52.334,19.833999 52.334,32.500999 32.501,32.500999 32.501,52.333 19.833,52.333 19.833,32.500999 0,32.500999 0,19.833999 19.833,19.833999z"  Stretch="Uniform" Fill="#FF727F8C" Width="12" Height="12" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>

                            <Path Name="Path2" Data="M0,0L53.333,0 53.333,8.888 0,8.888z"  Stretch="Uniform" Fill="#FF727F8C" Width="12" Height="12" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExcelEditorStyle"  TargetType="{x:Type local:SpreadsheetControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SpreadsheetControl}">
                    
                    <Grid x:Name="MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="200"/>
                        </Grid.RowDefinitions>

                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="NameBox" TextWrapping="NoWrap" Grid.Column="0" VerticalAlignment="Top" BorderThickness="1,1,0,1" HorizontalAlignment="Stretch" Height="23" IsReadOnly="False" MinWidth="100"
                                     Text="{Binding Path=GridProperties.CellName,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=Explicit}" HorizontalContentAlignment="Center"
                                     BorderBrush="{TemplateBinding BorderBrush}"/>

                            <Border Background="White" VerticalAlignment="Top" BorderThickness="0,1,0,1" Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border CornerRadius="10,0,0,10" 
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        VerticalAlignment="Top" BorderThickness="0" Width="60" Height="21">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" MinWidth="20"/>
                                            <ColumnDefinition Width="20" MinWidth="20"/>
                                            <ColumnDefinition Width="20" MinWidth="20"/>
                                        </Grid.ColumnDefinitions>
                                        <syncfusion:ButtonAdv x:Name="EndEditButton" SizeMode="Small" Background="Transparent" BorderThickness="0" Width="30" Grid.Column="1" SmallIcon="{StaticResource EndEditIcon}" Padding="2"
                                                              Visibility="{Binding Path=GridProperties.IsEditing,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,Converter={StaticResource BoolToVisibilityConverter}}" Height="30"/>
                                        <syncfusion:ButtonAdv x:Name="CancelEditButton" SizeMode="Small" Background="Transparent" BorderThickness="0" Width="30" Grid.Column="2" SmallIcon="{StaticResource CancelEditIcon}" Padding="2"
                                                              Visibility="{Binding Path=GridProperties.IsEditing,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,Converter={StaticResource BoolToVisibilityConverter}}" Height="30"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="7,7,0,0"
                                          Background="#FFB0BFD2" BorderThickness="1" BorderBrush="#FFB0BFD2"
                                          ResizeBehavior="PreviousAndCurrent"/>

                            <ScrollViewer Grid.Column="2">
                                <TextBox TextWrapping="Wrap" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="FormulaBar" VerticalAlignment="Stretch"
                                     IsReadOnly="{Binding Path=GridProperties.CurrentCellStyle.ReadOnly,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" BorderBrush="{TemplateBinding BorderBrush}"
                                     Text="{Binding Path=GridProperties.FormattedText,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </ScrollViewer>

                        </Grid>

                        <GridSplitter HorizontalAlignment="Stretch" Grid.Row="1" ResizeBehavior="PreviousAndNext" Height="5" Background="{TemplateBinding Background}"
                                      Visibility="{TemplateBinding FormulaBarVisibility}"/>

                        <Grid x:Name="Part_Grid" Grid.Row="2" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>                                                                                                                                          
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <local:SpreadsheetGroupPanel x:Name="ColumnGroupPanel" Orientation="Horizontal"   Grid.Column="1"/>
                            <local:SpreadsheetGroupPanel x:Name="RowGroupPanel" Orientation="Vertical"  Grid.Row="1"/>
                            <syncfusion:TabControlExt x:Name="ExcelTabControlAdv" SelectedIndex="{Binding Path=TabSelectedIndex,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                                Grid.Row="1"  Grid.Column="1"  SelectedItem="{Binding Path=TabSelectedItem,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                TabStripPlacement="{Binding Path=TabStyleManager.Dock,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                IsCustomTabItemContextMenuEnabled="True" ShowTabItemContextMenu="{Binding Path=TabStyleManager.ShowTabItemContextMenu,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                TabVisualStyle="{Binding Path=TabStyleManager.TabVisualStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                ShowTabListContextMenu="False" CloseButtonType="Hide" EnableLabelEdit="False">
                            </syncfusion:TabControlExt>                            
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ExcelEditorStyle}" TargetType="{x:Type local:SpreadsheetControl}"/>

</ResourceDictionary>
