<syncfusion:SmartTagBase x:Class="Syncfusion.Diagram.WPF.Expression.Design.VerticalRulerSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="VerticalRuler Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0"  Width="120" Height="25" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>

                <TextBlock Text="Background" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbBackground" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="MajorLinesStroke" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbMajorLinesStroke" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="MajorLinesThickness" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtMajorLinesThickness" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="MarkerBrush" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbMarkerBrush" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="MarkerThickness" Grid.Row="10" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtMarkerThickness" Grid.Row="10" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
                <TextBlock Text="MinorLinesStroke" Grid.Row="11" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbMinorLinesStroke" Grid.Row="11" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="MinorLinesThickness" Grid.Row="12" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtMinorLinesThickness" Grid.Row="12" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="LabelFontColor" Grid.Row="13" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbLabelFontColor" Grid.Row="13" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
    