<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.UI.Xaml.Charts">
    <Style x:Key="axisStyle" TargetType="Line">
        <Setter Property="Stroke" Value="Red"></Setter>
        <Setter Property="StrokeThickness" Value="1"></Setter>
    </Style>
    
    <Style x:Key="trackBallStyle" TargetType="Ellipse">
        <Setter Property="Height" Value="5"></Setter>
        <Setter Property="Width" Value="5"></Setter>
        <Setter Property="Fill" Value="Red"></Setter>
    </Style>

    <Style x:Key="sparklineBase" TargetType="{x:Type local:SparklineBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SparklineBase}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                        <Grid Background="Transparent" Name="PART_RootPanel"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SparklineBase}" BasedOn="{StaticResource sparklineBase}"/>
    
    <Style TargetType="{x:Type local:MarkerBase}" BasedOn="{StaticResource sparklineBase}">
        <Setter Property="AxisStyle" Value="{StaticResource axisStyle}"/>
        <Setter Property="LineStyle" Value="{StaticResource axisStyle}"/>
        <Setter Property="TrackBallStyle" Value="{StaticResource trackBallStyle}"/>
    </Style>

    <Style TargetType="{x:Type local:SfColumnSparkline}" BasedOn="{StaticResource sparklineBase}">
        <Setter Property="AxisStyle" Value="{StaticResource axisStyle}"/>
    </Style>

</ResourceDictionary>
