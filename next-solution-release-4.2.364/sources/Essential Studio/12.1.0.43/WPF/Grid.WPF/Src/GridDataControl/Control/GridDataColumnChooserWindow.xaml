<Window x:Class="Syncfusion.Windows.Controls.Grid.GridDataColumnChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Controls.Grid"
        x:Name="Columnchooserwindow"
        MinHeight="300"
        MaxHeight="300"
        AllowDrop="True"
        SizeToContent="Width"
        WindowStyle="ToolWindow">
    <ScrollViewer x:Name="columnchooserpanel"
                  Background="Transparent"
                  CanContentScroll="True"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Auto">
        <syncfusion:GridControl x:Name="grid" AllowDragDrop="True" />
    </ScrollViewer>

</Window>