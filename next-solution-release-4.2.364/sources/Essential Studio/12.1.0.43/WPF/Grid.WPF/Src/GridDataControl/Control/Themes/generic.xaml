<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">
    <Image x:Key="SortAscending" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/SortAscending.ico" />
    <Image x:Key="SortDescending" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/SortDescending.ico" />
    <Image x:Key="ClearSort" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/ClearSort.ico" />
    <Image x:Key="ClearFilter" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/ClearFilter.ico" />
    <Image x:Key="GroupBy" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/GroupBy.ico" />
    <Image x:Key="GroupDropArea" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/GroupDropArea.ico" />
    <Image x:Key="BestFit" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/BestFit.ico" />
    <Image x:Key="Delete" Source="pack://application:,,,/Syncfusion.Grid.Wpf;component/GridDataControl/Control/Styles/Icons/Delete.ico" />


    <ControlTemplate x:Key="GridDataControlTemplate" TargetType="{x:Type local:GridDataControl}">
        <Grid Name="PART_MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Name="PART_GroupDropAreaBorder"
                    Grid.Row="0"
                    Height="{Binding GroupDropAreaHeight,
                                     Mode=TwoWay,
                                     RelativeSource={RelativeSource TemplatedParent}}"
                    Margin="0,0,0,-1"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer Name="PART_GroupDropAreaScrollViewer"
                              CanContentScroll="True"
                              HorizontalScrollBarVisibility="Hidden"
                              SnapsToDevicePixels="True"
                              Style="{TemplateBinding ScrollViewerStyle}"
                              VerticalScrollBarVisibility="Hidden">
                    <!--<local:GridDataGroupDropAreaGridImpl x:Name="Part_GroupDropAreaGrid" />-->
                </ScrollViewer>
            </Border>
            <Border Name="PART_Border"
                    Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer Name="PART_ScrollViewer"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              IsDeferredScrollingEnabled="{Binding Path=IsDeferredScrollingEnabled,
                                                                   Mode=TwoWay,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                              SnapsToDevicePixels="True"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
            </Border>
            <Border Name="PART_BorderStatusBar"
                    Grid.Row="2"
                    Height="0"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               SnapsToDevicePixels="True"
                               Text="{TemplateBinding StatusBarMessage}"
                               TextTrimming="WordEllipsis" />
                    <Border Grid.Column="1"
                            Margin="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <Button x:Name="PART_CloseButton"
                                Width="15"
                                Height="15"
                                Margin="0,5,5,0" IsTabStop="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#FFFC5F4B"
                                BorderBrush="White"
                                Canvas.ZIndex="1"
                                ToolTip="Clear Filter">
                            <Grid>
                                <Path x:Name="path1"
                                      Data="M100.33679,95.997467 L726.36096,557.77032"
                                      Stretch="Fill"
                                      Stroke="White"
                                      StrokeThickness="2" />
                                <Path x:Name="path"
                                      Data="M13,461 L621,13"
                                      Stretch="Fill"
                                      Stroke="White"
                                      StrokeThickness="2" />
                            </Grid>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.MouseEnter">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimationUsingKeyFrames AutoReverse="True"
                                                                              BeginTime="00:00:00"
                                                                              Duration="00:00:00.0010000"
                                                                              Storyboard.TargetName="path"
                                                                              Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                    <LinearColorKeyFrame KeyTime="00:00:00" Value="#FFFC5F4B" />
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames AutoReverse="True"
                                                                              BeginTime="00:00:00"
                                                                              Duration="00:00:00.0010000"
                                                                              Storyboard.TargetName="path1"
                                                                              Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                    <LinearColorKeyFrame KeyTime="00:00:00" Value="#FFFC5F4B" />
                                                </ColorAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseLeave">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimationUsingKeyFrames AutoReverse="True"
                                                                              BeginTime="00:00:00"
                                                                              Duration="00:00:00.0010000"
                                                                              Storyboard.TargetName="path"
                                                                              Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                    <LinearColorKeyFrame KeyTime="00:00:00" Value="White" />
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames AutoReverse="True"
                                                                              BeginTime="00:00:00"
                                                                              Duration="00:00:00.0010000"
                                                                              Storyboard.TargetName="path1"
                                                                              Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                    <LinearColorKeyFrame KeyTime="00:00:00" Value="White" />
                                                </ColorAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Default">
                <Setter Property="VisualStyle" Value="0" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="VisualStyle" Value="1" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="VisualStyle" Value="2" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="VisualStyle" Value="3" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="VisualStyle" Value="4" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="VisualStyle" Value="5" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="VisualStyle" Value="10" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="VS2010">
                <Setter Property="VisualStyle" Value="20" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="VisualStyle" Value="9" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Metro">
                <Setter Property="VisualStyle" Value="23" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2010Blue">
                <Setter Property="VisualStyle" Value="17" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2010Silver">
                <Setter Property="VisualStyle" Value="18" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2010Black">
                <Setter Property="VisualStyle" Value="19" />
            </Trigger>
            <Trigger Property="ShowGroupDropArea" Value="False">
                <Setter TargetName="PART_GroupDropAreaBorder" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowGroupDropArea" Value="True">
                <Setter TargetName="PART_GroupDropAreaBorder" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GridDataControlBaseStyle" TargetType="{x:Type local:GridDataControl}">
        <Setter Property="Template" Value="{StaticResource GridDataControlTemplate}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="{x:Static ScrollBarVisibility.Auto}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="{x:Static ScrollBarVisibility.Auto}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    </Style>

    <Style BasedOn="{StaticResource GridDataControlBaseStyle}" TargetType="{x:Type local:GridDataControl}" />

</ResourceDictionary>
