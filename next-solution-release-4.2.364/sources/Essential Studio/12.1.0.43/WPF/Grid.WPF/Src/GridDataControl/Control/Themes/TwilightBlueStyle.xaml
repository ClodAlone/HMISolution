    <!--  Slider Styles  -->

    <Style x:Key="TwilightBlueHorizontalSliderUpThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="false" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Canvas SnapsToDevicePixels="true">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <TransformGroup.Children>
                                    <TransformCollection>
                                        <RotateTransform Angle="180" />
                                        <TranslateTransform X="5" Y="9" />
                                    </TransformCollection>
                                </TransformGroup.Children>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path x:Name="sliderThumb"
                              Data="{StaticResource TwilightBlueSliderPointedThumbOuterBorderGeometry}"
                              Fill="{StaticResource TwilightBlueHorizontalSliderThumbNormalBackground}"
                              SnapsToDevicePixels="True" />
                        <Path x:Name="InnerBorder"
                              Data="{StaticResource TwilightBlueSliderPointedThumbMiddleBorderGeometry}"
                              SnapsToDevicePixels="True"
                              Stroke="{StaticResource TwilightBlueHorizontalSliderThumbMiddleBorderBorderBrush}"
                              StrokeThickness="1" />
                        <Path x:Name="OuterBorder"
                              Data="{StaticResource TwilightBlueSliderPointedThumbOuterBorderGeometry}"
                              SnapsToDevicePixels="True"
                              Stroke="{StaticResource TwilightBlueHorizontalSliderThumbOuterBorderBorderBrush}"
                              StrokeThickness="1" />
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="sliderThumb" Property="Fill" Value="{StaticResource TwilightBlueHorizontalSliderThumbMouseOverBackground}" />
                            <Setter TargetName="InnerBorder" Property="Stroke" Value="{StaticResource TwilightBlueHorizontalSliderThumbMiddleBorderBorderBrush}" />
                            <Setter TargetName="OuterBorder" Property="Stroke" Value="{StaticResource TwilightBlueHorizontalSliderThumbOuterBorderBorderBrush}" />
                        </Trigger>
                        <!--
                            <Trigger Property="Foreground" Value="Blue">
                            <Setter Property="Fill" TargetName="sliderThumb" Value="{StaticResource Office2010BlueHorizontalSliderThumbHoverBackground}"/>
                            <Setter Property="Stroke" TargetName="OuterBorder" Value="{StaticResource Office2010BlueHorizontalSliderThumbHoverBorder}"/>
                            </Trigger>
                        -->
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="sliderThumb" Property="Fill" Value="{StaticResource TwilightBlueHorizontalSliderThumbPressedBackground}" />
                            <Setter TargetName="InnerBorder" Property="Stroke" Value="{StaticResource TwilightBlueHorizontalSliderThumbPressedInnerBorderBrush}" />
                            <Setter TargetName="OuterBorder" Property="Stroke" Value="{StaticResource TwilightBlueHorizontalSliderThumbPressedOuterBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TwilightBlueHorizontalSliderDownThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="false" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Canvas SnapsToDevicePixels="true">
                        <Path x:Name="thumbPath"
