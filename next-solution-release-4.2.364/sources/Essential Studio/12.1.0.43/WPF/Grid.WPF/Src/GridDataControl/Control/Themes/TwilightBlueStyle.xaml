                                         StrokeThickness="{TemplateBinding BorderThickness}" />
                                <Ellipse x:Name="ellipse2"
                                         Canvas.Left="2"
                                         Canvas.Top="2"
                                         Width="11"
                                         Height="11"
                                         SnapsToDevicePixels="True" />
                                <Ellipse x:Name="ellipse3"
                                         Canvas.Left="3"
                                         Canvas.Top="3"
                                         Width="9"
                                         Height="9"
                                         Fill="{StaticResource TwilightBlueRadioButtonInnerEllipseBackground}"
                                         SnapsToDevicePixels="True"
                                         Stroke="{StaticResource TwilightBlueRadioButtonInnerEllipseBorderBrush}"
                                         StrokeThickness="1" />
                                <Ellipse x:Name="ellipse"
                                         Canvas.Left="4"
                                         Canvas.Top="4"
                                         Width="7"
                                         Height="7"
                                         SnapsToDevicePixels="True" />
                            </Canvas>
                        </BulletDecorator.Bullet>
                        <ContentPresenter x:Name="contentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="true">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource TwilightBlueRadioBoxFocusVisual}" />
                            <Setter Property="Padding" Value="4,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ellipse" Property="Fill" Value="{StaticResource TwilightBlueRadioButtonPathBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ellipse1" Property="Stroke" Value="{StaticResource TwilightBlueRadioButtonOuterBorderPressedBorderBrush}" />
                            <Setter TargetName="ellipse1" Property="Fill" Value="{StaticResource TwilightBlueRadioButtonOuterBorderPressedBackground}" />
                            <Setter TargetName="ellipse3" Property="Fill" Value="{StaticResource TwilightBlueRadioButtonOuterBorderPressedBackground}" />
                            <Setter TargetName="ellipse3" Property="Stroke" Value="{StaticResource TwilightBlueRadioButtonInnerBorderPressedBorderBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ellipse1" Property="Fill" Value="{StaticResource TwilightBlueRadioButtonOuterBorderMouseOverBackground}" />
                            <Setter TargetName="ellipse1" Property="Stroke" Value="{StaticResource TwilightBlueRadioButtonOuterBorderMouseOverBorderBrush}" />
                            <Setter TargetName="ellipse3" Property="Fill" Value="{StaticResource TwilightBlueRadioButtonInnerBorderMouseOverBackground}" />
                            <Setter TargetName="ellipse3" Property="Stroke" Value="{StaticResource TwilightBlueRadioButtonInnerBorderMouseOverBorderBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

