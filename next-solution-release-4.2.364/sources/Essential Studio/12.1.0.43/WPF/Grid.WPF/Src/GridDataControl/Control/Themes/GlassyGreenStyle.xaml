    <Style x:Key="GlassyGreenHorizontalSliderUpThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="false" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Foreground" Value="Gray" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Canvas SnapsToDevicePixels="true">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <TransformGroup.Children>
                                    <TransformCollection>
                                        <RotateTransform Angle="180" />
                                        <TranslateTransform X="5" Y="9" />
                                    </TransformCollection>
                                </TransformGroup.Children>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path x:Name="sliderThumb"
                              Data="{StaticResource GlassyGreenSliderPointedThumbOuterBorderGeometry}"
                              Fill="{StaticResource GlassyGreenHorizontalSliderThumbNormalBackground}"
                              SnapsToDevicePixels="True" />
                        <Path x:Name="InnerBorder"
                              Data="{StaticResource GlassyGreenSliderPointedThumbMiddleBorderGeometry}"
                              SnapsToDevicePixels="True"
                              Stroke="{StaticResource GlassyGreenHorizontalSliderThumbMiddleBorderBorderBrush}"
                              StrokeThickness="1" />
                        <Path x:Name="OuterBorder"
                              Data="{StaticResource GlassyGreenSliderPointedThumbOuterBorderGeometry}"
                              SnapsToDevicePixels="True"
                              Stroke="{StaticResource GlassyGreenHorizontalSliderThumbOuterBorderBorderBrush}"
                              StrokeThickness="1" />
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="sliderThumb" Property="Fill" Value="{StaticResource GlassyGreenHorizontalSliderThumbMouseOverBackground}" />
                            <Setter TargetName="InnerBorder" Property="Stroke" Value="{StaticResource GlassyGreenHorizontalSliderThumbMiddleBorderBorderBrush}" />
                            <Setter TargetName="OuterBorder" Property="Stroke" Value="{StaticResource GlassyGreenHorizontalSliderThumbOuterBorderBorderBrush}" />
                        </Trigger>
                        <!--
                            <Trigger Property="Foreground" Value="Blue">
                            <Setter Property="Fill" TargetName="sliderThumb" Value="{StaticResource Office2010BlueHorizontalSliderThumbHoverBackground}"/>
                            <Setter Property="Stroke" TargetName="OuterBorder" Value="{StaticResource Office2010BlueHorizontalSliderThumbHoverBorder}"/>
                            </Trigger>
                        -->
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="sliderThumb" Property="Fill" Value="{StaticResource GlassyGreenHorizontalSliderThumbPressedBackground}" />
                            <Setter TargetName="InnerBorder" Property="Stroke" Value="{StaticResource GlassyGreenHorizontalSliderThumbPressedInnerBorderBrush}" />
                            <Setter TargetName="OuterBorder" Property="Stroke" Value="{StaticResource GlassyGreenHorizontalSliderThumbPressedOuterBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
