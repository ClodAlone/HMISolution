    <Style x:Key="GlassyGreenCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource GlassyGreenCheckBoxForeground}" />
        <Setter Property="Background" Value="{StaticResource GlassyGreenCheckBoxBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassyGreenCheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyCheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="true">
                        <BulletDecorator.Bullet>
                            <Border x:Name="border1"
                                    Width="13"
                                    Height="13"
                                    Background="{StaticResource GlassyGreenCheckBoxOuterBorderBackground}"
                                    BorderBrush="{StaticResource GlassyGreenCheckBoxOuterBorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Border x:Name="border2"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border x:Name="border3"
                                            Background="{StaticResource GlassyGreenCheckBoxInnerBorderBackground}"
                                            BorderBrush="{StaticResource GlassyGreenCheckBoxInnerBorderBorderBrush}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Canvas SnapsToDevicePixels="True">
                                            <Path x:Name="path"
                                                  Width="6"
                                                  Height="8"
                                                  Data="F1 M 424.575,325.964L 426.491,324.964L 428.158,327.297L 431.741,320.214L 433.574,321.464L 429.158,330.131L 427.074,330.131L 424.575,325.964 Z "
                                                  Fill="{StaticResource GlassyGreenCheckBoxPathBackground}"
                                                  Opacity="0"
                                                  SnapsToDevicePixels="True"
                                                  Stretch="Fill" />
                                        </Canvas>
                                    </Border>
                                </Border>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="true">                            
                            <Setter Property="Padding" Value="4,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="path" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource GlassyGreenCheckBoxOuterBorderMouseOverBorderBrush}" />
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource GlassyGreenCheckBoxOuterBorderMouseOverBackground}" />
                            <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource GlassyGreenCheckBoxInnerBorderMouseOverBorderBrush}" />
                            <Setter TargetName="border3" Property="Background" Value="{StaticResource GlassyGreenCheckBoxInnerBorderMouseOverBackground}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource GlassyGreenCheckBoxOuterBorderPressedBorderBrush}" />
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource GlassyGreenCheckBoxOuterBorderPressedBackground}" />
                            <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource GlassyGreenCheckBoxInnerBorderPressedBorderBrush}" />
                            <Setter TargetName="border3" Property="Background" Value="{StaticResource GlassyGreenCheckBoxInnerBorderPressedBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource GlassyGreenCheckBoxStyle}" TargetType="{x:Type CheckBox}" />


