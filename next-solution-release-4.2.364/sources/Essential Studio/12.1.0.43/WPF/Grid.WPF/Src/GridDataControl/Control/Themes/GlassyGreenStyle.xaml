                                                    <ColumnDefinition Width="Auto"
                                                                      MinWidth="24"
                                                                      SharedSizeGroup="MenuItemIconColumnGroup" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Margin="0"
                                                        Background="{StaticResource GlassyGreenSubMenuBackground}"
                                                        BorderBrush="{StaticResource GlassyGreenSubMenuBorderBrush}"
                                                        BorderThickness="0,0,1,0" />
                                                <ScrollViewer Grid.ColumnSpan="2"
                                                              CanContentScroll="true"
                                                              Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement},
                                                                                                            ResourceId=MenuScrollViewer}}">
                                                    <ItemsPresenter Margin="0,0,0,1"
