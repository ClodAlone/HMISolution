                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource BureauBlueCheckBoxOuterBorderMouseOverBorderBrush}" />
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource BureauBlueCheckBoxOuterBorderMouseOverBackground}" />
                            <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource BureauBlueCheckBoxInnerBorderMouseOverBorderBrush}" />
                            <Setter TargetName="border3" Property="Background" Value="{StaticResource BureauBlueCheckBoxInnerBorderMouseOverBackground}" />
