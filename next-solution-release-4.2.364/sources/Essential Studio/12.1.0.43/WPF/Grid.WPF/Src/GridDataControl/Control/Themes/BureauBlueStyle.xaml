                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource BureauBlueCheckBoxOuterBorderPressedBorderBrush}" />
                            <Setter TargetName="border1" Property="Background" Value="{StaticResource BureauBlueCheckBoxOuterBorderPressedBackground}" />
                            <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource BureauBlueCheckBoxInnerBorderPressedBorderBrush}" />
                            <Setter TargetName="border3" Property="Background" Value="{StaticResource BureauBlueCheckBoxInnerBorderPressedBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
