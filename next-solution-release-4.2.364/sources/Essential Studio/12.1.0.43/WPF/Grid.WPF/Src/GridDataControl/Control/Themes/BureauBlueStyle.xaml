                            <Setter TargetName="ellipse1" Property="Fill" Value="{StaticResource BureauBlueRadioButtonOuterBorderMouseOverBackground}" />
                            <Setter TargetName="ellipse1" Property="Stroke" Value="{StaticResource BureauBlueRadioButtonOuterBorderMouseOverBorderBrush}" />
