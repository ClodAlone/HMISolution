<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
>
    <local:TooltipConverter x:Key="tooltipText"/>
    <ControlTemplate
      x:Key="GridCellsControlTemplate"
      TargetType="{x:Type local:GridCellsControl}">
        <Border
        Name="PART_Border"
        BorderThickness="{TemplateBinding BorderThickness}"
        BorderBrush="{TemplateBinding BorderBrush}"
        Background="{TemplateBinding Background}"
            >
            <ScrollViewer
          Name="PART_ScrollViewer"
          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                >
                <local:GridControl  Name="PART_GridControl" />
            </ScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Setter Property="Background" Value="#FFF4F4F4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style
      x:Key="GridCellsControlBaseStyle"
      TargetType="{x:Type local:GridCellsControl}">
        <Setter Property="Template" Value="{StaticResource GridCellsControlTemplate}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="{x:Static ScrollBarVisibility.Auto}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="{x:Static ScrollBarVisibility.Auto}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </Style>

    <Style
      TargetType="{x:Type local:GridCellsControl}"
      BasedOn="{StaticResource GridCellsControlBaseStyle}">
    </Style>
    
    <LinearGradientBrush x:Key="LightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFF" Offset="0.0"/>
                <GradientStop Color="#EEE" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SolidBorderBrush" Color="#888" />
    <DataTemplate x:Key="tooltipTemplate">
        <Border 
                    Name="Border"
                    Background="{StaticResource LightBrush}"
                    BorderBrush="{StaticResource SolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    >
            <TextBlock Background="Transparent" Text="{Binding Path=CellValue}" Padding="2" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="customTooltipTemplate">
        <Border Name="Border"
                Background="{StaticResource LightBrush}"
                BorderBrush="{StaticResource SolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ContentControl Content="{Binding Path=ToolTip}" Padding="2" />
              <!--<TextBlock Background="Transparent" Text="{Binding Path=ToolTip, Converter={StaticResource tooltipText}}" Padding="2" />-->  
        </Border>
    </DataTemplate>

    <SolidColorBrush x:Key="validationBG" Color="#FFFFE1"/>
    <DataTemplate x:Key="datavalidationtooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource validationBG}"
            BorderBrush="{StaticResource SolidBorderBrush}"
            BorderThickness="1"
            >
            <TextBlock Text="{Binding Path=DataValidationTooltip}" Padding="2" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="commentTemplate">
        <Border 
                    Name="Border"
                    Background="{StaticResource LightBrush}"
                    BorderBrush="{StaticResource SolidBorderBrush}"
                    BorderThickness="2"
                    >
            <TextBlock Background="LightGoldenrodYellow" Text="{Binding Path=Comment}" Padding="2" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="errorTemplate">
        <Border 
                    Name="Border"
                    Background="{Binding Path=ErrorInfo.ErrorTooltipBackgroundBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    >
            <TextBlock Background="Transparent" Text="{Binding Path=ErrorInfo.ErrorMessage}" Foreground="{Binding Path=ErrorInfo.ErrorTooltipForegroundBrush}" Padding="2" />
        </Border>
    </DataTemplate>
    
