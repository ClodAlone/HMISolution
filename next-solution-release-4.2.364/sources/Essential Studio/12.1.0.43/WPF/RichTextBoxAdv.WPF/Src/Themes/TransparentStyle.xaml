<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:rich="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="http://schemas.syncfusion.com/wpf">

    <ContextMenu x:Key="ContextMenuStyle">
        <ContextMenu.Resources>
            <Style TargetType="{x:Type Image}">
                <Setter Property="Height" Value="16"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Margin" Value="0 0 6 0"/>
            </Style>
        </ContextMenu.Resources>
        <MenuItem Header="Cut" Command="rich:RichTextBoxAdv.Cut">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Cut16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Copy" Command="rich:RichTextBoxAdv.Copy">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Copy16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Paste" Command="rich:RichTextBoxAdv.Paste">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Paste16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Insert" Visibility="Collapsed">
            <MenuItem.Items>
                <MenuItem Header="Insert Column to the Left" Command="rich:RichTextBoxAdv.InsertColumn" CommandParameter="Left">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/InsertColumnLeft.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Insert Column to the Right" Command="rich:RichTextBoxAdv.InsertColumn" CommandParameter="Right">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/InsertColumnRight.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Insert Row Above" Command="rich:RichTextBoxAdv.InsertRow" CommandParameter="Above" >
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/InsertRowAbove.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Insert Row Below" Command="rich:RichTextBoxAdv.InsertRow" CommandParameter="Below">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/InsertRowBelow.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem.Items>
        </MenuItem>
        <MenuItem Header="Delete" Visibility="Collapsed">
            <MenuItem.Items>
                <MenuItem Header="Delete Row" Command="rich:RichTextBoxAdv.DeleteRow">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/DeleteRow.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete Column" Command="rich:RichTextBoxAdv.DeleteColumn">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/DeleteColumn.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete Table" Command="rich:RichTextBoxAdv.DeleteTable">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/DeleteTable.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem.Items>
        </MenuItem>
        <MenuItem Header="Select" Visibility="Collapsed">
            <MenuItem.Items>
                <MenuItem Header="Select Cell" Command="rich:RichTextBoxAdv.SelectCell">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/SelectCell.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Select Row" Command="rich:RichTextBoxAdv.SelectRow">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/SelectRow.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Select Column" Command="rich:RichTextBoxAdv.SelectColumn">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/SelectColumn.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Select Table" Command="rich:RichTextBoxAdv.SelectTable">
                    <MenuItem.Icon>
                        <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/SelectTable.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem.Items>
        </MenuItem>
        <MenuItem Header="Merge Cells" Visibility="Collapsed" Command="rich:RichTextBoxAdv.MergeSelectedCells">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/MergeCells.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <Separator Visibility="Collapsed"/>
        <MenuItem Header="Insert Table" Command="rich:RichTextBoxAdv.InsertTableDialog">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Table16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Font..." Command="rich:RichTextBoxAdv.FontDialog">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Fonts16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Paragraph..." Command="rich:RichTextBoxAdv.ParagraphDialog">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Paragraphdialog.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Bullets" Command="rich:RichTextBoxAdv.ListType" CommandParameter="Bulleted">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Bullets16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Numbering" Command="rich:RichTextBoxAdv.ListType" CommandParameter="Numbered">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Numbering16.png"/>
            </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Hyperlink" Command="rich:RichTextBoxAdv.HyperlinkDialog">
            <MenuItem.Icon>
                <Image Source="/Syncfusion.RichTextBoxAdv.WPF;component/Images/Hyperlink16.png"/>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <!--RichTextBoxAdv Template-->
    <Style TargetType="rich:RichTextBoxAdv">
        <Setter Property="Background" Value="White"/>
        <Setter Property="ContextMenu" Value="{StaticResource ContextMenuStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:RichTextBoxAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.Column="0" />
                            <ScrollBar x:Name="HorizontalScrollBar" Grid.Column="0" Height="16" Visibility="Collapsed" IsTabStop="False" Minimum="0" Orientation="Horizontal" Grid.Row="1"/>
                            <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" IsTabStop="False" Visibility="Visible" Minimum="0" Orientation="Vertical" Grid.Row="0" Width="16"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageLayoutViewer">
        <Setter Property="Background" Value="#80FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageLayoutViewer">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:CaretAdv">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:CaretAdv">
                    <Rectangle x:Name="rectangle" Fill="{TemplateBinding Background}" Width="100"></Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageAdv">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="IBeam"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageAdv">
                    <Grid>
                        <Border x:Name="PART_shadowEfffect" CornerRadius="0" Background="Black" Opacity="0.6" BorderThickness="0">
                            <Border.Effect>
                                <BlurEffect Radius="15"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Background="{TemplateBinding Background}" 
                                x:Name="PART_border" CornerRadius="0" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>