<Window x:Class="Syncfusion.Windows.Tools.Controls.HyperlinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="hyperlinkDialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Icon="{x:Null}"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls"
    Title="Insert Hyperlink" Width="320" FontSize="12" ResizeMode="NoResize" Height="130"
    WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <syncfusion:StringToBooleanMultiConverter x:Key="String2Boolean"/>
    </Window.Resources>

    <Grid Background="#FFF0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="_Text to Display:" Margin="5" Padding="0" VerticalAlignment="Center" Target="{Binding ElementName=text}"/>
        <TextBox Grid.Column="1" Margin="5" VerticalAlignment="Center" x:Name="txthyperText"/>
        <Label Content="Addr_ess:" Grid.Row="1" Margin="5" Padding="0" VerticalAlignment="Center" Target="{Binding ElementName=address}"/>
        <TextBox Margin="5" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" x:Name="txtAddress"/>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="OK" Margin="3" Padding="1" Click="btnAccept_Click" Width="74" Height="23" IsDefault="True">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource String2Boolean}">
                        <Binding Path="Text" ElementName="txthyperText"/>
                        <Binding Path="Text" ElementName="txtAddress"/>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
            <Button Content="Cancel" Margin="3" Padding="1" Width="74" Height="23" Click="Button_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
