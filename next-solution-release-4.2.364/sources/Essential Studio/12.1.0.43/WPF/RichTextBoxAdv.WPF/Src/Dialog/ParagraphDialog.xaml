<Window  x:Class="Syncfusion.Windows.Tools.Controls.ParagraphDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="paragraphDialog"
     xmlns:System="clr-namespace:System;assembly=mscorlib" Icon="{x:Null}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Paragraph" SizeToContent="WidthAndHeight" xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <Grid Background="#FFF0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="General" Margin="5" Padding="0" VerticalAlignment="Center"/>
        <Border Height="2" BorderThickness="0,0,0,1" Width="215" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="2 2 6 0" VerticalAlignment="Center" Background="#FFBFC8DA" BorderBrush="White"/>

        <Label Content="Ali_gnment:" Grid.Row="1" Margin="14,5,5,5"  Padding="0" Target="{Binding ElementName=cmbalignment}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" Grid.Row="1" Margin="5" Padding="4 2 2 2" x:Name="cmbalignment" Height="22" Background="White">
            <ComboBoxItem>Left</ComboBoxItem>
            <ComboBoxItem>Right</ComboBoxItem>
            <ComboBoxItem>Centered</ComboBoxItem>
            <ComboBoxItem>Justified</ComboBoxItem>
        </ComboBox>
        <Label Content="Indentation" Margin="5" Padding="0" Grid.Row="2" VerticalAlignment="Center"/>
        <Border Height="2" BorderThickness="0,0,0,1" Grid.Row="2" Width="194" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="2,5,6,0" VerticalAlignment="Center" Background="#FFBFC8DA" BorderBrush="White"/>

        <Label Content="_Left:" Grid.Row="3" Margin="15,5,5,5"  Padding="0" Target="{Binding ElementName=leftIndention}" VerticalAlignment="Center"/>
        <syncfusion:UpDown Grid.Column="1" Grid.Row="3" Margin="5" x:Name="leftIndention"  Height="22"
                           TextAlignment="Left" ZeroColor="Black" NumberDecimalDigits="1" Step="0.1"  MinValue="0" MaxValue="53"/>

        <Label Content="_Right:" Grid.Row="4" Margin="15,5,5,5"  Padding="0" Target="{Binding ElementName=rightIndention}" VerticalAlignment="Center"/>
        <syncfusion:UpDown Grid.Column="1" Grid.Row="4" Margin="5" x:Name="rightIndention" Step="0.1"  Height="22"
                           TextAlignment="Left" ZeroColor="Black" NumberDecimalDigits="1"  MinValue="0" MaxValue="53"/>

        <Label Content="Spacing" Margin="5" Padding="0" Grid.Row="5" VerticalAlignment="Center"/>
        <Border Height="2" BorderThickness="0,0,0,1" Grid.Row="5" Width="214" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="2,5,6,0" VerticalAlignment="Center" Background="#FFBFC8DA" BorderBrush="White"/>

        <Label Content="Be_fore (pt):" Grid.Row="6" Margin="15,5,5,5"  Padding="0" Target="{Binding ElementName=beforeSpacing}" VerticalAlignment="Center"/>
        <syncfusion:UpDown Grid.Column="1" Grid.Row="6" Margin="5" x:Name="beforeSpacing"  Height="22"
                           TextAlignment="Left" ZeroColor="Black" NumberDecimalDigits="0" Step="6" MinValue="0" MaxValue="53"/>

        <Label Content="_After (pt):" Grid.Row="7" Margin="15,5,5,5"  Padding="0" Target="{Binding ElementName=afterSpacing}" VerticalAlignment="Center"/>
        <syncfusion:UpDown Grid.Column="1" Grid.Row="7" Margin="5" x:Name="afterSpacing"  Height="22" Value="6"
                           TextAlignment="Left" ZeroColor="Black" NumberDecimalDigits="0" Step="6"  MinValue="0" MaxValue="53"/>


        <Label Content="Multiple spacing _at:" Grid.Row="8" Margin="15,5,5,5"  Padding="0" Target="{Binding ElementName=linespacing}" VerticalAlignment="Center"/>
        <syncfusion:UpDown Grid.Column="1" Grid.Row="8" Margin="5" x:Name="linespacing"  Height="22" Value="3"
                           TextAlignment="Left" ZeroColor="Black" NumberDecimalDigits="2" Step="0.5" MinValue="0" MaxValue="53"/>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Grid.Row="9" Grid.Column="1">
            <Button Content="OK" Margin="3" Padding="1" Width="74" Click="btnAccept_Click" Height="23" IsDefault="True"/>
            <Button Content="Cancel" Margin="3" Padding="1" Width="74" Click="Button_Click" Height="23" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
