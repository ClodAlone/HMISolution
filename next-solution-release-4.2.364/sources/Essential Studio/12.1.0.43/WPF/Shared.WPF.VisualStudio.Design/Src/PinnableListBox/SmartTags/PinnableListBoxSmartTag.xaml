<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.PinnableListBoxSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="PinnableListBox Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Grid.ColumnSpan="2">

            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">


                <TextBlock FontWeight="Bold">Essential Tools - PinnableListBox</TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Actions</TextBlock>
                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:PinnableListBoxItem}" Click="AddChildControls">Add New PinnableListBoxItem</Hyperlink>
                </TextBlock>


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>


                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>


            </StackPanel>


            <StackPanel  Margin="7" Name="Panel2">

                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

                    <TextBlock Text="Header" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="HeaderTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                 </Grid>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>
            
            </StackPanel>
        
        </StackPanel>
    
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>

