<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.TimeSpanEditSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="TimeSpanEdit Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="4" Name="panel1" Orientation="Vertical">
                <TextBlock FontWeight="Bold">Essential Tools - TimeSpanEdit</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel  Margin="7" Name="Panel2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0"/>
                    <TextBox Name="NameTextBox"   Width="115" Grid.Row="1" Grid.Column="1" Margin="14,7,112,0"/>
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" Grid.Column="0">
                                AllowNull
                    </TextBlock>
                    <CheckBox Name="AllowNull" Grid.Row="2" Grid.Column="1" Margin="15,8,0,0"/>
                    <TextBlock Text="Format"  VerticalAlignment="Center"  Grid.Row="3" Grid.Column="0"/>
                    <TextBox Name="Format"   Width="115" Grid.Row="3" Grid.Column="1" Margin="14,7,112,0"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0">
                                IncrementOnScrolling
                    </TextBlock>
                    <CheckBox Name="IncrementOnScrolling" Grid.Row="4" Grid.Column="1" Margin="15,8,0,0"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0">
                               ShowArrowButtons
                    </TextBlock>
                    <CheckBox Name="ShowArrowButtons" Grid.Row="6" Grid.Column="1" Margin="15,8,0,0"/>
                </Grid>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
    