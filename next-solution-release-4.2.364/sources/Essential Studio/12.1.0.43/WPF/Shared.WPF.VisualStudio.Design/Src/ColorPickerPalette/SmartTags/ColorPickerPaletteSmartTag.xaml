<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.ColorPickerPaletteSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="ColorPickerPalette Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">

            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">


                <TextBlock FontWeight="Bold">Essential Tools - ColorPickerPalette</TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="7,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>

                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>



            </StackPanel>


            <StackPanel  Margin="7" Name="Panel2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

                    <TextBlock Text="CustomHeaderText" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="CustomHeaderText"  Margin="7,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="AutomaticColorVisibility" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" />
                    <ComboBox Name="AutomaticColorVisibility" Margin="7,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="BlackWhiteVisibility" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="BlackWhiteVisibility" Margin="7,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="ThemePanelVisibility" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="ThemePanelVisibility" Margin="7,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="CustomHeaderVisibility" Grid.Row="5" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="CustomHeaderVisibility" Margin="7,7,0,0" Width="115" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="MoreColorOptionVisibility" Grid.Row="6" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="MoreColorOptionVisibility" Margin="7,7,0,0" Width="115" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="IsCustomTabVisible" Grid.Row="7" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="IsCustomTabVisible" Margin="7,7,0,0" Width="115" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="IsStandardTabVisible" Grid.Row="8" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="IsStandardTabVisible" Margin="7,7,0,0" Width="115" Grid.Row="8" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="StandardPanelVisibility" Grid.Row="9" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="StandardPanelVisibility" Margin="7,7,0,0" Width="115" Grid.Row="9" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="RecentlyUsedPanelVisibility" Grid.Row="10" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="RecentlyUsedPanelVisibility" Margin="7,7,0,0" Width="115" Grid.Row="10" Grid.Column="1"/>


                    <!--<StackPanel Grid.Row="10"   Margin="0,7,0,0">
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">-->
                    <CheckBox Name="IsExpanded" Grid.Row="11" Grid.Column="1" Margin="7,8,0,0"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" Grid.Row="11" Grid.Column="0">
                                IsExpanded
                    </TextBlock>
                    <!--</StackPanel>-->

                    <TextBlock Text="PopupHeight" VerticalAlignment="Center"  Grid.Row="12" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="PopupHeight"  Margin="7,7,0,0" Width="115" Grid.Row="12" Grid.Column="1"/>

                    <TextBlock Text="PopupWidth" VerticalAlignment="Center"  Grid.Row="13" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="PopupWidth"  Margin="7,7,0,0" Width="115" Grid.Row="13" Grid.Column="1"/>

                    <!--</StackPanel>-->

                </Grid>

            </StackPanel>



        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>