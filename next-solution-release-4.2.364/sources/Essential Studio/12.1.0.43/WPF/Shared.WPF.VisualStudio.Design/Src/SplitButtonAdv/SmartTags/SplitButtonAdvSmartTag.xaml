<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.SplitButtonAdvSmartTag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
      syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    
<syncfusion:SmartTagPresenter Title="SplitButtonAdv Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">

                <TextBlock FontWeight="Bold">Essential Tools - SplitButtonAdv</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>
                    

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>
                    
                    <TextBlock Text="Label" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0"/> 
                    <TextBox Name="LabelTextBox" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>
                </Grid>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel  Margin="7" Name="Panel2" >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="Bold" Grid.Row="0" Margin="0,7,0,0">Appearance</TextBlock>

                    <TextBlock Margin="0,7,0,0"  VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Text="IsMultiline"/>
                    <CheckBox Name="IsMultiline" Margin="0,7,0,0" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"  />

                    <TextBlock VerticalAlignment="Center" Text="SizeMode" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" />
                    <ComboBox Name="SizeMode" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1" />
                    
                    <Border BorderBrush="Black"  Grid.Row="5" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
                    
                    <TextBlock FontWeight="Bold" Grid.Row="6" Margin="0,7,0,0">Behavior</TextBlock>

                </Grid>
            </StackPanel>
            <StackPanel Margin="7" Name="panel3" Orientation="Vertical" >

                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>


                    <TextBlock VerticalAlignment="Center" Text="DropDirection" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0" />
                    <ComboBox Name="DropDownDirection" Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1" />
                </Grid>
                    </StackPanel>              
                



        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>




