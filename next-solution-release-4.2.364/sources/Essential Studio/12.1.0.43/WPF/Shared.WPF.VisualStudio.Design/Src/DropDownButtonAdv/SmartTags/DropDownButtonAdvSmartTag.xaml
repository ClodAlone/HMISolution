<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.DropDownButtonAdvSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="DropDownButtonAdv Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">
                <TextBlock FontWeight="Bold">Essential Tools - DropDownButtonAdv</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                   <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="Label" VerticalAlignment="Center"  Grid.Row="2" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="LabelTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>
                </Grid>
            </StackPanel>
            <StackPanel  Margin="7" Name="Panel2">
                <Border BorderBrush="Black"  Grid.Row="5" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>


                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Appearance" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0" FontWeight="Bold"/>

                    <TextBlock VerticalAlignment="Center" Text="SizeMode" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="SizeModeCombo" Margin="0,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>
                </Grid>


            </StackPanel>
            <StackPanel>
                <Border BorderBrush="Black"  Grid.Row="5" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Behaviour" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0" FontWeight="Bold"/>
                    <CheckBox Name="IsMultiLine" Grid.Row="5" Grid.Column="1" Margin="0,8,0,6"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0">
                                IsMultiLine
                    </TextBlock>

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,7,0,0">DropDirection</TextBlock>
                    <ComboBox FontWeight="Bold" Name="DropDirection" Width="115" Grid.Row="6" Grid.Column="1"></ComboBox>
                </Grid>
                <Border BorderBrush="Black"  Grid.Row="5" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,8,0,8"/>

            </StackPanel>
        </StackPanel>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>