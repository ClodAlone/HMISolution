<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.ToolBarAdvSmartTag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="ToolBarAdv Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">
                <TextBlock FontWeight="Bold">Essential Tools - ToolBarAdv</TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>
            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                   
                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="25,7,0,0" Grid.Row="1" Grid.Column="1"/>
                       
                    <Border BorderBrush="Black"  Grid.Row="2" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
                </Grid>
            </StackPanel>
            <StackPanel Margin="7" Name="panel2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>


                    
                    <TextBlock Margin="0,7,0,0"  VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Text="EnableAddRemoveButton"/>
                    <CheckBox Name="EnableAddRemoveButton" Margin="10,7,0,0" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"  />
                   
                    
                    <TextBlock Text="IsOverflowOpen" VerticalAlignment="Center" Grid.Column="0" Margin="0,7,0,0" Grid.Row="2"/>
                    <CheckBox Name="IsOverflowOpen" Margin="10,7,0,0" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1"/>
                    
                    <Border BorderBrush="Black"  Grid.Row="3" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                </Grid>
            </StackPanel>

        </StackPanel>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
