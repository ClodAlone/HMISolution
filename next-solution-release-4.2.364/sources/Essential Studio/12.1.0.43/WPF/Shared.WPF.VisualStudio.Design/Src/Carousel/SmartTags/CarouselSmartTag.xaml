<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.CarouselSmartTag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                        Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Carousel Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">

                <TextBlock FontWeight="Bold">Essential Tools - Carousel</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="14,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>
                </Grid>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel Margin="7">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/> 
                        <RowDefinition/>
                        <RowDefinition/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

                    <TextBlock Text="ItemsperPage" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="ItemsTextBox"  Margin="14,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="VisualMode" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" />
                    <ComboBox Name="VisualMode" Margin="14,7,0,0" Width="115" Grid.Row="2" Grid.Column="1" />
                   
                    <TextBlock Text="OpacityFraction" VerticalAlignment="Center"  Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="OpacityFraction"  Margin="14,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>
                    
                    <TextBlock Text="RadiusX" VerticalAlignment="Center"  Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="RadiusXTextBox"  Margin="14,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>
                    
                    <TextBlock Text="RadiusY" VerticalAlignment="Center"  Grid.Row="5" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="RadiusYTextBox"  Margin="14,7,0,0" Width="115" Grid.Row="5" Grid.Column="1"/>
                    
                    <TextBlock Text="RotationAngle" VerticalAlignment="Center"  Grid.Row="6" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="RotationAngleTextBox"  Margin="14,7,0,0" Width="115" Grid.Row="6" Grid.Column="1"/>
                    
                    <TextBlock Text="RotationSpeed" VerticalAlignment="Center"  Grid.Row="7" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="RotationSpeedTextBox"  Margin="14,7,0,0" Width="115" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock Margin="0,7,0,0" Grid.Row="8"  Grid.Column="0" Text="OpacityEnabled" />
                  <CheckBox Name="OpacityEnabled" Margin="14,7,0,0" VerticalAlignment="Center"  Grid.Row="8" Grid.Column="1"/>
                    
                    <TextBlock Margin="0,7,0,0" Grid.Row="9"  VerticalAlignment="Center" Grid.Column="0" Text="ScalingEnabled" />
                  <CheckBox Name="ScalingEnabled"  Grid.Column="1" Margin="14,7,0,0" VerticalAlignment="Center" Grid.Row="9"/>
                   


                    <TextBlock Margin="0,7,0,0" Grid.Row="10"  Grid.Column="0" Text=" SkewAngleXEnabled"/>
                    <CheckBox Name="SkewAngleXEnabled"  Margin="14,7,0,0" VerticalAlignment="Center" Grid.Row="10" Grid.Column="1"/>
                    
                    <TextBlock Margin="0,7,0,0" Grid.Row="11"   Grid.Column="0" Text=" SkewAngleYEnabled"/>
                    <CheckBox Name="SkewAngleYEnabled" Margin="14,7,0,0" VerticalAlignment="Center" Grid.Row="11" Grid.Column="1"/>
                    
                </Grid>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Behavior</TextBlock>

                
            </StackPanel>
            <StackPanel Margin="7" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        
                    </Grid.ColumnDefinitions>

                    <TextBlock Margin="0,7,0,0"  VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Text="EnableTouch"/>
                    <CheckBox Name="EnableTouch" Margin="10,7,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"  />
                    
                </Grid>
            </StackPanel>
        </StackPanel>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
