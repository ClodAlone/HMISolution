<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.ClockSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     Height="24" Width="24" x:Name="one" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="Clock Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - Clock</TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="0.5"  Margin="7,7,7,0"/>
			<StackPanel Margin="7">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock Text="Name" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
					<TextBox Name="NameTextBox" HorizontalAlignment="Right" Margin="3" Width="115" Grid.Row="0" Grid.Column="1"/>
					<Border BorderBrush="Black"  Grid.Row="1" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
				</Grid>
			</StackPanel>
			<StackPanel Margin="7">

                <Grid>
                    <Grid.RowDefinitions>

                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />



                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>



                    <TextBlock VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Text="Clock Corner Radius" />
                    <syncfusion:MaskedTextBox Grid.Row="1" Grid.Column="1" Name="ClockCornerRadiusTextBox"  
                                              Mask="00,00,00,00"
                                              TextMaskFormat="IncludeLiterals"
                                              Margin="3" Width="115" />


                    <TextBlock VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Text="Frame Corner Radius" />
                    <syncfusion:MaskedTextBox Grid.Row="2" Grid.Column="1" Name="FrameCornerRadiusTextBox"  
                                             Mask="00,00,00,00"
                                             TextMaskFormat="IncludeLiterals"
                                             Margin="3" Width="115" />

                    <TextBlock VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Text="AMPM Selector Corner Radius" />
                    <syncfusion:MaskedTextBox Grid.Row="3" Grid.Column="1" 
                                              Mask="00,00,00,00"
                                              TextMaskFormat="IncludeLiterals"
                                              Name="AMPMSElectorTextBox"  Margin="3" Width="115" />


                    <Border BorderBrush="Black"  Grid.Row="4" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                    <TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="5">Behavior</TextBlock>

                    <TextBlock VerticalAlignment="Center" Text="AMPM Selector Position" Grid.Row="6" Grid.Column="0"/>
                    <ComboBox Name="AMPMSelector" Margin="3,3,3,3" Width="115" Grid.Row="6" Grid.Column="1"/>

                    <StackPanel Grid.Row="7"  Margin="7">
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsDigitalAMPMVisible"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                 Enable Digital AMPM
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsInsideAMPMVisible"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                 Enable Inside AMPM
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>


                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>