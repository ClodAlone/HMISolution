<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.PercentTextBoxSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="PercentTextBox Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" >
            <StackPanel Margin="7" Orientation="Vertical" >
                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Essential Tools - PercentTextBox</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,7,0,0" HorizontalAlignment="Left" />

                    <Border BorderBrush="Black" BorderThickness="0.4" Margin="0,7,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                    <TextBlock Text="Min Value" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <syncfusion:IntegerTextBox x:Name="MinValue" Grid.Row="4" MinValue="0" MaxValue="99"  Grid.Column="1" Margin="5,7,0,0" Text="3"  HorizontalAlignment="Stretch" />

                    <TextBlock Text="Max Value" Grid.Row="5" Grid.Column="0" Margin="0,7,0,0"/>
                    <syncfusion:IntegerTextBox x:Name="MaxValue" Grid.Row="5" MinValue="0" MaxValue="99"  Grid.Column="1" Margin="5,7,0,0" Text="3"  HorizontalAlignment="Stretch" />

                    <TextBlock Text="Scroll Interval" Grid.Row="6" Grid.Column="0" Margin="0,7,0,0"/>
                    <syncfusion:IntegerTextBox x:Name="ScrollInterval" Grid.Row="6" MinValue="0" MaxValue="99"  Grid.Column="1" Margin="5,7,0,0" Text="3"  HorizontalAlignment="Stretch" />

                    <TextBlock Text="Percent Decimal Digits" Grid.Row="7" Grid.Column="0" Margin="0,7,0,0"/>
                    <syncfusion:IntegerTextBox x:Name="txtPercentDecimalDigits" Grid.Row="7" MinValue="0" MaxValue="99"  Grid.Column="1" Margin="5,7,0,0" Text="3"  HorizontalAlignment="Stretch" />


                    <TextBlock Text="Percent Decimal Separator" Grid.Row="8" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox x:Name="txtPercentDecimalSeperator" 
                         MaxLength="1"
                         Grid.Row="8" Grid.Column="1" Margin="5,7,0,0" Text="."  HorizontalAlignment="Stretch" />

                    <TextBlock Text="Percent Group Separator" Grid.Row="9" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox x:Name="txtPercentGroupSeperator" 
                         MaxLength="1"
                         Grid.Row="9" Grid.Column="1" Margin="5,7,0,0" Text=","  HorizontalAlignment="Stretch" />

                    <TextBlock Text="Percenter Edit Mode" Grid.Row="10" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="comboPercenterEditMode" Grid.Row="10" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Stretch" />

                    <TextBlock Text="Percentage symbol" Grid.Row="11" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="percentagesymbol" Grid.Row="11" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Stretch" />

                </Grid>
            </StackPanel>

            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="0.4" Margin="0,7,0,0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />
                    <TextBlock FontWeight="Bold" Grid.Row="1"  Grid.ColumnSpan="2" Margin="0,7,0,0">Behavior</TextBlock>
                    <TextBlock Text="EnterToMoveNext" Margin="0,7,0,0" Grid.Row="2" Grid.Column="0"/>
                    <CheckBox Name="EnterToMoveNext" Grid.Row="2" Grid.Column="1" Margin="15,7,0,0" />
                    <TextBlock Text="ValidationOnLostFocus" Margin="0,7,0,0" Grid.Row="3" Grid.Column="0"/>
                    <CheckBox Name="ValidationOnLostFocus" Grid.Row="3" Grid.Column="1" Margin="15,7,0,0"/>

                   </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>