<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.IntegerTextBoxSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                    Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="IntegerTextBox Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Tools - IntegerTextBox</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
<RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="25" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
               
                <TextBlock Text="Number Group Separator" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtNumberGroupSeperator" Grid.Row="4" 
                         MaxLength="1"
                         Grid.Column="1" Margin="5,5,0,0" Text="," Width="130" Height="25" HorizontalAlignment="Stretch" />



                <TextBlock Text="Horizontal Content Alignment" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboHorizontalContentAlignment" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />
                <TextBlock FontWeight="Bold" Margin="5,5,0,0" Grid.Row="6">Behavior</TextBlock>
                <TextBlock  Margin="5,5,0,0" Text="Enter To Move Next" Grid.Row="7" Grid.Column="0"/>
                <CheckBox Name="checkBoxEnterToMoveNext"  Margin="5,5,0,0" Grid.Row="7"  Grid.Column="1" Height="20" />

                <TextBlock  Margin="5,5,0,0" Text="GroupSeperatorEnabled" Grid.Row="8" Grid.Column="0"/>
                <CheckBox Name="chkGroupSeperatorEnabled" Margin="5,5,0,0"  Grid.Row="8" Grid.Column="1"/>

               
            </Grid>

        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>