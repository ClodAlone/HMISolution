<Window x:Class="Syncfusion.Grid.WPF.VisualStudio.Design.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Syncfusion.Grid.WPF.VisualStudio.Design" ResizeMode="NoResize"
        xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
        Title="GridDataControl Designer" Height="450" Width="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="WhistlerBlue.xaml"/>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFE9EDF1" Offset="0.015"/>
            <GradientStop Color="#FFD1D6DC" Offset="0.937"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFE9EDF1" Offset="0.015"/>
                <GradientStop Color="#FFD1D6DC" Offset="0.937"/>
            </LinearGradientBrush>
        </Grid.Background>
        <local:ViewDesign x:Name="View" >
        </local:ViewDesign>
    </Grid>
</Window>
