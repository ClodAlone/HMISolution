                                            <LinearGradientBrush StartPoint="0.599,-0.293" EndPoint="1.014,1.206">
                                                <GradientStop Offset="0" Color="Black" />
                                                <GradientStop Offset="1" />
                                                <GradientStop Color="#FFC3C3C3" />
                                            </LinearGradientBrush>
                                        </Path.OpacityMask>
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="-0.119,0.828" EndPoint="1.048,0.189">
