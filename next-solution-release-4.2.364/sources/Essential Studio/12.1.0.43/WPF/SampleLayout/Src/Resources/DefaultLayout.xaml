                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>

                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Grid.Row="0"
                                                   Margin="8,5,0,0"
                                                   HorizontalAlignment="Left"
                                                   FontFamily="Segoe WP Light"
                                                   FontSize="29.333"
                                                   Foreground="White"
                                                   Text="{TemplateBinding HeaderText}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="8,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   FontFamily="Segoe WP Light"
                                                   FontStyle="Italic"
                                                   Foreground="White"
                                                   Text="{TemplateBinding HeaderDescriptionText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                Visibility="{TemplateBinding SkinPickerVisibility}">
                                        <ComboBox x:Name="SkinChooser"
                                                  Width="100"
                                                  Height="25"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Top"
                                                  VerticalContentAlignment="Center"
                                                  Background="White"
                                                  BorderBrush="#FFD9E9FF"
                                                  BorderThickness="1"
                                                  Foreground="#FF8A8A8A"
                                                  SelectedValue="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                          Path=VisualStyle,
                                                                          Mode=OneWayToSource}" />
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <!--  GridView and UserOptions  -->
                            <Grid Grid.Row="{TemplateBinding HeaderRowCount}" Grid.RowSpan="{TemplateBinding HeaderRowSpan}">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0.001" Color="#FF8BB3DD" />
                                        <GradientStop Offset="0.006" Color="#FFA3C2E3" />
                                        <GradientStop Offset="0.048" Color="#FFE7F1FD" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75*" />
                                    <ColumnDefinition Width="25*" />
                                </Grid.ColumnDefinitions>

                                <!--  Grid View Implementation  -->
                                <Grid Grid.Column="0" Grid.ColumnSpan="{TemplateBinding ColSpan}">

                                    <Border Grid.Row="0"
                                            Margin="10,20,10,10"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            BorderBrush="#FF16538C"
                                            BorderThickness="2"
                                            CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FF9D9393" />
                                                <GradientStop Offset="1" Color="#FFB6B1B1" />
                                                <GradientStop Offset="0.02" Color="#FFFBFBFB" />
                                                <GradientStop Offset="0.984" Color="White" />
                                            </LinearGradientBrush>
                                        </Border.Background>

                                        <Grid Grid.Row="0" Grid.RowSpan="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Margin="5,-15,5,0"
                                                    Background="{TemplateBinding GridViewBackground}"
                                                    BorderBrush="#FFB7C4D6"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <TextBlock Margin="4"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Trebuchet MS"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Text="{TemplateBinding GridViewHeaderText}" />
                                            </Border>
                                            <Grid Grid.Row="1" Margin="3">
                                                <ContentControl Margin="0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Content="{TemplateBinding GridView}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!--  User Options Implementation  -->
                                <Grid Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="{TemplateBinding UserOptionsVisibility}">
                                    <ItemsControl HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ItemsSource="{TemplateBinding UserOptionsView}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:UserOptions}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HeaderBackground" Value="{StaticResource GridViewBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UserOptions}">
                    <Border Grid.Row="1"
                            Margin="5,20,5,5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderBrush="#FF16538C"
                            BorderThickness="2"
                            CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FF9D9393" />
                                <GradientStop Offset="1" Color="#FFB6B1B1" />
                                <GradientStop Offset="0.02" Color="#FFFBFBFB" />
                                <GradientStop Offset="0.984" Color="White" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid Grid.Row="0" Grid.RowSpan="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="5,-15,5,0"
                                    Background="{TemplateBinding HeaderBackground}"
                                    BorderBrush="#FFB7C4D6"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Margin="4"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontFamily="Trebuchet MS"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{TemplateBinding HeaderText}" />
                            </Border>
                            <Grid Grid.Row="1" Margin="2,2,0,5">
                                <ContentPresenter Margin="5"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
