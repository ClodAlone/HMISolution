<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap">

    <SolidColorBrush x:Key="Office2007Black.ExpanderBorderBrush" Color="#FF040404"/>
    <SolidColorBrush x:Key="Office2007Black.ExpanderSignBrush" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="Office2007Black.ExpanderBackgroundBrush"
                         EndPoint="0,1" 
                         StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#FF777777"/>
            <GradientStop Offset="0.1" Color="#FF777777"/>
            <GradientStop Offset="0.15" Color="#FF666666"/>
            <GradientStop Offset="0.4" Color="#FF666666"/>
            <GradientStop Offset="0.45" Color="#FF5F5F5F"/>
            <GradientStop Offset="0.5" Color="#FF555555"/>
            <GradientStop Offset="0.55" Color="#FF1C1C1C"/>
            <GradientStop Offset="0.7" Color="#FF1C1C1C"/>
            <GradientStop Offset="0.75" Color="#FF222222"/>
            <GradientStop Offset="0.8" Color="#FF222222"/>
            <GradientStop Offset="0.85" Color="#FF292929"/>
            <GradientStop Offset="1" Color="#FF393939"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Pen Brush="#B1B1B1" x:Key="Office2007Black.AxisPen" Thickness="0.2"/>
    
    <!--Expander Style-->


    <SolidColorBrush x:Key="TreeViewFill.Black" Color="#FF898989"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Black"  StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFB5B5B5"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Black" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>
    <LinearGradientBrush x:Key="Office2007BlackGridBackground" EndPoint="0.5,-0.04" StartPoint="0.5,0.051">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="#FFC4C4C4" Offset="0.683"/>
        <GradientStop Color="#FFE0E0E0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush  x:Key="Office2007Black.ChartBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCECFD1" Offset="0"/>
        <GradientStop Color="#FF898C8F" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#FF959697" x:Key="Office2007Black.BorderBackground"/>

    <SolidColorBrush Color="Transparent" x:Key="Office2007Black.LegendBackground"/>
    <SolidColorBrush x:Key="Office2007Black.LegendForeground"
                   Color="Black"/>
    <SolidColorBrush x:Key="Office2007Black.LegendBorderBackground"
                   Color="#FF5F5F5F"/>
    <CornerRadius x:Key="Office2007Black.LegendCornerRadius" 
                TopLeft="6" BottomLeft="6" BottomRight="6" TopRight="6"/>

    <Style x:Key="Office2007Black.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Black}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Black}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Black}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonHoverBackgroundBrush1}"
                                    TargetName="border"/>
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ButtonHoverBorderBrush1}"
                                    TargetName="border"/>
                            <Setter Property="Fill" TargetName="ExpandPath" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="Office2007BlackChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Black.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007Black.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Office2007Black.LegendCornerRadius}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <Style x:Key="Office2007BlackOlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Black.AxisPen}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2007Black.ExpanderStyle}"/>
        <Setter Property="GridBackground" Value="{StaticResource Office2007BlackGridBackground}"/>
        <Setter Property="LabelForeground" Value="{StaticResource Office2007Black.LegendForeground}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" x:Key="Office2007BlackChartStyle">
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Black.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="LegendStyle" Value="{StaticResource Office2007BlackChartLegendStyle}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" BasedOn="{StaticResource Office2007BlackChartStyle}"/>
    <Style TargetType="{x:Type local:OlapChart}" BasedOn="{StaticResource Office2007BlackOlapChartStyle}"/>

</ResourceDictionary>    
