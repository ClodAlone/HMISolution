<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap">


    <Pen Brush="#FF3B3B3B" x:Key="Office2010Black.GridLineStroke" Thickness="0.2"/>
    <SolidColorBrush x:Key="Office2010BlackGridBackground" Color="#FFFFFFFF"/>

    <LinearGradientBrush x:Key="Office2010Black.ChartBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="Gray" Offset="0"/>
        <GradientStop Color="#FF3B3B3B" Offset="1"/>
    </LinearGradientBrush>

    <!--Expander Style-->

    <Style x:Key="Office2010Black.ExpanderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1" Width="11" BorderThickness="0" Background="Transparent"   HorizontalAlignment="Right"  >
                            <Path x:Name="ExpandPath" Data="M357,301 L357.5,352.5 422.5,325.5 z" Height="8.032" Width="6" Stretch="Fill" Fill="White" StrokeThickness="0.5" Stroke="Black" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True"  RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                            <Setter Property="Path.RenderTransformOrigin" TargetName="ExpandPath" Value="0.175,0.722"/>
                            <Setter TargetName="ExpandPath" Property="Path.Fill" Value="Black"/>
                            <Setter TargetName="ExpandPath" Property="Path.Stroke" Value="Black"/>
                            <Setter TargetName="ExpandPath" Property="Path.Width" Value="5"/>
                            <Setter TargetName="ExpandPath" Property="Path.RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <RotateTransform Angle="42"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver"  Value="true">
                            <Setter Property="Path.Fill" Value="#FFFDDC00" TargetName="ExpandPath"/>
                            <Setter TargetName="ExpandPath" Property="Path.Stroke" Value="#FFF3C84B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White"/>
    </Style>


    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="Office2010BlackChartLegendStyle">
        <Setter Property="BorderBrush" Value="#FF3B3B3B"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <Style x:Key="Office2010BlackOlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource Office2010Black.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2010Black.ExpanderStyle}"/>
        <Setter Property="GridBackground" Value="{StaticResource Office2010BlackGridBackground}"/>
        <Setter Property="LabelForeground" Value="White"/>
    </Style>

    <Style x:Key="Office2010BlackChartStyle" TargetType="{x:Type syn:Chart}">
        <Setter Property="Background" Value="{StaticResource Office2010Black.ChartBackground}"/>
        <Setter Property="LegendStyle" Value="{StaticResource Office2010BlackChartLegendStyle}"/>
    </Style>
    
    
    <Style BasedOn="{StaticResource Office2010BlackOlapChartStyle}" TargetType="{x:Type local:OlapChart}"/>
    <Style  BasedOn="{StaticResource Office2010BlackChartStyle}" TargetType="{x:Type syn:Chart}"/>
    
</ResourceDictionary>    
