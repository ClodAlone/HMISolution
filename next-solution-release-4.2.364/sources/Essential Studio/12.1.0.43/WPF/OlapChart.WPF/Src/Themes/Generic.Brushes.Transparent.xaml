<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap">


    <Pen Brush="#FF000000" x:Key="Transparent.GridLineStroke" Thickness="0.2"/>
    <SolidColorBrush x:Key="TransparentGridBackground" Color="#72FFFFFF"/>
    
    <LinearGradientBrush x:Key="Transparent.ChartBackground" EndPoint="0.961,0.933" StartPoint="0.009,0.027">
        <GradientStop Color="#4CFFFFFF" Offset="0"/>
        <GradientStop Color="#7FFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!--Expander Style-->


    <Style x:Key="Transparent.ExpanderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1" Width="11" BorderThickness="0" Background="Transparent"   HorizontalAlignment="Right"  >
                            <Path x:Name="ExpandPath" Data="M357,301 L357.5,352.5 422.5,325.5 z" Height="8.032" Width="6" Stretch="Fill" Fill="White" StrokeThickness="0.5" Stroke="Black" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True"  RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                            <Setter Property="Path.RenderTransformOrigin" TargetName="ExpandPath" Value="0.175,0.722"/>
                            <Setter TargetName="ExpandPath" Property="Path.Fill" Value="Black"/>
                            <Setter TargetName="ExpandPath" Property="Path.Stroke" Value="Black"/>
                            <Setter TargetName="ExpandPath" Property="Path.Width" Value="5"/>
                            <Setter TargetName="ExpandPath" Property="Path.RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <RotateTransform Angle="42"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver"  Value="true">
                            <Setter Property="Path.Fill" Value="Black" TargetName="ExpandPath"/>
                            <Setter TargetName="ExpandPath" Property="Path.Stroke" Value="#FFE5E5E5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="TransparentLegendBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#33A7A7A7" Offset="1"/>
        <GradientStop Color="#BFFDFBF0"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="TransparentChartLegendStyle">
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Background" Value="{StaticResource TransparentLegendBackground}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <Style x:Key="TransparentOlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource Transparent.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Transparent.ExpanderStyle}"/>
        <Setter Property="GridBackground" Value="{StaticResource TransparentGridBackground}"/>
        <Setter Property="LabelForeground" Value="Black"/>
    </Style>
   

    
    <Style x:Key="TransparentChartStyle" TargetType="{x:Type syn:Chart}">
        <Setter Property="Background" Value="{StaticResource Transparent.ChartBackground}"/>
    </Style>

    <Style TargetType="{x:Type local:OlapChart}" BasedOn="{StaticResource TransparentOlapChartStyle}"/>
    <Style TargetType="{x:Type syn:Chart}" BasedOn="{StaticResource TransparentChartStyle}"/>
</ResourceDictionary>
