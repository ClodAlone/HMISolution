<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">

    <SolidColorBrush x:Key="Office2007Black.GridBackground" Color="#FFE6E7E9"/>
    <SolidColorBrush x:Key="Office2007Black.GroupingBarBackground" Color="#FFE6E7E9"/>

    <SolidColorBrush x:Key="Office2007Black.GridLineStroke" Color="Black"/>
    <SolidColorBrush x:Key="Office2007Black.GroupingBarItemsBorderBrush" Color="#FF4C5051"/>

    
    <LinearGradientBrush x:Key="Office2007Black.ColumnHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCFDFE" Offset="0.061"/>
        <GradientStop Color="#FFD7D7E1" Offset="0.896"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Black.RowHeaderBackgroundBrush" Color="#FFDCDDE5"/>
    <SolidColorBrush x:Key="Office2007Black.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2007Black.SummaryBackgroundBrush" Color="#FFFBE292"/>
   
    <LinearGradientBrush x:Key="Office2007Black.GroupingBarItemsBackground" EndPoint="0.497,0.898" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFEFF" Offset="0.073"/>
        <GradientStop Color="#FFD8D8E2" Offset="0.969"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Black.ColumnHeaderForegroundBrush" Color="#FF00080E"/>
    <SolidColorBrush x:Key="Office2007Black.RowHeaderForegroundBrush" Color="#FF00080E"/>
    <SolidColorBrush x:Key="Office2007Black.ValueCellForegroundBrush" Color="#535353"/>
    <SolidColorBrush x:Key="Office2007Black.SummaryForegroundBrush" Color="#535353"/>
    <SolidColorBrush x:Key="Office2007Black.WindowBorderBrush" Color="#4F4F4F"/>

    <local:PivotGridCellStyle x:Key="Office2007Black.ColumnHeaderStyle" 
                             Background="{StaticResource Office2007Black.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Black.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2007Black.RowHeaderStyle" 
                             Background="{StaticResource Office2007Black.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Black.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2007Black.SummaryHeaderStyle" 
                             Background="{StaticResource Office2007Black.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2007Black.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2007Black.SummaryCellStyle"
                              Background="{StaticResource Office2007Black.SummaryBackgroundBrush}"
                              Foreground="{StaticResource Office2007Black.ValueCellForegroundBrush}"
                              FontFamily="Calibri"
                              />

    <local:PivotGridCellStyle x:Key="Office2007Black.ValueCellStyle" 
                             Background="{StaticResource Office2007Black.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2007Black.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <SolidColorBrush x:Key="TreeViewFill.Black" Color="#FF898989"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Black"  StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFB5B5B5"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Black" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
<LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackground.Black}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>
    
    <Style x:Key="Office2007Black.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Black}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Black}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Black}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonHoverBackgroundBrush1}"
                                    TargetName="border"/>
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ButtonHoverBorderBrush1}"
                                    TargetName="border"/>
                            <Setter Property="Fill" TargetName="ExpandPath" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="Office2007BlackCurrentCellBorder" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7B6541" Offset="0"/>
        <GradientStop Color="#FFA48D62" Offset="0.996"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource Office2007Black.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Office2007Black.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Office2007Black.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Office2007Black.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Office2007Black.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Office2007Black.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Black.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2007Black.ExpanderStyle}"/>
        <Setter Property="GroupingBarBackground" Value="{StaticResource Office2007Black.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2007Black.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Office2007Black.GroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Office2007Black.WindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF00080E"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF4C5051"/>
        <Setter Property="CurrentCellBorder" Value="{StaticResource Office2007BlackCurrentCellBorder}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2007Black.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Office2007Black.SummaryForegroundBrush}"/>
        
    </Style>
</ResourceDictionary>