<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">

    <SolidColorBrush x:Key="Office2010Black.GridLineStroke" Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="Office2010Black.GroupingBarItemsBorderBrush" Color="#FF1F1F1F"/>

    <SolidColorBrush x:Key="Office2010Black.GridBackground" Color="#FF808080"/>
    <SolidColorBrush x:Key="Office2010Black.GroupingBarBackground" Color="#FF808080"/>


    <LinearGradientBrush x:Key="Office2010Black.ColumnHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE5E5E5" Offset="0"/>
        <GradientStop Color="#FFDADADA" Offset="1"/>
    </LinearGradientBrush>
    <!--<SolidColorBrush x:Key="Office2010Black.RowHeaderBackgroundBrush" Color="#FFD7E6FE"/>-->
    <LinearGradientBrush x:Key="Office2010Black.RowHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEEF4FA"/>
        <GradientStop Color="#FFEFF1F4" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010Black.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2010Black.SummaryBackgroundBrush" Color="#FF1F1F1F"/>


    <LinearGradientBrush x:Key="Office2010Black.GroupingBarItemsBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE5E5E5" Offset="0"/>
        <GradientStop Color="#FFDADADA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2010Black.ColumnHeaderForegroundBrush" Color="#FF363636"/>
    <SolidColorBrush x:Key="Office2010Black.RowHeaderForegroundBrush" Color="#FF363636"/>
    <SolidColorBrush x:Key="Office2010Black.ValueCellForegroundBrush" Color="#FF6C6D6F"/>
    <SolidColorBrush x:Key="Office2010Black.SummaryForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Office2010Black.WindowBorderBrush" Color="#FF1F1F1F"/>

    <local:PivotGridCellStyle x:Key="Office2010Black.ColumnHeaderStyle" 
                             Background="{StaticResource Office2010Black.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.ColumnHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:PivotGridCellStyle x:Key="Office2010Black.RowHeaderStyle" 
                             Background="{StaticResource Office2010Black.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.RowHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />


    <local:PivotGridCellStyle x:Key="Office2010Black.SummaryHeaderStyle" 
                             Background="{StaticResource Office2010Black.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.SummaryForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:PivotGridCellStyle x:Key="Office2010Black.SummaryCellStyle"
                              Background="{StaticResource Office2010Black.SummaryBackgroundBrush}"
                              Foreground="{StaticResource Office2010Black.SummaryForegroundBrush}"
                              FontFamily="Segoe UI"
                              />

    <local:PivotGridCellStyle x:Key="Office2010Black.ValueCellStyle" 
                             Background="{StaticResource Office2010Black.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.ValueCellForegroundBrush}"
                             FontFamily="Segoe UI"
                             />


    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToolTipBackgroundColor"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="LightBlue"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF4CC" Offset="0"/>
        <GradientStop Color="#FFFFEDA6" Offset="0.03"/>
        <GradientStop Color="#FFFFE178" Offset="0.298"/>
        <GradientStop Color="#FFFFE275" Offset="0.576"/>
        <GradientStop Color="#FFFFFBDF" Offset="0.97"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFF3C84B" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackgroundColor}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4"
            >
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style x:Key="Office2010Black.ExpanderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual">
                                            <LinearColorKeyFrame KeyTime="0" Value="#FFFDDC00"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual">
                                            <LinearColorKeyFrame KeyTime="0" Value="#FFA58A0B"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="CheckedVisual">
                                            <LinearColorKeyFrame KeyTime="0" Value="#FFFDDC00"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="CheckedVisual">
                                            <LinearColorKeyFrame KeyTime="0" Value="#FFA58A0B"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.StrokeThickness)" Storyboard.TargetName="UncheckedVisual">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="0.75"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.StrokeThickness)" Storyboard.TargetName="CheckedVisual">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="0.75"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual">
                                            <LinearColorKeyFrame KeyTime="0" Value="#FF564803"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Checked" GeneratedDuration="0:0:0.2" To="Unchecked"/>
                                    <VisualTransition From="Unchecked" GeneratedDuration="0:0:0.2" To="Checked"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="UncheckedVisual">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="CheckedVisual">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="CheckedVisual">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="UncheckedVisual">
                                            <LinearDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1"
								Width="11" BorderThickness="0" Background="Transparent"   HorizontalAlignment="Right"  >
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Height="8.032" Width="6" Stretch="Fill" Fill="White" StrokeThickness="0.5" Stroke="#FF080808" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Path x:Name="CheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="5.074,2.032,0.126,0" Height="8.032" Width="5" Stretch="Fill" Stroke="#FF252525" StrokeThickness="0.5" Fill="#FF474747" RenderTransformOrigin="0.175,0.722" >
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="45"/>
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="Office2010BlackCurrentCellBorder" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7B6541" Offset="0"/>
        <GradientStop Color="#FFA48D62" Offset="0.996"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource Office2010Black.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Office2010Black.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Office2010Black.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Office2010Black.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Office2010Black.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Office2010Black.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2010Black.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2010Black.ExpanderStyle}"/>
        <Setter Property="GroupingBarBackground" Value="{StaticResource Office2010Black.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2010Black.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Office2010Black.GroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Office2010Black.WindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF363636"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF1F1F1F"/>
        <Setter Property="CurrentCellBorder" Value="{StaticResource Office2010BlackCurrentCellBorder}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2010Black.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Office2010Black.SummaryForegroundBrush}"/>

    </Style>
</ResourceDictionary>