<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">

    <SolidColorBrush x:Key="MetroGridBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroGridLineStroke" Color="#FFC5C5C5"/>
    <SolidColorBrush x:Key="MetroGroupingBarItemsBorderBrush" Color="#00CCCCCC"/>

    <SolidColorBrush x:Key="MetroColumnHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroColumnHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroSummaryHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroSummaryHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroSummaryCellBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroSummaryCellForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroRowHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroRowHeaderForeground" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="MetroValueCellBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroValueCellForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroGroupingBarBackground" Color="#FFF4F4F4"/>

    <SolidColorBrush x:Key="MetroGroupingBarItemsBackground" Color="#FFEBEBEB"/>
    
    <SolidColorBrush x:Key="MetroGroupingBarItemForeground" Color="#FF333333"/>
         
    <SolidColorBrush x:Key="MetroWindowBorderBrush" Color="#FF119EDA"/>

    <SolidColorBrush x:Key="MetroGridOuterBorderBrush" Color="#FFDDDDDD"/>

    <SolidColorBrush x:Key="MetroButtonMouseHoverBackground" Color="#FFD8D8D9"/>

    <SolidColorBrush x:Key="MetroButtonMouseHoverBorderBrush" Color="#00CCCCCC"/>
    
    <SolidColorBrush x:Key="MetroButtonMouseHoverForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroButtonCheckedBackground" Color="#FF119EDA"/>

    <SolidColorBrush x:Key="MetroButtonCheckedBorderBrush" Color="#FF2ABFF1"/>
        
    <SolidColorBrush x:Key="MetroButtonCheckedForeground" Color="#FFFFFFFF"/>

    <local:PivotGridCellStyle x:Key="MetroColumnHeaderStyle" 
                             Background="{StaticResource MetroColumnHeaderBackground}"
                             Foreground="{StaticResource MetroColumnHeaderForeground}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />

    <local:PivotGridCellStyle x:Key="MetroRowHeaderStyle" 
                             Background="{StaticResource MetroRowHeaderBackground}"
                             Foreground="{StaticResource MetroRowHeaderForeground}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />


    <local:PivotGridCellStyle x:Key="MetroSummaryHeaderStyle" 
                             Background="{StaticResource MetroSummaryHeaderBackground}"
                             Foreground="{StaticResource MetroSummaryHeaderForeground}"
                             FontFamily="Segoe WP"                             
                             FontSize="13"
                             />

    <local:PivotGridCellStyle x:Key="MetroSummaryCellStyle"
                              Background="{StaticResource MetroSummaryCellBackground}"
                              Foreground="{StaticResource MetroSummaryCellForeground}"
                              FontFamily="Segoe WP"
                               FontWeight="SemiBold"
                             FontSize="12"
                              />

    <local:PivotGridCellStyle x:Key="MetroValueCellStyle" 
                             Background="{StaticResource MetroValueCellBackground}"
                             Foreground="{StaticResource MetroValueCellForeground}"
                             FontFamily="Segoe WP"
                             FontSize="12"
                             />

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource MetroGridBackground}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>
    
    <Style x:Key="MetroExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1" Width="11" BorderThickness="1" Background="Transparent" >
                            <Path x:Name="ExpandPath" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FFFFFFFF" RenderTransformOrigin="0.5,0.5"/>                         
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M290.5,329 L312.5,329.5 302.5,347.5 z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Fill" Value="#FFFFFFFF" TargetName="ExpandPath"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource MetroGridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource MetroColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource MetroRowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource MetroSummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource MetroSummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource MetroValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource MetroGridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource MetroExpanderStyle}"/>
        <Setter Property="GroupingBarBackground"  Value="{StaticResource MetroGroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource MetroGroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource MetroGroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource MetroWindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource MetroButtonMouseHoverBackground}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource MetroButtonMouseHoverBorderBrush}"/>     
        <Setter Property="GroupingBarItemForeground" Value="{StaticResource MetroGroupingBarItemForeground}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource MetroButtonMouseHoverForeground}"/>     
        <Setter Property="GroupingButtonCheckedBackground" Value="{StaticResource MetroButtonCheckedBackground}"/>       
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource MetroButtonCheckedForeground}"/>
        <Setter Property="GridOuterBorderBrush" Value="{StaticResource MetroGridOuterBorderBrush}"/>       
    </Style>
</ResourceDictionary>