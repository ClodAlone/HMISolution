<sync:ChromelessWindow x:Class="Syncfusion.Windows.Controls.PivotGrid.PivotValueChooser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:sync="http://schemas.syncfusion.com/wpf"
                       xmlns:res="clr-namespace:Syncfusion.Windows.Controls.PivotGrid.Resources"
        xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid"
        WindowStyle="ThreeDBorderWindow" ShowInTaskbar="False" ResizeMode="CanResize"  WindowStartupLocation="CenterOwner" 
        MinWidth="200" Width="200" MinHeight="250" Height="250">
    <sync:ChromelessWindow.MinimizeButtonTemplate>
        <ControlTemplate/>
    </sync:ChromelessWindow.MinimizeButtonTemplate>
    <sync:ChromelessWindow.MaximizeButtonTemplate>
        <ControlTemplate/>
    </sync:ChromelessWindow.MaximizeButtonTemplate>
    <sync:ChromelessWindow.RestoreButtonTemplate>
        <ControlTemplate/>
    </sync:ChromelessWindow.RestoreButtonTemplate>
    <sync:ChromelessWindow.Resources>
        <res:ResourceWrapperKeys x:Key="resourceWrapperKeys"/>
    </sync:ChromelessWindow.Resources>
    <Grid x:Name="LayoutRoot">
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="176*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>-->
        <ListBox AllowDrop="True" x:Name="pivotFieldList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel x:Name="listStack" MinHeight="16" Height="{Binding ItemHeight,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotValueChooser}}}"  Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox  VerticalAlignment="Center"  IsChecked="{Binding IsSelected}"/>
                            <TextBlock x:Name="contentTxt" Margin="4,0,0,0" MinWidth="140" FontSize="{Binding ItemFontSize,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotValueChooser}}}"   VerticalAlignment="Center" Text="{Binding FieldHeader}"/>
                        </StackPanel>
                        <Rectangle x:Name="Part_Indicator" Fill="Transparent" Width="160" Height="1" HorizontalAlignment="Stretch"/>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="DragOver">
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                                        <ColorAnimation From="Transparent" To="Black" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="DragLeave">
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                                        <ColorAnimation From="Black" To="Transparent" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Drop">
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                                        <ColorAnimation From="Black" To="Transparent" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--<StackPanel Orientation="Horizontal"  Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1">
            <Button x:Name="btnSyncToGrid" Content="{Binding PivotValueChooser_Apply,Source={StaticResource ResourceKey=resourceWrapperKeys}}" Click="btnSyncToGrid_Click"/>
            <Button Margin="5 0 0 0" x:Name="btnCancel" Content="Cancel" Click="btnCancel_Click"/>
        </StackPanel>-->
    </Grid>
</sync:ChromelessWindow>
