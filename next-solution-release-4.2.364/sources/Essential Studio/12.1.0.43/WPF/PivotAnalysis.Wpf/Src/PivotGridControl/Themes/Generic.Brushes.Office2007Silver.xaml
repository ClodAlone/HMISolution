<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">

    <SolidColorBrush Color="#FFCFD2DB"  x:Key="Office2007Silver.GridBackground"></SolidColorBrush>
    <SolidColorBrush Color="#FFCFD2DB"  x:Key="Office2007Silver.GroupingBarBackground"/>


       
    

    <SolidColorBrush x:Key="Office2007Silver.GridLineStroke" Color="#535353"/>
    <SolidColorBrush x:Key="Office2007Silver.GroupingBarItemsBorderBrush" Color="#FF707173"/>

  
    <LinearGradientBrush x:Key="Office2007Silver.ColumnHeaderBackgroundBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDDDEE2" Offset="0.874"/>
        <GradientStop Color="#FFFAFBFD" Offset="0.082"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Silver.RowHeaderBackgroundBrush" Color="#FFE1E2E6"/>
    <SolidColorBrush x:Key="Office2007Silver.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2007Silver.SummaryBackgroundBrush" Color="#FFFBE292"/>
   
    <LinearGradientBrush  x:Key="Office2007Silver.GroupingBarItemsBackground"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDCDDE1" Offset="0.886"/>
        <GradientStop Color="#FFF9FAFC" Offset="0.058"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007Silver.ColumnHeaderForegroundBrush" Color="#FF303E7B"/>
    <SolidColorBrush x:Key="Office2007Silver.RowHeaderForegroundBrush" Color="#FF303E7B"/>
    <SolidColorBrush x:Key="Office2007Silver.ValueCellForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Silver.SummaryForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Silver.WindowBorderBrush" Color="#7C7C7C"/>

    <local:PivotGridCellStyle x:Key="Office2007Silver.ColumnHeaderStyle" 
                             Background="{StaticResource Office2007Silver.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Silver.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2007Silver.RowHeaderStyle" 
                             Background="{StaticResource Office2007Silver.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Silver.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2007Silver.SummaryHeaderStyle" 
                             Background="{StaticResource Office2007Silver.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2007Silver.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2007Silver.SummaryCellStyle"
                              Background="{StaticResource Office2007Silver.SummaryBackgroundBrush}"
                              Foreground="{StaticResource Office2007Silver.ValueCellForegroundBrush}"
                              FontFamily="Calibri"
                              />

    <local:PivotGridCellStyle x:Key="Office2007Silver.ValueCellStyle" 
                             Background="{StaticResource Office2007Silver.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2007Silver.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <SolidColorBrush x:Key="TreeViewFill.Silver" Color="#FFA9B1B8"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Silver"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFDDDDE0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Silver" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackground.Silver}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4"
            >
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>
    
    <Style x:Key="Office2007Silver.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Silver}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Silver}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Silver}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonHoverBackgroundBrush1}"
                                    TargetName="border"/>
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ButtonHoverBorderBrush1}"
                                    TargetName="border"/>
                            <Setter Property="Fill" TargetName="ExpandPath" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="Office2007SilverCurrentCellBorder" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7B6541" Offset="0"/>
        <GradientStop Color="#FFA48D62" Offset="0.996"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource Office2007Silver.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Office2007Silver.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Office2007Silver.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Office2007Silver.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Office2007Silver.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Office2007Silver.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Silver.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2007Silver.ExpanderStyle}"/>
        <Setter Property="GroupingBarBackground" Value="{StaticResource Office2007Silver.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2007Silver.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Office2007Silver.GroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Office2007Silver.WindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF303E7B"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF707173"/>
        <Setter Property="CurrentCellBorder" Value="{StaticResource Office2007SilverCurrentCellBorder}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2007Silver.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Office2007Silver.SummaryForegroundBrush}"/>
    </Style>
</ResourceDictionary>