    </DataTemplate>
    <DataTemplate x:Key="Cross">
        <Path Data="M9.6249999,0.5 L15.375,0.5 15.375,9.125 23.5,9.125 23.5,14.875 15.375,14.875 15.375,23.5 9.6249999,23.5 9.6249999,14.875 0.5,14.875 0.5,9.125 9.6249999,9.125 z"  Stretch="Fill" >
            <Path.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
                    <Binding />
