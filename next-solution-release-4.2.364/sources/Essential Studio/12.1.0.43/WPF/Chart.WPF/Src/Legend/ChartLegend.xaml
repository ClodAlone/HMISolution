    <!--Legend Icon Templates using ChartTypes-->

    <DataTemplate x:Key="Pie">
        <Path Data="M 0,7 C 0,7 7,0 16,7 L 8,15 L 0,7" Margin="-2,-2,0,0" Fill="{Binding Interior}" Height="{Binding IconHeight,RelativeSource={RelativeSource AncestorType={x:Type local:ChartLegend}},Mode=TwoWay}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
