    <DataTemplate x:Key="FastLine">
        <Polyline Points="0,0,5,10,10,1,15,15,10,1,5,10,0,0" Fill="{Binding Interior}" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="Candle">
        <Polyline Points="7.5,0, 7.5,4, 0,4, 0,12, 7.5,12, 7.5,14, 7.5,12, 15,12, 15,4, 7.5,4" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill">
            <Polyline.Fill>
