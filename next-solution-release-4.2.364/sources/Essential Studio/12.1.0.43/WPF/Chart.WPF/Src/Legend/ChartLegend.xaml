    </DataTemplate>
    <DataTemplate x:Key="RotatedSpline">
        <Path Data="M 4,0 C 4,0 11,5 7,7 C 7,7 4,10 11,15 C 11,15 4,10 7,7 C 7,7 11,5 4,0" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill">
