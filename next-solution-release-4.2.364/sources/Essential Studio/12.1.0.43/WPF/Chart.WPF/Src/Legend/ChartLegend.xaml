    </DataTemplate>
    <DataTemplate x:Key="HiLoArea">
        <Polyline Points="0,7.5, 3,0, 8,15, 15,5, 8,0, 3,15, 0,7.5" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="Kagi">
        <Polyline Points="0,15, 9,15, 9,0, 15,0, 9,0, 9,15, 0,15" Fill="{Binding Interior}" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="Column">
