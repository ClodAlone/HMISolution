    <DataTemplate x:Key="HiLoOpenClose">
        <Polyline Points="7.5,0, 7.5,15, 0,15, 7.5,15, 7.5,7.5, 15,7.5, 7.5,7.5, 7.5,0" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill">
            <Polyline.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
