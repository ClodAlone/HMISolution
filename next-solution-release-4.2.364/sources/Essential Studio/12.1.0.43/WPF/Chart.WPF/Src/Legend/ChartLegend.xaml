    <DataTemplate x:Key="Spline">
        <Path Data="M 0,10 C 0,10 3,3 7,7 C 7,7 11,11 15,4 C 15,4 11,11 7,7 C 7,7 3,3 0,10" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill">
            <Path.Fill>
