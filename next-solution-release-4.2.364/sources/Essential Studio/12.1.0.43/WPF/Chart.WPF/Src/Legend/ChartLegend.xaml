<!--Defines the following:
    1) ChartLegend Style.
    -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf">
    <ItemsPanelTemplate x:Key="chartGridPanel">
        <local:ChartGrid AutoColumnsCount="{Binding ColumnsCount, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                           AutoRowsCount="{Binding RowsCount, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                           Orientation="{Binding Orientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>
    </ItemsPanelTemplate>

    <DataTemplate DataType="{x:Type local:ChartSegment}">
        <StackPanel Orientation="Horizontal" >
            <CheckBox IsChecked="{Binding CorrespondingPoints[0].DataPoint.Visible, Mode=TwoWay}"
                    VerticalAlignment="Center"
										IsThreeState="False"
										Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                    Visibility="{Binding CheckBoxVisibility, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
							  		HorizontalAlignment="Center"/>
            <DockPanel LastChildFill="False" Margin="5,0,0,0">

                <ContentControl Width="16" Height="16" Content="{Binding}" Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:ChartLegend}},Mode=TwoWay}" ContentTemplate="{Binding Series.InternalLegendIconTemplate}" Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>

                <TextBlock 
									Text="{Binding CorrespondingPoints[0].DataPoint.Label}"
                   Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                   VerticalAlignment="{Binding TextAlignment, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>
            </DockPanel>
        </StackPanel>
    </DataTemplate>
    <local:ShowSymbolConvertor x:Key="valconv" />
    
    <local:LegendIconInteriorConvertor x:Key="legendIconConv" />
    <DataTemplate DataType="{x:Type local:ChartSeries}">
        <StackPanel Orientation="Horizontal" Visibility="{Binding VisibilityOnLegend}"
			Margin="{Binding ItemMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}" >
            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                    Visibility="{Binding CheckBoxVisibility, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>
            <Grid>

                <ContentPresenter Height="{Binding IconHeight, RelativeSource={RelativeSource AncestorType={x:Type local:ChartLegend}},Mode=TwoWay}"  Width="{Binding IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ChartLegend}},Mode=TwoWay}" Content="{Binding}" Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:ChartLegend}},Mode=TwoWay}" ContentTemplate="{Binding InternalLegendIconTemplate}" Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>

                <Control x:Name="Part_Legend" Height="10" Width="10" Background="{Binding AdornmentSymbolInterior}" BorderThickness="{Binding AdornmentSymbolStrokeThickness}" BorderBrush="{Binding AdornmentSymbolStroke}"  Template="{Binding AdornmentSymbolTemplate}" >
                    <Control.Visibility>
                        <MultiBinding Converter="{StaticResource valconv}" >
                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}"  Path="ShowSymbol"></Binding>
                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}"  Path="IconVisibility"></Binding>
                            <Binding Path="ShowDataLabels"/>
                        </MultiBinding>
                    </Control.Visibility>
                </Control>
                <!--Visibility="{Binding Path=ShowSymbol, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}" />-->
            </Grid>
            <TextBlock Text="{Binding Label}"
                     Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                     VerticalAlignment="{Binding TextAlignment, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>
			<ContentPresenter Content="{Binding Unit}"  
                     ContentStringFormat="({0})"
                     Visibility="{Binding UnitVisibility}"                     
                     TextBlock.FontStyle="Italic" TextBlock.FontSize="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                     Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"
                     VerticalAlignment="{Binding TextAlignment, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"/>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type local:ChartLegend}">
        <Style.Resources>
       
        </Style.Resources>

        <Setter Property="Padding" Value="5"/>
        <Setter Property="Background" Value="#FFF5F5F5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderBrush" Value="#FFE5E5E5"/>
        <Setter Property="ItemsPanel" Value="{StaticResource chartGridPanel}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartLegend}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <ContentPresenter ContentSource="Header"/>
                            <ItemsPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsLegacyLegendStyleEnabled" Value="false">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="ItemMargin" Value="9"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>  
                <Setter Property="LegendPanel" Value="WrapPanel"/>   
                <Setter Property="local:ChartDockPanel.Dock" Value="Bottom"/>   
                <Setter Property="IconWidth" Value="13"/>
                <Setter Property="IconHeight" Value="13"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--Legend Icon Templates using Symbols-->

   
    
    
    <DataTemplate x:Key="Rectangle">
        <Rectangle Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Height="{Binding IconHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}"  Width="{Binding IconWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}" Margin="0,0,0,0">
            <Rectangle.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
                    <Binding />
                </MultiBinding>
            </Rectangle.Fill>
        </Rectangle>
    </DataTemplate>

    <DataTemplate x:Key="None">
        <Canvas></Canvas>
    </DataTemplate>

    <DataTemplate x:Key="Ellipse">
        <Ellipse Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Height="{Binding IconHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}" Width="{Binding IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ChartLegend}},Mode=TwoWay}" Margin="0,0,0,0">
            <Ellipse.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
                    <Binding />
                </MultiBinding>
            </Ellipse.Fill>  
        </Ellipse>
    </DataTemplate>
    <DataTemplate x:Key="Circle">
        <Ellipse Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Height="{Binding IconHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}" Width="{Binding IconWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartLegend}}}">
            <Ellipse.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
                    <Binding />
                </MultiBinding>
            </Ellipse.Fill>
        </Ellipse>       
    </DataTemplate>

    <DataTemplate x:Key="Pentagon">
        <Polyline Stretch="Fill" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Points=" 7.5,0,15,7,12,15,3,15,0,7,7.5,0">
            <Polyline.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
                    <Binding />
                </MultiBinding>
            </Polyline.Fill>
        </Polyline>
    </DataTemplate>
    <DataTemplate x:Key="StraightLine">
        <Polyline Stretch="Fill" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Points="7.5,0,7.5,15" Margin="0,0,0,0">
            <Polyline.Fill>
                <MultiBinding Converter="{StaticResource legendIconConv}" >
                    <Binding Path="Interior" />
                    <Binding Path="ColorEach" />
                    <Binding />
                </MultiBinding>
            </Polyline.Fill>
        </Polyline>
    </DataTemplate>
    <DataTemplate x:Key="HorizontalLine">
        <Polyline Stretch="Fill" Fill="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Points="0,7.5,15,7.5" Margin="0,0,0,0">
