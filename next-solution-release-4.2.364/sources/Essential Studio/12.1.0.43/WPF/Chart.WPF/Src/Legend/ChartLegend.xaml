    <DataTemplate x:Key="StackingLine100">
        <Polyline Points="0,10,5,10,10,1,15,15,10,1,5,10,0,10" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill">
            <Polyline.Fill>
