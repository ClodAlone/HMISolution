    </DataTemplate>
    <DataTemplate x:Key="FastHiLoOpenClose">
        <Polyline Points="7.5,0, 7.5,15, 0,15, 7.5,15, 7.5,7.5, 15,7.5, 7.5,7.5, 7.5,0" Fill="{Binding Interior}" Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="FastStackingColumn">
        <Polyline Points="0,15, 0,0, 10,0, 10,15,0,15" Margin="2,0,2,0" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="FastScatter">
        <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="Gantt">
        <Polyline Points="0,13, 0,4, 15,4, 15,13, 0,13 " Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Uniform">
