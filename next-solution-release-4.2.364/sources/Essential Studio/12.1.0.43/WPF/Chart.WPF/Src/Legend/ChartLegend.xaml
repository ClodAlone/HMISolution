    <DataTemplate x:Key="Pyramid">
        <Polyline Points="3,2, 12,2, 15,14, 0,14, 3,2" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="PointAndFigure">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="25*"/>
            </Grid.ColumnDefinitions>
            <Ellipse Stroke="Red" Grid.Row="0" Grid.Column="1" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
            <Grid Grid.Row="1"  Grid.Column="1" >
                <Line  Stroke="{Binding Stroke}"  StrokeThickness="{Binding StrokeThickness}" X1="0" Y1="8" X2="8" Y2="0" Stretch="Fill"/>
                <Line  Stroke="{Binding Stroke}"  StrokeThickness="{Binding StrokeThickness}" X1="0" Y1="0" X2="8" Y2="8" Stretch="Fill"/>
            </Grid >
        </Grid>        
    </DataTemplate>
    <DataTemplate x:Key="RangeArea">
        <Polyline Points="0,0, 8,6, 15,0, 15,15, 5,10, 0,15, 0,0" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Stretch="Fill"/>
    </DataTemplate>
    <DataTemplate x:Key="RangeColumn">
