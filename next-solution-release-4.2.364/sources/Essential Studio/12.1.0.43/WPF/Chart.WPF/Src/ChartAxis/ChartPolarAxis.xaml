<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart">
   
    
    <DataTemplate DataType="{x:Type local:ChartAxisLabel}">
        <DataTemplate.Resources>
            <RelativeSource Mode="FindAncestor" AncestorType="{x:Type local:ChartCartesianAxisLabelsPanel}" x:Key="axisSource"/>
        </DataTemplate.Resources>
        <Grid HorizontalAlignment="{Binding Axis.LabelHorizontalAlignment, RelativeSource={StaticResource axisSource}}"
              VerticalAlignment="{Binding Axis.LabelVerticalAlignment, RelativeSource={StaticResource axisSource}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" ContentTemplate="{Binding Axis.LabelsPrefix, RelativeSource={StaticResource axisSource}}"/>
            <Border Grid.Column="1" Background="{Binding Axis.LabelBackground, RelativeSource={StaticResource axisSource}}" 
                  BorderThickness="{Binding Axis.LabelBorderThickness, RelativeSource={StaticResource axisSource}}"
                  BorderBrush="{Binding Axis.LabelBorderBrush, RelativeSource={StaticResource axisSource}}" 
                  CornerRadius="{Binding Axis.LabelCornerRadius, RelativeSource={StaticResource axisSource}}">
            <TextBlock Text="{Binding Content, Mode=OneTime}"
                       FontSize="{Binding Axis.LabelFontSize, RelativeSource={StaticResource axisSource}}" 
                       FontFamily="{Binding Axis.LabelFontFamily, RelativeSource={StaticResource axisSource}}"
                       Foreground="{Binding Axis.LabelForeground, RelativeSource={StaticResource axisSource}}" 
                       FontWeight="{Binding Axis.LabelFontWeight, RelativeSource={StaticResource axisSource}}"/>
            </Border>
            <ContentControl Grid.Column="2" ContentTemplate="{Binding Axis.LabelsPostfix, RelativeSource={StaticResource axisSource}}"/>
        </Grid>
            </DataTemplate>

    

    <!-- Polar Axis template -->
    <DataTemplate x:Key="ChartPolarAxisTemplateKey">
        <DataTemplate.Resources>
            <DataTemplate DataType="{x:Type local:ChartAxisLabel}">
                <DataTemplate.Resources>
                    <RelativeSource Mode="FindAncestor" AncestorType="{x:Type local:ChartPolarAxisLabelsPanel}" x:Key="axisSource"/>
                </DataTemplate.Resources>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="{Binding Axis.LabelHorizontalAlignment, RelativeSource={StaticResource axisSource}}"
                            VerticalAlignment="{Binding Axis.LabelVerticalAlignment, RelativeSource={StaticResource axisSource}}">
                    <ContentControl ContentTemplate="{Binding Axis.LabelsPrefix, RelativeSource={StaticResource axisSource}}"/>
                    <Border Background="{Binding Axis.LabelBackground, RelativeSource={StaticResource axisSource}}" 
                  BorderThickness="{Binding Axis.LabelBorderThickness, RelativeSource={StaticResource axisSource}}"
                  BorderBrush="{Binding Axis.LabelBorderBrush, RelativeSource={StaticResource axisSource}}" 
                  CornerRadius="{Binding Axis.LabelCornerRadius, RelativeSource={StaticResource axisSource}}">
                        <TextBlock Text="{Binding Content, Mode=OneTime}"
                       FontSize="{Binding Axis.LabelFontSize, RelativeSource={StaticResource axisSource}}" 
                       FontFamily="{Binding Axis.LabelFontFamily, RelativeSource={StaticResource axisSource}}"
                       Foreground="{Binding Axis.LabelForeground, RelativeSource={StaticResource axisSource}}" 
                       FontWeight="{Binding Axis.LabelFontWeight, RelativeSource={StaticResource axisSource}}"/>
                    </Border>
                    <ContentControl ContentTemplate="{Binding Axis.LabelsPostfix, RelativeSource={StaticResource axisSource}}"/>
                </StackPanel>
            </DataTemplate>
        </DataTemplate.Resources>
        <ItemsControl ClipToBounds="False" 
                  ItemsSource="{Binding VisibleLabels, Mode=OneTime}"
                  ItemTemplate="{Binding LabelTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:ChartPolarAxisLabelsPanel ToolTip="{Binding ToolTip}" Axis="{Binding}" 
                                           Radius="{Binding Radius, Mode=OneWayToSource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartPolarPanel}}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="local:ChartCartesianAxisLabelsPanel.Position" Value="{Binding Position, Mode=OneTime}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </DataTemplate>

      
</ResourceDictionary>
