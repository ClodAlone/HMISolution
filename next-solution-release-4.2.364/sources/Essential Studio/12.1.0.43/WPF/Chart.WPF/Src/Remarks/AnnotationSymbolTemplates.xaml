<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:Syncfusion.Windows.Chart">
    <local:AnnotationConverter x:Key="Annotation" />
    <!--Annotation Label Templates -->
    <DataTemplate x:Key="templateEllipse">
        <Grid>
            <Ellipse Fill="{Binding Fill}" Stroke="Black" Width="25" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!--<ContentPresenter Content="{Binding Content}" HorizontalAlignment="Center"/>-->
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateRectangle">
        <Grid>
            <Rectangle Fill="{Binding Fill}" Stroke="Black" Height="10" Width="20"  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateRoundedRectangle">
        <Grid>
            <Rectangle Fill="{Binding Fill}" Stroke="Black" RadiusX="5" RadiusY="5" Height="10" Width="20"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateArrow">
        <Grid>
            <Polygon Stroke="Black" StrokeThickness="1" Fill="{Binding Fill}" Points="5,15 10,10 5,5 20,10 5,15" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateInverteredArrow">
        <Grid>
            <Polygon Stroke="Black" StrokeThickness="1" Fill="{Binding Fill}" Points="20,5 15,10 20,15 5,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateHexagon">
        <Grid>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
            <Polygon Stroke="Black"  StrokeThickness="1" Fill="{Binding Fill}" Points="10,20 5,15 5,10 10,5 15,10 15,15" HorizontalAlignment="Left" VerticalAlignment="Top"></Polygon>

        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templatePentagon">
        <Grid>
            <Polygon Stroke="Black" StrokeThickness="1" Fill="{Binding Fill}" Points="5,15 5,10 10,5 15,10 15,15" HorizontalAlignment="Left" VerticalAlignment="Top"></Polygon>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateCross">
        <Grid>
            <Polygon Stroke="Black" Fill="{Binding Fill}" Points="5,15 5,10 10,10 10,5 15,5 15,10 20,10 20,15 15,15 15,20 10,20 10,15" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top"></Polygon>
                <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <ContentPresenter.Content>
                        <MultiBinding Converter="{StaticResource Annotation}">
                            <Binding Path="Content" />
                        <Binding  />
                        </MultiBinding>
                    </ContentPresenter.Content>
                </ContentPresenter>
           
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateStar">
        <Grid>
            <Polygon Stroke="Black" Fill="{Binding Fill}" Points="5,18 10,5 15,18 5,10 15,10" HorizontalAlignment="Left" VerticalAlignment="Top"></Polygon>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateDiamond">
        <Grid>
            <Polygon Stroke="Black" StrokeThickness="1" Fill="{Binding Fill}" Points="5,10 10,5 15,10 10,15" HorizontalAlignment="Left" VerticalAlignment="Top"></Polygon>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateSquare">
        <Grid>
            <Rectangle Fill="{Binding Fill}" Stroke="Black" Height="10" Width="10"  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateCircle">
        <Grid>
            <Ellipse Fill="{Binding Fill}" Stroke="Black" Height="10" Width="10" HorizontalAlignment="Left" VerticalAlignment="Top"></Ellipse>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateHorizontalLine">
        <Grid>
            <Line Stroke="Black" X1="15" Y1="10" X2="35" Y2="10" HorizontalAlignment="Left"></Line>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateVerticalLine">
        <Grid>
            <Line Stroke="Black" X1="10" Y1="10" X2="10" Y2="30" HorizontalAlignment="Left"></Line>
            <ContentPresenter  Margin="0,15,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding  />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="templateNone">
        <Grid>
            <ContentPresenter  Margin="0,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ContentPresenter.Content>
                    <MultiBinding Converter="{StaticResource Annotation}">
                        <Binding Path="Content" />
                        <Binding />
                    </MultiBinding>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Grid>
    </DataTemplate>
    
    <!--Data Templates for Chart Series Annotation -->
    <DataTemplate x:Key="seriestemplateEllipse">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Margin="15,0,0,0"  VerticalAlignment="Bottom"/>
            <Ellipse Fill="{Binding Fill}" Margin="15"  Stroke="{Binding Stroke}" Width="25" Height="15" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateRectangle">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Grid.Row="1"  Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Rectangle Fill="{Binding Fill}" Margin="15" Stroke="{Binding Stroke}" Height="10" Width="20"  HorizontalAlignment="Center" VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateRoundedRectangle">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Rectangle Fill="{Binding Fill}" Margin="15" Stroke="{Binding Stroke}" RadiusX="5" RadiusY="5" Height="10" Width="20"  HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateArrow">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}" Margin="15" Fill="{Binding Fill}" Points="5,15 10,10 5,5 20,10 5,15" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateInverteredArrow">
        <Grid>
            <ContentPresenter Content="{Binding Description}"  Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}" Margin="15" Fill="{Binding Fill}" Points="20,5 15,10 20,15 5,10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateHexagon">
        <Grid>
            <ContentPresenter Content="{Binding Description}"    Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}"  Margin="15" Fill="{Binding Fill}" Points="7.5,15 2.5,10 2.5,5 7.5,0 12.5,5 12.5,10" HorizontalAlignment="Center" VerticalAlignment="Top"></Polygon>

        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplatePentagon">
        <Grid>
            <ContentPresenter Content="{Binding Description}"    Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}"  Margin="15" Fill="{Binding Fill}" Points="0,12.5 0,7.5 5,2.5 10,7.5 10,12.5" HorizontalAlignment="Center" VerticalAlignment="Top"></Polygon>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateCross">
        <Grid>
            <ContentPresenter Content="{Binding Description}"  Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}"  Margin="15"  Fill="{Binding Fill}" Points="0,5 5,5 5,0 10,0 10,5 15,5 15,10 10,10 10,15 10,15 5,15 5,10 0,10"  HorizontalAlignment="Center" VerticalAlignment="Top"></Polygon>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateStar">
        <Grid>
            <ContentPresenter Content="{Binding Description}"   Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}"   Fill="{Binding Fill}" Margin="15" Points="0,18 5,5 10,18 0,10 10,10" HorizontalAlignment="Center" VerticalAlignment="Top"></Polygon>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateDiamond">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Polygon Stroke="{Binding Stroke}" Fill="{Binding Fill}" Margin="15" Points="0,5 5,0 10,5 5,10" HorizontalAlignment="Center" VerticalAlignment="Top"></Polygon>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateSquare">
       
        <Grid>
          <ContentPresenter Content="{Binding Description}"  Margin="15,0,0,0"  VerticalAlignment="Bottom"/>
          <Rectangle Fill="{Binding Fill}"  Stroke="{Binding Stroke}" Margin="15"  Height="10" Width="10"  HorizontalAlignment="Center" VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateCircle">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Margin="15,0,0,0"  VerticalAlignment="Bottom"/>
            <Ellipse Fill="{Binding Fill}" Stroke="{Binding Stroke}" Margin="15" Height="10" Width="10" HorizontalAlignment="Center" VerticalAlignment="Top"></Ellipse>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateHorizontalLine">
        <Grid>
            <ContentPresenter Content="{Binding Description}" Margin="15,0,0,0" VerticalAlignment="Bottom"/>
            <Line Stroke="{Binding Stroke}"  Fill="{Binding Fill}"  Margin="15" X1="0" Y1="0" X2="20" Y2="0" VerticalAlignment="Top" ></Line>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateVerticalLine">
        <Grid>
            <ContentPresenter Content="{Binding Description}"   Margin="15,30,0,0" VerticalAlignment="Bottom"/>
            <Line Stroke="{Binding Stroke}"  Fill="{Binding Fill}" X1="10.5" Y1="12.5" X2="10.5" Y2="32.5"></Line>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="seriestemplateNone">
        <Grid>
            <ContentPresenter Content="{Binding Description}"  Margin="15" VerticalAlignment="Bottom"/>
        </Grid>
    </DataTemplate>

      
</ResourceDictionary>
