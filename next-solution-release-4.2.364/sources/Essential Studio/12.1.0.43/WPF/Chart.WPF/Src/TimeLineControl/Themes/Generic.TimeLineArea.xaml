<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
                    >
    
    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Themes/ChartVisualStyles.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartSeries/ChartSeries.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartAxis/ChartCartesianAxis.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="TimeLineControlCartesianAreaKey">
        <DataTemplate.Resources>
            <local:AxesStateToMarginConverter x:Key="areaMarginConverter"/>
            <local:AxesConverter x:Key="axesConverter"/>
            <local:IndicatorVisibilityConverter x:Key="indicatorVisibilityConverter"/>
            <local:LeftConverter x:Key="leftConverter"/>
            <local:TopConverter x:Key="topConverter"/>
            <local:SetCanvasLeftConverter x:Key="selectedRegionWidth"/>
        </DataTemplate.Resources>
        <local:ChartPanel x:Name="PART_CHARTPANEL">
            <local:ChartCartesianAreaGrid x:Name="PART_GridElement" 
                                 XAxis="{Binding HorizontalScrollingAxis}"
                                 YAxis="{Binding VerticalScrollingAxis}"
                                 Axes="{Binding Axes}"
                                 Background="{Binding GridBackground}"
                                 AlternatingLinesBrush="{Binding AlternatingGridBackground}"
                                 AlternatingLinesDirection="{Binding AlternatingFillDirection}"
                                 FillRule="{Binding AlternatingFillMode}"
                                 ClipToBounds="True">
                <local:ChartCartesianAreaGrid.Margin>
                    <MultiBinding Converter="{StaticResource areaMarginConverter}">
                        <Binding Path="AxesThickness"/>
                        <Binding Path="ActualWidth" ElementName="VerticalScrollBar"/>
                        <Binding Path="ActualHeight" ElementName="HorizontalScrollBar"/>
                    </MultiBinding>
                </local:ChartCartesianAreaGrid.Margin>
            </local:ChartCartesianAreaGrid>
            <local:ChartWatermarkElement x:Name="PART_WatermarkElement" 
                                 XAxis="{Binding HorizontalScrollingAxis}"
                                 YAxis="{Binding VerticalScrollingAxis}"
                                 Watermark="{Binding Watermark}"                        
                                 ClipToBounds="True">
                <local:ChartWatermarkElement.Margin>
                    <MultiBinding Converter="{StaticResource areaMarginConverter}">
                        <Binding Path="AxesThickness"/>
                        <Binding Path="ActualWidth" ElementName="VerticalScrollBar"/>
                        <Binding Path="ActualHeight" ElementName="HorizontalScrollBar"/>
                    </MultiBinding>
                </local:ChartWatermarkElement.Margin>
            </local:ChartWatermarkElement>
            <Grid Margin="{Binding AxesThickness}">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="PART_SeriesContainer" 
                    ItemsSource="{Binding VisibleSeries}"
                    ItemTemplate="{StaticResource ChartSeriesTemplate}"
                    IsTabStop="False"
                    ClipToBounds="true">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>


                <!--<Canvas x:Name="splitter" Margin="0,0,0,0">
                    <Thumb Height="2" BorderThickness="1"/>
                </Canvas>-->

                <ItemsControl  ItemsSource="{Binding InteractiveCursors}" ClipToBounds="True" >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>


                <local:ChartAdornmentsPresenter VisibleSeries="{Binding VisibleSeries}"
                                      Area="{Binding}" Axes="{Binding Axes}" ClipToBounds="True"/>
                <local:ChartZoomingScrollBar IsTabStop="False" Grid.Column="1" Grid.Row="0" x:Name="VerticalScrollBar"
                                     Orientation="Vertical" 
                                     IsInversed="{Binding VerticalScrollingAxis.IsInversed}"
                                     ZoomFactor="{Binding VerticalScrollingAxis.ZoomFactor}"
                                     ZoomSwitched="{Binding ZoomSwitched}"
                                     ZoomPosition="{Binding VerticalScrollingAxis.ZoomPosition, Mode=TwoWay}"/>
                <local:ChartZoomingScrollBar IsTabStop="False" Grid.Column="0" Grid.Row="1" x:Name="HorizontalScrollBar"
                                     Orientation="Horizontal"
                                     IsInversed="{Binding HorizontalScrollingAxis.IsInversed}"
                                     ZoomFactor="{Binding HorizontalScrollingAxis.ZoomFactor}"
                                     ZoomSwitched="{Binding ZoomSwitched}"
                                     ZoomPosition="{Binding HorizontalScrollingAxis.ZoomPosition, Mode=TwoWay}"/>
                <Grid>
                    <!--MouseOver region-->
                    <Canvas Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}">
                        <Rectangle Visibility="{Binding MousehoverVisibility}" Fill="{Binding ViewPortInterior}" Stroke="{Binding ViewPortInterior}" Width="{Binding MousehoverWidth}" Height="{Binding GridHeight}" Canvas.Left="{Binding MousehoverLeftCanvas}" Opacity="0.1"/>
                    </Canvas>

                    <!--Left Unselected region-->
                    <Canvas>
                        <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding UnSelectedRegionInterior}" Stroke="{Binding UnSelectedRegionInterior}" Width="{Binding CanvasLeft}" Height="{Binding GridHeight}" Canvas.Left="0" Opacity="0.35"/>
                    </Canvas>

                    <!--Right Unselected region-->
                    <Canvas>
                        <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding UnSelectedRegionInterior}" Stroke="{Binding UnSelectedRegionInterior}" Width="{Binding RightUnSelectedWidth}" Height="{Binding GridHeight}" Canvas.Left="{Binding CanvasRight}" Opacity="0.35"/>
                    </Canvas>

                    <!--Selected region-->
                    <Canvas>
                        <Rectangle x:Name="ColorRect" Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Width="{Binding SelectedRegionWidth}" Height="{Binding GridHeight}" Canvas.Left="{Binding CanvasLeft}" Opacity="0.7">
                            <Rectangle.Style>
                                <Style TargetType="{x:Type Rectangle}">
                                    <Setter Property="Fill" Value="{Binding ViewPortInterior}">
                                    </Setter>
                                    <Setter Property="Stroke" Value="#FF979897"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Fill" Value="{Binding MouseOverInterior}">
                                            </Setter>
                                            <Setter Property="Stroke">
                                                <Setter.Value>#FFEFCB55</Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Canvas>

                    <!--Left Indicator-->
                    <Grid>
                        <Line Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" X1="{Binding LeftOffsetX}" X2="{Binding LeftOffsetX}" Y1="0" Y2="{Binding ActualHeight}" StrokeThickness="2">
                            <Line.Style>
                                <Style TargetType="{x:Type Line}">
                                    <Setter Property="Fill" Value="{Binding ViewLineInterior}"/>
                                    <Setter Property="Stroke" Value="{Binding ViewLineInterior}"/>
                                </Style>
                            </Line.Style>
                        </Line>
                        <Canvas Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}">
                            <ContentPresenter Canvas.Left="{Binding LeftOffsetX, Converter={StaticResource leftConverter}}" ContentTemplate="{Binding LeftIndicatorTemplate}" Height="{Binding ThumbHeight}" Canvas.Top="{Binding GridHeight,Converter={StaticResource topConverter}}">
                            </ContentPresenter>
                        </Canvas>
                    </Grid>


                    <!--Right Indicator-->
                    <Grid>
                        <Line Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" X1="{Binding RightOffsetX}" X2="{Binding RightOffsetX}" Y1="0" Y2="{Binding ActualHeight}" StrokeThickness="2">
                            <Line.Style>
                                <Style TargetType="{x:Type Line}">
                                    <Setter Property="Fill" Value="{Binding ViewLineInterior}"/>
                                    <Setter Property="Stroke" Value="{Binding ViewLineInterior}"/>
                                </Style>
                            </Line.Style>
                        </Line>
                        <Canvas Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}">
                            <ContentPresenter ContentTemplate="{Binding RightIndicatorTemplate}"  Canvas.Left="{Binding RightOffsetX, Converter={StaticResource leftConverter}}"  Canvas.Top="{Binding GridHeight,Converter={StaticResource topConverter}}">
                            </ContentPresenter>
                        </Canvas>
                    </Grid>

                </Grid>
            </Grid>
            <ItemsControl x:Name="PART_AxesContainer" IsTabStop="False"
                    ItemTemplate="{StaticResource ChartCartesianAxisTemplateKey}"
>
                <ItemsControl.ItemsSource>
                    <MultiBinding Converter="{StaticResource axesConverter}">
                        <Binding Path="Axes"/>
                        <Binding Path="IsRetainAxisPosition"/>
                        <Binding Path="Axes.Count"/>
                    </MultiBinding>

                </ItemsControl.ItemsSource>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:ChartCartesianPanel AxesThickness="{Binding AxesThickness, Mode=OneWayToSource}"
                                       HorizontalScrollBarHeight="{Binding ActualHeight, ElementName=HorizontalScrollBar}"
                                       VerticalScrollBarWidth="{Binding ActualWidth, ElementName=VerticalScrollBar}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <local:ChartBreakRange x:Name="PART_ScaleBreakElement"
                                   XAxis="{Binding HorizontalScrollingAxis}"
                                   YAxis="{Binding VerticalScrollingAxis}">
                <local:ChartBreakRange.Margin>
                    <MultiBinding Converter="{StaticResource areaMarginConverter}">
                        <Binding Path="AxesThickness"/>
                        <Binding Path="ActualWidth" ElementName="VerticalScrollBar"/>
                        <Binding Path="ActualHeight" ElementName="HorizontalScrollBar"/>
                    </MultiBinding>
                </local:ChartBreakRange.Margin>
            </local:ChartBreakRange>
        </local:ChartPanel>
    </DataTemplate>
    <local:IndicatorVisibilityConverter x:Key="indicatorVisibilityConverter"/>
    <local:LeftConverter x:Key="leftConverter"/>
    <local:TopConverter x:Key="topConverter"/>
    <local:SetCanvasLeftConverter x:Key="selectedRegionWidth"/>
    <Grid x:Key="TimeLineIndicator">
        <!--MouseOver region-->
        <Canvas Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}">
            <Rectangle Visibility="{Binding MousehoverVisibility}" Fill="{Binding ViewPortInterior}" Stroke="{Binding ViewPortInterior}" Width="{Binding MousehoverWidth}" Height="{Binding GridHeight}" Canvas.Left="{Binding MousehoverLeftCanvas}" Opacity="0.25"/>
        </Canvas>

        <!--Left Unselected region-->
        <Canvas>
            <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding UnSelectedRegionInterior}" Stroke="{Binding UnSelectedRegionInterior}" Width="{Binding CanvasLeft}" Height="{Binding GridHeight}" Canvas.Left="0" Opacity="0.35"/>
        </Canvas>

        <!--Right Unselected region-->
        <Canvas>
            <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding UnSelectedRegionInterior}" Stroke="{Binding UnSelectedRegionInterior}" Width="{Binding RightUnSelectedWidth}" Height="{Binding GridHeight}" Canvas.Left="{Binding CanvasRight}" Opacity="0.35"/>
        </Canvas>

        <!--Selected region-->
        <Canvas>
            <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding ViewPortInterior}" Stroke="{Binding ViewPortInterior}" Width="{Binding SelectedRegionWidth}" Height="{Binding GridHeight}" Canvas.Left="{Binding CanvasLeft}" Opacity="0.35" Margin="0,0,0,0"  />
        </Canvas>

        <!--Left Indicator-->
        <Grid Margin="0,0,0,0" >
            <Line Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding ViewLineInterior}" Stroke="{Binding ViewLineInterior}" X1="{Binding LeftOffsetX}" X2="{Binding LeftOffsetX}" Y1="0" Y2="{Binding ActualHeight}" />
            <Canvas>
                <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding ViewLineInterior}" Stroke="{Binding ViewLineInterior}" Width="10" Height="20" Canvas.Left="{Binding LeftOffsetX, Converter={StaticResource leftConverter}}" Canvas.Top="{Binding LeftOffsetY,Converter={StaticResource topConverter}}" Margin="-5,0,0,0" />
            </Canvas>
        </Grid>


        <!--Right Indicator-->
        <Grid Margin="0,0,0,0" >
            <Line Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding ViewLineInterior}" Stroke="{Binding ViewLineInterior}" X1="{Binding RightOffsetX}" X2="{Binding RightOffsetX}" Y1="0" Y2="{Binding ActualHeight}" />
            <Canvas>
                <Rectangle Visibility="{Binding Converter={StaticResource indicatorVisibilityConverter}}" Fill="{Binding ViewLineInterior}" Stroke="{Binding ViewLineInterior}" Width="10" Height="20" Canvas.Left="{Binding RightOffsetX, Converter={StaticResource leftConverter}}" Canvas.Top="{Binding RightOffsetY,Converter={StaticResource topConverter}}" Margin="-5,0,0,0"/>
            </Canvas>
        </Grid>

    </Grid>

</ResourceDictionary>
