        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeLineControl}">
                    <ControlTemplate.Resources>
                        <local:SetCanvasLeftConverter x:Key="selectedRegionWidth"/>
                        <local:IndicatorVisibilityConverter x:Key="indicatorVisibilityConverter"/>
                        <local:PathVisibilityConverter x:Key="pathVisibilityConverter"/>
                    </ControlTemplate.Resources>
                    <Border ClipToBounds="{TemplateBinding ClipToBounds}" 
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" >
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <local:ChartDockPanel x:Name="PART_CHARTDOCKPANEL" Background="Transparent" ElementMargin="0">
                                <Canvas x:Name="splitter"  local:ChartDockPanel.Dock="Bottom" VerticalAlignment="Stretch" >
                                    <Thumb Height="2" BorderThickness="1"  DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding AxesThickness}"  />
                                </Canvas>
                                <ContentPresenter local:ChartDockPanel.Dock="Top" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0">
                                </ContentPresenter>
                                <local:ChartDockPanel.RootElement>
                                    <local:ChartAreaPresenter ContentTemplate="{StaticResource TimeLineControlCartesianAreaKey}" />
                                </local:ChartDockPanel.RootElement>
                            </local:ChartDockPanel>
                            <Grid Grid.Row="1" Width="{Binding ActualWidth}" Height="16" Visibility="{TemplateBinding ScrollBarVisibility}" >
                                <Border BorderThickness="{TemplateBinding ScrollBarBorderThickness}" BorderBrush="{TemplateBinding ScrollBarBorderBrush}" >
                                    <Grid Background="{TemplateBinding ScrollBarInterior}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <RepeatButton Width="14" Height="15" Template="{TemplateBinding ScrollBarSmallDecreaseTemplate}">
                                        </RepeatButton>


                                        <Grid Grid.Column="1">
                                            <Canvas >
                                                <Grid Width="{TemplateBinding SelectedRegionWidth}" Canvas.Left="{TemplateBinding CanvasLeft, Converter={StaticResource selectedRegionWidth}}">
                                                    <ContentPresenter ContentTemplate="{TemplateBinding ScrollThumbTemplate}"/>
                                                </Grid>
                                            </Canvas>
                                        </Grid>

                                        <RepeatButton Grid.Column="2" Width="14" Height="15" Template="{TemplateBinding ScrollBarSmallIncreaseTemplate}">
                                        </RepeatButton>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


