<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary Source="/Syncfusion.Chart.Wpf;component/Themes/Generic.Common.Converter.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
   

    <DrawingBrush x:Key="BlueWave.ChartBackground">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#FF787878" Geometry="F1 M 204.787,195.981L 804.785,195.981L 804.785,795.981L 204.787,795.981L 204.787,195.981 Z "/>
                    <GeometryDrawing Geometry="F1 M 196.783,188.652L 796.781,188.652L 796.781,788.652L 196.783,788.652L 196.783,188.652 Z ">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0.5,0.999998" EndPoint="0.5,-6.10352e-007">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="#FF043F64" Offset="0"/>
                                    <GradientStop Color="#FF50B6F7" Offset="1"/>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M 196.783,788.549L 796.781,788.549L 796.781,765.861L 196.783,765.861L 196.783,788.549 Z ">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0.5,2.95922e-005" EndPoint="0.5,1.00001">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="#80074469" Offset="0"/>
                                    <GradientStop Color="#80FFFFFF" Offset="1"/>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="F1 M 796.781,188.652L 196.781,188.652L 196.781,214.489L 796.781,214.489L 796.781,188.652 Z ">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0.499999,-0.0452946" EndPoint="0.499999,0.733392">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="#80FFFFFF" Offset="0"/>
                                    <GradientStop Color="#804DB1F2" Offset="1"/>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
  




    <SolidColorBrush Color="Transparent" x:Key="BlueWave.LegendBackground" />
    <SolidColorBrush x:Key="BlueWave.LegendForeground"
                   Color="#3071B0"/>

    <SolidColorBrush x:Key="BlueWave.LegendBorderBackground"
                   Color="#3071B0"/>
    <CornerRadius x:Key="BlueWave.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <SolidColorBrush x:Key="BlueWave.ToolBarBackground" 
                      Color="#D4E2F5"/>
    <LinearGradientBrush x:Key="BlueWave.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#79c5f4" Offset="0"/>
            <GradientStop Color="#595959" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BlueWave.ToolBarBorderBackground" 
                      Color="#3071B0"/>
    <SolidColorBrush x:Key="BlueWave.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="BlueWave.ToolBarItemForeground" 
                      Color="MidnightBlue"/>

    <SolidColorBrush x:Key="BlueWave.ToolBarGlyphColor" 
                      Color="#75B8E2"/>

    <CornerRadius x:Key="BlueWave.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="BlueWave.ToolBarMouseOverBorderBrush" Color="#FFCCECFF"/>


    <LinearGradientBrush x:Key="BlueWave.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#D4E2F5" Offset="0"/>
            <GradientStop Color="#80c8f6" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueWave.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#3376ae" Offset="0"/>
            <GradientStop Color="#D4E2F5" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BlueWave.AreaBackground"
                   Color="Transparent"/>
   
    <Thickness x:Key="BlueWave.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
    <Thickness x:Key="BlueWave.AreaBorderThickness" 
             Bottom="1" Left="1" Right="1" Top="1"/>

    <SolidColorBrush x:Key="BlueWave.AreaGridBackground"
                   Color="#EEF3FF"/>
    
    <Pen Brush="#3071B0" x:Key="BlueWave.AxisPen"/>

    <Style TargetType="{x:Type local:Chart}" x:Key="BlueWaveChartStyle">
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource BlueWave.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="DataContext" Value="{Binding}"/>
    </Style>

    <Pen Brush="#3071B0" x:Key="BlueWaveChartAreaAxisPen"/>

    <Pen  x:Key="BlueWaveSmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#3071B0" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>



    <Style TargetType="{x:Type local:ChartArea}" x:Key="BlueWaveChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource BlueWaveChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource BlueWaveSmallChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource BlueWaveChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource BlueWaveChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource BlueWaveChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{StaticResource BlueWave.AreaBackground}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Padding" Value="{StaticResource BlueWave.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BlueWave.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{x:Null}"/>


    </Style>

    <Style TargetType="{x:Type local:ChartLegend}" x:Key="BlueWaveChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueWave.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BlueWave.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource BlueWave.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource BlueWave.LegendCornerRadius}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="BlueWaveChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueWave.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BlueWave.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource BlueWave.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder" Value="{StaticResource BlueWave.ToolBarMouseOverBackground}" />
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource BlueWave.ToolBarMouseOverBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="BlueWaveToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource BlueWave.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BlueWave.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlueWave.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource BlueWave.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource BlueWave.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource BlueWaveChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource BlueWaveChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource BlueWaveChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource BlueWaveChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource BlueWaveToolBarItemStyle}" />

</ResourceDictionary>    
