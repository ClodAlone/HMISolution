<ResourceDictionary
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!--<local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartNoneArea.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartCartesianArea.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartPolarArea.xaml"/>-->
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartArea.xaml"/>        
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Legend/ChartLegend.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ToolBar/ChartToolBar.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Zooming/ChartZoomingControls.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartAreaContextMenu.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Printing/ChartPrintingControls.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartSeries/ChartSeries.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartSeries/SeriesGUI.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/InteractiveCursor/InteractiveCursor.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/3DChart/CartesianAxis3D.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/3DChart/Chart3DGrid.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/HeatMap/Themes/HeatMap.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/SparkLine/Themes/SparkLine.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/TimeLineControl/Themes/TimeLineControl.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type local:Chart}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Chart}">
                    <ControlTemplate.Resources>
                        <local:ChartAreaCornerRadiusToThicknessConverter x:Key="radiusToThicknessConverter"/>
                        <local:ChartPaddingConverter x:Key="paddingConverter"/>
                    </ControlTemplate.Resources>
                    <Border IsEnabled="{TemplateBinding IsEnabled}"  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="PART_INTERNAL_BORDER">
                        <Border.Padding>
                            <MultiBinding Converter="{StaticResource paddingConverter}" Mode="TwoWay">
                                <Binding Path="Padding" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}" />                               
                            </MultiBinding>
                        </Border.Padding>
                        <AdornerDecorator>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="PART_HEADER" local:ChartDockPanel.Dock="Top" Content="{Binding Header,RelativeSource={RelativeSource TemplatedParent}}"  HorizontalAlignment="{Binding HeaderAlignment,RelativeSource={RelativeSource TemplatedParent}}"  Grid.Row="0" Margin="0,0,0,-3.5"/>
                                <Grid Grid.Row="1">
                                    <local:ChartDockPanel x:Name="PART_ChartDockPanel" Background="Transparent" ClipToBounds="true">
                                        <local:ChartDockPanel.RootElement>
                                            <ItemsControl IsTabStop="False" ItemsPanel="{Binding AreasPanel, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ItemsPresenter/>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                            </ItemsControl>
                                        </local:ChartDockPanel.RootElement>
                                    </local:ChartDockPanel>
                                    <local:ChartAnnotationsPresenter IsTabStop="False" ItemsSource="{Binding AnnotationLabels, RelativeSource={RelativeSource TemplatedParent}}">
                                        <local:ChartAnnotationsPresenter.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas ClipToBounds="True"/>
                                            </ItemsPanelTemplate>
                                        </local:ChartAnnotationsPresenter.ItemsPanel>
                                    </local:ChartAnnotationsPresenter>
                                </Grid>
                                <ContentPresenter x:Name="PART_FOOTER" local:ChartDockPanel.Dock="Bottom" Content="{Binding Footer,RelativeSource={RelativeSource TemplatedParent}}"  HorizontalAlignment="{Binding FooterAlignment,RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="2" Margin="0"/>
                            </Grid>
                        </AdornerDecorator>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
  
</ResourceDictionary>
