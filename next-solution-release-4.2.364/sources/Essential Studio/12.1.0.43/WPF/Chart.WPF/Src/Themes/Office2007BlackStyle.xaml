    <LinearGradientBrush  x:Key="Office2007Black.ChartBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCECFD1" Offset="0"/>
        <GradientStop Color="#FF898C8F" Offset="1"/>
    </LinearGradientBrush>
    
    <SolidColorBrush Color="Transparent" x:Key="Office2007Black.LegendBackground"/>
    <SolidColorBrush x:Key="Office2007Black.LegendForeground"
                   Color="Black"/>
    <SolidColorBrush x:Key="Office2007Black.LegendBorderBackground"
                   Color="#FF5F5F5F"/>
    <CornerRadius x:Key="Office2007Black.LegendCornerRadius" 
                TopLeft="6" BottomLeft="6" BottomRight="6" TopRight="6"/>

    <SolidColorBrush x:Key="Office2007Black.ToolBarBackground" 
                      Color="#afb1b1"/>
    <LinearGradientBrush x:Key="Office2007Black.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#4e4e4e" Offset="0"/>
            <GradientStop Color="#3e3e3e" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Black.ToolBarBorderBackground" 
                      Color="#2c2c2c"/>
    <SolidColorBrush x:Key="Office2007Black.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="Office2007Black.ToolBarItemForeground" 
                      Color="#2c2c2c"/>

    <SolidColorBrush x:Key="Office2007Black.ToolBarGlyphColor" 
                      Color="Transparent"/>

    <CornerRadius x:Key="Office2007Black.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="Office2007Black.ToolBarMouseOverBorderBrush" Color="#2c2c2c"/>


    <LinearGradientBrush x:Key="Office2007Black.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#afb1b1" Offset="0"/>
            <GradientStop Color="#838383" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2007Black.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#333333" Offset="0"/>
            <GradientStop Color="#afb1b1" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007Black.AreaBorderBackground"
                   Color="Transparent"/>
    
    <SolidColorBrush x:Key="Office2007Black.AreaBackground"
                   Color="Transparent"/>
    
  
    
   
    <CornerRadius x:Key="Office2007Black.AreaCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <Thickness x:Key="Office2007Black.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
    <Thickness x:Key="Office2007Black.AreaBorderThickness" 
             Bottom="1" Left="1" Right="1" Top="1"/>
    <Pen Brush="#B1B1B1" x:Key="Office2007Black.AxisPen"/>

    <Style TargetType="{x:Type local:Chart}" x:Key="Office2007BlackChartStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <!--<Setter Property="WindowBackground" Value="{StaticResource Office2007Black.WindowBackground}"/>-->
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Black.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Pen Brush="#B1B1B1" x:Key="Office2007BlackChartAreaAxisPen"/>

    <Pen  x:Key="Office2007BlackSmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#B1B1B1" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>

    <Style TargetType="{x:Type local:ChartArea}" x:Key="Office2007BlackChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource Office2007BlackChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource Office2007BlackSmallChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource Office2007BlackChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource Office2007BlackChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource Office2007BlackChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{StaticResource Office2007Black.AreaBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.AreaBorderBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Office2007Black.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource Office2007Black.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Office2007Black.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>


    </Style>


    <Style TargetType="{x:Type local:ChartLegend}" x:Key="Office2007BlackChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Black.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007Black.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Office2007Black.LegendCornerRadius}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="Office2007BlackChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Black.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Office2007Black.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder" Value="{StaticResource Office2007Black.ToolBarMouseOverBackground}" />
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource Office2007Black.ToolBarMouseOverBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="Office2007BlackToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Office2007Black.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Office2007Black.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Office2007Black.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Office2007Black.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource Office2007BlackChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource Office2007BlackChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource Office2007BlackChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource Office2007BlackChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource Office2007BlackToolBarItemStyle}" />
</ResourceDictionary>    
