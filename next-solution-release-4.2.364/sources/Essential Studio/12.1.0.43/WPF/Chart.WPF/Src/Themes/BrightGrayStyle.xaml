    <LinearGradientBrush x:Key="BrightGray.LegendBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EFEFEF" Offset="0"/>
        <GradientStop Color="#C7C7C7" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrightGray.LegendForeground"
                   Color="#B1B1B1"/>
    
    <SolidColorBrush x:Key="BrightGray.LegendBorderBackground"
                   Color="#6C7278"/>
    <CornerRadius x:Key="BrightGray.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <SolidColorBrush x:Key="BrightGray.ToolBarBackground" 
                      Color="#d3d3d3"/>
    <LinearGradientBrush x:Key="BrightGray.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#bdbdbd" Offset="0"/>
            <GradientStop Color="#7d7d7d" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrightGray.ToolBarBorderBackground" 
                      Color="#6c7278"/>
    <SolidColorBrush x:Key="BrightGray.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="BrightGray.ToolBarItemForeground" 
                      Color="#6c7278"/>

    <SolidColorBrush x:Key="BrightGray.ToolBarGlyphColor" 
                      Color="#696565"/>

    <CornerRadius x:Key="BrightGray.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="BrightGray.ToolBarMouseOverBorderBrush" Color="#FFCCECFF"/>


    <LinearGradientBrush x:Key="BrightGray.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#d3d3d3" Offset="0"/>
            <GradientStop Color="#ababab" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrightGray.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#201f1f" Offset="0"/>
            <GradientStop Color="#d3d3d3" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="BrightGray.AreaBorderBackground"
                   Color="Transparent"/>
    
    <SolidColorBrush x:Key="BrightGray.AreaBackground"
                   Color="Transparent"/>
    
  
    
   
    <CornerRadius x:Key="BrightGray.AreaCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <Thickness x:Key="BrightGray.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
    <Thickness x:Key="BrightGray.AreaBorderThickness" 
             Bottom="1" Left="1" Right="1" Top="1"/>
    <Pen Brush="#B1B1B1" x:Key="BrightGray.AxisPen"/>

    <Style TargetType="{x:Type local:Chart}" x:Key="BrightGrayChartStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrightGray.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BrightGray.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Pen Brush="#B1B1B1" x:Key="BrightGrayChartAreaAxisPen"/>

    <Pen  x:Key="BrightGraySmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#B1B1B1" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>

    <Style TargetType="{x:Type local:ChartArea}" x:Key="BrightGrayChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource BrightGrayChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource BrightGraySmallChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource BrightGrayChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource BrightGrayChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource BrightGrayChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{StaticResource BrightGray.AreaBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrightGray.AreaBorderBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource BrightGray.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource BrightGray.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BrightGray.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{x:Null}"/>

    </Style>

    <Style TargetType="{x:Type local:ChartLegend}" x:Key="BrightGrayChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrightGray.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BrightGray.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource BrightGray.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource BrightGray.LegendCornerRadius}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="BrightGrayChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrightGray.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BrightGray.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource BrightGray.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder" Value="{StaticResource BrightGray.ToolBarMouseOverBackground}" />
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource BrightGray.ToolBarMouseOverBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="BrightGrayToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource BrightGray.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource BrightGray.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrightGray.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource BrightGray.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource BrightGray.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource BrightGrayChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource BrightGrayChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource BrightGrayChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource BrightGrayChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource BrightGrayToolBarItemStyle}" />

</ResourceDictionary>    
