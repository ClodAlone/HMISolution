<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Themes/Generic.Common.Converter.xaml"/>
    </ResourceDictionary.MergedDictionaries>

  



    <LinearGradientBrush x:Key="Luna.Homestead.LegendBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#BAC78F" Offset="0"/>
    <GradientStop Color="#E2EAC3" Offset="0.15"/>
    <GradientStop Color="#E2EAC3" Offset="0.85"/>
    <GradientStop Color="#BAC78F" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Luna.Homestead.WindowBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#BAC78F" Offset="0"/>
    <GradientStop Color="#BAC78F" Offset="1"/>
  </LinearGradientBrush>

  <Pen Brush="#AEB589" x:Key="Luna.Homestead.AxisPen"/>
  
  <SolidColorBrush Color="#C0BFBB" x:Key="Luna.Homestead.BorderBackground"/>
    <SolidColorBrush x:Key="Luna.Homestead.LegendForeground"
                   Color="#AEB589"/>
    <SolidColorBrush Color="#C0BFBB" x:Key="Luna.Homestead.LegendBorderBackground"/>
  <SolidColorBrush Color="White" x:Key="Luna.Homestead.ChartBackground"/>
  <SolidColorBrush Color="#1F00FF00" x:Key="Luna.Homestead.AreaGridBackground"/>

  <CornerRadius x:Key="Luna.Homestead.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <SolidColorBrush x:Key="Luna.Homestead.ToolBarBackground" 
                      Color="#e2eac3"/>
    <LinearGradientBrush x:Key="Luna.Homestead.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#dde6bc" Offset="0"/>
            <GradientStop Color="#c5d19d" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Luna.Homestead.ToolBarBorderBackground" 
                      Color="#9ca86a"/>
    <SolidColorBrush x:Key="Luna.Homestead.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="Luna.Homestead.ToolBarItemForeground" 
                      Color="Black"/>

    <SolidColorBrush x:Key="Luna.Homestead.ToolBarGlyphColor" 
                      Color="#929C70"/>

    <CornerRadius x:Key="Luna.Homestead.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="Luna.Homestead.ToolBarMouseOverBorderBrush" Color="#FFCCECFF"/>


    <LinearGradientBrush x:Key="Luna.Homestead.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#e2eac3" Offset="0"/>
            <GradientStop Color="#bdca94" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Luna.Homestead.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#656e32" Offset="0"/>
            <GradientStop Color="#e2eac3" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>


    <!--<SolidColorBrush Color="#056EAB" x:Key="Aero.NormalColor.AreaBorderBackground"/>-->
  <CornerRadius x:Key="Luna.Homestead.AreaCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
  <Thickness x:Key="Luna.Homestead.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
  <Thickness x:Key="Luna.Homestead.AreaBorderThickness" 
             Bottom="0" Left="0" Right="0" Top="0"/>

    <Style TargetType="{x:Type local:Chart}" x:Key="LunaHomesteadChartStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Luna.Homestead.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Luna.Homestead.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Pen Brush="#AEB589" x:Key="LunaHomesteadChartAreaAxisPen"/>

    <Pen  x:Key="LunaHomesteadSmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#AEB589" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>

    <Style TargetType="{x:Type local:ChartArea}" x:Key="LunaHomesteadChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource LunaHomesteadChartAreaAxisPen}">
        </Setter>

        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource LunaHomesteadSmallChartAreaAxisPen}">
        </Setter>

        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource LunaHomesteadSmallChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource LunaHomesteadChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource LunaHomesteadChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource LunaHomesteadChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Luna.Homestead.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource Luna.Homestead.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Luna.Homestead.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{StaticResource Luna.Homestead.AreaGridBackground}"/>


    </Style>


    <Style TargetType="{x:Type local:ChartLegend}" x:Key="LunaHomesteadChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Luna.Homestead.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Luna.Homestead.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Luna.Homestead.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Luna.Homestead.LegendCornerRadius}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="LunaHomesteadChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Luna.Homestead.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Luna.Homestead.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Luna.Homestead.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder" Value="{StaticResource Luna.Homestead.ToolBarMouseOverBackground}" />
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource Luna.Homestead.ToolBarMouseOverBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="LunaHomesteadToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Luna.Homestead.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Luna.Homestead.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Luna.Homestead.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Luna.Homestead.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Luna.Homestead.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource LunaHomesteadChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource LunaHomesteadChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource LunaHomesteadChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource LunaHomesteadChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource LunaHomesteadToolBarItemStyle}" />


</ResourceDictionary>
