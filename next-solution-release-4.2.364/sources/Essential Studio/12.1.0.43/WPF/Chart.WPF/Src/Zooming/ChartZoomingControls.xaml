<!--Defines the following:
    1) ChartPrintButton Style.
    2) ChartZoomingScrollBar Style.
    3) ChartZoomingToolkit Style.
    -->
<ResourceDictionary
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

  <Style TargetType="{x:Type local:ChartZoomingScrollBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ChartZoomingScrollBar}">
          <ScrollBar x:Name="PART_ScrollBar" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:ChartZoomingToolkit}">
    <Style.Resources>
      <Style x:Key="CommandButtonTemplate" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <ContentPresenter Content="{TemplateBinding Content}"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation To="32" Duration="0:0:0.2"
                    Storyboard.TargetProperty="Width" />
                  <DoubleAnimation To="32" Duration="0:0:0.2"
                    Storyboard.TargetProperty="Height" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Duration="0:0:0.2"
                    Storyboard.TargetProperty="Width" />
                  <DoubleAnimation Duration="0:0:0.2"
                    Storyboard.TargetProperty="Height" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding Path=Parent.(local:ChartZoomingToolkit.ZoomingToolkitVisibility), RelativeSource={RelativeSource TemplatedParent}}" >
            <StackPanel.Resources>
				<local:ChartResourceWrapper x:Key="ChartWrapperResources" />
			</StackPanel.Resources>
            <Button Style="{StaticResource CommandButtonTemplate}"
                      CommandTarget="{Binding Owner, RelativeSource={RelativeSource TemplatedParent}}"
                      Command="{x:Static local:ChartAreaCommands.CancelZooming}"
                      ToolTip="{Binding Source={StaticResource ChartWrapperResources}, Path=Close}"
											Visibility="{Binding Path=Parent.(local:ChartZoomingToolkit.ZoomCloseButtonVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{Binding Path=Owner.(local:ChartZoomingToolkit.ZoomCloseIconTemplate), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Button>
            <Button Style="{StaticResource CommandButtonTemplate}"
                      CommandTarget="{Binding Owner, RelativeSource={RelativeSource TemplatedParent}}"
                      Command="{x:Static local:ChartAreaCommands.ZoomIn}"
                      ToolTip="{Binding Source={StaticResource ChartWrapperResources}, Path=ZoomIn}"
											Visibility="{Binding Path=Parent.(local:ChartZoomingToolkit.ZoomInButtonVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{Binding Path=Owner.(local:ChartZoomingToolkit.ZoomInIconTemplate), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Button>

            <Button Style="{StaticResource CommandButtonTemplate}"
                      CommandTarget="{Binding Owner, RelativeSource={RelativeSource TemplatedParent}}"
                      Command="{x:Static local:ChartAreaCommands.ZoomOut}"
                      ToolTip="{Binding Source={StaticResource ChartWrapperResources}, Path=ZoomOut}"
											Visibility="{Binding Path=Parent.(local:ChartZoomingToolkit.ZoomOutButtonVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{Binding Path=Owner.(local:ChartZoomingToolkit.ZoomOutIconTemplate), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Button>

            <Button Style="{StaticResource CommandButtonTemplate}"
                      CommandTarget="{Binding Owner, RelativeSource={RelativeSource TemplatedParent}}"
                      Command="{x:Static local:ChartAreaCommands.ZoomReset}"
                      ToolTip="{Binding Source={StaticResource ChartWrapperResources}, Path=ResetZoom}"
											Visibility="{Binding Path=Parent.(local:ChartZoomingToolkit.ZoomResetButtonVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{Binding Path=Owner.(local:ChartZoomingToolkit.ZoomResetIconTemplate), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Button>

            <Button Style="{StaticResource CommandButtonTemplate}" 
                      CommandTarget="{Binding Owner,RelativeSource={RelativeSource TemplatedParent}}"
                      Command="{x:Static local:ChartAreaCommands.ZoomPanning}"
                      ToolTip="{Binding Source={StaticResource ChartWrapperResources}, Path=Panning}"
                                           Visibility="{Binding Path=Parent.(local:ChartZoomingToolkit.ZoomPanningButtonVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{Binding Path=Owner.(local:ChartZoomingToolkit.ZoomPanningIconTemplate), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Button>
                    </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>