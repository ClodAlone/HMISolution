<UserControl x:Class="Syncfusion.Windows.Chart.ChartAxisPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Syncfusion.Windows.Chart" Loaded="UserControl_Loaded"             
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"  xmlns:sync="clr-namespace:Syncfusion.Windows.Tools;assembly=Syncfusion.Shared.Wpf" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
    >
    <UserControl.Resources>
        <local:AxisTypeToEnabledConverter x:Key="AxisTypeToEnabledConverterKey"/>
        <local:ChartResourceWrapper x:Key="ResourceWrapper"/>
        <local:ChartAxisNameConverter  x:Key="ChartAxisNameConverterKey"/>
        <local:PropertyDialogHeaderConverter x:Key="PropertyDialogHeaderConverterKey"/>
        <local:BrushToPenConverter x:Key="BrushToPenConverter1"/>
        <local:BrushToPenConverter x:Key="BrushToPenConverter2"/>
        <local:BrushToPenConverter x:Key="BrushToPenConverter3"/>
       
    </UserControl.Resources>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Width="340" HorizontalAlignment="Left" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Margin="0,5,5,0" >
                    <GroupBox.Header>
                        <StackPanel Orientation="Vertical">
                            <Label Content="{Binding Source={StaticResource ResourceWrapper}, Path=SelectChartAxis}" Margin="0,0,0,0"  FontSize="16" />
                        </StackPanel>
                    </GroupBox.Header>
                    <ComboBox Name="AxisNo" Margin="50,10,50,5" ItemsSource="{Binding Axes, Converter={StaticResource ChartAxisNameConverterKey}}" DisplayMemberPath="Name" SelectedIndex="0"></ComboBox>
                </GroupBox>

                <GroupBox Grid.Row="1" Margin="0,0,5,0" DataContext="{Binding ElementName=AxisNo, Path=SelectedItem}" >
                    <GroupBox.Header>
                        <StackPanel Orientation="Vertical">
                            <Label Content="{Binding Source={StaticResource ResourceWrapper}, Path=Settings}" Margin="0,0,0,0"  FontSize="16" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Expander Grid.Row="0" Margin="0,5,5,0">
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=AxisType}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=ValueType}" HorizontalAlignment="Left" Grid.Column="0"></Label>
                                <ComboBox x:Name="ValueTypeComboBox" Grid.Column="1" SelectedItem="{Binding ValueType, Mode=TwoWay}"/>
                                <!--<CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="5,0,0,0" Content="{Binding Source={StaticResource ResourceWrapper}, Path=IsLograthimic}" IsChecked="{Binding SelectedModel.IsLograthimic, Mode=TwoWay}" VerticalAlignment="Center" />-->
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LograthimicRange}" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Lograthimic}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LogarithmicRange, Mode=TwoWay}" Grid.Row="2" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Lograthimic}"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LograthimicBase}" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Lograthimic}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LogarithmicBase, Mode=TwoWay}" Grid.Row="3" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Lograthimic}"/>
                                <Label  VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=DateTimeRange}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = DateTime}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding DateTimeRange, Mode=TwoWay}" Grid.Row="4" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = DateTime}"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=DateTimeInterval}" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = DateTime}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding DateTimeInterval, Mode=TwoWay}" Grid.Row="5" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = DateTime}"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelDateTimeFormat}" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = DateTime}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LabelDateTimeFormat, Mode=TwoWay}"  ToolTip="[Provide any Format Specifiers like 'd', 'M', etc.]" Grid.Row="6" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = DateTime}"/>
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="1" Margin="0,5,5,0">
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=AxisPosition}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Row="0" Margin="3,0,0,0" Grid.ColumnSpan="2" Content="{Binding Source={StaticResource ResourceWrapper}, Path=OpposedPosition}" VerticalAlignment="Center" IsChecked="{Binding OpposedPosition, Mode=TwoWay}" />
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=Orientation}" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1"></Label>
                                <ComboBox x:Name="OrientationCombo" Grid.Column="1" Grid.Row="1" SelectedItem="{Binding Orientation, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=Origin}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding Origin, Mode=TwoWay}" Grid.Row="2"/>

                               
                                </Grid>
                        </Expander>
                        <Expander Grid.Row="2" Margin="0,5,5,0">
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=AxisHeader}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=Header}" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0"></Label>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Header, Mode=TwoWay, Converter={StaticResource PropertyDialogHeaderConverterKey}}" VerticalAlignment="Center" />
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=HeaderAlignment}" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"></Label>
                                <ComboBox x:Name="HeaderAlignmentCombo" Grid.Column="1" SelectedItem="{Binding HeaderAlignment, Mode=TwoWay}" Grid.Row="1"/>


                            </Grid>
                        </Expander>
                        <Expander Grid.Row="3" Margin="0,5,5,0">
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <Label Content="{Binding Source={StaticResource ResourceWrapper}, Path=RangeAndInterval}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Margin="3,0,0,0" Content="{Binding Source={StaticResource ResourceWrapper}, Path=AutoSetRange}" IsChecked="{Binding IsAutoSetRange, Mode=TwoWay}" VerticalAlignment="Center" />
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=Range}" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding Range, Mode=TwoWay}" Grid.Row="1" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=RangeCalculationMode}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <ComboBox Grid.Column="1" x:Name="RangeCalculationModeCombo" SelectedItem="{Binding RangeCalculationMode, Mode=TwoWay}" Grid.Row="2"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=RangePadding}" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0"></Label>
                                <ComboBox Grid.Column="1" x:Name="ChartRangePaddingTypeCombo" SelectedItem="{Binding RangePadding, Mode=TwoWay}" Grid.Row="3"/>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=Interval}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding Interval, Mode=TwoWay}" Grid.Row="4" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}" />
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=DesiredIntervalCount}" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="0" IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding DesiredIntervalsCount, Mode=TwoWay}" Grid.Row="5"  IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"/>
                                <CheckBox Grid.Row="6" Margin="3,0,0,0" Grid.ColumnSpan="2" Content="{Binding Source={StaticResource ResourceWrapper}, Path=EnableZooming}" IsChecked="{Binding EnableZooming, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="4" Margin="0,5,5,0">
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=LabelSettings}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelForeground}" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Grid.Column="1" Grid.Row="0"  Brush="{Binding LabelForeground, Mode=TwoWay}"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelBackground}" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Grid.Column="1" Grid.Row="1"  Brush="{Binding LabelBackground, Mode=TwoWay}"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelBorderBrush}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Grid.Column="1" Grid.Row="2"  Brush="{Binding LabelBorderBrush, Mode=TwoWay}"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelBorderThickness}" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LabelBorderThickness, Mode=TwoWay}" Grid.Row="3"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelCornerRadius}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LabelCornerRadius, Mode=TwoWay}" Grid.Row="4"/>

                                <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Margin="3,0,0,0" Content="{Binding Source={StaticResource ResourceWrapper}, Path=HidePartialLabels}" IsChecked="{Binding HidePartialLabel, Mode=TwoWay}" VerticalAlignment="Center" />

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=IntersectAction}" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="0"></Label>
                                <ComboBox Grid.Column="1" x:Name="ChartLabelIntersectAction" SelectedItem="{Binding IntersectAction, Mode=TwoWay}" Grid.Row="6"/>

                                <Label  VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelFormat}" HorizontalAlignment="Left" Grid.Row="7" Grid.Column="0"  IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LabelFormat, Mode=TwoWay}" Grid.Row="7"  IsEnabled="{Binding ElementName = ValueTypeComboBox, Path=SelectedItem, Mode=OneWay, Converter={StaticResource AxisTypeToEnabledConverterKey}, ConverterParameter = Double}"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelRotateAngle}" HorizontalAlignment="Left" Grid.Row="8" Margin="0,2,0,25" Grid.RowSpan="2" Width="103.497"></Label>
                                <TextBox Grid.Column="1" Text="{Binding LabelRotateAngle, Mode=TwoWay}" Grid.Row="8"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LabelsMode}" HorizontalAlignment="Left" Grid.Row="9" Grid.Column="0"></Label>
                                <ComboBox Grid.Column="1" x:Name="ChartAxisLabelsModeCombo" SelectedItem="{Binding LabelsMode, Mode=TwoWay}" Grid.Row="9"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=EdgeLabelDrawingMode}" HorizontalAlignment="Left" Grid.Row="10" Grid.Column="0"></Label>
                                <ComboBox Grid.Column="1" x:Name="EdgeLabelDrawingModeCombo" SelectedItem="{Binding EdgeLabelsDrawingMode, Mode=TwoWay}" Grid.Row="10"/>
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="5"  BorderThickness="0" Margin="0,5,5,0" >
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=Appearance}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />                                   
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=LineStroke}" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker x:Name="LineStroke" Grid.Column="1" Grid.Row="0" Brush="{Binding LineStroke, Mode=TwoWay, Converter={StaticResource BrushToPenConverter1}}" />

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=SmallTickLinesStroke}" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker x:Name="SmallTickLineStroke" Grid.Column="1" Grid.Row="1" Brush="{Binding SmallTickLineStroke, Mode=TwoWay, Converter={StaticResource BrushToPenConverter2}}" />

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=SmallTickSize}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding SmallTickSize, Mode=TwoWay}" Grid.Row="2"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=SmallTicksPerInterval}" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding SmallTicksPerInterval, Mode=TwoWay}" Grid.Row="3"/>

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=TickLineStroke}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker x:Name="TickLineStroke" Grid.Column="1" Grid.Row="4" Brush="{Binding TickLineStroke, Mode=TwoWay, Converter={StaticResource BrushToPenConverter3}}" />

                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=TickSize}" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" Text="{Binding TickSize, Mode=TwoWay}" Grid.Row="5"/>
                                
                            </Grid>
                        </Expander>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

    
