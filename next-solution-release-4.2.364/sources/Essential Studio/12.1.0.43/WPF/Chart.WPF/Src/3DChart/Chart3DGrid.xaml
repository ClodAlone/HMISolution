<ResourceDictionary
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <local:ChartAxisTypeConverter x:Key="ChartAxisPositionConverter"/>

    <Style TargetType="{x:Type local:Chart3DGrid}">
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Chart3DGrid}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Chart3DTemplateKey">
        <Grid x:Name="grid">
            <!--<Line Stroke="Black" StrokeThickness="3" X1="-278" Y1="259" X2="97" Y2="259"></Line>-->
            <!--<Border>-->
            <Viewport3D x:Name="ChartViewport3D" Grid.Column="0"  Grid.Row="0" Camera="{Binding Camera3D}" ClipToBounds="True">
                <Viewport3D.Children>
                    <ModelVisual3D Content="{Binding AxisContent}"/>
                    <ModelVisual3D Content="{Binding GridContent}"/>
                    <ModelVisual3D Content="{Binding Labels3DContent}"/>
                    <ModelVisual3D Content="{Binding LightContent}"/>
                    <ModelVisual3D Content="{Binding Content3D}"/>
                </Viewport3D.Children>
            </Viewport3D>
            <!--<Canvas x:Name="canvas" Grid.Column="0"  Grid.Row="0"></Canvas>-->
            <!--</Border>-->
        </Grid>
    </DataTemplate>

</ResourceDictionary>
