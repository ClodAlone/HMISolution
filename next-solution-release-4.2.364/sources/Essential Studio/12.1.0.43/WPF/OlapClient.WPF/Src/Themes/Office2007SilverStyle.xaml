<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"   
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Client.Olap">

    <LinearGradientBrush x:Key="HeaderMouseOverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDECA9" Offset="0.007"/>
        <GradientStop Color="#FFFDE388" Offset="0.069"/>
        <GradientStop Color="#FFFDE387" Offset="0.917"/>
        <GradientStop Color="#FFFDF1BF" Offset="0.979"/>
        <GradientStop Color="#FFFDF8DE" Offset="0.993"/>
    </LinearGradientBrush>

    <Style TargetType="{x:Type local:OlapClient}">
        <Setter Property="Background" Value="#FFEEEFF3"/>
        <Setter Property="BorderBrush" Value="#FFC6C6C6"/>
        <Setter Property="HeaderBackground" Value="#FFEEEFF3"/>
        <Setter Property="HeaderBorderBrush" Value="#FFA9B1B8"/>
        <Setter Property="HeaderMouseOverBackground" Value="{StaticResource HeaderMouseOverBackgroundBrush}"/>
        <Setter Property="HeaderMouseOverBorderBrush" Value="#FFF1CA58"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    
</ResourceDictionary>
