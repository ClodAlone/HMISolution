<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"   
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Client.Olap">

    <LinearGradientBrush x:Key="HeaderMouseOverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF4CC" Offset="0"/>
        <GradientStop Color="#FFFFEDA6" Offset="0.03"/>
        <GradientStop Color="#FFFFE178" Offset="0.298"/>
        <GradientStop Color="#FFFFE275" Offset="0.576"/>
        <GradientStop Color="#FFFFFBDF" Offset="0.97"/>
    </LinearGradientBrush>

    <Style TargetType="{x:Type local:OlapClient}">
        <Setter Property="Background" Value="#FF808080"/>
        <Setter Property="BorderBrush" Value="#FF3B3B3B"/>
        <Setter Property="HeaderBackground" Value="#FFEFF1F4"/>
        <Setter Property="HeaderBorderBrush" Value="#FF3B3B3B"/>
        <Setter Property="HeaderMouseOverBackground" Value="{StaticResource HeaderMouseOverBackgroundBrush}"/>
        <Setter Property="HeaderMouseOverBorderBrush" Value="#FFF3C84B"/>
        <Setter Property="Foreground" Value="#FF1E395B"/>
    </Style>
</ResourceDictionary>
