<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"   
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Client.Olap">

    <LinearGradientBrush x:Key="HeaderMouseOverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <Style TargetType="{x:Type local:OlapClient}">
        <Setter Property="Background" Value="#4CFFFFFF"/>
        <Setter Property="BorderBrush" Value="#FF535353"/>
        <Setter Property="HeaderBackground" Value="#64FFFFFF"/>
        <Setter Property="HeaderBorderBrush" Value="#FF535353"/>
        <Setter Property="HeaderMouseOverBackground" Value="{StaticResource HeaderMouseOverBackgroundBrush}"/>
        <Setter Property="HeaderMouseOverBorderBrush" Value="#FF535353"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

</ResourceDictionary>
