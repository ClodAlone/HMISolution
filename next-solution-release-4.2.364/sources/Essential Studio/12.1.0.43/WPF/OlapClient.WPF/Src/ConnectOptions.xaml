<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Client.Olap.ConnectOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:resource="clr-namespace:Syncfusion.Windows.Client.Olap.Resources"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="{Binding ElementName=textBlockTitle, Path=Text}" Icon="App.ico" 
    WindowStartupLocation="CenterScreen" 
    Height="420" Width="450" MinHeight="200" MinWidth="400"
    ResizeMode="NoResize"
    Name="connectOptionWindow">
    <syncfusion:ChromelessWindow.Resources>
        <resource:ConnectionDialogResourceWrapper x:Key="ResourceWrapperKeys" />
    </syncfusion:ChromelessWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Since, Resource wrapper is added as resource of the window. We can't bind the title directly. 
            So, we are binding this text block with the title. The Title will bind to this text block-->
        <TextBlock x:Name="textBlockTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectOptionsDlgTitle}" Visibility="Collapsed" />

        <Border Grid.Row="0" CornerRadius="8"  BorderThickness="1" >
            <TextBlock HorizontalAlignment ="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgHeader}" />
        </Border>
        <GroupBox Grid.Row="1" Width="435" BorderThickness="1" BorderBrush="DarkGray" Margin="0,0,0,5">
            <GroupBox.Header>
                <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgDataSourceHeader}" FontSize="14" FontWeight="Bold"/>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <!--<CheckBox Grid.Row="1" Margin="11,4,2,2" Name="chkSyncfusionSampleSource"  Checked="chkSyncfusionSampleSource_Checked" Unchecked="chkSyncfusionSampleSource_Unchecked">
                    <TextBlock Text="Syncfusion sample source"  VerticalAlignment="Top" FontSize="14"  Height="20" />
                </CheckBox>-->
                <StackPanel Grid.Row="0"  Name="stpCustomDatasource" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2,2,2,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition/>

                        </Grid.RowDefinitions>
                    </Grid>
                    <GroupBox Grid.Row="0" BorderThickness="1" Width="420" BorderBrush="Gray">
                        <GroupBox.Header>
                            <RadioButton Name="chkCustomOfflineCube" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgOfflineCubeHeader}" Checked="chkCustomOfflineCube_Checked" Unchecked="chkCustomOfflineCube_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdCustomOfflineCube">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="2,2,2,2" Name="txtOfflineCubeFilePath" Grid.Column="0" IsReadOnly="True" />
                            <Button Margin="2,2,2,2" Name="btnBrowser" Grid.Column="1" Content="Browse" Click="btnBrowser_Click" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Margin="0,0,0,5" BorderThickness="1" Width="420" BorderBrush="Gray">
                        <GroupBox.Header>
                            <RadioButton Name="chkCutomServer" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgServerHeader}" Checked="chkCutomServer_Checked" Unchecked="chkCutomServer_Unchecked"/>
                        </GroupBox.Header>
                        <StackPanel Name="stpCutomServer">
                            <Grid Name="grdCustomSampleServer">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="2,2,2,2" Grid.Row="0" Grid.Column="0" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgServerName}"/>
                                <ComboBox Margin="2,2,2,2" Grid.Row="0" Grid.Column="1" Name="cmbServerName" IsEditable="True"/>
                                <TextBlock Margin="2,2,2,2" Grid.Row="1" Grid.Column="0" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgDatabaseName}"/>
                                <ComboBox Margin="2,2,2,2"  Grid.Row="1" Grid.Column="1" Name="cmbDatabaseName" IsEditable="True"/>
                            </Grid>
                            <Expander Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgCredential}" IsExpanded="False" Name="CredentialExpander"  Expanded="Expander_Expanded" Collapsed="CredentialExpander_Collapsed" >
                                <GroupBox Grid.Row="2" Margin="0,6,0,9" Height="72" BorderThickness="1" Width="400" BorderBrush="DarkGray" >
                                    <GroupBox.Header>
                                        <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgEnterCredentialHeader}" />
                                    </GroupBox.Header>
                                    <Grid Name="userInfoContainer">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="3,2,3,2" Grid.Row="0" Grid.Column="0" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgUserName}"/>
                                        <TextBox Margin="3,2,3,2" Grid.Row="0" Grid.Column="1" Name="txtUsername"/>
                                        <TextBlock Margin="3,2,3,2" Grid.Row="1" Grid.Column="0" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgPassword}"/>
                                        <PasswordBox Margin="3,2,3,2"  Grid.Row="1" Grid.Column="1" Name="txtPassword"/>
                                    </Grid>
                                </GroupBox>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                <GroupBox Grid.Row="1" BorderThickness="1" Width="420" BorderBrush="Gray">
                    <GroupBox.Header>
                        <RadioButton Name="chkCustomConnectionString" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgConnectionStringHeader}" Checked="chkCustomConnectionString_Checked" Unchecked="chkCustomConnectionString_Unchecked" />
                    </GroupBox.Header>
                    <Grid Name="grdconnectionString">
                        <TextBox Margin="2,2,2,2" Name="txtconnectionString" TextWrapping="WrapWithOverflow" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxLines="100"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="2" BorderThickness="1" Width="420" BorderBrush="Gray" Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderNameHeader}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <RadioButton x:Name="providerSSAS" GroupName="providerName" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderSSAS}" ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderSSASToolTip}" Margin="2" IsChecked="True" />
                        <RadioButton x:Name="providerMondrian" GroupName="providerName" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderMondrian}" ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderMondrianToolTip}" Margin="2" />
                        <RadioButton x:Name="providerActivePivot" GroupName="providerName" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderActivePivot}" ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgProviderActivePivotToolTip}" Margin="2" />
                    </StackPanel>
                </GroupBox>
                <Grid Grid.Row="3">
                    <Button Margin="2,5,90,0" Name="btnOkay" Width="60" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgOk}" HorizontalAlignment="Right" Click="btnOkay_Click" IsDefault="True"/>
                    <Button Margin="2,5,5,0" Name="btnCancel" Width="75" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientConnectDlgCancel}" HorizontalAlignment="Right" Click="btnCancel_Click" IsCancel="True"/>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</syncfusion:ChromelessWindow>