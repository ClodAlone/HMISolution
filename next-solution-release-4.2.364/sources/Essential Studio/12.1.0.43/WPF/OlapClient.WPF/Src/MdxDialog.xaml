<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Client.Olap.MdxDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:resource="clr-namespace:Syncfusion.Windows.Client.Olap.Resources"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Title="{Binding ElementName=textBlockTitle, Path=Text}" Icon="/Syncfusion.OlapClient.WPF;component/Images/MdxDialog.png" ResizeMode="NoResize"
             WindowStartupLocation="CenterScreen"
             mc:Ignorable="d" Width="500" Height="350">

    <syncfusion:ChromelessWindow.Resources>
        <resource:MdxQueryDialogResourceWrapper x:Key="ResourceWrapperKeys" />
    </syncfusion:ChromelessWindow.Resources>
    
    <Grid x:Name="LayoutRoot">
        <TextBlock x:Name="textBlockTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientMdxDlgQueryTitle}" Visibility="Collapsed" />
        <Border BorderThickness="1" BorderBrush="Black" Margin="5,5,5,20" CornerRadius="5" VerticalAlignment="Top">
            <TextBox IsReadOnly="True" x:Name="mdxQueryBox" TextWrapping="Wrap" Height="265" />
        </Border>
        <Button VerticalAlignment="Bottom" Height="25" Width="100" Margin="360,0,0,5" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientMdxQueryDlgOk}" Click="OK_Button_Click" />
    </Grid>
</syncfusion:ChromelessWindow>
