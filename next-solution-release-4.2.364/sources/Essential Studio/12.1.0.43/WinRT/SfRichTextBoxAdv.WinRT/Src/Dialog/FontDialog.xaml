<shared:WindowControl x:Class="Syncfusion.UI.Xaml.Controls.FontDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="fontDialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" AnimationType="None" VisualStyle="Aero"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" WindowStartupLocation="CenterScreen" Width="410" Height="405"
    xmlns:interact="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:local="clr-namespace:Syncfusion.UI.Xaml.Controls"
    xmlns:shared1="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WinRT" TitleBarBackground="Blue"
    mc:Ignorable="d" xmlns:shared="clr-namespace:Syncfusion.UI.Xaml.Controls;assembly=Syncfusion.Shared.WinRT"
    Title="Font" ResizeMode="NoResize" IconSize="0,0" >
	<shared:WindowControl.Resources>

		<LinearGradientBrush x:Key="ColorPickerPaletteBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
			<GradientStop Color="#FFD3E1F0" Offset="0.251"/>
			<GradientStop Color="#FFBED5F4" Offset="0.757"/>
			<GradientStop Color="#FFC0D4ED" Offset="0.484"/>
		</LinearGradientBrush>

		<SolidColorBrush x:Key="ColorPickerPaletteBorderBrushKey" Color="#FF9BB9DF"/>

		<SolidColorBrush x:Key="ColorPickerPaletteAutoBoderBrushKey" Color="#FFD8ECFE"/>
		<SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1BrushKey" Color="#FFD8ECFE"/>

		<SolidColorBrush x:Key="ColorPickerPaletteAutoBackgroundBrushKey" Color="#FFFFE7A2"/>



		<LinearGradientBrush x:Key="ColorPickerPaletteMoreColorBackgroundBrushKey" EndPoint=".5,1" StartPoint=".5,0">
			<GradientStop Color="#FFFFFFFF" Offset="0"/>
			<GradientStop Color="#FFFFFFFF" Offset="0.54"/>
			<GradientStop Color="#FFFFFFFF" Offset="0.971"/>
			<GradientStop Color="#FFFFFFFF" Offset="0.427"/>

		</LinearGradientBrush>



		<shared:SizeToDoubleConverter x:Key="SizeToDoubleConverterKey"/>

		<SolidColorBrush x:Key="ColorPickerPalettePopupBorderBrushKey" Color="#FF868686"/>



		<LinearGradientBrush x:Key="ColorPickerPaletteAutomaticColorBackgroundBrushKey" EndPoint=".5,1" StartPoint=".5,0">
			<GradientStop Color="#FFFFFFFF" Offset="0"/>
			<GradientStop Color="#FFFFFFFF" Offset="0.54"/>
			<GradientStop Color="#FFFFFFFF" Offset="0.971"/>
			<GradientStop Color="#FFFFFFFF" Offset="0.427"/>

		</LinearGradientBrush>



		<SolidColorBrush x:Key="ColorPickerPaletteAutoBoderMouseOverBrushKey" Color="Orange"/>

		<SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1MouseOverBrushKey" Color="#FFFFFFE6"/>

		<LinearGradientBrush x:Key="ColorPickerPaletteAutomaticColorMouseOverBrushKey" EndPoint=".5,1" StartPoint=".5,0">
			<GradientStop Color="#FFFEF8E1" Offset="0"/>
			<GradientStop Color="#FFFCDE93" Offset="0.54"/>
			<GradientStop Color="#FFFFDD83" Offset="0.971"/>
			<GradientStop Color="#FFFFF6D3" Offset="0.427"/>

		</LinearGradientBrush>

		<SolidColorBrush x:Key="ColorPickerPaletteAutoBoderSelectedBrushKey" Color="Orange"/>

		<SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1SelectedBrushKey" Color="#FFFFFFE6"/>

		<LinearGradientBrush x:Key="ColorPickerPaletteMoreColorMouseOverBrushKey" EndPoint=".5,1" StartPoint=".5,0">
			<GradientStop Color="#FFFEF8E1" Offset="0"/>
			<GradientStop Color="#FFFCDE93" Offset="0.54"/>
			<GradientStop Color="#FFFFDD83" Offset="0.971"/>
			<GradientStop Color="#FFFFF6D3" Offset="0.427"/>

		</LinearGradientBrush>


		<LinearGradientBrush x:Key="ColorPickerPaletteMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
			<GradientStop Color="#FFFFDD83" Offset="0.251"/>
			<GradientStop Color="#FFFFF6D3" Offset="0.757"/>
			<GradientStop Color="#FFFFDD83" Offset="0.484"/>
		</LinearGradientBrush>

		<SolidColorBrush x:Key="ColorPickerPaletteMouseOverBorderBrushKey" Color="#FFD0B989"/>


		<SolidColorBrush x:Key="ColorPickerUpDownMouseOverBorderBrushKey" Color="#FFD0B989"/>

		<LinearGradientBrush x:Key="ColorPickerUpDownMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
			<GradientStop Color="#FFF6E4B4" Offset="0.835"/>
			<GradientStop Color="#FFFCEFBD" Offset="0.129"/>
			<GradientStop Color="#FFFCCD52" Offset="0.5"/>
		</LinearGradientBrush>

	</shared:WindowControl.Resources>
    
    <StackPanel Background="#FFF0F0F0"  Margin="-2,-4,-2,-2" Height="505">
        <Border Background="#FFFFFFFF" BorderBrush="#FF898C95" BorderThickness="1.5" CornerRadius="0" Margin="0,0,0,8">
       
            <Grid x:Name="LayoutRoot" Background="#FFFFFFFF" Margin="-1,-1,0,0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" >
                        <TextBlock Text="Font:" Width="150" FontSize="12" Grid.Column="0" Margin="5,5,5,0" FontWeight="Bold"/>
                        <TextBox  Name="txtfontfamily" Margin="5,5,5,0" Width="150" Text="{Binding ElementName=lstfontFamily,Path=SelectedValue.Content, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                   />
                        <ListBox x:Name="lstfontFamily" Height="100" SelectedIndex="0" Width="150" Margin="5,0,5,5" FontFamily="Times New Roman" >
                            <ListBoxItem>Verdana</ListBoxItem>
                            <ListBoxItem>Calibri</ListBoxItem>
                            <ListBoxItem>Arial</ListBoxItem>
                            <ListBoxItem>Arial Black</ListBoxItem>
                            <ListBoxItem>Georgia</ListBoxItem>
                            <ListBoxItem>Courier New</ListBoxItem>
                            <ListBoxItem>Comic Sans MS</ListBoxItem>
                            <ListBoxItem>Calibri</ListBoxItem>
                            <ListBoxItem>Times New Roman</ListBoxItem>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Font Styles:" Width="100" FontSize="12" Margin="5,5,5,0" FontWeight="Bold"/>
                        <TextBox Margin="5,5,5,0" Width="100" Text="{Binding Path=SelectedValue.Content,ElementName=lstfontstyle,Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                 Name="txtfontstyle" />
                        <ListBox Height="100" Width="100" SelectedIndex="0" Name="lstfontstyle">
                            <ListBoxItem Content="Regular" Name="regularitem"/>
                            <ListBoxItem Content="Bold" Name="bolditem"/>
                            <ListBoxItem Content="Italic" Name="italicitem"/>
                            <ListBoxItem Content="Bold Italic" Name="bolditalicitem"/>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Size:" Grid.Column="2" FontSize="12" Margin="5,5,5,0" FontWeight="Bold"/>
                        <TextBox Grid.Column="2" Margin="5,5,13,0" Text="{Binding Path=SelectedValue.Content,ElementName=lstfontsize,Mode=TwoWay}" Name="txtfontsize"/>
                        <ListBox  Height="100" Grid.Column="2" SelectedIndex="3" Margin="5,0,13,5" Name="lstfontsize">
                            <ListBoxItem>8</ListBoxItem>
                            <ListBoxItem>9</ListBoxItem>
                            <ListBoxItem>10</ListBoxItem>
                            <ListBoxItem>11</ListBoxItem>
                            <ListBoxItem>12</ListBoxItem>
                            <ListBoxItem>14</ListBoxItem>
                            <ListBoxItem>16</ListBoxItem>
                            <ListBoxItem>18</ListBoxItem>
                            <ListBoxItem>20</ListBoxItem>
                            <ListBoxItem>22</ListBoxItem>
                            <ListBoxItem>24</ListBoxItem>
                            <ListBoxItem>26</ListBoxItem>
                            <ListBoxItem>28</ListBoxItem>
                            <ListBoxItem>36</ListBoxItem>
                            <ListBoxItem>48</ListBoxItem>
                            <ListBoxItem>72</ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" HorizontalAlignment="Left">
                    <TextBlock Text="Font Color:" Width="94" Margin="10,23,5,22" FontSize="12" FontWeight="Bold" Height="20" />
                    <shared:ColorPickerPalette x:Name="fontcolorpicker" Height="25" Width="170" Margin="10,5,20,5" 
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" PopupHeight="100" PopupWidth="165" StandardPanelVisibility="Collapsed" CustomHeaderVisibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border BorderBrush="#FF898C95" BorderThickness="0,1,0,0" Grid.Row="2">
                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Effects" FontWeight="Bold" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
					<Grid Grid.Row="1" Margin="5">
						 <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							 <RowDefinition Height="30"/>
                        	 <RowDefinition Height="30"/>
						</Grid.RowDefinitions>
                    	<CheckBox Margin="30,3,3,3"  x:Name="chksingle" Content="SingleStrikeThrough" Checked="OnSingleChecked"  />
                    	<CheckBox Margin="30,3,3,3" x:Name="chkdouble" Grid.Row="1" Content="DoubleStrikeThrough" Checked="OnDoubleChecked" />
                    	<CheckBox Margin="30,3,3,3" Content="Superscript" Grid.Column="1" Name="chksuperscript" Checked="OnSuperscriptChecked"/>
                    	<CheckBox Margin="30,3,3,3" Content="Subscript" Name="chksubscript" Grid.Row="1" Grid.Column="1" Checked="OnSubscriptChecked" />
					</Grid>
                </Grid>
            </Border>
            </Grid>
     
        </Border>
        <Grid HorizontalAlignment="Right" Margin="5,2,7,5" VerticalAlignment="Center" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"></ColumnDefinition>
                 <ColumnDefinition Width="84"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Content="OK" Width="75" Grid.Column="0"  HorizontalAlignment="left" Click="btnAccept_Click" ></Button>
            <Button Name="btnAccept" Grid.Column="1" Content="Cancel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="75" Margin="4,0,4,0" Click="Button_Click"/>
        </Grid>
    </StackPanel>
    
</shared:WindowControl>
