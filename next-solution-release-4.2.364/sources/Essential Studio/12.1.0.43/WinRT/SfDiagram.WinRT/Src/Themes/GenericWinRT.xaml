  <Style x:Key="PivotThumbStyle" TargetType="localControls:DiagramThumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="localControls:DiagramThumb">
          <Border
    Background="{TemplateBinding Background}"
    BorderBrush="{TemplateBinding BorderBrush}"
    BorderThickness="{TemplateBinding BorderThickness}" Width="25" Height="25" RenderTransformOrigin="0.5,0.5" Opacity="0.6" x:Name="thumb">

            <Border.RenderTransform>
              <ScaleTransform></ScaleTransform>
            </Border.RenderTransform>
            <Grid>
              <Ellipse Fill="#4288DB"  StrokeThickness="8" Stroke="Transparent"></Ellipse>
