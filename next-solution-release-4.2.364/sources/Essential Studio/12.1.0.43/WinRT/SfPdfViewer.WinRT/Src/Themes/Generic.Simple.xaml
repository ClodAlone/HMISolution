<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syncfusion.Windows.PdfViewer">

    <Style TargetType="local:SfPdfViewerControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SfPdfViewerControl">
                    <Grid x:Name="ViewerGrid">

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PdfDocumentView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PdfDocumentView">
                    <Grid x:Name="PdfDocumentGrid">
                        <ScrollViewer x:Name="documentScrollViewer" Margin="0,0,0,0" HorizontalScrollBarVisibility="Visible" HorizontalScrollMode="Enabled" MaxZoomFactor="3" MinZoomFactor="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" x:Name="PdfStackPanel">
                                <Canvas x:Name="PdfDocumentPanel">

                                </Canvas>
                                <Canvas x:Name="PrintPanel" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
