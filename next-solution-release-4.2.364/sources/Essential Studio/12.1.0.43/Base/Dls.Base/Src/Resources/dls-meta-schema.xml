<?xml version="1.0" encoding="utf-8" ?> 
<m:meta-schema xmlns:m="http://tempuri.org/DLSMetaSchema.xsd">
  <!-- root element -->
  <m:root name="DLS" type="Document"/>
  <!-- entities -->
  <m:type name="Document">
    <m:element name="image" type="string" />
    <m:group name="styles" item="style" type="Style"/>
    <m:group name="liststyles" item="style" type="ListStyle"/>
    <m:group name="sections" item="section" type="Section"/>
  </m:type>
  <m:type name="Column">
    <m:attribute name="Width" type="float"/>
    <m:attribute name="Spacing" type="float"/>
  </m:type>
  <m:type name="HeadersFooters">
    <m:element name="even-header" type="TextBody"/>
    <m:element name="odd-header" type="TextBody"/>
    <m:element name="even-footer" type="TextBody"/>
    <m:element name="odd-footer" type="TextBody"/>
    <m:element name="firts-page-header" type="TextBody"/>
    <m:element name="firts-page-footer" type="TextBody"/>
  </m:type>
  <m:type name="Hyperlink">
    <m:element name="Bookmark" type="Ref"/>
    <m:attribute name="FilePath" type="string"/>
    <m:attribute name="Uri" type="string"/>
    <m:attribute name="BookmarkName" type="string"/>
    <m:attribute name="HyperlinkType" type="HyperlinkType"/>
  </m:type>
  <m:type name="PageSetup">
    <m:attribute name="PageHeight" type="float"/>
    <m:attribute name="PageWidth" type="float"/>
    <m:attribute name="Alignment" type="PageAlignment"/>
    <m:attribute name="FooterDistance" type="float"/>
    <m:attribute name="HeaderDistance" type="float"/>
    <m:attribute name="Orientation" type="PageOrientation"/>
    <m:attribute name="BottomMargin" type="float"/>
    <m:attribute name="TopMargin" type="float"/>
    <m:attribute name="LeftMargin" type="float"/>
    <m:attribute name="RightMargin" type="float"/>
    <m:attribute name="DifferentFirstPage" type="boolean"/>
    <m:attribute name="DifferentOddEvenPage" type="boolean"/>
  </m:type>
  <m:type name="Paragraph">
    <m:element name="style" type="Ref"/>
    <m:element name="character-format" type="CharacterFormat" />
    <m:element name="paragraph-format" type="ParagraphFormat" />
    <m:element name="list-format" type="ListFormat" />
    <m:group name="items" item="item" type="ParagraphItem" />
  </m:type>
  <m:type name="Section">
    <m:element name="page-setup" type="PageSetup"/>
    <m:element name="headers-footers" type="HeadersFooters" />
    <m:group name="columns" item="column" type="Column" />
    <m:group ref="paragraphs" />
    <m:attribute name="BreakCode" type="SectionBreakCode" />
  </m:type>
  <m:type name="TableCell">
    <m:element name="cell-format" type="CellFormat" />
    <m:group ref="paragraphs" />
    <m:attribute name="Width" type="float" />
  </m:type>
  <m:type name="TableRow">
    <m:group name="cells" item="cell" type="TableCell" />
    <m:attribute name="RowHeight" type="float" />
    <m:attribute name="IsHeader" type="boolean" />
  </m:type>
  <m:type name="TextBody">
    <m:group ref="paragraphs" />
  </m:type>
  <!-- styles -->
  <m:type name="ListStyle">
    <m:group name="levels" item="level" type="ListLevel" />
  </m:type>
  <m:type name="ListLevel">
    <!-- ? -->
  </m:type>
  <m:type name="ParagraphStyle" mode="grouping">
    <m:element name="character-format" type="CharacterFormat" />
    <m:element name="paragraph-format" type="ParagraphFormat" />
    <m:attribute name="BaseStyleName" type="string" />
  </m:type>
  <m:type name="ShapeStyle" mode="grouping">
    <m:element name="shape-format" type="ShapeFormat" />
  </m:type>
  <m:type name="Style" mode="choice">
    <m:extention ref="ParagraphStyle"/>
    <m:extention ref="ShapeStyle"/>
    <m:attribute name="type" type="StyleType"/>
  </m:type>
  <!-- formats -->
  <m:type name="CharacterFormat">
    <m:attribute name="TextColor" type="Color" />
    <m:attribute name="FontName" type="string" />
    <m:attribute name="FontSize" type="float" />
    <m:attribute name="Bold" type="boolean" />
    <m:attribute name="Italic" type="boolean" />
    <m:attribute name="Strike" type="boolean" />
    <m:attribute name="DoubleStrike" type="boolean" />
    <m:attribute name="Underline" type="UnderlineStyle" />
    <m:attribute name="SubSuperScript" type="boolean" />
    <m:attribute name="LineSpacing" type="float" />
    <m:attribute name="Position" type="float" />
    <m:attribute name="TextBackgroundColor" type="Color" />
  </m:type>
  <m:type name="ParagraphFormat" mode="grouping">
    <m:element name="borders" type="Borders"/>
    <m:attribute name="HrAlignment" type="HorizontalAlignment" />
    <m:attribute name="VrAlignment" type="VerticalAlignment" />
    <m:attribute name="LeftIndent" type="float" />
    <m:attribute name="RightIndent" type="float" />
    <m:attribute name="FirstLineIndent" type="float" />
    <m:attribute name="Keep" type="float" />
    <m:attribute name="BeforeSpacing" type="float" />
    <m:attribute name="AfterSpacing" type="float" />
    <m:attribute name="KeepFollow" type="float" />
    <m:attribute name="WidowControl" type="boolean" />
    <m:attribute name="PageBreakBefore" type="boolean" />
    <m:attribute name="PageBreakAfter" type="boolean" />
    <m:attribute name="ColumnBreakAfter" type="boolean" />
    <m:attribute name="BackColor" type="Color" />
  </m:type>
  <m:type name="Borders">
    <m:element name="Bottom" type="Border" />
    <m:element name="Left" type="Border" />
    <m:element name="Top" type="Border" />
    <m:element name="Right" type="Border" />
  </m:type>
  <m:type name="Border">
    <m:attribute name="Color" type="Color" />
    <m:attribute name="LineWidth" type="float" />
    <m:attribute name="BorderType" type="BorderType" />
    <m:attribute name="Space" type="float" />
    <m:attribute name="Shadow" type="boolean" />
  </m:type>
  <m:type name="Paddings">
    <m:element name="Bottom" type="float" />
    <m:element name="Left" type="float" />
    <m:element name="Top" type="float" />
    <m:element name="Right" type="float" />
  </m:type>
  <m:type name="TableFormat">
    <m:extention ref="CellFormat" />
    <m:attribute name="CellSpacing" type="float" />
    <m:attribute name="LeftOffset" type="float" />
  </m:type>
  <m:type name="CellFormat" mode="grouping">
    <m:element name="borders" type="Borders" />
    <m:element name="paddings" type="Paddings" />
    <m:attribute name="VAlignment" type="VerticalAlignment"/>
    <m:attribute name="VMerge" type="CellMerge"/>
    <m:attribute name="HMerge" type="CellMerge"/>
    <m:attribute name="ShadingColor" type="Color"/>
  </m:type>
  <m:type name="ShapeFormat">
    <!-- ? -->
  </m:type>
  <m:type name="ListFormat">
    <m:attribute name="ListType" type="ListType" />
    <m:attribute name="LevelNumber" type="int" />
  </m:type>
  <!-- paragraph items -->
  <m:type name="ParagraphItem">
    <m:extention ref="TextRange"/>
    <m:extention ref="Field"/>
    <m:extention ref="Picture"/>
    <m:extention ref="Table"/>
    <m:extention ref="Canvas"/>
    <m:extention ref="Shape"/>
    <m:extention ref="BookmarkStart"/>
    <!-- m:extention ref="BookmarkEnd"/ -->
    <m:attribute name="type" type="ParagraphItemType"/>
  </m:type>
  <m:type name="TextRange" mode="grouping">
    <m:element name="character-format" type="CharacterFormat" />
    <m:element name="hyperlink" type="Hyperlink" />
    <m:element name="text" type="string" />
  </m:type>
  <m:type name="Field" mode="grouping">
    <m:attribute name="FieldType" type="FieldType" />
  </m:type>
  <m:type name="Picture" mode="grouping">
    <m:element name="image" type="string" />
    <m:attribute name="Width" type="float" />
    <m:attribute name="Height" type="float" />
    <m:attribute name="WidthScale" type="float" />
    <m:attribute name="HeightScale" type="float" />
    <m:attribute name="IsMetafile" type="boolean" />
  </m:type>
  <m:type name="Table" mode="grouping">
    <m:element name="table-format" type="TableFormat" />
    <m:group name="rows" item="row" type="TableRow" />
  </m:type>
  <m:type name="Canvas" mode="grouping">
    <m:attribute name="BorderColor" type="Color" />
    <!--m:attribute name="Width" type="float" /-->
    <!--m:attribute name="Height" type="float" /-->
    <m:group name="shapes" item="shape" type="Shape" />
  </m:type>
  <m:type name="Shape" mode="grouping">
  </m:type>
  <m:type name="BookmarkStart" mode="grouping">
    <m:attribute name="BookmarkName" type="string" />
  </m:type>
  <m:type name="BookmarkEnd" mode="grouping">
    <m:attribute name="BookmarkName" type="string" />
  </m:type>
  <!-- enums & simple types -->
  <m:type name="HyperlinkType" mode="enum">
    <m:enum value="None"/>
    <m:enum value="FileLink"/>
    <m:enum value="UriLink"/>
    <m:enum value="Bookmark"/>
  </m:type>
  <m:type name="PageAlignment" mode="enum">
    <m:enum value="Top"/>
    <m:enum value="Middle"/>
    <m:enum value="Justified"/>
    <m:enum value="Bottom"/>
  </m:type>
  <m:type name="PageOrientation" mode="enum">
    <m:enum value="Top"/>
    <m:enum value="Middle"/>
    <m:enum value="Justified"/>
    <m:enum value="Bottom"/>
  </m:type>
  <m:type name="SectionBreakCode" mode="enum">
    <m:enum value="NoBreak"/>
    <m:enum value="NewColumn"/>
    <m:enum value="NewPage"/>
    <m:enum value="EvenPage"/>
    <m:enum value="Oddpage"/>
  </m:type>
  <m:type name="UnderlineStyle" mode="enum">
    <m:enum value="None"/>
    <m:enum value="Single"/>
    <m:enum value="Words"/>
    <m:enum value="Double"/>
    <m:enum value="Dotted"/>
    <m:enum value="Thick"/>
    <m:enum value="Dash"/>
    <m:enum value="DashLong"/>
    <m:enum value="DotDash"/>
    <m:enum value="DotDotDash"/>
    <m:enum value="Wavy"/>
    <m:enum value="DottedHeavy"/>
    <m:enum value="DashHeavy"/>
    <m:enum value="DashLongHeavy"/>
    <m:enum value="DotDashHeavy"/>
    <m:enum value="DotDotDashHeavy"/>
    <m:enum value="WavyHeavy"/>
    <m:enum value="WavyDouble"/>
  </m:type>
  <m:type name="HorizontalAlignment" mode="enum">
    <m:enum value="Left"/>
    <m:enum value="Center"/>
    <m:enum value="Right"/>
    <m:enum value="Justify"/>
  </m:type>
  <m:type name="VerticalAlignment" mode="enum">
    <m:enum value="Top"/>
    <m:enum value="Middle"/>
    <m:enum value="Bottom"/>
  </m:type>
  <m:type name="BorderType" mode="enum">
    <m:enum value="None"/>
    <m:enum value="Single"/>
    <m:enum value="Thick"/>
    <m:enum value="Double"/>
    <m:enum value="Hairline"/>
    <m:enum value="Wave"/>
  </m:type>
  <m:type name="FieldType" mode="enum">
    <m:enum value="PageNumber"/>
    <m:enum value="NumPages"/>
  </m:type>
  <m:type name="Color" mode="pattern">
    <m:pattern value="^#[0-9a-fA-F]{8}$"/>
  </m:type>
  <m:type name="ParagraphItemType" mode="enum">
    <m:enum value="TextRange"/>
    <m:enum value="Picture"/>
    <m:enum value="Canvas"/>
    <m:enum value="Table"/>
    <m:enum value="BookmarkStart"/>
    <m:enum value="BookmarkEnd"/>
    <m:enum value="Field"/>
  </m:type>
  <m:type name="StyleType" mode="enum">
    <m:enum value="ParagraphStyle"/>
    <m:enum value="ImageStyle"/>
    <m:enum value="ShapeStyle"/>
  </m:type>
  <m:type name="ListType" mode="enum">
    <m:enum value="Numbered"/>
    <m:enum value="Bulleted"/>
    <m:enum value="NoList"/>
  </m:type>
  <m:type name="CellMerge" mode="enum">
    <m:enum value="None"/>
    <m:enum value="Start"/>
    <m:enum value="Continue"/>
  </m:type>
  <!-- shared groups -->
  <m:group name="paragraphs" item="paragraph" type="Paragraph" />
  <!-- helper types -->
  <m:type name="Ref">
    <m:attribute name="ref" type="int" />
  </m:type>
</m:meta-schema>
