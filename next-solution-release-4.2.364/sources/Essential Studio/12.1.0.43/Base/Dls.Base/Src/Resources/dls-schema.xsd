    <xs:attributeGroup ref="PictureAttrGroup" />
    <xs:attributeGroup ref="TableAttrGroup" />
    <xs:attributeGroup ref="CanvasAttrGroup" />
    <xs:attributeGroup ref="ShapeAttrGroup" />
    <xs:attributeGroup ref="BookmarkStartAttrGroup" />
