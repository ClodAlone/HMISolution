  <xs:attributeGroup name="FieldAttrGroup">
    <xs:attribute name="FieldType" type="FieldType" />
  </xs:attributeGroup>
  <xs:group name="PictureGroup">
    <xs:sequence>
      <xs:element name="image" type="xs:string" />
    </xs:sequence>
  </xs:group>
  <xs:complexType name="Picture">
    <xs:group ref="PictureGroup" />
    <xs:attributeGroup ref="PictureAttrGroup" />
