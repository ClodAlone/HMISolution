      <xs:enumeration value="None" />
      <xs:enumeration value="Start" />
      <xs:enumeration value="Continue" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Ref">
    <xs:sequence />
    <xs:attribute name="ref" type="xs:int" />
  </xs:complexType>
</xs:schema>