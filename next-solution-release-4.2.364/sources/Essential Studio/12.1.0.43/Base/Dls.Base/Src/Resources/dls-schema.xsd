      <xs:enumeration value="NewPage" />
      <xs:enumeration value="EvenPage" />
      <xs:enumeration value="Oddpage" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="UnderlineStyle">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Single" />
      <xs:enumeration value="Words" />
      <xs:enumeration value="Double" />
      <xs:enumeration value="Dotted" />
      <xs:enumeration value="Thick" />
      <xs:enumeration value="Dash" />
      <xs:enumeration value="DashLong" />
      <xs:enumeration value="DotDash" />
      <xs:enumeration value="DotDotDash" />
      <xs:enumeration value="Wavy" />
      <xs:enumeration value="DottedHeavy" />
      <xs:enumeration value="DashHeavy" />
      <xs:enumeration value="DashLongHeavy" />
      <xs:enumeration value="DotDashHeavy" />
      <xs:enumeration value="DotDotDashHeavy" />
      <xs:enumeration value="WavyHeavy" />
      <xs:enumeration value="WavyDouble" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HorizontalAlignment">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Left" />
      <xs:enumeration value="Center" />
      <xs:enumeration value="Right" />
      <xs:enumeration value="Justify" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VerticalAlignment">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Top" />
      <xs:enumeration value="Middle" />
      <xs:enumeration value="Bottom" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BorderType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="Single" />
      <xs:enumeration value="Thick" />
      <xs:enumeration value="Double" />
      <xs:enumeration value="Hairline" />
      <xs:enumeration value="Wave" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="FieldType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PageNumber" />
      <xs:enumeration value="NumPages" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Color">
    <xs:restriction base="xs:string">
      <xs:pattern value="^#[0-9a-fA-F]{8}$" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ParagraphItemType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="TextRange" />
      <xs:enumeration value="Picture" />
      <xs:enumeration value="Canvas" />
      <xs:enumeration value="Table" />
      <xs:enumeration value="BookmarkStart" />
      <xs:enumeration value="BookmarkEnd" />
      <xs:enumeration value="Field" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StyleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ParagraphStyle" />
      <xs:enumeration value="ImageStyle" />
      <xs:enumeration value="ShapeStyle" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ListType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Numbered" />
      <xs:enumeration value="Bulleted" />
      <xs:enumeration value="NoList" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CellMerge">
