  </xs:complexType>
  <xs:attributeGroup name="PictureAttrGroup">
    <xs:attribute name="Width" type="xs:float" />
    <xs:attribute name="Height" type="xs:float" />
    <xs:attribute name="WidthScale" type="xs:float" />
    <xs:attribute name="HeightScale" type="xs:float" />
    <xs:attribute name="IsMetafile" type="xs:boolean" />
  </xs:attributeGroup>
