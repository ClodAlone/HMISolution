    <xs:group ref="ShapeGroup" />
    <xs:attributeGroup ref="ShapeAttrGroup" />
    <xs:attribute name="id" type="xs:int" />
  </xs:complexType>
  <xs:attributeGroup name="ShapeAttrGroup" />
  <xs:group name="BookmarkStartGroup">
    <xs:sequence />
  </xs:group>
