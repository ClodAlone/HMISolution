  </xs:attributeGroup>
  <xs:complexType name="ShapeFormat">
    <xs:sequence />
    <xs:attribute name="id" type="xs:int" />
  </xs:complexType>
  <xs:complexType name="ListFormat">
    <xs:sequence />
    <xs:attribute name="ListType" type="ListType" />
    <xs:attribute name="LevelNumber" type="xs:int" />
    <xs:attribute name="id" type="xs:int" />
  </xs:complexType>
