  </xs:complexType>
  <xs:attributeGroup name="BookmarkStartAttrGroup">
    <xs:attribute name="BookmarkName" type="xs:string" />
  </xs:attributeGroup>
  <xs:group name="BookmarkEndGroup">
    <xs:sequence />
  </xs:group>
  <xs:complexType name="BookmarkEnd">
    <xs:group ref="BookmarkEndGroup" />
    <xs:attributeGroup ref="BookmarkEndAttrGroup" />
    <xs:attribute name="id" type="xs:int" />
  </xs:complexType>
  <xs:attributeGroup name="BookmarkEndAttrGroup">
    <xs:attribute name="BookmarkName" type="xs:string" />
  </xs:attributeGroup>
