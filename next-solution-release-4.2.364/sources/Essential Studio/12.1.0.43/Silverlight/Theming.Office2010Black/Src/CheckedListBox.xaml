<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"  >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->

    <SolidColorBrush x:Key="CheckListBoxBackgroundBrushKey" Color="#FFB3B3B3"/>

    <SolidColorBrush x:Key="Office2010BlackCheckListBoxBorderBrush" Color="#FF6A6A6A"/>
    <SolidColorBrush x:Key="Office2010BlackCheckListBoxForeground" Color="Black"/>
    <LinearGradientBrush x:Key="CheckListBoxItemPressedBrushKey" StartPoint="0.788002,-0.0286425" EndPoint="0.788002,0.857253">
        <GradientStop Color="#FFF9D576" Offset="0"/>
        <GradientStop Color="#FFFEE48A" Offset="0.969891"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CheckListBoxItemMouseOverBrushKey"  StartPoint="0.847565,0.00585402" EndPoint="0.847565,1.01021">
        <GradientStop Color="#FFFCEDB0" Offset="0.0100365"/>
        <GradientStop Color="#FFFDE38A" Offset="0.280109"/>
        <GradientStop Color="#FFFCFAF0" Offset="0.990868"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackCheckListBoxItemMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF8E9A8" Offset="0.044"/>
        <GradientStop Color="#FFF8E188" Offset="0.504"/>
        <GradientStop Color="#FFFBF9E0" Offset="0.978"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlackCheckListBoxItemMouseOverBorderBrush" Color="#FFECC757"/>

    <LinearGradientBrush x:Key="Office2010BlackSelectedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC28A30" Offset="0"/>
        <GradientStop Color="#FFC2A44D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackSelectedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE072" Offset="0.101"/>
        <GradientStop Color="#FFFFD86C" Offset="0.449"/>
        <GradientStop Color="#FFFFF480" Offset="0.96"/>
    </LinearGradientBrush>

    <!-- Styles -->

    <Style x:Key="Office2010BlackCheckedListBoxItemStyle" TargetType="local:CheckedListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBoxItem">
                    <Grid  Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlackCheckListBoxItemMouseOverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InnerBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlackCheckListBoxItemMouseOverBackground}"/>
                                        </ObjectAnimationUsingKeyFrames>                                      
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlackSelectedBackground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlackSelectedBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InnerBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!--<Rectangle x:Name="InnerfillColor" Opacity="0" Fill="White" IsHitTestVisible="False" RadiusX="1" RadiusY="1" />-->
                        <!--<Rectangle x:Name="fillColor" Opacity="0" Fill="{StaticResource Office2010BlackCheckListBoxItemMouseOverBackground}" IsHitTestVisible="False" RadiusX="1" RadiusY="1" Stroke="{StaticResource Office2010BlackCheckListBoxItemMouseOverBorderBrush}"/>
                        
                        <Rectangle x:Name="fillColor2" Opacity="0" Fill="{StaticResource Office2010BlackSelectedBackground}" IsHitTestVisible="False" RadiusX="1" RadiusY="1" Stroke="{StaticResource Office2010BlackSelectedBorderBrush}"/>-->
                        <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent">
                         <Border x:Name="InnerBorder" Background="Transparent" Margin="1">
                            <Grid x:Name="PART_Grid" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PART_Grid1" Grid.Column="0">
                                    <CheckBox x:Name="PART_CheckBox" Style="{StaticResource CheckBox}" Grid.Column="0" IsChecked="{TemplateBinding IsChecked}"  VerticalAlignment="Center" />
                                    <RadioButton x:Name="PART_Radio" GroupName="RadioButton"  IsChecked ="{TemplateBinding IsChecked}"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <Image Grid.Column="1" 
                                       x:Name="LeftImage" 
                                       Source="{TemplateBinding LeftImageSource}"
                                       MaxWidth="{TemplateBinding LeftImageWidth}"
                                       MaxHeight="{TemplateBinding LeftImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                <ContentPresenter x:Name="PART_Content" Grid.Column="2" Margin="2"  Content="{TemplateBinding Content}" />
                                <Image Grid.Row="0" Grid.Column="3" 
                                       x:Name="RightImage" 
                                       Source="{TemplateBinding RightImageSource}"
                                       MaxWidth="{TemplateBinding RightImageWidth}"
                                       MaxHeight="{TemplateBinding RightImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                            </Grid>
                        </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:CheckedListBoxItem" BasedOn="{StaticResource Office2010BlackCheckedListBoxItemStyle}"/>

    <Style x:Key="Office2010BlackCheckedListBoxStyle" TargetType="local:CheckedListBox" >
        <Setter Property="Padding" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlackCheckListBoxBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource CheckListBoxBackgroundBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource Office2010BlackCheckListBoxForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <ScrollViewer Style="{StaticResource ScrollViewer}" x:Name="outerScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderBrush="Transparent">
                            <ItemsPresenter x:Name="PART_ItemsHost"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="local:CheckedListBox" BasedOn="{StaticResource Office2010BlackCheckedListBoxStyle}"/>




</ResourceDictionary>

