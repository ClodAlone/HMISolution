<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight" >

    <LinearGradientBrush x:Key="RibbonMenuBottomBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFB2B3B4" Offset="0.278"/>
        <GradientStop Color="#FFE4E7EB" Offset="0.389"/>
        <GradientStop Color="#FFBBC0C4" Offset="0.778"/>
        <GradientStop Color="#FFB7B8BA" Offset="0.889"/>
        <GradientStop Color="#FF737878" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="local:RibbonMenuGroup" x:Key="Office2010BlackRibbonMenuGroupStyle">
        <Setter Property="IconBarEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonMenuGroup">
                    <Grid Name="gri">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextConverter"/>
                            <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#FFF0F2F5" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="22" Grid.Row="0" BorderThickness="1" BorderBrush="#FFFFFFFF">
                            <ContentControl Content="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF3B3B3B" HorizontalContentAlignment="Left"/>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid Background="White">
                                <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}" BorderBrush="#FFE7E9EB" Background="#FFFFFFFF" BorderThickness="0,0,1,0" Width="26" HorizontalAlignment="Left"/>
                                <Border>
                                    <ScrollViewer TabNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                        <ItemsPresenter Margin="2,0,0,0"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border BorderBrush="#FFEBECEE" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" Background="#FFFFFFFF" BorderThickness="0,0,2,0" Width="22" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Height="12" BorderThickness="0,0,0,1" BorderBrush="#FFC4C4C4" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FFE2E2E2" Offset="0.339"/>
                                    <GradientStop Color="#FFCBCBCB" Offset="0.941"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border HorizontalAlignment="Right" Margin="0,0,2,0">
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="4"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle  Fill="#FFABABAB"  Height="2" Width="2" Margin="1" Grid.Row="1" Grid.Column="1">
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="White" Opacity="0.7" Direction="319"  BlurRadius="0" ShadowDepth="2"></DropShadowEffect>
                                            </Rectangle.Effect>
                                        </Rectangle>

                                        <Rectangle  Fill="#FFABABAB" Height="2" Width="2"  Margin="1" Grid.Row="0" Grid.Column="1">
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="White"  Opacity="0.7"  Direction="319"  BlurRadius="0" ShadowDepth="2"></DropShadowEffect>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <Rectangle  Fill="#FFABABAB" Height="2" Width="2" Margin="1" Grid.Row="1" Grid.Column="0">
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="White" Opacity="0.7"  Direction="319"  BlurRadius="0" ShadowDepth="2"></DropShadowEffect>
                                            </Rectangle.Effect>
                                        </Rectangle>

                                    </Grid>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2010BlackRibbonMenuGroupStyle}" TargetType="local:RibbonMenuGroup"/>
	
</ResourceDictionary>
