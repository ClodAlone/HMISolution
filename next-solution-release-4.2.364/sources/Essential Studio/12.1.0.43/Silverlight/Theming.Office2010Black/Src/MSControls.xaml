                                        <Rectangle x:Name="Hover" Fill="{StaticResource TreeViewItemMouseOverBrushKey}" Stroke="{StaticResource TreeViewItemMouseOverBorderBrushKey}" StrokeThickness="1" RadiusX="2" RadiusY="2" IsHitTestVisible="False" Opacity="0"/>
                                        <ContentPresenter x:Name="Content" Cursor="{TemplateBinding Cursor}" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
