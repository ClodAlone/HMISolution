<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    >

    <!-- Brushes -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--<SolidColorBrush x:Key="TaskBarItemHeaderBackgroundBrushKey" Color="#FFE8E8E8"/>-->
         
       
       
        <LinearGradientBrush x:Key="TaskBarItemHeaderBackgroundBrushKey" StartPoint="0.571773,0.00813034" EndPoint="0.571773,0.983739">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#FFBDBDBD" Offset="0"/>
                <GradientStop Color="#FF9B9B9B" Offset="0.67062"/>
                <GradientStop Color="#FF919191" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
   
          
       
        
        <LinearGradientBrush x:Key="TaskBarItemBackgroundBrushKey" StartPoint="0.571773,0.00813034" EndPoint="0.571773,0.983739">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#FFBDBDBD" Offset="0"/>
                <GradientStop Color="#FF9B9B9B" Offset="0.67062"/>
                <GradientStop Color="#FF919191" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>


    <SolidColorBrush x:Key="ToggleButtonFillBrushKey" Color="#656870"/>
    <SolidColorBrush x:Key="TaskBarItemBorderBrushKey" Color="#313431"/>


    <Style x:Key="Office2010BlackTaskBarItemStyle" TargetType="local:TaskBarItem">
        <Setter Property="Background" Value="{StaticResource TaskBarItemBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TaskBarItemBorderBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsHeaderShown" Value="True"/>
        <Setter Property="HeaderHeight" Value="25"/>
        <Setter Property="Theme" Value="Office10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TaskBarItem">

                    <Grid x:Name="MainGrid"  >
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderGrid"   Background="{StaticResource TaskBarItemHeaderBackgroundBrushKey}" >
                                <Border x:Name="HeaderBorder" BorderBrush="{StaticResource TaskBarItemBorderBrushKey}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}" Padding="1">
                                    <controlsToolkit:DockPanel x:Name="Head" LastChildFill="False">
                                        <ToggleButton Background="#E2E2E2" Style="{StaticResource ToggleButton}" controlsToolkit:DockPanel.Dock="Right"  x:Name="ExpanderButton" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsTabStop="False"  Margin="3"/>
                                        <ContentPresenter controlsToolkit:DockPanel.Dock="Left" x:Name="HeaderContent" Content="{TemplateBinding Header}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},  Path=HeaderTemplate}" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center"/>
                                    </controlsToolkit:DockPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="ContentGrid"   Background="{TemplateBinding Background}" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
                                <Border x:Name="ContentBorder" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="1"        
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter x:Name="TaskBarContent"  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ItemContentTemplate}">
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlackTaskBarItemStyle}" TargetType="local:TaskBarItem"/>

    <Style x:Key="Office2010BlackTaskBarStyle" TargetType="local:TaskBar">
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="local:TaskBar">
                    <Border x:Name="MainBorder"  BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                     Background="{TemplateBinding Background}">
                        <StackPanel  x:Name="MainGrid" Orientation="Horizontal">
                            <ItemsPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlackTaskBarStyle}" TargetType="local:TaskBar">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Office2010BlackTaskBarItemStyle}"/>
    </Style>

</ResourceDictionary>
