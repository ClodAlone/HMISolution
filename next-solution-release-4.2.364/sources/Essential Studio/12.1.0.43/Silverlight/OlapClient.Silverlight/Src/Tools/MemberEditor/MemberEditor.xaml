                        </LinearGradientBrush>
                    </Rectangle.Stroke>
                </Rectangle>
                <Rectangle x:Name="rectangle" Margin="179,160,0,0" RadiusY="59" RadiusX="59" HorizontalAlignment="Left" Width="64" Height="60" VerticalAlignment="Top">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="#FF090909" Opacity="0.56" BlurRadius="11"/>
                    </Rectangle.Effect>
                    <Rectangle.Stroke>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF8A8A8A" Offset="0.002"/>
                            <GradientStop Color="#FFB2B2B2" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Stroke>
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFEEF3FA" Offset="0.477"/>
                            <GradientStop Color="#FFD6E3F4" Offset="0.554"/>
                            <GradientStop Color="#FFCBD9EC" Offset="0.873"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Path x:Name="path" Data="M41.200001,13.1 C25.680798,13.1 13.1,25.680798 13.1,41.200001 13.1,56.7192 25.680798,69.300003 41.200001,69.300003 56.7192,69.300003 69.300003,56.7192 69.300003,41.200001 69.300003,25.680798 56.7192,13.1 41.200001,13.1 z M41.200001,0.5 C63.67799,0.5 81.900002,18.722012 81.900002,41.200001 81.900002,63.67799 63.67799,81.900002 41.200001,81.900002 18.722012,81.900002 0.5,63.67799 0.5,41.200001 0.5,18.722012 18.722012,0.5 41.200001,0.5 z" HorizontalAlignment="Left" Margin="188.597,168.586,0,0" Stretch="Fill" Width="44.427"  Height="42.621" VerticalAlignment="Top">
                    <Path.Fill>
                        <LinearGradientBrush EndPoint="0.652,0.976" StartPoint="0.348,0.024">
                            <GradientStop Color="#FF69F8FF" Offset="0.064"/>
                            <GradientStop Color="#FF49E6FF" Offset="0.159"/>
                            <GradientStop Color="#FF031F69" Offset="0.923"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Stroke>
                        <LinearGradientBrush EndPoint="0.964,0.686" StartPoint="0.036,0.314">
                            <GradientStop Color="#FF98C3FF" Offset="0.002"/>
                            <GradientStop Color="White" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <TextBlock x:Name="textBlock" Height="24" Margin="247,177,297,0" TextWrapping="Wrap" Text="Loading" VerticalAlignment="Top" FontSize="17.667" FontFamily="Segoe UI Light" Foreground="#FF031F69"/>
                <Ellipse x:Name="ellipse1" Fill="#FF031F69" Margin="0,193,285,0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Right"  Width="2"/>
                <Ellipse x:Name="ellipse" Fill="#FF031F69" Margin="0,193,290,0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="2"/>
                <Ellipse x:Name="ellipse2" Fill="#FF031F69" Margin="0,193,280,0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="2"/>
            </Grid>
        </Popup>
    </Grid>
</sync:WindowControl>