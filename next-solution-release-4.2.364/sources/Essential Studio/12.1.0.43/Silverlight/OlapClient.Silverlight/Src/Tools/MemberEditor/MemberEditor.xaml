<sync:WindowControl x:Class="Syncfusion.Silverlight.Tools.Olap.MemberEditor"
		   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
		   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
		   xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
		   xmlns:DT="clr-namespace:System.Windows;assembly=System.Windows.Controls"
		   xmlns:local="clr-namespace:Syncfusion.Silverlight.Tools.Olap" MinHeight="370" MinWidth="270"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Client.Olap.Resources"
		   Width="270" Height="370" Icon="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/Member.png"
		    AnimationType="Zoom" ResizeMode="CanResizeWithGrip">
    <sync:WindowControl.Resources>
        <local:MemberIcon x:Key="ImageConverter"/>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
        <DT:HierarchicalDataTemplate x:Key="DataTemplate" x:Name="PART_HierarchicalTemplate"  ItemsSource="{Binding Path=ChildNodes}">
            <StackPanel Orientation="Horizontal" x:Name="PART_NodePanel">
                <CheckBox ClickMode="Press" IsChecked="{Binding Path=IsSelected,Mode=TwoWay}" Click="CheckBox_Click" Margin="1,-3.5,1,1"/>
                <ContentControl x:Name="PART_Image"  Margin="2,0,7,0" ContentTemplate="{Binding Converter={StaticResource ImageConverter}}"/>
                <TextBlock x:Name="PART_Node" Text="{Binding Path=Caption}" Margin="1,-3.5,1,1"/>
            </StackPanel>
        </DT:HierarchicalDataTemplate>
        <DT:HierarchicalDataTemplate  x:Key="WOChkDataTemplate" ItemsSource="{Binding Path=ChildNodes}">
            <StackPanel Orientation="Horizontal" x:Name="PART_NodePanel">
                <CheckBox Visibility="Collapsed" ClickMode="Press" IsChecked="{Binding Path=IsSelected,Mode=TwoWay}" Click="CheckBox_Click" Margin="1,-3.5,1,1"/>
                <ContentControl x:Name="PART_Image"  Margin="2,0,7,0" ContentTemplate="{Binding Converter={StaticResource ImageConverter}}"/>
                <TextBlock x:Name="PART_Node" Text="{Binding Path=Caption}" Margin="1,-3.5,1,1"/>
            </StackPanel>
        </DT:HierarchicalDataTemplate>
    </sync:WindowControl.Resources>
    <Grid>
        <Grid x:Name="LayoutRoot" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox Height="18"  x:Name="CheckAllNodes" Click="CheckAllNodes_Click"   Content="{Binding MemberEditor_CheckAll,Source={StaticResource resourceWrapper}}"
			 HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="10,5,5,5"/>
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <local:MemberEditorTreeView x:Name="MemberTree" ItemTemplate="{StaticResource DataTemplate}">
                </local:MemberEditorTreeView>
            </Grid>
            <Grid Grid.Row="2" x:Name="grid_condition" Visibility="Collapsed">
                <TextBlock x:Name="statusText" Text="" Margin="5 0"/>
            </Grid>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="3">
                <Button x:Name="OKButton" Content="{Binding Connection_OK,Source={StaticResource resourceWrapper}}" Click="OKButton_Click" MinWidth="75" Height="23"/>
                <Button x:Name="CancelButton" Content="{Binding Connection_Cancel,Source={StaticResource resourceWrapper}}" Click="CancelButton_Click" MinWidth="75" Height="23" Margin="5,5,5,5"/>
            </StackPanel>
        </Grid>
        <Popup x:Name="PART_ProgressPopup" Margin="80,70,0,0"  HorizontalAlignment="Center" VerticalAlignment="Center">
            <Popup.Resources>
                <Storyboard x:Key="Storyboard1" RepeatBehavior="Forever">
                    <PointAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.StartPoint)" Storyboard.TargetName="path">
                        <EasingPointKeyFrame KeyTime="0" Value="0.509,0.999"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.3" Value="-0.062,0.571"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.5" Value="0.3,0.207"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.7" Value="0.786,0.08"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.9" Value="1.016,0.573"/>
                        <EasingPointKeyFrame KeyTime="0:0:1.1" Value="0.753,0.962"/>
                    </PointAnimationUsingKeyFrames>
                    <PointAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.EndPoint)" Storyboard.TargetName="path">
                        <EasingPointKeyFrame KeyTime="0" Value="0.484,-0.077"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.1" Value="0.797,-0.009"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.2" Value="1.008,0.191"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.3" Value="1.17,0.485"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.5" Value="0.854,0.944"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.6" Value="0.553,1.121"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.7" Value="0.101,1.097"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.8" Value="-0.004,0.742"/>
                        <EasingPointKeyFrame KeyTime="0:0:0.9" Value="-0.011,0.429"/>
                        <EasingPointKeyFrame KeyTime="0:0:1" Value="0.028,0.077"/>
                        <EasingPointKeyFrame KeyTime="0:0:1.1" Value="0.161,-0.022"/>
                    </PointAnimationUsingKeyFrames>
                </Storyboard>
                <Storyboard x:Key="Storyboard2" RepeatBehavior="Forever">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ellipse">
                        <EasingDoubleKeyFrame KeyTime="0" Value="0.01"/>
                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ellipse1">
                        <EasingDoubleKeyFrame KeyTime="0" Value="0.01"/>
                        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.01"/>
                        <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ellipse2">
                        <EasingDoubleKeyFrame KeyTime="0" Value="0.01"/>
                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.01"/>
                        <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </Popup.Resources>
            <Grid Background="Transparent"   Margin="-300,-250,0,0"   >
                <Grid.Resources>
                </Grid.Resources>
                <Rectangle Margin="195,175,268,0" RadiusY="10.167" RadiusX="10.167" Height="32" VerticalAlignment="Top">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="#FF090909" Opacity="0.56" BlurRadius="11"/>
                    </Rectangle.Effect>
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFEEF3FA" Offset="0.477"/>
                            <GradientStop Color="#FFD6E3F4" Offset="0.554"/>
                            <GradientStop Color="#FFCBD9EC" Offset="0.873"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Stroke>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF8A8A8A" Offset="0.002"/>
