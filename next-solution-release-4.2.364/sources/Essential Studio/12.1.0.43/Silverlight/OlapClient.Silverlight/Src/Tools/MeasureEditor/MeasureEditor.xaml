<sync:WindowControl x:Class="Syncfusion.Silverlight.Tools.Olap.MeasureEditor"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:resource="clr-namespace:Syncfusion.Silverlight.Client.Olap.Resources"
           Width="270" Height="370" AnimationType="Zoom" ResizeMode="CanResizeWithGrip"
           Icon="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/Measure.png" 
           MinHeight="370" MinWidth="270">
    <sync:WindowControl.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
        <DataTemplate x:Key="Measure">
            <Image Height="15" Width="15" Source="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/Measure.png"/>
        </DataTemplate>
        <DataTemplate x:Key="DataTemplate" x:Name="MeasureListTemplate">
            <StackPanel Orientation="Horizontal">
                <CheckBox ClickMode="Press" IsChecked="{Binding Path=IsSelected,Mode=TwoWay}"/>
                <ContentControl Height="14" Width="14" x:Name="PART_Image"  Margin="0,0,7,0" ContentTemplate="{StaticResource Measure}"/>
                <TextBlock x:Name="PART_Node" Text="{Binding Path=Caption}"/>
            </StackPanel>
        </DataTemplate>
    </sync:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="Delete" Height="23" Width="27" ToolTipService.ToolTip="{Binding Delete,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Right" 
                Margin="0,3,5,3" Grid.Row="0" Click="Delete_Click">
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 14.8931,2.56871C 13.7204,2.34169 10.995,3.70179 8.34505,5.5491C 6.35546,3.1386 4.20413,1.2481 2.91151,1.39577C -0.0886315,1.73865 1.79717,4.05304 1.79717,4.05304C 3.44522,3.99612 5.23358,5.10977 6.88935,6.62091C 4.11774,8.77122 1.73103,12.0288 1.77824,13.4676C 1.86396,16.0821 4.00692,14.0248 4.00692,14.0248C 4.94982,13.2105 5.33555,10.1514 8.06999,7.78144C 10.8627,10.7257 13.0263,14.3392 13.0263,14.3392C 13.2849,13.0032 11.4845,9.65253 9.24945,6.69388C 11.9767,4.31455 14.8931,2.56871 14.8931,2.56871 Z">
                <Path.Fill>
                    <RadialGradientBrush RadiusX="1.63722" RadiusY="1.62028" Center="0.272662,0.0251297" GradientOrigin="0.272662,0.0251297">
                        <RadialGradientBrush.GradientStops>
                            <GradientStop Color="#FFF50000" Offset="0"/>
                            <GradientStop Color="#FF820000" Offset="1"/>
                        </RadialGradientBrush.GradientStops>
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <SkewTransform CenterX="0.272662" CenterY="0.0251297" AngleX="1.00263" AngleY="0"/>
                                <RotateTransform CenterX="0.272662" CenterY="0.0251297" Angle="60.6717"/>
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                    </RadialGradientBrush>
                </Path.Fill>

            </Path>

            <!--<Image Source="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/Delete.png"></Image>-->
        </Button>
        <Button x:Name="MoveDown" Height="23" Width="27" ToolTipService.ToolTip="{Binding MoveDown,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Right" 
                Margin="0,3,35,3" Grid.Row="0" Click="UpDown_Click">
            <!--<Image Height="13" Width="20" Source="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/DownArrow.png"></Image>-->
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 1.72079,9.20409L 5.62049,9.19964L 5.62049,1.13207L 10.8085,1.13207L 10.8085,9.1937L 14.4013,9.18959L 8.08485,14.9903L 1.72079,9.20409 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FFA8C8EE" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF6A9BF0" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FF1243A4" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF233F70" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

        </Button>
        <Button x:Name="MoveUp" Height="23" Width="27" ToolTipService.ToolTip="{Binding MoveUp,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Right" 
                Margin="0,3,65,3" Grid.Row="0" Click="UpDown_Click">
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 14.4015,6.9183L 10.5018,6.92275L 10.5018,14.9903L 5.31371,14.9903L 5.31371,6.92869L 1.72093,6.9328L 8.03739,1.13211L 14.4015,6.9183 Z ">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FFA8C8EE" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF6A9BF0" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="#FF1243A4" Offset="0"/>
                            <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                            <GradientStop Color="#FF233F70" Offset="1"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <!--<Image Height="13" Width="20" Source="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/UpArrow1.png"></Image>-->
        </Button>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="171*" />
                <ColumnDefinition Width="79*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="MeasureList" ItemTemplate="{StaticResource DataTemplate}" Grid.ColumnSpan="2"></ListBox>
        </Grid>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="2">
            <Button x:Name="OKButton" Content="{Binding Connection_OK,Source={StaticResource resourceWrapper}}" Click="OKButton_Click" MinWidth="75" Height="23" />
            <Button x:Name="CancelButton" Content="{Binding Connection_Cancel,Source={StaticResource resourceWrapper}}" Click="CancelButton_Click" Margin="5 5 5 5" MinWidth="75" Height="23"/>
        </StackPanel>
    </Grid>
</sync:WindowControl>