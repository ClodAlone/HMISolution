<sync:WindowControl x:Class="Syncfusion.Silverlight.Tools.Olap.CalcMemberEditor"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:slv="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"  
           xmlns:Tools="clr-namespace:Syncfusion.Silverlight.Tools.Olap"
           xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:resource="clr-namespace:Syncfusion.Silverlight.Client.Olap.Resources"
           Width="270" Height="370" AnimationType="Zoom" ResizeMode="CanResizeWithGrip"
           Icon="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/Measure.png" 
           MinHeight="300" MinWidth="570">
    <sync:WindowControl.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
    </sync:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Margin="2">
        <Grid.RowDefinitions>            
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CalcMeasureTreeViewBorder" Visibility="Collapsed" Opacity="0.5" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Tools:CubeDimensionBrowser x:Name="CalcMeasureTreeView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <slv:GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="4" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="labelCaption" Text="{Binding Caption,Source={StaticResource resourceWrapper}}" />
                <Border x:Name="CaptionTextBorder" Grid.Row="1" Visibility="Collapsed" Opacity="0.5" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <TextBox x:Name="CaptionText" Margin="5,1" Grid.Row="1" />
                <TextBlock x:Name="labelExpression" Text="{Binding Expression,Source={StaticResource resourceWrapper}}" Grid.Row="2" />
                <TextBox x:Name="ExpressionText" Margin="5,1"  HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="3" />
                <TextBlock x:Name="labelMember" Text="{Binding MemberType,Source={StaticResource resourceWrapper}}" Grid.Row="4" />
                <Border x:Name="MemberTypeBorder" Grid.Row="5" Visibility="Collapsed" Opacity="0.5" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <ComboBox x:Name="MemberTypeBox" Margin="5,1" SelectedIndex="0" Grid.Row="5" SelectionChanged="MemberTypeBox_SelectionChanged">
                    <ComboBoxItem Content="Measure" />
                    <ComboBoxItem Content="Dimension" />
                </ComboBox>
                <Border x:Name="MemberTypeTextBorder" Grid.Row="6" Visibility="Collapsed" Opacity="0.5"  Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <ComboBox x:Name="MemberTypeText" Margin="5,1" Grid.Row="6" Visibility="Collapsed" />
                <TextBlock x:Name="labelFormatString" Text="{Binding FormatString,Source={StaticResource resourceWrapper}}" Grid.Row="7" />
                <Border x:Name="FormatBoxBorder" Grid.Row="8" Visibility="Collapsed" Opacity="0.5" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <ComboBox x:Name="FormatBox" Margin="5,1" SelectedIndex="0" Grid.Row="8" SelectionChanged="FormatBox_SelectionChanged">
                    <ComboBoxItem Content="Standard" />
                    <ComboBoxItem Content="Currency" />
                    <ComboBoxItem Content="Percent" />
                    <ComboBoxItem Content="Custom" />
                </ComboBox>
                <Border x:Name="FormatTextBorder" Grid.Row="9" Visibility="Collapsed" Opacity="0.5" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <TextBox x:Name="FormatText" Margin="5,1" Grid.Row="9" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="OKButton" Content="{Binding Connection_OK,Source={StaticResource resourceWrapper}}" Click="OKButton_Click" MinWidth="75" Height="23" HorizontalAlignment="Right"/>
            <Button x:Name="CancelButton" Content="{Binding Connection_Cancel,Source={StaticResource resourceWrapper}}" Click="CancelButton_Click" MinWidth="75" Height="23" HorizontalAlignment="Right" Margin="5,5,5,5"/>
        </StackPanel>
    </Grid>
</sync:WindowControl>