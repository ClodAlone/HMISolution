<sync:WindowControl x:Class="Syncfusion.Silverlight.Tools.Olap.ConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Client.Olap.Resources"
    xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"    
     Icon="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/ConnectServer.png" ResizeMode="NoResize" AnimationType="Zoom"
    mc:Ignorable="d" Width="400" Height="Auto">
    <sync:WindowControl.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
    </sync:WindowControl.Resources>
    <Grid x:Name="LayoutRoot">        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderThickness="1" BorderBrush="Black" Margin="10" CornerRadius="5" VerticalAlignment="Top">
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <RadioButton Content="{Binding Server,Source={StaticResource resourceWrapper}}" x:Name="serverCubeOption" Click="serverCubeOption_Click" Margin="2" IsChecked="True" GroupName="connectionOptionGroup" />
                <Grid Margin="20,2,2,10">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*" />
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ServerName,Source={StaticResource resourceWrapper}}" x:Name="serverNameTitile" Grid.Row="0" Grid.Column="0" Margin="2" />
                    <TextBox Text=""  x:Name="serverNameBox" Grid.Row="0" Grid.Column="1" Margin="2" />
                    <TextBlock Text="{Binding DatabaseName,Source={StaticResource resourceWrapper}}"  x:Name="databaseNameTitle" Grid.Row="1" Grid.Column="0" Margin="2" />
                    <TextBox Text=""  x:Name="databaseNameBox" Grid.Row="1" Grid.Column="1" Margin="2"/>
                </Grid>
                <CheckBox Content="{Binding Credentials,Source={StaticResource resourceWrapper}}" x:Name="credentialOption" Click="credentialOption_Click" IsChecked="False" Margin="20,2" />
                <Grid Margin="20,2,2,10" x:Name="credentialContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*" />
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UserName,Source={StaticResource resourceWrapper}}" x:Name="userIdTitle" Grid.Row="0" Grid.Column="0" Margin="2" />
                    <TextBox Text=""  x:Name="userIdBox" Grid.Row="0" Grid.Column="1" Margin="2"/>
                    <TextBlock Text="{Binding Password,Source={StaticResource resourceWrapper}}" x:Name="passwordTitle" Grid.Row="1" Grid.Column="0" Margin="2" />
                    <PasswordBox Password=""  x:Name="passwordBox" Grid.Row="1" Grid.Column="1" Margin="2"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Black" Margin="10" CornerRadius="5" VerticalAlignment="Top">
            <StackPanel Orientation="Vertical">
                <RadioButton Content="{Binding ConnectionString,Source={StaticResource resourceWrapper}}" x:Name="connectionStringOption" Click="connectionStringOption_Click" Margin="2" GroupName="connectionOptionGroup" />
                <TextBox TextWrapping="Wrap" TextOptions.TextHintingMode="Animated" x:Name="connectionStringBox" Margin="20,2,2,10" Height="100" IsEnabled="False" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="Black" Margin="10" CornerRadius="5" VerticalAlignment="Top">
            <StackPanel Orientation="Vertical">
                <TextBlock Margin="2" Text="{Binding ProviderHeader,Source={StaticResource resourceWrapper}}" />
                <StackPanel Margin="20,2,2,2" Orientation="Horizontal">
                    <RadioButton Content="{Binding ProviderSSAS,Source={StaticResource resourceWrapper}}" ToolTipService.ToolTip="{Binding ProviderSSASToolTip,Source={StaticResource resourceWrapper}}" GroupName="providerName" x:Name="providerSSAS" VerticalAlignment="Center" IsChecked="True" />
                    <RadioButton Content="{Binding ProviderMondrian,Source={StaticResource resourceWrapper}}" ToolTipService.ToolTip="{Binding ProviderMondrianToolTip,Source={StaticResource resourceWrapper}}" GroupName="providerName" x:Name="providerMondrian"  VerticalAlignment="Center" />
                    <RadioButton Content="{Binding ProviderActivePivot,Source={StaticResource resourceWrapper}}" ToolTipService.ToolTip="{Binding ProviderActivePivotToolTip,Source={StaticResource resourceWrapper}}" GroupName="providerName" x:Name="providerActivePivot" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,5">
            <Button Content="{Binding Connection_OK,Source={StaticResource resourceWrapper}}" x:Name="okButton" Click="okButton_Click" Margin="2" Padding="40,5" />
            <Button Content="{Binding Connection_Cancel,Source={StaticResource resourceWrapper}}" x:Name="cancelButton" Click="cancelButton_Click" Margin="2" Padding="30,5"  />
        </StackPanel>
    </Grid>
</sync:WindowControl>
