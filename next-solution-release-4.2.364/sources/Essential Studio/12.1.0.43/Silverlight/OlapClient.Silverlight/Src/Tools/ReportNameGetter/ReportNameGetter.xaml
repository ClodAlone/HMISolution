<sync:WindowControl x:Class="Syncfusion.Silverlight.Tools.Olap.ReportNameGetter"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Client.Olap.Resources"
           Icon="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/New_Report.png"
           Height="108" ResizeMode="NoResize" AnimationType="Zoom">
    <sync:WindowControl.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
    </sync:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="5" Text="{Binding ReportName,Source={StaticResource resourceWrapper}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"></TextBlock>
            <TextBox Name="reportName" Margin="0,0,5,0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OKButton" Content="{Binding Connection_OK,Source={StaticResource resourceWrapper}}" Height="23" MinWidth="55" Click="OKButton_Click" TabIndex="0"  Grid.Row="1" />
            <Button x:Name="CancelButton" Content="{Binding Connection_Cancel,Source={StaticResource resourceWrapper}}" Click="CancelButton_Click" MinWidth="55" Height="23" Margin="5 0 5 0" Grid.Row="1" />
        </StackPanel>
    </Grid>
</sync:WindowControl>