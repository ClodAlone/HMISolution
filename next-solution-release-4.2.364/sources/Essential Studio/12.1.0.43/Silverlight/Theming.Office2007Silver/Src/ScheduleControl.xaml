<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:schedulecontrol="clr-namespace:Syncfusion.Windows.Controls.Schedule;assembly=Syncfusion.Schedule.Silverlight"
    >
    <Style x:Key="schedulecontrol:Schedule" TargetType="schedulecontrol:Schedule">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="schedulecontrol:Schedule">
                    <Grid x:Name="PART_MainGrid" Background="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="200"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFE1E5EA" Visibility="{TemplateBinding CalendarVisibility}">
                            <schedulecontrol:ScheduleCalendarViewItemsControl x:Name="PART_CalendarView" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Border BorderBrush="#FFC1CEDE" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFC5D3E3" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <schedulecontrol:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" Visibility="{TemplateBinding TitleBarVisibility}"/>
                                <schedulecontrol:ContentViewItemsControl x:Name="PART_MainViewItems" SelectedIndex="0" Grid.Row="1" Margin="2">
                                    <schedulecontrol:ContentViewItemsControl.Items>
                                        <schedulecontrol:ScheduleDaysView Margin="1" x:Name="PART_DaysView" />
                                        <schedulecontrol:ScheduleMonthView Margin="1" x:Name="PART_MonthView" />
                                        <schedulecontrol:ScheduleHorizontalView Margin="1" x:Name="PART_HorizontalView" />
                                    </schedulecontrol:ContentViewItemsControl.Items>
                                </schedulecontrol:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="schedulecontrol:Schedule" BasedOn="{StaticResource schedulecontrol:Schedule}"/>

</ResourceDictionary>
