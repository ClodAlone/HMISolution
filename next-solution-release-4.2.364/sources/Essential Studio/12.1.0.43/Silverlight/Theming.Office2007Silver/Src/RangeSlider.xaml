                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RangeSliderThumbMouseOverBrushKey}"/>
                            </ObjectAnimationUsingKeyFrames>



                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Focus">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="paththumbsecond" Storyboard.TargetProperty="Fill">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RangeSliderThumbMouseOverBrushKey}"/>
                            </ObjectAnimationUsingKeyFrames>



                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="paththumbsecond" Storyboard.TargetProperty="Fill">
