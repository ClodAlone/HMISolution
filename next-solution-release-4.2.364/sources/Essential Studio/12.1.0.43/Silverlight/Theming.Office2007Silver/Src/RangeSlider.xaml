            <Path Stretch="Fill" x:Name="paththumbsecond"  Stroke="{StaticResource RangeSliderThumbBorderBrushKey}" StrokeThickness="1" Fill="{StaticResource RangeSliderThumbBrushKey}"   Data="M261,231 L290.5,230.5 290.5,258 259.5,259 237.5,246 z">

