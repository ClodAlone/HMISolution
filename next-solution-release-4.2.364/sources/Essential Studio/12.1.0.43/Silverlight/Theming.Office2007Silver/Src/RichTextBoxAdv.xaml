<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rich="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.RichTextBoxAdv.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">

    <LinearGradientBrush x:Key="office2007silverbackgroundbrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFADAEB5" Offset="0"/>
        <GradientStop Color="#FFADAEB5" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="rich:RichTextBoxAdv">
        <!--<Setter Property="SelectionFillColor" Value="{StaticResource SelectionFillColor}"></Setter>-->
		<Setter Property="Background" Value="{StaticResource office2007silverbackgroundbrush}"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource office2007silverbackgroundbrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:RichTextBoxAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Background="{TemplateBinding Background}">
                        <local:ContextMenuAdvService.ContextMenuAdv>
                            <local:ContextMenuAdv x:Name="PART_ContextMenu">
                                <local:ContextMenuItemAdv x:Name="PART_Cut" Header="Cut" Command="{TemplateBinding CutCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Cut16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Copy" Header="Copy" Command="{TemplateBinding CopyCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Copy16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Paste" Header="Paste" Command="{TemplateBinding PasteCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Paste16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:SeparatorAdv />
                                <local:ContextMenuItemAdv x:Name="PART_Table" Header="Table"  Command="{TemplateBinding InsertTableDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Table32.png" Width="16" Height="16" Margin="3 0 0 0" />
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Font" Header="Font..." Command="{TemplateBinding FontDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Fontdialog.png" Width="16" Height="16" Margin="3 0 0 0" />
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Paragraph" Header="Paragraph..." Command="{TemplateBinding ParagraphDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Paragraphdialog.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Bullet" Header="Bullet" Command="{TemplateBinding ChangeListTypeCommand}" CommandParameter="Bulleted">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Bullets16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Numbering" Header="Numbering" Command="{TemplateBinding ChangeListTypeCommand}" CommandParameter="Numbered">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Numbering16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:SeparatorAdv />
                                <local:ContextMenuItemAdv x:Name="PART_Hyperlink" Header="Hyperlink" Command="{TemplateBinding HyperlinkDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Hyperlink16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                            </local:ContextMenuAdv>
                        </local:ContextMenuAdvService.ContextMenuAdv>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.Column="0"/>
                            <ScrollBar x:Name="HorizontalScrollBar" Grid.Column="0" Height="16" Visibility="Collapsed" IsTabStop="False" Minimum="0" Orientation="Horizontal" Grid.Row="1"/>
                            <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" IsTabStop="False" Visibility="Collapsed" Minimum="0" Orientation="Vertical" Grid.Row="0" Width="16"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageLayoutViewer">        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageLayoutViewer">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:CaretAdv">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:CaretAdv">
                    <Rectangle x:Name="rectangle" Fill="{TemplateBinding Background}"></Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageAdv">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageAdv">
                    <Grid>
                        <Border x:Name="PART_shadowEfffect" Background="Black" Opacity="0.3" CornerRadius="0" BorderThickness="0">
                            <Border.Effect>
                                <BlurEffect Radius="15"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Background="White" CornerRadius="0" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="IBeam">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
