            <GradientStop Offset="0.000000" Color="#ffc5bdc5"/>
            <GradientStop Offset="0.159341" Color="#ffd7d6db"/>
            <GradientStop Offset="0.686813" Color="#ffc5cad6"/>
            <GradientStop Offset="1.000000" Color="#ffe8e9f1"/>
