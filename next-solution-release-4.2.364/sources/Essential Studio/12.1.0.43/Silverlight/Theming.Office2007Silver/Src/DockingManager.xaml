        <LinearGradientBrush.Transform>
            <MatrixTransform Matrix="1.000000,0.000000,-0.000000,-1.000000,-493.549805,507.499512" />
        </LinearGradientBrush.Transform>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007Silver.ControlBackground" Color="#FFD6D7DE" />

    <SolidColorBrush x:Key="Office2007Silver.WindowBackground" Color="#EEEEF4" />

    <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0" x:Key="Office2007Silver.TabItemMouseHoverColor">
        <GradientStop Color="Gainsboro" Offset="0"/>
        <GradientStop Color="LightGray" Offset="0.025"/>
        <GradientStop Color="#FFE5E1DC" Offset="0.475"/>
        <GradientStop Color="#FFE5CC93" Offset="0.967"/>
        <GradientStop Color="#FFCEC3AA" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007Silver.TabItemBackgroundSelected" Color="#FFF7F7FF" />
    <SolidColorBrush x:Key="Office2007Silver.TabForeground" Color="#FF4A515A" />
    <SolidColorBrush x:Key="Office2007Silver.FloatHeaderBorderBrush" Color="#FFB2B2B2" />
    <SolidColorBrush x:Key="Office2007Silver.FloatHeaderBackground" Color="#EEEEF4" />

    <LinearGradientBrush x:Key="Office2007Silver.FloatHeaderMiddleBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE7E3E7" Offset="0"/>
        <GradientStop Color="#FFD8D7DC" Offset="0.2"/>
        <GradientStop Color="#A8AEB5" Offset="0.3"/>
        <GradientStop Color="#FFECECF4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007Silver.FloatHeaderMiddleBackgroundInactive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF2EFF2" Offset="0"/>
        <GradientStop Color="#FFE4E3E8" Offset="0.18"/>
        <GradientStop Color="#DADCDF" Offset="0.25"/>
        <GradientStop Color="#FFF2F2F9" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Office2007Silver.ListBoxStyle1" TargetType="ListBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Grid x:Name="LayoutRoot">
                            <Border Grid.Column="1" Background="White">
                                <ItemsPresenter />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="Office2007Silver.ButtonBackgroundBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFF9D1" Offset="1" />
            <GradientStop Color="#FFFFEAA3" Offset="0.65" />
            <GradientStop Color="#FFFFD75C" Offset="0.6" />
            <GradientStop Color="#FFFFD456" Offset="0.25" />
            <GradientStop Color="#FFFFE395" Offset="0.05" />
            <GradientStop Color="#FFFFEAAD" Offset="0" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Style x:Key="Office2007Silver.ListBoxItemStyle1" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="Padding" Value="0"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="RootElement" Width="110" Height="28">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />


                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2007.Blue.ButtonBackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#CAB583"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" Duration="0" To="0"/>
                                        <DoubleAnimation Storyboard.TargetName="LineBorder" Storyboard.TargetProperty="Opacity" Duration="0" To="0"/>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualState x:Name="Unselected" />
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" CornerRadius="2">
                            <Grid x:Name="ItemGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LineBorder" BorderThickness="1,0,0,0" BorderBrush="Gray" Grid.Column="1"></Border>
                                <Border x:Name="HoverBorder" Background="LightGray" Opacity="1"></Border>
                                <Image x:Name="tick" Width="20" Height="20" Opacity="0" Source="/Syncfusion.DockingManager.Silverlight;component/Images/Tick.png" Margin="3"/>

                                <ContentPresenter Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3"
                      Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2007Silver.AwlButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">

                    <Border Background="Transparent" Height="14" >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualState x:Name="Focused"/>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Disabled"/>
                                <vsm:VisualState x:Name="Normal"/>

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="mouseHoverRectangle" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="mousePressedRectangle" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="checkedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="uncheckedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>

                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="checkedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="uncheckedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Indeterminate"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid Height="Auto" Width="Auto">
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mousePressedRectangle">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF95999D" Offset="0"/>
                                        <GradientStop Color="#FFB0B4B8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFDDDEDE"/>
                                        <GradientStop Color="#FFF0F0F0" Offset="0.013"/>
                                        <GradientStop Color="#FFCFCFCF" Offset="0.163"/>
                                        <GradientStop Color="#FFBFC3C7" Offset="0.472"/>
                                        <GradientStop Color="#FFA4A8AC" Offset="0.528"/>
                                        <GradientStop Color="#FFD3DBE3" Offset="0.94"/>
                                        <GradientStop Color="#FFFBFBFB" Offset="0.987"/>
                                        <GradientStop Color="#FFECEDEE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mouseHoverRectangle">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFE3E5E6" Offset="0"/>
                                        <GradientStop Color="#FFCBD0D6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFF8F8F8" Offset="0.465"/>
                                        <GradientStop Color="#FFE7EBEF" Offset="0.947"/>
                                        <GradientStop Color="#FFF8F9F9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Grid>
                                    <Border x:Name="uncheckedArrow" Margin="0,0,1,1" BorderThickness="1" BorderBrush="Transparent" Width="15" Height="15" >
                                        <Canvas Width="15" Height="15" >
                                            <Rectangle Name="uncheckAwlBtnImg" Stroke="Black" StrokeThickness="1" Width="5" Height="7" Canvas.Top="2" Canvas.Left="4" />
                                            <Path Name="uncheckAwlInnerShadowBtnImg" Stroke="Black" Fill="Transparent" Data="M 7.5 9 L 7.5 2" />
                                            <Path Name="uncheckAwlLineBtnImg"  Stroke="Black" Fill="Transparent" Data="M 2 8.5 L 11 8.5" />
                                            <Path Name="uncheckAwlBottomLineBtnImg" Stroke="Black" Fill="Transparent" Data="M 6.5 9 L 6.5 12" />

                                        </Canvas>
                                    </Border>

                                    <Border Margin="0,0,1,1" BorderThickness="1" BorderBrush="Transparent" Width="15" Height="15" Opacity="0" RenderTransformOrigin="0.5,0.5" x:Name="checkedArrow" >
                                        <Canvas Width="15" Height="15" >
                                            <Rectangle Name="AwlBtnImg" Stroke="Black" StrokeThickness="1" Width="5" Height="7" Canvas.Top="2" Canvas.Left="4" />
                                            <Path Name="AwlInnerShadowBtnImg" Stroke="Black" Fill="Transparent" Data="M 7.5 9 L 7.5 2" />
                                            <Path Name="AwlLineBtnImg"  Stroke="Black" Fill="Transparent" Data="M 2 8.5 L 11 8.5" />
                                            <Path Name="AwlBottomLineBtnImg" Stroke="Black" Fill="Transparent" Data="M 6.5 9 L 6.5 12" />
                                        </Canvas>
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="90"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="office2007SilverMaximize" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualState x:Name="Focused"/>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Disabled"/>
                                <vsm:VisualState x:Name="Normal"/>

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="mouseHoverRectangle" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="mousePressedRectangle" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="checked" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="uncheckedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>

                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="checked" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="uncheckedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Indeterminate"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid Height="Auto" Width="Auto">
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mousePressedRectangle">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF95999D" Offset="0"/>
                                        <GradientStop Color="#FFB0B4B8" Offset="1"/>
                                    </LinearGradientBrush>
