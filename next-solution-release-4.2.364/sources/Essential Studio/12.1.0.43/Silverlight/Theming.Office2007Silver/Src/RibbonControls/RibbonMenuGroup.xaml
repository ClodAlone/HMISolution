<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight" >

    <LinearGradientBrush x:Key="RibbonMenuBottomBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEDEDED" Offset="0"/>
        <GradientStop Color="#FFE1E1E1" Offset="0.056"/>
        <GradientStop Color="#FFDDDDDD" Offset="0.611"/>
        <GradientStop Color="#FFCACACA" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="local:RibbonMenuGroup" x:Key="Office2007SilverRibbonMenuGroupStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonMenuGroup">
                    <Grid Name="gri">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextConverter"/>
                            <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#FFF0F2F5" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="22" Grid.Row="0" BorderThickness="1" BorderBrush="#FFFFFFFF">
                            <!--<TextBlock TextAlignment="Left" Text="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF403D3E" />-->
                            <ContentControl Content="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF00156E" HorizontalContentAlignment="Left"/>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>
                                <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter} }" BorderBrush="#FFE6E8EA" Background="#FFFFFFFF" BorderThickness="0,0,2,0" Width="26" HorizontalAlignment="Left"/>
                                <Border>
                                    <ScrollViewer TabNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border BorderBrush="#FFE2E4E7" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" Background="#FFFFFFFF" BorderThickness="0,0,2,0" Width="22" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Background="{StaticResource RibbonMenuBottomBrush}" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                            <Grid>
                                <Border HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FF454545" CornerRadius="2" Height="3" Width="3"/>

                                        <Border  Background="#FF454545" CornerRadius="2"  Height="3" Width="3" Margin="-5,0,0,0"/>
                                        <Border Background="#FF454545" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>

                                        <Border  Background="#FF454545" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                        <Border Background="#FF454545" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                        <Border  Background="#FF454545" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style BasedOn="{StaticResource Office2007SilverRibbonMenuGroupStyle}" TargetType="local:RibbonMenuGroup"/>
</ResourceDictionary>
