<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
                    xmlns:sfgridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight">
    <local:GridDataHeightConverter x:Key="groupAreaVisibilityConverter" />
    <Style TargetType="local:GridDataControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridDataControl">
                    <Grid x:Name="PART_MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="PART_GroupDropAreaBorder"
                                Grid.Row="0"
                                Height="{Binding GroupDropAreaHeight,
                                                 Mode=TwoWay,
                                                 RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="0,0,0,-1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Visibility="{Binding Path=ShowGroupDropArea,
                                                     RelativeSource={RelativeSource TemplatedParent},
                                                     Converter={StaticResource groupAreaVisibilityConverter}}">
                            <sfgridcommon:ScrollableContentViewer CanContentScroll="True"
                                                                  FontSize="14"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  Style="{TemplateBinding ScrollViewerStyle}"
                                                                  VerticalScrollBarVisibility="Hidden">
                                <local:GridDataGroupDropAreaGridImpl x:Name="PART_GroupDropAreaGrid" />
                            </sfgridcommon:ScrollableContentViewer>
                        </Border>
                        <Border x:Name="PART_Border"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <sfgridcommon:ScrollableContentViewer x:Name="PART_ScrollViewer"
                                                                  CanContentScroll="True"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  Style="{TemplateBinding ScrollViewerStyle}"
                                                                  VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <Border Name="PART_BorderStatusBar"
                                Grid.Row="2"
                                Height="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="3,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding StatusBarMessage}"
                                           TextTrimming="WordEllipsis" />
                                <Border Grid.Column="1"
                                        Margin="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="5">
                                    <Button x:Name="PART_CloseButton"
                                            Width="10"
                                            Height="10"
                                            Margin="0,5,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#FFFC5F4B"
                                            BorderBrush="White"
                                            Canvas.ZIndex="1">
                                        <ToolTipService.ToolTip>
                                            <TextBlock Text="Close" />
                                        </ToolTipService.ToolTip>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimationUsingKeyFrames BeginTime="00:00:00"
                                                                                                  Duration="00:00:00.0010000"
                                                                                                  Storyboard.TargetName="path1"
                                                                                                  Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                                        <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFFC5F4B" />
                                                                    </ColorAnimationUsingKeyFrames>
                                                                    <ColorAnimationUsingKeyFrames BeginTime="00:00:00"
                                                                                                  Duration="00:00:00.0010000"
                                                                                                  Storyboard.TargetName="path"
                                                                                                  Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                                        <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFFC5F4B" />
                                                                    </ColorAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed" />
                                                            <VisualState x:Name="Disabled">
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                                                        <SplineDoubleKeyFrame KeyTime="0" Value=".55" />
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="FocusStates">
                                                            <VisualState x:Name="Focused" />
                                                            <VisualState x:Name="Unfocused" />
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Grid Background="Transparent">
                                                        <Path x:Name="path1"
                                                              Data="M100.33679,95.997467 L726.36096,557.77032"
                                                              Stretch="Fill"
                                                              Stroke="Black"
                                                              StrokeThickness="2" />
                                                        <Path x:Name="path"
                                                              Data="M13,461 L621,13"
                                                              Stretch="Fill"
                                                              Stroke="Black"
                                                              StrokeThickness="2" />
                                                    </Grid>
                                                    <Rectangle x:Name="DisabledVisualElement"
                                                               Fill="#FFFFFFFF"
                                                               IsHitTestVisible="false"
                                                               Opacity="0"
                                                               RadiusX="3"
                                                               RadiusY="3" />
                                                    <Rectangle x:Name="FocusVisualElement"
                                                               Margin="1"
                                                               IsHitTestVisible="false"
                                                               Opacity="0"
                                                               RadiusX="2"
                                                               RadiusY="2"
                                                               Stroke="#FF6DBDD1"
                                                               StrokeThickness="1" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
