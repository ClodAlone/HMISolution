    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010SilverHorizontalThumbBorderBrush" Color="#FF8A9199" />

    <LinearGradientBrush x:Key="Office2010SilverVerticalThumbBackground" StartPoint="0.018,0.503" EndPoint="0.945,0.503">
        <GradientStop Offset="0.067" Color="#FFF0F4F8" />
