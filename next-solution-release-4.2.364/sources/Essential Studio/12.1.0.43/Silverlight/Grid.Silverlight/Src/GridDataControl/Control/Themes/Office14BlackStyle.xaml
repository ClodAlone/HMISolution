                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExtendButton" Storyboard.TargetProperty="Path.Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.5"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="FadeAnimation">
                                    <Storyboard x:Name="Fade">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PopUpBorder">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MenuItemSelected">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MenuItemFocused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemContent" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SubMenuItemFocused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>

                        <!--<Border x:Name="Border" Grid.ColumnSpan="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>-->
                        <Border x:Name="MenuItemHoverBorder"  Margin="1,2,2,0" Grid.ColumnSpan="5" Background="{StaticResource MenuItemMouseHoverBackgroundBrushKey}" BorderBrush="{StaticResource MenuItemMouseHoverBorderBrushKey}" BorderThickness="1" Opacity="0"/>
                        <Border x:Name="SubItemBorder" Grid.ColumnSpan="5" Margin="2,0,2,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                        <Border x:Name="SubItemHoverBorder" Grid.ColumnSpan="5" Margin="2,0,2,0" Background="{StaticResource SubItemMouseHoverBackgroundBrushKey}" BorderBrush="{StaticResource SubItemMouseHoverBorderBrushKey}" BorderThickness="1" Opacity="0" CornerRadius="2"/>

                        <Grid x:Name="IconGrid" MinHeight="25" Grid.Column="0" MinWidth="25">
                            <ContentControl x:Name="IconContent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,3,3,-1" Height="25" Width="25"/>
                            <CheckBox x:Name="CheckBoxPanel" Visibility="{TemplateBinding CheckBoxVisibility}" Style="{TemplateBinding CheckBoxStyle}"/>
                            <RadioButton x:Name="RadioButtonPanel" Visibility="{TemplateBinding RadioButtonVisibility}" Style="{TemplateBinding RadioButtonStyle}"/>
                        </Grid>

                        <ContentControl  Grid.Column="2" x:Name="MenuItemContent" Margin="{TemplateBinding Padding}" VerticalAlignment="Top" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                        <TextBlock x:Name="GestureTextBlock" Grid.Column="3" Margin="{TemplateBinding Padding}" VerticalAlignment="Top" HorizontalAlignment="Right" Text="{TemplateBinding InputGestureText}" Visibility="Collapsed"/>

                        <Border Grid.Column="4" Visibility="{TemplateBinding ExtendButtonVisibility}">
                            <Path Name="ExtendButton" Fill="{StaticResource ExtendButtonFillKey}" Stretch="Fill" Grid.Column="5" Stroke="{StaticResource ExtendButtonFillKey}" HorizontalAlignment="Left" Width="3" Height="5"
                                      UseLayoutRounding="False" Data="M129,173 L129,282 L246,222 z" />
                        </Border>

                        <Popup x:Name="SubMenuPopup">
                            <Border x:Name="PopUpBorder" BorderBrush="Transparent" Background="Transparent">
                                <Border Margin="2.5,2.5,0,0" Background="{StaticResource PopUpShadowBrushKey}">
                                    <Border Background="{StaticResource PopUpBackgroundBrush}" BorderBrush="{StaticResource PopUpBorderBrush}" BorderThickness="0.7" Margin="-2.5,-2.5,3,3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Height="{TemplateBinding ScrollerHeight}" Visibility="Collapsed" Grid.Row="0" x:Name="PART_TopScroll" Style="{TemplateBinding TopScrollButtonStyle}"/>
                                            <Grid Grid.Row="1" x:Name="PopUpGrid">
                                                <Rectangle RadiusX="2" RadiusY="2" Fill="{StaticResource PopUpLeftBackgroundBrush}" Width="26" Margin="0,0,5,4" HorizontalAlignment="Left"/>
                                                <Rectangle Fill="LightGray" Width="1" Margin="26,0,0,0" HorizontalAlignment="Left"/>
                                                <Rectangle Fill="White" Width="1" Margin="27,0,0,0" HorizontalAlignment="Left"/>
                                                <ScrollViewer x:Name="PART_ScrollViewer" BorderBrush="Transparent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </Grid>
                                            <Button Height="{TemplateBinding ScrollerHeight}" Visibility="Collapsed" Grid.Row="2" x:Name="PART_BottomScroll" Style="{TemplateBinding BottomScrollButtonStyle}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Projection>
                                    <PlaneProjection/>
                                </Border.Projection>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office14BlackMenuItemStyle}" TargetType="shared:MenuItemAdv"/>

</ResourceDictionary>
