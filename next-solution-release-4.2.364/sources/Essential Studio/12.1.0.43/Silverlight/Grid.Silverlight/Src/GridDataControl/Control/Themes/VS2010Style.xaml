                                       RadiusY="1"
                                       Stroke="{StaticResource RangeSliderBorder}"
                                       StrokeThickness="{TemplateBinding BorderThickness}" />
                            <Rectangle x:Name="HorizontalTrackRectangleDisabledOverlay"
