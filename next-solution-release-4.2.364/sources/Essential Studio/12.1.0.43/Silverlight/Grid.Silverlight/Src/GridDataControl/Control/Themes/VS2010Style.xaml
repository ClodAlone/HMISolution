                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="TrackRectangle"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Height="3"
                                       Margin="5,0,5,0"
