    <SolidColorBrush x:Key="RadioButtonBorderBrushKey" Color="#FF333333" />

    <SolidColorBrush x:Key="RadioButtonBackgroundBrushKey" Color="#FF666666" />

    <SolidColorBrush x:Key="RadioButtonMouseOverBrushKey" Color="#FFFFFFFF" />
    <!--  ComboBox  -->
    <SolidColorBrush x:Key="ComboBoxBorderBrushKey" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBoxToggleButtonBrushKey" Color="#FF808080" />
    <SolidColorBrush x:Key="ComboBoxToggleButtonCheckedBrushKey" Color="#FF808080" />


    <SolidColorBrush x:Key="ComboBoxBackgroundBrushKey" Color="#FF333333" />

    <SolidColorBrush x:Key="ComboBoxItemBackgroundBrushKey" Color="Transparent" />
