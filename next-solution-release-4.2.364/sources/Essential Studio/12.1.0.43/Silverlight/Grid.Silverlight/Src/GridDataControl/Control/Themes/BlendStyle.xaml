    <SolidColorBrush x:Key="ScrollBarThumbBrushKey" Color="#FF808080" />

    <SolidColorBrush x:Key="ScrollBarThumbMouseOverBrushKey" Color="#FFAAAAAA" />

    <SolidColorBrush x:Key="ScrollBarThumbPressedBrushKey" Color="#FFE5E5E5" />

