    <local:NullToInt32Converter x:Key="nullToInt32Cov" />

    <SolidColorBrush x:Key="brushWatermarkBackground" Color="White" />
    <SolidColorBrush x:Key="brushWatermarkForeground" Color="LightSteelBlue" />
    <SolidColorBrush x:Key="brushWatermarkBorder" Color="Indigo" />

    <Style x:Key="EntryFieldStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GridDataTextFilteringPaneStyle" TargetType="local:GridDataTextFilteringPane">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridDataTextFilteringPane">
                    <Border Width="230"
                            Height="130"
                            Background="{StaticResource Background}"
                            BorderBrush="Gray"
                            BorderThickness="0.7"
                            CornerRadius="4">
                        <Grid x:Name="LayoutRoot" Margin="5,0,5,5">
                            <Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
							 <Button x:Name="PART_CloseButton"
                                            Width="17"
                                            Height="17"
                                            Margin="0,2,-3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"                                          
                                           Style="{StaticResource AdvanceFilteringCloseButton}"
                                            Canvas.ZIndex="1">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="Close" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Border Grid.Row="1" Margin="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PART_ORRadioButton" Content="{Binding OR, Source={StaticResource ResourceString}}" />
                                    <RadioButton x:Name="PART_ANDRadioButton"
                                                 Margin="10,0,0,0"
                                                 Content="{Binding AND,
                                                                   Source={StaticResource ResourceString}}" />
                                    <CheckBox x:Name="PART_CaseCheckBox"
                                              Margin="10,0,0,0"
                                              Content="{Binding MatchCase,
                                                                Source={StaticResource ResourceString}}"
                                              Foreground="#FF837070" />
                                </StackPanel>
                            </Border>
                            <ComboBox Name="PART_ComboBox"
                                      Grid.Row="2"
                                      Margin="3"
                                      HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedComboValue,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Grid.Row="3" Margin="3">
                                <TextBlock Margin="5,2"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource BrushWatermarkForeground}"
                                           Text="{Binding EnterFilterValue,
                                                          Source={StaticResource ResourceString}}"
                                           Visibility="{Binding ElementName=PART_TextBox,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                Path=Text,
                                                                Converter={StaticResource textBlockVisibilityConverter}}" />
                                <TextBox Name="PART_TextBox"
                                         VerticalAlignment="Stretch"
                                         HorizontalContentAlignment="Left"
                                         Background="Transparent"
                                         Text="{Binding Path=Text,
                                                        Mode=TwoWay,
                                                        RelativeSource={RelativeSource TemplatedParent},
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                            </Grid>

                            <Button Name="PART_ClearButton"
                                    Grid.Row="4"
                                    Width="50"
                                    Height="20"
                                    Margin="3"
                                    HorizontalAlignment="Right"
                                    Content="{Binding Clear,
                                                      Source={StaticResource ResourceString}}"
                                    Padding="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource GridDataTextFilteringPaneStyle}" TargetType="local:GridDataTextFilteringPane" />

    <Style x:Key="GridDataDateTimeFilteringPaneStyle" TargetType="local:GridDataDateTimeFilteringPane">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridDataDateTimeFilteringPane">
                    <Border Width="250"
                            
                            CornerRadius="4"
                           
                            Background="{StaticResource Background}">
                        <Grid x:Name="LayoutRoot" Margin="5,0,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{Binding ElementName=PART_ComboBox, Path=SelectedValue, Converter={StaticResource VisibleHeightConverter}}" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="PART_CloseButton"
                                    Grid.Row="0"
                                            Width="17"
                                            Height="17"
                                            Margin="0,2,-3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"                                          
                                           Style="{StaticResource AdvanceFilteringCloseButton}"
                                            Canvas.ZIndex="1">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="Close" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Border Grid.Row="1" Margin="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PART_ORRadioButton" Content="{Binding OR, Source={StaticResource ResourceString}}" />
                                    <RadioButton x:Name="PART_ANDRadioButton"
                                                 Margin="10,0,0,0"
                                                 Content="{Binding AND,
                                                                   Source={StaticResource ResourceString}}" />
                                </StackPanel>
                            </Border>
                          
                            <ComboBox Name="PART_ComboBox"
                                      Grid.Row="2"
                                      Margin="3"
                                      Height="22"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      
                                     
                                      SelectedValue="{Binding SelectedComboValue,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}" />

                            <sfshared:DateTimeEdit x:Name="PART_StartDateTimeEdit"
                                                   Grid.Row="3"
                                                  Height="22"
                                                   Margin="3"
                                                   DateTime="{Binding Path=StartDate,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IsEmptyDateEnabled="True"
                                                   NoneDateText="{Binding SelectFilterDate,
                                                                          Source={StaticResource ResourceString}}"
                                                    />
                            <sfshared:DateTimeEdit x:Name="PART_EndDateTimeEdit"
                                                   Grid.Row="4"
                                                   Margin="3"
                                                  Height="22"
                                                   DateTime="{Binding Path=EndDate,
                                                                      Mode=TwoWay,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IsEmptyDateEnabled="True"
                                                   NoneDateText="{Binding FilterDateTo,
                                                                          Source={StaticResource ResourceString}}"
                                                  
                                                   Visibility="{Binding ElementName=PART_ComboBox,
                                                                        Path=SelectedValue,
                                                                        Converter={StaticResource VisiblityConverter}}" />
                            <Button Name="PART_ClearButton"
                                    Grid.Row="5"
                                    Margin="3"
                                    Width="50"
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    Content="{Binding Clear,
                                                      Source={StaticResource ResourceString}}"
                                    Padding="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource GridDataDateTimeFilteringPaneStyle}" TargetType="local:GridDataDateTimeFilteringPane" />


    <Style x:Key="GridDataInt32SliderFilteringPaneStyle" TargetType="local:GridDataInt32SliderFilteringPane">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridDataInt32SliderFilteringPane">
                    <Border Width="250"
                            Height="180"
                            Background="{StaticResource Background}"
                            BorderBrush="Gray"
                            BorderThickness="0.7"
                            CornerRadius="4">
                        <Grid x:Name="LayoutRoot" Margin="5,0,5,5">
                            <Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

 <Button x:Name="PART_CloseButton"
                                            Width="17"
                                            Height="17"
                                            Margin="0,2,-3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"                                          
                                           Style="{StaticResource AdvanceFilteringCloseButton}"
                                            Canvas.ZIndex="1">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="Close" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Border Grid.Row="1" Margin="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PART_ORRadioButton" Content="{Binding OR, Source={StaticResource ResourceString}}" />
                                    <RadioButton x:Name="PART_ANDRadioButton"
                                                 Margin="10,0,0,0"
                                                 Content="{Binding AND,
                                                                   Source={StaticResource ResourceString}}" />
                                </StackPanel>
                            </Border>

                            <ComboBox Name="PART_ComboBox"
                                      Grid.Row="2"
                                      Margin="3"
                                      HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedComboValue,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="{Binding None, Source={StaticResource ResourceString}}" />
                                <ComboBoxItem Content="{Binding GreaterThan, Source={StaticResource ResourceString}}" />
                                <ComboBoxItem Content="{Binding GreaterThanOrEqual, Source={StaticResource ResourceString}}" />
                                <ComboBoxItem Content="{Binding LessThan, Source={StaticResource ResourceString}}" />
                                <ComboBoxItem Content="{Binding LessThanOrEqual, Source={StaticResource ResourceString}}" />
                                <ComboBoxItem Content="{Binding EqualsString, Source={StaticResource ResourceString}}" />
                                <ComboBoxItem Content="{Binding NotEquals, Source={StaticResource ResourceString}}" />
                            </ComboBox>
                            <TextBlock Grid.Row="3"
                                       Margin="3"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Foreground="#FF837070"
                                       Text="{Binding SlideToFilter,
                                                      Source={StaticResource ResourceString}}"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Row="4" Margin="3">
                                <Slider Name="PART_Slider"
                                        Margin="3"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Maximum="{Binding MaxValue,
                                                          Mode=OneWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                        Minimum="{Binding MinValue,
                                                          Mode=OneWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                        Value="{Binding Value,
                                                        Mode=TwoWay,
                                                        RelativeSource={RelativeSource TemplatedParent},
                                                        Converter={StaticResource nullToInt32Cov}}" />
                                <StackPanel Margin="3" Orientation="Horizontal">
                                    <TextBlock HorizontalAlignment="Stretch"
                                               Foreground="#FF837070"
                                               Text="Filtered Value : " />
                                    <TextBlock HorizontalAlignment="Stretch"
                                               Foreground="#FF837070"
                                               Text="{Binding Value,
                                                              ElementName=PART_Slider,
                                                              Converter={StaticResource DoubleToIntConverter}}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Name="PART_ClearButton"
                                    Grid.Row="5"
                                    Width="50"
                                    Height="20"
                                    Margin="3"
                                    HorizontalAlignment="Right"
                                    Content="{Binding Clear,
                                                      Source={StaticResource ResourceString}}"
                                    Padding="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource GridDataInt32SliderFilteringPaneStyle}" TargetType="local:GridDataInt32SliderFilteringPane" />

