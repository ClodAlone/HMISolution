                                                                       RelativeSource={RelativeSource TemplatedParent},
                                                                       Converter={StaticResource marginConverterForOldExcelLikeFiltering},
                                                                       ConverterParameter=ItemsControl}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch"
                                                      BorderBrush="Gray"
                                                      BorderThickness="0.7"
                                                      ItemTemplate="{TemplateBinding ItemsTemplate}"
                                                      ItemsSource="{TemplateBinding ItemsSource}">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="0"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="scrollViewer"
                                                                      HorizontalAlignment="Stretch"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      Padding="2"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter Margin="0,20,0,0" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                        </ItemsControl>

                                        <Border x:Name="border"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="6,4,0,-22"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="White"
                                                Visibility="{Binding Visibility,
                                                                     ElementName=textBlock,
                                                                     Converter={StaticResource reverseVisibilityConverter}}">
                                            <StackPanel Margin="0,3,2,1"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="White"
                                                        Orientation="Horizontal">
                                                <CheckBox x:Name="PART_CheckBox"
                                                          Margin="5,0,5,0"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Margin="5,0,5,0"
                                                           HorizontalAlignment="Left"
                                                           Text="{Binding SelectAllFilter,
                                                                          Source={StaticResource ResourceString}}" />
                                            </StackPanel>
                                        </Border>

                                        <!--  This TextBlock to show case the NoItem found if search have no item  -->
                                        <TextBlock x:Name="textBlock"
                                                   Grid.Row="1"
                                                   Margin="10,20,0,-19"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Foreground="Gray"
                                                   Text="{Binding NoItemMatch,
                                                                  Source={StaticResource ResourceString}}"
                                                   Visibility="{Binding Items.Count,
                                                                        ElementName=PART_ItemsControl,
                                                                        Converter={StaticResource itemsSourceCountConverter},
                                                                        ConverterParameter={TemplateBinding ExcelLikeFilterAdvVisibility}}" />
                                    </Grid>



                                    <StackPanel Grid.Row="3"
                                                Grid.Column="1"
                                                Margin="0,10,5,5"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Visibility="{Binding OkCancelButtonVisibility,
                                                                     RelativeSource={RelativeSource TemplatedParent},
                                                                     Converter={StaticResource ResourceKey=booleanToVisibilityConverter}}">
                                        <Button Name="PART_OkButton"
                                                Width="65"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Content="OK"
                                                Padding="0,2,0,2" />
                                        <Button Name="PART_CancelButton"
                                                Width="65"
                                                Height="20"
                                                Margin="7,0,0,0"
                                                HorizontalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Content="Cancel"
                                                Padding="0,2,0,2" />
                                    </StackPanel>

                                    <Border Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            BorderBrush="LightGray"
                                            BorderThickness="0.5"
                                            Visibility="{Binding ResizingOptionVisibility,
                                                                 RelativeSource={RelativeSource TemplatedParent},
                                                                 Converter={StaticResource ResourceKey=booleanToVisibilityConverter}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStop Offset="0" Color="Transparent" />
                                                    <GradientStop Offset="1" Color="#E3E3E3" />
                                                </LinearGradientBrush.GradientStops>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Thumb Name="PART_ResizingThumb"
                                               Width="10"
                                               Height="8"
                                               HorizontalAlignment="Right"
                                               HorizontalContentAlignment="Right"
                                               Cursor="SizeNWSE">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Grid Background="Transparent" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Border>

                                </Grid>
                            </Border>
                        </Border>
                    </Popup>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

