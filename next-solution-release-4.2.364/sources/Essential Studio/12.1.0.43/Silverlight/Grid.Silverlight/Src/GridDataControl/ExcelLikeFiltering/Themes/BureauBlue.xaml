<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
                    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls.Scroll;assembly=Syncfusion.GridCommon.Silverlight"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
                    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Grid.Silverlight;component/GridDataControl/Control/Themes/BureauBlueStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <local:TextVisibilityConverter x:Key="textBlockVisibilityConverter" />
    <local:ItemsSourceCountConverter x:Key="itemsSourceCountConverter" />
    <local:ReverseVisibilityConverter x:Key="reverseVisibilityConverter" />
    <sfshared:BooleanToVisibilityConverterEx x:Key="booleanToVisibilityConverter" />
    <local:IconFillColorConverter x:Key="iconFillColorConverter" />
    <local:SortIconBackGroundConverter x:Key="sortIconBackGroundConverter" />
    <local:MarginConverterForOldExcelLikeFiltering x:Key="marginConverterForOldExcelLikeFiltering" />
    <SolidColorBrush x:Key="BrushWatermarkForeground" Color="LightSteelBlue" />

    <local:ResourceHelper x:Key="ResourceString" />

    <SolidColorBrush x:Key="Background" Color="White" />

    <LinearGradientBrush x:Key="SortIconBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#FFF39625" />
        <GradientStop Offset="0.059" Color="#FFFD9205" />
        <GradientStop Offset="0.971" Color="#FFFD6D01" />
        <GradientStop Offset="1" Color="#FFF67819" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SortIconBorderBrush" Color="Orange" />

    <DataTemplate x:Key="Defaulttemplate">
        <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
            <CheckBox Margin="5,0,5,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Content="{Binding Name,
                                        Mode=TwoWay}"
                      IsChecked="{Binding IsSelected,
                                        Mode=TwoWay}"
                      Padding="10,0,0,0"
                      gridcommon:VisualContainer.WantsMouseInput="True" />
        </StackPanel>
    </DataTemplate>

        <!--  Excel Like Filter Pane Definition  -->
    <Style x:Key="BureauBlueGridDataExcelLikeFilterPaneStyle" TargetType="local:GridDataExcelLikeFilterPane">
        <Setter Property="ItemsTemplate" Value="{StaticResource Defaulttemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridDataExcelLikeFilterPane">

                    <Popup x:Name="PART_FilterPopup"
                           Width="{TemplateBinding ActualWidth}"
                           Height="{TemplateBinding ActualHeight}"
                           MinWidth="250"
                           MinHeight="304"
                           HorizontalAlignment="Right"
                           HorizontalOffset="0"
                           IsOpen="{Binding Path=IsOpen,
                                            Mode=TwoWay,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                           VerticalOffset="1">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortAscendingBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortAscendingBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortDescendingBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortDescendingBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Ascending">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortAscendingBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SortIconBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortAscendingBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SortIconBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortDescendingBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortDescendingBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Descending">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortAscendingBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortAscendingBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortDescendingBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SortIconBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SortDescendingBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SortIconBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

