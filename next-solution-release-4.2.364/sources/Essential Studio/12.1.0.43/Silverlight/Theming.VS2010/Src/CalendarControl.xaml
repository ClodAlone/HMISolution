<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <SolidColorBrush x:Key="CalendarControlBackgroundBrushKey" Color="#FF2C3D5A" />

    <SolidColorBrush x:Key="CalendarControlBorderBrushKey" Color="#FF2C3D5A" />

    <SolidColorBrush x:Key="TextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="CalendarControlHeaderTextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="ScrollButtonFillKey" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="MouseHoverScrollButtonFillKey" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="MouseHoverHeaderBackgroundKey" Color="#FFFFFF00"/>
  
    <LinearGradientBrush x:Key="MouseHoverCellBackgroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6F7776" Offset="0.044"/>
        <GradientStop Color="#FF546375" Offset="0.805"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MouseHoverCellBorderBrushKey" Color="#FF9BA7B7" />

    <SolidColorBrush x:Key="MouseHoverCellForegroundKey" Color="#FFFFFFFF" />
  
    <LinearGradientBrush x:Key="SelectedCellBackgroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF2" Offset="0.028"/>
        <GradientStop Color="#FFFFF3CF" Offset="0.442"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.456"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.986"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SelectedCellBorderBrushKey" Color="#FF000000"/>
    
    <SolidColorBrush x:Key="SelectedCellForegroundKey" Color="#FF000000"/>

    <LinearGradientBrush x:Key="NextMonthDaysForegroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4D6082" Offset="0.045"/>
        <GradientStop Color="#FF3D5277" Offset="0.955"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PreviousMonthDaysForegroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4D6082" Offset="0.045"/>
        <GradientStop Color="#FF3D5277" Offset="0.955"/>
    </LinearGradientBrush>  

    <Style x:Key="VS2010CalendarStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CalendarControlBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarControlBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="DayForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="DateForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource CalendarControlHeaderTextBrushKey}"/>
        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource MouseHoverScrollButtonFillKey}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource ScrollButtonFillKey}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>       
        <Setter Property="MouseHoverCellBackground" Value="{StaticResource MouseHoverCellBackgroundKey}"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="{StaticResource MouseHoverCellBorderBrushKey}"/>
        <Setter Property="MouseHoverCellForeground" Value="{StaticResource MouseHoverCellForegroundKey}"/>
        <Setter Property="NextMonthDaysForeground" Value="{StaticResource NextMonthDaysForegroundKey}"/>
        <Setter Property="PreviousMonthDaysForeground" Value="{StaticResource PreviousMonthDaysForegroundKey}"/>
        <Setter Property="SelectedCellBackground" Value="{StaticResource SelectedCellBackgroundKey}"/>
        <Setter Property="SelectedCellBorderBrush" Value="{StaticResource SelectedCellBorderBrushKey}"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource SelectedCellForegroundKey}"/>
        <Setter Property="Padding" Value="2" />        
    </Style>
    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource VS2010CalendarStyle}"/>
</ResourceDictionary>
