<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gauge="clr-namespace:Syncfusion.Windows.Gauge;assembly=Syncfusion.Gauge.Silverlight">

    <!-- Brushes -->

    <SolidColorBrush x:Key="CircularGaugeInnerFrameBrushKey" Color="#FF8995AB"/>
  
    <RadialGradientBrush  x:Key="CircularGaugeBackgroundBrushKey" RadiusX="0.565" RadiusY="0.565" Center="0.513,0.494" GradientOrigin="0.513,0.494">
        <RadialGradientBrush.RelativeTransform>
            <TransformGroup>
                <RotateTransform CenterX="0.523476" CenterY="0.523795" Angle="-40.4402"/>
            </TransformGroup>
        </RadialGradientBrush.RelativeTransform>
        <GradientStop Color="#FF5B6B87" Offset="0.99"/>
        <GradientStop Color="#FFDDE1E8"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="CircularGaugeOuterFrameBrushKey" Color="#FFD9DADA"/>
    <SolidColorBrush x:Key="CircularGaugeMiddleFrameBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="CircularScaleBackgroundBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="CircularPointerBackgroundBrushKey" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="MarkTickSetTickBackgroundKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="PointerCapBackgroundBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="PointerCapInnerCapBrushKey" Color="Transparent"/>

    <RadialGradientBrush x:Key="PointerCapOuterCapBrushKey" RadiusY="0.497467586883809" Center="0.502,0.501" GradientOrigin="0.502,0.501" RadiusX="0.497467586883809">
        <RadialGradientBrush.RelativeTransform>
            <TransformGroup/>
        </RadialGradientBrush.RelativeTransform>
        <GradientStop Color="#FFCAD1DC" Offset="0.193"/>
        <GradientStop Color="#FF556683" Offset="0.789"/>
        <GradientStop Color="White" Offset="0.827"/>
        <GradientStop Color="#FFB9B9B9" Offset="0.995"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="LabelTickSetLabelForegroundKey" Color="White"/>
    <SolidColorBrush x:Key="LabelTickSetBackgroundBrushKey" Color="White"/>

    <LinearGradientBrush x:Key="LinearGaugeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF5B6B87" Offset="0.99"/>
        <GradientStop Color="#FFD9DDE5" Offset="0.015"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearGaugeInnerFrameBrushKey" Color="#FF8995AB"/>

    <SolidColorBrush x:Key="LinearGaugeMiddleFrameBrushKey" Color="#FF8995AB"/>

    <SolidColorBrush x:Key="LinearGaugeOuterFrameBrushKey" Color="#FFD9DADA"/>

    <LinearGradientBrush x:Key="LinearRangeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFAFA" Offset="0"/>
        <GradientStop Color="#FFF90D0D" Offset="0.808"/>
        <GradientStop Color="#FEB9AFAF" Offset="0"/>
        <GradientStop Color="#FEF03939" Offset="0.558"/>
        <GradientStop Color="#FEE6A4A4" Offset="0.344"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearScaleOuterBackgroundKey" Color="#FF8995AB"/>
    <SolidColorBrush x:Key="LinearScaleInnerBackgroundKey" Color="#FFD9DADA"/>

    <LinearGradientBrush x:Key="LinearBarPointerBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,-0.633">
        <GradientStop Color="#5EFFFFFF"/>
        <GradientStop Color="#FFE63639" Offset="0.7"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearMarkerPointerBackgroundBrushKey" Color="#FFD9DADA"/>

    <LinearGradientBrush x:Key="StateIndicatorBackgroundBrushKey" StartPoint="1.02308,1.52318" EndPoint="1.02308,0.523175">
        <GradientStop Color="#FFFDA519" Offset="0"/>
        <GradientStop Color="#FFFC8E26" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StateIndicatorActiveBackgroundBrushKey" EndPoint="0.5,0.33" StartPoint="0.5,0.985">
        <GradientStop Color="#FFFDA519" Offset="0"/>
        <GradientStop Color="#FFFB8E25" Offset="1"/>
    </LinearGradientBrush>
   
    <!-- Styles -->

    <Style x:Key="gauge:CircularGauge" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource CircularGaugeBackgroundBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource CircularGaugeInnerFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource CircularGaugeMiddleFrameBrushKey}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource CircularGaugeOuterFrameBrushKey}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:CircularGauge">
                    <Grid x:Name="PART_ContainerBorder">
                        <gauge:ScalesLayoutPanel x:Name="PART_ScalesPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Ellipse x:Name="PART_FirstBorder"/>
                            <Ellipse x:Name="PART_MiddleBorder"/>
                            <Ellipse x:Name="PART_SecondBorder"/>
                            <Ellipse x:Name="PART_InnerBorder" Fill="{TemplateBinding Background}"/>
                            <Path x:Name="PART_GlassPath"  Fill="Transparent"  Visibility="Collapsed"  Stretch="Fill" Data="F1M282.135,394.512C337.16,413.935,407.94,425.628,485.167,425.628L485.167,425.628C574.645,425.628,655.457,409.936,713.152,384.694L713.152,384.694C675.129,305.147,593.913,250.179,499.855,250.179L499.855,250.179C401.98,250.179,317.999,309.697,282.135,394.512" UseLayoutRounding="False">
                                <!--<Path.Fill>
                                    <LinearGradientBrush EndPoint="0.5,0.916" StartPoint="0.503,0.01">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#FFE9EBF5" Offset="0.55757099390029907"/>
                                        <GradientStop Color="#FFDCE0F2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>-->
                                <!--<Path.OpacityMask>
                                    <LinearGradientBrush EndPoint="0.5,0.916" StartPoint="0.503,0.01">
                                        <GradientStop Color="Black" Offset="0"/>
                                        <GradientStop Color="sc#0, 0, 0, 0" Offset="0.55757099390029907"/>
                                        <GradientStop Color="sc#0, 0, 0, 0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.OpacityMask>-->
                            </Path>
                            <Path x:Name="PART_SecondPath" Fill="White"  Stretch="Fill" Opacity="0" UseLayoutRounding="False" Canvas.Left="151.506" Canvas.Top="150.583" Data="M23.813,48.523994 L23.059002,71.669014 L0.018982558,102.494 L0,89.092018 C1.8840039,80.06501 23.813,48.523994 23.813,48.523994 z M97.926033,0 L98.409035,20.007011 C98.409035,20.007011 69.127037,26.323996 29.690039,65.467995 L31.881046,40.099995 C31.881046,40.099995 55.803032,10.439999 97.926033,0 z"/>
                            <ContentPresenter x:Name="PART_DigitalDisplay" Content="{TemplateBinding DigitalValue}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                        </gauge:ScalesLayoutPanel>


                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="gauge:CircularGauge" BasedOn="{StaticResource gauge:CircularGauge}"/>

    <Style x:Key="gauge:GaugeBorder" TargetType="gauge:GaugeBorder">
    </Style>

    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource gauge:GaugeBorder}"/>

    <Style x:Key="gauge:CircularScale" TargetType="gauge:CircularScale">
        <Setter Property="Background" Value="{StaticResource CircularScaleBackgroundBrushKey}"/>
        <Setter Property="ScaleBarSize" Value="10"/>
    </Style>
    <Style TargetType="gauge:CircularScale" BasedOn="{StaticResource gauge:CircularScale}"/>

    <Style x:Key="gauge:CircularPointer" TargetType="gauge:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="Background" Value="{StaticResource CircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
    </Style>
    <Style TargetType="gauge:CircularPointer" BasedOn="{StaticResource gauge:CircularPointer}"/>

    <Style x:Key="gauge:PointerCap" TargetType="gauge:PointerCap">
        <Setter Property="Background" Value="{StaticResource PointerCapBackgroundBrushKey}"/>
        <Setter Property="InnerCapBrush" Value="{StaticResource PointerCapInnerCapBrushKey}"/>
        <Setter Property="OuterCapBrush" Value="{StaticResource PointerCapOuterCapBrushKey}"/>
        <Setter Property="PointerCapRadius" Value="15"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource gauge:PointerCap}"/>

    <Style x:Key="gauge:CircularKnob" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource gauge:CircularKnob}"/>  

    <Style x:Key="gauge:MarkTickSet" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource MarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource gauge:MarkTickSet}"/>

    <Style x:Key="gauge:LabelTickSet" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LabelForeground" Value="#FFFFFFFF"/>
        <Setter Property="TickPlacement" Value="Inside"/>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource gauge:LabelTickSet}"/>

    <Style x:Key="gauge:CircularRange" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource gauge:CircularRange}"/>

    <Style x:Key="gauge:GaugeLabel" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource gauge:GaugeLabel}"/>

    <Style x:Key="gauge:GaugeImage" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource gauge:GaugeImage}"/>

    <Style x:Key="gauge:StateIndicator" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
        <Setter Property="ActiveBackgroundBrush" Value="{StaticResource StateIndicatorActiveBackgroundBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource StateIndicatorBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource gauge:StateIndicator}"/>
 
</ResourceDictionary>
