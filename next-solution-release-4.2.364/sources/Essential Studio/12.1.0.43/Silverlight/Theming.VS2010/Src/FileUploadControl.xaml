                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2.5*" />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource FileUploadButtonStyle}" Width="100" Content="Browse..." Margin="5,0,5,0"  Command="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BrowseCommand}"
                                            Height="25" x:Name="BtnBrowse" FontSize="12" Grid.Column="0"/>
                                <Button Style="{StaticResource FileUploadButtonStyle}" Width="100" Content="Upload" Margin="5,0,5,0" Command="{Binding RelativeSource={RelativeSource TemplatedParent},Path=UploadCommand}"
                                            x:Name="BtnUpload" FontSize="12" Grid.Column="1"/>
                                <Button Style="{StaticResource FileUploadButtonStyle}" Width="100" Content="Clear All" Margin="5,0,5,0" Command="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ClearCommand}"
                                            x:Name="BtnClear" FontSize="12" FontFamily="Arial" Grid.Column="2"/>

                                <Image HorizontalAlignment="Right" VerticalAlignment="Center"  x:Name="ThumbnailImage" Grid.Column="3" Grid.RowSpan="2" Grid.Row="1" Margin="0,0,10,0">
                                    <Image.Effect>
