<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
  xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"   xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">

    <!-- Brushes -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CommonBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!--<SolidColorBrush x:Key="TaskBarItemHeaderBackgroundBrushKey" Color="#FFEAF2FB"/>-->


    <!--<LinearGradientBrush x:Key="TaskBarItemHeaderBackgroundBrushKey" StartPoint="0.868476,-0.0333333" EndPoint="0.868476,1.12222">
        <GradientStop Color="White" Offset="0.01"/>
        <GradientStop Color="#FFE3EFFF" Offset="0.034"/>
        <GradientStop Color="#FFAFD2FF" Offset="0.995"/>
    </LinearGradientBrush>-->
    <SolidColorBrush x:Key="TaskBarItemHeaderBackgroundBrushKey" Color="#FF45597D"/>

    <SolidColorBrush x:Key="TextBrushKey" Color="Black" />
   
    <SolidColorBrush x:Key="TaskBarItemBackgroundBrushKey" Color="White" />
    <SolidColorBrush x:Key="TaskBarItemBorderBrushKey" Color="#FF2C3D5B"/>
    <SolidColorBrush x:Key="ToggleButtonFillBrushKey" Color="#FFCED4DD"/>

    <LinearGradientBrush x:Key="MouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE3EFFF" Offset="0.014"/>
        <GradientStop Color="#FFFEFEFF" Offset="0.515"/>
        <GradientStop Color="#FFE3EFFF" Offset="0.999"/>
        <GradientStop Color="#FF1A1A1A" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ToggleButtonFillBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrushKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <!--<VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>-->
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Background" Background="#FFFFF9E6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid Margin="1" Background="{TemplateBinding Background}">
                                <Border x:Name="BackgroundAnimation" Opacity="0" Background="{StaticResource BackgroundAnimationBrushKey}"/>
                                <Rectangle x:Name="BackgroundGradient" Fill="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="3" RadiusY="3" IsHitTestVisible="false" Opacity="0"/>
                        <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" RadiusX="2" RadiusY="2" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
   

    <Style x:Key="VS2010TaskBarItemStyle" TargetType="local:TaskBarItem">
        <Setter Property="Background" Value="{StaticResource TaskBarItemBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TaskBarItemBorderBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsHeaderShown" Value="True"/>
        <Setter Property="HeaderHeight" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TaskBarItem">
                    <Grid x:Name="MainGrid"  >
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderGrid"   Background="{StaticResource TaskBarItemHeaderBackgroundBrushKey}" >
                                <Border x:Name="HeaderBorder" BorderBrush="{StaticResource TaskBarItemBorderBrushKey}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{StaticResource TaskBarItemHeaderBackgroundBrushKey}" Padding="1"  >
                                    <controlsToolkit:DockPanel x:Name="Head" LastChildFill="False" >
                                        <ToggleButton Style="{StaticResource ToggleButtonStyle}" controlsToolkit:DockPanel.Dock="Right"  x:Name="ExpanderButton" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsTabStop="False"  Margin="3"/>
                                        <ContentControl  controlsToolkit:DockPanel.Dock="Left" x:Name="HeaderContent" Content="{TemplateBinding Header}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},  Path=HeaderTemplate}" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" Foreground="White"  />
                                    </controlsToolkit:DockPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="ContentGrid"   Background="{TemplateBinding Background}" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
                                <Border x:Name="ContentBorder" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="1"        
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter x:Name="TaskBarContent"  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ItemContentTemplate}"   >
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource VS2010TaskBarItemStyle}" TargetType="local:TaskBarItem"/>

    <Style x:Key="VS2010TaskBarStyle" TargetType="local:TaskBar">
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="local:TaskBar">
                    <Border x:Name="MainBorder"  BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                     Background="{TemplateBinding Background}">
                        <StackPanel  x:Name="MainGrid" Orientation="Horizontal">
                            <ItemsPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource VS2010TaskBarStyle}" TargetType="local:TaskBar">
        <Setter Property="ItemContainerStyle" Value="{StaticResource VS2010TaskBarItemStyle}"/>
    </Style>


</ResourceDictionary>
