<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gauge="clr-namespace:Syncfusion.Windows.Gauge;assembly=Syncfusion.Gauge.Silverlight">

    <!-- Brushes -->
      
    <SolidColorBrush x:Key="MarkTickSetTickBackgroundKey" Color="#FF8995AB"/>

    <SolidColorBrush x:Key="PointerCapBackgroundBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="PointerCapInnerCapBrushKey" Color="Transparent"/>

    <RadialGradientBrush x:Key="PointerCapOuterCapBrushKey" RadiusY="0.497467586883809" Center="0.502,0.501" GradientOrigin="0.502,0.501" RadiusX="0.497467586883809">
        <RadialGradientBrush.RelativeTransform>
            <TransformGroup/>
        </RadialGradientBrush.RelativeTransform>
        <GradientStop Color="#FFCAD1DC" Offset="0.193"/>
        <GradientStop Color="#FF556683" Offset="0.789"/>
        <GradientStop Color="White" Offset="0.827"/>
        <GradientStop Color="#FFB9B9B9" Offset="0.995"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="LabelTickSetLabelForegroundKey" Color="White"/>
    <SolidColorBrush x:Key="LabelTickSetBackgroundBrushKey" Color="#FF8995AB"/>
   
    <LinearGradientBrush x:Key="LinearGaugeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF5B6B87" Offset="0.99"/>
        <GradientStop Color="#FFD9DDE5" Offset="0.015"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HorizontalLinearGaugeBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF5B6B87" Offset="0.99"/>
        <GradientStop Color="#FFD9DDE5" Offset="0.015"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearGaugeInnerFrameBrushKey" Color="#FF8995AB"/>

    <SolidColorBrush x:Key="LinearGaugeMiddleFrameBrushKey" Color="#FF8995AB"/>   

    <SolidColorBrush x:Key="LinearGaugeOuterFrameBrushKey" Color="#FFD9DADA"/>

    <LinearGradientBrush x:Key="LinearRangeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFAFA" Offset="0"/>
        <GradientStop Color="#FFF90D0D" Offset="0.808"/>
        <GradientStop Color="#FEB9AFAF" Offset="0"/>
        <GradientStop Color="#FEF03939" Offset="0.558"/>
        <GradientStop Color="#FEE6A4A4" Offset="0.344"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearScaleOuterBackgroundKey" Color="#FF8995AB"/>
    <SolidColorBrush x:Key="LinearScaleInnerBackgroundKey" Color="#FFD9DADA"/>

    <LinearGradientBrush x:Key="LinearBarPointerBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,-0.633">
        <GradientStop Color="#5EFFFFFF"/>
        <GradientStop Color="#FFE63639" Offset="0.7"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearMarkerPointerBackgroundBrushKey" Color="#FFD9DADA"/>

    <LinearGradientBrush x:Key="StateIndicatorBackgroundBrushKey" StartPoint="1.02308,1.52318" EndPoint="1.02308,0.523175">
        <GradientStop Color="#FFFDA519" Offset="0"/>
        <GradientStop Color="#FFFC8E26" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StateIndicatorActiveBackgroundBrushKey" EndPoint="0.5,0.33" StartPoint="0.5,0.985">
        <GradientStop Color="#FFFDA519" Offset="0"/>
        <GradientStop Color="#FFFB8E25" Offset="1"/>
    </LinearGradientBrush>

    <!--Digital Gauge-->

    <SolidColorBrush x:Key="DigitalGaugeOuterFrameBrushKey" Color="#FFD9DADA"/>
    <SolidColorBrush x:Key="DigitalGaugeInnerFrameBrushKey" Color="#FF8995AB"/>
   
    <LinearGradientBrush x:Key="DigitalGaugeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD5DAE2" Offset="0.012"/>
        <GradientStop Color="#FF60708A" Offset="0.988"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="DigitalGaugeMiddleFrameBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="DigitalGaugeSegmentBrushKey" Color="#FFE5F0F5"/>
    
    <!--Rolling Gauge-->   

    <LinearGradientBrush x:Key="RollingGaugeBorderBrushKey" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
        <GradientStop Color="#FFD5DAE2" Offset="0.012"/>
        <GradientStop Color="#FF60708A" Offset="0.964"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RollingGaugeSegmentBorderBrushKey" Color="#FFE1E2F5"/>

    <SolidColorBrush x:Key="RollingGaugeBackgroundBrushKey" Color="#FFBFC4D1"/>   
   
    <SolidColorBrush x:Key="RollingGaugeTextBrushKey" Color="#FF3B3C64"/>

    <SolidColorBrush x:Key="RollingGaugeSegmentBackgroundKey" Color="White"/>  

    <!-- Styles -->   

    <Style x:Key="gauge:GaugeBorder" TargetType="gauge:GaugeBorder">
    </Style>
    
    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource gauge:GaugeBorder}"/>    

   <Style x:Key="gauge:PointerCap" TargetType="gauge:PointerCap">
        <Setter Property="Background" Value="{StaticResource PointerCapBackgroundBrushKey}"/>
        <Setter Property="InnerCapBrush" Value="{StaticResource PointerCapInnerCapBrushKey}"/>
        <Setter Property="OuterCapBrush" Value="{StaticResource PointerCapOuterCapBrushKey}"/>
        <Setter Property="PointerCapRadius" Value="15"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource gauge:PointerCap}"/>

    <Style x:Key="gauge:CircularKnob" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource gauge:CircularKnob}"/>

    <!--Digital Gauge-->
  
    <Style x:Key="gauge:DigitalGauge" TargetType="gauge:DigitalGauge">
        <Setter Property="MiddleFrameBrush" Value="{StaticResource DigitalGaugeMiddleFrameBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{StaticResource DigitalGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="Transparent"/>       
        <Setter Property="OuterFrameOffset" Value="28"/>
        <Setter Property="InnerFrameOffset" Value="18"/>
        <Setter Property="MiddleFrameOffset" Value="2"/>       
        <Setter Property="SegmentBrush" Value="{StaticResource DigitalGaugeSegmentBrushKey}"/>
        <Setter Property="Height" Value="150"/>
        <Setter Property="Width" Value="450"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:DigitalGauge">
                    <Grid x:Name="PART_ContainerBorder">
                        <gauge:LinearScaleLayoutPanel x:Name="PART_ScalesPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderWidth="{TemplateBinding BorderThickness}">
                            <Border Background="{StaticResource DigitalGaugeOuterFrameBrushKey}" CornerRadius="30">
                                <gauge:GaugeBorder x:Name="PART_FirstBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            </Border>
                            <Border Background="{StaticResource DigitalGaugeInnerFrameBrushKey}" CornerRadius="30">
                                <gauge:GaugeBorder x:Name="PART_SecondBorder"/>
                            </Border>
                            <Border Background="{TemplateBinding Background}" CornerRadius="30">
                                <gauge:GaugeBorder x:Name="PART_InnerBorder" Background="Transparent"/>
                            </Border>
                            <Path x:Name="PART_GlassPath"  Fill="White" Stretch="Fill" Opacity="0" Data="F1M6715.3052,7470.4629C6715.3052,7471.8589,6716.6032,7472.9919,6718.2042,7472.9919L7062.4512,7472.9919C7064.0542,7472.9919,7065.3532,7471.8589,7065.3532,7470.4629L7065.3532,7390.8089C7065.3532,7389.4979,7064.2062,7388.4349,7062.7422,7388.3059C6987.7532,7457.1769,6773.6622,7386.2859,6715.3052,7468.3669z"/>
                            <Path x:Name="PART_SecondGlassPath" Fill="White" Stretch="Fill" Opacity="0" Data="F1M6718.8335,7379.0537C6718.8335,7377.8267,6722.3825,7376.8327,6726.7605,7376.8327L7055.7205,7376.8327C7060.0995,7376.8327,7063.6475,7377.8267,7063.6475,7379.0537L7063.6475,7398.1127C7063.6475,7399.3387,7060.0995,7400.3327,7055.7205,7400.3327L6726.7605,7400.3327C6722.3825,7400.3327,6718.8335,7399.3387,6718.8335,7398.1127z"/>
                            <ContentPresenter  Content="{TemplateBinding InnerFrameContent}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ContentPresenter x:Name="PART_DigitalContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </gauge:LinearScaleLayoutPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="gauge:DigitalGauge" BasedOn="{StaticResource gauge:DigitalGauge}"/>

    <Style x:Key="gauge:MarkTickSet" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource MarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
		<Setter Property="DistanceFromScale" Value="4"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource gauge:MarkTickSet}"/>

    <Style x:Key="gauge:LabelTickSet" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LabelForeground" Value="#FFFFFFFF"/>
        <Setter Property="TickPlacement" Value="Inside"/>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource gauge:LabelTickSet}"/>

   <Style x:Key="gauge:CircularRange" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource gauge:CircularRange}"/>

    <Style x:Key="gauge:GaugeLabel" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource gauge:GaugeLabel}"/>

    <Style x:Key="gauge:GaugeImage" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource gauge:GaugeImage}"/>

   <Style x:Key="gauge:StateIndicator" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
        <Setter Property="ActiveBackgroundBrush" Value="{StaticResource StateIndicatorActiveBackgroundBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource StateIndicatorBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource gauge:StateIndicator}"/>

    <LinearGradientBrush x:Key="VerticalLinearBarPointerBackgroundBrush" EndPoint="1,0.395" StartPoint="-0.75,0.395">
        <GradientStop Color="#5EFFFFFF"/>
        <GradientStop Color="#FFE63639" Offset="0.7"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VerticalLinearRangeBackgroundBrush" EndPoint="2.08,0.528" StartPoint="-0.27,0.533">
        <GradientStop Color="#FF5B6B87" Offset="0.99"/>
        <GradientStop Color="#FFD9DDE5" Offset="0.015"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VerticalLinearBarBackgroundBrush" EndPoint="5.772,0.188" StartPoint="-4.772,0.179">
        <GradientStop Color="#5EFFFFFF"/>
        <GradientStop Color="#FFE63639" Offset="0.575"/>
    </LinearGradientBrush>

    <Style x:Key="gauge:LinearGauge" TargetType="gauge:LinearGauge">
        <Setter Property="InnerFrameBrush" Value="{StaticResource LinearGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource VerticalLinearRangeBackgroundBrush}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource LinearGaugeOuterFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource LinearGaugeMiddleFrameBrushKey}"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="OuterFrameOffset" Value="15"/>
        <Setter Property="InnerFrameOffset" Value="12"/>      
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:LinearGauge">
                    <Grid x:Name="PART_ContainerBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <gauge:LinearScaleLayoutPanel x:Name="PART_ScalesPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderWidth="{TemplateBinding BorderThickness}">
                            <gauge:GaugeBorder x:Name="PART_FirstBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <gauge:GaugeBorder x:Name="PART_MiddleBorder"/>
                            <gauge:GaugeBorder x:Name="PART_SecondBorder"/>
                            <gauge:GaugeBorder x:Name="PART_InnerBorder" Background="{TemplateBinding Background}"/>
                            <!--<Path x:Name="PART_GlassPath" Stretch="Fill" 
                                  Data="F1M1312.287,823.31C1304.858,823.31,1298.813,829.354,1298.813,836.783L1298.813,836.783L1298.813,842.123C1344.804,888.706,1404.4,987.421,1434.415,1194.948L1434.415,1194.948L1434.415,836.783C1434.415,829.354,1428.371,823.31,1420.942,823.31L1420.942,823.31z" UseLayoutRounding="False" 
                                  >
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="1.003,0.787" StartPoint="0.43,-0.062">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="sc#1, 0.9408364, 0.9459245, 0.9722317" Offset="0.056210434064269066"/>
                                        <GradientStop Color="sc#1, 0.889821649, 0.899297059, 0.948288" Offset="0.12542985692198272"/>
                                        <GradientStop Color="sc#1, 0.848573148, 0.8615959, 0.928928137" Offset="0.21881345384463202"/>
                                        <GradientStop Color="sc#1, 0.8204778, 0.8359168, 0.9157416" Offset="0.38083238867693581"/>
                                        <GradientStop Color="sc#1, 0.8148466, 0.8307699, 0.913098633" Offset="0.75518798828125"/>
                                        <GradientStop Color="#FFE9EBF5" Offset="0.75518798828125"/>
                                        <GradientStop Color="#FFDCE0F2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.OpacityMask>
                                    <LinearGradientBrush EndPoint="1.003,0.787" StartPoint="0.43,-0.062">
                                        <GradientStop Color="Black" Offset="0"/>
                                        <GradientStop Color="Black" Offset="0.056210434064269066"/>
                                        <GradientStop Color="Black" Offset="0.12542985692198272"/>
                                        <GradientStop Color="Black" Offset="0.21881345384463202"/>
                                        <GradientStop Color="Black" Offset="0.38083238867693581"/>
                                        <GradientStop Color="sc#0, 0, 0, 0" Offset="0.75518798828125"/>
                                        <GradientStop Color="sc#0, 0, 0, 0" Offset="0.75518798828125"/>
                                        <GradientStop Color="sc#0, 0, 0, 0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.OpacityMask>
                            </Path>-->
                            <ContentPresenter x:Name="PART_DigitalDisplay" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Content="{TemplateBinding DigitalValue}" 
                                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                        </gauge:LinearScaleLayoutPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="gauge:LinearGauge" BasedOn="{StaticResource gauge:LinearGauge}"/>

    <Style x:Key="gauge:LinearScale" TargetType="gauge:LinearScale">
        <Setter Property="OuterBackground" Value="Transparent"/>
        <Setter Property="InnerBackground" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Offset" Value="2"/>
        <Setter Property="RadiusX" Value="0"/>
        <Setter Property="RadiusY" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:LinearScale">
                    <gauge:LinearScaleLayoutPanel x:Name="PART_ScalesPanel" BorderWidth="{TemplateBinding BorderThickness}">                        
                    	<Border Background="{StaticResource LinearScaleInnerBackgroundKey}" BorderBrush="{StaticResource LinearScaleOuterBackgroundKey}" BorderThickness="1">
                    	<Grid Margin="-2">
                        <Path x:Name="PART_OuterPathRect" Fill="{TemplateBinding OuterBackground}"
                                Stroke="{TemplateBinding BorderBrush}"  StrokeThickness="0"/>
                        <Path x:Name="PART_InnerPathRect" Fill="{TemplateBinding InnerBackground}"
                                Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0"/>
                        <Path Fill="Transparent" Stretch="Fill"  Canvas.ZIndex="10" x:Name="PART_GlassPath" Data="F1M1129.1484,864.3437L1128.8164,554.4407C1128.7834,549.1267,1130.0544,546.7287,1131.1274,545.6507C1131.6134,545.1607,1132.1034,544.8957,1132.5094,544.7497L1131.9594,864.6247z"/>
						</Grid>
						</Border>
                    </gauge:LinearScaleLayoutPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="gauge:LinearScale" BasedOn="{StaticResource gauge:LinearScale}"/>

    <Style x:Key="gauge:LinearRange" TargetType="gauge:LinearRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource LinearRangeBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearRange" BasedOn="{StaticResource gauge:LinearRange}"/>

    <Style x:Key="gauge:LinearBarPointer" TargetType="gauge:LinearBarPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource VerticalLinearBarPointerBackgroundBrush}"/>      
        <Setter Property="PointerSelectionBrush" Value="Transparent"/>
		<Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:LinearBarPointer">
                    <gauge:LinearScaleLayoutPanel BorderWidth="{TemplateBinding BorderThickness}">
                        <Path x:Name="PART_SelectionPointerPath" Fill="{TemplateBinding Background}"
                              Stroke="Transparent" Visibility="Collapsed"/>
                        <Path x:Name="PART_PointerPath" Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"/>
                        
                        <Ellipse x:Name="PART_ThermoPointer" Fill="{TemplateBinding Background}" Canvas.ZIndex="10"
                                Stroke="{TemplateBinding BorderBrush}" />
                        
                            <Ellipse x:Name="PART_ThermoPointerGlass" 
                                Stroke="{TemplateBinding BorderBrush}" Canvas.ZIndex="20">
                            <Ellipse.Fill>
                                <LinearGradientBrush EndPoint="0.746,0.823" StartPoint="0.219,0.131">
                                    <GradientStop Color="#ffffffff" Offset="0"/>
                                    <GradientStop Color="#00ffffff" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                          
                    </gauge:LinearScaleLayoutPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="gauge:LinearBarPointer" BasedOn="{StaticResource gauge:LinearBarPointer}"/>

    <Style x:Key="gauge:LinearMarkerPointer" TargetType="gauge:LinearMarkerPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="PointerLength" Value="5" />
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross" />
        <Setter Property="Background" Value="{StaticResource LinearMarkerPointerBackgroundBrushKey}" />
    </Style>
    <Style TargetType="gauge:LinearMarkerPointer" BasedOn="{StaticResource gauge:LinearMarkerPointer}"/>  

    <!--Rolling Gauge-->
    
    <Style x:Key="VS2010RollingGaugeStyle" TargetType="gauge:RollingGauge">
        <Setter Property="BorderBrush" Value="{StaticResource RollingGaugeBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource RollingGaugeBackgroundBrushKey}"/>
        <Setter Property="SegmentBackground" Value="{StaticResource RollingGaugeSegmentBackgroundKey}"/>
        <Setter Property="SegmentForeground" Value="{StaticResource RollingGaugeTextBrushKey}"/>
        <Setter Property="SegmentBorderBrush" Value="{StaticResource RollingGaugeSegmentBorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="SegmentBorderThickness" Value="4"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>               
                <ControlTemplate TargetType="gauge:RollingGauge">
                    <Border BorderBrush="#FF8995AB" CornerRadius="7" BorderThickness=".8">
                    <Border Name="PART_ContainerBorder" 
                    BorderBrush="{TemplateBinding BorderBrush}"  
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    >
                        <Grid >
                        <StackPanel Name="PART_SegmentFrame"  
                                Orientation="Horizontal" 
                                Background="{TemplateBinding Background}"
                                >
                        </StackPanel>
                            <Border BorderBrush="#FF8995AB" BorderThickness="1" Opacity="0.685">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.505976,-0.0281891" EndPoint="0.505976,1.00788">
                                        <GradientStop Color="#00E5D1B4" Offset="0.317"/>
                                        <GradientStop Color="#FFABB4C2" Offset="1"/>
                                        <GradientStop Color="#6EB9B8EA"/>
                                        <GradientStop Color="#0BD8C3AD" Offset="0.325"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="gauge:RollingGauge" BasedOn="{StaticResource VS2010RollingGaugeStyle}"/>

    <Style x:Key="VS2010RollingCharacterStyle" TargetType="gauge:RollingCharacter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:RollingCharacter">
                    <Border Name="PART_SegmentBorder"          
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="0"  Margin="-0.8"
                Background="{TemplateBinding Background}"
                >
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Value}" Margin="0,2,0,0"
                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="gauge:RollingCharacter" BasedOn="{StaticResource VS2010RollingCharacterStyle}"/>

</ResourceDictionary>
