    <SolidColorBrush x:Key="TimeUpDownInvalidIconGlyph2StrokeBrushKey" Color="#FF1B1B54"/>

    <LinearGradientBrush x:Key="TimeUpDownInvalidIconGlyph2FillBrushKey" EndPoint="1.4,0.50126" StartPoint="-0.400002,0.50126">
        <GradientStop Color="#FFF7F79F" Offset="0.123636"/>
        <GradientStop Color="#FB8F8873" Offset="0.175974"/>
        <GradientStop Color="#F6271A47" Offset="0.236364"/>
        <GradientStop Color="#E7271A47" Offset="0.534545"/>
        <GradientStop Color="#9A89782B" Offset="0.941391"/>
        <GradientStop Color="#4DEBD60F" Offset="0.941818"/>
        <GradientStop Color="#FBF6EC20" Offset="0.956364"/>
        <GradientStop Color="#FFFFFF2F" Offset="0.963636"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TimeUpDownInvalidIconGlyph3StrokeBrushKey" Color="#FF1C1C50"/>

    <LinearGradientBrush x:Key="TimeUpDownInvalidIconGlyph3FillBrushKey" EndPoint="1.06,0.5" StartPoint="-0.0599991,0.5">
        <GradientStop Color="#F6271A47" Offset="0.236364"/>
        <GradientStop Color="#E7271A47" Offset="0.534545"/>
        <GradientStop Color="#9A89782B" Offset="0.98135"/>
        <GradientStop Color="#4DEBD60F" Offset="0.981818"/>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="RangeTimePickerPopupBackgroundBrushKey" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="RangeTimePickerCommitButtonStrokeBrushKey"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF67CA0A" />
        <GradientStop Color="#FF498C38" Offset="1" />
        <GradientStop Color="#FF29EE5B" Offset="0.375" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RangeTimePickerCommitButtonFillBrushKey"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF000000" />
