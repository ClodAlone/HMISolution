        <GradientStop Color="#FFFDA519" Offset="0"/>
        <GradientStop Color="#FFFB8E25" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StateIndicatorBackgroundBrushKey" EndPoint="0.5,0.33" StartPoint="0.5,0.985">
        <GradientStop Color="#FF00C914" Offset="0"/>
        <GradientStop Color="#FF3EC248" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearGaugeMiddleFrameBrushKey" Color="White"/>

    <LinearGradientBrush x:Key="LinearGaugeInnerFrameBrushKey" EndPoint="0.989,0.5" StartPoint="0.017,0.5">
        <GradientStop Color="#FFA7ADB7" Offset="0"/>
        <GradientStop Color="sc#1, 0.592766047, 0.5930181, 0.6208413" Offset="0.77177006006240845"/>
        <GradientStop Color="#FFE7E3E3" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="LinearGaugeBackgroundBrushKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.125" RadiusY="0.372">
        <GradientStop Color="#FFE0ECFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.7261673, 0.8276188, 1" Offset="0.610443115234375"/>
        <GradientStop Color="sc#1, 0.6843436, 0.8033114, 1" Offset="0.7698894739151001"/>
        <GradientStop Color="sc#1, 0.628860235, 0.771065235, 1" Offset="0.87665826082229614"/>
        <GradientStop Color="sc#1, 0.562505245, 0.7325006, 1" Offset="0.95973926782608032"/>
        <GradientStop Color="sc#1, 0.520995557, 0.708375752, 1" Offset="1"/>
        <GradientStop Color="#FFBFDBFF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="LinearGaugeOuterFrameBrushKey" EndPoint="1.056,0.5" StartPoint="0.036,0.5">
