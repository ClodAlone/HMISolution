    <Style x:Key="Office2003CircularGaugeStyle" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource Office2003CircularGaugeBackgroundBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2003CircularGaugeInnerFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2003CircularGaugeMiddleFrameBrushKey}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2003CircularGaugeOuterFrameBrushKey}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
    </Style>
    <Style TargetType="gauge:CircularGauge" BasedOn="{StaticResource Office2003CircularGaugeStyle}"/>

    <Style x:Key="Office2003GaugeBorderStyle" TargetType="gauge:GaugeBorder">
    </Style>
    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource Office2003GaugeBorderStyle}"/>

    <Style x:Key="Office2003CircularScaleStyle" TargetType="gauge:CircularScale">
        <Setter Property="ScaleBarSize" Value="10"/>
    </Style>
    <Style TargetType="gauge:CircularScale" BasedOn="{StaticResource Office2003CircularScaleStyle}"/>

    <Style x:Key="Office2003CircularPointerStyle" TargetType="gauge:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="Background" Value="{StaticResource Office2003CircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
    </Style>
    <Style TargetType="gauge:CircularPointer" BasedOn="{StaticResource Office2003CircularPointerStyle}"/>

    <Style x:Key="Office2003PointerCapStyle" TargetType="gauge:PointerCap">
        <Setter Property="PointerCapRadius" Value="7"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource Office2003PointerCapStyle}"/>

    <Style x:Key="Office2003CircularKnobStyle" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource Office2003CircularKnobStyle}"/>

    <Style x:Key="Office2003DigitalGaugeStyle" TargetType="gauge:DigitalGauge">
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2003DigitalGaugeMiddleFrameBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2003DigitalGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2003DigitalGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2003DigitalGaugeOuterFrameBrushKey}"/>
        <Setter Property="OuterFrameOffset" Value="12"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="MiddleFrameOffset" Value="2"/>
        <Setter Property="SegmentBrush" Value="{StaticResource Office2003DigitalGaugeSegmentBrushKey}"/>
    </Style>
    <Style TargetType="gauge:DigitalGauge" BasedOn="{StaticResource Office2003DigitalGaugeStyle}"/>

    <Style x:Key="Office2003MarkTickSetStyle" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource Office2003MarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource Office2003MarkTickSetStyle}"/>

    <Style x:Key="Office2003LabelTickSetStyle" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LabelForeground" Value="White"/>
        <Setter Property="TickPlacement" Value="Inside"/>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource Office2003LabelTickSetStyle}"/>

    <Style x:Key="Office2003CircularRangeStyle" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource Office2003CircularRangeStyle}"/>

    <Style x:Key="Office2003GaugeLabelStyle" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource Office2003GaugeLabelStyle}"/>

    <Style x:Key="Office2003GaugeImageStyle" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource Office2003GaugeImageStyle}"/>

    <Style x:Key="Office2003StateIndicatorStyle" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource Office2003StateIndicatorStyle}"/>

    <Style x:Key="Office2003LinearGaugeStyle" TargetType="gauge:LinearGauge">
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2003LinearGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2003LinearGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2003LinearGaugeOuterFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2003LinearGaugeMiddleFrameBrushKey}"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="OuterFrameOffset" Value="15"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="RadiusX" Value="15"/>
        <Setter Property="RadiusY" Value="15"/>
    </Style>
    <Style TargetType="gauge:LinearGauge" BasedOn="{StaticResource Office2003LinearGaugeStyle}"/>

    <Style x:Key="Office2003LinearScaleStyle" TargetType="gauge:LinearScale">
        <Setter Property="Offset" Value="2"/>
        <Setter Property="RadiusX" Value="5"/>
        <Setter Property="RadiusY" Value="10"/>
    </Style>
    <Style TargetType="gauge:LinearScale" BasedOn="{StaticResource Office2003LinearScaleStyle}"/>

    <Style x:Key="Office2003LinearRangeStyle" TargetType="gauge:LinearRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource Office2003LinearRangeBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearRange" BasedOn="{StaticResource Office2003LinearRangeStyle}"/>

    <Style x:Key="Office2003LinearBarPointerStyle" TargetType="gauge:LinearBarPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style TargetType="gauge:LinearBarPointer" BasedOn="{StaticResource Office2003LinearBarPointerStyle}"/>

    <Style x:Key="Office2003LinearMarkerPointerStyle" TargetType="gauge:LinearMarkerPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="PointerLength" Value="5" />
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross" />
        <Setter Property="Background" Value="{StaticResource Office2003LinearMarkerPointerBackgroundBrushKey}" />
    </Style>
    <Style TargetType="gauge:LinearMarkerPointer" BasedOn="{StaticResource Office2003LinearMarkerPointerStyle}"/>

    <Style x:Key="Office2003RollingGaugeStyle" TargetType="gauge:RollingGauge">
        <Setter Property="BorderBrush" Value="{StaticResource Office2003RollingGaugeBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2003RollingGaugeBackgroundBrushKey}"/>
        <Setter Property="SegmentBackground" Value="{StaticResource Office2003RollingGaugeSegmentBackgroundKey}"/>
        <Setter Property="SegmentForeground" Value="{StaticResource Office2003RollingGaugeTextBrushKey}"/>
        <Setter Property="SegmentBorderBrush" Value="{StaticResource Office2003RollingGaugeSegmentBorderBrushKey}"/>
    </Style>
    <Style TargetType="gauge:RollingGauge" BasedOn="{StaticResource Office2003RollingGaugeStyle}"/>

    <Style x:Key="Office2003RollingCharacterStyle" TargetType="gauge:RollingCharacter">
    </Style>
    <Style TargetType="gauge:RollingCharacter" BasedOn="{StaticResource Office2003RollingCharacterStyle}"/>






</ResourceDictionary>
