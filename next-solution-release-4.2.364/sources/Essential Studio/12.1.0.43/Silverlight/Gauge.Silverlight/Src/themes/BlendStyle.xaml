    <SolidColorBrush x:Key="BlendCircularGaugeMiddleFrameBrushKey" Color="#FFAAAAAA"/>
    <SolidColorBrush x:Key="BlendCircularScaleBackgroundBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="BlendCircularPointerBackgroundBrushKey" Color="#FFBDBDBD"/>
    <SolidColorBrush x:Key="BlendMarkTickSetTickBackgroundKey" Color="#FFAAAAAA"/>

    <SolidColorBrush x:Key="BlendLabelTickSetLabelForegroundKey" Color="White"/>
    <SolidColorBrush x:Key="BlendLabelTickSetBackgroundBrushKey" Color="White"/>

    <LinearGradientBrush x:Key="BlendLinearGaugeInnerFrameBrushKey" EndPoint="1.023,0.5" StartPoint="0.023,0.5">
        <GradientStop Color="#FF45484C" Offset="0"/>
        <GradientStop Color="sc#1, 0.08697331, 0.09347102, 0.101204164" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF5F6265" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="BlendLinearGaugeBackgroundBrushKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.125" RadiusY="0.372">
        <GradientStop Color="#FF969696" Offset="0"/>
        <GradientStop Color="sc#1, 0.240202367, 0.242509425, 0.245729312" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.184340477, 0.188636839, 0.194633156" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.139172778, 0.1450776, 0.153318807" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.108407959, 0.115408361, 0.1251786" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.102241725, 0.10946171, 0.119538426" Offset="1"/>
        <GradientStop Color="#FF5A5D61" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BlendLinearGaugeMiddleFrameBrushKey" Color="#FFAAAAAA"/>

    <LinearGradientBrush x:Key="BlendLinearGaugeOuterFrameBrushKey" EndPoint="1.042,0.5" StartPoint="0.021,0.5">
        <GradientStop Color="#FF5F6265" Offset="0"/>
        <GradientStop Color="sc#1, 0.08697331, 0.09347102, 0.101204164" Offset="0.70015799999237061"/>
        <GradientStop Color="#FF45484C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlendLinearRangeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFAFA" Offset="0"/>
        <GradientStop Color="#FFF90D0D" Offset="0.808"/>
        <GradientStop Color="#FEB9AFAF" Offset="0"/>
        <GradientStop Color="#FEF03939" Offset="0.558"/>
        <GradientStop Color="#FEE6A4A4" Offset="0.344"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BlendLinearBarPointerBackgroundBrushKey" Color="#FF2D09B1"/>

    <SolidColorBrush x:Key="BlendLinearMarkerPointerBackgroundBrushKey" Color="#FF2D09B1"/>

    <LinearGradientBrush x:Key="BlendDigitalGaugeOuterFrameBrushKey" EndPoint="0.5,-0.056" StartPoint="0.5,0.964">
        <GradientStop Color="#FF5F6266" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.70015799999237061"/>
        <GradientStop Color="#FF46494D" Offset="1"/>
