        <GradientStop Color="sc#1, 0.110575363, 0.115273222, 0.127564728" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.104616493, 0.10946171, 0.122138768" Offset="1"/>
        <GradientStop Color="#FF5B5D62" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BlendDigitalGaugeMiddleFrameBrushKey" Color="White"/>
    <SolidColorBrush x:Key="BlendDigitalGaugeSegmentBrushKey" Color="#FFE2E2E2"/>


    <!--Rolling Gauge-->
    <LinearGradientBrush x:Key="BlendRollingGaugeBorderBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF5F6266" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF46494D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlendRollingGaugeSegmentBorderBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF46494D" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF5F6266" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlendRollingGaugeBackgroundBrushKey"  EndPoint="0.5,-0.056" StartPoint="0.5,0.964">
        <GradientStop Color="#FF5F6266" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.70015799999237061"/>
        <GradientStop Color="#FF46494D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlendRollingGaugeSegmentBackgroundKey"  EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF959595" Offset="0"/>
        <GradientStop Color="sc#1, 0.23793754, 0.23948577, 0.243536577" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.1839543, 0.186837509, 0.194381177" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.140305564, 0.1442682, 0.15463607" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.110575363, 0.115273222, 0.127564728" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.104616493, 0.10946171, 0.122138768" Offset="1"/>
        <GradientStop Color="#FF5B5D62" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush  x:Key="BlendRollingGaugeTextBrushKey" Color="#FFAAAAAA" />


    <!-- Styles -->

    <Style x:Key="BlendCircularGaugeStyle" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource BlendCircularGaugeBackgroundBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource BlendCircularGaugeInnerFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource BlendCircularGaugeMiddleFrameBrushKey}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource BlendCircularGaugeOuterFrameBrushKey}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
    </Style>
    <Style TargetType="gauge:CircularGauge" BasedOn="{StaticResource BlendCircularGaugeStyle}"/>

    <Style x:Key="BlendGaugeBorderStyle" TargetType="gauge:GaugeBorder">
    </Style>
    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource BlendGaugeBorderStyle}"/>

    <Style x:Key="BlendCircularScaleStyle" TargetType="gauge:CircularScale">
        <Setter Property="Background" Value="{StaticResource BlendCircularScaleBackgroundBrushKey}"/>
        <Setter Property="ScaleBarSize" Value="10"/>
    </Style>
    <Style TargetType="gauge:CircularScale" BasedOn="{StaticResource BlendCircularScaleStyle}"/>

    <Style x:Key="BlendCircularPointerStyle" TargetType="gauge:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="Background" Value="{StaticResource BlendCircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
    </Style>
    <Style TargetType="gauge:CircularPointer" BasedOn="{StaticResource BlendCircularPointerStyle}"/>

    <Style x:Key="BlendPointerCapStyle" TargetType="gauge:PointerCap">
        <Setter Property="PointerCapRadius" Value="7"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource BlendPointerCapStyle}"/>

    <Style x:Key="BlendCircularKnobStyle" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource BlendCircularKnobStyle}"/>

    <Style x:Key="BlendDigitalGaugeStyle" TargetType="gauge:DigitalGauge">
        <Setter Property="MiddleFrameBrush" Value="{StaticResource BlendDigitalGaugeMiddleFrameBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource BlendDigitalGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource BlendDigitalGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource BlendDigitalGaugeOuterFrameBrushKey}"/>
        <Setter Property="OuterFrameOffset" Value="12"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="MiddleFrameOffset" Value="2"/>
        <Setter Property="SegmentBrush" Value="{StaticResource BlendDigitalGaugeSegmentBrushKey}"/>
    </Style>
    <Style TargetType="gauge:DigitalGauge" BasedOn="{StaticResource BlendDigitalGaugeStyle}"/>

    <Style x:Key="BlendMarkTickSetStyle" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource BlendMarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource BlendMarkTickSetStyle}"/>
    
    <SolidColorBrush x:Key="ForeColor" Color="#FFFF0000"/>

    <Style x:Key="BlendLabelTickSetStyle" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LabelForeground" Value="{StaticResource ForeColor}"/>
        <Setter Property="TickPlacement" Value="Inside"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="gauge:LabelTickSet">
                    <Canvas>
                        <TextBlock x:Name="PART_LabelTextBlock" Text="{TemplateBinding Text}"  Foreground="{TemplateBinding LabelForeground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontStyle="{TemplateBinding FontStyle}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        </TextBlock>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource BlendLabelTickSetStyle}"/>

    <Style x:Key="BlendCircularRangeStyle" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource BlendCircularRangeStyle}"/>

    <Style x:Key="BlendGaugeLabelStyle" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource BlendGaugeLabelStyle}"/>

    <Style x:Key="BlendGaugeImageStyle" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource BlendGaugeImageStyle}"/>

    <Style x:Key="BlendStateIndicatorStyle" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource BlendStateIndicatorStyle}"/>

    <Style x:Key="BlendLinearGaugeStyle" TargetType="gauge:LinearGauge">
        <Setter Property="InnerFrameBrush" Value="{StaticResource BlendLinearGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource BlendLinearGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource BlendLinearGaugeOuterFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource BlendLinearGaugeMiddleFrameBrushKey}"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="OuterFrameOffset" Value="15"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="RadiusX" Value="15"/>
        <Setter Property="RadiusY" Value="15"/>
    </Style>
    <Style TargetType="gauge:LinearGauge" BasedOn="{StaticResource BlendLinearGaugeStyle}"/>

    <Style x:Key="BlendLinearScaleStyle" TargetType="gauge:LinearScale">
        <Setter Property="Offset" Value="2"/>
        <Setter Property="RadiusX" Value="5"/>
        <Setter Property="RadiusY" Value="10"/>
    </Style>
    <Style TargetType="gauge:LinearScale" BasedOn="{StaticResource BlendLinearScaleStyle}"/>

    <Style x:Key="BlendLinearRangeStyle" TargetType="gauge:LinearRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource BlendLinearRangeBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearRange" BasedOn="{StaticResource BlendLinearRangeStyle}"/>

    <Style x:Key="BlendLinearBarPointerStyle" TargetType="gauge:LinearBarPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource BlendLinearBarPointerBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearBarPointer" BasedOn="{StaticResource BlendLinearBarPointerStyle}"/>

    <Style x:Key="BlendLinearMarkerPointerStyle" TargetType="gauge:LinearMarkerPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="PointerLength" Value="5" />
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross" />
        <Setter Property="Background" Value="{StaticResource BlendLinearMarkerPointerBackgroundBrushKey}" />
    </Style>
    <Style TargetType="gauge:LinearMarkerPointer" BasedOn="{StaticResource BlendLinearMarkerPointerStyle}"/>



    <Style x:Key="BlendRollingGaugeStyle" TargetType="gauge:RollingGauge">
        <Setter Property="BorderBrush" Value="{StaticResource BlendRollingGaugeBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource BlendRollingGaugeBackgroundBrushKey}"/>
        <Setter Property="SegmentBackground" Value="{StaticResource BlendRollingGaugeSegmentBackgroundKey}"/>
        <Setter Property="SegmentForeground" Value="{StaticResource BlendRollingGaugeTextBrushKey}"/>
        <Setter Property="SegmentBorderBrush" Value="{StaticResource BlendRollingGaugeSegmentBorderBrushKey}"/>
    </Style>
    <Style TargetType="gauge:RollingGauge" BasedOn="{StaticResource BlendRollingGaugeStyle}"/>

    <Style x:Key="BlendRollingCharacterStyle" TargetType="gauge:RollingCharacter">
    </Style>
    <Style TargetType="gauge:RollingCharacter" BasedOn="{StaticResource BlendRollingCharacterStyle}"/>

</ResourceDictionary>
