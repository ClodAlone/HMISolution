    <Style x:Key="Office2007BlackRollingGaugeStyle" TargetType="gauge:RollingGauge">
        <Setter Property="BorderBrush" Value="{StaticResource Office2007BlackRollingGaugeBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlackRollingGaugeBackgroundBrushKey}"/>
        <Setter Property="SegmentBackground" Value="{StaticResource Office2007BlackRollingGaugeSegmentBackgroundKey}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007BlackRollingGaugeTextBrushKey}"/>
        <Setter Property="SegmentBorderBrush" Value="{StaticResource Office2007BlackRollingGaugeSegmentBorderBrushKey}"/>
    </Style>
    <Style TargetType="gauge:RollingGauge" BasedOn="{StaticResource Office2007BlackRollingGaugeStyle}"/>

    <Style x:Key="Office2007BlackRollingCharacterStyle" TargetType="gauge:RollingCharacter">
    </Style>
    <Style TargetType="gauge:RollingCharacter" BasedOn="{StaticResource Office2007BlackRollingCharacterStyle}"/>



