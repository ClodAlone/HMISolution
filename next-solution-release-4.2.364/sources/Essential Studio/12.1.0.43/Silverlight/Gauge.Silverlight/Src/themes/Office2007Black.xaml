        <GradientStop Color="#FFCACED3" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlackRollingGaugeBorderBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
