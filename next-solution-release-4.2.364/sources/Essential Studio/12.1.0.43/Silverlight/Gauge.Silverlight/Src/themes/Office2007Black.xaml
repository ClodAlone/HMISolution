    <!-- Styles -->

    <Style x:Key="Office2007BlackCircularGaugeStyle" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource Office2007BlackCircularGaugeBackgroundBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2007BlackCircularGaugeInnerFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2007BlackCircularGaugeMiddleFrameBrushKey}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2007BlackCircularGaugeOuterFrameBrushKey}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
    </Style>
    <Style TargetType="gauge:CircularGauge" BasedOn="{StaticResource Office2007BlackCircularGaugeStyle}"/>

    <Style x:Key="Office2007BlackGaugeBorderStyle" TargetType="gauge:GaugeBorder">
    </Style>
    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource Office2007BlackGaugeBorderStyle}"/>

    <Style x:Key="Office2007BlackCircularScaleStyle" TargetType="gauge:CircularScale">
        <Setter Property="ScaleBarSize" Value="10"/>
    </Style>
    <Style TargetType="gauge:CircularScale" BasedOn="{StaticResource Office2007BlackCircularScaleStyle}"/>

    <Style x:Key="Office2007BlackCircularPointerStyle" TargetType="gauge:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007BlackCircularPointerBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlackCircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
    </Style>
    <Style TargetType="gauge:CircularPointer" BasedOn="{StaticResource Office2007BlackCircularPointerStyle}"/>

    <Style x:Key="Office2007BlackPointerCapStyle" TargetType="gauge:PointerCap">
        <Setter Property="PointerCapRadius" Value="7"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource Office2007BlackPointerCapStyle}"/>

    <Style x:Key="Office2007BlackCircularKnobStyle" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource Office2007BlackCircularKnobStyle}"/>

    <Style x:Key="Office2007BlackDigitalGaugeStyle" TargetType="gauge:DigitalGauge">
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2007BlackDigitalGaugeMiddleFrameBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2007BlackDigitalGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlackDigitalGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2007BlackDigitalGaugeOuterFrameBrushKey}"/>
        <Setter Property="OuterFrameOffset" Value="12"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="MiddleFrameOffset" Value="2"/>
        <Setter Property="SegmentBrush" Value="{StaticResource Office2007BlackDigitalGaugeSegmentBrushKey}"/>
    </Style>
    <Style TargetType="gauge:DigitalGauge" BasedOn="{StaticResource Office2007BlackDigitalGaugeStyle}"/>

    <Style x:Key="Office2007BlackMarkTickSetStyle" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource Office2007BlackMarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource Office2007BlackMarkTickSetStyle}"/>

<Style x:Key="Office2007BlackLabelTickSetStyle" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LabelForeground" Value="#FF375D81"/>
        <Setter Property="TickPlacement" Value="Inside"/>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource Office2007BlackLabelTickSetStyle}"/>

    <Style x:Key="Office2007BlackCircularRangeStyle" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource Office2007BlackCircularRangeStyle}"/>

    <Style x:Key="Office2007BlackGaugeLabelStyle" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource Office2007BlackGaugeLabelStyle}"/>

    <Style x:Key="Office2007BlackGaugeImageStyle" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource Office2007BlackGaugeImageStyle}"/>

    <Style x:Key="Office2007BlackStateIndicatorStyle" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource Office2007BlackStateIndicatorStyle}"/>

    <Style x:Key="Office2007BlackLinearGaugeStyle" TargetType="gauge:LinearGauge">
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2007BlackLinearGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlackLinearGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2007BlackLinearGaugeOuterFrameBrushKey}"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="OuterFrameOffset" Value="15"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="RadiusX" Value="15"/>
        <Setter Property="RadiusY" Value="15"/>
    </Style>
    <Style TargetType="gauge:LinearGauge" BasedOn="{StaticResource Office2007BlackLinearGaugeStyle}"/>

    <Style x:Key="Office2007BlackLinearScaleStyle" TargetType="gauge:LinearScale">
        <Setter Property="Offset" Value="2"/>
        <Setter Property="RadiusX" Value="5"/>
        <Setter Property="RadiusY" Value="10"/>
    </Style>
    <Style TargetType="gauge:LinearScale" BasedOn="{StaticResource Office2007BlackLinearScaleStyle}"/>

    <Style x:Key="Office2007BlackLinearRangeStyle" TargetType="gauge:LinearRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlackLinearRangeBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearRange" BasedOn="{StaticResource Office2007BlackLinearRangeStyle}"/>

    <Style x:Key="Office2007BlackLinearBarPointerStyle" TargetType="gauge:LinearBarPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlackLinearBarPointerBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearBarPointer" BasedOn="{StaticResource Office2007BlackLinearBarPointerStyle}"/>

    <Style x:Key="Office2007BlackLinearMarkerPointerStyle" TargetType="gauge:LinearMarkerPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="PointerLength" Value="5" />
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross" />
        <Setter Property="Background" Value="{StaticResource Office2007BlackLinearMarkerPointerBackgroundBrushKey}" />
    </Style>
    <Style TargetType="gauge:LinearMarkerPointer" BasedOn="{StaticResource Office2007BlackLinearMarkerPointerStyle}"/>
    <LinearGradientBrush x:Key="Office2007BlackRollingGaugeSegmentBackgroundKey" EndPoint="0.5,0" StartPoint="0.5,1">
