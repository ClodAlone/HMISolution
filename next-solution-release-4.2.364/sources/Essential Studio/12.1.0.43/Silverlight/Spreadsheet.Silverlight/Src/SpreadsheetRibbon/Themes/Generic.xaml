    <!--RibbonSplitButtonStyle-->
    <Style x:Key="ExcelEditorRibbonStyle" TargetType="local:SpreadsheetRibbon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.Resources>
                            <resources:ResourceWrapper x:Key="ribbonResources"/>
                        </Grid.Resources>
                        <Syncfusion:Ribbon Name="ExcelRibbon" Title="{Binding Path=ExcelProperties.RibbonTitle,Mode=TwoWay}"
                                           BackStageColor="{Binding Path=BackStageColor,RelativeSource={RelativeSource TemplatedParent}}"
                                           BackStageHeader="{Binding Path=BackStageHeader,RelativeSource={RelativeSource TemplatedParent}}">

                            <!--BackStage-->
                            <Syncfusion:Ribbon.BackStage>
                                <Syncfusion:Backstage Name="RibbonBackStage" Height="{Binding Path=BackStageHeight,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                      Width="{Binding BackStageWidth,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                    <Syncfusion:BackStageCommandButton x:Name="SaveButton" Header="{Binding Source={StaticResource ribbonResources},Path=Save}" Icon="{StaticResource SaveIcon}"  Command="{Binding ExportToExcelCommand}"/>
                                    <Syncfusion:BackStageCommandButton x:Name="SaveAsButton" Header="{Binding Source={StaticResource ribbonResources},Path=SaveAs}" Icon="{StaticResource SaveAsIcon}" Command="{Binding ExportToExcelCommand}"/>
                                    <Syncfusion:BackStageCommandButton x:Name="OpenButton" Header="{Binding Source={StaticResource ribbonResources},Path=Open}" Icon="{StaticResource OpenIcon}" Command="{Binding ImportFromExcelCommand}"/>
                                    <Syncfusion:BackstageTabItem Header="{Binding Source={StaticResource ribbonResources},Path=Info}">
                                        <Grid Background="#FFFEFEFE">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="7*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="25,20,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Information}" FontSize="20" FontFamily="Segoe UI" Grid.Row="0" />
                                                    <Rectangle Grid.Row="1" Stroke="#FFBCBCBC" Height="1" StrokeDashArray="4,3" Margin="0,15,20,0"/>
                                                </Grid>
                                                <Grid Margin="25,20,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Syncfusion:RibbonDropDownButton SizeMode="Large" IsMultiLine="True" Grid.Column="0" Label="{Binding Source={StaticResource ribbonResources},Path=Permissions}" Width="87" Height="80"
                                                                              LargeIcon="{StaticResource PermissionIcon}" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Syncfusion:RibbonDropDownButton.Background>
                                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                                <GradientStop Color="White" Offset="0.116"/>
                                                                <GradientStop Color="#FFF3F5F6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Syncfusion:RibbonDropDownButton.Background>
                                                        <Syncfusion:RibbonDropDownButton.BorderBrush>
                                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                                <GradientStop Color="#FFDDDEE0" Offset="0"/>
                                                                <GradientStop Color="#FFA1A2A4" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Syncfusion:RibbonDropDownButton.BorderBrush>
                                                        <Syncfusion:RibbonDropDownButton.Effect>
                                                            <DropShadowEffect ShadowDepth="2" Opacity="0.21" BlurRadius="3" Direction="310"/>
                                                        </Syncfusion:RibbonDropDownButton.Effect>
                                                        <Syncfusion:RibbonMenuGroup IconBarEnabled="True">
                                                            <Syncfusion:RibbonMenuItem Header="{Binding Source={StaticResource ribbonResources},Path=EncryptwithPassword}" Command="{Binding EncryptCommand}">
                                                                <Syncfusion:RibbonMenuItem.Icon>
                                                                    <Image Source="{StaticResource PermissionIcon}"/>
                                                                </Syncfusion:RibbonMenuItem.Icon>
                                                            </Syncfusion:RibbonMenuItem>
                                                            <Syncfusion:RibbonMenuItem Header="{Binding Source={StaticResource ribbonResources},Path=ProtectCurrentSheet}" Command="{Binding ProtectCurrentSheetCommand}">
                                                                <Syncfusion:RibbonMenuItem.Icon>
                                                                    <Image Source="{StaticResource ProtectIcon}"/>
                                                                </Syncfusion:RibbonMenuItem.Icon>
                                                            </Syncfusion:RibbonMenuItem>
                                                        </Syncfusion:RibbonMenuGroup>
                                                    </Syncfusion:RibbonDropDownButton>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top"  Margin="3">
                                                        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Permissions}" Grid.Column="1" FontWeight="Bold" Margin="3"/>
                                                        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=PermissionsDescription}" Grid.Column="1" TextWrapping="Wrap" Margin="3"/>
                                                    </StackPanel>
                                                    <Rectangle Grid.ColumnSpan="2" Grid.Column="0" Stroke="#FFBCBCBC" Height="1" StrokeDashArray="4,3" Margin="0,95,20,0"/>
                                                </Grid>
                                            </StackPanel>

                                            <Line HorizontalAlignment="Right" 
                                                  Stroke="#FF8F9DC0" StrokeDashArray="" Width="1" X1="1" Y1="{Binding Path=BackStageHeight,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource BorderHeightConverter}}" Y2="1">
                                                <Line.OpacityMask>
                                                    <LinearGradientBrush EndPoint="4.438, 0.009" StartPoint="4.812, 0.987" />
                                                </Line.OpacityMask>
                                            </Line>
                                            
                                            <Grid Margin="5" Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Viewbox Margin="15,0,0,0" x:Name="imageViewBox"  Height="200" Width="300" HorizontalAlignment="Left">
                                                    <Viewbox.Effect>
                                                        <DropShadowEffect ShadowDepth="2" Opacity="0.5"  />

                                                    </Viewbox.Effect>
                                                </Viewbox>
                                                <Grid Grid.Row="1" Grid.Column="0" Margin="15,0,0,0" x:Name="DocumentPropertiesGrid">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="40"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="0"/>
                                                        <RowDefinition Height="0"/>
                                                        <RowDefinition Height="0"/>
                                                        <RowDefinition Height="0"/>
                                                        <RowDefinition Height="40"/>
                                                        <RowDefinition Height="0"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="20"/>
                                                        <RowDefinition Height="20"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=DocumentProperties}" FontWeight="Bold"  HorizontalAlignment="Left" Margin="0,10,0,0"/>

                                                    <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=DocumentProperty_Title}"  Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"/>
                                                    <local:RibbonTextBox Style="{StaticResource TextBoxStyle}" MaskText="{Binding Source={StaticResource ribbonResources},Path=DocumentMask_Title}"
                                                                         Text="{Binding Path=ExcelProperties.WorkBook.BuiltInDocumentProperties.Title, Converter={StaticResource documentPropertiesConverter},Mode=TwoWay}" Width="220" Foreground="#ADADAD" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"/>

