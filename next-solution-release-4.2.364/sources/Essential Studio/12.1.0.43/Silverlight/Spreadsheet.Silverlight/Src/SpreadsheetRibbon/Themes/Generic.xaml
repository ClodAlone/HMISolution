                                                    </Syncfusion:RibbonMenuItem.Icon>
                                                </Syncfusion:RibbonMenuItem>
                                            <Syncfusion:RibbonMenuItem Height="38" IconSize="32,32" VerticalAlignment="Center" Header="{Binding Source={StaticResource ribbonResources},Path=FreezeTopRow}" Command="{Binding FreezePaneCommand}">
                                                    <Syncfusion:RibbonMenuItem.CommandParameter>
                                                        <local:Freeze>FreezeTopRow</local:Freeze>
                                                    </Syncfusion:RibbonMenuItem.CommandParameter>
                                                    <Syncfusion:RibbonMenuItem.Icon>
                                                        <Image Source="{StaticResource FreezeTopRowIcon}"/>
                                                    </Syncfusion:RibbonMenuItem.Icon>
                                                </Syncfusion:RibbonMenuItem>
                                            <Syncfusion:RibbonMenuItem Height="38" IconSize="32,32" VerticalAlignment="Center" Header="{Binding Source={StaticResource ribbonResources},Path=FreezeTopColumn}" Command="{Binding FreezePaneCommand}">
                                                    <Syncfusion:RibbonMenuItem.CommandParameter>
                                                        <local:Freeze>FreezeFirstColumn</local:Freeze>
                                                    </Syncfusion:RibbonMenuItem.CommandParameter>
                                                    <Syncfusion:RibbonMenuItem.Icon>
                                                        <Image Source="{StaticResource FreezeFirstColumnIcon}"/>
                                                    </Syncfusion:RibbonMenuItem.Icon>
                                                </Syncfusion:RibbonMenuItem>
                                            </Syncfusion:RibbonMenuGroup>
                                        </Syncfusion:RibbonDropDownButton>
                                    </Syncfusion:RibbonBar>

                                    <!--Comments-->
                                    <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Comments}" IsLauncherButtonVisible="False">
                                        <Syncfusion:RibbonButton IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=NewComment}" SizeMode="Large" LargeIcon="{StaticResource CommentIcon}"
                                                             Command="{Binding Path=InsertCommentCommand}" Visibility="{Binding Path=GridProperties.CurrentCellStyle.Comment,Mode=TwoWay,Converter={StaticResource NewCommentVisibilityConverter}}"/>
                                        <Syncfusion:RibbonButton IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=EditComment}" SizeMode="Large" LargeIcon="{StaticResource EditCommentIcon}"
                                                             Command="{Binding Path=InsertCommentCommand}" Visibility="{Binding Path=GridProperties.CurrentCellStyle.Comment,Mode=TwoWay,Converter={StaticResource EditCommentVisibilityConverter}}"/>
                                        <Syncfusion:RibbonButton Margin="0,0,4,0" IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=DeleteComment}" SizeMode="Large" LargeIcon="{StaticResource DeleteCommentIcon}" 
                                                             Command="{Binding Path=DeleteCommentCommand}" IsEnabled="{Binding Path=GridProperties.CurrentCellStyle.Comment,Mode=TwoWay,Converter={StaticResource DeleteCommentEnableConverter}}"/>
                                    </Syncfusion:RibbonBar>

                                    <!--Changes-->
                                    <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Changes}" IsLauncherButtonVisible="False">
                                        <Syncfusion:RibbonButton  IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=ProtectSheet}" SizeMode="Large" LargeIcon="{StaticResource ProtectSheetIcon}"
                                                             Command="{Binding ProtectCurrentSheetCommand}" Visibility="{Binding Path=ExcelProperties.IsPasswordProtected,Mode=TwoWay,Converter={StaticResource protectSheetVisibleConverter}}" />
                                    <Syncfusion:RibbonButton  IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=UnProtectSheet}" SizeMode="Large" LargeIcon="{StaticResource ProtectSheetIcon}" 
                                                             Command="{Binding ProtectCurrentSheetCommand}" Visibility="{Binding Path=ExcelProperties.IsPasswordProtected,Mode=TwoWay,Converter={StaticResource unProtectSheetVisibleConverter}}" />
                                    <Syncfusion:RibbonButton Margin="0,0,4,0"  IsCheckable="True" IsChecked="{Binding Path=ExcelProperties.IsWorkBookProtected,Mode=OneWay}"  Label="{Binding Source={StaticResource ribbonResources},Path=ProtectWorkbook}"
                                                             SizeMode="Large" LargeIcon="{StaticResource ProtectWorkBookIcon}" Command="{Binding ProtectWorkbookCommand}"/>
                                    </Syncfusion:RibbonBar>

                                <!--Grouping-->                                

                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Outline}" Syncfusion:RibbonBar.LauncherCommand="{Binding GroupOptionsCommand}" 
                                                      IsLauncherButtonVisible="True">

                                    <Syncfusion:RibbonButton IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=Group}"  SizeMode="Large" LargeIcon="{StaticResource GroupIcon}"
                                                             Command="{Binding GroupCommand}" />

                                    <Syncfusion:RibbonButton IsCheckable="False" Label="{Binding Source={StaticResource ribbonResources},Path=Ungroup}"  SizeMode="Large" LargeIcon="{StaticResource UngroupIcon}"
                                                             Command="{Binding UngroupCommand}" />
                                </Syncfusion:RibbonBar>
                                
                            </Syncfusion:RibbonTab>
                        </Syncfusion:Ribbon>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ExcelEditorRibbonStyle}" TargetType="local:SpreadsheetRibbon" />

</ResourceDictionary>
