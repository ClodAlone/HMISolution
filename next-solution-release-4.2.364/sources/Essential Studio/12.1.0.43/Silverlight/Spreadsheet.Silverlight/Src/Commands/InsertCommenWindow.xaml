<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.InsertCommentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Name="commentWindow" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="300" Height="200" Title="New Comment"
                          xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources">
    
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <!--<ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>-->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,5,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Comment}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5"/>
            <TextBox  Name="CommentBox" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  VerticalAlignment="Top"
                  Margin="5" TabIndex="0" Height="100" Width="200" Text="{Binding ElementName=commentWindow,Path=Comment,Mode=TwoWay}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" TabIndex="1"  HorizontalAlignment="Right" Margin="5" Width="75" Click="OnOkButtonClick"/>
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" TabIndex="2"  Margin="5" HorizontalAlignment="Right" Grid.Column="1" Width="75" Click="OnCancelButtonClick"/>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>

    