<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.GetPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
    mc:Ignorable="d" x:Name="PasswordWindow" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="280" Height="140" Title="Password">
    <syncfusion:WindowControl.Resources>
        <resources:ResourceWrapper x:Key="ribbonResources"/>
    </syncfusion:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Margin="2">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" >
                <TextBlock Margin="5" Text="{Binding Path=FileName,Mode=TwoWay,ElementName=PasswordWindow}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" >
                <TextBlock Margin="5" Text="{Binding Path=Description,Mode=TwoWay,ElementName=PasswordWindow}"/>
                <PasswordBox Margin="5" Width="205" x:Name="passwordBox"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  HorizontalAlignment="Right" Margin="5" Width="70" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5,5,5,5" HorizontalAlignment="Left" Grid.Column="1" Width="70" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
<!--</controls:ChildWindow>-->
