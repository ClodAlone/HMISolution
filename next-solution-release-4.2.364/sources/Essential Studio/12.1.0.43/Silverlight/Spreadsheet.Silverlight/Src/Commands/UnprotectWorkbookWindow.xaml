<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.UnprotectWorkbookWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False"  ResizeMode="NoResize" IsSystemMenuEnabled="False" x:Name="unprotectWindow"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="300" Height="120" Title="Unprotect Workbook"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources">
    
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=unprotectWindow}" Margin="3" Width="70"/>
                <PasswordBox x:Name="txtValue" Margin="3" Width="190"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5" >
                <Button  Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
