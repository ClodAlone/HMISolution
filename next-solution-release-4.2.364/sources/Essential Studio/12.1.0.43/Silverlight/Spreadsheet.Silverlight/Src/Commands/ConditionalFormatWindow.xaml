<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.ConditionalFormatWindow" 
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
           mc:Ignorable="d" x:Name="formatWindow" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False"
           xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="520" Height="150" Title="Conditional Format">
    <syncfusion:WindowControl.Resources>
        <resources:ResourceWrapper x:Key="ribbonResources"/>
    </syncfusion:WindowControl.Resources>
    <Grid x:Name="LayoutRoot">
        <StackPanel Margin="3">
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" FontWeight="Bold" Margin="5" Height="25" Width="300" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Width="240">
                    <TextBox x:Name="txtValue" Height="25" Margin="3" />
                    <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=And}" Margin="3" Visibility="{Binding Path=AdditionalTextboxVisibility,Mode=TwoWay,ElementName=formatWindow}" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtValue2" Margin="5" Height="25" Visibility="{Binding Path=AdditionalTextboxVisibility,Mode=TwoWay,ElementName=formatWindow}"/>
                </StackPanel>
                <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=With}" Margin="3" VerticalAlignment="Center"/>
                <ComboBox Margin="5" Width="215" SelectedIndex="0" x:Name="comboCellStyle">
                    <ComboBoxItem Content="{Binding Source={StaticResource ribbonResources},Path=LightRedFillwithDarkRedText}"/>
                    <ComboBoxItem Content="{Binding Source={StaticResource ribbonResources},Path=YellowFillwithDarkYellowText}"/>
                    <ComboBoxItem Content="{Binding Source={StaticResource ribbonResources},Path=GreenFillwithDarkGreenText}"/>
                    <ComboBoxItem Content="{Binding Source={StaticResource ribbonResources},Path=LightRedFill}"/>
                    <ComboBoxItem Content="{Binding Source={StaticResource ribbonResources},Path=RedText}"/>
                    <ComboBoxItem Content="{Binding Source={StaticResource ribbonResources},Path=RedBorder}"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
