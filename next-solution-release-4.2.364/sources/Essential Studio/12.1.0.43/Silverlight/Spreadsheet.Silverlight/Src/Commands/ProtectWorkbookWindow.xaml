<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.ProtectWorkbookWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False"  ResizeMode="NoResize" IsSystemMenuEnabled="False" x:Name="protectWindow"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="300" Height="205" Title="Protect Structure and Windows"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources">
    
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <TextBlock  Text="{Binding Path=Description,Mode=TwoWay,ElementName=protectWindow}" Margin="6,5,0,0" Height="20" Width="275" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10,0,0,0">
                <CheckBox  Margin="3" TabIndex="1" Content="{Binding Source={StaticResource ribbonResources},Path=Structure}" IsChecked="{Binding Path=IsStructure,Mode=TwoWay,ElementName=protectWindow}"/>
                <CheckBox  Margin="3" TabIndex="2" Content="{Binding Source={StaticResource ribbonResources},Path=Windows}" IsChecked="{Binding Path=IsWindows,Mode=TwoWay,ElementName=protectWindow}"/>
            </StackPanel>
            <TextBlock Text="{Binding Path=DescriptionText,Mode=TwoWay,ElementName=protectWindow}" Margin="6,5,0,0" Height="20" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <PasswordBox x:Name="txtValue"  TabIndex="0" Password="{Binding Path=Text,Mode=TwoWay,ElementName=protectWindow}" Margin="3" Width="270"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button  Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" TabIndex="4"  Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" TabIndex="5"  Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
