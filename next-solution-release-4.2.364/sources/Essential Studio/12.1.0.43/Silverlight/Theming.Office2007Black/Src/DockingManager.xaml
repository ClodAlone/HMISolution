                                        <GradientStop Color="#FF939BA3" Offset="0.475"/>
                                        <GradientStop Color="#FF74808D" Offset="0.543"/>
                                        <GradientStop Color="#FF8D9DAE" Offset="0.872"/>
                                        <GradientStop Color="#FFA3B3C4" Offset="0.973"/>
                                        <GradientStop Color="#FFBAC5D1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mousePressedRectangle">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF3C3C3C" Offset="0.058"/>
                                        <GradientStop Color="#FF525252" Offset="0.209"/>
                                        <GradientStop Color="#FF353535" Offset="0.312"/>
                                        <GradientStop Color="#FF2B2B2B" Offset="0.462"/>
                                        <GradientStop Color="Black" Offset="0.521"/>
                                        <GradientStop Color="#FF070707" Offset="0.713"/>
                                        <GradientStop Color="#FF323233" Offset="0.967"/>
                                        <GradientStop Color="#FF232323" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border BorderThickness="1" x:Name="innerRect" Width="15" Height="15" >
                                <Grid>
                                    <Border x:Name="uncheckedArrow" BorderThickness="1" BorderBrush="Transparent" Width="15" Height="15" >
                                        <Path Name="uncheckBtnImg" Margin="-1,-2,0,0" Width="8" Height="8" Stretch="Fill" Fill="Black" Data="F1 M 2446.14,509.986L 2439.87,509.986L 2439.87,515.908L 2446.14,515.908L 2446.14,509.986 Z M 2440.34,515.391L 2440.34,511.141L 2445.59,511.141L 2445.59,515.391L 2440.34,515.391 Z "/>
