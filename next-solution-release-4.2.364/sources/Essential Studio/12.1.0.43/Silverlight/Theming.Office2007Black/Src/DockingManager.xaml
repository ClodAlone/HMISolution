                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border Name="PART_Border" CornerRadius="6,6,0,0" BorderBrush="#FFB7BCC3" BorderThickness="1" Background="{StaticResource SideButtonBackground}">
