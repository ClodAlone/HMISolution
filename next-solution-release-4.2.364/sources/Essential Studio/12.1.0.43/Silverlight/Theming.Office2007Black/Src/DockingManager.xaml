                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LineBorder" BorderThickness="1,0,0,0" BorderBrush="Gray" Grid.Column="1"></Border>
                                <Border x:Name="HoverBorder" Background="LightGray" Opacity="1"></Border>
                                <Image x:Name="tick" Width="20" Height="20" Opacity="0" Source="/Syncfusion.DockingManager.Silverlight;component/Images/Tick.png" Margin="3"/>

                                <ContentPresenter Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3"
                      Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
	
	
