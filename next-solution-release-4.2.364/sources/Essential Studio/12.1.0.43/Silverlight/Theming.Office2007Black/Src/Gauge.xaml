<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gauge="clr-namespace:Syncfusion.Windows.Gauge;assembly=Syncfusion.Gauge.Silverlight">

    <!-- Brushes -->

    <RadialGradientBrush x:Key="CircularGaugeBackgroundBrushKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
