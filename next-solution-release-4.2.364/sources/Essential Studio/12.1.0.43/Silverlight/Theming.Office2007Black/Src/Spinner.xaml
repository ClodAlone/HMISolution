<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inputToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight">

    <!-- Brushes -->

   

    <SolidColorBrush x:Key="TextBrushKey" Color="#FF4C535C"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF4C535C"/>



    <LinearGradientBrush x:Key="BackgroundBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFDDE1E6" Offset="0"/>
        <GradientStop Color="#FFDDE1E6" Offset="0.4"/>
        <GradientStop Color="#FFB9BFC6" Offset="0.4"/>
        <GradientStop Color="#FFDFE2E6" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderBrushKey" Color="#FF898989"/>

    <LinearGradientBrush x:Key="MouseOverBrushKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>



    <SolidColorBrush x:Key="BackgroundAnimationBrushKey" Color="#FFFFF9E6"/>

    <LinearGradientBrush x:Key="DisabledBackgroundBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFF0F3F6" Offset="0"/>
        <GradientStop Color="#FFF0F3F6" Offset="0.4"/>
        <GradientStop Color="#FFE1E4E9" Offset="0.4"/>
        <GradientStop Color="#FFE8EBEF" Offset="1"/>

    </LinearGradientBrush>



    <LinearGradientBrush x:Key="FocusedBorderBrushKey"
                         StartPoint="1,1"
                         EndPoint="1,20"
                         >
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFCFD3D8"
                          Offset="9.95"/>
            <GradientStop Color="#FFD0D4D8"
                          Offset="9.93"/>
            <GradientStop Color="#FFEFEFEF"
                          Offset="0"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PressedBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFE7A66D" Offset="0"/>
        <GradientStop Color="#FFFFAE53" Offset="0.4"/>
        <GradientStop Color="#FFFF8E06" Offset="0.4"/>
        <GradientStop Color="#FFFFC450" Offset="1"/>
    </LinearGradientBrush>




    <SolidColorBrush x:Key="PressedBorderBrushKey" Color="#FF7B6645"/>

    <SolidColorBrush x:Key="MouseOverBorderBrushKey" Color="#FFB79E73"/>

    <LinearGradientBrush x:Key="SelectedBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFED498" Offset="0"/>
        <GradientStop Color="#FFFECD86" Offset="0.4"/>
        <GradientStop Color="#FFFDB759" Offset="0.4"/>
        <GradientStop Color="#FFFDEB9F" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SelectedBorderBrushKey" Color="#FF9E8255"/>


    <LinearGradientBrush x:Key="ButtonBackgroundBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFDDE1E6" Offset="0"/>
        <GradientStop Color="#FFDDE1E6" Offset="0.4"/>
        <GradientStop Color="#FFB9BFC6" Offset="0.4"/>
        <GradientStop Color="#FFDFE2E6" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonBorderBrushKey" Color="#FF898989"/>


    <SolidColorBrush x:Key="ButtonSpinnerBackgroundBrushKey" Color="#FFE8E8E8"/>


    <LinearGradientBrush x:Key="ButtonSpinnerMouseOverBorderBrushKey"
                         StartPoint="1,1"
                         EndPoint="1,20"
                         >
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFCFD3D8"
                          Offset="9.95"/>
            <GradientStop Color="#FFD0D4D8"
                          Offset="9.93"/>
            <GradientStop Color="#FFEFEFEF"
                          Offset="0"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="ButtonSpinnerBorderBrushKey" Color="#FF898989"/>
    <LinearGradientBrush x:Key="SpinnerButtonRepeatButtonPressedBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFE7A66D" Offset="0"/>
        <GradientStop Color="#FFFFAE53" Offset="0.4"/>
        <GradientStop Color="#FFFF8E06" Offset="0.4"/>
        <GradientStop Color="#FFFFC450" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonSpinnerUpButtonStrokeBrushKey" Color="#FF898989"/>

    <SolidColorBrush x:Key="ButtonSpinnerDownButtonStrokeBrushKey" Color="#FF898989"/>




    <LinearGradientBrush x:Key="ButtonSpinnerFocusVisualBrushKey"
                         StartPoint="1,1"
                         EndPoint="1,20"
                         >
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFCFD3D8"
                          Offset="9.95"/>
            <GradientStop Color="#FFD0D4D8"
                          Offset="9.93"/>
            <GradientStop Color="#FFEFEFEF"
                          Offset="0"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonSpinnerDisabledBrushKey" Color="LightGray"/>

<!-- Styles -->

    <Style x:Key="inputToolkit:ButtonSpinner" TargetType="inputToolkit:ButtonSpinner">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonSpinnerBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource ButtonSpinnerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="inputToolkit:ButtonSpinner">
                    <Grid>
                        <Grid.Resources>
                            <ControlTemplate x:Key="IncreaseButtonTemplate" TargetType="RepeatButton">
                                <Grid x:Name="Root">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0"/>
                                                <VisualTransition GeneratedDuration="00:00:00.1" To="MouseOver"/>
                                                <VisualTransition GeneratedDuration="00:00:00.1" To="Pressed"/>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BackgroundAnimationBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>

                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Highlight" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                        <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BackgroundAnimationBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SpinnerButtonRepeatButtonPressedBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                                        <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="FocusStates">
                                            <VisualState x:Name="Focused">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Unfocused"/>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Rectangle x:Name="Background" Stroke="{StaticResource ButtonSpinnerUpButtonStrokeBrushKey}" Fill="{TemplateBinding Background}" StrokeThickness="1" RadiusX="2" RadiusY="2"/>

                                    <Rectangle x:Name="BackgroundGradient" Fill="{StaticResource BackgroundBrushKey}" Stroke="#FFFFFFFF" StrokeThickness="1" RadiusX="1" RadiusY="1" Margin="1"/>

                                    <Rectangle x:Name="Highlight" Stroke="{StaticResource ButtonSpinnerFocusVisualBrushKey}" StrokeThickness="1" RadiusX="1" RadiusY="1" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                                    <Border x:Name="DisabledVisualElement" IsHitTestVisible="False" Opacity="0" Background="{StaticResource ButtonSpinnerDisabledBrushKey}" BorderBrush="{StaticResource ButtonSpinnerDisabledBrushKey}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                    <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource ButtonSpinnerFocusVisualBrushKey}" StrokeThickness="1" RadiusX="1" RadiusY="1" IsHitTestVisible="false" Margin="1" Visibility="Collapsed"/>
                                    <Path Fill="{StaticResource GlyphBrushKey}" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="4,3,4,3" VerticalAlignment="Stretch" Data="F1 M 541.537,173.589L 531.107,173.589L 536.322,167.49L 541.537,173.589 Z "/>
                                </Grid>
                            </ControlTemplate>
                            <ControlTemplate x:Key="DecreaseButtonTemplate" TargetType="RepeatButton">
                                <Grid x:Name="Root">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0"/>
                                                <VisualTransition GeneratedDuration="00:00:00.1" To="MouseOver"/>
                                                <VisualTransition GeneratedDuration="00:00:00.1" To="Pressed"/>
                                            </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BackgroundAnimationBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Highlight" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                        <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BackgroundAnimationBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SpinnerButtonRepeatButtonPressedBrushKey}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                                        <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="FocusStates">
                                            <VisualState x:Name="Focused">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Unfocused"/>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Rectangle x:Name="Background" Stroke="{StaticResource ButtonSpinnerDownButtonStrokeBrushKey}" Fill="{TemplateBinding Background}" StrokeThickness="1" RadiusX="2" RadiusY="2"/>

                                    <Rectangle x:Name="BackgroundGradient" Fill="{StaticResource BackgroundBrushKey}" Stroke="#FFFFFFFF" StrokeThickness="1" RadiusX="1" RadiusY="1" Margin="1"/>

                                    <Rectangle x:Name="Highlight" Stroke="{StaticResource ButtonSpinnerFocusVisualBrushKey}" StrokeThickness="1" RadiusX="1" RadiusY="1" IsHitTestVisible="false" Opacity="0"/>
                                    <Border x:Name="DisabledVisualElement" IsHitTestVisible="False" Opacity="0" Background="{StaticResource ButtonSpinnerDisabledBrushKey}" BorderBrush="{StaticResource ButtonSpinnerDisabledBrushKey}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                    <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource ButtonSpinnerFocusVisualBrushKey}" StrokeThickness="1" RadiusX="1" RadiusY="1" IsHitTestVisible="false" Visibility="Collapsed"/>
                                    <Path Fill="{StaticResource GlyphBrushKey}" Stretch="Uniform" Height="Auto" HorizontalAlignment="Stretch" Margin="4,3,4,3" VerticalAlignment="Stretch" Width="Auto" Data="F1 M 531.107,321.943L 541.537,321.943L 536.322,328.042L 531.107,321.943 Z "/>
                                </Grid>
                            </ControlTemplate>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MouseOverBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonSpinnerMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="presentationSite" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Gray"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="ElementContainer" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Gray"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="IncreaseStates">
                                <VisualState x:Name="IncreaseEnabled"/>
                                <VisualState x:Name="IncreaseDisabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DecreaseStates">
                                <VisualState x:Name="DecreaseEnabled"/>
                                <VisualState x:Name="DecreaseDisabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ElementContainer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border x:Name="MouseOverBorder" BorderBrush="Transparent" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ContentControl x:Name="presentationSite" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" IsTabStop="False" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Grid.RowSpan="2" Content="{TemplateBinding Content}"/>
                                    <Button IsHitTestVisible="True" IsTabStop="False" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <RepeatButton x:Name="IncreaseButton" IsTabStop="False" Template="{StaticResource IncreaseButtonTemplate}" Grid.Column="1" Grid.Row="0" ClickMode="Press"/>
                                    <RepeatButton x:Name="DecreaseButton" IsTabStop="False" Template="{StaticResource DecreaseButtonTemplate}" Grid.Column="1" Grid.Row="1" ClickMode="Press"/>
                                </Grid>
                            </Border>
                        </Border>
                        <Border x:Name="FocusVisualElement" IsHitTestVisible="false" Visibility="Collapsed" BorderBrush="{StaticResource ButtonSpinnerFocusVisualBrushKey}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1,1,1,1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="inputToolkit:ButtonSpinner" BasedOn="{StaticResource inputToolkit:ButtonSpinner}"/>
</ResourceDictionary>
