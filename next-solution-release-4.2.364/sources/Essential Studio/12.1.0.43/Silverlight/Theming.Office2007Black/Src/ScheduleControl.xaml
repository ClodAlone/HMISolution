                                    <schedulecontrol:ScheduleMonthView x:Name="PART_MonthView" Margin="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" SelectionBackground="{TemplateBinding SelectionBackground}" HeaderBrush="{TemplateBinding HeaderBrush}" Background="{TemplateBinding Background}" Style="{StaticResource OfficeBlackScheduleMonthViewStyle}" AppointmentEditorStyle="{StaticResource Office14BlackScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource Office14BlackAppointmentScheduleWindowStyle}"/>
                                    <schedulecontrol:ScheduleHorizontalView x:Name="PART_HorizontalView" Margin="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" SelectionBackground="{TemplateBinding SelectionBackground}" HeaderBrush="{TemplateBinding HeaderBrush}" Background="{TemplateBinding Background}" Style="{StaticResource OfficeBlackScheduleHorizontalViewStyle}" AppointmentEditorStyle="{StaticResource Office14BlackScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource Office14BlackAppointmentScheduleWindowStyle}"/>
                                </schedulecontrol:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="schedulecontrol:Schedule" BasedOn="{StaticResource OfficeBlackScheduleStyle}"/>

