    <Style x:Key="OfficeBlackScheduleHorizontalTimeSlotControlStyle" TargetType="schedulecontrol:ScheduleHorizontalTimeSlotControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="schedulecontrol:ScheduleHorizontalTimeSlotControl">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStateGroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Shaded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="IsCurrent">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.LeftBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.RightBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="IsCurrentAndShaded">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(ScheduleRectangleBorder.LeftBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(ScheduleRectangleBorder.RightBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <schedulecontrol:ScheduleRectangleBorder x:Name="PART_Border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" LeftBrush="{TemplateBinding BorderBrush}" BottomBrush="{TemplateBinding BorderBrush}" RightBrush="{TemplateBinding BorderBrush}" TopBrush="{TemplateBinding BorderBrush}"/>
                        <schedulecontrol:ScheduleRectangleBorder x:Name="PART_ShadedBorder" Background="{TemplateBinding SelectionBackground}" BorderThickness="{TemplateBinding BorderThickness}" LeftBrush="{TemplateBinding BorderBrush}" BottomBrush="{TemplateBinding BorderBrush}" RightBrush="{TemplateBinding BorderBrush}" TopBrush="{TemplateBinding BorderBrush}" Visibility="Collapsed"/>
                        <schedulecontrol:UniformStackPanel x:Name="PART_TimeSlotPanel" Orientation="Horizontal"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OfficeBlackScheduleHorizontalAppointmentViewControlStyle" TargetType="schedulecontrol:ScheduleHorizontalAppointmentViewControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="schedulecontrol:ScheduleHorizontalAppointmentViewControl">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Common">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BorderElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BorderSelectedElement" Storyboard.TargetProperty="(Shape.StrokeThickness)">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="2"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SubjectText" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Thickness>2</Thickness>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_LocationText" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Thickness>2</Thickness>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BorderSelectedElement" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF000000"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border BorderBrush="#FF7E7E7E" BorderThickness="1" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF939598" Offset="1"/>
                                    <GradientStop Color="#FFE8E8E8"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PART_SubjectText" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Row="0" FontFamily="Verdana" FontSize="11" FontWeight="Bold" Text="{Binding Subject}" TextWrapping="NoWrap" Foreground="#FF454545"/>
                                <TextBlock x:Name="PART_LocationText" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Row="1" FontFamily="Verdana" FontSize="11" Text="{Binding Location}" TextWrapping="NoWrap" Foreground="#FF454545"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="PART_BorderElement" Visibility="Collapsed">
                            <Rectangle x:Name="PART_BorderSelectedElement" Stroke="Transparent"/>
                            <Rectangle x:Name="PART_LeftRect" Fill="White" Stroke="Black" StrokeThickness="1" Height="5" HorizontalAlignment="Left" Margin="-2,0,0,0" VerticalAlignment="Center" Width="5"/>
                            <Rectangle x:Name="PART_RightRect" Fill="White" Stroke="Black" StrokeThickness="1" Height="5" HorizontalAlignment="Right" Margin="0,0,-2,0" VerticalAlignment="Center" Width="5"/>
                            <Border x:Name="PART_LeftEdge" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="5" Background="Transparent"/>
                            <Border x:Name="PART_RightEdge" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5" Background="Transparent"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
