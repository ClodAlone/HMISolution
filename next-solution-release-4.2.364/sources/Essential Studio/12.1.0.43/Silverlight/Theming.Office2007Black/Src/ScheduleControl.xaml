    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:schedulecontrol="clr-namespace:Syncfusion.Windows.Controls.Schedule;assembly=Syncfusion.Schedule.Silverlight"
    xmlns:System_Windows_Controls_Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=System.Windows.Controls"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"   
	xmlns:System="clr-namespace:System;assembly=mscorlib"
    >
    <SolidColorBrush x:Key="Office14BlackBackgroundBrush" Color="White"></SolidColorBrush>
    <SolidColorBrush x:Key="Office14BlackForegroundBrush" Color="#FF363636"></SolidColorBrush>
    <SolidColorBrush x:Key="Office14BlackBorderBrush" Color="#FFB8B8B8"></SolidColorBrush>
    <!--Day Header Part -->
    <LinearGradientBrush x:Key="TodayHeaderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFED79" Offset="0"/>
        <GradientStop Color="#FFFFD86B" Offset="0.5"/>
        <GradientStop Color="#FFFFEA77" Offset="0.952"/>
        <GradientStop Color="#FFA5BFE1" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScheduleButtonForeground" Color="#FF1E395B"/>
    <SolidColorBrush x:Key="ScheduleButtonBorderBrush" Color="#FFC2943C"/>
    <LinearGradientBrush x:Key="ScheduleButtonMouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDF8E5" Offset="0"/>
        <GradientStop Color="#FFFBEBAA" Offset="0.016"/>
        <GradientStop Color="#FFFAE289" Offset="0.131"/>
        <GradientStop Color="#FFF8E188" Offset="0.885"/>
        <GradientStop Color="#FFF9EAAD" Offset="0.951"/>
        <GradientStop Color="#FFFCFAF2" Offset="1"/>
