<sync:WindowControl x:Class="Syncfusion.Silverlight.Controls.PivotGrid.PivotFieldListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared.Controls;assembly=Syncfusion.Shared.Silverlight" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid" 
    mc:Ignorable="d" MinWidth="220" Width="220" Height="250" 
    d:DesignHeight="300" d:DesignWidth="400" AnimationType="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <sync:WindowControl.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
        <DataTemplate x:Key="pvtTableTemplate">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                <TextBlock Margin="4,0,0,0" Text="{Binding FieldHeader}"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="pvtTableItemStyle" TargetType="ListBoxItem">
            <Setter Property="sfshared:DragAndDropManager.AllowDrag" Value="True"/>
            <Setter Property="sfshared:DragAndDropManager.AllowDrop" Value="True"/>
            <Setter Property="sfshared:DragAndDropManager.DropDescriptionVisibility" Value="Collapsed"/>
        </Style>
    </sync:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Background="White">
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <CheckBox Content="Show all fields" IsChecked="{Binding ShowAllFields,Mode=TwoWay}" VerticalAlignment="Center" Margin="10 0 10 0"/>
            <Button x:Name="MoveDown" Height="23" Width="27" ToolTipService.ToolTip="{Binding MoveDown,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Right" 
                Margin="0,3,11,3" Click="UpDown_Click">
                <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 1.72079,9.20409L 5.62049,9.19964L 5.62049,1.13207L 10.8085,1.13207L 10.8085,9.1937L 14.4013,9.18959L 8.08485,14.9903L 1.72079,9.20409 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="#FFA8C8EE" Offset="0"/>
                                <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                                <GradientStop Color="#FF6A9BF0" Offset="1"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="#FF1243A4" Offset="0"/>
                                <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                                <GradientStop Color="#FF233F70" Offset="1"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

            </Button>
            <Button x:Name="MoveUp" Height="23" Width="27" ToolTipService.ToolTip="{Binding MoveUp,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Right" 
                Margin="0,3,42,3" Click="UpDown_Click">
                <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 14.4015,6.9183L 10.5018,6.92275L 10.5018,14.9903L 5.31371,14.9903L 5.31371,6.92869L 1.72093,6.9328L 8.03739,1.13211L 14.4015,6.9183 Z ">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="#FFA8C8EE" Offset="0"/>
                                <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                                <GradientStop Color="#FF6A9BF0" Offset="1"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0.797968,0.432267" EndPoint="0.190285,0.432267">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="#FF1243A4" Offset="0"/>
                                <GradientStop Color="#FF638EE9" Offset="0.550182"/>
                                <GradientStop Color="#FF233F70" Offset="1"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Button>
        </Grid>
        <ListBox AllowDrop="True" SelectionChanged="Part_PivotTableFields_SelectionChanged" ItemTemplate="{StaticResource pvtTableTemplate}" 
                                         x:Name="Part_PivotTableFields"
                                         ItemContainerStyle="{StaticResource pvtTableItemStyle}"
                                         ItemsSource="{Binding PivotTableFields}" Grid.Row="1"/>
    </Grid>
</sync:WindowControl>
