<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.GridCommon.Silverlight"   xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows" 
                    >

    <resource:ResourceWrapper x:Key="resourceWrapper"/>
    
    <SolidColorBrush x:Key="MetroGridBackground" Color="#FFF4F4F4"/>
    
    <SolidColorBrush x:Key="MetroGridLineStroke" Color="#FFE5E5E5"/>
    
    <SolidColorBrush x:Key="MetroGroupingBarItemsBorderBrush" Color="#00FFFFFF"/>

    <SolidColorBrush x:Key="MetroColumnHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroColumnHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroSummaryHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroSummaryHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroSummaryCellBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroSummaryCellForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroRowHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroRowHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroValueCellBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroValueCellForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroGroupingBarBackground" Color="#FFF4F4F4"/>

    <SolidColorBrush x:Key="MetroGroupingBarItemsBackground" Color="#FFEBEBEB"/>

    <SolidColorBrush x:Key="MetroComputationButtomBackground" Color="#FFEBEBEB"/>
    
    <SolidColorBrush x:Key="MetroGroupingBarItemForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroWindowBorderBrush" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroGridOuterBorderBrush" Color="#FFDDDDDD"/>

    <SolidColorBrush x:Key="MetroButtonMouseHoverBackground" Color="#FFD8D8D9"/>

    <SolidColorBrush x:Key="MetroButtonMouseHoverBorderBrush" Color="#00FFFFFF"/>

    <SolidColorBrush x:Key="MetroButtonMouseHoverForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroButtonCheckedBackground" Color="#FF119EDA"/>

    <SolidColorBrush x:Key="MetroButtonCheckedForeground" Color="#FFFFFFFF"/>

    <local:PivotGridCellStyle x:Key="MetroColumnHeaderStyle" 
                             Background="{StaticResource MetroColumnHeaderBackground}"
                             Foreground="{StaticResource MetroColumnHeaderForeground}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />

    <local:PivotGridCellStyle x:Key="MetroRowHeaderStyle" 
                             Background="{StaticResource MetroRowHeaderBackground}"
                             Foreground="{StaticResource MetroRowHeaderForeground}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />


    <local:PivotGridCellStyle x:Key="MetroSummaryHeaderStyle" 
                             Background="{StaticResource MetroSummaryHeaderBackground}"
                             Foreground="{StaticResource MetroSummaryHeaderForeground}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />

    <local:PivotGridCellStyle x:Key="MetroSummaryCellStyle"
                              Background="{StaticResource MetroSummaryCellBackground}"
                              Foreground="{StaticResource MetroSummaryCellForeground}"
                              FontFamily="Segoe WP"
                              FontWeight="SemiBold"
                             FontSize="13"
                              />

    <local:PivotGridCellStyle x:Key="MetroValueCellStyle" 
                             Background="{StaticResource MetroValueCellBackground}"
                             Foreground="{StaticResource MetroValueCellForeground}"
                             FontFamily="Segoe WP"
                             FontSize="12"
                             />


    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource MetroGridBackground}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style TargetType="Button" x:Key="ComputationButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdItem" VerticalAlignment="Center"  CornerRadius="6" BorderBrush="#00FFFFFF"
                            BorderThickness="1" Background="{StaticResource MetroComputationButtomBackground}">
                        <TextBlock Height="25" Text="{Binding ShowFields,Source={StaticResource resourceWrapper}}" Margin="2,3,3,2" TextAlignment="Center" />                           
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #FFD8D8D9
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #00FFFFFF
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroExpanderStyle"  TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="#FFFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="#FFFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1" Width="11"  BorderThickness="0" Background="Transparent"   HorizontalAlignment="Right"  >
                            <Grid>
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FFFFFFFF"/>
                                <Path x:Name="CheckedVisual" Data="M290.5,329 L312.5,329.5 302.5,347.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FFFFFFFF"/>                                
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"   Margin="4,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>   
    
    
    <Style TargetType="local:PivotGridControl">
        <Setter Property="Background" Value="{StaticResource MetroGridBackground}"/>
        
        <Setter Property="ColumnHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource MetroColumnHeaderBackground}"
                             Foreground="{StaticResource MetroColumnHeaderForeground}"
                             FontFamily="Segoe WP"                             
                             FontSize="13"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderCellStyle">
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource MetroRowHeaderBackground}"
                             Foreground="{StaticResource MetroRowHeaderForeground}"
                             FontFamily="Segoe WP"                           
                             FontSize="13"
                             />

            </Setter.Value>

        </Setter>
        <Setter Property="SummaryCellStyle">
            <Setter.Value>
                <local:PivotGridCellStyle
                              Background="{StaticResource MetroSummaryCellBackground}"
                              Foreground="{StaticResource MetroSummaryCellForeground}"
                              FontFamily="Segoe WP"
                              FontWeight="SemiBold"
                              FontSize="13"
                              />

            </Setter.Value>
        </Setter>
        <Setter Property="SummaryHeaderStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource MetroSummaryHeaderBackground}"
                             Foreground="{StaticResource MetroSummaryHeaderForeground}"
                             FontFamily="Segoe WP"                            
                             FontSize="13"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource MetroValueCellBackground}"
                             Foreground="{StaticResource MetroValueCellForeground}"
                             FontFamily="Segoe WP"
                             FontSize="12"
                             />
            </Setter.Value>
        </Setter>

        <Setter Property="ExpanderStyle" Value="{StaticResource MetroExpanderStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource MetroGridLineStroke}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource MetroGroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource MetroGroupingBarItemsBorderBrush}"/>
        <Setter Property="GroupingBarItemForeground" Value="{StaticResource MetroGroupingBarItemForeground}"/>
        <Setter Property="GridOuterBorderBrush" Value="{StaticResource MetroGridOuterBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource MetroButtonMouseHoverBackground}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource MetroButtonMouseHoverBorderBrush}"/>            
        <Setter Property="GroupingButtonCheckedBackground" Value="{StaticResource MetroButtonCheckedBackground}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource MetroButtonCheckedForeground}"/>
        
    </Style>


</ResourceDictionary>