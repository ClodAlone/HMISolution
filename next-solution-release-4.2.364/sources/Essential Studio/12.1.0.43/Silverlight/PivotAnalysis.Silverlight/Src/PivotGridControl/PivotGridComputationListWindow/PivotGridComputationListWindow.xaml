<sync:WindowControl x:Class="Syncfusion.Silverlight.Controls.PivotGrid.PivotGridComputationListWindow"
		   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
		   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
		   xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared.Controls;assembly=Syncfusion.Shared.Silverlight"   
           xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"    
		   xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid" 
		    MinWidth="220" Width="220" Height="250"  Icon="/Syncfusion.OlapClient.Silverlight;component/Tools/Images/Member.png"
		    AnimationType="None" ResizeMode="NoResize" WindowStartupLocation="Manual">  
    <sync:WindowControl.Resources>
        <Style x:Key="PivotCalculationToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!--<ToggleButton Margin="2,4,2,0" Content="{Binding FieldName}" VerticalAlignment="Center" />-->
                        <Border Margin="2 3 2 3" x:Name="brdItem" BorderThickness="1">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock x:Name="contentTxt" TextTrimming="WordEllipsis"  VerticalAlignment="Center"  Text="{Binding FieldHeader}" Margin="2,0" >                              
                                </TextBlock>
                            </Grid>
                            <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                                <contextmenu:ContextMenuAdv x:Name="calculationToggleButtonContextMenuAdv" Visibility="Collapsed">
                                    <contextmenu:ContextMenuItemAdv Header="Order">
                                        <contextmenu:ContextMenuItemAdv Header="Move to Beginning" />
                                        <contextmenu:ContextMenuItemAdv Header="Move to Left" />
                                        <contextmenu:ContextMenuItemAdv Header="Move to Right" />
                                        <contextmenu:ContextMenuItemAdv Header="Move to End" />
                                        <contextmenu:ContextMenuItemAdv Header="Smallest to largest" />
                                        <contextmenu:ContextMenuItemAdv Header="Largest to smallest" />
                                    </contextmenu:ContextMenuItemAdv>
                                </contextmenu:ContextMenuAdv>
                            </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        Hand
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PivotCalculationTemplate">
            <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotCalculationToggleButtonStyle}" Tag="{Binding}" Margin="1,0,0,0" >
            </ToggleButton>
        </DataTemplate>

        <!-- PivotGrouping ComputationInfo ItemPanel Template-->
        <ItemsPanelTemplate x:Key="PivotComputationInfoPanelTemplate">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" />
        </ItemsPanelTemplate>

        <Style x:Key="PivotGroupingItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="sfshared:DragAndDropManager.AllowDrag" Value="True"/>
            <Setter Property="sfshared:DragAndDropManager.AllowDrop" Value="True"/>
            <Setter Property="sfshared:DragAndDropManager.DropDescriptionVisibility" Value="Collapsed"/>
        </Style>
    </sync:WindowControl.Resources>
    
    <Grid  x:Name="Grid1">
           <local:PivotGroupingItemsControl 
                                  x:Name="ComputationListPanel" Margin="-2,0,0,0"
                        BorderThickness="2,0,2,0" Background="{Binding}"  BorderBrush="{Binding}"
                        ItemsPanel="{StaticResource PivotComputationInfoPanelTemplate}"
                        ItemTemplate="{StaticResource PivotCalculationTemplate}"
                        ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}"
                        sfshared:DragAndDropManager.AllowDrop="True"
                       >                
            </local:PivotGroupingItemsControl>        
    </Grid>
</sync:WindowControl>