<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.GridCommon.Silverlight"  xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows" 
                    >

    <resource:ResourceWrapper x:Key="resourceWrapper"/>
    <SolidColorBrush x:Key="Office2010Silver.GridBackground" Color="#FFE4E8ED"/>

    <SolidColorBrush x:Key="Office2010Silver.GridLineStroke" Color="#FFA5ACB5"/>

    <SolidColorBrush x:Key="Office2010Silver.BorderBrush" Color="#FFA5ACB5"/>

    <SolidColorBrush x:Key="Office2010Silver.RowHeaderBackgroundBrush" Color="#FFEFF1F4"/>

    <LinearGradientBrush x:Key="Office2010Silver.ColumnHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF6F8FA" Offset="0"/>
        <GradientStop Color="#FFECEFF3" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010Silver.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2010Silver.SummaryBackgroundBrush" Color="#FFC5CED8"/>

    <SolidColorBrush x:Key="Office2010Silver.ColumnHeaderForegroundBrush" Color="#FF1E395B"/>
    <SolidColorBrush x:Key="Office2010Silver.RowHeaderForegroundBrush" Color="#FF1E395B"/>
    <SolidColorBrush x:Key="Office2010Silver.ValueCellForegroundBrush" Color="#FF6C6D6F"/>
    <SolidColorBrush x:Key="Office2010Silver.SummaryForegroundBrush" Color="#FF1E395B"/>

    <local:PivotGridCellStyle x:Key="Office2010Silver.ColumnHeaderStyle" 
                             Background="{StaticResource Office2010Silver.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2010Silver.RowHeaderStyle" 
                             Background="{StaticResource Office2010Silver.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2010Silver.SummaryStyle" 
                             Background="{StaticResource Office2010Silver.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2010Silver.ValueCellStyle" 
                             Background="{StaticResource Office2010Silver.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <SolidColorBrush x:Key="TreeViewFill.Black" Color="#FF898989"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Black"  StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFB5B5B5"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010SilverGroupingBarItemsBackground"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF6F8FA" Offset="0"/>
        <GradientStop Color="#FFECEFF3" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010SilverComputationButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF6F8FA" Offset="0"/>
        <GradientStop Color="#FFECEFF3" Offset="1"/>
    </LinearGradientBrush>

    <local:ExpanderPathConverter x:Key="expanderPathConverter"/>

    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF4CC" Offset="0"/>
        <GradientStop Color="#FFFFEDA6" Offset="0.03"/>
        <GradientStop Color="#FFFFE178" Offset="0.298"/>
        <GradientStop Color="#FFFFE275" Offset="0.576"/>
        <GradientStop Color="#FFFFFBDF" Offset="0.97"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#FFF3C84B" x:Key="ButtonHoverBorderBrush1"/>

    <LinearGradientBrush x:Key="Office2010SilverGroupingButtonsHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF4CC" Offset="0"/>
        <GradientStop Color="#FFFFEDA6" Offset="0.03"/>
        <GradientStop Color="#FFFFE178" Offset="0.298"/>
        <GradientStop Color="#FFFFE275" Offset="0.576"/>
        <GradientStop Color="#FFFFFBDF" Offset="0.97"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010SilverGroupingButtonsCheckedBackgroundBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FED5A8" Offset="1"/>
        <GradientStop Color="#FCBC7A" Offset="0.65"/>
        <GradientStop Color="#F99630" Offset="0.6"/>
        <GradientStop Color="#FCC869" Offset="0.25"/>
        <GradientStop Color="#FDECA2" Offset="0.05"/>
        <GradientStop Color="#FDF1B0" Offset="0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010SilverGroupingBarItemForeground" Color="#FF1E395B"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackground.Black}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style TargetType="Button" x:Key="ComputationButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdItem" VerticalAlignment="Center"  CornerRadius="6" BorderBrush="{StaticResource Office2010Silver.BorderBrush}"
                            BorderThickness="1" Background="{StaticResource Office2010SilverComputationButtonBackground}" >
                        <TextBlock Height="25" Text="{Binding ShowFields,Source={StaticResource resourceWrapper}}" Margin="2,3,3,2" TextAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFFFFBDA" Offset="0.022"/>
                                                        <GradientStop Color="#FFFFE8A8" Offset="0.499"/>
                                                        <GradientStop Color="#FFFFD767" Offset="0.507"/>
                                                        <GradientStop Color="#FFFFE59C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #FFFFC06F
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2010Silver.ExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame  KeyTime="0" >
                                                <DiscreteObjectKeyFrame.Value>
                                                    <DropShadowEffect Color="#FFD09D0F" ShadowDepth="0" BlurRadius="9" Direction="231"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame  KeyTime="0" >
                                                <DiscreteObjectKeyFrame.Value>
                                                    <DropShadowEffect Color="#FFD09D0F" ShadowDepth="0" BlurRadius="7" Direction="231"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Duration="0" To="#FFD09D0F" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual" />
                                        <ColorAnimation Duration="0" To="#FFD09D0F" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="CheckedVisual" />
                                        <ColorAnimation Duration="0" To="#FFE7B811" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
					BorderBrush="Transparent" 
					CornerRadius="1" 
					Width="11" 
					BorderThickness="0" 
					Background="Transparent"   HorizontalAlignment="Right">
                            <Grid>
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Width="6" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="8.032" VerticalAlignment="Top" Fill="White" StrokeThickness="0.5" Stroke="#FFA8A8A8"/>
                                <Path x:Name="CheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="5.074,2.032,0.126,0" Stretch="Fill"  Height="8.032" Width="5" VerticalAlignment="Top" Fill="#FF747474" Stroke="#FF252525" StrokeThickness="0.5" >
                                    <Path.RenderTransform>
                                        <CompositeTransform Rotation="45"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PivotGridControl">
        <Setter Property="Background" Value="{StaticResource Office2010Silver.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Office2010Silver.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.ColumnHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderCellStyle">
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Office2010Silver.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.RowHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryCellStyle">
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Office2010Silver.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.SummaryForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryHeaderStyle">
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Office2010Silver.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.SummaryForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Office2010Silver.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2010Silver.ValueCellForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>

        <Setter Property="ExpanderStyle" Value="{StaticResource Office2010Silver.ExpanderStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2010Silver.GridLineStroke}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2010SilverGroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Office2010Silver.BorderBrush}"/>
        <Setter Property="GroupingBarItemForeground" Value="{StaticResource Office2010SilverGroupingBarItemForeground}"/>
        <Setter Property="GridOuterBorderBrush" Value="{StaticResource Office2010Silver.BorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource Office2010SilverGroupingButtonsHoverBackgroundBrush}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2010Silver.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonCheckedBackground" Value="{StaticResource Office2010SilverGroupingButtonsCheckedBackgroundBrush}"/>
    </Style>

</ResourceDictionary>