<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.GridCommon.Silverlight"
                    >

    <resource:ResourceWrapper x:Key="resourceWrapper"/>
    
    <SolidColorBrush x:Key="Office2003Blue.GridBackground" Color="#D5E5FC"/>

    <SolidColorBrush x:Key="Office2003Blue.GridLineStroke" Color="#3170C9"/>

    <SolidColorBrush x:Key="Office2003Blue.ColumnHeaderBackgroundBrush" Color="#93B7EA"/>
    <SolidColorBrush x:Key="Office2003Blue.RowHeaderBackgroundBrush" Color="#93B7EA"/>
    <SolidColorBrush x:Key="Office2003Blue.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2003Blue.SummaryBackgroundBrush" Color="#BDD7FF"/>

    <SolidColorBrush x:Key="Office2003Blue.ColumnHeaderForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.RowHeaderForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.ValueCellForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.SummaryForegroundBrush" Color="#415788"/>


    <local:PivotGridCellStyle x:Key="Office2003Blue.ColumnHeaderStyle" 
                             Background="{StaticResource Office2003Blue.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2003Blue.RowHeaderStyle" 
                             Background="{StaticResource Office2003Blue.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2003Blue.SummaryStyle" 
                             Background="{StaticResource Office2003Blue.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2003Blue.ValueCellStyle" 
                             Background="{StaticResource Office2003Blue.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />
    
    <LinearGradientBrush x:Key="Office2003BlueComputationButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7FA6DB" Offset="1"/>
        <GradientStop Color="#FFC3D8FE" Offset="0.993"/>
        <GradientStop Color="#FFF4FAFE" Offset="0.082"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackground.Blue}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style TargetType="Button" x:Key="ComputationButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdItem" VerticalAlignment="Center"  CornerRadius="6"
                            BorderThickness="1" Background="{StaticResource Office2003BlueComputationButtonBackground}" >
                        <TextBlock Height="25" Text="{Binding ShowFields,Source={StaticResource resourceWrapper}}" Margin="2,3,3,2" TextAlignment="Center" Foreground="{Binding Office2003Blue.SummaryForegroundBrush}" />                       
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                        <GradientStop Color="#FFEDF2FA" Offset="0.501"/>
                                                        <GradientStop Color="#FFD7E4F4" Offset="0.506"/>
                                                        <GradientStop Color="#FFC1D2E8" Offset="0.969"/>
                                                    </LinearGradientBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #FFFFC06F
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2003Blue.ExpanderStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Blue}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            Background="{StaticResource ToolTipBackground.Blue}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Blue}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonMouseOverBrush.Blue}"
                                    TargetName="border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>