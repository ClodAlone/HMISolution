        </Setter>
        <Setter Property="ValueCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Blend.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Blend.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>

        <Setter Property="ExpanderStyle" Value="{StaticResource Blend.ExpanderStyle}"/>
        <Setter Property="GridLineStroke" Value="#FF333333"/>
        <Setter Property="GroupingBarItemBackground" Value="#FF3A3A3A"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="#FF333333"/>
        <Setter Property="GroupingBarItemForeground" Value="{StaticResource Blend.ColumnHeaderForegroundBrush}"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF2B2B2B"/>
        <!--<Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource BlendGroupingButtonsHoverBackgroundBrush}"/>-->
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="#FF808080"/>
