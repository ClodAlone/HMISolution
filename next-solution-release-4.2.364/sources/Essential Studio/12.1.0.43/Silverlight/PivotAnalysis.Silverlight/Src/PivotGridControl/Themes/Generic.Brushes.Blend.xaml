        <GradientStop Color="#FFFFE8A8" Offset="0.499"/>
        <GradientStop Color="#FFFFD767" Offset="0.507"/>
        <GradientStop Color="#FFFFE59C" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="local:PivotGridControl">
        <Setter Property="Background" Value="#FF595959"/>
        <Setter Property="ColumnHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Blend.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Blend.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Blend.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Blend.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>

        </Setter>
        <Setter Property="SummaryCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Blend.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Blend.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryHeaderStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Blend.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Blend.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />
