<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.GridCommon.Silverlight"   xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows" 
                    >

    <resource:ResourceWrapper x:Key="resourceWrapper"/>
    <SolidColorBrush x:Key="Office2007Blue.GridLineStroke" Color="#3170C9"/>

    <SolidColorBrush x:Key="Office2007Blue.GridBackground" Color="AliceBlue"/>


    <SolidColorBrush x:Key="Office2007Blue.ColumnHeaderBackgroundBrush" Color="#AED1FF"/>
    
    <LinearGradientBrush x:Key="Office2007Blue.RowHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC4D9FF" Offset="0.97"/>
        <GradientStop Color="#FFFBFFFF" Offset="0.03"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Blue.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryBackgroundBrush" Color="#FFFBE292"/>

    <SolidColorBrush x:Key="Office2007Blue.ColumnHeaderForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.RowHeaderForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.ValueCellForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryForegroundBrush" Color="#243A76"/>

    <LinearGradientBrush x:Key="Office2007BlueGroupingBarItemsBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7FA6DB" Offset="1"/>
        <GradientStop Color="#FFC3D8FE" Offset="0.993"/>
        <GradientStop Color="#FFF4FAFE" Offset="0.082"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueComputationButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7FA6DB" Offset="1"/>
        <GradientStop Color="#FFC3D8FE" Offset="0.993"/>
        <GradientStop Color="#FFF4FAFE" Offset="0.082"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="Office2007BlueGroupingButtonsHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFBDA" Offset="0.022"/>
        <GradientStop Color="#FFFFE8A8" Offset="0.499"/>
        <GradientStop Color="#FFFFD767" Offset="0.507"/>
        <GradientStop Color="#FFFFE59C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueGroupingButtonsCheckedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFA78057" Offset="0"/>
        <GradientStop Color="#FFC99465" Offset="0.021"/>
        <GradientStop Color="#FFFCB16D" Offset="0.123"/>
        <GradientStop Color="#FFFFAB47" Offset="0.327"/>
        <GradientStop Color="#FFFF8D05" Offset="0.435"/>
        <GradientStop Color="#FFFFC450" Offset="0.941"/>
        <GradientStop Color="#FFFFB41E" Offset="0.992"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ToolTipBackgroundColor"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="LightBlue"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <local:ExpanderPathConverter x:Key="expanderPathConverter"/>
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackgroundColor}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4"
            >
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style TargetType="Button" x:Key="ComputationButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdItem" VerticalAlignment="Center"   CornerRadius="6" BorderBrush="#FF6593CF"
                            BorderThickness="1" Background="{StaticResource Office2007BlueComputationButtonBackground}" >
                        <TextBlock Height="25" Text="{Binding ShowFields,Source={StaticResource resourceWrapper}}" Margin="2,3,3,2" TextAlignment="Center" Foreground="{StaticResource Office2007Blue.SummaryForegroundBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFFFFBDA" Offset="0.022"/>
                                                        <GradientStop Color="#FFFFE8A8" Offset="0.499"/>
                                                        <GradientStop Color="#FFFFD767" Offset="0.507"/>
                                                        <GradientStop Color="#FFFFE59C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #FFFFC06F
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Office2007Blue.ExpanderStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>



                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource ButtonHoverBorderBrush1}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>




                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                            BorderBrush="#FF3F576F"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            >
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.792,0.86" StartPoint="0.101,0.088">
                                    <GradientStop Color="White" Offset="0.229"/>
                                    <GradientStop Color="#FFB0C8F0" Offset="0.974"/>
                                </LinearGradientBrush>

                            </Border.Background>

                            <Border BorderThickness="2" CornerRadius="2">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="MouseOverColor" Color="Transparent"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <Path Margin="0" Fill="#FF3F576F" Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, 
                                        Converter={StaticResource expanderPathConverter}}"/>
                                    <!--<Path Margin="0" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="Black" Name="UncheckedVisual" />
                                    <Path Margin="0" Data="M0,2L0,3 5,3 5,2z" 
                                              Fill="Black" Name="CheckedVisual" />-->
                                </Grid>
                            </Border>

                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonMouseOverBrush.Blue}"
                                    TargetName="border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
  
    <Style TargetType="local:PivotGridControl">
        <Setter Property="Background" Value="#FFB0D7FF"/>
        <Setter Property="ColumnHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Office2007Blue.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="#FFD7E6FE"
                             Foreground="{StaticResource Office2007Blue.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>

        </Setter>
        <Setter Property="SummaryCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Office2007Blue.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryHeaderStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Office2007Blue.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Office2007Blue.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>

        <Setter Property="ExpanderStyle" Value="{StaticResource Office2007Blue.ExpanderStyle}"/>
        <Setter Property="GridLineStroke" Value="#FFADD1FF"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2007BlueGroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="#FF6593CF"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF15428B"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF6593CF"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource Office2007BlueGroupingButtonsHoverBackgroundBrush}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2007Blue.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonCheckedBackground" Value="{StaticResource Office2007BlueGroupingButtonsCheckedBackgroundBrush}"/>
    </Style>
</ResourceDictionary>