<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.GridCommon.Silverlight"  xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"  
                    >
    <resource:ResourceWrapper x:Key="resourceWrapper"/>
    <SolidColorBrush x:Key="Transparent.GridLineStroke" Color="Black"/>

    <SolidColorBrush x:Key="Transparent.GridBackground" Color="#4CFFFFFF"/>


    <SolidColorBrush x:Key="Transparent.RowHeaderBackgroundBrush" Color="#4CFFFFFF"/>

    <!--<LinearGradientBrush x:Key="Transparent.RowHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC4D9FF" Offset="0.97"/>
        <GradientStop Color="#FFFBFFFF" Offset="0.03"/>
    </LinearGradientBrush>-->
    <LinearGradientBrush x:Key="Transparent.ColumnHeaderBackgroundBrush" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#ECF8FBFD"/>
        <GradientStop Color="#00A3A3A3" Offset="1"/>
        <GradientStop Color="#C0FFFFFF"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Transparent.ValueCellBackgroundBrush" Color="#4CFFFFFF"/>
    <SolidColorBrush x:Key="Transparent.SummaryBackgroundBrush" Color="#B3FFFFFF"/>

    <SolidColorBrush x:Key="Transparent.ColumnHeaderForegroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="Transparent.RowHeaderForegroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="Transparent.ValueCellForegroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="Transparent.SummaryForegroundBrush" Color="#FF000000"/>

    <LinearGradientBrush x:Key="TransparentGroupingBarItemsBackground" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#ECF8FBFD"/>
        <GradientStop Color="#7EA3A3A3" Offset="1"/>
        <GradientStop Color="#C0FFFFFF"/>
        <GradientStop Color="#9BFFFFFF" Offset="0.511"/>
        <GradientStop Color="#83C7C7C7" Offset="0.515"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TransparentComputationButtonBackground" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#ECF8FBFD"/>
        <GradientStop Color="#7EA3A3A3" Offset="1"/>
        <GradientStop Color="#C0FFFFFF"/>
        <GradientStop Color="#9BFFFFFF" Offset="0.511"/>
        <GradientStop Color="#83C7C7C7" Offset="0.515"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="TransparentGroupingButtonsHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>
    

    <LinearGradientBrush x:Key="TransparentGroupingButtonsCheckedBackgroundBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF"/>
        <GradientStop Color="#7EFFFFFF" Offset="0.032"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.649"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ToolTipBackgroundColor"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="LightBlue"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <local:ExpanderPathConverter x:Key="expanderPathConverter"/>
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#7F000000" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackgroundColor}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4"
            >
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style TargetType="Button" x:Key="ComputationButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdItem" VerticalAlignment="Center"   CornerRadius="6" BorderBrush="#FF000000"
                            BorderThickness="1" Background="{StaticResource TransparentComputationButtonBackground}" >
                        <TextBlock Height="25" Text="{Binding ShowFields,Source={StaticResource resourceWrapper}}" Margin="2,3,3,2" TextAlignment="Center" Foreground="{StaticResource Transparent.SummaryForegroundBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFFFFBDA" Offset="0.022"/>
                                                        <GradientStop Color="#FFFFE8A8" Offset="0.499"/>
                                                        <GradientStop Color="#FFFFD767" Offset="0.507"/>
                                                        <GradientStop Color="#FFFFE59C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #FFFFC06F
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Transparent.ExpanderStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>



                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource ButtonHoverBorderBrush1}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>




                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                            BorderBrush="#FF3F576F"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            >
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.792,0.86" StartPoint="0.101,0.088">
                                    <GradientStop Color="White" Offset="0.229"/>
                                    <GradientStop Color="#FFB0C8F0" Offset="0.974"/>
                                </LinearGradientBrush>

                            </Border.Background>

                            <Border BorderThickness="2" CornerRadius="2">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="MouseOverColor" Color="Transparent"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <Path Margin="0" Fill="#FF3F576F" Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, 
                                        Converter={StaticResource expanderPathConverter}}"/>
                                    <!--<Path Margin="0" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="Black" Name="UncheckedVisual" />
                                    <Path Margin="0" Data="M0,2L0,3 5,3 5,2z" 
                                              Fill="Black" Name="CheckedVisual" />-->
                                </Grid>
                            </Border>

                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonMouseOverBrush.Blue}"
                                    TargetName="border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PivotGridControl">
        <Setter Property="Background" Value="{StaticResource Transparent.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Transparent.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Transparent.ColumnHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Transparent.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Transparent.RowHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>

        </Setter>
        <Setter Property="SummaryCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Transparent.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Transparent.SummaryForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryHeaderStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Transparent.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Transparent.SummaryForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">

            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Transparent.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Transparent.ValueCellForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
            </Setter.Value>
        </Setter>

        <Setter Property="ExpanderStyle" Value="{StaticResource Transparent.ExpanderStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Transparent.GridLineStroke}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource TransparentGroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="#FF000000"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF000000"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF000000"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource TransparentGroupingButtonsHoverBackgroundBrush}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Transparent.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonCheckedBackground" Value="{StaticResource TransparentGroupingButtonsCheckedBackgroundBrush}"/>
    </Style>
</ResourceDictionary>
