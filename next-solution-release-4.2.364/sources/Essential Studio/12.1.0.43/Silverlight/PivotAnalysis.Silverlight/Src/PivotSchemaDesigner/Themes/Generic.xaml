<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
    xmlns:pivotSchemaDesigner="clr-namespace:Syncfusion.Silverlight.Controls.PivotSchemaDesigner"
    xmlns:res="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared.Controls;assembly=Syncfusion.Shared.Silverlight" 
    xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk">

    <pivotSchemaDesigner:DeletePivotItemCommand x:Name="DeletePivotItem"/>
    <pivotSchemaDesigner:DeleteFilterCommand x:Name="DeleteFilter"/>
    <pivotSchemaDesigner:ShowFilterCommand x:Name="ShowFilter"/>
    <pivotSchemaDesigner:ShowCalculationCommand x:Name="ShowCalculation"/>
    <res:ResourceWrapper x:Key="resourceWrapperKeys"/>

    <!--============Background Brushes for different theme===========-->
    <SolidColorBrush x:Key="Classic.PivotSchemaBackground" Color="White"/>
    <SolidColorBrush x:Key="Office2003.PivotSchemaBackground" Color="#FFE6E7E9"/>
    <SolidColorBrush x:Key="Blend.PivotSchemaBackground" Color="#FF595959"/>
    <SolidColorBrush x:Key="Metro.PivotSchemaBackground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Office2007Black.PivotSchemaBackground" Color="#FFE6E7E9"/>
    <SolidColorBrush x:Key="Office2007Blue.PivotSchemaBackground" Color="AliceBlue"/>
    <SolidColorBrush x:Key="Office2007Silver.PivotSchemaBackground" Color="#FFCFD2DB"/>

    <SolidColorBrush x:Key="Office2010Black.PivotSchemaBackground" Color="#FF808080"/>
    <SolidColorBrush x:Key="Office2010Blue.PivotSchemaBackground" Color="#FFCCDBEC"/>
    <SolidColorBrush x:Key="Office2010Silver.PivotSchemaBackground" Color="#FFE4E8ED"/>

    <!--ListBox Item background brush-->
    <LinearGradientBrush x:Key="ListBoxItem"  StartPoint="0.522556,-0.0161282" EndPoint="0.522556,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFF8E7" Offset="0"/>
            <GradientStop Color="#FFFCE29E" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--ListBox item background brush on mouse_hover-->
    <LinearGradientBrush x:Key="ListBoxItemMouseOver" StartPoint="0.522556,-0.0161282" EndPoint="0.522556,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFF8E7" Offset="0"/>
            <GradientStop Color="#FFF6CA54" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="lstPivotItemBorderBrush" Color="#F1D14D"/>

    <Style TargetType="ToggleButton"  x:Key="PivotItemToggleButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Margin="2,1" x:Name="brdItem" Background="{StaticResource ListBoxItem}" BorderBrush="{StaticResource lstPivotItemBorderBrush}" BorderThickness="1" CornerRadius="2">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="contentTxt" Text="{Binding FieldHeader}" Margin="6,0" />
                            <Button  x:Name="PART_PivotItemButton" Grid.Column="1" Width="12" Height="12" Margin="2,0" Tag="{Binding}" Command="{StaticResource DeletePivotItem}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border x:Name="PART_PivotItemImageBorder" >
                                            <Image HorizontalAlignment="Center" Height="8" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Delete.png" Stretch="UniformToFill" VerticalAlignment="Center" Width="8"  Margin="2,0"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                                            <GradientStop Color="#EFC723" Offset="0.501"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.506"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.969"/>
                                                                        </LinearGradientBrush>
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        #EFC723
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Cursor">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        Hand
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToggleButton"  x:Key="PivotComputationToggleButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Margin="2,1" x:Name="brdItem" Background="{StaticResource ListBoxItem}" BorderBrush="{StaticResource lstPivotItemBorderBrush}" BorderThickness="1" CornerRadius="2">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="contentTxt" Text="{Binding FieldHeader}" Margin="6,0" />
                            <Button  x:Name="PART_PivotItemButton" Grid.Column="1" Width="12" Height="12" Margin="2,0" Tag="{Binding}" Command="{StaticResource DeletePivotItem}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border x:Name="PART_PivotItemImageBorder" >
                                            <Image HorizontalAlignment="Center" Height="8" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Delete.png" Stretch="UniformToFill" VerticalAlignment="Center" Width="8"  Margin="2,0"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                                            <GradientStop Color="#EFC723" Offset="0.501"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.506"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.969"/>
                                                                        </LinearGradientBrush>
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        #EFC723
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Cursor">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        Hand
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="PART_ShowCalcButton" Grid.Column="2" Width="12" Height="12" Margin="2,0" Tag="{Binding}" Command="{StaticResource ShowCalculation}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border x:Name="PART_PivotItemImageBorder" >
                                            <Image HorizontalAlignment="Center" Height="8" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/DownArrow.png" Stretch="UniformToFill" VerticalAlignment="Center" Width="8"  Margin="2,0"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                                            <GradientStop Color="#EFC723" Offset="0.501"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.506"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.969"/>
                                                                        </LinearGradientBrush>
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        #EFC723
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Cursor">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        Hand
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToggleButton"  x:Key="ReportFilterToggleButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Margin="2,1" x:Name="brdItem" Background="{StaticResource ListBoxItem}" BorderBrush="{StaticResource lstPivotItemBorderBrush}" BorderThickness="1" CornerRadius="2">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="contentTxt" Text="{Binding DisplayHeader}" Margin="6,0" />
                            <!--Delete button-->
                            <Button Grid.Column="1" Width="12" Height="12" Margin="2,0" Tag="{Binding}" Command="{StaticResource DeleteFilter}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border x:Name="PART_PivotItemImageBorder">
                                            <Image HorizontalAlignment="Center" Height="8" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Delete.png" Stretch="UniformToFill" VerticalAlignment="Center" Width="8"  Margin="2,0"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                                            <GradientStop Color="#EFC723" Offset="0.501"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.506"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.969"/>
                                                                        </LinearGradientBrush>
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        #EFC723
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotItemImageBorder" Storyboard.TargetProperty="Cursor">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        Hand
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!--FilterBar Downward button-->
                            <Button x:Name="PART_FilterBtn" Grid.Column="2" Width="12" Height="12" Margin="2,0" Tag="{Binding}" Command="{StaticResource ShowFilter}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PART_ShowFilterBorder" >
                                            <Image HorizontalAlignment="Center" Height="8" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/DownArrow.png" Stretch="UniformToFill" VerticalAlignment="Center" Width="8"  Margin="2,0"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="MouseOver">
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_ShowFilterBorder" Storyboard.TargetProperty="Background">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                                            <GradientStop Color="#EFC723" Offset="0.501"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.506"/>
                                                                            <GradientStop Color="#EFC723" Offset="0.969"/>
                                                                        </LinearGradientBrush>
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_ShowFilterBorder" Storyboard.TargetProperty="BorderBrush">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        #EFC723
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_ShowFilterBorder" Storyboard.TargetProperty="Cursor">
                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                    <DiscreteObjectKeyFrame.Value>
                                                                        Hand
                                                                    </DiscreteObjectKeyFrame.Value>
                                                                </DiscreteObjectKeyFrame>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--ListBox PivotItem Template-->
    <DataTemplate x:Key="lstPivotItemTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotItemToggleButtonStyle}" Tag="{Binding}" Margin="1,0,0,0" >
        </ToggleButton>
    </DataTemplate>

    <!--ListBox PivotCalculation Template-->
    <DataTemplate x:Key="lstPivotCalculationTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotComputationToggleButtonStyle}" Tag="{Binding}" Margin="1,0,0,0" >
        </ToggleButton>
    </DataTemplate>
    <!--ListBox FilterItem Template-->
    <DataTemplate x:Key="lstPivotFilterItemTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource ReportFilterToggleButtonStyle}" Tag="{Binding}" Margin="1,0,0,0" >
        </ToggleButton>
    </DataTemplate>

    <!--ListBox Itemcontainer style-->
    <Style x:Key="lstItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="sfshared:DragAndDropManager.AllowDrag" Value="True"/>
        <Setter Property="sfshared:DragAndDropManager.AllowDrop" Value="True"/>
        <Setter Property="sfshared:DragAndDropManager.DropDescriptionVisibility" Value="Collapsed"/>
    </Style>

    <!--PivotDesigner style-->
    <Style TargetType="pivotSchemaDesigner:PivotSchemaDesigner" >
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="pivotSchemaDesigner:PivotSchemaDesigner">
                        <Border BorderBrush="Black" BorderThickness="1" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height=".5*" MinHeight="150"/>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height=".5*" MinHeight="150"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                 <Popup x:Name="PART_Indicator">
                                    <Line Stroke="Gray" StrokeThickness="2" X1="0"/>
                                </Popup>

                                <!--PivotTable Field List-->
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#FFCED4DB">
                                        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaHeaderPivotTableFieldList}" Margin="4,0" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Margin="8,0,8,3" Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaHeaderAddReport}" VerticalAlignment="Bottom"/>
                                    <!--PivotTable Field listbox-->
                                    <ListBox x:Name="PART_PivotTableList"
                                             Grid.Row="2" 
                                             Margin="6,0"
                                             AllowDrop="True"
                                             sfshared:DragAndDropManager.AllowDrop="True"
                                             ItemsSource="{Binding Path=PivotTableFields}"
                                             >
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    <TextBlock x:Name="contentTxt" Margin="4,0,0,0" Text="{Binding FieldName}" VerticalAlignment="Center"/>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_PivotTableList" Storyboard.TargetProperty="Cursor">
                                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                                            <DiscreteObjectKeyFrame.Value>
                                                                                Hand
                                                                            </DiscreteObjectKeyFrame.Value>
                                                                        </DiscreteObjectKeyFrame>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="sfshared:DragAndDropManager.AllowDrag" Value="True"/>
                                                <Setter Property="sfshared:DragAndDropManager.AllowDrop" Value="True"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                Hand
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                                <sdk:GridSplitter Grid.Row="1" Width="Auto" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFF9FAFA" />

                                <!--PivotTable Items-->
                                <Grid Grid.Row="2" Margin="6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height=".5*"/>
                                        <RowDefinition Height=".5*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="23"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"  Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaHeaderDragArea}" VerticalAlignment="Center"/>
                                        <!--Report Filters-->
                                        <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Height="12" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Filter_Pivot.png" Stretch="Fill" VerticalAlignment="Center" Width="12"  Margin="4,0"/>
                                            <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaListBoxReportFilter}" Margin="4,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!--Report Filter Listbox-->
                                        <ListBox x:Name="PART_FilterList" Grid.Column="0" Grid.Row="2" AllowDrop="True"
                                            Margin="0,0,2,0" 
                                            ItemsSource="{Binding Path=Filters}"
                                                 ItemTemplate="{StaticResource lstPivotFilterItemTemplate}"
                                            ItemContainerStyle="{StaticResource lstItemContainerStyle}"
                                            sfshared:DragAndDropManager.AllowDrop="True"   
                                             sfshared:DragAndDropManager.AllowDrag ="True" >
                                        </ListBox>
                                        <!--PivotColumn-->
                                        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Height="12" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Column.png" Stretch="Fill" VerticalAlignment="Center" Width="12"  Margin="4,0"/>
                                            <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaListBoxColumnLabel}" Margin="4,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!--PivotColumn Listbox-->
                                        <ListBox x:Name="PART_PivotColumnList" Grid.Column="1" AllowDrop="True"
                                             Grid.Row="2" 
                                             Margin="2,0,0,0"
                                            ItemTemplate="{StaticResource lstPivotItemTemplate}"
                                            ItemContainerStyle="{StaticResource lstItemContainerStyle}"
                                            ItemsSource="{Binding Path=PivotControl.PivotColumns}"
                                            sfshared:DragAndDropManager.AllowDrop="True"   
                                            sfshared:DragAndDropManager.AllowDrag ="True"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="23"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <!--PivotRows-->
                                        <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"  Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Height="12" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Row.png" Stretch="Fill" VerticalAlignment="Center" Width="12"  Margin="4,0"/>
                                            <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaListBoxRowLabel}" Margin="4,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!--PivotRow Listbox-->
                                        <ListBox x:Name="PART_PivotRowList" Grid.Column="0" AllowDrop="True"   
                                             sfshared:DragAndDropManager.AllowDrop="True"   
                                             sfshared:DragAndDropManager.AllowDrag ="True"
                                             Grid.Row="1" 
                                             Margin="0,0,2,0"
                                             ItemTemplate="{StaticResource lstPivotItemTemplate}"
                                             ItemContainerStyle="{StaticResource lstItemContainerStyle}"
                                             ItemsSource="{Binding Path=PivotControl.PivotRows}"/>

                                        <!--Pivot Values-->
                                        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"  Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Height="12" Source="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Sigma.png" Stretch="Fill" VerticalAlignment="Center" Width="12"  Margin="4,0"/>
                                            <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaListBoxValues}" VerticalAlignment="Center" Margin="4,0"/>
                                        </StackPanel>
                                        <!--Pivot Values listbox-->
                                        <ListBox x:Name="PART_PivotCalculationList" AllowDrop="True"
                                                 sfshared:DragAndDropManager.AllowDrop="True"   
                                                 sfshared:DragAndDropManager.AllowDrag ="True"
                                                 Grid.Column="1" Grid.Row="1" Margin="2,0,0,0"
                                                 ItemTemplate="{StaticResource lstPivotCalculationTemplate}"
                                                 ItemContainerStyle="{StaticResource lstItemContainerStyle}"
                                                 ItemsSource="{Binding Path=PivotControl.PivotCalculations}"/>
                                    </Grid>
                                </Grid>

                                <CheckBox x:Name="PART_ShowCalculationsAsColumn" Grid.Row="3" Margin="6,0" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaCheckBoxShowCalulation}" VerticalAlignment="Center" IsChecked="{Binding Path=PivotControl.ShowCalculationsAsColumns, Mode=TwoWay}"  />
                                <Grid Grid.Row="4" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="PART_DeferLayoutUpdate" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaCheckBoxDeferUpdate}"  VerticalAlignment="Center" IsChecked="{Binding Path=PivotControl.DeferLayoutUpdate, Mode=TwoWay}"/>
                                    <Button x:Name="PART_DeferLayoutUpdateButton" IsEnabled="{Binding ElementName=PART_DeferLayoutUpdate, Path=IsChecked}" Grid.Column="1" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaButtonUpdate}"  VerticalAlignment="Center" HorizontalAlignment="Right" Width="75"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>
