<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"  >
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CommonBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!-- Brushes -->


    <SolidColorBrush x:Key="CheckListBoxBackgroundBrushKey" Color="White"/>


    <LinearGradientBrush  x:Key="CheckListBoxItemMouseOverBrushKey" StartPoint="0.830428,0.0327849" EndPoint="0.830428,0.97541">            
       <GradientStop Color="#FFF9FAFC" Offset="0.00904159"/>
       <GradientStop Color="#FFF2F6FC" Offset="0.532971"/>
       <GradientStop Color="#FFEBF3FC" Offset="0.990868"/>            
    </LinearGradientBrush>


    
    <LinearGradientBrush x:Key="CheckListBoxItemPressedBrushKey" StartPoint="0.690438,1.04918" EndPoint="0.690438,0.0874342">       
            <GradientStop Color="#FFC1DBFB" Offset="0.00904159"/>
            <GradientStop Color="#FFCEE3FB" Offset="0.532971"/>
            <GradientStop Color="#FFDCEBFB" Offset="0.990868"/>        
    </LinearGradientBrush>

    <!-- Styles -->


    <Style x:Key="Windows7CheckedListBoxItemStyle" TargetType="local:CheckedListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBoxItem">
                    <Grid  Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="fillColor" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="fillColor2" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="fillColor" Opacity="0" Fill="{StaticResource CheckListBoxItemMouseOverBrushKey}" IsHitTestVisible="False" RadiusX="1" RadiusY="1"/>
                        <Rectangle x:Name="fillColor2" Opacity="0" Fill="{StaticResource CheckListBoxItemPressedBrushKey}" IsHitTestVisible="False" RadiusX="1" RadiusY="1"/>
                        <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent">
                            <Grid x:Name="PART_Grid" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PART_Grid1" Grid.Column="0">
                                    <CheckBox x:Name="PART_CheckBox" Style="{StaticResource CheckBox}" Grid.Column="0" IsChecked="{TemplateBinding IsChecked}"  VerticalAlignment="Center" />
                                    <RadioButton x:Name="PART_Radio" GroupName="RadioButton"  IsChecked ="{TemplateBinding IsChecked}"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <Image Grid.Column="1" 
                                       x:Name="LeftImage" 
                                       Source="{TemplateBinding LeftImageSource}"
                                       MaxWidth="{TemplateBinding LeftImageWidth}"
                                       MaxHeight="{TemplateBinding LeftImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                <ContentPresenter x:Name="PART_Content" Grid.Column="2" Margin="2"  Content="{TemplateBinding Content}" />
                                <Image Grid.Row="0" Grid.Column="3" 
                                       x:Name="RightImage" 
                                       Source="{TemplateBinding RightImageSource}"
                                       MaxWidth="{TemplateBinding RightImageWidth}"
                                       MaxHeight="{TemplateBinding RightImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:CheckedListBoxItem" BasedOn="{StaticResource Windows7CheckedListBoxItemStyle}"/>

    <Style x:Key="Windows7CheckedListBoxStyle" TargetType="local:CheckedListBox" >
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CheckListBoxBackgroundBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBox">
                    <Border CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="outerScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter x:Name="PART_ItemsHost"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="local:CheckedListBox" BasedOn="{StaticResource Windows7CheckedListBoxStyle}"/>
</ResourceDictionary>
