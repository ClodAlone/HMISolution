<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
 xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <SolidColorBrush x:Key="FocusedBorderBrushKey" Color="#FF6DBDD1"/>

    <SolidColorBrush x:Key="DisabledBackgroundBrushKey" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="BackgroundBrushKey" EndPoint=".7,1" StartPoint=".7,0">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#F9FFFFFF" Offset="0.375"/>
        <GradientStop Color="#E5FFFFFF" Offset="0.625"/>
        <GradientStop Color="#C6FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SelectedBrushKey" EndPoint=" 0.7,0" StartPoint=" 0.7,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#F9FFFFFF" Offset="0.375"/>
        <GradientStop Color="#E5FFFFFF" Offset="0.625"/>
        <GradientStop Color="#C6FFFFFF" Offset="1"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="PressedBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFB6C7D0" Offset="0"/>
        <GradientStop Color="#FFD9E8F1" Offset="0.022"/>
        <GradientStop Color="#FFE0F1FA" Offset="0.117"/>
        <GradientStop Color="#FFBEE2F5" Offset="0.508"/>
        <GradientStop Color="#FF9BD3EF" Offset="0.542"/>
        <GradientStop Color="#FF6DB5DC" Offset="0.933"/>
        <GradientStop Color="#FF60A7CE" Offset="0.978"/>
        <GradientStop Color="#FF31668D" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PressedBorderBrushKey" Color="#FF31668D"/>
   
    <SolidColorBrush x:Key="ButtonMouseOverBorderBrushKey" Color="#FF487BA3"/>
    <!-- Brushes -->
    
    <SolidColorBrush x:Key="DateTimeEditMouseOverBrushKey" Color="#FFF1F4F8"/>

    <SolidColorBrush x:Key="DateTimeEditCaretBackgroundBrushKey" Color="Black"/>    

    <LinearGradientBrush  x:Key="DateTimeEditBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE7F0F9" Offset="0.945"/>
        <GradientStop Color="#FFF6F8FC" Offset="0.99"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DateTimeEditFocusedBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="DateTimeEditBorderBrushKey" Color="#FF9B9FA4"/>

    <SolidColorBrush x:Key="CalendarControlBackgroundBrushKey" Color="#FFEAF2FB"/>

    <SolidColorBrush x:Key="CalendarControlBorderBrushKey" Color="#FFA0BCE4"/>

    <SolidColorBrush x:Key="CalendarControlHeaderTextBrushKey" Color="#FF15428B"/>

    <SolidColorBrush x:Key="TextBrushKey" Color="#FF15428B"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF15428B"/>    

    <SolidColorBrush x:Key="ButtonMouseOverBrushKey" Color="#FFF1F4F8"/>

    <SolidColorBrush x:Key="ButtonBorderBrushKey" Color="#FF9B9FA4"/>

    <LinearGradientBrush  x:Key="ButtonBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE7F0F9" Offset="0.945"/>
        <GradientStop Color="#FFF6F8FC" Offset="0.99"/>
    </LinearGradientBrush>    

    <LinearGradientBrush x:Key="ScrollButtonFillKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFCADCF0" Offset="0"/>
        <GradientStop Color="#FFCBDEF4" Offset="0.4"/>
        <GradientStop Color="#FFC2D5ED" Offset="0.4"/>
        <GradientStop Color="#FFCADCF5" Offset="1"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="MouseHoverScrollButtonFillKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MouseHoverCellBackgroundKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>



    <SolidColorBrush x:Key="MouseHoverCellBorderBrushKey" Color="#FFB79E73"/>

    <LinearGradientBrush x:Key="SelectedCellBackgroundKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFED498" Offset="0"/>
        <GradientStop Color="#FFFECD86" Offset="0.4"/>
        <GradientStop Color="#FFFDB759" Offset="0.4"/>
        <GradientStop Color="#FFFDEB9F" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SelectedCellBorderBrushKey" Color="#FF9E8255"/>

    <SolidColorBrush x:Key="MouseHoverCellForegroundKey" Color="#FF15428B"/>

    <SolidColorBrush x:Key="NextMonthDaysForegroundKey" Color="LightBlue"/>
    <SolidColorBrush x:Key="PreviousMonthDaysForegroundKey" Color="LightBlue"/>


    <Style x:Key="Windows7CalendarControlStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CalendarControlBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarControlBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource CalendarControlHeaderTextBrushKey}"/>
        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource MouseHoverScrollButtonFillKey}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource ScrollButtonFillKey}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>
        <Setter Property="DayForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="DateForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="MouseHoverCellBackground" Value="{StaticResource MouseHoverCellBackgroundKey}"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="{StaticResource MouseHoverCellBorderBrushKey}"/>
        <Setter Property="MouseHoverCellForeground" Value="{StaticResource MouseHoverCellForegroundKey}"/>
        <Setter Property="NextMonthDaysForeground" Value="{StaticResource NextMonthDaysForegroundKey}"/>
        <Setter Property="PreviousMonthDaysForeground" Value="{StaticResource PreviousMonthDaysForegroundKey}"/>
        <Setter Property="SelectedCellBackground" Value="{StaticResource SelectedCellBackgroundKey}"/>
        <Setter Property="SelectedCellBorderBrush" Value="{StaticResource SelectedCellBorderBrushKey}"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Padding" Value="2" />

    </Style>

    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource Windows7CalendarControlStyle}"/>

    <Style x:Key="BrushEditToggleButtonStyle1" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrushKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Background" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid >
                                <Rectangle x:Name="BackgroundGradient" Fill="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>

                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="3" RadiusY="3" IsHitTestVisible="false" Opacity="0"/>
                        <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
