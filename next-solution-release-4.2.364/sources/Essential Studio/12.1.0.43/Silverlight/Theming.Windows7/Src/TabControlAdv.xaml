<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"  
    xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight">

    <SolidColorBrush x:Key="TabControlBackground" Color="White"/>

    <LinearGradientBrush x:Key="TabControlBorderBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFA3AEB9" Offset="0"/>
            <GradientStop Color="#FF8399A9" Offset="0.375"/>
            <GradientStop Color="#FF718597" Offset="0.375"/>
            <GradientStop Color="#FF617584" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="DisabledTabControlBrushKey" Color="#8CFFFFFF"/>

        <!-- TabItem -->

        <SolidColorBrush x:Key="TabItemBackgroundBrushKey" Color="#FF1F3B53"/>
        <SolidColorBrush x:Key="TabItemBorderBrushKey" Color="#FFA3AEB9"/>
        <SolidColorBrush x:Key="DisabledTabItemBrushKey" Color="#8CFFFFFF"/>

        <!-- TabControl Adv -->

        <SolidColorBrush x:Key="TabControlAdvButtonPathBrushKey" Color="#000000"/>
        <SolidColorBrush x:Key="TabControlAdvButtonActivePathBrushKey" Color="#000000"/>
        <SolidColorBrush x:Key="TabControlAdvMenuBackgroundBrushKey" Color="#FBF9FB"/>
        <SolidColorBrush x:Key="TabControlAdvMenuBorderBrushKey" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="TabControlAdvMenuInnerLineBrushKey" Color="#A0A0B4"/>
        <LinearGradientBrush x:Key="TabControlAdvMenuInnerColumnBrushKey" EndPoint="1, 0.5" StartPoint="0, 0.5">
            <GradientStop Color="#F3F6FC" Offset="0"/>
            <GradientStop Color="#D5D9E6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TabControlAdvMenuItemBackgroundBrushKey" EndPoint="0.5, 1" StartPoint="0.5, 0">
            <GradientStop Color="#EEF7FB" Offset="0"/>
            <GradientStop Color="#BDE5F6" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TabControlAdvMenuItemBorderBrushKey" Color="#96D9F9"/>
        <SolidColorBrush x:Key="TabPanelAdvBackgroundBrushKey" Color="#FBF9FB"/>

        <SolidColorBrush x:Key="TabControlAdvLightBorderBrushKey" Color="#F2F9FD"/>
        <SolidColorBrush x:Key="TabControlAdvBlueBorderBrushKey" Color="#D2E6FA"/>

        <SolidColorBrush x:Key="TabControlAdvButtonBackgroundBrushKey" Color="#CEEDFA"/>
        <SolidColorBrush x:Key="TabControlAdvButtonBorderBrushKey" Color="#69A1BF"/>

        <SolidColorBrush x:Key="TabControlAdvBorderBrushKey" Color="#9196A2"/>
        <SolidColorBrush x:Key="TabControlAdvHoverSelectedBorderBrushKey" Color="#69A1BF"/>

        <LinearGradientBrush x:Key="TabControlAdvBackgroundBrushKey" EndPoint="0.5, 1" StartPoint="0.5, 0">
            <GradientStop Color="#EEF8FC"  Offset="0"/>
            <GradientStop Color="#84D1F1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvHoverBackgroundBrushKey" EndPoint="0.5, 1" StartPoint="0.5, 0">
            <GradientStop Color="#EEF8FC"   Offset="0"/>
            <GradientStop Color="#84D1F1"  Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TaControlAdvbSelectedBackgroundBrushKey" EndPoint="0.5, 1" StartPoint="0.5, 0">
            <GradientStop Color="Silver"  Offset="0"/>
            <GradientStop Color="WhiteSmoke"  Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvRightRotatedTabBackgroundBrushKey" EndPoint="1, 0.5" StartPoint="0, 0.5">
            <GradientStop Color="#E2EDF7" Offset="0"/>
            <GradientStop Color="#9AB6D3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvRightRotatedTabHoverBackgroundBrushKey" EndPoint="1, 0.5" StartPoint="0, 0.5">
            <GradientStop Color="#EEF8FC" Offset="0"/>
            <GradientStop Color="#84D1F1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvRightRotatedTabSelectedBackgroundBrushKey" EndPoint="1, 0.5" StartPoint="0, 0.5">
            <GradientStop Color="Silver" Offset="0"/>
            <GradientStop Color="WhiteSmoke" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvLeftRotatedTabBackgroundBrushKey" EndPoint="0, 0.5" StartPoint="1, 0.5">
            <GradientStop Color="#E2EDF7" Offset="0"/>
            <GradientStop Color="#9AB6D3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvLeftRotatedTabHoverBackgroundBrushKey" EndPoint="0, 0.5" StartPoint="1, 0.5">
            <GradientStop Color="#EEF8FC" Offset="0"/>
            <GradientStop Color="#84D1F1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TabControlAdvLeftRotatedTabSelectedBackgroundBrushKey" EndPoint="0, 0.5" StartPoint="1, 0.5">
            <GradientStop Color="Silver" Offset="0"/>
            <GradientStop Color="WhiteSmoke" Offset="1"/>
        </LinearGradientBrush>



        <Style TargetType="local:TabItemAdvBorderAero" x:Key="local:TabItemAdvBorderAero">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabItemAdvBorderAero">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal"/>
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvHoverBackgroundBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Selected">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="SelectedUpperBorderPath" Storyboard.TargetProperty="Opacity" To="1"/>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="SelectedDownBorderPath" Storyboard.TargetProperty="Opacity" To="1"/>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="RightRotatedNormal">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvRightRotatedTabBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvRightRotatedTabBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="RightRotatedMouseOver">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvRightRotatedTabHoverBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpperBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="RightRotatedSelected">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvRightRotatedTabSelectedBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpperBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="LeftRotatedNormal">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvLeftRotatedTabBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvLeftRotatedTabBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState 
                                        x:Name="LeftRotatedMouseOver">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvLeftRotatedTabHoverBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpperBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="LeftRotatedSelected">
                                        <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverUpperBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverDownBorderPath" Storyboard.TargetProperty="Opacity"  To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvLeftRotatedTabSelectedBackgroundBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DownBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpperBorderPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Canvas>
                                <Path x:Name="UpperBorderPath" 
                                  Stroke="{StaticResource TabControlAdvBorderBrushKey}"/>
                                <Path x:Name="DownBorderPath" 
                                  Fill="{StaticResource TabControlAdvBackgroundBrushKey}"
                                  Stroke="{StaticResource TabControlAdvBackgroundBrushKey}"/>
                                <Path x:Name="MouseOverUpperBorderPath"
                                  Stroke="{TemplateBinding BorderBrush}"/>
                                <Path x:Name="MouseOverDownBorderPath" 
                                  Fill="{TemplateBinding Background}"
                                  Stroke="Yellow" />
                                <Path x:Name="SelectedUpperBorderPath" Opacity="0"
                                  Stroke="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                <Path x:Name="SelectedDownBorderPath" Opacity="0"
                                  Fill="{StaticResource TaControlAdvbSelectedBackgroundBrushKey}"
                                  Stroke="Silver"/>
                                <Path x:Name="BorderBottomPath" Stroke="{StaticResource TabControlAdvBlueBorderBrushKey}"/>
                                <ContentPresenter Content="{TemplateBinding Content}">
                                </ContentPresenter>
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:TabItemAdvBorderAero}" TargetType="local:TabItemAdvBorderAero"/>


        <Style TargetType="local:DragMarker" x:Key="local:DragMarker">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:DragMarker">
                        <Popup x:Name="Popup" HorizontalOffset="{TemplateBinding HorizontalOffset}"
                           VerticalOffset="{TemplateBinding VerticalOffset}" Height="9" Width="8">
                            <Path x:Name="MarkerPath" Data="M3,0L3,7 L1,7 L4.5,10 L8,7 L6,7 L6,0 L2.5,0" Fill="{StaticResource TabControlAdvButtonBackgroundBrushKey}" 
                              Stroke="{StaticResource TabControlAdvBorderBrushKey}"/>
                        </Popup>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:DragMarker}" TargetType="local:DragMarker"/>




        <Style TargetType="local:TabPopupMenuItem" x:Key="local:TabPopupMenuItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabPopupMenuItem">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="ItemMouseOverBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="ItemMouseOverBorder" Opacity="0" Background="{StaticResource TabControlAdvMenuItemBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvMenuItemBorderBrushKey}" 
                                BorderThickness="1" CornerRadius="3" Margin="3"/>
                                <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" 
                                BorderThickness="1" CornerRadius="3" Margin="3">
                                    <Grid x:Name="ItemGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="ItemImage" Grid.Column="0" Width="20" Height="20" Source="{TemplateBinding HeaderImage}" Margin="2"/>
                                        <ContentPresenter x:Name="PART_PopUpPresenter" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                  ContentTemplate="{TemplateBinding HeaderTextTemplate}" Content="{TemplateBinding HeaderText}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:TabPopupMenuItem}" TargetType="local:TabPopupMenuItem"/>

        <Style TargetType="local:TabPopupMenu" x:Key="local:TabPopupMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabPopupMenu">
                        <Popup x:Name="Popup" HorizontalOffset="{TemplateBinding HorizontalOffset}"
                           VerticalOffset="{TemplateBinding VerticalOffset}">
                            <Border x:Name="PopupBorder" Background="{StaticResource TabControlAdvMenuBackgroundBrushKey}" BorderThickness="1"
                                BorderBrush="{StaticResource TabControlAdvMenuBorderBrushKey}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource TabControlAdvMenuInnerColumnBrushKey}"/>
                                        <Border Grid.Column="1" Background="{StaticResource TabControlAdvMenuInnerLineBrushKey}"/>
                                    </Grid>
                                    <StackPanel x:Name="PopupRoot" Grid.ColumnSpan="3">
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="MenuItemStyle" Value="{StaticResource local:TabPopupMenuItem}"/>
        </Style>

        <Style BasedOn="{StaticResource local:TabPopupMenu}" TargetType="local:TabPopupMenu"/>

        <Style TargetType="local:ScrollingButton" x:Key="local:ScrollingButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:ScrollingButton">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Pressed">
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Border x:Name="MouseOverButtonBorder" Width="14" Opacity="0" Height="14" Background="{StaticResource TabControlAdvButtonBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvButtonBorderBrushKey}" BorderThickness="1"/>
                            <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="PART_Path1" Data="M0,0L4,3.5 0,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}"/>
                                    <Path x:Name="PART_Path2" Data="M4,0L8,3.5 4,7"  Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path3" Data="M5,0L5,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path4" Data="M8,0L4,3.5 8,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path5" Data="M4,0L0,3.5 4,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path6" Data="M2,0L2,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:ScrollingButton}" TargetType="local:ScrollingButton"/>

        <Style TargetType="local:MenuButton" x:Key="local:MenuButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:MenuButton">
                        <Grid>
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Border x:Name="MouseOverButtonBorder" Width="14" Height="14" Opacity="0" Background="{StaticResource TabControlAdvButtonBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvButtonBorderBrushKey}" BorderThickness="1"/>
                            <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Path x:Name="PathButton"
				                Fill="{StaticResource TabControlAdvButtonPathBrushKey}"
				                HorizontalAlignment="Center" VerticalAlignment="Center"
				                Width="8" Height="8">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <PathGeometry>
                                                <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="8,1"/>
                                                    <LineSegment Point="8,3"/>
                                                    <LineSegment Point="0,3"/>
                                                </PathFigure>
                                            </PathGeometry>
                                            <PathGeometry>
                                                <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="4,8"/>
                                                    <LineSegment Point="8,4"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:MenuButton}" TargetType="local:MenuButton"/>

        <Style TargetType="local:CloseButton" x:Key="local:CloseButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:CloseButton">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Border x:Name="MouseOverButtonBorder" Width="14" Height="14" Opacity="0" Background="{StaticResource TabControlAdvButtonBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvButtonBorderBrushKey}" BorderThickness="1"/>

                            <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Path x:Name="CrossPath"
				                    Stroke="{StaticResource TabControlAdvButtonPathBrushKey}"
				                    StrokeThickness="1.5"
                                    Data="M1,1 L7,7 M1,7 L7,1"
				                    HorizontalAlignment="Center" VerticalAlignment="Center"
				                    Width="8" Height="8"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:CloseButton}" TargetType="local:CloseButton"/>

        <Style TargetType="local:TabPanelAdv" x:Key="local:TabPanelAdv">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabPanelAdv">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid>
                                <Border HorizontalAlignment="Stretch" Height="2" VerticalAlignment="Bottom" BorderThickness="1,0,1,0" 
                                    BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}" Background="{StaticResource TabControlAdvLightBorderBrushKey}"/>
                                <Border x:Name="BottomBorder" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                    BorderThickness="1,1,1,0" BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}" 
                                    CornerRadius="3">
                                    <Border BorderThickness="1,1,1,0" BorderBrush="{StaticResource TabControlAdvLightBorderBrushKey}" CornerRadius="3">
                                        <Border BorderThickness="2,2,2,0" BorderBrush="{StaticResource TabControlAdvBlueBorderBrushKey}">
                                            <Border BorderThickness="1,1,1,0" BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                        </Border>
                                    </Border>
                                </Border>
                                <controlsToolkit:DockPanel x:Name="DockPanel" LastChildFill="False">
                                    <Border x:Name="ButtonsBorder" controlsToolkit:DockPanel.Dock="Right">
                                        <controlsToolkit:DockPanel>
                                            <local:CloseButton 
                                            x:Name="PART_CloseButton" Width="14" Height="14"
                                            Style="{StaticResource local:CloseButton}"               
                                            controlsToolkit:DockPanel.Dock="Right"/>
                                            <StackPanel x:Name="MenuPanel" controlsToolkit:DockPanel.Dock="Right" Width="14" Height="14">
                                                <local:TabPopupMenu 
                                                x:Name="TabPopupMenu"
                                                Style="{StaticResource local:TabPopupMenu}"/>
                                                <local:MenuButton 
                                                x:Name="PART_MenuButton"
                                                Style="{StaticResource local:MenuButton}" 
                                                Width="14" Height="14"/>
                                            </StackPanel>
                                            <local:ScrollingPanel x:Name="PART_ScrollingPanel" HorizontalAlignment="Center" controlsToolkit:DockPanel.Dock="Right">
                                                <local:ScrollingButton 
                                                x:Name="FirstTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="FirstTab" Visibility="Collapsed"/>
                                                <local:ScrollingButton 
                                                x:Name="PrevPage"
                                                
                                                ScrollDirection="PrevPage" Visibility="Collapsed"/>
                                                <local:ScrollingButton 
                                                x:Name="PrevTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="PrevTab"/>
                                                <local:ScrollingButton 
                                                x:Name="NextTab"
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextTab"/>
                                                <local:ScrollingButton 
                                                x:Name="NextPage" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextPage" Visibility="Collapsed"/>
                                                <local:ScrollingButton 
                                                x:Name="LastTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="LastTab" Visibility="Collapsed"/>
                                            </local:ScrollingPanel>
                                        </controlsToolkit:DockPanel>
                                    </Border>
                                    <ContentPresenter Name="PART_TabItems" 
                                        controlsToolkit:DockPanel.Dock="Left">
                                    </ContentPresenter>
                                </controlsToolkit:DockPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource local:TabPanelAdv}" TargetType="local:TabPanelAdv"/>

        <Style TargetType="local:TabItemAdv" x:Key="Windows7TabItemAdvStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabItemAdv">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0,3,0,3"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard >
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0,3,0,3"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                                <vsm:VisualStateGroup x:Name="SelectionStates">
                                    <vsm:VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0,3,0,3"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="UnSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0,3,0,3"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                                <vsm:VisualStateGroup x:Name="FocusStates">
                                    <vsm:VisualState x:Name="LostFocus"/>
                                    <vsm:VisualState x:Name="GotFocus"/>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <local:TabItemAdvBorderAero x:Name="TabItemBorder"
                             Style="{StaticResource local:TabItemAdvBorderAero}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Foreground="{TemplateBinding Foreground}"
                            >
                                <controlsToolkit:DockPanel x:Name="PART_DockPanel" LastChildFill="True">
                                    <local:DragMarker 
                                x:Name="DragMarker"
                                Style="{StaticResource local:DragMarker}"/>
                                    <local:CloseButton 
                                x:Name="PART_CloseButton"
                                Style="{StaticResource local:CloseButton}"
                                Width="15" Height="14" Margin="2,0,3,0" controlsToolkit:DockPanel.Dock="Right"
                                VerticalAlignment="Center"/>
                                    <Image x:Name="PART_Image" Stretch="None" Margin="4,0,4,0"
                               VerticalAlignment="Center"/>
                                    <local:TabContentPanel x:Name="TabContentPanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                        <TextBox x:Name="PART_TextBox"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Collapsed"
                                      Margin="2,0,2,0"/>
                                    <ContentPresenter x:Name="PART_Content"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Visible"
                                      Margin="2,0,2,0">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock"/>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </local:TabContentPanel>
                                </controlsToolkit:DockPanel>
                            </local:TabItemAdvBorderAero>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style BasedOn="{StaticResource Windows7TabItemAdvStyle}" TargetType="local:TabItemAdv"/>

        <Style TargetType="local:TabControlAdv" x:Key="Windows7TabControlAdvStyle">
        <Setter Property="Background" Value="{StaticResource TabControlBackground}"/>
        <Setter Property="MinHeight"   Value="100"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabControlAdv">
                        <Grid Background="Transparent" VerticalAlignment="Stretch">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="TopPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="LeftPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="RightPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="BottomPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <local:TabControlPanel x:Name="TabControlPanel" Background="{TemplateBinding Background}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource TabPanelAdvBackgroundBrushKey}">
                                    <local:TabPanelAdv 
                                    x:Name="TabPanel" 
                                    Style="{StaticResource local:TabPanelAdv}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!--<ItemsPresenter x:Name="ItemsPresenter"/>-->
                                        <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </local:TabPanelAdv>
                                </Grid>
                            <Border x:Name="ContentPanel" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border x:Name="ContentPanel2" BorderBrush="{StaticResource TabControlAdvLightBorderBrushKey}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                        <Border x:Name="ContentPanel3" BorderBrush="{StaticResource TabControlAdvBlueBorderBrushKey}">
                                            <Border x:Name="ContentPanel4" BorderBrush="{StaticResource TabControlAdvBlueBorderBrushKey}">
                                                <Border x:Name="ContentPanel5" BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}">
                                                    <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                            </Border>
                                        </Border>
                                    </Border>
                                </Border>
                            </local:TabControlPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle"  Value="{StaticResource Windows7TabItemAdvStyle}"/>
        </Style>

        <Style BasedOn="{StaticResource Windows7TabControlAdvStyle}" TargetType="local:TabControlAdv"/>

    </ResourceDictionary>
