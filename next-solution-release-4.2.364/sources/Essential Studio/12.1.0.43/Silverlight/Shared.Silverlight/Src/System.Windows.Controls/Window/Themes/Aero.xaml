   <Style x:Key="CloseButtonStyle" TargetType="Button">
			<Setter Property="IsEnabled" Value="true"/>
			<Setter Property="IsTabStop" Value="false"/>
			<Setter Property="MinWidth" Value="5"/>
			<Setter Property="MinHeight" Value="5"/>
			<Setter Property="Background" Value="{StaticResource CloseButton_NormalBackgroundBrush}"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Arrow"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="FocusStates">
									<VisualState x:Name="Unfocused"/>
									<VisualState x:Name="Focused"/>
								</VisualStateGroup>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="MouseOver">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Background" Storyboard.TargetName="OuterBorder">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CloseButton_OverBackgroundBrush}"/>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ShadowOver">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
											</ObjectAnimationUsingKeyFrames>
											<ColorAnimation Duration="0" To="Red" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="OuterBorder" />
											<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="OuterBorder" />
											<DoubleAnimation Duration="0" To="11" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" Storyboard.TargetName="OuterBorder" />
											<DoubleAnimation Duration="0" To="95" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Direction)" Storyboard.TargetName="OuterBorder" />
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Pressed">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Background" Storyboard.TargetName="OuterBorder">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CloseButton_PressedBackgroundBrush}"/>
											</ObjectAnimationUsingKeyFrames>
											<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="OuterBorder" />
											<ColorAnimation Duration="0" To="#FFAF0000" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="OuterBorder" />
											<DoubleAnimation Duration="0" To="4" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" Storyboard.TargetName="OuterBorder" />
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Disabled"/>
									<VisualState x:Name="Normal">
										<Storyboard>
											<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" Storyboard.TargetName="OuterBorder" />
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
							<Border x:Name="OuterBorder" Background="{TemplateBinding Background}" CornerRadius="0,0,5,0" HorizontalAlignment="Left" Width="39">
								<Border.Effect>
									<DropShadowEffect/>
								</Border.Effect>
								<Border BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="0,0,5,0">
									<Grid HorizontalAlignment="Center" Margin="0,3" VerticalAlignment="Top" Width="23">
                                    <Image Source="/Syncfusion.Shared.Silverlight;Component/System.Windows.Controls/Window/Images/close.png" />
                                    <!--<Path Data="M2.0639408,0.25 L5.1016836,3.2877426 L8.0806208,0.3088057 L9.9303741,2.1585598 L6.9514375,5.1374969 L9.9891939,8.1752529 L8.1752529,9.989193 L5.1374969,6.9514375 L2.1585641,9.9303703 L0.30881,8.080616 L3.2877429,5.1016831 L0.25,2.0639405 z" Fill="{StaticResource HeaderButton_FillBrush}" Margin="0.207,-1.793,0.554,-0.447" Stretch="Fill" Stroke="#FF535666" StrokeThickness="0.5" UseLayoutRounding="False"/>-->
									</Grid>
								</Border>
							</Border>
							<ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"/>
							<StackPanel x:Name="ShadowOver" Height="41.695" IsHitTestVisible="False" Margin="-20 -4 -15 -15" Visibility="Collapsed" Width="53.57"/>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
