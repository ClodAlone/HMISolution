<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">

    <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
    <FontFamily x:Key="MetroFontFamily">Segoe WP</FontFamily>
    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>
    

    <!--Top Scroll Button Style-->
    <Style x:Key="TopScrollButtonStyleKey" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TopButtonScroll" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{StaticResource MetroBackgroundBrush}" x:Name="TopButtonScroll" BorderThickness="0.5" BorderBrush="{StaticResource MetroBorderBrush}">
                            <Path Fill="{StaticResource MetroForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="180"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Bottom Scroll Button Style-->
    <Style x:Key="BottomScrollButtonStyleKey" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BottomButtonScroll" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{StaticResource MetroBackgroundBrush}" x:Name="BottomButtonScroll"  BorderThickness="0.5" BorderBrush="{StaticResource MetroBorderBrush}">
                            <Path Fill="{StaticResource MetroForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z">
                            </Path>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroContextMenuItemAdvStyle" TargetType="controls:ContextMenuItemAdv">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="Padding" Value="4,3,2,3"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ContextMenuItemAdv">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Opacity" To="0.5"/>
                                    </Storyboard>
                                </VisualState>                              
                            </VisualStateGroup>                         
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Content" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ColorAnimation Duration="0" Storyboard.TargetName="InnerBorder" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" To="#40FFFFFF"/>-->
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>                        
                        <Rectangle x:Name="Bg" Stroke="Transparent" StrokeThickness="1" Opacity="0" Fill="{StaticResource MetroBrush}"/>                          
                        <!--<Rectangle x:Name="InnerBorder" RadiusX="2" RadiusY="2" Stroke="Transparent" Margin="1"/>-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto"
                                    MinWidth="24"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="17"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="PART_Content" Margin="1" VerticalAlignment="Center" Grid.Column="0" />

                            <Border BorderThickness="1" BorderBrush="{StaticResource MetroBorderBrush}" Background="{StaticResource MetroPanelBackgroundBrush}" x:Name="GlyphPanel" 
                                    Visibility="{TemplateBinding CheckBoxVisibility}"
                                    Width="22" Height="22" Margin="1">
                                <Path Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="{StaticResource MetroForegroundBrush}" x:Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="{StaticResource MetroBorderBrush}" Background="{StaticResource MetroPanelBackgroundBrush}" Visibility="{TemplateBinding RadioButtonVisibility}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="Background" 
								            StrokeThickness="1" Height="8" Margin="1" Width="8" Fill="{StaticResource MetroForegroundBrush}"/>
                                        <!--<Ellipse.Fill>
                                            <RadialGradientBrush Center="0.65625,0.218746" GradientOrigin="0.65625,0.218746">
                                                <RadialGradientBrush.GradientStops>
                                                    <GradientStop Color="#FFCCCCED" Offset="0"/>
                                                    <GradientStop Color="#FF16186D" Offset="1"/>
                                                </RadialGradientBrush.GradientStops>
                                                <RadialGradientBrush.RelativeTransform>
                                                    <TransformGroup>
                                                        <RotateTransform CenterX="0.65625" CenterY="0.218746" Angle="120.379"/>
                                                    </TransformGroup>
                                                </RadialGradientBrush.RelativeTransform>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>-->
                                    <Ellipse x:Name="BoxMiddleLine" Stroke="#FF333333" StrokeThickness="1" Height="10" Width="10" Opacity=".2"/>
                                    <Ellipse x:Name="CheckIcon" Fill="#FF333333" Height="4" Width="4" Opacity="1"/>
                                </Grid>
                            </Border>

                            <ContentControl x:Name="Presenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" 
                                              Margin="{TemplateBinding Padding}" Grid.Column="2"/>

                            <Border Grid.Column="3" Visibility="{TemplateBinding ExtendButtonVisibility}">
                                <Path x:Name="path" Fill="{StaticResource MetroForegroundBrush}" Stretch="Fill" Grid.Column="3" Stroke="{StaticResource MetroForegroundBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" Width="5" Height="5" 
                                      Data="M129,173 L129,282 L246,222 z" />
                            </Border>

                            <Popup x:Name="PART_Popup" Grid.Column="4" IsOpen="{TemplateBinding IsOpen}">
                                <Border x:Name="PopupBorder" BorderBrush="{TemplateBinding SubMenuBorderBrush}" BorderThickness="{TemplateBinding SubMenuBorderThickness}" 
                                Background="{TemplateBinding SubMenuBackground}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Height="10" Visibility="Collapsed" Grid.Row="0" x:Name="PART_TopScroll" Style="{StaticResource TopScrollButtonStyleKey}"/>
                                        <Grid x:Name="PopupGrid" Grid.Row="1">
                                        <Rectangle Fill="White" Width="28" Margin="2" HorizontalAlignment="Left"/>
                                        <Rectangle Fill="{StaticResource MetroBorderBrush}" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                                            <ScrollViewer x:Name="PART_ScrollViewer" BorderBrush="Transparent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Grid>
                                        <Button Height="10" Visibility="Collapsed" Grid.Row="2" x:Name="PART_BottomScroll" Style="{StaticResource BottomScrollButtonStyleKey}"/>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MetroContextMenuItemAdvStyle}" TargetType="controls:ContextMenuItemAdv"/>

    <Style x:Key="MetroSeparatorAdvStyle" TargetType="controls:SeparatorAdv">
        <Setter Property="Background" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="0,0.2,0,0"/>
        <Setter Property="Margin" Value="32,2,2,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeparatorAdv">
                    <Rectangle StrokeThickness="{TemplateBinding BorderThickness}"
                        Stroke="{TemplateBinding BorderBrush}"
                        Fill="{TemplateBinding BorderThickness}"
                        Height="1" StrokeDashArray="1,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MetroSeparatorAdvStyle}" TargetType="controls:SeparatorAdv"/>

    <Style x:Key="MetroContextMenuAdvStyle" TargetType="controls:ContextMenuAdv">
        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="SubMenuBackground" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="SubMenuBorderThickness" Value="1"/>
        <Setter Property="SubMenuBorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource MetroContextMenuItemAdvStyle}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VisualStyle" Value="Metro"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ContextMenuAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <!--<Border.Effect>
                            <DropShadowEffect
                                Color="#FFC0C0C0"
                                ShadowDepth="3"/>
                        </Border.Effect>-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Height="10" Visibility="Collapsed" Grid.Row="0" x:Name="PART_TopScroll" Style="{StaticResource TopScrollButtonStyleKey}"/>
                            <Grid x:Name="PopupGrid" Grid.Row="1">
                            <Rectangle Fill="{StaticResource MetroPanelBackgroundBrush}" Width="28" Margin="2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="{StaticResource MetroBorderBrush}" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                            <ScrollViewer x:Name="PART_ScrollViewer" BorderBrush="Transparent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                        <Button Height="10" Visibility="Collapsed" Grid.Row="2" x:Name="PART_BottomScroll" Style="{StaticResource BottomScrollButtonStyleKey}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MetroContextMenuAdvStyle}" TargetType="controls:ContextMenuAdv"/>
</ResourceDictionary>
