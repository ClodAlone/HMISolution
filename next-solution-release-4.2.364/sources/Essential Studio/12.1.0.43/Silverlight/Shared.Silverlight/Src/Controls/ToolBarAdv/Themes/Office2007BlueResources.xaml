    <SolidColorBrush x:Key="CheckedBorderBrush" Color="#FFFFA500" />
     
    <SolidColorBrush x:Key="ToolBarTextBoxDisabledBorderBrush" Color="#FFB5B2B5"/>   

    <LinearGradientBrush x:Key="MouseOverToggleButtonBackground" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFF9D1" Offset="1"/>
        <GradientStop Color="#FFEAA3" Offset="0.65"/>
        <GradientStop Color="#FFD75C" Offset="0.6"/>
        <GradientStop Color="#FFD456" Offset="0.25"/>
        <GradientStop Color="#FFE395" Offset="0.05"/>
        <GradientStop Color="#FFEAAD" Offset="0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="ToolBarComboBoxMouseOverBorderBrush" Color="#FF3399FF"/>

    <LinearGradientBrush x:Key="OuterBorderBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFDDCE9A" Offset="1"/>
        <GradientStop Color="#FFC1A978" Offset="0.486"/>
        <GradientStop Color="#FFD3CEBB" Offset="0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBoxItemMouseOverBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF8EE" Offset="0"/>
        <GradientStop Color="#FFFFECA8" Offset="0.3"/>
        <GradientStop Color="#FFFCD987" Offset="0.36666666666666664"/>
        <GradientStop Color="#FFFEDD70" Offset="0.6"/>
        <GradientStop Color="#FFFFD694" Offset="0.7"/>
        <GradientStop Color="#FFFDE599" Offset="0.93333333333333335"/>
        <GradientStop Color="#FFF3E7B5" Offset="1"/>
