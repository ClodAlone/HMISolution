                          <ToggleButton Style="{StaticResource ExpanderButtonStyle}" x:Name="PART_Toggle" Margin="-10 5 0 5" Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
