                            </ToggleButton>

                            <ContentControl Content="{TemplateBinding Header}" x:Name="PART_Header" Background="{TemplateBinding LineColor}" Grid.Column="1"/>

                            <Border Background="{TemplateBinding Background}" Grid.Column="1" Grid.Row="1">
                                <ItemsPresenter Grid.Column="1" Grid.Row="1" x:Name="PART_Presenter"/>
                            </Border>
                        </Grid>
                    </Border>
