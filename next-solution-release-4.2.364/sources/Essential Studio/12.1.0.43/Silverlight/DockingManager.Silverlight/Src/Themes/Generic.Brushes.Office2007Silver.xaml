    <!-- Office2007 Silver-->





    <Style TargetType="windows:SideButton" x:Key="Office2007Silver.sideButtonStyle">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="Trebuchet MS" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="windows:SideButton">
                    <Grid Background="#FFD6D7DE">
                        <Border Name="PART_Border" CornerRadius="6,6,0,0" BorderBrush="#FFB5B5B7" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Name="Icon"
							Margin="2" Height="18" Width="18"
							Background="{TemplateBinding Icon}" />
                                <Border Width="2" Height="2"/>
                                <TextBlock Text="{TemplateBinding Content}"
                            	Foreground="Black" Margin="2,2,2,2"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

