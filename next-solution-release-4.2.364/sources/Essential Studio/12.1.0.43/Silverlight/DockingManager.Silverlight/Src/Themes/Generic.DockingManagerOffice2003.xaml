<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls" 
    xmlns:windows="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.DockingManager.Silverlight" >

    <LinearGradientBrush x:Key="Blend.BrushHeader" StartPoint="0,0" EndPoint="0,1" >
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FF3B3B3B" Offset="0"/>
                <GradientStop Color="#FF333333" Offset="1"/>
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Blend.BrushSlot" Color="#FF333333"/>
    <SolidColorBrush x:Key="Blend.WindowBackground" Color="#FF333333"/>
    <SolidColorBrush x:Key="Blend.TabControlBackground" Color="#FF333333"/>
    <LinearGradientBrush x:Key="Blend.TabItemBackground" StartPoint="0,0" EndPoint="1,0" >
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FF3B3B3B" Offset="0"/>
                <GradientStop Color="#FF333333" Offset="1"/>
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Blend.TabItemBackgroundSelected" Color="#FF595959" />
    <SolidColorBrush x:Key="Blend.TabForeground" Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="Blend.TabItemForeground" Color="#DBDBDB" />
    <SolidColorBrush x:Key="Blend.TabForegroundSelected" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Blend.FloatHeaderBorderBrush" Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="Blend.FloatHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="Blend.DockedElementTabbedHostFocused" Color="#FF333333" />
    <SolidColorBrush x:Key="Blend.DockedElementTabbedHostFocusedForeground" Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="Blend.ButtonFocused" Color="Red" />
    <SolidColorBrush x:Key="Blend.ButtonFocusedBorder" Color="Red" />
    <SolidColorBrush x:Key="Blend.ButtonOver" Color="Red" />
    <SolidColorBrush x:Key="Blend.ButtonOverBorder" Color="Red" />
    <SolidColorBrush x:Key="Blend.MainContolBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Blend.TabItemsBackgroundMouseOver" Color="#FF424242" />
    <LinearGradientBrush x:Key="Blend.FloatHeaderMiddleBackground" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FF646464" Offset="0.5"/>
                <GradientStop Color="#FF595959" Offset="0.5"/>
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Blend.FloatWindowBorderBrush" Color="#FFDEDEDE" />

    <SolidColorBrush x:Key="Blend.MenuItemInactiveBackground" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Blend.MenuItemActiveBrush" Color="#AAAAAA" />



    <Style TargetType="windows:DockingManager">
        <!--<Setter Property="HeaderBackgroud" Value="{StaticResource Blend.BrushHeader}"/>-->
        <Setter Property="WindowBackground" Value="{StaticResource Blend.WindowBackground}"/>

        <!--<Setter Property="TabItemBackgroundUnSelected" Value="{StaticResource Blend.TabItemBackground}"/>

        <Setter Property="TabItemBackgroundSelected" Value="{StaticResource Blend.TabItemBackgroundSelected}"/>
        <Setter Property="TabItemForegroundUnSelected" Value="{StaticResource Blend.TabItemForeground}"/>

        <Setter Property="TabItemForegroundSelected" Value="{StaticResource Blend.TabForegroundSelected}"/>-->

    </Style>

</ResourceDictionary>
