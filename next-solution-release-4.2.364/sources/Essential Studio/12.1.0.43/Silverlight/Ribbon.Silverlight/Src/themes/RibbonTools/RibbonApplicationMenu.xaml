<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="RibbonItemMouseOverBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFF9D1" Offset="1"/>
        <GradientStop Color="#FFEAA3" Offset="0.65"/>
        <GradientStop Color="#FFD75C" Offset="0.6"/>
        <GradientStop Color="#FFD456" Offset="0.25"/>
        <GradientStop Color="#FFE395" Offset="0.05"/>
        <GradientStop Color="#FFEAAD" Offset="0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RibbonItemPressedBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#F6B96B" Offset="1"/>
        <GradientStop Color="#FDAA63" Offset="0.65"/>
        <GradientStop Color="#FC8F3C" Offset="0.6"/>
        <GradientStop Color="#FFBC61" Offset="0.25"/>
        <GradientStop Color="#FFCB7F" Offset="0.05"/>
        <GradientStop Color="#FFD086" Offset="0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RibbonItemForeground" Color="#FF00156E"/>

    <SolidColorBrush x:Key="RibbonItemBorderBrush" Color="#CAB583" />

    <LinearGradientBrush x:Key="RibbonItemHoverCheckedBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#E3A96B" Offset="1"/>
        <GradientStop Color="#F6A963" Offset="0.65"/>
        <GradientStop Color="#E68736" Offset="0.6"/>
        <GradientStop Color="#F8C35C" Offset="0.25"/>
        <GradientStop Color="#FDD065" Offset="0.05"/>
        <GradientStop Color="#FDD165" Offset="0"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Key="RibbonToggleButtonBackgroundBrush">
        <GradientStop Color="#FFF9ECC4" Offset="0"/>
        <GradientStop Color="#FFEED382" Offset="0.811"/>
        <GradientStop Color="#FFE9CA66" Offset="0.96"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RibbonItemCheckedBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FED5A8" Offset="1"/>
        <GradientStop Color="#FCBC7A" Offset="0.65"/>
        <GradientStop Color="#F99630" Offset="0.6"/>
        <GradientStop Color="#FCC869" Offset="0.25"/>
        <GradientStop Color="#FDECA2" Offset="0.05"/>
        <GradientStop Color="#FDF1B0" Offset="0"/>
    </LinearGradientBrush>

    <Style TargetType="local:SimpleMenuButton">
    	<Setter Property="Icon" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt16.png"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SimpleMenuButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InnerBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InnerBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Label" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InnerBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InnerBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Label" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="PART_OutterBorder"
			                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                            Opacity="{TemplateBinding Opacity}">
                            <Border.Resources>
                                <local:SizeToDoubleConverter x:Name="SizeToDoubleConverterKey" />
                            </Border.Resources>
                            <Border 
                                x:Name="PART_InnerBorder" BorderThickness="1">
                                <StackPanel 
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Stretch">
                                    <Image 
                                        Margin="5,1,5,3" 
                                        Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"
                                        Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        MinHeight="16" MinWidth="16"/>
                                    <StackPanel Orientation="Vertical"
                                        Margin="0,0,0,2" VerticalAlignment="Center">
                                        <TextBlock 
                                            x:Name="PART_Label" 
                                            TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            FontWeight="{TemplateBinding LabelFontWeight}" Text="{TemplateBinding Label}" />
                                        <TextBlock x:Name="PART_Description" Width="{TemplateBinding DescriptionWidth}"
                                            TextWrapping="Wrap" Margin="0,0,10,0" 
                                            TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left"
						                    Text="{TemplateBinding Description}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SplitMenuButton">
    	<Setter Property="Icon" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt16.png"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SplitMenuButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InnerBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ToggleButton" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ToggleButton" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Label" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ToggleButtonMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_InnerBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ToggleButton" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ToggleButton" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ContentBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonToggleButtonBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Label" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="TopScrollMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TopScroll" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TopScroll" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="BottomScrollMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BottomScroll" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BottomScroll" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="0" />
                            </Grid.ColumnDefinitions>
                            <Border 
                                Background="Transparent" 
                                x:Name="PART_InnerBorder" BorderThickness="1">
                                <Border.Resources>
                                    <local:SizeToDoubleConverter x:Name="SizeToDoubleConverterKey" />
                                </Border.Resources>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PART_ContentBorder" Grid.Column="0" BorderThickness="0" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Image Margin="5,1,5,3" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"
                                                Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                MinHeight="16" MinWidth="16"/>
                                            <ContentControl Grid.Column="1" Background="Transparent" x:Name="PART_Label" 
                                                VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding Header}" 
                                                ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                        </Grid>
                                    </Border>
                                    <Border 
                                        x:Name="PART_ToggleButton" Width="24" Grid.Column="1"
                                        Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="Transparent">
                                        <Path Fill="{StaticResource RibbonItemForeground}" Margin="5,16,0,0" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Height="0" Grid.Column="1" x:Name="PART_RibbonDropDownBdr">
                                <Grid>
                                    <local:RibbonShadow Margin="5,5,0,0" />
                                    <Border Background="#FFFAFAFA" BorderThickness="1" BorderBrush="Gray">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Height="{TemplateBinding ScrollerHeight}" Background="LightBlue" x:Name="PART_TopScroll" BorderThickness="0.5" BorderBrush="Transparent">
                                                <Path Fill="{StaticResource RibbonItemForeground}" Margin="0,5,0,0"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="180"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ScrollViewer 
                                                x:Name="PART_ScrollViewer" Grid.Row="1"
                                                VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" 
                                                Padding="0" Margin="0" BorderThickness="1">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                            <Border Height="{TemplateBinding ScrollerHeight}" Background="LightBlue" Grid.Row="2" x:Name="PART_BottomScroll" BorderThickness="0.5" BorderBrush="Transparent">
                                                <Path Fill="{StaticResource RibbonItemForeground}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z">
                                                </Path>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
