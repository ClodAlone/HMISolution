<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:local="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight" 
    xmlns:rich="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.RichTextBoxAdv.Silverlight">

    <!--<LinearGradientBrush x:Key="Metrobackgroundbrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC7DAF0" Offset="0"/>
        <GradientStop Color="#FF85A1C0" Offset="1"/>
    </LinearGradientBrush>-->

    <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
    <FontFamily x:Key="MetroFontFamily">/Syncfusion.Theming.Metro;component/Fonts/Fonts.zip#Segoe WP</FontFamily>
    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>

    
    <Style x:Key="MetroContextMenuItemAdvStyle" TargetType="local:ContextMenuItemAdv">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MetroFontFamily}"/>
        <Setter Property="Padding" Value="4,3,2,3"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ContextMenuItemAdv">
                    <Grid Height="{TemplateBinding Height}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Opacity" To="0.5"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1"/>                                        
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                        <Rectangle x:Name="Bg" Stroke="Transparent" StrokeThickness="1" Opacity="0" Fill="{StaticResource MetroBrush}">                           
                        </Rectangle>
                        <!--<Rectangle x:Name="InnerBorder" RadiusX="2" RadiusY="2" Stroke="Transparent" Margin="1"/>-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto"
                                    MinWidth="24"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="17"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="PART_Content" Margin="1" HorizontalAlignment="Center" Width="17" Height="17" VerticalAlignment="Center" Grid.Column="0" FontFamily="{StaticResource FontFamily}" Foreground="{TemplateBinding Foreground}"/>

                            <Border BorderThickness="1" BorderBrush="{StaticResource MetroBorderBrush}" Background="{StaticResource MetroBackgroundBrush}" x:Name="GlyphPanel" 
                                    Visibility="{TemplateBinding CheckBoxVisibility}"
                                    Width="22" Height="22" Margin="1">
                                <Path Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="#FF333333" x:Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight"/>
                            </Border>

                            <Border BorderThickness="1" BorderBrush="{StaticResource MetroBorderBrush}" Background="{StaticResource MetroBackgroundBrush}" Visibility="{TemplateBinding RadioButtonVisibility}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="Background" 
								            StrokeThickness="1" Height="8" Margin="1" Width="8" Fill="#FF333333">
                                        <!--<Ellipse.Fill>
                                            <RadialGradientBrush Center="0.65625,0.218746" GradientOrigin="0.65625,0.218746">
                                                <RadialGradientBrush.GradientStops>
                                                    <GradientStop Color="#FFCCCCED" Offset="0"/>
                                                    <GradientStop Color="#FF16186D" Offset="1"/>
                                                </RadialGradientBrush.GradientStops>
                                                <RadialGradientBrush.RelativeTransform>
                                                    <TransformGroup>
                                                        <RotateTransform CenterX="0.65625" CenterY="0.218746" Angle="120.379"/>
                                                    </TransformGroup>
                                                </RadialGradientBrush.RelativeTransform>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>-->
                                    </Ellipse>
                                    <Ellipse x:Name="BoxMiddleLine" Stroke="#FF333333" StrokeThickness="1" Height="10" Width="10" Opacity=".2"/>
                                    <Ellipse x:Name="CheckIcon" Fill="#FF333333" Height="4" Width="4" Opacity="1"/>
                                </Grid>
                            </Border>

                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Header}" VerticalAlignment="Center" ContentTemplate="{TemplateBinding HeaderTemplate}" 
                                              Margin="10,0,0,0" Grid.Column="2"/>

                            <Border Grid.Column="3" Visibility="{TemplateBinding ExtendButtonVisibility}">
                                <Path Fill="{StaticResource MetroForegroundBrush}" Stretch="Fill" Grid.Column="3" Stroke="{StaticResource MetroForegroundBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" Width="5" Height="5" 
                                      UseLayoutRounding="False" Data="M129,173 L129,282 L246,222 z" />
                            </Border>

                            <Popup x:Name="PART_Popup" Grid.Column="4" IsOpen="{TemplateBinding IsOpen}">
                                <Border BorderBrush="{TemplateBinding SubMenuBorderBrush}" BorderThickness="{TemplateBinding SubMenuBorderThickness}" 
                                Background="{TemplateBinding SubMenuBackground}">
                                    <Grid>
                                        <Rectangle Fill="White" Width="28" Margin="2" HorizontalAlignment="Left"/>
                                        <Rectangle Fill="{StaticResource MetroBorderBrush}" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                                        <ItemsPresenter Margin="2"/>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MetroContextMenuItemAdvStyle}" TargetType="local:ContextMenuItemAdv"/>

    <Style x:Key="MetroSeparatorAdvStyle" TargetType="local:SeparatorAdv">
        <Setter Property="Background" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="0,0.2,0,0"/>
        <Setter Property="Margin" Value="32,2,2,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SeparatorAdv">
                    <Rectangle StrokeThickness="{TemplateBinding BorderThickness}"
                        Stroke="{TemplateBinding BorderBrush}"
                        Fill="{TemplateBinding BorderThickness}"
                        Height="1" StrokeDashArray="1,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MetroSeparatorAdvStyle}" TargetType="local:SeparatorAdv"/>

    <Style x:Key="MetroContextMenuAdvStyle" TargetType="local:ContextMenuAdv">
        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="SubMenuBackground" Value="White"/>
        <Setter Property="SubMenuBorderThickness" Value="1"/>
        <Setter Property="SubMenuBorderBrush" Value="#FFA7ABB0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource MetroContextMenuItemAdvStyle}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VisualStyle" Value="Metro"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ContextMenuAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <!--<Border.Effect>
                            <DropShadowEffect
                                Color="#FFC0C0C0"
                                ShadowDepth="3"/>
                        </Border.Effect>-->
                        <Grid>
                            <Rectangle Fill="{StaticResource MetroPanelBackgroundBrush}" Width="28" Margin="2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="{StaticResource MetroBorderBrush}" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource MetroContextMenuAdvStyle}" TargetType="local:ContextMenuAdv"/>

    <Style TargetType="rich:RichTextBoxAdv">
        <!--<Setter Property="SelectionFillColor" Value="{StaticResource SelectionFillColor}"></Setter>-->
		<Setter Property="Background" Value="{StaticResource MetroBackgroundBrush}"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBackgroundBrush}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:RichTextBoxAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Background="{TemplateBinding Background}">
                        <local:ContextMenuAdvService.ContextMenuAdv>
                            <local:ContextMenuAdv x:Name="PART_ContextMenu" Style="{StaticResource MetroContextMenuAdvStyle}">
                                <local:ContextMenuItemAdv x:Name="PART_Cut" Header="Cut" Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding CutCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Cut16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Copy" Header="Copy" Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding CopyCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Copy16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Paste" Header="Paste" Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding PasteCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Paste16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:SeparatorAdv Style="{StaticResource MetroSeparatorAdvStyle}"/>
                                <local:ContextMenuItemAdv x:Name="PART_Table" Header="Table"  Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding InsertTableDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Table32.png" Width="16" Height="16" Margin="3 0 0 0" />
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Font" Header="Font..."  Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding FontDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Fontdialog.png"  Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Paragraph" Header="Paragraph..." Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding ParagraphDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Paragraphdialog.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Bullet" Header="Bullet" Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding ChangeListTypeCommand}" CommandParameter="Bulleted">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Bullets16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Numbering" Header="Numbering" Style="{StaticResource MetroContextMenuItemAdvStyle}" Command="{TemplateBinding ChangeListTypeCommand}" CommandParameter="Numbered">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Numbering16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:SeparatorAdv Style="{StaticResource MetroSeparatorAdvStyle}"/>
                                <local:ContextMenuItemAdv x:Name="PART_Hyperlink" Header="Hyperlink"  Style="{StaticResource MetroContextMenuItemAdvStyle }" Command="{TemplateBinding HyperlinkDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Hyperlink16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                            </local:ContextMenuAdv>
                        </local:ContextMenuAdvService.ContextMenuAdv>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.Column="0"/>
                            <ScrollBar x:Name="HorizontalScrollBar" Grid.Column="0" Height="16" Visibility="Collapsed" IsTabStop="False" Minimum="0" Orientation="Horizontal" Grid.Row="1"/>
                            <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" IsTabStop="False" Visibility="Collapsed" Minimum="0" Orientation="Vertical" Grid.Row="0" Width="16"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageLayoutViewer">        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageLayoutViewer">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:CaretAdv">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:CaretAdv">
                    <Rectangle x:Name="rectangle" Fill="{TemplateBinding Background}"></Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageAdv">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageAdv">
                    <Grid>
                        <Border x:Name="PART_shadowEfffect" Background="Black" Opacity="0.3" CornerRadius="0"
                                BorderThickness="0">
                            <Border.Effect>
                                <BlurEffect Radius="15"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Background="White" CornerRadius="0" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="IBeam">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
