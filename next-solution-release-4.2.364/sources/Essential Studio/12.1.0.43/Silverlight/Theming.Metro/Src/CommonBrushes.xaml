                        <Rectangle x:Name="Highlight" Stroke="{StaticResource ButtonSpinnerFocusVisualBrushKey}" StrokeThickness="0" RadiusX="0" RadiusY="0" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                        <Border x:Name="DisabledVisualElement" IsHitTestVisible="False" Opacity="0" Background="{StaticResource ButtonSpinnerDisabledBrushKey}" BorderBrush="{StaticResource ButtonSpinnerDisabledBrushKey}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource ButtonSpinnerFocusVisualBrushKey}" StrokeThickness="0" RadiusX="0" RadiusY="0" IsHitTestVisible="false" Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>
