                            <Path x:Name="CheckIcon" Fill="{StaticResource GlyphBrushKey}" Stretch="Fill" Height="10" Margin="1,1,0,1.5" Width="10.5" Opacity="0" Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z"/>
                            <Rectangle x:Name="IndeterminateIcon" Fill="{StaticResource GlyphBrushKey}" Height="2" Width="6" Opacity="0"/>
