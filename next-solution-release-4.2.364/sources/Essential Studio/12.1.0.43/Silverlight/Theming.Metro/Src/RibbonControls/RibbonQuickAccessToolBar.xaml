<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight" xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources;assembly=Syncfusion.Ribbon.Silverlight">
    
    <!--Brushes-->

 <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
    <FontFamily x:Key="MetroFontFamily">/Syncfusion.Theming.Metro;component/Fonts/SegoeWP.ttf#Segoe WP</FontFamily>
    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#FFBABABA"/>
    <SolidColorBrush x:Key="SplitterBrush1" Color="#FFFFFFFF"/>      
   
    <!--Style-->

    <Style TargetType="local:QATDropDownControl" x:Key="QATDropDownControlKey">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:QATDropDownControl">
                    <Grid Background="Transparent">
                        <Grid.Resources>
                            <local:SizeToDoubleConverter x:Key="SizeToDouble"/>                         

                            <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>
                            <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
                            <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
                            <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
                            <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
                            <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
                            <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
                            <FontFamily x:Key="MetroFontFamily">Segoe WP</FontFamily>
                            <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>

                            <Style TargetType="local:RibbonMenuGroup">

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="local:RibbonMenuGroup">
                                            <Grid Name="gri">
                                                <Grid.Resources>
                                                    <local:TextToVisibilityConverter x:Key="TextConverter"/>
                                                    <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                                    <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                                                </Grid.Resources>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="{StaticResource MetroBackgroundBrush}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="22" Grid.Row="0" BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentControl Content="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MetroForegroundBrush}" HorizontalContentAlignment="Left"/>
                                                </Border>
                                                <Border Grid.Row="1">
                                                    <Grid>
                                                        <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}" BorderBrush="{StaticResource MetroBorderBrush}" Background="{StaticResource MetroPanelBackgroundBrush}" BorderThickness="0,0,1,0" Width="26" HorizontalAlignment="Left"/>
                                                        <Border>
                                                            <ScrollViewer TabNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="2">
                                                    <Grid>
                                                        <Border BorderBrush="{StaticResource MetroBorderBrush}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" Background="{StaticResource MetroPanelBackgroundBrush}" BorderThickness="0,0,1,0" Width="22" HorizontalAlignment="Left"/>
                                                        <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="3" Height="14" BorderThickness ="0,1,0,0" BorderBrush="{StaticResource MetroBorderBrush}" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}" Background="{StaticResource MetroBackgroundBrush}">
                                                    <Grid>
                                                        <Border HorizontalAlignment="right" Margin="0,0,2,0">
                                                            <Grid >
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="6"/>
                                                                    <RowDefinition Height="4"/>
                                                                </Grid.RowDefinitions>
                                                                <Rectangle  Fill="#FFBCC6D1"  Height="2" Width="2" Margin="1" Grid.Row="1" Grid.Column="1">
                                                                    <Rectangle.Effect>
                                                                        <DropShadowEffect Color="White" Opacity="0.7" Direction="319"  BlurRadius="0" ShadowDepth="2"></DropShadowEffect>
                                                                    </Rectangle.Effect>
                                                                </Rectangle>

                                                                <Rectangle  Fill="#FFBCC6D1" Height="2" Width="2"  Margin="1" Grid.Row="0" Grid.Column="1">
                                                                    <Rectangle.Effect>
                                                                        <DropShadowEffect Color="White"  Opacity="0.7"  Direction="319"  BlurRadius="0" ShadowDepth="2"></DropShadowEffect>
                                                                    </Rectangle.Effect>
                                                                </Rectangle>
                                                                <Rectangle  Fill="#FFBCC6D1" Height="2" Width="2" Margin="1" Grid.Row="1" Grid.Column="0">
                                                                    <Rectangle.Effect>
                                                                        <DropShadowEffect Color="White" Opacity="0.7"  Direction="319"  BlurRadius="0" ShadowDepth="2"></DropShadowEffect>
                                                                    </Rectangle.Effect>
                                                                </Rectangle>

                                                            </Grid>
                                                        </Border>
                                                        <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="local:RibbonMenuItem">
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="local:RibbonMenuItem">
                                            <Grid>
                                                <Grid.Resources>
                                                    <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                                </Grid.Resources>
                                                <vsm:VisualStateManager.VisualStateGroups>
                                                    <vsm:VisualStateGroup x:Name="RibbonMenuItemStates">
                                                        <vsm:VisualStateGroup.Transitions>

                                                        </vsm:VisualStateGroup.Transitions>

                                                        <vsm:VisualState x:Name="Normal">
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                                                    <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                    <!--<EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>-->
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                        <vsm:VisualState x:Name="MouseOver">
                                                            <Storyboard>                                                               
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="content" Storyboard.TargetProperty="Foreground">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Foreground">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>

                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                                                    <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                    </vsm:VisualStateGroup>
                                                </vsm:VisualStateManager.VisualStateGroups>

                                                <Border Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Margin="1">
                                                    <Grid Margin="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ContentControl Foreground="{TemplateBinding Foreground}" x:Name="content" Content="{TemplateBinding Header}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" Grid.Column="1" Margin="6 2 2 2"/>
                                                        <ContentControl x:Name="path" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="2" Margin="3" FontSize="14"/>
                                                        <Border Margin="2" VerticalAlignment="{TemplateBinding HorizontalAlignment}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                                                            <ContentControl BorderThickness="2" Content="{TemplateBinding Icon}" Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IconSize, Converter={StaticResource SizeToDouble}, ConverterParameter=width}"
                                                    Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IconSize, Converter={StaticResource SizeToDouble}, ConverterParameter=height}">
                                                            </ContentControl>
                                                        </Border>
                                                        <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" Background="{StaticResource MetroPanelBackgroundBrush}" BorderBrush="{StaticResource MetroBorderBrush}" BorderThickness="1">
                                                            <Path x:Name="CheckIcon"  
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource MetroForegroundBrush}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown" Canvas.ZIndex="10">
                                                    <Grid Opacity="0" x:Name="PART_poup">
                                                        <local:RibbonShadow Margin="3,3,0,0"/>
                                                        <Border Background="{StaticResource MetroPanelBackgroundBrush}" BorderThickness="1" BorderBrush="{StaticResource MetroBorderBrush}">
                                                            <ItemsPresenter />
                                                        </Border>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>                                                                                
                            
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>                                        
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroFocusedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".55" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="DisabledVisualElement"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid Background="Transparent" x:Name="PART_ToggleButton">
                            <Border x:Name="Background" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                <Grid Background="{TemplateBinding Background}" Margin="0">                                    
                                    <Border x:Name="BackgroundGradient" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"/>
                                </Grid>
                            </Border>     
                            
                            <Grid Width="5" Background="Transparent">                                                                
                                <StackPanel VerticalAlignment="Center">
                                    <Line x:Name="path" Fill="{StaticResource MetroForegroundBrush}" VerticalAlignment="Bottom" X2="1" Stretch="Fill" Stroke="{StaticResource MetroForegroundBrush}" />
                                    <Path x:Name="path1" Data="M3.375,8.3987293 L8.0413799,8.4820175 L5.6247015,12.896584 z" Fill="{StaticResource MetroForegroundBrush}" StrokeStartLineCap="Flat" Stretch="Fill" StrokeEndLineCap="Flat" Stroke="{StaticResource MetroForegroundBrush}" StrokeThickness="1" StrokeMiterLimit="10" StrokeLineJoin="Miter" Height="3.3" Grid.Row="1" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Rectangle x:Name="DisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" RadiusY="3" RadiusX="3"/>
                            <Rectangle x:Name="FocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" RadiusY="2" RadiusX="2" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                        </Grid>
                        <local:RibbonDropDown Background="{StaticResource MetroPanelBackgroundBrush}" Grid.Row="1" x:Name="PART_RibbonDropDown">
                            <local:RibbonMenuGroup x:Name="PART_RibbonMenuGroup" IconBarEnabled="True">
                                <local:RibbonMenuItem Margin="0,0,0,0" x:Name="PART_MoreCommands" />
                                <local:RibbonMenuItem Margin="0,0,0,0" x:Name="PART_ShowBelowtheRibbon" />
                                <local:RibbonSeparator Margin="29,-4,0,0"/>
                                <local:RibbonMenuItem Margin="0,-6,0,3" x:Name="PART_MinimizeRibbon" IsCheckable="True"/>
                            </local:RibbonMenuGroup >
                        </local:RibbonDropDown>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:QuickAccessToolBar" x:Key="Office2010BlueQuickAccessToolBarStyle">
        <Setter Property="Height" Value="24"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:QuickAccessToolBar">
                    <Grid x:Name="PART_RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroFocusedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".55" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="OverFlowDisabledVisualElement"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="LayoutRoot" Height="24" Background="{TemplateBinding Background}">
                            <Grid.Resources>
                                <local:VisibilityInverter x:Key="PART_VisibilityInverter" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>                            
                            
                            <!-- Left Separartor -->
                            <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource SplitterBrush}"  Background="{StaticResource SplitterBrush1}" Height="19" VerticalAlignment="Center"  HorizontalAlignment="Left"  Width="2" Grid.Column="0" Visibility="{TemplateBinding SeperatorVisibility}"/>                          

                            <ItemsPresenter x:Name="Part_ItemsPresenter" Grid.Column="1" Margin="2,1,5,1" VerticalAlignment="Center" />

                           <!-- Right Separator -->
                            <Border Width="2" BorderThickness="0,0,1,0" BorderBrush="{StaticResource SplitterBrush}"  Background="{StaticResource SplitterBrush1}" HorizontalAlignment="Right" Grid.Column="1" Height="19" VerticalAlignment="Center"   Visibility="{TemplateBinding SeperatorVisibility}"></Border>                          

                            <Grid Grid.Column="3" x:Name="PART_NormalContainer" Visibility="{Binding OverFlowVisibility, Converter={StaticResource PART_VisibilityInverter}, RelativeSource={RelativeSource TemplatedParent}}" Width="13" Margin="2,2,0,1">
                                <local:QATDropDownControl x:Name="PART_QATDropDownControl" Style="{StaticResource QATDropDownControlKey}" QATButtonCaption="{TemplateBinding QATButtonCaption}" />
                            </Grid>
                            <Grid Grid.Column="3" Visibility="{TemplateBinding OverFlowVisibility}" x:Name="PART_OverFlowContainer" Width="15" Margin="2,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid Background="Transparent" x:Name="PART_OverFlowToggleButton">
                                    <Border x:Name="OverFlowBackground" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                        <Grid Background="{TemplateBinding Background}" Margin="1">                                            
                                            <Border x:Name="OverFlowBackgroundGradient" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Height="22" HorizontalAlignment="Center">
                                        <Path Data="M0.46875,6.0625 L0.46875,10.438004 L4.5625,8.0627766 z" Fill="#FF00156E" Height="5.376" Margin="0" Stretch="Fill" Stroke="#FF00156E" VerticalAlignment="Center" Width="3"/>
                                        <Path Data="M0.46875,6.0625 L0.46875,10.438004 L4.5625,8.0627766 z" Fill="#FF00156E" Height="5.376" Margin="2,0,0,0" Stretch="Fill" Stroke="#FF00156E" VerticalAlignment="Center" Width="3"/>
                                    </StackPanel>
                                    <Rectangle x:Name="OverFlowDisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" RadiusY="3" RadiusX="3"/>
                                    <Rectangle x:Name="OverFlowFocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" RadiusY="2" RadiusX="2" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                                </Grid>
                                <local:RibbonDropDown Grid.Row="1" x:Name="PART_OverflowRibbonDropDown">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" x:Name="PART_OverflowItemsControl" />
                                        <Grid x:Name="PART_OverFlowTopContainer" Width="15" Background="Transparent" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </local:RibbonDropDown>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2010BlueQuickAccessToolBarStyle}" TargetType="local:QuickAccessToolBar"/>
	
	</ResourceDictionary>