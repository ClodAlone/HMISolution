    <Style x:Key="Office2010BlueTaskBarItemStyle" TargetType="local:TaskBarItem">
        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsHeaderShown" Value="True"/>
        <Setter Property="HeaderHeight" Value="25"/>       
        <Setter Property="Theme" Value="Metro"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TaskBarItem">

                    <Grid x:Name="MainGrid"  >
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderGrid">
                                <Border x:Name="HeaderBorder" BorderBrush="{StaticResource MetroBorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{StaticResource MetroBackgroundBrush}" Padding="1">
                                    <controlsToolkit:DockPanel x:Name="Head" LastChildFill="False">
                                        <ToggleButton Style="{StaticResource ToggleButton}" controlsToolkit:DockPanel.Dock="Right"  x:Name="ExpanderButton" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsTabStop="False" />
                                        <ContentPresenter controlsToolkit:DockPanel.Dock="Left" x:Name="HeaderContent" Content="{TemplateBinding Header}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},  Path=HeaderTemplate}" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center"/>
                                    </controlsToolkit:DockPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="ContentGrid"   Background="{TemplateBinding Background}" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
                                <Border x:Name="ContentBorder" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="1"        
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter x:Name="TaskBarContent"  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ItemContentTemplate}">
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueTaskBarItemStyle}" TargetType="local:TaskBarItem"/>

    <Style x:Key="Office2010BlueTaskBarStyle" TargetType="local:TaskBar">
        <Setter Property="Foreground" Value="Red"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="local:TaskBar">
                    <Border x:Name="MainBorder"  BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                     Background="{TemplateBinding Background}">
                        <StackPanel  x:Name="MainGrid" Orientation="Horizontal">
                            <ItemsPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueTaskBarStyle}" TargetType="local:TaskBar">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Office2010BlueTaskBarItemStyle}"/>
    </Style>

</ResourceDictionary>
