    <!-- BackStage TabItem Style -->
    <Style  TargetType="local:BackstageTabItem">
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="Height" Value="37"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0 2"/>
        <Setter Property="Template">
            <Setter.Value >
                <ControlTemplate   TargetType="local:BackstageTabItem">
                    <Grid x:Name="layoutRoot" Background="#00000000">

                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonTabItemStates">

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="IsMouseOverEnabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="controlLabel" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hoverBorder" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="IsSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="controlLabel" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="selectedBorder" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hoverBorder" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="controlLabel" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0.5"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="hoverBorder" Visibility="Collapsed" Margin="0,0,1,0" Background="{TemplateBinding BackStageColor}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderBrush="{x:Null}" BorderThickness="0">
                            <!--<Border BorderBrush="#4C000000" BorderThickness="0,1" Background="#BFFFFFFF"/>-->
                        </Border>
                        <Border x:Name="selectedBorder" Visibility="Collapsed" Margin="0" Background="{TemplateBinding BackStageColor}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderBrush="#FF000463" BorderThickness="0">
                            <Grid HorizontalAlignment="Stretch" Margin="0" Width="Auto">
                                <!--<Border BorderBrush="#7F000000" BorderThickness="0,1">
                                    <Border.Background>
                                        <RadialGradientBrush RadiusY="1.193" Center="0.5,0.972" GradientOrigin="0.5,0.972" RadiusX="0.662">

                                            <GradientStop Color="#A5FFFFFF" Offset="0"/>
                                            <GradientStop Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>-->
                                <Path Fill="White" Stretch="Fill" Stroke="{x:Null}" StrokeThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="15" Height="27" Data="M1,0L0,1 1,2z" Margin="0,0,-1,0"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="controlLabel" HorizontalAlignment="Left" Foreground="{TemplateBinding  Foreground}"  Margin="12,0" VerticalAlignment="Center" Text="{TemplateBinding Header}" TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BackStage CommandButton Style -->
    <Style TargetType="local:BackStageCommandButton">
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Width" Value="130"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BackStageCommandButton">
                    <Grid Background="#00000000" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonTabItemStates">

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="IsMouseOverEnabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="controlLabel" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="iconImage" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.5"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="controlLabel" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0.5"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="border" Visibility="Collapsed" Background="{TemplateBinding BackStageColor}" BorderBrush="{TemplateBinding BackStageColor}"
                                BorderThickness="0">
                            <!--<Border Margin="0" BorderThickness="1" BorderBrush="#19000000" Background="#BFFFFFFF">
                                <Border BorderBrush="#7FFFFFFF" BorderThickness="1" CornerRadius="1" Background="#33FFFFFF"/>
                            </Border>-->
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="16,0,15,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image x:Name="iconImage" Source="{TemplateBinding Icon}" HorizontalAlignment="Left" Height="16" VerticalAlignment="Center"  Width="16" />
                            <TextBlock Text="{TemplateBinding Header}" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" TextTrimming="WordEllipsis" x:Name="controlLabel"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
	
      
