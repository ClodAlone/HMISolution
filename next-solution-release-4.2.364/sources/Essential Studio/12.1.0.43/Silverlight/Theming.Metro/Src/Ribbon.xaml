                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="DropDownStates">
                                <vsm:VisualState x:Name="DropDownNormal">
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="DropDownSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonDropDownToggleButtonHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="DropDownPressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource  MetroBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_DropDownText" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource  MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_ItemArrow" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource  MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="Border" Margin="1,2,1,2"  Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="Part_ExpandedHost">
                                    <Border>
                                        <Grid x:Name="Part_RibbonBarStrip">
                                            <Grid.Resources>
                                                <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverterKey" />
                                            </Grid.Resources>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="68"></RowDefinition>
                                                
                                                <RowDefinition Height="15"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Border  Grid.Row="0" >
                                                <ItemsPresenter Margin="1"/>
                                            </Border>

                                            <StackPanel Grid.RowSpan="2" Orientation="Horizontal">
                                           		<Line Width="1" X1="1" Y2="1" Y1="87" Visibility="{TemplateBinding BarSeperatorVisibility}" Stroke="{StaticResource MetroBorderBrush}" >												
												</Line>
                                               
                                            </StackPanel>

                                            <Grid Grid.Row="2" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="Part_Text" Text="{TemplateBinding Header}"  VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                <local:RibbonButton x:Name="Part_LauncherButton" Style="{StaticResource RibbonBarLauncherButton}" Width="15" Height="15"
                                                                    Visibility="{Binding IsLauncherButtonVisible,Converter={StaticResource BooleanToVisibilityConverterKey},RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Command="{TemplateBinding LauncherCommand}" SizeMode="Small" Grid.Column="1" />
                                            </Grid>

                                        </Grid>
                                    </Border>
                                </ContentPresenter>

                                <Grid x:Name="Part_DropDown" Margin="0,4,0,0" Visibility="Collapsed" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto"  />
                                        <RowDefinition Height="*"  />
                                    </Grid.RowDefinitions>

                          
                                      <Line  Grid.RowSpan="3" HorizontalAlignment="Right"  VerticalAlignment="Stretch"  Width="1" X1="1" Y2="1" Y1="80"  Stroke="{StaticResource MetroBorderBrush}" >
												
												</Line>

                                    <Border Grid.Row="0" x:Name="Part_BorderImage" BorderBrush="{StaticResource MetroBorderBrush}"  BorderThickness="1" Margin="3,0,3,0" CornerRadius="3"  HorizontalAlignment="Center">
                                        <Grid MinWidth="31" MinHeight="31">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{TemplateBinding CollapseImage}" Stretch="None" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="PART_DropDownText" Grid.Row="1" Text="{TemplateBinding Header}" Margin="3,0,3,0"  HorizontalAlignment="Center" />
                                    <Path Grid.Row="2" x:Name="Part_ItemArrow" Fill="{StaticResource MetroForegroundBrush}" Data="M 0 0 L 4 4 L 8 0 Z"  Height="3" Width="6" HorizontalAlignment="Center" Stretch="Uniform"  VerticalAlignment="Top" />
                                    <Popup x:Name="Part_Popup" Margin="-1,1,0,0" VerticalAlignment="Bottom" Grid.Row="2">
                                        <Canvas>
                                            <Rectangle x:Name="Part_OutsideRect" />
                                            <Grid x:Name="Part_PopupContent">
                                                <local:RibbonShadow  Margin="4,4,0,0" />
                                                <Border CornerRadius="3" Background="{StaticResource  MetroBackgroundBrush}" BorderThickness="1" BorderBrush="{StaticResource MetroBorderBrush}">
                                                    <ContentPresenter x:Name="Part_CollapsedHost"/>
                                                </Border>
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

