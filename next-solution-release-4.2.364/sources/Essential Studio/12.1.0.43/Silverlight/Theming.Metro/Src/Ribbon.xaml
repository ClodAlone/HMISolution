    <!--RibbonDropDown-->
    <Style TargetType="local:RibbonDropDown">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonDropDown">
                    <Popup x:Name="Part_Popup" VerticalOffset="{TemplateBinding VerticalOffset}" HorizontalOffset="{TemplateBinding HorizontalOffset}">
                        <Canvas>
                            <Rectangle x:Name="Part_OutsideRect"/>
