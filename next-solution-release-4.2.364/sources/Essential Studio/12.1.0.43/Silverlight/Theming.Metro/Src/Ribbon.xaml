                                    <Border Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}" CornerRadius="1">
                                        <ContentPresenter/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonMenu-->
    <Style TargetType="local:RibbonMenu">
        <Setter Property="Background" Value="{StaticResource RibbonBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonMenu">
                    <Popup x:Name="Part_Popup" >
                        <Canvas x:Name="Part_Root">
                            <Canvas.Resources>
                                <Style x:Key="ItemsPaneStyle" TargetType="local:RibbonItemsControl">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="local:RibbonItemsControl">
                                                <Grid Background="{TemplateBinding Background}">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
