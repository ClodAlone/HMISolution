    <Style TargetType="local:TabButton" x:Key="Syncfusion.Windows.Tools.Controls.TabButton">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>           
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="23"/>
        <Setter Property="SeparatorOpacity" Value="0"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabButton">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>
                            
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="MouseOver" GeneratedDuration="0:0:0.0"/>
                                    <vsm:VisualTransition From="Selected" GeneratedDuration="0:0:0.0"/>
                                    <vsm:VisualTransition From="SelectedMouseOver" GeneratedDuration="0:0:0.0"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal"/>

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard >
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFF5F5F5" />
