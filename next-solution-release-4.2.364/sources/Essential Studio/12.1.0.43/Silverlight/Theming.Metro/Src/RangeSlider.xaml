    <!-- Styles -->

    <ControlTemplate x:Key="RangeSliderRepeatButtonTemplate1" TargetType="RepeatButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <Storyboard>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Opacity" To="1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="MouseOver">
                        <Storyboard>

                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Stroke">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF838383"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="contentPresenter" Storyboard.TargetProperty="Foreground">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFC6C6C6"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Stroke">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFADADAD"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">

                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused"/>
                    <VisualState x:Name="Unfocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid Margin="1">
                <Path x:Name="BackgroundGradient" Width="16" Height="16" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Stroke="#FFC1C1C1" Fill="White" StrokeLineJoin="Round" Data="F1 M 1040.29,64.2751C 1044.93,64.2751 1048.68,68.031 1048.68,72.664C 1048.68,77.2971 1044.93,81.0529 1040.29,81.0529C 1035.66,81.0529 1031.9,77.2971 1031.9,72.664C 1031.9,68.031 1035.66,64.2751 1040.29,64.2751 Z "/>
            </Grid>
            <ContentControl 
                              x:Name="contentPresenter"
                              Content="3" FontFamily="Webdings"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="{TemplateBinding Padding}" Foreground="#FF6F6F6F"
                                 />
            <Rectangle x:Name="DisabledVisualElement" RadiusX="3" RadiusY="3" Fill="{StaticResource DisabledBackgroundBrushKey}" Opacity="0" IsHitTestVisible="false" />
            <Rectangle x:Name="FocusVisualElement" RadiusX="2" RadiusY="2" Margin="1" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
        </Grid>
    </ControlTemplate>

