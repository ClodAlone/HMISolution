                </Grid.ColumnDefinitions>
                <Rectangle x:Name="Background" Width="5" Height="20" Fill="Black" Stroke="Black" Grid.Column="0"/>
                <Rectangle x:Name="OuterBorder" Width="3" Height="20" Fill="White" Stroke="White" Grid.Column="1"/>
            </Grid>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="RangeSliderHorizontalThumbTemplateKey1" TargetType="Thumb">
        <Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
