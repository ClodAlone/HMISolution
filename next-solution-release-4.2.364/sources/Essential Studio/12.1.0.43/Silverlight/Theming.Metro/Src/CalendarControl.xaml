<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>

    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
    <FontFamily x:Key="MetroFontFamily">Segoe WP</FontFamily>
    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>



    <SolidColorBrush x:Key="CalendarControlBackgroundBrushKey" Color="#FF2C3D5A" />

    <SolidColorBrush x:Key="CalendarControlBorderBrushKey" Color="#FF2C3D5A" />

    <SolidColorBrush x:Key="TextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="CalendarControlHeaderTextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="ScrollButtonFillKey" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="MouseHoverScrollButtonFillKey" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="MouseHoverHeaderBackgroundKey" Color="#FFFFFF00"/>
  
    <LinearGradientBrush x:Key="MouseHoverCellBackgroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6F7776" Offset="0.044"/>
        <GradientStop Color="#FF546375" Offset="0.805"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MouseHoverCellBorderBrushKey" Color="#FF9BA7B7" />

    <SolidColorBrush x:Key="MouseHoverCellForegroundKey" Color="#FFFFFFFF" />
  
    <LinearGradientBrush x:Key="SelectedCellBackgroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF2" Offset="0.028"/>
        <GradientStop Color="#FFFFF3CF" Offset="0.442"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.456"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.986"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SelectedCellBorderBrushKey" Color="#FF000000"/>
    
    <SolidColorBrush x:Key="SelectedCellForegroundKey" Color="#FF000000"/>

    <LinearGradientBrush x:Key="NextMonthDaysForegroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4D6082" Offset="0.045"/>
        <GradientStop Color="#FF3D5277" Offset="0.955"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PreviousMonthDaysForegroundKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4D6082" Offset="0.045"/>
        <GradientStop Color="#FF3D5277" Offset="0.955"/>
    </LinearGradientBrush>  

    <Style x:Key="MetroCalendarStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="DayForeground" Value="{StaticResource MetroBrush}"/>
        <Setter Property="DateForeground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource MetroForegroundBrush}"/>
        
        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>       
        <Setter Property="MouseHoverCellBackground" Value="{StaticResource MetroHoverBrush}"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="{StaticResource MetroHoverBrush}"/>
        <Setter Property="MouseHoverCellForeground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="MouseHoverCellCornerRadius" Value="0"/>
        <Setter Property="NextMonthDaysForeground" Value="#FFA3ABB5"/>
        <Setter Property="PreviousMonthDaysForeground" Value="#FFA3ABB5"/>
        <Setter Property="SelectedCellBackground" Value="{StaticResource MetroHoverBrush}"/>
        <Setter Property="SelectedCellBorderBrush" Value="{StaticResource MetroBrush}"/>
        
        
        <Setter Property="SelectedCellCornerRadius" Value="0"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CalendarControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="RootElement" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="25" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="25" />

                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,-2,0" Background="{TemplateBinding HeaderBackground}" Grid.Column="0" Grid.Row="0">
                                <Grid>
<Ellipse x:Name="circle"
                                     Width="19"
                                     Height="19"
                                     Stroke="#FFC1C1C1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="white"/>
                                <Polygon x:Name="Previous" Margin="0,-2,0,0" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Points="-1,8 5,3 5,13 -1,8" Fill="{TemplateBinding ScrollButtonFill}" StrokeThickness="1"/>
                                </Grid>
                            </Border>
                            <Border Background="{TemplateBinding HeaderBackground}" Grid.Column="1" Grid.Row="0">
                                <TextBlock x:Name="MonthText" Grid.Column="1" Foreground="{TemplateBinding HeaderForeground}" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            </Border>
                            <Border Margin="-2,0,-2,0" Background="{TemplateBinding HeaderBackground}" Grid.Column="2" Grid.Row="0">
                                <Grid>
                                    <Ellipse x:Name="circle1"
                                     Width="19"
                                     Height="19"
                                     Stroke="#FFC1C1C1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="White"/>
                           
                                <Polygon x:Name="Next" Grid.Column="2" Margin="0,0,3,2" Grid.Row="0" HorizontalAlignment="Center"  Points="9,9 3,3 3,13 9,9" VerticalAlignment="Center" Fill="{TemplateBinding ScrollButtonFill}" StrokeThickness="1"/>
                                </Grid>
                            </Border>
                            <Grid x:Name="weekGrid" Grid.Column="0" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Grid x:Name="DateGrid" ShowGridLines="True" Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="1">
                            </Grid>
                            <StackPanel Margin="2" Grid.ColumnSpan="3" Background="{TemplateBinding HeaderBackground}" Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                                <TextBlock x:Name="TodayDatebtn"  Grid.Column="0" Grid.Row="2" Text="  Today: " Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                                <TextBlock x:Name="TodayDate" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource MetroCalendarStyle}"/>
</ResourceDictionary>
