<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"  >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MSControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--New-->
    <SolidColorBrush x:Key="CheckListBoxBackgroundBrushKey" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="CheckListBoxBorderBrushKey" Color="#7F000000"/>
    <SolidColorBrush x:Key="SidePanelBrush" Color="White" Opacity="0.8"/>
    <LinearGradientBrush x:Key="CheckListBoxItemMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#99FAFAFA" Offset="0"/>
        <GradientStop Color="#99FFFFFF" Offset="0.491"/>
        <GradientStop Color="#99E2E2E2" Offset="0.531"/>
        <GradientStop Color="#99B6B6B6" Offset="0.789"/>
        <GradientStop Color="#99D5D5D5" Offset="0.996"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key ="CheckListBoxItemMouseOverBorderBrushKey" Color="#7F000000"/>
    <LinearGradientBrush x:Key="CheckListBoxItemPressedBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#99FAFAFA" Offset="0"/>
        <GradientStop Color="#99FFFFFF" Offset="0.491"/>
        <GradientStop Color="#99E2E2E2" Offset="0.531"/>
        <GradientStop Color="#99B6B6B6" Offset="0.789"/>
        <GradientStop Color="#99D5D5D5" Offset="0.996"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key ="CheckListBoxItemPressedBorderBrushKey" Color="#7F000000"/>
    <LinearGradientBrush x:Key="CheckBoxBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.5">
        <GradientStop Color="#FFE6E6E6" Offset="0"/>
        <GradientStop Color="#FFFCFCFC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CheckBoxBorderBrushKey" Color="#FF333333" Opacity=".5"/>
    <SolidColorBrush x:Key="CheckBoxIconBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="ContextMenuSeparatorBrush" Color="#FF434343" Opacity="0.495" />
    <SolidColorBrush x:Key="TextBrushKey" Color="#FF000000"/>
    <SolidColorBrush Color="#CCFFFFFF" x:Key="InnerBorderBrush"/>        
    
    <Style x:Key="TransparentCheckedListBoxItemStyle" TargetType="local:CheckedListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBoxItem">
                    <Grid  Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="fillColor" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                        <DoubleAnimation Storyboard.TargetName="innerborder" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="fillColor2" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                        <DoubleAnimation Storyboard.TargetName="fillColor" Storyboard.TargetProperty="Opacity" Duration="0" To="0"/>
                                        <DoubleAnimation Storyboard.TargetName="innerborder" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="fillColor2" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                        <DoubleAnimation Storyboard.TargetName="fillColor" Storyboard.TargetProperty="Opacity" Duration="0" To="0"/>
                                        <DoubleAnimation Storyboard.TargetName="innerborder" Storyboard.TargetProperty="Opacity" Duration="0" To="1"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="fillColor" Opacity="0" Fill="{StaticResource CheckListBoxItemMouseOverBrushKey}" Stroke="{StaticResource CheckListBoxItemMouseOverBorderBrushKey}" StrokeThickness="1" IsHitTestVisible="False"/>
                        <Rectangle x:Name="innerborder" Opacity="0"  Margin="1" Stroke="{StaticResource InnerBorderBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
                        <Rectangle x:Name="fillColor2" Opacity="0" Fill="{StaticResource CheckListBoxItemPressedBrushKey}" Stroke="{StaticResource CheckListBoxItemPressedBorderBrushKey}" IsHitTestVisible="False"/>
                        <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent">
                            <Grid x:Name="PART_Grid" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PART_Grid1" Grid.Column="0">
                                    <CheckBox   x:Name="PART_CheckBox"  IsChecked ="{TemplateBinding IsChecked}"  VerticalAlignment="Center" HorizontalAlignment="Left"    />
                                    <RadioButton x:Name="PART_Radio" GroupName="RadioButton"  IsChecked ="{TemplateBinding IsChecked}"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                                <Image Grid.Column="1" 
                                       x:Name="LeftImage" 
                                       Source="{TemplateBinding LeftImageSource}"
                                       MaxWidth="{TemplateBinding LeftImageWidth}"
                                       MaxHeight="{TemplateBinding LeftImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                <ContentControl x:Name="PART_Content" Grid.Column="2" Margin="2"  Content="{TemplateBinding Content}">
                                    <ContentControl.Effect>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35"/>
                                    </ContentControl.Effect>
                                </ContentControl>
                                <Image Grid.Row="0" Grid.Column="3" 
                                       x:Name="RightImage" 
                                       Source="{TemplateBinding RightImageSource}"
                                       MaxWidth="{TemplateBinding RightImageWidth}"
                                       MaxHeight="{TemplateBinding RightImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CheckedListBoxItem" BasedOn="{StaticResource TransparentCheckedListBoxItemStyle}"/>

    <Style x:Key="TransparentCheckedListBoxStyle" TargetType="local:CheckedListBox" >
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CheckListBoxBackgroundBrushKey}" />
        <Setter Property="BorderBrush" Value="{StaticResource CheckListBoxBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBox">                    
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <Border x:Name="InnerBorder" BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="outerScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="1" BorderBrush="Transparent" BorderThickness="0">
                                <ItemsPresenter x:Name="PART_ItemsHost"/>
                            </ScrollViewer>
                        </Border>
                    </Border>                   
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CheckedListBox" BasedOn="{StaticResource TransparentCheckedListBoxStyle}"/>

</ResourceDictionary>
