    <ControlTemplate x:Key="RangeSliderRepeatButtonTemplate1" TargetType="RepeatButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        
                    </VisualState>
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RepeatButtonMouseOverBrush}"/>
                            </ObjectAnimationUsingKeyFrames>
                           
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RepeatButtonPressedBrush}"/>
                            </ObjectAnimationUsingKeyFrames>
                        
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">

                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused"/>
                    <VisualState x:Name="Unfocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid Margin="1">

                <Border x:Name="Background" CornerRadius="8" Opacity="1" Background="{StaticResource RepeatButtonBackground}"  BorderThickness="1" BorderBrush="{StaticResource RepeatButtonBorder}">
                    <Border CornerRadius="8"  BorderThickness="1" BorderBrush="{StaticResource InnerBorderBrush}"></Border>
                </Border>
            </Grid>
            <ContentControl 
                              x:Name="contentPresenter"
                              Content="3" FontFamily="Webdings"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" FontSize="12"
                              HorizontalAlignment="Center"
                              Margin="{TemplateBinding Padding}" Foreground="Black"
                                 >
                <ContentControl.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="White"/>
                </ContentControl.Effect>
            </ContentControl>
            <Rectangle x:Name="DisabledVisualElement" RadiusX="3" RadiusY="3" Fill="{StaticResource DisabledBackgroundBrushKey}" Opacity="0" IsHitTestVisible="false" />
            <Rectangle x:Name="FocusVisualElement" RadiusX="2" RadiusY="2" Margin="1" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
        </Grid>
    </ControlTemplate>

