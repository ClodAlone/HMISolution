                                                        <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="UncheckedVisual" />
                                                        <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="UncheckedVisual" />
                                                        <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="CheckedVisual" />
