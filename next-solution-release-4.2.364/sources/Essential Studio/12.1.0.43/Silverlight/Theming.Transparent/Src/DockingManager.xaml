    <Style TargetType="windows:SideButton" x:Key="TransparentSideButtonStyle">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="Trebuchet MS" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="windows:SideButton">
                    <Grid >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualState x:Name="Focused"/>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Disabled"/>
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentSideButtonSelectedBackground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentSideButtonSelectedBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">                                 
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border Name="PART_Border" CornerRadius="6,6,0,0" BorderBrush="{StaticResource TransparentSideButtonBorderBrush}" BorderThickness="1" Background="{StaticResource TransparentSideButtonBackground}">
                            <Border x:Name="InnerBorder" BorderBrush="{StaticResource TransparentInnerBorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0">
                                <StackPanel Orientation="Horizontal">
                              <Border Name="Icon"	Margin="4,2,2,2" Height="18" Width="18"	Background="{TemplateBinding Icon}" />
                                <Border Width="2" Height="2"/>
                                    <TextBlock Text="{TemplateBinding Content}"	Foreground="Black" Margin="5,2,2,2"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>   

    <Style x:Key="TransparentAwlButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
