                            <Border Background="Transparent" BorderThickness="1" Width="17" Height="15" BorderBrush="Transparent"  Margin="0" x:Name="rectangle" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1" Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
