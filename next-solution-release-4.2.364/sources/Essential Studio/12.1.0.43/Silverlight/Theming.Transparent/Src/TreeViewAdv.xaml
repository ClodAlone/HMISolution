<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">
  

    <LinearGradientBrush x:Key="TransparentHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#66FAFAFA" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.491"/>
        <GradientStop Color="#66C8C8C8" Offset="0.531"/>
        <GradientStop Color="#66B6B6B6" Offset="0.789"/>
        <GradientStop Color="#66D5D5D5" Offset="0.996"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentHoverInnerBorderBrush" Color="#CCFFFFFF"/>

    <SolidColorBrush x:Key="TransparentHoverBorderBrush" Color="#7F505050"/>

    <SolidColorBrush x:Key="TransparentHoverForeground" Color="#FF000000"/>

    <LinearGradientBrush x:Key="TransparentSelectedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#4C767676" Offset="1"/>
        <GradientStop Color="#4CFEFEFE" Offset="0.957"/>
        <GradientStop Color="#4CB6B6B6" Offset="0.619"/>
        <GradientStop Color="#4C9B9B9B" Offset="0.474"/>
        <GradientStop Color="#4CFFFFFF"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="TransparentSelectedUnfocussedBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.5">
        <GradientStop Color="#FF767676" Offset="1"/>
        <GradientStop Color="#FFFEFEFE" Offset="0.957"/>
        <GradientStop Color="#FF979797" Offset="0.914"/>
        <GradientStop Color="#FF9B9B9B" Offset="0.708"/>
        <GradientStop Color="#FFFEFEFE" Offset="0.369"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentSelectedBorderBrush" Color="#7F000000"/>

    <SolidColorBrush x:Key="TransparentSelectedForeground" Color="#FF000000"/>

    <SolidColorBrush x:Key="TransparentDragMarkerBackground" Color="#FF0092EF"/>

    <SolidColorBrush x:Key="TransparentDragMarkerColumnHeaderBaackground" Color="#FF0092EF"/>

    <SolidColorBrush x:Key="TransparentColumnHeaderBackground" Color="#7FFFFFFF"/>

    <LinearGradientBrush x:Key="TreeViewColumnHeaderHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="LineBrush" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.5">
        <GradientStop Color="#FF767676" Offset="1"/>
        <GradientStop Color="#FFFEFEFE" Offset="0.957"/>
        <GradientStop Color="#FFB6B6B6" Offset="0.619"/>
        <GradientStop Color="#FF9B9B9B" Offset="0.474"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewColumnHeaderThumbBackground" Color="#7F000000"/>

    <LinearGradientBrush x:Key="TreeViewColumnHeaderPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF"/>
        <GradientStop Color="#7EFFFFFF" Offset="0.032"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.649"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewAdvForeground" Color="#FF000000"/>

    <LinearGradientBrush x:Key="TreeViewAdvBackground"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FBEBEBE" Offset="1"/>
        <GradientStop Color="#99FFFFFF"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewAdvBorderBrush" Color="#99000000"/>
 
    <SolidColorBrush x:Key="TreeViewItemAdvForeground" Color="#FF000000"/>

    <SolidColorBrush x:Key="TreeViewItemBackgroundBrushKey" Color="Transparent"/>   
    
    <SolidColorBrush x:Key="TreeViewItemAdvNormalBorderBrushKey" Color="Transparent"/>       

    <SolidColorBrush x:Key="TransparentSelectedUnfocussedBorderBrush" Color="#FF000000" Opacity="0.5"/>   
  
    <SolidColorBrush x:Key="TreeViewItemAdvNormalBackgroundBrushKey" Color="Transparent"/>

    <SolidColorBrush x:Key="TreeViewExpanderBackground" Color="#FF787878" Opacity="0.705"/>

    <SolidColorBrush x:Key="TreeViewExpanderBorderBrush" Color="#FF2B2B2B" Opacity="0.705"/>

    <SolidColorBrush x:Key="TreeViewExpanderHoverBackground" Color="#FF585858" Opacity="0.7"/>

    <SolidColorBrush x:Key="TreeViewExpanderHoverBorderBrush" Color="#FF000000" Opacity="0.7"/>
    
    <SolidColorBrush x:Key="TreeViewExpanderCheckedBackground" Color="#FF000000" Opacity="0.7"/>
    
    <SolidColorBrush x:Key="TreeViewExpanderCheckedBorderBrush" Color="#FF000000" Opacity="0.7"/>

    <SolidColorBrush x:Key="DragLineColor" Color="#FF0092EF"/>
    
    <ControlTemplate x:Key="TreeViewItemAdvExpanderButtonStyle"  TargetType="ToggleButton">
        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5"  Height="Auto" Width="Auto">
            <vsm:VisualStateManager.VisualStateGroups>

                <vsm:VisualStateGroup x:Name="CommonStates">
                    <vsm:VisualState x:Name="Normal">
                        <Storyboard>
                        <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="UncheckedVisual" />
                        <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="UncheckedVisual" />
                            <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="CheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="CheckedVisual" />
                        </Storyboard>
                    </vsm:VisualState>
                    <vsm:VisualState x:Name="Disabled">
                    </vsm:VisualState>
                    <vsm:VisualState x:Name="MouseOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Fill">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TreeViewExpanderHoverBackground}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Stroke">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TreeViewExpanderHoverBorderBrush}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Fill">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TreeViewExpanderHoverBackground}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Stroke">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TreeViewExpanderHoverBorderBrush}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ColorAnimation Duration="0" To="#FF00E8FF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="UncheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="UncheckedVisual" />
                            <ColorAnimation Duration="0" To="#FF00E8FF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="CheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="CheckedVisual" />
                        </Storyboard>
                    </vsm:VisualState>
                </vsm:VisualStateGroup>
               
                <vsm:VisualStateGroup x:Name="CheckStates">
                    <vsm:VisualState x:Name="Unchecked">
                        <Storyboard>
                            <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="UncheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="UncheckedVisual" />
                            <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="CheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="CheckedVisual" />
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                        </Storyboard>
                    </vsm:VisualState>
                    <vsm:VisualState x:Name="Checked">
                        <Storyboard>
                            <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="UncheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="UncheckedVisual" />
                            <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" Storyboard.TargetName="CheckedVisual" />
                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)" Storyboard.TargetName="CheckedVisual" />
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                        </Storyboard>
                    </vsm:VisualState>
                </vsm:VisualStateGroup>

            </vsm:VisualStateManager.VisualStateGroups>
            <Path x:Name="UncheckedVisual" Stroke="{StaticResource TreeViewExpanderBorderBrush}" Fill="{StaticResource TreeViewExpanderBackground}" Margin="0,-1,0,0" Width="6" Height="8" Stretch="Fill" Data="F1 M 492.891,338.23L 492.9,334.35L 492.909,330.471L 495.488,332.417L 498.066,334.362L 495.479,336.296L 492.891,338.23 Z " StrokeThickness="0.5" StrokeMiterLimit="2.75">
                <Path.Effect>
                    <DropShadowEffect/>
                </Path.Effect>
            </Path>
            <Path x:Name="CheckedVisual" Stroke="{StaticResource TreeViewExpanderCheckedBorderBrush}" Fill="{StaticResource TreeViewExpanderCheckedBackground}"  Margin="0,-1,0,0" Width="7" Height="7" Stretch="Fill" Data="F1 M 488.338,322.896L 488.338,322.901L 495.647,322.901L 495.647,315.592L 495.644,315.592L 488.338,322.896 Z " StrokeThickness="0.5" StrokeMiterLimit="2.75">
                <Path.Effect>
                    <DropShadowEffect/>
                </Path.Effect>
            </Path>
        </Grid>
    </ControlTemplate>

    <!-- TreeViewItemAdv Template-->
    <Style x:Key="TransparentTreeViewItemAdvStyle" TargetType="local:TreeViewItemAdv">
        <Setter Property="Background" Value="{StaticResource TreeViewItemBackgroundBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TreeViewItemAdvForeground}"/>
        <Setter Property="ExpanderTemplate" Value="{StaticResource TreeViewItemAdvExpanderButtonStyle}"/>        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TreeViewItemAdv">
                    <Grid x:Name="LayoutRoot" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- VSM for TreeViewItemAdv-->
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" >
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="UnFocusedSelection">
                                    <!--<Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeunfocusedselection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeunfocusedselection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>-->
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="SelectedMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeselctionmouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeselctionmouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>


                                <vsm:VisualState x:Name="MultiSelect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="DeSelect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                              
                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unselected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="ItemStates">
                                <vsm:VisualState x:Name="Expanded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CollapsedIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Collapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CollapsedIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="SourceStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition GeneratedDuration="00:00:00.2000000" To="HasItems"/>
                                    <vsm:VisualTransition GeneratedDuration="00:00:00.2000000" To="NoItems"/>
                                </vsm:VisualStateGroup.Transitions>
                                <vsm:VisualState x:Name="HasItems">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Expander" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="NoItems">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Expander" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Loading">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Expander" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingContentPresenter" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" 
                                                                       Storyboard.TargetName="path">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="360"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid x:Name="PART_Header" Margin="{TemplateBinding HeaderMargin}" Canvas.ZIndex="999">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="ExpandCollapseZone"   Grid.Column="0" Grid.Row="1" 
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Line X1="0" X2="25" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"  Y1="0" Y2="0" x:Name="HorizontalRootLine" Margin="11,0,0,0" 
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" StrokeThickness="1" 
                                    StrokeDashArray="{TemplateBinding LineStrokeArray}" Stroke="{TemplateBinding RootLineStroke}" 
                                    Visibility="{TemplateBinding HorizontalLineVisibility}"></Line>

                                <Rectangle Width="1" x:Name="VerticalRootLine1"
                                HorizontalAlignment="Center"   StrokeThickness="0.5" StrokeDashArray="{TemplateBinding LineStrokeArray}" 
                                       Stroke="{TemplateBinding RootLineStroke}" Visibility="{TemplateBinding VerticalRootLine1Visibility}" ></Rectangle>

                                <ToggleButton x:Name="Expander"   Grid.RowSpan="2"
                                      IsChecked="{TemplateBinding IsExpanded}"  
                                      Opacity="0" IsThreeState="False"  Width="12" Height="12"
                                      Template="{TemplateBinding ExpanderTemplate}" Visibility="Visible">
                                </ToggleButton>
                                <Ellipse x:Name="path" StrokeThickness="2.5" Fill="#FFDDECFE" Stretch="Fill" Grid.RowSpan="2" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Width="16" Height="16" Visibility="Collapsed">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-180"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>                                   
                                        <Ellipse.Stroke>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#FFE5E5E5"/>
                                            <GradientStop Color="#FF2B8EAD" Offset="0.559"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>                                 
                                </Ellipse>
                            </Grid>

                            <Border x:Name="HeaderBorder" Grid.Row="1" Grid.Column="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid  Grid.Row="0" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                            <Image Margin="2,0,0,0"  x:Name="ExpandIconPart"  Source="{TemplateBinding  ExpandImageSource}" HorizontalAlignment="Left"
                                                       Width="{TemplateBinding ExpandImageWidth}" Height="{TemplateBinding ExpandImageHeight}" ></Image>
                                            <Image Margin="2,0,0,0"  x:Name="CollapsedIconPart"   Source="{TemplateBinding CollapseImageSource}"
                                                      Width="{TemplateBinding CollapseImageWidth}" Height="{TemplateBinding CollapseImageHeight}"></Image>
                                            <Image x:Name="LeftImage" Source="{TemplateBinding LeftImageSource}" MaxWidth="{TemplateBinding LeftImageWidth}"
                                                MaxHeight="{TemplateBinding LeftImageHeight}" Margin="{TemplateBinding ImageMargin}"
                                                HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}" VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1"  x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding TextVerticalAlignment}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" Margin="{TemplateBinding TextMargin}">
                                            <TextBox x:Name="TextBox" Visibility="Collapsed" HorizontalAlignment="Center"  VerticalAlignment="Bottom" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}"  FontFamily="{TemplateBinding FontFamily}"/>                                            
                                            <Border VerticalAlignment="Stretch" >
                                                <Grid>
                                                    <ContentPresenter x:Name="ContentPresenter" Margin="4,1,4,1"  VerticalAlignment="{TemplateBinding TextVerticalAlignment}" HorizontalAlignment="Left" Content="{TemplateBinding Header}"  ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                                    <ContentPresenter x:Name="LoadingContentPresenter" Margin="4,2,4,1"  VerticalAlignment="{TemplateBinding TextVerticalAlignment}" HorizontalAlignment="Left" Content="{TemplateBinding LoadingHeader}" ContentTemplate="{TemplateBinding LoadingHeaderTemplate}" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>                                        
                                        </StackPanel>
                                        
                                        <Image Grid.Row="0" Grid.Column="2" x:Name="RightImage" Source="{TemplateBinding RightImageSource}" MaxWidth="{TemplateBinding RightImageWidth}" MaxHeight="{TemplateBinding RightImageHeight}"
                                                Margin="{TemplateBinding ImageMargin}" HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}" VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                    </Grid>
                                </Grid>
                            </Border>                          
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Opacity="0" Grid.Row="1"/>
                        <Border x:Name="nodemouseover"  VerticalAlignment="Top" BorderThickness="1" CornerRadius="0" BorderBrush="{StaticResource TransparentHoverBorderBrush}" Background="{StaticResource TransparentHoverBackground}" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left">
                            <Border x:Name="nodeInnerMouseOver" BorderBrush="{StaticResource TransparentHoverInnerBorderBrush}" BorderThickness="1"/>
                        </Border>
                        <Border x:Name="multiSelection"  BorderThickness="1" Visibility="Collapsed" Opacity="0" VerticalAlignment="Top"  HorizontalAlignment="Left"/>
                        <Border x:Name="nodeunfocusedselection"  VerticalAlignment="Top" BorderThickness="1" CornerRadius="0" BorderBrush="{StaticResource TransparentSelectedUnfocussedBorderBrush}" Background="{StaticResource TransparentSelectedUnfocussedBackground}" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left">
                            <!--<Border BorderBrush="{StaticResource TransparentHoverInnerBorderBrush}" BorderThickness="1"/>-->
                        </Border>
                        <Border x:Name="normal"  VerticalAlignment="Top" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"/>
                        <Border x:Name="nodeSelection"  VerticalAlignment="Top" BorderThickness="1" CornerRadius="0" BorderBrush="{StaticResource TransparentSelectedBorderBrush}" Background="{StaticResource TransparentSelectedBackground}" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left">
                            <Border x:Name="nodeSelectionInnerMouseOver" BorderBrush="{StaticResource TransparentHoverInnerBorderBrush}" BorderThickness="1"/>
                        </Border>
                        <Border x:Name="nodeselctionmouseover"  VerticalAlignment="Top" BorderThickness="1" CornerRadius="0" BorderBrush="{StaticResource TransparentSelectedBorderBrush}" Background="{StaticResource TransparentSelectedBorderBrush}" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"/>
                        <Grid Grid.RowSpan="2" Margin="{TemplateBinding HeaderMargin}" Width="22" HorizontalAlignment="Left">
                            <Rectangle x:Name="VerticalRootLine2" Width="1" HorizontalAlignment="Center" StrokeThickness="0.5" StrokeDashArray="{TemplateBinding LineStrokeArray}" Stroke="{TemplateBinding RootLineStroke}" Visibility="{TemplateBinding VerticalRootLine2Visibility}" Margin="{TemplateBinding RootLineMargin}"/>
                            <Rectangle Width="1" x:Name="VerticalRootLine3" VerticalAlignment="Bottom" HorizontalAlignment="Center"   StrokeThickness="0.5" StrokeDashArray="{TemplateBinding LineStrokeArray}" Stroke="{TemplateBinding RootLineStroke}" Visibility="{TemplateBinding VerticalRootLine3Visibility}" Height="{TemplateBinding VerticalLine3Height}"></Rectangle>
                        </Grid>
                        <Rectangle Height="1.5" Width="Auto"  Grid.Row="2" Grid.ColumnSpan="4" Margin="8,0,0,0" StrokeThickness="1.5"  Stroke="{TemplateBinding DragLineColor}" Visibility="{TemplateBinding DragLineVisibility}"></Rectangle>
                    </Grid>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>   
    <Style BasedOn="{StaticResource TransparentTreeViewItemAdvStyle}" TargetType="local:TreeViewItemAdv"/>

    <Style x:Key="TransparentTreeViewAdvStyle" TargetType="local:TreeViewAdv">
        <Setter Property="RootLineVisibility" Value="Collapsed"/>
        <Setter Property="FullRowSelect" Value="False"/>
        <Setter Property="Background" Value="{StaticResource TreeViewAdvBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TreeViewAdvBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ExpanderTemplate" Value="{StaticResource TreeViewItemAdvExpanderButtonStyle}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TransparentTreeViewItemAdvStyle}"/>
        <Setter Property="DragLineColor" Value="{StaticResource DragLineColor}"/>
        <Setter Property="FullRowSelect" Value="True"/>
        <Setter Property="Theme" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid x:Name="LayoutRoot" >
                        <ScrollViewer x:Name="ScrollViewer"
                                              VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Auto"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              Background="{TemplateBinding Background}" Padding="0"
                                              BorderThickness="{TemplateBinding BorderThickness}">
                            <Border x:Name="InnerBorder" BorderBrush="{StaticResource TransparentHoverInnerBorderBrush}" BorderThickness="1">
                                <Grid x:Name="TreeViewGrid" >
                                    <ItemsPresenter x:Name="TreeItems"/>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                        <Canvas x:Name="TreeViewCanvas">
                            <Popup x:Name="PopUp" IsOpen="False" >
                            </Popup>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentTreeViewAdvStyle}" TargetType="local:TreeViewAdv"/>   

</ResourceDictionary>
