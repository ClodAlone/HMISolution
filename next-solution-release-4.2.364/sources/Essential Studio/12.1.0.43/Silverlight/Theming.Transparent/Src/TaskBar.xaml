<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
  xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"   xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">

    <!-- Brushes -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CommonBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <LinearGradientBrush x:Key="TransparentTaskBarItemBackgroundBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FBEBEBE" Offset="1"/>
        <GradientStop Color="#99FFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="Transparent" x:Key="TransparentTaskBarBackgroundBrush" />
    <SolidColorBrush Color="#7F000000" x:Key="TransparentTaskBarItemBorderBrushKey" />
    <SolidColorBrush Color="#7F000000" x:Key="TransparentTaskBarItemHeaderBorderBrushKey" Opacity="0.6"/>
    <LinearGradientBrush Opacity="0.6" x:Key="TransparentTaskBarItemHeaderBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFAFAFA" Offset="0"/>
        <GradientStop Color="#FFDEDEDE" Offset="0.491"/>
        <GradientStop Color="#FFA5A5A5" Offset="0.531"/>
        <GradientStop Color="#FFB6B6B6" Offset="0.789"/>
        <GradientStop Color="#FFD5D5D5" Offset="0.996"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="Black" x:Key="TransparentForegroundBrush"/>
    
    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource TransparentForegroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TransparentForegroundBrush}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource TransparentTaskBarItemHeaderBorderBrushKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <!--<VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>-->
                                <!--<VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>-->
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Background" Background="{StaticResource TransparentTaskBarItemHeaderBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid Margin="1" Background="{TemplateBinding Background}">
                                <Border x:Name="BackgroundAnimation" Opacity="0" Background="{StaticResource BackgroundAnimationBrushKey}"/>
                                <Rectangle x:Name="BackgroundGradient" Fill="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="3" RadiusY="3" IsHitTestVisible="false" Opacity="0"/>
                        <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" RadiusX="2" RadiusY="2" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush Color="#CCFFFFFF" x:Key="TransparentInnerBorderBrush"/>
    <Style x:Key="TransparentTaskBarItemStyle" TargetType="local:TaskBarItem">
        <Setter Property="Background" Value="{StaticResource TransparentTaskBarItemBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TransparentTaskBarItemBorderBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TransparentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsHeaderShown" Value="True"/>
        <Setter Property="HeaderHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TaskBarItem">
                    <Grid x:Name="MainGrid"  >
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderGrid"   Background="{StaticResource TransparentTaskBarItemHeaderBackground}" >
                                <Border x:Name="HeaderBorder" BorderBrush="{StaticResource TransparentTaskBarItemHeaderBorderBrushKey}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="1"  >
                                    <Border BorderBrush="{StaticResource TransparentInnerBorderBrush}" BorderThickness="1">
                                    <controlsToolkit:DockPanel x:Name="Head" LastChildFill="False" >
                                        <ToggleButton Style="{StaticResource ToggleButtonStyle}" controlsToolkit:DockPanel.Dock="Right"  x:Name="ExpanderButton" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsTabStop="False"  Margin="3,1,3,1"/>
                                        <ContentControl  controlsToolkit:DockPanel.Dock="Left" x:Name="HeaderContent" Content="{TemplateBinding Header}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},  Path=HeaderTemplate}" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"  />
                                    </controlsToolkit:DockPanel>
                                    </Border>
                                </Border>
                            </Grid>

                            <Grid x:Name="ContentGrid"    Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
                                <Border x:Name="ContentBorder" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="1,0,1,1"        Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                              >
                                    <Border BorderBrush="{StaticResource TransparentInnerBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <ContentPresenter x:Name="TaskBarContent"  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ItemContentTemplate}"   >
                                            </ContentPresenter>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TransparentTaskBarItemStyle}" TargetType="local:TaskBarItem"/>

    <Style x:Key="TransparentTaskBarStyle" TargetType="local:TaskBar">
        <Setter Property="Foreground" Value="{StaticResource TransparentForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="local:TaskBar">
                    <Border x:Name="MainBorder"  BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                     Background="{TemplateBinding Background}">
                        <StackPanel  x:Name="MainGrid" Orientation="Horizontal">
                            <ItemsPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TransparentTaskBarStyle}" TargetType="local:TaskBar">
        <Setter Property="ItemContainerStyle" Value="{StaticResource TransparentTaskBarItemStyle}"/>
    </Style>


</ResourceDictionary>
