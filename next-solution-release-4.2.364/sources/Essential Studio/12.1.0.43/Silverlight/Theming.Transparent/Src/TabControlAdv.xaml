        <Style TargetType="local:TabItemAdvBorderOffice2007"  x:Key="local:TabItemAdvBorderOffice2007">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabItemAdvBorderOffice2007">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal"/>
                                    <vsm:VisualState x:Name="MouseOver">
                                        <!--<Storyboard>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOutterLine" Storyboard.TargetProperty="Stroke">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabItemMouseOverBorderBrushKey}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Stroke">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabItemMouseOverBorderBrushKey}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabItemAdvMouseOverBrushKey}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>-->
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Selected">
                                        <Storyboard>
                                            <!--<DoubleAnimation Duration="0" Storyboard.TargetName="SelectedOutterLine" Storyboard.TargetProperty="Opacity" To="1"/>-->

                                            <!--<DoubleAnimation Duration="0" Storyboard.TargetName="HoverOutterLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                                <DoubleAnimation Duration="0" Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                                <DoubleAnimation Duration="0" Storyboard.TargetName="BottomLine" Storyboard.TargetProperty="Opacity" To="1"/>-->
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="SelectedMouseOver">
                                        <!--<Storyboard>
                                                <DoubleAnimation Duration="0" Storyboard.TargetName="HoverOutterLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                                <DoubleAnimation Duration="0" Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                                <DoubleAnimation Duration="0" Storyboard.TargetName="SelectedOutterLine" Storyboard.TargetProperty="Opacity" To="1"/>
                                                <DoubleAnimation Duration="0" Storyboard.TargetName="HoverSelectedLine" Storyboard.TargetProperty="Opacity" To="1"/>
                                            </Storyboard>-->
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Canvas>
                                <Border x:Name="BackBorder" Background="Transparent"/>
                                <Path x:Name="SelectedOutterLine" Opacity="0" Fill="{StaticResource TabItemSelectedBrushKey}" Stroke="{StaticResource TabItemSelectedBorderBrushKey}"></Path>
                                <Path x:Name="SelectedMouseOverOutterLine" Opacity="0" Fill="{StaticResource TabItemSelectedBrushKey}" Stroke="{StaticResource TabItemSelectedMouseOverBorderBrushKey}"></Path>
                                <Path x:Name="HoverSelectedLine" Opacity="0" Stroke="{StaticResource TabItemSelectedMouseOverBorderBrushKey}" Fill="Transparent"></Path>
                                <Path x:Name="HoverOutterLine" StrokeThickness="0" Stroke="{TemplateBinding BorderBrush}" Fill="Transparent"></Path>
                                <Path x:Name="HoverInnerLine" Stroke="{TemplateBinding BorderBrush}" Fill="{TemplateBinding Background}"></Path>
                                <Path x:Name="BottomLine" Opacity="0" Stroke="Transparent"></Path>
                                <ContentPresenter Content="{TemplateBinding Content}" Margin="3,0,3,0">
                                </ContentPresenter>
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:TabItemAdvBorderOffice2007"  BasedOn="{StaticResource local:TabItemAdvBorderOffice2007}"/>

        <Style TargetType="local:DragMarker" x:Key="local:DragMarker">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:DragMarker">
                        <Popup x:Name="Popup" HorizontalOffset="{TemplateBinding HorizontalOffset}"
                           VerticalOffset="{TemplateBinding VerticalOffset}" Height="9" Width="8">
                            <Path x:Name="MarkerPath" Data="M3,0L3,7 L1,7 L4.5,10 L8,7 L6,7 L6,0 L2.5,0" Fill="{StaticResource TabControlAdvButtonBackgroundBrushKey}" 
                              Stroke="{StaticResource TabControlAdvBorderBrushKey}"/>
                        </Popup>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style BasedOn="{StaticResource local:DragMarker}" TargetType="local:DragMarker"/>
    
  
        <Style TargetType="local:TabPopupMenuItem" x:Key="local:TabPopupMenuItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabPopupMenuItem">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeMenuItemHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentMenuItemHoverBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerborder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentmenuitemhoverInnerBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>

                            <Border x:Name="ItemBorder" Background="Transparent" Margin="1" BorderBrush="Transparent" BorderThickness="1">
                            <Border BorderThickness="1" x:Name="innerborder">
                                <Grid x:Name="ItemGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="ItemImage" Grid.Column="0" Width="20" Height="20" Source="{TemplateBinding HeaderImage}" Margin="1"/>
                                    <ContentPresenter x:Name="PART_PopUpPresenter" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                   Margin="5,0,7,0"                  ContentTemplate="{TemplateBinding HeaderTextTemplate}" Content="{TemplateBinding HeaderText}"/>
                                </Grid>
                            </Border>
                        </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:TabPopupMenuItem"  BasedOn="{StaticResource local:TabPopupMenuItem}"/>

        <Style TargetType="local:TabPopupMenu" x:Key="local:TabPopupMenu">

            <Setter Property="Template">

                <Setter.Value>
                    <ControlTemplate TargetType="local:TabPopupMenu">
                        <Popup x:Name="Popup" HorizontalOffset="{TemplateBinding HorizontalOffset}"
                           VerticalOffset="{TemplateBinding VerticalOffset}">
                            <Border x:Name="PopupBorder"  BorderThickness="1" Margin="0,0,5,5"
                                BorderBrush="{StaticResource TransparentThemeTabItemContextMenuBorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".5" Direction="315"/>
                            </Border.Effect>
                            <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>

                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IconBar" Grid.Column="0" Background="{StaticResource TransparentThemeContextMenuIconBarBackgroundBrush}"/>

                                    </Grid>
                                <StackPanel Background="{StaticResource TransparentThemeTabItemContextMenuBackgroundBrush}" x:Name="PopupRoot" Grid.ColumnSpan="3">
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="MenuItemStyle" Value="{StaticResource local:TabPopupMenuItem}"/>
        </Style>
        <Style TargetType="local:TabPopupMenu"  BasedOn="{StaticResource local:TabPopupMenu}"/>

        <Style TargetType="local:ScrollingButton" x:Key="local:ScrollingButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:ScrollingButton">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeMenuButtonHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TranspaentThemeMenuButtonHoverBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path1" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path1" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path2" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path2" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path3" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path3" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path4" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path4" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path5" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path5" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path6" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path6" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>

                                        </Storyboard>

                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Pressed">
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>

                            <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="PART_Path1" Data="M0,0L4,3.5 0,7" Stroke="{StaticResource TransparentThemePathFillBrush}" 
                                      Fill="{StaticResource TransparentThemePathFillBrush}"/>
                                    <Path x:Name="PART_Path2" Data="M4,0L8,3.5 4,7"  Stroke="{StaticResource TransparentThemePathFillBrush}" 
                                      Fill="{StaticResource TransparentThemePathFillBrush}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path3" Data="M5,0L5,7" Stroke="{StaticResource TransparentThemePathFillBrush}" 
                                      Fill="{StaticResource TransparentThemePathFillBrush}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path4" Data="M8,0L4,3.5 8,7" Stroke="{StaticResource TransparentThemePathFillBrush}" 
                                      Fill="{StaticResource TransparentThemePathFillBrush}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path5" Data="M4,0L0,3.5 4,7" Stroke="{StaticResource TransparentThemePathFillBrush}" 
                                      Fill="{StaticResource TransparentThemePathFillBrush}" Visibility="Collapsed"/>
                                    <Path x:Name="PART_Path6" Data="M2,0L2,7" Stroke="{StaticResource TransparentThemePathFillBrush}" 
                                      Fill="{StaticResource TransparentThemePathFillBrush}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:ScrollingButton"  BasedOn="{StaticResource local:ScrollingButton}"/>

        <Style TargetType="local:MenuButton" x:Key="local:MenuButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:MenuButton">
                        <Grid>
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeMenuButtonHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TranspaentThemeMenuButtonHoverBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PathButton" Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>

                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>

                            <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Path x:Name="PathButton"
				                Fill="{StaticResource TransparentThemePathFillBrush}"
				                HorizontalAlignment="Center" VerticalAlignment="Center"
				                Width="8" Height="8">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <PathGeometry>
                                                <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="8,1"/>
                                                    <LineSegment Point="8,3"/>
                                                    <LineSegment Point="0,3"/>
                                                </PathFigure>
                                            </PathGeometry>
                                            <PathGeometry>
                                                <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="4,8"/>
                                                    <LineSegment Point="8,4"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:MenuButton"  BasedOn="{StaticResource local:MenuButton}"/>

        <Style TargetType="local:CloseButton" x:Key="local:CloseButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:CloseButton">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Normal" />
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeMenuButtonHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TranspaentThemeMenuButtonHoverBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CrossPath" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentHoverPathBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>

                            <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <Path x:Name="CrossPath"
				                    Stroke="{StaticResource TransparentThemePathFillBrush}"
				                    StrokeThickness="1.5"
                                    Data="M1,1 L7,7 M1,7 L7,1"
				                    HorizontalAlignment="Center" VerticalAlignment="Center"
				                    Width="8" Height="8"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:CloseButton"  BasedOn="{StaticResource local:CloseButton}"/>

        <Style TargetType="local:TabPanelAdv" x:Key="local:TabPanelAdv">
            <Setter Property="Background" Value="{StaticResource TransparentThemeTabPanelAdvBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentTabControlAdvBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabPanelAdv">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border BorderBrush="#CCFFFFFF" BorderThickness="1,1,1,0">
                        <controlsToolkit:DockPanel x:Name="DockPanel" LastChildFill="False">
                                <Border x:Name="ButtonsBorder" 
                                    controlsToolkit:DockPanel.Dock="Right">
                                    <controlsToolkit:DockPanel>
                                        <local:CloseButton 
                                        x:Name="PART_CloseButton" 
                                        Style="{StaticResource local:CloseButton}"
                                        Width="15" Height="14" Margin="0,0,3,0"
                                        />
                                        <StackPanel x:Name="MenuPanel" controlsToolkit:DockPanel.Dock="Right" Width="14" Height="14">
                                            <local:TabPopupMenu 
                                            x:Name="TabPopupMenu"
                                            Style="{StaticResource local:TabPopupMenu}"/>
                                            <local:MenuButton 
                                            x:Name="PART_MenuButton" 
                                            Style="{StaticResource local:MenuButton}"
                                            Width="14" Height="14"/>
                                        </StackPanel>
                                        <local:ScrollingPanel x:Name="PART_ScrollingPanel" HorizontalAlignment="Center" controlsToolkit:DockPanel.Dock="Right">
                                            <local:ScrollingButton 
                                                x:Name="FirstTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="FirstTab" Visibility="Collapsed"/>
                                            <local:ScrollingButton 
                                                x:Name="PrevPage"
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="PrevPage" Visibility="Collapsed"/>
                                            <local:ScrollingButton 
                                                x:Name="PrevTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="PrevTab"/>
                                            <local:ScrollingButton 
                                                x:Name="NextTab"
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextTab"/>
                                            <local:ScrollingButton 
                                                x:Name="NextPage" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextPage" Visibility="Collapsed"/>
                                            <local:ScrollingButton 
                                                x:Name="LastTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="LastTab" Visibility="Collapsed"/>
                                        </local:ScrollingPanel>
                                    </controlsToolkit:DockPanel>
                                </Border>
                                <Grid>

                                    <ContentPresenter x:Name="PART_TabItems"
                                          HorizontalAlignment="Center"
                                          controlsToolkit:DockPanel.Dock="Left"/>
                                </Grid>
                            </controlsToolkit:DockPanel>
                        </Border>
                    </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:TabPanelAdv"  BasedOn="{StaticResource local:TabPanelAdv}"/>

        <Style TargetType="local:TabItemAdv" x:Key="TransparentTabItemAdvStyle">
            <Setter Property="Foreground" Value="{StaticResource TransparentThemeForegroundBrush}"/>
            <Setter Property="BorderThickness"  Value="1,1,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabItemAdv">
                        <Grid Background="Transparent">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeTabItemSelectedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerborder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#CCFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeTabItemSelectedBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Normal">

                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="MouseOver">
                                        <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerborder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#CCFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeTabItemHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeTabItemExtHoverBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>

                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Border 
                            x:Name="TabItemBorder" 
                       Margin="3,3,3,0" CornerRadius="3,3,0,0"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" >
                            <Border CornerRadius="3,3,0,0" BorderThickness="1,1,1,0" x:Name="innerborder">
                                <controlsToolkit:DockPanel x:Name="PART_DockPanel" LastChildFill="True" Margin="3,3,3,0" >
                                    <local:DragMarker 
                                x:Name="DragMarker"
                                Style="{StaticResource local:DragMarker}"/>
                                    <local:CloseButton 
                                x:Name="PART_CloseButton" 
                                Style="{StaticResource local:CloseButton}"
                                Width="15" Height="14" Margin="4,0,4,0" controlsToolkit:DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                                    <Image x:Name="PART_Image" Stretch="None" Margin="1,0,1,0" VerticalAlignment="Center"/>
                                    <local:TabContentPanel x:Name="TabContentPanel"
                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                    HorizontalAlignment="Center">
                                        <TextBox x:Name="PART_TextBox"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Collapsed"/>
                                        <ContentPresenter x:Name="PART_Content"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Visible">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock"/>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </local:TabContentPanel>
                                </controlsToolkit:DockPanel>
                            </Border>
                        </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="local:TabItemAdv"  BasedOn="{StaticResource TransparentTabItemAdvStyle}"/>

        <Style TargetType="local:TabControlAdv" x:Key="TransparentTabControlAdvStyle">
            <Setter Property="Background" Value="{StaticResource TransparentThemeTabControlExtBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentTabControlAdvBorderBrush}"/>
            <Setter Property="MinHeight"   Value="100"/>
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
        <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TabControlAdv">
                        <Grid Background="Transparent"  VerticalAlignment="Stretch">
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="CommonStates">
                                    <vsm:VisualState x:Name="TopPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="LeftPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="RightPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="BottomPlacement">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <local:TabControlPanel x:Name="TabControlPanel" >
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
        >
                                    <local:TabPanelAdv 
                                    x:Name="TabPanel" 
                                    Style="{StaticResource local:TabPanelAdv}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </local:TabPanelAdv>
                                </Grid>
                                <Border x:Name="ContentPanel" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderBrush="#CCFFFFFF" BorderThickness="1">
                                    <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                            </Border>
                            </local:TabControlPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Setter Property="ItemContainerStyle"  Value="{StaticResource TransparentTabItemAdvStyle}"/>
            <Setter Property="MenuItemStyle" Value="{StaticResource local:TabPopupMenuItem}"/>
        </Style>
        <Style BasedOn="{StaticResource TransparentTabControlAdvStyle}" TargetType="local:TabControlAdv"/>
   </ResourceDictionary>
