<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    >

    <!-- Brushes -->

    <SolidColorBrush x:Key="TextBrushKey" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TaskBarItemHeaderBackgroundBrushKey" Color="#FF5A595A"/>
    <SolidColorBrush x:Key="TaskBarItemBackgroundBrushKey" Color="#FF525252"/>
    <SolidColorBrush x:Key="TaskBarItemBorderBrushKey" Color="#FF444444"/>
   
    <SolidColorBrush x:Key="MouseOverBrushKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="BackgroundAnimationBrushKey" Color="#FF595959"/>

    <SolidColorBrush x:Key="DisabledBackgroundBrushKey" Color="#FF666666"/>

    <SolidColorBrush x:Key="FocusedBorderBrushKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="PressedBrushKey" Color="#FF424242"/>

    <SolidColorBrush x:Key="SelectedBrushKey" Color="#FFAAAAAA"/>
    <SolidColorBrush x:Key="ToggleButtonFillBrushKey" Color="White"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrushKey" Color="#FF595959"/>
    <SolidColorBrush x:Key="ButtonBorderBrushKey" Color="#FF333333"/>
    <SolidColorBrush x:Key="ButtonMouseOverBrushKey" Color="#FFAAAAAA"/>

    <!-- Styles -->


    <!-- ToggleButton -->

    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrushKey}"/>      
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF595959"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>

                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Background" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid >
                                <Rectangle x:Name="BackgroundGradient" Fill="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>

                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="3" RadiusY="3" IsHitTestVisible="false" Opacity="0"/>
                        <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" RadiusX="2" RadiusY="2" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

   

    <Style x:Key="BlendTaskBarItemStyle" TargetType="local:TaskBarItem">
        <Setter Property="Background" Value="{StaticResource TaskBarItemBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TaskBarItemBorderBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsHeaderShown" Value="True"/>
        <Setter Property="HeaderHeight" Value="25"/>
        <Setter Property="Theme" Value="Blend" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TaskBarItem">                    
                    <Grid x:Name="MainGrid"  > 
                        <VisualStateManager.VisualStateGroups> 
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">                                    
                                </VisualState> 
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MouseOverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>                                   
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                       <!-- <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" x:Name="MouseOverBorder"></Border> -->
                            <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderGrid"  Background="{StaticResource TaskBarItemHeaderBackgroundBrushKey}" >
                                <Border x:Name="HeaderBorder" BorderBrush="{StaticResource TaskBarItemBorderBrushKey}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}" Padding="1">
                                    <controlsToolkit:DockPanel x:Name="Head" LastChildFill="False">
                                        <ToggleButton Background="{StaticResource ToggleButtonFillBrushKey}" Style="{StaticResource ToggleButtonStyle}" controlsToolkit:DockPanel.Dock="Right" x:Name="ExpanderButton" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsTabStop="False"  Margin="3"/>
                                        <ContentPresenter controlsToolkit:DockPanel.Dock="Left"  x:Name="HeaderContent" Content="{TemplateBinding Header}" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},  Path=HeaderTemplate}" HorizontalAlignment="Left" Margin="3" VerticalAlignment="Center"/>
                                    </controlsToolkit:DockPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="ContentGrid"   Background="{TemplateBinding Background}" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
                                <Border x:Name="ContentBorder" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="1"        
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter x:Name="TaskBarContent"  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ItemContentTemplate}">
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendTaskBarItemStyle}" TargetType="local:TaskBarItem"/>

    <Style x:Key="BlendTaskBarStyle" TargetType="local:TaskBar">
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="local:TaskBar">
                    <Border x:Name="MainBorder"  BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                     Background="{TemplateBinding Background}" CornerRadius="3">
                        <StackPanel  x:Name="MainGrid" Orientation="Horizontal">
                            <ItemsPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendTaskBarStyle}" TargetType="local:TaskBar">
        <Setter Property="ItemContainerStyle" Value="{StaticResource BlendTaskBarItemStyle}"/>
    </Style>

</ResourceDictionary>
