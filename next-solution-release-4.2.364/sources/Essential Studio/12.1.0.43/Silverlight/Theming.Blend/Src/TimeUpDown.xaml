    <SolidColorBrush x:Key="TimeUpDownInvalidIconGlyph3StrokeBrushKey" Color="#FF333333"/>

    <LinearGradientBrush x:Key="TimeUpDownInvalidIconGlyph3FillBrushKey" EndPoint="1.06,0.5" StartPoint="-0.0599991,0.5">
        <GradientStop Color="#F6271A47" Offset="0.236364"/>
        <GradientStop Color="#E7271A47" Offset="0.534545"/>
