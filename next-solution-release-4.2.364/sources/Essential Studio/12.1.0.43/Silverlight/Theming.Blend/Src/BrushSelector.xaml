    </Style>

    <Style x:Key="BlendBrushSelectorStyle" TargetType="local:BrushSelector" >
        <Setter Property="Background" Value="{StaticResource BrushSelectorBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="BorderBrush" Value="{StaticResource BrushSelectorBorderBrushKey}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BrushSelector">
                    <Border  Margin="0">
                        <Grid Width="{TemplateBinding Width}" MaxHeight="25" x:Name="MainGrid">
                            <Grid.Resources>
                                <Style x:Key="BrushSelectorToggleButtonStyle" TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{StaticResource BrushSelectorBackgroundBrushKey}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrushKey}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Fill">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushSelectorMouseOverToggleGradientFillBrushKey}"/>
                                                                    </ObjectAnimationUsingKeyFrames>-->
                                                                    <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DisabledBackgroundBrushKey}"/>
                                                                    </ObjectAnimationUsingKeyFrames>-->

                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Fill">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                                                    </ObjectAnimationUsingKeyFrames>

                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                                                        <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="CheckStates">
                                                            <VisualState x:Name="Checked"/>
                                                            <VisualState x:Name="Unchecked"/>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="FocusStates">
                                                            <VisualState x:Name="Focused">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Fill">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                                                        <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Unfocused"/>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="7*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle x:Name="BackgroundGradient" Fill="{TemplateBinding Background}"/>
                                                            <Rectangle Grid.Column="1" x:Name="ToggleGradient" Fill="{StaticResource BrushSelectorMouseOverToggleGradientFillBrushKey}" RadiusX="2" RadiusY="2"/>

                                                            <Path x:Name="BtnArrow" Stretch="Uniform" Height="6" StrokeThickness="2" Grid.Column="1" Stroke="{StaticResource GlyphBrushKey}" HorizontalAlignment="Center" Width="10" Data="M 1,1.5 L 4.5,5 L 8,1.5"/>
                                                            <!--<Path Stretch="Fill" Height="7" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Width="7" UseLayoutRounding="False" Fill="{StaticResource GlyphBrushKey}" Data="M-136,132 L-122,132 L-129,141 z">
                                                            </Path>-->
                                                        </Grid>
                                                    </Border>
                                                    <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                    <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="3" RadiusY="3" IsHitTestVisible="false" Opacity="0"/>
                                                    <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" RadiusX="2" RadiusY="2" Margin="1" IsHitTestVisible="false" Opacity="0"/>

                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <ToggleButton BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Grid.Column="2" x:Name="colorToggleButton" Style="{StaticResource BrushSelectorToggleButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                                    <Rectangle Name="selectedColorRect" HorizontalAlignment="Left"  Fill="{TemplateBinding SelectedBrush}" Width="20" Height="20" Margin="1"/>
                                    <TextBlock  Name="colortext" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <Popup HorizontalOffset="-2" VerticalOffset="20" Name="BrushEditPopup" IsOpen="{Binding ElementName=colorToggleButton, Path=IsChecked}" >

                                <!--<StackPanel Background="{Binding ElementName=BrushEdit, Path=Background}">-->
                                <Canvas x:Name="OutsideCanvas" Background="Red">
                                    <Canvas x:Name="OutsidePopupCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <local:BrushEdit Name="BrushEdit" MinWidth="250" VisualizationStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VisualizationStyle,Mode=TwoWay}" EnableGradientToSolidSwitch="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableGradientToSolidSwitch,Mode=TwoWay}" SelectedBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedBrush,Mode=TwoWay}" BrushMode="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BrushMode,Mode=TwoWay}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                                    <!--</StackPanel>-->
                                </Canvas>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:BrushSelector" BasedOn="{StaticResource BlendBrushSelectorStyle}"/>

</ResourceDictionary>
