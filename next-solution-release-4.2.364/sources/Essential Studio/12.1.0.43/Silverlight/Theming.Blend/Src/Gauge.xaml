    <SolidColorBrush x:Key="CircularGaugeMiddleFrameBrushKey" Color="#FFAAAAAA"/>
    <SolidColorBrush x:Key="CircularScaleBackgroundBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="CircularPointerBackgroundBrushKey" Color="#FFBDBDBD"/>
    <SolidColorBrush x:Key="MarkTickSetTickBackgroundKey" Color="#FFAAAAAA"/>

    <SolidColorBrush x:Key="LabelTickSetLabelForegroundKey" Color="White"/>
    <SolidColorBrush x:Key="LabelTickSetBackgroundBrushKey" Color="White"/>

    <LinearGradientBrush x:Key="LinearGaugeInnerFrameBrushKey" EndPoint="1.023,0.5" StartPoint="0.023,0.5">
        <GradientStop Color="#FF45484C" Offset="0"/>
        <GradientStop Color="sc#1, 0.08697331, 0.09347102, 0.101204164" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF5F6265" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="LinearGaugeBackgroundBrushKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.125" RadiusY="0.372">
        <GradientStop Color="#FF969696" Offset="0"/>
        <GradientStop Color="sc#1, 0.240202367, 0.242509425, 0.245729312" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.184340477, 0.188636839, 0.194633156" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.139172778, 0.1450776, 0.153318807" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.108407959, 0.115408361, 0.1251786" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.102241725, 0.10946171, 0.119538426" Offset="1"/>
        <GradientStop Color="#FF5A5D61" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="LinearGaugeMiddleFrameBrushKey" Color="#FFAAAAAA"/>

    <LinearGradientBrush x:Key="LinearGaugeOuterFrameBrushKey" EndPoint="1.042,0.5" StartPoint="0.021,0.5">
        <GradientStop Color="#FF5F6265" Offset="0"/>
        <GradientStop Color="sc#1, 0.08697331, 0.09347102, 0.101204164" Offset="0.70015799999237061"/>
        <GradientStop Color="#FF45484C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LinearRangeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFAFA" Offset="0"/>
        <GradientStop Color="#FFF90D0D" Offset="0.808"/>
        <GradientStop Color="#FEB9AFAF" Offset="0"/>
        <GradientStop Color="#FEF03939" Offset="0.558"/>
        <GradientStop Color="#FEE6A4A4" Offset="0.344"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="LinearBarPointerBackgroundBrushKey" Color="#FF2D09B1"/>

    <SolidColorBrush x:Key="LinearMarkerPointerBackgroundBrushKey" Color="#FF2D09B1"/>

    <LinearGradientBrush x:Key="DigitalGaugeOuterFrameBrushKey" EndPoint="0.5,-0.056" StartPoint="0.5,0.964">
        <GradientStop Color="#FF5F6266" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.70015799999237061"/>
        <GradientStop Color="#FF46494D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DigitalGaugeInnerFrameBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF46494D" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF5F6266" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DigitalGaugeBackgroundBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF959595" Offset="0"/>
        <GradientStop Color="sc#1, 0.23793754, 0.23948577, 0.243536577" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.1839543, 0.186837509, 0.194381177" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.140305564, 0.1442682, 0.15463607" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.110575363, 0.115273222, 0.127564728" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.104616493, 0.10946171, 0.122138768" Offset="1"/>
        <GradientStop Color="#FF5B5D62" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DigitalGaugeMiddleFrameBrushKey" Color="White"/>
    <SolidColorBrush x:Key="DigitalGaugeSegmentBrushKey" Color="#FFE2E2E2"/>


    <!--Rolling Gauge-->
    <LinearGradientBrush x:Key="RollingGaugeBorderBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF5F6266" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF46494D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RollingGaugeSegmentBorderBrushKey" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF46494D" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.29984200000762939"/>
        <GradientStop Color="#FF5F6266" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="RollingGaugeBackgroundBrushKey"  EndPoint="0.5,-0.056" StartPoint="0.5,0.964">
        <GradientStop Color="#FF5F6266" Offset="0"/>
        <GradientStop Color="sc#1, 0.08784071, 0.09438236, 0.103540942" Offset="0.70015799999237061"/>
        <GradientStop Color="#FF46494D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RollingGaugeSegmentBackgroundKey"  EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FF959595" Offset="0"/>
        <GradientStop Color="sc#1, 0.23793754, 0.23948577, 0.243536577" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.1839543, 0.186837509, 0.194381177" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.140305564, 0.1442682, 0.15463607" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.110575363, 0.115273222, 0.127564728" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.104616493, 0.10946171, 0.122138768" Offset="1"/>
        <GradientStop Color="#FF5B5D62" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush  x:Key="RollingGaugeTextBrushKey" Color="#FFAAAAAA" />
    

    <!-- Styles -->

    <Style x:Key="gauge:CircularGauge" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource CircularGaugeBackgroundBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource CircularGaugeInnerFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource CircularGaugeMiddleFrameBrushKey}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource CircularGaugeOuterFrameBrushKey}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
    </Style>
    <Style TargetType="gauge:CircularGauge" BasedOn="{StaticResource gauge:CircularGauge}"/>

    <Style x:Key="gauge:GaugeBorder" TargetType="gauge:GaugeBorder">
    </Style>
    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource gauge:GaugeBorder}"/>

    <Style x:Key="gauge:CircularScale" TargetType="gauge:CircularScale">
        <Setter Property="Background" Value="{StaticResource CircularScaleBackgroundBrushKey}"/>
        <Setter Property="ScaleBarSize" Value="10"/>
    </Style>
    <Style TargetType="gauge:CircularScale" BasedOn="{StaticResource gauge:CircularScale}"/>

   <Style x:Key="gauge:CircularPointer" TargetType="gauge:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="Background" Value="{StaticResource CircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
    </Style>
    <Style TargetType="gauge:CircularPointer" BasedOn="{StaticResource gauge:CircularPointer}"/>

   <Style x:Key="gauge:PointerCap" TargetType="gauge:PointerCap">
        <Setter Property="PointerCapRadius" Value="7"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource gauge:PointerCap}"/>

    <Style x:Key="gauge:CircularKnob" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource gauge:CircularKnob}"/>

    <Style x:Key="gauge:DigitalGauge" TargetType="gauge:DigitalGauge">
        <Setter Property="MiddleFrameBrush" Value="{StaticResource DigitalGaugeMiddleFrameBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource DigitalGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource DigitalGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource DigitalGaugeOuterFrameBrushKey}"/>
        <Setter Property="OuterFrameOffset" Value="12"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="MiddleFrameOffset" Value="2"/>
        <Setter Property="SegmentBrush" Value="{StaticResource DigitalGaugeSegmentBrushKey}"/>
    </Style>
    <Style TargetType="gauge:DigitalGauge" BasedOn="{StaticResource gauge:DigitalGauge}"/>

    <Style x:Key="gauge:MarkTickSet" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource MarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource gauge:MarkTickSet}"/>

    <Style x:Key="gauge:LabelTickSet" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LabelForeground" Value="#FF375D81"/>
        <Setter Property="TickPlacement" Value="Inside"/>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource gauge:LabelTickSet}"/>

   <Style x:Key="gauge:CircularRange" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource gauge:CircularRange}"/>

    <Style x:Key="gauge:GaugeLabel" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource gauge:GaugeLabel}"/>

    <Style x:Key="gauge:GaugeImage" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource gauge:GaugeImage}"/>

   <Style x:Key="gauge:StateIndicator" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource gauge:StateIndicator}"/>

    <Style x:Key="gauge:LinearGauge" TargetType="gauge:LinearGauge">
        <Setter Property="InnerFrameBrush" Value="{StaticResource LinearGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource LinearGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource LinearGaugeOuterFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource LinearGaugeMiddleFrameBrushKey}"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="OuterFrameOffset" Value="15"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="RadiusX" Value="15"/>
        <Setter Property="RadiusY" Value="15"/>
    </Style>
    <Style TargetType="gauge:LinearGauge" BasedOn="{StaticResource gauge:LinearGauge}"/>

    <Style x:Key="gauge:LinearScale" TargetType="gauge:LinearScale">
        <Setter Property="Offset" Value="2"/>
        <Setter Property="RadiusX" Value="5"/>
        <Setter Property="RadiusY" Value="10"/>
    </Style>
    <Style TargetType="gauge:LinearScale" BasedOn="{StaticResource gauge:LinearScale}"/>

    <Style x:Key="gauge:LinearRange" TargetType="gauge:LinearRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource LinearRangeBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearRange" BasedOn="{StaticResource gauge:LinearRange}"/>

    <Style x:Key="gauge:LinearBarPointer" TargetType="gauge:LinearBarPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource LinearBarPointerBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearBarPointer" BasedOn="{StaticResource gauge:LinearBarPointer}"/>

    <Style x:Key="gauge:LinearMarkerPointer" TargetType="gauge:LinearMarkerPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="PointerLength" Value="5" />
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross" />
        <Setter Property="Background" Value="{StaticResource LinearMarkerPointerBackgroundBrushKey}" />
    </Style>
    <Style TargetType="gauge:LinearMarkerPointer" BasedOn="{StaticResource gauge:LinearMarkerPointer}"/>

  

    <Style x:Key="gauge:RollingGauge" TargetType="gauge:RollingGauge">
        <Setter Property="BorderBrush" Value="{StaticResource RollingGaugeBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource RollingGaugeBackgroundBrushKey}"/>
        <Setter Property="SegmentBackground" Value="{StaticResource RollingGaugeSegmentBackgroundKey}"/>
        <Setter Property="SegmentForeground" Value="{StaticResource RollingGaugeTextBrushKey}"/>
        <Setter Property="SegmentBorderBrush" Value="{StaticResource RollingGaugeSegmentBorderBrushKey}"/>
    </Style>
    <Style TargetType="gauge:RollingGauge" BasedOn="{StaticResource gauge:RollingGauge}"/>

    <Style x:Key="gauge:RollingCharacter" TargetType="gauge:RollingCharacter">
    </Style>
    <Style TargetType="gauge:RollingCharacter" BasedOn="{StaticResource gauge:RollingCharacter}"/>

</ResourceDictionary>
