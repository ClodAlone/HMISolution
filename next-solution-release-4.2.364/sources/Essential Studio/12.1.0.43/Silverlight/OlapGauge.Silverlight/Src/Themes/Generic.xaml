    <Style TargetType="local:OlapCircularGauge">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapCircularGauge">
                    <syncfusion:CircularGauge x:Name="PART_OlapCircularGauge" 
                                              Height="Auto"
                                              Width="Auto"
                                              InnerFrameBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=InnerFrameBrush}"
                                              OuterFrameBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OuterFrameBrush}"
                                              HorizontalAlignment="Center"  
                                              Radius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Radius}" 
                                              Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"
                                              FrameType="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=FrameType}" >
                        <syncfusion:CircularGauge.Scales>
                            <syncfusion:CircularScale   x:Name="m_scale" 
                                                        Radius = "120" 
                                                        Minimum="0" 
                                                        Maximum="100"
                                                        MinorIntervalValue="2" 
                                                        MajorIntervalValue="10"
                                                        StartAngle="120" 
                                                        GapSweepAngle="300"                                            
                                                        ShadowOffset="3"
                                                        Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"
                                                        ScaleBarSize = "0" >
                                <syncfusion:CircularScale.Ticks>
                                    <syncfusion:LabelTickSet 
                                                        FontSize="13"                                                       
                                                        Name="m_label"   
                                                        TickPlacement="Inside"   
                                                        LabelForeground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LabelForeground}" 
                                                        VerticalContentAlignment="Bottom" 
                                                        DistanceFromScale="5" />
                                    <syncfusion:MarkTickSet 
                                                        TickHeight="8" 
                                                        TickShape="Rectangle"  
                                                        TickStyle="MajorTick" 
                                                        TickBackground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TickBackground}"
                                                        Name="majorLabelTick" 
                                                        TickWidth="2"                                                                                             
                                                        TickPlacement="Outside"/>
                                    <syncfusion:MarkTickSet
                                                        TickHeight="2" 
                                                        TickWidth="1" 
                                                        TickStyle="MinorTick" 
                                                        TickShape="Ellipse" 
                                                        Name="minorTick" 
                                                        TickBackground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TickBackground}" 
                                                       
                                                        TickPlacement="Outside"/>
                                </syncfusion:CircularScale.Ticks>
                                <syncfusion:CircularScale.Pointers>
                                    <syncfusion:CircularPointer 
                                                        Background="{StaticResource CircularGaugePointer}" 
                                                        NeedleStyle="Triangle"
                                                        Name="valuePointer"
                                                        BorderBrush="Silver"
                                                        PointerWidth="15"
                                                        EnablePointerInteraction="False"
                                                        PointerNeedleType="Needle" 
                                                        PointerPlacement="Inside">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Name="txtPointerTooltip">
                                                <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PointerToolTipValue}">
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </syncfusion:CircularPointer>
                                    <syncfusion:CircularPointer 
                                                        Background="{StaticResource CircularGaugePointer}" 
                                                        MarkerStyle="Triangle" 
                                                        Name="markerPointer"
                                                        BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"
                                                        PointerNeedleType="Marker"
                                        PointerLength="16" PointerWidth="16"
                                                        EnablePointerInteraction="False"
                                                        PointerPlacement="Outside">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Name="txtMarkerTooltip">
                                                <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MarkerToolTipValue}">
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </syncfusion:CircularPointer>
                                </syncfusion:CircularScale.Pointers>
                                <syncfusion:CircularScale.PointerCap>
                                    <syncfusion:PointerCap
                                                        PointerCapRadius="10" 
                                                        Background="{StaticResource CircularGaugePointerCap}" >
                                    </syncfusion:PointerCap>
                                </syncfusion:CircularScale.PointerCap>
                                <syncfusion:CircularScale.Ranges>
                                    <syncfusion:CircularRange 
                                                        StartValue="0" 
                                                        Name="range" 
                                                        StartWidth="10"
                                                        EndWidth="0"  
                                                        Background="Red"
                                                        RangePosition="Inside"
                                                        DistanceFromScale="35" >
                                    </syncfusion:CircularRange>
                                </syncfusion:CircularScale.Ranges>
                            </syncfusion:CircularScale>
                        </syncfusion:CircularGauge.Scales>
                        <syncfusion:CircularGauge.CustomLabels>
                            <syncfusion:GaugeLabel 
                                                TextAngle="0.00"
                                                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" 
                                                FontSize="12"/>
                        </syncfusion:CircularGauge.CustomLabels>
                        <syncfusion:CircularGauge.Images>
                            <syncfusion:GaugeImage x:Name="img1"/>
                            <syncfusion:GaugeImage x:Name="img2"/>
                        </syncfusion:CircularGauge.Images>
                    </syncfusion:CircularGauge>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
