<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <!--<SolidColorBrush x:Key="CalendarControlBackgroundBrushKey" Color="#FFE4E8EC"/>-->
    
     <LinearGradientBrush x:Key="CalendarControlBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFBFBFB" Offset="0.118"/>
        <GradientStop Color="#FFEEF0F3" Offset="0.971"/>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="TextBrushKey" Color="#FF4C535C"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF4C535C"/>



    <SolidColorBrush x:Key="ScrollButtonFillKey" Color="Silver"/>

    <LinearGradientBrush x:Key="MouseHoverScrollButtonFillKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MouseHoverCellBackgroundKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>



    <SolidColorBrush x:Key="MouseHoverCellBorderBrushKey" Color="#FFB79E73"/>

    <SolidColorBrush x:Key="SelectedCellBackgroundKey" Color="#FFCCD2D9"/>

    <!--<LinearGradientBrush x:Key="SelectedCellBackgroundKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFED498" Offset="0"/>
        <GradientStop Color="#FFFECD86" Offset="0.4"/>
        <GradientStop Color="#FFFDB759" Offset="0.4"/>
        <GradientStop Color="#FFFDEB9F" Offset="1"/>
    </LinearGradientBrush>-->

    <SolidColorBrush x:Key="SelectedCellBorderBrushKey" Color="#FF9E8255"/>

    <SolidColorBrush x:Key="MouseHoverCellForegroundKey" Color="#FF15428B"/>

    <SolidColorBrush x:Key="NextMonthDaysForegroundKey" Color="Silver"/>
    <SolidColorBrush x:Key="PreviousMonthDaysForegroundKey" Color="Silver"/>




    <SolidColorBrush x:Key="CalendarControlBorderBrushKey" Color="#FFA9B1B8"/>

    <SolidColorBrush x:Key="CalendarControlHeaderTextBrushKey" Color="#FF4C535C"/>



    <Style x:Key="Office2010SilverCalendarControlStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CalendarControlBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarControlBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource CalendarControlHeaderTextBrushKey}"/>
        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource ScrollButtonFillKey}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource ScrollButtonFillKey}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>
        <Setter Property="DayForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="DateForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="MouseHoverCellBackground" Value="Transparent"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="Transparent"/>
        <Setter Property="MouseHoverCellForeground" Value="{StaticResource MouseHoverCellForegroundKey}"/>
        <Setter Property="NextMonthDaysForeground" Value="{StaticResource NextMonthDaysForegroundKey}"/>
        <Setter Property="PreviousMonthDaysForeground" Value="{StaticResource PreviousMonthDaysForegroundKey}"/>
        <Setter Property="SelectedCellBackground" Value="{StaticResource SelectedCellBackgroundKey}"/>
        <Setter Property="SelectedCellBorderBrush" Value="Transparent"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource Office2010SilverCalendarControlStyle}"/>
</ResourceDictionary>


