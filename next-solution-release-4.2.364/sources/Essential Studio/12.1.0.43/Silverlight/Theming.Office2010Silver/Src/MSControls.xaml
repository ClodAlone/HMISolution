                            <Path x:Name="CheckIcon" Data="F1 M 424.575,325.964L 426.491,324.964L 428.158,327.297L 431.741,320.214L 433.574,321.464L 429.158,330.131L 427.074,330.131L 424.575,325.964 Z " Fill="Black" FlowDirection="LeftToRight" Width="8.5" Height="8" Opacity="0" Stretch="Fill" />
