                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Storyboard.TargetName="ContentElement2">
                                            <SplineColorKeyFrame KeyTime="0" Value="#FFFDF4D8"/>
