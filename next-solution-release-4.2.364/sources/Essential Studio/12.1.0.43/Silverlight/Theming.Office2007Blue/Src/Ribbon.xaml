        <ResourceDictionary Source="/Syncfusion.Ribbon.Silverlight;component/themes/generic.Black.xaml" shared:SkinList.Key="Office2007Black"/>
        <ResourceDictionary Source="/Syncfusion.Ribbon.Silverlight;component/themes/generic.Silver.xaml" shared:SkinList.Key="Office2007Silver"/>
