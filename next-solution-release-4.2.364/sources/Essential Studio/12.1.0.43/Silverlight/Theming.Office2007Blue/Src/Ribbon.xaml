<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:ctrls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Data"
	xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=System.Windows"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight" 
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    >  

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonButton.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonSeparator.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonApplicationMenu.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonQuickAccessToolBar.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonMenuGroup.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonDropDownButton.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonSplitButton.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonMenuItem.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Theming.Office2007Blue;component/RibbonControls/RibbonScreenTip.xaml"/>
    </ResourceDictionary.MergedDictionaries>

