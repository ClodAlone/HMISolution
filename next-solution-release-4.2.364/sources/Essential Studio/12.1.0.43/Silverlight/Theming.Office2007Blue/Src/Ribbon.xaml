    <!-- RibbonComboBox -->
    <Style TargetType="local:RibbonComboBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Foreground" Value="{StaticResource WindowTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource ComboBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="5,1,5,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonComboBox">
                    <Grid x:Name="LayoutRoot">
                        <Grid.Resources>
                            <Storyboard x:Key="aniHidePopup">
                                <DoubleAnimation To="0" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity" />
                            </Storyboard>
                            <Storyboard x:Key="aniOpenPopup">
                                <DoubleAnimation To="1" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity"/>
                            </Storyboard>
                            <Storyboard x:Key="aniMouseOver" >
                                <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.Background).(SolidColorBrush.Color)" To="White" />
                            </Storyboard>
                        </Grid.Resources>

                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">

                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="MouseOver" />

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation To=".55" Duration="0:0:0.25"
														 Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </VisualState>

                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="FocusStates">

                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="FocusedDropDown" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="Focused" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Unfocused"/>

                                <vsm:VisualState x:Name="FocusedDropDown">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="PopupBorder"
											Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.Background).(SolidColorBrush.Color)" To="White" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="ContentPresenterBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.Resources>
                                    <Style x:Key="comboToggleStyle" TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="ClickMode" Value="Press"/>
                                        <Setter Property="Foreground" Value="#FF333333"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="2,0,2,0"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <vsm:VisualStateManager.VisualStateGroups>
                                                            <vsm:VisualStateGroup x:Name="CommonStates">
                                                                <vsm:VisualStateGroup.Transitions>
                                                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25" />
                                                                    <VisualTransition From="Pressed" GeneratedDuration="0:0:0.25" />
                                                                </vsm:VisualStateGroup.Transitions>

                                                                <vsm:VisualState x:Name="Normal" />
                                                                <vsm:VisualState x:Name="MouseOver">
                                                                    <Storyboard>
                                                                        <ColorAnimation To="#FFB79E73" Duration="0:0:0.25"
														Storyboard.TargetName="Background"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ComboThumbBackgroundHover}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Pressed" >
                                                                    <Storyboard>
                                                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="BtnArrowHost"
														 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" />
                                                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="BtnArrowHost"
														 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" />
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Disabled">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Duration="0:0:0.25" To=".55"
														 Storyboard.TargetName="DisabledVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                            </vsm:VisualStateGroup>
                                                            <vsm:VisualStateGroup x:Name="CheckStates">
                                                                <vsm:VisualStateGroup.Transitions>
                                                                    <VisualTransition From="Checked" GeneratedDuration="0:0:0.25" />
                                                                </vsm:VisualStateGroup.Transitions>

                                                                <vsm:VisualState x:Name="Checked">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ColorAnimation To="#9A8F63" Duration="0:0:0.25"
														Storyboard.TargetName="Background"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="ComboThumb" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ToggleButton.IsCheckedBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="ComboThumb" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource MenuButton.InnerBorderBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Unchecked"/>
                                                            </vsm:VisualStateGroup>
                                                            <vsm:VisualStateGroup x:Name="FocusStates">
                                                                <vsm:VisualState x:Name="Focused">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames  Duration="0:0:0.25"
																		Storyboard.TargetName="FocusVisualElement"
																		Storyboard.TargetProperty="Visibility">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Visible"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Unfocused" />
                                                            </vsm:VisualStateGroup>
                                                        </vsm:VisualStateManager.VisualStateGroups>

                                                        <Border x:Name="Background" Width="16"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Background="{TemplateBinding Background}" >
                                                            <Border x:Name="ComboThumb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
										BorderBrush="{TemplateBinding BorderBrush}" >
                                                                <Border x:Name="BtnArrowHost">
                                                                    <Border.RenderTransform>
                                                                        <TranslateTransform X="0" Y="0"/>
                                                                    </Border.RenderTransform>
                                                                    <Path x:Name="BtnArrow" Data="M0,0L3.5,4 7,0z" Height="4" Width="8" Stretch="Uniform"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Fill="{StaticResource PathFill}"/>
                                                                </Border>
                                                            </Border>
                                                        </Border>
                                                        <Rectangle x:Name="DisabledVisualElement" RadiusX="1" RadiusY="1" Fill="#FFFFFFFF" Opacity="0" IsHitTestVisible="false" />
                                                        <Rectangle x:Name="FocusVisualElement" RadiusX="0.5" RadiusY="0.5" Margin="1"  Stroke="#FF6DBDD1" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="false" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"  
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" >
                                    <TextBlock Text=" "/>
                                </ContentPresenter>

                                <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Style="{StaticResource comboToggleStyle}" />
                            </Grid>
                        </Border>
                        <Rectangle x:Name="DisabledVisualElement" RadiusX="1" RadiusY="3" Fill="White" Opacity="0" IsHitTestVisible="false" />
                        <Rectangle x:Name="FocusVisualElement" RadiusY="2" Margin="1"  Stroke="Transparent" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
                        <Popup x:Name="Popup" Canvas.ZIndex="10">
                            <Grid x:Name="PopupBorder" Opacity="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <local:RibbonShadow Margin="4,4,0,0" />
                                <Border CornerRadius="3"
									Background="{TemplateBinding Background}"
									BorderBrush="{StaticResource WindowFrameBrush}"
									BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="ScrollViewer"  Style="{StaticResource ScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  BorderThickness="0" Padding="1" >
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonComboBoxItem -->
    <SolidColorBrush x:Key="MenuButton.OuterBorderBrush" Color="#FFCFB486"/>
    <LinearGradientBrush x:Key="MenuButton.MouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEDE5C9" Offset="0"/>
        <GradientStop Color="#FFFFFFFE" Offset="0.028"/>
        <GradientStop Color="#FFFFEBA6" Offset="0.484"/>
        <GradientStop Color="#FFFFD75A" Offset="0.537"/>
        <GradientStop Color="#FFFFE590" Offset="0.957"/>
        <GradientStop Color="#FFFFF8B0" Offset="0.993"/>
    </LinearGradientBrush>

    <Style TargetType="local:RibbonComboBoxItem">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonComboBoxItem">
                    <Grid Background="{TemplateBinding Background}">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25" />
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="InnerBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="InnerBorder"
																	   Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="InnerBorder"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To=".55"
														 Storyboard.TargetName="contentPresenter"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="Selected" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Unselected" />
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="OuterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.OuterBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="OuterBorder"
																	   Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="Focused" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused" />
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="OuterBorder" BorderThickness="1"
								BorderBrush="{TemplateBinding BorderBrush}"
								Background="{TemplateBinding Background}"
								Opacity="{TemplateBinding Opacity}" >
                            <Grid>
                                <Border x:Name="InnerBorder" BorderThickness="1" Opacity="0" HorizontalAlignment="Stretch"/>
                                <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Left"
												  Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>

                        <Rectangle x:Name="FocusVisualElement" Stroke="Transparent" StrokeThickness="1" Opacity="0" RadiusX="1" RadiusY="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonListBox -->
    <Style TargetType="local:RibbonListBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="#FFFFFFFF"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="BorderBrush" Value="#FF9DBBE7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonListBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" Padding="1">
                        <ScrollViewer Style="{StaticResource ScrollViewerStyle}"  Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}" x:Name="ScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonRadioButton -->
    <Style TargetType="local:RibbonRadioButton">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource CheckRadioFillNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckRadioStrokeNormal}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonRadioButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckBoxBorderBrushHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckBoxInnerBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse3" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="contentPresenter" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PathFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Canvas Width="13" Height="13">
                                <Ellipse x:Name="ellipse1" Width="13" Height="13" Stroke="{StaticResource CheckBoxBorderBrush}">
                                </Ellipse>
                                <Ellipse x:Name="ellipse2" Fill="{StaticResource CheckBoxInnerBorderBrush}" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                                </Ellipse>
                                <Ellipse x:Name="ellipse3" Fill="{StaticResource CheckRadioInnerFillBrush}" Canvas.Left="3" Canvas.Top="3" Width="7" Height="7">
                                </Ellipse>
                                <Ellipse x:Name="ellipse" Canvas.Left="4" Canvas.Top="4" Width="5" Height="5">
                                </Ellipse>
                            </Canvas>
                            <Ellipse Height="13" x:Name="DisabledVisualElement" Width="13" Opacity="0" Fill="#FFFFFFFF"/>
                        </Grid>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0.5,0,0.5" x:Name="contentPresenter" VerticalAlignment="Center" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonTextBox -->
    <SolidColorBrush x:Key="ListBorder" Color="#FF82A5CB"/>
    <Color x:Key="ControlBrushColor">White</Color>
    <SolidColorBrush x:Key="ControlTextBrush" Color="#FF0B0B0B"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#FF8F9494" />
    
    <Style TargetType="local:RibbonTextBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ControlTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ListBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonTextBox">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="ReadOnly" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard Duration="0:0:0.25">
                                        <ColorAnimation Storyboard.TargetName="MouseOverBorder"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="#FF99C1E2" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="#FF5275A5" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
														To="White" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation Storyboard.TargetName="DisabledVisualElement"
														 Storyboard.TargetProperty="Opacity"
														 To="1" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="{StaticResource ControlBrushColor}" />
                                        <ColorAnimation Storyboard.TargetName="ContentElement"
														Storyboard.TargetProperty="(ScrollViewer.Foreground).(SolidColorBrush.Color)"
														To="Gray" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="ReadOnly" >
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1"
														 Storyboard.TargetName="ReadOnlyVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="Focused" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="Border" Background="Transparent"
								BorderBrush="{StaticResource CheckBoxBorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" >
                            <Grid>
                                <Border x:Name="ReadOnlyVisualElement" Background="#D2F7F7F7" Opacity="0" />
                                <Border x:Name="MouseOverBorder" BorderThickness="1" BorderBrush="Transparent">
                                    <ScrollViewer x:Name="ContentElement" Style="{StaticResource ScrollViewerStyle}" BorderThickness="0" IsTabStop="False"
												  Padding="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </Border>
