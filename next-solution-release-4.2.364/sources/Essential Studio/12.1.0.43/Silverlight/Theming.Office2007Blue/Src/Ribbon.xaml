    <SolidColorBrush x:Key="StatusBarBorderDark" Color="#FF698EBF"/>
    <SolidColorBrush x:Key="StatusBarBorderLight" Color="#FFF8FBFF"/>
    <LinearGradientBrush x:Key="StatusBarLightBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE6F0FF" Offset="0"/>
        <GradientStop Color="#FFB5D3F7" Offset="0.374"/>
        <GradientStop Color="#FFD6E7F7" Offset="0.89"/>
        <GradientStop Color="#FFC1DAF7" Offset="0.978"/>
        <GradientStop Color="#FFA6C1E3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatusBarDarkBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC6DBF7" Offset="0.041"/>
        <GradientStop Color="#FFADCCF7" Offset="0.278"/>
        <GradientStop Color="#FF93B6EE" Offset="0.34"/>
        <GradientStop Color="#FF7397C6" Offset="0.917"/>
        <GradientStop Color="#FF8BA8CC" Offset="0.959"/>
        <GradientStop Color="#FF849FC1" Offset="0.979"/>
        <GradientStop Color="#FF5D7BA1" Offset="1"/>
    </LinearGradientBrush>

    <!--RibbonStatusBar-->
    <Style TargetType="local:RibbonStatusBar" x:Key="Office2007BlueRibbonStatusBarStyle">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource StatusBarBorderDark}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonStatusBar">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{TemplateBinding BorderBrush}" >
                                <Border Grid.Column="0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource StatusBarBorderLight}" Background="{StaticResource StatusBarLightBackground}">
                                    <ContentPresenter Content="{TemplateBinding StatusItemsPane}"/>
                                </Border>
                            </Border>
                            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource StatusBarBorderLight}">
                                <Border Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource StatusBarBorderLight}" Background="{StaticResource StatusBarDarkBackground}">
                                    <ContentPresenter Content="{TemplateBinding ControlItemsPane}"/>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style BasedOn="{StaticResource Office2007BlueRibbonStatusBarStyle}" TargetType="local:RibbonStatusBar"/>
</ResourceDictionary>
