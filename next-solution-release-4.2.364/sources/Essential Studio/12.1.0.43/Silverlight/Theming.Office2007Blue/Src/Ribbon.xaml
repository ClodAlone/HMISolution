<Style BasedOn="{StaticResource Office2007BlueApplicationmenuStyle}" TargetType="local:ApplicationMenu"/>

    <!--Ribbon Brushes-->
    <SolidColorBrush x:Key="RibbonToolbarBelowOutterBorderBrush" Color="#FF7EA1CD"/>
    <SolidColorBrush x:Key="RibbonForeground" Color="#FF10418C"/>
    <SolidColorBrush x:Key="RibbonCaptionForeground" Color="#FF707681"/>

    <!--Ribbon-->
    <Style TargetType="local:Ribbon" x:Key="Office2007BlueRibbonStyle">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
         <Setter Property="QuickAccessToolbarStyle" Value="{StaticResource Office2007BlueQuickAccessToolBarStyle}"/>
        <Setter Property="ApplicationMenuStyle" Value="{StaticResource Office2007BlueApplicationmenuStyle}"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonForeground}" />
        <Setter Property="Title" Value="My Application"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!--<Grid/>-->
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid x:Name="Ribbon" Background="{StaticResource RibbonBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <!--<RowDefinition Height="24" />-->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" MaxWidth="42" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <shared:ContextMenuAdvService.ContextMenuAdv>
                            <shared:ContextMenuAdv VisualStyle="Office2007Blue">
                                <shared:ContextMenuItemAdv Header="Customize Quick Access Toolbar..." Name="PART_MoreCommands"/>
                                <shared:ContextMenuItemAdv Header="Show Quick Access Toolbar below the Ribbon" Name="PART_ShowBelow"/>
                                <shared:ContextMenuItemAdv Header="Minimize Ribbon" Name="PART_Minimize" IsCheckable="True"/>
                            </shared:ContextMenuAdv>
                        </shared:ContextMenuAdvService.ContextMenuAdv>


                        <Border x:Name="Title" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0 -24" Height="24" BorderThickness="0,0,0,1"  BorderBrush="{StaticResource DarkBorder}" Background="{StaticResource TitleBackground}"/>

                        <Border x:Name="TabBar" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0,1,0,0"  BorderBrush="{StaticResource LightBorder}">
                        </Border>

                        <ContentControl Grid.RowSpan="1" Margin="0 -24 0 0" Grid.Row="0" BorderThickness="0" Content="{TemplateBinding ApplicationMenu}" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

                        <Grid Margin="-15,-48,0,0" Grid.Column="1" VerticalAlignment="Center" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="PART_QATAboveContainer">
                                <ContentControl BorderThickness="0" Content="{TemplateBinding QuickAccessToolBar}" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <local:RibbonTitlePanel x:Name="Part_TitlePanel" VerticalAlignment="Top" Height="24" Margin="0 -24 0 0" Grid.Column="1" Caption="{TemplateBinding Title}" Foreground="{StaticResource RibbonCaptionForeground}" Background="Transparent"/>

                        <Border CornerRadius="1" Margin="1" x:Name="Part_QATBorderContainer" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" 
                                BorderThickness="1" BorderBrush="{StaticResource RibbonToolbarBelowOutterBorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Color="#FFB2CDED" />
                                    <GradientStop Color="#FFAAC5EA" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="PART_QATBelowContainer" />
                        </Border>

                        <ContentPresenter x:Name="Part_NormalTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <ContentControl                                      
                                FontFamily="{TemplateBinding FontFamily}" 
                                FontSize="{TemplateBinding FontSize}" 
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight ="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}">
                                <ItemsPresenter  x:Name="Part_TabPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </ContentControl>
                        </ContentPresenter>

                        <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource DarkBorder}" VerticalAlignment="Bottom"/>

                        <local:RibbonDropDown x:Name="Part_PopupTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <local:RibbonDropDown.Template>
                                <ControlTemplate>
                                    <Popup x:Name="Part_Popup" >
                                        <Canvas>
                                            <Rectangle x:Name="Part_OutsideRect"/>
                                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                                <local:RibbonShadow Margin="4,4,0,0"/>
                                                <ContentPresenter />
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </ControlTemplate>
                            </local:RibbonDropDown.Template>
                        </local:RibbonDropDown>

                        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,-1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:RibbonTabStrip x:Name="Part_TabStrip" Background="Transparent">


                            </local:RibbonTabStrip>
                            <ContentControl Content="{TemplateBinding TabPanelItem}" Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style BasedOn="{StaticResource Office2007BlueRibbonStyle}" TargetType="local:Ribbon"/>
  
    <!-- TabButton -->

    <LinearGradientBrush x:Key="Blue.TabButton.HoverTabHighlight" EndPoint="0.5, 1" StartPoint="0.5, 0">
        <GradientStop Color="#FFD3E5F8" Offset="0"/>
        <GradientStop Color="#FFC5DDF6" Offset="0.025"/>
        <GradientStop Color="#FFE1E9F1" Offset="0.47"/>
        <GradientStop Color="#FFDED1A4" Offset="0.975"/>
        <GradientStop Color="#FFB5C3C1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Blue.TabButton.SelectedBrush" EndPoint="0.5, 0" StartPoint="0.5, 1">
        <GradientStop Color="#FFEBF3FB" Offset="0.108"/>
        <GradientStop Color="#FFE7EFF7" Offset="0.935"/>
        <GradientStop Color="#FFD5DFE9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Blue.Ribbon.BorderBrush" Color="#FF98BDE2"/>
    <Color x:Key="Blue.RibbonTapPanel.SeparatorColor.Start">#FFE1D4A7</Color>
    <Color x:Key="Blue.RibbonTapPanel.SeparatorColor.End"  >#FFE0D3B7</Color>
    <Color x:Key="Blue.Foreground">#FF456DA3</Color>

    <Style TargetType="local:TabButton" x:Key="Syncfusion.Windows.Tools.Controls.TabButton">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Blue.Foreground}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="MinWidth" Value="23"/>
        <Setter Property="SeparatorOpacity" Value="0"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabButton">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="Selected" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="SelectedMouseOver" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard Duration="0:0:0.25">
                                        <Storyboard>
                                            <DoubleAnimation To="0.75" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightBorder"
														 Storyboard.TargetProperty="Opacity" />
                                            <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />
                                        </Storyboard>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Left"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Right"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="SelectedBackground"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="SelectedMouseOver">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Left"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Right"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="0.75" Duration="0:0:0.25"
														Storyboard.TargetName="HighlightBorderSelected"
														Storyboard.TargetProperty="Opacity"/>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="SelectedBackground"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border Height="23" Margin="0,0,1,0"
								BorderBrush="{TemplateBinding BorderBrush}"
								Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HighlightBorder" Grid.Column="1" Height="23" Opacity="0"
										BorderThickness="1,1,1,1" CornerRadius="4,4,0,0" Margin="-1,0,-1,0"
										BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}"
										Background="{StaticResource Blue.TabButton.HoverTabHighlight}"/>
                                <Border x:Name="HighlightEdge" Grid.Column="1" Height="21" Opacity="0"
										CornerRadius="3,3,0,0" BorderThickness="1,1,1,0" BorderBrush="WhiteSmoke"/>

                                <Grid x:Name="SelectedBackground" Grid.Column="1" Opacity="0">
