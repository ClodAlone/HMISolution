                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFE4ECF5" Offset="0"/>
                                        <GradientStop Color="#FFFDFDFD" Offset="0.026"/>
                                        <GradientStop Color="#FFDEEAF7" Offset="0.965"/>
                                        <GradientStop Color="#FFECF3FB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mousePressedRectangle">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFD2E6FB" Offset="0.009"/>
                                        <GradientStop Color="#FFB8D5F2" Offset="0.112"/>
                                        <GradientStop Color="#FFACC9E6" Offset="0.47"/>
                                        <GradientStop Color="#FF96BBE0" Offset="0.521"/>
                                        <GradientStop Color="#FFB9DAFB" Offset="0.936"/>
                                        <GradientStop Color="#FFDCE9F7" Offset="0.987"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="15" Height="15">
                                <Grid>
                                    <Path Name="OptionsButtonPath" Margin="0,4,0,0" HorizontalAlignment="Center" Stroke="Black" Fill="Black" StrokeThickness="1" Data="M 0.5,2.5 L 6.5,2.5 L 3.5,6 Z" />
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2007Blue.AwlButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">

                    <Border Background="Transparent" Height="14" >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualState x:Name="Focused"/>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Disabled"/>
                                <vsm:VisualState x:Name="Normal"/>

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="mouseHoverRectangle" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="mousePressedRectangle" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="checkedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="uncheckedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>

                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="checkedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="uncheckedArrow" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Indeterminate"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid Height="Auto" Width="Auto">
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mouseHoverRectangle">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFE4ECF5" Offset="0"/>
                                        <GradientStop Color="#FFFDFDFD" Offset="0.026"/>
                                        <GradientStop Color="#FFDEEAF7" Offset="0.965"/>
                                        <GradientStop Color="#FFECF3FB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Width="15" Height="15" Margin="1,1,1,1" Opacity="0" x:Name="mousePressedRectangle">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFD2E6FB" Offset="0.009"/>
                                        <GradientStop Color="#FFB8D5F2" Offset="0.112"/>
                                        <GradientStop Color="#FFACC9E6" Offset="0.47"/>
                                        <GradientStop Color="#FF96BBE0" Offset="0.521"/>
                                        <GradientStop Color="#FFB9DAFB" Offset="0.936"/>
                                        <GradientStop Color="#FFDCE9F7" Offset="0.987"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Grid>
                                    <Border x:Name="uncheckedArrow" Margin="0,0,1,1" BorderThickness="1" BorderBrush="Transparent" Width="15" Height="15" >
                                        <Canvas Width="15" Height="15" >
                                            <Rectangle Name="uncheckAwlBtnImg" Stroke="Black" StrokeThickness="1" Width="5" Height="7" Canvas.Top="2" Canvas.Left="4" />
                                            <Path Name="uncheckAwlInnerShadowBtnImg" Stroke="Black" Fill="Transparent" Data="M 7.5 9 L 7.5 2" />
                                            <Path Name="uncheckAwlLineBtnImg"  Stroke="Black" Fill="Transparent" Data="M 2 8.5 L 11 8.5" />
                                            <Path Name="uncheckAwlBottomLineBtnImg" Stroke="Black" Fill="Transparent" Data="M 6.5 9 L 6.5 12" />

                                        </Canvas>
                                    </Border>

                                    <Border Margin="0,0,1,1" BorderThickness="1" BorderBrush="Transparent" Width="15" Height="15" Opacity="0" RenderTransformOrigin="0.5,0.5" x:Name="checkedArrow" >
                                        <Canvas Width="15" Height="15" >
                                            <Rectangle Name="AwlBtnImg" Stroke="Black" StrokeThickness="1" Width="5" Height="7" Canvas.Top="2" Canvas.Left="4" />
                                            <Path Name="AwlInnerShadowBtnImg" Stroke="Black" Fill="Transparent" Data="M 7.5 9 L 7.5 2" />
                                            <Path Name="AwlLineBtnImg"  Stroke="Black" Fill="Transparent" Data="M 2 8.5 L 11 8.5" />
                                            <Path Name="AwlBottomLineBtnImg" Stroke="Black" Fill="Transparent" Data="M 6.5 9 L 6.5 12" />
                                        </Canvas>
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="90"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>                                 
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

