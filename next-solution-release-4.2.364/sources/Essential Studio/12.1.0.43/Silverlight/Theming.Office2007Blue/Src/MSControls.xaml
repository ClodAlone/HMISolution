                        <Grid x:Name="TemplateRightSelected" Visibility="Collapsed" Canvas.ZIndex="1">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{StaticResource TabItemSelectedBrushKey}" BorderThickness="1" CornerRadius="0,3,3,0">
