                            <Border x:Name="FocusVisualLeft" Margin="2,2,0,2" IsHitTestVisible="false" Visibility="Collapsed" BorderBrush="{StaticResource FocusedBorderBrushKey}" BorderThickness="1,1,0,1" CornerRadius="3,0,0,3"/>
                            <Border x:Name="DisabledVisualLeftSelected" Margin="2,2,0,2" IsHitTestVisible="false" Opacity="0" Background="{StaticResource DisabledTabItemBrushKey}" CornerRadius="3,0,0,3"/>
