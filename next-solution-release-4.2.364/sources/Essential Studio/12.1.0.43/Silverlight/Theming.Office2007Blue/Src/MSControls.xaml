                            <Border x:Name="FocusVisualBottom" Margin="2,0,2,2" IsHitTestVisible="false" Visibility="Collapsed" BorderBrush="{StaticResource FocusedBorderBrushKey}" BorderThickness="1,0,1,1" CornerRadius="0,0,3,3"/>
                            <Border x:Name="DisabledVisualBottomSelected" Margin="2,0,2,2" IsHitTestVisible="false" Opacity="0" Background="{StaticResource DisabledTabItemBrushKey}" CornerRadius="0,0,3,3"/>
                        </Grid>
                        <Grid x:Name="TemplateBottomUnselected" Visibility="Collapsed">
                            <Border x:Name="BorderBottom" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0,0,3,3">
