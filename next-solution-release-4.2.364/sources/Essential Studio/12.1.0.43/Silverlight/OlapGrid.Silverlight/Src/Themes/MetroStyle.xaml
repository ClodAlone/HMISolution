<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight"
    xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Grid.Olap">
    
    <SolidColorBrush x:Key="MetroGridBackground" Color="#FFFFFFFF"/>
    
    <SolidColorBrush x:Key="MetroBorderBrush" Color="#FFCCCCCC"/>
    
    <SolidColorBrush x:Key="MetroExpanderBackground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroColumnHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroColumnHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroSummaryHeaderBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroSummaryHeaderForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroSummaryCellBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroSummaryCellForeground" Color="#FF333333"/>

    <SolidColorBrush x:Key="MetroRowHeaderBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroRowHeaderForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroValueCellBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroValueCellForeground" Color="#FF333333"/>




    <Style TargetType="local:OlapGridExpandHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridExpandHyperlinkCell">
                    <Grid x:Name="RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19px"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Expanders-->
                        <ToggleButton VerticalAlignment="Top"   x:Name="PART_Expander" Margin="4,2,0,5" Style="{Binding Path=ExpanderStyle,RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                          Visibility="{Binding Path=HasChildren,RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!--Textblock of expander cells-->
                        <TextBlock Margin="1,0,2,0" 
                                   x:Name="PART_InnerTextBlock" 
                                   Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CellDescriptor.CellValue}"
                                   Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}" />
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="PART_ContextMenuAdv" Visibility="Collapsed" 
                                                        Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                                        Background="{Binding Path=Background,RelativeSource={RelativeSource TemplatedParent}}">
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource MetroExpanderBackground}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource MetroExpanderBackground}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1" Width="11" BorderThickness="0" Background="Transparent"   HorizontalAlignment="Right"  >
                            <Grid>
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="{StaticResource MetroExpanderBackground}"/>                             
                                <Path x:Name="CheckedVisual" Data="M290.5,329 L312.5,329.5 302.5,347.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="{StaticResource MetroExpanderBackground}"/>                             
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style 
        TargetType="local:OlapGrid">
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource MetroColumnHeaderBackground}" Foreground="{StaticResource MetroColumnHeaderForeground}" FontFamily="Segoe WP" FontSize="13"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource MetroRowHeaderBackground}" Foreground="{StaticResource MetroRowHeaderForeground}" FontFamily="Segoe WP" FontSize="13"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryColumnStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource MetroSummaryHeaderBackground}"
                             Foreground="{StaticResource MetroSummaryHeaderForeground}"
                             FontFamily="Segoe WP" FontWeight="SemiBold" FontSize="12"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryRowStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource MetroSummaryCellBackground}"
                             Foreground="{StaticResource MetroSummaryCellForeground}"
                             FontFamily="Segoe WP" FontWeight="SemiBold" FontSize="12"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource MetroValueCellBackground}"
                             Foreground="{StaticResource MetroValueCellForeground}"
                             FontFamily="Segoe WP" FontSize="12"/>
            </Setter.Value>
        </Setter>
        <Setter Property="GridLineStroke"  Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderStyle}"/>
        <Setter Property="Background" Value="{StaticResource MetroGridBackground}"/>
    </Style>
</ResourceDictionary>
