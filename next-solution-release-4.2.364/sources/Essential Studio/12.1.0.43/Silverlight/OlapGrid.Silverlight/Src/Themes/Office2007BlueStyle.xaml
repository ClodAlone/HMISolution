<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight"
    xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Grid.Olap">
    <SolidColorBrush x:Key="Classic.GridBackground" Color="#FFFFFF"/>



    <LinearGradientBrush x:Key="Office2007Blue.ColumnHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC4D9FF" Offset="0.97"/>
        <GradientStop Color="#FFFBFFFF" Offset="0.03"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Blue.RowHeaderBackgroundBrush" Color="#FFD7E6FE"/>
    <SolidColorBrush x:Key="Office2007Blue.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryColumnBackgroundBrush" Color="#FFFBE292"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryRowBackgroundBrush" Color="#FFFBE292"/>

    <SolidColorBrush x:Key="Office2007Blue.ColumnHeaderForegroundBrush" Color="#FF15428B"/>
    <SolidColorBrush x:Key="Office2007Blue.RowHeaderForegroundBrush" Color="#FF15428B"/>
    <SolidColorBrush x:Key="Office2007Blue.ValueCellForegroundBrush" Color="#FF485565"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryColumnForegroundBrush" Color="#FF15428B"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryRowForegroundBrush" Color="#FF15428B"/>
    <SolidColorBrush x:Key="Office2007Blue.GridLineStroke" Color="#FFADD1FF"/>
<LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>
    <SolidColorBrush Color="#FFB0D7FF" x:Key="Office2007BlueGridBackground"/>

    <Style TargetType="local:OlapGridExpandHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridExpandHyperlinkCell">
                    <Grid x:Name="RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19px"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Expanders-->
                        <ToggleButton VerticalAlignment="Top"   x:Name="PART_Expander" Margin="4,2,0,5" Style="{Binding Path=ExpanderStyle,RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                          Visibility="{Binding Path=HasChildren,RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!--Textblock of expander cells-->
                        <TextBlock Margin="1,0,2,0" 
                                   x:Name="PART_InnerTextBlock" 
                                   Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CellDescriptor.CellValue}"
                                   Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}" />
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="PART_ContextMenuAdv" Visibility="Collapsed" 
                                                        Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                                        Background="{Binding Path=Background,RelativeSource={RelativeSource TemplatedParent}}">
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="ToggleButton" x:Key="ExpanderStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="{StaticResource ButtonHoverBorderBrush1}"/>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" CornerRadius="2" Width="11" BorderThickness="1" BorderBrush="#FF3F576F">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.792,0.86" StartPoint="0.101,0.088">
                                    <GradientStop Color="White" Offset="0.229"/>
                                    <GradientStop Color="#FFB0C8F0" Offset="0.974"/>
                                </LinearGradientBrush>
                            </Border.Background>
                           
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" >
                                    <Path Margin="0" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="Black" Name="UncheckedVisual" />
                                    <Path Margin="0" Data="M0,2L0,3 5,3 5,2z" 
                                              Fill="Black" Name="CheckedVisual" />
                                </Grid>
                    
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style 
        TargetType="local:OlapGrid">
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Office2007Blue.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.ColumnHeaderForegroundBrush}" 
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Office2007Blue.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryColumnStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Office2007Blue.SummaryColumnBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.SummaryColumnForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryRowStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Office2007Blue.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.SummaryRowForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Office2007Blue.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.ValueCellForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="GridLineStroke"  Value="{StaticResource Office2007Blue.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderStyle}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueGridBackground}"/>
    </Style>
</ResourceDictionary>
