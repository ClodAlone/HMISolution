    <!--OlapArea-->
    <Style TargetType="local:OlapArea">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapArea">
                    <Grid>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25*"/>
                                    <RowDefinition Height="75*"/>
                                </Grid.RowDefinitions>
                                <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding EffectsBrush}" Width="{Binding Width}" Height="{Binding Height}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableChartAreaEffects, Converter={StaticResource boolvisibilityconverter}}"/>
                                <syncfusion:ChartDockPanel x:Name="ChartArea_dock" LastChildFill="True" Background="Transparent" Grid.Row="0" Grid.RowSpan="2" >
                                    <ContentPresenter x:Name="ChartHeader" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" syncfusion:ChartDockPanel.Dock="Top" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="ChartLegends" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  Content="{TemplateBinding Legends}"
                                                  syncfusion:ChartDockPanel.Dock="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends.DockPosition}" 
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends, Converter={StaticResource legendvisible}}"/>

                                    <Grid x:Name="LayoutRoot" Background="Transparent" Margin="5,15,15,5">
                                        <syncfusion:ChartAreaWatermarkControl x:Name="watermarkControl" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}">
                                            <syncfusion:ChartAreaWatermarkControl.Background>
                                                <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkContentConverter}, ConverterParameter=Image}" 
                                                            AlignmentX="{TemplateBinding WatermarkAlignmentX}" AlignmentY="{TemplateBinding WatermarkAlignmentY}"
                                                            Opacity="{TemplateBinding WatermarkOpacity}" Stretch="{TemplateBinding WatermarkImageStretch}">
                                                    <ImageBrush.RelativeTransform>
                                                        <RotateTransform Angle="{TemplateBinding WatermarkRotationAngle}" CenterX="0.5" CenterY="0.5"></RotateTransform>
                                                    </ImageBrush.RelativeTransform>
                                                </ImageBrush>
                                            </syncfusion:ChartAreaWatermarkControl.Background>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkContentConverter}, ConverterParameter=Text}" 
                                                       Opacity="{TemplateBinding WatermarkOpacity}" FontSize="{TemplateBinding WatermarkTextFontSize}" RenderTransformOrigin="0.5,0.5"
                                                       FontFamily="{TemplateBinding WatermarkTextFontFamily}" FontWeight="{TemplateBinding WatermarkTextFontWeight}"
                                                       HorizontalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkAlignmentConverter}, ConverterParameter=AlignmentX}" 
                                                       VerticalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkAlignmentConverter}, ConverterParameter=AlignmentY}">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{TemplateBinding WatermarkRotationAngle}"></RotateTransform>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </syncfusion:ChartAreaWatermarkControl>

                                        <syncfusion:StripLinePanel x:Name="stripLinePanel" Background="{TemplateBinding GridBackground}" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}" Area="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=.}"  />

                                        <syncfusion:SmallTickLinesPanel x:Name="smalltickgridLinesPanel" Background="Transparent" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}" Visibility="Visible" />
                                        <syncfusion:ChartAxesGridLinesPanel x:Name="gridLinesPanel" Background="Transparent" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}"/>
                                        <Grid x:Name="InternalCanvas" Background="Transparent" Margin="{TemplateBinding AxesThickness}" IsHitTestVisible="True" Canvas.ZIndex="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ItemsControl ItemsSource="{TemplateBinding Series}" x:Name="ItemsControlSeries">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <ItemsControl x:Name="interactiveCursor"  ItemsSource="{TemplateBinding InteractiveCursors}" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid Background="Transparent"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <Canvas Name="secondaryaxis" Height="auto" Width="auto"  />

                                            <syncfusion:ZoomingToolKit x:Name="ZoomTool" Visibility="Visible" HorizontalAlignment="Left" VerticalAlignment="Top" />

                                            <syncfusion:ZoomingScrollBar x:Name="HorizontalBar" Orientation="Horizontal" Grid.Row="1"  Visibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                                            <syncfusion:ZoomingScrollBar x:Name="VerticalBar" Orientation="Vertical" Grid.Column="1" Visibility="{TemplateBinding VerticalScrollBarVisibility}"/>

                                            <Rectangle Fill="#FFE9EEF4" Grid.Column="1" Grid.Row="1"/>

                                            <Grid x:Name="rangeSelectionGrid">
                                                <Button x:Name="RangeSelectionClose" Width="15" Height="15" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="{TemplateBinding CloseButtonVisibility}" Margin="{TemplateBinding RangeSelectionMargin}" >
                                                    <Button.Template>
                                                        <ControlTemplate>
                                                            <Grid Background="Transparent">
                                                                <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/RangeSelectionClose.png" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <ContentPresenter x:Name="rangeSelection" IsHitTestVisible="False" Height="{TemplateBinding RangeSelectionHeight}" Width="{TemplateBinding RangeSelectionWidth}" VerticalAlignment="Top" HorizontalAlignment="Left" ContentTemplate="{TemplateBinding RangeSelectionTemplate}"  Margin="{TemplateBinding RangeSelectionMargin}">
                                                </ContentPresenter>

                                                <ContentPresenter x:Name="rangeSelectionMouseOver" IsHitTestVisible="False" Height="{TemplateBinding RangeSelectionMouseOverHeight}" Width="{TemplateBinding RangeSelectionMouseOverWidth}" VerticalAlignment="Top" HorizontalAlignment="Left" ContentTemplate="{TemplateBinding RangeSelectionOnMouseOverTemplate}"  Margin="{TemplateBinding RangeSelectionMouseMoveMargin}" >
                                                </ContentPresenter>
                                            </Grid>

                                        </Grid>

                                        <syncfusion:ChartScaleBreakPresenter x:Name="scaleBreakItemsControl" Margin="{TemplateBinding AxesThickness}"  Area="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                             XAxis="{TemplateBinding PrimaryAxis}" YAxis="{TemplateBinding SecondaryAxis}" Background="{TemplateBinding GridBackground}"
                                                                             IsTabStop="False" ItemsSource="{Binding Breaks, RelativeSource={RelativeSource TemplatedParent}}">
                                            <syncfusion:ChartScaleBreakPresenter.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <syncfusion:ChartScaleBreakPanel x:Name="scaleBreakPanel"/>
                                                </ItemsPanelTemplate>
                                            </syncfusion:ChartScaleBreakPresenter.ItemsPanel>
                                        </syncfusion:ChartScaleBreakPresenter>

                                        <ItemsControl ItemsSource="{TemplateBinding Axes}"  IsHitTestVisible="True" Canvas.ZIndex="0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <syncfusion:ChartAxesPanel Background="Transparent" x:Name="ChartAxis"></syncfusion:ChartAxesPanel>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </syncfusion:ChartDockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


