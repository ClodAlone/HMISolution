                <TextBlock Grid.Column="0" Grid.Row="1" Margin="3,1,2,1" Text="Columns :"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Margin="3,1,2,1" Text="Rows :"/>
                <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="Value :"/>-->
                <TextBlock Grid.Column="0" Grid.Row="0" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=MeasureValue}"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=ColumnValue}"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=RowValue}"/>
                <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=ValueCellValue}"/>

                <TextBlock Grid.Column="1" Grid.Row="0" Text=":"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Text=":"/>
                <TextBlock Grid.Column="1" Grid.Row="2" Text=":"/>
                <TextBlock Grid.Column="1" Grid.Row="3" Text=":"/>
                <!--Tooltip Value region-->
                <TextBlock Grid.Column="2" Grid.Row="0" Margin="3,2,2,1" Text="{Binding Converter={StaticResource ToolTipConverter}, ConverterParameter='Measure', Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Margin="3,1,2,1" Text="{Binding Converter={StaticResource ToolTipConverter}, ConverterParameter='Columns', Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Grid.Row="2" Margin="3,1,2,1" Text="{Binding Converter={StaticResource ToolTipConverter}, ConverterParameter='Rows', Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource ToolTipConverter}, ConverterParameter='Value', Mode=OneWay}"/>
            </Grid>
        </Border>
    </Popup>

    <Popup x:Key="HeaderToolTipPopup" >
        <Border BorderThickness="1" BorderBrush="Black" Background="White" CornerRadius="5" >
            <Grid Background="White" Margin="5" Visibility="{Binding  Path=CellDescriptor.CellValue, FallbackValue=Collapsed, Converter={StaticResource FallbackValueToVisibilityConverter }}">
                <TextBlock Grid.Column="0" Grid.Row="0" Margin="3,2,2,1" 
                           Text="{Binding Converter={StaticResource toolTipDateTimeConverter}}" /> 
            </Grid>
        </Border>
    </Popup>
</ResourceDictionary>