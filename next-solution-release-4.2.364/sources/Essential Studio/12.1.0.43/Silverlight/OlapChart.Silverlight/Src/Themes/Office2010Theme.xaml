                                <Setter Property="EnableEffects" Value="true"/>


                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="TransparentGridBackground" Color="#72FFFFFF"/>

    <LinearGradientBrush   x:Key="Transparent.ChartBackground" EndPoint="0.961,0.933" StartPoint="0.009,0.027">
        <GradientStop Color="#4CFFFFFF" Offset="0"/>
        <GradientStop Color="#7FFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="sync:Chart" x:Key="TransparentStyle" >
        <Setter Property="AreaStyle">
            <Setter.Value>
                <Style TargetType="sync:ChartArea">
                    <Setter Property="Background" Value="{StaticResource Transparent.ChartBackground}"/>
                    <Setter Property="BorderBrush" Value="#FF000000"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#FF000000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="GridBackground" Value="{StaticResource TransparentGridBackground}"/>
                    <Setter Property="EnableChartAreaEffects" Value="True"/>
                    <Setter Property="LegendStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartLegend">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#33A7A7A7" Offset="1"/>
                                            <GradientStop Color="#BFFDFBF0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#FF000000"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="PrimaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="#FF000000"/>
                                <Setter Property="LineStroke" Value="#FF000000"/>
                                <Setter Property="SmallTicksStroke" Value="#FF000000"/>
                                <Setter Property="GridLineStroke" Value="#FF000000"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SecondaryAxisStyle">
                        <Setter.Value>
                            <Style  TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="#FF000000"/>
                                <Setter Property="LineStroke" Value="#FF000000"/>
                                <Setter Property="SmallTicksStroke" Value="#FF000000"/>
                                <Setter Property="GridLineStroke" Value="#FF000000"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
