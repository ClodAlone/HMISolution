<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sync="clr-namespace:Syncfusion.Windows.Chart;assembly=Syncfusion.Chart.Silverlight">

    <SolidColorBrush x:Key="Office2010SilverGridBackground" Color="#FFFFFFFF"/>
    <LinearGradientBrush   x:Key="Office2010Silver.ChartBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF3F5F7" Offset="0"/>
        <GradientStop Color="#FFEEF1F5" Offset="0.834"/>
        <GradientStop Color="#FFEDF0F4" Offset="1"/>
    </LinearGradientBrush>
    
    <Style TargetType="sync:Chart" x:Key="Office2010SilverStyle" >
        <Setter Property="AreaStyle">
            <Setter.Value>
                <Style TargetType="sync:ChartArea">
                    <Setter Property="Background" Value="{StaticResource Office2010Silver.ChartBackground}"/>
                    <Setter Property="BorderBrush" Value="#FFA5ACB5"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#FF1E395B"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="GridBackground" Value="{StaticResource Office2010SilverGridBackground}"/>
                    <Setter Property="EnableChartAreaEffects" Value="True"/>
                    <Setter Property="LegendStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartLegend">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#FFA5ACB5"/>
                                <Setter Property="Foreground" Value="#FF1E395B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="PrimaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="#FF1E395B"/>
                                <Setter Property="LineStroke" Value="#FFA5ACB5"/>
                                <Setter Property="SmallTicksStroke" Value="#FFA5ACB5"/>
                                <Setter Property="GridLineStroke" Value="#FFA5ACB5"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SecondaryAxisStyle">
                        <Setter.Value>
                            <Style  TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="#FF1E395B"/>
                                <Setter Property="LineStroke" Value="#FFA5ACB5"/>
                                <Setter Property="SmallTicksStroke" Value="#FFA5ACB5"/>
                                <Setter Property="GridLineStroke" Value="#FFA5ACB5"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SeriesStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartSeries">

                                <Setter Property="StrokeThickness" Value="0"/>
                                <Setter Property="EnableEffects" Value="true"/>


                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="Office2010BlackGridBackground" Color="#FFFFFFFF"/>
    <LinearGradientBrush   x:Key="Office2010Black.ChartBackground"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="Gray" Offset="0"/>
        <GradientStop Color="#FF3B3B3B" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="sync:Chart" x:Key="Office2010BlackStyle" >
        <Setter Property="AreaStyle">
            <Setter.Value>
                <Style TargetType="sync:ChartArea">
                    <Setter Property="Background" Value="{StaticResource Office2010Black.ChartBackground}"/>
                    <Setter Property="BorderBrush" Value="#FF3B3B3B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="GridBackground" Value="{StaticResource Office2010BlackGridBackground}"/>
                    <Setter Property="EnableChartAreaEffects" Value="True"/>
                    <Setter Property="LegendStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartLegend">
                                <Setter Property="Background" Value="Transparent" >

                                </Setter>
                                <Setter Property="BorderBrush" Value="#FF3B3B3B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="PrimaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="White"/>
                                <Setter Property="LineStroke" Value="#FF3B3B3B"/>
                                <Setter Property="SmallTicksStroke" Value="#FF3B3B3B"/>
                                <Setter Property="GridLineStroke" Value="#FF3B3B3B"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SecondaryAxisStyle">
                        <Setter.Value>
                            <Style  TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="White"/>
                                <Setter Property="LineStroke" Value="#FF3B3B3B"/>
                                <Setter Property="SmallTicksStroke" Value="#FF3B3B3B"/>
                                <Setter Property="GridLineStroke" Value="#FF3B3B3B"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SeriesStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartSeries">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="StrokeThickness" Value="0"/>
                                <Setter Property="EnableEffects" Value="true"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>


    <SolidColorBrush x:Key="Office2010BlueGridBackground"  Color="#FFFFFFFF"/>
    <LinearGradientBrush   x:Key="Office2010Blue.ChartBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEDF3F9" Offset="0"/>
        <GradientStop Color="#FFE1EBF8" Offset="0.959"/>
        <GradientStop Color="#FFE0EAF8" Offset="1"/>
    </LinearGradientBrush>

