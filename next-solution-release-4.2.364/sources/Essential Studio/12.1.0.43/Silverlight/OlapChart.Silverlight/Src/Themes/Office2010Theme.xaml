    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroThemeChartBorderBrush"/>
    <SolidColorBrush x:Key="MetroThemeChartBackground" Color="White"/>
    <SolidColorBrush x:Key="MetroThemeForeground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroThemeChartAreaBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="MetroThemeChartAreaBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="BlendChartBackgroundBrush" Color="#FF404040"/>
    <SolidColorBrush  x:Key="MetroThemeLegendBackground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroThemeLegendForeground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroThemeAxisForeground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroThemeLegendBorderBrush"  Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="MetroThemeGridLineStroke" Color="#FFCCCCCC"/>

    <Style TargetType="sync:Chart" x:Key="MetroStyle">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroThemeChartBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MetroThemeForeground}"/>
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="Segoe WP"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="AreaStyle">
            <Setter.Value>
                <Style TargetType="sync:ChartArea">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="GridBackground" Value="White"/>
                    <Setter Property="LegendStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartLegend">
                                <Setter Property="Background" Value="{StaticResource MetroThemeLegendBackground}">
                                </Setter>
                                <Setter Property="BorderBrush" Value="{StaticResource MetroThemeLegendForeground}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource MetroThemeLegendForeground}"/>
                                <Setter Property="FontFamily" Value="Segoe WP"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="LegendIcon" Value="Rectangle"/>
                                <Setter Property="DockPosition" Value="Top"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="PrimaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="{StaticResource MetroThemeAxisForeground}"/>
                                <Setter Property="FontFamily" Value="Segoe WP"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="ShowGridLines" Value="true"/>
                                <Setter Property="GridLineStroke" Value="{StaticResource MetroThemeGridLineStroke}"/>
                                <Setter Property="LineStroke" Value="{StaticResource MetroThemeGridLineStroke}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SecondaryAxisStyle">
                        <Setter.Value>
                            <Style  TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="{StaticResource MetroThemeAxisForeground}"/>
                                <Setter Property="FontFamily" Value="Segoe WP"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="GridLineStroke" Value="{StaticResource MetroThemeGridLineStroke}"/>
                                <Setter Property="LineStroke" Value="{StaticResource MetroThemeGridLineStroke}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SeriesStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartSeries">
                                <Setter Property="Stroke" Value="Blue" />
                                <Setter Property="StrokeThickness" Value="0"/>
                                <Setter Property="EnableEffects" Value="True"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
