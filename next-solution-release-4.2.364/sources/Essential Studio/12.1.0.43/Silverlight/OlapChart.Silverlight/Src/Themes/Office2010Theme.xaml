        <Setter Property="AreaStyle">
            <Setter.Value>
                <Style TargetType="sync:ChartArea">
                    <Setter Property="Background" Value="{StaticResource Office2010Blue.ChartBackground}"/>
                    <Setter Property="BorderBrush" Value="#FF849DBD"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#FF1E395B"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="GridBackground" Value="{StaticResource Office2010BlueGridBackground}"/>
                    <Setter Property="EnableChartAreaEffects" Value="True"/>
                    <Setter Property="LegendStyle">
