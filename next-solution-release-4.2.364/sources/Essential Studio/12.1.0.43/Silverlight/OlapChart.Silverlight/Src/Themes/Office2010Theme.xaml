                            <Style TargetType="sync:ChartLegend">
                                <Setter Property="Background" Value="Transparent" >

                                </Setter>
                                <Setter Property="BorderBrush" Value="#FF849DBD"/>
                                <Setter Property="Foreground" Value="#FF1E395B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="PrimaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="#FF1E395B"/>
                                <Setter Property="LineStroke" Value="#FF849DBD"/>
                                <Setter Property="SmallTicksStroke" Value="#FF849DBD"/>
                                <Setter Property="GridLineStroke" Value="#FF849DBD"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
                                <Setter Property="GridLineStrokeThickness" Value="0.25"/>
                                <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SecondaryAxisStyle">
                        <Setter.Value>
                            <Style  TargetType="sync:ChartAxis">
                                <Setter Property="LabelForeground" Value="#FF1E395B"/>
                                <Setter Property="LineStroke" Value="#FF849DBD"/>
                                <Setter Property="SmallTicksStroke" Value="#FF849DBD"/>
                                <Setter Property="GridLineStroke" Value="#FF849DBD"/>
                                <Setter Property="LineStrokeThickness" Value="0.25"/>
