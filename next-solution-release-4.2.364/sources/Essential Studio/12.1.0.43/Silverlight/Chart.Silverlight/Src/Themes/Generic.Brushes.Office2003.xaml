<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">

    <LinearGradientBrush EndPoint="0.503,0.941" StartPoint="0.5,-0.061" x:Key="Office2003EffectsColor">
        <GradientStop Color="#E5FFFFFF" Offset="0.057"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1.152" StartPoint="0.5,0" x:Key="Office2003ChartAreaBackground">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#B2F1F4FA" Offset="0.074432373046875"/>
        <GradientStop Color="#99E5EAF6" Offset="0.21"/>
        <GradientStop Color="#00DAE2F3" Offset="0.213"/>
        <GradientStop Color="#00D2DCF0" Offset="0.996"/>
        <GradientStop Color="sc#1, 0.630757153, 0.708375752, 0.8713671" Offset="1"/>
        <GradientStop Color="#00D0DBF0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Key="Office2003ChartBackground">
        <GradientStop Color="#FFD3E6FD" Offset="0"/>
        <GradientStop Color="sc#1, 0.5525114, 0.70105505, 0.9601539" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.4672382, 0.623241663, 0.941100657" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.39828968, 0.560324848, 0.925695" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.351327181, 0.517470658, 0.9152018" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.341914415, 0.50888133, 0.913098633" Offset="1"/>
        <GradientStop Color="#FF9EBDF5" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.04" StartPoint="0.5,0.051" x:Key="Office2003AreaGridBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#4885BB" x:Key="Office2003.ChartBorderBackground"/>

    <LinearGradientBrush EndPoint="0.5,-0.676" StartPoint="0.5,0.427" x:Key="Office2003.LegendBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2003.AreaBorderBackground"
               Color="#2971AD"/>
    
    <Style TargetType="syncfusion:Chart" x:Key="Chart">
        <Setter Property="Background" Value="{StaticResource Office2003ChartBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2003.ChartBorderBackground}"/>
    </Style>
    
    <Style TargetType="syncfusion:ChartLegend" x:Key="ChartLegend">
        <Setter Property="Background" Value="{StaticResource Office2003.LegendBackground}"/>
        <Setter Property="BorderBrush" Value="#FFA0BEE4"/>
        <Setter Property="Foreground" Value="#FF0D55E2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    
    <Style TargetType="syncfusion:ChartArea" x:Key="ChartArea">
        <Setter Property="BorderBrush" Value="{StaticResource Office2003.AreaBorderBackground}"/>
        <Setter Property="GridBackground" Value="White"/>
        <Setter Property="Foreground" Value="#FF0D55E2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="EffectsBrush" Value="{StaticResource Office2003EffectsColor}"/>
        <Setter Property="EnableChartAreaEffects" Value="True"/>
    </Style>
    
    <Style TargetType="syncfusion:ChartAxis" x:Key="ChartAxis">
        <Setter Property="LineStroke" Value="#FFCCCDCE"/>
        <Setter Property="SmallTicksStroke" Value="#FFCCCDCE"/>
        <Setter Property="GridLineStroke" Value="#FFCCCDCE"/>
        <Setter Property="LineStrokeThickness" Value="0.5"/>
        <Setter Property="GridLineStrokeThickness" Value="0.5"/>
        <Setter Property="SmallTicksStrokeThickness" Value="0.5"/>
        <Setter Property="LabelForeground" Value="#FF0D55E2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style TargetType="syncfusion:ChartSeries" x:Key="ChartSeries">
        <Setter Property="Stroke" Value="#8A53564F"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

</ResourceDictionary>
