<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:toolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">

    <LinearGradientBrush EndPoint="0.503,0.941" StartPoint="0.5,-0.061" x:Key="BlendChartEffectsColor">
        <GradientStop Color="#E5FFFFFF" Offset="0.057"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Key="BlendChartBackground">
        <GradientStop Color="#FF9D9FA2" Offset="0"/>
        <GradientStop Color="sc#1, 0.310883969, 0.3196818, 0.3337868" Offset="0.505096435546875"/>
        <GradientStop Color="sc#1, 0.255985469, 0.263231933, 0.276297152" Offset="0.70152944326400757"/>
        <GradientStop Color="sc#1, 0.183499828, 0.188697964, 0.200390309" Offset="0.84482598304748535"/>
        <GradientStop Color="sc#1, 0.09702131, 0.09977569, 0.109830141" Offset="0.96215355396270752"/>
        <GradientStop Color="sc#1, 0.06301001, 0.06480327, 0.0742135644" Offset="1"/>
        <GradientStop Color="#FF47484D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1.152" StartPoint="0.5,0" x:Key="BlendAreaBackground">
        <GradientStop Color="#E5FFFFFF" Offset="0"/>
        <GradientStop Color="#66E6E6E7" Offset="0.074432373046875"/>
        <GradientStop Color="#4CCDCECF" Offset="0.213"/>
        <GradientStop Color="#00B5B7B8" Offset="0.217"/>
        <GradientStop Color="#00A2A5A7" Offset="1"/>
        <GradientStop Color="sc#1, 0.341914415, 0.356400132, 0.3662526" Offset="1"/>
        <GradientStop Color="#009EA1A3" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.676" StartPoint="0.5,0.427" x:Key="Blend.LegendBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#FFD5D7D8" x:Key="BlendChartBorderBrush"/>

    <Style TargetType="syncfusion:Chart" x:Key="Chart">
        <Setter Property="Background" Value="#FF595959"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlendChartBorderBrush}"/>
    </Style>

    <SolidColorBrush x:Key="Blend.AreaBorderBackground"
                   Color="Transparent"/>

    <SolidColorBrush x:Key="Blend.AreaBackground"
                   Color="Transparent"/>

    <LinearGradientBrush EndPoint="0.5,-0.04" StartPoint="0.5,0.051" x:Key="BlendAreaGridBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="#CCDADBDC" Offset="0.78167599439620972"/>
        <GradientStop Color="#CCDBDEE0" Offset="1"/>
    </LinearGradientBrush>
    
    <Style TargetType="syncfusion:ChartArea" x:Key="ChartArea">
        <Setter Property="BorderBrush" Value="{StaticResource Blend.AreaBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Blend.AreaBackground}"/>
        <Setter Property="GridBackground" Value="#FFE6E6E6"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="EffectsBrush" Value="Transparent"/>
        <Setter Property="EnableChartAreaEffects" Value="False"/>
    </Style>

    <Style TargetType="syncfusion:ChartLegend" x:Key="ChartLegend">
        <Setter Property="Background" Value="{StaticResource Blend.LegendBackground}"/>
        <Setter Property="BorderBrush" Value="#FFA0BEE4"/>
        <Setter Property="Foreground" Value="#FF15428B"/>
    </Style>
    
    <Style TargetType="syncfusion:ChartAxis" x:Key="ChartAxis">
        <Setter Property="LabelForeground" Value="White"/>
        <Setter Property="GridLineStroke" Value="Black"/>
        <Setter Property="LineStroke" Value="Black"/>
        <Setter Property="GridLineStrokeThickness" Value="0.25"/>
        <Setter Property="LineStrokeThickness" Value="0.25"/>
        <Setter Property="SmallTicksStroke" Value="Transparent"/>
    </Style>


    <SolidColorBrush x:Key="Blend.ZoomingToolkitBackground"
                   Color="Transparent"/>

    <Style TargetType="syncfusion:ZoomingToolKit" x:Key="ZoomingToolkit">
        <Setter Property="Background" Value="{StaticResource Blend.ZoomingToolkitBackground}"/>
    </Style>

    <Style TargetType="syncfusion:ChartSeries" x:Key="ChartSeries">
        <Setter Property="Stroke" Value="#8A53564F"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>
</ResourceDictionary>

