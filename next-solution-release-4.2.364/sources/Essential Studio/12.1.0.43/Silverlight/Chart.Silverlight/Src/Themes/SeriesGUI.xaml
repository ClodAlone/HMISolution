                    <RadialGradientBrush Center="0.554,0.302" GradientOrigin="0.535,0.134" RadiusX="1.03" RadiusY="0.812">
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <SkewTransform AngleX="0" AngleY="0" CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <RotateTransform Angle="-34.7" CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <TranslateTransform X="0"/>
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                        <GradientStop Color="#7FF4F2F2" Offset="0.233"/>
                        <GradientStop Color="#BFFFFFFF"/>
                        <GradientStop Color="#4CB1ABAB" Offset="0.471"/>
                        <GradientStop Color="#3FE4D7D7" Offset="0.722"/>
                        <GradientStop Color="#33E4D7D7" Offset="0.583"/>
                        <GradientStop Color="#26E4D7D7" Offset="0.717"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="Scatter">
        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Canvas.Left="{Binding X1}" Canvas.Top="{Binding Y1}" Width="{Binding X2}" Height="{Binding Y2}"
                     Opacity="{Binding Opacity}"/>
            <Popup IsOpen="False" Opacity="0.5" OpacityMask="Transparent">
                <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Width="{Binding X2}" Height="{Binding Y2}"
                     Opacity="0.5"/>
            </Popup>
        </Canvas>
    </DataTemplate>

