    <DataTemplate x:Key="Column">
        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  
                 Fill="{Binding Interior}" Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="{Binding Opacity}"/>
            <Rectangle Visibility="{Binding Series.EnableEffects, Converter={StaticResource BooltoVisible}}" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  
                  Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="{Binding Opacity}">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint='1.58,0.5' StartPoint='-0.436,0.5'>
                        <GradientStop Color='#26675A5A' Offset='0.275'/>
                        <GradientStop Color='#26675A5A' Offset='0.652'/>
                        <GradientStop Color='#33B3ACAC' Offset='0.252'/>
                        <GradientStop Color='#33B3ACAC' Offset='0.672'/>
                        <GradientStop Color='#25282323' Offset='0.47'/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Popup IsOpen="False" Opacity="0.5" OpacityMask="Transparent">
                <Rectangle Fill="{Binding Interior}" Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="0.5"/>
            </Popup>
            <Path Visibility="{Binding Series.EnableEffects, Converter={StaticResource BooltoVisible}}" Data="M200,200 L300,200 290,205 210,205" Stroke="Transparent" Stretch="Fill" Height="{Binding Height,Converter={StaticResource EnableEffectWidthConverter}}"  Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  Width="{Binding Width}"
                     Opacity="{Binding Opacity}">
                <Path.Fill>
                    <LinearGradientBrush EndPoint="0.5,1.908" StartPoint="0.5,0">
                        <GradientStop Color="#33D7D0D0" Offset="0.296"/>
                        <GradientStop Color="#3FEAE5E5" Offset="0.561"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </DataTemplate>

    <!--LineChartTemplate-->
    <DataTemplate x:Key="Line_Effects">
        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding X1}" X2="{Binding X2}" Y1="{Binding Y1}" Y2="{Binding Y2}"
                  Opacity="{Binding Opacity}"/>
            <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" Canvas.Left="{Binding X1, Converter={StaticResource Effects}}" Canvas.Top="{Binding Y1, Converter={StaticResource Effects}}" StrokeThickness="{Binding StrokeThickness}" Width="10" Height="10" Opacity="{Binding Opacity}" Visibility="{Binding Series.AdditionalEffectVisibility}">
               
            </Ellipse>
            <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" Canvas.Left="{Binding X2, Converter={StaticResource Effects}}" Canvas.Top="{Binding Y2, Converter={StaticResource Effects}}" StrokeThickness="{Binding StrokeThickness}" Width="10" Height="10" Opacity="{Binding Opacity}" Visibility="{Binding Series.AdditionalEffectVisibility}">

            </Ellipse>
        </Canvas>
    </DataTemplate>
    
    <DataTemplate x:Key="Line">
        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding X1}" X2="{Binding X2}" Y1="{Binding Y1}" Y2="{Binding Y2}"
                  Opacity="{Binding Opacity}"/>
        </Canvas>
    </DataTemplate>

    <!--ScatterChartTemplate-->
    <DataTemplate x:Key="Scatter_Effects">
        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Canvas.Left="{Binding X1}" Canvas.Top="{Binding Y1}" Width="{Binding X2}" Height="{Binding Y2}"
                     Opacity="{Binding Opacity}"/>
            <Ellipse Stroke="Transparent" StrokeThickness="0" Canvas.Left="{Binding X1}" Canvas.Top="{Binding Y1}" Width="{Binding X2}" Height="{Binding Y2}"
                     Opacity="{Binding Opacity}" Visibility="{Binding Series.AdditionalEffectVisibility}">
