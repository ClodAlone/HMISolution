    <DataTemplate x:Key="Bar">
        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  
                 Fill="{Binding Interior}" Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="{Binding Opacity}"/>
            <Rectangle Visibility="{Binding Series.EnableEffects, Converter={StaticResource BooltoVisible}}" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  
                  Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="{Binding Opacity}">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint='0.5,1.58' StartPoint='0.5,-0.436'>
                        <GradientStop Color='#26675A5A' Offset='0.33'/>
                        <GradientStop Color='#26675A5A' Offset='0.601'/>
                        <GradientStop Color='#33B3ACAC' Offset='0.3'/>
                        <GradientStop Color='#33B3ACAC' Offset='0.635'/>
                        <GradientStop Color='#25282323' Offset='0.47'/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Popup IsOpen="False" Opacity="0.5" OpacityMask="Transparent">
                <Rectangle 
                 Fill="{Binding Interior}" Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="0.5"/>
            </Popup>
            <Path  Data="M200,200 L200,300 190,280 190,220" Stroke="Transparent" Stretch="Fill" Width="{Binding Width,Converter={StaticResource EnableEffectWidthConverter}}"  Canvas.Left="{Binding XWidth}" Canvas.Top="{Binding Y}"  Height="{Binding Height}"
                   Visibility="{Binding Series.EnableEffects, Converter={StaticResource BooltoVisible}}" Opacity="{Binding Opacity}">
                <Path.RenderTransform>
                    <TranslateTransform X="-10"/>
                </Path.RenderTransform>
                <Path.Fill>
                    <LinearGradientBrush EndPoint="0.5,1.908" StartPoint="0.5,0">
                        <GradientStop Color="#33D7D0D0" Offset="0.296"/>
                        <GradientStop Color="#3FEAE5E5" Offset="0.561"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </DataTemplate>

    <!--StackingColumnChartTemplate-->
    <DataTemplate x:Key="StackingColumn_Effects">

        <Canvas Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  
                 Fill="{Binding Interior}" Width="{Binding Width}" Height="{Binding Height}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                       Opacity="{Binding Opacity}"/>
            <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  
                 Width="{Binding Width}" Height="{Binding Height}" Stroke="Transparent" StrokeThickness="0"
                       Opacity="{Binding Opacity}" Visibility="{Binding Series.AdditionalEffectVisibility}">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="1.58,0.5" StartPoint="-0.436,0.5">
                        <GradientStop Color="#26675A5A" Offset="0.275"/>
                        <GradientStop Color="#26675A5A" Offset="0.652"/>
                        <GradientStop Color="#33B3ACAC" Offset="0.252"/>
                        <GradientStop Color="#33B3ACAC" Offset="0.672"/>
                        <GradientStop Color="#25282323" Offset="0.47"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Path  Data="M200,200 L300,200 290,205 210,205" Stroke="Transparent" Stretch="Fill" Height="{Binding Height,Converter={StaticResource EnableEffectWidthConverter}}"  Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"  Width="{Binding Width}"
                    Visibility="{Binding Series.AdditionalEffectVisibility}" Opacity="{Binding Opacity}">
                <Path.Fill>
                   <LinearGradientBrush EndPoint="0.5,1.908" StartPoint="0.5,0">
