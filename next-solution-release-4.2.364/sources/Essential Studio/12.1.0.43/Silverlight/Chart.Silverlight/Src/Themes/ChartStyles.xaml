    <SolidColorBrush Color="Black" x:Key="GridStroke"/>
    <SolidColorBrush Color="White" x:Key="gridlinestroke"/>


    <Style TargetType="local:Chart" x:Key="GrayScale" >
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontFamily" Value="Calibri"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="AreaStyle">
            <Setter.Value>
                <Style TargetType="local:ChartArea">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontFamily" Value="Calibri"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="LegendStyle">
                        <Setter.Value>
                            <Style TargetType="local:ChartLegend">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontFamily" Value="Calibri"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="LegendIcon" Value="Rectangle"/>
                                <Setter Property="DockPosition" Value="Top"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="PrimaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="local:ChartAxis">
                                <Setter Property="ShowGridLines" Value="true"/>
                                <Setter Property="LabelFontSize" Value="12"/>
                                <Setter Property="LineStroke" Value="{StaticResource GridStroke}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SecondaryAxisStyle">
                        <Setter.Value>
                            <Style TargetType="local:ChartAxis">
                                <Setter Property="ShowGridLines" Value="true"/>
                                <Setter Property="LabelFontSize" Value="12"/>
                                <Setter Property="GridLineStroke" Value="{StaticResource GridStroke}"/>
                                <Setter Property="LineStroke" Value="{StaticResource GridStroke}"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="SeriesStyle">
                        <Setter.Value>
                            <Style TargetType="local:ChartSeries">
                                <Setter Property="StrokeThickness" Value="0"/>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

    </Style>

