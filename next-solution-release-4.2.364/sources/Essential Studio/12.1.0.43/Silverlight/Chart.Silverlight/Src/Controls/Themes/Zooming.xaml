<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">
    
    <Style TargetType="syncfusion:ZoomingScrollBar">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource chartskins}"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:ZoomingScrollBar">
                    <ScrollBar x:Name="PART_ScrollBar" Orientation="{TemplateBinding Orientation}" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Mode=TwoWay}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     SmallChange="{TemplateBinding SmallChange}" LargeChange="{TemplateBinding LargeChange}" ViewportSize="{TemplateBinding ViewportSize}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="syncfusion:ZoomingToolKit">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:ZoomingToolKit">
                    <Grid Background="Transparent" Visibility="{TemplateBinding ZoomingToolkitVisibility}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ViewStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.3">

                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="ZoomInMouseEnter">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomIn" Storyboard.TargetProperty="(UIElement.Width)" To="40" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ZoomInMouseLeave">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomIn" Storyboard.TargetProperty="(UIElement.Width)" To="32" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="ZoomOutMouseEnter">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomOut" Storyboard.TargetProperty="(UIElement.Width)" To="40" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ZoomOutMouseLeave">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomOut" Storyboard.TargetProperty="(UIElement.Width)" To="32" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="ZoomPanMouseEnter">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomPan" Storyboard.TargetProperty="(UIElement.Width)" To="40" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ZoomPanMouseLeave">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomPan" Storyboard.TargetProperty="(UIElement.Width)" To="32" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="ZoomCloseMouseEnter">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomClose" Storyboard.TargetProperty="(UIElement.Width)" To="40" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ZoomCloseMouseLeave">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomClose" Storyboard.TargetProperty="(UIElement.Width)" To="32" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="ZoomResetMouseEnter">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomReset" Storyboard.TargetProperty="(UIElement.Width)" To="40" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ZoomResetMouseLeave">
                                    <Storyboard >
                                        <DoubleAnimation Storyboard.TargetName="ZoomReset" Storyboard.TargetProperty="(UIElement.Width)" To="32" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Background="Transparent" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ZoomClose" Width="30" Visibility="{TemplateBinding ZoomCloseButtonVisibility}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/Close.png" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="ZoomIn" Grid.Column="1" Width="30"  Visibility="{TemplateBinding ZoomInButtonVisibility}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/ZoomIn.png" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="ZoomOut" Grid.Column="2" Width="30" Visibility="{TemplateBinding ZoomOutButtonVisibility}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/ZoomOut.png" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="ZoomReset" Grid.Column="3" Width="30" Visibility="{TemplateBinding ZoomResetButtonVisibility}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/ZoomReset.png" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="ZoomPan" Grid.Column="4" Width="30" Visibility="{TemplateBinding ZoomOutButtonVisibility}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/Hand.png" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
