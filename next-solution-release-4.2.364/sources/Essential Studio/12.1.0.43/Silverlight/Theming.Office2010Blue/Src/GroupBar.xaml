<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <!--Brushes-->

    <SolidColorBrush x:Key="PopUpMenuBorderBrush" Color="#FFAFB2B7"/>

    <SolidColorBrush x:Key="GroupBarItemMouseOverBorderBrush" Color="#FF869FC0"/>

    <SolidColorBrush x:Key="GroupBarItemSelectedBorderBrush" Color="#FF94ABC8"/>

    <LinearGradientBrush x:Key="GroupBarItemPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF8CA5C4" Offset="0.011"/>
        <GradientStop Color="#FF9FB7D6" Offset="0.193"/>
        <GradientStop Color="#FF9FB7D6" Offset="0.945"/>
        <GradientStop Color="#FF94ACCB" Offset="0.989"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GroupBarItemPressedBorderBrush" Color="#FF7B94B2"/>

    <SolidColorBrush x:Key="GroupBarBorderBrush" Color="#FFB5C8DF"/>

    <SolidColorBrush x:Key="GroupBarHeaderBrush" Color="#FFB5C8DF"/>

    <SolidColorBrush x:Key="GroupBarContentBrush" Color="#FFB5C8DF"/>

    <SolidColorBrush x:Key="GroupBarItemNormalStateBrush"
		Color="#FFB5C8DF"/>

    <LinearGradientBrush x:Key="GroupBarItemSelectedBackgroundBrush"
			StartPoint="0,0"
			EndPoint="0,1">
        <GradientStop Color="#FF778DA9" Offset="0.028"/>
        <GradientStop Color="#FFF7F7F7" Offset="0.044"/>
        <GradientStop Color="#FFDCE9F7" Offset="0.044"/>
        <GradientStop Color="#FFC6DAEF" Offset="0.036"/>
        <GradientStop Color="#FFB1C9E3" Offset="0.518"/>
        <GradientStop Color="#FFC9DCEE" Offset="0.952"/>
        <GradientStop Color="#FFDBE9F5" Offset="0.956"/>
        <GradientStop Color="#FFCADAEA" Offset="0.964"/>
        <GradientStop Color="#FF869FBF" Offset="0.976"/>
        <GradientStop Color="#FF778DA9" Offset="0.024"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GroupBarItemMouseOverBackgroundBrush"
			StartPoint="0,0"
			EndPoint="0,1">
        <GradientStop Color="#FF9BB3D2" Offset="0"/>
        <GradientStop Color="#FF89A1C1" Offset="0.029"/>
        <GradientStop Color="#FFE6F0F5" Offset="0.032"/>
        <GradientStop Color="#FFF2FBFE" Offset="0.044"/>
        <GradientStop Color="#FFC2D8EF" Offset="0.521"/>
        <GradientStop Color="#FFCFE1F2" Offset="0.968"/>
        <GradientStop Color="#FFF1FAFC" Offset="0.964"/>
        <GradientStop Color="#FF94ABC8" Offset="0.976"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GroupBarItemMouseOverSelectedBackgroundBrush"
    	StartPoint="0,0"
    	EndPoint="0,1">
        <GradientStop Color="#FFDAEEFB" Offset="0"/>
        <GradientStop Color="#FFBDD3EA" Offset="0.437"/>
        <GradientStop Color="#FFD2E3F2" Offset="0.874"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SplitterBackgroundBrush"
    	StartPoint="0,0"
    	EndPoint="0,1">
        <GradientStop Color="#FFBDD0E9" Offset="0"/>
        <GradientStop Color="#FFD5E6FB" Offset="0.125"/>
        <GradientStop Color="#FFC9DAEF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GroupBarSplitterBrush" Color="#FF8BA4C4"/>

    <SolidColorBrush x:Key="PointBrush" Color="#FF84ACDD"/>

    <LinearGradientBrush x:Key="NavigationToolbarItemMouseOverBrush"
    	StartPoint="0,0"
    	EndPoint="0,1">
        <GradientStop Color="#FFE3EEF4" Offset="0"/>
        <GradientStop Color="#FFF5FDFF" Offset="0.012"/>
        <GradientStop Color="#FFC5DCF1" Offset="0.416"/>
        <GradientStop Color="#FFD2E3F3" Offset="0.938"/>
        <GradientStop Color="#FFF4FCFE" Offset="0.975"/>
        <GradientStop Color="#FFBBCCDE" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NavigationToolbarItemSelectedBackgroundBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="NavigationToolbarItemArrowBrush" Color="#FF4371B0"/>

    <SolidColorBrush x:Key="CollapseArrowColor" Color="#FF4371B0"/>

    <SolidColorBrush x:Key="NavigationPaneMouseOverColor" Color="#FFDBEAF9"/>

    <!--Styles-->

    <Style x:Key="local:NavigationToolbar" TargetType="local:NavigationToolbar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NavigationToolbar">
                    <Grid x:Name="NavToolbar">
                        <Border x:Name="NavigationToolbarHost">
                        </Border>
                        <StackPanel x:Name="NavigationToolbarPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ItemsPresenter/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource local:NavigationToolbar}" TargetType="local:NavigationToolbar"/>

    <Style x:Key="local:NonStackGrid" TargetType="local:NonStackGrid">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NonStackGrid">
                    <Grid x:Name="NonStackModeGrid">
                        <ItemsPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource local:NonStackGrid}" TargetType="local:NonStackGrid"/>

    <Style x:Key="local:NavigationToolbarItem"  TargetType="local:NavigationToolbarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NavigationToolbarItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ImageHost"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource NavigationToolbarItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="ImageHost" To="1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ImageHost"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SelectStates">
                                <VisualState x:Name="Select">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ImageHost"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource NavigationToolbarItemSelectedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unselect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ImageHost"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="ToolBarItem">
                            <Border x:Name="ImageHost" Width="20" Height="20" Background = "{StaticResource GroupBarHeaderBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="EmptyImage" Visibility="Visible" Margin="2" Height="16" Width="16">
                                        <Image x:Name="ToolBarItemImage" Height="16" Width="16" Visibility="Visible"  UseLayoutRounding="False" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource local:NavigationToolbarItem}" TargetType="local:NavigationToolbarItem"/>

    <Style x:Key="local:PopupMenu" TargetType="local:PopupMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PopupMenu">
                    <Popup x:Name="popMenu">
                        <Border x:Name="gridBorder" BorderThickness="1" BorderBrush="{StaticResource PopUpMenuBorderBrush}" >
                            <Border.Effect>
                                <DropShadowEffect
                                Color="#FFBEBEBF"
                                ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid x:Name="popGrid">
                                <Border Background="Transparent">
                                    <StackPanel x:Name="pnlRoot" Background="Transparent">
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource local:PopupMenu}" TargetType="local:PopupMenu"/>


    <Style x:Key="local:StackGrid" TargetType="local:StackGrid">
        <Setter Property="Background" Value="{StaticResource GroupBarContentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:StackGrid">
                    <Grid x:Name="StackModeGrid">
                        <Grid.Resources>
                            <Storyboard x:Key="aniHidePopup" >
                                <DoubleAnimation To="0" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity" />
                            </Storyboard>
                            <Storyboard x:Key="aniMouseOver" >
                                <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.Background).(SolidColorBrush.Color)" To="White" />
                            </Storyboard>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource NavigationToolbarItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemMouseOverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="PopupBorder" To="1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectStates">
                                <VisualState x:Name="Select">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unselect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NavPaneStates">
                                <VisualState x:Name="NavPaneSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource NavigationPaneMouseOverColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NavPaneUnselected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NavPaneMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="#FFFFFFDC" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NavPaneMouseOut">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="MainHostGrid" Background="{TemplateBinding Background}"  Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="HeaderGrid" Background="{StaticResource GroupBarHeaderBrush}" Grid.Row="0" Height="30" >
                                <!--<TextBlock x:Name="ItemHeaderText" Margin="15,2,2,2"  VerticalAlignment="Center"/>-->
                                <ContentControl x:Name="ItemHeaderText" Margin="15,2,2,2"  VerticalAlignment="Center"/>
                                <Border x:Name="CollapseButton" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Right" Width="16" Height="15" Background="Transparent" Visibility="{TemplateBinding AllowCollapseVisibility}">
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="7">
                                        <Path Data="M 3, 0 L 0, 3 3, 6" HorizontalAlignment="Center" Stroke="{StaticResource CollapseArrowColor}" x:Name="PART1_Path1" VerticalAlignment="Center"/>
                                        <Path Data="M 7, 0 L 4, 3 7, 6" HorizontalAlignment="Center" Stroke="{StaticResource CollapseArrowColor}" x:Name="PART1_Path2" VerticalAlignment="Center"/>
                                    </Canvas>
                                </Border>

                                <Border x:Name="ExpandButton" Visibility="Collapsed" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Right" Width="16" Height="15" Background="Transparent">
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="7">
                                        <Path Data="M 1, 0 L 4, 3 1, 6" HorizontalAlignment="Center" Stroke="{StaticResource CollapseArrowColor}" x:Name="PART2_Path1" VerticalAlignment="Center"/>
                                        <Path Data="M 5, 0 L 8, 3 5, 6" HorizontalAlignment="Center" Stroke="{StaticResource CollapseArrowColor}" x:Name="PART2_Path2" VerticalAlignment="Center"/>
                                    </Canvas>
                                </Border>
                            </Grid>

                            <Border x:Name="ItemBorder" Grid.Row="1" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid x:Name="ItemHost">
                                    <Grid x:Name="ItemGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <local:PopupMenu x:Name="NavPanePopup"/>

                                    <ScrollViewer x:Name="NavPaneScrollBar" BorderBrush="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <ContentControl x:Name="NavPanelContent" Margin="0,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ContentControl.Content>
                                                <Grid x:Name="NavPaneGrid" Visibility="Collapsed">
                                                    <Border x:Name="NavPaneBorder"  RenderTransformOrigin="0,0">
                                                        <TextBlock x:Name="NavPaneText" Text="Navigation Pane" TextAlignment="Center" HorizontalAlignment="Center" Visibility="{TemplateBinding ShowNavigationPaneTextVisibility}">
                                                        </TextBlock>
                                                    </Border>
                                                    <Grid.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Grid.RenderTransform>
                                                </Grid>
                                            </ContentControl.Content>
                                        </ContentControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="GroupBarSplitter" Grid.Row="2" Background="{StaticResource SplitterBackgroundBrush}" BorderBrush="{StaticResource GroupBarSplitterBrush}" BorderThickness="1" Height="7" HorizontalAlignment="Stretch">
                            <Border Grid.Row="2" Width="25" Height="7" HorizontalAlignment="Stretch">
                                <Canvas Margin="2,0,0,0">
                                    <Line X1="1" Y1="1" X2="3" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="5" Y1="1" X2="7" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="9" Y1="1" X2="11" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="13" Y1="1" X2="15" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="17" Y1="1" X2="19" Y2="2" Stroke="White" StrokeThickness="2"/>

                                    <Line X1="0" Y1="2" X2="2" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="4" Y1="2" X2="6" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="8" Y1="2" X2="10" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="12" Y1="2" X2="14" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="16" Y1="2" X2="18" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                </Canvas>
                            </Border>
                        </Border>

                        <Grid x:Name="ItemsGrid" Grid.Row="3">
                            <Border x:Name="StackItemsHost" Grid.Row="3" >
                            </Border>
                            <ItemsPresenter/>
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal"  Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        </StackPanel>

                        <StackPanel x:Name="NavPanel" Grid.Row="4" Orientation="Horizontal" Background="{StaticResource GroupBarHeaderBrush}" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <StackPanel x:Name="NavigationToolBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            </StackPanel>
                            <StackPanel x:Name="DropDownMenu" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="PopupBorder" HorizontalAlignment="Left" Height="20" Width="20" Margin="2" BorderThickness="1" BorderBrush="{StaticResource GroupBarHeaderBrush}" Background="{StaticResource GroupBarHeaderBrush}">
                                    <Canvas Width="5" Height="3" VerticalAlignment="Center"	HorizontalAlignment="Center">
                                        <Line X1="0" Y1="1" X2="5" Y2="1" StrokeThickness="1" Stroke="{StaticResource NavigationToolbarItemArrowBrush}"/>
                                        <Line X1="1" Y1="2" X2="4" Y2="2" StrokeThickness="1" Stroke="{StaticResource NavigationToolbarItemArrowBrush}"/>
                                        <Line X1="2" Y1="3" X2="3" Y2="3" StrokeThickness="1" Stroke="{StaticResource NavigationToolbarItemArrowBrush}"/>

                                        <Line X1="0" Y1="0" X2="5" Y2="0" StrokeThickness="1" Stroke="{StaticResource NavigationToolbarItemArrowBrush}"/>
                                        <Line X1="1" Y1="1" X2="4" Y2="1" StrokeThickness="1" Stroke="{StaticResource NavigationToolbarItemArrowBrush}"/>
                                        <Line X1="2" Y1="2" X2="3" Y2="2" StrokeThickness="1" Stroke="{StaticResource NavigationToolbarItemArrowBrush}"/>
                                    </Canvas>
                                </Border>
                                <local:PopupMenu x:Name="PopupMenu"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource local:StackGrid}" TargetType="local:StackGrid"/>

    <Style x:Key="Office2010BlueGroupBarItemStyle" TargetType="local:GroupBarItem">
        <Setter Property="Background" Value="{StaticResource GroupBarContentBrush}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource GroupBarHeaderBrush}"/>
        <Setter Property="HeaderForeground" Value="Black"/>
        <Setter Property="HeaderFontFamily" Value="Arial"/>
        <Setter Property="HeaderFontSize" Value="12"/>
        <Setter Property="HeaderFontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GroupBarItem">
                    <Grid x:Name="ItemHost">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemMouseOverBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightOuterBorder"
									Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemMouseOverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>-->
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="HeaderElement" To="1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SelectStates">
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemSelectedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightOuterBorder"
									Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemSelectedBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>-->
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemPressedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightOuterBorder"
									Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemPressedBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>-->
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="UnSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpandStates">
                                <VisualState x:Name="Expanded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PanelContent"
									Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 5 3 L 5 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 5 3 L 5 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="PanelContent"  From="0.0" To="1.0"
									Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarItemSelectedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PanelContent"
									Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource GroupBarHeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="UnderLine" Background="Transparent" Height="2" Grid.Row="0"/>

                        <Border x:Name="HighlightOuterBorder" Grid.Row="1" BorderBrush="Transparent">
                            <Grid x:Name="HighlightHeaderElement" Background="{TemplateBinding HeaderBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="HighlightHeaderElementTranslateTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>

                                <Border x:Name="HighlightExpandBorder" Grid.Column="0" Height="9" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#FF7898B5" CornerRadius="1,1,1,1" Width="9" BorderThickness="1,1,1,1">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                            <LinearGradientBrush.GradientStops>
                                                <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
                                                <GradientStop Offset="1" Color="#FFC0B7A6"/>
                                            </LinearGradientBrush.GradientStops>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Margin="1,1,1,1" Fill="Black" x:Name="HighlightExpandPath" Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                </Border>

                                <Image x:Name="HighlightImage" Grid.Column="0" Source="{TemplateBinding HeaderImageSource}" Margin="3" Height="{TemplateBinding ImageHeight}" Width="{TemplateBinding ImageWidth}" HorizontalAlignment="Left" Stretch="UniformToFill"/>
                                <!--<TextBlock x:Name="HighlightHeaderText" Grid.Column="1" Margin="5,2,2,2" Text="{TemplateBinding HeaderText}" Foreground="{TemplateBinding HeaderForeground}" FontFamily="{TemplateBinding HeaderFontFamily}" FontSize="{TemplateBinding HeaderFontSize}" FontWeight = "{TemplateBinding HeaderFontWeight}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" VerticalAlignment="Center"/>-->
                                <ContentControl x:Name="HighlightHeaderText" Grid.Column="1" Margin="5,2,2,2" Content="{TemplateBinding HeaderText}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding HeaderForeground}" FontFamily="{TemplateBinding HeaderFontFamily}" FontSize="{TemplateBinding HeaderFontSize}" FontWeight = "{TemplateBinding HeaderFontWeight}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="OuterBorder" Grid.Row="1">
                            <Grid x:Name="HeaderElement" Background="{TemplateBinding HeaderBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="HeaderElementTranslateTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>

                                <Border x:Name="ExpandBorder" Grid.Column="0" Height="9" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#FF7898B5" CornerRadius="1,1,1,1" Width="9" BorderThickness="1,1,1,1">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                            <LinearGradientBrush.GradientStops>
                                                <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
                                                <GradientStop Offset="1" Color="#FFC0B7A6"/>
                                            </LinearGradientBrush.GradientStops>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Margin="1,1,1,1" Fill="Black" x:Name="ExpandPath" Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                </Border>

                                <Image x:Name="Image" Grid.Column="0" Source="{TemplateBinding HeaderImageSource}" Margin="3" Height="{TemplateBinding ImageHeight}" Width="{TemplateBinding ImageWidth}" HorizontalAlignment="Left" Stretch="UniformToFill"/>
                                <!--<TextBlock x:Name="HeaderText" Grid.Column="1" Margin="5,2,2,2" Text="{TemplateBinding HeaderText}" Foreground="{TemplateBinding HeaderForeground}" FontFamily="{TemplateBinding HeaderFontFamily}" FontSize="{TemplateBinding HeaderFontSize}" FontWeight = "{TemplateBinding HeaderFontWeight}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" VerticalAlignment="Center"/>-->
                                <ContentControl x:Name="HeaderText" Grid.Column="1" Margin="5,2,2,2" Content="{TemplateBinding HeaderText}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding HeaderForeground}" FontFamily="{TemplateBinding HeaderFontFamily}" FontSize="{TemplateBinding HeaderFontSize}" FontWeight = "{TemplateBinding HeaderFontWeight}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="BorderContent" Visibility="Collapsed" Grid.Row="2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid x:Name="ContentContainer" Background="{TemplateBinding Background}" Grid.Row="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PanelContent" Visibility="Collapsed">
                                </Border>
                                <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2010BlueGroupBarItemStyle}" TargetType="local:GroupBarItem"/>

    <Style x:Key="Office2010BlueGroupBarStyle" TargetType="local:GroupBar" >
        <Setter Property="Background" Value="{StaticResource GroupBarContentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GroupBarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GroupBar">
                    <ScrollViewer Padding="{TemplateBinding Padding}"
								x:Name="ScrollViewer"    
                                Visibility="Visible"
								BorderThickness="{TemplateBinding BorderThickness}"
								BorderBrush="{TemplateBinding BorderBrush}"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Disabled">
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}">
                            <Grid x:Name="MainHost">
                                <local:NonStackGrid x:Name="NonStackGrid"/>
                                <local:StackGrid x:Name="StackGrid"/>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2010BlueGroupBarStyle}" TargetType="local:GroupBar"/>
</ResourceDictionary>
