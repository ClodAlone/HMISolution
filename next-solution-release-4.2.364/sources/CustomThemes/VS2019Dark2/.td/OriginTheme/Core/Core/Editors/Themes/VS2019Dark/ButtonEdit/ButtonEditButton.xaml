<!-- General --><sys:Boolean x:Key="{dxet:ButtonsThemeKey ResourceKey=DateEditUseArrowGlyph}">False</sys:Boolean>

<Thickness x:Key="{dxet:ButtonsThemeKey ResourceKey=DefaultBorderThickness}">0,0,0,0</Thickness>

<ControlTemplate x:Key="{dxet:ButtonsThemeKey ResourceKey=ButtonTemplate}" TargetType="{x:Type ButtonBase}"><Grid x:Name="Root" Background="Transparent" cs:id="Grid_0000"><Border x:Name="IsDefault" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding dxi:AppearanceOptions.CornerRadius}" Padding="{TemplateBinding Padding}" cs:id="Border_0000"><ContentPresenter x:Name="Content" Style="{Binding Path=DataContext.(dxei:ButtonInfoPropertyProvider.GlyphContainerStyle), RelativeSource={RelativeSource TemplatedParent}}" /></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF3E3E40" cs:id="Setter_0004" /><Setter Property="BorderBrush" Value="#FF3E3E40" cs:id="Setter_0005" /><Setter Property="TextElement.Foreground" Value="#FFF1F1F1" cs:id="Setter_0006" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#FF007ACC" cs:id="Setter_0007" /><Setter Property="BorderBrush" Value="#FF007ACC" cs:id="Setter_0008" /><Setter Property="TextElement.Foreground" Value="#FFF1F1F1" cs:id="Setter_0009" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" TargetName="Root" Value="0.38" /></Trigger><DataTrigger Binding="{Binding Path=IsChecked}" Value="True"><Setter Property="Background" Value="#FF007ACC" cs:id="Setter_0010" /><Setter Property="BorderBrush" Value="#FF007ACC" cs:id="Setter_0011" /><Setter Property="TextElement.Foreground" Value="#FFF1F1F1" cs:id="Setter_0012" /></DataTrigger></ControlTemplate.Triggers></ControlTemplate>

</ResourceDictionary>