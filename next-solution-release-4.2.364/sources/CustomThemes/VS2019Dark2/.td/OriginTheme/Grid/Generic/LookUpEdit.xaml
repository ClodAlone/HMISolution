<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dxe="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v21.2" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgl="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys" xmlns:col="clr-namespace:System.Collections;assembly=mscorlib" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:dxdst="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:cs="colorscheme_ignorable_uri" mc:Ignorable="cs">
    <ControlTemplate x:Key="{dxgt:LookUpEditThemeKey ResourceKey=PopupContentTemplate}" TargetType="{x:Type ContentControl}">
        <dxgl:GridControl x:Name="PART_GridControl" ShowBorder="False" />
    </ControlTemplate>

<ControlTemplate x:Key="{dxgt:AutoCompleteEditThemeKey ResourceKey=PopupContentTemplate}" TargetType="{x:Type ContentControl}"><dxgl:GridControl x:Name="PART_Content" ShowBorder="False" AutoGenerateColumns="AddNew" ItemsSource="{Binding Path=(dxe:BaseEdit.OwnerEdit).ItemsSource, RelativeSource={RelativeSource TemplatedParent}}" /></ControlTemplate>

<Style x:Key="{dxdst:DefaultStyleThemeKey FullName=DevExpress.Xpf.Grid.LookUp.LookUpEdit}" TargetType="{x:Type dxgl:LookUpEdit}" BasedOn="{StaticResource {dxdst:DefaultStyleThemeKey FullName=DevExpress.Xpf.Editors.LookUpEditBase}}"><Setter Property="ValidateOnTextInput" Value="false" /><Setter Property="AutoComplete" Value="true" /><Setter Property="IncrementalFiltering" Value="true" /><Setter Property="AllowRecreatePopupContent" Value="false" /><Setter Property="PopupContentTemplate" Value="{DynamicResource {dxgt:LookUpEditThemeKey ResourceKey=PopupContentTemplate}}" /></Style>

<DataTemplate x:Key="{dxgt:LookUpEditThemeKey ResourceKey=GridHeaderContentStyle}"><TextBlock Text="{Binding}" FontStyle="Oblique" /></DataTemplate>

</ResourceDictionary>