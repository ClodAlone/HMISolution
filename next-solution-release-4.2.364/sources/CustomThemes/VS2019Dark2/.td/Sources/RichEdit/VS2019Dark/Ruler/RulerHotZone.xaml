<ResourceDictionary mc:Ignorable="cs"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:cs="colorscheme_ignorable_uri"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
                    xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
                    xmlns:dxrei="http://schemas.devexpress.com/winfx/2008/xaml/richedit/internal"
                    xmlns:dxret="http://schemas.devexpress.com/winfx/2008/xaml/richedit/themekeys"
                    xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <dxt:ResourceDictionaryEx Source="/DevExpress.Xpf.Themes.VS2019Dark.v21.2;component/RichEdit/VS2019Dark/UICore.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- General -->

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=TabTypeToggleHotZoneControlTemplate}" TargetType="dxrei:TabTypeToggleHotZoneControl">
        <Border Background="$Button.Background"
                BorderBrush="$Delimiter"
                BorderThickness="1"
                cs:id="Border_0001"/>
    </ControlTemplate>

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=DisabledHotZoneControlTemplate}" TargetType="dxrei:DisabledHotZoneControl">
        <Border Background="$Border"
                Height="7"
                Width="9"
                cs:id="Border_0000"/>
    </ControlTemplate>

    <!-- Indent -->

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=FirstLineIndentHotZoneControlTemplate}" TargetType="dxrei:FirstLineIndentHotZoneControl">
        <Grid x:Name="Root">
            <Path Style="{StaticResource UIShape.FirstLineIndent}"
                  Visibility="{TemplateBinding EnabledVisibility}"
                  cs:id="Path_0000"/>
            <Path Opacity="0.38"
                  Style="{StaticResource UIShape.FirstLineIndent}"
                  Visibility="{TemplateBinding DisabledVisibility}"
                  cs:id="Path_0001"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=LeftIndentHotZoneControlTemplate}" TargetType="dxrei:HorizontalHotZoneControl">
        <Grid x:Name="Root">
            <Path Style="{StaticResource UIShape.LeftIndent}"
                  Visibility="{TemplateBinding EnabledVisibility}"
                  cs:id="Path_0000"/>
            <Path Opacity="0.38"
                  Style="{StaticResource UIShape.LeftIndent}"
                  Visibility="{TemplateBinding DisabledVisibility}"
                  cs:id="Path_0001"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=LeftIndentBottomHotZoneControlTemplate}" TargetType="dxrei:LeftIndentBottomHotZoneControl">
        <Grid x:Name="Root">
            <Border Background="$Button.Background"
                    BorderBrush="$Border"
                    BorderThickness="1,0,1,1"
                    Height="5"
                    Visibility="{TemplateBinding EnabledVisibility}"
                    Width="10"
                    cs:id="Border_0001"/>
            <Border Background="$Button.Background"
                    BorderBrush="$Border"
                    BorderThickness="1,0,1,1"
                    Height="5"
                    Opacity="0.38"
                    Visibility="{TemplateBinding DisabledVisibility}"
                    Width="10"
                    cs:id="Border_0002"/>
        </Grid>
    </ControlTemplate>

    <!-- Tab -->

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=DecimalTabHotZoneControlTemplate}" TargetType="dxrei:DecimalTabHotZoneControl">
        <Grid x:Name="Root">
            <Path Style="{StaticResource UIShape.DecimalTab}" Visibility="{TemplateBinding EnabledVisibility}"/>
            <Path Opacity="0.38"
                  Style="{StaticResource UIShape.DecimalTab}"
                  Visibility="{TemplateBinding DisabledVisibility}"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="{dxret:RichEditRulerThemeKey ResourceKey=HorizontalTableHotZoneControlTemplate}" TargetType="dxrei:HorizontalTableHotZoneControl">
        <Grid x:Name="Root">
            <Border Background="$Window.Background"
                    BorderBrush="$Delimiter"
                    BorderThickness="1"
                    Padding="2"
                    cs:id="Border_0001">
                <Grid>
                    <Path Style="{StaticResource UIShape.HorizontalTable}" Visibility="{TemplateBinding EnabledVisibility}"/>
                    <Path Opacity="0.38"
                          Style="{StaticResource UIShape.HorizontalTable}"
                          Visibility="{TemplateBinding DisabledVisibility}"/>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>