<ResourceDictionary mc:Ignorable="cs"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:cs="colorscheme_ignorable_uri"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
                    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                    xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <dxt:ResourceDictionaryEx Source="/DevExpress.Xpf.Themes.VS2017Dark.v20.2;component/LayoutControl/VS2017Dark/UICore.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- General -->

    <Style x:Key="ElementSizerStyle" TargetType="dxlc:ElementSizer">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background"
                Value="Transparent"
                cs:id="Setter_0000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dxlc:ElementSizer">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <dx:Container cs:id="Container_0000">
                            <dx:Container.Resources>
                                <dx:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                            </dx:Container.Resources>
                            <Grid x:Name="Root">
                                <dx:Container x:Name="HorizontalRootElement" Cursor="SizeNS">
                                    <Path x:Name="PathNS"
                                          Fill="$Foreground"
                                          Stretch="Fill"
                                          Style="{StaticResource UIShape.SizeGrip.Horizontal}"
                                          Visibility="{Binding ShowResizingHandle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                          cs:id="Path_0000"/>
                                </dx:Container>
                                <dx:Container x:Name="VerticalRootElement" Cursor="SizeWE">
                                    <Path x:Name="PathWE"
                                          Fill="$Foreground"
                                          Stretch="Fill"
                                          Style="{StaticResource UIShape.SizeGrip.Vertical}"
                                          Visibility="{Binding ShowResizingHandle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                          cs:id="Path_0001"/>
                                </dx:Container>
                            </Grid>
                        </dx:Container>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Duration="0"
                                                        Storyboard.TargetName="PathNS"
                                                        Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)"
                                                        To="$Focused"
                                                        cs:id="ColorAnimation_0000"/>
                                        <ColorAnimation Duration="0"
                                                        Storyboard.TargetName="PathWE"
                                                        Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)"
                                                        To="$Focused"
                                                        cs:id="ColorAnimation_0001"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>