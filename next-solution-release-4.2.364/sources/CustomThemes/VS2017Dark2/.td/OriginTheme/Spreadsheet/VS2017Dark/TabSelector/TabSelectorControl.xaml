<!-- General --><ControlTemplate x:Key="{dxspst:SpreadsheetThemeKey ResourceKey=TabSelectorTemplate}" TargetType="{x:Type dxspsi:SpreadsheetTabSelector}"><Grid x:Name="PART_RootContainer"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#FF3F3F46" cs:id="Border_0000"><Grid x:Name="PART_NavButtonContainer"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="PART_FirstButton" Command="{Binding FirstTabCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Grid.Column="0" Style="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=BaseButtonStyle}}"><Path Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Style="{StaticResource UIShape.Navigation.First}" cs:id="Path_0000" /></Button><Button x:Name="PART_PrevButton" Command="{Binding PrevTabCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Grid.Column="1" Style="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=BaseButtonStyle}}"><Path Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Style="{StaticResource UIShape.Navigation.PrevItem}" cs:id="Path_0001" /></Button><Button x:Name="PART_NextButton" Command="{Binding NextTabCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Grid.Column="2" Style="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=BaseButtonStyle}}"><Path Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Style="{StaticResource UIShape.Navigation.NextItem}" cs:id="Path_0002" /></Button><Button x:Name="PART_LastButton" Command="{Binding LastTabCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Grid.Column="3" Style="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=BaseButtonStyle}}"><Path Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Style="{StaticResource UIShape.Navigation.Last}" cs:id="Path_0003" /></Button></Grid></Border><dxspsi:TabSelectorPanel AddButtonTemplate="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=AddButtonDataTemplate}}" Grid.Column="1" Grid.ColumnSpan="2" TabSelectorItemColoredTemplate="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=TabSelectorColoredItemTemplate}}" TabSelectorItemDefaultTemplate="{DynamicResource {dxspst:SpreadsheetThemeKey ResourceKey=TabSelectorItemTemplate}}" /></Grid><ControlTemplate.Triggers><Trigger Property="dx:ThemeManager.IsTouchEnabled" Value="True"><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" /></Trigger></ControlTemplate.Triggers></ControlTemplate>

