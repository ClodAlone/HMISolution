<Window x:Class="Bornander.UI.Commands.Test.AcknowledgableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AcknowledgableDialog" Height="150" Width="400">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="icon"/>
        <TextBox Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" IsReadOnly="True" VerticalContentAlignment="Center" x:Name="message" Style="{StaticResource borderlessTextBox}" />
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="64" Margin="0,0,0,0" Content="Yes" x:Name="yes" Click="yes_Click"/>
            <Button Width="64" Margin="8,0,0,0" Content="No" x:Name="no" Click="no_Click"/>
            <Button Width="64" Margin="8,0,0,0" Content="Ok" x:Name="ok" Click="ok_Click"/>
        </StackPanel>
        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Do not show this dialog again" x:Name="doNotShowAgain"/>
        
        
    </Grid>
</Window>
