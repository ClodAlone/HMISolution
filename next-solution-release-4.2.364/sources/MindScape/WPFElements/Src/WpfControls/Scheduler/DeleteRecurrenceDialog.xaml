<UserControl x:Class="Mindscape.WpfElements.DeleteRecurrenceDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
             xmlns:ms="clr-namespace:Mindscape.WpfElements">
  <StackPanel x:Name="LayoutRoot" Width="270" Margin="8">
    <TextBlock Text="Do you want to delete all the occurrences of the recurring appointment, or just this one?" TextWrapping="Wrap" Margin="10,0,0,0" />
    <RadioButton IsChecked="{Binding DeleteOccurrence}" Content="Delete this occurrence." GroupName="DeleteOptions" Margin="10,18,0,0" />
    <RadioButton IsChecked="{Binding DeleteSeries}" Content="Delete the series." GroupName="DeleteOptions" Margin="10,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Command="{x:Static ms:SchedulerCommands.OkCommand}" Content="OK" Width="75" Height="23" Margin="0,12,0,0" />
      <Button Command="{x:Static ms:SchedulerCommands.CancelCommand}" Content="Cancel" Width="75" Height="23" Margin="12,12,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>