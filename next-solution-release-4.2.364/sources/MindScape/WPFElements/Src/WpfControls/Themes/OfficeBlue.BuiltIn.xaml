  <!-- Styles -->
  
  <ControlTemplate x:Key="HorizontalProgressBarStyle" TargetType="{x:Type ProgressBar}">
    <Grid>
      <Border Background="{StaticResource HorizontalProgressBarBackground}" Margin="1" BorderThickness="1" BorderBrush="{StaticResource ProgressBarInnerBorder}" CornerRadius="3" />
      <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource HorizontalProgressBarIndicatorBackground}" CornerRadius="3" />
      <Border x:Name="IndeterminateBorder" Visibility="Hidden">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="-0.5" Color="Transparent" />
            <GradientStop Offset="-0.3" Color="#77ABF1" />
            <GradientStop Offset="-0.1" Color="Transparent" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Name="PART_Track" BorderBrush="{StaticResource HorizontalProgressBarBorder}" BorderThickness="1" CornerRadius="3" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsIndeterminate" Value="True">
        <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
        <Setter TargetName="IndeterminateBorder" Property="Visibility" Value="Visible" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                               To="1.1" Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                               To="1.3" Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                               To="1.5" Duration="0:0:2" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[0].Offset" To="-0.5" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[1].Offset" To="-0.3" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[2].Offset" To="-0.1" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="VerticalProgressBarStyle" TargetType="{x:Type ProgressBar}">
    <Grid>
      <Border Background="{StaticResource VerticalProgressBarBackground}" Margin="1" BorderThickness="1" BorderBrush="{StaticResource ProgressBarInnerBorder}" CornerRadius="3" />
      <Border Name="PART_Indicator" VerticalAlignment="Bottom" Background="{StaticResource VerticalProgressBarIndicatorBackground}" CornerRadius="3" />
      <Border x:Name="IndeterminateBorder" Visibility="Hidden">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="1.5" Color="Transparent" />
            <GradientStop Offset="1.3" Color="#77ABF1" />
            <GradientStop Offset="1.1" Color="Transparent" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Name="PART_Track" BorderBrush="{StaticResource VerticalProgressBarBorder}" BorderThickness="1" CornerRadius="3" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsIndeterminate" Value="True">
        <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
        <Setter TargetName="IndeterminateBorder" Property="Visibility" Value="Visible" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                               To="-0.1" Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                               To="-0.3" Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                               To="-0.5" Duration="0:0:2" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[0].Offset" To="1.5" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[1].Offset" To="1.3" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[2].Offset" To="1.1" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="{x:Type ProgressBar}" TargetType="{x:Type ProgressBar}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template" Value="{StaticResource VerticalProgressBarStyle}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource HorizontalProgressBarStyle}" />
      </Trigger>
    </Style.Triggers>
  </Style>

