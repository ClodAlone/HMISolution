    <GradientStop Offset="1" Color="#FDFDFD" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="VerticalSliderTrackBorder" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#B5B8B6" />
    <GradientStop Offset="1" Color="#FDFDFD" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverSliderThumbBackground" StartPoint="0,0" EndPoint="1,1">
