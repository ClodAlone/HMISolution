    <GradientStop Offset="0.5" Color="#D1DAE4" />
    <GradientStop Offset="1" Color="#D1DBE6" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverVerticalScrollBarThumbBackground" StartPoint="0,0" EndPoint="1,0">
