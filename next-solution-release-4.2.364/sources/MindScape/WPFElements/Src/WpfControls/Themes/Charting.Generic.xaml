  <!-- Stick style -->
  
  <local:StickToPathGeometryConverter x:Key="StickToPathGeometry" />
  
  <Style TargetType="local:Stick">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:Stick">
          <Path Style="{TemplateBinding VisualStyle}" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased"
                Stroke="{TemplateBinding BorderBrush}">
            <Path.Data>
              <MultiBinding Converter="{StaticResource StickToPathGeometry}">
                <Binding Path="LowPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:Stick}}" />
                <Binding Path="OpenPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:Stick}}" />
                <Binding Path="ClosePosition" RelativeSource="{RelativeSource AncestorType={x:Type local:Stick}}" />
                <Binding Path="VisualStyle" RelativeSource="{RelativeSource AncestorType={x:Type local:Stick}}" />
              </MultiBinding>
            </Path.Data>
          </Path>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- Candlestick style -->
  
  <local:CandlestickToPathGeometryConverter x:Key="CandlestickToPathGeometry" />
  
  <Style TargetType="local:Candlestick">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:Candlestick">
          <Path Style="{TemplateBinding VisualStyle}" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased"
                Stroke="{TemplateBinding BorderBrush}" Fill="{TemplateBinding Background}">
            <Path.Data>
              <MultiBinding Converter="{StaticResource CandlestickToPathGeometry}">
                <Binding Path="LowPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:Candlestick}}" />
                <Binding Path="OpenPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:Candlestick}}" />
                <Binding Path="ClosePosition" RelativeSource="{RelativeSource AncestorType={x:Type local:Candlestick}}" />
                <Binding Path="BoxWidth" RelativeSource="{RelativeSource AncestorType={x:Type local:Candlestick}}" />
              </MultiBinding>
            </Path.Data>
          </Path>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

