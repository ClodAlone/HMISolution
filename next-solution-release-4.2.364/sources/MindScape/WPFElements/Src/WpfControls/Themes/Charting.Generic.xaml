      <Path Data="M 0 0 L 38 0 L 38 10 L 0 10 Z" VerticalAlignment="Top" Style="{Binding PolarSeries.AreaStyle}"
            Fill="{Binding Converter={StaticResource AreaBackgroundConverter}}" />
      <Path Data="M 0 0 L 38 0" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}" Style="{Binding PolarSeries.LineStyle}"
