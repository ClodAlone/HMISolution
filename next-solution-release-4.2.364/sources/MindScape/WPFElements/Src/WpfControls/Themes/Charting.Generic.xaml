    <Border Margin="{Binding LevelOffset, Converter={StaticResource HorizontalLabelLevelMargin}}" VerticalAlignment="Top">
      <Border Margin="{Binding PositionOffset, Converter={StaticResource HorizontalAxisLabelMargin}}">
        <Border Width="100" HorizontalAlignment="Left" Margin="-50,0,0,0" Height="{Binding RotatedHeight}">
          <ContentControl Content="{Binding Label}" ContentTemplate="{Binding LabelTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransform="{Binding Content, Converter={StaticResource AxisLabelRotation}, RelativeSource={RelativeSource TemplatedParent}}" 
                          Foreground="{Binding Foreground}" />
        </Border>
      </Border>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="VerticalAxisLabelTemplate">
    <Border Margin="{Binding PositionOffset, Converter={StaticResource VerticalAxisLabelMargin}}" VerticalAlignment="Bottom">
      <Border Height="100" VerticalAlignment="Bottom" Margin="0,0,0,-50">
        <ContentControl Content="{Binding Label}" ContentTemplate="{Binding LabelTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="{Binding Foreground}" />
      </Border>
    </Border>
  </DataTemplate-->

  <Style x:Key="GridItemsControlStyle" TargetType="ItemsControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="HorizontalAxisTemplate">
    <Grid Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <ms:DualSlider ShowBottomRightTickMarks="False" ShowTopLeftTickMarks="False" Style="{Binding SliderStyle, RelativeSource={RelativeSource TemplatedParent}}"
                     MinimumRange="{Binding MinimumRange, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     IsReversed="{Binding IsReversed, RelativeSource={RelativeSource TemplatedParent}}"
                     Visibility="{Binding IsSliderVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
      <Grid Grid.Row="1">
        <ItemsControl Name="PART_MinorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
        <ItemsControl Name="PART_MajorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
        <Border VerticalAlignment="Top" Height="1" Style="{Binding AxisLineStyle, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
      <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" Margin="0,0,-1000,0" Grid.Row="2" />
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" Margin="0,4,0,0"
                 Visibility="{Binding TitleVisibility, RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="3" TextWrapping="{Binding TitleWrapping, RelativeSource={RelativeSource TemplatedParent}}" />
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="VerticalAxisTemplate" TargetType="{x:Type local:ChartAxis}">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="TitleHost" Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
                 TextAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" TextWrapping="{Binding TitleWrapping, RelativeSource={RelativeSource TemplatedParent}}"
		         Margin="6,0,4,0" Padding="0,0,3,0" Visibility="{Binding TitleVisibility, RelativeSource={RelativeSource TemplatedParent}}">
        <TextBlock.LayoutTransform>
          <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
        </TextBlock.LayoutTransform>
      </TextBlock>
      <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" Margin="0,0,2,0" Grid.Column="1" />
      <Grid Grid.Column="2" HorizontalAlignment="Right">
        <ItemsControl Name="PART_MinorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
        <ItemsControl Name="PART_MajorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
        <Border HorizontalAlignment="Right" Width="1" Style="{Binding AxisLineStyle, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
      <ms:DualSlider ShowBottomRightTickMarks="False" ShowTopLeftTickMarks="False" Style="{Binding SliderStyle, RelativeSource={RelativeSource TemplatedParent}}"
                     Grid.Column="3" Orientation="Vertical"
                     MinimumRange="{Binding MinimumRange, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     IsReversed="{Binding IsReversed, RelativeSource={RelativeSource TemplatedParent}}"
                     Visibility="{Binding IsSliderVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
    </Grid>
	<ControlTemplate.Triggers>
	  <Trigger Property="IsTitleRotated" Value="False">
	    <Setter TargetName="TitleHost" Property="LayoutTransform" Value="{x:Null}" />
	  </Trigger>
	</ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="XAxisLineStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="Black" />
  </Style>

  <Style x:Key="YAxisLineStyle" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="Black" />
  </Style>

  <Style x:Key="AxisLineStyle" TargetType="Border">
    <Setter Property="Background" Value="Black" />
  </Style>

  <DataTemplate x:Key="RightVerticalAxisLabelTemplate">
    <Border Margin="{Binding PositionOffset, Converter={StaticResource VerticalAxisLabelMargin}}" VerticalAlignment="Bottom">
      <Border Height="100" VerticalAlignment="Bottom" Margin="0,0,0,-50">
        <ContentControl Content="{Binding Label}" ContentTemplate="{Binding Template}" HorizontalAlignment="Left" VerticalAlignment="Center" />
      </Border>
    </Border>
  </DataTemplate>

  <Style x:Key="MinorTickMarkStyle" TargetType="Border">
    <Setter Property="Background" Value="Black" />
  </Style>

  <ControlTemplate x:Key="RightVerticalAxisTemplate" TargetType="{x:Type local:ChartAxis}">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ms:DualSlider ShowBottomRightTickMarks="False" ShowTopLeftTickMarks="False" Style="{Binding SliderStyle, RelativeSource={RelativeSource TemplatedParent}}"
                     MinimumRange="{Binding MinimumRange, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     IsReversed="{Binding IsReversed, RelativeSource={RelativeSource TemplatedParent}}" Orientation="Vertical"
                     Visibility="{Binding IsSliderVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
      <Grid Grid.Column="1">
        <Border Width="1" Style="{Binding AxisLineStyle, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" HorizontalAlignment="Left" />
        <ItemsControl Name="PART_MinorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" HorizontalAlignment="Left" />
        <ItemsControl Name="PART_MajorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
      </Grid>
      <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" Margin="2,0,4,0" Grid.Column="2" />
      <TextBlock Name="TitleHost" Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="{Binding TitleWrapping, RelativeSource={RelativeSource TemplatedParent}}"
                 VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" SnapsToDevicePixels="True"
		         Margin="4,0,6,0" Visibility="{Binding TitleVisibility, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="3">
        <TextBlock.LayoutTransform>
          <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
        </TextBlock.LayoutTransform>
      </TextBlock>
    </Grid>
	<ControlTemplate.Triggers>
	  <Trigger Property="IsTitleRotated" Value="False">
	    <Setter TargetName="TitleHost" Property="LayoutTransform" Value="{x:Null}" />
	  </Trigger>
	</ControlTemplate.Triggers>
  </ControlTemplate>
  
  <ControlTemplate x:Key="TopHorizontalAxisTemplate">
    <Grid Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" Margin="0,4,0,0"
                 Visibility="{Binding TitleVisibility, RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="0" TextWrapping="{Binding TitleWrapping, RelativeSource={RelativeSource TemplatedParent}}" />
      <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" Margin="0,0,-1000,0" Grid.Row="1" />
      <Grid Grid.Row="2">
        <ItemsControl Name="PART_MinorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
        <ItemsControl Name="PART_MajorTickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
        <Border VerticalAlignment="Bottom" Height="1" Style="{Binding AxisLineStyle, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
      <ms:DualSlider ShowBottomRightTickMarks="False" ShowTopLeftTickMarks="False" Style="{Binding SliderStyle, RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="3"
                     MinimumRange="{Binding MinimumRange, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     IsReversed="{Binding IsReversed, RelativeSource={RelativeSource TemplatedParent}}"
                     Visibility="{Binding IsSliderVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
    </Grid>
  </ControlTemplate>

  <Style TargetType="local:ChartAxis">
    <Setter Property="MinorTickMarkStyle" Value="{StaticResource MinorTickMarkStyle}" />
    <Setter Property="SliderStyle" Value="{StaticResource ChartAxisDualSliderStyle}" />
    <Style.Triggers>
      <Trigger Property="Placement" Value="Right">
        <Setter Property="Template" Value="{StaticResource RightVerticalAxisTemplate}" />
      </Trigger>
      <Trigger Property="Placement" Value="Left">
        <Setter Property="Template" Value="{StaticResource VerticalAxisTemplate}" />
      </Trigger>
	  <Trigger Property="Placement" Value="Overlay">
        <Setter Property="Template" Value="{StaticResource VerticalAxisTemplate}" />
      </Trigger>
      <Trigger Property="Placement" Value="Bottom">
        <Setter Property="Template" Value="{StaticResource HorizontalAxisTemplate}" />
      </Trigger>
      <Trigger Property="Placement" Value="Top">
        <Setter Property="Template" Value="{StaticResource TopHorizontalAxisTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="LegendItemTemplate">
    <StackPanel Orientation="Horizontal" Margin="6,0,6,0" SnapsToDevicePixels="True">
      <ContentPresenter Content="{Binding}" ContentTemplate="{Binding LegendIconTemplate}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
      <TextBlock Text="{Binding LegendLabel}" Margin="7,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True" />
    </StackPanel>
  </DataTemplate>

  <!--DataTemplate x:Key="LegendItemIconTemplate">
    <ContentPresenter Content="{Binding}" ContentTemplate="{Binding LegendIconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
  </DataTemplate>
  
  <DataTemplate x:Key="LegendItemTitleTemplate">
    <TextBlock Text="{Binding LegendLabel}" Margin="7,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Left" />
  </DataTemplate-->

  <DataTemplate x:Key="TitleTemplate">
    <!--Border BorderThickness="1" BorderBrush="#83A5D2">
      <Border BorderThickness="1" BorderBrush="#EFF6FF" Background="#ABC9EE">
        <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
                   Text="{Binding}" />
      </Border>
    </Border-->
    <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
               Text="{Binding}" />
  </DataTemplate>

  <ms:FormattingConverter x:Key="StringConverter" />

  <Style TargetType="local:DataLabel">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="#55FFFFFF" Margin="1">
              <TextBlock Text="{Binding DependentData, Converter={StaticResource StringConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="2,0,2,0" Foreground="{TemplateBinding Foreground}" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="DataLabelStyle" TargetType="local:DataLabel">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="#55FFFFFF" Margin="1">
              <TextBlock Text="{Binding DependentData, Converter={StaticResource StringConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="2,0,2,0" Foreground="{TemplateBinding Foreground}" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <DataTemplate x:Key="LegendHeaderTemplate">
    <TextBlock Text="{Binding}" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Left" FontWeight="Bold" />
  </DataTemplate>

  <local:LegendPositionToVisibilityConverter x:Key="VerticalLegendVisibility" LeftVisibility="Visible" RightVisibility="Visible" />
  <local:LegendPositionToVisibilityConverter x:Key="HorizontalLegendVisibility" TopVisibility="Visible" BottomVisibility="Visible" />
  <local:LegendPositionToVisibilityConverter x:Key="CenterLegendVisibility" CenterVisibility="Visible" />

  <!-- TODO: split each template into a separate resource rather than setting visibility. -->
  <Style TargetType="local:Legend">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Black" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Header" Value="Legend" />
    <Setter Property="HeaderTemplate" Value="{StaticResource LegendHeaderTemplate}" />
    <Setter Property="ItemTemplate" Value="{StaticResource LegendItemTemplate}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
	<Setter Property="ItemsPanel">
	  <Setter.Value>
	    <ItemsPanelTemplate>
          <WrapPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
	  </Setter.Value>
	</Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid SnapsToDevicePixels="True">
            <!-- Vertical template -->
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    Visibility="{Binding LegendPosition, Converter={StaticResource VerticalLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                    CornerRadius="3">
              <Border Background="{TemplateBinding Background}" CornerRadius="3">
                <DockPanel Margin="{TemplateBinding Padding}">
                  <ContentControl Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                  ContentTemplate="{Binding HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                  Foreground="{TemplateBinding Foreground}" DockPanel.Dock="Top" />
                  <ItemsPresenter Margin="0,0,0,2" DockPanel.Dock="Top" />
                </DockPanel>
              </Border>
            </Border>
            <!-- Horizontal template -->
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Margin="{TemplateBinding Margin}"
                    Background="{TemplateBinding Background}"
                    Visibility="{Binding LegendPosition, Converter={StaticResource HorizontalLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                    CornerRadius="3">
              <Border Background="{TemplateBinding Background}" CornerRadius="3">
                <StackPanel Margin="{TemplateBinding Padding}">
                  <ContentControl Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                Foreground="{TemplateBinding Foreground}" />
                  <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,0,2">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Border>
            <!-- Center template -->
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Margin="{TemplateBinding Margin}"
                    Background="{TemplateBinding Background}"
                    Visibility="{Binding LegendPosition, Converter={StaticResource CenterLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                    CornerRadius="3">
              <Border Background="{TemplateBinding Background}" CornerRadius="3">
                <StackPanel Margin="{TemplateBinding Padding}">
                  <ContentControl Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                  ContentTemplate="{Binding HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                  Foreground="{TemplateBinding Foreground}" />
                  <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,0,2" />
                </StackPanel>
              </Border>
            </Border>

          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:LegendPositionToIntegerConverter x:Key="LegendRow" LeftInteger="1" RightInteger="1" TopInteger="0" BottomInteger="2" CenterInteger="1" />
  <local:LegendPositionToIntegerConverter x:Key="LegendColumn" LeftInteger="0" RightInteger="2" TopInteger="1" BottomInteger="1" CenterInteger="2" />
  <local:LegendPositionToVisibilityConverter x:Key="OutsideLegendVisibility" RightVisibility="Visible" LeftVisibility="Visible" TopVisibility="Visible" BottomVisibility="Visible" />

  <Style TargetType="local:Chart">
    <Setter Property="TitleTemplate" Value="{StaticResource TitleTemplate}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="#83A5D2" />
    <Setter Property="Padding" Value="0,12,10,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Grid.RowSpan="2" />

            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid x:Name="PART_AxisGrid" Grid.Row="1" Grid.Column="1" Margin="{TemplateBinding Padding}">
                <Border x:Name="PART_ChartRoot">
                  <Border x:Name="PART_ChartArea" VerticalAlignment="Bottom" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <Grid>
                      <!-- TODO: try cut down the number of elements in this grid -->
                      <ItemsControl ItemsSource="{Binding BackgroundElements, RelativeSource={RelativeSource TemplatedParent}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Grid />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <Canvas x:Name="PART_ChartCanvas" Background="Transparent" />
                    </Grid>
                  </Border>
                </Border>
				<Border x:Name="PART_ForegroundRoot">
				  <Grid>
				    <Canvas x:Name="PART_ForegroundCanvas" />
                      <ItemsControl ItemsSource="{Binding ForegroundElements, RelativeSource={RelativeSource TemplatedParent}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Grid />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    <Canvas x:Name="PART_MouseCanvas" />
                    <local:Legend ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{Binding LegendStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                  Visibility="{Binding LegendPosition, Converter={StaticResource CenterLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                                  LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource TemplatedParent}}" />
				  </Grid>
				</Border>
                <!-- This line is to add the DataSeries to the visual tree -->
                <ItemsControl ItemsSource="{Binding Series, RelativeSource={RelativeSource TemplatedParent}}" Width="0" Height="0" />
              </Grid>
              <local:Legend ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{Binding LegendStyle, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="{Binding LegendPosition, Converter={StaticResource OutsideLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                            LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource TemplatedParent}}"
                            Grid.Row="{Binding LegendPosition, Converter={StaticResource LegendRow}, RelativeSource={RelativeSource TemplatedParent}}"
                            Grid.Column="{Binding LegendPosition, Converter={StaticResource LegendColumn}, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>

            <ContentControl Content="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />

          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ***** Legend Icon Templates ***** -->

  <!-- Converters -->

  <local:LegendItemToChartSymbolBorderBrushConverter x:Key="ChartSymbolBorderConverter" />
  <local:LegendItemToChartSymbolBackgroundConverter x:Key="ChartSymbolBackgroundConverter" />
  <local:LegendItemToChartSymbolSizeConverter x:Key="ChartSymbolSizeConverter" />
  <local:LegendItemToAreaBackgroundConverter x:Key="AreaBackgroundConverter" />
  <local:LegendItemToLineStrokeConverter x:Key="LineStrokeConverter" />
  <local:LegendItemToDashArrayConverter x:Key="DashArrayConverter" />
  <local:LegendItemToAreaChartSymbolMarginConverter x:Key="AreaChartSymbolMarginConverter" />

  <!-- BarSeries -->

  <DataTemplate x:Key="BarSeriesLegendIcon">
    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding LegendIconBrush}" Margin="0,2,0,2" SnapsToDevicePixels="True" />
  </DataTemplate>

  <Style TargetType="local:BarSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource BarSeriesLegendIcon}" />
    <Setter Property="DataLabelStyle" Value="{StaticResource DataLabelStyle}" />
  </Style>

  <!-- PieSeries -->

  <DataTemplate x:Key="PieSeriesLegendIcon">
    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding LegendIconBrush}" Margin="0,2,0,2" SnapsToDevicePixels="True" />
  </DataTemplate>

  <Style TargetType="local:PieSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource PieSeriesLegendIcon}" />
    <Setter Property="DataLabelStyle" Value="{StaticResource DataLabelStyle}" />
  </Style>

  <!-- BubbleSeries -->

  <DataTemplate x:Key="BubbleSeriesLegendIcon">
    <local:Bubble Width="12" Height="12" Background="{Binding LegendIconBrush}" SnapsToDevicePixels="True" />
  </DataTemplate>

  <Style TargetType="local:BubbleSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource BubbleSeriesLegendIcon}" />
  </Style>

  <!-- LineSeries -->

  <DataTemplate x:Key="LineSeriesLegendIcon">
    <Grid Margin="0,2,0,2" SnapsToDevicePixels="True">
      <Path Data="M 0 0 L 38 0" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}" Style="{Binding DataSeries.LineStyle}"
            StrokeDashArray="{Binding Converter={StaticResource DashArrayConverter}}" Stretch="None"
            VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased" />
      <local:ChartSymbol IsHitTestVisible="False" Style="{Binding DataSeries.SymbolStyle}" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center"
                         BorderBrush="{Binding Converter={StaticResource ChartSymbolBorderConverter}}" SnapsToDevicePixels="True"
                         Background="{Binding Converter={StaticResource ChartSymbolBackgroundConverter}}"
                         Width="{Binding Converter={StaticResource ChartSymbolSizeConverter}}"
                         Height="{Binding Converter={StaticResource ChartSymbolSizeConverter}}" />
    </Grid>
  </DataTemplate>

  <Style TargetType="local:LineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource LineSeriesLegendIcon}" />
  </Style>

  <!-- AreaSeries -->

  <DataTemplate x:Key="AreaSeriesLegendIcon">
    <Grid VerticalAlignment="Center" Margin="0,2,0,2" SnapsToDevicePixels="True">
      <Path Data="M 0 0 L 38 0 L 38 10 L 0 10 Z" VerticalAlignment="Top" Style="{Binding DataSeries.AreaStyle}"
            Fill="{Binding Converter={StaticResource AreaBackgroundConverter}}" SnapsToDevicePixels="True" />
      <Path Data="M 0 0 L 38 0" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}" Style="{Binding DataSeries.LineStyle}"
            StrokeDashArray="{Binding Converter={StaticResource DashArrayConverter}}" SnapsToDevicePixels="True"
            VerticalAlignment="Top" />
      <local:ChartSymbol IsHitTestVisible="False" Style="{Binding DataSeries.SymbolStyle}" HorizontalAlignment="Center"
                         VerticalAlignment="Top" Margin="{Binding Converter={StaticResource AreaChartSymbolMarginConverter}}"
                         BorderBrush="{Binding Converter={StaticResource ChartSymbolBorderConverter}}" SnapsToDevicePixels="True"
                         Background="{Binding Converter={StaticResource ChartSymbolBackgroundConverter}}"
                         Width="{Binding Converter={StaticResource ChartSymbolSizeConverter}}"
                         Height="{Binding Converter={StaticResource ChartSymbolSizeConverter}}" />
    </Grid>
  </DataTemplate>

  <Style TargetType="local:AreaSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource AreaSeriesLegendIcon}" />
  </Style>

  <!-- SplineAreaSeries -->

  <Style TargetType="local:SplineAreaSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource AreaSeriesLegendIcon}" />
  </Style>

  <!-- SplineSeries -->

  <Style TargetType="local:SplineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource LineSeriesLegendIcon}" />
  </Style>

  <!-- StackedAreaSeries -->

  <Style TargetType="local:StackedAreaSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource AreaSeriesLegendIcon}" />
  </Style>

  <!-- StackedBarSeries -->

  <Style TargetType="local:StackedBarSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource BarSeriesLegendIcon}" />
    <Setter Property="DataLabelStyle" Value="{StaticResource DataLabelStyle}" />
  </Style>

  <!-- StackedLineSeries -->

  <Style TargetType="local:StackedLineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource LineSeriesLegendIcon}" />
  </Style>

  <!-- StackedSplineAreaSeries -->

  <Style TargetType="local:StackedSplineAreaSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource AreaSeriesLegendIcon}" />
  </Style>

  <!-- StackedSplineSeries -->

  <Style TargetType="local:StackedSplineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource LineSeriesLegendIcon}" />
  </Style>
  
  <!-- StockSeries -->
  
  <DataTemplate x:Key="StockSeriesLegendIcon">
    <Path Data="M 0 0 L 38 0" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}" Style="{Binding DataSeries.PositiveStyle}"
          Stretch="None" Margin="0,2,0,2"
          VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased" />
  </DataTemplate>
  
  <Style x:Key="PositiveStockSeriesStyle" TargetType="Path">
    <Setter Property="StrokeThickness" Value="3" />
  </Style>
  
  <Style x:Key="NegativeStockSeriesStyle" TargetType="Path">
    <Setter Property="StrokeThickness" Value="3" />
  </Style>
  
  <Style TargetType="local:StockSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource StockSeriesLegendIcon}" />
    <Setter Property="PositiveStyle" Value="{StaticResource PositiveStockSeriesStyle}" />
    <Setter Property="NegativeStyle" Value="{StaticResource NegativeStockSeriesStyle}" />
  </Style>
  
  <!-- CandlestickSeries -->

  <DataTemplate x:Key="CandlestickSeriesLegendIcon">
    <Path Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}" Style="{Binding DataSeries.PositiveStyle}"
          Stretch="None" Margin="0,2,0,2"
          VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased" />
  </DataTemplate>
  
  <Style x:Key="PositiveCandlestickSeriesStyle" TargetType="Path">
    <Setter Property="StrokeThickness" Value="3" />
  </Style>

  <Style x:Key="NegativeCandlestickSeriesStyle" TargetType="Path">
    <Setter Property="StrokeThickness" Value="3" />
  </Style>

  <Style TargetType="local:CandlestickSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource CandlestickSeriesLegendIcon}" />
    <Setter Property="PositiveStyle" Value="{StaticResource PositiveCandlestickSeriesStyle}" />
    <Setter Property="NegativeStyle" Value="{StaticResource NegativeCandlestickSeriesStyle}" />
  </Style>

  <!-- BoxplotSeries -->
  
  <ms:ArithmeticConverter x:Key="Half" Multiplier="0.5" />
  <local:DoubleToThicknessConverter x:Key="DoubleToThickness" IsTop="True" />
  <local:DoubleToThicknessConverter x:Key="DoubleToThicknessRight" IsRight="True" />
  
  <ControlTemplate x:Key="VerticalBoxAndWhiskersTemplate" TargetType="local:BoxAndWhiskers">
    <Grid Width="{Binding BoxWidth}">
	  <Path Stroke="{TemplateBinding Background}" StrokeThickness="2" StrokeDashArray="3,3" Data="M 0 0 L 0 1" Stretch="Fill"
	     	Width="2" Height="{TemplateBinding MinimumPosition}" HorizontalAlignment="Center" />
	  <Border Background="{TemplateBinding Background}" HorizontalAlignment="Center" Height="2"
			  Width="{TemplateBinding BoxWidth, Converter={StaticResource Half}}" VerticalAlignment="Top" />
	  <Border Background="{TemplateBinding Background}" HorizontalAlignment="Center" Height="2"
		      Width="{TemplateBinding BoxWidth, Converter={StaticResource Half}}" VerticalAlignment="Bottom" />
	  <Border Width="{TemplateBinding BoxWidth}" Height="{TemplateBinding BoxHeight}" BorderThickness="2" BorderBrush="{TemplateBinding Background}"
		      VerticalAlignment="Top" HorizontalAlignment="Center" Background="White"
			  Margin="{Binding UpperQuartilePosition, Converter={StaticResource DoubleToThickness}, RelativeSource={RelativeSource TemplatedParent}}" />
	  <Border Background="{TemplateBinding Background}" HorizontalAlignment="Center" Height="4"
			  Width="{TemplateBinding BoxWidth}" VerticalAlignment="Top"
			  Margin="{Binding MedianPosition, Converter={StaticResource DoubleToThickness}, RelativeSource={RelativeSource TemplatedParent}}">
	    <Border.RenderTransform>
		  <TranslateTransform Y="-2" />
	    </Border.RenderTransform>
	  </Border>
    </Grid>
  </ControlTemplate>
  
  <ControlTemplate x:Key="HorizontalBoxAndWhiskersTemplate" TargetType="local:BoxAndWhiskers">
    <Grid Height="{Binding BoxWidth}">
	  <Path Stroke="{TemplateBinding Background}" StrokeThickness="2" StrokeDashArray="3,3" Data="M 0 0 L 1 0" Stretch="Fill"
	     	Height="2" Width="{TemplateBinding MinimumPosition}" VerticalAlignment="Center" />
	  <Border Background="{TemplateBinding Background}" VerticalAlignment="Center" Width="2"
			  Height="{TemplateBinding BoxWidth, Converter={StaticResource Half}}" HorizontalAlignment="Right" />
	  <Border Background="{TemplateBinding Background}" VerticalAlignment="Center" Width="2"
		      Height="{TemplateBinding BoxWidth, Converter={StaticResource Half}}" HorizontalAlignment="Left" />
	  <Border Height="{TemplateBinding BoxWidth}" Width="{TemplateBinding BoxHeight}" BorderThickness="2" BorderBrush="{TemplateBinding Background}"
		      HorizontalAlignment="Right" VerticalAlignment="Center" Background="White"
			  Margin="{Binding UpperQuartilePosition, Converter={StaticResource DoubleToThicknessRight}, RelativeSource={RelativeSource TemplatedParent}}" />
	  <Border Background="{TemplateBinding Background}" VerticalAlignment="Center" Width="4"
			  Height="{TemplateBinding BoxWidth}" HorizontalAlignment="Right"
			  Margin="{Binding MedianPosition, Converter={StaticResource DoubleToThicknessRight}, RelativeSource={RelativeSource TemplatedParent}}">
	    <Border.RenderTransform>
		  <TranslateTransform X="-2" />
	    </Border.RenderTransform>
	  </Border>
    </Grid>
  </ControlTemplate>
  
  <Style TargetType="local:BoxAndWhiskers">
    <Setter Property="Template" Value="{StaticResource VerticalBoxAndWhiskersTemplate}" />
    <Style.Triggers>
	  <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource Self}}" Value="Horizontal">
	    <Setter Property="Template" Value="{StaticResource HorizontalBoxAndWhiskersTemplate}" />
	  </DataTrigger>
	</Style.Triggers>
  </Style>
  
  <DataTemplate x:Key="BoxplotSeriesLegendIcon">
    <Path Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}"
          Stretch="None" Margin="0,2,0,2" StrokeThickness="3"
          VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased" />
  </DataTemplate>
  
  <Style TargetType="local:BoxplotSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource BoxplotSeriesLegendIcon}" />
  </Style>
  
  <!-- HeatMapSeries -->
  
  <local:HeatmapGradientConverter x:Key="HeatmapGradientConverter" />
  
  <DataTemplate x:Key="HeatmapSeriesLegendIcon">
    <Grid VerticalAlignment="Center" Margin="0,2,0,2" SnapsToDevicePixels="True">
	  <Border Background="{Binding DataSeries.SeriesBrush, Converter={StaticResource HeatmapGradientConverter}}" Width="38" Height="10" />
	</Grid>
  </DataTemplate>
  
  <Style TargetType="local:HeatmapSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource HeatmapSeriesLegendIcon}" />
  </Style>
  
  <!-- Bar style -->

