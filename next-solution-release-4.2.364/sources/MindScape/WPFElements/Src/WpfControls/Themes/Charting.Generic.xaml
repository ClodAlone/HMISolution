  </DataTemplate>

  <Style TargetType="local:RadarSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource RadarSeriesLegendIcon}" />
  </Style>

  <!-- PolarLineSeries -->

  <DataTemplate x:Key="PolarLineSeriesLegendIcon">
    <Grid Margin="0,2,0,2">
      <Path Data="M 0 0 L 38 0" Stroke="{Binding Converter={StaticResource LineStrokeConverter}}" Style="{Binding PolarSeries.LineStyle}"
            StrokeDashArray="{Binding Converter={StaticResource DashArrayConverter}}"
            VerticalAlignment="Center" HorizontalAlignment="Center">
        <Path.RenderTransform>
          <TranslateTransform X="0.5" Y="0.5" />
        </Path.RenderTransform>
      </Path>
      <local:PolarChartSymbol IsHitTestVisible="False" Style="{Binding PolarSeries.SymbolStyle}" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center"
                              BorderBrush="{Binding Converter={StaticResource ChartSymbolBorderConverter}}"
                              Background="{Binding Converter={StaticResource ChartSymbolBackgroundConverter}}" />
    </Grid>
  </DataTemplate>

  <Style TargetType="local:PolarLineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource PolarLineSeriesLegendIcon}" />
  </Style>

  <!-- RoseSeries -->

  <DataTemplate x:Key="RoseSeriesLegendIcon">
    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding LegendIconBrush}" Margin="0,2,0,2" />
  </DataTemplate>

  <Style TargetType="local:RoseSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource RoseSeriesLegendIcon}" />
  </Style>

  <!-- PolarSplineAreaSeries -->

  <Style TargetType="local:PolarSplineAreaSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource RadarSeriesLegendIcon}" />
  </Style>

  <!-- PolarSplineSeries -->

  <Style TargetType="local:PolarSplineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource PolarLineSeriesLegendIcon}" />
  </Style>

  <!-- PolarBubbleSeries -->

  <DataTemplate x:Key="PolarBubbleSeriesLegendIcon">
    <local:PolarBubble Width="12" Height="12" Background="{Binding LegendIconBrush}" />
  </DataTemplate>

  <Style TargetType="local:PolarBubbleSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource PolarBubbleSeriesLegendIcon}" />
  </Style>

  <!-- PolarBar style -->

  <ms:ThicknessToDoubleConverter x:Key="ThicknessToDouble" />

  <LinearGradientBrush x:Key="PolarBarBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#66000000" />
    <GradientStop Offset="1" Color="#66FFFFFF" />
  </LinearGradientBrush>

  <Style TargetType="local:PolarBar">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PolarBar">
          <Grid>
            <Path Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}" StrokeLineJoin="Round"
                  Fill="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
            <Path Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}"
                  Stroke="#99000000" Fill="{StaticResource PolarBarBackground}" StrokeLineJoin="Round"
                  StrokeThickness="{Binding BorderThickness, Converter={StaticResource ThicknessToDouble}, RelativeSource={RelativeSource TemplatedParent}}" />
            <Path Name="MouseOverBorder" Fill="#44FFFFFF" Opacity="0" IsHitTestVisible="False"
                  Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}" />
            <Path Name="SelectedBorder" Opacity="0" IsHitTestVisible="False" Fill="#66000000"
                  Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- StackedRadarSeries -->

  <Style TargetType="local:StackedRadarSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource RadarSeriesLegendIcon}" />
  </Style>

  <!-- StackedPolarLineSeries -->

  <Style TargetType="local:StackedPolarLineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource PolarLineSeriesLegendIcon}" />
  </Style>

  <!-- StackedPolarSplineAreaSeries -->

  <Style TargetType="local:StackedPolarSplineAreaSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource RadarSeriesLegendIcon}" />
  </Style>

  <!-- StackedPolarSplineSeries -->

  <Style TargetType="local:StackedPolarSplineSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource PolarLineSeriesLegendIcon}" />
  </Style>

  <!-- StackedRoseSeries -->

  <Style TargetType="local:StackedRoseSeries">
    <Setter Property="LegendIconTemplate" Value="{StaticResource RoseSeriesLegendIcon}" />
  </Style>

  <!-- PolarBubble -->

  <Style TargetType="local:PolarBubble">
    <Setter Property="Background" Value="Green" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="DarkGray" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PolarBubble">
          <Grid>
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="{Binding BorderThickness, Converter={StaticResource BubbleThickness}, RelativeSource={RelativeSource TemplatedParent}}"
                     Opacity="{Binding IsNegative, Converter={StaticResource BubbleOpacity}, RelativeSource={RelativeSource TemplatedParent}}" />
            <Ellipse Fill="#88FFFFFF" Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="{Binding BorderThickness, Converter={StaticResource BubbleThickness}, RelativeSource={RelativeSource TemplatedParent}}"
                     Opacity="0" Name="MouseOverEllipse" />
            <Ellipse Fill="#44000000" Stroke="#333333" StrokeThickness="2" Opacity="0" Name="SelectedEllipse" />
            <Ellipse>
              <Ellipse.Fill>
                <RadialGradientBrush Center="0.4,0.4" GradientOrigin="0.4,0.4">
                  <GradientStop Offset="0" Color="#AAFFFFFF" />
                  <GradientStop Offset="0.3" Color="#33FFFFFF" />
                  <GradientStop Offset="0.5" Color="#22000000" />
                  <GradientStop Offset="0.6" Color="#33000000" />
                  <GradientStop Offset="1" Color="#66000000" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverEllipse" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedEllipse" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- PolarScatterSeries -->

  <Style x:Key="DefaultPolarChartSymbolStyle" TargetType="local:PolarChartSymbol">
    <Setter Property="Margin" Value="-6,-6,6,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PolarChartSymbol">
          <Grid>
            <Ellipse Width="12" Height="12" Fill="#01000000" />
            <Ellipse Width="8" Height="8" Fill="White" StrokeThickness="1" Stroke="{TemplateBinding Background}" />
            <Ellipse Name="MouseOverShape" Width="8" Height="8" Fill="Red" StrokeThickness="1" Stroke="Red" Opacity="0" />
            <Ellipse Name="SelectedShape" Width="10" Height="10" Fill="White" StrokeThickness="2" Stroke="Black" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverShape" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedShape" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="PolarScatterSeriesLegendIcon">
    <local:PolarChartSymbol IsHitTestVisible="False" Style="{Binding PolarSeries.SymbolStyle}" HorizontalAlignment="Center"
                            Margin="0,2,0,2" VerticalAlignment="Center"
                            BorderBrush="{Binding Converter={StaticResource ChartSymbolBorderConverter}}"
                            Background="{Binding Converter={StaticResource ChartSymbolBackgroundConverter}}" />
  </DataTemplate>

  <Style TargetType="local:PolarScatterSeries">
    <Setter Property="SymbolStyle" Value="{StaticResource DefaultPolarChartSymbolStyle}" />
    <Setter Property="LegendIconTemplate" Value="{StaticResource PolarScatterSeriesLegendIcon}" />
  </Style>

  <!-- Theta axis -->

  <Style TargetType="local:ThetaAxis">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ThetaAxis">
          <Grid>
            <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rho axis -->

  <DataTemplate x:Key="RhoAxisLabelTemplate">
    <Border BorderThickness="1" BorderBrush="Black" Background="#FFFFFF" IsHitTestVisible="False">
      <ContentControl Content="{Binding}" Margin="2,-1,2,-1" />
    </Border>
  </DataTemplate>

  <Style TargetType="local:RhoAxis">
    <Setter Property="LabelTemplate" Value="{StaticResource RhoAxisLabelTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:RhoAxis">
          <Grid>
            <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Polar chart -->

  <Style TargetType="local:PolarChart">
    <Setter Property="TitleTemplate" Value="{StaticResource TitleTemplate}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="#83A5D2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PolarChart">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />

            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Row="1" Grid.Column="1">
                <!--ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0">
                  <Canvas x:Name="PART_ChartCanvas" />
                </ScrollViewer-->
                <ItemsControl ItemsSource="{Binding BackgroundElements, RelativeSource={RelativeSource TemplatedParent}}"
                              Margin="26">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Grid />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Canvas x:Name="PART_ChartCanvas" Background="#01000000" />
				<ItemsControl ItemsSource="{Binding ForegroundElements, RelativeSource={RelativeSource TemplatedParent}}"
                              Margin="26">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Grid />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ContentControl Content="{Binding ThetaAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                <ContentControl Content="{Binding RhoAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Margin="26" />
                <local:Legend ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{Binding LegendStyle, RelativeSource={RelativeSource TemplatedParent}}"
                              Visibility="{Binding LegendPosition, Converter={StaticResource CenterLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                              LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>

              <!-- This line is to add all the polar series to the visual tree -->
              <ItemsControl ItemsSource="{Binding Series, RelativeSource={RelativeSource TemplatedParent}}" Width="0" Height="0" />

              <Border Grid.Row="{Binding LegendPosition, Converter={StaticResource LegendRow}, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Column="{Binding LegendPosition, Converter={StaticResource LegendColumn}, RelativeSource={RelativeSource TemplatedParent}}">
                <local:Legend ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{Binding LegendStyle, RelativeSource={RelativeSource TemplatedParent}}"
                              Visibility="{Binding LegendPosition, Converter={StaticResource OutsideLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                              LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
            </Grid>

            <!-- Title -->
            <ContentControl Content="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>