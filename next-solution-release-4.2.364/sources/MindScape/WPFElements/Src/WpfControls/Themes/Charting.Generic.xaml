  <!-- Bubble style -->

  <local:BooleanToDoubleConverter x:Key="BubbleOpacity" TrueDouble="0.3" FalseDouble="0.9" />
  <ms:ThicknessToDoubleConverter x:Key="BubbleThickness" />

  <Style TargetType="local:Bubble">
    <Setter Property="Background" Value="Green" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="DarkGray" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:Bubble">
          <Grid>
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="{Binding BorderThickness, Converter={StaticResource BubbleThickness}, RelativeSource={RelativeSource TemplatedParent}}"
                     Opacity="{Binding IsNegative, Converter={StaticResource BubbleOpacity}, RelativeSource={RelativeSource TemplatedParent}}" />
            <Ellipse Fill="#88FFFFFF" Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="{Binding BorderThickness, Converter={StaticResource BubbleThickness}, RelativeSource={RelativeSource TemplatedParent}}"
                     Opacity="0" Name="MouseOverEllipse" />
            <Ellipse Fill="#44000000" Stroke="#333333" StrokeThickness="2" Opacity="0" Name="SelectedEllipse" />
            <Ellipse>
              <Ellipse.Fill>
                <RadialGradientBrush Center="0.4,0.4" GradientOrigin="0.4,0.4">
                  <GradientStop Offset="0" Color="#AAFFFFFF" />
                  <GradientStop Offset="0.3" Color="#33FFFFFF" />
                  <GradientStop Offset="0.5" Color="#22000000" />
                  <GradientStop Offset="0.6" Color="#33000000" />
                  <GradientStop Offset="1" Color="#66000000" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverEllipse" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedEllipse" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scatter series style -->

  <Style x:Key="DefaultChartSymbolStyle" TargetType="local:ChartSymbol">
    <Setter Property="Margin" Value="-4,-4,4,4" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ChartSymbol">
          <Grid>
            <Ellipse Width="12" Height="12" Fill="#01000000" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-4" />
            <Ellipse Fill="White" StrokeThickness="1" Stroke="{TemplateBinding Background}" />
            <Ellipse Name="MouseOverShape" Fill="Red" StrokeThickness="1" Stroke="Red" Opacity="0" />
            <Ellipse Name="SelectedShape" Fill="White" StrokeThickness="2" Stroke="Black" Opacity="0" Margin="-1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverShape" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedShape" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="ScatterSeriesLegendIcon">
    <local:ChartSymbol IsHitTestVisible="False" Style="{Binding DataSeries.SymbolStyle}" HorizontalAlignment="Center"
                       Margin="0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                       BorderBrush="{Binding Converter={StaticResource ChartSymbolBorderConverter}}"
                       Background="{Binding Converter={StaticResource ChartSymbolBackgroundConverter}}"
                       Width="{Binding Converter={StaticResource ChartSymbolSizeConverter}}"
                       Height="{Binding Converter={StaticResource ChartSymbolSizeConverter}}" />
  </DataTemplate>

  <Style TargetType="local:ScatterSeries">
    <Setter Property="SymbolStyle" Value="{StaticResource DefaultChartSymbolStyle}" />
    <Setter Property="LegendIconTemplate" Value="{StaticResource ScatterSeriesLegendIcon}" />
  </Style>

  <!-- Pie Chart -->

  <local:PieSliceToRadialGradientBrushConverter x:Key="PieSliceBrushConverter">
    <local:PieSliceToRadialGradientBrushConverter.GradientStops>
      <GradientStop Offset="0" Color="#00000000" />
      <GradientStop Offset="0.7" Color="#22000000" />
      <GradientStop Offset="0.8" Color="#33000000" />
      <GradientStop Offset="1" Color="#77000000" />
    </local:PieSliceToRadialGradientBrushConverter.GradientStops>
    <local:PieSliceToRadialGradientBrushConverter.DoughnutGradientStops>
      <GradientStop Offset="0" Color="#77000000" />
      <GradientStop Offset="0.2" Color="#33000000" />
      <GradientStop Offset="0.3" Color="#22000000" />
      <GradientStop Offset="0.5" Color="#00000000" />
      <GradientStop Offset="0.7" Color="#22000000" />
      <GradientStop Offset="0.8" Color="#33000000" />
      <GradientStop Offset="1" Color="#77000000" />
    </local:PieSliceToRadialGradientBrushConverter.DoughnutGradientStops>
  </local:PieSliceToRadialGradientBrushConverter>

  <ms:FormattingConverter x:Key="PieSlicePercentageConverter" FormatString="{}{0:0.0#\%}" />

  <Style TargetType="local:PieSlice">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PieSlice">
          <Grid>
            <Path Fill="{TemplateBinding Background}" Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}"
                  ToolTipService.Placement="Mouse">
              <!--ToolTipService.ToolTip>
                <ToolTip Content="{Binding PieSliceData, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToolTip.Template>
                    <ControlTemplate>
                      <Border Background="#ABC9EE" BorderThickness="1" BorderBrush="#83A5D2" CornerRadius="4">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="10" Color="Black" Direction="0" ShadowDepth="0" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Content.Title, RelativeSource={RelativeSource TemplatedParent}}" Margin="2,2,0,2" />
                          <TextBlock Text=":" Margin="1,2,4,2" />
                          <TextBlock Text="{Binding Content.Percentage, Converter={StaticResource PieSlicePercentageConverter}, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,2,2" />
                        </StackPanel>
                      </Border>
                    </ControlTemplate>
                  </ToolTip.Template>
                </ToolTip>
              </ToolTipService.ToolTip-->
            </Path>
            <Path Name="MouseOverPath" Fill="#44FFFFFF" Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"
                  StrokeThickness="1" Stroke="Gray" StrokeLineJoin="Round" IsHitTestVisible="False" />
            <Path Name="SelectedPath" Data="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"
                  StrokeThickness="2" Stroke="Black" StrokeLineJoin="Round" IsHitTestVisible="False" />
            <Canvas Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Clip="{Binding PathData, RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{Binding Self, Converter={StaticResource PieSliceBrushConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverPath" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Duration="0:0:000.20" Storyboard.TargetProperty="ExplodedDistance" To="10" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Duration="0:0:000.20" Storyboard.TargetProperty="ExplodedDistance" To="0" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="local:PieChart">
    <Setter Property="TitleTemplate" Value="{StaticResource TitleTemplate}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="#83A5D2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />

            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Row="1" Grid.Column="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0">
                  <Canvas x:Name="PART_ChartCanvas" />
                </ScrollViewer>
                <local:Legend ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{Binding LegendStyle, RelativeSource={RelativeSource TemplatedParent}}"
                              Visibility="{Binding LegendPosition, Converter={StaticResource CenterLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                              LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
              <!--Border BorderThickness="1,0,1,1" BorderBrush="#83A5D2" Grid.Column="1" Margin="10,0,0,0">
                <Border BorderThickness="1" BorderBrush="#EFF6FF" Background="#ABC9EE">
                  <StackPanel>
                    <TextBlock Text="Legend" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Left" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                                  ItemTemplate="{StaticResource LegendItemTemplate}" Margin="5,0,5,2" />
                  </StackPanel>
                </Border>
              </Border-->
              <!-- This line is to add the PieSeries to the visual tree -->
              <ItemsControl ItemsSource="{Binding Series, RelativeSource={RelativeSource TemplatedParent}}" Width="0" Height="0" />

              <Border Grid.Row="{Binding LegendPosition, Converter={StaticResource LegendRow}, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Column="{Binding LegendPosition, Converter={StaticResource LegendColumn}, RelativeSource={RelativeSource TemplatedParent}}">
                <local:Legend ItemsSource="{Binding LegendItems, RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{Binding LegendStyle, RelativeSource={RelativeSource TemplatedParent}}"
                              Visibility="{Binding LegendPosition, Converter={StaticResource OutsideLegendVisibility}, RelativeSource={RelativeSource TemplatedParent}}"
                              LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
            </Grid>
            <!-- Title -->
            <!--Border BorderThickness="1" BorderBrush="#83A5D2">
              <Border BorderThickness="1" BorderBrush="#EFF6FF" Background="#ABC9EE">
                <TextBlock FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"
                       Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
            </Border-->
            <ContentControl Content="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />

          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

