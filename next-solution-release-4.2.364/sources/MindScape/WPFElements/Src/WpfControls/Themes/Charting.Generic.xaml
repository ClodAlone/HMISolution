<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mindscape.WpfElements.Charting"
    xmlns:ms="clr-namespace:Mindscape.WpfElements">

  <ms:BooleanToVisibilityConverter x:Key="bvc" />
  <ms:BooleanToVisibilityConverter x:Key="ibvc" IsInverted="True" />

  <!-- Slider styles -->

  <ms:DoubleToVisibilityConverter x:Key="GripperVisibility" VisibleThreshold="24" />
  
  <SolidColorBrush x:Key="ScrollBarBackground" Color="#EDEDED" />
  <SolidColorBrush x:Key="ScrollBarBorder" Color="#959595" />
  <SolidColorBrush x:Key="ScrollBarInnerBorder" Color="#E7E7E8" />
  <SolidColorBrush x:Key="ScrollBarGripperColor" Color="#77000000" />
  <SolidColorBrush x:Key="ScrollBarLightGripperColor" Color="#99FFFFFF" />

  <LinearGradientBrush x:Key="HorizontalMousePressedScrollBarColor" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C1E8F8" />
    <GradientStop Offset="0.5" Color="#B3E2F7" />
    <GradientStop Offset="0.5" Color="#6EC7ED" />
    <GradientStop Offset="1" Color="#68BDE0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HorizontalScrollBarForeground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#EFEFEF" />
    <GradientStop Offset="0.5" Color="#E9E9EA" />
    <GradientStop Offset="0.5" Color="#D2D3D5" />
    <GradientStop Offset="1" Color="#C1C2C5" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HorizontalMouseOverScrollBarColor" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DEF2FC" />
    <GradientStop Offset="0.5" Color="#D7EFFB" />
    <GradientStop Offset="0.5" Color="#A8DAF5" />
    <GradientStop Offset="1" Color="#A5D6F0" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="VerticalMousePressedScrollBarColor" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#C1E8F8" />
    <GradientStop Offset="0.5" Color="#B3E2F7" />
    <GradientStop Offset="0.5" Color="#6EC7ED" />
    <GradientStop Offset="1" Color="#68BDE0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="VerticalScrollBarForeground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#EFEFEF" />
    <GradientStop Offset="0.5" Color="#E9E9EA" />
    <GradientStop Offset="0.5" Color="#D2D3D5" />
    <GradientStop Offset="1" Color="#C1C2C5" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="VerticalMouseOverScrollBarColor" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#DEF2FC" />
    <GradientStop Offset="0.5" Color="#D7EFFB" />
    <GradientStop Offset="0.5" Color="#A8DAF5" />
    <GradientStop Offset="1" Color="#A5D6F0" />
  </LinearGradientBrush>
  
  <ControlTemplate x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
    <Border Background="Transparent" />
  </ControlTemplate>

  <SolidColorBrush x:Key="TimeExplorerMainDualSliderForeground" Color="Black" />

  <!-- Horizontal -->
  
  <Style x:Key="ChartAxisHorizontalStartThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="11" Margin="-9,0,9,0">
            <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="1,1,0,1" Background="{StaticResource ScrollBarInnerBorder}" Width="9" HorizontalAlignment="Left">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" Margin="1,1,0,1" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="7" Orientation="Horizontal">
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
            </StackPanel>
            <Border Name="Etch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,0,1,0" Margin="0,1,0,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Right" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChartAxisHorizontalEndThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="11" Margin="-2,0,0,0">
            <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="0,1,1,1" Background="{StaticResource ScrollBarInnerBorder}" Width="9" HorizontalAlignment="Right">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" BorderThickness="0,1,1,1" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="7" Orientation="Horizontal">
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
            </StackPanel>
            <Border Name="Etch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="1,0,0,0" Margin="0,1,0,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Left" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChartAxisHorizontalRangeThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border BorderThickness="0,1,0,1" BorderBrush="{StaticResource ScrollBarBorder}" Background="{StaticResource ScrollBarInnerBorder}">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" Margin="0,1,0,1" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="7" Orientation="Horizontal"
                        Visibility="{Binding ActualWidth, Converter={StaticResource GripperVisibility}, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
            </StackPanel>
            <Border Name="LeftEtch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,0,1,0" Margin="0,1,0,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Left" Visibility="Hidden" />
            <Border Name="RightEtch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="1,0,0,0" Margin="0,1,1,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Right" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
              <Setter TargetName="LeftEtch" Property="Visibility" Value="Visible" />
              <Setter TargetName="RightEtch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
              <Setter TargetName="LeftEtch" Property="Visibility" Value="Visible" />
              <Setter TargetName="RightEtch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- Vertical -->
  
  <Style x:Key="ChartAxisVerticalStartThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Height="11" Margin="0,9,0,-9">
            <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="1,0,1,1" Background="{StaticResource ScrollBarInnerBorder}" Height="9" VerticalAlignment="Bottom">
              <Border Name="InnerBorder" Background="{StaticResource VerticalScrollBarForeground}" Margin="1,0,1,1" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="7" Orientation="Vertical">
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
            </StackPanel>
            <Border Name="Etch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,1,0,0" Margin="1,0,1,0"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Height="2" VerticalAlignment="Top" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource VerticalMouseOverScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource VerticalMousePressedScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChartAxisVerticalEndThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Height="11" Margin="0,0,0,-2">
            <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="1,1,1,0" Background="{StaticResource ScrollBarInnerBorder}" Height="9" VerticalAlignment="Top">
              <Border Name="InnerBorder" Background="{StaticResource VerticalScrollBarForeground}" BorderThickness="1,1,1,0" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="7" Orientation="Vertical">
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
            </StackPanel>
            <Border Name="Etch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,0,0,1" Margin="1,0,1,0"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Height="2" VerticalAlignment="Bottom" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource VerticalMouseOverScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource VerticalMousePressedScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChartAxisVerticalRangeThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border BorderThickness="1,0,1,0" BorderBrush="{StaticResource ScrollBarBorder}" Background="{StaticResource ScrollBarInnerBorder}">
              <Border Name="InnerBorder" Background="{StaticResource VerticalScrollBarForeground}" Margin="1,0,1,0" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="7" Orientation="Vertical"
                        Visibility="{Binding ActualHeight, Converter={StaticResource GripperVisibility}, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Height="1" Background="{StaticResource ScrollBarLightGripperColor}" />
            </StackPanel>
            <Border Name="BottomEtch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,1,0,0" Margin="1,0,1,0"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Height="2" VerticalAlignment="Bottom" Visibility="Hidden" />
            <Border Name="TopEtch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,0,0,1" Margin="1,1,1,0"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Height="2" VerticalAlignment="Top" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource VerticalMouseOverScrollBarColor}" />
              <Setter TargetName="BottomEtch" Property="Visibility" Value="Visible" />
              <Setter TargetName="TopEtch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource VerticalMousePressedScrollBarColor}" />
              <Setter TargetName="BottomEtch" Property="Visibility" Value="Visible" />
              <Setter TargetName="TopEtch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- Chart axis slider templates -->

  <ControlTemplate x:Key="ChartAxisHorizontalDualSliderTemplate">
    <Grid Background="{TemplateBinding Background}">
      <Grid x:Name="PART_Root" Background="Transparent" VerticalAlignment="Center" Margin="1">
        <RepeatButton x:Name="PART_LargeDecreaseButton" HorizontalAlignment="Left" Template="{StaticResource InvisibleRepeatButton}" />
        <RepeatButton x:Name="PART_LargeIncreaseButton" HorizontalAlignment="Left" Template="{StaticResource InvisibleRepeatButton}" />
        <Thumb x:Name="PART_RangeThumb" Style="{StaticResource ChartAxisHorizontalRangeThumbStyle}" HorizontalAlignment="Left" Height="13" />
        <Thumb x:Name="PART_StartThumb" Style="{StaticResource ChartAxisHorizontalStartThumbStyle}" HorizontalAlignment="Left" Cursor="SizeWE" />
        <Thumb x:Name="PART_EndThumb" Style="{StaticResource ChartAxisHorizontalEndThumbStyle}" HorizontalAlignment="Left" Cursor="SizeWE" />
      </Grid>
    </Grid>
  </ControlTemplate>
  
  <ControlTemplate x:Key="ChartAxisVerticalDualSliderTemplate">
    <Grid Background="{TemplateBinding Background}">
      <Grid x:Name="PART_Root" Background="Transparent" HorizontalAlignment="Center" Margin="1">
        <RepeatButton x:Name="PART_LargeDecreaseButton" VerticalAlignment="Bottom" Template="{StaticResource InvisibleRepeatButton}" />
        <RepeatButton x:Name="PART_LargeIncreaseButton" VerticalAlignment="Bottom" Template="{StaticResource InvisibleRepeatButton}" />
        <Thumb x:Name="PART_RangeThumb" Style="{StaticResource ChartAxisVerticalRangeThumbStyle}" VerticalAlignment="Bottom" Width="13" />
        <Thumb x:Name="PART_StartThumb" Style="{StaticResource ChartAxisVerticalStartThumbStyle}" VerticalAlignment="Bottom" Cursor="SizeNS" />
        <Thumb x:Name="PART_EndThumb" Style="{StaticResource ChartAxisVerticalEndThumbStyle}" VerticalAlignment="Bottom" Cursor="SizeNS" />
      </Grid>
    </Grid>
  </ControlTemplate>
  
  <Style x:Key="ChartAxisDualSliderStyle" TargetType="{x:Type ms:DualSlider}">
    <Setter Property="Background" Value="{StaticResource ScrollBarBackground}" />
    <Setter Property="EndBuffer" Value="9" />
    <Setter Property="Template" Value="{StaticResource ChartAxisHorizontalDualSliderTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource ChartAxisVerticalDualSliderTemplate}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  
  <!-- Axis styles -->
  
  <DataTemplate x:Key="VerticalTickTemplate">
    <Border BorderThickness="0,1,0,0" BorderBrush="Black" MinHeight="1" Width="6" Height="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </DataTemplate>

  <DataTemplate x:Key="MinorVerticalTickTemplate">
    <Border BorderThickness="0,1,0,0" BorderBrush="Black" MinHeight="1" Width="3" Height="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </DataTemplate>

  <DataTemplate x:Key="HorizontalTickTemplate">
    <Border BorderThickness="0,0,1,0" BorderBrush="Black" MinWidth="1" Height="6" Width="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Top" />
  </DataTemplate>

  <DataTemplate x:Key="MinorHorizontalTickTemplate">
    <Border BorderThickness="0,0,1,0" BorderBrush="Black" MinWidth="1" Height="3" Width="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Top" />
  </DataTemplate>

  <!--local:DoubleToThicknessConverter x:Key="HorizontalAxisLabelMargin" IsLeft="True" />
  <local:DoubleToThicknessConverter x:Key="VerticalAxisLabelMargin" IsBottom="True" />
  <local:DoubleToThicknessConverter x:Key="HorizontalLabelLevelMargin" IsTop="True" />

  <local:AxisLabelToRotateTransformConverter x:Key="AxisLabelRotation" /-->

