<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="http://namespaces.mindscape.co.nz/wpf">

  <SolidColorBrush x:Key="FlatButtonOuterBorderBrush" Color="#FF3C7FB1" />
  <SolidColorBrush x:Key="FlatButtonInnerBorderBrush" Color="#FFFAFDFE" />
  <SolidColorBrush x:Key="FlatButtonInnerBorderBrush_Down" Color="#FF9EB0BA" />
  
  <SolidColorBrush x:Key="{x:Static local:FilteringTextBoxBase.BorderBrushKey}" Color="#FF3C7FB1" />

  <Style x:Key="FlatButtonOuterBorder" TargetType="{x:Type Border}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource FlatButtonInnerBorderBrush}" />
    <Setter Property="Background" Value="{StaticResource FlatButtonInnerBorderBrush}" />
  </Style>

  <Style x:Key="FlatButtonInnerBorder" TargetType="{x:Type Border}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource FlatButtonInnerBorderBrush}" />
    <Setter Property="Background" Value="{StaticResource FlatButtonInnerBorderBrush}" />
  </Style>

  <LinearGradientBrush x:Key="FlatButtonFillBrush_Hot" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFEAF6FD" />
    <GradientStop Offset="1" Color="#FFA7D9F5" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="FlatButtonFillBrush_Down" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFE4F3FB" />
    <GradientStop Offset="1" Color="#FF68B3DB" />
  </LinearGradientBrush>

  <Style x:Key="{x:Static local:DropDownEditBox.ToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Style="{StaticResource FlatButtonOuterBorder}" Name="OuterBorder">
            <Border Style="{StaticResource FlatButtonInnerBorder}" Padding="3,3,3,0" Name="InnerBorder">
              <Polygon Fill="Black" Points="0,0 7,0 3.5,4" VerticalAlignment="Center" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource FlatButtonFillBrush_Hot}" />
              <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource FlatButtonOuterBorderBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource FlatButtonFillBrush_Down}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource FlatButtonInnerBorderBrush_Down}" />
              <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource FlatButtonOuterBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:Spin.SpinButtonStyleKey}" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Style="{StaticResource FlatButtonOuterBorder}" Padding="1,1.5,1.5,1.5" Name="Bd">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource FlatButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource FlatButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:MonthCalendar.SelectButtonStyleKey}" TargetType="ButtonBase">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Style="{StaticResource FlatButtonOuterBorder}" Padding="6,4,6,4" Name="Bd">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource FlatButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource FlatButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>