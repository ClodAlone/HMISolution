<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mindscape.WpfElements"
                    xmlns:dg="clr-namespace:Mindscape.WpfElements.WpfDataGrid"
                    xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
                    xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid"
                    >
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Common.Generic.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="bvc" />
  <local:BooleanToVisibilityConverter x:Key="bvc_hidden" Invisibility="Hidden" />
  <dg:DataGridPagerVisibilityConverter x:Key="DataGridPagerVisibility" />

  <SolidColorBrush x:Key="MouseOverTextColor" Color="Black" />
  <SolidColorBrush x:Key="ReadonlyTextColor" Color="#6D6D6D" />

  <SolidColorBrush x:Key="DataGridBorder" Color="#707070" />
  <SolidColorBrush x:Key="DisabledForeground" Color="#888888" />
  <SolidColorBrush x:Key="TextColor" Color="Black" />

  <LinearGradientBrush x:Key="DataGridColumnHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F2F2F2" />
    <GradientStop Offset="0.4" Color="#ECECEC" />
    <GradientStop Offset="0.4" Color="#DBDBDB" />
    <GradientStop Offset="1" Color="#CFCFCF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverDataGridColumnHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E7F5FD" />
    <GradientStop Offset="0.4" Color="#DAF0FC" />
    <GradientStop Offset="0.4" Color="#BDE6FD" />
    <GradientStop Offset="1" Color="#AADBF6" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MousePressedDataGridColumnHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C2E4F6" />
    <GradientStop Offset="0.4" Color="#C2E4F6" />
    <GradientStop Offset="0.4" Color="#A9DAF3" />
    <GradientStop Offset="1" Color="#91CCEB" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="MouseOverDataGridBackground" Color="#EFEFEF" />
  <SolidColorBrush x:Key="SelectedDataGridBackground" Color="#8CC5FF" />

  <LinearGradientBrush x:Key="FrozenShadow" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#DD000000" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="FrozenRowShadow" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DD000000" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="DataGridRowHeaderBackground" Color="#DBDBDB" />
  
  <SolidColorBrush x:Key="InnerBorder" Color="#F6F6F6" />
  <SolidColorBrush x:Key="MouseOverDataGridBorder" Color="#F7CD34" />
  <SolidColorBrush x:Key="SelectedDataGridBorder" Color="#FB8C3C" />
  <SolidColorBrush x:Key="DataGridCellHighlightedBorder" Color="#000000" />
  <SolidColorBrush x:Key="DataGridCellEditingBorder" Color="#CC5500" />
  <SolidColorBrush x:Key="DataGridCellNotValidBorder" Color="Red" />

  <Style x:Key="GridViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="Background" Value="{StaticResource DataGridBorder}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Padding="{TemplateBinding Padding}" Background="Transparent">
            <Rectangle HorizontalAlignment="Center" Width="0" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <SolidColorBrush x:Key="MouseOverUngroupColumnButtonBorder" Color="#772011" />
  <SolidColorBrush x:Key="MouseOverUngroupColumnButtonInnerBorder" Color="#DAB3AF" />

  <LinearGradientBrush x:Key="MouseOverUngroupColumnButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D1A19C" />
    <GradientStop Offset="0.5" Color="#D47668" />
    <GradientStop Offset="0.5" Color="#C23823" />
    <GradientStop Offset="1" Color="#D17C63" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PressedUngroupColumnButtonBorder" Color="#703A28" />
  <SolidColorBrush x:Key="PressedUngroupColumnButtonInnerBorder" Color="#A48D87" />

  <LinearGradientBrush x:Key="PressedUngroupColumnButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D1A993" />
    <GradientStop Offset="0.5" Color="#B9765B" />
    <GradientStop Offset="0.5" Color="#8A1E08" />
    <GradientStop Offset="1" Color="#8E6B1F" />
  </LinearGradientBrush>

  <Style x:Key="UngroupColumnButton" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Name="Border" BorderThickness="1" CornerRadius="2" BorderBrush="Transparent">
            <Border Name="InnerBorder" BorderThickness="1" CornerRadius="2" BorderBrush="Transparent" Background="Transparent">
              <Path Name="Path" StrokeThickness="2" Stroke="Gray" Data="M 0 0 L 1 1 M 1 0 L 0 1" StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round" Stretch="Fill" Width="7" Height="7" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverUngroupColumnButtonBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverUngroupColumnButtonInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MouseOverUngroupColumnButtonBackground}" />
              <Setter TargetName="Path" Property="Stroke" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedUngroupColumnButtonBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedUngroupColumnButtonInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource PressedUngroupColumnButtonBackground}" />
              <Setter TargetName="Path" Property="Stroke" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <SolidColorBrush x:Key="DisabledBorder" Color="#ADB2B5" />
  <SolidColorBrush x:Key="DisabledInnerBorder" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DisabledBackground" Color="#F4F4F4" />
  
  <SolidColorBrush x:Key="MouseOverBorder" Color="#3C7FB1" />
  <SolidColorBrush x:Key="MouseOverInnerBorder" Color="#D6EDFA" />
  <SolidColorBrush x:Key="PressedBorder" Color="#2C628B" />
  <SolidColorBrush x:Key="PressedInnerBorder" Color="#B0CDDD" />
  
  <Style x:Key="RemoveFilterButton" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
	<Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource DataGridBorder}" />
	<Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Name="Border" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
            <Border Name="InnerBorder" BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverUngroupColumnButtonBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverUngroupColumnButtonInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MouseOverUngroupColumnButtonBackground}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedUngroupColumnButtonBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedUngroupColumnButtonInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource PressedUngroupColumnButtonBackground}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
			<Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource DisabledBackground}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource DisabledInnerBorder}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <DataTemplate x:Key="ObjectFilterSelectorTemplate">
    <StackPanel Width="160">
	  <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}" Content="Select all" Margin="4,3,0,4" />
	  <Border BorderThickness="1" BorderBrush="{StaticResource DataGridBorder}">
        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="White" Padding="3,2,2,1">
          <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource SelectableObjectTemplate}" />
	    </ScrollViewer>
	  </Border>
	</StackPanel>
  </DataTemplate>
  
  <local:MatchingTemplateSelector x:Key="FilterDescriptionTemplateSelector" BasedOn="{StaticResource SecondaryFilterDescriptionTemplateSelector}">
    <local:TypeTemplate DataType="{x:Type dg:BooleanFilterDescription}" Template="{StaticResource BooleanFilterSelectorTemplate}" />
	<local:TypeTemplate DataType="{x:Type dg:ObjectFilterDescription}" Template="{StaticResource ObjectFilterSelectorTemplate}" />
  </local:MatchingTemplateSelector>
  
  <DataTemplate x:Key="ColumnFilterTemplate">
    <StackPanel>
      <ContentControl Content="{Binding Description}" ContentTemplateSelector="{StaticResource FilterDescriptionTemplateSelector}" />
	  <Button Content="Clear filter" Command="{x:Static dg:DataGridCommands.RemoveFilter}" CommandParameter="{Binding Column}"
	          Style="{StaticResource RemoveFilterButton}" Margin="0,8,0,0" />
	</StackPanel>
  </DataTemplate>
  
  <dg:ColumnToColumnFilterConverter x:Key="ColumnToColumnFilter" />
  
  <SolidColorBrush x:Key="PopupBackground" Color="#F6F6F6" />
  <SolidColorBrush x:Key="FilterBrush" Color="#3399FF" />
  
  <Style x:Key="ShadowStyle" TargetType="Border">
    <Setter Property="Effect">
      <Setter.Value>
        <local:IfFullTrust>
          <![CDATA[
            <DropShadowEffect xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Color="Black" Direction="-45" Opacity="0.6" />
          ]]>
        </local:IfFullTrust>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="FilterButton" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
		<Grid>
          <Border Name="Border" BorderThickness="1" CornerRadius="2" BorderBrush="Transparent">
            <Border Name="InnerBorder" BorderThickness="1" CornerRadius="2" BorderBrush="Transparent" Background="Transparent">
              <Path Name="Path" Fill="{StaticResource FilterBrush}" Data="M 0 0 L 1 0 L 0.6 0.4 L 0.6 1 L 0.4 0.8 L 0.4 0.4 Z" StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round" Stretch="Fill" Width="10" Height="9" />
            </Border>
          </Border>
		    <dg:FilterPopup Name="Popup" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" StaysOpen="False" AllowsTransparency="True" Focusable="True">
			  <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}">
                <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource DataGridBorder}" BorderThickness="1"
                        Style="{StaticResource ShadowStyle}" Padding="3">
				  <ContentControl Content="{Binding Column, Converter={StaticResource ColumnToColumnFilter}, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridColumnHeader}}}"
				                  ContentTemplate="{StaticResource ColumnFilterTemplate}" />
				</Border>
			  </Grid>
			</dg:FilterPopup>
		  </Grid>
          <ControlTemplate.Triggers>
		    <DataTrigger Binding="{Binding Column.Filter, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridColumnHeader}}}" Value="{x:Null}">
			  <Setter TargetName="Path" Property="Fill" Value="Gray" />
			</DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MouseOverDataGridColumnHeaderBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MousePressedDataGridColumnHeaderBackground}" />
              <Setter TargetName="Path" Property="Fill" Value="Black" />
            </Trigger>
			<Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="0,0,20,20" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <dg:DataGridColumnToFilterVisibilityConverter x:Key="FilterButtonVisibility" />

  <Style x:Key="GridViewColumnHeaderStyle" TargetType="{x:Type dg:DataGridColumnHeader}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource DataGridBorder}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
          <Grid>
            <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridBorder}" Padding="0">
              <Border Name="HeaderBorder" BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridColumnHeaderBackground}" Padding="4,0,4,0">
			    <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
				  <Grid.ColumnDefinitions>
				    <ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				  </Grid.ColumnDefinitions>
                  <ContentPresenter Name="HeaderContent" Margin="0,0,0,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
				  <ToggleButton Name="FilterButton" Style="{StaticResource FilterButton}" Grid.Column="1" Margin="8,1,0,0"
				                Visibility="{Binding Column, Converter={StaticResource FilterButtonVisibility}, RelativeSource={RelativeSource TemplatedParent}}" />
				</Grid>
              </Border>
            </Border>
            <Path Data="M 0 1 L 0.5 0 L 1 1 Z" Stretch="Fill" Fill="Transparent" IsHitTestVisible="False" Width="5" Height="3" SnapsToDevicePixels="True"
                  VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,0,0" Name="SortArrow" />
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-8,0" Style="{StaticResource GridViewColumnHeaderGripper}"
                   IsEnabled="{Binding Column.AllowResize, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
			  <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition SourceName="FilterButton" Property="IsMouseOver" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource MouseOverDataGridColumnHeaderBackground}" />
              <Setter Property="Foreground" Value="{StaticResource MouseOverTextColor}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource MousePressedDataGridColumnHeaderBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
            <DataTrigger Binding="{Binding Column.SortDirection, RelativeSource={RelativeSource Self}}" Value="Ascending">
              <Setter TargetName="SortArrow" Property="Fill" Value="Black" />
              <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource MousePressedDataGridColumnHeaderBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Column.SortDirection, RelativeSource={RelativeSource Self}}" Value="Descending">
              <Setter TargetName="SortArrow" Property="Fill" Value="Black" />
              <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 1 0 L 0.5 1 Z" />
              <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource MousePressedDataGridColumnHeaderBackground}" />
            </DataTrigger>
			<DataTrigger Binding="{Binding IsColumnHeaderFilterVisible, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="False">
			  <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Column.AllowFiltering, RelativeSource={RelativeSource Self}}" Value="False">
			  <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Role" Value="Floating">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
              <Border BorderThickness="1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridBorder}" Padding="0">
                <Border BorderThickness="1" BorderBrush="White" Background="{StaticResource DataGridColumnHeaderBackground}">
                  <ContentPresenter Margin="0,0,0,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Role" Value="Padding">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
              <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridBorder}" Padding="0">
                <Border BorderThickness="1" BorderBrush="White" Background="{StaticResource DataGridColumnHeaderBackground}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Role" Value="Grouping">
        <Setter Property="Margin" Value="11,0,0,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
              <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding BorderBrush}" Padding="0">
                <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{TemplateBinding Background}">
                  <Grid>
                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    <Button Name="UngroupButton" Style="{StaticResource UngroupColumnButton}" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="3" Visibility="Hidden"
                            Command="{x:Static dg:DataGridCommands.UngroupColumn}" CommandParameter="{TemplateBinding Column}" />
                  </Grid>
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="UngroupButton" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="DataGridColumnHeaderTemplate">
    <TextBlock Text="{Binding}" Margin="0,4,0,2" Height="17" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </DataTemplate>
  
  <DataTemplate x:Key="GroupedDataGridColumnHeaderTemplate">
    <TextBlock Text="{Binding}" Margin="22,1,22,1" IsHitTestVisible="False" VerticalAlignment="Center" />
  </DataTemplate>

  <SolidColorBrush x:Key="HeaderDropIndicatorBackground" Color="#000080" />

  <DataTemplate x:Key="ColumnHeaderIndentTemplate">
    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridBorder}"
            Width="{Binding GroupingIndent, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
      <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridColumnHeaderBackground}" />
    </Border>
  </DataTemplate>
  
  <Style x:Key="{x:Type dg:DataGridHeaderRowPresenter}" TargetType="{x:Type dg:DataGridHeaderRowPresenter}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridHeaderRowPresenter}">
          <DockPanel>
            <ItemsControl ItemsSource="{Binding GroupedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                          ItemTemplate="{StaticResource ColumnHeaderIndentTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid Grid.ColumnSpan="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ItemsPresenter ClipToBounds="True" />
              <ContentControl Content="{Binding PaddingColumnHeader, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1" />
              <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Grid.ColumnSpan="2"
                          Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
                <Border Width="4" Background="{StaticResource FrozenShadow}" />
              </StackPanel>
              <!-- TODO: this next part (the drop indicator) is duplicated in the grouping panel. Refactor this out and add a property to change it.-->
              <Grid Margin="-5,0,5,1" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.ColumnSpan="2"
                    Visibility="{Binding IsRequestingColumnDropPosition, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="Transform" X="{Binding ColumnDropRequestPosition, RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid.RenderTransform>
                <Border Width="3" Background="{StaticResource HeaderDropIndicatorBackground}" HorizontalAlignment="Center" />
                <Path Width="9" Height="7" Data="M 0 0 L 1 0 L 0.5 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Center" />
                <Path Width="9" Height="7" Data="M 0.5 0 L 0 1 L 1 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
              </Grid>
            </Grid>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= -->
  <!--   Filter styles   -->
  <!-- ================= -->
  
  <dg:ColumnToColumnFilterConverter x:Key="SimpleColumnToColumnFilter" UseBooleanFilter="False" />
  
  <DataTemplate x:Key="SimpleStringFilterSelectorTemplate">
    <DockPanel>
	  <ToggleButton IsChecked="{Binding Description.MatchCase, Mode=TwoWay}" Content="Aa" Margin="2,0,0,0" DockPanel.Dock="Right" ToolTip="Match case" />
	  <TextBox Text="{Binding Description.FirstValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
    </DockPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="StringFilterTemplate">
	<ContentControl Margin="2" Content="{Binding Converter={StaticResource SimpleColumnToColumnFilter}}" ContentTemplate="{StaticResource SimpleStringFilterSelectorTemplate}" />
  </DataTemplate>
  
  <dg:NumericFilterToStringConverter x:Key="NumericFilterToString" />
  
  <DataTemplate x:Key="NumericFilterTemplate">
    <TextBox Margin="2" Text="{Binding Filter, Converter={StaticResource NumericFilterToString}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
  </DataTemplate>
  
  <pe:EnumValuesConverter x:Key="EnumValuesConverter" HasEmptyValue="True" />
  <dg:ObjectFilterToObjectConverter x:Key="ObjectFilterToObject" />
  
  <pe:ListSelectDisplayConverter x:Key="ListSelectDisplayConverter" />
  
  <DataTemplate x:Key="ListSelectItem">
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource ListSelectDisplayConverter}">
          <Binding />
          <Binding Path="(pe:ListSelectDisplayContext.PropertyInfo)" RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </DataTemplate>
  
  <DataTemplate x:Key="EnumFilterTemplate">
    <ComboBox Margin="2" IsEditable="True"
	          ItemsSource="{Binding PropertyInfo, Converter={StaticResource EnumValuesConverter}}"
			  ItemTemplate="{StaticResource ListSelectItem}"
			  pe:ListSelectDisplayContext.PropertyInfo="{Binding PropertyInfo}"
			  SelectedValue="{Binding Filter, Converter={StaticResource ObjectFilterToObject}, Mode=TwoWay}" />
  </DataTemplate>
  
  <DataTemplate x:Key="NoFilterTemplate" />
  
  <dg:FilterTemplateSelector x:Key="FilterTemplateSelector"
                             StringFilterTemplate="{StaticResource StringFilterTemplate}"
							 NumericFilterTemplate="{StaticResource NumericFilterTemplate}"
							 EnumFilterTemplate="{StaticResource EnumFilterTemplate}"
							 NoFilterTemplate="{StaticResource NoFilterTemplate}" />
  
  <Style x:Key="FilterCellContainerStyle" TargetType="ContentControl">
    <Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate TargetType="ContentControl">
		  <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource DataGridBorder}">
		    <ContentPresenter />
		  </Border>
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <Style x:Key="{x:Type dg:DataGridFilterRow}" TargetType="{x:Type dg:DataGridFilterRow}">
    <Setter Property="ItemTemplateSelector" Value="{StaticResource FilterTemplateSelector}" />
	<Setter Property="ItemsPanel">
	  <Setter.Value>
	    <ItemsPanelTemplate>
		  <dg:DataGridRowPanel />
		</ItemsPanelTemplate>
	  </Setter.Value>
	</Setter>
	<Setter Property="ItemContainerStyle" Value="{StaticResource FilterCellContainerStyle}" />
	<Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate>
		  <DockPanel>
		    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}" Name="RowHeader"
			        Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
				    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
			  <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridRowHeaderBackground}" />
		    </Border>
		    <ItemsControl ItemsSource="{Binding GroupedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			 			  DockPanel.Dock="Left">
			  <ItemsControl.ItemsPanel>
			    <ItemsPanelTemplate>
				  <StackPanel Orientation="Horizontal" />
			    </ItemsPanelTemplate>
			  </ItemsControl.ItemsPanel>
			  <ItemsControl.ItemTemplate>
			    <DataTemplate>
				  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}"
						  Width="{Binding GroupingIndent, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			    </DataTemplate>
			  </ItemsControl.ItemTemplate>
		    </ItemsControl>
		    <Grid>
			  <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DataGridBorder}">
			    <ItemsPresenter />
			  </Border>
			  <StackPanel Orientation="Horizontal" Grid.Column="2"
						  Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
			    <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			    <Border Width="4" Background="{StaticResource FrozenShadow}" />
			  </StackPanel>
		    </Grid>
		  </DockPanel>
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <DataTemplate x:Key="NoAggregateTemplate" />
  
  <DataTemplate x:Key="SumAggregateTemplate">
    <StackPanel Orientation="Horizontal" Margin="3" VerticalAlignment="Center">
      <TextBlock Text="Total: " />
      <TextBlock Text="{Binding Aggregate.Result, StringFormat={}{0:0.##}}" />
    </StackPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="CountAggregateTemplate">
    <StackPanel Orientation="Horizontal" Margin="3" VerticalAlignment="Center">
      <TextBlock Text="Count: " />
      <TextBlock Text="{Binding Aggregate.Result}" />
    </StackPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="AverageAggregateTemplate">
    <StackPanel Orientation="Horizontal" Margin="3" VerticalAlignment="Center">
      <TextBlock Text="Avg: " />
      <TextBlock Text="{Binding Aggregate.Result, StringFormat={}{0:0.##}}" />
    </StackPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="MinimumAggregateTemplate">
    <StackPanel Orientation="Horizontal" Margin="3" VerticalAlignment="Center">
      <TextBlock Text="Min: " />
      <TextBlock Text="{Binding Aggregate.Result}" />
    </StackPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="MaximumAggregateTemplate">
    <StackPanel Orientation="Horizontal" Margin="3" VerticalAlignment="Center">
      <TextBlock Text="Max: " />
      <TextBlock Text="{Binding Aggregate.Result}" />
    </StackPanel>
  </DataTemplate>
  
  <local:ArithmeticConverter x:Key="Times100" Multiplier="100" />
  
  <DataTemplate x:Key="ModeAggregateTemplate">
    <StackPanel Orientation="Horizontal" Margin="3" VerticalAlignment="Center">
      <TextBlock Text="{Binding Aggregate.Result.Percentage, Converter={StaticResource Times100}, StringFormat={}{0:0}%}" />
      <TextBlock Text="{Binding Aggregate.Result.Value}" Margin="8,0,0,0" />
    </StackPanel>
  </DataTemplate>
  
  <dg:FooterTemplateSelector x:Key="FooterTemplateSelector"
                             NoAggregateTemplate="{StaticResource NoAggregateTemplate}"
							 SumAggregateTemplate="{StaticResource SumAggregateTemplate}"
							 CountAggregateTemplate="{StaticResource CountAggregateTemplate}"
							 AverageAggregateTemplate="{StaticResource AverageAggregateTemplate}"
							 MinimumAggregateTemplate="{StaticResource MinimumAggregateTemplate}"
							 MaximumAggregateTemplate="{StaticResource MaximumAggregateTemplate}"
							 ModeAggregateTemplate="{StaticResource ModeAggregateTemplate}" />
  
  <Style x:Key="{x:Type dg:DataGridFooter}" TargetType="{x:Type dg:DataGridFooter}">
    <Setter Property="ItemTemplateSelector" Value="{StaticResource FooterTemplateSelector}" />
	<Setter Property="ItemsPanel">
	  <Setter.Value>
	    <ItemsPanelTemplate>
		  <dg:DataGridRowPanel />
		</ItemsPanelTemplate>
	  </Setter.Value>
	</Setter>
	<Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate>
		  <DockPanel>
            <Border BorderThickness="0,1,1,0" BorderBrush="{StaticResource DataGridBorder}" Name="RowHeader"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridRowHeaderBackground}" />
            </Border>
			<ItemsControl ItemsSource="{Binding GroupedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			              DockPanel.Dock="Left">
			  <ItemsControl.ItemsPanel>
			    <ItemsPanelTemplate>
			      <StackPanel Orientation="Horizontal" />
			    </ItemsPanelTemplate>
			  </ItemsControl.ItemsPanel>
			  <ItemsControl.ItemTemplate>
				<DataTemplate>
				  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderThickness="0,1,1,0" BorderBrush="{StaticResource DataGridBorder}"
					      Width="{Binding GroupingIndent, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
			<Grid>
			  <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridRowHeaderBackground}">
			    <ItemsPresenter />
			  </Border>
			  <StackPanel Orientation="Horizontal" Grid.Column="2"
                          Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
                <Border Width="4" Background="{StaticResource FrozenShadow}" />
              </StackPanel>
			</Grid>
		  </DockPanel>
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <!-- ======================= -->
  <!--   ScrollViewer styles   -->
  <!-- ======================= -->
  
  <Style x:Key="InvisibleButtonStyle" TargetType="Button">
    <Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate TargetType="Button">
		  <Border Background="Transparent" />
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <Style x:Key="{x:Static local:DataGrid.ScrollViewerStyleKey}" TargetType="ScrollViewer">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
			  <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
			  <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="1" Visibility="{Binding ShowColumnHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <dg:DataGridHeaderRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Focusable="False" Margin="0,0,-1,0"
                                                  ItemsSource="{Binding EffectiveColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                                                  ItemContainerStyle="{StaticResource GridViewColumnHeaderStyle}"
                                                  ItemTemplate="{Binding ColumnHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <dg:DataGridHeaderRowPresenter.ItemsPanel>
                  <ItemsPanelTemplate>
                    <dg:DataGridRowPanel />
                  </ItemsPanelTemplate>
                </dg:DataGridHeaderRowPresenter.ItemsPanel>
              </dg:DataGridHeaderRowPresenter>
            </Grid>

			<!-- Filter row -->
            <dg:DataGridFilterRow ItemsSource="{Binding EffectiveColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			                      Grid.ColumnSpan="2" Grid.Row="1"
								  Visibility="{Binding IsFilterRowVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			
            <Grid Visibility="{Binding ShowColumnHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridBorder}"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border BorderThickness="1" BorderBrush="White" Background="{StaticResource DataGridColumnHeaderBackground}">
				  <Button Command="{x:Static dg:DataGridCommands.ToggleSelectAll}" Style="{StaticResource InvisibleButtonStyle}" />
				</Border>
              </Border>
            </Grid>

            <Grid Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Grid.Column="2">
              <Border BorderThickness="1,0,0,1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridBorder}"
                    Visibility="{Binding ShowColumnHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border BorderThickness="1" BorderBrush="White" Background="{StaticResource DataGridColumnHeaderBackground}" />
              </Border>
            </Grid>
			
			<!-- Filter row scroll corner -->
			<Grid Visibility="{Binding IsFilterRowVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			      Grid.Column="2" Grid.Row="1">
			  <Border Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" BorderThickness="1,0,0,1" BorderBrush="{StaticResource DataGridBorder}">
                <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridRowHeaderBackground}" />
              </Border>
			</Grid>

            <ScrollContentPresenter Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local" Grid.Row="2" Grid.ColumnSpan="2"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="0,0,-1,0"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
			
            <!-- Footer -->
			<dg:DataGridFooter Columns="{Binding EffectiveColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			                   Grid.ColumnSpan="2" Grid.Row="3"
							   Visibility="{Binding IsFooterVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			
			<StackPanel Grid.Row="2" Grid.ColumnSpan="2" Visibility="{Binding IsFrozenRowLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border Height="{Binding FrozenRowEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
              <Border Background="{StaticResource FrozenRowShadow}" Height="4" />
            </StackPanel>
									
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource DataGridBorder}" Grid.Row="4" Grid.ColumnSpan="2"
                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Background="#EEEEEE" Padding="0,0,0,1">
              <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal"
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Cursor="Arrow" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            </Border>
            <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource DataGridBorder}" Grid.Column="2" Grid.Row="2" Grid.RowSpan="2"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Background="#EEEEEE" Padding="0,0,1,0">
              <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical"
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Cursor="Arrow" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            </Border>
            <Rectangle Grid.Column="2" Grid.Row="4" Fill="#EEEEEE" />
            <Rectangle Name="CornerDot" Grid.Column="2" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{StaticResource DataGridBorder}" Width="1" Height="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ComputedHorizontalScrollBarVisibility" Value="Collapsed">
              <Setter TargetName="CornerDot" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
              <Setter TargetName="CornerDot" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= -->
  <!--   Editor styles   -->
  <!-- ================= -->

  <Style x:Key="DataGridTextBoxStyle" TargetType="TextBox">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="White" VerticalAlignment="Stretch">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="5,3,0,3" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- IntegerTextBox style -->

  <Style x:Key="DataGridIntegerTextBoxStyle" TargetType="{x:Type local:IntegerTextBox}">
    <Setter Property="Padding" Value="5,0,0,0" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- NumericTextBox style -->

  <Style x:Key="DataGridNumericTextBoxStyle" TargetType="{x:Type local:NumericTextBox}">
    <Setter Property="Padding" Value="5,0,0,0" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <Style x:Key="DataGridDateTimePickerStyle" TargetType="{x:Type local:DropDownDatePicker}">
    <Setter Property="Format" Value="ShortDate" />
  </Style>

  <!-- TimeSpanPicker style -->

  <Style x:Key="DataGridTimeSpanPickerStyle" TargetType="local:TimeSpanPicker">
    <Setter Property="Padding" Value="5,0,0,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  
  <!-- ColorPicker style -->
  
  <Style x:Key="DataGridColorPickerStyle" TargetType="local:ColorPicker">
    <Setter Property="Padding" Value="5,0,0,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- NumericUpDown style -->

  <Style x:Key="DataGridNumericUpDownStyle" TargetType="{x:Type local:NumericUpDown}">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource DataGridBorder}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:NumericUpDown}">
          <local:SpinDecorator Change="{TemplateBinding SmallChange}"
                               Margin="{TemplateBinding Margin}"
                               Background="White" BorderThickness="0">
            <local:IntegerTextBox Value="{Binding Value}" 
                                  Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                  Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="White"
                                  VerticalAlignment="Center" Padding="4,0,0,0"
                                  BorderThickness="0" />
          </local:SpinDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- CheckBox style -->

  <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- ComboBox styles -->

  <Style x:Key="ComboBoxStyle" TargetType="{x:Type ComboBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="5,3,0,3" />
  </Style>

  <!-- ===================== -->
  <!--   Display templates   -->
  <!-- ===================== -->

  <!-- General text display template -->

  <DataTemplate x:Key="DisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding}" VerticalAlignment="Center" />
  </DataTemplate>
  
  <!-- Right aligned text display template -->

  <DataTemplate x:Key="RightAlignedDisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding}" VerticalAlignment="Center" TextAlignment="Right" />
  </DataTemplate>

  <!-- DateTime display template -->

  <local:FormattingConverter x:Key="DateTimeDisplayFormatConverter" FormatString="{}{0:d}" />

  <DataTemplate x:Key="DateTimeDisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding Converter={StaticResource DateTimeDisplayFormatConverter}}" VerticalAlignment="Center" />
  </DataTemplate>

  <!-- Collection display template -->

  <DataTemplate x:Key="CollectionDisplayTemplate">
    <StackPanel Orientation="Horizontal" Margin="3,4,2,4">
      <TextBlock Text="{Binding Count}" VerticalAlignment="Center" />
      <TextBlock Name="ItemText" Text=" items" VerticalAlignment="Center" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Value.Count}" Value="1">
        <Setter TargetName="ItemText" Property="Text" Value=" item" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Color display template -->

  <local:ColorToBrushConverter x:Key="ColorToBrush" />
  <local:ColorToNameConverter x:Key="ColorToName" />
  
  <DataTemplate x:Key="ColorPickerDisplayTemplate">
    <Grid Background="#01000000">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{Binding Converter={StaticResource ColorToBrush}}"
              BorderBrush="Black" BorderThickness="1" Margin="5,3,6,3" SnapsToDevicePixels="True"
              Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
      <TextBlock Grid.Column="1" Foreground="{StaticResource TextColor}"
                 Text="{Binding Converter={StaticResource ColorToName}}"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <!-- CheckBox display template -->

  <DataTemplate x:Key="CheckBoxDisplayTemplate">
    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
              IsChecked="{Binding Content, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
  </DataTemplate>

  <!-- TimeSpan display template -->

  <local:TimeSpanToStringConverter x:Key="TimeSpanToString" />

  <DataTemplate x:Key="TimeSpanPickerDisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding Converter={StaticResource TimeSpanToString}}" VerticalAlignment="Center" />
  </DataTemplate>

  <!-- ======================== -->
  <!--   DataGridPager styles   -->
  <!-- ======================== -->

  <LinearGradientBrush x:Key="DataGridButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F2F2F2" />
    <GradientStop Offset="0.4" Color="#ECECEC" />
    <GradientStop Offset="0.4" Color="#DBDBDB" />
    <GradientStop Offset="1" Color="#CFCFCF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverDataGridButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E7F5FD" />
    <GradientStop Offset="0.4" Color="#DAF0FC" />
    <GradientStop Offset="0.4" Color="#BDE6FD" />
    <GradientStop Offset="1" Color="#AADBF6" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedDataGridButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C2E4F6" />
    <GradientStop Offset="0.4" Color="#C2E4F6" />
    <GradientStop Offset="0.4" Color="#A9DAF3" />
    <GradientStop Offset="1" Color="#91CCEB" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="MouseOverDataGridButtonBorder" Color="#3C7FB1" />
  <SolidColorBrush x:Key="PressedDataGridButtonBorder" Color="#2C628B" />

  <SolidColorBrush x:Key="DisabledDataGridButtonBorder" Color="#888888" />
  <SolidColorBrush x:Key="DisabledDataGridButtonBackground" Color="#E0E0E0" />
  <SolidColorBrush x:Key="DisabledDataGridButtonForeground" Color="#707070" />

  <Style x:Key="DataGridButtonStyle" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Name="Border" BorderThickness="1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource InnerBorder}">
            <Border Name="Background" Margin="1" Background="{StaticResource DataGridButtonBackground}">
              <ContentPresenter />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverDataGridButtonBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverDataGridButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedDataGridButtonBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedDataGridButtonBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledDataGridButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DisabledDataGridButtonBackground}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource DisabledDataGridButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledDataGridButtonForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <SolidColorBrush x:Key="DataGridPagerButtonBackground" Color="#FEFEFE" />
  <SolidColorBrush x:Key="MouseOverDataGridPagerButtonBackground" Color="#BDE6FD" />
  <SolidColorBrush x:Key="SelectedDataGridPagerButtonBackground" Color="#A9DAF3" />

  <Style x:Key="PagerButtonStyle" TargetType="RadioButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Name="Border" BorderThickness="1" BorderBrush="{StaticResource DataGridBorder}" Background="{StaticResource DataGridPagerButtonBackground}" Margin="-1,0,0,0">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverDataGridPagerButtonBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedDataGridPagerButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="PagerButtonTemplate">
    <RadioButton Style="{StaticResource PagerButtonStyle}" MinWidth="20" Height="20" Content="{Binding Content}"
                 IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="10" />
  </DataTemplate>

  <LinearGradientBrush x:Key="DataGridPagerBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="-0.5" Color="#CFCFCF" />
    <GradientStop Offset="1" Color="#F2F2F2" />
  </LinearGradientBrush>

  <local:ArithmeticConverter x:Key="PlusOne" Additive="1" />

  <Style TargetType="{x:Type dg:DataGridPager}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridPager}">
          <Border Background="{StaticResource DataGridPagerBackground}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DataGridBorder}">
            <DockPanel LastChildFill="False">

              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                <Button Name="FirstPageButton" Command="{x:Static dg:DataGridCommands.FirstPage}" Style="{StaticResource DataGridButtonStyle}" Width="18" Height="18" Margin="4,0,0,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Rectangle Fill="{Binding Foreground, ElementName=FirstPageButton}" Width="1" Height="7" SnapsToDevicePixels="True" />
                    <Path Data="M 0 0.5 L 1 0 L 1 1 Z" Fill="{Binding Foreground, ElementName=FirstPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                  </StackPanel>
                </Button>
                <RepeatButton Name="PreviousPageButton" Command="{x:Static dg:DataGridCommands.PreviousPage}" Style="{StaticResource DataGridButtonStyle}" Width="18" Height="18" Margin="4,0,0,0">
                  <Path Data="M 0 0.5 L 1 0 L 1 1 Z" Fill="{Binding Foreground, ElementName=PreviousPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                </RepeatButton>

                <ItemsControl ItemsSource="{Binding PagerButtons, RelativeSource={RelativeSource TemplatedParent}}" Margin="4,0,0,0" ItemTemplate="{StaticResource PagerButtonTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <RepeatButton Name="NextPageButton" Command="{x:Static dg:DataGridCommands.NextPage}" Style="{StaticResource DataGridButtonStyle}" Width="18" Height="18" Margin="4,0,0,0">
                  <Path Data="M 0 0 L 1 0.5 L 0 1 Z" Fill="{Binding Foreground, ElementName=NextPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                </RepeatButton>
                <Button Name="LastPageButton" Command="{x:Static dg:DataGridCommands.LastPage}" Style="{StaticResource DataGridButtonStyle}" Width="18" Height="18" Margin="4,0,0,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M 0 0 L 1 0.5 L 0 1 Z" Fill="{Binding Foreground, ElementName=LastPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                    <Rectangle Fill="{Binding Foreground, ElementName=LastPageButton}" Width="1" Height="7" SnapsToDevicePixels="True" />
                  </StackPanel>
                </Button>

              </StackPanel>

              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource DataGridBorder}" Background="White" Width="2" Margin="5,6,10,6" SnapsToDevicePixels="True" />
                <TextBlock Text="Page" VerticalAlignment="Center" />
                <local:SpinDecorator ShowSpinUI="False" ValueProperty="Value" Padding="0" Margin="5,4,5,4" BorderThickness="0" Background="Transparent"
                                     MinimumProperty="Minimum" MaximumProperty="Maximum" Height="22" MinHeight="22">
                  <local:IntegerTextBox Value="{Binding PageIndex, Converter={StaticResource PlusOne}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        VerticalAlignment="Center" MinWidth="40" Minimum="1" Maximum="{Binding DataGridItemsSource.PageCount, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderThickness="1" BorderBrush="{StaticResource DataGridBorder}" Height="22" MinHeight="22" />
                </local:SpinDecorator>
                <TextBlock Text="of" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DataGridItemsSource.PageCount, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="3" VerticalAlignment="Center" Margin="5,0,10,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type dg:DataGridItemsPresenter}" TargetType="{x:Type dg:DataGridItemsPresenter}">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <dg:DataGridPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridItemsPresenter}">
          <ScrollViewer Style="{StaticResource {x:Static local:DataGrid.ScrollViewerStyleKey}}"
                        HorizontalScrollBarVisibility="Auto" CanContentScroll="True"
                        VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:DataGrid.ExpanderToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Width="9" Height="9" BorderThickness="1" Margin="4"
                  BorderBrush="#FF7898B5" CornerRadius="1" SnapsToDevicePixels="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="White" Offset="0.2" />
                <GradientStop Color="#FFC0B7A6" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Path x:Name="ExpandPath" Margin="1,1,1,1" Fill="Black"
                  Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Data" TargetName="ExpandPath" Value="M 0 2 L 0 3 L 5 3 L 5 2 Z" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <pg:LevelToIndentConverter x:Key="ExpandableCellIndentConverter" />
  
  <ControlTemplate x:Key="ExpandableCellTemplate" TargetType="dg:DataGridCellContainer">
    <Border Name="ColoredBackground" BorderThickness="0,0,1,0" BorderBrush="{Binding VerticalGridLineBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
	        Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle Width="{Binding Row.HierarchyLevel, Converter={StaticResource ExpandableCellIndentConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
        <ToggleButton Style="{DynamicResource {x:Static local:DataGrid.ExpanderToggleButtonStyleKey}}" Grid.Column="1"
                      IsChecked="{Binding Row.IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static dg:DataGridCommands.ToggleExpandedState}"
                      Visibility="{Binding Row.HasChildren, Converter={StaticResource bvc_hidden}, RelativeSource={RelativeSource TemplatedParent}}" />

        <Grid Margin="0,0,0,1" Grid.Column="2">
          <Rectangle Name="Background" Fill="Transparent" />
          <Rectangle Name="Border" StrokeThickness="1" Stroke="Transparent" Fill="Transparent" IsHitTestVisible="False" Margin="1" />
          <ContentPresenter />
          <Rectangle Name="TopBorder" StrokeThickness="2" Stroke="Transparent" IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Fill" Value="{StaticResource MouseOverDataGridBackground}" />
      </Trigger>
      <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row">
        <Setter TargetName="Background" Property="Fill" Value="Transparent" />
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Background" Property="Fill" Value="{StaticResource SelectedDataGridBackground}" />
      </Trigger>
	  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
	    <Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </DataTrigger>
	  <MultiDataTrigger>
	    <MultiDataTrigger.Conditions>
		  <Condition Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row" />
		  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True" />
		</MultiDataTrigger.Conditions>
		<Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </MultiDataTrigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="{StaticResource DataGridCellHighlightedBorder}" />
      </Trigger>
      <Trigger Property="IsValid" Value="False">
        <Setter TargetName="TopBorder" Property="Stroke" Value="{StaticResource DataGridCellNotValidBorder}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  
  <ControlTemplate x:Key="DetailedDataGridCellTemplate" TargetType="dg:DataGridCellContainer">
    <Border Name="ColoredBackground" BorderThickness="0,0,1,0" BorderBrush="{Binding VerticalGridLineBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
	        Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Grid Margin="0,0,0,1">
        <Rectangle Name="Background" Fill="Transparent" />
        <Rectangle Name="Border" StrokeThickness="1" Stroke="Transparent" Fill="Transparent" IsHitTestVisible="False" Margin="1" />
        <ContentPresenter />
        <Rectangle Name="TopBorder" StrokeThickness="2" Stroke="Transparent" IsHitTestVisible="False" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Fill" Value="{StaticResource MouseOverDataGridBackground}" />
      </Trigger>
      <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row">
        <Setter TargetName="Background" Property="Fill" Value="Transparent" />
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Background" Property="Fill" Value="{StaticResource SelectedDataGridBackground}" />
      </Trigger>
	  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
	    <Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </DataTrigger>
	  <MultiDataTrigger>
	    <MultiDataTrigger.Conditions>
		  <Condition Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row" />
		  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True" />
		</MultiDataTrigger.Conditions>
		<Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </MultiDataTrigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="{StaticResource DataGridCellHighlightedBorder}" />
      </Trigger>
      <Trigger Property="IsValid" Value="False">
        <Setter TargetName="TopBorder" Property="Stroke" Value="{StaticResource DataGridCellNotValidBorder}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="DataGridCellContainerStyle" TargetType="dg:DataGridCellContainer">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dg:DataGridCellContainer">
          <Border BorderThickness="0,0,1,0" BorderBrush="{Binding VerticalGridLineBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
		          Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="0,0,0,1" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
      <Trigger Property="IsValid" Value="False">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
	  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
	    <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
	  </DataTrigger>
	  <MultiDataTrigger>
	    <MultiDataTrigger.Conditions>
		  <Condition Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row" />
		  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True" />
		</MultiDataTrigger.Conditions>
		<Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
	  </MultiDataTrigger>
      <Trigger Property="IsExpandableCell" Value="True">
        <Setter Property="Template" Value="{StaticResource ExpandableCellTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  
  <local:DataGridIndentConverter x:Key="DataGridIndentConverter" />
  
  <Style TargetType="dg:DataGridRow">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource DataGridBorder}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
	<Setter Property="ItemContainerStyle" Value="{StaticResource DataGridCellContainerStyle}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <dg:DataGridRowPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dg:DataGridRow">
          <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Row header: -->
            <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}" Name="RowHeader"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridRowHeaderBackground}">
                <ContentPresenter ContentTemplate="{Binding RowHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
              </Border>
            </Border>
            <!-- Grouping indent: -->
            <Border Background="{StaticResource DataGridRowHeaderBackground}" Grid.Column="1"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,0">
              <Border.Width>
                <MultiBinding Converter="{StaticResource DataGridIndentConverter}">
                  <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="GroupingIndent" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                </MultiBinding>
              </Border.Width>
            </Border>
            <!-- Cells: -->
            <Border Name="Background" Background="Transparent" Margin="0,0,0,1" Grid.Column="2" />
            <ItemsPresenter Grid.Column="2" />
            <Border BorderBrush="{Binding HorizontalGridLineBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="3" />
            <StackPanel Orientation="Horizontal" Grid.Column="2"
                        Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
              <Border Width="4" Background="{StaticResource FrozenShadow}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverDataGridBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="RowAndCell">
              <Setter TargetName="Background" Property="Background" Value="Transparent" />
            </DataTrigger>
            <Trigger SourceName="RowHeader" Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverDataGridBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Cell">
              <Setter TargetName="Background" Property="Background" Value="Transparent" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource SelectedDataGridBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- =================== -->
  <!--   Grouping styles   -->
  <!-- =================== -->

  <SolidColorBrush x:Key="DataGridGroupingPanelBackground" Color="#C5C7D1" />

  <Style x:Key="{x:Type dg:DataGridGroupingPanel}" TargetType="{x:Type dg:DataGridGroupingPanel}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource DataGridBorder}" />
    <Setter Property="Background" Value="{StaticResource DataGridGroupingPanelBackground}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridGroupingPanel}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{TemplateBinding Background}">
              <Grid>
                <TextBlock Name="Description" Margin="15,6,6,6" Text="Drag and drop a column header here to group by that column" />
                <ItemsPresenter Margin="5,2,0,2" />
                <Grid Margin="-5,2,5,2" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.ColumnSpan="2"
                      Visibility="{Binding IsRequestingColumnDropPosition, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                  <Grid.RenderTransform>
                    <TranslateTransform x:Name="Transform" X="{Binding ColumnDropRequestPosition, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Grid.RenderTransform>
                  <Border Width="3" Background="{StaticResource HeaderDropIndicatorBackground}" HorizontalAlignment="Center" />
                  <Path Width="9" Height="7" Data="M 0 0 L 1 0 L 0.5 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Center" />
                  <Path Width="9" Height="7" Data="M 0.5 0 L 0 1 L 1 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                </Grid>
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="Description" Property="Visibility" Value="Hidden" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <dg:GroupHeaderCellTemplateSelector x:Key="GroupHeaderCellTemplateSelector"
                                      NoAggregateTemplate="{StaticResource NoAggregateTemplate}"
									  SumAggregateTemplate="{StaticResource SumAggregateTemplate}"
							          CountAggregateTemplate="{StaticResource CountAggregateTemplate}"
							          AverageAggregateTemplate="{StaticResource AverageAggregateTemplate}"
							          MinimumAggregateTemplate="{StaticResource MinimumAggregateTemplate}"
							          MaximumAggregateTemplate="{StaticResource MaximumAggregateTemplate}"
							          ModeAggregateTemplate="{StaticResource ModeAggregateTemplate}" />
  
  <Style TargetType="dg:DataGridGroupingRow">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource DataGridRowHeaderBackground}" />
	<Setter Property="ItemTemplateSelector" Value="{StaticResource GroupHeaderCellTemplateSelector}" />
	<Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <dg:DataGridRowPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dg:DataGridGroupingRow">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource DataGridBorder}"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource DataGridRowHeaderBackground}">
                <ContentPresenter ContentTemplate="{Binding GroupRowHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
              </Border>
            </Border>

            <Border Grid.Column="1">
              <Border.Width>
                <MultiBinding Converter="{StaticResource DataGridIndentConverter}">
                  <Binding Path="GroupedColumns.Count" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                  <Binding Path="GroupingIndent" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                </MultiBinding>
              </Border.Width>
            </Border>

			<Border Grid.Column="1" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource DataGridBorder}" />
			
			<ItemsPresenter Grid.Column="2" />
            
			<StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
			  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderBrush="{StaticResource DataGridBorder}" BorderThickness="0,0,1,0">
                <Border.Width>
                  <MultiBinding Converter="{StaticResource DataGridIndentConverter}">
                    <Binding Path="Group.Level" Mode="OneWay" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="GroupingIndent" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                  </MultiBinding>
                </Border.Width>
              </Border>
			  <ToggleButton Style="{DynamicResource {x:Static local:DataGrid.ExpanderToggleButtonStyleKey}}" DockPanel.Dock="Left" VerticalAlignment="Center"
				            IsChecked="{Binding Group.IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
			  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderThickness="0,0,0,1">
			    <ContentPresenter Content="{Binding Group.GroupName, RelativeSource={RelativeSource TemplatedParent}}"
				   			      VerticalAlignment="Center" Margin="6,5,12,5" DockPanel.Dock="Left"
								  ContentTemplate="{TemplateBinding HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" />
			  </Border>
			</StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================== -->
  <!--   DataGrid style   -->
  <!-- ================== -->

  <Style TargetType="{x:Type local:DataGrid}">
    <Style.Resources>
      <!-- Readonly edit display -->
      <DataTemplate x:Key="{x:Static local:PropertyGrid.ReadOnlyDisplayKey}">
        <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding Value}" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyTextColor}" />
      </DataTemplate>
      <!-- Collection edit display -->
      <DataTemplate x:Key="{x:Static local:PropertyGrid.CollectionDisplayKey}">
        <StackPanel Orientation="Horizontal" Margin="3,4,2,4">
          <TextBlock Text="{Binding Path=Value.Count}" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyTextColor}" 
                     Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
          <TextBlock Name="ItemText" Text=" items" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyTextColor}" 
                     Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Value.Count}" Value="1">
            <Setter TargetName="ItemText" Property="Text" Value=" item" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </Style.Resources>
    <Setter Property="BuiltInEditorStyles">
      <Setter.Value>
        <pe:BuiltInEditorStyleCollection>
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.SimpleTextEditorKey}" Style="{StaticResource DataGridTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.NonAutoUpdatingTextEditorKey}" Style="{StaticResource DataGridTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.IntegerEditorKey}" Style="{StaticResource DataGridIntegerTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.DoubleEditorKey}" Style="{StaticResource DataGridNumericTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectEditorKey}" Style="{StaticResource ComboBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectNoTextEntryEditorKey}" Style="{StaticResource ComboBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.CheckBoxEditorKey}" Style="{StaticResource DataGridCheckBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.NumericUpDownEditorKey}" Style="{StaticResource DataGridNumericUpDownStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ColorEditorKey}" Style="{StaticResource DataGridColorPickerStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.DateEditorKey}" Style="{StaticResource DataGridDateTimePickerStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.TimeSpanEditorKey}" Style="{StaticResource DataGridTimeSpanPickerStyle}" />
        </pe:BuiltInEditorStyleCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="BuiltInDisplayTemplates">
      <Setter.Value>
        <dg:BuiltInDisplayTemplateCollection>
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ReadOnlyDisplayKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.CollectionDisplayKey}" Template="{StaticResource CollectionDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.SimpleTextEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.NonAutoUpdatingTextEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.IntegerEditorKey}" Template="{StaticResource RightAlignedDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.DoubleEditorKey}" Template="{StaticResource RightAlignedDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ListSelectEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ListSelectNoTextEntryEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.RadioSelectEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.CheckBoxEditorKey}" Template="{StaticResource CheckBoxDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.SliderEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.NumericUpDownEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ColorEditorKey}" Template="{StaticResource ColorPickerDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.DateEditorKey}" Template="{StaticResource DateTimeDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.TimeSpanEditorKey}" Template="{StaticResource TimeSpanPickerDisplayTemplate}" />
        </dg:BuiltInDisplayTemplateCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource DataGridBorder}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ColumnHeaderTemplate" Value="{StaticResource DataGridColumnHeaderTemplate}" />
	<Setter Property="HorizontalGridLineBrush" Value="{StaticResource DataGridBorder}" />
	<Setter Property="VerticalGridLineBrush" Value="{StaticResource DataGridBorder}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DataGrid}">
          <Grid>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <dg:DataGridGroupingPanel BorderThickness="0,0,0,1" Visibility="{TemplateBinding IsGroupingPanelVisible, Converter={StaticResource bvc}}"
                                          ItemsSource="{TemplateBinding GroupedColumns}"
                                          ItemContainerStyle="{StaticResource GridViewColumnHeaderStyle}"
                                          ItemTemplate="{StaticResource GroupedDataGridColumnHeaderTemplate}" />
                <dg:DataGridItemsPresenter ItemsSource="{TemplateBinding DisplayedItemsSource}" Grid.Row="1"
                                           ItemTemplate="{TemplateBinding ItemTemplate}"
                                           ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                           ItemContainerStyle="{TemplateBinding ItemContainerStyle}" />
                <dg:DataGridPager DataGridItemsSource="{TemplateBinding DisplayedItemsSource}" Grid.Row="2">
				  <dg:DataGridPager.Visibility>
				    <MultiBinding Converter="{StaticResource DataGridPagerVisibility}">
					  <Binding Path="IsPagerVisible" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
					  <Binding Path="DisplayedItemsSource.PageCount" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
					</MultiBinding>
				  </dg:DataGridPager.Visibility>
				</dg:DataGridPager>
              </Grid>
            </Border>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>