            <Grid>
              <Path Name="PART_Arc" Stroke="White" StrokeThickness="6" />
              <ItemsControl Name="PART_LabelsHost">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Grid />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl Name="PART_TickMarksHost">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Grid />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Grid Margin="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Path Name="PART_Needle" Data="M 0.5 0 L 1 1 L 0 1 Z" Fill="#5C5C5C" Width="6" Stretch="Fill" />
              </Grid>
              <Ellipse Width="20" Height="20" Fill="#5C5C5C" />
            </Grid>
          </Grid>
