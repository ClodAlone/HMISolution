                        Width="{Binding ActualWidth, ElementName=Border}" Height="200" Background="#11000000">
                  <ListBox x:Name="SelectionAdapter" ItemsSource="{TemplateBinding ItemsSource}" SelectedItem="{Binding SelectedTimeSpan, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
