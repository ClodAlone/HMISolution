  <SolidColorBrush x:Key="ColorPickerLabelForeground" Color="#4C535C" />

  <SolidColorBrush x:Key="ColorPickerListBoxBorder" Color="#C5C5C5" />

  <SolidColorBrush x:Key="MouseOverColorPickerListBoxItemBorder" Color="#F29436" />
  <SolidColorBrush x:Key="MouseOverColorPickerListBoxItemInnerBorder" Color="#FFE294" />
  <SolidColorBrush x:Key="SelectedColorPickerListBoxItemBorder" Color="#EF4810" />
  <SolidColorBrush x:Key="SelectedColorPickerListBoxItemInnerBorder" Color="#FFE294" />

  <local:ColorToBrushConverter x:Key="ColorToBrush" />
  <local:ColorToNameConverter x:Key="ColorToName" UseClosestColor="True" />

  <DataTemplate x:Key="ColorPickerListBoxItemTemplate">
    <Border Background="{Binding Color, Converter={StaticResource ColorToBrush}}" SnapsToDevicePixels="True"
            Width="13" Height="13" ToolTip="{Binding Name}" />
  </DataTemplate>

  <Style x:Key="VerticalColorPickerListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1,0,1,0" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorPickerListBoxBorder}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid>
            <ContentPresenter Width="13" Height="13" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />
            <Border Name="Border" BorderBrush="Transparent" BorderThickness="1" Width="13" Height="13">
              <Border Name="InnerBorder" BorderThickness="1" BorderBrush="Transparent" Width="11" Height="11" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverColorPickerListBoxItemBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverColorPickerListBoxItemInnerBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SelectedColorPickerListBoxItemBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource SelectedColorPickerListBoxItemInnerBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HorizontalColorPickerListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource VerticalColorPickerListBoxItemStyle}">
    <Setter Property="Margin" Value="2,1,2,1" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="ColorPickerListBoxStyleBase" TargetType="{x:Type ListBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemTemplate" Value="{StaticResource ColorPickerListBoxItemTemplate}" />
    <Setter Property="SelectedValuePath" Value="Color" />
    <Setter Property="SelectedValue" Value="{Binding SelectedColor, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="VerticalColorPickerListBoxStyle" TargetType="{x:Type ListBox}" BasedOn="{StaticResource ColorPickerListBoxStyleBase}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0,1,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorPickerListBoxBorder}" />
    <Setter Property="Margin" Value="2,0,2,0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource VerticalColorPickerListBoxItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />
            <ScrollViewer Focusable="False" BorderThickness="0" Padding="0">
              <ItemsPresenter Margin="{TemplateBinding Padding}" />
            </ScrollViewer>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HorizontalColorPickerListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource ColorPickerListBoxStyleBase}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource HorizontalColorPickerListBoxItemStyle}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type local:ColorPicker}" TargetType="{x:Type local:ColorPicker}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ColorPicker}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <StackPanel Margin="{TemplateBinding Padding}">
              <Border Background="{StaticResource ColorPickerLabelBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource ColorPickerListBoxBorder}" Height="18">
                <TextBlock Margin="11,0,0,0" Foreground="{StaticResource ColorPickerLabelForeground}" VerticalAlignment="Center" FontWeight="Bold" FontSize="10">Theme Colors</TextBlock>
              </Border>
              <Border Height="1" Background="{StaticResource ColorPickerLabelBorder}" />
              <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource ThemeColorsSubList}}" Style="{StaticResource HorizontalColorPickerListBoxStyle}" />

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,3">
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Background1SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Text1SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Background2SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Text2SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Accent1SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Accent2SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Accent3SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Accent4SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Accent5SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
                <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource Accent6SubList}}" Style="{StaticResource VerticalColorPickerListBoxStyle}" />
              </StackPanel>

              <Border Background="{StaticResource ColorPickerLabelBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource ColorPickerListBoxBorder}" Height="18">
                <TextBlock Margin="11,0,0,0" Foreground="{StaticResource ColorPickerLabelForeground}" VerticalAlignment="Center" FontWeight="Bold" FontSize="10">Standard Colors</TextBlock>
              </Border>
              <Border Height="1" Background="{StaticResource ColorPickerLabelBorder}" />
              <ListBox ItemsSource="{TemplateBinding Palette, Converter={StaticResource StandardColorsSubList}}" Style="{StaticResource HorizontalColorPickerListBoxStyle}" />
              <StackPanel Name="RecentColorsHost">
                <Border Background="{StaticResource ColorPickerLabelBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource ColorPickerListBoxBorder}" Height="18">
                  <TextBlock Margin="11,0,0,0" Foreground="{StaticResource ColorPickerLabelForeground}" VerticalAlignment="Center" FontWeight="Bold" FontSize="10">Recent Colors</TextBlock>
                </Border>
                <Border Height="1" Background="{StaticResource ColorPickerLabelBorder}" />
                <ListBox Name="RecentColorsList" ItemsSource="{TemplateBinding RecentColors}" Style="{StaticResource HorizontalColorPickerListBoxStyle}" Width="172" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding ItemsSource.Count, ElementName=RecentColorsList}" Value="0">
              <Setter TargetName="RecentColorsHost" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================= -->
  <!--   DropDownColorPicker style   -->
  <!-- ============================= -->

  <DataTemplate x:Key="DefaultColorPickerDropDownTemplate">
    <Border BorderBrush="{Binding BorderBrush}" BorderThickness="1">
      <StackPanel>
        <local:ColorPicker Palette="{Binding Palette}" SelectedColor="{Binding SelectedColor}" BorderThickness="0" />
        <local:MoreColorsButton CurrentColor="{Binding SelectedColor}" BorderThickness="0,1,0,0" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="DefaultColorPickerHeaderTemplate">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}"
              BorderBrush="Black" BorderThickness="1" Margin="2,0,6,0" SnapsToDevicePixels="True"
              Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
      <TextBlock Grid.Column="1" Foreground="{Binding Foreground}" Text="{Binding SelectedColor, Converter={StaticResource ColorToName}}"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <Style x:Key="{x:Type local:DropDownColorPicker}" TargetType="{x:Type local:DropDownColorPicker}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource DefaultColorPickerHeaderTemplate}" />
    <Setter Property="DropDownTemplate" Value="{StaticResource DefaultColorPickerDropDownTemplate}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DropDownColorPicker}">
          <local:DropDownEditBox Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:DropDownColorPicker}}}"
                                 DropDownTemplate="{TemplateBinding DropDownTemplate}" HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                 IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ -->
  <!--   ChannelColorPicker style   -->
  <!-- ============================ -->

  <local:ColorChannelAdjustmentBrushConverter x:Key="AlphaChanger" Channel="Alpha" />
  <local:ColorChannelAdjustmentBrushConverter x:Key="RedChanger" Channel="Red" />
  <local:ColorChannelAdjustmentBrushConverter x:Key="GreenChanger" Channel="Green" />
  <local:ColorChannelAdjustmentBrushConverter x:Key="BlueChanger" Channel="Blue" />
  <local:ColorChannelAdjustmentBrushMultiConverter x:Key="SaturationChanger" Channel="Saturation" />
  <local:ColorChannelAdjustmentBrushConverter x:Key="ValueChanger" Channel="Value" />

  <LinearGradientBrush x:Key="HorizontalHueGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#FF0000" />
    <GradientStop Offset="0.1666" Color="#FFFF00" />
    <GradientStop Offset="0.3333" Color="#00FF00" />
    <GradientStop Offset="0.5" Color="#00FFFF" />
    <GradientStop Offset="0.6666" Color="#0000FF" />
    <GradientStop Offset="0.8333" Color="#FF00FF" />
    <GradientStop Offset="1" Color="#FF0000" />
  </LinearGradientBrush>

  <ControlTemplate x:Key="HighAlphaTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource AlphaChanger}, ConverterParameter=255, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="HighRedTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource RedChanger}, ConverterParameter=255, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="HighGreenTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource GreenChanger}, ConverterParameter=255, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="HighBlueTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource BlueChanger}, ConverterParameter=255, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="HighSaturationTemplate" TargetType="RepeatButton">
    <Border>
      <Border.Background>
        <MultiBinding Converter="{StaticResource SaturationChanger}" ConverterParameter="1">
          <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
          <Binding Path="NotifyingColor.H" RelativeSource="{RelativeSource AncestorType={x:Type local:ChannelColorPicker}}" />
        </MultiBinding>
      </Border.Background>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="HighValueTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource ValueChanger}, ConverterParameter=1, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="LowAlphaTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource AlphaChanger}, ConverterParameter=0, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="LowRedTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource RedChanger}, ConverterParameter=0, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="LowGreenTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource GreenChanger}, ConverterParameter=0, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="LowBlueTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource BlueChanger}, ConverterParameter=0, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <ControlTemplate x:Key="LowSaturationTemplate" TargetType="RepeatButton">
    <Border>
      <Border.Background>
        <MultiBinding Converter="{StaticResource SaturationChanger}" ConverterParameter="0">
          <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
          <Binding Path="NotifyingColor.H" RelativeSource="{RelativeSource AncestorType={x:Type local:ChannelColorPicker}}" />
        </MultiBinding>
      </Border.Background>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="LowValueTemplate" TargetType="RepeatButton">
    <Border Background="{Binding Background, Converter={StaticResource ValueChanger}, ConverterParameter=0, RelativeSource={RelativeSource TemplatedParent}}" />
  </ControlTemplate>

  <Style x:Key="ColorSliderRepeatButtonStyle" TargetType="RepeatButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="8" />
  </Style>
  
  <SolidColorBrush x:Key="MousePressedSliderThumbBackground" Color="Black" />
  <SolidColorBrush x:Key="ColorSliderThumbBackground" Color="DarkGray" />

  <Style x:Key="ColorSliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="Transparent" BorderThickness="0">
            <Path Name="Arrow" Data="M 2 0 L 7 7 L 12 0 Z" Fill="{StaticResource ColorSliderThumbBackground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource MousePressedSliderThumbBackground}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource MousePressedSliderThumbBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColorSliderStyle" TargetType="{x:Type Slider}">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="255" />
    <Setter Property="Margin" Value="0,2,3,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid MinHeight="{TemplateBinding Slider.MinHeight}">
            <Border Height="1" Background="Black" Margin="7,0,7,0" />
            <Border Name="HueBackground" Background="{StaticResource HorizontalHueGradient}" Opacity="0" Height="8" Margin="7,0,7,0" />
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Name="LowButton" Foreground="{Binding Foreground, RelativeSource={RelativeSource Self}}" Style="{StaticResource ColorSliderRepeatButtonStyle}"
                              Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" Command="Slider.DecreaseLarge" Margin="7,0,-7,0" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Margin="0,0,0,7" Style="{StaticResource ColorSliderThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Name="HighButton" Foreground="{Binding Foreground, RelativeSource={RelativeSource Self}}" Style="{StaticResource ColorSliderRepeatButtonStyle}"
                              Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" Command="Slider.IncreaseLarge" Margin="-7,0,7,0" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Foreground" Value="Transparent">
              <Setter TargetName="LowButton" Property="Template" Value="{StaticResource LowAlphaTemplate}" />
              <Setter TargetName="HighButton" Property="Template" Value="{StaticResource HighAlphaTemplate}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Red">
              <Setter TargetName="LowButton" Property="Template" Value="{StaticResource LowRedTemplate}" />
              <Setter TargetName="HighButton" Property="Template" Value="{StaticResource HighRedTemplate}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Green">
              <Setter TargetName="LowButton" Property="Template" Value="{StaticResource LowGreenTemplate}" />
              <Setter TargetName="HighButton" Property="Template" Value="{StaticResource HighGreenTemplate}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Blue">
              <Setter TargetName="LowButton" Property="Template" Value="{StaticResource LowBlueTemplate}" />
              <Setter TargetName="HighButton" Property="Template" Value="{StaticResource HighBlueTemplate}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Orange">
              <Setter TargetName="LowButton" Property="Template" Value="{StaticResource LowSaturationTemplate}" />
              <Setter TargetName="HighButton" Property="Template" Value="{StaticResource HighSaturationTemplate}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Yellow">
              <Setter TargetName="LowButton" Property="Template" Value="{StaticResource LowValueTemplate}" />
              <Setter TargetName="HighButton" Property="Template" Value="{StaticResource HighValueTemplate}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Purple">
              <Setter TargetName="LowButton" Property="Template" Value="{x:Null}" />
              <Setter TargetName="HighButton" Property="Template" Value="{x:Null}" />
              <Setter TargetName="HueBackground" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:ArithmeticConverter x:Key="Times100" Multiplier="100" />
  
  <Style x:Key="{x:Type local:ChannelColorPicker}" TargetType="{x:Type local:ChannelColorPicker}">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ChannelColorPicker}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="3,3,5,3">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Name="RRow" />
                <RowDefinition Name="GRow" />
                <RowDefinition Name="BRow" />
                <RowDefinition Name="HRow" />
                <RowDefinition Name="SRow" />
                <RowDefinition Name="VRow" />
                <RowDefinition Name="ARow" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="45" />
              </Grid.ColumnDefinitions>

              <Label Grid.Row="0" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="R:" VerticalAlignment="Center" />
              <Slider Name="RChannelEditor" Foreground="Red" Value="{Binding NotifyingColor.R, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="0" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="0" Grid.Column="2" Height="21" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=RChannelEditor, UpdateSourceTrigger=PropertyChanged}" />

              <Label Grid.Row="1" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="G:" VerticalAlignment="Center" />
              <Slider Name="GChannelEditor" Foreground="Green" Value="{Binding NotifyingColor.G, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="1" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="1" Grid.Column="2" Height="21" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=GChannelEditor, UpdateSourceTrigger=PropertyChanged}" />

              <Label Grid.Row="2" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="B:" VerticalAlignment="Center" />
              <Slider Name="BChannelEditor" Foreground="Blue" Value="{Binding NotifyingColor.B, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="2" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="2" Grid.Column="2" Height="21" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=BChannelEditor, UpdateSourceTrigger=PropertyChanged}" />

              <Label Grid.Row="3" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="H:" VerticalAlignment="Center" />
              <Slider Name="HChannelEditor" Foreground="Purple" Value="{Binding NotifyingColor.H, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="3" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center" Maximum="360"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="3" Grid.Column="2" Height="21" Minimum="0" Maximum="360" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=HChannelEditor, UpdateSourceTrigger=PropertyChanged}" />

              <Label Grid.Row="4" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="S:" VerticalAlignment="Center" />
              <Slider Name="SChannelEditor" Foreground="Orange" Value="{Binding NotifyingColor.S, Converter={StaticResource Times100}, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="4" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center" Maximum="100"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="4" Grid.Column="2" Height="21" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=SChannelEditor, UpdateSourceTrigger=PropertyChanged}" />

              <Label Grid.Row="5" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="V:" VerticalAlignment="Center" />
              <Slider Name="VChannelEditor" Foreground="Yellow" Value="{Binding NotifyingColor.V, Converter={StaticResource Times100}, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="5" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center" Maximum="100"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="5" Grid.Column="2" Height="21" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=VChannelEditor, UpdateSourceTrigger=PropertyChanged}" />

              <Label Grid.Row="6" Grid.Column="0" Foreground="{StaticResource Foreground}" Content="A:" VerticalAlignment="Center" />
              <Slider Name="AChannelEditor" Foreground="Transparent" Value="{Binding NotifyingColor.A, RelativeSource={RelativeSource TemplatedParent}}"
                      Grid.Row="6" Grid.Column="1" Style="{StaticResource ColorSliderStyle}" VerticalAlignment="Center"
                      Background="{TemplateBinding SelectedColor, Converter={StaticResource ColorToBrush}}" />
              <local:IntegerUpDown Grid.Row="6" Grid.Column="3" Height="21" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                   Value="{Binding Value, ElementName=AChannelEditor, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsRgbVisible" Value="False">
              <Setter TargetName="RRow" Property="Height" Value="0" />
              <Setter TargetName="GRow" Property="Height" Value="0" />
              <Setter TargetName="BRow" Property="Height" Value="0" />
            </Trigger>
            <Trigger Property="IsHsvVisible" Value="False">
              <Setter TargetName="HRow" Property="Height" Value="0" />
              <Setter TargetName="SRow" Property="Height" Value="0" />
              <Setter TargetName="VRow" Property="Height" Value="0" />
            </Trigger>
            <Trigger Property="IsAlphaVisible" Value="False">
              <Setter TargetName="ARow" Property="Height" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== -->
  <!--   ColorButton style   -->
  <!-- ===================== -->

  <Style x:Key="{x:Type local:ColorButton}" TargetType="{x:Type local:ColorButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorPickerListBoxBorder}" />
    <Setter Property="Background" Value="{StaticResource MenuBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ColorButton}">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="{StaticResource MenuItemLeftMarginBackground}" Width="26" />
              <Border Name="MouseOverBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Grid.ColumnSpan="2" Margin="1" />
              <Border Width="18" Height="18" BorderThickness="1" BorderBrush="{StaticResource MouseOverColorPickerListBoxItemBorder}"
                      Background="{StaticResource MouseOverColorPickerListBoxItemInnerBorder}" CornerRadius="1"
                      Name="SelectedBorder" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <Border Width="14" Height="14" BorderThickness="1" BorderBrush="{StaticResource ColorPickerListBoxBorder}"
                      Background="{TemplateBinding Color, Converter={StaticResource ColorToBrush}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" Margin="8,3,0,4" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
              <Setter TargetName="MouseOverBorder" Property="BorderBrush" Value="{StaticResource HighlightedMenuItemBorder}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =========================== -->
  <!--   DropDownPopupItem style   -->
  <!-- =========================== -->

  <Style x:Key="{x:Type local:DropDownPopupItem}" TargetType="{x:Type local:DropDownPopupItem}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorPickerListBoxBorder}" />
    <Setter Property="Background" Value="{StaticResource MenuBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DropDownPopupItem}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="17" />
              </Grid.ColumnDefinitions>
              <Border Background="{StaticResource MenuItemLeftMarginBackground}" Width="26" />
              <Border Name="MouseOverBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Grid.ColumnSpan="3" Margin="1" />
              <ContentPresenter Name="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Icon" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="8,3,0,4" />
              <Path Name="Arrow" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 0 7 L 4 3.5 Z" Fill="{TemplateBinding Foreground}" />
              <Popup Name="Popup" Placement="Right" HorizontalOffset="-3" VerticalOffset="-1" AllowsTransparency="True" Focusable="False"
                     IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                     PopupAnimation="Slide">
                <Grid Name="DropDown">
                  <Border Name="SubmenuBorder" SnapsToDevicePixels="True" Background="White"
                          BorderBrush="{StaticResource Border}" BorderThickness="1" MinWidth="135" Style="{StaticResource ShadowStyle}">
                    <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
              <Setter TargetName="MouseOverBorder" Property="BorderBrush" Value="{StaticResource HighlightedMenuItemBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
              <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="0,0,20,20" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================== -->
  <!--   MoreColorsButton style   -->
  <!-- ========================== -->

  <Image x:Key="MoreColorsIcon" Source="/Mindscape.WpfElements;component/Images/MoreColorsIcon.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" />

  <Style x:Key="{x:Type local:MoreColorsButton}" TargetType="{x:Type local:MoreColorsButton}" BasedOn="{StaticResource {x:Type local:DropDownPopupItem}}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Header" Value="More Colors" />
    <Setter Property="Icon" Value="{StaticResource MoreColorsIcon}" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <DockPanel>
            <Border Background="{StaticResource MenuBackground}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="OK" Width="80" Margin="5" Command="{x:Static local:MoreColorsButtonCommands.AcceptColor}" />
                <Button Content="Cancel" Width="80" Margin="5" Command="{x:Static local:MoreColorsButtonCommands.CancelColor}" />
              </StackPanel>
            </Border>
            <Border Height="1" Background="{StaticResource Border}" DockPanel.Dock="Bottom" />
            <local:HsvColorPicker x:Name="HSVPicker" Width="180" Height="180" DockPanel.Dock="Left" Margin="1"
                                  SelectedColor="{Binding NewColor, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:MoreColorsButton}}}" />
            <Border BorderBrush="Black" Padding="2" Background="White" CornerRadius="2" Margin="0,2,0,3" Height="30"
                    DockPanel.Dock="Bottom" Width="150" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding CurrentColor, Converter={StaticResource ColorToBrush}, RelativeSource={RelativeSource AncestorType={x:Type local:MoreColorsButton}}}" />
                <Border Background="{Binding NewColor, Converter={StaticResource ColorToBrush}, RelativeSource={RelativeSource AncestorType={x:Type local:MoreColorsButton}}}" Grid.Column="1" />
              </Grid>
            </Border>
            <local:ChannelColorPicker Width="180" BorderThickness="0" Height="140" H="{Binding H, Mode=TwoWay, ElementName=HSVPicker}"
                                      SelectedColor="{Binding NewColor, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:MoreColorsButton}}}" />
          </DockPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- AutoCompleteBox style -->

  <DataTemplate x:Key="SuggestionTemplate">
    <ContentPresenter Content="{Binding Suggestion}" />
  </DataTemplate>

  <Style x:Key="{x:Type local:AutoCompleteBox}" TargetType="{x:Type local:AutoCompleteBox}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AutoCompleteBox}">
          <Grid>
            <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer Margin="1" x:Name="PART_ContentHost" Height="{TemplateBinding Height}" />
            </Border>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Width="{Binding ActualWidth, ElementName=Border}">
                <ListBox Name="PART_ListBox" ItemsSource="{TemplateBinding MatchingSuggestions}"
                         ItemTemplate="{StaticResource SuggestionTemplate}" />
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
