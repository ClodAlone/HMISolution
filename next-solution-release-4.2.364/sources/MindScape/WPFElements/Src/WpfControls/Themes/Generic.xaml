  <Style x:Key="OutlookBarButtonStyle" TargetType="ToggleButton">
    <Setter Property="BorderBrush" Value="{StaticResource OutlookBarBorder}" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="Foreground"  Value="{StaticResource OutlookBarForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border Background="{StaticResource OutlookBarButtonBackground}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                    Name="Border" />
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2,0,2"
                              Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverOutlookBarButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedOutlookBarButtonBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedOutlookBarButtonBackground}" />
              <Setter Property="Foreground" Value="Black" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedMouseOverOutlookBarButtonBackground}" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="OutlookBarThumbStyle" TargetType="Thumb">
    <Setter Property="Template" >
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource OutlookBarBorder}" BorderThickness="1" Height="8">
            <Border Background="{StaticResource OutlookBarThumbBackground}" BorderBrush="White" BorderThickness="0,1,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" >
                <Border Background="{StaticResource OutlookBarBorder}" Width="2" Height="2">
                  <Border Background="{StaticResource OutlookBarThumbLightColor}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerColor}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource OutlookBarBorder}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightColor}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerColor}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource OutlookBarBorder}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightColor}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerColor}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource OutlookBarBorder}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightColor}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerColor}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource OutlookBarBorder}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightColor}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerColor}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
              </StackPanel>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <DataTemplate x:Key="OutlookBarItemTemplate">
    <ToggleButton Style="{StaticResource OutlookBarButtonStyle}" Content="{Binding Header}"
		          ContentTemplate="{Binding HeaderTemplate}" ContentTemplateSelector="{Binding HeaderTemplateSelector}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding Visibility}" />
  </DataTemplate>
  
  <DataTemplate x:Key="CollapsedOutlookBarItemTemplate">
    <ToggleButton Style="{StaticResource OutlookBarButtonStyle}" BorderThickness="0" Content="{Binding CollapsedHeader}"
	              ContentTemplate="{Binding CollapsedHeaderTemplate}" ContentTemplateSelector="{Binding CollapsedHeaderTemplateSelector}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding Visibility}" />
  </DataTemplate>
  
  <Style x:Key="{x:Type local:OutlookBar}" TargetType="{x:Type local:OutlookBar}">
    <Setter Property="BorderBrush" Value="{StaticResource OutlookBarBorder}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:OutlookBar}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource OutlookBarBorder}" BorderThickness="1,1,1,0">
              <ContentPresenter x:Name="PART_ContentHost" />
            </Border>
            <Thumb Grid.Row="1" x:Name="PART_Thumb" Style="{StaticResource OutlookBarThumbStyle}" Cursor="SizeNS" />
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" ItemTemplate="{StaticResource OutlookBarItemTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <local:CountLimitedPanel x:Name="PART_ExpandedItemsPanel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Grid.Row="3" MinHeight="25" Background="{StaticResource OutlookBarButtonBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,1,1">
              <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" ItemTemplate="{StaticResource CollapsedOutlookBarItemTemplate}"
                            HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:SizeLimitedPanel x:Name="PART_CollapsedItemsPanel" Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!--
  ==================================================================================================================================================================
                                                                           DropDownColorPicker styles
  ==================================================================================================================================================================
  -->

  <Style x:Key="ColorPickerDropDownEditBoxStyle" TargetType="{x:Type local:DropDownEditBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DropDownEditBox}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Name="ToggleButton"
                          Grid.Column="1">
              <Path Fill="Black" Data="M 0 0 L 1 0 L 0.5 1 Z" Width="9" Height="7" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
            <ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" />
            <Popup AllowsTransparency="True" Placement="Bottom" Focusable="False" Name="Popup" PopupAnimation="Slide" VerticalOffset="0"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Grid Name="PopupGrid">
                <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}"
                        Style="{StaticResource ShadowStyle}">
                  <ContentPresenter ContentTemplate="{TemplateBinding DropDownTemplate}" />
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="PopupGrid" Property="Margin" Value="0,0,20,20" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Foreground color picker -->

  <DataTemplate x:Key="ForegroundColorButtonTemplate">
    <Button Command="{x:Static local:RichTextCommands.ApplyForegroundColor}" Width="26" Padding="0">
      <Border Width="28" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="14" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1">A</TextBlock>
          <Border Width="18" Height="4" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}" Margin="0,-3,0,3" SnapsToDevicePixels="True" />
        </StackPanel>
      </Border>
    </Button>
  </DataTemplate>

  <DataTemplate x:Key="ForegroundColorPickerDropDownTemplate">
    <Border Background="White" BorderThickness="1" BorderBrush="{StaticResource Border}">
      <StackPanel>
        <local:ColorButton SelectedColor="{Binding SelectedColor}" Color="Black" Content="Automatic" />
        <local:ColorPicker SelectedColor="{Binding SelectedColor}" BorderThickness="0" />
        <local:MoreColorsButton CurrentColor="{Binding SelectedColor}" BorderThickness="0,1,0,0" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <Style x:Key="ForegroundColorPickerStyle" TargetType="local:DropDownColorPicker">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="DropDownTemplate" Value="{StaticResource ForegroundColorPickerDropDownTemplate}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource ForegroundColorButtonTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:DropDownColorPicker">
          <local:DropDownEditBox Style="{StaticResource ColorPickerDropDownEditBoxStyle}" HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                 DropDownTemplate="{TemplateBinding DropDownTemplate}" Content="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                 IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Background color picker -->

  <DataTemplate x:Key="BackgroundColorButtonTemplate">
    <Button Command="{x:Static local:RichTextCommands.ApplyBackgroundColor}" Width="26" Padding="0">
      <Border Width="28" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Margin="0,1,0,1">
          <Image Source="/Mindscape.WpfElements;component/Images/BackgroundPaint.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
          <Border Width="18" Height="4" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}" Margin="0,-4,0,4" />
        </StackPanel>
      </Border>
    </Button>
