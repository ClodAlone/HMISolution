<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:Mindscape.WpfElements">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Scheduler.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/PropertyGrid.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Charting.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/DataGrid.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Ribbon.Generic.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

  <Style TargetType="{x:Type local:MaskedTextBox}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <!--Setter Property="Focusable" Value="False" /-->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:MaskedTextBox}">
          <RichTextBox x:Name="PART_RichTextBox" Background="{TemplateBinding Background}"
                       Foreground="{TemplateBinding Foreground}"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}"
                       HorizontalScrollBarVisibility="Disabled"
                       AcceptsReturn="False"
                       AutoWordSelection="False"
					   Padding="{TemplateBinding Padding}"
                       />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <local:SignConverter x:Key="SignConverter" />
  
  <Style TargetType="{x:Type local:CurrencyTextBox}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CurrencyTextBox}">
          <TextBox x:Name="PART_TextBox"
                   HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   VerticalAlignment="{TemplateBinding VerticalAlignment}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   >
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CurrencyTextBox}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:CurrencyTextBox}}}" />
                <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CurrencyTextBox}}}" />
                <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CurrencyTextBox}}}" />
              </Style>
            </TextBox.Style>
          </TextBox>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource SignConverter}}"
                         Value="{x:Static local:Sign.Negative}">
              <Setter TargetName="PART_TextBox" Property="Style" Value="{Binding NegativeStyle, RelativeSource={RelativeSource AncestorType={x:Type local:CurrencyTextBox}}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:PercentageTextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:PercentageTextBox}">
          <TextBox x:Name="PART_TextBox"
                   HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   >
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:PercentageTextBox}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:PercentageTextBox}}}" />
                <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:PercentageTextBox}}}" />
                <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:PercentageTextBox}}}" />
              </Style>
            </TextBox.Style>
          </TextBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style TargetType="{x:Type local:ColorTextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ColorTextBox}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" BorderThickness="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:Spin}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Spin}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid DockPanel.Dock="Right">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <RepeatButton Command="{x:Static local:SpinCommands.Increase}" Grid.Row="0" 
                            Style="{StaticResource {x:Static local:Spin.SpinButtonStyleKey}}">
                <Polygon Points="3,0 6,3 0,3" Fill="Black" SnapsToDevicePixels="True" />
              </RepeatButton>
              <RepeatButton Command="{x:Static local:SpinCommands.Decrease}" Grid.Row="2" 
                            Style="{StaticResource {x:Static local:Spin.SpinButtonStyleKey}}">
                <Polygon Points="3,3 6,0 0,0" Fill="Black" SnapsToDevicePixels="True" />
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:SpinDecorator}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SpinDecorator}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <DockPanel>
              <local:Spin DockPanel.Dock="Right" Change="{TemplateBinding Change}" x:Name="PART_Spin"
                          Visibility="{TemplateBinding ShowSpinUI, Converter={StaticResource BooleanToVisibility}}" />
              <ContentPresenter />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:NumericTextBox}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:NumericTextBox}">
          <TextBox x:Name="PART_TextBox" 
                   HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   >
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:NumericTextBox}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:NumericTextBox}}}" />
                <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:NumericTextBox}}}" />
                <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:NumericTextBox}}}" />
              </Style>
            </TextBox.Style>
          </TextBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style TargetType="{x:Type local:DoubleTextBox}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DoubleTextBox}">
          <TextBox x:Name="PART_TextBox" 
                   HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   >
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:DoubleTextBox}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:DoubleTextBox}}}" />
                <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DoubleTextBox}}}" />
                <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:DoubleTextBox}}}" />
              </Style>
            </TextBox.Style>
          </TextBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:IntegerTextBox}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="ShowSeparators" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:IntegerTextBox}">
          <TextBox x:Name="PART_TextBox"
                   HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   >
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:IntegerTextBox}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:IntegerTextBox}}}" />
                <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:IntegerTextBox}}}" />
                <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:IntegerTextBox}}}" />
              </Style>
            </TextBox.Style>
          </TextBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="SpinTextBox" TargetType="ComboBox">
    <Setter Property="IsEditable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <TextBox Name="PART_EditableTextBox" BorderThickness="0" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="NumericElementTemplate">
    <local:SpinDecorator ShowSpinUI="False" Change="1" BorderThickness="0">
      <local:IntegerTextBox Value="{Binding Value}" Culture="{Binding Culture}"
                            Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                            Precision="{Binding Precision}"
                            EnforcePrecision="False"
                            ShowSeparators="False" BorderThickness="0" />
    </local:SpinDecorator>
  </DataTemplate>
  
  <DataTemplate x:Key="ReadOnlyElementTemplate">
    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
             BorderThickness="0" Focusable="False" 
             Background="Transparent" 
             Foreground="{Binding Foreground}" 
             />
  </DataTemplate>
  
  <DataTemplate x:Key="SelectElementTemplate">
    <ComboBox SelectedValue="{Binding Text}" Style="{StaticResource SpinTextBox}"
              Background="Transparent" 
              Foreground="{Binding Foreground}" 
              ItemsSource="{Binding PermittedValues}" />
  </DataTemplate>
  
  <local:DateTimePartTemplateSelector x:Key="DateTimePartTemplateSelector"
                                      NumericElementTemplate="{StaticResource NumericElementTemplate}"
                                      SelectElementTemplate="{StaticResource SelectElementTemplate}"
                                      ReadOnlyElementTemplate="{StaticResource ReadOnlyElementTemplate}"
                                      />

  <Style TargetType="{x:Type local:DateTimePicker}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DateTimePicker}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <ItemsControl ItemsSource="{TemplateBinding DisplayElements}"
                          ItemTemplateSelector="{StaticResource DateTimePartTemplateSelector}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <local:ProportionalStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style>
                  <Setter Property="local:ProportionalStackPanel.Proportion" Value="{Binding EstimatedProportion}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ItemsControl>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:DropDownEditBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DropDownEditBox}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Name="Bd">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
              <ToggleButton IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                            Grid.Column="1" Style="{StaticResource {x:Static local:DropDownEditBox.ToggleButtonStyleKey}}" />
              <Popup AllowsTransparency="True" Placement="Bottom" Focusable="False"
                     PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" 
                     IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="0" SnapsToDevicePixels="True"
                        MinWidth="{Binding ActualWidth, ElementName=Bd}">
                  <ContentPresenter ContentTemplate="{TemplateBinding DropDownTemplate}" />
                </Border>
              </Popup>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="EmptyStyle" />
  
  <local:SameMonthConverter x:Key="SameMonth" />

  <DataTemplate x:Key="NonDayTemplate">
    <TextBlock />
  </DataTemplate>

  <DataTemplate x:Key="DayTemplate">
    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Day}" />
    <DataTemplate.Triggers>
      <DataTrigger Value="False">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource SameMonth}">
            <Binding />
            <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:MonthCalendar}}" Path="VisibleMonth" />
          </MultiBinding>
        </DataTrigger.Binding>
        <DataTrigger.Setters>
          <Setter Property="TextBlock.Foreground" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        </DataTrigger.Setters>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <local:DayTemplateSelector x:Key="DayTemplateSelector" 
                             DayTemplate="{StaticResource DayTemplate}" 
                             NonDayTemplate="{StaticResource NonDayTemplate}" />
  
  <s:String x:Key="{x:Static local:MonthCalendar.TodayButtonContentKey}">Today</s:String>
  
  <Style TargetType="{x:Type local:MonthCalendar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:MonthCalendar}">
          <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <RepeatButton DockPanel.Dock="Left" Focusable="False" Style="{StaticResource {x:Static local:MonthCalendar.SelectButtonStyleKey}}"
                              Command="{x:Static local:CalendarCommands.MonthBack}">
                  <Polygon Points="0,4 8,0 8,8" Fill="Black" />
                </RepeatButton>
                <RepeatButton DockPanel.Dock="Right" Focusable="False" Style="{StaticResource {x:Static local:MonthCalendar.SelectButtonStyleKey}}" 
                              Command="{x:Static local:CalendarCommands.MonthForward}">
                  <Polygon Points="0,0 0,8 8,4" Fill="Black" />
                </RepeatButton>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding MonthText}" />
                  <TextBlock Text="{Binding SelectedDate.Year, RelativeSource={RelativeSource AncestorType={x:Type local:MonthCalendar}}}" />
                </TextBlock>
              </DockPanel>
              <ItemsControl x:Name="PART_DaysOfWeekList" HorizontalContentAlignment="Center" DockPanel.Dock="Top">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button Command="{x:Static local:CalendarCommands.SelectToday}" 
                        Style="{StaticResource {x:Static local:MonthCalendar.SelectButtonStyleKey}}"
                        Content="{DynamicResource {x:Static local:MonthCalendar.TodayButtonContentKey}}"
                        />
              </StackPanel>
              <ListBox x:Name="PART_DaysList" ItemTemplateSelector="{StaticResource DayTemplateSelector}" 
                       HorizontalContentAlignment="Center" BorderThickness="0"
                       Background="{TemplateBinding Background}"
                       Foreground="{TemplateBinding Foreground}"
                       KeyboardNavigation.DirectionalNavigation="None" FocusVisualStyle="{StaticResource EmptyStyle}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="{Binding WeeksToDisplay, RelativeSource={RelativeSource AncestorType={x:Type local:MonthCalendar}}}" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style TargetType="{x:Type local:DropDownDatePicker}">
    <Style.Resources>
      <DataTemplate x:Key="HeaderTemplate">
        <local:DateTimePicker Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              BorderThickness="0"
                              Culture="{Binding Culture}"
							  Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownDatePicker}}}"
							  Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownDatePicker}}}"
                              Format="{Binding Format}" CustomFormat="{Binding CustomFormat}" />
      </DataTemplate>
      <DataTemplate x:Key="DropDownTemplate">
        <local:MonthCalendar SelectedDate="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             Culture="{Binding Culture}"
                             Background="{Binding Background}"
                             Foreground="{Binding Foreground}"
                             TodayButtonTimeAction="{Binding TodayButtonTimeAction}"
							 Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownDatePicker}}}"
							 Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownDatePicker}}}"
                             local:DropDownEditBox.RequestCloseOnAction="{Binding CloseOnSelect, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownDatePicker}}}"
                             />
      </DataTemplate>
    </Style.Resources>
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DropDownDatePicker}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <local:DropDownEditBox Background="{TemplateBinding Background}" 
                                   Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:DropDownDatePicker}}}"
                                   HeaderTemplate="{StaticResource HeaderTemplate}"
                                   DropDownTemplate="{StaticResource DropDownTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:MulticolumnTreeView.ExpandCollapseToggleStyleKey}"
         TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Width="19" Height="13" Background="Transparent">
            <Border Width="9" Height="9" BorderThickness="1"
                    BorderBrush="#FF7898B5" CornerRadius="1" SnapsToDevicePixels="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="White" Offset="0.2" />
                  <GradientStop Color="#FFC0B7A6" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Path x:Name="ExpandPath" Margin="1,1,1,1" Fill="Black"
                    Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Data" TargetName="ExpandPath" Value="M 0 2 L 0 3 L 5 3 L 5 2 Z" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:MulticolumnTreeViewIndentConverter x:Key="LevelToIndentConverter" Indent="14" />
  
  <DataTemplate x:Key="{x:Static local:MulticolumnTreeView.ExpandingCellTemplateKey}">
    <Border SnapsToDevicePixels="True" Name="Bd"
            Focusable="False" FocusVisualStyle="{StaticResource EmptyStyle}"
            Margin="-6,0,0,0"
            BorderThickness="0">
      <DockPanel>
        <ToggleButton x:Name="Expander" 
                      Style="{StaticResource {x:Static local:MulticolumnTreeView.ExpandCollapseToggleStyleKey}}" 
                      Margin="{Binding Level, Converter={StaticResource LevelToIndentConverter}, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}"
                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}"
                      ClickMode="Press" />
        <ContentPresenter ContentTemplate="{Binding Columns[0].OriginalCellTemplate, RelativeSource={RelativeSource AncestorType={x:Type GridViewRowPresenter}}}"
                          ContentTemplateSelector="{Binding Columns[0].OriginalCellTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type GridViewRowPresenter}}}"
                          />
      </DockPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=HasItems,RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}" 
                   Value="False">
        <Setter TargetName="Expander"
                Property="ToggleButton.Visibility"
                Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}"
                   Value="True">
        <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  
  <Style TargetType="local:MulticolumnTreeViewItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:MulticolumnTreeViewItem">
          <StackPanel>
            <Border Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <GridViewRowPresenter x:Name="PART_Header" Content="{TemplateBinding Header}"
                                    Columns="{Binding WrappedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeView}}}" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Width" Value="Auto" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Height" Value="Auto" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:MulticolumnTreeView.ScrollViewerStyleKey}" TargetType="ScrollViewer">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="{TemplateBinding Padding}">
              <ScrollViewer DockPanel.Dock="Top" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <GridViewHeaderRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                            Columns="{Binding TemplatedParent.WrappedColumns, RelativeSource={RelativeSource TemplatedParent}}"
                                            ColumnHeaderContainerStyle="{Binding TemplatedParent.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}" 
                                            ColumnHeaderTemplate="{Binding TemplatedParent.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}" 
                                            ColumnHeaderTemplateSelector="{Binding TemplatedParent.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" 
                                            ColumnHeaderContextMenu="{Binding TemplatedParent.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}" 
                                            AllowsColumnReorder="{Binding TemplatedParent.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}" />
              </ScrollViewer>
              <ScrollContentPresenter Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local" 
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" 
                                      CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </DockPanel>
            <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" 
                       Grid.Row="1" 
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableWidth}" 
                       ViewportSize="{TemplateBinding ViewportWidth}" 
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" 
                       Cursor="Arrow" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" 
                       Grid.Column="1" 
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableHeight}" 
                       ViewportSize="{TemplateBinding ViewportHeight}" 
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                       Cursor="Arrow" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            <DockPanel Grid.Column="1" Grid.Row="1" LastChildFill="False" Background="{Binding Background, ElementName=PART_VerticalScrollBar}">
              <Rectangle DockPanel.Dock="Left" Width="1" Fill="White" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
              <Rectangle DockPanel.Dock="Top" Height="1" Fill="White" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </DockPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="local:MulticolumnTreeView">
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ExpandingDecorator" Value="{StaticResource {x:Static local:MulticolumnTreeView.ExpandingCellTemplateKey}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:MulticolumnTreeView">
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}">
              <ScrollViewer Style="{StaticResource {x:Static local:MulticolumnTreeView.ScrollViewerStyleKey}}"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:CoverFlow}">
    <Setter Property="Background" Value="Black" />
    <Setter Property="ReflectionBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
          <GradientStop Offset="0" Color="#A0000000" />
          <GradientStop Offset="1" Color="Black" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CoverFlow}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Canvas IsItemsHost="True" ClipToBounds="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:ReflectionPositionConverter x:Key="ReflectionPosition" Offset="0" />
  <local:ReflectionPositionConverter x:Key="ReflectionGradientPosition" Offset="1" />
  <local:NegativeConverter x:Key="Negative" />
  
  <Style TargetType="{x:Type local:CoverFlowItem}">
    <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Clip">
      <Setter.Value>
        <PathGeometry>
          <PathFigure StartPoint="{Binding ClipBottomLeft, RelativeSource={RelativeSource AncestorType={x:Type local:CoverFlowItem}}}" IsClosed="True">
            <PathFigure.Segments>
              <LineSegment Point="0, 0" />
              <LineSegment Point="{Binding ClipTopRight, RelativeSource={RelativeSource AncestorType={x:Type local:CoverFlowItem}}}" />
              <LineSegment Point="{Binding ClipBottomRight, RelativeSource={RelativeSource AncestorType={x:Type local:CoverFlowItem}}}" />
            </PathFigure.Segments>
          </PathFigure>
        </PathGeometry>
      </Setter.Value>
    </Setter>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TransformGroup>
          <ScaleTransform ScaleX="1" ScaleY="1" />
          <SkewTransform AngleX="0" AngleY="0" />
          <TranslateTransform X="0" Y="0" />
        </TransformGroup>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CoverFlowItem}">
          <ControlTemplate.Resources>
            <Storyboard x:Key="{x:Static local:CoverFlowItem.TransitionAnimationKey}">
              <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" />
              <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" />
              <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(SkewTransform.AngleY)" />
              <DoubleAnimation Duration="0:0:0.2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)" />
              <PointAnimation Duration="0:0:0.2" Storyboard.TargetProperty="(UIElement.Clip).(PathGeometry.Figures)[0].(PathFigure.Segments)[0].(LineSegment.Point)" />
              <PointAnimation Duration="0:0:0.2" Storyboard.TargetProperty="(UIElement.Clip).(PathGeometry.Figures)[0].(PathFigure.Segments)[1].(LineSegment.Point)" />
            </Storyboard>
          </ControlTemplate.Resources>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" 
                  >
            <Canvas>

              <ContentPresenter Name="ContentPresenter" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" />

              <Rectangle Width="{TemplateBinding Width}" 
                         Height="{TemplateBinding Height}">
                <Rectangle.Fill>
                  <VisualBrush TileMode="FlipX" AlignmentY="Bottom" Stretch="UniformToFill" Visual="{Binding ElementName=ContentPresenter}" />
                </Rectangle.Fill>
                <Rectangle.LayoutTransform>
                  <ScaleTransform ScaleY="{Binding ReflectionScaleY, Converter={StaticResource Negative}, RelativeSource={RelativeSource AncestorType={x:Type local:CoverFlow}}}" />
                </Rectangle.LayoutTransform>
                <Rectangle.RenderTransform>
                  <TranslateTransform Y="{Binding Height, Converter={StaticResource ReflectionPosition}, RelativeSource={RelativeSource TemplatedParent}}" />
                </Rectangle.RenderTransform>
              </Rectangle>
              
              <Rectangle Width="{TemplateBinding Width}" 
                         Height="{TemplateBinding Height}"
                         Fill="{Binding ReflectionBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CoverFlow}}}">
                <Rectangle.LayoutTransform>
                  <ScaleTransform ScaleY="{Binding ReflectionScaleY, Converter={StaticResource Negative}, RelativeSource={RelativeSource AncestorType={x:Type local:CoverFlow}}}" />
                </Rectangle.LayoutTransform>
                <Rectangle.RenderTransform>
                  <TranslateTransform Y="{Binding Height, Converter={StaticResource ReflectionGradientPosition}, RelativeSource={RelativeSource TemplatedParent}}" />
                </Rectangle.RenderTransform>
              </Rectangle>

            </Canvas>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="DefaultPromptTemplate">
    <TextBlock Text="{Binding}" FontStyle="Italic" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#888888" IsHitTestVisible="False"
               />
  </DataTemplate>

  <Style x:Key="{x:Type local:PromptDecorator}" TargetType="{x:Type local:PromptDecorator}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:PromptDecorator}">
          <Grid>
            <ContentPresenter />
            <ContentControl Name="PromptControl" ContentTemplate="{TemplateBinding PromptTemplate}" Content="{TemplateBinding Prompt}"
                            Visibility="{TemplateBinding IsPromptVisible, Converter={StaticResource BooleanToVisibility}}"
                            Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="PromptTemplate" Value="{x:Null}">
              <Setter TargetName="PromptControl" Property="ContentTemplate" Value="{StaticResource DefaultPromptTemplate}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Color picker -->

  <local:PointToTranslateTransformConverter x:Key="PointToTranslateTransform" />
  <local:HueToSaturationGradientBrushConverter x:Key="SaturationGradient" />

  <Style x:Key="{x:Type local:ColorSquare}" TargetType="{x:Type local:ColorSquare}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ColorSquare">
          <Grid SnapsToDevicePixels="True">
            <Border Background="{Binding NotifyingColor.H, Converter={StaticResource SaturationGradient}, RelativeSource={RelativeSource TemplatedParent}}" />
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Offset="0" Color="#00000000" />
                  <GradientStop Offset="1" Color="#FF000000" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid ClipToBounds="True">
              <Grid Width="12" Height="12" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-6,-6,6,6"
                  RenderTransform="{Binding CursorPosition, Converter={StaticResource PointToTranslateTransform}, RelativeSource={RelativeSource TemplatedParent}}">
                <Ellipse Width="12" Height="12" StrokeThickness="1" Stroke="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Ellipse Width="10" Height="10" StrokeThickness="1" Stroke="Black" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Ellipse Width="8" Height="8" StrokeThickness="1" Stroke="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF0000" />
    <GradientStop Offset="0.1666" Color="#FFFF00" />
    <GradientStop Offset="0.3333" Color="#00FF00" />
    <GradientStop Offset="0.5" Color="#00FFFF" />
    <GradientStop Offset="0.6666" Color="#0000FF" />
    <GradientStop Offset="0.8333" Color="#FF00FF" />
    <GradientStop Offset="1" Color="#FF0000" />
  </LinearGradientBrush>

  <Style x:Key="HueThumbStyle" TargetType="Thumb">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Path Fill="Black" Data="M 0 0 L 1 0.5 L 0 1 Z" Stretch="Fill" HorizontalAlignment="Left" Width="7" Height="9" />
            <Path Fill="Black" Data="M 0 0.5 L 1 0 L 1 1 Z" Stretch="Fill" HorizontalAlignment="Right" Width="7" Height="9" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HueSliderStyle" TargetType="Slider">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border Background="{StaticResource HueGradient}" SnapsToDevicePixels="True" />
            <Border  ClipToBounds="True">
              <Track Orientation="Vertical" Name="PART_Track" Margin="0,-4,0,-4" SnapsToDevicePixels="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource HueThumbStyle}" />
                </Track.Thumb>
              </Track>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type local:HsvColorPicker}" TargetType="{x:Type local:HsvColorPicker}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HsvColorPicker}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:ColorSquare Name="ColorSquare" SelectedColor="{Binding SelectedColor, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" H="{Binding H, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Slider Name="PART_Slider" Style="{StaticResource HueSliderStyle}" Width="20" Grid.Column="1" Value="{Binding NotifyingColor.H, Mode=TwoWay, ElementName=ColorSquare}"
                    Minimum="0" Maximum="360" IsDirectionReversed="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

