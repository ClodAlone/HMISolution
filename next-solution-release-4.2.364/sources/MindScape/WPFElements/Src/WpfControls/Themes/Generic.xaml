  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="VerticalMouseOverDualSliderThumbBackground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#FFF7CA" />
    <GradientStop Offset="1" Color="#FFDE7F" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="HorizontalPressedDualSliderThumbBackground" StartPoint="0,0" EndPoint="0,1">
