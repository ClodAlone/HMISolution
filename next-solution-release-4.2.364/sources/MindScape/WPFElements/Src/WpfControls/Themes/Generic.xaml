  <!-- Main dual slider styles -->

  <SolidColorBrush x:Key="TimeExplorerMainDualSliderForeground" Color="Black" />

  <Style x:Key="TimeExplorerMainHorizontalStartThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="11" Margin="-9,0,9,0">
            <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="1,1,0,1" Background="{StaticResource ScrollBarInnerBorder}" Width="9" HorizontalAlignment="Left">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" Margin="1,1,0,1" />
            </Border>
            <Path Data="M 0 2.5 L 3 0 L 3 5 Z" Width="3" Height="5" Fill="{StaticResource TimeExplorerMainDualSliderForeground}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Border Name="Etch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,0,1,0" Margin="0,1,0,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Right" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TimeExplorerMainHorizontalEndThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="11" Margin="-2,0,0,0">
            <Border BorderBrush="{StaticResource ScrollBarBorder}" BorderThickness="0,1,1,1" Background="{StaticResource ScrollBarInnerBorder}" Width="9" HorizontalAlignment="Right">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" BorderThickness="0,1,1,1" />
            </Border>
            <Path Data="M 0 0 L 3 2.5 L 0 5 Z" Width="3" Height="5" Fill="{StaticResource TimeExplorerMainDualSliderForeground}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Border Name="Etch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="1,0,0,0" Margin="0,1,0,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Left" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
              <Setter TargetName="Etch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TimeExplorerMainHorizontalRangeThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border BorderThickness="0,1,0,1" BorderBrush="{StaticResource ScrollBarBorder}" Background="{StaticResource ScrollBarInnerBorder}">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" Margin="0,1,0,1" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="7" Orientation="Horizontal"
                        Visibility="{Binding ActualWidth, Converter={StaticResource GripperVisibility}, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
            </StackPanel>
            <Border Name="LeftEtch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="0,0,1,0" Margin="0,1,0,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Left" Visibility="Hidden" />
            <Border Name="RightEtch" Background="{StaticResource ScrollBarLightGripperColor}" BorderThickness="1,0,0,0" Margin="0,1,1,1"
                    BorderBrush="{StaticResource ScrollBarGripperColor}" Width="2" HorizontalAlignment="Right" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
              <Setter TargetName="LeftEtch" Property="Visibility" Value="Visible" />
              <Setter TargetName="RightEtch" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
              <Setter TargetName="LeftEtch" Property="Visibility" Value="Visible" />
              <Setter TargetName="RightEtch" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <SolidColorBrush x:Key="TimeExplorerMarkerBorder" Color="#3399FF" />
  <SolidColorBrush x:Key="TimeExplorerMarkerBackground" Color="#A8CAEC" />

  <Style x:Key="TimeExplorerMainDualSliderStyle" TargetType="{x:Type local:TimeExplorerMainDualSlider}">
    <Setter Property="Background" Value="{StaticResource ScrollBarBackground}" />
    <Setter Property="EndBuffer" Value="9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimeExplorerMainDualSlider}">
          <Grid Background="{TemplateBinding Background}">
            <Grid x:Name="PART_Root" Background="Transparent" VerticalAlignment="Center" Margin="1">
              <Border Name="PART_InternalMarker" Height="13" HorizontalAlignment="Left" BorderThickness="1"
                      BorderBrush="{StaticResource TimeExplorerMarkerBorder}" Background="{StaticResource TimeExplorerMarkerBackground}" />
              <RepeatButton x:Name="PART_LargeDecreaseButton" HorizontalAlignment="Left" Template="{StaticResource InvisibleRepeatButton}" />
              <RepeatButton x:Name="PART_LargeIncreaseButton" HorizontalAlignment="Left" Template="{StaticResource InvisibleRepeatButton}" />
              <Thumb x:Name="PART_RangeThumb" Style="{StaticResource TimeExplorerMainHorizontalRangeThumbStyle}" HorizontalAlignment="Left" Height="13" />
              <Thumb x:Name="PART_StartThumb" Style="{StaticResource TimeExplorerMainHorizontalStartThumbStyle}" HorizontalAlignment="Left" Cursor="SizeWE" />
              <Thumb x:Name="PART_EndThumb" Style="{StaticResource TimeExplorerMainHorizontalEndThumbStyle}" HorizontalAlignment="Left" Cursor="SizeWE" />
            </Grid>

            <Grid x:Name="PART_VerticalRoot" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Internal dual slider styles -->

  <SolidColorBrush x:Key="TimeExplorerInternalDualSliderForeground" Color="Black" />

  <Style x:Key="TimeExplorerInternalHorizontalStartThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="8">
            <Border BorderThickness="1" BorderBrush="{StaticResource Border}" Background="{StaticResource ScrollBarInnerBorder}" />
            <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" Margin="1,2,2,2" />
            <Path Data="M 0 2.5 L 3 0 L 3 5 Z" Width="3" Height="5" Fill="{StaticResource TimeExplorerInternalDualSliderForeground}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TimeExplorerInternalHorizontalEndThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="8" Margin="-7,0,0,0">
            <Border BorderThickness="1" BorderBrush="{StaticResource Border}" Background="{StaticResource ScrollBarInnerBorder}" />
            <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" Margin="2,2,1,2" />
            <Path Data="M 0 0 L 3 2.5 L 0 5 Z" Width="3" Height="5" Fill="{StaticResource TimeExplorerInternalDualSliderForeground}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TimeExplorerInternalHorizontalRangeThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0" Height="13" VerticalAlignment="Bottom">
              <Border Name="InnerBorder" Background="{StaticResource HorizontalScrollBarForeground}" BorderThickness="1" BorderBrush="{StaticResource ScrollBarInnerBorder}" />
            </Border>
            <Border BorderThickness="1,0,1,0" BorderBrush="{StaticResource Border}" Margin="0,0,0,12" IsHitTestVisible="False" />
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="8" Orientation="Horizontal" Margin="0,0,0,2"
                        Visibility="{Binding ActualWidth, Converter={StaticResource GripperVisibility}, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarGripperColor}" />
              <Border Width="1" Background="{StaticResource ScrollBarLightGripperColor}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMouseOverScrollBarColor}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource HorizontalMousePressedScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <SolidColorBrush x:Key="TimeExplorerClearRepeatButtonBackground" Color="#444444" />

  <ControlTemplate x:Key="ClearRepeatButtonTemplate" TargetType="RepeatButton">
    <Border Background="{StaticResource TimeExplorerClearRepeatButtonBackground}" Opacity="0.5" IsHitTestVisible="False" />
  </ControlTemplate>

  <Style x:Key="TimeExplorerInternalDualSliderStyle" TargetType="{x:Type local:DualSlider}">
    <Setter Property="EndBuffer" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DualSlider}">
          <Grid>
            <Grid x:Name="PART_Root">
              <RepeatButton x:Name="PART_LargeDecreaseButton" HorizontalAlignment="Left" Template="{StaticResource ClearRepeatButtonTemplate}" />
              <RepeatButton x:Name="PART_LargeIncreaseButton" HorizontalAlignment="Left" Template="{StaticResource ClearRepeatButtonTemplate}" />
              <Thumb x:Name="PART_RangeThumb" Style="{StaticResource TimeExplorerInternalHorizontalRangeThumbStyle}" HorizontalAlignment="Left" />
              <Thumb x:Name="PART_StartThumb" Style="{StaticResource TimeExplorerInternalHorizontalStartThumbStyle}" HorizontalAlignment="Left" Cursor="SizeWE" Height="19" VerticalAlignment="Center"
                     Visibility="{Binding CanEditRangeMagnitude, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:TimeExplorer}}}" />
              <Thumb x:Name="PART_EndThumb" Style="{StaticResource TimeExplorerInternalHorizontalEndThumbStyle}" HorizontalAlignment="Left" Cursor="SizeWE" Height="19" VerticalAlignment="Center"
                     Visibility="{Binding CanEditRangeMagnitude, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:TimeExplorer}}}" />
            </Grid>

            <Grid x:Name="PART_VerticalRoot" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TimeExplorer time unit buttons -->

  <SolidColorBrush x:Key="TimeExplorerBackground" Color="#EDEDED" />
  <SolidColorBrush x:Key="MouseOverTimeExplorerTimeUnitBackground" Color="#22000000" />
  <SolidColorBrush x:Key="TimeExplorerMinorTimeUnitBackground" Color="#19000000" />

  <DataTemplate x:Key="TimeExplorerMinorTimeUnitTemplate">
    <Grid Name="Grid" Margin="1,0,0,0" Background="{StaticResource TimeExplorerMinorTimeUnitBackground}">
      <Border Name="Border" Background="Transparent" />
      <TextBlock Foreground="Black" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Center" Text="{Binding Label}" Width="{Binding Width}"
                 TextAlignment="Center" Margin="0,0,0,2" />
    </Grid>
    <DataTemplate.Triggers>
      <Trigger SourceName="Grid" Property="IsMouseOver" Value="True">
        <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverTimeExplorerTimeUnitBackground}" />
      </Trigger>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverTimeExplorerTimeUnitBackground}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="TimeExplorerMajorTimeUnitTemplate">
    <Grid Name="Grid" Background="Transparent">
      <Border Width="{Binding Width}" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Border}" />
      <TextBlock Foreground="Black" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Center" Text="{Binding Label}" Width="{Binding Width}" TextAlignment="Center" />
    </Grid>
    <DataTemplate.Triggers>
      <Trigger SourceName="Grid" Property="IsMouseOver" Value="True">
        <Setter TargetName="Grid" Property="Background" Value="{StaticResource MouseOverTimeExplorerTimeUnitBackground}" />
      </Trigger>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter TargetName="Grid" Property="Background" Value="{StaticResource MouseOverTimeExplorerTimeUnitBackground}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- TimeExplorer style -->

  <Style x:Key="{x:Type local:TimeExplorer}" TargetType="{x:Type local:TimeExplorer}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Background" Value="{StaticResource TimeExplorerBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TimeExplorer}">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
              <Grid ClipToBounds="True" Margin="-1,0,0,0">
                <ContentPresenter Content="{TemplateBinding Chart}" Margin="0,20,0,27" />
                <ItemsControl x:Name="PART_MajorButtonHost" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent" Margin="0,0,-100000,12"
                              ItemTemplate="{StaticResource TimeExplorerMajorTimeUnitTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="PART_MinorButtonHost" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent" Margin="0,15,-100000,12"
                              ItemTemplate="{StaticResource TimeExplorerMinorTimeUnitTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <local:DualSlider Name="PART_InternalDualSlider" Style="{StaticResource TimeExplorerInternalDualSliderStyle}" MinimumRange="10" />
              </Grid>
            </Border>
            <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,1,1">
              <local:TimeExplorerMainDualSlider x:Name="PART_MainDualSlider" Style="{StaticResource TimeExplorerMainDualSliderStyle}"
                                                InternalRangeStart="{Binding RangeStart, ElementName=PART_InternalDualSlider}"
                                                InternalRangeEnd="{Binding RangeEnd, ElementName=PART_InternalDualSlider}" />
            </Border>
            <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Grid.RowSpan="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
