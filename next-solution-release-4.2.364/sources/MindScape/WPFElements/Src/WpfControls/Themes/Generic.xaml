  <Style x:Key="{x:Type local:RichTextToolBar}" TargetType="{x:Type local:RichTextToolBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RichTextToolBar}">
          <Grid Height="80">
            <StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <ToggleButton Command="{x:Static local:RichTextCommands.ToggleFontWeight}" CommandParameter="{StaticResource Bold}"
                              Width="24" Height="24" ToolTip="Bold (Ctrl + B)"
                              ContentTemplate="{StaticResource BoldButtonTemplate}"
                              IsChecked="{Binding CurrentFontWeight, Converter={StaticResource FontWeightToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}">B</ToggleButton>
                <ToggleButton Command="{x:Static local:RichTextCommands.ToggleFontStyle}" CommandParameter="{StaticResource Italic}"
                              Width="24" Height="24" ToolTip="Italic (Ctrl + I)"
                              ContentTemplate="{StaticResource ItalicButtonTemplate}"
                              IsChecked="{Binding CurrentFontStyle, Converter={StaticResource FontStyleToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}">I</ToggleButton>
                <ToggleButton Command="{x:Static local:RichTextCommands.ToggleTextDecorations}" CommandParameter="{StaticResource Underline}"
                              Width="24" Height="24" ToolTip="Underline (Ctrl + U)"
                              ContentTemplate="{StaticResource UnderlineButtonTemplate}"
                              IsChecked="{Binding CurrentTextDecorations, Converter={StaticResource UnderlineToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}">U</ToggleButton>

                <local:DropDownColorPicker Palette="{Binding BackgroundPalette, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,0,0,0" Height="24"
                                          Style="{StaticResource BackgroundColorPickerStyle}"
                                          SelectedColor="{Binding CurrentBackground, Converter={StaticResource BrushToColor}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <local:DropDownColorPicker Palette="{Binding ForegroundPalette, RelativeSource={RelativeSource TemplatedParent}}" Margin="5,0,0,0" Height="24"
                                          Style="{StaticResource ForegroundColorPickerStyle}"
                                          SelectedColor="{Binding CurrentForeground, Converter={StaticResource BrushToColor}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Left}" Margin="10,0,0,0" Width="24"
                              ContentTemplate="{StaticResource LeftAlignmentButtonTemplate}" ToolTip="Align Text Left (Ctrl + L)"
                              IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource LeftAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Center}" Width="24"
                              ContentTemplate="{StaticResource CenterAlignmentButtonTemplate}" ToolTip="Center (Ctrl + E)"
                              IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource CenterAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Right}" Width="24"
                              ContentTemplate="{StaticResource RightAlignmentButtonTemplate}" ToolTip="Align Text Right (Ctrl + R)"
                              IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource RightAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Justify}" Width="24"
                              ContentTemplate="{StaticResource JustifyAlignmentButtonTemplate}" ToolTip="Justify (Ctrl + J)"
                              IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource JustifyAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />

                <ComboBox Width="140" SelectedValue="{Binding CurrentFontFamily, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="10,0,0,0"
                          ItemsSource="{Binding FontFamilies, RelativeSource={RelativeSource TemplatedParent}}" ItemTemplate="{StaticResource FontFamilyItemTemplate}"
                          Name="FontSelector" Height="24" />
                <ComboBox Width="50" SelectedValue="{Binding CurrentFontSize, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="5,0,0,0"
                          ItemsSource="{Binding FontSizes, RelativeSource={RelativeSource TemplatedParent}}" Height="24" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
                <Button Command="{x:Static ApplicationCommands.Cut}" ToolTip="Cut (Ctrl + X)" Width="24" Height="24" Padding="0"
                        ContentTemplate="{StaticResource CutButtonTemplate}" />
                <Button Command="{x:Static ApplicationCommands.Copy}" ToolTip="Copy (Ctrl + C)" Width="24" Height="24" Padding="0"
                        ContentTemplate="{StaticResource CopyButtonTemplate}" />
                <Button Command="{x:Static ApplicationCommands.Paste}" ToolTip="Paste (Ctrl + V)" Width="24" Height="24" Padding="0"
                        ContentTemplate="{StaticResource PasteButtonTemplate}" />

                <Button Command="{x:Static ApplicationCommands.Undo}" ToolTip="Undo (Ctrl + Z)" Width="24" Height="24" Margin="10,0,0,0" Padding="0"
                        ContentTemplate="{StaticResource UndoButtonTemplate}" />
                <Button Command="{x:Static ApplicationCommands.Redo}" ToolTip="Redo (Ctrl + Y)" Width="24" Height="24" Padding="0"
                        ContentTemplate="{StaticResource RedoButtonTemplate}" />

              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FontSelectorDisplayMode" Value="Plain">
              <Setter TargetName="FontSelector" Property="ItemTemplate" Value="{StaticResource PlainFontFamilyItemTemplate}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
