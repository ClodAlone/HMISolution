  <local:ListToSubListConverter x:Key="Accent2SubList" StartIndex="35" Length="5" />
  <local:ListToSubListConverter x:Key="Accent3SubList" StartIndex="40" Length="5" />
  <local:ListToSubListConverter x:Key="Accent4SubList" StartIndex="45" Length="5" />
