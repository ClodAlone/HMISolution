          ]]>
        </local:IfFullTrust>
      </Setter.Value>
    </Setter>
  </Style>

  <SolidColorBrush x:Key="Border" Color="#4887B6" />
  <SolidColorBrush x:Key="HighlightedMenuItemBackground" Color="#E4F1F7" />
  <SolidColorBrush x:Key="HighlightedMenuItemBorder" Color="#B0E0F3" />
  <SolidColorBrush x:Key="MenuItemLeftMarginBackground" Color="#F1F1F1" />
  <SolidColorBrush x:Key="MenuBackground" Color="#F5F5F5" />
  <SolidColorBrush x:Key="EditorBackground" Color="White" />
  <SolidColorBrush x:Key="Foreground" Color="Black" />
  
