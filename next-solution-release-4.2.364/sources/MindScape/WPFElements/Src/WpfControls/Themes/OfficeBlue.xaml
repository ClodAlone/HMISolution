<ResourceDictionary x:Class="Mindscape.WpfElements.Themes.OfficeBlue"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Mindscape.WpfElements">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.PropertyGrid.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.RichTextToolBar.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.Scheduler.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.DateTimeControls.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.DataGrid.xaml" />
	<ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.Ribbon.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <SolidColorBrush x:Key="{x:Static local:FilteringTextBoxBase.BorderBrushKey}" Color="#6392CE" />
  
  <!-- ======================= -->
  <!--   MaskedTextBox style   -->
  <!-- ======================= -->

  <Style x:Key="{x:Type RichTextBox}" TargetType="{x:Type RichTextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RichTextBox}">
          <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style TargetType="{x:Type local:MaskedTextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:MaskedTextBox}">
          <RichTextBox Name="PART_RichTextBox" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}"
                       HorizontalScrollBarVisibility="Disabled" AcceptsReturn="False" AutoWordSelection="False" Padding="{TemplateBinding Padding}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- ========================= -->
  <!--   CurrencyTextBox style   -->
  <!-- ========================= -->
  
  <local:SignConverter x:Key="SignConverter" />

  <Style x:Key="{x:Type local:CurrencyTextBox}" TargetType="{x:Type local:CurrencyTextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CurrencyTextBox}">
          <TextBox Name="PART_TextBox" IsReadOnly="{TemplateBinding IsReadOnly}" TextAlignment="{TemplateBinding TextAlignment}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   Background="{TemplateBinding Background}"
                   Foreground="{TemplateBinding Foreground}"
                   BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource SignConverter}}" Value="{x:Static local:Sign.Negative}">
              <Setter TargetName="PART_TextBox" Property="Style" Value="{Binding NegativeStyle, RelativeSource={RelativeSource AncestorType={x:Type local:CurrencyTextBox}}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type local:PercentageTextBox}" TargetType="{x:Type local:PercentageTextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:PercentageTextBox}">
          <TextBox Name="PART_TextBox" IsReadOnly="{TemplateBinding IsReadOnly}" TextAlignment="{TemplateBinding TextAlignment}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   Background="{TemplateBinding Background}"
                   Foreground="{TemplateBinding Foreground}"
                   BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================= -->
  <!--   AutoCompleteBox style   -->
  <!-- ========================= -->

  <local:InputSuggestionToContentConverter x:Key="SuggestionContentConverter" />

  <DataTemplate x:Key="SuggestionTemplate">
    <ContentPresenter Content="{Binding Converter={StaticResource SuggestionContentConverter}}" />
  </DataTemplate>

  <Style x:Key="{x:Type local:AutoCompleteBox}" TargetType="{x:Type local:AutoCompleteBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AutoCompleteBox}">
          <Grid>
            <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer Name="PART_ContentHost" />
            </Border>
            <Popup Name="Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True">
              <Grid Name="PopupGrid">
                <Border MinWidth="{Binding ActualWidth, ElementName=Border}" Height="200" Style="{StaticResource ShadowStyle}">
                  <ListBox Name="PART_ListBox" ItemsSource="{TemplateBinding MatchingSuggestions}" ItemTemplate="{StaticResource SuggestionTemplate}" />
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
              <Setter Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="PopupGrid" Property="Margin" Value="0,0,20,20" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================= -->
  <!--   MulticolumnTreeView style   -->
  <!-- ============================= -->

  <Style x:Key="{x:Static local:MulticolumnTreeView.ExpandCollapseToggleStyleKey}" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <Path Name="Path" Data="M 6 0 L 6 6 L 0 6 Z" Fill="{StaticResource TreeViewArrowBrush}" Stroke="{StaticResource TreeViewArrowBrush}"
                  StrokeThickness="1" Margin="5,0,0,0">
              <Path.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="0" CenterX="2" CenterY="7" />
              </Path.RenderTransform>
            </Path>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Path" Property="Fill" Value="White" />
              <Trigger.EnterActions>
                <BeginStoryboard HandoffBehavior="Compose">
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" From="0" To="-45" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard HandoffBehavior="Compose">
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" From="-45" To="0" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Path" Property="Fill" Value="{StaticResource MouseOverTreeViewArrowBrush}" />
              <Setter TargetName="Path" Property="Stroke" Value="{StaticResource MouseOverTreeViewArrowBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:MulticolumnTreeViewIndentConverter x:Key="LevelToIndentConverter" Indent="14" />

  <DataTemplate x:Key="{x:Static local:MulticolumnTreeView.ExpandingCellTemplateKey}">
    <DockPanel>
      <ToggleButton Name="Expander" Style="{StaticResource {x:Static local:MulticolumnTreeView.ExpandCollapseToggleStyleKey}}"
                    Margin="{Binding Level, Converter={StaticResource LevelToIndentConverter}, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}"
                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}"
                    ClickMode="Press" VerticalAlignment="Center" />
      <ContentPresenter ContentTemplate="{Binding Columns[0].OriginalCellTemplate, RelativeSource={RelativeSource AncestorType={x:Type GridViewRowPresenter}}}"
                        ContentTemplateSelector="{Binding Columns[0].OriginalCellTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type GridViewRowPresenter}}}"
                        VerticalAlignment="Center" Margin="5,0,0,0" />
    </DockPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=HasItems,RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeViewItem}}}" Value="False">
        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <Style TargetType="local:MulticolumnTreeViewItem">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Padding" Value="0,3,0,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:MulticolumnTreeViewItem">
          <StackPanel>
            <Grid>
              <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" />
              <GridViewRowPresenter Name="PART_Header" Content="{TemplateBinding Header}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                    Columns="{Binding WrappedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:MulticolumnTreeView}}}" />
            </Grid>
            <ItemsPresenter Name="ItemsHost">
              <ItemsPresenter.LayoutTransform>
                <ScaleTransform x:Name="Scale" ScaleY="0" />
              </ItemsPresenter.LayoutTransform>
            </ItemsPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard HandoffBehavior="Compose">
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard HandoffBehavior="Compose">
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" From="1" To="0" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Width" Value="Auto" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Height" Value="Auto" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
            <Trigger SourceName="Border" Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverListBoxItemBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverListBoxItemBorder}" />
            </Trigger>
            <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverListBoxItemBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverListBoxItemBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedListBoxItemBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SelectedListBoxItemBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="{x:Static local:MulticolumnTreeView.ScrollViewerStyleKey}" TargetType="ScrollViewer">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Padding="0">
              <GridViewHeaderRowPresenter Columns="{Binding TemplatedParent.WrappedColumns, RelativeSource={RelativeSource TemplatedParent}}"
                                          ColumnHeaderContainerStyle="{Binding TemplatedParent.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ColumnHeaderTemplate="{Binding TemplatedParent.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ColumnHeaderTemplateSelector="{Binding TemplatedParent.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ColumnHeaderContextMenu="{Binding TemplatedParent.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}" 
                                          AllowsColumnReorder="{Binding TemplatedParent.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}" />
            </ScrollViewer>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,1" Background="{StaticResource Border}" Grid.Column="1"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
              <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{StaticResource ButtonBackground}" />
            </Border>
            <ScrollContentPresenter Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local" Grid.Row="1"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="2" Height="19" BorderThickness="0,1,0,0"
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Template="{StaticResource HorizontalScrollBarTemplate}"
                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Column="1" Grid.Row="1" Width="19" BorderThickness="1,0,0,0"
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Template="{StaticResource VerticalScrollBarTemplate}"
                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            <Border Grid.Column="1" Grid.Row="2" Background="{StaticResource ScrollBarBackground}" />
            <Rectangle Grid.Column="2" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{StaticResource Border}" Width="1" Height="1"
                       Name="CornerDot" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ComputedHorizontalScrollBarVisibility" Value="Visible" />
                <Condition Property="ComputedVerticalScrollBarVisibility" Value="Visible" />
              </MultiTrigger.Conditions>
              <Setter TargetName="CornerDot" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GridViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="GridViewColumnHeader">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border BorderThickness="0,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding BorderBrush}">
              <Border Name="InnerBorder" BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="HeaderContent" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </Border>
            <Thumb Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-9,0" Style="{StaticResource GridViewColumnHeaderGripper}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverInnerBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource PressedButtonBackground}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedInnerBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Role" Value="Floating">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Canvas Name="PART_FloatingHeaderCanvas" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Role" Value="Padding">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Border BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding BorderBrush}">
                <Border BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{TemplateBinding Background}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="local:MulticolumnTreeView">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="ExpandingDecorator" Value="{StaticResource {x:Static local:MulticolumnTreeView.ExpandingCellTemplateKey}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:MulticolumnTreeView">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <ScrollViewer Style="{StaticResource {x:Static local:MulticolumnTreeView.ScrollViewerStyleKey}}" Padding="0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- ========================= -->
  <!--   DualProgressBar style   -->
  <!-- ========================= -->
  
  <local:ArithmeticConverter x:Key="HalfConverter" Multiplier="0.5" />
  
  <LinearGradientBrush x:Key="HorizontalProgressBarNestedIndicatorBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#CDFFCD" />
    <GradientStop Offset="0.5" Color="#9CEDAC" />
    <GradientStop Offset="0.5" Color="#00B823" />
    <GradientStop Offset="1" Color="#1CE133" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="VerticalProgressBarNestedIndicatorBackground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#CDFFCD" />
    <GradientStop Offset="0.5" Color="#9CEDAC" />
    <GradientStop Offset="0.5" Color="#00B823" />
    <GradientStop Offset="1" Color="#1CE133" />
  </LinearGradientBrush>
  
  <ControlTemplate x:Key="HorizontalDualProgressBarTemplate" TargetType="{x:Type local:DualProgressBar}">
    <Grid>
      <Border Background="{StaticResource HorizontalProgressBarBackground}" Margin="1" BorderThickness="1" BorderBrush="{StaticResource ProgressBarInnerBorder}" CornerRadius="3" />
      <Grid Name="IndicatorGrid">
        <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource HorizontalProgressBarIndicatorBackground}"
                CornerRadius="3" />
        <Border Name="PART_NestedIndicator" HorizontalAlignment="Left" Background="{StaticResource HorizontalProgressBarNestedIndicatorBackground}"
                Height="{Binding Height, Converter={StaticResource HalfConverter}, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" />
      </Grid>
      <Grid Name="LabelGrid">
        <ContentPresenter Content="{Binding StartContent, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left"
                          VerticalAlignment="Center" Margin="5,0,0,0" />
        <ContentPresenter Content="{Binding CenterContent, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        <ContentPresenter Content="{Binding EndContent, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
      </Grid>
      <Border Name="IndeterminateBorder" Opacity="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="-0.5" Color="Transparent" />
            <GradientStop Offset="-0.3" Color="#77ABF1" />
            <GradientStop Offset="-0.1" Color="Transparent" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Name="PART_Track" BorderBrush="{StaticResource HorizontalProgressBarBorder}" BorderThickness="1" CornerRadius="3" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsIndeterminate" Value="True">
        <Setter TargetName="IndicatorGrid" Property="Opacity" Value="0" />
        <Setter TargetName="LabelGrid" Property="Opacity" Value="0" />
        <Setter TargetName="IndeterminateBorder" Property="Opacity" Value="1" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Offset)" To="1.1"
                             Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Offset)" To="1.3"
                             Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Offset)" To="1.5"
                             Duration="0:0:2" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[0].Offset" To="-0.5" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[1].Offset" To="-0.3" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[2].Offset" To="-0.1" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  
  <ControlTemplate x:Key="VerticalDualProgressBarTemplate" TargetType="{x:Type local:DualProgressBar}">
    <Grid>
      <Border Background="{StaticResource VerticalProgressBarBackground}" Margin="1" BorderThickness="1" BorderBrush="{StaticResource ProgressBarInnerBorder}" CornerRadius="3" />
      <Grid Name="IndicatorGrid">
        <Border Name="PART_Indicator" VerticalAlignment="Bottom" Background="{StaticResource VerticalProgressBarIndicatorBackground}"
                CornerRadius="3" />
        <Border Name="PART_NestedIndicator" VerticalAlignment="Bottom" Background="{StaticResource VerticalProgressBarNestedIndicatorBackground}"
                Width="{Binding Width, Converter={StaticResource HalfConverter}, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" />
      </Grid>
      <Grid Name="LabelGrid">
        <ContentPresenter Content="{Binding StartContent, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Bottom"
                          HorizontalAlignment="Center" Margin="0,0,0,5" />
        <ContentPresenter Content="{Binding CenterContent, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
        <ContentPresenter Content="{Binding EndContent, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="top"
                          HorizontalAlignment="Center" Margin="0,5,0,0" />
      </Grid>
      <Border Name="IndeterminateBorder" Opacity="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="1.5" Color="Transparent" />
            <GradientStop Offset="1.3" Color="#77ABF1" />
            <GradientStop Offset="1.1" Color="Transparent" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Name="PART_Track" BorderBrush="{StaticResource VerticalProgressBarBorder}" BorderThickness="1" CornerRadius="3" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsIndeterminate" Value="True">
        <Setter TargetName="IndicatorGrid" Property="Opacity" Value="0" />
        <Setter TargetName="LabelGrid" Property="Opacity" Value="0" />
        <Setter TargetName="IndeterminateBorder" Property="Opacity" Value="1" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Offset)" To="-0.1"
                             Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Offset)" To="-0.3"
                             Duration="0:0:2" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Offset)" To="-0.5"
                             Duration="0:0:2" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[0].Offset" To="1.5" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[1].Offset" To="1.3" />
              <DoubleAnimation Duration="0:0:0.000" Storyboard.TargetName="IndeterminateBorder" Storyboard.TargetProperty="Background.GradientStops[2].Offset" To="1.1" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  
  <Style x:Key="{x:Type local:DualProgressBar}" TargetType="{x:Type local:DualProgressBar}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource VerticalDualProgressBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource HorizontalDualProgressBarTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  
  <!-- ===================== -->
  <!--   SplitButton style   -->
  <!-- ===================== -->

  <SolidColorBrush x:Key="DisabledSplitButtonBorder" Color="#ADB2B5" />
  <SolidColorBrush x:Key="DisabledSplitButtonBackground" Color="#F4F4F4" />
  <SolidColorBrush x:Key="DisabledSplitButtonForeground" Color="#ADADAD" />
  <SolidColorBrush x:Key="DisabledSplitButtonInnerBorder" Color="#FFFFFF" />
  
  <LinearGradientBrush x:Key="OpenSplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E3EFFE" Offset="0" />
    <GradientStop Color="#83B0EC" Offset="1" />
  </LinearGradientBrush>
  
  <ControlTemplate x:Key="SplitButtonToggleTemplate" TargetType="ToggleButton">
    <Grid SnapsToDevicePixels="True">
      <Border Background="Transparent">
        <Path Fill="{TemplateBinding Foreground}" Data="M 0 0 L 8 0 L 4 4 Z" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Border>
    </Grid>
  </ControlTemplate>
  
  <Style x:Key="{x:Type local:SplitButton}" TargetType="{x:Type local:SplitButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SplitButton}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Menu Width="10" VerticalAlignment="Bottom" HorizontalAlignment="Left">
              <MenuItem IsSubmenuOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        ItemsSource="{Binding DropDownItems, RelativeSource={RelativeSource TemplatedParent}}"
                        Width="10" Margin="-2,0,0,-1" />
            </Menu>
            <Border Grid.Column="1" HorizontalAlignment="Right" Width="5" Name="Shadow" Background="{StaticResource MenuBackground}"
                    Visibility="Collapsed" Style="{StaticResource ShadowStyle}" />
            <Border Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2">
              <Border Name="InnerBorder" BorderThickness="1" BorderBrush="{StaticResource InnerBorder}" Background="{TemplateBinding Background}" />
            </Border>
            <Border Name="Separator" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,0,0" Grid.Column="1" Margin="0,3,0,3" />
            <Border Name="PressedBorder" Margin="1,1,0,1" Opacity="0" Background="{StaticResource PressedButtonBackground}" />
            <Border Name="OpenBorder" Background="{StaticResource OpenSplitButtonBackground}" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                    Visibility="{Binding IsDropDownOpen, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Margin="{TemplateBinding Padding}" />
            <ToggleButton Name="PART_ToggleButton" Grid.Column="1" Template="{StaticResource SplitButtonToggleTemplate}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverInnerBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
              <Setter TargetName="Separator" Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBorder" Property="Opacity" Value="1" />
              <Setter TargetName="Separator" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
            </Trigger>
			<Trigger Property="IsEnabled" Value="False">
			  <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource DisabledSplitButtonInnerBorder}" />
			  <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource DisabledSplitButtonBackground}" />
			  <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledSplitButtonBorder}" />
			  <Setter TargetName="Separator" Property="BorderBrush" Value="{StaticResource DisabledSplitButtonForeground}" />
			  <Setter TargetName="PART_ToggleButton" Property="Foreground" Value="{StaticResource DisabledSplitButtonForeground}" />
			  <Setter Property="Foreground" Value="{StaticResource DisabledSplitButtonForeground}" />
			</Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- ==================== -->
  <!--   DualSlider style   -->
  <!-- ==================== -->
  
  <ControlTemplate x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
    <Border Background="Transparent" />
  </ControlTemplate>
  
  <DataTemplate x:Key="HorizontalTickTemplate">
    <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Border}" Height="5" MinWidth="1" Width="{Binding}"
            HorizontalAlignment="Left" SnapsToDevicePixels="True" />
  </DataTemplate>
  
  <DataTemplate x:Key="VerticalTickTemplate">
    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}" Width="5" MinHeight="1" Height="{Binding}"
            VerticalAlignment="Bottom" SnapsToDevicePixels="True" />
  </DataTemplate>
  
  <Style x:Key="GridItemsControlStyle" TargetType="ItemsControl">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <ControlTemplate x:Key="HorizontalDualSliderTemplate" TargetType="{x:Type local:DualSlider}">
    <StackPanel>
	  <ItemsControl Name="PART_TopLeftLabelHost" Style="{StaticResource GridItemsControlStyle}" Margin="8,0,8,0"
                    Visibility="{TemplateBinding ShowTopLeftLabels, Converter={StaticResource bvc}}" />
      <ItemsControl ItemsSource="{TemplateBinding TickPositions}" Visibility="{TemplateBinding ShowTopLeftTickMarks, Converter={StaticResource bvc}}"
                    Style="{StaticResource GridItemsControlStyle}" Margin="8,0,8,0" ItemTemplate="{StaticResource HorizontalTickTemplate}" />
      <Grid>
        <Border Height="4" Background="{StaticResource SliderTrackBackground}"
                BorderThickness="1" BorderBrush="{StaticResource HorizontalSliderTrackBorder}" CornerRadius="2" Margin="8,0,8,0" />
        <RepeatButton Name="PART_LargeDecreaseButton" HorizontalAlignment="Left" Height="9" Template="{StaticResource InvisibleRepeatButton}" />
        <RepeatButton Name="PART_LargeIncreaseButton" HorizontalAlignment="Left" Height="9" Template="{StaticResource InvisibleRepeatButton}" />
        <Thumb Name="PART_RangeThumb" Style="{StaticResource SliderThumbStyle}" Height="6" HorizontalAlignment="Left" BorderThickness="0,1,0,1" />
        <Thumb Name="PART_StartThumb" Style="{StaticResource SliderThumbStyle}" HorizontalAlignment="Left" Width="9" Height="18" Margin="-8,0,8,0" />
        <Thumb Name="PART_EndThumb" Style="{StaticResource SliderThumbStyle}" HorizontalAlignment="Left" Width="9" Height="18" />
      </Grid>
      <ItemsControl ItemsSource="{TemplateBinding TickPositions}" Visibility="{TemplateBinding ShowBottomRightTickMarks, Converter={StaticResource bvc}}"
                    Style="{StaticResource GridItemsControlStyle}" Margin="8,0,8,0" ItemTemplate="{StaticResource HorizontalTickTemplate}" />
	  <ItemsControl Name="PART_BottomRightLabelHost" Style="{StaticResource GridItemsControlStyle}" Margin="8,0,8,0"
                    Visibility="{TemplateBinding ShowBottomRightLabels, Converter={StaticResource bvc}}" />
    </StackPanel>
  </ControlTemplate>
  
  <ControlTemplate x:Key="VerticalDualSliderTemplate" TargetType="{x:Type local:DualSlider}">
    <StackPanel Orientation="Horizontal">
	  <ItemsControl Name="PART_TopLeftLabelHost" Style="{StaticResource GridItemsControlStyle}" Margin="0,8,0,8"
                    Visibility="{TemplateBinding ShowTopLeftLabels, Converter={StaticResource bvc}}" />
      <ItemsControl ItemsSource="{TemplateBinding TickPositions}" Visibility="{TemplateBinding ShowTopLeftTickMarks, Converter={StaticResource bvc}}"
                    Style="{StaticResource GridItemsControlStyle}" Margin="0,8,0,8" ItemTemplate="{StaticResource VerticalTickTemplate}" />
      <Grid>
        <Border Width="4" Background="{StaticResource SliderTrackBackground}"
                BorderThickness="1" BorderBrush="{StaticResource VerticalSliderTrackBorder}" CornerRadius="2" Margin="0,7,0,7" />
        <RepeatButton Name="PART_LargeDecreaseButton" VerticalAlignment="Bottom" Width="9" Template="{StaticResource InvisibleRepeatButton}" />
        <RepeatButton Name="PART_LargeIncreaseButton" VerticalAlignment="Bottom" Width="9" Template="{StaticResource InvisibleRepeatButton}" />
        <Thumb Name="PART_RangeThumb" Style="{StaticResource SliderThumbStyle}" Width="6" VerticalAlignment="Bottom" BorderThickness="1,0,1,0" />
        <Thumb Name="PART_StartThumb" Style="{StaticResource SliderThumbStyle}" VerticalAlignment="Bottom" Width="18" Height="9" Margin="0,8,0,-8" />
        <Thumb Name="PART_EndThumb" Style="{StaticResource SliderThumbStyle}" VerticalAlignment="Bottom" Width="18" Height="9" />
      </Grid>
      <ItemsControl ItemsSource="{TemplateBinding TickPositions}" Visibility="{TemplateBinding ShowBottomRightTickMarks, Converter={StaticResource bvc}}"
                    Style="{StaticResource GridItemsControlStyle}" Margin="0,8,0,8" ItemTemplate="{StaticResource VerticalTickTemplate}" />
	  <ItemsControl Name="PART_BottomRightLabelHost" Style="{StaticResource GridItemsControlStyle}" Margin="0,8,0,8"
                    Visibility="{TemplateBinding ShowBottomRightLabels, Converter={StaticResource bvc}}" />
    </StackPanel>
  </ControlTemplate>
  
  <Style x:Key="{x:Type local:DualSlider}" TargetType="{x:Type local:DualSlider}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="EndBuffer" Value="8" />
    <Setter Property="Template" Value="{StaticResource HorizontalDualSliderTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource VerticalDualSliderTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  
  <!-- ==================== -->
  <!--   OutlookBar style   -->
  <!-- ==================== -->
  
  <LinearGradientBrush x:Key="OutlookBarThumbBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E3EFFF" />
    <GradientStop Offset="1" Color="#B6D6FF" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="OutlookBarThumbLightBrush" Color="#F9F9FB" />
  <SolidColorBrush x:Key="OutlookBarThumbInnerBrush" Color="#ADD1FF" />
  <SolidColorBrush x:Key="OutlookBarForeground" Color="#204D89" />
  
  <Style x:Key="OutlookBarButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1,0,1,1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource OutlookBarForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Border Name="InnerBorder"  Background="{TemplateBinding Background}" BorderBrush="{StaticResource InnerBorder}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
              <Setter Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverInnerBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource PressedButtonBackground}" />
              <Setter Property="BorderBrush" Value="{StaticResource PressedBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedInnerBorder}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="{StaticResource CheckedButtonBackground}" />
              <Setter Property="BorderBrush" Value="{StaticResource PressedBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedInnerBorder}" />
              <Setter Property="Foreground" Value="Black" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter Property="Background" Value="{StaticResource MouseOverCheckedButtonBackground}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource DisabledBackground}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource DisabledInnerBorder}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="CollapsedOutlookBarButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Border" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource PressedButtonBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="{StaticResource CheckedButtonBackground}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter Property="Background" Value="{StaticResource MouseOverCheckedButtonBackground}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="OutlookBarThumbStyle" TargetType="Thumb">
    <Setter Property="Template" >
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Height="8">
            <Border Background="{StaticResource OutlookBarThumbBackground}" BorderBrush="White" BorderThickness="0,1,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" >
                <Border Background="{StaticResource Border}" Width="2" Height="2">
                  <Border Background="{StaticResource OutlookBarThumbLightBrush}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerBrush}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource Border}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightBrush}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerBrush}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource Border}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightBrush}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerBrush}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource Border}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightBrush}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerBrush}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
                <Border Background="{StaticResource Border}" Width="2" Height="2" Margin="2,0,0,0">
                  <Border Background="{StaticResource OutlookBarThumbLightBrush}" Width="2" Height="2" Margin="1,1,-1,-1">
                    <Border Background="{StaticResource OutlookBarThumbInnerBrush}" Width="1" Height="1" Margin="0,0,1,1" />
                  </Border>
                </Border>
              </StackPanel>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <DataTemplate x:Key="OutlookBarItemTemplate">
    <ToggleButton Style="{StaticResource OutlookBarButtonStyle}" Content="{Binding Header}"
	              ContentTemplate="{Binding HeaderTemplate}" ContentTemplateSelector="{Binding HeaderTemplateSelector}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding Visibility}" />
  </DataTemplate>
  
  <DataTemplate x:Key="CollapsedOutlookBarItemTemplate">
    <ToggleButton Style="{StaticResource CollapsedOutlookBarButtonStyle}" Content="{Binding CollapsedHeader}"
	              ContentTemplate="{Binding CollapsedHeaderTemplate}" ContentTemplateSelector="{Binding CollapsedHeaderTemplateSelector}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding Visibility}" />
  </DataTemplate>
  
  <Style x:Key="{x:Type local:OutlookBar}" TargetType="{x:Type local:OutlookBar}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:OutlookBar}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0">
              <ContentPresenter Name="PART_ContentHost" />
            </Border>
            <Thumb Grid.Row="1" Name="PART_Thumb" Style="{StaticResource OutlookBarThumbStyle}" Cursor="SizeNS" />
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" ItemTemplate="{StaticResource OutlookBarItemTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <local:CountLimitedPanel Name="PART_ExpandedItemsPanel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Grid.Row="3" MinHeight="25" Background="{StaticResource ButtonBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,1,1">
              <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" ItemTemplate="{StaticResource CollapsedOutlookBarItemTemplate}"
                            HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:SizeLimitedPanel Name="PART_CollapsedItemsPanel" Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- ===================== -->
  <!--   RadialGauge style   -->
  <!-- ===================== -->

  <LinearGradientBrush x:Key="RadialGaugeBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#6392CE" />
    <GradientStop Offset="0.6" Color="#6392CE" />
    <GradientStop Offset="1" Color="#ADD3FF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ShineBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#77FFFFFF" />
    <GradientStop Offset="1" Color="#11EEEEEE" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RadialGaugeBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FBFBFB" />
    <GradientStop Offset="1" Color="#363636" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RadialGaugeInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#363636" />
    <GradientStop Offset="1" Color="#FBFBFB" />
  </LinearGradientBrush>

  <Style x:Key="RadialGaugeMajorTickMarkStyle" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Background" Value="White" />
  </Style>
  
  <Style x:Key="{x:Type local:RadialGauge}" TargetType="{x:Type local:RadialGauge}">
    <Setter Property="MajorTickMarkStyle" Value="{StaticResource RadialGaugeMajorTickMarkStyle}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:AnimatedValueDisplay">
          <Grid Width="{Binding Size, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding Size, RelativeSource={RelativeSource TemplatedParent}}">
            <Ellipse Fill="{StaticResource RadialGaugeBorder}" />
            <Ellipse Fill="#999999" Margin="4" />
            <Ellipse Fill="{StaticResource RadialGaugeInnerBorder}" Margin="7" />
            <Ellipse Fill="{StaticResource RadialGaugeBackground}" Margin="10" />
            <Grid>
              <Path Name="PART_Arc" Stroke="White" StrokeThickness="6" />
              <ItemsControl Name="PART_LabelsHost" Style="{StaticResource GridItemsControlStyle}" />
              <ItemsControl Name="PART_TickMarksHost" Style="{StaticResource GridItemsControlStyle}" />
              <Grid Margin="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Path Name="PART_Needle" Data="M 0.5 0 L 1 1 L 0 1 Z" Fill="#C21218" Width="6" Stretch="Fill" />
              </Grid>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="5.5*" />
                  <RowDefinition Height="4.5*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.5*" />
                  <ColumnDefinition Width="7*" />
                  <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <Ellipse Margin="0,13,0,0" Fill="{StaticResource ShineBackground}" Grid.Column="1" />
              </Grid>
              <Ellipse Width="20" Height="20" Fill="#C21218" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
</ResourceDictionary>