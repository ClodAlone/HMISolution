<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:local="clr-namespace:Mindscape.WpfElements"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/AlloyLight.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
  ==================================================================================================================================================================
                                                                           RichTextToolBar styles
  ==================================================================================================================================================================
  -->

  <local:BrushToColorConverter x:Key="BrushToColor" />

  <FontWeight x:Key="Bold">Bold</FontWeight>
  <FontStyle x:Key="Italic">Italic</FontStyle>
  <TextDecoration x:Key="Underline" Location="Underline" />

  <TextAlignment x:Key="Left">Left</TextAlignment>
  <TextAlignment x:Key="Right">Right</TextAlignment>
  <TextAlignment x:Key="Center">Center</TextAlignment>
  <TextAlignment x:Key="Justify">Justify</TextAlignment>

  <local:ObjectToBooleanConverter x:Key="FontWeightToBoolConverter" Object="{StaticResource Bold}" />
  <local:ObjectToBooleanConverter x:Key="FontStyleToBoolConverter" Object="{StaticResource Italic}" />
  <local:ListToBooleanConverter x:Key="UnderlineToBoolConverter" Object="{StaticResource Underline}" />
  <local:ObjectToBooleanConverter x:Key="LeftAlignToBoolConverter" Object="{StaticResource Left}" />
  <local:ObjectToBooleanConverter x:Key="RightAlignToBoolConverter" Object="{StaticResource Right}" />
  <local:ObjectToBooleanConverter x:Key="CenterAlignToBoolConverter" Object="{StaticResource Center}" />
  <local:ObjectToBooleanConverter x:Key="JustifyAlignToBoolConverter" Object="{StaticResource Justify}" />

  <SolidColorBrush x:Key="ToolBarFontColor" Color="Black" />

  <SolidColorBrush x:Key="RichMouseOverButtonBackground" Color="#B6B6B6" />
  <SolidColorBrush x:Key="RichMousePressedButtonBackground" Color="#888888" />
  <SolidColorBrush x:Key="RichSelectedButtonBackground" Color="#888888" />

  <SolidColorBrush x:Key="PopupBorder" Color="#868686" />

  <!-- ********** Button Styles ********** -->

  <Style x:Key="RichToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichMouseOverButtonBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichSelectedButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RichButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Background" Value="#BFBFBF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#939393" CornerRadius="4" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="DisabledBorder" Background="#559C9C9C" Opacity="0" CornerRadius="4" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichMouseOverButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichMousePressedButtonBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Background" Value="Transparent" />
              <Setter TargetName="DisabledBorder" Property="Opacity" Value="1" />
              <Setter TargetName="Border" Property="BorderBrush" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ********** Button Templates ********** -->

  <DataTemplate x:Key="BoldButtonTemplate">
    <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource ToolBarFontColor}"
               FontFamily="Palatino Linotype">B</TextBlock>
  </DataTemplate>

  <DataTemplate x:Key="ItalicButtonTemplate">
    <TextBlock FontWeight="Bold" FontStyle="Italic" FontSize="14" Foreground="{StaticResource ToolBarFontColor}"
                FontFamily="Palatino Linotype">I</TextBlock>
  </DataTemplate>

  <DataTemplate x:Key="UnderlineButtonTemplate">
    <TextBlock FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" TextDecorations="Underline"
               Foreground="{StaticResource ToolBarFontColor}" FontFamily="Palatino Linotype">U</TextBlock>
  </DataTemplate>

  <DataTemplate x:Key="LeftAlignmentButtonTemplate">
    <Border SnapsToDevicePixels="True">
      <StackPanel>
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Left" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Left" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Left" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Left" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Left" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="CenterAlignmentButtonTemplate">
    <Border SnapsToDevicePixels="True">
      <StackPanel>
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="RightAlignmentButtonTemplate">
    <Border SnapsToDevicePixels="True">
      <StackPanel>
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="8" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="JustifyAlignmentButtonTemplate">
    <Border SnapsToDevicePixels="True">
      <StackPanel>
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
        <Border Width="12" Height="1" Background="Transparent" />
        <Border Width="12" Height="1" Background="{StaticResource ToolBarFontColor}" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="CutButtonTemplate">
    <Image Source="/Mindscape.WpfElements;component/Images/Cut.png" Width="19" Height="19" />
  </DataTemplate>

  <DataTemplate x:Key="CopyButtonTemplate">
    <Image Source="/Mindscape.WpfElements;component/Images/Copy.png" Width="22" Height="23" />
  </DataTemplate>

  <DataTemplate x:Key="PasteButtonTemplate">
    <Image Source="/Mindscape.WpfElements;component/Images/Paste.png" Width="23" Height="22" />
  </DataTemplate>

  <DataTemplate x:Key="UndoButtonTemplate">
    <Image Source="/Mindscape.WpfElements;component/Images/Undo.png" Width="22" Height="22" />
  </DataTemplate>

  <DataTemplate x:Key="RedoButtonTemplate">
    <Image Source="/Mindscape.WpfElements;component/Images/Redo.png" Width="22" Height="22" />
  </DataTemplate>

  <!-- ********** DropDownColorPicker styles **********-->

  <SolidColorBrush x:Key="RichButtonBackground" Color="#BFBFBF" />

  <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Background="Transparent" CornerRadius="4" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichMouseOverButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichMousePressedButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColorPickerToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Name="Border" Width="13" Background="Transparent" CornerRadius="4">
            <Path Style="{StaticResource DropDownArrowStyle}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverDropDownButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColorPickerDropDownEditBoxStyle" TargetType="{x:Type local:DropDownEditBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DropDownEditBox}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Name="Border" Background="{StaticResource RichButtonBackground}" Grid.ColumnSpan="2" CornerRadius="4" />
            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Name="ToggleButton"
                          Grid.Column="1" Style="{StaticResource ColorPickerToggleButtonStyle}" />
            <ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" />
            <Popup AllowsTransparency="True" Placement="Bottom" Focusable="False" Name="Popup" PopupAnimation="Slide" VerticalOffset="0"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Grid Name="PopupGrid">
                <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}"
                        Style="{StaticResource ShadowStyle}">
                  <ContentPresenter ContentTemplate="{TemplateBinding DropDownTemplate}" />
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="PopupGrid" Property="Margin" Value="0,0,20,20" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Foreground color picker -->

  <DataTemplate x:Key="ForegroundColorButtonTemplate">
    <Button Style="{StaticResource ColorPickerButtonStyle}" Command="{x:Static local:RichTextCommands.ApplyForegroundColor}">
      <Border Width="28" Height="20">
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="14" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1">A</TextBlock>
          <Border Width="18" Height="4" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}" Margin="0,-3,0,3" SnapsToDevicePixels="True" />
        </StackPanel>
      </Border>
    </Button>
  </DataTemplate>

  <DataTemplate x:Key="ForegroundColorPickerDropDownTemplate">
    <Border Background="White" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}">
      <StackPanel>
        <local:ColorButton SelectedColor="{Binding SelectedColor}" Color="Black" Content="Automatic" />
        <local:ColorPicker SelectedColor="{Binding SelectedColor}" BorderThickness="0" />
        <local:MoreColorsButton CurrentColor="{Binding SelectedColor}" BorderThickness="0,1,0,0" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <Style x:Key="ForegroundColorPickerStyle" TargetType="local:DropDownColorPicker">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="DropDownTemplate" Value="{StaticResource ForegroundColorPickerDropDownTemplate}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource ForegroundColorButtonTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:DropDownColorPicker">
          <local:DropDownEditBox Style="{StaticResource ColorPickerDropDownEditBoxStyle}" HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                 DropDownTemplate="{TemplateBinding DropDownTemplate}" Content="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                 IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Background color picker -->

  <DataTemplate x:Key="BackgroundColorButtonTemplate">
    <Button Style="{StaticResource ColorPickerButtonStyle}" Command="{x:Static local:RichTextCommands.ApplyBackgroundColor}">
      <Border Width="28" Height="20">
        <StackPanel Margin="0,1,0,1">
          <Image Source="/Mindscape.WpfElements;component/Images/BackgroundPaint.png" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
          <Border Width="18" Height="4" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}" Margin="0,-4,0,4" />
        </StackPanel>
      </Border>
    </Button>
  </DataTemplate>

  <DataTemplate x:Key="BackgroundColorPickerDropDownTemplate">
    <Border Background="White" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}">
      <StackPanel>
        <local:ColorButton SelectedColor="{Binding SelectedColor}" Color="White" Content="Automatic" />
        <local:ColorPicker SelectedColor="{Binding SelectedColor}" BorderThickness="0" />
        <local:MoreColorsButton CurrentColor="{Binding SelectedColor}" BorderThickness="0,1,0,0" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <Style x:Key="BackgroundColorPickerStyle" TargetType="local:DropDownColorPicker" BasedOn="{StaticResource ForegroundColorPickerStyle}">
    <Setter Property="DropDownTemplate" Value="{StaticResource BackgroundColorPickerDropDownTemplate}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource BackgroundColorButtonTemplate}" />
  </Style>

  <!-- ********** Font ComboBox Styles ********** -->

  <SolidColorBrush x:Key="RichMouseOverComboBoxItemBackground" Color="#9C9C9C" />

  <Style x:Key="RichComboBoxItemStyle" TargetType="ComboBoxItem">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Margin="2,0,1,0">
            <Border Name="Border" Background="#01000000" />
            <ContentPresenter Margin="3,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource RichMouseOverComboBoxItemBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="FontFamilyItemTemplate">
    <TextBlock FontFamily="{Binding}" Text="{Binding}" FontSize="14" Height="22" VerticalAlignment="Center" Foreground="Black" />
  </DataTemplate>
  
  <DataTemplate x:Key="PlainFontFamilyItemTemplate">
    <TextBlock Text="{Binding}" FontSize="14" Height="22" VerticalAlignment="Center" />
  </DataTemplate>

  <DataTemplate x:Key="FontSizeItemTemplate">
    <TextBlock Text="{Binding}" Foreground="Black" />
  </DataTemplate>

  <!-- ComboBox -->

  <Style x:Key="RichComboBoxToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#FF333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2,2,3,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Grid Width="14" HorizontalAlignment="Right">
              <Border Name="Border" CornerRadius="3" Background="#BFBFBF" />
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#A6A6A6" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#A6A6A6" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#A6A6A6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <SolidColorBrush x:Key="RichComboBoxBorder" Color="#898989" />

  <ControlTemplate x:Key="ComboBoxTextBox" TargetType="TextBox">
    <Border x:Name="PART_ContentHost" Focusable="False" Background="{TemplateBinding Background}" />
  </ControlTemplate>

  <Style x:Key="RichComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Padding" Value="6,2,25,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RichComboBoxItemStyle}" />
    <Setter Property="ItemTemplate" Value="{StaticResource FontFamilyItemTemplate}" />
    <Setter Property="MaxDropDownHeight" Value="500" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="ControlContainer">
            <Border x:Name="ContentPresenterBorder">
              <Grid>
                <Border Name="Border" Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" Background="#EDEDED"
                        Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="4" />
                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" Padding="3,0,0,0"
                           VerticalAlignment="Center" Foreground="Black" />
                <!--TextBox Template="{StaticResource ComboBoxTextBox}" VerticalAlignment="Center" Padding="5,0,0,0"
                         BorderThickness="0" x:Name="PART_EditableTextBox" Text="{TemplateBinding SelectedValue}" IsReadOnly="{TemplateBinding IsReadOnly}"
                         Focusable="True" Margin="3,0,0,0" Background="Transparent" /-->
                <ToggleButton Background="{TemplateBinding Background}" HorizontalContentAlignment="Center"
                              HorizontalAlignment="Stretch" Margin="1" x:Name="DropDownToggle" Style="{StaticResource RichComboBoxToggleButtonStyle}"
                              
                              VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Path StrokeThickness="1" Stroke="Black" Data="M 0 0 L 3 3 L 6 0" HorizontalAlignment="Right" Margin="1,1,0,0" />
                </ToggleButton>
              </Grid>
            </Border>
            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="0" AllowsTransparency="True"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Grid Name="PopupBorder" MinWidth="50" SnapsToDevicePixels="True">
                <ContentControl>
                  <Border Height="Auto" HorizontalAlignment="Stretch" BorderBrush="#4C4C4C" Background="#EDEDED"
                      BorderThickness="1">
                    <ScrollViewer Padding="0" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                      <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                          <Setter Property="SnapsToDevicePixels" Value="True" />
                          <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                          <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                              <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </ScrollViewer.Resources>
                    </ScrollViewer>
                  </Border>
                </ContentControl>
              </Grid>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ********** RichTextToolBar Style ********** -->

  <Style x:Key="{x:Type local:RichTextToolBar}" TargetType="{x:Type local:RichTextToolBar}">
    <Setter Property="Background" Value="#9C9C9C" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RichTextToolBar}">
          <Grid Background="{TemplateBinding Background}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,4">

                <ToggleButton Command="{x:Static local:RichTextCommands.ToggleFontWeight}" CommandParameter="{StaticResource Bold}"
                                    Style="{StaticResource RichToggleButtonStyle}" ToolTip="Bold (Ctrl + B)"
                                    ContentTemplate="{StaticResource BoldButtonTemplate}" Margin="4,0,0,0"
                                    IsChecked="{Binding CurrentFontWeight, Converter={StaticResource FontWeightToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ToggleFontStyle}" CommandParameter="{StaticResource Italic}"
                                    Style="{StaticResource RichToggleButtonStyle}" ToolTip="Italic (Ctrl + I)"
                                    ContentTemplate="{StaticResource ItalicButtonTemplate}" Margin="4,0,0,0"
                                    IsChecked="{Binding CurrentFontStyle, Converter={StaticResource FontStyleToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ToggleTextDecorations}" CommandParameter="{StaticResource Underline}"
                                    Style="{StaticResource RichToggleButtonStyle}" ToolTip="Underline (Ctrl + U)"
                                    ContentTemplate="{StaticResource UnderlineButtonTemplate}" Margin="4,0,0,0"
                                    IsChecked="{Binding CurrentTextDecorations, Converter={StaticResource UnderlineToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />

                <Border Height="15" Width="1" Background="#AAAAAA" Margin="8,0,0,0" />

                <local:DropDownColorPicker Style="{StaticResource BackgroundColorPickerStyle}" Margin="8,0,0,0"
                                              Palette="{Binding BackgroundPalette, RelativeSource={RelativeSource TemplatedParent}}"
                                              SelectedColor="{Binding CurrentBackground, Converter={StaticResource BrushToColor}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <local:DropDownColorPicker Style="{StaticResource ForegroundColorPickerStyle}" Margin="4,0,0,0"
                                              Palette="{Binding ForegroundPalette, RelativeSource={RelativeSource TemplatedParent}}"
                                              SelectedColor="{Binding CurrentForeground, Converter={StaticResource BrushToColor}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                <Border Height="15" Width="1" Background="#AAAAAA" Margin="8,0,0,0" />

                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Left}"
                                  ToolTip="Align Text Left (Ctrl + L)" Margin="8,0,0,0"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource LeftAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource LeftAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Center}"
                                  ToolTip="Center (Ctrl + E)" Margin="4,0,0,0"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource CenterAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource CenterAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Right}"
                                  ToolTip="Align Text Right (Ctrl + R)" Margin="4,0,0,0"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource RightAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource RightAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Justify}"
                                  ToolTip="Justify (Ctrl + J)" Margin="4,0,0,0"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource JustifyAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource JustifyAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />

                <Border Height="15" Width="1" Background="#AAAAAA" Margin="8,0,0,0" />

                <ComboBox Width="140" SelectedValue="{Binding CurrentFontFamily, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ItemsSource="{Binding FontFamilies, RelativeSource={RelativeSource TemplatedParent}}" Name="FontSelector"
                          Style="{StaticResource RichComboBoxStyle}" Height="26" Margin="8,0,0,0" Tag="260" />
                <ComboBox Width="50" SelectedValue="{Binding CurrentFontSize, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ItemsSource="{Binding FontSizes, RelativeSource={RelativeSource TemplatedParent}}" Tag="54"
                          Style="{StaticResource RichComboBoxStyle}" ItemTemplate="{StaticResource FontSizeItemTemplate}" Height="26" Margin="4,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                <Button Command="{x:Static ApplicationCommands.Cut}" ToolTip="Cut (Ctrl + X)" Margin="4,0,0,0"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource CutButtonTemplate}" />
                <Button Command="{x:Static ApplicationCommands.Copy}" ToolTip="Copy (Ctrl + C)" Margin="4,0,0,0"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource CopyButtonTemplate}" />
                <Button Command="{x:Static ApplicationCommands.Paste}" ToolTip="Paste (Ctrl + V)" Margin="4,0,0,0"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource PasteButtonTemplate}" />

                <Border Height="15" Width="1" Background="#AAAAAA" Margin="8,0,0,0" />

                <Button Command="{x:Static ApplicationCommands.Undo}" ToolTip="Undo (Ctrl + Z)" Margin="8,0,0,0"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource UndoButtonTemplate}" />
                <Button Command="{x:Static ApplicationCommands.Redo}" ToolTip="Redo (Ctrl + Y)" Margin="4,0,0,0"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource RedoButtonTemplate}" />

              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FontSelectorDisplayMode" Value="Plain">
              <Setter TargetName="FontSelector" Property="ItemTemplate" Value="{StaticResource PlainFontFamilyItemTemplate}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>