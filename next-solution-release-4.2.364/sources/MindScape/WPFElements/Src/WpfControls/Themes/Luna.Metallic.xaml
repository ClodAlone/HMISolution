<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="http://namespaces.mindscape.co.nz/wpf">

  <SolidColorBrush x:Key="{x:Static local:FilteringTextBoxBase.BorderBrushKey}" Color="#FF7F9DB9" />

  <SolidColorBrush x:Key="ColoredButtonBorderBrush_Normal" Color="#FF9495A2" />
  <SolidColorBrush x:Key="ColoredButtonBorderBrush_Hot" Color="#FF5B6665" />
  <SolidColorBrush x:Key="ColoredButtonBorderBrush_Down" Color="#FF5B6665" />

  <LinearGradientBrush x:Key="ColoredButtonFillBrush_Normal" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFF1F1F5" />
    <GradientStop Offset="1" Color="#FFCDCED8" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ColoredButtonFillBrush_Hot" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFEFEFE" />
    <GradientStop Offset="1" Color="#FFCFD1DF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ColoredButtonFillBrush_Down" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFCBCDE7" />
    <GradientStop Offset="1" Color="#FFF6F7FA" />
  </LinearGradientBrush>

  <Style x:Key="ColoredButtonBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource ColoredButtonBorderBrush_Normal}" />
    <Setter Property="Background" Value="{StaticResource ColoredButtonFillBrush_Normal}" />
  </Style>

  <Style x:Key="{x:Static local:DropDownEditBox.ToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Style="{StaticResource ColoredButtonBorder}" Padding="3,3,3,0" Name="Bd">
            <Path Fill="Black" Data="M 1 0 L 4 3 L 7 0 L 8.5 1.5 L 4 5.5 L -0.5 1.5" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColoredButtonBorderBrush_Hot}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColoredButtonBorderBrush_Down}" />
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:Spin.SpinButtonStyleKey}" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Style="{StaticResource ColoredButtonBorder}" Padding="1,1.5,1.5,1.5" Name="Bd">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:MonthCalendar.SelectButtonStyleKey}" TargetType="ButtonBase">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Style="{StaticResource ColoredButtonBorder}" Padding="6,4,6,4" Name="Bd" Margin="2">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>