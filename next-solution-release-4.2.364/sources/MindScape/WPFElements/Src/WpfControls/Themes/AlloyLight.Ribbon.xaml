      </Border>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
