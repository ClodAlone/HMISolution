      </Border>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource SelectedRibbonButtonBackground}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MediumToggleButtonTemplate" TargetType="ToggleButton">
    <Border Name="Border" Background="Transparent" CornerRadius="2">
      <Border Name="Background" Margin="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="2" Padding="2,1,3,1">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ContentControl Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <ContentPresenter Name="ContentPresenter" Grid.Column="1" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource SelectedRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="{x:Static ms:Ribbon.ToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
	<Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
    <Setter Property="Template" Value="{StaticResource MediumToggleButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="ms:Ribbon.EditorSize" Value="Large">
        <Setter Property="Template" Value="{StaticResource LargeToggleButtonTemplate}" />
      </Trigger>
	  <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ -->
  <!--   Ribbon SplitButton style   -->
  <!-- ============================ -->

  <Style x:Key="SplitButtonToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="2,1,3,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Name="Border" Background="Transparent" CornerRadius="0,0,2,2">
            <Border Name="Background" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="0,0,2,2">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
            </Trigger>
			<Trigger Property="IsChecked" Value="True">
			  <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
			</Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="MediumSplitButtonToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="3,1,3,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Name="Border" Background="Transparent" CornerRadius="0,2,2,0">
            <Border Name="Background" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="0,2,2,0">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
            </Trigger>
			<Trigger Property="IsChecked" Value="True">
			  <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
			</Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <SolidColorBrush x:Key="MouseOverSplitButtonBorder" Color="#CDCDCD" />
  <SolidColorBrush x:Key="MouseOverSplitButtonBackground" Color="#A6A6A6" />

  <ControlTemplate x:Key="LargeSplitButtonTemplate" TargetType="{x:Type ms:SplitButton}">
    <Grid Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Name="Border" Background="Transparent" CornerRadius="2" Grid.RowSpan="2">
        <Border Name="Background" Margin="1" />
      </Border>
      <Border Name="ButtonBorder" Background="Transparent" CornerRadius="2,2,0,0" Margin="1,1,1,0" />
      <ToggleButton Name="ToggleButton" Style="{StaticResource SplitButtonToggleButtonStyle}" Grid.Row="1" Grid.RowSpan="2"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" />
      <ContentControl Content="{TemplateBinding ms:Ribbon.LargeIcon}" IsHitTestVisible="False" Margin="4,3,5,1" VerticalAlignment="Top" />
      <Grid Name="ContentHost" Grid.Row="1" IsHitTestVisible="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="Split" Height="1" />
        <ContentPresenter ContentTemplate="{StaticResource DropDownContentTemplate}" Margin="3,-4,4,1" Grid.Row="1" VerticalAlignment="Bottom" />
      </Grid>
      <Popup Name="Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
             AllowsTransparency="True" StaysOpen="False">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                  Style="{StaticResource ShadowStyle}" MinWidth="{TemplateBinding ActualWidth}">
            <ms:PopupMenu ItemsSource="{Binding DropDownItems, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
		<Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
      </Trigger>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
      <DataTrigger Binding="{Binding DropDownItems.Count, RelativeSource={RelativeSource Self}}" Value="0">
        <Setter TargetName="DropDownBorder" Property="Height" Value="45" />
      </DataTrigger>
      <Trigger SourceName="ButtonBorder" Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="Command" Value="{x:Null}">
        <Setter TargetName="ToggleButton" Property="Grid.Row" Value="0" />
        <Setter TargetName="Split" Property="Opacity" Value="0" />
		<Setter TargetName="Background" Property="Margin" Value="0" />
		<Setter TargetName="ButtonBorder" Property="Margin" Value="0" />
		<Setter TargetName="ToggleButton" Property="BorderThickness" Value="0" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
	  <Trigger Property="IsDropDownOpen" Value="True">
	    <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
		<Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
	  </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MediumSplitButtonTemplate" TargetType="{x:Type ms:SplitButton}">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Name="Border" Background="Transparent" CornerRadius="2" Grid.ColumnSpan="2">
        <Border Name="Background" Margin="1" />
      </Border>
	  <Border Name="ButtonBorder" Background="Transparent" CornerRadius="2,0,0,2" Margin="1,1,0,1" />
      <ToggleButton Name="ToggleButton" Style="{StaticResource MediumSplitButtonToggleButtonStyle}" Grid.Column="1" Grid.ColumnSpan="2"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="0,1,1,1" />
					
      <StackPanel Name="ContentHost" Orientation="Horizontal" IsHitTestVisible="False">
        <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="3,0,0,0" />
        <ContentPresenter Name="ContentPresenter" Margin="3,0,1,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Border Name="Split" Width="1" Margin="1,0,0,0" />
      </StackPanel>
      <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" VerticalAlignment="Center" Margin="3,0,4,0" Grid.Column="1" IsHitTestVisible="False" />

      <Popup Name="Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
             AllowsTransparency="True" StaysOpen="False">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                  Style="{StaticResource ShadowStyle}" MinWidth="{TemplateBinding ActualWidth}">
            <ms:PopupMenu ItemsSource="{Binding DropDownItems, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
	    <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
		<Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
      </Trigger>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
      <DataTrigger Binding="{Binding DropDownItems.Count, RelativeSource={RelativeSource Self}}" Value="0">
        <Setter TargetName="DropDownBorder" Property="Height" Value="45" />
      </DataTrigger>
      <Trigger Property="Command" Value="{x:Null}">
        <Setter TargetName="ToggleButton" Property="Grid.Column" Value="0" />
        <Setter TargetName="Split" Property="Opacity" Value="0" />
		<Setter TargetName="Background" Property="Margin" Value="0" />
		<Setter TargetName="ButtonBorder" Property="Margin" Value="0" />
		<Setter TargetName="ToggleButton" Property="BorderThickness" Value="0" />
      </Trigger>
      <Trigger SourceName="ButtonBorder" Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
	  <Trigger Property="IsDropDownOpen" Value="True">
	    <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
		<Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
	  </Trigger>
      <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="{x:Static ms:Ribbon.SplitButtonStyleKey}" TargetType="{x:Type ms:SplitButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
    <Setter Property="Template" Value="{StaticResource MediumSplitButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="ms:Ribbon.EditorSize" Value="Large">
        <Setter Property="Template" Value="{StaticResource LargeSplitButtonTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================================== -->
  <!--   Ribbon DropDownColorPicker style   -->
  <!-- ==================================== -->

  <DataTemplate x:Key="ColorPickerHeaderTemplate">
    <Grid>
      <ContentControl Name="IconHost" Content="{Binding Path=(ms:Ribbon.SmallIcon), RelativeSource={RelativeSource AncestorType={x:Type ms:DropDownColorPicker}}}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="3,0,0,0" />
      <Border Background="{Binding Converter={StaticResource ColorToBrush}}"
              Height="4" VerticalAlignment="Bottom" Width="{Binding ActualWidth, ElementName=IconHost}" HorizontalAlignment="Right" />
    </Grid>
    <DataTemplate.Triggers>
      <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <ControlTemplate x:Key="DropDownColorPickerButtonTemplate" TargetType="Button">
    <Border Name="Border" Background="Transparent" CornerRadius="2,0,0,2">
      <Border Name="Background" Margin="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="2,0,0,2" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  
  <Style x:Key="{x:Static ms:Ribbon.DropDownColorPickerStyleKey}" TargetType="ms:DropDownColorPicker">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
	<Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource ColorPickerHeaderTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ms:DropDownColorPicker">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

			<Border Name="Border" Background="Transparent" CornerRadius="2" Grid.ColumnSpan="2">
              <Border Name="Background" Margin="1,1,0,1" />
            </Border>
            <Button Name="Button" Template="{StaticResource DropDownColorPickerButtonTemplate}" />
            <ToggleButton Name="ToggleButton" Style="{StaticResource MediumSplitButtonToggleButtonStyle}" Grid.Column="1" BorderThickness="0,1,1,1"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

            <StackPanel Name="IconHost" Orientation="Horizontal" IsHitTestVisible="False">
              <ContentControl Content="{TemplateBinding SelectedColor}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
              <Border Name="Split" Width="1" Margin="1,1,0,1" />
            </StackPanel>
            <StackPanel Name="ContentHost" Orientation="Horizontal" Grid.Column="1">
              <ContentPresenter Name="ContentPresenter" Content="{TemplateBinding ms:Ribbon.EditorHeader}" VerticalAlignment="Center" Margin="1,0,0,0" IsHitTestVisible="False" />
              <Border IsHitTestVisible="False">
                <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" VerticalAlignment="Center" Margin="3,0,4,0" />
              </Border>
            </StackPanel>

            <Popup Name="Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True" StaysOpen="False">
              <Grid Name="DropDown" SnapsToDevicePixels="True">
                <!-- TODO: need to revise what is responsible for providing the drop down border. -->
                <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="0"
                        Style="{StaticResource ShadowStyle}" MinWidth="{TemplateBinding ActualWidth}">
                  <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type ms:DropDownColorPicker}}}" ContentTemplate="{TemplateBinding DropDownTemplate}" />
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
	       	  <Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverSplitButtonBorder}" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
            </Trigger>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentPresenter" Property="Content" Value="Small">
              <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== -->
  <!--   PopupResizer style   -->
  <!-- ====================== -->

  <SolidColorBrush x:Key="PopupResizerGripperBrush" Color="#BFBFBF" />
  <SolidColorBrush x:Key="PopupResizerBackground" Color="#666666" />

  <ControlTemplate x:Key="EdgeThumbTemplate">
    <Border Background="Transparent" Height="10">
      <Border Height="4" Width="20" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1">
        <Border.Background>
          <DrawingBrush Viewport="0,0,4,4" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Geometry="M 0 0 L 4 0 L 4 4 L 0 4 Z" Brush="Transparent" />
                <GeometryDrawing Geometry="M 1 1 L 3 1 L 3 3 L 1 3 Z" Brush="{StaticResource PopupResizerGripperBrush}" />
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Background>
      </Border>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="CornerThumbTemplate">
    <Border Background="Transparent" Height="12" Width="10">
      <Border Height="8" Width="8" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"
              Clip="{TemplateBinding Tag}">
        <Border.Background>
          <DrawingBrush Viewport="0,1,4,4" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Geometry="M 0 0 L 4 0 L 4 4 L 0 4 Z" Brush="Transparent" />
                <GeometryDrawing Geometry="M 1 0 L 3 0 L 3 2 L 1 2 Z" Brush="{StaticResource PopupResizerGripperBrush}" />
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Background>
      </Border>
    </Border>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:PopupResizer}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
	<Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{StaticResource PopupResizerBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:PopupResizer}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <Thumb Name="PART_Thumb" Template="{StaticResource EdgeThumbTemplate}" Cursor="SizeNS" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Position" Value="BottomRight">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNWSE" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 3 0 L 8 0 L 8 8 L 0 8 L 0 4 L 3 4 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Position" Value="BottomLeft">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Left" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNESW" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 0 0 L 3 0 L 3 4 L 8 4 L 8 8 L 0 8 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Position" Value="TopRight">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNESW" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 0 0 L 8 0 L 8 8 L 4 8 L 4 4 L 0 4 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Position" Value="TopLeft">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Left" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNWSE" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 0 0 L 8 0 L 8 4 L 4 4 L 4 8 L 0 8 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== -->
  <!--   Gallery Item style   -->
  <!-- ====================== -->

  <SolidColorBrush x:Key="MouseOverGalleryItemBackground" Color="#A6A6A6" />
  <SolidColorBrush x:Key="SelectedGalleryItemBackground" Color="#757575" />

  <Style TargetType="{x:Type ms:GalleryItem}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
	<Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:GalleryItem}">
          <Grid>
            <Border Name="Border" Background="{TemplateBinding BorderBrush}">
              <Border Name="Background" Margin="{TemplateBinding BorderThickness}">
			    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Margin="{TemplateBinding Padding}" />
			  </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverGalleryItemBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource SelectedGalleryItemBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== -->
  <!--   GalleryGroup style   -->
  <!-- ====================== -->

  <SolidColorBrush x:Key="GalleryGroupHeaderBackground" Color="#949494" />
  <SolidColorBrush x:Key="GalleryGroupHeaderForeground" Color="#3D3D3D" />

  <DataTemplate x:Key="GalleryGroupHeaderTemplate">
    <Border Background="{StaticResource GalleryGroupHeaderBackground}">
      <TextBlock Text="{Binding}" Margin="12,2,0,2" Foreground="{StaticResource GalleryGroupHeaderForeground}" />
    </Border>
  </DataTemplate>

  <Style TargetType="{x:Type ms:GalleryGroup}">
    <Setter Property="HeaderTemplate" Value="{StaticResource GalleryGroupHeaderTemplate}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel ItemWidth="{Binding ActualItemWidth, RelativeSource={RelativeSource AncestorType={x:Type ms:Gallery}}}"
                     ItemHeight="{Binding ActualItemHeight, RelativeSource={RelativeSource AncestorType={x:Type ms:Gallery}}}" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:GalleryGroup}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter Name="HeaderHost" ContentSource="Header" />
            <ItemsPresenter Grid.Row="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= -->
  <!--   Gallery style   -->
  <!-- ================= -->

  <SolidColorBrush x:Key="GalleryBackground" Color="#949494" />

  <SolidColorBrush x:Key="GalleryButtonBackground" Color="#9C9C9C" />
  <SolidColorBrush x:Key="MouseOverGalleryButtonBackground" Color="#A6A6A6" />
  <SolidColorBrush x:Key="PressedGalleryButtonBackground" Color="#757575" />

  <SolidColorBrush x:Key="DisabledGalleryButtonForeground" Color="#878787" />
  
  <Style x:Key="GalleryButtonStyle" TargetType="ButtonBase">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource GalleryButtonForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Name="Border" CornerRadius="{TemplateBinding Tag}" Background="{TemplateBinding BorderBrush}">
            <Border Name="Background" Margin="{TemplateBinding BorderThickness}" Background="{StaticResource GalleryButtonBackground}" CornerRadius="{TemplateBinding Tag}">
              <ContentPresenter />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverGalleryButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedGalleryButtonBackground}" />
			  <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledGalleryButtonForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ms:ArithmeticConverter x:Key="Plus24" Additive="24" />

  <ControlTemplate x:Key="GalleryTemplate" TargetType="{x:Type ms:Gallery}">
    <Grid VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="15" />
      </Grid.ColumnDefinitions>
      <Border Name="Background" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
              Background="{TemplateBinding Background}">
        <ms:GalleryItemsPresenter Name="ItemsHost" ItemsSource="{TemplateBinding GalleryItems}" Margin="{TemplateBinding Padding}"
                                  ItemTemplate="{TemplateBinding ItemTemplate}" ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}">
          <ms:GalleryItemsPresenter.ItemsPanel>
            <ItemsPanelTemplate>
              <ms:GalleryPanel ClipToBounds="True" />
            </ItemsPanelTemplate>
          </ms:GalleryItemsPresenter.ItemsPanel>
        </ms:GalleryItemsPresenter>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <RepeatButton Style="{StaticResource GalleryButtonStyle}" Command="{x:Static ms:GalleryCommands.NavigateUpCommand}">
          <Grid Width="5" Height="3">
            <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                  Data="M 0 3 L 3 0 L 5 3 Z" />
          </Grid>
        </RepeatButton>
        <RepeatButton Grid.Row="1" Style="{StaticResource GalleryButtonStyle}" Command="{x:Static ms:GalleryCommands.NavigateDownCommand}">
          <Grid Width="5" Height="3">
            <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                  Data="M 0 0 L 5 0 L 3 3 Z" />
          </Grid>
        </RepeatButton>
        <ToggleButton Name="DropDownButton" Grid.Row="2" Style="{StaticResource GalleryButtonStyle}">
          <Grid Width="7" Height="6">
            <Path Width="7" Height="6" RenderOptions.EdgeMode="Aliased"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                  Data="M 0 0 L 7 0 L 7 1 L 0 1 Z M 1 3 L 6 3 L 4 6 Z" />
          </Grid>
        </ToggleButton>
      </Grid>
      <Popup Name="Popup" MinWidth="{TemplateBinding ActualWidth}" Width="{TemplateBinding ActualWidth}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=DropDownButton}"
             Placement="Relative" StaysOpen="False" AllowsTransparency="True" ClipToBounds="False" MinHeight="100">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                  Style="{StaticResource ShadowStyle}">
            <ms:PopupMenu>
              <ms:Gallery />
              <ms:PopupResizer DockPanel.Dock="Bottom" ResizeMode="Corner" />
            </ms:PopupMenu>
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
        <Setter TargetName="Popup" Property="MinWidth" Value="{Binding ActualWidth, Converter={StaticResource Plus24}, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter TargetName="Popup" Property="Width" Value="{Binding ActualWidth, Converter={StaticResource Plus24}, RelativeSource={RelativeSource TemplatedParent}}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="GalleryInPopupTemplate" TargetType="{x:Type ms:Gallery}">
    <ScrollViewer VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
      <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" />
    </ScrollViewer>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:Gallery}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="1" />
	<Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource GalleryBorder}" />
    <Setter Property="Background" Value="{StaticResource GalleryBackground}" />
    <Setter Property="Template" Value="{StaticResource GalleryInPopupTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsWithinPopup" Value="False">
        <Setter Property="Template" Value="{StaticResource GalleryTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ====================== -->
  <!--   Ribbon Group style   -->
  <!-- ====================== -->

  <!-- Ribbon Group Dialog Button -->

  <SolidColorBrush x:Key="RibbonGroupButtonForeground" Color="#3D3D3D" />

  <SolidColorBrush x:Key="MouseOverRibbonGroupButtonBackground" Color="#A6A6A6" />
  <SolidColorBrush x:Key="PressedRibbonGroupButtonBackground" Color="#757575" />
  
  <Style x:Key="RibbonGroupButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="3,2,1,0" />
	<Setter Property="BorderThickness" Value="0" />
	<Setter Property="Foreground" Value="{StaticResource RibbonGroupButtonForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Name="Border" Background="Transparent">
            <Border Name="Background" Margin="{TemplateBinding BorderThickness}">
              <Grid Width="7" Height="7" Margin="{TemplateBinding Padding}">
                <Path StrokeThickness="1" Stroke="{TemplateBinding Foreground}" Width="7" Height="7"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Data="M 0 4 L 0 0 L 4 0 M 2 2 L 5.5 6 L 1 6 M 5 5 L 6 1" RenderOptions.EdgeMode="Aliased" />
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonGroupButtonBackground}" />
            </Trigger>
			<Trigger Property="IsPressed" Value="True">
			  <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonGroupButtonBackground}" />
			  <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
			</Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ribbon Group -->

  <SolidColorBrush x:Key="RibbonGroupHeaderBackground" Color="#D6D6D6" />
  <SolidColorBrush x:Key="RibbonGroupHeaderForeground" Color="#3D3D3D" />
  <SolidColorBrush x:Key="RibbonGroupBackground" Color="#8F8F8F" />
  
  <DataTemplate x:Key="RibbonGroupHeaderTemplate">
    <TextBlock Text="{Binding}" Foreground="{StaticResource RibbonGroupHeaderForeground}" HorizontalAlignment="Center" />
  </DataTemplate>

  <ControlTemplate x:Key="RibbonGroupTemplate" TargetType="{x:Type ms:RibbonGroup}">
    <Grid Name="Background" Margin="1,1,2,0" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="17" />
      </Grid.RowDefinitions>
	  <Border CornerRadius="2,2,0,0" Background="{StaticResource RibbonGroupBackground}" />
      <Border Name="HeaderBackground" Grid.Row="1" CornerRadius="0,0,2,2" Background="{StaticResource RibbonGroupHeaderBackground}" Margin="0,0,0,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Header" Margin="4,0,2,0" />
          <Button Name="RibbonGroupButton" Grid.Column="1" Style="{StaticResource RibbonGroupButtonStyle}" Margin="0,0,1,1"
                  Command="{TemplateBinding RibbonGroupCommand}" />
        </Grid>
      </Border>
      <ItemsPresenter Margin="6,2,6,1" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="RibbonGroupCommand" Value="{x:Null}">
        <Setter TargetName="RibbonGroupButton" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <SolidColorBrush x:Key="CollapsedRibbonGroupBackground" Color="#D6D6D6" />
  <SolidColorBrush x:Key="MouseOverCollapsedRibbonGroupBackground" Color="#A6A6A6" />
  <SolidColorBrush x:Key="PressedCollapsedRibbonGroupBackground" Color="#757575" />
  
  <SolidColorBrush x:Key="CollapsedRibbonGroupIconBackground" Color="#8F8F8F" />

  <Style x:Key="CollapsedRibbonGroupButtonStyle" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
	<Setter Property="BorderThickness" Value="0" />
	<Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Name="Border" CornerRadius="2" Background="{TemplateBinding BorderBrush}">
            <Border Name="Background" Margin="{TemplateBinding BorderThickness}" Background="{StaticResource CollapsedRibbonGroupBackground}" CornerRadius="2">
              <ContentPresenter Name="ContentPresenter" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverCollapsedRibbonGroupBackground}" />
            </Trigger>
            <!-- TODO: we may only need one of these triggers when we use the ClickMode=Press -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedCollapsedRibbonGroupBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedCollapsedRibbonGroupBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="CollapsedRibbonGroupTemplate"  TargetType="{x:Type ms:RibbonGroup}">
    <Grid Margin="1,1,2,2">
      <ToggleButton Name="ToggleButton" Style="{StaticResource CollapsedRibbonGroupButtonStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- Icon -->
          <Border Background="{StaticResource CollapsedRibbonGroupIconBackground}" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,3,0">
            <ContentPresenter Margin="7" Content="{TemplateBinding CollapsedIcon}" MinHeight="16" MinWidth="16" />
	      </Border>
          <!-- Header -->
          <ContentPresenter ContentTemplate="{StaticResource DropDownContentTemplate}" ContentSource="Header" Grid.Row="1" Margin="1,0,2,10" />
        </Grid>
      </ToggleButton>
      <Popup Name="Popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=ToggleButton}" StaysOpen="False" AllowsTransparency="True">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource RibbonContentBackground}"
                  Style="{StaticResource ShadowStyle}" CornerRadius="3" Height="86">
            <Grid Name="Background" Background="Transparent">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="17" />
              </Grid.RowDefinitions>
              <Border Name="HeaderBackground" Grid.Row="1" CornerRadius="0,0,2,2" Background="{StaticResource RibbonGroupHeaderBackground}" Margin="1,0,1,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Header" Margin="4,0,2,0" />
                  <Button Name="RibbonGroupButton" Grid.Column="1" Style="{StaticResource RibbonGroupButtonStyle}" Margin="0,0,1,1"
                          Command="{TemplateBinding RibbonGroupCommand}" />
                </Grid>
              </Border>
              <ItemsPresenter Margin="6,2,6,1" />
            </Grid>
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
      <Trigger Property="RibbonGroupCommand" Value="{x:Null}">
        <Setter TargetName="RibbonGroupButton" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:RibbonGroup}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HeaderTemplate" Value="{StaticResource RibbonGroupHeaderTemplate}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <ms:RibbonGroupPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template" Value="{StaticResource RibbonGroupTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsExpanded" Value="False">
        <Setter Property="Template" Value="{StaticResource CollapsedRibbonGroupTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== -->
  <!--   Ribbon Tab style   -->
  <!-- ==================== -->

  <Style TargetType="{x:Type ms:RibbonTab}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
	<Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
	<Setter Property="Background" Value="{StaticResource TabItemBackground}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:RibbonTab}">
          <Grid>
            <Border Name="Border" Margin="0,0,10,0" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="12,4,12,2" RecognizesAccessKey="True" />
            </Border>
            <Path Data="M 0 0 L 1 1 L 0 1 Z" Fill="{TemplateBinding Background}" Stretch="Fill" Width="20" VerticalAlignment="Stretch"
                  HorizontalAlignment="Right" Margin="-2,2,-10,0" Name="Triangle" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverTabItemBackground}" />
              <Setter TargetName="Triangle" Property="Fill" Value="{StaticResource MouseOverTabItemBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Panel.ZIndex" Value="100" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedTabItemBackground}" />
              <Setter TargetName="Triangle" Property="Fill" Value="{StaticResource SelectedTabItemBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================ -->
  <!--   Ribbon style   -->
  <!-- ================ -->

  <Style TargetType="{x:Type ms:Ribbon}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:Ribbon}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource RibbonContentBackground}" Height="91" Grid.Row="1">
              <ItemsControl ItemsSource="{Binding SelectedItem.Items, RelativeSource={RelativeSource TemplatedParent}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ms:RibbonTabPanel />
                  </ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
            <Border Background="{TemplateBinding Background}" />
            <ItemsPresenter Margin="20,2,0,0" MinHeight="23" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>