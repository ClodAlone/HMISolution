    <Border Name="Border" Background="Transparent" CornerRadius="2">
      <Border Name="Background" Margin="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="2" Padding="2,1,3,2">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ContentControl Content="{TemplateBinding ms:Ribbon.LargeIcon}" VerticalAlignment="Top" />
          <ContentPresenter ContentTemplate="{StaticResource LargeButtonContentTemplate}" Grid.Row="1"
                            VerticalAlignment="Top" HorizontalAlignment="Center" />
