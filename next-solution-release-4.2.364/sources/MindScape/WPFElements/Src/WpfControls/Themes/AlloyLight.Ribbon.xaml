<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ms="clr-namespace:Mindscape.WpfElements"
					xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/AlloyLight.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <sys:Thickness x:Key="ShadowMargin" Right="8" Bottom="8" />

  <ms:ObjectToIconConverter x:Key="IconConverter" />

  <SolidColorBrush x:Key="GalleryButtonForeground" Color="#3D3D3D" />

  <SolidColorBrush x:Key="RibbonContentBackground" Color="#9C9C9C" />
  <SolidColorBrush x:Key="TabItemForeground" Color="#3D3D3D" />

  <DataTemplate x:Key="DropDownArrowTemplate">
    <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased" Fill="{StaticResource GalleryButtonForeground}"
          Data="M 0 0 L 5 0 L 3 3 Z" />
  </DataTemplate>

  <ms:DropDownContentConverter x:Key="TopDropDownContentConverter" IsTop="True" />
  <ms:DropDownContentConverter x:Key="BottomDropDownContentConverter" IsTop="False" IncludeFinalSpace="True" />

  <DataTemplate x:Key="DropDownContentTemplate">
    <StackPanel>
      <ContentControl Content="{Binding Converter={StaticResource TopDropDownContentConverter}}" HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ContentControl Content="{Binding Converter={StaticResource BottomDropDownContentConverter}}" />
        <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <ms:DropDownContentConverter x:Key="BottomButtonContentConverter" IsTop="False" IncludeFinalSpace="False" />

  <DataTemplate x:Key="LargeButtonContentTemplate">
    <StackPanel>
      <ContentControl Content="{Binding Converter={StaticResource TopDropDownContentConverter}}" HorizontalAlignment="Center" />
      <ContentControl Content="{Binding Converter={StaticResource BottomButtonContentConverter}}" HorizontalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- =================== -->
  <!--   Separator style   -->
  <!-- =================== -->

  <SolidColorBrush x:Key="SeparatorBrush" Color="#CDCDCD" />

  <Style x:Key="{x:Static ms:Ribbon.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Margin" Value="3,6,3,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Width="1" Background="{StaticResource SeparatorBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================== -->
  <!--   TextBlock style   -->
  <!-- =================== -->

  <Style x:Key="{x:Static ms:Ribbon.TextBlockStyleKey}" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ================== -->
  <!--   CheckBox style   -->
  <!-- ================== -->

  <SolidColorBrush x:Key="DisabledRibbonForeground" Color="#B8B8B8" />
  
  <Style x:Key="{x:Static ms:Ribbon.CheckBoxStyleKey}" TargetType="CheckBox">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource CheckBoxBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="3,0,3,0" />
    <Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal">
            <Border Name="Border" Width="13" Height="13" Background="{TemplateBinding Background}" VerticalAlignment="Center"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
              <Path Width="7" Height="7" x:Name="CheckMark" SnapsToDevicePixels="False" StrokeThickness="2" Stroke="{TemplateBinding Foreground}" Data="M 0 3 L 3 7 L 7 -2" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="CheckMark" Property="Data" Value="M 0 7 L 7 0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverCheckBoxBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledRibbonForeground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= -->
  <!--   NumericUpDown style   -->
  <!-- ======================= -->

  <Style x:Key="SpinButtonStyle" TargetType="ButtonBase">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource DropDownButtonBackground}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Name="Border" CornerRadius="2" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverDropDownButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpinStyle" TargetType="{x:Type ms:Spin}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:Spin}">
          <Border Background="{TemplateBinding Background}" CornerRadius="2">
            <Grid DockPanel.Dock="Right">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <RepeatButton Command="{x:Static ms:SpinCommands.Increase}" Grid.Row="0" Style="{StaticResource {x:Static ms:Spin.SpinButtonStyleKey}}">
                <Polygon Points="4,0 8,3 0,3"
                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}" />
              </RepeatButton>
              <RepeatButton Command="{x:Static ms:SpinCommands.Decrease}" Grid.Row="2" Style="{StaticResource {x:Static ms:Spin.SpinButtonStyleKey}}">
                <Polygon Points="4,3 8,0 0,0"
                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}" />
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpinDecoratorStyle" TargetType="{x:Type ms:SpinDecorator}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:SpinDecorator}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{TemplateBinding BorderBrush}" Grid.ColumnSpan="2" CornerRadius="3">
              <Border Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}" />
            </Border>
            <ms:Spin Change="{TemplateBinding Change}" x:Name="PART_Spin" Width="14" Grid.Column="1"
                        Visibility="{TemplateBinding ShowSpinUI, Converter={StaticResource bvc}}" Margin="1" />
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding BorderThickness}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static ms:Ribbon.NumericUpDownStyleKey}" TargetType="{x:Type ms:NumericUpDown}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
	<Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Padding" Value="3,2,2,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:NumericUpDown}">
          <DockPanel LastChildFill="True">
            <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="3,0,5,0" />
            <ms:SpinDecorator Change="{Binding SmallChange, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" DockPanel.Dock="Right"
							  Style="{StaticResource SpinDecoratorStyle}" Width="{TemplateBinding ms:Ribbon.EditorWidth}" Margin="0,1,0,1">
              <ms:NumericTextBox Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                 Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                 BorderThickness="0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" />
            </ms:SpinDecorator>
            <ContentPresenter Name="ContentHost" Content="{TemplateBinding ms:Ribbon.EditorHeader}" Margin="0,0,5,0" VerticalAlignment="Center" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="{x:Static ms:Ribbon.IntegerUpDownStyleKey}" TargetType="{x:Type ms:IntegerUpDown}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
	<Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Padding" Value="3,2,2,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:IntegerUpDown}">
          <DockPanel LastChildFill="True">
            <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="3,0,5,0" DockPanel.Dock="Left" />
            <ms:SpinDecorator Change="{Binding SmallChange, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" DockPanel.Dock="Right"
                              Style="{StaticResource SpinDecoratorStyle}" Width="{TemplateBinding ms:Ribbon.EditorWidth}" Margin="0,1,0,1">
              <ms:IntegerTextBox Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                 Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                 Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                 BorderThickness="0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" />
            </ms:SpinDecorator>
            <ContentPresenter Name="ContentHost" Content="{TemplateBinding ms:Ribbon.EditorHeader}" Margin="0,0,5,0" VerticalAlignment="Center" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================== -->
  <!--   PopupMenu style   -->
  <!-- =================== -->

  <SolidColorBrush x:Key="MenuItemCheckBackground" Color="#757575" />

  <!-- SubmenuItem -->

  <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="MenuItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
        <ColumnDefinition Width="13" />
      </Grid.ColumnDefinitions>
      <Border Name="MouseOverBorder" Background="Transparent" Grid.ColumnSpan="5" />
      <Border Name="CheckedBorder" Margin="2,1,3,1" MinWidth="20">
        <Grid>
          <ContentPresenter Name="Icon" Content="{Binding Icon, Converter={StaticResource IconConverter}, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" />
          <Path Name="Check" Width="7" Height="7" SnapsToDevicePixels="False" Stroke="{StaticResource Foreground}" Visibility="Collapsed"
                StrokeThickness="1" Data="M 0 2 L 2 5 L 6 0" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Border>
      <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,3,0,4" />
      <TextBlock Grid.Column="3" Text="{TemplateBinding InputGestureText}" Margin="16,3,2,4" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Hidden" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckedBorder" Property="Background" Value="{StaticResource MenuItemCheckBackground}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Icon" Value="{x:Null}" />
          <Condition Property="IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
		<Setter TargetName="CheckedBorder" Property="Background" Value="Transparent" />
      </MultiTrigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
		<Setter Property="Foreground" Value="{StaticResource MouseOverMenuItemForeground}" />
        <Setter TargetName="Check" Property="Stroke" Value="{StaticResource MouseOverMenuItemForeground}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
        <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- SubmenuHeader -->

  <SolidColorBrush x:Key="MenuArrowBrush" Color="#3D3D3D" />

  <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="MenuItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
        <ColumnDefinition Width="13" />
      </Grid.ColumnDefinitions>
      <Border Width="25" />
      <Border Name="MouseOverBorder" Background="Transparent" Grid.ColumnSpan="5" Margin="1" />
      <ContentPresenter Name="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Content="{Binding Icon, Converter={StaticResource IconConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
      <ContentPresenter Name="HeaderHost" Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" Margin="0,3,0,4" />
      <TextBlock Grid.Column="3" Text="{TemplateBinding InputGestureText}" Margin="16,3,2,4" />
      <Path Name="Arrow" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
            Data="M 0 0 L 0 7 L 4 3.5 Z" Fill="{StaticResource MenuArrowBrush}" RenderOptions.EdgeMode="Aliased" />
      <Grid Margin="9,0,3,0" Grid.ColumnSpan="5">
        <Popup Name="Popup" Placement="Right" VerticalOffset="-1" PopupAnimation="Slide" HorizontalOffset="0"
               IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Grid Name="DropDown">
            <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                    Style="{StaticResource ShadowStyle}" MinWidth="135">
              <ms:PopupMenu ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" />
            </Border>
          </Grid>
        </Popup>
      </Grid>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
      </Trigger>
	  <Trigger Property="IsMouseOver" Value="True">
	    <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
		<Setter Property="Foreground" Value="{StaticResource MouseOverMenuItemForeground}" />
        <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource MouseOverMenuItemForeground}" />
	  </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSubmenuOpen" Value="True" />
          <Condition Property="HasItems" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
        <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
      </Trigger>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDownBorder" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- MenuItem Style -->

  <Style x:Key="{x:Static ms:PopupMenu.MenuItemStyleKey}" TargetType="MenuItem">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
	<Setter Property="Foreground" Value="{StaticResource Foreground}" />
	<!--Setter Property="Margin" Value="2,0,2,0" /-->
    <Style.Triggers>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
      </Trigger>
      <Trigger Property="Role" Value="SubmenuItem">
        <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate x:Key="PopupMenuSeparatorTemplate" TargetType="Separator">
    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" Height="1" Margin="4,1,4,1" />
  </ControlTemplate>

  <Style TargetType="{x:Type ms:PopupMenu}">
    <Style.Resources>
      <ResourceDictionary>
        <Style TargetType="Separator">
          <Setter Property="OverridesDefaultStyle" Value="True" />
          <Setter Property="Template" Value="{StaticResource PopupMenuSeparatorTemplate}" />
        </Style>
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:PopupMenu}">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================= -->
  <!--   Ribbon ComboBox style   -->
  <!-- ========================= -->

  <Style x:Key="RichComboBoxToggleButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
	<Setter Property="Padding" Value="2,2,3,2" />
    <Setter Property="Background" Value="{StaticResource DropDownButtonBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Grid.Column="1">
              <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource MouseOverDropDownButtonBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DisabledDropDownButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static ms:Ribbon.ComboBoxStyleKey}" TargetType="ComboBox">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Padding" Value="3,1,3,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MaxDropDownHeight" Value="500" />
    <Setter Property="Focusable" Value="False" />
	<Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <DockPanel LastChildFill="True">
            <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="3,0,5,0" IsHitTestVisible="False" DockPanel.Dock="Left" />
            <Grid DockPanel.Dock="Right" Width="{TemplateBinding ms:Ribbon.EditorWidth}" Margin="0,1,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
              </Grid.ColumnDefinitions>
			  <Border Name="Border" Grid.ColumnSpan="2" Background="{TemplateBinding BorderBrush}" CornerRadius="3">
                <Border BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="3" />
              </Border>

              <Border Padding="2">
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
              </Border>
              <TextBox VerticalAlignment="Center" Padding="{TemplateBinding Padding}" Margin="1"
                       BorderThickness="0" x:Name="PART_EditableTextBox" IsReadOnly="{TemplateBinding IsReadOnly}"
                       Visibility="Hidden" Focusable="True" Background="{TemplateBinding Background}" />
					   
              <ToggleButton Name="ToggleButton" Grid.ColumnSpan="2" Style="{StaticResource RichComboBoxToggleButtonStyle}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" HorizontalAlignment="Center" Margin="2,4,3,4" Grid.Row="2" />
              </ToggleButton>
              <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                          Style="{StaticResource ShadowStyle}" MinWidth="{Binding ActualWidth, ElementName=Border}">
                    <ScrollViewer Padding="0" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <VirtualizingStackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ContentControl Name="ContentHost" Content="{TemplateBinding ms:Ribbon.EditorHeader}" Margin="0,0,5,0"
                            VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TabItemForeground}" />
          </DockPanel>
          <ControlTemplate.Triggers>
		  <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDownBorder" Property="MinHeight" Value="45" />
            </Trigger>
			<Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
			<Trigger Property="IsGrouping" Value="True">
              <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="Focusable" Value="True" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter TargetName="ToggleButton" Property="Grid.Column" Value="1" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
            </Trigger>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= -->
  <!--   Ribbon Button style   -->
