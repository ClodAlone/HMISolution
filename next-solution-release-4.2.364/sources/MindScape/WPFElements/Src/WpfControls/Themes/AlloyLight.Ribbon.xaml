            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ContentControl Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" />
          <ContentPresenter Name="ContentPresenter" Grid.Column="1" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
      </Trigger>
      <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="{x:Static ms:Ribbon.ButtonStyleKey}" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
	<Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
    <Setter Property="Template" Value="{StaticResource MediumButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="ms:Ribbon.EditorSize" Value="Large">
        <Setter Property="Template" Value="{StaticResource LargeButtonTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================= -->
  <!--   Ribbon ToggleButton style   -->
  <!-- ============================= -->

