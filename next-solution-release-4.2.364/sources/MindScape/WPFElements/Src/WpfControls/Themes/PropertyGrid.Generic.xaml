<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid"
                    xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
                    xmlns:e="clr-namespace:Mindscape.WpfElements"
                    xmlns:local="clr-namespace:Mindscape.WpfElements"
                    >
  
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Common.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Editors.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/NumericUpDown.Generic.xaml" />
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/TreeListView.Generic.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <pg:LevelToIndentConverter x:Key="LevelToIndentConverter" />

  <DataTemplate x:Key="{x:Static e:PropertyGrid.PropertyNameTemplateKey}">
    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            SnapsToDevicePixels="True" Name="Bd"
            Focusable="True" FocusVisualStyle="{StaticResource EmptyStyle}"
            Padding="2,0,6,0" Margin="-10,0,0,0"
            BorderThickness="18,0,1,0">
      <DockPanel Margin="-19,0,0,0">
        <ToggleButton x:Name="Expander" 
                      Style="{StaticResource {x:Static pg:TreeListView.ExpandCollapseToggleStyleKey}}" 
                      Margin="{Binding Level,Converter={StaticResource LevelToIndentConverter},RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}"
                      IsChecked="{Binding Path=IsExpanded,RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}"
                      ClickMode="Press" />
        <TextBlock Name="NameBlock" Text="{Binding Node.HumanName}" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                   ToolTipService.IsEnabled="{Binding Path=(ToolTipService.IsEnabled), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                   Tag="{Binding PropertyNameToolTipTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                   >
          <ToolTipService.ToolTip>
            <ToolTip Content="{Binding}" 
                     ContentTemplate="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     />
          </ToolTipService.ToolTip>
        </TextBlock>
      </DockPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=HasItems,RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}" 
                   Value="False">
        <Setter TargetName="Expander"
                Property="ToggleButton.Visibility"
                Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=(pg:TreeListView.ShowSubitemExpanders),RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" 
                   Value="False">
        <Setter TargetName="Expander"
                Property="ToggleButton.Visibility"
                Value="Hidden" />
        <Setter TargetName="Bd"
                Property="Border.BorderThickness"
                Value="3,0,1,0" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}"
                   Value="True">
        <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
        <Setter TargetName="NameBlock" Property="TextBlock.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  
  <HierarchicalDataTemplate x:Key="PropertyGridHierarchy" ItemsSource="{Binding Path=Children}" />

  <sys:String x:Key="{x:Static pg:ViewCommandsToolBar.SearchLabelContentKey}">Search:</sys:String>

  <BooleanToVisibilityConverter x:Key="bvc" />
  
  <Style TargetType="{x:Type pg:ViewCommandsToolBar}">
    <Style.Resources>
      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="CommandTarget" Value="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
    </Style.Resources>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ViewCommandsToolBar}">
          <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="3">
            <DockPanel>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowCategorized}" ToolTip="Sort by Category" 
                      DockPanel.Dock="Left">
                <Path Data="M 0 0 L 5 0 L 5 1 L 0 1 Z M 7 0 L 12 0 L 12 1 L 7 1 Z
                                                      M 7 2 L 12 2 L 12 3 L 7 3 Z
                            M 0 4 L 5 4 L 5 5 L 0 5 Z M 7 4 L 12 4 L 12 5 L 7 5 Z
                                                      M 7 6 L 12 6 L 12 7 L 7 7 Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowAlphaSorted}" ToolTip="Sort Alphabetically"
                      DockPanel.Dock="Left">
                <Path Data="M 2 0 L 4 0 L 4 5 L 6 5 L 3 8 L 0 5 L 2 5 Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowUnsorted}" ToolTip="No Sorting" 
                      DockPanel.Dock="Left">
                <Path Data="M 0 0 L 8 0 L 8 1 L 0 1 Z
                            M 0 2 L 8 2 L 8 3 L 0 3 Z
                            M 0 4 L 8 4 L 8 5 L 0 5 Z
                            M 0 6 L 8 6 L 8 7 L 0 7 Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Label DockPanel.Dock="Left" Content="{DynamicResource {x:Static pg:ViewCommandsToolBar.SearchLabelContentKey}}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinWidth="40" Name="PART_FilterText" Grid.ColumnSpan="2" Padding="2,2,22,2" />
                <Button Command="{x:Static pg:ViewCommandsToolBar.ClearFilter}" Grid.Column="1" Visibility="{Binding IsEnabled, Converter={StaticResource bvc}, RelativeSource={RelativeSource Self}}">
                  <Path Stretch="Fill" Stroke="Black" Data="M 0 0 L 1 1 M 1 0 L 0 1" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                        Width="8" Height="8" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Center" Name="Path" />
                </Button>
              </Grid>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="TreeListViewStyleExpander" TargetType="{x:Type Expander}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <StackPanel>
            <DockPanel Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
              <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                            Visibility="{Binding Path=(pg:TreeListView.ShowGroupExpanders), Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                            Style="{StaticResource {x:Static pg:TreeListView.ExpandCollapseToggleStyleKey}}" 
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" Margin="-2,0,-2,0" />
              <ContentPresenter ContentSource="Header" />
            </DockPanel>
            <ContentPresenter Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BooleanToVisibility}}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <pg:AreEqualConverter x:Key="AreEqual" />

  <Style x:Key="{x:Static e:PropertyGrid.SelectionTrackingStyleKey}" TargetType="pg:TreeListViewItem" BasedOn="{StaticResource TreeListViewItemContainerStyle}">
    <Style.Triggers>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource AreEqual}">
            <MultiBinding.Bindings>
              <Binding Path="Header" RelativeSource="{RelativeSource Self}" />
              <Binding Path="SelectedGridItem" RelativeSource="{RelativeSource AncestorType={x:Type e:PropertyGrid}}" />
            </MultiBinding.Bindings>
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter Property="IsSelected" Value="True" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PropertyGridTextBoxStyle" TargetType="TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  
  <Style x:Key="PropertyGridComboBoxStyle" TargetType="ComboBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  
  <Style x:Key="PropertyGridColorPickerStyle" TargetType="{x:Type local:DropDownColorPicker}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  
  <Style x:Key="PropertyGridDatePickerStyle" TargetType="{x:Type local:DropDownDatePicker}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  
  <Style x:Key="PropertyGridNumericUpDownStyle" TargetType="{x:Type local:NumericUpDown}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  
  <Style x:Key="PropertyGridTimeSpanPickerStyle" TargetType="{x:Type local:TimeSpanPicker}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  
  <pe:BuiltInEditorStyleCollection x:Key="{x:Static local:PropertyGrid.BuiltInEditorStyleCollectionKey}">
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.SimpleTextEditorKey}" Style="{StaticResource PropertyGridTextBoxStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectEditorKey}" Style="{StaticResource PropertyGridComboBoxStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectNoTextEntryEditorKey}" Style="{StaticResource PropertyGridComboBoxStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.RadioSelectEditorKey}" Style="{StaticResource PropertyGridComboBoxStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ColorEditorKey}" Style="{StaticResource PropertyGridColorPickerStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.DateEditorKey}" Style="{StaticResource PropertyGridDatePickerStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.NumericUpDownEditorKey}" Style="{StaticResource PropertyGridNumericUpDownStyle}" />
    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.TimeSpanEditorKey}" Style="{StaticResource PropertyGridTimeSpanPickerStyle}" />
  </pe:BuiltInEditorStyleCollection>
  
  <Style TargetType="{x:Type e:PropertyGrid}" x:Shared="False">
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="PropertyNameTemplate" Value="{StaticResource {x:Static e:PropertyGrid.PropertyNameTemplateKey}}" />
    <Setter Property="ToolTipService.IsEnabled" Value="False" />
    <Setter Property="BuiltInEditorStyles" Value="{StaticResource {x:Static local:PropertyGrid.BuiltInEditorStyleCollectionKey}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:PropertyGrid}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsToolBarVisible, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource BooleanToVisibility}}">
                <pg:ViewCommandsToolBar Target="{Binding BindingView, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
                <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Padding="0,20,0,20"
                           Visibility="{Binding BindingView.DefaultView.IsEmpty, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource BooleanToVisibility}}">
                  No properties match the search criteria.
                </TextBlock>
              </StackPanel>
              <pg:TreeListView x:Name="PART_Grid"
                                  ItemTemplate="{StaticResource PropertyGridHierarchy}" 
                                  ItemContainerStyle="{StaticResource {x:Static e:PropertyGrid.SelectionTrackingStyleKey}}"
                                  ItemsSource="{TemplateBinding BindingView}">
                <pg:TreeListView.Columns>
                  <GridViewColumnCollection>
                    <GridViewColumn CellTemplate="{Binding PropertyNameTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                                    Width="{Binding Path=(pg:TreeListView.ResizeColumnWidth), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                                    />
                    <GridViewColumn CellTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Path=EditorSelector}" />
                  </GridViewColumnCollection>
                </pg:TreeListView.Columns>
                <pg:TreeListView.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.ContainerStyle>
                      <Style TargetType="{x:Type GroupItem}">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GroupItem}">
                              <Expander Style="{StaticResource TreeListViewStyleExpander}" IsExpanded="True">
                                <Expander.Header>
                                  <TextBlock Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                             Text="{Binding Name}" FontWeight="Bold" Margin="2" />
                                </Expander.Header>
                                <Expander.Content>
                                  <ItemsPresenter />
                                </Expander.Content>
                              </Expander>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </GroupStyle.ContainerStyle>
                  </GroupStyle>
                </pg:TreeListView.GroupStyle>
              </pg:TreeListView>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Rectangle x:Key="{x:Static pg:ManyEditor.ResetButtonContentKey}" x:Shared="False"
             Stroke="Black" StrokeThickness="1" Fill="Azure"
             Width="6" Height="6" Margin="2,0,2,0">
    <Rectangle.LayoutTransform>
      <RotateTransform Angle="45" />
    </Rectangle.LayoutTransform>
  </Rectangle>

  <sys:String x:Key="{x:Static pg:ManyEditor.ResetToolTipContentKey}">
    This property has different values across the selected objects.  
    Click to set a value.
  </sys:String>
  
  <DataTemplate x:Key="{x:Static pg:ManyEditor.InconsistentValuesTemplateKey}">
    <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
      <TextBlock Text="Multiple (" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PropertyTypeName}" VerticalAlignment="Center" />
      <TextBlock Text=")" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <Style TargetType="pg:ManyEditor">
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="pg:ManyEditor">
          <Border BorderThickness="0" Name="Bd"
                  Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}"
                  Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}">
            <Grid>
              <Grid.Resources>
                <pg:ManyToNodeConverter x:Key="DeManyfier" />
              </Grid.Resources>
              <DockPanel Name="InconsistentView">
                <Button DockPanel.Dock="Right" Padding="-1"
                        Command="{x:Static pg:ManyEditor.ResetCommand}" CommandParameter="{Binding}"
                        Content="{DynamicResource {x:Static pg:ManyEditor.ResetButtonContentKey}}"
                        ToolTip="{DynamicResource {x:Static pg:ManyEditor.ResetToolTipContentKey}}"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
                <ContentControl Content="{Binding Value}" 
                                ContentTemplate="{DynamicResource {x:Static pg:ManyEditor.InconsistentValuesTemplateKey}}" />
              </DockPanel>
              <ContentControl Name="ConsistentView" Visibility="Collapsed"
                              Background="Transparent"
                              Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource MarginInversionConverter}}"
                              Content="{Binding Converter={StaticResource DeManyfier}}" 
                              Focusable="False" FocusVisualStyle="{StaticResource EmptyStyle}"
                              ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsConsistent" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
            </Trigger>
            <Trigger Property="IsConsistent" Value="True">
              <Setter TargetName="ConsistentView" Property="Visibility" Value="Visible" />
              <Setter TargetName="InconsistentView" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
</ResourceDictionary>
