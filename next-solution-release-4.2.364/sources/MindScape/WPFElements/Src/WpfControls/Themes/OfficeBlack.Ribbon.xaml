        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                  Style="{StaticResource ShadowStyle}" MinWidth="{TemplateBinding ActualWidth}">
