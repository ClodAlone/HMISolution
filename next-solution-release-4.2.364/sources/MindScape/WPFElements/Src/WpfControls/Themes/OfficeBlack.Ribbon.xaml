          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverRibbonButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseOverRibbonButtonInnerBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedRibbonButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
              <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource PressedRibbonButtonInnerBorder}" />
              <Setter TargetName="Background" Property="BorderThickness" Value="1,0,1,1" />
              <Setter TargetName="Background" Property="Padding" Value="2,2,3,3" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SelectedRibbonButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedRibbonButtonBackground}" />
              <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource SelectedRibbonButtonInnerBorder}" />
