<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ms="clr-namespace:Mindscape.WpfElements"
					xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlack.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <sys:Thickness x:Key="ShadowMargin" Right="8" Bottom="8" />

  <ms:BooleanToVisibilityConverter x:Key="bvc" />
  <ms:ColorToBrushConverter x:Key="ColorToBrush" />
  <ms:ObjectToIconConverter x:Key="IconConverter" />

  <SolidColorBrush x:Key="PopupBackground" Color="#FAFAFA" />
  <SolidColorBrush x:Key="PopupBorder" Color="#868686" />
  <SolidColorBrush x:Key="PopupInnerBorder" Color="#F5F5F5" />

  <SolidColorBrush x:Key="GalleryButtonDarkForeground" Color="#7F7F7F" />
  <SolidColorBrush x:Key="GalleryButtonLightForeground" Color="#99E4E6E8" />

  <SolidColorBrush x:Key="RibbonForeground" Color="#464646" />
  
  <LinearGradientBrush x:Key="RibbonContentBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D7DADF" />
    <GradientStop Offset="0.2" Color="#C1C6CF" />
    <GradientStop Offset="0.2" Color="#B4BBC5" />
    <GradientStop Offset="1" Color="#E7F0F1" />
  </LinearGradientBrush>

  <DataTemplate x:Key="DropDownArrowTemplate">
    <Grid Width="5" Height="4">
      <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased" Fill="{StaticResource GalleryButtonLightForeground}"
            Data="M 0 0 L 5 0 L 3 3 Z" Margin="0,1,0,0" />
      <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased" Fill="{StaticResource GalleryButtonDarkForeground}"
            Data="M 0 0 L 5 0 L 3 3 Z" Margin="0,0,0,1" />
    </Grid>
  </DataTemplate>

  <ms:DropDownContentConverter x:Key="TopDropDownContentConverter" IsTop="True" />
  <ms:DropDownContentConverter x:Key="BottomDropDownContentConverter" IsTop="False" IncludeFinalSpace="True" />

  <DataTemplate x:Key="DropDownContentTemplate">
    <StackPanel>
      <ContentControl Content="{Binding Converter={StaticResource TopDropDownContentConverter}}" HorizontalAlignment="Center" Foreground="{StaticResource RibbonForeground}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ContentControl Content="{Binding Converter={StaticResource BottomDropDownContentConverter}}" Foreground="{StaticResource RibbonForeground}" />
        <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <ms:DropDownContentConverter x:Key="BottomButtonContentConverter" IsTop="False" IncludeFinalSpace="False" />

  <DataTemplate x:Key="LargeButtonContentTemplate">
    <StackPanel>
      <ContentControl Content="{Binding Converter={StaticResource TopDropDownContentConverter}}" HorizontalAlignment="Center" Foreground="{StaticResource RibbonForeground}" />
      <ContentControl Content="{Binding Converter={StaticResource BottomButtonContentConverter}}" Foreground="{StaticResource RibbonForeground}" HorizontalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- =================== -->
  <!--   Separator style   -->
  <!-- =================== -->

  <SolidColorBrush x:Key="LightSeparatorBrush" Color="#E6E9EB" />
  <SolidColorBrush x:Key="DarkSeparatorBrush" Color="#A7ABAD" />

  <Style x:Key="{x:Static ms:Ribbon.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Margin" Value="3,6,3,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Width="2" BorderThickness="1,0,0,0" BorderBrush="{StaticResource LightSeparatorBrush}" Background="{StaticResource DarkSeparatorBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================== -->
  <!--   TextBlock style   -->
  <!-- =================== -->

  <Style x:Key="{x:Static ms:Ribbon.TextBlockStyleKey}" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ================== -->
  <!--   CheckBox style   -->
  <!-- ================== -->

  <SolidColorBrush x:Key="CheckBoxBorder" Color="#848484" />
  <SolidColorBrush x:Key="CheckBoxInnerBackground" Color="#F4F4F4" />
  <SolidColorBrush x:Key="MouseOverCheckBoxBorder" Color="#848484" />
  <SolidColorBrush x:Key="MouseOverCheckBoxInnerBackground" Color="#F4F4F4" />
  <SolidColorBrush x:Key="PressedCheckBoxBorder" Color="#848484" />
  <SolidColorBrush x:Key="PressedCheckBoxInnerBackground" Color="#F4F4F4" />
  <SolidColorBrush x:Key="DisabledCheckBoxBorder" Color="#AEB1B5" />
  <SolidColorBrush x:Key="DisabledCheckBoxInnerBackground" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="CheckBoxInnerBorder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#A2ACB9" />
    <GradientStop Offset="1" Color="#E4E6EA" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CheckBoxBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#CACFD5" />
    <GradientStop Offset="1" Color="#F6F6F6" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverCheckBoxInnerBorder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FAD57A" />
    <GradientStop Offset="1" Color="#FDF1CF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverCheckBoxBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FCE7AF" />
    <GradientStop Offset="1" Color="#FEF8E7" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedCheckBoxInnerBorder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#F28926" />
    <GradientStop Offset="1" Color="#FAD5AF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedCheckBoxBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FFD067" />
    <GradientStop Offset="1" Color="#FFF4D5" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="DisabledCheckBoxInnerBorder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#E0E2E5" />
    <GradientStop Offset="1" Color="#F2F3F3" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="DisabledCheckBoxBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#EEF0F2" />
    <GradientStop Offset="1" Color="#FBFBFB" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="CheckMarkBrush" Color="#496A95" />

  <Style x:Key="{x:Static ms:Ribbon.CheckBoxStyleKey}" TargetType="CheckBox">
    <Setter Property="Margin" Value="3,0,3,0" />
    <Setter Property="Foreground" Value="{StaticResource RibbonForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border Name="Border" BorderThickness="1" BorderBrush="{StaticResource CheckBoxBorder}" Background="{StaticResource CheckBoxInnerBackground}"
                    Width="13" Height="13">
              <Grid>
                <Border Name="Background" Margin="1" BorderThickness="1" BorderBrush="{StaticResource CheckBoxInnerBorder}" Background="{StaticResource CheckBoxBackground}" />
                <Path Width="9" Height="9" VerticalAlignment="Center" Name="CheckMark" Stroke="{StaticResource CheckMarkBrush}"
                      StrokeThickness="2" Data="M 0 0.6 L 0.4 1 L 1 0" Stretch="Fill"
                      Visibility="{Binding IsChecked, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Border>
            <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverCheckBoxBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverCheckBoxInnerBackground}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseOverCheckBoxInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverCheckBoxBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedCheckBoxBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedCheckBoxInnerBackground}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource PressedCheckBoxInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedCheckBoxBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledCheckBoxBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DisabledCheckBoxInnerBackground}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource DisabledCheckBoxInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource DisabledCheckBoxBackground}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= -->
  <!--   NumericUpDown style   -->
  <!-- ======================= -->

  <SolidColorBrush x:Key="SpinDecoratorBorder" Color="#898989" />
  <SolidColorBrush x:Key="SpinDecoratorBackground" Color="#E8E8E8" />
  <SolidColorBrush x:Key="MouseOverSpinBorder" Color="#B7B7B7" />
  <SolidColorBrush x:Key="MouseOverSpinDecoratorBorder" Color="#898989" />
  <SolidColorBrush x:Key="MouseOverSpinDecoratorBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MouseOverSpinButtonBorder" Color="#DBCE99" />
  <SolidColorBrush x:Key="MouseOverSpinButtonInnerBorder" Color="#FFFDF3" />
  <SolidColorBrush x:Key="PressedSpinButtonBorder" Color="#9A9064" />

  <LinearGradientBrush x:Key="SpinButtonForeground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#575757" />
    <GradientStop Offset="1" Color="#343434" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverSpinBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#EDF1F6" />
    <GradientStop Offset="0.5" Color="#E3E8EE" />
    <GradientStop Offset="0.5" Color="#DAE0E7" />
    <GradientStop Offset="1" Color="#EEF2F6" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="MouseOverSpinButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFCDC" />
    <GradientStop Offset="0.5" Color="#FFF3B1" />
    <GradientStop Offset="0.5" Color="#FFD975" />
    <GradientStop Offset="1" Color="#FFDE88" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedSpinButtonInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DFD9C5" />
    <GradientStop Offset="0.5" Color="#EFDDBC" />
    <GradientStop Offset="0.5" Color="#FFC67D" />
    <GradientStop Offset="1" Color="#FFDF8D" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedSpinButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D8CEB0" />
    <GradientStop Offset="0.5" Color="#E7CB98" />
    <GradientStop Offset="0.5" Color="#FFA738" />
    <GradientStop Offset="1" Color="#FFC145" />
  </LinearGradientBrush>

  <Style x:Key="SpinButtonStyle" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{StaticResource SpinButtonForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Name="Border" BorderThickness="1" Background="Transparent" BorderBrush="Transparent">
            <Border Name="Background" BorderThickness="1">
              <ContentPresenter />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinButtonBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseOverSpinButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSpinButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedSpinButtonBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource PressedSpinButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedSpinButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpinStyle" TargetType="{x:Type ms:Spin}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:Spin}">
          <Grid DockPanel.Dock="Right">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Name="Background" Grid.RowSpan="2" BorderThickness="1" Background="Transparent" BorderBrush="Transparent" />
            <RepeatButton Command="{x:Static ms:SpinCommands.Increase}" Grid.Row="0" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" Focusable="False" Style="{StaticResource SpinButtonStyle}">
              <Polygon Points="4,0 7,3 0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Name="UpArrow" RenderOptions.EdgeMode="Aliased" Margin="0,2,0,0" />
            </RepeatButton>
            <RepeatButton Command="{x:Static ms:SpinCommands.Decrease}" Grid.Row="2" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" Focusable="False" Style="{StaticResource SpinButtonStyle}">
              <Polygon Points="4,3 7,0 0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased" Margin="0,0,0,1" />
            </RepeatButton>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseOverSpinBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSpinBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseOverSpinBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSpinBackground}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpinDecoratorStyle" TargetType="{x:Type ms:SpinDecorator}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource SpinDecoratorBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpinDecoratorBorder}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:SpinDecorator}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{TemplateBinding Background}" Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Grid.ColumnSpan="2" />
            <ms:Spin Change="{TemplateBinding Change}" x:Name="PART_Spin" Width="17" Visibility="{TemplateBinding ShowSpinUI, Converter={StaticResource bvc}}"
                     Grid.Column="1" Style="{StaticResource SpinStyle}" Margin="1" />
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding BorderThickness}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
              <Setter Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorder}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinDecoratorBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSpinDecoratorBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinDecoratorBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSpinDecoratorBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static ms:Ribbon.NumericUpDownStyleKey}" TargetType="{x:Type ms:NumericUpDown}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource SpinDecoratorBorder}" />
    <Setter Property="Background" Value="{StaticResource SpinDecoratorBackground}" />
    <Setter Property="Padding" Value="0,2,2,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:NumericUpDown}">
          <DockPanel LastChildFill="True">
            <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="3,0,5,0" />
            <ms:SpinDecorator Change="{Binding SmallChange, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" DockPanel.Dock="Right"
                              Style="{StaticResource SpinDecoratorStyle}" Width="{TemplateBinding ms:Ribbon.EditorWidth}">
              <ms:NumericTextBox Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                 Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                 Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                 BorderThickness="0" Background="Transparent" Padding="{TemplateBinding Padding}" />
            </ms:SpinDecorator>
            <ContentPresenter Name="ContentHost" Content="{TemplateBinding ms:Ribbon.EditorHeader}" Margin="0,0,5,0" VerticalAlignment="Center" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static ms:Ribbon.IntegerUpDownStyleKey}" TargetType="{x:Type ms:IntegerUpDown}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource SpinDecoratorBorder}" />
    <Setter Property="Background" Value="{StaticResource SpinDecoratorBackground}" />
    <Setter Property="Padding" Value="0,2,2,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:IntegerUpDown}">
          <DockPanel LastChildFill="True">
            <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="3,0,5,0" DockPanel.Dock="Left" />
            <ms:SpinDecorator Change="{Binding SmallChange, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" DockPanel.Dock="Right"
                              Style="{StaticResource SpinDecoratorStyle}" Width="{TemplateBinding ms:Ribbon.EditorWidth}">
              <ms:IntegerTextBox Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                 Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                 Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                 BorderThickness="0" Background="Transparent" Padding="{TemplateBinding Padding}" />
            </ms:SpinDecorator>
            <ContentPresenter Name="ContentHost" Content="{TemplateBinding ms:Ribbon.EditorHeader}" Margin="0,0,5,0" VerticalAlignment="Center" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================== -->
  <!--   PopupMenu style   -->
  <!-- =================== -->

  <SolidColorBrush x:Key="MenuItemCheckBorder" Color="#F29536" />
  <SolidColorBrush x:Key="MenuItemCheckBackground" Color="#FFE395" />
  <SolidColorBrush x:Key="MenuItemLeftMarginBorder" Color="#C5C5C5" />

  <LinearGradientBrush x:Key="HighlightedMenuItemBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DBCE99" />
    <GradientStop Offset="1" Color="#BCAA8A" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HighlightedMenuItemInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFFB" />
    <GradientStop Offset="0.5" Color="#FFF9E3" />
    <GradientStop Offset="0.5" Color="#FFF2C9" />
    <GradientStop Offset="1" Color="#FFFBD4" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HighlightedMenuItemBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFDEB" />
    <GradientStop Offset="0.5" Color="#FFEBAE" />
    <GradientStop Offset="0.5" Color="#FFD558" />
    <GradientStop Offset="1" Color="#FFE283" />
  </LinearGradientBrush>

  <!-- SubmenuItem -->

  <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="MenuItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
        <ColumnDefinition Width="13" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource MenuItemLeftMarginBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource MenuItemLeftMarginBorder}" />
      <Border Name="MouseOverBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Grid.ColumnSpan="5" CornerRadius="1">
        <Border Name="MouseOverBackground" Margin="1" />
      </Border>
      <Border Name="CheckedBorder" BorderThickness="1" CornerRadius="1" Margin="2,1,3,1" MinWidth="20">
        <Grid>
          <ContentPresenter Name="Icon" Content="{Binding Icon, Converter={StaticResource IconConverter}, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" />
          <Path Name="Check" Width="7" Height="7" SnapsToDevicePixels="False" Stroke="{StaticResource MenuItemCheckBrush}" Visibility="Collapsed"
                StrokeThickness="1" Data="M 0 3 L 2 6 L 6 0" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Border>
      <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,3,0,4" />
      <TextBlock Grid.Column="3" Text="{TemplateBinding InputGestureText}" Margin="16,3,2,4" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Hidden" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckedBorder" Property="BorderBrush" Value="{StaticResource MenuItemCheckBorder}" />
        <Setter TargetName="CheckedBorder" Property="Background" Value="{StaticResource MenuItemCheckBackground}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Icon" Value="{x:Null}" />
          <Condition Property="IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
      </MultiTrigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemInnerBorder}" />
        <Setter TargetName="MouseOverBorder" Property="BorderBrush" Value="{StaticResource HighlightedMenuItemBorder}" />
        <Setter TargetName="MouseOverBackground" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
        <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- SubmenuHeader -->

  <LinearGradientBrush x:Key="MenuArrowBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#393E45" />
    <GradientStop Offset="1" Color="#5F6773" />
  </LinearGradientBrush>

  <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="MenuItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
        <ColumnDefinition Width="13" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource MenuItemLeftMarginBackground}" Width="25"  BorderThickness="0,0,1,0" BorderBrush="{StaticResource MenuItemLeftMarginBorder}" />
      <Border Name="MouseOverBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Grid.ColumnSpan="5" Margin="1" />
      <ContentPresenter Name="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Content="{Binding Icon, Converter={StaticResource IconConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
      <ContentPresenter Name="HeaderHost" Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" Margin="0,3,0,4" />
      <TextBlock Grid.Column="3" Text="{TemplateBinding InputGestureText}" Margin="16,3,2,4" />
      <Path Name="Arrow" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
            Data="M 0 0 L 0 7 L 4 3.5 Z" Fill="{StaticResource MenuArrowBrush}" RenderOptions.EdgeMode="Aliased" />
      <Grid Margin="9,0,3,0" Grid.ColumnSpan="5">
        <Popup Name="Popup" Placement="Right" VerticalOffset="-1" PopupAnimation="Slide" HorizontalOffset="0"
               IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Grid Name="DropDown">
            <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                    Style="{StaticResource ShadowStyle}" MinWidth="135">
              <Border BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}">
                <ms:PopupMenu ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
            </Border>
          </Grid>
        </Popup>
      </Grid>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Icon" Value="{x:Null}">
        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsHighlighted" Value="True" />
          <Condition Property="HasItems" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
        <Setter TargetName="MouseOverBorder" Property="BorderBrush" Value="{StaticResource HighlightedMenuItemBorder}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="HasItems" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
        <Setter TargetName="MouseOverBorder" Property="BorderBrush" Value="{StaticResource HighlightedMenuItemBorder}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSubmenuOpen" Value="True" />
          <Condition Property="HasItems" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="MouseOverBorder" Property="Background" Value="{StaticResource HighlightedMenuItemBackground}" />
        <Setter TargetName="MouseOverBorder" Property="BorderBrush" Value="{StaticResource HighlightedMenuItemBorder}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
        <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
      </Trigger>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDownBorder" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- MenuItem Style -->

  <Style x:Key="{x:Static ms:PopupMenu.MenuItemStyleKey}" TargetType="MenuItem">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Style.Triggers>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
      </Trigger>
      <Trigger Property="Role" Value="SubmenuItem">
        <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate x:Key="PopupMenuSeparatorTemplate" TargetType="Separator">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
        <ColumnDefinition Width="13" />
      </Grid.ColumnDefinitions>
      <Border Height="3" Width="25" Background="{StaticResource MenuItemLeftMarginBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource MenuItemLeftMarginBorder}" />
      <Border Height="1" Margin="0,1,0,1" Background="{StaticResource MenuItemLeftMarginBorder}" Grid.Column="2" Grid.ColumnSpan="3" />
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:PopupMenu}">
    <Style.Resources>
      <ResourceDictionary>
        <Style TargetType="Separator">
          <Setter Property="OverridesDefaultStyle" Value="True" />
          <Setter Property="Template" Value="{StaticResource PopupMenuSeparatorTemplate}" />
        </Style>
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:PopupMenu}">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

