  <LinearGradientBrush x:Key="RibbonGroupInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E7E9ED" />
    <GradientStop Offset="1" Color="#77E9E9E9" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RibbonGroupHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#B6B8B8" />
	<GradientStop Offset="1" Color="#9FA0A0" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="RibbonGroupHeaderForeground" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="MouseOverRibbonGroupInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#CCFFFFFF" />
	<GradientStop Offset="1" Color="Transparent" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="MouseOverRibbonGroupBackground" Color="#EBEDEF" />

  <LinearGradientBrush x:Key="MouseOverRibbonGroupBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#AEB0B4" />
    <GradientStop Offset="1" Color="#818181" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverRibbonGroupHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#AAABAB" />
    <GradientStop Offset="1" Color="#6D6E6E" />
  </LinearGradientBrush>

  <DataTemplate x:Key="RibbonGroupHeaderTemplate">
    <TextBlock Text="{Binding}" Foreground="{StaticResource RibbonGroupHeaderForeground}" HorizontalAlignment="Center" />
  </DataTemplate>

  <ControlTemplate x:Key="RibbonGroupTemplate" TargetType="{x:Type ms:RibbonGroup}">
    <Grid Name="Background" Margin="1,1,2,0" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="17" />
      </Grid.RowDefinitions>
      <Border Name="HeaderBackground" Grid.Row="1" CornerRadius="0,0,2,2" Background="{StaticResource RibbonGroupHeaderBackground}" Margin="1,0,2,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Header" Margin="4,0,2,0" />
          <Button Name="RibbonGroupButton" Grid.Column="1" Style="{StaticResource RibbonGroupButtonStyle}" Margin="0,0,1,1"
                  Command="{TemplateBinding RibbonGroupCommand}" />
        </Grid>
      </Border>
      <ItemsPresenter Margin="6,2,6,1" />
      <Border BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource RibbonGroupInnerBorder}"
                    Margin="1,1,0,0" Grid.RowSpan="2" />
      <Border Name="Border" BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource RibbonGroupBorder}"
                    Margin="0,0,1,1" Grid.RowSpan="2">
        <Border Name="InnerBorder" BorderThickness="1" CornerRadius="2" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverRibbonGroupInnerBorder}" />
        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverRibbonGroupBorder}" />
        <Setter TargetName="HeaderBackground" Property="Background" Value="{StaticResource MouseOverRibbonGroupHeaderBackground}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonGroupBackground}" />
      </Trigger>
      <Trigger Property="RibbonGroupCommand" Value="{x:Null}">
        <Setter TargetName="RibbonGroupButton" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <LinearGradientBrush x:Key="CollapsedRibbonGroupBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F3F3F3" />
    <GradientStop Offset="0.18" Color="#C8CDD4" />
    <GradientStop Offset="0.18" Color="#B9C0C9" />
    <GradientStop Offset="1" Color="#EBEBEB" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CollapsedRibbonGroupBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#B6B7B7" />
    <GradientStop Offset="1" Color="#707070" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CollapsedRibbonGroupInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FAFAFA" />
    <GradientStop Offset="0.5" Color="#DADDE1" />
    <GradientStop Offset="1" Color="#F0F0F0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverCollapsedRibbonGroupBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F6F6F6" />
    <GradientStop Offset="0.18" Color="#D6DCE4" />
    <GradientStop Offset="0.18" Color="#CBD2DD" />
    <GradientStop Offset="1" Color="#EBEBEB" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverCollapsedRibbonGroupBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#BCC1D6" />
    <GradientStop Offset="1" Color="#748DBB" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MouseOverCollapsedRibbonGroupInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FAFAFA" />
    <GradientStop Offset="1" Color="#FFFFFF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedCollapsedRibbonGroupBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#989898" />
    <GradientStop Offset="0.04" Color="#DEDFE0" />
    <GradientStop Offset="0.18" Color="#ADB1B8" />
    <GradientStop Offset="0.18" Color="#9EA3AC" />
    <GradientStop Offset="1" Color="#D2D6D6" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedCollapsedRibbonGroupBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#7C7D7D" />
    <GradientStop Offset="0.98" Color="#949494" />
    <GradientStop Offset="1" Color="#BABABA" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PressedCollapsedRibbonGroupInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E7E7E8" />
    <GradientStop Offset="0.18" Color="#C3C5CA" />
    <GradientStop Offset="0.18" Color="#B7BBC1" />
    <GradientStop Offset="1" Color="#DDE0E0" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="CollapsedRibbonGroupIconBorder" Color="#A0A0A0" />
  <SolidColorBrush x:Key="CollapsedRibbonGroupIconBackground" Color="#99FFFFFF" />
  <SolidColorBrush x:Key="CollapsedRibbonGroupIconBottomBackground" Color="#C2C2C2" />

  <Style x:Key="CollapsedRibbonGroupButtonStyle" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Name="Border" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource CollapsedRibbonGroupBorder}"
                  Background="{StaticResource CollapsedRibbonGroupInnerBorder}">
            <Border Name="Background" Margin="1,0,1,1" Background="{StaticResource CollapsedRibbonGroupBackground}">
              <ContentPresenter Name="ContentPresenter" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverCollapsedRibbonGroupBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverCollapsedRibbonGroupInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverCollapsedRibbonGroupBackground}" />
            </Trigger>
            <!-- TODO: we may only need one of these triggers when we use the ClickMode=Press -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedCollapsedRibbonGroupBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedCollapsedRibbonGroupInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedCollapsedRibbonGroupBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedCollapsedRibbonGroupBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedCollapsedRibbonGroupInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedCollapsedRibbonGroupBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <LinearGradientBrush x:Key="CollapsedRibbonGroupPopupBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#A4A4A4" />
    <GradientStop Offset="1" Color="#7A7A7A" />
  </LinearGradientBrush>

  <ControlTemplate x:Key="CollapsedRibbonGroupTemplate"  TargetType="{x:Type ms:RibbonGroup}">
    <Grid Margin="1,1,2,0">
      <ToggleButton Name="ToggleButton" Style="{StaticResource CollapsedRibbonGroupButtonStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- Icon -->
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,3,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource CollapsedRibbonGroupIconBackground}" CornerRadius="4,4,0,0" />
            <ContentPresenter Margin="7,3,7,3" Content="{TemplateBinding CollapsedIcon}" MinHeight="16" MinWidth="16" />
            <Border Background="{StaticResource CollapsedRibbonGroupIconBottomBackground}" Grid.Row="1" CornerRadius="0,0,4,4" />
            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource CollapsedRibbonGroupIconBorder}" Grid.RowSpan="2" />
          </Grid>
          <!-- Header -->
          <ContentPresenter ContentTemplate="{StaticResource DropDownContentTemplate}" ContentSource="Header" Grid.Row="1" Margin="1,0,2,10" />
        </Grid>
      </ToggleButton>
      <Popup Name="Popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=ToggleButton}" StaysOpen="False" AllowsTransparency="True">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource RibbonContentBackground}"
                  Style="{StaticResource ShadowStyle}" CornerRadius="3" Height="86">
            <Grid Name="Background" Background="Transparent">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="17" />
              </Grid.RowDefinitions>
              <Border Name="HeaderBackground" Grid.Row="1" CornerRadius="0,0,2,2" Background="{StaticResource RibbonGroupHeaderBackground}" Margin="1,0,2,2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Header" Margin="4,0,2,0" />
                  <Button Name="RibbonGroupButton" Grid.Column="1" Style="{StaticResource RibbonGroupButtonStyle}" Margin="0,0,1,1"
                          Command="{TemplateBinding RibbonGroupCommand}" />
                </Grid>
              </Border>
              <ItemsPresenter Margin="6,2,6,1" />
              <Border BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource RibbonGroupInnerBorder}"
                      Margin="1,1,0,0" Grid.RowSpan="2" />
              <Border Name="Border" BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource RibbonGroupBorder}"
                      Margin="0,0,1,1" Grid.RowSpan="2">
                <Border Name="InnerBorder" BorderThickness="1" CornerRadius="2" />
              </Border>
              <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource CollapsedRibbonGroupPopupBorder}" CornerRadius="2" Grid.RowSpan="2" />
            </Grid>
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
      <Trigger SourceName="DropDown" Property="IsMouseOver" Value="True">
        <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverRibbonGroupInnerBorder}" />
        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverRibbonGroupBorder}" />
        <Setter TargetName="HeaderBackground" Property="Background" Value="{StaticResource MouseOverRibbonGroupHeaderBackground}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverRibbonGroupBackground}" />
      </Trigger>
      <Trigger Property="RibbonGroupCommand" Value="{x:Null}">
        <Setter TargetName="RibbonGroupButton" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:RibbonGroup}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HeaderTemplate" Value="{StaticResource RibbonGroupHeaderTemplate}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <ms:RibbonGroupPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template" Value="{StaticResource RibbonGroupTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsExpanded" Value="False">
        <Setter Property="Template" Value="{StaticResource CollapsedRibbonGroupTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== -->
  <!--   Ribbon Tab style   -->
  <!-- ==================== -->

  <Style TargetType="{x:Type ms:RibbonTab}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Foreground" Value="{StaticResource TabItemForeground}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:RibbonTab}">
          <Grid Name="Grid" Background="Transparent">
            <Border Background="{StaticResource TabItemInnerBorder}" BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                    Name="MouseOverBorder" Visibility="Hidden" Margin="3,1,2,0">
              <Border Background="{StaticResource MouseOverTopTabItemBackground}" Margin="1,1,1,0" CornerRadius="3,3,0,0" />
            </Border>
            <Border Name="SelectedBorder" Margin="3,1,2,0" Background="{StaticResource TabItemInnerBorder}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,1,1,0" Visibility="Hidden" CornerRadius="4,4,0,0">
              <Grid>
                <Border Background="{StaticResource TabItemBackground}" Margin="1,1,1,0" CornerRadius="4,4,0,0" />
                <Border VerticalAlignment="Bottom" BorderBrush="{StaticResource Border}" Height="2"
                        BorderThickness="1,0,1,0" CornerRadius="2,2,0,0" Margin="-2,0,-2,0" Background="{StaticResource TabItemBackground}" />
              </Grid>
            </Border>
            <Border Name="Glow" Visibility="Hidden" BorderThickness="1,1,1,0" BorderBrush="{StaticResource TopTabItemOuterGlowBorder}" CornerRadius="5,5,0,0" Margin="2,0,1,0">
              <Border BorderThickness="1,1,1,0" BorderBrush="{StaticResource TopTabItemMiddleGlowBorder}" CornerRadius="4,4,0,0">
                <Border BorderThickness="1,1,1,0" BorderBrush="{StaticResource TabItemInnerGlowBorder}" CornerRadius="4,4,0,0" />
              </Border>
            </Border>
            <ContentPresenter ContentSource="Header" Margin="12,5,12,3" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible" />
			  <Setter Property="Foreground" Value="{StaticResource RibbonForeground}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition SourceName="Grid" Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================ -->
  <!--   Ribbon style   -->
  <!-- ================ -->

  <SolidColorBrush x:Key="RibbonBorder" Color="#BEBEBE" />
  <SolidColorBrush x:Key="BottomRibbonBorder" Color="#5C5C5C" />

  <LinearGradientBrush x:Key="RibbonInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D7DADF" />
    <GradientStop Offset="1" Color="#D6DCDD" />
  </LinearGradientBrush>

  <Style TargetType="{x:Type ms:Ribbon}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:Ribbon}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="#CCCCCC" CornerRadius="3" Height="2" VerticalAlignment="Bottom" Grid.Row="1" Margin="1,0,1,0">
              <Border.BitmapEffect>
                <DropShadowBitmapEffect Color="#CCCCCC" Opacity="0.5" Direction="-90" ShadowDepth="1" Softness="0.1" />
              </Border.BitmapEffect>
            </Border>
            <Border BorderThickness="1,1,1,0" CornerRadius="3" BorderBrush="{StaticResource RibbonBorder}"
                    Height="91" Margin="1,0,1,0" Grid.Row="1">
              <Border BorderThickness="0,0,0,1" CornerRadius="3" BorderBrush="{StaticResource BottomRibbonBorder}" Background="{StaticResource RibbonInnerBorder}">
                <Border CornerRadius="2" Background="{StaticResource RibbonContentBackground}" Margin="1">
                  <ItemsControl ItemsSource="{Binding SelectedItem.Items, RelativeSource={RelativeSource TemplatedParent}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ms:RibbonTabPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Border>
              </Border>
            </Border>
            <Border Background="{TemplateBinding Background}" />
            <ItemsPresenter Margin="20,2,0,-1" MinHeight="23" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>