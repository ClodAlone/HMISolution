  <SolidColorBrush x:Key="PopupResizerBorder" Color="#E1E1E1" />
  <SolidColorBrush x:Key="PopupResizerGripperDarkBrush" Color="#7C7C7C" />
  <SolidColorBrush x:Key="PopupResizerGripperLightBrush" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="PopupResizerBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFFF" />
    <GradientStop Offset="1" Color="#C6C6C6" />
  </LinearGradientBrush>

  <ControlTemplate x:Key="EdgeThumbTemplate">
    <Border Background="Transparent">
      <Border Height="5" Width="20" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1">
        <Border.Background>
          <DrawingBrush Viewport="0,0,5,5" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Geometry="M 0 0 L 5 0 L 5 5 L 0 5 Z" Brush="Transparent" />
                <GeometryDrawing Geometry="M 2 2 L 4 2 L 4 4 L 2 4 Z" Brush="{StaticResource PopupResizerGripperLightBrush}" />
                <GeometryDrawing Geometry="M 1 1 L 3 1 L 3 3 L 1 3 Z" Brush="{StaticResource PopupResizerGripperDarkBrush}" />
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Background>
      </Border>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="CornerThumbTemplate">
    <Border Background="Transparent" Height="10" Width="10">
      <Border Height="8" Width="8" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"
              Clip="{TemplateBinding Tag}">
        <Border.Background>
          <DrawingBrush Viewport="0,1,4,4" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Geometry="M 0 0 L 4 0 L 4 4 L 0 4 Z" Brush="Transparent" />
                <GeometryDrawing Geometry="M 0 1 L 2 1 L 2 3 L 0 3 Z" Brush="{StaticResource PopupResizerGripperLightBrush}" />
                <GeometryDrawing Geometry="M 1 0 L 3 0 L 3 2 L 1 2 Z" Brush="{StaticResource PopupResizerGripperDarkBrush}" />
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Border.Background>
      </Border>
    </Border>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:PopupResizer}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource PopupResizerBorder}" />
    <Setter Property="Background" Value="{StaticResource PopupResizerBackground}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ms:PopupResizer}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <Thumb Name="PART_Thumb" Template="{StaticResource EdgeThumbTemplate}" Cursor="SizeNS" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Position" Value="BottomRight">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNWSE" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 3 0 L 8 0 L 8 8 L 0 8 L 0 4 L 3 4 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Position" Value="BottomLeft">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Left" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNESW" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 0 0 L 3 0 L 3 4 L 8 4 L 8 8 L 0 8 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Position" Value="TopRight">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNESW" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 0 0 L 8 0 L 8 8 L 4 8 L 4 4 L 0 4 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Position" Value="TopLeft">
              <Setter TargetName="PART_Thumb" Property="Template" Value="{StaticResource CornerThumbTemplate}"  />
              <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Left" />
              <Setter TargetName="PART_Thumb" Property="Cursor" Value="SizeNWSE" />
              <Setter TargetName="PART_Thumb" Property="Tag">
                <Setter.Value>
                  <PathGeometry Figures="M 0 0 L 8 0 L 8 4 L 4 4 L 4 8 L 0 8 Z" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

