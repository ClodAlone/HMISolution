  <SolidColorBrush x:Key="MouseOverSplitBorder" Color="#CCBD89" />
  <SolidColorBrush x:Key="MouseOverTopSplitBackground" Color="#FFF5DA" />
  <SolidColorBrush x:Key="MouseOverBottomSplitBackground" Color="#FFF0BF" />
  <SolidColorBrush x:Key="PressedButtonSplitBorder" Color="#937A52" />
  <SolidColorBrush x:Key="PressedButtonSplitBackground" Color="#FFD6A9" />
  <SolidColorBrush x:Key="PressedToggleButtonSplitBorder" Color="#CEBE86" />
  <SolidColorBrush x:Key="PressedToggleButtonSplitBackground" Color="#FFF4D9" />

  <LinearGradientBrush x:Key="MouseOverSplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFEF2" />
    <GradientStop Offset="0.4" Color="#FFF7D7" />
    <GradientStop Offset="0.4" Color="#FFF1BF" />
    <GradientStop Offset="1" Color="#FFF7D9" />
  </LinearGradientBrush>

  <ms:ArithmeticConverter x:Key="PlusFour" Additive="4" />

  <ControlTemplate x:Key="LargeSplitButtonTemplate" TargetType="{x:Type ms:SplitButton}">
    <Grid Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Name="Border" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2" Grid.RowSpan="2">
        <Border Name="Background" Margin="1" />
      </Border>
      <Border Name="ButtonBorder" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2"
              Grid.RowSpan="2" ms:ClipToElement.ClipToElement="{Binding ElementName=IconHost}">
        <Border Name="ButtonBackground" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2" Padding="2,1,3,2" />
      </Border>
      <ToggleButton Name="ToggleButton" Style="{StaticResource SplitButtonToggleButtonStyle}" Grid.RowSpan="2"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    ms:ClipToElement.ClipToElement="{Binding ElementName=ContentHost}" />
      <Border Name="IconHost" VerticalAlignment="Top">
        <ContentControl Content="{TemplateBinding ms:Ribbon.LargeIcon}" IsHitTestVisible="False" Margin="4,3,5,1" />
      </Border>
      <Grid Name="ContentHost" Grid.Row="1" IsHitTestVisible="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="Split" BorderThickness="0,1,0,0" Height="2" Margin="1,0,1,0" />
        <ContentPresenter ContentTemplate="{StaticResource DropDownContentTemplate}" Margin="3,-4,4,1" Grid.Row="1" VerticalAlignment="Bottom" />
      </Grid>
      <Popup Name="Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
             AllowsTransparency="True" StaysOpen="False">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                  Style="{StaticResource ShadowStyle}" MinWidth="{TemplateBinding ActualWidth}">
            <Border BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}">
              <ms:PopupMenu ItemsSource="{Binding DropDownItems, RelativeSource={RelativeSource TemplatedParent}}" />
            </Border>
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverRibbonButtonBorder}" />
        <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverRibbonButtonInnerBorder}" />
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
      </Trigger>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
      </Trigger>
      <DataTrigger Binding="{Binding DropDownItems.Count, RelativeSource={RelativeSource Self}}" Value="0">
        <Setter TargetName="DropDownBorder" Property="Height" Value="45" />
      </DataTrigger>
      <Trigger SourceName="ButtonBorder" Property="IsMouseOver" Value="True">
        <Setter TargetName="Split" Property="BorderBrush" Value="{StaticResource MouseOverSplitBorder}" />
        <Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverTopSplitBackground}" />
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource MouseOverRibbonButtonBorder}" />
        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MouseOverRibbonButtonBackground}" />
        <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="{StaticResource MouseOverRibbonButtonInnerBorder}" />
      </Trigger>
      <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
        <Setter TargetName="Split" Property="BorderBrush" Value="{StaticResource MouseOverSplitBorder}" />
        <Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverBottomSplitBackground}" />
      </Trigger>
      <Trigger SourceName="ToggleButton" Property="IsPressed" Value="True">
        <Setter TargetName="Split" Property="BorderBrush" Value="{StaticResource PressedToggleButtonSplitBorder}" />
        <Setter TargetName="Split" Property="Background" Value="{StaticResource PressedToggleButtonSplitBackground}" />
      </Trigger>
      <Trigger SourceName="ToggleButton" Property="IsChecked" Value="True">
        <Setter TargetName="Split" Property="BorderBrush" Value="{StaticResource PressedToggleButtonSplitBorder}" />
        <Setter TargetName="Split" Property="Background" Value="{StaticResource PressedToggleButtonSplitBackground}" />
      </Trigger>
      <Trigger Property="Command" Value="{x:Null}">
        <Setter TargetName="ToggleButton" Property="ms:ClipToElement.ClipToElement" Value="{x:Null}" />
        <Setter TargetName="Split" Property="Opacity" Value="0" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PressedRibbonButtonBorder}" />
        <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedRibbonButtonBackground}" />
        <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1,1,1,0" />
        <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="{StaticResource PressedRibbonButtonInnerBorder}" />
        <Setter TargetName="ButtonBackground" Property="BorderThickness" Value="1,0,1,1" />
        <Setter TargetName="Split" Property="BorderBrush" Value="{StaticResource PressedButtonSplitBorder}" />
        <Setter TargetName="Split" Property="Background" Value="{StaticResource PressedButtonSplitBackground}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <SolidColorBrush x:Key="MouseOverVerticalSplitBorder" Color="#CDB175" />
  <SolidColorBrush x:Key="PressedVerticalSplitBorder" Color="#AD7E48" />

  <ControlTemplate x:Key="MediumSplitButtonTemplate" TargetType="{x:Type ms:SplitButton}">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Name="Border" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2" Grid.ColumnSpan="2">
        <Border Name="Background" Margin="1" />
      </Border>
      <Border Name="ButtonBorder" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2" Grid.ColumnSpan="2"
              ms:ClipToElement.ClipToElement="{Binding ElementName=ContentHost}">
        <Border Name="ButtonBackground" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2" Padding="2,1,3,2" />
      </Border>
      <ToggleButton Name="ToggleButton" Style="{StaticResource SplitButtonToggleButtonStyle}" Grid.ColumnSpan="2"
                    ms:ClipToElement.ClipToElement="{Binding ElementName=DropDownArrowHost}"
