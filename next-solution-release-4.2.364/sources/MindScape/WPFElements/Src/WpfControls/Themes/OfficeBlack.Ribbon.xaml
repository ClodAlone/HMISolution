  <Style x:Key="GalleryButtonStyle" TargetType="ButtonBase">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GalleryButtonDarkForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Name="Border" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Tag}"
                  BorderBrush="{StaticResource GalleryBorder}" Background="{StaticResource GalleryButtonInnerBorder}">
            <Border Name="Background" Margin="1" Background="{StaticResource GalleryButtonBackground}" CornerRadius="{TemplateBinding Tag}">
              <ContentPresenter />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverGalleryButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverGalleryButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverGalleryButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedGalleryButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedGalleryButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedGalleryButtonBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledGalleryButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DisabledGalleryButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource DisabledGalleryButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledGalleryButtonForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ms:ArithmeticConverter x:Key="Plus24" Additive="24" />

  <ControlTemplate x:Key="GalleryTemplate" TargetType="{x:Type ms:Gallery}">
    <Grid VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="15" />
      </Grid.ColumnDefinitions>
      <Border Name="Background" BorderThickness="1,1,0,1" BorderBrush="{TemplateBinding BorderBrush}"
              Background="{TemplateBinding Background}">
        <ms:GalleryItemsPresenter Name="ItemsHost" ItemsSource="{TemplateBinding GalleryItems}" Margin="{TemplateBinding Padding}"
                                  ItemTemplate="{TemplateBinding ItemTemplate}" ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}">
          <ms:GalleryItemsPresenter.ItemsPanel>
            <ItemsPanelTemplate>
              <ms:GalleryPanel ClipToBounds="True" />
            </ItemsPanelTemplate>
          </ms:GalleryItemsPresenter.ItemsPanel>
        </ms:GalleryItemsPresenter>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <RepeatButton Style="{StaticResource GalleryButtonStyle}" Command="{x:Static ms:GalleryCommands.NavigateUpCommand}">
          <RepeatButton.Tag>
            <sys:CornerRadius TopRight="2" />
          </RepeatButton.Tag>
          <Grid Width="5" Height="4">
            <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased" Fill="{StaticResource GalleryButtonLightForeground}"
                  Data="M 0 3 L 3 0 L 5 3 Z" Margin="0,0,0,1" />
            <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                  Data="M 0 3 L 3 0 L 5 3 Z" Margin="0,1,0,0" />
          </Grid>
        </RepeatButton>
        <RepeatButton Grid.Row="1" Style="{StaticResource GalleryButtonStyle}" Command="{x:Static ms:GalleryCommands.NavigateDownCommand}">
          <Grid Width="5" Height="4">
            <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased" Fill="{StaticResource GalleryButtonLightForeground}"
                  Data="M 0 0 L 5 0 L 3 3 Z" Margin="0,1,0,0" />
            <Path Width="5" Height="3" RenderOptions.EdgeMode="Aliased"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                  Data="M 0 0 L 5 0 L 3 3 Z" Margin="0,0,0,1" />
          </Grid>
        </RepeatButton>
        <ToggleButton Name="DropDownButton" Grid.Row="2" Style="{StaticResource GalleryButtonStyle}">
          <ToggleButton.Tag>
            <sys:CornerRadius BottomRight="2" />
          </ToggleButton.Tag>
          <Grid Width="7" Height="7">
            <Path Width="7" Height="6" RenderOptions.EdgeMode="Aliased" Fill="{StaticResource GalleryButtonLightForeground}"
                  Data="M 0 0 L 7 0 L 7 1 L 0 1 Z M 0 2 L 7 2 L 4 6 Z" Margin="0,1,0,0" />
            <Path Width="7" Height="6" RenderOptions.EdgeMode="Aliased"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                  Data="M 0 0 L 7 0 L 7 1 L 0 1 Z M 1 3 L 6 3 L 4 6 Z" Margin="0,0,0,1" />
          </Grid>
        </ToggleButton>
      </Grid>
      <Popup Name="Popup" MinWidth="{TemplateBinding ActualWidth}" Width="{TemplateBinding ActualWidth}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=DropDownButton}"
             Placement="Relative" StaysOpen="False" AllowsTransparency="True" ClipToBounds="False" MinHeight="100">
        <Grid Name="DropDown" SnapsToDevicePixels="True">
          <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                  Style="{StaticResource ShadowStyle}">
            <Border BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}">
              <ms:PopupMenu>
                <ms:Gallery />
                <ms:PopupResizer DockPanel.Dock="Bottom" ResizeMode="Corner" />
              </ms:PopupMenu>
            </Border>
          </Border>
        </Grid>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverGalleryBackground}" />
      </Trigger>
      <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
        <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
        <Setter TargetName="Popup" Property="MinWidth" Value="{Binding ActualWidth, Converter={StaticResource Plus24}, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter TargetName="Popup" Property="Width" Value="{Binding ActualWidth, Converter={StaticResource Plus24}, RelativeSource={RelativeSource TemplatedParent}}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="GalleryInPopupTemplate" TargetType="{x:Type ms:Gallery}">
    <ScrollViewer VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
      <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" />
    </ScrollViewer>
  </ControlTemplate>

  <Style TargetType="{x:Type ms:Gallery}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource GalleryBorder}" />
    <Setter Property="Background" Value="{StaticResource GalleryBackground}" />
    <Setter Property="Template" Value="{StaticResource GalleryInPopupTemplate}" />
