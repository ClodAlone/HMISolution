  <!-- ==================================== -->
  <!--   Ribbon DropDownColorPicker style   -->
  <!-- ==================================== -->

  <DataTemplate x:Key="ColorPickerHeaderTemplate">
    <Grid>
      <ContentControl Name="IconHost" Content="{Binding Path=(ms:Ribbon.SmallIcon), RelativeSource={RelativeSource AncestorType={x:Type ms:DropDownColorPicker}}}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="3,0,0,0" />
      <Border Background="{Binding Converter={StaticResource ColorToBrush}}"
              Height="4" VerticalAlignment="Bottom" Width="{Binding ActualWidth, ElementName=IconHost}" HorizontalAlignment="Right" />
    </Grid>
    <DataTemplate.Triggers>
      <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <Style x:Key="{x:Static ms:Ribbon.DropDownColorPickerStyleKey}" TargetType="ms:DropDownColorPicker">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
	<Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="HeaderTemplate" Value="{StaticResource ColorPickerHeaderTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ms:DropDownColorPicker">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Name="Border" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2" Grid.ColumnSpan="2">
              <Border Name="Background" Margin="1" />
            </Border>
            <Button Name="Button" Template="{StaticResource MediumButtonTemplate}" Grid.ColumnSpan="2" ms:ClipToElement.ClipToElement="{Binding ElementName=IconHost}" />
            <ToggleButton Name="ToggleButton" Style="{StaticResource SplitButtonToggleButtonStyle}" Grid.ColumnSpan="2"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ms:ClipToElement.ClipToElement="{Binding ElementName=ContentHost}" />

            <StackPanel Name="IconHost" Orientation="Horizontal" IsHitTestVisible="False">
              <ContentControl Content="{TemplateBinding SelectedColor}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
              <Border Name="Split" Width="1" Margin="1,1,0,1" />
            </StackPanel>
            <StackPanel Name="ContentHost" Orientation="Horizontal" Grid.Column="1">
              <ContentPresenter Name="ContentPresenter" Content="{TemplateBinding ms:Ribbon.EditorHeader}" VerticalAlignment="Center" Margin="1,0,0,0" IsHitTestVisible="False" />
              <Border IsHitTestVisible="False">
                <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" VerticalAlignment="Center" Margin="3,0,4,0" />
              </Border>
            </StackPanel>

            <Popup Name="Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True" StaysOpen="False">
              <Grid Name="DropDown" SnapsToDevicePixels="True">
                <!-- TODO: need to revise what is responsible for providing the drop down border. -->
                <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="0"
                        Style="{StaticResource ShadowStyle}" MinWidth="{TemplateBinding ActualWidth}">
                  <Border BorderThickness="0" BorderBrush="{StaticResource PopupInnerBorder}">
                    <ContentPresenter Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type ms:DropDownColorPicker}}}" ContentTemplate="{TemplateBinding DropDownTemplate}" />
                  </Border>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverRibbonButtonBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverRibbonButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverSplitButtonBackground}" />
              <Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverVerticalSplitBorder}" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
            </Trigger>
            <Trigger SourceName="ToggleButton" Property="IsChecked" Value="True">
              <Setter TargetName="Split" Property="Background" Value="{StaticResource MouseOverVerticalSplitBorder}" />
            </Trigger>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentPresenter" Property="Content" Value="Small">
              <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="Button" Property="IsPressed" Value="True">
              <Setter TargetName="Split" Property="Background" Value="{StaticResource PressedVerticalSplitBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

