  <SolidColorBrush x:Key="PressedComboBoxButtonInnerBorder" Color="#FFB31B" />

  <LinearGradientBrush x:Key="MouseOverComboBoxButtonInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFFB" />
    <GradientStop Offset="1" Color="#FFFCF3" />
