    <GradientStop Offset="1" Color="#EFF2F6" />
  </LinearGradientBrush>

  <Style x:Key="RichComboBoxToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2,2,3,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <Border Name="Border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" Background="Transparent"
                    Width="14" HorizontalAlignment="Right">
              <Border Name="Background" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseNearComboBoxButtonBackground}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseNearComboBoxButtonBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseNearComboBoxButtonBackground}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseNearComboBoxButtonBackground}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinButtonBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource MouseOverComboBoxButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource MouseOverComboBoxButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedComboBoxButtonBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource PressedComboBoxButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource PressedComboBoxButtonBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource IsCheckedComboBoxButtonBorder}" />
              <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource IsCheckedComboBoxButtonInnerBorder}" />
              <Setter TargetName="Background" Property="Background" Value="{StaticResource IsCheckedComboBoxButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static ms:Ribbon.ComboBoxStyleKey}" TargetType="ComboBox">
    <Setter Property="Padding" Value="3,1,3,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MaxDropDownHeight" Value="500" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <DockPanel LastChildFill="True">
            <ContentControl Name="IconHost" Content="{TemplateBinding ms:Ribbon.SmallIcon}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="3,0,5,0" IsHitTestVisible="False" DockPanel.Dock="Left" />
            <Grid DockPanel.Dock="Right" Width="{TemplateBinding ms:Ribbon.EditorWidth}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
              </Grid.ColumnDefinitions>
              <Border Name="Border" Background="{StaticResource SpinDecoratorBackground}"
                      BorderThickness="1" BorderBrush="{StaticResource SpinDecoratorBorder}" Grid.ColumnSpan="2" />

              <Border Padding="2">
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
              </Border>
              <TextBox VerticalAlignment="Center" Padding="{TemplateBinding Padding}"
                       BorderThickness="0" x:Name="PART_EditableTextBox" IsReadOnly="{TemplateBinding IsReadOnly}"
                       Visibility="Hidden" Focusable="True" Background="Transparent" />

              <ToggleButton Name="ToggleButton" Grid.ColumnSpan="2" Style="{StaticResource RichComboBoxToggleButtonStyle}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentControl ContentTemplate="{StaticResource DropDownArrowTemplate}" HorizontalAlignment="Center" Margin="2,4,3,4" Grid.Row="2" />
              </ToggleButton>
              <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Grid Name="DropDown" SnapsToDevicePixels="True">
                  <Border Name="DropDownBorder" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" BorderThickness="1"
                          Style="{StaticResource ShadowStyle}" MinWidth="{Binding ActualWidth, ElementName=Border}">
                    <Border BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}">
                      <ScrollViewer Padding="0" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <VirtualizingStackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                      </ScrollViewer>
                    </Border>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ContentControl Name="ContentHost" Content="{TemplateBinding ms:Ribbon.EditorHeader}" Margin="0,0,5,0"
                            VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource RibbonForeground}" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSpinDecoratorBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinDecoratorBorder}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverSpinDecoratorBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverSpinDecoratorBorder}" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="Focusable" Value="True" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter TargetName="ToggleButton" Property="Grid.Column" Value="1" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="{StaticResource ShadowMargin}" />
            </Trigger>
            <Trigger Property="ms:Ribbon.EditorSize" Value="Small">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="ContentHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="IconHost" Property="Content" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

