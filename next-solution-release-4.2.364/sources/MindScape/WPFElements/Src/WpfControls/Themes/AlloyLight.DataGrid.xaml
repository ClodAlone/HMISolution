<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mindscape.WpfElements"
                    xmlns:dg="clr-namespace:Mindscape.WpfElements.WpfDataGrid"
                    xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
                    xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/AlloyLight.DateTimeControls.xaml" />
	<ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Common.Generic.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <local:BooleanToVisibilityConverter x:Key="bvc_hidden" Invisibility="Hidden" />
  <dg:DataGridPagerVisibilityConverter x:Key="DataGridPagerVisibility" />
  
  <SolidColorBrush x:Key="MouseOverDataGridBackground" Color="#A6A6A6" />
  <SolidColorBrush x:Key="SelectedDataGridBackground" Color="#757575" />

  <LinearGradientBrush x:Key="FrozenShadow" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#DD000000" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="FrozenRowShadow" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DD000000" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="ReadonlyTextColor" Color="#6D6D6D" />
  <SolidColorBrush x:Key="MouseOverDataGridBorder" Color="#F7CD34" />
  <SolidColorBrush x:Key="SelectedDataGridBorder" Color="#FB8C3C" />
  <SolidColorBrush x:Key="DataGridCellHighlightedBorder" Color="#000000" />
  <SolidColorBrush x:Key="DataGridCellNotValidBorder" Color="Red" />

  <!-- ================= -->
  <!--   Editor styles   -->
  <!-- ================= -->

  <!-- TextBox style -->

  <Style x:Key="DataGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="5,2,2,2" />
  </Style>

  <!-- IntegerTextBox style -->

  <Style x:Key="DataGridIntegerTextBoxStyle" TargetType="{x:Type local:IntegerTextBox}" BasedOn="{StaticResource {x:Type local:IntegerTextBox}}">
    <Setter Property="Padding" Value="5,2,2,2" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- NumericTextBox style -->

  <Style x:Key="DataGridNumericTextBoxStyle" TargetType="{x:Type local:NumericTextBox}" BasedOn="{StaticResource {x:Type local:NumericTextBox}}">
    <Setter Property="Padding" Value="5,2,2,2" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- DropDownDatePicker style -->

  <Style x:Key="DataGridDatePickerStyle" TargetType="{x:Type local:DropDownDatePicker}" BasedOn="{StaticResource {x:Type local:DropDownDatePicker}}">
    <Setter Property="Padding" Value="2,1,1,1" />
    <Setter Property="Format" Value="ShortDate" />
  </Style>

  <!-- TimeSpanPicker style -->

  <Style x:Key="DataGridTimeSpanPickerStyle" TargetType="local:TimeSpanPicker" BasedOn="{StaticResource {x:Type local:TimeSpanPicker}}">
    <Setter Property="Padding" Value="5,2,2,2" />
  </Style>

  <!-- NumericUpDown style -->

  <Style x:Key="DataGridNumericUpDownStyle" TargetType="{x:Type local:NumericUpDown}" BasedOn="{StaticResource {x:Type local:NumericUpDown}}">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Padding" Value="5,2,2,2" />
  </Style>

  <!-- CheckBox style -->

  <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ComboBox styles -->

  <Style x:Key="DataGridComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Padding" Value="5,2,2,2" />
  </Style>

  <!-- ColorPicker styles -->

  <Style x:Key="DataGridColorPickerStyle" TargetType="{x:Type local:DropDownColorPicker}" BasedOn="{StaticResource {x:Type local:DropDownColorPicker}}">
    <Setter Property="Padding" Value="5,2,2,2" />
  </Style>

  <!-- ===================== -->
  <!--   Display templates   -->
  <!-- ===================== -->

  <!-- General text display template -->

  <DataTemplate x:Key="DisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding}" VerticalAlignment="Center" />
  </DataTemplate>
  
  <!-- Right aligned text display template -->

  <DataTemplate x:Key="RightAlignedDisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding}" VerticalAlignment="Center" TextAlignment="Right" />
  </DataTemplate>

  <!-- DateTime display template -->

  <local:FormattingConverter x:Key="DateTimeDisplayFormatConverter" FormatString="{}{0:d}" />

  <DataTemplate x:Key="DateTimeDisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding Converter={StaticResource DateTimeDisplayFormatConverter}}" VerticalAlignment="Center" />
  </DataTemplate>

  <!-- Collection display template -->

  <DataTemplate x:Key="CollectionDisplayTemplate">
    <StackPanel Orientation="Horizontal" Margin="3,4,2,4">
      <TextBlock Text="{Binding Count}" VerticalAlignment="Center" />
      <TextBlock Name="ItemText" Text=" items" VerticalAlignment="Center" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Value.Count}" Value="1">
        <Setter TargetName="ItemText" Property="Text" Value=" item" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Color display template -->

  <DataTemplate x:Key="ColorPickerDisplayTemplate">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{Binding Converter={StaticResource ColorToBrush}}"
              BorderBrush="Black" BorderThickness="1" Margin="5,3,6,3" SnapsToDevicePixels="True"
              Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
      <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource ColorToName}}" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <!-- CheckBox display template -->

  <DataTemplate x:Key="CheckBoxDisplayTemplate">
    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
              IsChecked="{Binding Content, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
  </DataTemplate>

  <!-- TimeSpan display template -->

  <local:TimeSpanToStringConverter x:Key="TimeSpanToString" />

  <DataTemplate x:Key="TimeSpanPickerDisplayTemplate">
    <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding Converter={StaticResource TimeSpanToString}}" VerticalAlignment="Center" />
  </DataTemplate>

  <!-- ======================== -->
  <!--   DataGridPager styles   -->
  <!-- ======================== -->

  <SolidColorBrush x:Key="DataGridPagerButtonBackground" Color="#B6B6B6" />
  <SolidColorBrush x:Key="MouseOverDataGridPagerButtonBackground" Color="#AAAAAA" />
  <SolidColorBrush x:Key="SelectedDataGridPagerButtonBackground" Color="#666666" />

  <Style x:Key="PagerButtonStyle" TargetType="RadioButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Name="Border" BorderThickness="1" BorderBrush="{StaticResource ButtonBorder}" Background="{StaticResource DataGridPagerButtonBackground}" Margin="-1,0,0,0">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverDataGridPagerButtonBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedDataGridPagerButtonBackground}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="PagerButtonTemplate">
    <RadioButton Style="{StaticResource PagerButtonStyle}" MinWidth="20" Height="20" Content="{Binding Content}"
                 IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="10" />
  </DataTemplate>

  <SolidColorBrush x:Key="DataGridPagerBackground" Color="#B6B6B6" />

  <local:ArithmeticConverter x:Key="PlusOne" Additive="1" />

  <Style TargetType="{x:Type dg:DataGridPager}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridPager}">
          <Border Background="{StaticResource DataGridPagerBackground}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}">
            <DockPanel LastChildFill="False">

              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                <Button Name="FirstPageButton" Command="{x:Static dg:DataGridCommands.FirstPage}" Width="18" Height="18" Margin="4,0,0,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Rectangle Fill="{Binding Foreground, ElementName=FirstPageButton}" Width="1" Height="7" SnapsToDevicePixels="True" />
                    <Path Data="M 0 0.5 L 1 0 L 1 1 Z" Fill="{Binding Foreground, ElementName=FirstPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                  </StackPanel>
                </Button>
                <RepeatButton Name="PreviousPageButton" Command="{x:Static dg:DataGridCommands.PreviousPage}" Width="18" Height="18" Margin="4,0,0,0">
                  <Path Data="M 0 0.5 L 1 0 L 1 1 Z" Fill="{Binding Foreground, ElementName=PreviousPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                </RepeatButton>

                <ItemsControl ItemsSource="{Binding PagerButtons, RelativeSource={RelativeSource TemplatedParent}}" Margin="4,0,0,0" ItemTemplate="{StaticResource PagerButtonTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <RepeatButton Name="NextPageButton" Command="{x:Static dg:DataGridCommands.NextPage}" Width="18" Height="18" Margin="4,0,0,0">
                  <Path Data="M 0 0 L 1 0.5 L 0 1 Z" Fill="{Binding Foreground, ElementName=NextPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                </RepeatButton>
                <Button Name="LastPageButton" Command="{x:Static dg:DataGridCommands.LastPage}" Width="18" Height="18" Margin="4,0,0,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M 0 0 L 1 0.5 L 0 1 Z" Fill="{Binding Foreground, ElementName=LastPageButton}" Stretch="Fill" Width="4" Height="7" SnapsToDevicePixels="True" />
                    <Rectangle Fill="{Binding Foreground, ElementName=LastPageButton}" Width="1" Height="7" SnapsToDevicePixels="True" />
                  </StackPanel>
                </Button>

              </StackPanel>

              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border Background="White" Width="1" Margin="5,6,10,6" SnapsToDevicePixels="True" />
                <TextBlock Text="Page" VerticalAlignment="Center" />
                <local:SpinDecorator ShowSpinUI="False" ValueProperty="Value" Padding="0" Margin="5,4,5,4" BorderThickness="0" Background="Transparent"
                                     MinimumProperty="Minimum" MaximumProperty="Maximum">
                  <local:IntegerTextBox Value="{Binding PageIndex, Converter={StaticResource PlusOne}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        VerticalAlignment="Center" MinWidth="40" Minimum="1" Maximum="{Binding DataGridItemsSource.PageCount, RelativeSource={RelativeSource TemplatedParent}}" />
                </local:SpinDecorator>
                <TextBlock Text="of" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DataGridItemsSource.PageCount, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="3" VerticalAlignment="Center" Margin="5,0,10,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================== -->
  <!--   DataGrid column styles   -->
  <!-- ========================== -->

  <Style x:Key="GridViewColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="Background" Value="{StaticResource Border}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Padding="{TemplateBinding Padding}" Background="Transparent">
            <Rectangle HorizontalAlignment="Center" Width="0" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <SolidColorBrush x:Key="MouseOverUngroupColumnButtonBorder" Color="#772011" />
  <SolidColorBrush x:Key="MouseOverUngroupColumnButtonInnerBorder" Color="#DAB3AF" />

  <LinearGradientBrush x:Key="MouseOverUngroupColumnButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D1A19C" />
    <GradientStop Offset="0.5" Color="#D47668" />
    <GradientStop Offset="0.5" Color="#C23823" />
    <GradientStop Offset="1" Color="#D17C63" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PressedUngroupColumnButtonBorder" Color="#703A28" />
  <SolidColorBrush x:Key="PressedUngroupColumnButtonInnerBorder" Color="#A48D87" />

  <LinearGradientBrush x:Key="PressedUngroupColumnButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D1A993" />
    <GradientStop Offset="0.5" Color="#B9765B" />
    <GradientStop Offset="0.5" Color="#8A1E08" />
    <GradientStop Offset="1" Color="#8E6B1F" />
  </LinearGradientBrush>

  <Style x:Key="UngroupColumnButton" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <Path Name="Path" StrokeThickness="2" Stroke="Gray" Data="M 0 0 L 1 1 M 1 0 L 0 1" StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round" Stretch="Fill" Width="7" Height="7" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Path" Property="Stroke" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <DataTemplate x:Key="ColumnFilterTemplate">
    <StackPanel>
      <ContentControl Content="{Binding Description}" ContentTemplateSelector="{StaticResource FilterDescriptionTemplateSelector}" />
	  <Button Content="Clear filter" Command="{x:Static dg:DataGridCommands.RemoveFilter}" CommandParameter="{Binding Column}" Margin="0,8,0,0" />
	</StackPanel>
  </DataTemplate>
  
  <dg:ColumnToColumnFilterConverter x:Key="ColumnToColumnFilter" />
  
  <SolidColorBrush x:Key="FilterPopupBackground" Color="#B6B6B6" />
  
  <Style x:Key="FilterButton" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
		<Grid>
          <Border Name="Border" CornerRadius="2" Background="Transparent">
            <Path Name="Path" Fill="#333333" Data="M 0 0 L 1 0 L 0.6 0.4 L 0.6 1 L 0.4 0.8 L 0.4 0.4 Z" StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round" Stretch="Fill" Width="10" Height="9" />
          </Border>
		    <dg:FilterPopup Name="Popup" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" StaysOpen="False" AllowsTransparency="True" Focusable="True">
			  <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}">
                <Border Name="DropDownBorder" Background="{StaticResource FilterPopupBackground}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        Style="{StaticResource ShadowStyle}" Padding="3">
				  <ContentControl Content="{Binding Column, Converter={StaticResource ColumnToColumnFilter}, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridColumnHeader}}}"
				                  ContentTemplate="{StaticResource ColumnFilterTemplate}" />
				</Border>
			  </Grid>
			</dg:FilterPopup>
		  </Grid>
          <ControlTemplate.Triggers>
		    <DataTrigger Binding="{Binding Column.Filter, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridColumnHeader}}}" Value="{x:Null}">
			  <Setter TargetName="Path" Property="Fill" Value="Gray" />
			</DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedBorder}" />
            </Trigger>
			<Trigger SourceName="Popup" Property="AllowsTransparency" Value="True">
              <Setter TargetName="DropDown" Property="Margin" Value="0,0,20,20" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <dg:DataGridColumnToFilterVisibilityConverter x:Key="FilterButtonVisibility" />

  <Style x:Key="GridViewColumnHeaderStyle" TargetType="{x:Type dg:DataGridColumnHeader}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
          <Grid>
            <Border BorderThickness="0,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="0">
			  <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
				<Grid.ColumnDefinitions>
				  <ColumnDefinition Width="*" />
				  <ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
                <ContentPresenter Name="HeaderContent" Margin="0,0,0,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
			    <ToggleButton Name="FilterButton" Style="{StaticResource FilterButton}" Grid.Column="1" Margin="8,1,0,0"
				              Visibility="{Binding Column, Converter={StaticResource FilterButtonVisibility}, RelativeSource={RelativeSource TemplatedParent}}" />
			  </Grid>
            </Border>
            <Path Data="M 0 1 L 0.5 0 L 1 1 Z" Stretch="Fill" Fill="Transparent" IsHitTestVisible="False" Width="5" Height="3" SnapsToDevicePixels="True"
                  VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,0,0" Name="SortArrow" />
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-8,0" Style="{StaticResource GridViewColumnHeaderGripper}"
                   IsEnabled="{Binding Column.AllowResize, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
			  <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition SourceName="FilterButton" Property="IsMouseOver" Value="False" />
              </MultiTrigger.Conditions>
              <Setter Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="{StaticResource PressedButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource Foreground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
            </Trigger>
            <DataTrigger Binding="{Binding Column.SortDirection, RelativeSource={RelativeSource Self}}" Value="Ascending">
              <Setter TargetName="SortArrow" Property="Fill" Value="{StaticResource MouseOverForeground}" />
              <Setter Property="Background" Value="{StaticResource CheckedButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Column.SortDirection, RelativeSource={RelativeSource Self}}" Value="Descending">
              <Setter TargetName="SortArrow" Property="Fill" Value="{StaticResource MouseOverForeground}" />
              <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 1 0 L 0.5 1 Z" />
              <Setter Property="Background" Value="{StaticResource CheckedButtonBackground}" />
              <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
            </DataTrigger>
			<DataTrigger Binding="{Binding IsColumnHeaderFilterVisible, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="False">
			  <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Column.AllowFiltering, RelativeSource={RelativeSource Self}}" Value="False">
			  <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Role" Value="Floating">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
              <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="0">
                <ContentPresenter Margin="0,0,0,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Role" Value="Padding">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
              <Border BorderThickness="0,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="0" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Role" Value="Grouping">
        <Setter Property="Margin" Value="11,0,0,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dg:DataGridColumnHeader}">
              <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="0">
                <Grid>
                  <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                  <Button Name="UngroupButton" Style="{StaticResource UngroupColumnButton}" VerticalAlignment="Center"
                          HorizontalAlignment="Right" Margin="3" Visibility="Hidden"
                          Command="{x:Static dg:DataGridCommands.UngroupColumn}" CommandParameter="{TemplateBinding Column}" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="UngroupButton" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="DataGridColumnHeaderTemplate">
    <TextBlock Text="{Binding}" Margin="0,4,0,2" Height="17" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </DataTemplate>
  
  <DataTemplate x:Key="GroupedDataGridColumnHeaderTemplate">
    <TextBlock Text="{Binding}" Margin="22,1,22,1" IsHitTestVisible="False" VerticalAlignment="Center" />
  </DataTemplate>

  <SolidColorBrush x:Key="HeaderDropIndicatorBackground" Color="#FFB85A" />
  
  <DataTemplate x:Key="ColumnHeaderIndentTemplate">
    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource Border}" Background="{StaticResource ButtonBackground}"
            Width="{Binding GroupingIndent, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
  </DataTemplate>

  <Style x:Key="{x:Type dg:DataGridHeaderRowPresenter}" TargetType="{x:Type dg:DataGridHeaderRowPresenter}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridHeaderRowPresenter}">
          <DockPanel>
            <ItemsControl ItemsSource="{Binding GroupedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                          ItemTemplate="{StaticResource ColumnHeaderIndentTemplate}" DockPanel.Dock="Left">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ItemsPresenter ClipToBounds="True" />
              <ContentControl Content="{Binding PaddingColumnHeader, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1" />
              <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Grid.ColumnSpan="2"
                          Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
                <Border Width="4" Background="{StaticResource FrozenShadow}" />
              </StackPanel>
              <Grid Margin="-5,0,5,1" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.ColumnSpan="2"
                    Visibility="{Binding IsRequestingColumnDropPosition, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="Transform" X="{Binding ColumnDropRequestPosition, RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid.RenderTransform>
                <Border Width="3" Background="{StaticResource HeaderDropIndicatorBackground}" HorizontalAlignment="Center" />
                <Path Width="9" Height="7" Data="M 0 0 L 1 0 L 0.5 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Center" />
                <Path Width="9" Height="7" Data="M 0.5 0 L 0 1 L 1 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
              </Grid>
            </Grid>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= -->
  <!--   Row and cell styles   -->
  <!-- ======================= -->

  <Style x:Key="{x:Static local:DataGrid.ExpanderToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <Path Name="Path" Data="M 0 0 L 6 4 L 0 8" Fill="{StaticResource TreeViewArrowBrush}" Margin="4" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Path" Property="Data" Value="M 0 0 L 8 0 L 4 6" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
              <Setter TargetName="Path" Property="Fill" Value="{StaticResource SelectedTreeViewArrowBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Path" Property="Fill" Value="{StaticResource MouseOverTreeViewArrowBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <pg:LevelToIndentConverter x:Key="ExpandableCellIndentConverter" />

  <ControlTemplate x:Key="ExpandableCellTemplate" TargetType="dg:DataGridCellContainer">
    <Border Name="ColoredBackground" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle Width="{Binding Row.HierarchyLevel, Converter={StaticResource ExpandableCellIndentConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
        <ToggleButton Style="{DynamicResource {x:Static local:DataGrid.ExpanderToggleButtonStyleKey}}" Grid.Column="1" VerticalAlignment="Center"
                      IsChecked="{Binding Row.IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static dg:DataGridCommands.ToggleExpandedState}"
                      Visibility="{Binding Row.HasChildren, Converter={StaticResource bvc_hidden}, RelativeSource={RelativeSource TemplatedParent}}" />
        <Grid Grid.Column="2">
          <Rectangle Name="Border" StrokeThickness="1" Stroke="Transparent" Fill="Transparent" IsHitTestVisible="False" />
          <ContentPresenter />
          <Rectangle Name="TopBorder" StrokeThickness="2" Stroke="Transparent" IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Border" Property="Fill" Value="{StaticResource MouseOverDataGridBackground}" />
      </Trigger>
      <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row">
        <Setter TargetName="Border" Property="Fill" Value="Transparent" />
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Border" Property="Fill" Value="{StaticResource SelectedDataGridBackground}" />
        <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
      </Trigger>
	  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
	    <Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </DataTrigger>
	  <MultiDataTrigger>
	    <MultiDataTrigger.Conditions>
		  <Condition Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row" />
		  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True" />
		</MultiDataTrigger.Conditions>
		<Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </MultiDataTrigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="Black" />
      </Trigger>
      <Trigger Property="IsEditing" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="#333333" />
        <Setter TargetName="Border" Property="Fill" Value="#333333" />
      </Trigger>
      <Trigger Property="IsValid" Value="False">
        <Setter TargetName="TopBorder" Property="Stroke" Value="{StaticResource DataGridCellNotValidBorder}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  
  <ControlTemplate x:Key="DetailedDataGridCellTemplate" TargetType="dg:DataGridCellContainer">
    <Border Name="ColoredBackground" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Grid>
        <Rectangle Name="Border" StrokeThickness="1" Stroke="Transparent" Fill="Transparent" IsHitTestVisible="False" />
        <ContentPresenter />
        <Rectangle Name="TopBorder" StrokeThickness="2" Stroke="Transparent" IsHitTestVisible="False" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Border" Property="Fill" Value="{StaticResource MouseOverDataGridBackground}" />
      </Trigger>
      <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row">
        <Setter TargetName="Border" Property="Fill" Value="Transparent" />
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Border" Property="Fill" Value="{StaticResource SelectedDataGridBackground}" />
        <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
      </Trigger>
	  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
	    <Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </DataTrigger>
	  <MultiDataTrigger>
	    <MultiDataTrigger.Conditions>
		  <Condition Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row" />
		  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True" />
		</MultiDataTrigger.Conditions>
		<Setter TargetName="ColoredBackground" Property="Background" Value="Transparent" />
	  </MultiDataTrigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="Black" />
      </Trigger>
      <Trigger Property="IsEditing" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="#EDEDED" />
        <Setter TargetName="Border" Property="Fill" Value="#EDEDED" />
      </Trigger>
      <Trigger Property="IsValid" Value="False">
        <Setter TargetName="TopBorder" Property="Stroke" Value="{StaticResource DataGridCellNotValidBorder}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="DataGridCellContainerStyle" TargetType="dg:DataGridCellContainer">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dg:DataGridCellContainer">
          <Border BorderBrush="{StaticResource Border}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
      <Trigger Property="IsValid" Value="False">
        <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
      </Trigger>
	  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True">
	    <Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
	  </DataTrigger>
	  <MultiDataTrigger>
	    <MultiDataTrigger.Conditions>
		  <Condition Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Row" />
		  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type dg:DataGridRow}}}" Value="True" />
		</MultiDataTrigger.Conditions>
		<Setter Property="Template" Value="{StaticResource DetailedDataGridCellTemplate}" />
	  </MultiDataTrigger>
      <Trigger Property="IsExpandableCell" Value="True">
        <Setter Property="Template" Value="{StaticResource ExpandableCellTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <SolidColorBrush x:Key="DataGridRowHeaderBackground" Color="#B6B6B6" />
  <SolidColorBrush x:Key="GroupIndentBackground" Color="#EDEDED" />

  <local:DataGridIndentConverter x:Key="DataGridIndentConverter" />

  <Style TargetType="dg:DataGridRow">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
	<Setter Property="ItemContainerStyle" Value="{StaticResource DataGridCellContainerStyle}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <dg:DataGridRowPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dg:DataGridRow">
          <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" Grid.ColumnSpan="3" />
            <!-- Row header: -->
            <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Border}" Margin="0,0,0,1" Background="{StaticResource DataGridRowHeaderBackground}"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Name="RowHeader" 
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <ContentPresenter ContentTemplate="{Binding RowHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
            </Border>
            <!-- Grouping indent: -->
            <Border Background="{StaticResource GroupIndentBackground}" Grid.Column="1"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,0">
              <Border.Width>
                <MultiBinding Converter="{StaticResource DataGridIndentConverter}">
                  <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="GroupingIndent" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                </MultiBinding>
              </Border.Width>
            </Border>
            <!-- Cells: -->
            <Border Name="Border" Background="Transparent" Grid.Column="2" />
            <ItemsPresenter Grid.Column="2" />
            <StackPanel Orientation="Horizontal" Grid.Column="2"
                        Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
              <Border Width="4" Background="{StaticResource FrozenShadow}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverDataGridBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="RowAndCell">
              <Setter TargetName="Border" Property="Background" Value="Transparent" />
            </DataTrigger>
            <Trigger SourceName="RowHeader" Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverDataGridBackground}" />
            </Trigger>
            <DataTrigger Binding="{Binding SelectionType, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Value="Cell">
              <Setter TargetName="Border" Property="Background" Value="Transparent" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedDataGridBackground}" />
              <Setter Property="Foreground" Value="{StaticResource MouseOverForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================== -->
  <!--   Grouping styles   -->
  <!-- =================== -->

  <SolidColorBrush x:Key="DataGridGroupingPanelBackground" Color="#B6B6B6" />

  <Style x:Key="{x:Type dg:DataGridGroupingPanel}" TargetType="{x:Type dg:DataGridGroupingPanel}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Background" Value="{StaticResource DataGridGroupingPanelBackground}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridGroupingPanel}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <Grid>
              <TextBlock Name="Description" Margin="15,6,6,6" Text="Drag and drop a column header here to group by that column" />
              <ItemsPresenter Margin="5,2,0,2" />
              <Grid Margin="-5,2,5,2" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.ColumnSpan="2"
                    Visibility="{Binding IsRequestingColumnDropPosition, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="Transform" X="{Binding ColumnDropRequestPosition, RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid.RenderTransform>
                <Border Width="3" Background="{StaticResource HeaderDropIndicatorBackground}" HorizontalAlignment="Center" />
                <Path Width="9" Height="7" Data="M 0 0 L 1 0 L 0.5 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Center" />
                <Path Width="9" Height="7" Data="M 0.5 0 L 0 1 L 1 1 Z" Fill="{StaticResource HeaderDropIndicatorBackground}" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="Description" Property="Visibility" Value="Hidden" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dg:DataGridGroupingRow">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource DataGridRowHeaderBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dg:DataGridGroupingRow">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource Border}" Background="{StaticResource DataGridRowHeaderBackground}"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <ContentPresenter ContentTemplate="{Binding GroupRowHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
            </Border>

            <Border Grid.Column="1">
              <Border.Width>
                <MultiBinding Converter="{StaticResource DataGridIndentConverter}">
                  <Binding Path="GroupedColumns.Count" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                  <Binding Path="GroupingIndent" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                </MultiBinding>
              </Border.Width>
            </Border>

			<Border Grid.Column="1" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border}" />
			
			<ItemsPresenter Grid.Column="2" />
            
			<StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
			  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Border.Width>
                  <MultiBinding Converter="{StaticResource DataGridIndentConverter}">
                    <Binding Path="Group.Level" Mode="OneWay" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="GroupingIndent" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
                  </MultiBinding>
                </Border.Width>
              </Border>
			  <ToggleButton Style="{DynamicResource {x:Static local:DataGrid.ExpanderToggleButtonStyleKey}}" DockPanel.Dock="Left" VerticalAlignment="Center"
				            IsChecked="{Binding Group.IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
			  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderThickness="0,0,0,1">
			    <ContentPresenter Content="{Binding Group.GroupName, RelativeSource={RelativeSource TemplatedParent}}"
				   			      VerticalAlignment="Center" Margin="7,5,12,5" DockPanel.Dock="Left"
								  ContentTemplate="{TemplateBinding HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" />
			  </Border>
			</StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= -->
  <!--   Filter styles   -->
  <!-- ================= -->
  
  <Style x:Key="FilterCellContainerStyle" TargetType="ContentControl">
    <Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate TargetType="ContentControl">
		  <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Border}">
		    <ContentPresenter />
		  </Border>
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <Style x:Key="{x:Type dg:DataGridFilterRow}" TargetType="{x:Type dg:DataGridFilterRow}">
	<Setter Property="ItemContainerStyle" Value="{StaticResource FilterCellContainerStyle}" />
	<Setter Property="Background" Value="{StaticResource DataGridRowHeaderBackground}" />
    <Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate>
		  <DockPanel Background="{TemplateBinding Background}">
		    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource Border}" Background="{StaticResource DataGridRowHeaderBackground}"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Name="RowHeader"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			<ItemsControl ItemsSource="{Binding GroupedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			              DockPanel.Dock="Left">
			  <ItemsControl.ItemsPanel>
			    <ItemsPanelTemplate>
			      <StackPanel Orientation="Horizontal" />
			    </ItemsPanelTemplate>
			  </ItemsControl.ItemsPanel>
		      <ItemsControl.ItemTemplate>
				<DataTemplate>
				  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderThickness="0,0,1,1" BorderBrush="{StaticResource Border}"
					      Width="{Binding GroupingIndent, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
				</DataTemplate>
		      </ItemsControl.ItemTemplate>
			</ItemsControl>
			<Grid>
			  <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border}">
			    <ItemsPresenter />
		      </Border>
			  <StackPanel Orientation="Horizontal" Grid.Column="2"
                          Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
                <Border Width="4" Background="{StaticResource FrozenShadow}" />
              </StackPanel>
			</Grid>
		  </DockPanel>
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <Style x:Key="{x:Type dg:DataGridFooter}" TargetType="{x:Type dg:DataGridFooter}">
    <Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate>
		  <DockPanel>
            <Border BorderThickness="0,1,1,0" BorderBrush="{StaticResource Border}" Background="{StaticResource DataGridRowHeaderBackground}"
                    Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" Name="RowHeader"
                    Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			<ItemsControl ItemsSource="{Binding GroupedColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			              DockPanel.Dock="Left">
			  <ItemsControl.ItemsPanel>
			    <ItemsPanelTemplate>
			      <StackPanel Orientation="Horizontal" />
			    </ItemsPanelTemplate>
			  </ItemsControl.ItemsPanel>
			  <ItemsControl.ItemTemplate>
				<DataTemplate>
				  <Border Background="{StaticResource DataGridRowHeaderBackground}" BorderThickness="0,1,1,0" BorderBrush="{StaticResource Border}"
					      Width="{Binding GroupingIndent, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
			<Grid>
			  <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}" Background="{StaticResource DataGridRowHeaderBackground}">
			    <ItemsPresenter />
			  </Border>
			  <StackPanel Orientation="Horizontal" Grid.Column="2"
                          Visibility="{Binding IsFrozenLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <Border Width="{Binding FrozenEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
                <Border Width="4" Background="{StaticResource FrozenShadow}" />
              </StackPanel>
			</Grid>
		  </DockPanel>
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <!-- =================== -->
  <!--   DataGrid styles   -->
  <!-- =================== -->

  <Style x:Key="InvisibleButtonStyle" TargetType="Button">
    <Setter Property="Template">
	  <Setter.Value>
	    <ControlTemplate TargetType="Button">
		  <Border Background="Transparent" />
		</ControlTemplate>
	  </Setter.Value>
	</Setter>
  </Style>
  
  <Style x:Key="{x:Static local:DataGrid.ScrollViewerStyleKey}" TargetType="ScrollViewer">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
			  <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
			  <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="1" Visibility="{Binding ShowColumnHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <dg:DataGridHeaderRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Focusable="False" Margin="0,0,-1,0"
                                             ItemsSource="{Binding EffectiveColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                                             ItemContainerStyle="{StaticResource GridViewColumnHeaderStyle}"
                                             ItemTemplate="{Binding ColumnHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
                <dg:DataGridHeaderRowPresenter.ItemsPanel>
                  <ItemsPanelTemplate>
                    <dg:DataGridRowPanel />
                  </ItemsPanelTemplate>
                </dg:DataGridHeaderRowPresenter.ItemsPanel>
              </dg:DataGridHeaderRowPresenter>
            </Grid>

			<!-- Filter row -->
            <dg:DataGridFilterRow ItemsSource="{Binding EffectiveColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			                      Grid.ColumnSpan="2" Grid.Row="1"
								  Visibility="{Binding IsFilterRowVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
			
            <Grid Visibility="{Binding ShowColumnHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource Border}" Background="{StaticResource ButtonBackground}"
                      Width="{Binding RowHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
                      Visibility="{Binding ShowRowHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
			    <Button Command="{x:Static dg:DataGridCommands.ToggleSelectAll}" Style="{StaticResource InvisibleButtonStyle}" />
			  </Border>
            </Grid>

            <Grid Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Grid.Column="2">
              <Border BorderThickness="1,0,0,1" BorderBrush="{StaticResource Border}" Background="{StaticResource ButtonBackground}"
                      Visibility="{Binding ShowColumnHeaders, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
            </Grid>

			<!-- Filter row scroll corner -->
			<Grid Visibility="{Binding IsFilterRowVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			      Grid.Column="2" Grid.Row="1">
			  <Border BorderThickness="1,0,0,1" BorderBrush="{StaticResource Border}" Background="{StaticResource DataGridRowHeaderBackground}"
                      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
			</Grid>
			
            <ScrollContentPresenter Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local" Grid.Row="2" Grid.ColumnSpan="2"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="0,0,-1,0"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
			
            <!-- Footer -->
			<dg:DataGridFooter Columns="{Binding EffectiveColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}"
			                   Grid.ColumnSpan="2" Grid.Row="3"
							   Visibility="{Binding IsFooterVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
							   
			<StackPanel Grid.Row="2" Grid.ColumnSpan="2" Visibility="{Binding IsFrozenRowLineVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}">
              <Border Height="{Binding FrozenRowEdge, RelativeSource={RelativeSource AncestorType={x:Type local:DataGrid}}}" />
              <Border Background="{StaticResource FrozenRowShadow}" Height="4" />
            </StackPanel>
									
            <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Height="19" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                       Template="{StaticResource HorizontalScrollBarTemplate}" Grid.Row="4" Grid.ColumnSpan="2"
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                       Cursor="Arrow" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Width="19" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Border}"
                       Template="{StaticResource VerticalScrollBarTemplate}" Grid.Column="2" Grid.Row="2" Grid.RowSpan="2"
                       Minimum="0.0" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Cursor="Arrow" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            <Rectangle Grid.Column="2" Grid.Row="4" Fill="{StaticResource ScrollBarBackground}" />
            <Rectangle Grid.Column="2" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{StaticResource Border}" Width="1" Height="1"
                       Name="CornerDot" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ComputedHorizontalScrollBarVisibility" Value="Visible" />
                <Condition Property="ComputedVerticalScrollBarVisibility" Value="Visible" />
              </MultiTrigger.Conditions>
              <Setter TargetName="CornerDot" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type dg:DataGridItemsPresenter}" TargetType="{x:Type dg:DataGridItemsPresenter}">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <dg:DataGridPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dg:DataGridItemsPresenter}">
          <ScrollViewer Style="{StaticResource {x:Static local:DataGrid.ScrollViewerStyleKey}}"
                        HorizontalScrollBarVisibility="Auto" CanContentScroll="True"
                        VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="PagerStyle" TargetType="{x:Type dg:DataGridPager}" BasedOn="{StaticResource {x:Type dg:DataGridPager}}" />

  <Style TargetType="{x:Type local:DataGrid}">
    <Style.Resources>
      <!-- Readonly edit display -->
      <DataTemplate x:Key="{x:Static local:PropertyGrid.ReadOnlyDisplayKey}">
        <TextBlock Padding="3,4,0,4" Margin="0,0,2,0" Text="{Binding Value}" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyTextColor}" />
      </DataTemplate>
      <!-- Collection edit display -->
      <DataTemplate x:Key="{x:Static local:PropertyGrid.CollectionDisplayKey}">
        <StackPanel Orientation="Horizontal" Margin="3,4,2,4">
          <TextBlock Text="{Binding Path=Value.Count}" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyTextColor}" 
                     Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
          <TextBlock Name="ItemText" Text=" items" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyTextColor}" 
                     Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Value.Count}" Value="1">
            <Setter TargetName="ItemText" Property="Text" Value=" item" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </Style.Resources>
    <Setter Property="BuiltInEditorStyles">
      <Setter.Value>
        <pe:BuiltInEditorStyleCollection>
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.SimpleTextEditorKey}" Style="{StaticResource DataGridTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.NonAutoUpdatingTextEditorKey}" Style="{StaticResource DataGridTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.IntegerEditorKey}" Style="{StaticResource DataGridIntegerTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.DoubleEditorKey}" Style="{StaticResource DataGridNumericTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectEditorKey}" Style="{StaticResource DataGridComboBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectNoTextEntryEditorKey}" Style="{StaticResource DataGridComboBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.CheckBoxEditorKey}" Style="{StaticResource DataGridCheckBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.NumericUpDownEditorKey}" Style="{StaticResource DataGridNumericUpDownStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ColorEditorKey}" Style="{StaticResource DataGridColorPickerStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.DateEditorKey}" Style="{StaticResource DataGridDatePickerStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.TimeSpanEditorKey}" Style="{StaticResource DataGridTimeSpanPickerStyle}" />
        </pe:BuiltInEditorStyleCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="BuiltInDisplayTemplates">
      <Setter.Value>
        <dg:BuiltInDisplayTemplateCollection>
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ReadOnlyDisplayKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.CollectionDisplayKey}" Template="{StaticResource CollectionDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.SimpleTextEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.NonAutoUpdatingTextEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.IntegerEditorKey}" Template="{StaticResource RightAlignedDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.DoubleEditorKey}" Template="{StaticResource RightAlignedDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ListSelectEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ListSelectNoTextEntryEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.RadioSelectEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.CheckBoxEditorKey}" Template="{StaticResource CheckBoxDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.SliderEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.NumericUpDownEditorKey}" Template="{StaticResource DisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.ColorEditorKey}" Template="{StaticResource ColorPickerDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.DateEditorKey}" Template="{StaticResource DateTimeDisplayTemplate}" />
          <dg:BuiltInDisplayTemplate EditorKey="{x:Static local:PropertyGrid.TimeSpanEditorKey}" Template="{StaticResource TimeSpanPickerDisplayTemplate}" />
        </dg:BuiltInDisplayTemplateCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Background" Value="{StaticResource ListBoxBackground}" />
    <Setter Property="PagerStyle" Value="{StaticResource PagerStyle}" />
    <Setter Property="ColumnHeaderTemplate" Value="{StaticResource DataGridColumnHeaderTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DataGrid}">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <dg:DataGridGroupingPanel BorderThickness="0,0,0,1" Visibility="{TemplateBinding IsGroupingPanelVisible, Converter={StaticResource bvc}}"
                                          ItemsSource="{TemplateBinding GroupedColumns}"
                                          ItemContainerStyle="{StaticResource GridViewColumnHeaderStyle}"
                                          ItemTemplate="{StaticResource GroupedDataGridColumnHeaderTemplate}" />
                <dg:DataGridItemsPresenter ItemsSource="{TemplateBinding DisplayedItemsSource}" ItemTemplate="{TemplateBinding ItemTemplate}" Grid.Row="1"
                                           ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}" ItemContainerStyle="{TemplateBinding ItemContainerStyle}" />
                <dg:DataGridPager DataGridItemsSource="{TemplateBinding DisplayedItemsSource}" Style="{TemplateBinding PagerStyle}" Grid.Row="2"
                                  MaxPagerButtonCount="{TemplateBinding MaxPagerButtonCount}" EllipsisMode="{TemplateBinding EllipsisMode}">
				  <dg:DataGridPager.Visibility>
				    <MultiBinding Converter="{StaticResource DataGridPagerVisibility}">
					  <Binding Path="IsPagerVisible" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
					  <Binding Path="DisplayedItemsSource.PageCount" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGrid}}" />
					</MultiBinding>
				  </dg:DataGridPager.Visibility>
				</dg:DataGridPager>
              </Grid>
            </Border>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>