<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:local="clr-namespace:Mindscape.WpfElements"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlack.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <!--
  ==========================================================================================================================
                                                       Scheduler Control
  ==========================================================================================================================
  -->

  <local:BooleanToVisibilityConverter x:Key="bvc" />
  <local:BooleanToVisibilityConverter x:Key="ibvc" IsInverted="True" />
  <local:DateRangeDisplayConverter x:Key="DateRangeToTitle" />
  <local:DateRangeDisplayConverter x:Key="DateRangeToAbbreviatedTitle" MonthFormat="MMM" />

  <Style TargetType="local:EditableTextBlock">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:EditableTextBlock">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}" />
              <TextBlock Text="{TemplateBinding Text}" TextWrapping="Wrap"
                         Visibility="{Binding IsInEditMode, Converter={StaticResource ibvc}, RelativeSource={RelativeSource TemplatedParent}}"
                         FocusVisualStyle="{x:Null}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInEditMode" Value="False">
              <Setter TargetName="PART_ContentHost" Property="Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <sys:Double x:Key="HourSlotHeight">60</sys:Double>
  <sys:Double x:Key="HourSlotHeightBar1">59</sys:Double>
  <sys:Double x:Key="HalfHourSlotHeight">30</sys:Double>
  <local:WeekToStringConverter x:Key="WeekString" />

  <local:TimeOfDayToMinuteStringConverter x:Key="MinuteString" />
  <local:DateTimeToDayOfWeekStringConverter x:Key="DayOfWeekString" />

  <SolidColorBrush x:Key="ShadowBrush" Color="#444C535C" />
  <SolidColorBrush x:Key="DarkGrayBrush" Color="#9199A4" />
  <SolidColorBrush x:Key="TodayBrush" Color="#EE9311" />

  <!--
  ==========================================================================================================================
                                                         View Changer Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="ViewChangerNormalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E8EBF7" Offset="0" />
    <GradientStop Color="#E8EBF7" Offset="0.4" />
    <GradientStop Color="#C6C8D2" Offset="0.4" />
    <GradientStop Color="#D4D7E1" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ViewChangerMouseOverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFF4C9" Offset="0" />
    <GradientStop Color="#FFF4C9" Offset="0.4" />
    <GradientStop Color="#FFD86A" Offset="0.4" />
    <GradientStop Color="#FFE69E" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ViewChangerIsSelectedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFCC90" Offset="0" />
    <GradientStop Color="#FFCC90" Offset="0.4" />
    <GradientStop Color="#FEAE42" Offset="0.4" />
    <GradientStop Color="#FEE07A" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ViewChangerMousePressedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFB558" Offset="0" />
    <GradientStop Color="#FFB558" Offset="0.4" />
    <GradientStop Color="#FB8F3E" Offset="0.4" />
    <GradientStop Color="#FEB966" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ViewChangerMouseOver_CheckedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFB558" Offset="0" />
    <GradientStop Color="#FFB558" Offset="0.4" />
    <GradientStop Color="#FB8F3E" Offset="0.4" />
    <GradientStop Color="#FEE07A" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ViewChangerBorderBrush" Color="Black" />

  <Style x:Key="ViewChangeButtonStyle" TargetType="RadioButton">
    <Setter Property="BorderBrush" Value="{StaticResource ViewChangerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border Name="Border" Background="{StaticResource ViewChangerNormalBrush}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentControl Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ViewChangerMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ViewChangerIsSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ViewChangerMousePressedBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ViewChangerMouseOver_CheckedBrush}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                            Normal Button
  ==========================================================================================================================
  -->

  <Style x:Key="AddItemButtonStyle" TargetType="Button">
    <Setter Property="BorderBrush" Value="DarkGray" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Background="{StaticResource ViewChangerNormalBrush}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,5,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ViewChangerMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ViewChangerMousePressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                         View Navigation Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="SameViewChangerNormalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FBFBFB" Offset="0" />
    <GradientStop Color="#FBFBFB" Offset="0.5" />
    <GradientStop Color="#E1E1E1" Offset="0.5" />
    <GradientStop Color="#EAEAEA" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SameViewChangerMouseOverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFBDA" Offset="0" />
    <GradientStop Color="#FFEAA5" Offset="0.5" />
    <GradientStop Color="#FFD86B" Offset="0.5" />
    <GradientStop Color="#F6DE99" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SameViewChangerMousePressedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F4B86B" Offset="0" />
    <GradientStop Color="#FDA452" Offset="0.5" />
    <GradientStop Color="#FB8F40" Offset="0.5" />
    <GradientStop Color="#F4B267" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="SameViewChangeButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Background="{StaticResource SameViewChangerNormalBrush}" BorderThickness="1" BorderBrush="Gray" CornerRadius="20" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SameViewChangerMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SameViewChangerMousePressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                         Day of Week Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="DayButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DBDEE1" Offset="0" />
    <GradientStop Color="#D3D6DA" Offset="0.5" />
    <GradientStop Color="#B4BAC1" Offset="0.5" />
    <GradientStop Color="#CBCED4" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="DayButtonMouseOverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DCDFE3" Offset="0" />
    <GradientStop Color="#D9DBDE" Offset="0.5" />
    <GradientStop Color="#CBCED4" Offset="0.5" />
    <GradientStop Color="#D4D7DC" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="DayButtonPressedBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0.2" />
    <GradientStop Color="#E2E4E7" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="0.8" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="DayButtonBorderBrush" Color="#B0B6BE" />

  <Style x:Key="DayButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Background="{StaticResource DayButtonNormalBrush}" BorderThickness="1" BorderBrush="{StaticResource DayButtonBorderBrush}" />
            <Border Background="{StaticResource DayButtonPressedBrush}" BorderThickness="1" BorderBrush="{StaticResource DayButtonBorderBrush}"
                    Name="PressedBorder" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DayButtonMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DayButtonMouseOverBrush}" />
              <Setter TargetName="PressedBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                              Today Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="SchedulerTodayButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#f5C25E" Offset="0" />
    <GradientStop Color="#f5C25E" Offset="0.5" />
    <GradientStop Color="#EF9B1F" Offset="0.5" />
    <GradientStop Color="#F8D67C" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SchedulerTodayButtonAdditionalNormalBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0" />
    <GradientStop Color="#FADF89" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SchedulerTodayButtonMouseOverBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0" />
    <GradientStop Color="#FCEBB7" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="SchedulerTodayButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border Background="{StaticResource SchedulerTodayButtonNormalBrush}" />
            <Border Background="{StaticResource SchedulerTodayButtonAdditionalNormalBrush}" />
            <Border Name="MouseOverBorder" Background="{StaticResource SchedulerTodayButtonMouseOverBrush}" Opacity="0" />
            <Border BorderBrush="{StaticResource TodayBrush}" BorderThickness="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                             Wing Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="ChangeAppointmentButtonNormalBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#CFD2D8" Offset="0" />
    <GradientStop Color="#B0B6BE" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ChangeAppointmentButtonMouseOverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C1C5CC" Offset="0.2" />
    <GradientStop Color="#B0B6BE" Offset="0.5" />
    <GradientStop Color="#C1C6CC" Offset="0.8" />
  </LinearGradientBrush>

  <SolidColorBrush Color="#404840" x:Key="ChangeAppointmentArrowBrush" />

  <Style x:Key="WingButtonBase" TargetType="Button">
    <Setter Property="Height" Value="200" />
    <Setter Property="Width" Value="22" />
  </Style>

  <Style x:Key="WingButtonBackgroundBase" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource DarkGrayBrush}" />
  </Style>

  <Style x:Key="WingButtonBackground" TargetType="Border" BasedOn="{StaticResource WingButtonBackgroundBase}">
    <Setter Property="Background" Value="{StaticResource ChangeAppointmentButtonNormalBrush}" />
  </Style>

  <Style x:Key="WingButtonMouseOverBackground" TargetType="Border" BasedOn="{StaticResource WingButtonBackgroundBase}">
    <Setter Property="Background" Value="{StaticResource ChangeAppointmentButtonMouseOverBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style x:Key="WingButtonTextBlock" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Width" Value="200" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,-200,0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TransformGroup>
          <RotateTransform Angle="-90" CenterX="100" />
          <TranslateTransform X="-107" Y="7" />
        </TransformGroup>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WingButtonIcon" TargetType="Path">
    <Setter Property="Stroke" Value="{StaticResource ChangeAppointmentArrowBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Margin" Value="8,11,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="PreviousAppointmentButtonStyle" TargetType="Button" BasedOn="{StaticResource WingButtonBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Style="{StaticResource WingButtonBackground}" CornerRadius="0,8,8,0" />
            <TextBlock Name="Text" Text="{Binding Formatter.PreviousItemButtonContent, RelativeSource={RelativeSource AncestorType={x:Type local:Scheduler}}}"
			           Style="{StaticResource WingButtonTextBlock}" Foreground="Black" />
            <Path Data="M 0 0 L 0 10 M 7 1 L 3 5 L 7 9" Style="{StaticResource WingButtonIcon}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ChangeAppointmentButtonMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Text" Property="Foreground" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NextAppointmentButtonStyle" TargetType="Button" BasedOn="{StaticResource WingButtonBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Style="{StaticResource WingButtonBackground}" CornerRadius="8,0,0,8" />
            <TextBlock Name="Text" Text="{Binding Formatter.NextItemButtonContent, RelativeSource={RelativeSource AncestorType={x:Type local:Scheduler}}}"
			           Style="{StaticResource WingButtonTextBlock}" Foreground="Black" />
            <Path Data="M 7 0 L 7 10 M 0 1 L 4 5 L 0 9" Style="{StaticResource WingButtonIcon}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource ChangeAppointmentButtonMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Text" Property="Foreground" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                         Time Line Styles
  ==========================================================================================================================
  -->

  <SolidColorBrush x:Key="TimeLineForeground" Color="#6593CF" />

  <DataTemplate x:Key="TimeLineUnitTemplate">
    <StackPanel>
      <Border HorizontalAlignment="Center" Width="40" Height="1" BorderThickness="1" BorderBrush="Black" />
      <Grid Height="{StaticResource HourSlotHeightBar1}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="3" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock TextAlignment="Right" FontSize="14" Margin="0, 3, 0, 0" Text="{Binding TwelveHourClockHour}" />
        <TextBlock Grid.Column="2" FontSize="10" Margin="0, -1, 0, 0" Text="{Binding Converter={StaticResource MinuteString}}" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <SolidColorBrush x:Key="TimeSlotBorder" Color="#5D8CC9" />
  <SolidColorBrush x:Key="OnTheHourBrush" Color="#C7CBD1" />
  <SolidColorBrush x:Key="DefaultBrush" Color="#DDE0E3" />
  <local:MinuteOfHourBrushConverter x:Key="TimeSlotLineBrush" OnTheHourBrush="{StaticResource OnTheHourBrush}" DefaultBrush="{StaticResource DefaultBrush}" />

  <SolidColorBrush x:Key="WorkTimeBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NotWorkTimeBrush" Color="#E8EAEC" />
  <SolidColorBrush x:Key="SelectedTimeSlotBrush" Color="#4C535C" />
  <local:TimeSlotStateToBrushConverter x:Key="TimeSlotBackgroundBrush" WorkTimeBrush="{StaticResource WorkTimeBrush}"
                                           NotWorkTimeBrush="{StaticResource NotWorkTimeBrush}"
                                           SelectedWorkTimeBrush="{StaticResource SelectedTimeSlotBrush}"
                                           SelectedNotWorkTimeBrush="{StaticResource SelectedTimeSlotBrush}" />

  <DataTemplate x:Key="TimeSlotTemplate">
    <Border Background="{Binding TimeSlotState, Converter={StaticResource TimeSlotBackgroundBrush}}" Height="{StaticResource HalfHourSlotHeight}"
              BorderThickness="0, 0, 0, 1" BorderBrush="{Binding Minute, Converter={StaticResource TimeSlotLineBrush}}" SnapsToDevicePixels="True">
      <Border Background="Transparent" BorderThickness="1,0,1,0" BorderBrush="{StaticResource DarkGrayBrush}" Margin="0,0,0,-1" SnapsToDevicePixels="True" />
    </Border>
  </DataTemplate>

  <!--
  ==========================================================================================================================
                                                         Appointment Styles
  ==========================================================================================================================
  -->

  <Style x:Key="HorizontalAppointmentTimeChangerStyle" TargetType="local:ScheduleItemTimeChanger">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderThickness="0" Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="Invisible">
    <Border Background="Transparent" BorderBrush="Transparent" />
  </ControlTemplate>

  <Style x:Key="AppointmentMoverStyle" TargetType="local:ScheduleItemMover">
    <Setter Property="Template" Value="{StaticResource Invisible}" />
  </Style>

  <local:SchedulerElementDisplayStateToCornerRadiusConverter x:Key="AppointmentElementCornerRadiusConverter" ScheduleElementEndRadius="8" />

  <LinearGradientBrush x:Key="AppointmentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="White" Offset="0" />
    <GradientStop Color="#D2D5DA" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AppointmentBorder" Color="#5B81B2" />

  <DataTemplate x:Key="ScheduleItemTemplate">
    <Grid>
      <Border BorderThickness="0" Background="{StaticResource ShadowBrush}" Margin="5,5,-5,-5" Canvas.ZIndex="-20" IsHitTestVisible="False"
              CornerRadius="{Binding Content, Converter={StaticResource AppointmentElementCornerRadiusConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
      <Border BorderBrush="{StaticResource DarkGrayBrush}" BorderThickness="1"
              CornerRadius="{Binding Content, Converter={StaticResource AppointmentElementCornerRadiusConverter}, RelativeSource={RelativeSource TemplatedParent}}"
              Width="{TemplateBinding Width}" IsHitTestVisible="False"
              Background="{StaticResource AppointmentBrush}" />
      <Image Source="/Mindscape.WpfElements;component/Images/Recurrence_Small.png"
             VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="2,2,5,8" Width="11" Height="10"
             Visibility="{Binding Content.ScheduleItem.IsInstanceOfRecurringItem, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
      <local:EditableTextBlock Text="{Binding Content.ScheduleItem.Name, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Black" Margin="5,9,20,0"
                               MinWidth="10"
                               IsHitTestVisible="{Binding Content.ScheduleItem.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
    </Grid>
  </DataTemplate>

  <Style x:Key="ScheduleItemStyle" TargetType="local:SchedulerElement">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
              </Grid.RowDefinitions>
              <local:ScheduleItemTimeChanger Grid.Row="0" Cursor="SizeNS"
                                              Style="{StaticResource HorizontalAppointmentTimeChangerStyle}"
                                              ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              Visibility="{Binding IsScheduleItemStartVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                                              TimeEnd="StartTime" />
              <local:ScheduleItemMover Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource AppointmentMoverStyle}" Cursor="Hand"
                                         ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                         x:Name="PART_Mover"
                                         />
              <local:ScheduleItemTimeChanger Grid.Row="3" Cursor="SizeNS"
                                              Style="{StaticResource HorizontalAppointmentTimeChangerStyle}"
                                              ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              Visibility="{Binding IsScheduleItemEndVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                                              TimeEnd="EndTime" />
            </Grid>
            <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
            <Grid Visibility="{Binding ScheduleItem.IsSelected, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                  IsHitTestVisible="False">
              <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
              </Grid.RowDefinitions>
              <Border Background="Transparent" BorderThickness="2" BorderBrush="Black" Grid.RowSpan="3"
                      CornerRadius="{Binding ElementState, Converter={StaticResource AppointmentElementCornerRadiusConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
              <Grid Grid.Row="0" Margin="0,-2,0,0" Visibility="{Binding IsScheduleItemStartVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" />
                <Border Grid.Column="1" Background="White" BorderBrush="Black" BorderThickness="1" />
                <Border Grid.Column="2" Background="Transparent" />
              </Grid>
              <Grid Grid.Row="2" Margin="0,0,0,-2" Visibility="{Binding IsScheduleItemEndVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" />
                <Border Grid.Column="1" Background="White" BorderBrush="Black" BorderThickness="1" />
                <Border Grid.Column="2" Background="Transparent" />
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:SchedulerElementDisplayStateToTimeStringConverter x:Key="StartTimeString" TimeEnd="StartTime" />
  <local:SchedulerElementDisplayStateToTimeStringConverter x:Key="EndTimeString" TimeEnd="EndTime" />
  <local:DimensionConverter x:Key="AppointmentNameWidth" Add="-150" />
  <local:SchedulerElementDisplayStateToCornerRadiusConverter x:Key="SmallAppointmentElementCornerRadiusConverter" ScheduleElementEndRadius="4" Orientation="Horizontal" />
  <local:SchedulerElementDisplayStateToCornerRadiusConverter x:Key="SmallestCornerRadiusConverter" ScheduleElementEndRadius="2" Orientation="Horizontal" />
  <local:SchedulerElementDisplayStateToThicknessConverter x:Key="SmallAppointmentElementMarginConverter" ScheduleElementEndOffset="10" />
  <local:SchedulerElementDisplayStateToThicknessConverter x:Key="InnerMarginConverter" ScheduleElementEndOffset="8" />
  <local:SchedulerElementDisplayStateToThicknessConverter x:Key="TinyMarginConverter" ScheduleElementEndOffset="2" />

  <Style x:Key="SummaryItemTimeChangerBase" TargetType="local:ScheduleItemTimeChanger">
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template" Value="{StaticResource Invisible}" />
  </Style>

  <Style x:Key="LeftTimeChanger" TargetType="local:ScheduleItemTimeChanger" BasedOn="{StaticResource SummaryItemTimeChangerBase}">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="TimeEnd" Value="StartTime" />
  </Style>

  <Style x:Key="RightTimeChanger" TargetType="local:ScheduleItemTimeChanger" BasedOn="{StaticResource SummaryItemTimeChangerBase}">
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="TimeEnd" Value="EndTime" />
  </Style>

  <LinearGradientBrush x:Key="LongItemBackground" StartPoint="0, 0" EndPoint="0, 1">
    <GradientStop Color="White" Offset="0" />
    <GradientStop Color="#D2D5DA" Offset="1.2" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="LongItemTimeForeground" Color="#4C535C" />

  <DataTemplate x:Key="LongItemTemplate">
    <Grid>
      <Border CornerRadius="{Binding Content, Converter={StaticResource SmallAppointmentElementCornerRadiusConverter}, RelativeSource={RelativeSource TemplatedParent}}"
              Height="20" BorderBrush="{StaticResource DarkGrayBrush}" BorderThickness="1"
              Margin="{Binding Content, Converter={StaticResource SmallAppointmentElementMarginConverter}, RelativeSource={RelativeSource TemplatedParent}}"
              Background="{StaticResource LongItemBackground}" IsHitTestVisible="False" />
      <Grid Margin="9,0,9,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Content, Converter={StaticResource StartTimeString}, RelativeSource={RelativeSource TemplatedParent}}"
                   Foreground="{StaticResource LongItemTimeForeground}" Margin="7,0,8,0" Grid.Column="0" IsHitTestVisible="False" />
        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
          <local:EditableTextBlock Text="{Binding Content.ScheduleItem.Name, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                   TextAlignment="Center" Foreground="Black"
                                   FontWeight="Bold" HorizontalAlignment="Center" MinWidth="10"
                                   IsHitTestVisible="{Binding Content.ScheduleItem.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
          <Image Source="/Mindscape.WpfElements;component/Images/Recurrence_Small.png" IsHitTestVisible="False" 
                 VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,3,3,4" Width="11" Height="10"
                 Visibility="{Binding Content.ScheduleItem.IsInstanceOfRecurringItem, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
        </StackPanel>
        <TextBlock Text="{Binding Content, Converter={StaticResource EndTimeString}, RelativeSource={RelativeSource TemplatedParent}}"
                   Foreground="{StaticResource LongItemTimeForeground}" Margin="5,0,8,0" Grid.Column="2" TextAlignment="Right" IsHitTestVisible="False" />
      </Grid>
    </Grid>
  </DataTemplate>

  <Style x:Key="LongItemStyle" TargetType="local:SchedulerElement">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid Margin="8,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
              </Grid.ColumnDefinitions>
              <local:ScheduleItemTimeChanger Style="{StaticResource LeftTimeChanger}" 
                                             ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                             Visibility="{Binding IsScheduleItemStartVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                                             />
              <local:ScheduleItemMover Grid.Column="1" Style="{StaticResource AppointmentMoverStyle}" Cursor="Hand" Name="PART_Mover"
                                       ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}" />
              <local:ScheduleItemTimeChanger Style="{StaticResource RightTimeChanger}" 
                                             ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                             Visibility="{Binding IsScheduleItemEndVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                                             />
            </Grid>
            <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
            <Grid Visibility="{Binding ScheduleItem.IsSelected, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                  Margin="{Binding ElementState, Converter={StaticResource InnerMarginConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                  IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
              </Grid.ColumnDefinitions>
              <Border Background="Transparent"
                        CornerRadius="{Binding ElementState, Converter={StaticResource SmallestCornerRadiusConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                        BorderThickness="3" BorderBrush="Black"
                        Margin="{Binding ElementState, Converter={StaticResource TinyMarginConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                        Grid.ColumnSpan="3" />
              <Grid Grid.Column="0" Visibility="{Binding IsScheduleItemStartVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="Transparent" />
                <Border Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="1" />
                <Border Grid.Row="2" Background="Transparent" />
              </Grid>
              <Grid Grid.Column="2" Visibility="{Binding IsScheduleItemEndVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="Transparent" />
                <Border Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="1" />
                <Border Grid.Row="2" Background="Transparent" />
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="ShortItemTemplate">
    <Grid>
      <Border CornerRadius="4" Height="20" BorderThickness="0" Margin="10, 0, 10, 0"
              Background="{StaticResource AppointmentBrush}" IsHitTestVisible="False" />
      <Grid Margin="9,0,9,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Content, Converter={StaticResource StartTimeString}, RelativeSource={RelativeSource TemplatedParent}}"
                   Foreground="{StaticResource LongItemTimeForeground}" Margin="7,0,8,0" Grid.Column="0" IsHitTestVisible="False" />
        <TextBlock Text="{Binding Content, Converter={StaticResource EndTimeString}, RelativeSource={RelativeSource TemplatedParent}}"
                   Foreground="{StaticResource LongItemTimeForeground}" Margin="5,0,8,0" Grid.Column="1" TextAlignment="Right" IsHitTestVisible="False" />
        <local:EditableTextBlock Text="{Binding Content.ScheduleItem.Name, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Left" Foreground="Black"
                                 Grid.Column="2" Margin="0,0,8,0" MinWidth="10"
                                 IsHitTestVisible="{Binding Content.ScheduleItem.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
      </Grid>
    </Grid>
  </DataTemplate>

  <Style x:Key="ShortItemStyle" TargetType="local:SchedulerElement">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid Margin="8,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
              </Grid.ColumnDefinitions>
              <local:ScheduleItemTimeChanger Style="{StaticResource LeftTimeChanger}" 
                                             ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                             />
              <local:ScheduleItemMover Grid.Column="1" Style="{StaticResource AppointmentMoverStyle}" Cursor="Hand" Name="PART_Mover"
                                       ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}" />
              <local:ScheduleItemTimeChanger Style="{StaticResource RightTimeChanger}" 
                                             ScheduleItem="{Binding ScheduleItem, RelativeSource={RelativeSource TemplatedParent}}"
                                             />
            </Grid>
            <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
            <Grid Visibility="{Binding ScheduleItem.IsSelected, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" Margin="8,0,8,0"
                    IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
              </Grid.ColumnDefinitions>
              <Border Background="Transparent" CornerRadius="2" BorderThickness="3" BorderBrush="Black" Margin="2,0,2,0"
                        Grid.ColumnSpan="3" />
              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="Transparent" />
                <Border Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="1" />
                <Border Grid.Row="2" Background="Transparent" />
              </Grid>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="6" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="Transparent" />
                <Border Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="1" />
                <Border Grid.Row="2" Background="Transparent" />
              </Grid>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                         Create Item Here Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="CreateHereElementBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="White" Offset="0" />
    <GradientStop Color="#D2D5DA" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="CreateHereElementStyle" TargetType="local:SchedulerElement">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="8" BorderThickness="2" BorderBrush="Black" Margin="10, 0, 10, 0" Height="24" Background="{StaticResource CreateHereElementBackground}">
            <TextBox Margin="10, 0, 10, 0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <LinearGradientBrush x:Key="AddAppointmentButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FEFEFE" Offset="0" />
    <GradientStop Color="#EEF0F1" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AddAppointmentButtonBorder" Color="#9199A4" />
  <SolidColorBrush x:Key="AddAppointmentButtonForeground" Color="#9CA3AD" />

  <Style x:Key="AddAppointmentButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="5" Margin="25,0,25,0" BorderBrush="{StaticResource AddAppointmentButtonBorder}" BorderThickness="1" Background="{StaticResource AddAppointmentButtonBackground}">
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{StaticResource AddAppointmentButtonForeground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                         
  ==========================================================================================================================
  -->

  <local:BooleanToStyleConverter x:Key="DayHeaderForWeekButtonConverter"
                                 TrueStyle="{StaticResource SchedulerTodayButtonStyle}"
                                 FalseStyle="{StaticResource DayButtonStyle}" />

  <DataTemplate x:Key="DayHeaderForWeek">
    <Grid>
      <Button Style="{Binding IsCurrentDay, Converter={StaticResource DayHeaderForWeekButtonConverter}}"
              VerticalAlignment="Top" BorderThickness="1" BorderBrush="Gray" Background="LightGray"
              Height="20" 
              Command="{x:Static local:SchedulerCommands.GoToDayCommand}"
              CommandParameter="{Binding}"
              />
      <TextBlock Text="{Binding Date.Day}" IsHitTestVisible="False" Margin="5, 1, 0, 0" FontWeight="Bold" />
      <TextBlock Text="{Binding Date, Converter={StaticResource DayOfWeekString}}" IsHitTestVisible="False" TextAlignment="Center" Margin="0, 1, 0, 0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="WeekViewOverlay">
    <Border IsHitTestVisible="False" BorderThickness="2, 0, 2, 2" BorderBrush="{StaticResource TodayBrush}"
            Margin="-1,0,1,0"
            Visibility="{Binding IsCurrentDay, Converter={StaticResource bvc}}"
            />
  </DataTemplate>

  <SolidColorBrush x:Key="WeekViewDayElementNeutralBrush" Color="#C7CBD1" />
  <local:ElementViewStatusToBrushConverter x:Key="WeekViewDayElementBackground"
                                               NormalBrush="{StaticResource WeekViewDayElementNeutralBrush}"
                                               MouseOverBrush="{StaticResource WeekViewDayElementNeutralBrush}"
                                               PaddingBrush="{StaticResource WeekViewDayElementNeutralBrush}"
                                               SelectedBrush="#4C535C" />

  <local:BooleanToBrushConverter x:Key="WeekViewDayElementBorder" TrueBrush="{StaticResource TodayBrush}" FalseBrush="{StaticResource DarkGrayBrush}" />
  <local:BooleanToThicknessConverter x:Key="WeekViewDayElementThickness" TrueThickness="2,0,2,0" FalseThickness="1,0,1,0" />

  <DataTemplate x:Key="WeekViewHeaderOverlay">
    <Border IsHitTestVisible="False" BorderThickness="0,0,0,2" BorderBrush="{Binding IsCurrentDay, Converter={StaticResource WeekViewDayElementBorder}}"
              />
  </DataTemplate>

  <Style x:Key="WeekViewDayElementStyle" TargetType="local:MonthViewDayElement">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{Binding Day.IsCurrentDay, Converter={StaticResource WeekViewDayElementBorder}, RelativeSource={RelativeSource TemplatedParent}}"
                    BorderThickness="{Binding Day.IsCurrentDay, Converter={StaticResource WeekViewDayElementThickness}, RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{Binding ViewStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource WeekViewDayElementBackground}}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:TimeOfDayVerticalOffsetConverter x:Key="TimePointerMargin" HourSlotHeight="{StaticResource HourSlotHeight}" />
  <local:ObjectToVisibilityConverter x:Key="NullToVisibleConverter" NullVisibility="Visible" />

  <Style x:Key="NavigationBarStyle" TargetType="local:SchedulerNavigationBar">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SchedulerNavigationBar">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="35" />
              <ColumnDefinition Width="35" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
              <Button Style="{StaticResource SameViewChangeButtonStyle}" 
                      Margin="5"
                      Command="{x:Static local:SchedulerCommands.DecrementViewCommand}"
                      />
              <Path Stroke="Black" Data="M 5 0 L 0 5 L 10 5 M 0 5 L 5 10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Column="2">
              <Button Style="{StaticResource SameViewChangeButtonStyle}"
                      Margin="5"
                      Command="{x:Static local:SchedulerCommands.IncrementViewCommand}"
                      />
              <Path Stroke="Black" Data="M 0 5 L 10 5 L 5 0 M 10 5 L 5 10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Grid.Column="3" FontSize="20" Margin="10,3,0,0"
                       Text="{Binding DateRange, Converter={StaticResource DateRangeToTitle}, RelativeSource={RelativeSource TemplatedParent}}" />
            <Button Grid.Column="4" Style="{StaticResource AddItemButtonStyle}" Width="152"
                    Margin="0,1,18,1" Command="{x:Static local:SchedulerCommands.AddScheduleItemCommand}"
                    Visibility="{Binding ToolBarContent, Converter={StaticResource NullToVisibleConverter}, RelativeSource={RelativeSource TemplatedParent}}">
              <StackPanel Orientation="Horizontal">
                <Grid VerticalAlignment="Center">
                  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black" Width="4" Height="12" />
                  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black" Width="12" Height="4" />
                </Grid>
                <ContentControl Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center"
                                Content="{Binding Formatter.AddAppointmentButtonContent, RelativeSource={RelativeSource AncestorType={x:Type local:Scheduler}}}" />
              </StackPanel>
            </Button>
            <ContentPresenter Grid.Column="4" Content="{Binding ToolBarContent, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MoreAppointmentsButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border>
              <Path Name="Arrow" Fill="#BEBEBE" Stroke="White" Data="M 0 0 L 15 0 L 8 9 Z" StrokeThickness="1.5" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="#F7BE57" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:ElementViewStatusToBrushConverter x:Key="DayElementBackground"
                                               NormalBrush="White"
                                               MouseOverBrush="White"
                                               MouseOverPaddingBrush="#C7CBD1"
                                               PaddingBrush="#C7CBD1"
                                               SelectedBrush="#E8EAEC" />
  <local:BooleanToBrushConverter x:Key="DayElementBorderBrush" TrueBrush="{StaticResource TodayBrush}" FalseBrush="{StaticResource DarkGrayBrush}" />
  <local:BooleanToThicknessConverter x:Key="DayElementBorderThickness" TrueThickness="2,1,2,2" FalseThickness="1,1,1,2" />
  <local:BooleanToThicknessConverter x:Key="DayElementMargin" TrueThickness="0" FalseThickness="0,0,-1,0" />

  <Style x:Key="DayElementStyle" TargetType="local:MonthViewDayElement">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{Binding ViewStatus, Converter={StaticResource DayElementBackground}, RelativeSource={RelativeSource TemplatedParent}}"
                  BorderBrush="{Binding Day.IsCurrentDay, Converter={StaticResource DayElementBorderBrush}, RelativeSource={RelativeSource TemplatedParent}}"
                  BorderThickness="{Binding Day.IsCurrentDay, Converter={StaticResource DayElementBorderThickness}, RelativeSource={RelativeSource TemplatedParent}}"
                  Margin="{Binding Day.IsCurrentDay, Converter={StaticResource DayElementMargin}, RelativeSource={RelativeSource TemplatedParent}}">
            <Button Height="10" Width="15" Margin="4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Style="{StaticResource MoreAppointmentsButtonStyle}"
                    ToolTipService.ToolTip="Click for more appointments."
                    Visibility="{Binding HasOverflowItems, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                    Command="{x:Static local:SchedulerCommands.ViewDetailsCommand}"
                    />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SmallSchedulerCanvasBase" TargetType="local:SmallSchedulerCanvas">
    <Setter Property="LongItemStyle" Value="{StaticResource LongItemStyle}" />
    <Setter Property="LongItemTemplate" Value="{StaticResource LongItemTemplate}" />
  </Style>

  <Style x:Key="DayHeaderShowingMultiDayItemsOnly" TargetType="local:SmallSchedulerCanvas" BasedOn="{StaticResource SmallSchedulerCanvasBase}">
    <Setter Property="DayElementStyle" Value="{StaticResource WeekViewDayElementStyle}" />
    <Setter Property="ShowShortItems" Value="False" />
    <Setter Property="Height" Value="60" />
    <Setter Property="EnlargeWhenFull" Value="True" />
    <Setter Property="CreateHereButtonStyle" Value="{StaticResource AddAppointmentButtonStyle}" />
    <Setter Property="CreateHereElementStyle" Value="{StaticResource CreateHereElementStyle}" />
  </Style>

  <Style x:Key="SmallDayDisplayShowingAllItems" TargetType="local:SmallSchedulerCanvas" BasedOn="{StaticResource SmallSchedulerCanvasBase}">
    <Setter Property="DayElementStyle" Value="{StaticResource DayElementStyle}" />
    <Setter Property="ShowShortItems" Value="True" />
    <Setter Property="ShortItemStyle" Value="{StaticResource ShortItemStyle}" />
    <Setter Property="ShortItemTemplate" Value="{StaticResource ShortItemTemplate}" />
    <Setter Property="CreateHereButtonStyle" Value="{StaticResource AddAppointmentButtonStyle}" />
    <Setter Property="CreateHereElementStyle" Value="{StaticResource CreateHereElementStyle}" />
  </Style>

  <Style x:Key="SchedulerCanvasBase" TargetType="local:SchedulerCanvas">
    <Setter Property="ScheduleItemStyle" Value="{StaticResource ScheduleItemStyle}" />
    <Setter Property="ScheduleItemTemplate"  Value="{StaticResource ScheduleItemTemplate}" />
    <Setter Property="TimeSlotTemplate" Value="{StaticResource TimeSlotTemplate}" />
    <Setter Property="CreateHereElementStyle" Value="{StaticResource CreateHereElementStyle}" />
  </Style>

  <LinearGradientBrush x:Key="TimePointerBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1ECE1" Offset="0" />
    <GradientStop Color="#F9CC5F" Offset="1" />
  </LinearGradientBrush>

  <!--
  ==========================================================================================================================
                                                                Week View
  ==========================================================================================================================
  -->

  <Style x:Key="WeekViewStyle" TargetType="local:WeekView">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header - small surface for showing multi-day items -->
            <Border>
              <StackPanel Margin="0,0,1,0"
                          >

                <ItemsControl Margin="50, 0, 17, 0"
                              ItemsSource="{Binding Week.Days, RelativeSource={RelativeSource TemplatedParent}}"
                              ItemTemplate="{StaticResource DayHeaderForWeek}" 
                              HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Stretch" 
                              VerticalContentAlignment="Stretch"
                              >
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid>
                  <Border BorderThickness="0,0,0,1" BorderBrush="Black" />
                  <ScrollViewer Margin="50, 0, 0, 0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0"
                                BorderThickness="0" MaxHeight="80" FocusVisualStyle="{x:Null}">
                    <local:SmallSchedulerCanvas Days="{Binding Week.Days, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource DayHeaderShowingMultiDayItemsOnly}"
                                                TargetWeek="{Binding Week, RelativeSource={RelativeSource TemplatedParent}}"
                                                CreateHereElementDuration="1440"
                                                />
                  </ScrollViewer>
                  <ItemsControl Grid.Column="1"
                                ItemsSource="{Binding Week.Days, RelativeSource={RelativeSource TemplatedParent}}"
                                ItemTemplate="{StaticResource WeekViewHeaderOverlay}" Margin="50,0,17,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </StackPanel>
            </Border>

            <!-- The timeslotted schedule detail -->
            <Border VerticalAlignment="Stretch" Grid.Row="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0"
                              Margin="0,0,1,0" Grid.ColumnSpan="5" x:Name="PART_ScrollViewer" FocusVisualStyle="{x:Null}" >
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="15" VerticalAlignment="Top" BorderBrush="#BB5503" BorderThickness="0,0,0,1"
                            Margin="{Binding Now, Converter={StaticResource TimePointerMargin}, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="{Binding ContainsToday, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{StaticResource TimePointerBackground}" />
                    <ItemsControl ItemsSource="{Binding Times, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,-1,0,0"
                                  ItemTemplate="{StaticResource TimeLineUnitTemplate}" />
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource DarkGrayBrush}">
                      <local:SchedulerCanvas Days="{Binding Week.Days, RelativeSource={RelativeSource TemplatedParent}}" Margin="-1,0,0,0"
                                             Style="{StaticResource SchedulerCanvasBase}"
                                             CreateHereButtonStyle="{StaticResource AddAppointmentButtonStyle}"
                                             />
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Week.Days, RelativeSource={RelativeSource TemplatedParent}}"
                                    ItemTemplate="{StaticResource WeekViewOverlay}" Margin="1,0,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </Grid>
                </ScrollViewer>
                <Button Style="{StaticResource PreviousAppointmentButtonStyle}" Grid.Column="1"
                          Command="{x:Static local:SchedulerCommands.PreviousScheduleItemCommand}"
                          Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                          IsEnabled="{Binding IsPreviousWingEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
                <Button Style="{StaticResource NextAppointmentButtonStyle}" Grid.Column="3"
                          Command="{x:Static local:SchedulerCommands.NextScheduleItemCommand}"
                          Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                          IsEnabled="{Binding IsNextWingEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Border>

          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                                  Day View
  ==========================================================================================================================
  -->

  <local:DateTimeToFullDateStringConverter x:Key="DayString" />
  <local:BooleanToBrushConverter x:Key="DayHeaderBrush" TrueBrush="{StaticResource SchedulerTodayButtonNormalBrush}" FalseBrush="{StaticResource DayButtonNormalBrush}" />
  <local:BooleanToBrushConverter x:Key="DayHeaderBorderBrush" TrueBrush="{StaticResource TodayBrush}" FalseBrush="{StaticResource DayButtonBorderBrush}" />
  <local:BooleanToBrushConverter x:Key="DayHeaderBottomLineBrush" TrueBrush="{StaticResource TodayBrush}" FalseBrush="{StaticResource DarkGrayBrush}" />
  <local:BooleanToBrushConverter x:Key="DayBodyBorderBrush" TrueBrush="{StaticResource TodayBrush}" FalseBrush="Transparent" />

  <LinearGradientBrush x:Key="TodayBorderAdditionalNormalBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="Transparent" Offset="0.3" />
    <GradientStop Color="#FADF89" Offset="0.5" />
    <GradientStop Color="Transparent" Offset="0.7" />
  </LinearGradientBrush>

  <Style x:Key="DayViewStyle" TargetType="local:DayView">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The header - small surface for showing multi-day items -->
            <Border Grid.Row="0">
              <StackPanel>
                <Grid Margin="50, 0, 18, 0">
                  <Border Height="20" Background="{Binding Day.IsCurrentDay, Converter={StaticResource DayHeaderBrush}, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderThickness="1"
                            BorderBrush="{Binding Day.IsCurrentDay, Converter={StaticResource DayHeaderBorderBrush}, RelativeSource={RelativeSource TemplatedParent}}"
                            VerticalAlignment="Top">
                    <Grid>
                      <Border Height="20" Background="{StaticResource TodayBorderAdditionalNormalBrush}"
                              Visibility="{Binding Day.IsCurrentDay, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}" />
                      <TextBlock Margin="4, 0, 0, 0" Text="{Binding StartDate.Day, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" />
                      <TextBlock HorizontalAlignment="Center" Text="{Binding StartDate, Converter={StaticResource DayOfWeekString}, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                  </Border>
                </Grid>
                <Grid Margin="0,0,1,0">
                  <Border BorderThickness="0,0,0,1" BorderBrush="Black" />
                  <ScrollViewer Margin="50, 0, 0, 0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0"
                                BorderThickness="0" MaxHeight="80" FocusVisualStyle="{x:Null}">
                    <local:SmallSchedulerCanvas Days="{Binding Days, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource DayHeaderShowingMultiDayItemsOnly}"
                                                CreateHereElementDuration="1440"
                                                />
                  </ScrollViewer>
                  <Border BorderThickness="0,0,0,2"
                            BorderBrush="{Binding Day.IsCurrentDay, Converter={StaticResource DayHeaderBottomLineBrush}, RelativeSource={RelativeSource TemplatedParent}}"
                            Margin="50,0,17,0" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- The body - large timeslotted surface for detailed view of day's items -->
            <Border VerticalAlignment="Stretch" Grid.Row="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.ColumnSpan="5" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0"
                              Margin="0,0,1,0" x:Name="PART_ScrollViewer" FocusVisualStyle="{x:Null}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="15" VerticalAlignment="Top" BorderBrush="#BB5503" BorderThickness="0,0,0,1"
                            Margin="{Binding Now, Converter={StaticResource TimePointerMargin}, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="{Binding Day.IsCurrentDay, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{StaticResource TimePointerBackground}"
                            />
                    <ItemsControl ItemsSource="{Binding Times, RelativeSource={RelativeSource TemplatedParent}}"
                                  ItemTemplate="{StaticResource TimeLineUnitTemplate}" Margin="0, -1, 0, 0" />
                    <local:SchedulerCanvas Days="{Binding Days, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1"
                                           Style="{StaticResource SchedulerCanvasBase}"
                                           CreateHereButtonStyle="{StaticResource AddAppointmentButtonStyle}"
                                           />
                    <Border Grid.Column="1" BorderThickness="2,0,2,2"
                            BorderBrush="{Binding Day.IsCurrentDay, Converter={StaticResource DayBodyBorderBrush}, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Grid>
                </ScrollViewer>
                <Button Style="{StaticResource PreviousAppointmentButtonStyle}" Grid.Column="1"
                        Command="{x:Static local:SchedulerCommands.PreviousScheduleItemCommand}"
                        Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                        IsEnabled="{Binding IsPreviousWingEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
                <Button Style="{StaticResource NextAppointmentButtonStyle}" Grid.Column="3"
                        Command="{x:Static local:SchedulerCommands.NextScheduleItemCommand}"
                        Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                        IsEnabled="{Binding IsNextWingEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:DateTimeToBrushConverter x:Key="DayBodyBorderBrushConverter" TodayBrush="{StaticResource TodayBrush}" NeutralBrush="Transparent" />

  <Style x:Key="{x:Type local:DaySchedule}" TargetType="{x:Type local:DaySchedule}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0"
                          x:Name="PART_ScrollViewer" FocusVisualStyle="{x:Null}">
              <Grid>
                <local:SchedulerCanvas Name="PART_SchedulerCanvas" Height="1440"
                                       Style="{StaticResource SchedulerCanvasBase}"
                                       CreateHereButtonStyle="{StaticResource AddAppointmentButtonStyle}"
                                       FocusVisualStyle="{x:Null}" />
                <Border Grid.Column="1" BorderThickness="2,0,2,2"
                        BorderBrush="{Binding Date, Converter={StaticResource DayBodyBorderBrushConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </ScrollViewer>
            <Button Style="{StaticResource PreviousAppointmentButtonStyle}" Grid.Column="1" HorizontalAlignment="Left"
                        Command="{x:Static local:SchedulerCommands.PreviousScheduleItemCommand}"
                        Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                        IsEnabled="{Binding IsPreviousWingEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
            <Button Style="{StaticResource NextAppointmentButtonStyle}" Grid.Column="3" HorizontalAlignment="Right"
                        Command="{x:Static local:SchedulerCommands.NextScheduleItemCommand}"
                        Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                        IsEnabled="{Binding IsNextWingEnabled, RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:DateTimeToBrushConverter x:Key="DayHeaderBottomLineBrushConverter" TodayBrush="{StaticResource TodayBrush}" NeutralBrush="#5D8CC9" />

  <Style x:Key="{x:Type local:DayScheduleSummary}" TargetType="{x:Type local:DayScheduleSummary}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0"
                        BorderThickness="0" Height="80" FocusVisualStyle="{x:Null}">
            <Grid>
              <local:SmallSchedulerCanvas Name="PART_SchedulerCanvas" Height="80"
                                          Style="{StaticResource DayHeaderShowingMultiDayItemsOnly}"
                                          CreateHereElementDuration="1440"
                                          FocusVisualStyle="{x:Null}" />
              <Border BorderThickness="0,0,0,2"
                      BorderBrush="{Binding Date, Converter={StaticResource DayHeaderBottomLineBrushConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <LinearGradientBrush x:Key="WhiteTimePointerBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="white" Offset="0" />
    <GradientStop Color="#F9CC5F" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="{x:Type local:TimeOfDayBar}" TargetType="{x:Type local:TimeOfDayBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0"
                        BorderThickness="0" FocusVisualStyle="{x:Null}" Name="PART_ScrollViewer">
            <Grid>
              <Border Margin="-10,0,0,0">
                <Border Height="15" VerticalAlignment="Top" BorderThickness="0,0,0,1" BorderBrush="#BB5503"
                      Margin="{Binding Now, Converter={StaticResource TimePointerMargin}, RelativeSource={RelativeSource TemplatedParent}}"
                      Visibility="{Binding IsTimePointerVisible, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{StaticResource WhiteTimePointerBackground}" />
              </Border>
              <ItemsControl ItemsSource="{Binding Times, RelativeSource={RelativeSource TemplatedParent}}"
                            ItemTemplate="{StaticResource TimeLineUnitTemplate}" />
            </Grid>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                         Week of Month Button
  ==========================================================================================================================
  -->

  <LinearGradientBrush x:Key="SidewaysButtonNormalBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#DBDEE1" Offset="0" />
    <GradientStop Color="#D3D6DA" Offset="0.5" />
    <GradientStop Color="#B4BAC1" Offset="0.5" />
    <GradientStop Color="#CBCED4" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SidewaysButtonMouseOverBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#DCDFE3" Offset="0" />
    <GradientStop Color="#D9DBDE" Offset="0.5" />
    <GradientStop Color="#CBCED4" Offset="0.5" />
    <GradientStop Color="#D4D7DC" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SidewaysButtonPressedBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#E6EAEF" Offset="0" />
    <GradientStop Color="#E2E6EC" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="SidewaysButtonBorderBrush" Color="#B0B6BE" />

  <Style x:Key="SidewaysButton" TargetType="Button">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Name="Border" Width="20" Background="{StaticResource SidewaysButtonNormalBrush}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Padding="3" BorderThickness="0">
              <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" FontSize="10"
                             Width="200" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,-200,0" IsHitTestVisible="False">
              <TextBlock.RenderTransform>
                <TransformGroup>
                  <RotateTransform Angle="-90" CenterX="100" />
                  <TranslateTransform X="-107" Y="7" />
                </TransformGroup>
              </TextBlock.RenderTransform>
              </TextBlock>
            </ScrollViewer>
            <Border Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource SidewaysButtonBorderBrush}" />
            <Border Background="Transparent" BorderThickness="1,1,0,1" BorderBrush="#F6F7F8" Opacity="0" Name="OuterPressedBorder" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SidewaysButtonMouseOverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SidewaysButtonPressedBrush}" />
              <Setter TargetName="OuterPressedBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                                 Month View
  ==========================================================================================================================
  -->

  <local:DateTimeToDayOfMonthStringConverter x:Key="DayOfMonthString" />

  <local:BooleanToStyleConverter x:Key="DayOfMonthButtonStyle" TrueStyle="{StaticResource SchedulerTodayButtonStyle}" FalseStyle="{StaticResource DayButtonStyle}" />

  <DataTemplate x:Key="DayOfMonthTemplate">
    <Grid Margin="0,0,-1,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="20" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Button Style="{Binding IsCurrentDay, Converter={StaticResource DayOfMonthButtonStyle}}"
              Command="{x:Static local:SchedulerCommands.GoToDayCommand}"
              CommandParameter="{Binding}"
              />
      <TextBlock Margin="5, 1, 0, 0" Text="{Binding Date, Converter={StaticResource DayOfMonthString}}" IsHitTestVisible="False" FontWeight="Bold" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="WeekOfMonthTemplate">
    <Grid Name="Grid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource SidewaysButton}" HorizontalAlignment="Left" Margin="0, 20, 0, 0"
              Content="{Binding DateRangeDisplayInfo, Converter={StaticResource DateRangeToAbbreviatedTitle}}"
              Command="{x:Static local:SchedulerCommands.GoToWeekCommand}"
              CommandParameter="{Binding}"
              />
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="20" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <local:SmallSchedulerCanvas Grid.Row="1"
                                    Days="{Binding Days}"
                                    TargetMonth="{Binding Month}"
                                    Style="{StaticResource SmallDayDisplayShowingAllItems}"
                                    CreateHereElementDuration="1440"
                                    />
        <ItemsControl ItemsSource="{Binding Days}"
                      ItemTemplate="{StaticResource DayOfMonthTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </Grid>
  </DataTemplate>

  <SolidColorBrush x:Key="SchedulerTextColor" Color="#6F7074" />
  <SolidColorBrush x:Key="WeekNameSeperatorBorder" Color="#6F7074" />

  <DataTemplate x:Key="DayOfWeekNameTemplate">
    <TextBlock Text="{Binding}" TextAlignment="Center" Foreground="{StaticResource SchedulerTextColor}" />
  </DataTemplate>
  
  <Style x:Key="MonthViewStyle" TargetType="local:MonthView">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Day of week header seperators -->
              <UniformGrid Margin="26, 0, 0, 0" Rows="1">
                <Border BorderBrush="{StaticResource WeekNameSeperatorBorder}" BorderThickness="0,0,1,0" />
                <Border BorderBrush="{StaticResource WeekNameSeperatorBorder}" BorderThickness="0,0,1,0" />
                <Border BorderBrush="{StaticResource WeekNameSeperatorBorder}" BorderThickness="0,0,1,0" />
                <Border BorderBrush="{StaticResource WeekNameSeperatorBorder}" BorderThickness="0,0,1,0" />
                <Border BorderBrush="{StaticResource WeekNameSeperatorBorder}" BorderThickness="0,0,1,0" />
                <Border BorderBrush="{StaticResource WeekNameSeperatorBorder}" BorderThickness="0,0,1,0" />
                <Border />
              </UniformGrid>
              <!-- Day of week headers -->
              <ItemsControl ItemsSource="{Binding DayOfWeekNames, RelativeSource={RelativeSource TemplatedParent}}"
                            ItemTemplate="{StaticResource DayOfWeekNameTemplate}" Margin="26,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- Schedule detail -->
              <Grid Grid.Row="1" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="25" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Month.Weeks, RelativeSource={RelativeSource TemplatedParent}}" Margin="5,0,1,0"
                                ItemTemplate="{StaticResource WeekOfMonthTemplate}"
                                Grid.ColumnSpan="4"
                                >
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Style="{StaticResource PreviousAppointmentButtonStyle}" Grid.Column="1"
                          Command="{x:Static local:SchedulerCommands.PreviousScheduleItemCommand}"
                          Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                          IsEnabled="{Binding IsPreviousWingEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                          />
                <Button Style="{StaticResource NextAppointmentButtonStyle}" Grid.Column="3"
                          Command="{x:Static local:SchedulerCommands.NextScheduleItemCommand}"
                          Visibility="{Binding ShowWings, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}"
                          IsEnabled="{Binding IsNextWingEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                          />
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==========================================================================================================================
                                                               Scheduler Style
  ==========================================================================================================================
  -->

  <Style x:Key="ScheduleItemDialogStyle" TargetType="local:ScheduleItemDialog">
    <Style.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlack.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Style.Resources>
  </Style>

  <Style x:Key="RecurrenceDialogStyle" TargetType="local:RecurrenceDialog">
    <Style.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlack.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Style.Resources>
  </Style>

  <Style x:Key="DeleteRecurrenceDialogStyle" TargetType="local:DeleteRecurrenceDialog">
    <Style.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlack.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Style.Resources>
  </Style>

  <SolidColorBrush x:Key="ViewChangerPanelBackground" Color="#9199A4" />
  <SolidColorBrush x:Key="ViewChangerPanelBorder" Color="#4C535C" />
  <SolidColorBrush x:Key="NavigationBackground" Color="#F0F1F2" />

  <Style x:Key="{x:Type local:Scheduler}" TargetType="{x:Type local:Scheduler}">
    <Setter Property="WeekViewStyle" Value="{StaticResource WeekViewStyle}" />
    <Setter Property="DayViewStyle" Value="{StaticResource DayViewStyle}" />
    <Setter Property="MonthViewStyle" Value="{StaticResource MonthViewStyle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="ScheduleItemDialogStyle" Value="{StaticResource ScheduleItemDialogStyle}" />
    <Setter Property="RecurrenceDialogStyle" Value="{StaticResource RecurrenceDialogStyle}" />
    <Setter Property="DeleteRecurrenceDialogStyle" Value="{StaticResource DeleteRecurrenceDialogStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Scheduler}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Week / month / day selection -->
              <Grid Height="30">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Name="PART_DayViewButton" GroupName="ViewChangeButtons"
                           Content="{Binding Formatter.DayButtonContent, RelativeSource={RelativeSource TemplatedParent}}"
                               Command="{x:Static local:SchedulerCommands.SwitchToDayViewCommand}"
                               Style="{StaticResource ViewChangeButtonStyle}" BorderThickness="0,0,1,1"
                             Cursor="Hand" />
                <RadioButton Name="PART_WeekViewButton"  Grid.Column="1" GroupName="ViewChangeButtons"
                           Content="{Binding Formatter.WeekButtonContent, RelativeSource={RelativeSource TemplatedParent}}"
                               Command="{x:Static local:SchedulerCommands.SwitchToWeekViewCommand}"
                               Style="{StaticResource ViewChangeButtonStyle}" BorderThickness="0,0,1,1"
                             Cursor="Hand" />
                <RadioButton Name="PART_MonthViewButton"
                           Content="{Binding Formatter.MonthButtonContent, RelativeSource={RelativeSource TemplatedParent}}"
                               Command="{x:Static local:SchedulerCommands.SwitchToMonthViewCommand}"
                               Grid.Column="2" GroupName="ViewChangeButtons"
                               Style="{StaticResource ViewChangeButtonStyle}" BorderThickness="0,0,1,1"
                             Cursor="Hand" />
                <Border Grid.Column="3" BorderThickness="0,0,0,1" BorderBrush="{StaticResource ViewChangerPanelBorder}" Background="{StaticResource ViewChangerPanelBackground}">
                  <StackPanel Orientation="Horizontal"
                              Visibility="{Binding IsInWeekView, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
                    <RadioButton Name="PART_WorkWeekRadioButton" GroupName="WeekLengthButtonGroup" Margin="20,0,0,0" VerticalAlignment="Center"
                               Content="{Binding Formatter.ShowWorkWeekLabelContent, RelativeSource={RelativeSource TemplatedParent}}"
                                 Command="{x:Static local:SchedulerCommands.ShowWorkWeekCommand}" />
                    <RadioButton Name="PART_FullWeekRadioButton" GroupName="WeekLengthButtonGroup" Margin="10,0,8,0" VerticalAlignment="Center" IsChecked="True"
                               Content="{Binding Formatter.ShowFullWeekLabelContent, RelativeSource={RelativeSource TemplatedParent}}"
                                 Command="{x:Static local:SchedulerCommands.ShowFullWeekCommand}" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Prev / Next / Caption / Commands -->
              <local:SchedulerNavigationBar DateRange="{Binding CurrentView.DateRangeDisplayInfo, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{StaticResource NavigationBackground}"
                                          Grid.Row="1" Style="{StaticResource NavigationBarStyle}"
                                          ToolBarContent="{Binding ToolBarContent, RelativeSource={RelativeSource TemplatedParent}}"
                                          />

              <!-- The actual schedule -->
              <Border Name="ContentBorder" Background="{StaticResource NavigationBackground}" Grid.Row="2">
                <ContentControl HorizontalContentAlignment="Stretch" Content="{Binding CurrentView, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>