<dxb:BarSubItem
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="UnitConverterManager.MenuControls.BarCommonItems"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UnitConverterManager"
             xmlns:properties="clr-namespace:UnitConverterManager.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/UnitConverters.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewUnitConverters" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="170" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="170" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectUnitConverters" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="150" x:Name="biUnitConverter" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <dxb:BarButtonItem  x:Name="biAddNewLocale"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UCMaddlanguage}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewLocale}" />
            <dxb:BarButtonItem  x:Name="biAddNewConverter"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UCMaddstring}"  
                             Command="{x:Static self:UIGeneralCommands.AddNewConverter}" />
            <dxb:BarItemLinkSeparator/>
            <dxb:BarButtonItem  x:Name="biRemoveLocale" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource UCMRemoveLanguage}"  
                             Command="{x:Static self:UIGeneralCommands.RemoveLocale}" />
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItem  x:Name="biRenameLocale"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource RenameSmall}"  
                             Command="{x:Static self:UIGeneralCommands.RenameLocale}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biToolsUnitConverters" Content="{x:Static translatableMenu:Resources.ToolsHeaderTitle}">
        <dxb:BarButtonItem MergeOrder="70" x:Name="biImportConverters" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UCMimportdata}"  
                             Command="{x:Static self:UIGeneralCommands.ImportConverters}" />

        <dxb:BarButtonItem MergeOrder="80" x:Name="biExportConverters" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                             Glyph="{StaticResource UCMexportdata}"  
                             Command="{x:Static self:UIGeneralCommands.ExportConverters}" />
    </dxb:BarSubItem>
</dxb:BarSubItem>
