<UserControl x:Class="UnitConverterManager.Controls.UConverterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             Height="100" Width="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.ExpressionEditor_Expression}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtExpression" Validation.ErrorTemplate="{x:Null}" 
                     Text="{Binding Expression, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1"/>
            <ContentPresenter Grid.Column="2" 
                Content="{Binding ElementName=txtExpression, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="30,0,30,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.ExpressionEditor_Functions}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2,2,2,2"/>
            <ComboBox x:Name="cmbFunctions" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" IsEditable="False" SelectedIndex="0" Height="18" />
            <Button Grid.Column="2" VerticalAlignment="Center" Click="AddFunction" >
                <Button.Content>
                    <Image Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                </Button.Content>

            </Button>
        </Grid>
    </Grid>
</UserControl>
