<UserControl x:Class="UnitConverterManager.UnitConverterEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UnitConverterManager"
             xmlns:properties="clr-namespace:UnitConverterManager.Properties"
             xmlns:converters="clr-namespace:UnitConverterManager.Converters"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/UnitConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CSVIdConverter x:Key="CSVIdConverter"/>
            <converters:ConverterItemToSummary x:Key="ConverterItemToSummary" />
        </ResourceDictionary>
    </UserControl.Resources>
    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                <dxb:BarButtonItem Command="Properties" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewLocale}" Content="{x:Static properties:UICommandResource.AddNewLocaleText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewConverter}" Content="{x:Static properties:UICommandResource.AddNewConverterText}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.ImportConverters}" Content="{x:Static properties:UICommandResource.ImportConvertersText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.ExportConverters}" Content="{x:Static properties:UICommandResource.ExportConvertersText}"/>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />
        
        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />
        
        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="ApplicationCommands.Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="ApplicationCommands.Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="ApplicationCommands.Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    PreviewExecuted="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />

        <CommandBinding Command="ApplicationCommands.Redo"
                    PreviewExecuted="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewLocale}" 
                    Executed="OnAddNewConverter" 
                    CanExecute="CanAddNewConverter" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewConverter}" 
                    Executed="OnAddNewConverterItem" 
                    CanExecute="CanAddNewConverterItem" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ImportConverters}" 
                    Executed="OnImportConverters" 
                    CanExecute="CanImportConverters" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ExportConverters}" 
                    Executed="OnExportConverters" 
                    CanExecute="CanExportConverters" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.RemoveLocale}" 
                    Executed="OnRemoveLocale" 
                    CanExecute="CanRemoveLocale" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.RemoveConverter}"
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.RenameLocale}"
                    Executed="OnRenameItem" 
                    CanExecute="CanRenameItem" />


    </UserControl.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Toolbar-->
        <dxb:BarContainerControl ContainerType="Top" x:Name="toolbar" Visibility="Collapsed">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                <dxb:BarButtonItem Glyph="{StaticResource UCMaddlanguage}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                        Command="{x:Static self:UIGeneralCommands.AddNewLocale}"/>
                <dxb:BarButtonItem Glyph="{StaticResource UCMaddstring}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                        Command="{x:Static self:UIGeneralCommands.AddNewConverter}"/>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Glyph="{StaticResource UCMimportdata}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                        Command="{x:Static self:UIGeneralCommands.ImportConverters}"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!--<ProgressBar Grid.Row="1" x:Name="progressBar" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top"/>-->
        <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible" VerticalAlignment="Stretch"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                SelectionMode="Cell"
                                Name="gridDataControl"
                                EnableSmartColumnsGeneration="True"
                                AutoPopulateColumns="False" 
                                AllowDrop="True"  
                                AllowLiveDataShaping="False"    
                                CustomColumnSort="GridDataControl_CustomColumnSort"
                                dx:DXSerializer.SerializationID="gridDataControl" 
                                dx:DXSerializer.StoreLayoutMode="All" 
                                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
          <dxg:GridControl.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Cut"
                              Executed="OnCommandCut"
                              CanExecute="CanCommandCut" />
                    <CommandBinding Command="ApplicationCommands.Paste"
                              Executed="OnCommandPaste"
                              CanExecute="CanCommandPaste" />
                    <CommandBinding Command="ApplicationCommands.Copy"
                              Executed="OnCommandCopy"
                              CanExecute="CanCommandCopy" />
          </dxg:GridControl.CommandBindings>
          <dxg:GridControl.Resources>
                <DataTemplate x:Key="cellTemplate">
                    <DockPanel  ToolTipService.IsEnabled="False">
                        <Button DockPanel.Dock="Right" Click="DlgButton_Click_Clear">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="DlgButton_Click">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBlock ToolTip="{Binding Value, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConverterItemToSummary}}" Text="{Binding Value, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ConverterItemToSummary}}" />
                    </DockPanel>
                </DataTemplate>
            </dxg:GridControl.Resources>
            <dxg:GridControl.Columns>
              <dxg:GridColumn ReadOnly="False" x:Name="colID" AllowEditing="True"
                              SortMode ="Custom" GroupInterval="Value" ShowGroupedColumn="True"
                              AllowGrouping ="True" AllowSorting ="True" FieldName="ID" Header="ID"
                              DisplayMemberBinding="{Binding Path=ID, Mode=TwoWay}">
                <dxg:GridColumn.CellTemplate>
                  <DataTemplate>
                    <DockPanel LastChildFill="True">
                      <dxe:TextEdit Text="{Binding Data.ID, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaskType="None"/>
                    </DockPanel>
                  </DataTemplate>
                </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>

                <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False"
                            BestFitMode="VisibleRows"
                            PreviewKeyDown="gridDataControl_PreviewKeyDown"
                            PreviewMouseDown="gridDataControl_PreviewMouseDown"
                            RowDoubleClick="gridDataControl_RowDoubleClick"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Cell" 
                            MultiSelectMode="None">
                    <!--<dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>-->
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
