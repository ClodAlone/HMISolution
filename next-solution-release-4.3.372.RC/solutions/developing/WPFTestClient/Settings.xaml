<UserControl x:Class="WPFTestClient.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFTestClient"
             mc:Ignorable="d" 
             Height="300" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Server:" Grid.Column="0" Grid.Row="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="txtServer" Grid.Column="1" Grid.Row="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <TextBlock Text="User:" Grid.Column="0" Grid.Row="1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="txtUser" Grid.Column="1" Grid.Row="1" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <TextBlock Text="Passwrod:" Grid.Column="0" Grid.Row="2" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtPassword" Grid.Column="1" Grid.Row="2" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <Button Content="Ok" Grid.Column="0" Grid.Row="4" Margin="5" IsDefault="True" Click="ButtonOk_Click"/>
        <Button Content="Cancel" Grid.Column="1" Grid.Row="4" Margin="5" IsDefault="False" IsCancel="True" Click="ButtonCancel_Click"/>
    </Grid>
</UserControl>
