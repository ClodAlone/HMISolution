<UserControl x:Class="SerialDriverCodeBaseEx.Controls.SerialChannelSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:SerialDriverCodeBase.Properties"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="SerialStack" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/> 
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="11" HorizontalAlignment="Stretch" Background="Transparent" />-->
            <TextBlock Name="TxBKeepOpened" Text="{x:Static properties:Resources.KeepOpened}" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,2" x:FieldModifier="public"/>
            <CheckBox Name="KeepOpened" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Margin="0,5"
                  IsChecked="{Binding KeepOpened, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

            <TextBlock Name="TxBPort" Text="{x:Static properties:Resources.Port}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" x:FieldModifier="public"/>
            <ComboBox Name="CmbPort" Grid.Column="2" Grid.Row="1"  IsEditable="True" x:FieldModifier="public"
                  Text="{Binding CommPortName}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Value"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding CommPortName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" >
            </ComboBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbPort, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBBaud" Text="{x:Static properties:Resources.BaudRate}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1" x:FieldModifier="public"/>
            <ComboBox Name="CmbBaud" Grid.Column="2" Grid.Row="2" x:FieldModifier="public"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Value"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding CommPortBaudRate, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=CmbBaud, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBDataBits" Text="{x:Static properties:Resources.DataBits}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="DataBits" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" x:FieldModifier="public"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding CommPortDataBits, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=DataBits, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBParity" Text="{x:Static properties:Resources.Parity}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1" x:FieldModifier="public"/>
            <ComboBox Name="CmbParity" Grid.Column="2" Grid.Row="4" x:FieldModifier="public"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedIndex="{Binding Path=CommPortParity, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  >
            </ComboBox>
            <ContentPresenter Grid.Row="4" Grid.Column="3" 
            Content="{Binding ElementName=CmbParity, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBStop" Text="{x:Static properties:Resources.StopBits}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1" x:FieldModifier="public"/>
            <ComboBox Name="CmbStop" Grid.Column="2" Grid.Row="5" x:FieldModifier="public"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedValue="{Binding Path=CommPortStopBits, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="5" Grid.Column="3" 
            Content="{Binding ElementName=CmbStop, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBHandShake" Text="{x:Static properties:Resources.Handshake}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1" x:FieldModifier="public"/>
            <ComboBox Name="CmbHandShake" Grid.Column="2" Grid.Row="6" x:FieldModifier="public"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedIndex="{Binding Path=CommPortHandshake, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="6" Grid.Column="3" 
            Content="{Binding ElementName=CmbHandShake, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBCommPortRtsEnable" Text="{x:Static properties:Resources.RTSEnable}" VerticalAlignment="Center" Grid.Row="7" Margin="0,1" x:FieldModifier="public"/>
            <CheckBox Name="CommPortRtsEnable" Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Margin="0,5"
                  IsChecked="{Binding CommPortRtsEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

            <TextBlock Name="TxBCommPortDtrEnable" Text="{x:Static properties:Resources.DTREnable}" VerticalAlignment="Center" Grid.Row="8" Margin="0,1" x:FieldModifier="public"/>
            <CheckBox Name="CommPortDtrEnable" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center"  x:FieldModifier="public" Margin="0,5"
                  IsChecked="{Binding CommPortDtrEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

            <TextBlock Name="TxBRxTimeout" Text="{x:Static properties:Resources.RXTimeout}" VerticalAlignment="Center" Grid.Row="9" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="RxTimeout" Grid.Column="2" Grid.Row="9" HorizontalAlignment="Stretch" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding CommPortReadTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="9" Grid.Column="3" 
            Content="{Binding ElementName=RxTimeout, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBTxTimeout" Text="{x:Static properties:Resources.TXTimeout}" VerticalAlignment="Center" Grid.Row="10" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="TxTimeout" Grid.Column="2" Grid.Row="10" HorizontalAlignment="Stretch" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding CommPortWriteTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="10" Grid.Column="3" 
            Content="{Binding ElementName=TxTimeout, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </StackPanel>
</UserControl>
