<UserControl x:Class="TerraBrowser.TerraBrowser" Width="600" Height="400"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerraBrowser"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:TerraBrowser.Properties">
    <UserControl.Resources>
        <converters:DoubleToLatitudeDegreesConverter x:Key="DoubleToLatitudeDegreesConverter"/>
        <converters:DoubleToLongitudeDegreesConverter x:Key="DoubleToLongitudeDegreesConverter"/>
        <DataTemplate x:Key="flagTemplate">
            <Grid Width="12" Height="12">
                <Ellipse Fill="#FF333333"/>
                <Ellipse Margin="3" Fill="White"/>
                <Grid.RenderTransform>
                    <TranslateTransform X="-6" Y="-6"/>
                </Grid.RenderTransform>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <dxm:MapControl Name="mapControl" ZoomLevel="3" CenterPoint="44.647115,10.9251857" IsManipulationEnabled="True"
                        MouseDoubleClick="mapControl_MouseDoubleClick">
            <dxm:MapControl.CoordinatesPanelOptions>
                <dxm:CoordinatesPanelOptions x:Name="coordinatesPanel"/>
            </dxm:MapControl.CoordinatesPanelOptions>

            <dxm:ImageTilesLayer >
                <dxm:ImageTilesLayer.DataProvider>
                    <dxm:BingMapDataProvider BingKey="AlyRXdH0-7gITM8V4SpqrJg7QxwD9zzbzLIICmxrhn1LS8rtJn7bpcCym6NK0qGb" Kind="Hybrid"/>
                    <!--<dxm:OpenStreetMapDataProvider/>-->
                </dxm:ImageTilesLayer.DataProvider>
            </dxm:ImageTilesLayer>
            <dxm:VectorLayer>
                <dxm:MapItemStorage>
                    <dxm:MapItemStorage.Items>
                        <dxm:MapDot x:Name="mapDot" Visible="True" ShapeKind="Circle" Size="10" 
                                Fill="#FFFBF00C">
                            <!--region #ShapeTitleOptions-->
                            <dxm:MapDot.TitleOptions>
                                <dxm:ShapeTitleOptions x:Name="shapeTitleOptions" Visible="True"/>
                            </dxm:MapDot.TitleOptions>
                            <!--endregion #ShapeTitleOptions-->
                        </dxm:MapDot>
                    </dxm:MapItemStorage.Items>
                </dxm:MapItemStorage>
            </dxm:VectorLayer>
        </dxm:MapControl>
        
        <StackPanel Orientation="Vertical" Grid.Row="1" Margin="2,2,2,2">
            <Grid Margin="2,2,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static properties:Resources.Latitude}" />
                <!--<TextBox Grid.Column="1" LostKeyboardFocus="TextBox_LostKeyboardFocus" LostFocus="TextBox_LostFocus"  x:Name="txtLatidute" HorizontalAlignment="Stretch"/>-->
                <!--EditValue="{Binding Location,Converter={StaticResource DoubleToTimeConverter},ConverterParameter=0,RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"-->
                <dxe:TextEdit x:Name="txtLatidute" Grid.Row="0" Grid.Column="4"
                          MaskType="Regular" Mask="\d{3}° \d{2}' \d{2}'' >[NS]" 
                          MaskShowPlaceHolders="False" Text="{Binding Latitude, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, 
                          Converter={StaticResource DoubleToLatitudeDegreesConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          DisplayFormatString="" MaskUseAsDisplayFormat="True"/>
            </Grid>

            <Grid Margin="2,2,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static properties:Resources.Longitude}" />
                <!--<TextBox Grid.Column="1"  LostKeyboardFocus="TextBox_LostKeyboardFocus" LostFocus="TextBox_LostFocus" x:Name="txtLongitude" HorizontalAlignment="Stretch"/>-->
                <dxe:TextEdit x:Name="txtLongitude" Grid.Row="0" Grid.Column="4"
                          MaskType="Regular" Mask="\d{3}° \d{2}' \d{2}'' >[WE]" 
                          MaskShowPlaceHolders="False" Text="{Binding Longitude, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, 
                          Converter={StaticResource DoubleToLongitudeDegreesConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          DisplayFormatString="" MaskUseAsDisplayFormat="True"/>
            </Grid>
            <Grid Margin="2,2,2,2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2.7*"/>
                    <ColumnDefinition Width=".3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static properties:Resources.Address}"/>
                <TextBox Grid.Column="1" x:Name="txtAddress" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="2" Content="{x:Static properties:Resources.FetchBtnTitle}" Command="{Binding Path=FetchCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
