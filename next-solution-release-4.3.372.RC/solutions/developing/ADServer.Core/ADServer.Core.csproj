<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp2.0</TargetFramework>
	<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>ADServer</RootNamespace>
    <AssemblyName>ADispatcherServer.Core</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <DefineConstants>NET_CORE;NET_STANDARD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;NET_CORE;NET_STANDARD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>NET_CORE;NET_STANDARD</DefineConstants>
  </PropertyGroup>

 <ItemGroup>
    <None Remove="ADServer.ADUAServer.Config.xml" />
    <None Remove="OPCUAClient.Config.xml" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="..\ADServer\ADServer.cs" Link="ADServer.cs" />
    <Compile Include="..\ADServer\ADUANodeManager.cs" Link="ADUANodeManager.cs" />
    <Compile Include="..\ADServer\ADUAServer.cs" Link="ADUAServer.cs" />
    <Compile Include="..\ADServer\NotificationBase.cs" Link="NotificationBase.cs" />
    <Compile Include="..\ADServer\NotificationPersistence.cs" Link="NotificationPersistence.cs" />
    <Compile Include="..\ADServer\PluginThread.cs" Link="PluginThread.cs" />
    <Compile Include="..\ADServer\Program.cs" Link="Program.cs" />
    <Compile Include="..\ADServer\Properties\Resources.Designer.cs" Link="Properties\Resources.Designer.cs" />
    <Compile Include="..\ADServer\Properties\Settings.Designer.cs" Link="Properties\Settings.Designer.cs" />
    <Compile Include="..\ADServer\UsersAndRolesMapping.cs" Link="UsersAndRolesMapping.cs" />
    <Compile Include="..\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
    <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>

 <ItemGroup>
    <PackageReference Include="DevExpress.Data" Version="21.2.13" />
    <PackageReference Include="DevExpress.Xpo" Version="21.2.13" />
    <PackageReference Include="log4net" Version="2.0.14" />
    <PackageReference Include="Mindscape.Raygun4Net.NetCore" Version="6.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\..\Sources\UA SDK\UA-.NETStandard\Stack\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\..\..\Sources\UA SDK\UA-.NETStandard\Libraries\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\Sources\UA SDK\UA-.NETStandard\Libraries\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\DriverBaseClassLibrary\DriverBaseInterfaces.csproj" />
    <ProjectReference Include="..\ConcurrentLog4Net\ConcurrentLog4Net.csproj" />
    <ProjectReference Include="..\Dynamics\MSZ.csproj" />
    <ProjectReference Include="..\ADModel\ADModel.csproj" />
	<ProjectReference Include="..\ADPluginBase\ADPluginBase.csproj" />
    <ProjectReference Include="..\ADPluginInterfaces\ADPluginInterfaces.csproj" />
    <ProjectReference Include="..\ADServerInfo\ADServerInfo.csproj" />
    <ProjectReference Include="..\OPCUAViewModel\OPCUAViewModel.csproj" />
    <ProjectReference Include="..\UFInterfaces\UFInterfaces.csproj" />
    <ProjectReference Include="..\UFUAServerBase\UFUAServerBase.csproj" />
    <ProjectReference Include="..\UFUATag\UFUAModel.csproj" />
	<ProjectReference Include="..\UserModel\UFUserModel.csproj" />
    <ProjectReference Include="..\Utilities\Utilities.csproj" />
    <ProjectReference Include="..\ViewModelBase\ViewModelBase.csproj" />
	<Content Include="App.ico" />
	<Content Include="OPCUAClient.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
	<Content Update="ADispatcherServer.Core.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
   <None Include="..\ADServer\Properties\Settings.settings" Link="Properties\Settings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
    </None>
 </ItemGroup>

  <ItemGroup>
  <EmbeddedResource Include="..\ADServer\Properties\Resources.resx" Link="Properties\Resources.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="ADServer.ADUAServer.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ADispatcherServer.Core.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
</Project>
