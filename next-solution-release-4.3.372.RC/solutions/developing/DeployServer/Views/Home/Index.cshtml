@inject DeployServer.Services.IApplicationConfiguration AppSettings;
@{
    ViewData["Title"] = "Home Page";
}

<script src="~/scripts/core/coresignalr.js"></script>
<script src="~/scripts/core/busyIndicator.js"></script>
<script src="~/scripts/main.js"></script>

<div ng-controller="MainController">

    <h1 class="display-4">Welcome</h1>
    <div id="root" class="root">
        <table>
            <tr>
                <td data-i18n="sys.cpuloadpercent"></td>
                <td> {{cputotalload}} </td>
            </tr>
        </table>
        <div id="processGrid"/>
        <div class="gridToolbar">
            <div id="btnStart" />
            <div id="btnStop" />
            <div id="btnErase" />
        </div>

        <div class="loadpanel" dx-load-panel="busyOptions"></div>
        <div class="loadpanel" dx-load-panel="connectingOptions"></div>
    </div>


    <script>
        var proxyPath = '@AppSettings.ProxyPath';
        var connected = false;
        initMainPage();

        function initMainPage(scope) {

            var noDataText = i18next.t('messages.ConnectingToServer');

            var columns = [];
            columns.push({ dataField: "name", caption: i18next.t("Name"), width: 200 });
            columns.push({ dataField: "cpuUsage", caption: i18next.t("cpuUsage"), width: 200 });
            columns.push({ dataField: "pagedMemorySize", caption: i18next.t("PagedMemorySize"), width: 200 });

            var dataGrid = $("#processGrid").dxDataGrid({
                showBorders: true,
                editing: {
                    editEnabled: false,
                    editMode: 'row',
                    insertEnabled: false,
                    removeEnabled: false
                },
                allowColumnReordering: true,
                allowColumnResizing: true,
                onContentReady: function (e) {
                    $(e.component.element()).height($("#root").attr("height") - 100);
                    $(e.component.element()).width($("#root").attr("width"));
                },
                selection: {
                    mode: "multiple"
                },
                scrolling: {
                    mode: "virtual"
                },
                filterRow: {
                    visible: true
                },
                loadPanel: {
                    enabled: true
                },
                columns: columns,
                noDataText: noDataText,
                onSelectionChanged: function (e) {

                    var startDisabled = false;

                    btnStart.option("disabled", startDisabled);
                }
            }).dxDataGrid("instance");

            //$("#btnStart").dxButton({
            //    text: i18next.t("Start"),
            //    type: "normal",
            //    disabled: true,
            //    onClick: function (e) {

            //    }
            //}).dxButton("instance");

            if (!scope) {

                function pollScope() {

                    scope = angular.element($("#processGrid")).scope();
                    if (!scope) {
                        setTimeout(pollScope, 1000);
                    }
                    else {
                        pollData(scope, dataGrid);

                        var interval = setInterval(function () {
                            if (connected)
                                pollData(scope, dataGrid);

                        }, 1000);
                    }
                };

                setTimeout(pollScope, 1000);
                return;
            }

            pollData(scope, dataGrid);

            var interval = setInterval(function () {
                if (connected)
                    pollData(scope, dataGrid);

            }, 1000);
        }

        function pollData(scope, dataGrid) {

            scope.corehubconnection.invoke("GetProcessesData")
                .then((ret) => {

                    connected = true;
                    dataGrid.option("dataSource", ret);
                    dataGrid.option("loadPanel.enabled", false);

                    //btnStart.option("disabled", ret.length === 0);
                    //btnStop.option("disabled", ret.length === 0);
                })
                .catch(err => {

                    connected = true;
                    console.error(err.toString());
                    dataGrid.option("loadPanel.enabled", false);
                    var errorText = i18next.t('messages.ErrorGettingProcessesData') + err.toString();
                    dataGrid.option("noDataText", errorText);
                    scope.$broadcast(onError, { ex: err, value: errorText });
                });
        }
    </script>
</div>
