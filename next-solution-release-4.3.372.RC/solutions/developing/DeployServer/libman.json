{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "unpkg",
      "library": "devextreme@21.2.6",
      "destination": "wwwroot/lib/devextreme/"
    },
    {
      "library": "angular.js@1.8.2",
      "destination": "wwwroot/lib/angular.js/"
    },
    {
      "provider": "unpkg",
      "library": "@microsoft/signalr@6.0.0",
      "destination": "wwwroot/lib/microsoft/signalr/"
    },
    {
      "provider": "unpkg",
      "library": "@microsoft/signalr-protocol-msgpack@6.0.0",
      "destination": "wwwroot/lib/microsoft/signalr-protocol-msgpack/"
    },
    {
      "library": "i18next@21.4.2",
      "destination": "wwwroot/lib/i18next/"
    },
    {
      "library": "msgpack5@5.3.2",
      "destination": "wwwroot/lib/msgpack5/"
    },
    {
      "library": "i18next-xhr-backend@3.2.2",
      "destination": "wwwroot/lib/i18next-xhr-backend/"
    },
    {
      "library": "i18next-browser-languagedetector@6.1.2",
      "destination": "wwwroot/lib/i18next-browser-languagedetector/"
    },
    {
      "library": "jquery-i18next@1.2.1",
      "destination": "wwwroot/lib/jquery-i18next/"
    }
  ]
}