<UserControl x:Class="UFRecipeEditor.Controls.NewGroupDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties" 
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" Width="300" Height="150"
             d:DesignHeight="150" d:DesignWidth="300">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewGroupDefinitionTitle}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewGroupDefinitionName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GroupName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewGroupDefinitionDescription}" VerticalAlignment="Center" />
            <Grid x:Name="gridDesc" Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="textEditDesc" />
                <Button Click="textEditDesc_Click" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="textEditDesc_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            
            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewRecipeDefinitionDynamicSettings}" VerticalAlignment="Center" x:Name="textDynamicSettings"/>
            <Grid Grid.Column="1" Grid.Row="3" x:Name="gridDynamic">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding DynamicSettingsForEditing}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="0"/>
                <Button HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="Button_Click" Grid.Column="1">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2"  Click="Button_Clear" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
