<UserControl x:Class="UFRecipeEditor.Controls.NewDataValueDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:localconverters="clr-namespace:UFRecipeEditor.Converters"
             xmlns:properties="clr-namespace:UFRecipeEditor.Properties" 
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:commontemplate="clr-namespace:OPCUAViewModel.PropertyDataTemplate;assembly=OPCUAViewModel"
             mc:Ignorable="d" Width="300" Height="300"
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--<converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <localconverters:EncondingVisibilityConverter x:Key="EncondingVisibilityConverter" />-->
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewDataValueDefinitionTitle}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewDataValueDefinitionName}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding DataValueName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
                              Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewDataValueDefinitionDescription}" VerticalAlignment="Center" />
            <Grid x:Name="gridDescription" Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="textEditDesc" />
                <Button Click="textEditDesc_Click" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="textEditDesc_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            
            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewDataValueDefinitionDataType}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding DataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  x:Name="comboDataType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" IsEnabled="False"/>
            <ContentPresenter Grid.Row="3" Grid.Column="2" 
            Content="{Binding ElementName=comboDataType, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewDataValueInheritDataTypeFromTag}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Grid.Row="4" x:Name="checkBoxInheritDataTypeFromTag" IsChecked="{Binding InheritDataTypeFromTag}" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5" />

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.NewDataValueDefinitionDefaultValue}" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DefaultValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textDefaultValue" />
            <ContentPresenter Grid.Row="5" Grid.Column="2" 
                              Content="{Binding ElementName=textDefaultValue, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.NewDataValueDefinitionNullable}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Grid.Row="6" x:Name="checkBoxNullable" IsChecked="{Binding AllowNull}" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5" />
            
            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.NewDataValueDefinitionTagDataValue}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="7" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTag" AllowDataSync="False" AllowRemoteServer="False" />
            </DockPanel>
            <ContentPresenter Grid.Row="7" Grid.Column="2" 
                              Content="{Binding ElementName=textColumnTag, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.NewDataValueDefinitionTagIODataValue}" VerticalAlignment="Center" />
            <DockPanel Grid.Column="1" Grid.Row="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <commontemplate:OPCUAEntityReferencePropertyEditor x:Name="textColumnTagIO" AllowDataSync="False" AllowRemoteServer="True"/>
            </DockPanel>
            <ContentPresenter Grid.Row="8" Grid.Column="2" 
                              Content="{Binding ElementName=textColumnTagIO, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
