<dxb:BarManager
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="UFRecipeEditor.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFRecipeEditor.MenuControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="RecipeBarManagerToolbar"
             mc:Ignorable="d">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="recipeToolbar" x:Name="recipeToolBar1"
                    GlyphSize="Small" ShowDragWidget="True" 
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStartServerText"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStopServerText"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biServiceManager"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCertificateChecker"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewGroup"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewDataValue"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biMoveTagUp"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biMoveTagDown"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCsvImportExport"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biResetRecipeLayout"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCreateRecipeDatabase"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biTestRecipeEditor"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
