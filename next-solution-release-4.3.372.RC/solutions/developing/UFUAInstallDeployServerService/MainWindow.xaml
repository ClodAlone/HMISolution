<dx:DXWindow x:Class="UFUAInstallDeployServerService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:self="clr-namespace:UFUAInstallDeployServerService"
        xmlns:properties="clr-namespace:UFUAInstallDeployServerService.Properties"
        xmlns:uc="clr-namespace:UFUAServiceLibrary;assembly=UFUAServiceLibrary"
        xmlns:cc="http://progea.com/CommonControls"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        WindowStartupLocation="CenterScreen" BorderEffect="Default"
        Background="{x:Null}" SizeToContent="WidthAndHeight"
        Title="{x:Static properties:Resources.AppTitle}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />          
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static self:MainWindow.SaveSettings}" 
                    Executed="OnSaveSettings" 
                    CanExecute="CanSaveSettings" />

        <CommandBinding Command="{x:Static self:MainWindow.ReloadSettings}" 
                    Executed="OnReloadSettings" 
                    CanExecute="CanReloadSettings" />

    </Window.CommandBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Auto"
                                        Name="Scroll">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <uc:InstallServiceControl x:Name="serviceControl" Grid.ColumnSpan="4"/>
            <TextBlock Margin="2,2,2,6"  Text="{x:Static properties:Resources.UserName}" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox Margin="2" Name="userName" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Text="{Binding Settings.UserName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3"
            Content="{Binding ElementName=userName, Path=(Validation.Errors).CurrentItem}"/>
            <TextBlock Margin="2,2,2,6"  Text="{x:Static properties:Resources.Password}" Grid.Column="0" Grid.Row="2"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <cc:BindablePasswordBox Margin="5,0" x:Name="password" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"
                         Password="{Binding Settings.Password, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"/>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=userName, Path=(Validation.Errors).CurrentItem}"/>
            <TextBlock Margin="2,2,2,6"  Text="{x:Static properties:Resources.ProjectPath}" Grid.Column="0" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <DockPanel LastChildFill="True"   Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2">
                <Button Margin="2,0,0,0" DockPanel.Dock="Right" HorizontalAlignment="Left"  MinWidth="40" x:Name="btnBrowse" Click="btnBrowse_Click">
                    <Button.Content>
                        <Image Source="{StaticResource OpenFolder}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Margin="0" Name="projectPath" Text="{Binding Settings.ProjectPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"></TextBox>
            </DockPanel>
            <ContentPresenter Grid.Row="4" Grid.Column="3"
            Content="{Binding ElementName=projectPath, Path=(Validation.Errors).CurrentItem}"/>
            <DockPanel LastChildFill="False" Grid.Column="2" Grid.Row="5">
                <Button  Margin="5" 
                    Command="{x:Static self:MainWindow.SaveSettings}" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.SaveSettingsText}" />
                    </StackPanel>
                </Button>
                <Button  Margin="5"
                    Command="{x:Static self:MainWindow.ReloadSettings}" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.ReloadSettingsText}" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</dx:DXWindow>
