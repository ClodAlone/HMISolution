<UserControl x:Class="LogicManager.LogicEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:LogicManager"
             xmlns:properties="clr-namespace:LogicManager.Properties"
             xmlns:go="http://schemas.nwoods.com/GoXam"
             mc:Ignorable="d" 
             Height="300" Width="600">

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StartTestCommand}" 
                    Executed="OnStartTestCommand" 
                    CanExecute="CanStartTestCommand" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StopTestCommand}" 
                    Executed="OnStopTestCommand" 
                    CanExecute="CanStopTestCommand" />

    </UserControl.CommandBindings>

    <UserControl.Resources>
        <ResourceDictionary>

            <go:BooleanBrushConverter x:Key="theValueConverter"
                              FalseBrush="Red" TrueBrush="Green" />
            <go:BooleanBrushConverter x:Key="theSelectionConverter"
                              FalseBrush="Black" TrueBrush="Cyan" />

            <DataTemplate x:Key="Wire">
                <go:LinkPanel>
                    <go:Link.Route>
                        <go:Route Routing="AvoidsNodes" Curve="JumpOver"
                        RelinkableTo="True" RelinkableFrom="True" />
                    </go:Link.Route>
                    <go:LinkShape StrokeThickness="2"
                          Stroke="{Binding Path=Link.FromNode.Data.Value,
                                   Converter={StaticResource theValueConverter}}" />
                    <Path Fill="Black" go:LinkPanel.ToArrow="Standard" />
                </go:LinkPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <go:Diagram x:Name="myDiagram" Grid.Row="0"
                PreviewMouseWheel="myDiagram_PreviewMouseWheel"
                LinkTemplate="{StaticResource Wire}"
                Padding="10"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                InitialDiagramBoundsSpot="None"
                Drop="myDiagram_Drop"
                DragOver="myDiagram_DragOver"
                SelectionChanged="myDiagram_SelectionChanged"
                MouseDoubleClick="myDiagram_MouseDoubleClick">
            <go:Diagram.LayoutManager>
                <go:LayoutManager Initial="ValidateAll" />
            </go:Diagram.LayoutManager>
        </go:Diagram>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Right" Text="{x:Static properties:Resources.CycleTimeTitle}" Margin="2,2,2,2"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Text="{Binding CycleTime}" Margin="2,2,2,2"/>

            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{x:Static properties:Resources.CurrentStatusTitle}" Margin="2,2,2,2"/>
            <TextBlock Grid.Column="3" HorizontalAlignment="Left" Text="{Binding CurrentStatus}" Margin="2,2,2,2"/>

            <TextBlock Grid.Column="4" HorizontalAlignment="Right" Text="{x:Static properties:Resources.LastErrorTitle}" Margin="2,2,2,2"/>
            <TextBlock Grid.Column="5" HorizontalAlignment="Left" Text="{Binding CurrentError}" Margin="2,2,2,2"/>
        </Grid>
    </Grid>
</UserControl>
