<dxb:BarManager
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
        x:Class="LogicManager.ToolbarControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:LogicManager"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        dx:DXSerializer.SerializationID="LogicBarManagerToolbar"
        mc:Ignorable="d">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="logicToolbar" x:Name="logicToolBar1"
                GlyphSize="Small" ShowDragWidget="True" 
                AllowCustomizationMenu="True" 
                AllowDrop="True" 
                AllowHide="True"
                AllowCollapse="True" 
                AllowQuickCustomization="True">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStartTestCommand"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStopTestCommand"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
