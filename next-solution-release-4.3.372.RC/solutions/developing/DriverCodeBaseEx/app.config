                <value>.changeSettings</value>
            </setting>
            <setting name="MaxConsecutivePollingHiPriJobs" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="MaxConsecutivePollingInUseJobs" serializeAs="String">
                <value>2</value>
            </setting>
            <setting name="MaxConsecutivePollingNotInUseJobs" serializeAs="String">
                <value>2</value>
            </setting>
            <setting name="RefreshDiagnosticIntervall" serializeAs="String">
                <value>1000</value>
            </setting>
            <setting name="MaxErrorPollingTime" serializeAs="String">
                <value>3600000</value>
            </setting>
            <setting name="ScheduleRemainingPercent" serializeAs="String">
                <value>0.5</value>
            </setting>
            <setting name="ClosingTimeout" serializeAs="String">
                <value>10000</value>
            </setting>
            <setting name="DefaultDrvFileExtCore" serializeAs="String">
