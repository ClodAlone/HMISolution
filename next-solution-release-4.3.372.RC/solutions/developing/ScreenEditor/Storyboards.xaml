<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Storyboard x:Key="BlinkScaleStoryboard">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
            <SplineDoubleKeyFrame KeySpline="0,0,0.35,1" KeyTime="00:00:00.1000000" Value="1.05" />
            <SplineDoubleKeyFrame KeySpline="0.88,0,1,1" KeyTime="00:00:00.3000000" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
            <SplineDoubleKeyFrame KeySpline="0,0,0.35,1" KeyTime="00:00:00.1000000" Value="1.05" />
            <SplineDoubleKeyFrame KeySpline="0.88,0,1,1" KeyTime="00:00:00.3000000" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
            <SplineDoubleKeyFrame KeySpline="0,0,0.35,1" KeyTime="00:00:00.1000000" Value="0" />
            <SplineDoubleKeyFrame KeySpline="0.88,0,1,1" KeyTime="00:00:00.3000000" Value="0" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>


    <Storyboard x:Key="BlinkOpacityStoryboard">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0.5" />
            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1" />
            <SplineDoubleKeyFrame KeyTime="00:00:01.1000000" Value="0.5" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0.9" />
            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1" />
            <SplineDoubleKeyFrame KeyTime="00:00:01.1000000" Value="0.9" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0.9" />
            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1" />
            <SplineDoubleKeyFrame KeyTime="00:00:01.1000000" Value="0.9" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)">
            <SplineDoubleKeyFrame KeyTime="00:00:02.7000000" Value="0.5" />
            <SplineDoubleKeyFrame KeyTime="00:00:02.9000000" Value="0.8" />
            <SplineDoubleKeyFrame KeyTime="00:00:03.9000000" Value="0.5" />
            <SplineDoubleKeyFrame KeySpline="0,0,0.62,0.26" KeyTime="00:00:04.1000000" Value="1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

</ResourceDictionary>