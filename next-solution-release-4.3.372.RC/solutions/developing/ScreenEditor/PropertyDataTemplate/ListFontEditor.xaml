<UserControl x:Class="ScreenManager.PropertyDataTemplate.ListFontEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:self="clr-namespace:ScreenManager.PropertyDataTemplate"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             Height="300" Width="300"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="380">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:FontSettingsConverterName x:Key="FontSettingsConverterName"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>

        <CommandBinding Command="{x:Static self:ListFontEditor.ClearCommand}"
                    Executed="OnClearCommandExecuted" 
                    CanExecute="OnCanClearCommand" />

        <CommandBinding Command="{x:Static self:ListFontEditor.EditCommand}"
                    Executed="OnEditCommandExecuted" 
                    CanExecute="OnCanEditCommand" />

    </UserControl.CommandBindings>

    <Grid x:Name="layoutGrid" >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible" VerticalAlignment="Stretch"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                SelectionMode="Cell"
                                Name="gridControl" 
                                EnableSmartColumnsGeneration="True"
                                AutoPopulateColumns="True" 
                                AllowDrop="False"  
                                AllowLiveDataShaping="False">
            <dxg:GridControl.Resources>
                <DataTemplate x:Key="cellTemplate">
                    <DockPanel LastChildFill="True">
                        <Button MinHeight="30" DockPanel.Dock="Right" 
                                Command="{x:Static self:ListFontEditor.EditCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBox MinHeight="30" 
                                 x:Name="fontsettinglabel" 
                                 MinWidth="120" IsReadOnly="True" VerticalAlignment="Center"
                                 Text="{Binding Data.Value, Converter={StaticResource FontSettingsConverterName}}" />
                    </DockPanel>
                </DataTemplate>
                <DataTemplate x:Key="previewTemplate">
                    <DockPanel LastChildFill="True">
                        <Label MinHeight="30" 
                                 x:Name="fontsettinglabel"  VerticalAlignment="Center"
                                 MinWidth="120"
                                 Content="aAbByYzZ" 
                                 FontFamily="{Binding Data.Value.FontFamily}"
                                 FontStyle="{Binding Data.Value.FontStyle}"
                                 FontWeight="{Binding Data.Value.FontWeight}"
                                 FontSize="{Binding Data.Value.FontSize,ValidatesOnDataErrors=True}"/>
                    </DockPanel>
                </DataTemplate>
            </dxg:GridControl.Resources>
            <dxg:GridControl.Columns>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" 
                                AllowGrouping ="False" MinWidth="100"
                                AllowSorting ="True" DisplayMemberBinding="{Binding Path=CultureName, Mode=OneWay}" Header="{x:Static properties:Resources.CultureSettingsCultureHeader}"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" MinWidth="180"
                                AllowGrouping ="False" CellTemplate="{StaticResource cellTemplate}"
                                AllowSorting ="True" DisplayMemberBinding="{Binding Path=Value}" Header="{x:Static properties:Resources.CultureSettingsValueFontHeader}"/>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" MinWidth="180"
                                AllowGrouping ="False"  CellTemplate="{StaticResource previewTemplate}"
                                AllowSorting ="True" DisplayMemberBinding="{Binding Path=Value}" Header="{x:Static properties:Resources.CultureSettingsPreviewHeader}"/>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView" AllowEditing="False"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="False"
                            ShowSearchPanelMode="Never" 
                            ShowSearchPanelMRUButton="False"
                            ShowFilterPanelMode="Never" 
                            NavigationStyle="Cell" 
                            MultiSelectMode="None">
                    <!--<dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>-->
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="Add" Height="50" Grid.Column="1" Click="Add_Click" Content="{x:Static properties:Resources.AddButtonTitle}"/>
            <Button x:Name="Remove" Height="50" Grid.Column="2" Click="Remove_Click" Content="{x:Static properties:Resources.DeleteButtonTitle}"/>
        </Grid>
    </Grid>
</UserControl>
