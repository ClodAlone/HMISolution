<wpfutilities:BarManagerBase
    xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities" x:Class="ScreenManager.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:local="clr-namespace:ScreenManager.MenuControls" 
             xmlns:self="clr-namespace:ScreenManager"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="ScreensBarManager"
             mc:Ignorable="d">
    <dxb:BarManager.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/Screen.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dxb:BarManager.Resources>
    <dxb:BarManager.CommandBindings>
        <CommandBinding Command="{x:Static self:UIGeneralCommands.ShowToolbar}" 
                    Executed="OnShowToolbar" 
                    CanExecute="CanAlwaysExecute" />
    </dxb:BarManager.CommandBindings>
    <dxb:BarManager.Items>
        <local:BarCommonItems x:Name="menuItems" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}" />
        <local:BarCommonGeneralItems x:Name="menuGeneralItems" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}" />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="screenMenu">
            <dxb:BarSubItemLink BarItemName="biViewScreens" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="biProjectScreens" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="designScreenManagerBar" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="formatScreenManagerBar" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="biToolsScreenManager" MergeType="MergeItems" />
            <dxb:BarSubItemLink BarItemName="biOptionsScreenManager" MergeType="MergeItems" />
        </dxb:Bar>
        <dxb:Bar Caption="{x:Static translatableMenu:Resources.MainToolBarTitle}" x:Name="SMMainToolBar" dxb:MergingProperties.Name="mainToolBar"
                             GlyphSize="Small" ShowDragWidget="True" 
                             AllowCustomizationMenu="True"
                             AllowDrop="True" 
                             AllowHide="True"
                             AllowCollapse="True"
                             AllowQuickCustomization="True">
            <dxb:BarButtonItem MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biSMTAddStringId" IsVisible="False"
                                 Command="{x:Static self:UIGeneralCommands.AddStringId}"
                                 Glyph="{StaticResource AddStringId}"
                                 Content="{x:Static translatableMenu:Resources.AddStringIdName}"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</wpfutilities:BarManagerBase>
