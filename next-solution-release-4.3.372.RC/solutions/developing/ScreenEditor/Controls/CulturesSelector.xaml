<UserControl x:Class="ScreenManager.Controls.CulturesSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="250">
    <Grid>
        <ListView x:Name="selector" MinHeight="10" MinWidth="10" Visibility="Visible"
                PreviewMouseDoubleClick="GridControl_PreviewMouseDoubleClick"
                PreviewMouseLeftButtonUp="GridControl_PreviewMouseLeftButtonUp">
        </ListView>
    </Grid>
</UserControl>
