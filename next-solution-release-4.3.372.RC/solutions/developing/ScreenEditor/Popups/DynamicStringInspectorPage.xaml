<UserControl x:Class="ScreenManager.Popups.DynamicStringInspectorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5" x:Name="rowSplitter"/>
            <RowDefinition Height="Auto" x:Name="rowContent"/>
        </Grid.RowDefinitions>
        <dxg:GridControl x:Name="mainGrid">
            <dxg:GridColumn Header="{x:Static properties:Resources.ElementPathColHeader}" AllowSearchPanel="False"  Width="Auto" DisplayMemberBinding="{Binding StringDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <dxg:GridColumn Header="{x:Static properties:Resources.StringValueColHeader}" DisplayMemberBinding="{Binding StringText, Mode=OneWay}"  x:Name="textGridColumn" Width="*">
            </dxg:GridColumn>
        </dxg:GridControl>
    </Grid>
</UserControl>
