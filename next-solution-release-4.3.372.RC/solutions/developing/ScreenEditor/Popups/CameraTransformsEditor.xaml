<UserControl x:Class="ScreenManager.Popups.CameraTransformsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:self="clr-namespace:ScreenManager"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>      
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.CommandBindings>
    <CommandBinding Command="{x:Static self:UIGeneralCommands.AddCurrentCamera}"
                Executed="OnAddCurrentCamera"
                CanExecute="CanAddCurrentCamera" />
    <CommandBinding Command="{x:Static self:UIGeneralCommands.RemoveCurrentCamera}"
                Executed="OnRemoveCurrentCamera"
                CanExecute="CanRemoveCurrentCamera" />
  </UserControl.CommandBindings>
        
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Toolbar-->
        <dxb:BarContainerControl ContainerType="Top" x:Name="toolbar" Grid.Row="0" Background="Transparent">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                <dxb:BarStaticItem ShowBorder="False" Content="{x:Static properties:Resources.CurrentCamera}" />
                <dxb:BarEditItem x:Name="name" EditWidth="100">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" 
                                   ToolTip="{x:Static properties:UICommandResource.AddCurrentCameraText}"
                                   Glyph="{StaticResource AddNewSmall}"
                                   Command="{x:Static self:UIGeneralCommands.AddCurrentCamera}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True"
                               ToolTip="{x:Static properties:UICommandResource.RemoveCurrentCameraText}"
                               Glyph="{StaticResource DeleteSmall}"
                               Command="{x:Static self:UIGeneralCommands.RemoveCurrentCamera}" />
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <dxg:GridControl Grid.Row="1" MinHeight="10" MinWidth="10" Visibility="Visible" Margin="1,1,1,1"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                Name="gridControl" 
                                AutoPopulateColumns="False" 
                                AllowDrop="False" 
                                AllowLiveDataShaping="False" 
                                MouseDoubleClick="gridDataControl_MouseDoubleClick"
                                dx:DXSerializer.SerializationID="gridDataControl" 
                                dx:DXSerializer.StoreLayoutMode="All" 
                                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
            <dxg:GridControl.CommandBindings>
              <CommandBinding Command="ApplicationCommands.Delete" CanExecute="CanRemoveCurrentCamera" Executed="OnRemoveCurrentCamera" />
            </dxg:GridControl.CommandBindings>
            <dxg:GridControl.Columns>
              <dxg:GridColumn ReadOnly="False" AllowEditing="True" AllowGrouping="True" FieldName="Name" Header="{x:Static properties:Resources.CameraName}"/>
              <dxg:GridColumn ReadOnly="False" AllowEditing="True" AllowGrouping="True" FieldName="AnimationTime" Header="{x:Static properties:Resources.CameraAnimationTime}">
                <dxg:GridColumn.EditSettings>
                  <dxe:TextEditSettings MaskType="Numeric" Mask="d" HorizontalContentAlignment="Right" />
                </dxg:GridColumn.EditSettings>
              </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>

                <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False"
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="False"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Cell" 
                            MultiSelectMode="Row">
                    <!--<dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>-->
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>

    </Grid>
</UserControl>
