<UserControl x:Class="ScreenManager.EffectSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar" 
    xmlns:properties="clr-namespace:ScreenManager.Properties"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    Width="400">
    <Grid>
        <StackPanel>
            <Button Click="Reset_Click" Content="{x:Static properties:Resources.Effects_Reset}" />

            <dxn:NavBarControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <dxn:NavBarControl.Groups>
                    <dxn:NavBarGroup Header="{x:Static properties:Resources.ShadowOuterGlow}" IsExpanded="True">
                        <dxn:NavBarItem>
                            <dxn:NavBarItem.Content>
                                <StackPanel Margin="2" Orientation="Vertical">
                                    <CheckBox x:Name="btnShadow" Click="Shadow_Click" Content="{x:Static properties:Resources.Effects_Shadow}" />
                                    <ContentControl Height="150" Name="propertyGridShadow"/>
                                </StackPanel>
                            </dxn:NavBarItem.Content>
                        </dxn:NavBarItem>
                    </dxn:NavBarGroup>

                    <dxn:NavBarGroup Header="{x:Static properties:Resources.Blur}" IsExpanded="False">
                        <dxn:NavBarItem>
                            <dxn:NavBarItem.Content>
                                <StackPanel Margin="2" Orientation="Vertical">
                                    <CheckBox x:Name="btnBlur" Click="Blur_Click" Content="{x:Static properties:Resources.Effects_Blur}" />
                                    <ContentControl Height="150" Name="propertyGridBlur"/>
                                </StackPanel>
                            </dxn:NavBarItem.Content>
                        </dxn:NavBarItem>
                    </dxn:NavBarGroup>
                </dxn:NavBarControl.Groups>
            </dxn:NavBarControl>
        </StackPanel>
    </Grid>
</UserControl>
