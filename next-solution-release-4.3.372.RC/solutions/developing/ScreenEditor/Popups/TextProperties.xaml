<UserControl x:Class="ScreenManager.Popups.TextProperties"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="200" Width="300" DataContextChanged="UserControl_DataContextChanged">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/Screen.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UserControl.CommandBindings>
        <CommandBinding Command="EditingCommands.ToggleBold"
                    Executed="OnToggleBold" 
                    CanExecute="CanToggleBold" />

        <CommandBinding Command="EditingCommands.ToggleItalic"
                    Executed="OnToggleItalic" 
                    CanExecute="CanToggleItalic" />

        <CommandBinding Command="EditingCommands.ToggleUnderline"
                    Executed="OnToggleUnderline" 
                    CanExecute="CanToggleUnderline" />

        <CommandBinding Command="EditingCommands.IncreaseFontSize"
                    Executed="OnIncreaseFontSize" 
                    CanExecute="CanIncreaseFontSize" />

        <CommandBinding Command="EditingCommands.DecreaseFontSize"
                    Executed="OnDecreaseFontSize" 
                    CanExecute="CanDecreaseFontSize" />
    </UserControl.CommandBindings>
    
    <Grid x:Name="MainGrid" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="gridText"   Visibility="Collapsed">
            <TextBox Grid.Row="0" x:Name="TextEditor" TextChanged="TextEditor_TextChanged" 
                     FontFamily="{Binding Path=FontFamily, Mode=OneWay}" 
                     FontSize="{Binding Path=FontSize, Mode=OneWay}" 
                     FontStyle="{Binding Path=FontStyle, Mode=OneWay}" 
                     FontWeight="{Binding Path=FontWeight, Mode=OneWay}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,2" x:Name="gridText1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Click="Button_Click" MaxHeight="25" Grid.Column="0">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Click="Button_Clear" MaxHeight="25" Grid.Column="1">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="2" MaxHeight="25" Command="EditingCommands.IncreaseFontSize">
                <Image Source="{StaticResource SMTextGrowFont}" />
            </Button>

            <Button Grid.Column="3" MaxHeight="25" Command="EditingCommands.DecreaseFontSize">
                <Image Source="{StaticResource SMTextShrinkFont}" />
            </Button>
            <ToggleButton x:Name="toggleU1"  Grid.Column="4" MaxHeight="25" Command="EditingCommands.ToggleUnderline">
                <Image Source="{StaticResource SMTextUnderline}" />
            </ToggleButton>
        </Grid>
        <Grid Grid.Row="1"  Margin="0,2,0,0" x:Name="gridText2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" MaxHeight="25" Command="EditingCommands.IncreaseFontSize">
                <Image Source="{StaticResource SMTextGrowFont}" />
            </Button>

            <Button Grid.Column="1" MaxHeight="25" Command="EditingCommands.DecreaseFontSize">
                <Image Source="{StaticResource SMTextShrinkFont}" />
            </Button>
            <ToggleButton x:Name="toggleU2" Grid.Column="2" MaxHeight="25" Command="EditingCommands.ToggleUnderline">
                <Image Source="{StaticResource SMTextUnderline}" />
            </ToggleButton>
        </Grid>
        <DockPanel  Margin="0,5,0,0" Grid.Row="2">
            <TextBlock Text="Font Family" Width="80" DockPanel.Dock="Left"/>
            <ComboBox Grid.Row="1" Text="{Binding Path=FontFamily, UpdateSourceTrigger=PropertyChanged}" x:Name="fontNameBox" IsEditable="True" />
        </DockPanel>
        <DockPanel  Margin="0,5,0,0" Grid.Row="3">
            <TextBlock Text="Font Size" Width="80" DockPanel.Dock="Left"/>
            <ComboBox Grid.Row="2" Text="{Binding Path=FontSize, UpdateSourceTrigger=PropertyChanged}" x:Name="fontSizeBox" IsEditable="True" />
        </DockPanel>

        <DockPanel  Margin="0,5,0,0" Grid.Row="4">
            <TextBlock Text="Font Style" Width="80" DockPanel.Dock="Left"/>
            <ComboBox Grid.Row="2" Text="{Binding Path=FontStyle, UpdateSourceTrigger=PropertyChanged}" x:Name="fontStyleBox" IsEditable="True" />
        </DockPanel>
        <DockPanel  Margin="0,5,0,0" Grid.Row="5">
            <TextBlock Text="Font Weight" Width="80" DockPanel.Dock="Left"/>
            <ComboBox Grid.Row="2" Text="{Binding Path=FontWeight, UpdateSourceTrigger=PropertyChanged}" x:Name="fontWeightBox" IsEditable="True" />
        </DockPanel>
        <!--<StackPanel Orientation="Horizontal" Grid.Row="5">
            <Button Command="EditingCommands.IncreaseFontSize">
                <Image Source="{StaticResource SMTextGrowFont}" />
            </Button>

            <Button Command="EditingCommands.DecreaseFontSize">
                <Image Source="{StaticResource SMTextShrinkFont}" />
            </Button>

            -->
            <!--<Button Command="EditingCommands.ToggleBold">
                <Image Source="{StaticResource SMTextBold}" />
            </Button>

            <Button Command="EditingCommands.ToggleItalic">
                <Image Source="{StaticResource SMTextItalics}" />
            </Button>-->
            <!--

            <Button Command="EditingCommands.ToggleUnderline">
                <Image Source="{StaticResource SMTextUnderline}" />
            </Button>
        </StackPanel>-->
    </Grid>
</UserControl>
