<UserControl x:Class="ScreenManager.Popups.SpaceDistribution"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             Height="300" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.NumberColumnsTitle}" VerticalAlignment="Center"/>
        <dxe:SpinEdit Grid.Column="1" Name="upDownColumns" Value="2" MinValue="1" HorizontalContentAlignment="Center" MaskType="Numeric" Mask="d" />
        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.ColumnsGapTitle}" VerticalAlignment="Center"/>
        <dxe:SpinEdit Grid.Row="1" Grid.Column="1" Name="upDownColumnsGap" Value="10" HorizontalContentAlignment="Center" MaskType="Numeric" Mask="d" />
        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.RowsGapTitle}" VerticalAlignment="Center"/>
        <dxe:SpinEdit Grid.Row="2" Grid.Column="1" Name="upDownRowsGap" Value="10" HorizontalContentAlignment="Center" MaskType="Numeric" Mask="d" />
        <Button x:Name="btnApply" Grid.Row="3" Grid.ColumnSpan="2" Content="{x:Static properties:Resources.ApplyTitle}"/>
    </Grid>
</UserControl>
