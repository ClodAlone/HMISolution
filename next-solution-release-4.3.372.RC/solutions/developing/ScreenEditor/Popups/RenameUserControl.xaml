<UserControl x:Class="ScreenManager.Popups.RenameUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             mc:Ignorable="d" 
             Height="100" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Static properties:Resources.RenameControlName}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1"/>
    </Grid>
</UserControl>
