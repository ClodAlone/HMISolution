<UserControl x:Class="ScreenManager.FolderBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ScreenManager"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             Height="300" Width="250" PreviewKeyDown="UserControl_PreviewKeyDown">
    
    <UserControl.Resources>
        <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
        <converters:FileNameToVisibilityConverter x:Key="FileNameToVisibilityConverter"/>
        <dxg:TreeListControl x:Key="treeview" SelectionMode="Row" SelectionChanged="TreeViewAdv_SelectedItemChanged" HorizontalAlignment="Stretch"  VerticalAlignment="Top">
            <dxg:TreeListControl.Columns>
                <dxg:TreeListColumn FieldName="ItemHeader" />
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="treeListView" NavigationStyle="Row" HiddenEditor="OnHiddenEditor" ShowGridMenu="OnShowGridMenu"
                                ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                IsSynchronizedWithCurrentItem="True" AutoWidth="True" AllowDragDrop="False">
                    <!-- StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"-->
                    <dxg:TreeListView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                            <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                        </Style>
                    </dxg:TreeListView.RowStyle>
                    <dxg:TreeListView.CellStyle>
                        <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                          <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                        </Style>
                    </dxg:TreeListView.CellStyle>
                </dxg:TreeListView>
            </dxg:TreeListControl.View>
        </dxg:TreeListControl>
    </UserControl.Resources>

    <Grid FocusManager.FocusedElement="{Binding ElementName=ScreenNameTxt}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="13" Grid.Row="0" BorderThickness="1" />
        <ScrollViewer x:Name="scroller" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
        <!--<StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" >
            <Label Content="Name" HorizontalAlignment="Right" />
            <TextBox IsReadOnly="True" Text="{Binding FolderName}" Width="150" HorizontalAlignment="Right" />
        </StackPanel>-->
    </Grid>
</UserControl>
