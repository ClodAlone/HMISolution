<UserControl x:Class="ScreenManager.NewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ScreenManager"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:pdtemplates="clr-namespace:ScreenManager.PropertyDataTemplate"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             FocusManager.FocusedElement="{Binding ElementName=ScreenNameTxt}"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" Width="400" Height="200"> 
    

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Storyboards.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:FileNameToVisibilityConverter x:Key="FileNameToVisibilityConverter"/>
      <utilities:BrushToNameConverter x:Key="BrushNameConverter" />
      <LinearGradientBrush x:Key="Nuance30" EndPoint="0.5,0.905" StartPoint="0.5,-0.622">
        <GradientStop Color="#FF6E7072" Offset="0"/>
        <GradientStop Color="sc#1, 0.08857274, 0.0902648, 0.09382588" Offset="0.65896815061569214"/>
        <GradientStop Color="#FF282526" Offset="1"/>
      </LinearGradientBrush>
    </ResourceDictionary>
  </UserControl.Resources>
    <Grid Margin="10" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static properties:Resources.ScreenWidth}"/>
        <dxe:SpinEdit Margin="2" x:Name="spineditScreenWidth" 
              EditValue="{Binding ScreenWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}" Grid.Column="1"  HorizontalAlignment="Stretch"
                     
               Mask="#########0" EditValueType="{x:Type sys:Double}"
              InvalidValueBehavior="AllowLeaveEditor"
               IsFloatValue="False" />
        <Button  Grid.Column="2"  Margin="0,3"
                  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, 
                  AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" 
                  ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"> 
            <Button.Content>
                <Image Margin="2" Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static properties:Resources.ScreenHeight}" Grid.Row="1" />
        <dxe:SpinEdit Margin="2" x:Name="spineditScreenHeight"  
              EditValue="{Binding ScreenHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}" Grid.Column="1" Grid.Row="1"
               HorizontalAlignment="Stretch" Mask="#########0" EditValueType="{x:Type sys:Double}"
              
              InvalidValueBehavior="AllowLeaveEditor" IsFloatValue="False" />
        <Button  Grid.Column="2" Grid.Row="1"  Margin="0,3"
                  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, 
                  AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" 
                  ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"
                  CommandParameter="1">
            <Button.Content>
                <Image Margin="2" Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static properties:Resources.ScreenBackColor}" Grid.Row="2"  />
        <commoncontrols:CustomPopupColorEdit Margin="2" x:Name="popupColorEdit" OnlySolidColors="False"
                Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Grid.Row="2" Grid.Column="1"  
                
                SelectedBrush="{Binding ScreenBackBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Button  Grid.Column="2" Grid.Row="2" Margin="0,3"
                  Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, 
                  AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" 
                  ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}"
                  CommandParameter="2">
            <Button.Content>
                <Image Margin="2" Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Content="{x:Static properties:Resources.NewScreenName}" Grid.Row="3"  />
        <ComboBox x:Name="ScreenNameTxt" IsEditable="True"  Grid.Row="3" Grid.Column="1"
                    Margin="2"
                   Grid.ColumnSpan="2"
                    Text="{Binding ScreenName}" >
            <ComboBoxItem Content="_Layout_Top"/>
            <ComboBoxItem Content="_Layout_Left"/>
            <ComboBoxItem Content="_Layout_Right"/>
            <ComboBoxItem Content="_Layout_Bottom"/>
            <ComboBoxItem Content="_AppBar_Top"/>
            <ComboBoxItem Content="_AppBar_Bottom"/>
        </ComboBox>
    </Grid>
</UserControl>
