<UserControl x:Class="ScreenManager.NewScreenType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ScreenManager"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"

             FocusManager.FocusedElement="{Binding ElementName=ScreenNameTxt}"
             mc:Ignorable="d">
    
    <UserControl.Resources>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
        <converters:FileNameToVisibilityConverter x:Key="FileNameToVisibilityConverter"/>
        <dxg:TreeListControl x:Key="treeview" SelectionMode="Row" SelectionChanged="TreeViewAdv_SelectedItemChanged" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" x:Shared="False">
            <dxg:TreeListControl.Columns>
                <dxg:TreeListColumn FieldName="ItemHeader" />
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="treeListView" NavigationStyle="Row"
                                ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                IsSynchronizedWithCurrentItem="True" AutoWidth="True" AllowDragDrop="False">
                    <!-- StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd" CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"-->
                    <dxg:TreeListView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                            <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                        </Style>
                    </dxg:TreeListView.RowStyle>
                    <dxg:TreeListView.CellStyle>
                        <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                          <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                        </Style>
                    </dxg:TreeListView.CellStyle>
                </dxg:TreeListView>
            </dxg:TreeListControl.View>
        </dxg:TreeListControl>
    </UserControl.Resources>

    <Grid x:Name="TreeviewContainerGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="13" Grid.Row="0" BorderThickness="1" />
        <!--<ContentControl x:Name="scroller" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>-->
        <ListBox Grid.Row="0" Grid.Column="2" x:Name="listBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         SelectionChanged="listBox_SelectionChanged" MouseDoubleClick="listBox_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Viewbox Stretch="Fill" Width="200" Height="150" Margin="20, 20, 20, 20">
                        <Button Content="{Binding}" ClipToBounds="True" Background="Transparent" Focusable="False" IsEnabled="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Name}">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" />
                            </Button.Effect>
                        </Button>
                        <dxb:BarManager.DXContextMenu>
                            <dxb:PopupMenu x:Name="contextMenu">
                                <dxb:PopupMenu.Items>
                                    <dxb:BarButtonItem ItemClick="Button_Click" Content="{x:Static properties:Resources.NewScreenDelete}" />
                                </dxb:PopupMenu.Items>
                            </dxb:PopupMenu>
                        </dxb:BarManager.DXContextMenu>
                    </Viewbox>                        
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <DockPanel Margin="20" LastChildFill="True"  HorizontalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding fileName, Converter={StaticResource FileNameToVisibilityConverter}}">
            <TextBlock MinWidth="120" DockPanel.Dock="Left" Text="{x:Static properties:Resources.NewScreenName}" 
                   HorizontalAlignment="Right" 
                   Margin="10,0"
                   VerticalAlignment="Center"
                   TextAlignment="Right"/>
            <ComboBox x:Name="ScreenNameTxt" HorizontalAlignment="Left" IsEditable="True" Width="300" Text="{Binding fileName}">
                <ComboBoxItem Content="_Layout_Top"/>
                <ComboBoxItem Content="_Layout_Left"/>
                <ComboBoxItem Content="_Layout_Right"/>
                <ComboBoxItem Content="_Layout_Bottom"/>
                <ComboBoxItem Content="_AppBar_Top"/>
                <ComboBoxItem Content="_AppBar_Bottom"/>
            </ComboBox>
        </DockPanel>
    </Grid>
</UserControl>
