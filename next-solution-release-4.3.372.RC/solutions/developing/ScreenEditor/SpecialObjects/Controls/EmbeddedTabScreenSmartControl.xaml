<UserControl x:Class="ScreenManager.SpecialObjects.Controls.EmbeddedTabScreenSmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:ScreenManager.Properties"
             xmlns:controls="clr-namespace:ScreenManager.Controls"
             xmlns:template="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             mc:Ignorable="d" Height="640" Width="960">
    
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.ListEmbeddedScreen}"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Click="MoveUp" Margin="5,5,5,5" ToolTip="{x:Static properties:Resources.MoveUpButtonTitle}" >
                    <Button.Content>
                        <Image Margin="2"  Source="{StaticResource MouseUpSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="MoveDown" Grid.Column="1"  ToolTip="{x:Static properties:Resources.MoveDownButtonTitle}" Margin="5,5,5,5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource MouseDownSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddEmmbeddedScreenButtonTitle}" Margin="5,5,5,5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button IsEnabled="False" Grid.Column="1" x:Name="btnDelete" 
                        ToolTip="{x:Static properties:Resources.DeleteEmmbeddedScreenButtonTitle}" Click="OnDelete" Margin="5,5,5,5">
                    <Button.Content>
                        <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>

            <dxg:GridControl Grid.Row="2" Name="gridControl">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=Screen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.EmmbeddedScreenName}">

                        <dxg:GridColumn.EditTemplate>
                            <ControlTemplate>
                                <dxe:ComboBoxEdit Name="PART_Editor" 
                                          HorizontalContentAlignment="Left"                                        
                                          EditValue="{Binding EditValue, RelativeSource={RelativeSource TemplatedParent}}" 
                                          SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsTextEditable="False"
                                          AllowNullInput="False" 
                                          AcceptsReturn="False"
                                          AutoComplete="False" 
                                          EditorActivated="PART_Editor_DropDownOpened"
                                          ImmediatePopup="True"/>
                            </ControlTemplate>
                        </dxg:GridColumn.EditTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=FileParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.EmbeddedScreenFileParameterName}">

                        <dxg:GridColumn.EditTemplate>
                            <ControlTemplate>
                                <dxe:ComboBoxEdit Name="PART_Editor" 
                                          HorizontalContentAlignment="Left"                                        
                                          EditValue="{Binding EditValue, RelativeSource={RelativeSource TemplatedParent}}" 
                                          SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsTextEditable="False"
                                          AllowNullInput="False" 
                                          AcceptsReturn="False"
                                          AutoComplete="False" 
                                          EditorActivated="PART_Editor_EditorActivated"
                                          ImmediatePopup="True"/>
                            </ControlTemplate>
                        </dxg:GridColumn.EditTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn DisplayMemberBinding="{Binding Path=TabHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.EmbeddedScreenTabHeaderName}">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <template:TextPropertyEditor BindingPath="Data.TabHeader" 
                                                             Workspace="{Binding Workspace, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                                   CellValueChanged="tableView_CellValueChanged" EnableImmediatePosting="True"
                                   FocusedRowChanged="tableView_FocusedRowChanged"/>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
