<UserControl x:Class="Pads.AlphaNumericPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:Pads.Properties"
             xmlns:local="clr-namespace:Pads"
             FocusManager.FocusedElement="{Binding ElementName=txt}"
             FontSize="{Binding Source={x:Static properties:Settings.Default},Path=AlphanumericFontSize}" 
             mc:Ignorable="d" 
             Height="400" Width="900">
    <Grid>
        <Grid x:Name="grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <StackPanel x:Name="maxLenghtPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Content="{x:Static properties:Resources.MaxLenghtTitle}" x:Name="maxLabel" />
                    <Label Content="" x:Name="maxTxt" Margin="10,0,0,0"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="TagDescriptionPanel" Orientation="Horizontal" Visibility="Collapsed" >
                        <Label Content="{x:Static properties:Resources.TagDescriptionTitle}" x:Name="TagDescriptionLabel" />
                        <Label Content="" x:Name="TagDescriptionTxt" Margin="10,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBox Text="" x:Name="txt">
                    <TextBox.Resources>
                        <Storyboard x:Key="blink">
                            <DoubleAnimation 
                                             Storyboard.TargetName="txt"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0"
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                        </Storyboard>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
