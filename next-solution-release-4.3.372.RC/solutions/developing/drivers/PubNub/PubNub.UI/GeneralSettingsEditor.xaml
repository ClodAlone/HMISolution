<UserControl x:Class="PubNub.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:PubNub.UI.Properties"
             xmlns:baseproperties="clr-namespace:DriverCodeBase.UI.Properties;assembly=DriverCodeBase.UI"
             mc:Ignorable="d" Width="600" Height="300"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dx:DXTabControl Name="tabGeneral">
            <dx:DXTabItem Name="GeneralSettings" Header="{x:Static baseproperties:Resources.GeneralSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="MainStack" Orientation="Vertical">
                        <!--<Grid x:Name="gridGeneral">
                        </Grid>-->
                        <Grid x:Name="gridSpecific">
                            <Grid.ColumnDefinitions>                            
                                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <GridSplitter Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="Transparent" />
                            <TextBlock Text="{x:Static properties:Resources.PubNubPublishKey}" VerticalAlignment="Center" x:FieldModifier="public" Name="PubNubPublishKeyText" Grid.Row="0" Margin="0,1"/>
                            <TextBox Name="DrvPublishKey" Grid.Column="2" Grid.Row="0" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                            Text="{Binding PublishKey, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
                            <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="DrvPublishKeyErr"
                            Content="{Binding ElementName=DrvPublishKey, Path=(Validation.Errors).CurrentItem}"/>
                            <TextBlock Text="{x:Static properties:Resources.PubNubSubscribeKey}" VerticalAlignment="Center" x:FieldModifier="public" Name="PubNubSubscribeKeyText" Grid.Row="1" Margin="0,1"/>
                            <TextBox Name="DrvSubscribeKey" Grid.Column="2" Grid.Row="1" x:FieldModifier="public" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                           Text="{Binding SubscribeKey, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center" ></TextBox>
                            <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="DrvSubscritionKeyErr"
                            Content="{Binding ElementName=DrvSubscribeKey, Path=(Validation.Errors).CurrentItem}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </dx:DXTabItem>
            <dx:DXTabItem Name="ChannelSettings" Header="{x:Static baseproperties:Resources.ChannelsSettings}">
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
