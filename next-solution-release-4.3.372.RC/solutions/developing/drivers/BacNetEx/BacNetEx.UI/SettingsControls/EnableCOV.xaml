<UserControl x:Class="BACnet.UI.SettingsControls.EnableCOV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:BACnet.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="TxBCOVEnable" Text="{x:Static properties:Resources.ENABLECOV}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>
                <CheckBox Name="CkCOVEnable" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"  Margin="0,5"
                  IsChecked="{Binding COVEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="CheckCOVEnableErr"
            Content="{Binding ElementName=CkCOVEnable, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
