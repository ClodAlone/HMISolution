<UserControl x:Class="OpcClientDriver.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:OpcClientDriver.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="10" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.Item}" VerticalAlignment="Center" Margin="0,1" />
                <DockPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKPConditionalVariable">
                    <Button DockPanel.Dock="Right" Click="ResetItem_Click">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="btnItem_Click">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <TextBox Text="{Binding ItemName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     x:Name="textEditItem" />
                </DockPanel>
                <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="textEditItemErr"
                    Content="{Binding ElementName=textEditItem, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.AppName}" VerticalAlignment="Center" Margin="0,1" />
                <TextBox Name="edtAppName" Grid.Row="1" Grid.Column="2" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding AppName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="edtAppNameErr"
                    Content="{Binding ElementName=edtAppName, Path=(Validation.Errors).CurrentItem}"/>
                
                <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.Endpoint}" VerticalAlignment="Center" Margin="0,1" />
                <TextBox Name="edtEndpointUrl" Grid.Row="2" Grid.Column="2" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding EndpointUrl, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3" x:FieldModifier="public" Name="edtEndpointUrlErr"
                    Content="{Binding ElementName=edtEndpointUrl, Path=(Validation.Errors).CurrentItem}"/>
                
                <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.RelativePath}" VerticalAlignment="Center" Margin="0,1" />
                <TextBox Name="edtRelativePath" Grid.Row="3" Grid.Column="2" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding RelativePath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3" x:FieldModifier="public" Name="edtRelativePathErr"
                    Content="{Binding ElementName=edtRelativePath, Path=(Validation.Errors).CurrentItem}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
