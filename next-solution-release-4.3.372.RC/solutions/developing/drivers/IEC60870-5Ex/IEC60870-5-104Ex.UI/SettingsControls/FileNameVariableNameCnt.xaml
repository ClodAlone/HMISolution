<UserControl x:Class="IEC60870_5_104.UI.SettingsControls.FileNameVariableNameCnt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:properties="clr-namespace:IEC60870_5_104.UI.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"             
             xmlns:localConv="clr-namespace:DriverCodeBaseEx.Converters;assembly=DriverCodeBaseEx"
             x:Name="FileNameVariableMain"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"             
             Tag="{Binding FileNameVariableTag, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
             Validation.ErrorTemplate="{x:Null}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/../SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/../SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <localConv:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <!--<TextBlock Name="TxBFileNameVariable" Text="{x:Static properties:Resources.FileNameVariable}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>-->
            <!--<DockPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,5">
                <Button DockPanel.Dock="Right" Click="ResetFileNameVariableTag_Click">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button DockPanel.Dock="Right" Click="SetFileNameVariableTag_Click">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox x:Name="textEditFileNameVariable" IsReadOnly="True" HorizontalAlignment="Stretch"
		     Text="{Binding FileNameVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
		     Validation.ErrorTemplate="{x:Null}" />
            </DockPanel>
            <ContentPresenter Grid.Row="0" Grid.Column="3"
	          Content="{Binding ElementName=textEditFileNameVariable, Path=(Validation.Errors).CurrentItem}"/>-->

            <TextBlock Text="{x:Static properties:Resources.FileNameVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TxBFileNameVariable" Margin="0,1"/>
            <DockPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKPFileNameVariable">
                <Button DockPanel.Dock="Right" Click="DlgButton_Click_Clear"  Margin="0,5">
                    <Button.Content>
                        <Image x:Name="cancelImg" Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:FieldModifier="public" x:Name="uriButton" DockPanel.Dock="Right" Click="DlgButton_Click"  Margin="0,5">
                    <Button.Content>
                        <Image x:Name="editImg" Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
                <dxe:ComboBoxEdit
			        x:Name="uriLabel" 
			        Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=Tag, Converter={StaticResource UriConverter}, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
			        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
			        PopupOpening="uriLabel_PopupOpening"
            
			        LostFocus="uriLabel_LostFocus" PreviewKeyDown="uriLabel_KeyDown" GotFocus="uriLabel_GotFocus"
			        SelectedIndexChanged="uriLabel_SelectedIndexChanged"
			        ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"
			        Margin="0,5" PopupClosed="uriLabel_PopupClosed">
                </dxe:ComboBoxEdit>
            </DockPanel>
    </Grid>    
</UserControl>
