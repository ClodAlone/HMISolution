<UserControl x:Class="IEC60870_5_104.UI.SettingsControls.WriteTimeStampCnt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC60870_5_104.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <TextBlock Name="TxBWriteTimeStamp" Text="{x:Static properties:Resources.WriteTimeStamp}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
            <CheckBox Name="CkWriteTimeStamp" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
		      IsChecked="{Binding WriteTimeStamp, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
		      Margin="0,5"/>
            <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="CheckWriteTimeStampErr"
		      Content="{Binding ElementName=CkWriteTimeStamp, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>    
</UserControl>
