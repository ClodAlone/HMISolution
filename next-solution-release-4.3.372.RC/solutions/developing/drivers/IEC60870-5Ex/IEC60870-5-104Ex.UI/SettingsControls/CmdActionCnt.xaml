<UserControl x:Class="IEC60870_5_104.UI.SettingsControls.CmdActionCnt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC60870_5_104.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <TextBlock Name="TxtCmdAction" Text="{x:Static properties:Resources.CmdAction}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>
            <ComboBox Name="CmbCmdAction" Grid.Column="2" Grid.Row="0" IsEditable="False"
		      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
		      SelectedValue="{Binding CmdAction, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
		      Margin="0,5"/>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
			  Content="{Binding ElementName=CmbCmdAction, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>    
</UserControl>
