<UserControl x:Class="IEC60870_5_104.UI.SettingsControls.UpdateTimeStampCnt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC60870_5_104.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <TextBlock Name="TxBUpdateTimeStamp" Text="{x:Static properties:Resources.UpdateTimeStamp}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>
            <CheckBox Name="CkUpdateTimeStamp" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
		      IsChecked="{Binding UpdateTimeStamp, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
		      Margin="0,5"/>
            <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="CheckUpdateTimeStampErr"
		     Content="{Binding ElementName=CkUpdateTimeStamp, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>    
</UserControl>
