<UserControl x:Class="IEC61850.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC61850.UI.Properties"
             mc:Ignorable="d" Height="150" Width="400"
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GridSplitter Grid.Column="1" Grid.RowSpan="7" HorizontalAlignment="Stretch" Background="Transparent" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.IEC61850TransportSelector}" Grid.Row="0" Margin="0,1"/>
                <TextBox Name="stTransportSelector" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding TransportSelector, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=stTransportSelector, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.IEC61850SessionSelector}" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="stSessionSelector" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding SessionSelector, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3"
                Content="{Binding ElementName=stSessionSelector, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.IEC61850PresentationSelector}" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="stPresentation" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding PresentationSelector, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3"
                Content="{Binding ElementName=stPresentationSelector, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.IEC61850ApplicationID}" Grid.Row="3" Margin="0,1"/>
                <TextBox Name="stApplicationID" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding ApplicationID, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                    <ContentPresenter Grid.Row="3" Grid.Column="3"
                Content="{Binding ElementName=stApplicationID, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.IEC61850AEQualifier}" Grid.Row="4" Margin="0,1"/>
                <TextBox Name="stAEQualifier" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding AEQualifier, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                    <ContentPresenter Grid.Row="4" Grid.Column="3"
                Content="{Binding ElementName=stAEQualifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtAuthenticationEnabled" Text="{x:Static properties:Resources.IEC61850AuthenticationEnabled}" VerticalAlignment="Center"  Grid.Row="5" Margin="0,1"/>
                <CheckBox Name="stAuthenticationEnabled" Grid.Column="2" Grid.Row="5" VerticalAlignment="Center" Margin="0,5" HorizontalAlignment="Stretch"
                    IsChecked="{Binding AuthenticationEnabled, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                    <ContentPresenter Grid.Row="5" Grid.Column="3" x:FieldModifier="public" Name="ChReportAutomaticActivationErr"
                Content="{Binding ElementName=stAuthenticationEnabled, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtAuthenticationPassword" VerticalAlignment="Center" Text="{x:Static properties:Resources.IEC61850AuthenticationPassword}" Grid.Row="6" Margin="0,1"/>
                <TextBox Name="stAuthenticationPassword" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     Text="{Binding AuthenticationPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="6" Grid.Column="3"
                Content="{Binding ElementName=stAuthenticationPassword, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
