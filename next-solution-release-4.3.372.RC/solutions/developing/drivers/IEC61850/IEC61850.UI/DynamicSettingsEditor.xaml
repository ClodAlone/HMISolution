<UserControl x:Class="IEC61850.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC61850.UI.Properties"
             mc:Ignorable="d" Width="500" Height="500"
             d:DesignHeight="300" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="3" Grid.RowSpan="12" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.IEC61850LogicalDeviceName}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>
                <TextBox Name="tbLogicalDeviceName" Grid.Column="2" Grid.Row="0"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding LogicalDeviceName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=tbLogicalDeviceName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.IEC61850LogicalNodeName}" VerticalAlignment="Center" Grid.Row="1" Margin="0,5"/>
                <TextBox Name="tbLogicalNodeName" Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding LogicalNodeName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=tbLogicalNodeName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.IEC61850FunctionalConstraint}" VerticalAlignment="Center" Grid.Row="2" Margin="0,5"/>
                <ComboBox Name="CmbFunctionalConstraint" Grid.Column="2" Grid.Row="2" IsEditable="False" Margin="0,5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding FunctionalConstraint, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=CmbFunctionalConstraint, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.IEC61850DataItemIdentifier}" VerticalAlignment="Center" Grid.Row="3" Margin="0,5"/>
                <TextBox Name="tbDataItemIdentifier" Grid.Column="2" Grid.Row="3"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding DataItemIdentifier, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=tbDataItemIdentifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.IEC61850MMSDataType}" VerticalAlignment="Center" Grid.Row="4" Margin="0,5"/>
                <ComboBox Name="CmbMMSDataType" Grid.Column="2" Grid.Row="4" IsEditable="False" Margin="0,5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding MMSDataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CmbMMSDataType_SelectionChanged" />
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
                Content="{Binding ElementName=CmbMMSDataType, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtDataMaximumLength" Text="{x:Static properties:Resources.IEC61850DataMaximumLength}" VerticalAlignment="Center" Grid.Row="5" Margin="0,5" Grid.ColumnSpan="3"/>
                <TextBox Name="tbDataMaximumLength" Grid.Column="2" Grid.Row="5"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding DataMaximumLength, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"/>
                <ContentPresenter Grid.Row="5" Grid.Column="3" 
                Content="{Binding ElementName=tbDataMaximumLength, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBRetryOutputInCaseOfError" Text="{x:Static properties:Resources.IEC61850RetryOutputInCaseOfError}" VerticalAlignment="Center" Grid.Row="6" Margin="0,5"/>
                <CheckBox Name="CheckRetryOutputInCaseOfError" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Margin="0,5"
                      IsChecked="{Binding RetryOutputInCaseOfError, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

                <TextBlock Name="TxtReportType" Text="{x:Static properties:Resources.IEC61850ReportType}" VerticalAlignment="Center" Grid.Row="7" Margin="0,5"/>
                <ComboBox Name="CmbReportType" Grid.Column="2" Grid.Row="7" IsEditable="False" Margin="0,5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding ReportType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="CmbReportType_SelectionChanged" />
                <ContentPresenter Grid.Row="7" Grid.Column="3" 
                Content="{Binding ElementName=CmbReportType, Path=(Validation.Errors).CurrentItem}"/>
            
                <TextBlock Name="TxtReportLogicalDeviceName" Text="{x:Static properties:Resources.IEC61850ReportLogicalDeviceName}" VerticalAlignment="Center" Grid.Row="8" Margin="0,5"/>
                <TextBox Name="tbReportLogicalDeviceName" Grid.Column="2" Grid.Row="8"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding ReportLogicalDeviceName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="8" Grid.Column="3" 
                Content="{Binding ElementName=tbReportLogicalDeviceName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtReportLogicalNodeName" Text="{x:Static properties:Resources.IEC61850ReportLogicalNodeName}" VerticalAlignment="Center" Grid.Row="9" Margin="0,5"/>
                <TextBox Name="tbReportLogicalNodeName" Grid.Column="2" Grid.Row="9"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding ReportLogicalNodeName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="9" Grid.Column="3" 
                Content="{Binding ElementName=tbReportLogicalNodeName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxtReportName" Text="{x:Static properties:Resources.IEC61850ReportName}" VerticalAlignment="Center" Grid.Row="10" Margin="0,5"/>
                <TextBox Name="tbReportName" Grid.Column="2" Grid.Row="10"  HorizontalAlignment="Stretch" Margin="0,5"
                     Text="{Binding ReportName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="10" Grid.Column="3" 
                Content="{Binding ElementName=tbReportName, Path=(Validation.Errors).CurrentItem}"/>
            
                <TextBlock Name="TxBInitializeData" Text="{x:Static properties:Resources.IEC61850InitializeData}" VerticalAlignment="Center" Grid.Row="11" Margin="0,5"/>
                <CheckBox Name="CheckInitializeData" Grid.Row="11" Grid.Column="2" VerticalAlignment="Center"
                      IsChecked="{Binding InitializeData, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
