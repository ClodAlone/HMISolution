<UserControl x:Class="FanucCNC.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:FanucCNC.UI.Properties"
             mc:Ignorable="d" Height="216.162" Width="400" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <!--<TextBlock Name="txtCNCPath" Text="{x:Static properties:Resources.CaptionCNCPath}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <TextBox Name="CNCPath" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
                     Text="{Binding CNCPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=CNCPath, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Grid.Row="8" Text="{x:Static properties:Resources.UseDirectReading}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUseDirectReading" Margin="0,1"/>
                <CheckBox  Grid.Row="8" Grid.Column="2" Name="UseDirectReading" VerticalAlignment="Center" Margin="5"
                            x:FieldModifier="public" IsChecked="{Binding UseDirectReading, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Name="TextMaxVarPerCycle" Text="{x:Static properties:Resources.MaxVarPerCycle}"  VerticalAlignment="Center" Grid.Row="9" Margin="0,1"/>
                <TextBox Name="MaxVarPerCycle" Grid.Column="2" Grid.Row="9" HorizontalAlignment="Stretch"
                     Text="{Binding MaxVarPerCycle, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="9" Grid.Column="3" 
                Content="{Binding ElementName=MaxVarPerCycle, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.UsePing}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textUsePing" Margin="0,1"/>
                <CheckBox  Grid.Row="10" Grid.Column="2" Name="UsePing" VerticalAlignment="Center" Margin="5"
                            x:FieldModifier="public" IsChecked="{Binding UsePing, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />-->
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
