<UserControl x:Class="FanucCNC.UI.DynamicSettingsControl_Custom_DownloadProgramToCnc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:FanucCNC.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="MainStack" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->

            <TextBlock Text="Cnc file's folder" VerticalAlignment="Center" Grid.Row="0"/>
            <TextBox Name="txtCNCTargetPath" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"
                 Text="{Binding CNCTargetPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=txtCNCTargetPath, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CaptionAddProgramName}" VerticalAlignment="Center" Grid.Row="1"/>
            <CheckBox x:Name="chkAddProgramName" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding AddProgramName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></CheckBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3"
            Content="{Binding ElementName=chkAddProgramName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CaptionAddStartEndProgram}" VerticalAlignment="Center" Grid.Row="2"/>
            <CheckBox x:Name="chkAddStartEndProgram" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding AddStartEndProgram, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></CheckBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=chkAddStartEndProgram, Path=(Validation.Errors).CurrentItem}"/>

            <!--<TextBlock Text="{x:Static properties:Resources.CaptionRemoveR}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
            <CheckBox x:Name="chkRemoveR" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="5"
                  IsChecked="{Binding RemoveR, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=chkRemoveR, Path=(Validation.Errors).CurrentItem}"/>-->
            
            <TextBlock Text="{x:Static properties:Resources.CaptionManageTemporaryProgram}" VerticalAlignment="Center" Grid.Row="3"/>
            <CheckBox x:Name="chkManageTemporaryProgram" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                  IsChecked="{Binding ManageTemporaryProgram, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></CheckBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3"
            Content="{Binding ElementName=chkManageTemporaryProgram, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </StackPanel>
</UserControl>
