<UserControl x:Class="FanucCNC.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:FanucCNC.UI.Properties"             
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock Text="{x:Static properties:Resources.CaptionCategory}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <ComboBox Name="cmbCategory" Grid.Column="2" Grid.Row="0" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                      SelectionChanged="cmbCategory_SelectionChanged"                  
                      SelectedValuePath="Code"
                      DisplayMemberPath="Description"/>

                <TextBlock Text="{x:Static properties:Resources.CaptionFunction}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <ComboBox Name="cmbFunction" Grid.Column="2" Grid.Row="1" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                      SelectionChanged="cmbFunction_SelectionChanged"                  
                      SelectedValuePath="Code"
                      DisplayMemberPath="Description"
                      SelectedValue="{Binding FunctionCode, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=cmbFunction, Path=(Validation.Errors).CurrentItem}"/>

                <!--<TextBlock Text="{x:Static properties:Resources.CaptionOffsetVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="lblOffsetVariable" Grid.Row="1" Margin="0,1"/>
            <DockPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKOffsetVariable" Margin="0,5">
                <Button DockPanel.Dock="Right" Click="btnOffsetVariableCancel_Click">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button DockPanel.Dock="Right" Click="btnOffsetVariableBrowse_Click">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox x:Name="textOffsetVariable" IsReadOnly="True" 
                     Text="{Binding OffsetVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     Validation.ErrorTemplate="{x:Null}" />
            </DockPanel>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=textOffsetVariable, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="txtCNCPath" Text="{x:Static properties:Resources.CaptionCNCPath}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
            <TextBox Name="CNCPath" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch"
                 Text="{Binding CNCPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=CNCPath, Path=(Validation.Errors).CurrentItem}"/>-->
            </Grid>

            <Grid x:Name="SecondaryGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>-->
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->
            
                <!--<TextBlock Text="{x:Static properties:Resources.CaptionOffsetVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="lblOffsetVariable" Grid.Row="0" Margin="0,1"/>
                <DockPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKOffsetVariable" Margin="0,5">
                    <Button DockPanel.Dock="Right" Click="btnOffsetVariableCancel_Click">
                        <Button.Content>
                            <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="btnOffsetVariableBrowse_Click">
                        <Button.Content>
                            <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                        </Button.Content>
                    </Button>
                    <TextBox x:Name="textOffsetVariable" IsReadOnly="True" 
                         Text="{Binding OffsetVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                         Validation.ErrorTemplate="{x:Null}" />
                </DockPanel>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=textOffsetVariable, Path=(Validation.Errors).CurrentItem}"/>-->

                <TextBlock Name="lblCNCPath" Text="{x:Static properties:Resources.CaptionCNCPath}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <TextBox Name="txtCNCPath" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch"
                     Text="{Binding CNCPath, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,5"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=txtCNCPath, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
