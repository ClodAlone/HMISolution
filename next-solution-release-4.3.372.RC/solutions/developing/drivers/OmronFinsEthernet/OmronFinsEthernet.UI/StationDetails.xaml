<UserControl x:Class="OmronFinsEthernet.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:OmronFinsEthernet.UI.Properties"
             mc:Ignorable="d" Height="300" Width="600"
             d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock Text="{x:Static properties:Resources.DestinationNetworkAddress}" VerticalAlignment="Center" Grid.Row="0"/>
                <TextBox Name="DestinationNetworkAddress" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding DestinationNetworkAddress, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" />
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=DestinationNetworkAddress, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.DestinationNode}" VerticalAlignment="Center" Grid.Row="1"/>
                <TextBox Name="DA1" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding DestinationNode, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"/>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=DA1, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.DestinationUnit}" VerticalAlignment="Center" Grid.Row="2"/>
                <TextBox Name="DA2" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch"  Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding DestinationUnit, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"/>
                <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=DA2, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
