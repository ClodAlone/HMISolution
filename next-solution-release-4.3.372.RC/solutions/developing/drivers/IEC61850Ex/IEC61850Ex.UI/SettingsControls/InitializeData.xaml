<UserControl x:Class="IEC61850.UI.SettingsControls.InitializeData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:IEC61850.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="TxBInitializeData" Text="{x:Static properties:Resources.IEC61850InitializeData}" VerticalAlignment="Center" Grid.Row="0" Margin="0,5"/>
        <CheckBox Name="CheckInitializeData" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                    IsChecked="{Binding InitializeData, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
    </Grid>    
</UserControl>
