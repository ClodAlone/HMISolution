<UserControl x:Class="OpcClientDriver.UI.ImportTagsEditorTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:propertiesBase="clr-namespace:DriverCodeBaseEx.UI.Properties;assembly=DriverCodeBaseEx.UI"
             xmlns:properties="clr-namespace:OpcClientDriver.UI.Properties"                
             xmlns:converters="clr-namespace:OpcClientDriver.UI.Converters"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:locControls="clr-namespace:DriverCodeBaseEx.UI.Controls;assembly=DriverCodeBaseEx.UI"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SelectIndexToVisiblityConverter x:Key="SelectIndexToVisiblityConverter" />            
        </ResourceDictionary>
    </UserControl.Resources>

    <!--<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>-->

    <DockPanel HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch" 
            Width="Auto" 
            Height="Auto" 
            Dock="Top" >
        <dx:DXTabControl Grid.Row="1" Name="tabControl" SelectionChanged="TabControlExt_SelectionChanged" SelectionChanging="TabControlExt_SelectionChanging">
            <dx:DXTabItem Name="TabFile" Header="{x:Static properties:Resources.FileImportTab}">
                <DockPanel x:Name="MainStack"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Width="Auto" 
                    Height="Auto" 
                    Dock="Top" >
                </DockPanel>
            </dx:DXTabItem>
            <dx:DXTabItem Name="TabBrowser" Header="{x:Static properties:Resources.ServerBrowseTab}" Height="22" VerticalAlignment="Top">
                <Grid x:Name="GridStation">
                    <Grid.ColumnDefinitions>                        
                        <ColumnDefinition Width="100*" />
                        <ColumnDefinition Width="100*" />
                        <ColumnDefinition Width="100*" />
                        <ColumnDefinition Width="300*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="100*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--import tags button--> 
                    <Grid x:Name="ButtonGrid" Grid.Row="0" Grid.ColumnSpan="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="Col0" Width="25*" />                            
                            <ColumnDefinition x:Name="Col2" Width="25*" />                            
                            <ColumnDefinition x:Name="Col4" Width="25*" />
                            <ColumnDefinition x:Name="Col5" Width="25*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="5">
                            <Button Name="btnImportBS" Margin="0,7,0,8" Content="{x:Static propertiesBase:Resources.ImportTags}" Click="UpdateBS_Click"></Button>
                        </StackPanel>
                    </Grid>
                    <!--Opc import custom control -->
                    <ContentControl x:Name="browserOpcUa" Grid.Row="1" Grid.ColumnSpan="4" VerticalAlignment="Stretch"/>

                    <!--import base control -->
                    <CheckBox Name="AddStationNameBS" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content ="{x:Static propertiesBase:Resources.ImportTreeAddStationName}" Grid.ColumnSpan="2" ></CheckBox>
                    <TextBlock Text="{x:Static propertiesBase:Resources.ImportTreeStation}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="2" />
                    <ComboBox Name="CmbStationBS" Grid.Column="3" Grid.Row="2" VerticalAlignment="Bottom" 
                    IsEditable="False" IsReadOnly="True" SelectionChanged="CmbStationBS_SelectionChanged"/>
                    <TextBlock Name="ImportFolderBS" Text="{x:Static propertiesBase:Resources.ImportTreeTagFolder}" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Grid.Column="2" Width="auto" />
                    <locControls:FolderCommand Grid.Column="3" x:FieldModifier="public"  x:Name="DKPFolderCommandVariable" Grid.Row="3" VerticalAlignment="Center" Margin="0,5,0,0">
                    </locControls:FolderCommand>
                    <ContentPresenter Grid.Column="3" 
                        Content="{Binding ElementName=DKPFolderCommandVariable, Path=(Validation.Errors).CurrentItem}" VerticalAlignment="Center">
                    </ContentPresenter>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </DockPanel>
    <!--</Grid>-->
</UserControl>
