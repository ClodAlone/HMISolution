<UserControl x:Class="MTConnect.UI.SettingsControls.MTConnectPath"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MTConnect.UI.SettingsControls"
              xmlns:properties="clr-namespace:MTConnect.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.MTConnectPathParemeter}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
        <TextBox Name="PathParameter" Grid.Column="2" Grid.Row="0"
                 Text="{Binding PathParameter, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" 
                    Content="{Binding ElementName=PathParameter, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
