<UserControl x:Class="MQTTClient.UI.SettingsControls.JsonMessageFormat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MQTTClient.UI.SettingsControls"
             xmlns:properties="clr-namespace:MQTTClient.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="txtJsonMessageFormat" Text="{x:Static properties:Resources.MQTTClientJsonMessageFormat}" VerticalAlignment="Center" Margin="0,1"/>
        <TextBox Name="boxJsonMessageFormat" Grid.Column="2" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                   Text="{Binding JsonMessageFormat, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
        <ContentPresenter Grid.Column="3"
                  Content="{Binding ElementName=boxJsonMessageFormat, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
