<UserControl x:Class="SNMP.UI.SettingsControls.SnmpDataSize"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SNMP.UI.SettingsControls"
             xmlns:properties="clr-namespace:SNMP.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static properties:Resources.SNMPDataSize}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
        <TextBox Name="SNMPDataSize" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
               Text="{Binding snmpDataSize, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
        <ContentPresenter Grid.Row="2" Grid.Column="3"
                Content="{Binding ElementName=SNMPDataSize, Path=(Validation.Errors).CurrentItem}"/>

    </Grid>
</UserControl>
