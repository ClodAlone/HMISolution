<UserControl x:Class="SNMP.UI.SettingsControls.SnmpDataType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SNMP.UI.SettingsControls"
             xmlns:properties="clr-namespace:SNMP.UI.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static properties:Resources.SNMPDataType}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
        <ComboBox Name="CmbSNMPDataType" Grid.Column="2" Grid.Row="1" IsEditable="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                SelectedValue="{Binding snmpDataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
        <ContentPresenter Grid.Row="1" Grid.Column="3"
                Content="{Binding ElementName=CmbSNMPDataType, Path=(Validation.Errors).CurrentItem}"/>

    </Grid>
</UserControl>
