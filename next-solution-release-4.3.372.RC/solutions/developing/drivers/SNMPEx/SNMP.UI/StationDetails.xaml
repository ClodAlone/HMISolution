<UserControl x:Class="SNMP.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:SNMP.UI.Properties"
             mc:Ignorable="d" Height="500" Width="600"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>                   
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Name="TBContextName" VerticalAlignment="Center" Grid.Row="0" Margin="0,1" Text="{x:Static properties:Resources.SNMPContextName}"/>
                <TextBox x:Name="TXContextName" Grid.Column="2" Grid.Row="0"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding snmpContextName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3"
                    Content="{Binding ElementName=TXContextName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TBUserName" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" Text="{x:Static properties:Resources.SNMPUserName}"/>
                <TextBox x:Name="TXUserName" Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding snmpUserName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3"
                    Content="{Binding ElementName=TXUserName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TBSecurityLevel" Text="{x:Static properties:Resources.SNMSecurityLevel}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <ComboBox x:Name="CmbSecurityLevel" Grid.Column="2" Grid.Row="2" Margin="0,5" IsEditable="False"
	                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
	                  SelectedValue="{Binding snmpSecurityLevel, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                                </ComboBox>
                                <ContentPresenter Grid.Row="1" Grid.Column="3"
	                Content="{Binding ElementName=CmbSecurityLevel, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TBAuthenticationProtocol" Text="{x:Static properties:Resources.SNMPAuthenticationProtocol}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <ComboBox x:Name="CmbAuthenticationProtocol" Grid.Column="2" Grid.Row="3" Margin="0,5" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding snmpAuthenticationProtocol, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3"
                    Content="{Binding ElementName=CmbAuthenticationProtocol, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TBAuthenticationPassword" VerticalAlignment="Center" Grid.Row="4" Margin="0,1" Text="{x:Static properties:Resources.SNMPAuthenticationPassword}"/>
                <cc:BindablePasswordBox Grid.Row="4" Grid.Column="2" Margin="0,5" Password="{Binding snmpAuthenticationPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     x:Name="TXAuthenticationPassword" />
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
                    Content="{Binding ElementName=TXAuthenticationPassword, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name ="TBPrivacyEncryptionProtocol" Text="{x:Static properties:Resources.SNMPPrivacyEncryptionProtocol}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
                <ComboBox x:Name="CmbPrivacyEncryptionProtocol" Grid.Column="2" Grid.Row="5" Margin="0,5" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding snmpPrivacyEncryptionProtocol, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3"
                    Content="{Binding ElementName=CmbPrivacyEncryptionProtocol, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name ="TBPrivacyEncryptionPassword" VerticalAlignment="Center" Grid.Row="6" Margin="0,1" Text="{x:Static properties:Resources.SNMPPrivacyEncryptionPassword}"/>
                <cc:BindablePasswordBox Grid.Row="6" Grid.Column="2" Margin="0,5" Password="{Binding snmpPrivacyEncryptionPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     x:Name="TXPrivacyEncryptionPassword" />
                <ContentPresenter Grid.Row="6" Grid.Column="3" 
                    Content="{Binding ElementName=TXPrivacyEncryptionPassword, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
