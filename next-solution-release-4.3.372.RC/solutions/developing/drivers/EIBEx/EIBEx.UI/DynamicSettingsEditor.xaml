<UserControl x:Class="EIB.UI.DynamicSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:EIB.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />
                <ResourceDictionary Source="/WPFUtilities;component/Resources/SharedImages.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="11" HorizontalAlignment="Stretch" Background="Transparent" />-->
                
                <!--<TextBlock Text="{x:Static properties:Resources.CaptionOutputOnlyOnRequest}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1" Name="OutputOnlyOnRequestText"/>
                <CheckBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Name="OutputOnlyOnRequest" Margin="0,5"
                  IsChecked="{Binding OutputOnlyOnRequest, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" Name="OutputOnlyOnRequestError"
                Content="{Binding ElementName=OutputOnlyOnRequest, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.CaptionPollingOnlyOnRequest}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" Name="PollingOnlyOnRequestText"/>
                <CheckBox Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Name="PollingOnlyOnRequest" Margin="0,5"
                  IsChecked="{Binding PollingOnlyOnRequest, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Checked="PollingOnlyOnRequest_Checked" Unchecked="PollingOnlyOnRequest_Checked"></CheckBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" Name="PollingOnlyOnRequestError"
                Content="{Binding ElementName=PollingOnlyOnRequest, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="{x:Static properties:Resources.CaptionEnablePolling}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1" Name="EneblePollingText"/>
                <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Name="EnablePolling" Margin="0,5"
                  IsChecked="{Binding EnablePolling, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3" Name="EnablePollingError"
                Content="{Binding ElementName=EnablePolling, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--TextBlock VerticalAlignment="Center" Grid.Row="3" Margin="0,1" Text="{x:Static properties:Resources.CaptionPollingTime}" Name="PollingTimeText"/>
                <TextBox Name="PollingTime" Grid.Column="2" Grid.Row="3"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding PollingTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3" Name="PollingTimeError"
                Content="{Binding ElementName=PollingTime, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="{x:Static properties:Resources.CaptionRetryInitialPolling}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1" Name="RetryInitialPollingText"/>
                <CheckBox Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"  Name="RetryInitialPolling" Margin="0,5"
                  IsChecked="{Binding RetryInitialPolling, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3" Name="RetryInitialPollingError"
                Content="{Binding ElementName=RetryInitialPolling, Path=(Validation.Errors).CurrentItem}"/>-->
                
                <!--<TextBlock VerticalAlignment="Center" Grid.Row="5" Text="{x:Static properties:Resources.CaptionAutoResetNewData}" Margin="0,1" Name="AutoResetNewDataTimeText"/>
                <TextBox Name="AutoResetNewDataTime" Grid.Column="2" Grid.Row="5" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding AutoResetNewDataTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="5" Grid.Column="3" Name="AutoResetNewDataTimeError"
                Content="{Binding ElementName=AutoResetNewDataTime, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock Text="{x:Static properties:Resources.CaptionRetryOutput}" VerticalAlignment="Center" Grid.Row="6" Margin="0,1" Name="RetryOutputText"/>
                <CheckBox Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Name="RetryOutput" Margin="0,5"
                  IsChecked="{Binding RetryOutput, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
                <ContentPresenter Grid.Row="6" Grid.Column="3" Name="RetryOutputError"
                Content="{Binding ElementName=RetryOutput, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock VerticalAlignment="Center" Grid.Row="7" Margin="0,1" Text="{x:Static properties:Resources.CaptionInputGroups}" Name="InputGroupText"/>
                <TextBox Name="InputGroups" Grid.Column="2" Grid.Row="7" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding InputGroups, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="7" Grid.Column="3" Name="InputGroupError"
                Content="{Binding ElementName=InputGroups, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock VerticalAlignment="Center" Grid.Row="8" Margin="0,1" Text="{x:Static properties:Resources.CaptionPollingGroup}" Name="PollingGroupText"/>
                <TextBox Name="PollingGroup" Grid.Column="2" Grid.Row="8"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding PollingGroup, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="8" Grid.Column="3" Name="PollingGroupError"
                Content="{Binding ElementName=PollingGroup, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock VerticalAlignment="Center" Grid.Row="9" Margin="0,1" Text="{x:Static properties:Resources.CaptionOutputGroup}" Name="OutputGroupText"/>
                <TextBox Name="OutputGroup" Grid.Column="2" Grid.Row="9"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding OutputGroup, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="9" Grid.Column="3" Name="OutputGroupError"
                Content="{Binding ElementName=OutputGroup, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock VerticalAlignment="Center" Grid.Row="10" Margin="0,1" Text="{x:Static properties:Resources.CaptionEisDataFormat}" Name="CmbEisDataFormatText"/>
                <ComboBox Name="CmbEisDataFormat" Grid.Column="2" Grid.Row="10" IsEditable="False" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 SelectedIndex="{Binding Path=DataFormat, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                 Margin="0,5">
                </ComboBox>
                <ContentPresenter Grid.Row="10" Grid.Column="3" Name="CmbEisDataFormatError"
                Content="{Binding ElementName=CmbEisDataFormat, Path=(Validation.Errors).CurrentItem}"/>-->

                <!--<TextBlock VerticalAlignment="Center" Grid.Row="12" Text="{x:Static properties:Resources.CaptionStation}"/>
                <ComboBox Name="CmbStation" Grid.Column="2" Grid.Row="12" 
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding StationName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Margin="0,0,0,2" Grid.RowSpan="2">
                </ComboBox>
                <ContentPresenter Grid.Row="12" Grid.Column="3" 
                Content="{Binding ElementName=CmbStation, Path=(Validation.Errors).CurrentItem}"/>-->
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
