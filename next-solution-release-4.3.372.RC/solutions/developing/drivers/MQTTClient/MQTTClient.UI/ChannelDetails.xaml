<UserControl x:Class="MQTTClient.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:MQTTClient.UI.Properties"
             mc:Ignorable="d" Height="500" Width="600"
             d:DesignHeight="350" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="Auto"/>-->
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="12" HorizontalAlignment="Stretch" Background="Transparent" />-->

                <TextBlock VerticalAlignment="Center" Grid.Row="0" Margin="0,1" Text="{x:Static properties:Resources.BrokerHostName}"/>
                <TextBox Name="MqttHostName" Grid.Column="2" Grid.Row="0"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MQTTServerHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3" 
                Content="{Binding ElementName=MqttHostName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="MqttServerHostPortText" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" Text="{x:Static properties:Resources.BrokerHostPort}"/>
                <TextBox Name="MqttServerHostPort" Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MQTTServerHostPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=MqttServerHostPort, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="ClientIdentifierText" VerticalAlignment="Center" Grid.Row="2" Margin="0,1" Text="{x:Static properties:Resources.MQTTClientClientIdentifier}"/>
                <DockPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKPMQTTClientIdentifier" Margin="0,5">
                    <Button DockPanel.Dock="Right" Click="GenerateNewClientID_Click">
                        <Button.Content>
                            <TextBlock Text="{x:Static properties:Resources.MQTTClientGenerateNewID}"/>
                        </Button.Content>
                    </Button>
                    <TextBox Name="MqttClientIdentifier" Validation.ErrorTemplate="{x:Null}"
                  Text="{Binding MQTTClientIdentifier, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                </DockPanel>
                <ContentPresenter Grid.Row="2" Grid.Column="3"
                 Content="{Binding ElementName=MqttClientIdentifier, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Grid.Row="3" Margin="0,1" Text="{x:Static properties:Resources.MQTTClientUsername}"/>
                <TextBox Name="MqttUserName" Grid.Column="2" Grid.Row="3"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MQTTClientUserName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3"
                Content="{Binding ElementName=MqttUserName, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Grid.Row="4" Margin="0,1" Text="{x:Static properties:Resources.MQTTClientPassword}"/>
                <TextBox Name="MqttPassword" Grid.Column="2" Grid.Row="4"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MQTTClientPassword, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3"
                Content="{Binding ElementName=MqttPassword, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.MQTTClientCleanSession}" VerticalAlignment="Center" x:FieldModifier="public" Name="textCleanSession" Grid.Row="5" Margin="0,1"/>
                <CheckBox Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Name="checkCleanSession" Margin="0,5"
                IsChecked="{Binding MQTTClientCleanSession, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

                <TextBlock Name="MqttClientKeepAliveText" VerticalAlignment="Center" Grid.Row="6" Margin="0,1" Text="{x:Static properties:Resources.MQTTClientKeepAliveTime}"/>
                <TextBox Name="MqttClientKeepAlive" Grid.Column="2" Grid.Row="6"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                Text="{Binding MQTTClientKeepAliveTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="6" Grid.Column="3"
                Content="{Binding ElementName=MqttClientKeepAlive, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.MQTTClientUseSecureConnection}" VerticalAlignment="Center" x:FieldModifier="public" Name="textUseSecureConnection" Grid.Row="7" Margin="0,1"/>
                <CheckBox Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Name="checkUseSecureConnection" Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      IsChecked="{Binding MQTTClientUseSecureConnection, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

                <TextBlock Text="{x:Static properties:Resources.MQTTClientProtocolForSecureConnection}" Name ="TxtProtocolSecureConnection" VerticalAlignment="Center" Grid.Row="8" Margin="0,1"/>
                <ComboBox Name="CmbProtocolForSecureConnection" Grid.Column="2" Grid.Row="8" Margin="0,5" IsEditable="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                      SelectedValue="{Binding MQTTClientProtocolForSecureConnection, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
                <ContentPresenter Grid.Row="8" Grid.Column="3"
                Content="{Binding ElementName=CmbProtocolForSecureConnection, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Grid.Row="9" Margin="0,1" Text="{x:Static properties:Resources.MQTTClientCACertificateFile}" Name="TxtMqttCACertificateFile"/>
                <TextBox Name="MqttCACertificateFile" Grid.Column="2" Grid.Row="9"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MQTTClientCACertificateFile, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="9" Grid.Column="3"
                Content="{Binding ElementName=MqttCACertificateFile, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock VerticalAlignment="Center" Grid.Row="10" Margin="0,1" Text="{x:Static properties:Resources.MQTTClientClientCertificateFile}" Name="TxtMqttClientCertificateFile"/>
                <TextBox Name="MqttClientCertificateFile" Grid.Column="2" Grid.Row="10"  HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MQTTClientClientCertificateFile, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="10" Grid.Column="3"
                Content="{Binding ElementName=MqttClientCertificateFile, Path=(Validation.Errors).CurrentItem}"/>

                <!--<TextBlock Text="{x:Static properties:Resources.MQTTClientUseAzureConnection}" VerticalAlignment="Center" x:FieldModifier="public" Name="textUseAzureConnection" Grid.Row="11" Margin="0,1"/>
                <CheckBox Grid.Row="11" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Name="checkUseAzureConnection" Margin="5"
                      IsChecked="{Binding MQTTClientUseAzureConnection, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>-->
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
