<UserControl x:Class="SQLDriver.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties;assembly=DriverCodeBaseEx.UI"
             mc:Ignorable="d" Width="600" Height="300"
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dx:DXTabControl Name="tabGeneral">
            <dx:DXTabItem Name="GeneralSettings" Header="{x:Static properties:Resources.GeneralSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="MainStack" Orientation="Vertical">
                        <Grid x:Name="gridSpecific">
                            <Grid.ColumnDefinitions>                                
                                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->
                            <ContentPresenter Grid.Row="0" Grid.Column="2" x:FieldModifier="public" Name="DrvUrlClockPostErr"
                            Content="{Binding ElementName=DrvUrlClockPost, Path=(Validation.Errors).CurrentItem}"/>
                            <ContentPresenter Grid.Row="1" Grid.Column="2" x:FieldModifier="public" Name="DrvSubscritionKeyErr"
                            Content="{Binding ElementName=DrvUrlToPostTo, Path=(Validation.Errors).CurrentItem}"/>
                            <ContentPresenter Grid.Row="2" Grid.Column="2" x:FieldModifier="public" Name="DrvApiKeyErr"
                            Content="{Binding ElementName=DrvApiKey, Path=(Validation.Errors).CurrentItem}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </dx:DXTabItem>
            <dx:DXTabItem Name="ChannelSettings" Header="{x:Static properties:Resources.ChannelsSettings}">
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
