<UserControl x:Class="TwinCAT.UI.SettingsControls.DeviceAddress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:TwinCAT.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.CaptionDeviceAddress}" VerticalAlignment="Center" Margin="0,1"/>
        <TextBox Name="StartAddr" Grid.Column="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
            Text="{Binding Address, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
        <ContentPresenter Grid.Column="3" 
        Content="{Binding ElementName=StartAddr, Path=(Validation.Errors).CurrentItem}"/>                
    </Grid>
</UserControl>
