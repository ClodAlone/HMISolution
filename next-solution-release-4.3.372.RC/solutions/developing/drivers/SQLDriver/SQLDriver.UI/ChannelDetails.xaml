<UserControl x:Class="SQLDriver.UI.ChannelDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dr="clr-namespace:DataReaderEditor.PropertyDataTemplate;assembly=DataReaderEditor"
             xmlns:local="clr-namespace:SQLDriver.UI"
             xmlns:properties="clr-namespace:SQLDriver.UI.Properties"
             mc:Ignorable="d" Height="250" Width="600"
             d:DesignHeight="50" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source=".\ResourceDictionary\DataError.xaml" />-->
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="1" Grid.RowSpan="1" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.ConnectionStringText}" VerticalAlignment="Center" Margin="0,1" Grid.Row="0" Name="label7"/>
                <dr:DataReaderModelPropertyEditor Grid.Column="2" Grid.Row="0"  Name="editConnectionString" Margin="0,5" ToolTip="{x:Static properties:Resources.ConnectionStringTooltip}"/>

	            <TextBlock Text="{x:Static properties:Resources.BackupConnectionStringText}" VerticalAlignment="Center" Margin="0,1" Grid.Column="0" Grid.Row="1" Name="label"  />
                <dr:DataReaderModelPropertyEditor  Grid.Column="2" Grid.Row="1" Margin="0,5" Name="editBackupConnectionString"/>
	            
	            <TextBlock Name="TxBSwitchHostTimeout" Text="{x:Static properties:Resources.SwitchHostTimeout}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="SwitchHostTimeout" Grid.Column="2" Grid.Row="2" Margin="0,1"
	                 VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
	                 Text="{Binding ChannelSwitchHostTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
	            <ContentPresenter Grid.Row="2" Grid.Column="3" 
	            Content="{Binding ElementName=ChannelSwitchHostTimeout, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Name="TxBPublishingInterval" Text="{x:Static properties:Resources.PublishingInterval}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1"/>
                <TextBox Name="PublishingInterval" Grid.Column="2" Grid.Row="3" Margin="0,1"
	                 VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
	                 Text="{Binding PublishingInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="3" Grid.Column="3" 
	            Content="{Binding ElementName=PublishingInterval, Path=(Validation.Errors).CurrentItem}"/>
                <TextBlock Name="TxBMaxConsecutiveWrite" Text="{x:Static properties:Resources.MaxConsecutiveWrite}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1"/>
                <TextBox Name="MaxConsecutiveWrite" Grid.Column="2" Grid.Row="4" Margin="0,1"
	                 VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
	                 Text="{Binding MaxConsecutiveWrite, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3" 
	            Content="{Binding ElementName=MaxConsecutiveWrite, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
