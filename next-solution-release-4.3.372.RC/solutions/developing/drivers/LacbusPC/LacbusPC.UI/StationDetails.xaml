<UserControl x:Class="LacbusPC.UI.StationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:LacbusPC.UI.Properties"
             mc:Ignorable="d" Height="400" Width="600"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFUtilities;component/ResourceDictionary/DataError.xaml" />-->
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <StackPanel x:Name="MainStack" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--<GridSplitter Grid.Column="2" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />-->
                <TextBlock Text="{x:Static properties:Resources.LacbusRTUNumber}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1"/>
                <TextBox Name="RTUNumber" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                Text="{Binding LacbusPCRTUNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="0" Grid.Column="3"
                    Content="{Binding ElementName=RTUNumber, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.LacbusProtocolType}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
                <ComboBox Name="CmbProtocolType" Grid.Column="2" Grid.Row="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    SelectedValue="{Binding LacbusPCProtocolType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
                </ComboBox>
                <ContentPresenter Grid.Row="1" Grid.Column="3"
                    Content="{Binding ElementName=CmbProtocolType, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Text="{x:Static properties:Resources.LacbusPhoneNumber}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1"/>
                <TextBox Name="PhoneNumber" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding LacbusPCPhoneNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="2" Grid.Column="3"
                    Content="{Binding ElementName=PhoneNumber, Path=(Validation.Errors).CurrentItem}"/>

                <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.CaptionAutomaticPollRTU}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textBlockAutomaticPollRTU" Margin="0,1"/>
                <CheckBox  Grid.Row="3" Grid.Column="2" Name="AutomaticPollRTU" VerticalAlignment="Center"
                        x:FieldModifier="public" IsChecked="{Binding LacbusPCAutomaticPollRTU, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,5"/>

                <TextBlock Text="{x:Static properties:Resources.LacbusCommunicationDuration}" VerticalAlignment="Center" Grid.Row="4" Margin="0,1" Name="CommunicationDurationText"/>
                <TextBox Name="CommunicationDuration" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                    Text="{Binding LacbusPCCommunicationDuration, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
                <ContentPresenter Grid.Row="4" Grid.Column="3"
                    Content="{Binding ElementName=CommunicationDuration, Path=(Validation.Errors).CurrentItem}"/>

		          <TextBlock Text="{x:Static properties:Resources.LacbusAutomaticPollRTUFrequency}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1" Name="AutomaticPollRTUFrequencyText"/>
		          <TextBox Name="AutomaticPollRTUFrequency" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
		                  Text="{Binding LacbusPCAutomaticPollRTUFrequency, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
		          <ContentPresenter Grid.Row="5" Grid.Column="3"
	                  Content="{Binding ElementName=AutomaticPollRTUFrequency, Path=(Validation.Errors).CurrentItem}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
