<UserControl x:Class="Simotion.UI.SettingsControls.StringLength"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:Simotion.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="TxBStringLength" Text="{x:Static properties:Resources.StringLength}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
        <TextBox Name="TxStringLength" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}"  Margin="0,5"
                Text="{Binding StringLength, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" />
        <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=TxStringLength, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
