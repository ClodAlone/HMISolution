<UserControl x:Class="Simotion.UI.SettingsControls.S7DataFormat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:Simotion.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{x:Static properties:Resources.S7DataFormat}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1"/>
        <ComboBox Name="CmbS7DataFormat" Grid.Column="2" Grid.Row="2" IsEditable="False" HorizontalAlignment="Stretch" Margin="0,5"
                SelectedValue="{Binding  S7DataFormat, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" >
        </ComboBox>
        <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=CmbS7DataFormat, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
