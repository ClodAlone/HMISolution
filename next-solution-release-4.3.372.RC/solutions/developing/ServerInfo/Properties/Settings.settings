<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="UFUAServerInfo.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultServerExe" Type="System.String" Scope="Application">
      <Value Profile="(Default)">PlatformNextIOServer.exe</Value>
    </Setting>
    <Setting Name="DefaultServerConfig" Type="System.String" Scope="Application">
      <Value Profile="(Default)">UFUAServer.UAServer.Config.xml</Value>
    </Setting>
    <Setting Name="XpoDefaultConnectionString" Type="System.String" Scope="Application">
      <Value Profile="(Default)">XpoProvider=MSSqlServer;data source=(local);integrated security=SSPI;initial catalog=ApplicationName</Value>
    </Setting>
    <Setting Name="TagsRootName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Tags</Value>
    </Setting>
    <Setting Name="DynSettingsSeparator" Type="System.Char" Scope="Application">
      <Value Profile="(Default)">$</Value>
    </Setting>
    <Setting Name="AlarmsRootName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Alarms</Value>
    </Setting>
    <Setting Name="DriversRootName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Drivers</Value>
    </Setting>
    <Setting Name="DefaultAliasRootName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">DA</Value>
    </Setting>
    <Setting Name="AuditSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Audit</Value>
    </Setting>
    <Setting Name="CFR21UserName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">NExT_IO_Server</Value>
    </Setting>
    <Setting Name="SysTrayApp" Type="System.String" Scope="Application">
      <Value Profile="(Default)">PlatformNextSysTray.exe</Value>
    </Setting>
    <Setting Name="HistorianFlushFolderName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Historian</Value>
    </Setting>
    <Setting Name="EventFlushFolderName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">EventLog</Value>
    </Setting>
    <Setting Name="DataLoggerFlushFolderName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">DataLogger</Value>
    </Setting>
    <Setting Name="DefaultFileExtAlr" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.alrRTSettings</Value>
    </Setting>
    <Setting Name="RuntimeAlrFileName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">RuntimeAlarm</Value>
    </Setting>
    <Setting Name="SQLDatabaseConfigurationTool" Type="System.String" Scope="Application">
      <Value Profile="(Default)">SQLDatabaseConfiguration.exe</Value>
    </Setting>
    <Setting Name="SQLDatabaseConfigurationArgs" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"/O{0}" "/P{1}" ""/D"{2}" "/T{3}" "/U{4}" "/L{5}" "/C{6}" "/H{7}"</Value>
    </Setting>
    <Setting Name="CoreExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.core</Value>
    </Setting>
    <Setting Name="MinWriteTimeout" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">5000</Value>
    </Setting>
  </Settings>
</SettingsFile>