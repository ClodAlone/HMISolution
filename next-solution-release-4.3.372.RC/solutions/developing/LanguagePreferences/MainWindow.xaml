<dx:DXWindow x:Class="LanguagePreferences.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:LanguagePreferences.Properties"
        xmlns:converters="clr-namespace:LanguagePreferences.Converters"
        Title="{x:Static properties:Resources.Title}" Height="350" Width="525"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        WindowStartupLocation="CenterScreen" BorderEffect="Default" 
        ResizeMode="NoResize">
    
    <Window.Resources>
        <converters:LanguageNameConverter x:Key="LanguageNameConverter" />
        <converters:LanguageNameBoldConverter x:Key="LanguageNameBoldConverter" />
    </Window.Resources>
    
    <Border CornerRadius="10" BorderBrush="Black" BorderThickness="2px, 5px, 2px, 5px" Margin="10" >
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static properties:Resources.Languages}" />
            <ListBox Grid.Row="1" Margin="0, 10, 0, 10"
                     ItemsSource="{Binding AvailableLanguages}" 
                     SelectedItem="{Binding SelectedUI}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource LanguageNameConverter}}" 
                                   FontWeight="{Binding Converter={StaticResource LanguageNameBoldConverter}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="5"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
            <!--<StackPanel Grid.Row="2" HorizontalAlignment="Center" >-->
                <Button Content="{x:Static properties:Resources.SetAsDefaultLanguageCommandTitle}" Command="{Binding SetAsDefault}"/>
                <Button Grid.Row="2" Content="{x:Static properties:Resources.CloseCommandTitle}" Command="{Binding CloseApplication}"/>
            <!--</StackPanel>-->
            </Grid>
        </Grid>
    </Border>
</dx:DXWindow>
