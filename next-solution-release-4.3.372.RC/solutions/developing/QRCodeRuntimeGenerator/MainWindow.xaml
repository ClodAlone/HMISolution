        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:QRCodeRuntimeGenerator.Properties"
        Title="MainWindow" Height="204" Width="358">
    <Grid>
        <TextBox x:Name="QRCode" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="01234-ABCD"  Width="330" Margin="10,10,10,125" />
        <!--<Button Content="{x:Static properties:Resources.QRPreview}" HorizontalAlignment="Left" Margin="0,63,0,0" VerticalAlignment="Top" Width="350" Height="37"/>
        <Button Content="{x:Static properties:Resources.QRPrint}" HorizontalAlignment="Left" Margin="0,100,0,0" VerticalAlignment="Top" Width="350" Height="42"/>-->
        <Button x:Name="previewbuttont" Content="{x:Static properties:Resources.PreviewButtonTitle}" HorizontalAlignment="Left" Margin="10,63,0,0" VerticalAlignment="Top" Width="330" Height="37" Click="previewbuttont_Click"/>
        <Button x:Name="printbuttont" Content="{x:Static properties:Resources.PrintButtonTitle}" HorizontalAlignment="Left" Margin="10,114,0,0" VerticalAlignment="Top" Width="330" Height="37" Click="printbuttont_Click"/>

    </Grid>
</Window>
