<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="UFInstallWebClient.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DefaultWebSite" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Default Web Site</Value>
    </Setting>
    <Setting Name="DefaultAppPool" Type="System.String" Scope="Application">
      <Value Profile="(Default)">MovNExTWebServerAppPool</Value>
    </Setting>
    <Setting Name="DefaultIdentity" Type="System.String" Scope="Application">
      <Value Profile="(Default)">ApplicationPoolIdentity</Value>
    </Setting>
    <Setting Name="DefaultTheme" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Blend</Value>
    </Setting>
    <Setting Name="ProjectPathSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Project</Value>
    </Setting>
    <Setting Name="WebClientPathSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">UFWebClient.HTML5</Value>
    </Setting>
    <Setting Name="LogPathSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Log</Value>
    </Setting>
    <Setting Name="CommonApplicationFolder" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Movicon.NExT</Value>
    </Setting>
    <Setting Name="CompanyName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Progea</Value>
    </Setting>
    <Setting Name="AppDataPathSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">App_Data</Value>
    </Setting>
    <Setting Name="SelectImageFilter" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Images (*.jpg, *.jpeg , *.jpe, *.gif, *.png, *.bmp)|*.jpg;*.jpeg;*.jpe;*.gif;*.png;*.bmp|All Files|*.*</Value>
    </Setting>
    <Setting Name="RefreshPollingTimeDefaultValue" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">1000</Value>
    </Setting>
    <Setting Name="RefreshPollingTimeCountDefaultValue" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">10</Value>
    </Setting>
    <Setting Name="DelayBroadcasterDefaultValue" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">250</Value>
    </Setting>
    <Setting Name="SessionTimeoutDefaultValue" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">60</Value>
    </Setting>
    <Setting Name="ConcurrentRenderingPipelineValue" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">5</Value>
    </Setting>
    <Setting Name="LowResolutionDefaultValue" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="SoftwareRenderingDefaultValue" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">False</Value>
    </Setting>
  </Settings>
</SettingsFile>