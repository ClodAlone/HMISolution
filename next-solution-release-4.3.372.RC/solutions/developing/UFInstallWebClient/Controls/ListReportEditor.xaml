<UserControl x:Class="UFInstallWebClient.Controls.ListReportEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFInstallWebClient.Controls"
             xmlns:common="clr-namespace:CommonControls.Converters;assembly=CommonControls"
             xmlns:properties="clr-namespace:UFInstallWebClient.Properties" xmlns:editors="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             x:Name="listDataSourceEditor"
             Height="300" Width="500"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <common:ActualWidthConverter x:Key="ActualWidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>

        <!--<CommandBinding Command="{x:Static self:ListDataSourceEditor.EditCommand}"
                    Executed="OnEditCommandExecuted" 
                    CanExecute="OnCanExecuteEditCommand" />-->

        <CommandBinding Command="{x:Static self:ListDataSourceEditor.RemoveCommand}"
                    Executed="OnRemoveCommandExecuted" 
                    CanExecute="OnCanExecuteRemoveCommand" />

        <CommandBinding Command="{x:Static self:ListDataSourceEditor.MoveUpCommand}"
                    Executed="OnMoveUpCommandExecuted" 
                    CanExecute="OnCanExecuteMoveUpCommand" />

        <CommandBinding Command="{x:Static self:ListDataSourceEditor.MoveDownCommand}"
                    Executed="OnMoveDownCommandExecuted" 
                    CanExecute="OnCanExecuteMoveDownCommand" />

    </UserControl.CommandBindings>

    <Grid x:Name="layoutGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=listUriControl, Path=ItemsSource.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.Report}" Margin="10,0" />
            <TextBlock Text="{x:Static properties:Resources.Users}" Grid.Column="1" Margin="5,0"/>
            <TextBlock Text="{x:Static properties:Resources.Roles}" Grid.Column="2" />
        </Grid>
        <ListBox x:Name="listUriControl" 
                 ItemsSource="{Binding}"
                 IsSynchronizedWithCurrentItem="False" Grid.Row="1" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding Path=ActualWidth, 
                        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}},
                        Converter={StaticResource ResourceKey=ActualWidthConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <!--<ColumnDefinition Width="Auto"/>-->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <editors:ComboBoxEdit SeparatorString="; "
                                  ItemsSource="{Binding Reports}"
                                  EditValue="{Binding Report}"
                                  Margin="3,0"/>

                        <editors:ComboBoxEdit SeparatorString="; "
                                  ItemsSource="{Binding Users}"
                                  Text="{Binding SelectedUsers}"                                              
                                  Margin="3,0"
                                  Grid.Column="1">
                            <editors:ComboBoxEdit.StyleSettings>
                                <editors:CheckedComboBoxStyleSettings />
                            </editors:ComboBoxEdit.StyleSettings>
                        </editors:ComboBoxEdit>

                        <editors:ComboBoxEdit SeparatorString="; "
                                  ItemsSource="{Binding Roles}"
                                  Text="{Binding SelectedRoles}"                                  
                                  Margin="3,0"
                                  Grid.Column="2">
                            <editors:ComboBoxEdit.StyleSettings>
                                <editors:CheckedComboBoxStyleSettings />
                            </editors:ComboBoxEdit.StyleSettings>
                        </editors:ComboBoxEdit>
                        
                        <Button Grid.Column="3" Tag="{Binding}"
                                Command="{x:Static self:ListDataSourceEditor.RemoveCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="4" Tag="{Binding}"
                                Command="{x:Static self:ListDataSourceEditor.MoveUpCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource MoveUpSmall}"/>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="5" Tag="{Binding}"
                                Command="{x:Static self:ListDataSourceEditor.MoveDownCommand}">
                            <Button.Content>
                                <Image Source="{StaticResource MoveDownSmall}"/>
                            </Button.Content>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static properties:Resources.ListDataSourceAddNew}" Command="{Binding Path=AddNew, ElementName=listDataSourceEditor}" />
            <Button Content="{x:Static properties:Resources.ListDataSourceRemoveAll}" Grid.Column="1" Command="{Binding Path=RemoveAll, ElementName=listDataSourceEditor}" />
        </Grid>
        
    </Grid>
</UserControl>
