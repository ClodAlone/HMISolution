<dx:DXTabbedWindow x:Class="UFInstallWebClient.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:IIS7Manager="clr-namespace:IIS7Manager;assembly=IIS7Manager"
                   xmlns:System="clr-namespace:System;assembly=mscorlib"
                   xmlns:local="clr-namespace:UFInstallWebClient.Converters"
                   xmlns:properties="clr-namespace:UFInstallWebClient.Properties"
                   xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
                   xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                   xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                   WindowStartupLocation="CenterScreen" BorderEffect="Default" 
                   Icon="App.ico" TabbedWindowMode="Compact"
                   Title="{x:Static properties:Resources.AppTitle}" Height="600" Width="850" >
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="identityUsers"
                                MethodName="GetValues"
                                ObjectType="{x:Type System:Enum}" >
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="IIS7Manager:IISAppPool+IISAppPoolProcessModelIdentityType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <local:IdentityToVisibilityConverter x:Key="IdentityVisibilityConverter" />
            <local:IdentityToBooleanConverter x:Key="IdentityBooleanConverter" />
            <local:IsTitleEditableMultiConverter x:Key="IsTitleEditableMultiConverter" />
            <utilities:ItemsCountConverter x:Key="ItemsCountConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <dx:DXTabControl>
            
            <dx:DXTabItem Header="{x:Static properties:Resources.DeployHeader}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="1" Margin="2,2,2,2" Text="{x:Static properties:Resources.IISUrl}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <TextBox x:Name="txtUrl" Grid.Row="1" Grid.Column="1" Margin="2,2,2,2" Text="{Binding Path=IISUrl, Mode=OneWay}" IsEnabled="False"/>

                    <TextBlock Grid.Row="3" Margin="2,2,2,2" Text="{x:Static properties:Resources.AliasName}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <TextBox x:Name="txtAlias" Grid.Row="3" Grid.Column="1" Margin="2,2,2,2" 
                     Text="{Binding Path=AliasName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                    <ContentPresenter Grid.Row="3" Grid.Column="2" Content="{Binding ElementName=txtAlias, Path=(Validation.Errors).CurrentItem}"/>

                    <TextBlock Grid.Row="4" Margin="2,2,2,2" Text="{x:Static properties:Resources.DeployPath}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="2,2,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtDeployPath" Text="{Binding Path=DeployPath, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Width="18" Grid.Column="1" Click="DeployPath_Click">
                            <Button.Content>
                                <Image Source="{StaticResource SelectPathSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>
                    <ContentPresenter Grid.Row="4" Grid.Column="2" Content="{Binding ElementName=txtDeployPath, Path=(Validation.Errors).CurrentItem}"/>

                    <TextBlock Grid.Row="5" Margin="2,2,2,2" Text="{x:Static properties:Resources.ApplicationPool}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <ComboBox x:Name="txtApplicationPool" Grid.Row="5" Grid.Column="1" Margin="2,2,2,2" IsEditable="True" 
                      ItemsSource="{Binding ApplicationPoolList}" 
                      SelectedItem="{Binding Path=ApplicationPoolName, UpdateSourceTrigger=PropertyChanged}" 
                      Text="{Binding Path=ApplicationPoolName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <!--<TextBox x:Name="txtApplicationPool" Grid.Row="5" Grid.Column="1" Margin="2,2,2,2" 
                     Text="{Binding Path=ApplicationPoolName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />-->
                    <ContentPresenter Grid.Row="5" Grid.Column="2" Content="{Binding ElementName=txtApplicationPool, Path=(Validation.Errors).CurrentItem}"/>

                    <TextBlock Grid.Row="6" Margin="2,2,2,2" Text="{x:Static properties:Resources.Indentity}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <ComboBox x:Name="txtIdentityValue" Grid.Row="6" Grid.Column="1" Margin="2,2,2,2" IsEditable="False" SelectionChanged="Identity_SelectionChanged" 
                      ItemsSource="{Binding Source={StaticResource identityUsers}}" 
                      SelectedItem="{Binding Path=IndentityValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                      Visibility="{Binding Path=IndentityValue, Converter={StaticResource IdentityVisibilityConverter}, ConverterParameter=true}" />
                    <Grid x:Name="gridIdentityName" Grid.Row="6" Grid.Column="1" Margin="2,2,2,2" 
                          Visibility="{Binding Path=IndentityValue, Converter={StaticResource IdentityVisibilityConverter}, ConverterParameter=false}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtIdentityName"
                         Text="{Binding Path=IndentityName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" />
                        <Button Width="18" Grid.Column="1" Click="IdentityButton_ChangeUser">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Width="18" Grid.Column="2" Click="IdentityButton_RemoveUser" 
                        IsEnabled="{Binding Path=IndentityName, Converter={StaticResource IdentityBooleanConverter}, ConverterParameter=false}">
                            <Button.Content>
                                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>
                    <ContentPresenter Grid.Row="6" Grid.Column="2" Content="{Binding ElementName=txtIdentityName, Path=(Validation.Errors).CurrentItem}"/>
                </Grid>
            </dx:DXTabItem>
            
            <dx:DXTabItem Header="{x:Static properties:Resources.DataSourcesHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Margin="2,2,2,2" Text="{x:Static properties:Resources.DataGridSources}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="2,2,2,2">
                        <Button DockPanel.Dock="Right" Click="DataGridSourcesClear_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="DataGridSourcesEdit_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBox IsReadOnly="True" Text="{Binding Path=DataGridSources, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ItemsCountConverter}}"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Margin="2,2,2,2" Text="{x:Static properties:Resources.DataAnalysisSources}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="2,2,2,2">
                        <Button DockPanel.Dock="Right" Click="DataAnalysisSourcesClear_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="DataAnalysisSourcesEdit_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBox IsReadOnly="True" Text="{Binding Path=DataAnalysisSources, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ItemsCountConverter}}"/>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Margin="2,2,2,2" Text="{x:Static properties:Resources.DashBoardSources}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="2,2,2,2">
                        <Button DockPanel.Dock="Right" Click="DashBoardSourcesClear_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="DashBoardSourcesEdit_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBox IsReadOnly="True" Text="{Binding Path=DashBoardSources, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ItemsCountConverter}}"/>
                    </DockPanel>

                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.DisableCreateNewDashboard}"
                              IsChecked="{Binding Path=DisableCreateNewDashboard}" />

                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.SwitchToViewerDashboard}"
                              IsChecked="{Binding Path=SwitchToViewerDashboard}" />
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem Header="{x:Static properties:Resources.BasicSettingsHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="showTitle" Margin="2,2,2,2" VerticalAlignment="Center"
                                  Content="{x:Static properties:Resources.ShowProjectTitle}"
                                  IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                                  IsChecked="{Binding Path=ShowProjectTitle}" />
                        <TextBox Grid.Column="1" Margin="10,2,2,2"
                                 Text="{Binding Path=ProjectTitle, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource IsTitleEditableMultiConverter}" Mode="OneWay">
                                    <Binding Path="IsChecked" ElementName="showHeader" />
                                    <Binding Path="IsChecked" ElementName="showTitle" />
                                </MultiBinding>
                            </TextBox.IsEnabled>
                        </TextBox>
                    </Grid>                    
                    <TextBlock Grid.Row="1" Margin="2,2,2,2" Text="{x:Static properties:Resources.LogoUrl}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="2,2,2,2">
                        <Button DockPanel.Dock="Right" Click="LogoUrlCancel_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="LogoUrlEdit_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource SelectPathSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBox Text="{Binding Path=LogoUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    
                    <UniformGrid Columns="2" Grid.ColumnSpan="3" Grid.Row="2">
                        <StackPanel>
                    <CheckBox x:Name="showHeader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowHeader}"
                              IsChecked="{Binding Path=ShowHeader}" />

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowUserRegisterLink}"
                              IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                              IsChecked="{Binding Path=ShowUserRegisterLink}" />

                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowDashboardMenuItem}"
                              IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                              IsChecked="{Binding Path=ShowDashboardMenuItem}" />

                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowAlarmMenuItem}"
                              IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                              IsChecked="{Binding Path=ShowAlarmMenuItem}" />

                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowDataAnalisysMenuItem}"
                              IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                              IsChecked="{Binding Path=ShowDataAnalisysMenuItem}" />
                        
                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowDataGridMenuItem}"
                              IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                              IsChecked="{Binding Path=ShowDataGridMenuItem}" />
                        
                        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowReportMenuItem}"
                              IsEnabled="{Binding Path=IsChecked, ElementName=showHeader, Mode=OneWay}"
                              IsChecked="{Binding Path=ShowReportMenuItem}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.ShowScreenNavigator}"
                              IsChecked="{Binding Path=ShowScreenNavigator}" />
                        
                        <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.DisablePopupScreen}"
                              IsChecked="{Binding Path=DisablePopupScreen}" />

                        <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.StaticOptimization}"
                              Checked="checkStaticOptimization_Checked" IsChecked="{Binding Path=StaticOptimization}" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </dx:DXTabItem>

            <dx:DXTabItem Header="{x:Static properties:Resources.ReportSettingsHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Margin="2,2,2,2" Text="{x:Static properties:Resources.ReportSources}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="2,2,2,2">
                        <Button DockPanel.Dock="Right" Click="ReportSourcesClear_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="ReportSourcesEdit_Click" BorderThickness="0">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <TextBox IsReadOnly="True" Text="{Binding Path=ReportSources, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ItemsCountConverter}}"/>
                    </DockPanel>
                </Grid>
            </dx:DXTabItem>
            
            <dx:DXTabItem Header="{x:Static properties:Resources.AdvancedSettingsHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Margin="2,2,2,2" Text="{x:Static properties:Resources.SessionTimeout}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <dxe:SpinEdit Grid.Row="0" Grid.Column="1" Margin="2,2,2,2"
                                  MinValue="1" MaxValue="600" IsFloatValue="False" AllowSpinOnMouseWheel="True" 
                                  Text="{Binding Path=SessionTimeout, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Margin="2,2,2,2" Text="{x:Static properties:Resources.RefreshPollingTime}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <dxe:SpinEdit Grid.Row="1" Grid.Column="1" Margin="2,2,2,2"
                                  MinValue="10" MaxValue="10000" IsFloatValue="False" AllowSpinOnMouseWheel="True" 
                                  Text="{Binding Path=RefreshPollingTime, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Margin="2,2,2,2" Text="{x:Static properties:Resources.RefreshPollingTimeCount}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <dxe:SpinEdit Grid.Row="2" Grid.Column="1" Margin="2,2,2,2"
                                  MinValue="1" MaxValue="500" IsFloatValue="False" AllowSpinOnMouseWheel="True"
                                  Text="{Binding Path=RefreshPollingTimeCount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Margin="2,2,2,2" Text="{x:Static properties:Resources.DelayBroadcaster}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <dxe:SpinEdit Grid.Row="3" Grid.Column="1" Margin="2,2,2,2"
                                  MinValue="10" MaxValue="10000" IsFloatValue="False" AllowSpinOnMouseWheel="True"
                                  Text="{Binding Path=DelayBroadcaster, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Margin="2,2,2,2" Text="{x:Static properties:Resources.ConcurrentRenderingPipeline}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <dxe:SpinEdit Grid.Row="4" Grid.Column="1" Margin="2,2,2,2"
                                  MinValue="1" MaxValue="100" IsFloatValue="False" AllowSpinOnMouseWheel="True"
                                  Text="{Binding Path=ConcurrentRenderingPipeline, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.SoftwareRendering}"
                              IsChecked="{Binding Path=SoftwareRendering}" />

                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.LowResolution}"
                              IsChecked="{Binding Path=LowResolution}" />

                    <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,2,2,2"
                            Content="{x:Static properties:Resources.DefaultValuesBtnTitle}" Click="SetDefaultValues_Click" />
                </Grid>
            </dx:DXTabItem>
            
        </dx:DXTabControl>
        
        <Grid Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Rectangle RadiusX="10" Grid.ColumnSpan="6"
                        RadiusY="10" 
                        Stroke="White" 
                        StrokeDashArray="2"
                        Grid.Row="1" Margin="12,10,12,12" />
            <Border Padding="4"  Grid.ColumnSpan="6"
                        CornerRadius="2,2,2,2" 
                        Margin="10,10,10,10" 
                        Grid.Row="1" >
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Auto"
                                        Name="Scroll">
                    <TextBox Name="txtOutput" Background="{x:Null}" BorderBrush="{x:Null}" IsReadOnly="True" />
                </ScrollViewer>
            </Border>

            <Button Grid.Row="2" Grid.Column="0" x:Name="btnPublish" Margin="2,2,2,2" IsEnabled="{Binding Path=IsValid}"
                        Content="{x:Static properties:Resources.PublishButtonText}"  Height="30" Click="OnPublish_Click" />
            <Button Grid.Row="2" Grid.Column="1" x:Name="btnUpdate" Margin="2,2,2,2" IsEnabled="{Binding Path=IsPublished}"
                        Content="{x:Static properties:Resources.UpdateButtonText}"  Height="30" Click="OnUpdate_Click" />
            <Button Grid.Row="2" Grid.Column="2" x:Name="btnBrowse" Margin="2,2,2,2" 
                        Content="{x:Static properties:Resources.BrowseButtonText}" Height="30" Click="OnBrowse_Click" />
            <Button Grid.Row="2" Grid.Column="3" x:Name="btnClose" Margin="2,2,2,2" 
                        Content="{x:Static properties:Resources.CloseButtonText}"  Height="30" Click="OnClose_Click" />
            <!--<StackPanel Grid.Row="2" Margin="5,5,5,5" Orientation="Horizontal" HorizontalAlignment="Right" >
            </StackPanel>-->
        </Grid>
    </Grid>
</dx:DXTabbedWindow>
