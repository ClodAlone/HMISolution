<UserControl x:Class="HistoricalEventControl.HistoricalEvents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:properties="clr-namespace:HistoricalEventControl.Properties" 
             xmlns:converters="clr-namespace:HistoricalEventControl.Converters"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:enum="clr-namespace:HistoricalEventControl"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:self="clr-namespace:HistoricalEventControl.Converters"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:wpfutils="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:localconverters="clr-namespace:DataloggerViewerControl.Converters"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
             mc:Ignorable="d" Height="835" Width="865">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <self:ErrorInfoToBooleanConverter x:Key="ErrorInfoToBooleanConverter" />
            <self:ErrorInfoToVisibilityConverter x:Key="ErrorInfoToVisibilityConverter" />
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <localconverters:EventMessageConverter x:Key="EventMessageConverter" />
            <localconverters:EventStateConverter x:Key="EventStateConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <DockPanel.Resources>

           
            <converters:EventTypeToTextConverter x:Key="EventTypeToTextConverter" />
            <!-- *************************************************************** -->

            <!-- GRID CONTROL -->
            <!-- Header Foreground -->
            <DataTemplate x:Key="ColumnHeaderTemplate">
                <Border>
                    <ContentPresenter Name="contentPresenter" 
                                      Content="{Binding}" 
                                      TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                      TextBlock.FontFamily="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                      TextBlock.FontSize="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                      TextBlock.FontWeight="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                      TextBlock.FontStyle="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                     Style="{Binding  Path=(dxg:BaseGridHeader.GridColumn).ActualColumnHeaderContentStyle, RelativeSource={RelativeSource TemplatedParent}}">
                    </ContentPresenter>
                </Border>
            </DataTemplate>
            <!-- END GRID CONTROL -->
            <DiscreteObjectKeyFrame x:Key="colTextWrapKey" Value="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></DiscreteObjectKeyFrame>
        </DockPanel.Resources>
        <!-- TRAY BAR FOR CONFIGURATION -->
        <dxb:BarContainerControl ContainerType="Top" x:Name="mainToolbar" DockPanel.Dock="Top">
            <dxb:ToolBarControl BarItemDisplayMode="ContentAndGlyph" UseWholeRow="True" dxb:MergingProperties.Name="mainHistoricalEventsToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False">
              <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                  <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  UseLightweightTemplates="False" EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                        <dxe:ComboBoxEdit 
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>
                    <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall" Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmall" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />  
              </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit" />
                <dxb:BarItemSeparator />

                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="startTime" Content="{x:Static properties:Resources.HistoricalEvents_DateTimeStart}" EditValue="{Binding DateTimeStart,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                        </dxe:TextEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>

                <dxb:BarItemSeparator />

                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="endTime" Content="{x:Static properties:Resources.HistoricalEvents_DateTimeEnd}" EditValue="{Binding DateTimeEnd,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                        </dxe:TextEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>
        
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MinHeight="40" x:Name="options" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="16*" />
                </Grid.ColumnDefinitions>
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button1" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Minute}" Grid.Column="0" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="1"
    		/>
                <Button  ToolTipService.ShowOnDisabled="True" x:Name="Button2" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Hour}" Grid.Column="1"
    		Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="2" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button3" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Day}" Grid.Column="2" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="3" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button4" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Week}" Grid.Column="3" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="4" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button5" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Month}" Grid.Column="4" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="5" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button6" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Year}" Grid.Column="5" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="6" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button7" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_All}" Grid.Column="6" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="0" />
                <wpfutils:ComboWeb VerticalContentAlignment="Center" x:Name="Combo" Grid.Row="1" SelectionChanged="Combo_SelectionChanged" Grid.Column="7">
                    <ComboBox.Resources>
                        <DataTemplate x:Key="DataTemplateSequenceData">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="4,2,2,4" TextWrapping="NoWrap" Text="{Binding}" d:LayoutOverrides="Width, Height" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.Resources>
                    <ComboBox.ItemTemplate>
                        <StaticResource ResourceKey="DataTemplateSequenceData" />
                    </ComboBox.ItemTemplate>
                    <ComboBoxItem Content="{x:Static properties:Resources.ComboAll}" Tag="All" />
                    <ComboBoxItem Content="{x:Static properties:Resources.ComboAlarms}" Tag="Alarms" />
                    <ComboBoxItem Content="{x:Static properties:Resources.ComboDrivers}" Tag="Drivers" />
                    <ComboBoxItem Content="{x:Static properties:Resources.ComboSystem}" Tag="System" />
                </wpfutils:ComboWeb>
            </Grid>
            <Grid Grid.Row="2" x:Name="commands">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button MinHeight="40" DockPanel.Dock="Bottom" x:Name="Button8" Content="{x:Static properties:Resources.HistoricalEvents_RefreshDataCommand}" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Button Grid.Row="2" Grid.Column="1"
    		MinWidth="16" x:Name="Button9"
    		ToolTip="{x:Static properties:Resources.ExportDataCommand}"
    		Command="{Binding Path=ExportDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="1"
    		 Tag="ButtonExportData">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.ExportDataCommand}" Background="{x:Null}" x:Name="txtExport" />
                    </StackPanel>
                </Button>
                <ComboBox MinWidth="90" Visibility="Visible" Grid.Column="2" x:Name="cmbExportType" SelectionChanged="cmbExportType_SelectionChanged" />
                <Border Grid.Column="3" BorderThickness="1" 
                        BorderBrush="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderBrush}}"
                        Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}">
                            <dxe:CheckEdit ShowBorder="True" Grid.Column="3" x:Name="chkMultiLine" Content="{x:Static properties:Resources.HistoricalEvents_MultilineExportOption}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" Checked="chkMultiLine_Checked" Unchecked="chkMultiLine_Unchecked"></dxe:CheckEdit>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <dxg:GridControl 
                    MinHeight="10" 
                    MinWidth="10" 
                    Visibility="Visible"
                    AutoExpandAllGroups="True"
			        x:Name="gridControl"
                    AllowDrop="True" 
                    dx:DXSerializer.SerializationID="gridControl" dx:DXSerializer.StoreLayoutMode="All" 
                    AllowLiveDataShaping="False"                   
                    dxg:DataControlSerializationOptions.AddNewColumns="False" 
    		        dxg:DataControlSerializationOptions.RemoveOldColumns="False"
                    CustomColumnDisplayText="gridControl_CustomColumnDisplayText">
                    <dxg:GridControl.Resources>
                        <Style TargetType="{x:Type dxg:BaseGridHeader}">
                            <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        </Style>
                        <Style x:Key="columnStyle" BasedOn="{StaticResource {x:Type dxg:BaseGridHeader}}" TargetType="{x:Type dxg:BaseGridHeader}">
                            <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        </Style>
                        <Style x:Key="printColumnHeaderStyle" BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintHeaderStyle}}" TargetType="dxe:TextEdit">
                            <Setter Property="TextWrapping" Value="{Binding Value, Source={StaticResource colTextWrapKey}}" />
                        </Style>
                    </dxg:GridControl.Resources>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col1" AllowSearchPanel="True" Tag="EventDate" FieldName="EventDateTime" Header="{x:Static properties:Resources.HistoricalEvents_EventDateColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings Mask="d" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn UnboundType="DateTime" UnboundExpression="[EventDateTime]" ReadOnly="True" AllowEditing="False" x:Name="Col2" AllowSearchPanel="True" Tag="EventTime" FieldName="UnboundEventDateTime" Header="{x:Static properties:Resources.HistoricalEvents_EventTimeColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings Mask="T" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col3" AllowSearchPanel="True" Tag="EventUtcDate" FieldName="EventDateTimeUtc" Header="{x:Static properties:Resources.HistoricalEvents_EventDateUtcColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings Mask="d" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn UnboundType="DateTime" UnboundExpression="[EventDateTimeUtc]" ReadOnly="True" AllowEditing="False" x:Name="Col4" AllowSearchPanel="True" Tag="EventUtcTime" FieldName="UnboundEventDateTimeUtc" Header="{x:Static properties:Resources.HistoricalEvents_EventTimeUtcColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings Mask="T" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col5" AllowSearchPanel="True" FieldName="EventType" Header="{x:Static properties:Resources.HistoricalEvents_EventTypeColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col6" AllowSearchPanel="True" FieldName="SourceName" Header="{x:Static properties:Resources.HistoricalEvents_EventSourceNameColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col7" AllowSearchPanel="True" FieldName="EventMessage" Header="{x:Static properties:Resources.HistoricalEvents_EventMessageColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col8" AllowSearchPanel="True" FieldName="EventDetails" Header="{x:Static properties:Resources.HistoricalEvents_EventDetailsColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col9" AllowSearchPanel="True" FieldName="EventState" Header="{x:Static properties:Resources.HistoricalEvents_EventStateColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col10" AllowSearchPanel="True" FieldName="Severity" Header="{x:Static properties:Resources.HistoricalEvents_EventSeverityColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                        <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                        </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col11" AllowSearchPanel="True" FieldName="EventComment" Header="{x:Static properties:Resources.HistoricalEvents_EventCommentColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                        <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                        </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col12" AllowSearchPanel="True" FieldName="UserName" Header="{x:Static properties:Resources.HistoricalEvents_UserNameColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col13" AllowSearchPanel="True" FieldName="EventOccurence" Header="{x:Static properties:Resources.HistoricalEvents_EventOccurenceColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" x:Name="Col14" AllowSearchPanel="True" FieldName="EventSequence" Header="{x:Static properties:Resources.HistoricalEvents_EventSequenceColumnName}" MinWidth="10" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <!--ShowGroupPanel="{Binding ShowGroupPanel, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"-->
                        <dxg:TableView x:Name="tableView" ShowTotalSummary="True" AutoWidth="False"
                        ShowAutoFilterRow="True" AllowEditing="False" 
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        ShowGroupPanel="True"
                        ShowSearchPanelMode="Always" 
                        SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True" 
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row"
                        VerticalScrollbarVisibility="Auto"
                        HorizontalScrollbarVisibility="Auto">
                            <dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Setter Property="TextBlock.FontFamily" Value="{Binding EventAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontSize" Value="{Binding EventAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontWeight" Value="{Binding EventAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontStyle" Value="{Binding EventAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Style.Triggers>
                                        <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                            <Setter Property="Background" Value="LightGray" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TableView.RowStyle>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                </dxg:GridControl>

                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.RowSpan="3" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.HistoricalEvents_WaitText}" VerticalAlignment="Center" Grid.RowSpan="3"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
                <Border Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                BorderThickness="1" BorderBrush="Gray" Background="Black" 
                Visibility="{Binding ElementName=errorInfo, Path=Text, Converter={StaticResource ErrorInfoToVisibilityConverter}}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=gridDataControl1, Mode=OneWay}" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2" Text="{x:Static properties:Resources.HistoricalViewerError}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Foreground="Red" />
                        <Button Grid.Column="1" Margin="2" Width="24" HorizontalAlignment="Right" Click="errorInfo_ClearMessage">
                            <Button.Content>
                                <Image x:Name="acknowledgeImg" Source="{DynamicResource Acknowledge}" Height="14" Width="14" />
                            </Button.Content>
                        </Button>
                        <TextBlock x:Name="errorInfo" Grid.Row="1" Grid.ColumnSpan="2" 
                            Margin="2" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Text="" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
