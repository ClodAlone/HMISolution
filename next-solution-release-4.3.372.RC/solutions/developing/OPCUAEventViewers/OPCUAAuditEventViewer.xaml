<UserControl x:Class="OPCUAEventViewers.OPCUAAuditEventViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:OPCUAEventViewers.Properties" 
    Height="300" Width="500" 
    xmlns:cc="http://progea.com/CommonControls"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             DataContextChanged="UserControl_DataContextChanged">

    <Grid>
        <Grid.Resources>
            <!-- Resources scoped at the Application level should be defined here. -->
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/OPCUAEventViewers.xaml" />
                    <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Toolbar-->
        <dxb:BarContainerControl ContainerType="Top" Grid.Row="0" Visibility="Collapsed">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
              <dxb:BarButtonItem x:Name="OPUAEVCancl" Glyph="{StaticResource OPUAEVCancl}" GlyphSize="Custom" CustomGlyphSize="14,14" Command="{Binding Path=ClearAllCommand}"
                              ToolTip="{x:Static properties:Resources.ClearAllCommandHeader}"/>
                <dxb:BarItemSeparator />
              <dxb:BarButtonItem x:Name="OPUAEVPrint" Glyph="{StaticResource OPUAEVPrint}" GlyphSize="Custom" CustomGlyphSize="14,14" ItemClick="Print_Click"
                              ToolTip="{x:Static properties:Resources.PrintCommandHeader}"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <dxg:GridControl Grid.Row="1"  x:Name="gridAlarmList">
            <dxg:GridControl.Columns>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Source, Mode=OneWay}" Header="{x:Static properties:Resources.SourceColumnHeader}" ReadOnly="True" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Type, Mode=OneWay}" Width="0" Header="{x:Static properties:Resources.TypeColumnHeader}" ReadOnly="True" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Severity, Mode=OneWay}" Width="0" Header="{x:Static properties:Resources.SeverityColumnHeader}" ReadOnly="True" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Time, Mode=OneWay}" Header="{x:Static properties:Resources.TimeColumnHeader}" ReadOnly="True" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Message, Mode=OneWay}" Header="{x:Static properties:Resources.MessageColumnHeader}" ReadOnly="True" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Method, Mode=OneWay}" Header="{x:Static properties:Resources.MethodColumnHeader}" ReadOnly="True" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=InputArguments, Mode=OneWay}" Header="{x:Static properties:Resources.InputArgumentsColumnHeader}" ReadOnly="True" />
            </dxg:GridControl.Columns>
        </dxg:GridControl>

        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                            Margin="0" Grid.Row="1"  x:Name="IsBusyGrid">

            <DockPanel LastChildFill="True">

                <Label DockPanel.Dock="Top" Height="40" x:Name="busyContent"
                   FontSize="25" FontWeight="Bold" FontFamily="Arial Black" 
                       Margin="10,0,0,0" Visibility="Collapsed" 
                   Foreground="Black" VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch" Background="Transparent" 
                   Content="{x:Static properties:Resources.PleaseWait}" />


                <Viewbox HorizontalAlignment="Center"
                VerticalAlignment="Center">
                    <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed"/>
                </Viewbox>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
