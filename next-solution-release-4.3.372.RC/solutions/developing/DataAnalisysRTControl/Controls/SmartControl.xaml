<UserControl xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
             x:Class="DataAnalisysRTControl.Controls.SmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:DataAnalisysRTControl.Properties"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:smartutils="clr-namespace:SmartControlUtilities.Controls;assembly=SmartControlUtilities"
             xmlns:local="clr-namespace:DataAnalisysRTControl.Converters"
             xmlns:enums="clr-namespace:DataAnalisysRTControl"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             xmlns:datatemplate="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             mc:Ignorable="d" Height="640" Width="960">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:TypedListConverter x:Key="TypedListConverter" />
            <local:AggregatedTablesConverter x:Key="AggregatedTablesConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddButtonTitle}" Margin="0,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <Button IsEnabled="False" Grid.Column="1" x:Name="btnDelete"
                      ToolTip="{x:Static properties:Resources.DeleteButtonTitle}" Click="OnDelete" Margin="0,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <Button Click="OnExpand" Grid.Column="2" ToolTip="{x:Static properties:Resources.ExpandAllButtonTitle}" Margin="0,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource Expand}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <Button Grid.Column="3" ToolTip="{x:Static properties:Resources.CollapseAllButtonTitle}" Click="OnCollapse" Margin="0,5,0,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource Collapse}" Height="16" Width="16" />
            </Button.Content>
          </Button>
          <Button Click="OnMoveUp" Grid.Column="4"
                  ToolTip="{x:Static properties:Resources.MoveUp}" Margin="5,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource MoveUpSmall}" Height="16" Width="16" />
            </Button.Content>

          </Button>
          <Button Click="OnMoveDown" Grid.Column="5" 
                  ToolTip="{x:Static properties:Resources.MoveDown}" Margin="5,5,5,5">
            <Button.Content>
              <Image Margin="2" Source="{StaticResource MoveDownSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
        </Grid>
        <dxg:GridControl Grid.Row="1" Name="gridControl">
            <dxg:GridControl.Columns>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=color, Mode=TwoWay}" Header="{x:Static properties:Resources.Color}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <commoncontrols:CustomPopupColorEdit OnlySolidColors="True" Name="PART_Editor" Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" BrushSelected="OnBrushSelected" Color="{Binding RowData.Row.color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <!--<dxg:GridColumn DisplayMemberBinding="{Binding Path=title, Mode=TwoWay}" Header="{x:Static properties:Resources.Title}">-->
                <!--<dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings/>
                        </dxg:GridColumn.EditSettings>-->
                <dxg:GridColumn MinWidth="50" Header="{x:Static properties:Resources.Title}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <smartutils:PenNameSelector PropName="title" 
                                    OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn  Header="{x:Static properties:Resources.Dlrsource}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <CheckBox Click="CheckBox_Click" HorizontalAlignment="Center" IsChecked="{Binding Data.dlrsource, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn MinWidth="50" AllowDrop="False" AllowEditing="False" DisplayMemberBinding="{Binding Path=tagName, Mode=TwoWay}" Header="{x:Static properties:Resources.TagName}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <smartutils:TagSelector RuntimeVersion="False" ReferencedTag="tagReference" HistoricalPropName="historicalName" 
                                    ColumnPropName="tagName" DlrsourcePropName="dlrsource" TagName="tagName"
                                    NodeID="nodeID" SourceTimeStamp="sourcetimestampColumnName" OnlyHistoricalTags="False"                   
                                    OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn MinWidth="50" AllowDrop="False" AllowEditing="False" Header="{x:Static properties:Resources.TagConditionalName}">
                    <dxg:GridColumn.CellTemplate>
                      <DataTemplate>
                            <smartutils:TagSelector RuntimeVersion="False" ReferencedTag="conditionalTag"  OnlyHistoricalTags="False" HitTestVisiblePropName="dlrsource" 
                                                    UpdateRelatedProperties="False" OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                      </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
              </dxg:GridColumn>
              <dxg:GridColumn AllowDrop="False" AllowEditing="False" DisplayMemberBinding="{Binding Path=historicalName, Mode=TwoWay}" Header="{x:Static properties:Resources.HistoricalName}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" ToolTip="{Binding Data.historicalName}" Grid.Column="1" Grid.Row="1"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBox IsReadOnly="False" IsHitTestVisible="False" x:Name="historical" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                 ToolTip="{Binding Data.historicalName}" Text="{Binding Data.historicalName}" />
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=isVisible, Mode=TwoWay}" Header="{x:Static properties:Resources.VisibleTitle}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=showaxis, Mode=TwoWay}" Header="{x:Static properties:Resources.ShowAxisTitle}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=authomaticscale, Mode=TwoWay}" Header="{x:Static properties:Resources.AuthomaticScaleTitle}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=min, Mode=TwoWay}" Header="{x:Static properties:Resources.MinValTitle}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="g" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=max, Mode=TwoWay}" Header="{x:Static properties:Resources.MaxValTitle}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="g" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                    CellValueChanging="tableView_CellValueChanging" 
                    CellValueChanged="tableView_CellValueChanged" 
                    FocusedRowChanged="tableView_FocusedRowChanged" />
            </dxg:GridControl.View>
            <dxg:GridControl.DetailDescriptor>
                <dxg:DataControlDetailDescriptor ItemsSourcePath="." ItemsSourceValueConverter="{StaticResource TypedListConverter}" Margin="10">
                    <dxg:DataControlDetailDescriptor.DataControl>
                        <dxg:GridControl AutoGenerateColumns="None">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=usesourcetimestamp, Mode=TwoWay}" Header="{x:Static properties:Resources.SourceTimeStampTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=localizeSourceTimeStamp,Mode=TwoWay}" Header="{x:Static properties:Resources.LocalizeSourceTimeStampTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit Name="PART_Editor" 
                                                IsEnabled="{Binding RowData.Row.usesourcetimestamp}"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="tabAggregation" DisplayMemberBinding="{Binding Path=useTableAggregation, Mode=TwoWay}" Header="{x:Static properties:Resources.UseTableAggregation}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit Name="PART_Editor">
                                                <dxe:CheckEdit.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource AggregatedTablesConverter}">
                                                        <Binding Path="RowData.Row.dlrsource"/>
                                                        <Binding Path="RowData.Row.historicalName" />
                                                    </MultiBinding>
                                                </dxe:CheckEdit.IsEnabled>
                                            </dxe:CheckEdit>

                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="tabMinAggregation" DisplayMemberBinding="{Binding Path=minAggregation, Mode=TwoWay}" Header="{x:Static properties:Resources.ShowMinAggregation}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit Name="PART_Editor" 
                                                IsEnabled="{Binding RowData.Row.useTableAggregation}"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="tabAvgAggregation" DisplayMemberBinding="{Binding Path=avgAggregation, Mode=TwoWay}" Header="{x:Static properties:Resources.ShowAvgAggregation}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit Name="PART_Editor" 
                                                IsEnabled="{Binding RowData.Row.useTableAggregation}"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="tabMaxAggregation" DisplayMemberBinding="{Binding Path=maxAggregation, Mode=TwoWay}" Header="{x:Static properties:Resources.ShowMaxAggregation}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit Name="PART_Editor" 
                                                IsEnabled="{Binding RowData.Row.useTableAggregation}"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=isstatisticenabled, Mode=TwoWay}" Header="{x:Static properties:Resources.StatisticsLineTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit Name="PART_Editor" 
                                                IsEnabled="{Binding RowData.Row.useTableAggregation,Converter={StaticResource InverseBooleanConverter}}"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=logarithmicYScale, Mode=TwoWay}" Header="{x:Static properties:Resources.LogarithmicYScaleTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=logarithmicbaseYScale, Mode=TwoWay}" Header="{x:Static properties:Resources.LogarithmicBaseYScaleTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="useEUMinMaxColumn" DisplayMemberBinding="{Binding Path=useeuminmax, Mode=TwoWay}" Header="{x:Static properties:Resources.UseEUMinMaxTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="addVirtualPointsColumn" DisplayMemberBinding="{Binding Path=addVirtualPoints, Mode=TwoWay}" Header="{x:Static properties:Resources.AddVirtualPointsTitle}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn 
                                  IsEnabled="{Binding RowData.Row.useTableAggregation,Converter={StaticResource InverseBooleanConverter}}"
                                  DisplayMemberBinding="{Binding Path=serieType, Mode=TwoWay}" Header="{x:Static properties:Resources.LineType}">
                                        <dxg:GridColumn.EditSettings>  
                                            <dxe:ComboBoxEditSettings 
                                                  HorizontalContentAlignment="Left"  
                                                  IsTextEditable="False"
                                                  AllowNullInput="False" 
                                                  AcceptsReturn="False"
                                                  AutoComplete="False" 
                                                  ImmediatePopup="True"
                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type enums:LineType}}"> 
                                            </dxe:ComboBoxEditSettings>  
                                        </dxg:GridColumn.EditSettings>  
                                </dxg:GridColumn>
                                <dxg:GridColumn MinWidth="100" DisplayMemberBinding="{Binding Path=penUnitConverter, Mode=TwoWay}"  Header="{x:Static properties:Resources.UnitConverter}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <datatemplate:IdUnitConverterPropertyEditor BindingPath="{Binding Path=penUnitConverter, Mode=TwoWay}"  
                                                Workspace="{Binding Workspace, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn x:Name="arrayIndex" DisplayMemberBinding="{Binding Path=arrayindex, Mode=TwoWay}" Header="{x:Static properties:Resources.ArrayIndex}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=thickness, Mode=TwoWay}" Header="{x:Static properties:Resources.Thickness}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn DisplayMemberBinding="{Binding Path=pointPrecision, Mode=TwoWay}" Header="{x:Static properties:Resources.PointPrecision}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView 
                                    CellValueChanging="tableView_CellValueChanging" 
                                    CellValueChanged="tableView_CellValueChanged" 
                                    FocusedRowChanged="tableView_FocusedRowChanged" 
                                    AllowHorizontalScrollingVirtualization="False"/>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxg:DataControlDetailDescriptor.DataControl>
                </dxg:DataControlDetailDescriptor>
            </dxg:GridControl.DetailDescriptor>
        </dxg:GridControl>
    </Grid>
</UserControl>
