<UserControl x:Class="PropertyControl.PropertyDataTemplate.DateTimePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <dxe:DateEdit x:Name="dateTime"
                    Validation.ErrorTemplate="{x:Null}"  
                    MaskType="DateTime"
                    EditValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    MaskUseAsDisplayFormat="True"
                    ShowClearButton="False"
                    ShowToday="True"
                    Mask="G"
                    ShowWeekNumbers="True"/>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=dateTime, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
