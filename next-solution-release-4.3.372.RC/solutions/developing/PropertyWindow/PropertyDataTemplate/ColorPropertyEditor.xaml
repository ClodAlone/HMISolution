<UserControl x:Class="PropertyControl.PropertyDataTemplate.ColorPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:commoncontrols="http://progea.com/CommonControls"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <Grid>
        <commoncontrols:CustomPopupColorEdit x:Name="popupColorEdit"
            Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" 
            OnlySolidColors="True" Color="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
