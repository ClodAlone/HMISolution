<UserControl x:Class="TrendRealTimeSlim.RealTimeTrendControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:localconverters="clr-namespace:TrendRealTimeSlim.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:TrendRealTimeSlim.Properties"
	           xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/TrendRealTimeSlim.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ConditionalStyleConverter x:Key="ConditionalStyleConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertedVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:MeasureUnitConverter x:Key="MeasureUnitConverter" />
            <localconverters:OperatingModeToVisibilityConverter x:Key="OperatingModeToVisibilityConverter" />
            <localconverters:OrientationToAngleConverter x:Key="OrientationToAngleConverter" />
            <localconverters:DoublePrecisionConverter x:Key="DoublePrecisionConverter" />
            <Style TargetType="{x:Type Button}" x:Key="ButtonRowCommandStyle">
            </Style>
            <Style TargetType="{x:Type RepeatButton}" x:Key="RepeatButtonFetch" />
            <Style TargetType="{x:Type Button}" x:Key="ButtonFetch" />
            <DataTemplate x:Key="Data">
                <Grid>
                    <StackPanel>
                        <dxe:ImageEdit IsPrintingMode="True" Source="{Binding Content}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="AxisTitleTemplate">
                <TextBlock Text="{Binding}" RenderTransformOrigin="0.5, 0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </DataTemplate>

            <dxc:PointSeries2D ArgumentScaleType="DateTime" x:Key="seriesScatterStyle" x:Shared="False"
                                                  ArgumentDataMember="SourceTimestamp"
                                                  ValueDataMember="dValueConverted"
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:PointSeries2D.MarkerModel>
              <dxc:PolygonMarker2DModel/>
            </dxc:PointSeries2D.MarkerModel>
            <dxc:PointSeries2D.Label>
              <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
            </dxc:PointSeries2D.Label>
            <dxc:PointSeries2D.PointOptions>
              <dxc:PointOptions>
                <dxc:PointOptions.ValueNumericOptions>
                  <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                </dxc:PointOptions.ValueNumericOptions>
              </dxc:PointOptions>
            </dxc:PointSeries2D.PointOptions>
          </dxc:PointSeries2D>
          
            <dxc:LineSeries2D ArgumentScaleType="DateTime" x:Key="seriesLineStyle" x:Shared="False"
                                                  ArgumentDataMember="SourceTimestamp"
                                                  ValueDataMember="dValueConverted"
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:LineSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:LineSeries2D.Label>
                <dxc:LineSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:LineSeries2D.PointOptions>
            </dxc:LineSeries2D>

            <dxc:LineStepSeries2D ArgumentScaleType="DateTime" x:Key="seriesStepLineStyle" x:Shared="False"
                                                  ArgumentDataMember="SourceTimestamp" 
                                                  ValueDataMember="dValueConverted" 
                                                  AnimationAutoStartMode="PlayOnce" MarkerSize="5">
                <dxc:LineStepSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:LineStepSeries2D.Label>
                <dxc:LineStepSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:LineStepSeries2D.PointOptions>
            </dxc:LineStepSeries2D>

            <dxc:AreaSeries2D ArgumentScaleType="DateTime" x:Key="seriesAreaStyle" x:Shared="False"
                              Transparency="0.5" ArgumentDataMember="SourceTimestamp" 
                                                  ValueDataMember="dValueConverted" MarkerSize="5">
                <dxc:AreaSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:AreaSeries2D.Label>
                <dxc:AreaSeries2D.PointOptions>
                    <dxc:PointOptions>
                        <dxc:PointOptions.ValueNumericOptions>
                            <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                        </dxc:PointOptions.ValueNumericOptions>
                    </dxc:PointOptions>
                </dxc:AreaSeries2D.PointOptions>
            </dxc:AreaSeries2D>

            <dxc:BarSideBySideSeries2D ArgumentScaleType="DateTime" x:Key="seriesColumnStyle" x:Shared="False"
                                                  ArgumentDataMember="SourceTimestamp" BarWidth="5"
                                                  ValueDataMember="dValueConverted"
                                                  AnimationAutoStartMode="PlayOnce">
                <dxc:BarSideBySideSeries2D.Label>
                    <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                </dxc:BarSideBySideSeries2D.Label>
            </dxc:BarSideBySideSeries2D>


            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="{Binding DefToolbarHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="toolbar">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="5" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <dxc:SecondaryAxisY2D x:Key="secondaryaxisY" x:Shared="False"
                        Logarithmic="False" Alignment="Near"
                        LogarithmicBase="10.0"
                        GridLinesVisible="False" GridLinesMinorVisible="False">
                <dxc:AxisY2D.NumericScaleOptions>
                    <dxc:ContinuousNumericScaleOptions AutoGrid="{Binding YAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                </dxc:AxisY2D.NumericScaleOptions>
                <dxc:SecondaryAxisY2D.CrosshairAxisLabelOptions>
                    <dxc:CrosshairAxisLabelOptions Pattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                </dxc:SecondaryAxisY2D.CrosshairAxisLabelOptions>
                <dxc:SecondaryAxisY2D.WholeRange>
                    <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" AutoSideMargins="False" SideMarginsValue="0" />
                </dxc:SecondaryAxisY2D.WholeRange>
                <dxc:SecondaryAxisY2D.Label>
                    <dxc:AxisLabel 
                      Angle="{Binding TrendOrientation, ConverterParameter=1,Converter={StaticResource OrientationToAngleConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                      TextPattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                        <dxc:SecondaryAxisY2D.ResolveOverlappingOptions>
                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                    AllowRotate="True"
                                    AllowStagger="True"
                                    MinIndent="5" />
                        </dxc:SecondaryAxisY2D.ResolveOverlappingOptions>
                    </dxc:AxisLabel>
                </dxc:SecondaryAxisY2D.Label>
            </dxc:SecondaryAxisY2D>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grid">

        <Grid x:Name="maybeLayoutManagerGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <AdornerDecorator Grid.Row="1" x:Name="adorner" Grid.ColumnSpan="10" Grid.RowSpan="10">
            <dxd:DockLayoutManager x:Name="dockManager" DockItemHidden="OnDockItemHidden" ClosedPanelsBarVisibility="Auto">

                <dxd:LayoutGroup x:Name="groupGeneral">

                    <dxd:LayoutPanel ShowCaption="False" Caption="{x:Static properties:Resources.ChartTitle}" x:Name="chartPanel">
                        <Grid x:Name="mainChartGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="9*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <dxc:ChartControl Name="sfchart" BorderThickness="0" EnableAnimation="False" 
                          CrosshairEnabled="{Binding IsInStop, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                          PreviewKeyDown="chart_PreviewKeyDown" 
                          CustomDrawSeries="chart_CustomDrawSeries"
                          CustomDrawCrosshair="chart_CustomDrawCrosshair"
                          PreviewMouseDown="chart_MouseDown"
                          PreviewMouseUp="chart_MouseUp"
                          BoundDataChanged="chart_BoundDataChanged"
                          PreviewMouseWheel="chart_PreviewMouseWheel">

                              <dxc:ChartControl.LayoutTransform>
                                <RotateTransform Angle="{Binding TrendOrientation,Converter={StaticResource OrientationToAngleConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                              </dxc:ChartControl.LayoutTransform>
                                <dxc:ChartControl.IsManipulationEnabled>True</dxc:ChartControl.IsManipulationEnabled>
                                <dxc:ChartControl.CrosshairOptions>
                                    <dxc:CrosshairOptions ShowArgumentLine="True" ShowValueLine="True" x:Name="crosshair"
                                                      ShowArgumentLabels="True" ShowValueLabels="True"
                                                      ShowCrosshairLabels="True"
                                                      CrosshairLabelMode="ShowForNearestSeries" />
                                </dxc:ChartControl.CrosshairOptions>
                                <dxc:ChartControl.Diagram>
                                        <dxc:XYDiagram2D Name="diagram" AllowSeriesBitmapCaching="False" Rotated="{Binding Rotated, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                           Zoom="diagram_Zoom" MouseWheel="diagram_MouseWheel" EnableAxisXNavigation="True" EnableAxisYNavigation="True">
                                        <dxc:XYDiagram2D.DefaultPane>
                                                <dxc:Pane x:Name="pane" Grid.Row="0">
                                                <dxc:Pane.AxisYScrollBarOptions>
                                                    <dxc:ScrollBarOptions Alignment="Far"
                                                              Visible="True" />
                                                </dxc:Pane.AxisYScrollBarOptions>
                                                <dxc:Pane.AxisXScrollBarOptions>
                                                    <dxc:ScrollBarOptions Alignment="Near" 
                                                              Visible="True" />
                                                </dxc:Pane.AxisXScrollBarOptions>
                                            </dxc:Pane>
                                        </dxc:XYDiagram2D.DefaultPane>

                                        <dxc:XYDiagram2D.AxisY>
                                            <dxc:AxisY2D Name="axisY" Visible="False"
                                                     Brush="{Binding AxisStroke, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                     Logarithmic="{Binding LogarithmicYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                     LogarithmicBase="{Binding LogarithmicBaseYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                     GridLinesVisible="{Binding YGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                     GridLinesMinorVisible="{Binding YMinorGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                <dxc:AxisY2D.NumericScaleOptions>
                                                    <dxc:ContinuousNumericScaleOptions x:Name="numericalScaleOptions" AutoGrid="True" />
                                                </dxc:AxisY2D.NumericScaleOptions>
                                                <dxc:AxisY2D.CrosshairAxisLabelOptions>
                                                    <dxc:CrosshairAxisLabelOptions Pattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                                </dxc:AxisY2D.CrosshairAxisLabelOptions>
                                                <dxc:AxisY2D.WholeRange>
                                                    <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" AutoSideMargins="False" SideMarginsValue="0" />
                                                </dxc:AxisY2D.WholeRange>
                                                <dxc:AxisY2D.Label>
                                                    <dxc:AxisLabel Angle="{Binding TrendOrientation, ConverterParameter=1,Converter={StaticResource OrientationToAngleConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                      TextPattern="{Binding AxisYTextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                                                                    AllowRotate="True"
                                                                                    AllowStagger="True"
                                                                                    MinIndent="5" />
                                                        </dxc:Axis2D.ResolveOverlappingOptions>
                                                    </dxc:AxisLabel>
                                                </dxc:AxisY2D.Label>
                                            </dxc:AxisY2D>
                                        </dxc:XYDiagram2D.AxisY>
                                        <dxc:XYDiagram2D.SecondaryAxesY>
                                        </dxc:XYDiagram2D.SecondaryAxesY>
                                        <dxc:XYDiagram2D.AxisX>
                                            <dxc:AxisX2D Name="axisX" 
                                                     Brush="{Binding AxisStroke, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                                     GridLinesVisible="{Binding XGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                     GridLinesMinorVisible="{Binding XMinorGridLineVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                <dxc:AxisX2D.DateTimeScaleOptions>
                                                    <dxc:ContinuousDateTimeScaleOptions AutoGrid="{Binding XAutoGrid, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                                </dxc:AxisX2D.DateTimeScaleOptions>
                                                <dxc:AxisX2D.WholeRange>
                                                    <dxc:Range AutoSideMargins="False" SideMarginsValue="0" />
                                                </dxc:AxisX2D.WholeRange>
                                                <dxc:AxisX2D.CrosshairLabelTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Background}" Padding="5,1">
                                                            <TextBlock Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}" FontStretch="{Binding FontStretch}" FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}" Text="{Binding Text}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </dxc:AxisX2D.CrosshairLabelTemplate>
                                                <dxc:AxisX2D.CrosshairAxisLabelOptions>
                                                    <dxc:CrosshairAxisLabelOptions Pattern=" {A:G}" />
                                                </dxc:AxisX2D.CrosshairAxisLabelOptions>
                                                <dxc:AxisX2D.Label>
                                                    <dxc:AxisLabel Angle="{Binding TrendOrientation, ConverterParameter=1, Converter={StaticResource OrientationToAngleConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True"
                                                                                    AllowRotate="False"
                                                                                    AllowStagger="False"
                                                                                    MinIndent="5" />
                                                        </dxc:Axis2D.ResolveOverlappingOptions>
                                                    </dxc:AxisLabel>
                                                </dxc:AxisX2D.Label>
                                            </dxc:AxisX2D>
                                        </dxc:XYDiagram2D.AxisX>
                                            <dxc:XYDiagram2D.Series>
                                                <dxc:AreaSeries2D ArgumentScaleType="DateTime" x:Name="dataContextSerie" DisplayName="DataContextSerie" Visible="False"
                                                  Transparency="0.5" ArgumentDataMember="SourceTimestamp" Brush="DodgerBlue" ValueScaleType="Numerical"
                                                  ValueDataMember="dValueConverted" CrosshairLabelPattern="{Binding TextPattern, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" MarkerSize="5">
                                                    <dxc:AreaSeries2D.Border>
                                                        <dxc:SeriesBorder Brush="DodgerBlue">
                                                            <dxc:SeriesBorder.LineStyle>
                                                                <dxc:LineStyle Thickness="1"/>
                                                            </dxc:SeriesBorder.LineStyle>
                                                        </dxc:SeriesBorder>
                                                    </dxc:AreaSeries2D.Border>
                                                    <dxc:AreaSeries2D.Label>
                                                        <dxc:SeriesLabel Visible="False" ResolveOverlappingMode="Default" />
                                                    </dxc:AreaSeries2D.Label>
                                                    <dxc:AreaSeries2D.PointOptions>
                                                        <dxc:PointOptions>
                                                            <dxc:PointOptions.ValueNumericOptions>
                                                                <dxc:NumericOptions Format="FixedPoint" Precision="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                                            </dxc:PointOptions.ValueNumericOptions>
                                                        </dxc:PointOptions>
                                                    </dxc:AreaSeries2D.PointOptions>
                                                </dxc:AreaSeries2D>
                                            </dxc:XYDiagram2D.Series>
                                    </dxc:XYDiagram2D>
                                </dxc:ChartControl.Diagram>
                            </dxc:ChartControl>
                            <Grid x:Name="trendButtonsGrid" Margin="0,10,0,0" Grid.ZIndex="99" Grid.Row="1" Visibility="{Binding RuntimeMode, Converter={StaticResource OperatingModeToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                              <!-- BUTTONS -->
                              <Button x:Name="btnGoToStart" Click="GoToStart" MinHeight="5" MinWidth="5" Grid.Column="0" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.GoStart}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSendprev}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnGoToPrevTwo" Click="GoToPrevPrev" MinHeight="5" MinWidth="5" Grid.Column="1" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.GoPrevTwo}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSprevprev}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnGoToPrev" Click="GoToPrev" MinHeight="5" MinWidth="5" Grid.Column="2" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.GoPrev}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSprev}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnPlay" Grid.Column="3" Click="Play" MinHeight="5" MinWidth="5" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.Play}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSplay}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnPause" Grid.Column="4" Click="Pause" MinHeight="5" MinWidth="5" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              Width="{Binding ElementName=prev, Path=Width}"
                              ToolTip="{x:Static properties:Resources.Pause}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSstop}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnGoToNext" Click="GoToNext" MinHeight="5" MinWidth="5" Grid.Column="5" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.GoNext}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSnext}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnGoToNextTwo" Click="GoToNextNext" MinHeight="5" MinWidth="5" Grid.Column="6" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.GoNextTwo}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSnextnext}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="btnGoToEnd" Click="GoToEnd" MinHeight="5" MinWidth="5" Grid.Column="7" Style="{StaticResource ButtonFetch}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1"
                              ToolTip="{x:Static properties:Resources.GoEnd}"
                              IsEnabled="{Binding IsInStop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                                <StackPanel Background="Transparent">
                                  <Image Source="{DynamicResource TRTSendnext}" Width="16" Height="16" />
                                </StackPanel>
                              </Button>
                            </Grid>
                        </Grid>
                    </dxd:LayoutPanel>

                </dxd:LayoutGroup>
                <dxd:DockLayoutManager.AutoHideGroups>
                    <dxd:AutoHideGroup DockType="Bottom" AutoHideSize="200,200" x:Name="autoHideBottom">
                        <dxd:LayoutPanel ShowCaption="True" Caption="{x:Static properties:Resources.LegendTitle}" x:Name="legendPanel" Visibility="{Binding AutoHidePanelsVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                            <!--<ScrollViewer x:Name="legendScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Row="1">-->
                                <Grid x:Name="legendInnerPanel" Grid.Row="1" Visibility="{Binding AutoHidePanelsVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <dxg:GridControl  Grid.Row="1" MouseDown="lengedGrid_MouseDown" x:Name="legend_GridControl"
                                     MinHeight="10" MinWidth="10" Visibility="Visible" 
                                     Tag="DataSourceStyle" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     AllowLiveDataShaping="False">
                                        <dxg:GridControl.Resources>
                                            <ControlTemplate x:Key="borderTemplate" TargetType="{x:Type ContentControl}">
                                                <Border BorderThickness="0" CornerRadius="0" 
                                                      Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:TextEdit}}}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                            <Style BasedOn="{StaticResource {dxet:TextEditThemeKey ResourceKey=TextStyle}}" TargetType="{x:Type TextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LegendAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding LegendAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}" >
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LegendAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding LegendAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </dxg:GridControl.Resources>
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn Tag="Visible" x:Name="visibleTitle" Header="{x:Static properties:Resources.VisibleTitle}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Data.IsVisible}" />
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="LColor" x:Name="colorTitle" Header="{x:Static properties:Resources.ColorTitle}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Fill="{Binding Data.RealColor}" Width="10" Height="10" />
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="DName" x:Name="nameTitle" Header="{x:Static properties:Resources.NameTitle}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Text="{Binding Data.DName}" Grid.Column="1" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="EUnit" x:Name="eUnitTitle" Header="{x:Static properties:Resources.EUnit}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="eUnitText" FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource MeasureUnitConverter}">
                                                                        <Binding Path="Data.EUnit" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                        <Binding Path="Data.UnitConverterLabel" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="DValue" x:Name="dValueTitle" Header="{x:Static properties:Resources.DValue}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="liveValueText" FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource DoublePrecisionConverter}">
                                                                        <Binding Path="Data.DValueValue" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                        <Binding Path="PointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource Mode=FindAncestor,AncestorType=UserControl}" />
                                                                        <Binding Path="Data.pointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="LastClickedPointDate" x:Name="pointDateTitle" Header="{x:Static properties:Resources.PointDate}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Text="{Binding Data.LastClickedPoint.Date, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Grid.Column="1" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="LastClickedPointValue" x:Name="pointValueTitle" Header="{x:Static properties:Resources.PointValue}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource DoublePrecisionConverter}">
                                                                        <Binding Path="Data.LastClickedPoint.Value" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                        <Binding Path="PointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource Mode=FindAncestor,AncestorType=UserControl}" />
                                                                        <Binding Path="Data.pointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="MinValue" x:Name="statMinTitle" Header="{x:Static properties:Resources.StatisticMin}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource DoublePrecisionConverter}">
                                                                    <Binding Path="Data.minValue" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                    <Binding Path="PointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource Mode=FindAncestor,AncestorType=UserControl}" />
                                                                    <Binding Path="Data.pointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="MaxValue" x:Name="statMaxTitle" Header="{x:Static properties:Resources.StatisticMax}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource DoublePrecisionConverter}">
                                                                    <Binding Path="Data.maxValue" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                    <Binding Path="PointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource Mode=FindAncestor,AncestorType=UserControl}" />
                                                                    <Binding Path="Data.pointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Tag="AvgValue" x:Name="avgTitle" Header="{x:Static properties:Resources.Average}" ReadOnly="True" AllowEditing="False" AllowAutoFilter="False" AllowColumnFiltering="False" AllowSorting="False" AllowSearchPanel="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="{Binding ElementName=legend_GridControl, Path=FontSize}" Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource DoublePrecisionConverter}">
                                                                    <Binding Path="Data.averageValue" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                    <Binding Path="PointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource Mode=FindAncestor,AncestorType=UserControl}" />
                                                                    <Binding Path="Data.pointPrecision" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <dxg:TableView HorizontalScrollbarVisibility="Auto" VerticalScrollbarVisibility="Auto" 
                                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                IsSynchronizedWithCurrentItem="True" FocusedRowChanged="legendListBox_SelectionChanged" AllowMoveColumnToDropArea="{Binding AllowRuntimeChanges, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" AllowGrouping="False" ShowGroupPanel="False" AllowFilterEditor="False" ShowAutoFilterRow="False" ShowSearchPanelMode="Never" AllowColumnFiltering="False" AllowSorting="False" NavigationStyle="Row">

                                                <dxg:TableView.ColumnHeaderContentStyle>
                                                    <Style TargetType="{x:Type ContentControl}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LegendAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding LegendAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                        <Setter Property="FontFamily" Value="{Binding FontFamily, Mode=OneWay, ElementName=legend_GridControl}" />
                                                        <Setter Property="FontSize" Value="{Binding FontSize, Mode=OneWay, ElementName=legend_GridControl}" />
                                                        <Setter Property="FontWeight" Value="{Binding FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                        <Setter Property="FontStyle" Value="{Binding FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                                    </Style>
                                                </dxg:TableView.ColumnHeaderContentStyle>
                                            </dxg:TableView>
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </Grid>
                            <!--</ScrollViewer>-->
                        </dxd:LayoutPanel>

                    </dxd:AutoHideGroup>

                    <dxd:AutoHideGroup DockType="Right" AutoHideSize="200,200" x:Name="autoHideRight">
                        <dxd:LayoutPanel ShowCaption="True" Caption="{x:Static properties:Resources.GridTitle}" x:Name="gridPanel" Visibility="{Binding AutoHidePanelsVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">

                            <Grid x:Name="printGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <dxb:ToolBarControl x:Name="toolbarPrintSettings" IsMultiLine="False" ShowDragWidget="False" UseWholeRow="True" AllowCustomizationMenu="False" AllowQuickCustomization="False">
                                    <dxb:BarButtonItem x:Name="btnPrintGrid" Glyph="{DynamicResource Print}" ToolTip="{x:Static properties:Resources.PrintTitle}"
                                        ItemClick="PrintGrid_Click" ToolTipService.ShowOnDisabled="True" GlyphSize="Custom" CustomGlyphSize="16,16" />
                                </dxb:ToolBarControl>

                                <DockPanel Grid.Row="1" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                        <TextBlock x:Name="gridTagName" Grid.Column="0" Text="{x:Static properties:Resources.GridTagName}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="0" x:Name="tagName" Text="" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid>
                                        <dxg:GridControl Grid.Row="1" Name="gridControl">
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn Tag="PenName" DisplayMemberBinding="{Binding Path=PenName, Mode=OneWay}" Header="{x:Static properties:Resources.PenBaseName}" />
                                                <dxg:GridColumn Tag="SourceTimeStamp" DisplayMemberBinding="{Binding Path=SourceTimeStamp, Mode=OneWay}" Header="{x:Static properties:Resources.TimeTitle}">
                                                    <dxg:GridColumn.EditSettings>
                                                        <!--<dxe:TextEditSettings Mask="dd/MM/yyyy h:m:s t" MaskType="DateTime" MaskUseAsDisplayFormat="True"/>-->
                                                        <dxe:TextEditSettings DisplayFormat="" MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" />
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                    <dxg:GridColumn Tag="Value" Header="{x:Static properties:Resources.ValueTitle}">
                                                        <dxg:GridColumn.DisplayMemberBinding>
                                                            <MultiBinding Converter="{StaticResource DoublePrecisionConverter}">
                                                                <Binding Path="Data.dValueConverted" />
                                                                <Binding Path="View.DataContext" />
                                                                <Binding Path="Data.pointPrecision"/>
                                                            </MultiBinding>
                                                        </dxg:GridColumn.DisplayMemberBinding>
                                                    </dxg:GridColumn>
                                                </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TableView Name="tableView" ShowTotalSummary="True" DataContext="{Binding PointPrecision, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" />
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                        </Grid>
                                </DockPanel>

                            </Grid>

                        </dxd:LayoutPanel>
                    </dxd:AutoHideGroup>

                </dxd:DockLayoutManager.AutoHideGroups>

            </dxd:DockLayoutManager>
            </AdornerDecorator>

            <dxb:BarContainerControl Grid.Row="0" DockPanel.Dock="Top" x:Name="toolbar" ContainerType="Top">
                <dxb:ToolBarControl IsMultiLine="False" ShowDragWidget="False" dxb:MergingProperties.Name="mainDARTToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False"
                                AllowCustomizationMenu="False" AllowQuickCustomization="False" UseWholeRow="True">
                    <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                      <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                      <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                      UseLightweightTemplates="False" EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                        <dxb:BarEditItem.EditTemplate>
                          <DataTemplate>
                            <dxe:ComboBoxEdit
                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                            Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                          </DataTemplate>
                        </dxb:BarEditItem.EditTemplate>
                      </dxb:BarEditItem>
                        <dxb:BarButtonItem x:Name="clearSmall" Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}">
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem x:Name="editGeneralSmall" Glyph="{DynamicResource EditGeneralSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding EditCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}">
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem x:Name="saveSmall" Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}">
                        </dxb:BarButtonItem>
                        <dxb:BarButtonItem x:Name="cancelSmall" Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}">
                        </dxb:BarButtonItem>

                    </dxb:BarLinkContainerItem>

                    <dxb:BarLinkContainerItem x:Name="toolbarShowHideButtons" IsVisible="{Binding ShowToolbarShowHideButtons, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                        <dxb:BarCheckItem GlyphSize="Custom" CustomGlyphSize="16,16" IsChecked="True" Glyph="{DynamicResource Cross}"
                              ItemClick="ShowCrossHair_Click" x:Name="btnShowCrossHair" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.CrossHairTitle}" />
                        <dxb:BarCheckItem GlyphSize="Custom" CustomGlyphSize="16,16" Glyph="{DynamicResource Expand}"
                              ItemClick="ExpandCollapse_Click" x:Name="btnExpand" 
                                          IsVisible="{Binding DockManagerAllowed, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                          ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ExpandTitle}"/>
                      <dxb:BarButtonItem Glyph="{DynamicResource Print}" GlyphSize="Custom" CustomGlyphSize="16,16"
                      ItemClick="Print_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.PrintTitle}" x:Name="btnPrint"/>
                    </dxb:BarLinkContainerItem>
                </dxb:ToolBarControl>
            </dxb:BarContainerControl>

            <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="10" Grid.RowSpan="10" />
            <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="errorContent" Text="{Binding GeneralError, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" >
            <TextBlock.Resources>
                <Storyboard x:Key="blink" RepeatBehavior="3x">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="errorContent">
                        <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                        <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                        <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </TextBlock.Resources>
        </TextBlock>
        </Grid>
    </Grid>
</UserControl>
