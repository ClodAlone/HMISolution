                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarButtonItem Glyph="{StaticResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall" Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}" />
                        <dxb:BarButtonItem Glyph="{StaticResource EditGeneralSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="editGeneralSmall"
                            Command="{Binding EditCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.EditSettings}" />
                        <dxb:BarButtonItem Glyph="{StaticResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmall"
                            Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}" />
                        <dxb:BarButtonItem Glyph="{StaticResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall"
                            Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />
                    </dxb:BarLinkContainerItem>
                    <dxb:BarLinkContainerItem x:Name="toolbarSettings1">
                        <dxb:BarCheckItem Glyph="{StaticResource Cross}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              IsChecked="True" ItemClick="ShowCrossHair_Click" x:Name="btnShowCrossHair" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.CrossHairTitle}">
                        </dxb:BarCheckItem>
                        <dxb:BarCheckItem Glyph="{StaticResource Expand}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ItemClick="ExpandCollapse_Click" x:Name="btnExpand" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ExpandTitle}">
                        </dxb:BarCheckItem>
                        <dxb:BarCheckItem Glyph="{StaticResource Statistics}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              IsChecked="{Binding ShowStatisticLines, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                              x:Name="chkShowStatistics" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.StatisticsTitle}">
                        </dxb:BarCheckItem>
                        <dxb:BarCheckItem Glyph="{StaticResource Tag}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ItemClick="ShowLabels_Click" IsChecked="False" x:Name="btnShowLabels" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.LabelTitle}">
                        </dxb:BarCheckItem>
                        <dxb:BarButtonItem Glyph="{StaticResource Previous}" GlyphSize="Custom" CustomGlyphSize="16,16" ItemClick="Prev_Click" x:Name="btnPrev" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.PrevTitle}">
                        </dxb:BarButtonItem>
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="cmbTimeRange">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False">
                                    <dxe:ComboBoxEditSettings.Items>
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Minute}" Tag="{x:Static utilities:DateSpan.Minute}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Hour}" Tag="{x:Static utilities:DateSpan.Hour}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Day}" Tag="{x:Static utilities:DateSpan.Day}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Week}" Tag="{x:Static utilities:DateSpan.Week}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Month}" Tag="{x:Static utilities:DateSpan.Month}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Year}" Tag="{x:Static utilities:DateSpan.Year}" />
                                    </dxe:ComboBoxEditSettings.Items>
                                </dxe:ComboBoxEditSettings>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarButtonItem Glyph="{StaticResource Next}" GlyphSize="Custom" CustomGlyphSize="16,16" ItemClick="Next_Click" x:Name="btnNext" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.NextTitle}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarCheckItem GlyphSize="Custom" CustomGlyphSize="16,16" 
                              IsChecked="{Binding UseAbsoluteRanges, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Glyph="{StaticResource DARUseAbsoluteRanges}"
                              x:Name="chkUseAbsoluteRanges" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.UseAbsoluteRangesTitle}" />
                        <dxb:BarCheckItem GlyphSize="Custom" CustomGlyphSize="16,16" 
                              IsChecked="{Binding UseAggregation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Glyph="{StaticResource Group}"
                              x:Name="chkUseAggregationTitle" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.UseAggregationTitle}" />
                        <dxb:BarButtonItem GlyphSize="Custom" CustomGlyphSize="16,16" Glyph="{StaticResource Print}"
                              ItemClick="Print_Click" x:Name="btnPrint" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.PrintTitle}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarButtonItem Glyph="{StaticResource ReloadSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="btnRefresh" ItemClick="Refresh_Click" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.RefreshTitle}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarCheckItem x:Name="btnAll" Glyph="{StaticResource All}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.AllTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.All}}" />
                        <dxb:BarCheckItem x:Name="btnMin" Glyph="{StaticResource Minute}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.MinTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.Minute}}" />
                        <dxb:BarCheckItem x:Name="btnHour" Glyph="{StaticResource Hour}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.HourTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.Hour}}" />
                        <dxb:BarCheckItem x:Name="btnDay" Glyph="{StaticResource Day}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DayTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.Day}}" />
                        <dxb:BarCheckItem x:Name="btnWeek" Glyph="{StaticResource Week}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.WeekTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.Week}}" />
                        <dxb:BarCheckItem x:Name="btnMonth" Glyph="{StaticResource Month}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.MonthTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.Month}}" />
                        <dxb:BarCheckItem x:Name="btnYear" Glyph="{StaticResource Year}" GlyphSize="Custom" CustomGlyphSize="16,16" 
                              ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.YearTitle}"
                                   IsChecked="{Binding FilterType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, Converter={StaticResource FilterTypeToBooleanConverter}, ConverterParameter={x:Static utilities:DateSpan.Year}}" />
                        <dxb:BarItemSeparator />
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="maxRecord" Content="{x:Static properties:Resources.MaxRecordTitle}" EditValue="{Binding MaxRecords,Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:SpinEditSettings ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.MaxRecordTitle}" MinValue="1" MaxValue="1000000" />
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarItemSeparator />

                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="cmbCompare" IsEnabled="False" Content="{x:Static properties:Resources.CompareTitle}" EditValueChanged="cmbCompare_SelectionChanged">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="False">
                                    <dxe:ComboBoxEditSettings.Items>
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.None}" Tag="{x:Static utilities:DateSpan.None}" IsSelected="True" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Minute}" Tag="{x:Static utilities:DateSpan.Minute}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Hour}" Tag="{x:Static utilities:DateSpan.Hour}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Day}" Tag="{x:Static utilities:DateSpan.Day}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Week}" Tag="{x:Static utilities:DateSpan.Week}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Month}" Tag="{x:Static utilities:DateSpan.Month}" />
                                        <dxe:ComboBoxEditItem Content="{x:Static properties:Resources.Year}" Tag="{x:Static utilities:DateSpan.Year}" />
                                    </dxe:ComboBoxEditSettings.Items>
                                </dxe:ComboBoxEditSettings>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="startTextTitle" EditWidth="120" IsReadOnly="True" IsEnabled="False" Content="{x:Static properties:Resources.StartDate}" EditValue="{Binding DateTimeStart}">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                                </dxe:TextEditSettings>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarEditItem UseLightweightTemplates="False" x:Name="endTextTitle" EditWidth="120" IsReadOnly="True" IsEnabled="False" Content="{x:Static properties:Resources.EndDate}" EditValue="{Binding DateTimeEnd}">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                                </dxe:TextEditSettings>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                    </dxb:BarLinkContainerItem>
                </dxb:ToolBarControl>
            </dxb:BarContainerControl>


            <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="10" Grid.RowSpan="10" />
            <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="nullconnectionContent" Text="{Binding ConnectionError, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" VerticalAlignment="Center" Grid.ColumnSpan="10" Grid.RowSpan="10"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <Viewbox Stretch="Fill" Visibility="Collapsed" x:Name="txtMode" IsHitTestVisible="False" 
                   KeyboardNavigation.IsTabStop="False"
                 Width="{Binding ElementName=layoutItems, Path=Width}" Height="{Binding ElementName=layoutItems, Path=Height}">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" 
                   KeyboardNavigation.IsTabStop="False"
                       Text="{x:Static properties:Resources.NoReportLicense}" FontSize="48" Opacity="0.1">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-45" />
                </TextBlock.LayoutTransform>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="5" />
                </TextBlock.Effect>
            </TextBlock>
        </Viewbox>
    </Grid>
</UserControl>
