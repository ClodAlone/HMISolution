<UserControl x:Class="MSSchedulerSettings.Controls.WeeklyPlan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:converters="clr-namespace:MSSchedulerSettings.Converters"
             xmlns:properties="clr-namespace:MSSchedulerSettings.Properties" 
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="weeklyPlan"   
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
            <Border x:Key="unselectedBorder" BorderBrush="{DynamicResource {dxgt:GridRowThemeKey ResourceKey=GridDataRowDelimiterBrush}}"/>
            <!--<Border x:Key="selectedBorder" BorderBrush="{DynamicResource {dxgt:TableViewThemeKey ResourceKey=AnnotationFocusedRowBrush}}"/>-->
            <!--<Border x:Key="selectedBorder" BorderBrush="{DynamicResource {dxgt:GridRowThemeKey ResourceKey=BorderFocusedBrush}}"/>-->
            <!--<Border x:Key="selectedBorder" BorderBrush="{DynamicResource {dxgt:GridRowThemeKey ResourceKey=CellTextFocusedBrush}}"/>-->
            <!--<Border x:Key="oddRowBackground" BorderBrush="{DynamicResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"/>-->

            <converters:DayOfWeekToTextConverter x:Key="DayOfWeekToTextConverter" />
            <converters:DayOfWeekToBrushConverter x:Key="DayOfWeekToBrushConverter" />
            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
            <DataTemplate x:Key="RowHeaderBaseTemplate">
              <Grid x:Name="RowHeaderBaseTemplate" Margin="4,0" IsHitTestVisible="False" Focusable="False">
                <TextBlock Text="{Binding DayOfWeek, Converter={StaticResource DayOfWeekToTextConverter}}" 
                           ToolTipService.ShowOnDisabled="False" ToolTipService.IsEnabled="False"
                           HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource DayOfWeekToBrushConverter}" Mode="OneWay">
                      <Binding Path="DayOfWeek" />
                      <Binding Path="SelectionColor" 
                               RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                      <Binding Path="Foreground"
                               RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                    </MultiBinding>
                  </TextBlock.Foreground>
                </TextBlock>
              </Grid>
            </DataTemplate>
        </ResourceDictionary>
  </UserControl.Resources>
  <dxb:BarManager.DXContextMenu>
    <dxb:PopupMenu x:Name="contextMenu" Opacity="0.8">
      <dxb:PopupMenu.Items>
        <dxb:BarButtonItem Command="{Binding Path=AddNew, ElementName=weeklyPlan}" x:Name="addWItemButton"
                           Content="{x:Static properties:Resources.AddNewWeeklyItem}" />
        <dxb:BarButtonItem Command="{Binding Path=Edit, ElementName=weeklyPlan}" x:Name="editWItemButton"
                           Content="{x:Static properties:Resources.EditWeeklyPlanItem}" />
        <dxb:BarItemLinkSeparator />
        <dxb:BarButtonItem Command="{Binding Path=Delete, ElementName=weeklyPlan}" x:Name="deleteWItemButton"
                           Content="{x:Static properties:Resources.DeleteWeeklyPlanItem}" />
      </dxb:PopupMenu.Items>
    </dxb:PopupMenu>
  </dxb:BarManager.DXContextMenu>
    <Grid>
        <Grid x:Name="weeklyPlanGrid" ToolTipService.ShowOnDisabled="False" ToolTipService.IsEnabled="False">
        </Grid>
    </Grid>
</UserControl>


