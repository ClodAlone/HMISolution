<UserControl xmlns:ms="http://namespaces.mindscape.co.nz/wpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:MSSchedulerSettings.Properties"
             xmlns:self="clr-namespace:MSSchedulerSettings"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
             xmlns:userlocal="clr-namespace:MSSchedulerSettings"
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:local="clr-namespace:DevExpress.Xpf.Scheduler.UI;assembly=DevExpress.Xpf.Scheduler.v21.2"
             xmlns:dxschd="clr-namespace:DevExpress.Xpf.Scheduler.Drawing;assembly=DevExpress.Xpf.Scheduler.v21.2"
             xmlns:dxscht="clr-namespace:DevExpress.Xpf.Scheduler.ThemeKeys;assembly=DevExpress.Xpf.Scheduler.v21.2"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxsch="http://schemas.devexpress.com/winfx/2008/xaml/scheduler"
             xmlns:dxga="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:common="clr-namespace:OPCUAViewModel.PropertyDataTemplate;assembly=OPCUAViewModel"
             xmlns:dxschint="http://schemas.devexpress.com/winfx/2008/xaml/scheduler/internal" xmlns:XtraScheduler="clr-namespace:DevExpress.XtraScheduler;assembly=DevExpress.XtraScheduler.v21.2.Core"
             xmlns:controls="clr-namespace:MSSchedulerSettings.Controls"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:wpfconverters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             x:Class="MSSchedulerSettings.Controls.NewEvent"
             mc:Ignorable="d" d:DesignWidth="300" 
             Height="400">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <wpfconverters:DefaultDateTimeConverter x:Key="DefaultDateTimeConverter" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Pink" />
            <converters:DateTimeToTimeSpanConverter x:Key="DateTimeToTimeSpanConverter" />
            <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="TextBlock.Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" />
                <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" />
            </Style>
            <Style x:Key="GridViewColumnHeaderGripper" TargetType="{x:Type Thumb}">
                <Setter Property="Canvas.Right" Value="-9" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <Rectangle Fill="{TemplateBinding Background}" HorizontalAlignment="Center" Width="1" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Background" Value="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <Grid SnapsToDevicePixels="true">
                                <Border x:Name="HeaderBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MaxHeight="7" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="UpperHighlight" Visibility="Collapsed" />
                                        <Border Padding="{TemplateBinding Padding}" Grid.RowSpan="2">
                                            <ContentPresenter x:Name="HeaderContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0,0,1" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="HeaderHoverBorder" BorderThickness="1,0,1,1" Margin="1,1,0,0" />
                                <Border x:Name="HeaderPressBorder" BorderThickness="1,1,1,0" Margin="1,0,0,1" />
                                <Canvas>
                                    <Thumb x:Name="PART_HeaderGripper" Style="{StaticResource GridViewColumnHeaderGripper}" />
                                </Canvas>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="HeaderBorder">
                                        <Setter.Value>
                                            <SolidColorBrush Color="White" Opacity="0.2" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" TargetName="HeaderBorder">
                                        <Setter.Value>
                                            <SolidColorBrush Color="White" Opacity="0.4" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="HederTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </DataTemplate>

            <userlocal:DateTimeToShortDateStringConverter x:Key="DateTimeConverter" />
            <!--TimeRulerTemplate-->
            <DataTemplate x:Key="MyTimeRulerMinuteItemTemplate">
                <TextBlock Style="{DynamicResource {dxscht:DayViewThemeKey ResourceKey=TimeRulerFontStyle}}"
                    Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}"
                    Background="{x:Null}"
                    FontSize="10"
                    HorizontalAlignment="Right"
                    Text="{Binding Caption}"
                    Padding="0,2,2,2" />
            </DataTemplate>
            <DataTemplate x:Key="MyTimeRulerHourItemTemplate">
                <TextBlock Style="{DynamicResource {dxscht:DayViewThemeKey ResourceKey=TimeRulerFontStyle}}"
                    Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}"
                    Background="{x:Null}"
                    Text="{Binding Caption}"
                    dxschd:SharedSizePanel.Span="{Binding MinuteItems.Count}"
                    FontSize="{Binding FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" 
                    HorizontalAlignment="Right"
                    Padding="0,2,14,2" />
            </DataTemplate>
            <DataTemplate x:Key="{dxscht:DayViewThemeKey ResourceKey=TimeRulerTemplate, IsThemeIndependent=True}">
                <Grid SnapsToDevicePixels="True" Background="Transparent" dxsch:SchedulerControl.HitTestType="Ruler">
                    <!--BEGIN WPF-->
                    <Grid.IsSharedSizeScope>
                        <sys:Boolean>True</sys:Boolean>
                    </Grid.IsSharedSizeScope>
                    <!--END WPF-->
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition>
                                <!--BEGIN WPF-->
                                <RowDefinition.SharedSizeGroup>
                                    <sys:String>TimeRuler</sys:String>
                                </RowDefinition.SharedSizeGroup>
                                <!--END WPF-->
                            </RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="{DynamicResource {dxscht:DayViewThemeKey ResourceKey=TimeRulerMargin}}" Orientation="Horizontal" VerticalAlignment="Top">
                            <Grid Margin="{DynamicResource {dxscht:DayViewThemeKey ResourceKey=TimeRulerMargin}}">
                                <dxschd:SchedulerItemsControl ItemsSource="{Binding Elements}" 
                        ItemTemplate="{StaticResource MyTimeRulerHourItemTemplate}"
                        
                                Grid.ColumnSpan="2"
                        >
                                    <!--ItemTemplate="{DynamicResource {dxscht:DayViewThemeKey ResourceKey=TimeRulerHourItemTemplate}}"-->
                                    <dxschd:SchedulerItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <dxschd:SharedSizePanel Orientation="Vertical" SharedSizeGroup="VerticalDayViewCells" x:Name="HourItemPanel" IsBaseSizePanel="False" VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </dxschd:SchedulerItemsControl.ItemsPanel>
                                </dxschd:SchedulerItemsControl>

                                <dxschd:SchedulerItemsControl ItemsSource="{Binding AllMinuteItems}" 
                        ItemTemplate="{StaticResource MyTimeRulerMinuteItemTemplate}"
                        Grid.Column="1">
                                    <dxschd:SchedulerItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <dxschd:SharedSizePanel Orientation="Vertical" SharedSizeGroup="VerticalDayViewCells" x:Name="MinuteItemPanel" IsBaseSizePanel="False" VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </dxschd:SchedulerItemsControl.ItemsPanel>
                                </dxschd:SchedulerItemsControl>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition>
                                <!--BEGIN WPF-->
                                <RowDefinition.SharedSizeGroup>
                                    <sys:String>TimeRuler</sys:String>
                                </RowDefinition.SharedSizeGroup>
                                <!--END WPF-->
                            </RowDefinition>
                        </Grid.RowDefinitions>
                        <dxschd:TimeRulerTimeMarker x:Name="timeIndicator" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TimeRuler="{Binding}">
                            <ContentPresenter Style="{Binding ElementName=timeIndicator, Path=TimeRuler.View.CurrentTimeIndicatorStyle}" Content="{Binding}" />
                        </dxschd:TimeRulerTimeMarker>
                    </Grid>
                </Grid>
            </DataTemplate>
            <!--VisualDataHeader-->
            <Style x:Key="DateHeaderStyle" TargetType="{x:Type dxschint:VisualDateHeader}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type dxschint:VisualDateHeader}">
                            <TextBlock Foreground="{TemplateBinding Foreground}" x:Name="text" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding IntervalStart, ConverterParameter=ddd, Converter={StaticResource DateTimeConverter}}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid>
                                <TextBlock FontSize="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" x:Name="text" Text="{Binding IntervalStart, ConverterParameter=ddd, Converter={StaticResource DateTimeConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!---->
            <userlocal:SimpleSchedulingDateConverter x:Key="schedulingDateConverter" />
            <userlocal:SimpleSchedulingDateToVisual x:Key="schedulingDateToVisualConverter" />
            <DataTemplate x:Key="AppointmentTooltipContentTemplate">
                <Grid>
                    <TextBlock Text="{Binding ViewInfo, Path=CustomViewInfo}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid x:Name="MainGrid">
        <dx:DXTabControl x:Name="tabGeneral" SelectionChanged="OnTabSelectionChanged" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
			Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
            <dx:DXTabControl.View>
                <dx:TabControlMultiLineView />
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="DevWeeklyPlan" Header="{x:Static properties:Resources.NewEventWeeklyPlan}"
				Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <dxsch:SchedulerControl Grid.Row="1" HorizontalAlignment="Left" Margin="12,12,0,0" x:Name="schedulerControl1" 
					FormCustomizationUsingMVVMLocal="False" GotFocus="schedulerControl1_GotFocus"
					Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
					VerticalAlignment="Top" ActiveViewType="WorkWeek" Start="4/16/2012" AppointmentViewInfoCustomizing="schedulerControl1_AppointmentViewInfoCustomizing"
                                       EditAppointmentFormShowing="schedulerControl1_EditAppointmentFormShowing">
                    <dxsch:SchedulerControl.OptionsView>
                        <dxsch:OptionsView FirstDayOfWeek="Monday" />
                    </dxsch:SchedulerControl.OptionsView>
                    <dxsch:SchedulerControl.DayView>
                        <dxsch:DayView>
                            <dxsch:DayView.AppointmentDisplayOptions>
                                <dxsch:SchedulerDayViewAppointmentDisplayOptions />
                            </dxsch:DayView.AppointmentDisplayOptions>
                        </dxsch:DayView>
                    </dxsch:SchedulerControl.DayView>
                    <dxsch:SchedulerControl.MonthView>
                        <dxsch:MonthView>
                            <dxsch:MonthView.AppointmentDisplayOptions>
                                <dxsch:SchedulerMonthViewAppointmentDisplayOptions />
                            </dxsch:MonthView.AppointmentDisplayOptions>
                        </dxsch:MonthView>
                    </dxsch:SchedulerControl.MonthView>
                    <dxsch:SchedulerControl.TimelineView>
                        <dxsch:TimelineView>
                            <dxsch:TimelineView.AppointmentDisplayOptions>
                                <dxsch:SchedulerTimelineViewAppointmentDisplayOptions />
                            </dxsch:TimelineView.AppointmentDisplayOptions>
                        </dxsch:TimelineView>
                    </dxsch:SchedulerControl.TimelineView>
                    <dxsch:SchedulerControl.WeekView>
                        <dxsch:WeekView>
                            <dxsch:WeekView.AppointmentDisplayOptions>
                                <dxsch:SchedulerWeekViewAppointmentDisplayOptions ShowRecurrence="True" EndTimeVisibility="Always" StartTimeVisibility="Always" />
                            </dxsch:WeekView.AppointmentDisplayOptions>
                        </dxsch:WeekView>
                    </dxsch:SchedulerControl.WeekView>
                    <dxsch:SchedulerControl.WorkWeekView>
                        <dxsch:WorkWeekView x:Name="workView" ShowFullWeek="True" ShowWorkTimeOnly="False" 
							TimeScale="1:0:0" ShowDayHeaders="True" TimeMarkerVisibility="Never" ShowAllDayArea="False">
                            <dxsch:WorkWeekView.AppointmentDisplayOptions>
                                <dxsch:SchedulerDayViewAppointmentDisplayOptions ShowRecurrence="False"
									ShowReminder="False"
									StartTimeVisibility="Never"
									EndTimeVisibility="Never" ToolTipService.IsEnabled="True" />
                            </dxsch:WorkWeekView.AppointmentDisplayOptions>
                            <dxsch:DayView.WorkTime>
                                <XtraScheduler:WorkTimeInterval End="18:00:0" Start="08:00:0" />
                            </dxsch:DayView.WorkTime>
                            
                        </dxsch:WorkWeekView>
                    </dxsch:SchedulerControl.WorkWeekView>
                    <dxsch:SchedulerControl.TimeRulerMenuCustomizations>
                        <dxb:BarButtonItem x:Name="AddScheduleTime" 
							Content="{x:Static properties:Resources.AddScheduleTime}" 
							dxb:BarItemLinkActionBase.ItemLinkIndex="1"
							ItemClick="AddSchedule_ItemClick" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.NewAppointment}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.SwitchViewMenu}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.CustomizeTimeRuler}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.NewAllDayEvent}" />
                    </dxsch:SchedulerControl.TimeRulerMenuCustomizations>
                    <dxsch:SchedulerControl.AppointmentMenuCustomizations>
                        <dxb:BarButtonItem x:Name="NewApp" Content="{x:Static properties:Resources.AddScheduleTime}" 
							dxb:BarItemLinkActionBase.ItemLinkIndex="0" ItemClick="AddSchedule_ItemClick" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.LabelSubMenu}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.StatusSubMenu}" />
                    </dxsch:SchedulerControl.AppointmentMenuCustomizations>

                    <dxsch:SchedulerControl.DefaultMenuCustomizations>
                        <dxb:BarButtonItem x:Name="AddSchedule" 
							Content="{x:Static properties:Resources.AddScheduleTime}" 
							dxb:BarItemLinkActionBase.ItemLinkIndex="1"
							ItemClick="AddSchedule_ItemClick" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.NewAppointment}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.NewAllDayEvent}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.NewRecurringAppointment}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.NewRecurringEvent}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.GotoThisDay}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.GotoToday}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.GotoDate}" />
                        <dxb:RemoveBarItemAndLinkAction ItemName="{x:Static dxsch:SchedulerMenuItemName.SwitchViewMenu}" />
                    </dxsch:SchedulerControl.DefaultMenuCustomizations>
                </dxsch:SchedulerControl>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="CalendarSettings" Header="{x:Static properties:Resources.NewEventCalendar}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" MinHeight="50" />
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="0" x:Name="btnAddCal" Click="CalendarItemAdd_Click">
                        <TextBlock x:Name="btnAddCalText" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.AddCalendarItem}" />
                    </Button>
                    <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="1" x:Name="btnEditCal" Click="CalendarItemEdit_Click">
                        <TextBlock x:Name="btnEditCalText" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.EditCalendarItem}" />
                    </Button>
                    <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="2" x:Name="btnDelCal" Click="CalendarItemDelete_Click">
                        <TextBlock x:Name="btnDelCalText" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.DeleteCalendarItem}" />
                    </Button>
                </Grid>
            <Grid x:Name="CalendarGrid" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:WebListView Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" HorizontalContentAlignment="Stretch" Grid.Row="2" x:Name="CalendarItemsGrid" ListView.MouseDoubleClick="CalendarItemEdit_Click" VerticalAlignment="Stretch">
                    <controls:WebListView.View>
                        <GridView>
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemStart}" Width="Auto">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="StartDate">
                                        <Binding Path="StartDate" />
                                        <Binding Path="Type" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemEnd}" Width="Auto">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="EndDate">
                                        <Binding Path="EndDate" />
                                        <Binding Path="Type" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemType}" DisplayMemberBinding="{Binding Type, UpdateSourceTrigger=LostFocus}" Width="Auto" />
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemMonth}" Width="Auto">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="Month">
                                        <Binding Path="Month" />
                                        <Binding Path="Type" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemWeekOfMonth}" Width="Auto">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="WeekOfMonth">
                                        <Binding Path="WeekOfMonth" />
                                        <Binding Path="Type" />
                                        <Binding Path="DayOfMonth" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemDayOfWeek}" Width="Auto">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="DayOfWeek">
                                        <Binding Path="DayOfWeek" />
                                        <Binding Path="Type" />
                                        <Binding Path="DayOfMonth" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                            <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemDayOfMonth}" Width="Auto">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="DayOfMonth">
                                        <Binding Path="DayOfMonth" />
                                        <Binding Path="Type" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                        </GridView>
                    </controls:WebListView.View>
                </controls:WebListView>
                </Grid>
                </Grid>
                </ScrollViewer>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="ExceptionCalendarSettings" Header="{x:Static properties:Resources.NewEventExceptions}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" MinHeight="50" />
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="0" x:Name="btnAddCal2" Click="CalendarExceptionsItemAdd_Click">
                            <TextBlock x:Name="btnAddCal2Text" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.AddCalendarItem}" />
                        </Button>
                        <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="1" x:Name="btnEditCal2" Click="CalendarExceptionsItemEdit_Click">
                            <TextBlock x:Name="btnEditCal2Text" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.EditCalendarItem}" />
                        </Button>
                        <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="2" x:Name="btnDelCal2" Click="CalendarExceptionsItemDelete_Click">
                            <TextBlock x:Name="btnDelCal2Text" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.DeleteCalendarItem}" />
                        </Button>
                        <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="3" x:Name="btnDelCalMulti2" Click="CalendarExceptionsItemsDelete_Click">
                            <TextBlock x:Name="btnDelCalMulti2Text" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.DeleteCalendarItems}" />
                        </Button>
                        <Button Style="{DynamicResource ButtonStyle}" Grid.Row="0" Grid.Column="4" x:Name="btnAddHolidays" Click="AddMissingHolidays_Click">
                            <TextBlock x:Name="btnAddHolidaysText" TextWrapping="Wrap" TextAlignment="Center" Text="{x:Static properties:Resources.AddDefaultHolidays}" />
                        </Button>
                    </Grid>
                    <Grid x:Name="ExceptionCalendarGrid" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:WebListView Foreground="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, UpdateSourceTrigger=PropertyChanged}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" HorizontalContentAlignment="Stretch" Grid.Row="2" x:Name="CalendarItemsGrid2" ListView.MouseDoubleClick="CalendarExceptionsItemEdit_Click" VerticalAlignment="Stretch">
                            <controls:WebListView.View>
                                <GridView>
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemStart}" Width="Auto">
                                        <GridViewColumn.DisplayMemberBinding>
                                            <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="StartDate">
                                                <Binding Path="StartDate" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </GridViewColumn.DisplayMemberBinding>
                                    </GridViewColumn>
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemEnd}" Width="Auto">
                                        <GridViewColumn.DisplayMemberBinding>
                                            <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="EndDate">
                                                <Binding Path="EndDate" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </GridViewColumn.DisplayMemberBinding>
                                    </GridViewColumn>
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemType}" DisplayMemberBinding="{Binding Type, UpdateSourceTrigger=LostFocus}" Width="Auto" />
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemMonth}" Width="Auto">
                                        <GridViewColumn.DisplayMemberBinding>
                                            <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="Month">
                                                <Binding Path="Month" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </GridViewColumn.DisplayMemberBinding>
                                    </GridViewColumn>
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemWeekOfMonth}" Width="Auto">
                                        <GridViewColumn.DisplayMemberBinding>
                                            <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="WeekOfMonth">
                                                <Binding Path="WeekOfMonth" />
                                                <Binding Path="Type" />
                                                <Binding Path="DayOfMonth" />
                                            </MultiBinding>
                                        </GridViewColumn.DisplayMemberBinding>
                                    </GridViewColumn>
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemDayOfWeek}" Width="Auto">
                                        <GridViewColumn.DisplayMemberBinding>
                                            <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="DayOfWeek">
                                                <Binding Path="DayOfWeek" />
                                                <Binding Path="Type" />
                                                <Binding Path="DayOfMonth" />
                                            </MultiBinding>
                                        </GridViewColumn.DisplayMemberBinding>
                                    </GridViewColumn>
                                    <GridViewColumn HeaderTemplate="{StaticResource HederTemplate}" Header="{x:Static properties:Resources.CalendarItemDayOfMonth}" Width="Auto">
                                        <GridViewColumn.DisplayMemberBinding>
                                            <MultiBinding Converter="{StaticResource schedulingDateToVisualConverter}" ConverterParameter="DayOfMonth">
                                                <Binding Path="DayOfMonth" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </GridViewColumn.DisplayMemberBinding>
                                    </GridViewColumn>
                                </GridView>
                            </controls:WebListView.View>
                        </controls:WebListView>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="GeneralSettings" Header="{x:Static properties:Resources.NewEventTitle}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewEventName}" VerticalAlignment="Center" x:Name="lblName" />
                        <TextBlock Margin="5,2" Grid.Row="1" Grid.Column="1"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
							HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
							x:Name="textEditName" />

                        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.EnableEvent}" VerticalAlignment="Center" x:Name="lblEnable" />
                        <CheckBox Margin="5,2" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" 
							Content="" IsChecked="{Binding Enable, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							x:Name="chkEnable" />
                        <ContentPresenter Grid.Row="2" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=chkEnable}" />

                        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewEventType}" VerticalAlignment="Center" x:Name="lblType" />
                        <ComboBox Margin="5,2" Grid.Column="1" Grid.Row="3" x:Name="comboType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
                        <wpfutilities:ComboWeb Visibility="Collapsed" Margin="5,2" Grid.Column="1" x:Name="comboType_web" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
                        <ContentPresenter Grid.Row="3" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=comboType}" />

                        <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.Time}" VerticalAlignment="Center" x:Name="lblTime" />
            <dxga:DateEdit Margin="5,2" Grid.Row="4" Grid.Column="1" EditValue="{Binding Time, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultDateTimeConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                x:Name="textEditTime" MaskType="TimeSpan" Mask="HH:mm:ss" MaskUseAsDisplayFormat="True" AllowDefaultButton="False" PopupMaxHeight="0">
                <dxe:ButtonEdit.Buttons>
                    <dxe:SpinButtonInfo IsDefaultButton="true" SpinStyle="Vertical" />
                </dxe:ButtonEdit.Buttons>
            </dxga:DateEdit>
            <ContentPresenter Grid.Row="4" Grid.Column="2" 
							Name="cpStartTime"
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditTime}" />
                        
            <TextBox Visibility="Collapsed" Margin="5,2" Grid.Row="4" Grid.Column="1"
                x:Name="textEditTime_web" HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
							/>
            <ContentPresenter Visibility="Collapsed" Grid.Row="4" Grid.Column="2" 
							Name="cpStartTime_web"
                Content="{Binding ElementName=textEditTime_web, Path=(Validation.Errors).CurrentItem}" />

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.Date}" VerticalAlignment="Center" x:Name="lblDate" Visibility="Collapsed" />
