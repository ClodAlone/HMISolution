                                    EditValue="{Binding Date, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Mask="dd/MM/YY"  Visibility="Collapsed" x:Name="textEditDate" Text="dd/MM/YY"
                                    DisplayFormatString="dd/MM/YY"  NullText="dd/MM/YY"  AllowSpinOnMouseWheel="False"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" FontFamily="Segoe UI" FontWeight="Normal"/>
                            <ContentPresenter Grid.Row="5" Grid.Column="2" 
                        Content="{Binding ElementName=textEditDate, Path=(Validation.Errors).CurrentItem}" Visibility="Collapsed" />-->

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.TimeOff}" VerticalAlignment="Center" x:Name="lblTimeOff" />
            <!--<dxga:TextEdit   Margin="5,2" Grid.Row="6" Grid.Column="1" MaskType="DateTime" MaskUseAsDisplayFormat="True"
                                    EditValue="{Binding TimeOff, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Mask="HH:mm:ss"  x:Name="textEditTimeOff" NullText="00:00:00"  Text="00:00:00"  AllowSpinOnMouseWheel="False"
                                    DisplayFormatString="HH:mm:ss" 
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" FontFamily="Segoe UI" FontWeight="Normal"/>-->
            <dxga:DateEdit Margin="5,2" Grid.Row="6" Grid.Column="1" EditValue="{Binding TimeOff, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultDateTimeConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                x:Name="textEditTimeOff" MaskType="TimeSpan" Mask="HH:mm:ss" MaskUseAsDisplayFormat="True" AllowDefaultButton="False" PopupMaxHeight="0">
                <dxe:ButtonEdit.Buttons>
                    <dxe:SpinButtonInfo IsDefaultButton="true" SpinStyle="Vertical" />
                </dxe:ButtonEdit.Buttons>
            </dxga:DateEdit>
            <ContentPresenter Grid.Row="6" Grid.Column="2" 
							Name="cpEndTime"
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditTimeOff}" />

            <TextBox Visibility="Collapsed" Margin="5,2" Grid.Row="6" Grid.Column="1"
                x:Name="textEditTimeOff_web" HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
							/>
            <ContentPresenter Visibility="Collapsed" Grid.Row="6" Grid.Column="2" 
							Name="cpEndTime_web"
                Content="{Binding ElementName=textEditTimeOff_web, Path=(Validation.Errors).CurrentItem}" />

            <ContentPresenter Grid.Row="7" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditDateOff}" Visibility="Collapsed" />

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.NewEventTag}" VerticalAlignment="Center" x:Name="lblTag" />
            <Grid Grid.Row="8" Margin="5,2" Grid.Column="1" x:Name="TagGrid">
                <common:OPCUAEntityReferencePropertyEditor x:Name="textScheduleItemName" AllowDataSync="False" />
            </Grid>
            <ContentPresenter Grid.Row="9" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textScheduleItemName}" />

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.NewEventValueOn}" VerticalAlignment="Center" x:Name="lblOn" />
            <TextBox Grid.Row="9" Margin="5,2" Grid.Column="1"
                Text="{Binding ValueOn, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
							HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
							x:Name="textEditValueOn" />
            <ContentPresenter Grid.Row="10" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditValueOn}" />

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.NewEventValueOff}" VerticalAlignment="Center" x:Name="lblOff" />
            <TextBox Grid.Row="10" Margin="5,2" Grid.Column="1"
                Text="{Binding ValueOff, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
							HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
							x:Name="textEditValueOff" />
            <ContentPresenter Grid.Row="11" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditValueOff}" />

            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.NewEventEnableTag}" VerticalAlignment="Center" x:Name="lblEnableItem" />
            <Grid Grid.Row="11" Margin="5,2" Grid.Column="1" x:Name="EnableGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <common:OPCUAEntityReferencePropertyEditor x:Name="textEditEnableItem" AllowDataSync="False" />
            </Grid>
            <ContentPresenter Grid.Row="11" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditEnableItem}" />

            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.ExecOnAtStartup}" VerticalAlignment="Center" x:Name="lblStartup" />
            <CheckBox Grid.Row="12" Margin="5,2" Grid.Column="1" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" 
							Content="" IsChecked="{Binding ExecOnAtStartup, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							x:Name="chkStartup" />
            <ContentPresenter Grid.Row="12" Grid.Column="2" 
							Name="cpStartup"
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=chkStartup}" />

            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.ExecOffAtStartup}" VerticalAlignment="Center" x:Name="lblOffStartup" />
            <CheckBox Grid.Row="13" Margin="5,2" Grid.Column="1" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" 
							Content="" IsChecked="{Binding ExecOffAtStartup, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							x:Name="chkOffStartup" />
            <ContentPresenter Grid.Row="13" Grid.Column="2" 
							Name="cpOffStartup"
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=chkOffStartup}" />

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.SelectableRuntime}" VerticalAlignment="Center" x:Name="lblRuntime" />
            <CheckBox Grid.Row="14" Margin="5,2" Grid.Column="1" HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" 
							Content="" IsChecked="{Binding RuntimeSelectable, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
							x:Name="chkSelectable" />
            <ContentPresenter Grid.Row="13" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=chkSelectable}" />

                        <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.NewEventAccessRole}" VerticalAlignment="Center" x:Name="lblRole" />
                        <ComboBox Margin="5,2" Grid.Column="1" Grid.Row="15" Text="{Binding AccessRole}" SelectedValue="{Binding AccessRole}" x:Name="comboAccessRole" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
                        <wpfutilities:ComboWeb Visibility="Collapsed" Margin="5,2" Grid.Column="1" Grid.Row="15" Text="{Binding AccessRole}" SelectedValue="{Binding AccessRole}" x:Name="comboAccessRole_web" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
                        <ContentPresenter Grid.Row="15" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditAccessRole}" />

            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.NewEventAccessLevel}" VerticalAlignment="Center" x:Name="lblLevel" />
            <TextBox Grid.Row="16" Margin="5,2" Grid.Column="1"
                Text="{Binding AccessLevels, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
							HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
							x:Name="textEditAccessLevel" />
            <ContentPresenter Grid.Row="15" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=textEditAccessLevel}" />

            <TextBlock Grid.Row="17" Text="{x:Static properties:Resources.NewEventAccessMask}" VerticalAlignment="Center" x:Name="lblMask" />
            <DockPanel Grid.Row="17" Margin="5,2" Grid.Column="1" x:Name="editAccesMask">
                <Button x:Name="bitmask" DockPanel.Dock="Right" Tag="{Binding AccessMasks, Mode=TwoWay}" Click="AMButton_Click">
                    <Image x:Name="bitmaskImage" Height="16" Width="16" />
                </Button>
                <TextBox x:Name="text" IsReadOnly="False" Text="{Binding Tag, ElementName=bitmask, StringFormat=X8, UpdateSourceTrigger=LostFocus}" />
            </DockPanel>
            

            <ContentPresenter Grid.Row="17" Grid.Column="2" 
							Content="{Binding (Validation.Errors).CurrentItem, ElementName=editAccesMask}" />

            <TextBlock Visibility="Collapsed" Grid.Row="18" Text="{x:Static properties:Resources.CommandsOff}" VerticalAlignment="Center" x:Name="lblCommandsOff" />
            <Button Visibility="Collapsed" Grid.Row="18" Grid.Column="1" x:Name="commandsOff" Tag="{Binding CommandsOff, Mode=TwoWay}" Click="CommandsBtn_Click">
                <Image x:Name="commandsOffImage" Height="16" Width="16" />
            </Button>

            <TextBlock Visibility="Collapsed" Grid.Row="19" Text="{x:Static properties:Resources.CommandsOn}" VerticalAlignment="Center" x:Name="lblCommandsOn" />
            <Button Visibility="Collapsed" Grid.Row="19" Grid.Column="1" x:Name="commandsOn" Tag="{Binding CommandsOn, Mode=TwoWay}" Click="CommandsBtn_Click">
                <Image x:Name="commandsOnImage" Height="16" Width="16" />
            </Button>
                        
            </Grid>
