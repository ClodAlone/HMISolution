<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             x:Class="DBControls.Controls.SmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:properties="clr-namespace:DBControls.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:templates="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Button Click="Button_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DataSourceSelector}">
          <Button.Content>
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
              <Label Margin="10,0" x:Name="connectionlabel" Content="{x:Static properties:Resources.DataSourceSelector}"/>
            </StackPanel>
          </Button.Content>
        </Button>
        <dxg:GridControl Name="gridControl" Grid.Row="1" ItemsSourceChanged="gridControl_ItemsSourceChanged">
            <dxg:GridControl.Columns>
                <dxg:GridColumn x:Name="Col1"  BestFitMaxRowCount="15" AllowBestFit="True" AllowEditing="False" DisplayMemberBinding="{Binding Path=ColName, Mode=TwoWay}" Header="{x:Static properties:Resources.ColName}">
                </dxg:GridColumn>
                    <dxg:GridColumn x:Name="Col2"  BestFitMaxRowCount="15" AllowBestFit="True" Header="{x:Static properties:Resources.ColTitle}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings/>
                    </dxg:GridColumn.EditSettings>
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <templates:TextPropertyEditor BindingPath="Row.Caption" 
                                Workspace="{Binding Workspace, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

                <dxg:GridColumn x:Name="Col4"  BestFitMaxRowCount="15" AllowBestFit="True" DisplayMemberBinding="{Binding Path=IsEditable, Mode=TwoWay}" Header="{x:Static properties:Resources.IsEditable}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn x:Name="Col5" BestFitMaxRowCount="15" AllowBestFit="True" Header="{x:Static properties:Resources.ImageThresholds}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding EditImageColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding RowData.Row.ColName}">
                                <Button.Content>
                                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" 
                    AllowBestFit="True" BestFitMaxRowCount="15" 
                    BestFitArea="All" AllowColumnMoving="False"
                    BestFitMode="DistinctValues"
                    HorizontalScrollbarVisibility="Auto"
                    VerticalScrollbarVisibility="Visible"
                    ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" CellValueChanged="tableView_CellValueChanged" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
