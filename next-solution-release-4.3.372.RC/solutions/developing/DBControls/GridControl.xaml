<UserControl xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
             x:Class="DBControls.GridControl" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:self="clr-namespace:DBControls.Converters"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:DBControls.Properties"
             mc:Ignorable="d" xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             Background="{dxi:ThemeResource {dxct:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             xmlns:local="clr-namespace:DBControls"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxct="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" 
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             Height="835" Width="865">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <dxe:TextEditSettings x:Key="dateSettings" MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            <dxe:TextEditSettings x:Key="timespanSettings" MaskType="TimeSpan" Mask="c" MaskUseAsDisplayFormat="True" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            <local:TextEditSettingsEx x:Key="numericSettings" MaskType="Numeric" Mask="f0" MaskUseAsDisplayFormat="True" x:Shared="False" HorizontalContentAlignment="Right" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            <local:TextEditSettingsEx x:Key="decimalSettings" MaskType="Numeric" Mask="f" MaskUseAsDisplayFormat="True" x:Shared="False" HorizontalContentAlignment="Right" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            <local:TextEditSettingsEx x:Key="generalSettings" x:Shared="False" HorizontalContentAlignment="Left" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            <dxmvvm:BooleanToObjectConverter x:Key="BoolToTextConverter" FalseValue="False" TrueValue="True" />
            <dxe:CheckEditSettings x:Key="booleanSettings" DisplayTextConverter="{StaticResource BoolToTextConverter}" />
            <self:ThresholdToImageConverter x:Key="ThresholdToImageConverter" />
            <self:ColumnItemsToCaptionVisibilityConverter x:Key="ColumnItemsToCaptionVisibilityConverter" />
            <self:ColumnItemsToCaptionAlignmentConverter x:Key="ColumnItemsToCaptionAlignmentConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <DataTemplate x:Key="ImageColumnTemplate">
                <DockPanel x:Name="ImageColumnPanel">
                    <DockPanel.Style>
                        <Style TargetType="{x:Type DockPanel}">
                            <EventSetter Event="MouseLeftButtonDown" Handler="ImageColumnEditClick_Handler" />
                        </Style>
                    </DockPanel.Style>
                    <TextBlock x:Name="ImageCellTextBlock" Text="{Binding Value}" Padding="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center">
                        <DockPanel.Dock>
                            <MultiBinding Converter="{StaticResource ColumnItemsToCaptionAlignmentConverter}">
                                <!--<Binding Path="ControlDataSource.ColumnListSettings" RelativeSource="{RelativeSource FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="Column.FieldName" />-->
                                <Binding Path="Value" />
                                <Binding Path="ImageThresholds" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="UriToImageConverter" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="Column.FieldName" />
                            </MultiBinding>
                        </DockPanel.Dock>
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource ColumnItemsToCaptionVisibilityConverter}">
                                <Binding Path="Value" />
                                <Binding Path="ImageThresholds" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="UriToImageConverter" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="TemplatedParent.Tag" ElementName="ImageColumnPanel" />
                                <Binding Path="Column.FieldName"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <dxe:TextEdit Name="PART_Editor" EditorActivated="OnImageCell_EditorActivated" Visibility="{Binding TemplatedParent.Tag, ElementName=ImageColumnPanel, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=1}" DockPanel.Dock="{Binding (DockPanel.Dock), ElementName=ImageCellTextBlock}" TextWrapping="NoWrap" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" />
                    <Image x:Name="CellImage" VerticalAlignment="Center" HorizontalAlignment="Center" Width="{Binding ElementName=CellImage, Path=Source.PixelWidth}" Height="{Binding ElementName=CellImage, Path=Source.PixelHeight}">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource ThresholdToImageConverter}">
                                <Binding Path="Value" />
                                <Binding Path="ImageThresholds" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="UriToImageConverter" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                                <Binding Path="Column.FieldName" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <DockPanel.Resources>
            <converters:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertionVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <self:ErrorInfoToBooleanConverter x:Key="ErrorInfoToBooleanConverter" />
            <self:ErrorInfoToVisibilityConverter x:Key="ErrorInfoToVisibilityConverter" />
            <self:ConditionalStyleConverter x:Key="ConditionalStyleConverter" />
            <DiscreteObjectKeyFrame x:Key="colTextWrapKey" Value="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></DiscreteObjectKeyFrame>
        </DockPanel.Resources>

        <dxb:BarContainerControl ContainerType="Top" DockPanel.Dock="Top" x:Name="toolbar">
            <dxb:ToolBarControl BarItemDisplayMode="ContentAndGlyph" UseWholeRow="True" dxb:MergingProperties.Name="mainDBGridToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False">
              <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                  <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                        <dxe:ComboBoxEdit
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>
                    <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall" Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmallBtn" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />  
              </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit" />
            </dxb:ToolBarControl>

        </dxb:BarContainerControl>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MinHeight="40" x:Name="commands" DockPanel.Dock="Bottom" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="2" Grid.Column="0" x:Name="ReloadButton"
    		MinWidth="16" ToolTipService.ShowOnDisabled="True" 
    		ToolTip="{x:Static properties:Resources.ReloadData}"
    		Command="{Binding Path=ReloadData, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    		Tag="ButtonReloadData">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.ReloadData}" Background="{x:Null}" x:Name="txtReload"
    				Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    				Source="{DynamicResource RefreshSmall}" x:Name="refreshSmall" Width="16" Height="16" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="1" x:Name="InsertRowButton"
    		MinWidth="16" ToolTipService.ShowOnDisabled="True" 
    		ToolTip="{x:Static properties:Resources.InsertRow}"
    		Command="{Binding Path=InsertRow, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    		Tag="ButtonInsertRow">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.InsertRow}" Background="{x:Null}" x:Name="txtInsertRow"
    				Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    				Source="{DynamicResource AddNewSmall1}" x:Name="addSmall" Width="16" Height="16" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="2" x:Name="DeleteRowButton"
    		MinWidth="16" ToolTipService.ShowOnDisabled="True" 
    		ToolTip="{x:Static properties:Resources.DeleteRow}"
    		Command="{Binding Path=DeleteRow, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    		Tag="ButtonDeleteRow">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.DeleteRow}" Background="{x:Null}" x:Name="txtDeleteRow"
    				Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    				Source="{DynamicResource DeleteSmall}" x:Name="deleteSmall" Width="16" Height="16" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="3" x:Name="SaveDataButton"
    		MinWidth="16" ToolTipService.ShowOnDisabled="True" 
    		ToolTip="{x:Static properties:Resources.SaveData}"
    		Command="{Binding Path=SaveData, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    		Tag="ButtonSaveData">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.SaveData}" Background="{x:Null}" x:Name="txtSaveRow"
    				Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    				Source="{DynamicResource SaveSmall}" x:Name="saveSmall" Width="16" Height="16" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="4"
    		MinWidth="16" x:Name="Button9" ToolTipService.ShowOnDisabled="True" 
    		ToolTip="{x:Static properties:Resources.ExportDataCommand}"
    		Command="{Binding Path=ExportDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="1"
    		Tag="ButtonExportData">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.ExportDataCommand}" Background="{x:Null}" x:Name="txtExport" 
                           Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                      <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
    				Source="{DynamicResource ExportDataSmall}" x:Name="exportSmall" Width="16" Height="16" />
                    </StackPanel>
                </Button>
                <ComboBox MinWidth="90" Visibility="Visible" Grid.Column="5" x:Name="cmbExportType" SelectionChanged="cmbExportType_SelectionChanged" />
                <Border Grid.Row="2" Grid.Column="6" BorderThickness="1" 
                        BorderBrush="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderBrush}}"
                        Background="{dxi:ThemeResource {dxct:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}">
                    <dxe:CheckEdit ShowBorder="True" Grid.Column="3" x:Name="chkMultiLine" Content="{x:Static properties:Resources.MultilineExportOption}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" Checked="chkMultiLine_Checked" Unchecked="chkMultiLine_Unchecked"></dxe:CheckEdit>
                </Border>
            </Grid>
            <Grid Grid.Row="0">
                <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
			                 Tag="DataSourceStyle" 
                             Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             ItemsSourceChanged="gridDataControl1_ItemsSourceChanged"
                             AutoExpandAllGroups="True" 
			                 x:Name="gridDataControl1" SelectionMode="Cell"
                             SelectedItemChanged="OnGridSelectedItemChanged"
                             AutoGeneratedColumns="OnAutoGeneratedColumns"
                             AllowDrop="True" AutoPopulateColumns="True"
                             AllowLiveDataShaping="False" 
                             dx:DXSerializer.SerializationID="gridDataControl1" 
                             dx:DXSerializer.StoreLayoutMode="All" 
                             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                             dxg:DataControlSerializationOptions.AddNewColumns="False"
    		                 dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                <dxg:GridControl.Resources>
                    <Style TargetType="dxg:GridColumnHeader">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HeaderBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                <Setter Property="Background" Value="{Binding HeaderBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <ControlTemplate   
                             x:Key="{dxgt:GridControlThemeKey ResourceKey=BorderTemplate, IsThemeIndependent=True}"  
                             TargetType="{x:Type ContentControl}">
                            <Border Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                                <ContentPresenter />
                            </Border>
                    </ControlTemplate>
                    <Style TargetType="ScrollBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                <Setter Property="Background" Value="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    </dxg:GridControl.Resources>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView"
                        Background="{Binding Background, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        ShowColumnHeaders="{Binding ShowColumnHeaders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        AllowEditing="True" 
                        InitNewRow="tableView_InitNewRow"  AutoWidth="False"
                        InvalidRowException="tableView_InvalidRowException" 
                        CellValueChanged="tableView_CellValueChanged"                        
                        PreviewKeyDown="tableView_PreviewKeyDown"
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        ShowSearchPanelMode="Always" 
                        SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True" VerticalScrollbarVisibility="Auto" HorizontalScrollbarVisibility="Auto"
                        FocusedRowHandleChanged="OnFocusedRowHandleChanged"
                        ShowHorizontalLines="{Binding ShowCellsBorder, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        ShowVerticalLines="{Binding ShowCellsBorder, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        ShowFilterPanelMode="ShowAlways">
                        <dxg:TableView.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="Resources\CellStyles.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </dxg:TableView.Resources>
                        <dxg:TableView.ColumnHeaderContentStyle>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeaderForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding HeaderForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </Style>
                        </dxg:TableView.ColumnHeaderContentStyle>
                            <dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowAreaForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="TextBlock.Foreground" Value="{Binding RowAreaForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CellBorderColor, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{Binding CellBorderColor, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    </DataTrigger>
                                        <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                        <Setter Property="Background" Value="{Binding FocusedRowBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        <Setter Property="Foreground" Value="{Binding FocusedRowForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        </Trigger>
                                    </Style.Triggers>
                                <Setter Property="TextBlock.FontFamily" Value="{Binding RowAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontSize" Value="{Binding RowAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontWeight" Value="{Binding RowAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontStyle" Value="{Binding RowAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                </Style>
                            </dxg:TableView.RowStyle>
                            <dxg:TableView.CellStyle>
                                <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                  <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                                  <Style.Triggers>
                                        <DataTrigger Binding="{Binding RowMinHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                            <Setter Property="MinHeight" Value="{Binding RowMinHeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CellBorderColor, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding CellBorderColor, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=(dxg:GridViewBase.IsFocusedCell), RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding FocusedCellBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Background" Value="{Binding FocusedCellBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=(dxg:GridViewBase.IsFocusedCell), RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding FocusedCellForeground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource ConditionalStyleConverter}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Foreground" Value="{Binding FocusedCellForeground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TableView.CellStyle>
                            <dxg:TableView.PrintColumnHeaderStyle>
                                <Style BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintHeaderStyle}}" TargetType="dxe:TextEdit">
                                    <Setter Property="TextWrapping" Value="{Binding Value, Source={StaticResource colTextWrapKey}}" />
                                </Style>
                            </dxg:TableView.PrintColumnHeaderStyle>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.ColumnSpan="13" Grid.RowSpan="13" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.ColumnSpan="13" Grid.RowSpan="13"
    		    HorizontalAlignment="Center" Visibility="Collapsed" />
                <Border Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BorderThickness="1" BorderBrush="Gray" Background="Black" x:Name="errorWindow"
                    Visibility="Collapsed">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=gridDataControl1, Mode=OneWay}" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2" Text="{x:Static properties:Resources.GridControlError}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Foreground="Red" />
                        <Button Grid.Column="1" Margin="2" Width="24" HorizontalAlignment="Right" Click="errorInfo_ClearMessage">
                            <Button.Content>
                                <Image Source="{DynamicResource Acknowledge}" Height="14" Width="14" />
                            </Button.Content>
                        </Button>
                        <TextBlock x:Name="errorInfo" Grid.Row="1" Grid.ColumnSpan="2" 
                                Margin="2" Foreground="White" Visibility="Visible" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Text="" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

    