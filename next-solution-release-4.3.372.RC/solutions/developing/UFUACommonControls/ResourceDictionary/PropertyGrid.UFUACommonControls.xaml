<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ExpandCollapseGroupStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Border BorderThickness="0" CornerRadius="3" Margin="0,3,2,0" Padding="3,0,0,3">
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <Border BorderThickness="0" Padding="0" CornerRadius="0,3,0,0">
                                    <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding Name}" />
                                </Border>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpandCollapseAdvancedStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Border BorderThickness="0" CornerRadius="3" Margin="20,3,2,0" Padding="3,0,0,3">
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <Border BorderThickness="0" Padding="0" CornerRadius="0,3,0,0">
                                    <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding Name}" />
                                </Border>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
