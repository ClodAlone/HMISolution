<UserControl x:Class="OPCUAClientStatus.OPCUAClientStatusUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    xmlns:properties="clr-namespace:OPCUAClientStatus.Properties"
    Height="400" Width="500">
    
    <UserControl.Resources>
        <DoubleAnimation x:Key="ExplodeAnimation" To="0.2" Duration="0:0:0.3" />
        <DoubleAnimation x:Key="CollapseAnimation" To="0.0" Duration="0:0:0.3" />
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
    </UserControl.Resources>
    <Grid x:Name="mainGrid" PreviewMouseRightButtonDown="treeViewStatus_MouseRightButtonDown" PreviewMouseDown="treeViewStatus_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="textStatus" Orientation="Horizontal">
            <TextBlock x:Name="pendingCount" Text="{x:Static properties:Resources.OPCUAClientStatusPendingCount}"/>
            <TextBlock Text="{Binding PendingCount, Mode=OneWay}"/>
            <TextBlock Text=" | "/>
            <TextBlock x:Name="clientStatusThreads" Text="{x:Static properties:Resources.OPCUAClientStatusThreads}" />
            <TextBlock Text="{Binding ThreadCount, Mode=OneWay}"  />
            <TextBlock Text=" | "/>
            <TextBlock x:Name="clientStatusRefreshRate" Text="{x:Static properties:Resources.OPCUAClientStatusUIRefreshRate}" />
            <TextBlock Text="{Binding UiUpdates, Mode=OneWay}" />
            <TextBlock x:Name="clientStatusAtSeconds" Text="{x:Static properties:Resources.OPCUAClientStatusAtSeconds}" />
            <TextBlock Text=" | "/>
            <TextBlock x:Name="clientStatusServerUpdate" Text="{x:Static properties:Resources.OPCUAClientStatusServerUpdate}" />
            <TextBlock Text="{Binding TicksReceived, Mode=OneWay}" />
            <TextBlock x:Name="clientStatusAtStatus" Text="{x:Static properties:Resources.OPCUAClientStatusAtSeconds}" />
            <TextBlock Text=" | "/>
            <TextBlock x:Name="clientStatusCPU" Text="{x:Static properties:Resources.OPCUAClientStatusCPU}" />
            <TextBlock Text="{Binding CpuPercent, Mode=OneWay}"/>
            <TextBlock x:Name="uiPercent" Text="{x:Static properties:Resources.OPCUAClientStatusPercent}"/>
            <TextBlock Text=" | "/>
            <TextBlock x:Name="uiLatency" Text="{x:Static properties:Resources.OPCUAClientStatusUILatency}" />
            <TextBlock Text="{Binding UiLatency, Mode=OneWay}"  />
            <TextBlock x:Name="miliSeconds" Text="{x:Static properties:Resources.OPCUAClientStatusMiliSeconds}"/>
        </StackPanel>

      <dxg:TreeListControl x:Name="treeListControl" SelectionMode="Row" x:Shared="False"
                                 Grid.Row="1" SelectionChanged="treeListControl_SelectionChanged">
        <dxg:TreeListControl.Columns>
          <dxg:TreeListColumn FieldName="InnerControl" ReadOnly="True">
            <dxg:TreeListColumn.CellTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding Data.InnerControl}"/>
              </DataTemplate>
            </dxg:TreeListColumn.CellTemplate>
          </dxg:TreeListColumn>
          <!-- Validate="OnTreeHeaderValidate" -->
        </dxg:TreeListControl.Columns>
        <dxg:TreeListControl.View>
          <dxg:TreeListView x:Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                  MultiSelectMode="None"
                                  ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                  AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                  ShowColumnHeaders="False" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                                  BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch"  VerticalAlignment="Top"
                                  IsSynchronizedWithCurrentItem="True" AllowDragDrop="False"
                                  NodeExpanding="OnTreeNodeExpanding"  NodeCollapsing="OnTreeNodeCollapsing"
                                  AutoWidth="True">
            <dxg:TreeListView.RowStyle>
              <Style TargetType="{x:Type dxg:RowControl}">
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                      <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Path=Row.InnerControl.DataContext.Connected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Path=Row.InnerControl.DataContext.Connected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="Red" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </dxg:TreeListView.RowStyle>
            <dxg:TreeListView.CellStyle>
              <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}},Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
             </Style>
            </dxg:TreeListView.CellStyle>
          </dxg:TreeListView>
        </dxg:TreeListControl.View>
      </dxg:TreeListControl>

      <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" />
        <Grid Grid.Row="3" x:Name="secondGrid" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label x:Name="LabelSessions" Grid.Row="0" />
            <Label x:Name="LabelSubscriptions" Grid.Row="1" />
            <Label x:Name="LabelMonitoredItems" Grid.Row="2" />
            <dxc:ChartControl Grid.Row="3"  
                              x:Name="c" FontSize="18" BorderBrush="Transparent" dx:ThemeManager.ThemeName="Office2007Black"
                              >
                <dxc:ChartControl.AnimationRecords>
                    <dxc:ChartAnimationRecord x:Name="seriesAnimation">
                        <dxc:ChartAnimationRecord.Animations>
                            <dxc:SeriesAnimation TargetSeries="{Binding ElementName=series}">
                                <dxc:SeriesAnimation.Actions>
                                    <dxc:SeriesSeriesPointsAction />
                                </dxc:SeriesAnimation.Actions>
                            </dxc:SeriesAnimation>
                        </dxc:ChartAnimationRecord.Animations>
                    </dxc:ChartAnimationRecord>
                </dxc:ChartControl.AnimationRecords>
                <dxc:ChartControl.Triggers>
                    <EventTrigger RoutedEvent="dxc:ChartControl.Loaded">
                        <EventTrigger.Actions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="seriesAnimation" Storyboard.TargetProperty="Progress"
                                                         From="0" To="1" Duration="0:0:0.6" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger.Actions>
                    </EventTrigger>
                </dxc:ChartControl.Triggers>
                <dxc:ChartControl.Diagram>
                    <dxc:SimpleDiagram2D>
                        <dxc:SimpleDiagram2D.Series>
                            <dxc:PieSeries2D x:Name="series" ArgumentScaleType="Qualitative" HoleRadiusPercent="0">
                                <dxc:PieSeries2D.PointOptions>
                                    <dxc:PointOptions PointView="ArgumentAndValues">
                                        <dxc:PointOptions.ValueNumericOptions>
                                            <dxc:NumericOptions Format="Percent" Precision="0" />
                                        </dxc:PointOptions.ValueNumericOptions>
                                    </dxc:PointOptions>
                                </dxc:PieSeries2D.PointOptions>
                                <dxc:PieSeries2D.Label>
                                    <dxc:SeriesLabel Visible="True" RenderMode="RectangleConnectedToCenter" />
                                </dxc:PieSeries2D.Label>
                                <dxc:PieSeries2D.Points>
                                    <dxc:SeriesPoint x:Name="sessionSeries" Argument="{x:Static properties:Resources.SessionsChartTooltip}" Value="0" />
                                    <dxc:SeriesPoint x:Name="subscriptionSeries" Argument="{x:Static properties:Resources.SubscriptionsChartTooltip}" Value="0" />
                                    <dxc:SeriesPoint x:Name="monitoredItemSeries" Argument="{x:Static properties:Resources.MonitoredItemsChartTooltip}" Value="0" />
                                </dxc:PieSeries2D.Points>
                            </dxc:PieSeries2D>
                        </dxc:SimpleDiagram2D.Series>
                    </dxc:SimpleDiagram2D>
                </dxc:ChartControl.Diagram>
            </dxc:ChartControl>
        </Grid>
    </Grid>

</UserControl>
