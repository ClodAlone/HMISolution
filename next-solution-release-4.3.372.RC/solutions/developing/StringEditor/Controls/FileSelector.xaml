<UserControl x:Class="StringManager.Controls.FileSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:StringManager.Properties"
             xmlns:lrc="clr-namespace:StringManager.Converters"
             xmlns:src="clr-namespace:WPFUtilities.ImportExportHelpers;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <src:ImportItemsCheckedConverter x:Key="ImportItemsCheckedConverter" />
            <lrc:ExportOptionConverter x:Key="ExportOptionConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Margin="2" FontWeight="Bold" Header="{x:Static properties:Resources.SelectFile}">
            <DockPanel LastChildFill="True" Margin="5">
                <!--<TextBlock DockPanel.Dock="Left"  Margin="2" FontWeight="Normal" MinWidth="80" TextAlignment="Left" Text="{x:Static properties:Resources.ImportEditorFilePath}" />-->
                <Button DockPanel.Dock="Right"  Margin="2" Name="btnOpen" MinWidth="30" Content="..." ToolTip="{x:Static properties:Resources.SelectFile}" Click="SelectFile_Click"></Button>
                <TextBox IsReadOnly="True" Margin="2" TextWrapping="Wrap" Text="{Binding FilePath, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
            </DockPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Margin="2" x:Name="filterSep" Visibility="Visible" FontWeight="Bold" Header="{x:Static properties:Resources.PropertySep}" >
            <StackPanel Margin="5">
                <RadioButton GroupName="SepPropertyGroup" Margin="2" Content="';'"  
                    IsChecked="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                    ConverterParameter={x:Static src:SepType.SemiColon}}">
                </RadioButton>
                <RadioButton GroupName="SepPropertyGroup" Margin="2" Content="','"
                    IsChecked="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                    ConverterParameter={x:Static src:SepType.Colon}}"/>
                <RadioButton GroupName="SepPropertyGroup" Margin="2" Content="Tab"
                    IsChecked="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                    ConverterParameter={x:Static src:SepType.Tab}}">
                </RadioButton>
            </StackPanel>
        </GroupBox>
      <GroupBox Grid.Row="2" Margin="2" x:Name="exportOptions" Visibility="Collapsed" FontWeight="Bold" Header="{x:Static properties:Resources.ExportOptions}" >
        <StackPanel Margin="5">
          <RadioButton GroupName="ExpPropertyGroup" Margin="2" Content="{x:Static properties:Resources.ExportOptionsAll}"
              IsChecked="{Binding ExportOption, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ExportOptionConverter}, 
                      ConverterParameter={x:Static lrc:ExportOption.All}}">
          </RadioButton>
          <RadioButton GroupName="ExpPropertyGroup" Margin="2" Content="{x:Static properties:Resources.ExportOptionsSelected}"
              IsChecked="{Binding ExportOption, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ExportOptionConverter}, 
                      ConverterParameter={x:Static lrc:ExportOption.Selected}}"/>
        </StackPanel>
      </GroupBox>
    </Grid>
</UserControl>
