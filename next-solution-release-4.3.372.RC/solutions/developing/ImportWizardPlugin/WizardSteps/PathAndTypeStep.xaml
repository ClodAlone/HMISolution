<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:ImportWizardPlugin.Properties"
    xmlns:converters="clr-namespace:WizardPluginHelpers.Converters;assembly=WizardPluginHelpers"   
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    x:Class="ImportWizardPlugin.ProjectWizardPathAndType"
    xmlns:sourcefileditor="clr-namespace:ImportWizardPlugin"
    mc:Ignorable="d"
    HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
            <converters:SourceFileConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Left">
      <StackPanel HorizontalAlignment="Center" Orientation="Vertical"  Margin="30">
        <Label HorizontalAlignment="Left" x:Name="sourceFileTitle"
               Content="{x:Static properties:Resources.SourceFileTitle}" />
        <StackPanel Margin="0,2" Orientation="Horizontal" VerticalAlignment="Top"  HorizontalAlignment="Left">
          <TextBox Width="435" x:Name="text" IsReadOnly="False" HorizontalAlignment="Left"
                   Text="{Binding SourceProject, UpdateSourceTrigger=LostFocus, Converter={StaticResource UriConverter}}" />
          <Button Margin="5,0" IsEnabled="{Binding ElementName=Static, Path=IsChecked}"
                              HorizontalAlignment="Left"
                              MinWidth="40" x:Name="btnBrowse1" Click="DlgButton_Click">
            <Button.Content>
              <Image Source="{StaticResource OpenFolder}" Height="16" Width="16" />
            </Button.Content>
          </Button>
        </StackPanel>

        <Label HorizontalAlignment="Left" Margin="0,10,0,0" x:Name="projectName"
               Content="{x:Static properties:Resources.ProjectName}" />
        <TextBox Text="{Binding ProjectName}" VerticalAlignment="Top"  HorizontalAlignment="Left"
                 Grid.Row="1" x:Name="textBoxProjectName"  KeyboardNavigation.DirectionalNavigation="None"
                 Width="478" />

        <Label HorizontalAlignment="Left" Margin="0,10,0,0" x:Name="projectFolder"
               Content="{x:Static properties:Resources.ProjectFolder}" />
        <TextBox Text="{Binding Path=ProjectPath,Mode=OneWay}"
         VerticalAlignment="Top"  HorizontalAlignment="Left" IsEnabled="False"
         Grid.Row="2" TextWrapping="Wrap" x:Name="textBoxProjectPath"
         Width="478" Height="Auto"/>

        <StackPanel Margin="0,2" Orientation="Horizontal">
          <RadioButton x:Name="Static" MinWidth="100" GroupName="Path" Content="{x:Static properties:Resources.UseFolder}"
                       IsChecked="{Binding IsDynamic, Converter={StaticResource RadioButtonCheckedConverter},ConverterParameter=False}"
                   Checked="Static_Checked_1"/>
          <Button Margin="5" IsEnabled="{Binding ElementName=Static, Path=IsChecked}" HorizontalAlignment="Left"  MinWidth="40" x:Name="btnBrowse" Click="btnBrowse_Click">
            <Button.Content>
              <Image Source="{StaticResource OpenFolder}" Height="16" Width="16" />
            </Button.Content>
          </Button>
        </StackPanel>

        <StackPanel Margin="0,2" Orientation="Horizontal" >
          <RadioButton x:Name="Dynamic" MinWidth="100" GroupName="Path" Content="{x:Static properties:Resources.UseConnectionWizard}"
                       IsChecked="{Binding IsDynamic, Converter={StaticResource RadioButtonCheckedConverter},ConverterParameter=True}"
                           Checked="Static_Checked_1"/>

          <Button Margin="5" IsEnabled="{Binding ElementName=Dynamic, Path=IsChecked}" HorizontalAlignment="Left" MinWidth="40" x:Name="btnUseConnectionWizard" Click="btnUseConnectionWizard_Click">
            <Button.Content>
              <Image Source="{StaticResource DataSmall}" Height="16" Width="16" />
            </Button.Content>
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
</UserControl>
