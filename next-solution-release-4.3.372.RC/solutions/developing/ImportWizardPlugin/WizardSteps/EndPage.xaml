<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:ImportWizardPlugin.Properties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="ImportWizardPlugin.EndPage"
    mc:Ignorable="d"
    HorizontalAlignment="Left" VerticalAlignment="Top">
  <Grid HorizontalAlignment="Left">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="2" Grid.Row="7" VerticalAlignment="Center" Orientation="Vertical">
      <StackPanel Orientation="Horizontal">
        <Label x:Name="toFinish" HorizontalAlignment="Left" Content="{x:Static properties:Resources.ToFinish}" HorizontalContentAlignment="Left" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Label x:Name="toCancel" HorizontalAlignment="Left" Content="{x:Static properties:Resources.ToCancel}" HorizontalContentAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
