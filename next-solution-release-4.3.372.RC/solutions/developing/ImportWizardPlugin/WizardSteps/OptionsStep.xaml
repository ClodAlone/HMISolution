<UserControl x:Class="ImportWizardPlugin.ProjectWizardOptionsTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ImportWizardPlugin.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:WizardPluginHelpers.Converters;assembly=WizardPluginHelpers"   
             mc:Ignorable="d" 
    HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/SharedResources;component/Resources/CustomWizard.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <converters:SourceFileToFileNameConverter x:Key="SourceFileToFileNameConverter" />
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Left" >
      <DockPanel HorizontalAlignment="Center" LastChildFill="True" Margin="30">
        <TextBlock VerticalAlignment="Bottom" DockPanel.Dock="Bottom" x:Name="supportedDrivers"
                   Text="{x:Static properties:Resources.SupportedDrivers}" 
                   HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal">
          <StackPanel Orientation="Vertical">
            <!--<Label HorizontalAlignment="Left" Content="{x:Static properties:Resources.Import}" x:Name="import"/>-->
            <CheckBox  Margin="0" Grid.ColumnSpan="3" Grid.Row="0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="import" Content="{x:Static properties:Resources.SelectAll}" Checked="checkboxAll_Checked" Unchecked="checkboxAll_Unchecked"/>           
            <CheckBox Tag="Alarm"  Margin="10,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxAlarms" Content="{x:Static properties:Resources.ImportAlarms}"/>
            <CheckBox Tag="Driver"  Margin="10,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDrivers" Content="{x:Static properties:Resources.ImportDrivers}"/>
            <CheckBox Tag="Tag"  Margin="10,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxTags" Content="{x:Static properties:Resources.ImportTags}"/>
            <CheckBox Tag="DLR"  Margin="10,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLRs" Content="{x:Static properties:Resources.ImportDLRs}"/>
            <CheckBox Tag="Screen" Margin="10,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxScreens" Content="{x:Static properties:Resources.ImportScreens}"/>
            <CheckBox Tag="Recipe" Margin="10,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxRecipes" Content="{x:Static properties:Resources.ImportRecipes}"/>
            
            <Label Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static properties:Resources.EnableLog}" x:Name="enableLog"/>
            <CheckBox Margin="0,2,0,0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxImported" Content="{x:Static properties:Resources.ImportedLog}"/>
            <CheckBox Margin="0,2,0,0" Width="Auto" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxNotImported" Content="{x:Static properties:Resources.NotImportedLog}"/>
          </StackPanel>
          <StackPanel Orientation="Vertical" Margin="20,0,0,0">
            <CheckBox  Margin="0" IsChecked="False" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxString" Content="{x:Static properties:Resources.ImportString}"/>
            <Grid IsEnabled="{Binding ElementName=checkboxString, Path=IsChecked}" Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddButtonTitle}" Margin="0,5,5,5">
                <Button.Content>
                  <Image Margin="2" Source="{StaticResource CWAddNew}" Height="16" Width="16" />
                </Button.Content>
              </Button>
              <Button IsEnabled="False" Grid.Column="1" x:Name="btnDelete"
                              ToolTip="{x:Static properties:Resources.DeleteButtonTitle}" Click="OnDelete" Margin="5,5,0,5">
                <Button.Content>
                  <Image Margin="2" Source="{StaticResource CWMinus}" Height="16" Width="16" />
                </Button.Content>
              </Button>
            </Grid>
            <dxg:GridControl Margin="0,2,0,0" IsEnabled="{Binding ElementName=checkboxString, Path=IsChecked}"
              Name="gridControl" MinWidth="100" Height="168">
              <dxg:GridControl.Columns>
                <dxg:GridColumn ToolTip="{Binding Path=FileName, Mode=OneWay}" Header="{x:Static properties:Resources.StringHeader}"  x:Name="stringHeader">
                  <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                      <DockPanel LastChildFill="True" ToolTip="{Binding Data.FileName}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <TextBlock IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    ToolTip="{Binding Data.FileName}" Text="{Binding Data.FileName, Converter={StaticResource SourceFileToFileNameConverter}, Mode=OneWay}" />
                      </DockPanel>
                    </DataTemplate>
                  </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn  DisplayMemberBinding="{Binding Path=Culture, Mode=TwoWay}" Header="{x:Static properties:Resources.StringCulture}"  x:Name="stringCulture">
                  <dxg:GridColumn.EditTemplate>
                    <ControlTemplate>
                      <dxe:ComboBoxEdit Name="PART_Editor"
                                HorizontalContentAlignment="Left"
                                EditValue="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                                SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                                SelectedIndexChanged="PART_Editor_SelectedIndexChanged"
                                EditorActivated="CULTURE_Editor_DropDownOpened"
                                IsTextEditable="False"
                                AllowNullInput="False"
                                AcceptsReturn="False"
                                ImmediatePopup="True">
                      </dxe:ComboBoxEdit>
                    </ControlTemplate>
                  </dxg:GridColumn.EditTemplate>
                </dxg:GridColumn>
              </dxg:GridControl.Columns>
              <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False"
                   FocusedRowChanged="tableView_FocusedRowChanged" />
              </dxg:GridControl.View>
            </dxg:GridControl>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Grid>
</UserControl>
