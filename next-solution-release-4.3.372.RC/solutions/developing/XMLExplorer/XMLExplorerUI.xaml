<UserControl x:Class="XMLExplorer.XMLExplorerUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:local="clr-namespace:XMLExplorer" 
    Height="300" Width="300">
    <Grid>
      <dx:DXTabControl x:Name="TabControl" Visibility="Collapsed"  VerticalAlignment="Stretch">
        <dx:DXTabControl.View>
          <dx:TabControlScrollView HeaderLocation="Top"/>
        </dx:DXTabControl.View>
      </dx:DXTabControl>
        <TextBlock x:Name="TextNoItems" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static local:Properties.Resources.NoItemsAvailable}"/>
    </Grid>
</UserControl>
