<UserControl x:Class="DriverCodeBaseEx.UI.Controls.TCPChannelSettingsUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="TCPStack" Orientation="Vertical">
        <Grid x:Name="tcpGrid" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--<GridSplitter Grid.Column="1" Grid.RowSpan="6" HorizontalAlignment="Stretch" Background="Transparent" />-->
            <TextBlock Name="TxBHostName" Text="{x:Static properties:Resources.HostName}" VerticalAlignment="Center" Grid.Row="0" Margin="0,1" x:FieldModifier="public"/>
            <TextBox x:Name="HostName" Grid.Column="2" Grid.Row="0" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding TcpChannelSettingsHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="0" Grid.Column="3" 
            Content="{Binding ElementName=HostName, Path=(Validation.Errors).CurrentItem}" Height="18" VerticalAlignment="Top"/>

            <TextBlock Name="TxBHostPort" Text="{x:Static properties:Resources.HostPort}" VerticalAlignment="Center" Grid.Row="1" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="HostPort" Grid.Column="2" Grid.Row="1" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding TcpChannelSettingsHostPort, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=HostPort, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBBackupHostName" Text="{x:Static properties:Resources.BackupHostName}" VerticalAlignment="Center" Grid.Row="2" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="BackupHostName" Grid.Column="2" Grid.Row="2" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding TcpChannelSettingsBackupHostName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=BackupHostName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Name="TxBSwitchHostTimeout" Text="{x:Static properties:Resources.SwitchHostTimeout}" VerticalAlignment="Center" Grid.Row="3" Margin="0,1" x:FieldModifier="public"/>
            <TextBox Name="SwitchHostTimeout" Grid.Column="2" Grid.Row="3" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding TcpChannelSettingsSwitchHostTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=SwitchHostTimeout, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </StackPanel>
</UserControl>
