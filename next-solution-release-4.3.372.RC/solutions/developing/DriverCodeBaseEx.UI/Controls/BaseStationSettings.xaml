<UserControl x:Class ="DriverCodeBaseEx.UI.Controls.BaseStationSettings"
             x:ClassModifier="public"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:local="clr-namespace:DriverCodeBaseEx.Converters;assembly=DriverCodeBaseEx"
             xmlns:locControls="clr-namespace:DriverCodeBaseEx.UI.Controls"
             xmlns:locSettingsControls="clr-namespace:DriverCodeBaseEx.UI.SettingsControls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <local:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>            
        </Grid.RowDefinitions>

        <!--<GridSplitter Grid.Column="1" Grid.RowSpan="5" HorizontalAlignment="Stretch" Background="Transparent" />-->
        <TextBlock Text="{x:Static properties:Resources.Name}" VerticalAlignment="Center" x:FieldModifier="public" Name="ChNameText" Grid.Row="0" Margin="0,1"/>
        <TextBox Name="ChName" Grid.Column="2" Grid.Row="0" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="ChNameErr"
            Content="{Binding ElementName=ChName, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.MaxRetryBeforeError}" VerticalAlignment="Center" x:FieldModifier="public" Name="MaxRetryText" Grid.Row="2" Margin="0,1"/>
        <TextBox Name="MaxRetry" Grid.Column="2" Grid.Row="2" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding MaxRetriesBeforeError, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
        <ContentPresenter Grid.Row="2" Grid.Column="3" x:FieldModifier="public" Name="MaxRetryErr"
            Content="{Binding ElementName=MaxRetry, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.Channel}" VerticalAlignment="Center" x:FieldModifier="public" Name="CmbChannelText" Grid.Row="1" Margin="0,1"/>
        <ComboBox x:FieldModifier="public" Name="CmbChannel" Grid.Column="2" Grid.Row="1" 
                  DisplayMemberPath="Name"
                  SelectedValuePath="Name"
                  SelectedValue="{Binding Channel, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5">
        </ComboBox>
        <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="CmbChannelErr"
            Content="{Binding ElementName=CmbChannel, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.CaptionStateVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TXBStateVariable" Grid.Row="3" Margin="0,5"/>
        <locSettingsControls:BrowseTag x:FieldModifier="public" x:Name="DKPStateVariable" Grid.Column="2" Grid.Row="3"
            Tag="{Binding StateTag, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
        <ContentPresenter Grid.Row="3" Grid.Column="3" x:FieldModifier="public" Name="DKStateVariableErr"
            Content="{Binding ElementName=DKPStateVariable, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.CaptionCommandVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TXBCommandVariable" Grid.Row="4" Margin="0,5"/>
        <locSettingsControls:BrowseTag x:FieldModifier="public" x:Name="DKPCommandVariable" Grid.Column="2" Grid.Row="4"
            Tag="{Binding CommandTag, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
        <ContentPresenter Grid.Row="4" Grid.Column="3" x:FieldModifier="public" Name="DKPCommandVariableErr"
            Content="{Binding ElementName=DKPCommandVariable, Path=(Validation.Errors).CurrentItem}"/>        
        
        <TextBlock x:FieldModifier="public" Name="TxBkAllowRewritingOfTheSameValue" Text="{x:Static properties:Resources.AllowRewritingOfTheSameValue}" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
        <CheckBox x:FieldModifier="public" Name="CheckAllowRewritingOfTheSameValue" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" Margin="0,5"
                  IsChecked="{Binding RewritingOfTheSameValue, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="5" Grid.Column="3" 
            Content="{Binding ElementName=CheckAllowRewritingOfTheSameValue, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.DisableQualityUpdate}" VerticalAlignment="Center" x:FieldModifier="public" Name="CheckDisableQualityUpdateText" Grid.Row="6"  Margin="0,5"/>
        <CheckBox VerticalAlignment="Center" x:Name="CheckDisableQualityUpdate" x:FieldModifier="public" Margin="0,5" Grid.Row="6" Grid.Column="2"
                  IsChecked="{Binding DisableQualityUpdate, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="6" Grid.Column="3" x:FieldModifier="public" Name="CheckDisableQualityUpdateErr"
            Content="{Binding ElementName=CheckDisableQualityUpdate, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
