<UserControl x:Class="DriverCodeBaseEx.UI.Controls.BaseTestConnectionInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DriverCodeBaseEx.UI.Controls"
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             mc:Ignorable="d" d:DesignWidth="400" Height="Auto" Width="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="MainStack" Orientation="Vertical">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Name="TextStateInfo" Grid.Row="0" Background="Transparent" BorderThickness="0" TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,5"/>
            <TextBox x:Name="TextBoxInfo" Height="350" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" FontSize="14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,5"/>
            <Button Content="{x:Static properties:Resources.CaptionCopyInfo}" Grid.Row="2" Width="150" Click="Button_Click" IsDefault="True" HorizontalAlignment ="Left" Margin="0,5"/>
        </Grid>
    </StackPanel>
</UserControl>
