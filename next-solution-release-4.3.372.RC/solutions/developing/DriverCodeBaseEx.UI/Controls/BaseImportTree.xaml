<UserControl x:Class="DriverCodeBaseEx.UI.Controls.BaseImportTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:locControls="clr-namespace:DriverCodeBaseEx.UI.Controls"
             xmlns:local="clr-namespace:DriverCodeBaseEx.Converters;assembly=DriverCodeBaseEx"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" MinHeight="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <Style x:Key="CustomListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#FF2C2C2C"></Setter>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FF262626"></Setter>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="true">
                        <Setter Property="Background" Value="Gray" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <local:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="11.844*"/>
            <RowDefinition Height="13.116*"/>
            <RowDefinition Height="400*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtImportTreeTitle" Text="{x:Static properties:Resources.ImportTreeTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"  />
        <Grid x:Name="ButtonGrid" Grid.Row="1" Margin="0,0,0,5" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0" Width="*" />
                <ColumnDefinition x:Name="Col1" Width="*" />
                <ColumnDefinition x:Name="Col2" Width="*" />
                <ColumnDefinition x:Name="Col3" Width="*" />
                <ColumnDefinition x:Name="Col4" Width="*" />
                <ColumnDefinition x:Name="Col5" Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnOpen"  Content="{x:Static properties:Resources.LoadFile}" Click="LoadFile_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnGetPLCTags"  Content="{x:Static properties:Resources.GetPLCTags}" Click="GetPlc_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnSelAll"  Content="{x:Static properties:Resources.SelectAll}" Click="SelAll_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnClear"  Content="{x:Static properties:Resources.SelectNone}" Click="Clear_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnImport"  Content="{x:Static properties:Resources.ImportTags}" Click="Import_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="5" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnUpdateSymbol"  Content="{x:Static properties:Resources.UpdateSymbol}" Click="Update_Click"></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>
            <dxg:TreeListControl x:Name="ImportTreeListControl" SelectionMode="Row" Margin="0,0,0,5">
                <dxg:TreeListControl.View>
                    <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                        ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                        AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                        ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" 
                                        NodeExpanding="OnTreeNodeExpanding" 
                                        ShowHorizontalLines="False" ShowIndicator="False" IsSynchronizedWithCurrentItem="True">
                        <dxg:TreeListView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:TreeListView.RowStyle>
                        <dxg:TreeListView.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                            </Style>
                        </dxg:TreeListView.CellStyle>
                    </dxg:TreeListView>
                </dxg:TreeListControl.View>
            </dxg:TreeListControl>
        </Grid>
        <Grid x:Name="GridStation" Grid.Row="4"  VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="131*"/>
                <ColumnDefinition Width="133*" />
                <ColumnDefinition Width="133*" />
                <ColumnDefinition Width="400*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox Name="AddStationName" Grid.Column="0" VerticalAlignment="Center" Content ="{x:Static properties:Resources.ImportTreeAddStationName}"  Grid.ColumnSpan="2" />
            <TextBlock Text="{x:Static properties:Resources.ImportTreeStation}" Grid.Column="3" VerticalAlignment="Center"   />
            <ComboBox Name="CmbStation"  Grid.Column="4" VerticalAlignment="Center" 
                          IsEditable="False" IsReadOnly="True" SelectionChanged="CmbStation_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,27,0,0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="131*" />
                <ColumnDefinition Width="133*" />
                <ColumnDefinition Width="133*" />
                <ColumnDefinition Width="399*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Name="ImportFolder" Text="{x:Static properties:Resources.ImportTreeTagFolder}" VerticalAlignment="Center" Grid.Column="2"   HorizontalAlignment="Left"  Width="auto"/>
            <locControls:FolderCommand Grid.Column="3" x:FieldModifier="public"  x:Name="DKPFolderCommandVariable" Grid.RowSpan="2" VerticalAlignment="Center" />

            <ContentPresenter Grid.Column="3" 
            Content="{Binding ElementName=DKPFolderCommandVariable, Path=(Validation.Errors).CurrentItem}" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="6" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="133*" />
                <ColumnDefinition Width="196*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="133*" />
                <ColumnDefinition Width="196*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Name="txtBehaviorExistingTag" Text="{x:Static properties:Resources.ImportBehaviorForExistingTags}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"   HorizontalAlignment="Left"  Width="auto" Margin="0,5"/>
            <ComboBox Name="cmbBehaviorExistingTag"  Grid.Column="1"  Grid.Row="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                           IsEditable="False" IsReadOnly="True" Margin="0,5"/>
            <TextBlock Name="txtBehaviorDynamicLink" Text="{x:Static properties:Resources.ImportBehaviorForDynamicLink}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="3"   HorizontalAlignment="Left"  Width="auto" Margin="0,5"/>
            <ComboBox Name="cmbBehaviorDynamicLink"  Grid.Column="4"  Grid.Row="1" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key"
                          IsEditable="False" IsReadOnly="True" Margin="0,5"/>
        </Grid>
    </Grid>
</UserControl>