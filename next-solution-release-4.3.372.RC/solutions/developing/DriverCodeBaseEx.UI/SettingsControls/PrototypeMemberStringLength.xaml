<UserControl x:Class="DriverCodeBaseEx.UI.SettingsControls.PrototypeMemberStringLength"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             mc:Ignorable="d" Width="400" Height="300"
             d:DesignHeight="400" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>            
            <RowDefinition Height="100*"/>            
        </Grid.RowDefinitions>        
        <Grid Grid.Row="0" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <dxg:TreeListControl Name="treeListControl" SelectionMode="None">
            <dxg:TreeListControl.Columns >
                <dxg:TreeListColumn FieldName="NameC" FilterPopupMode="Excel" Header="{x:Static properties:Resources.CaptionMemberName}" />
                    <dxg:TreeListColumn FieldName="DataType" FilterPopupMode="Excel" Header="{x:Static properties:Resources.CaptionMemberDataType}" />
                    <dxg:TreeListColumn FieldName="StringLength" FilterPopupMode="Excel" Header="{x:Static properties:Resources.CaptionMemberStringLength}" AllowEditing="True"/>
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="treeListView" NavigationStyle="Cell" AllowTreeIndentScrolling="True" AllowSorting="False"
                    ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                    AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                    ShowColumnHeaders="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                    IsSynchronizedWithCurrentItem="True" CustomColumnDisplayText="treeListView_CustomColumnDisplayText"
                    HiddenEditor="treeListView_HiddenEditor" ValidateCell="treeListView_ValidateCell" ShowingEditor="treeListView_ShowingEditor" InvalidNodeException="treeListView_InvalidNodeException"
                    >
                    <dxg:TreeListView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <!--<Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />-->
                                    </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TreeListView.RowStyle>
                        <dxg:TreeListView.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                <Setter Property="MinHeight" Value="25" />
                            </Style>
                        </dxg:TreeListView.CellStyle>
                    </dxg:TreeListView>
            </dxg:TreeListControl.View>           
            </dxg:TreeListControl>
        </Grid>
        <!--<TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Run Text="{x:Static properties:Resources.PrototypeMemberSizeMaxValueCaption}"/>
            <Run Text="{Binding MaxStringLength, Mode=OneWay}"/>
        </TextBlock>-->        
    </Grid>
</UserControl>
