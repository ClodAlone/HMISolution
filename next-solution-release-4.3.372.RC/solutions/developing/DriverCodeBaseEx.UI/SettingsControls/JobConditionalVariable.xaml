<UserControl x:Class="DriverCodeBaseEx.UI.SettingsControls.JobConditionalVariable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBaseEx.UI.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:locSettingsControls="clr-namespace:DriverCodeBaseEx.UI.SettingsControls"
             xmlns:localConv="clr-namespace:DriverCodeBaseEx.Converters;assembly=DriverCodeBaseEx"
             x:Name="ConditionalVariableMain"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <localConv:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.JobConditionalVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TXBJobConditionalVariable" Margin="0,1"/>
        <locSettingsControls:BrowseTag x:FieldModifier="public" x:Name="DKPStateVariable" Margin="0,5,0,5" Grid.Column="2" Grid.Row="5"
            Tag="{Binding ConditionalVariableTag, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{x:Null}" />
        </Grid>
</UserControl>
