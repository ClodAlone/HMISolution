<UserControl x:Class="StartupWelcome.Controls.WorkspaceLayoutManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:StartupWelcome.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel x:Name="layoutNameDockPanel" LastChildFill="True">
            <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resources.LayoutName}" Margin="5" />
            <dxe:TextEdit DockPanel.Dock="Right" Validate="OnValidating" InvalidValueBehavior="AllowLeaveEditor" ValidateOnTextInput="True" Margin="5" MinWidth="50" NullText="{x:Static properties:Resources.EnterLayoutName}" EditValue="{Binding SavedLayoutName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="5" LastChildFill="True">
            <TextBlock Text="{x:Static properties:Resources.AvailableLayoutsList}" Margin="5" HorizontalAlignment="Center" DockPanel.Dock="Top" />
            <dxg:GridControl MinHeight="10" MinWidth="10" DockPanel.Dock="Bottom"
                                    AutoExpandAllGroups="True"
                                    AutoGenerateColumns="AddNew"
                                    SelectionMode="Row"
                                    SelectionChanged="gridControl_SelectionChanged"
                                    Name="gridControl" 
                                    ShowLoadingPanel="True"
                                    ItemsSource="{Binding LayoutsList, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                    AutoPopulateColumns="False" 
                                    AllowDrop="False" 
                                    AllowLiveDataShaping="False"
                                    PreviewKeyDown="GridControl_PreviewKeyDown"
                                    dx:DXSerializer.SerializationID="gridDataControl" 
                                    dx:DXSerializer.StoreLayoutMode="All" 
                                    dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                    dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" FieldName="Name" Header="{x:Static properties:Resources.LayoutNameColumnHeader}"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>

                    <dxg:TableView x:Name="tableView" AllowEditing="False"
                                AutoWidth="True"
                                RowDoubleClick="OnRowDoubleClick"
                                FadeSelectionOnLostFocus="False" 
                                BestFitMode="VisibleRows"
                                AllowBestFit="True" 
                                AllowResizing="True"
                                ShowGroupPanel="False"
                                ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                                SearchPanelHorizontalAlignment="Stretch"
                                ShowSearchPanelMRUButton="True"
                                ShowFilterPanelMode="ShowAlways" 
                                NavigationStyle="Row" 
                                MultiSelectMode="None">
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </DockPanel>
    </Grid>
</UserControl>
