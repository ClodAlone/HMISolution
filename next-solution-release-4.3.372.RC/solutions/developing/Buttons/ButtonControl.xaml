<Button x:Class="Buttons.ButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="120" Height="30" 
             xmlns:properties="clr-namespace:Buttons.Properties" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"    
             ClickMode="Release" 
             PreviewTouchDown="Button_PreviewTouchDown" 
             PreviewTouchUp="Button_PreviewTouchUp"
             MouseLeave="Button_MouseLeave"
             MouseEnter="Button_MouseEnter"
             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
</Button>

