<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:effects="clr-namespace:ShaderEffects;assembly=ShaderEffects"
             xmlns:local="clr-namespace:SymbolGallery"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar" 
             x:Class="SymbolGallery.CarouselListControl"
             x:Name="symbolgallery"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/SymbolGallery.xaml" />
      </ResourceDictionary.MergedDictionaries>

        <DataTemplate x:Key="CopyLinkImage">
            <Image Source="{StaticResource SGLink}" Stretch="None" VerticalAlignment="Bottom" ToolTip="{x:Static local:Properties.Resources.Linked}"
                   HorizontalAlignment="Right" Margin="2, 2, 2, 2" IsHitTestVisible="False"/>
        </DataTemplate>
        <DataTemplate x:Key="ItemTemplate">
            <Viewbox Stretch="UniformToFill" >
                <Button x:Name="btn" ClipToBounds="False" Width="200" Height="200"
                    Margin="20, 20, 20, 20" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                    PreviewMouseDoubleClick="Button_PreviewMouseDoubleClick"
                    PreviewMouseDown="Button_PreviewMouseDown" PreviewMouseMove="Button_PreviewMouseMove" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button.ContextMenu>

                        <ContextMenu HasDropShadow="True" Opened="cm_Opened">
                            <MenuItem Header="{x:Static local:Properties.Resources.EditCode}" Click="Button_Code" x:Name="menuCode"/>
                            <MenuItem Header="{x:Static local:Properties.Resources.Remove}" Click="Button_Remove" x:Name="menuRemove"/>
                        </ContextMenu>

                    </Button.ContextMenu>
                    <Button.Resources>
                        <Storyboard x:Key="MouseOver">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1.3" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>

                        <Storyboard x:Key="MouseLeave">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="1" KeySpline="0,0,0.5,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </Button.Resources>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource MouseOver}" x:Name="MouseOver_BeginStoryboard" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource MouseLeave}" x:Name="MouseLeave_BeginStoryboard" />
                        </EventTrigger>
                    </Button.Triggers>
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <SkewTransform AngleX="0" AngleY="0" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Button.Effect>
                        <effects:ReflectionEffect InputHeight="{Binding ActualHeight, ElementName=btn}" />
                    </Button.Effect>
                </Button>
            </Viewbox>
        </DataTemplate>
        <local:DoubleToIntConverter x:Key="DoubleToIntConverter" />
        <local:BoolToVisibilityCollapseConverter x:Key="BoolToVisibilityCollapseConverter"/>
        <local:BoolToVisibilityHideConverter x:Key="BoolToVisibilityHideConverter"/>
    </ResourceDictionary>

  </UserControl.Resources>

    <Grid>
        <dx:DXTabControl x:Name="tabControl" SelectionChanged="tabControl_SelectionChanged">
            <dx:DXTabItem Header="{x:Static local:Properties.Resources.StaticHeaderText}" 
                          x:Name="tabStatic" Glyph="{StaticResource SGStaticSmall}" IsSelected="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                    <ListBox x:Name="Gallery" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                             Visibility="{Binding ViewModel.IsGridMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}"
                                             Background="Transparent" >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <cc:CarouselControl x:Name="Carousel" 
                                         Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}"
                                        RenderTransformOrigin="0.5,0.5" Background="Transparent" 
                                        Fade="0.5" LookDownOffset="20" RotationSpeed="100" Scale="0.8" />

                    <Grid HorizontalAlignment="Center" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="2,2,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Content="&lt;" Click="Button_Prev" Background="Transparent" BorderBrush="Transparent" 
                                            Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}" />
                        <Button Visibility="Collapsed" Grid.Column="1" Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="{x:Static local:Properties.Resources.EditCode}" Click="Button_Code" Background="Transparent" BorderBrush="Transparent" x:Name="btnCode" IsEnabled="False"/>
                        <Button Visibility="Collapsed" Grid.Column="2" Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="{x:Static local:Properties.Resources.Remove}" Click="Button_Remove" Background="Transparent" BorderBrush="Transparent" x:Name="btnRemove" IsEnabled="False"/>
                        <Button Grid.Column="3" Margin="2,2,2,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Content="&gt;" Click="Button_Next" Background="Transparent" BorderBrush="Transparent" 
                                            Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}" />
                    </Grid>

                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem Header="{x:Static local:Properties.Resources.DigitalHeaderText}" 
                          x:Name="tabDigital" Glyph="{StaticResource SGDigital}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                    <ListBox x:Name="GalleryDigital" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                             Visibility="{Binding ViewModel.IsGridMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}"
                                             Background="Transparent" >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <cc:CarouselControl x:Name="CarouselDigital" 
                                         Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}"
                                        RenderTransformOrigin="0.5,0.5" Background="Transparent" 
                                        Fade="0.5" LookDownOffset="20" RotationSpeed="100" Scale="0.8" />

                    <Grid HorizontalAlignment="Left"  Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Margin="2" x:Name="toggleAnimate" Click="ToggleButton_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="{x:Static local:Properties.Resources.EnableAnimation}" Background="Transparent" BorderBrush="Transparent" />
                    </Grid>
                    <Grid HorizontalAlignment="Center" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="2,2,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Content="&lt;" Click="ButtonDigital_Prev" Background="Transparent" BorderBrush="Transparent" 
                                            Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}" />
                        <Button Visibility="Collapsed" Grid.Column="1" Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="{x:Static local:Properties.Resources.EditCode}" Click="ButtonDigital_Code" Background="Transparent" BorderBrush="Transparent" x:Name="btnCodeDigital" IsEnabled="False"/>
                        <Button Grid.Column="2" Margin="2,2,2,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Content="&gt;" Click="ButtonDigital_Next" Background="Transparent" BorderBrush="Transparent" 
                                            Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}" />
                    </Grid>

                
              </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem Header="{x:Static local:Properties.Resources.AnalogHeaderText}" 
                          x:Name="tabAnalog" Glyph="{StaticResource SGAnalogSmall}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                    <ListBox x:Name="GalleryAnalog" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                             Visibility="{Binding ViewModel.IsGridMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}"
                                             Background="Transparent" >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <cc:CarouselControl x:Name="CarouselAnalog" 
                                         Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}"
                                        RenderTransformOrigin="0.5,0.5" Background="Transparent" 
                                        Fade="0.5" LookDownOffset="20" RotationSpeed="100" Scale="0.8" />

                    <Grid HorizontalAlignment="Left"  Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Margin="2" x:Name="toggleAnalogAnimate" Click="ToggleAnalogButton_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="{x:Static local:Properties.Resources.EnableAnimation}" Background="Transparent" BorderBrush="Transparent" />
                    </Grid>
                    <Grid HorizontalAlignment="Center" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="2,2,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Content="&lt;" Click="ButtonAnalog_Prev" Background="Transparent" BorderBrush="Transparent" 
                                            Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}" />
                        <Button Visibility="Collapsed" Grid.Column="1" Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="{x:Static local:Properties.Resources.EditCode}" Click="ButtonAnalog_Code" Background="Transparent" BorderBrush="Transparent" x:Name="btnCodeAnalog" IsEnabled="False"/>
                        <Button Grid.Column="2" Margin="2,2,2,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Content=">" Click="ButtonAnalog_Next" Background="Transparent" BorderBrush="Transparent" 
                                            Visibility="{Binding ViewModel.IsCarouselMode, Converter={StaticResource BoolToVisibilityCollapseConverter}, ElementName=symbolgallery}" />
                    </Grid>

                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>
        
        <ProgressBar x:Name="progressBar" IsIndeterminate="True" Background="Transparent"
                     Visibility="Collapsed" Height="10" VerticalAlignment="Center" Margin="2,2,2,2"/>
    </Grid>
</UserControl>
