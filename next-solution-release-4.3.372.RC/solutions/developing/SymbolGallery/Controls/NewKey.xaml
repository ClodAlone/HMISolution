<UserControl x:Class="SymbolGallery.Controls.NewKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:SymbolGallery.Properties"
             Height="200" Width="400">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Title" Margin="20,10,10,10" FontSize="20" FontFamily="Segoe UI"  FontWeight="Bold" Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewKeyTitle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock FontFamily="Segoe UI"  Grid.Row="1" Text="{x:Static properties:Resources.EnterKeyKey}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="1" x:Name="keyBox" Margin="10,10,10,10" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBlock FontFamily="Segoe UI"  Grid.Row="2" Text="{x:Static properties:Resources.EnterKeyVerifyKey}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="2" x:Name="verifykeyBox" Margin="10,10,10,10" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
