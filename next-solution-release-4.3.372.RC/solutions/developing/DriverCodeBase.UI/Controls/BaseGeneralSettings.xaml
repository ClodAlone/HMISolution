<UserControl x:Class="DriverCodeBase.UI.Controls.BaseGeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBase.UI.Properties"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:local="clr-namespace:DriverCodeBase.Converters;assembly=DriverCodeBase"
             xmlns:locControls="clr-namespace:DriverCodeBase.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <local:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--<GridSplitter Grid.Column="1" Grid.RowSpan="6" HorizontalAlignment="Stretch" Background="Transparent" />-->
        <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.Enable}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textBlockEnable" Margin="0,1"/>
        <CheckBox Grid.Row="0" Grid.Column="2" Name="Enable" VerticalAlignment="Center" Margin="0,5"
                    x:FieldModifier="public" IsChecked="{Binding Enable, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Static properties:Resources.AggregationThreshold}"  VerticalAlignment="Center" x:FieldModifier="public" x:Name="AggregationThresholdText" Grid.Row="1" Margin="0,1"/>
        <TextBox Name="AggregationThreshold" Grid.Column="2" Grid.Row="1" x:FieldModifier="public" Text="{Binding AggregationThreshold, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged }"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="AggregationThresholdErr"
        Content="{Binding ElementName=AggregationThreshold, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.AggregationLimit}"  VerticalAlignment="Center" x:FieldModifier="public" x:Name="AggregationLimitText" Grid.Row="2" Margin="0,1"/>
        <TextBox Name="AggregationLimit" Grid.Column="2" Grid.Row="2" x:FieldModifier="public" Text="{Binding AggregationLimit, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"></TextBox>
        <ContentPresenter Grid.Row="2" Grid.Column="3" x:FieldModifier="public" Name="AggregationLimitErr"
        Content="{Binding ElementName=AggregationLimit, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.SynchAtStartup}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textBlockSynchAtStartup" Margin="0,1"/>
        <CheckBox  Grid.Row="3" Grid.Column="2" Name="SynchAtStartup" VerticalAlignment="Center"  Margin="0,5"
                    x:FieldModifier="public" IsChecked="{Binding SyncAtStartup, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.WriteAsync}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textBlockWriteAsync" Margin="0,1"/>
        <CheckBox  Grid.Row="4" Grid.Column="2" Name="WriteAsync" VerticalAlignment="Center"  Margin="0,5"
                    x:FieldModifier="public" IsChecked="{Binding WriteAsync, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />

        
        <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.EnableStatistic}" VerticalAlignment="Center" x:FieldModifier="public" x:Name="textBlockEnableStatistic" Margin="0,1"/>
        <CheckBox  Grid.Row="5" Grid.Column="2" Name="EnableStatistic" VerticalAlignment="Center"  Margin="0,5"
                    x:FieldModifier="public" IsChecked="{Binding EnableStatistics, ValidatesOnDataErrors=True,UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Static properties:Resources.StateCommandVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TXBStateCommandVariable" Grid.Row="6" Margin="0,1"/>
        <locControls:StateCommand Grid.Row="6" Grid.Column="2" x:FieldModifier="public"  x:Name="DKPStateCommandVariable"/>
        <ContentPresenter Grid.Row="6" Grid.Column="3" 
        Content="{Binding ElementName=uriButton, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
