<UserControl x:Class="DriverCodeBase.UI.Controls.BaseDynamicSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DriverCodeBase.UI.Properties"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="B" Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition SharedSizeGroup="E" Width="Auto"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--<GridSplitter Grid.Column="1" Grid.RowSpan="8" HorizontalAlignment="Stretch" Background="Transparent" />-->
        <TextBlock Text="{x:Static properties:Resources.LinkType}" VerticalAlignment="Center" x:FieldModifier="public" Name="CmbLinkTypeText" Grid.Row="0" Margin="0,1"/>
        <ComboBox Name="CmbLinkType" Grid.Column="2" Grid.Row="0"  x:FieldModifier="public"  
                  SelectedIndex="{Binding Path=TagLinkType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  Margin="0,5">
        </ComboBox>
        <ContentPresenter Grid.Row="0" Grid.Column="3" x:FieldModifier="public" Name="CmbLinkTypeErr"
            Content="{Binding ElementName=CmbLinkType, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.Station}" VerticalAlignment="Center" x:FieldModifier="public" Name="CmbStationText" Grid.Row="1" Margin="0,1"/>
        <ComboBox Name="CmbStation" Grid.Column="2" Grid.Row="1" x:FieldModifier="public"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Name"
                  SelectedValue="{Binding StationName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                  Margin="0,5">
        </ComboBox>
        <ContentPresenter Grid.Row="1" Grid.Column="3" x:FieldModifier="public" Name="CmbStationErr"
            Content="{Binding ElementName=CmbStation, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.SwapBytes}" VerticalAlignment="Center" x:FieldModifier="public" Name="CheckSwapBytesText" Grid.Row="2" Margin="0,1"/>
        <CheckBox Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" x:Name="CheckSwapBytes" x:FieldModifier="public" Margin="0,5"
                  IsChecked="{Binding SwapBytes, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="2" Grid.Column="3" x:FieldModifier="public" Name="CheckSwapBytesErr"
            Content="{Binding ElementName=CheckSwapBytes, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.SwapWords}" VerticalAlignment="Center" x:FieldModifier="public" Name="CheckSwapWordsText" Grid.Row="3" Margin="0,1"/>
        <CheckBox Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" x:Name="CheckSwapWords" x:FieldModifier="public" Margin="0,5"
                  IsChecked="{Binding SwapWords, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
        <ContentPresenter Grid.Row="3" Grid.Column="3" x:FieldModifier="public" Name="CheckSwapWordsErr"
            Content="{Binding ElementName=CheckSwapWords, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.OutputAtStartup}" VerticalAlignment="Center" x:FieldModifier="public" Name="OutputAtStartupText" Grid.Row="4" Margin="0,1"/>
        <CheckBox Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" x:FieldModifier="public" Name="OutputAtStartup" Margin="0,5"
                  IsChecked="{Binding OutputAtStartup, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

        <TextBlock Text="{x:Static properties:Resources.Method}" Name ="TMethod" x:FieldModifier="public" VerticalAlignment="Center" Grid.Row="5" Margin="0,1"/>
        <ComboBox Name="CmbMethod" Grid.Column="2" Grid.Row="5" x:FieldModifier="public"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                  SelectedIndex="{Binding Path=MethodID, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" >
        </ComboBox>
        <ContentPresenter Grid.Row="5" Grid.Column="3" x:FieldModifier="public" Name="CmbMethodErr"
            Content="{Binding ElementName=CmbMethod, Path=(Validation.Errors).CurrentItem}"/>
        <TextBlock Text="{x:Static properties:Resources.ElementNumber}" Name ="TElemNumber" x:FieldModifier="public" VerticalAlignment="Center" Grid.Row="6" Margin="0,1"/>
        <TextBox Name="edtElementNumber" Grid.Column="2" Grid.Row="6" x:FieldModifier="public"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" Margin="0,5"
                 Text="{Binding ElementNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
        <ContentPresenter Grid.Row="6" Grid.Column="3" x:FieldModifier="public" Name="edtElementNumberErr"
            Content="{Binding ElementName=edtElementNumber, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.JobConditionalVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="TXBStateCommandVariable" Grid.Row="7" Margin="0,1"/>
        <DockPanel Grid.Row="7" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKPStateCommandVariable" Margin="0,5">
            <Button DockPanel.Dock="Right" Click="ResetConditionalTag_Click">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button DockPanel.Dock="Right" Click="SetConditionalTag_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="textEditConditionalVariable" IsReadOnly="True" 
                     Text="{Binding ConditionalVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     Validation.ErrorTemplate="{x:Null}" />
        </DockPanel>
        <ContentPresenter Grid.Row="7" Grid.Column="3" 
            Content="{Binding ElementName=textEditConditionalVariable, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Text="{x:Static properties:Resources.JobOffsetVariable}" VerticalAlignment="Center" x:FieldModifier="public" Name="lblOffsetVariable" Grid.Row="8" Margin="0,1" Visibility="Collapsed"/>
        <DockPanel Grid.Row="8" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:FieldModifier="public" Name="DKOffsetVariable"  Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Click="btnOffsetVariableCancel_Click">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button DockPanel.Dock="Right" Click="btnOffsetVariableBrowse_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="textOffsetVariable" IsReadOnly="True" 
                     Text="{Binding OffsetVariableName, Mode=OneWay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     Validation.ErrorTemplate="{x:Null}" />
        </DockPanel>
        <ContentPresenter Grid.Row="8" Grid.Column="3" 
            Content="{Binding ElementName=textOffsetVariable, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
