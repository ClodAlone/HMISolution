<UserControl x:Class="DriverCodeBase.UI.Controls.BaseImportTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:properties="clr-namespace:DriverCodeBase.UI.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:local="clr-namespace:DriverCodeBase.Converters;assembly=DriverCodeBase"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" MinHeight="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
          <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <Style x:Key="CustomListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#FF2C2C2C"></Setter>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#FF262626"></Setter>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="true">
                        <Setter Property="Background" Value="Gray" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <local:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtImportTreeTitle" Text="{x:Static properties:Resources.ImportTreeTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
        <Grid x:Name="ButtonGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0" Width="*" />
                <ColumnDefinition x:Name="Col1" Width="*" />
                <ColumnDefinition x:Name="Col2" Width="*" />
                <ColumnDefinition x:Name="Col3" Width="*" />
                <ColumnDefinition x:Name="Col4" Width="*" />
                <ColumnDefinition x:Name="Col5" Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnOpen" Margin="0,7,0,8" Content="{x:Static properties:Resources.LoadFile}" Click="LoadFile_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnGetPLCTags" Margin="0,7,0,8" Content="{x:Static properties:Resources.GetPLCTags}" Click="GetPlc_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnSelAll" Margin="0,7,0,8" Content="{x:Static properties:Resources.SelectAll}" Click="SelAll_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnClear" Margin="0,7,0,8" Content="{x:Static properties:Resources.SelectNone}" Click="Clear_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnImport" Margin="0,7,0,8" Content="{x:Static properties:Resources.ImportTags}" Click="Import_Click"></Button>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="5" HorizontalAlignment="Stretch" Orientation="Vertical">
                <Button Name="btnUpdateSymbol" Margin="0,7,0,8" Content="{x:Static properties:Resources.UpdateSymbol}" Click="Update_Click"></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <dxg:TreeListControl x:Name="ImportTreeListControl" SelectionMode="Row">
                <dxg:TreeListControl.View>
                    <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                                        ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                                        AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                                        ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" 
                                        NodeExpanding="OnTreeNodeExpanding" 
                                        ShowHorizontalLines="False" ShowIndicator="False" IsSynchronizedWithCurrentItem="True">
                        <dxg:TreeListView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:TreeListView.RowStyle>
                        <dxg:TreeListView.CellStyle>
                            <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                              <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                            </Style>
                        </dxg:TreeListView.CellStyle>
                    </dxg:TreeListView>
                </dxg:TreeListControl.View>
            </dxg:TreeListControl>
        </Grid>
        <Grid x:Name="GridStation" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="300*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <CheckBox Name="AddStationName" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content ="{x:Static properties:Resources.ImportTreeAddStationName}" x:FieldModifier="public"></CheckBox>
                <TextBlock Text="{x:Static properties:Resources.ImportTreeStation}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="2" Width="143"/>
                <ComboBox Name="CmbStation" Grid.Column="3" VerticalAlignment="Bottom" 
                          IsEditable="False" IsReadOnly="True" SelectionChanged="CmbStation_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="300*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <TextBlock Name="ImportFolder" Text="{x:Static properties:Resources.ImportTreeTagFolder}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="2" Width="143"/>
            <TextBox Name="ImportFolderText" Grid.Column="3"  VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,0,0" />

        </Grid>
        <Grid Grid.Row="5" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120*" />
                <ColumnDefinition Width="180*" />
                <ColumnDefinition Width="120*" />
                <ColumnDefinition Width="180*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <TextBlock Name="txtBehaviorExistingTag" Text="{x:Static properties:Resources.ImportBehaviorForExistingTags}" VerticalAlignment="Bottom" Grid.Row="0" Grid.Column="0"   HorizontalAlignment="Left"  Width="auto" Margin="5,0,0,0"/>
            <ComboBox Name="cmbBehaviorExistingTag"  Grid.Column="1"  Grid.Row="1" VerticalAlignment="Stretch" DisplayMemberPath="Value" SelectedValuePath="Key"
                           IsEditable="False" IsReadOnly="True" Margin="0,0,0,0"/>
            <TextBlock Name="txtBehaviorDynamicLink" Text="{x:Static properties:Resources.ImportBehaviorForDynamicLink}" VerticalAlignment="Bottom" Grid.Row="0" Grid.Column="2"   HorizontalAlignment="Left"  Width="auto" Margin="5,0,0,0"/>
            <ComboBox Name="cmbBehaviorDynamicLink"  Grid.Column="3"  Grid.Row="1" VerticalAlignment="Stretch" DisplayMemberPath="Value" SelectedValuePath="Key"
                          IsEditable="False" IsReadOnly="True" Margin="0,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>