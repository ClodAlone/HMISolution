<UserControl x:Class="JavaScriptEditor.JavaScriptEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JavaScriptEditor"
             xmlns:sn="http://scintillanet.codeplex.com" 
             xmlns:WinWrap="clr-namespace:WinWrap.Basic;assembly=ww10_wpf"
             xmlns:properties="clr-namespace:JavaScriptEditor.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Margin="0,0,0,5" Content="{x:Static properties:Resources.EditReferencesButtonTitle}" Click="EditReferences_Click"/>
        <sn:ScintillaWPF Grid.Row="1" Name="scintilla" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <WinWrap:BasicIdeCtl Grid.Row="2" x:Name="basicIdeCtl" FileTools="False" AlwaysSplit="False" TaskbarIconMode="IconNoneSysmenuNone" EventMode="True" FullPopupMenu="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
