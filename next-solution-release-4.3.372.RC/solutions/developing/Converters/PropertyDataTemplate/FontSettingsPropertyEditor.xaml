<UserControl x:Class="Converters.PropertyDataTemplate.FontSettingsPropertyEditor"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:FontSettingsConverterName x:Key="FontSettingsConverterName" />
        </ResourceDictionary>
    </UserControl.Resources>


    <DockPanel>
        <Button x:Name="fontsetting"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <TextBox x:Name="fontsettinglabel" IsHitTestVisible="False" Text="{Binding Path=Tag, ElementName=fontsetting, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FontSettingsConverterName}}" />
    </DockPanel>
</UserControl>
