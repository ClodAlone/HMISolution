<UserControl x:Class="EditDisplay.DateEditDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Background="#FF333333" Foreground="White"
             xmlns:dxga="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib" FontSize="20" 
             FontFamily="Segoe UI" FontWeight="SemiBold" FontStyle="Normal"
             mc:Ignorable="d" Height="21" Width="159">
    <Grid x:Name="grid">
        <dxga:TextEdit MaskType="DateTime" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        Mask="{Binding Path=DisplayFormatString, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                        MaskCulture="{x:Static glob:CultureInfo.CurrentCulture}"
                        DisplayFormatString="" 
                        FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        FontStyle="{Binding Path=FontStyle, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        NullText="{Binding Path=NullText, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                        ShowBorder="{Binding Path=ShowBorder, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                        VerticalAlignment="Center" x:Name="display" EditValueChanged="display_EditValueChanged" />
    </Grid>
</UserControl>
