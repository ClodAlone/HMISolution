<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             x:Class="EditDisplay.EditDisplay"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             Foreground="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
             xmlns:local="clr-namespace:EditDisplay"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="40">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
          <Path x:Key="up" Margin="60"
                Data="M0,14 L15,0 L30,14z"
                              Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RepeatButton}}}" Height="160" Stretch="Fill" Width="90" RenderTransformOrigin="0.5,0.5"/>
          <Path x:Key="down" Margin="60"
                Data="M0,0 L15,14 L30,0z"
                              Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RepeatButton}}}" Height="160" Stretch="Fill" Width="90" RenderTransformOrigin="0.5,0.5"/>
        </ResourceDictionary>
    </UserControl.Resources>
  <UserControl.Style>
    <Style TargetType="{x:Type local:EditDisplay}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type local:EditDisplay}">
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" ClipToBounds="True">
              <Grid x:Name="container">
                <!--Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">-->
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Style>

  <!--<Grid x:Name="container">
    --><!--Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">--><!--
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0*"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="0*"/>
    </Grid.ColumnDefinitions>
  </Grid>-->
</UserControl>
