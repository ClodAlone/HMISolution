<UserControl x:Class="EditDisplay.CalendarEditDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxei="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
             Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             Foreground="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
             xmlns:dxga="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib" 
             xmlns:converters="clr-namespace:EditDisplay.Converters"
             mc:Ignorable="d" Height="21" Width="159">
    <UserControl.Resources>
        <converters:FontSizeToCellSizeConverter x:Key="FontSizeToCellSizeConverter"/>        
    </UserControl.Resources>
    <Grid x:Name="grid">
        <Grid.Resources>
        <Style TargetType="dxei:DateNavigatorCalendarControl">
            <Setter Property="CellSize" Value="{Binding FontSize, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Converter={StaticResource FontSizeToCellSizeConverter}}" />
        </Style>
        </Grid.Resources>
        <!--Mask="{Binding Path=DisplayFormatString, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                        DisplayFormatString="{Binding Path=DisplayFormatString, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"-->
        <dxga:DateEdit x:Name="display" MaskType="DateTime" 
                        MaskUseAsDisplayFormat="True" PopupOpening="display_PopupOpening"
                        MaskCulture="{x:Static glob:CultureInfo.CurrentCulture}"
                        IsTextEditable="False" IsReadOnly="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        Mask="{Binding Path=DisplayFormatString, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                        DisplayFormatString=""
                        NullText="{Binding Path=NullText, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" 
                        EditValueChanged="display_EditValueChanged"
                        FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        FontStyle="{Binding Path=FontStyle, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        VerticalAlignment="Bottom" ShowClearButton="False" ShowToday="True" ShowWeekNumbers="True">
        </dxga:DateEdit>

    </Grid>
</UserControl>
