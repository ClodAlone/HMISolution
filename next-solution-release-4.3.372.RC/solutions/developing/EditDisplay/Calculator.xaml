<UserControl x:Class="EditDisplay.Calculator"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v21.2"
             mc:Ignorable="d" Height="22" Width="218">
    <Grid x:Name="grid">
        <dxe:PopupCalcEdit x:Name="display" Value="{Binding Path=EditValue, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, UpdateSourceTrigger=LostFocus, Mode=TwoWay, ValidatesOnDataErrors=True}" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
