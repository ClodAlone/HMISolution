<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="MarkerTemplate">
        <Viewbox RenderTransformOrigin="0, 0.5" Stretch="Fill" 
              Width="{Binding MarkerFactorHeight, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
              Height="{Binding MarkerFactorWidth, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
              Margin="{Binding MarkerOffset, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
			>
            <Grid x:Name="Needle1" Margin="0">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="1" ScaleX="-1"/>
                        <SkewTransform AngleY="0" AngleX="0"/>
                        <RotateTransform Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Path Stretch="Fill" Fill="{Binding MarkerStroke, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
                      Data="F1 M 686,458L 694,462L 694,463L 686,467L 686,458 Z " HorizontalAlignment="Right" Height="9" Margin="0,0,11,0" VerticalAlignment="Center" Width="8"/>
                <Path Stretch="Fill" Fill="{Binding MarkerFill, Mode=OneWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
                      Data="F1 M 687,459.734L 687,465.267L 692.733,462.445L 687,459.734 Z " HorizontalAlignment="Right" Height="5.533" Margin="0,0,12.3,0" VerticalAlignment="Center" Width="5.733"/>
            </Grid>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>
