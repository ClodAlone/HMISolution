<ResourceDictionary              
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" 
             xmlns:properties="clr-namespace:Trends.Properties;assembly=Trends"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:locals="clr-namespace:Trends.Converters;assembly=Trends">
    
    <locals:SampleToMaxValue x:Key="SampleToMaxValue" />

    <dxc:XYDiagram2D x:Key="diagram" BarDistance="0.04" AllowSeriesBitmapCaching="False"
                     EnableAxisXNavigation="True"
                     EnableAxisYNavigation="True"
                     Rotated="{Binding Rotated, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
      <dxc:XYDiagram2D.DefaultPane>
        <dxc:Pane Grid.Row="0">
          <dxc:Pane.AxisYScrollBarOptions>
            <dxc:ScrollBarOptions Visible="False"/>
          </dxc:Pane.AxisYScrollBarOptions>
          <dxc:Pane.AxisXScrollBarOptions>
            <dxc:ScrollBarOptions Visible="False"/>
          </dxc:Pane.AxisXScrollBarOptions>
        </dxc:Pane>
      </dxc:XYDiagram2D.DefaultPane>
        <dxc:XYDiagram2D.NavigationOptions>
          <dxc:NavigationOptions
              UseKeyboard="True"
              UseScrollBars="True"
              UseMouse="True"
              UseTouchDevice="True"/>
        </dxc:XYDiagram2D.NavigationOptions>
        <dxc:XYDiagram2D.AxisY>
            <dxc:AxisY2D Tag="axisY2D" 
                                Interlaced="False"
                                Logarithmic="{Binding LogarithmicYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                LogarithmicBase="{Binding LogarithmicBaseYScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                                GridLinesMinorVisible="True">
                <dxc:AxisY2D.CrosshairAxisLabelOptions>
                    <dxc:CrosshairAxisLabelOptions Pattern=" {V:F2}"/>
                </dxc:AxisY2D.CrosshairAxisLabelOptions>
                <dxc:AxisY2D.Title>
                    <dxc:AxisTitle />
                </dxc:AxisY2D.Title>
                <dxc:AxisY2D.WholeRange>
                    <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" AutoSideMargins="False" SideMarginsValue="0"/>
                    <!--MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						            MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"/>-->
                </dxc:AxisY2D.WholeRange>
                <dxc:AxisY2D.Label>
                    <dxc:AxisLabel>
                        <dxc:AxisY2D.ResolveOverlappingOptions>
                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True" 
                                                                    AllowRotate="False"
                                                                    AllowStagger="False"
                                                                    MinIndent="{Binding MinYIndent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"/>
                        </dxc:AxisY2D.ResolveOverlappingOptions>
                    </dxc:AxisLabel>
                </dxc:AxisY2D.Label>
            </dxc:AxisY2D>
        </dxc:XYDiagram2D.AxisY>

        <dxc:XYDiagram2D.AxisX>
            <dxc:AxisX2D Tag="axisX2D" GridLinesVisible="True" GridLinesMinorVisible="True">
                <dxc:AxisX2D.CrosshairAxisLabelOptions>
                    <dxc:CrosshairAxisLabelOptions Pattern=" {A:F2}"/>
                </dxc:AxisX2D.CrosshairAxisLabelOptions>
                <dxc:AxisX2D.WholeRange>
                    <dxc:Range dxc:AxisY2D.AlwaysShowZeroLevel="False" AutoSideMargins="False" SideMarginsValue="0"/>
                                    <!--MinValue="{Binding Minimum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
						            MaxValue="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"/>-->
                </dxc:AxisX2D.WholeRange>
                <dxc:AxisX2D.Title>
                    <dxc:AxisTitle/>
                </dxc:AxisX2D.Title>
                <dxc:AxisX2D.Label>
                    <dxc:AxisLabel>
                        <dxc:Axis2D.ResolveOverlappingOptions>
                            <dxc:AxisLabelResolveOverlappingOptions AllowHide="True" 
                                                                    AllowRotate="False"
                                                                    AllowStagger="False"
                                                                    MinIndent="{Binding MinXIndent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"/>
                        </dxc:Axis2D.ResolveOverlappingOptions>
                    </dxc:AxisLabel>
                </dxc:AxisX2D.Label>
            </dxc:AxisX2D>
        </dxc:XYDiagram2D.AxisX>
        <dxc:XYDiagram2D.Series>
            <dxc:LineScatterSeries2D Tag="dataContextSerie" DisplayName="dataContextSerie"  Visible="False"
                                            Visibility="Collapsed" ArgumentScaleType="Numerical" 
                                            MarkerSize="5" MarkerVisible="True"
                                            AnimationAutoStartMode="SetStartState">
                <dxc:LineScatterSeries2D.MarkerModel>
                    <dxc:RingMarker2DModel/>
                </dxc:LineScatterSeries2D.MarkerModel>
                <dxc:LineScatterSeries2D.Label>
                    <dxc:SeriesLabel Visible="{Binding SeriesLabelVisible, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                     TextPattern="{}{A:F2 - V:F2}"   ResolveOverlappingMode="{Binding ResolveLabelOverlappingMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}" 
                                                ConnectorThickness="1" />
                </dxc:LineScatterSeries2D.Label>
            </dxc:LineScatterSeries2D>
        </dxc:XYDiagram2D.Series>
    </dxc:XYDiagram2D>

</ResourceDictionary>
