<UserControl x:Class="AuditTrace.AuditTraceComment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AuditTrace"
             xmlns:properties="clr-namespace:AuditTrace.Properties"
             xmlns:converters="clr-namespace:AuditTrace.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             FocusManager.FocusedElement="{Binding ElementName=txtAuditComment}"
             Height="250" Width="520">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="100" />
            <!--<RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />-->
        </Grid.RowDefinitions>
        <TextBlock Margin="5" x:Name="txtDisplayName"
                   Text="{x:Static properties:Resources.AuditTraceComment_DisplayName}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Margin="5" 
                   Text="{Binding DisplayName}" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Margin="5" x:Name="txtActualValue"
                   Text="{x:Static properties:Resources.AuditTraceComment_ActualValue}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="2" Margin="5" 
                   Text="{Binding CurrentValue}" VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Margin="5" x:Name="txtAudiValue"
                   Text="{x:Static properties:Resources.AuditTraceComment_AuditValue}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="2" Margin="5" 
                   Text="{Binding AuditValue}" VerticalAlignment="Center" />

        <TextBlock Grid.Row="3" Margin="5" x:Name="txtUserComment"
                   Text="{x:Static properties:Resources.AuditTraceComment_AuditComment}" VerticalAlignment="Top" />
        <DockPanel Grid.Row="3" Grid.Column="2" Margin="5">
            <!--<Button DockPanel.Dock="Right">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>-->
            <Button DockPanel.Dock="Right" Click="EditAuditComment_Click"
                        Tag="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="txtAuditComment" Validation.ErrorTemplate="{x:Null}"
                     Text="{Binding AuditComment, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ContentPresenter Grid.Row="3" Grid.Column="3"
            Content="{Binding ElementName=txtAuditComment, Path=(Validation.Errors).CurrentItem}"/>

        <!--<TextBlock Grid.Row="5" 
                   Visibility="{Binding IsPasswordRequiredOnAudit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"
                   Text="{x:Static properties:Resources.AuditTraceComment_UserName}" VerticalAlignment="Center" />
        <DockPanel Grid.Row="5" Grid.Column="2" Margin="5,0,5,2">
            <Button DockPanel.Dock="Right">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button DockPanel.Dock="Right" 
                    Tag="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <TextBlock Grid.Row="6" 
                   Visibility="{Binding IsPasswordRequiredOnAudit, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"
                   Text="{x:Static properties:Resources.AuditTraceComment_Password}" VerticalAlignment="Center" />
        <DockPanel Grid.Row="6" Grid.Column="2" Margin="5,0,5,2">
            <Button DockPanel.Dock="Right">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button DockPanel.Dock="Right" 
                    Tag="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>-->
    </Grid>
</UserControl>
