<UserControl x:Class="WPFUtilities.GeoMapCoordinatesInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" 
             xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
             xmlns:properties="clr-namespace:WPFUtilities.Properties">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="0.90*"></RowDefinition>
            <RowDefinition Height ="0.10*"></RowDefinition>
        </Grid.RowDefinitions>
        <dxm:MapControl 
            Grid.Row="0"
            x:Name="mapControl" 
            IsManipulationEnabled="True" 
            VirtualizingPanel.IsVirtualizing="True"
            MinZoomLevel="1"
            MaxZoomLevel="20"
            EnableRotation="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <dxm:MapControl.ScrollButtonsOptions>
                <dxm:ScrollButtonsOptions Visible="False"/>
            </dxm:MapControl.ScrollButtonsOptions>
            <dxm:MapControl.ZoomTrackbarOptions>
                <dxm:ZoomTrackbarOptions Visible="False"/>
            </dxm:MapControl.ZoomTrackbarOptions>

            <dxm:ImageTilesLayer x:Name="imageTilesLayer" >
                <dxm:ImageTilesLayer.DataProvider>
                    <dxm:BingMapDataProvider 
                        x:Name="bingMapDataProvider" 
                        BingKey="{Binding Source={x:Static properties:Settings.Default}, Path=BingMapKey}"
                        Kind="Hybrid"/>
                </dxm:ImageTilesLayer.DataProvider>
            </dxm:ImageTilesLayer>

            <dxm:VectorLayer>
                <dxm:MapItemStorage x:Name="screenLayer"/>
            </dxm:VectorLayer>
            <dxm:VectorLayer>
                <dxm:MapItemStorage x:Name="pathLayer"/>
            </dxm:VectorLayer>
        </dxm:MapControl>
        <Button 
            Grid.Row="0" 
            FontSize="36" 
            FontWeight="Normal" 
            Foreground="White" 
            Background="Transparent"
            Content="+"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="Transparent"/> 
        <Button 
            Grid.Row="1" 
            x:Name="btnSaveView"
            Click="btnSaveView_Click"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Margin="5"
            Content="{x:Static properties:Resources.SaveMapSettings}"
            ToolTip="{x:Static properties:Resources.SaveMapSettingsTip}"
            Width="150" 
            Height="50"
            FontSize="16"/>
    </Grid>
</UserControl>
