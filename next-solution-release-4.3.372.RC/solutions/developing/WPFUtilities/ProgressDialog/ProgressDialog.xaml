<Window x:Class="Utilities.ProgressDialog.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:WPFUtilities.Properties"
        Title="Processing..."
        Width="440"
        Height="220"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Opacity="0.95"
        WindowStyle="None"
        Background="{x:Null}"
        ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="BackBrush" EndPoint="0.874,1.197"
                           StartPoint="0.126,-0.197">
                <GradientStop Color="#FF030404"
                      Offset="0" />
                <GradientStop Color="#FF000000"
                      Offset="1" />
                <GradientStop Color="#FFABB8B9"
                      Offset="0.304" />
            </LinearGradientBrush>

        </ResourceDictionary>
    </Window.Resources>
  <Border CornerRadius="12,12,12,12" Margin="20,20,20,20"
          BorderBrush="#FF020202"
          BorderThickness="0,0,0,0"
          Background="{StaticResource BackBrush}"
          x:Name="border"
          Height="Auto">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="10" Opacity="0.5" />
        </Border.Effect>
        <Grid>
      <ProgressBar Margin="8,0,12,52"
                   x:Name="progressBar"
                   Foreground="#FFFFA609"
                   VerticalAlignment="Bottom"
                   Height="25" IsIndeterminate="False" />
      <TextBlock Margin="145,8,10,0"
                 Text="{x:Static properties:Resources.ProgressDialogPleaseWait}"
                 x:Name="txtDialogMessage"
                 VerticalAlignment="Top"
                 Height="Auto"
                 Foreground="#FFCCCCCC"
                 FontSize="14"
                 TextWrapping="Wrap" />
      <DockPanel Height="25"
                 VerticalAlignment="Bottom"
                 Margin="10,0,12,13">
        <Button x:Name="btnCancel"
                Click="btnCancel_Click"
                Visibility="Collapsed"
                Content="{x:Static properties:Resources.LabelCancel}"
                DockPanel.Dock="Right"
                Width="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Right" />
        <Label x:Name="lblStatus"
               Foreground="#FFCCCCCC"
               Content="{x:Static properties:Resources.ProgressDialogWorkInProgress}" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
