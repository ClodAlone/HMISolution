<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid;assembly=Mindscape.WpfElements"
                    xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing;assembly=Mindscape.WpfElements"
                    xmlns:e="clr-namespace:Mindscape.WpfElements;assembly=Mindscape.WpfElements"
                    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:local="clr-namespace:Mindscape.WpfElements;assembly=Mindscape.WpfElements"
                    xmlns:properties="clr-namespace:WPFUtilities.Properties"
                    xmlns:converters="clr-namespace:WPFUtilities">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <pg:LevelToIndentConverter x:Key="LevelToIndentConverter" />
    <pg:MarginInversionConverter x:Key="MarginInversionConverter" />
    <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderMargin" Usage="Margin" />
    <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderPadding" Usage="Padding" />
    <pg:ManyToNodeConverter x:Key="DeManyfier" />
    <pg:AreEqualConverter x:Key="AreEqual" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <converters:GroupItemToMarginConverter x:Key="GroupItemToMarginConverter" />
    <!--<converters:SolidColorBrushMultiplyConververter x:Key="SolidColorBrushMultiplyConververter" />-->

    <!-- PropertyGrid -->
    <DataTemplate x:Key="{x:Static e:PropertyGrid.PropertyNameTemplateKey}">
        <Border SnapsToDevicePixels="True" Name="Bd"
                Focusable="True" Padding="2,0,6,0" Margin="-10,0,0,0"
                BorderThickness="18,0,1,0">
            <DockPanel Margin="-15,0,0,0">
                <Expander x:Name="Expander" 
                          Margin="{Binding Level,Converter={StaticResource LevelToIndentConverter},RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}"
                          IsExpanded="{Binding Path=IsExpanded,RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}" />
                <TextBlock Name="NameBlockaaaa" Text="{Binding Node.HumanName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTipService.IsEnabled="{Binding Path=(ToolTipService.IsEnabled), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                           Tag="{Binding PropertyNameToolTipTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{Binding}" 
                                 ContentTemplate="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
                    </ToolTipService.ToolTip>
                </TextBlock>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=HasItems,RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}" Value="False">
                <Setter TargetName="Expander" Property="Expander.Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(pg:TreeListView.ShowSubitemExpanders),RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" Value="False">
                <Setter TargetName="Expander" Property="Expander.Visibility" Value="Hidden" />
                <Setter TargetName="Bd" Property="Border.BorderThickness" Value="3,0,1,0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <HierarchicalDataTemplate x:Key="PropertyGridHierarchy" ItemsSource="{Binding Path=Children}" />

    <DataTemplate x:Key="ManyEditorContentTemplate">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border Background="Transparent" Width="3" Height="0" />
            <TextBlock Text="{x:Static properties:Resources.PropertyGrid_MultipleValueText}" VerticalAlignment="Center" />
            <TextBlock Text=" (" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PropertyTypeName}" VerticalAlignment="Center" />
            <TextBlock Text=")" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="ManyEditorStyle" TargetType="{x:Type pg:ManyEditor}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type pg:ManyEditor}">
                    <Grid>
                        <DockPanel Name="InconsistentView">
                            <Button DockPanel.Dock="Right" Command="{x:Static pg:ManyEditor.ResetCommand}" CommandParameter="{Binding}" 
                                    ToolTip="{x:Static properties:Resources.PropertyGrid_MultipleValueTooltip}" Margin="0,0,0,0"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}">
                                <Button.Content>
                                    <Image Source="{StaticResource ClearSmall}" Width="16" Height="16" />
                                </Button.Content>
                            </Button>
                            <Border Name="Bd" BorderThickness="1" 
                                    MinHeight="25" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type dxc:DXBorder}}}">
                                <ContentControl Content="{Binding Value}" ContentTemplate="{StaticResource ManyEditorContentTemplate}" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </DockPanel>
                        <ContentControl Name="ConsistentView" Visibility="Collapsed" Content="{Binding Converter={StaticResource DeManyfier}}" 
                            Focusable="False" 
                            ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsConsistent" Value="True">
                            <Setter TargetName="ConsistentView" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InconsistentView" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type e:PropertyGrid}" x:Shared="False">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DefaultMargin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="PropertyNameTemplate" Value="{StaticResource {x:Static e:PropertyGrid.PropertyNameTemplateKey}}" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
        <Setter Property="BuiltInEditorStyles">
            <Setter.Value>
                <pe:BuiltInEditorStyleCollection>
                    <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ManyEditorKey}" Style="{StaticResource ManyEditorStyle}" />
                </pe:BuiltInEditorStyleCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type e:PropertyGrid}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}">
                        <Border.Resources>
                            <!-- ReadOnlyDisplay DataTemplate -->
                            <DataTemplate x:Key="{x:Static local:PropertyGrid.ReadOnlyDisplayKey}">
                                <Border Background="Transparent" BorderThickness="1" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type dxc:DXBorder}}}"
                                        MinHeight="25">
                                    <TextBlock Margin="3,0,0,0" Text="{Binding Value}" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                            <!-- CollectionDisplay DataTemplate -->
                            <DataTemplate x:Key="{x:Static local:PropertyGrid.CollectionDisplayKey}">
                                <Border Background="Transparent" BorderThickness="1" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type dxc:DXBorder}}}"
                                        MinHeight="25" Margin="{Binding Content,Converter={StaticResource GroupItemToMarginConverter},RelativeSource={RelativeSource AncestorType={x:Type GroupItem}}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right">
                                            <Button Command="{x:Static local:PropertyGrid.CollectionAddCommand}" CommandParameter="{Binding Value}"
                                                    ToolTip="Click to add a new item" Padding="0"
                                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}">
                                                <Button.Content>
                                                    <Image Source="{StaticResource AddNewSmall}" Width="16" Height="16" />
                                                </Button.Content>
                                            </Button>
                                        </Border>
                                        <TextBlock Text="{Binding Path=Value.Count}" IsEnabled="False" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
                                        <TextBlock Name="ItemText" Text="{x:Static properties:Resources.PropertyGrid_MultipleItems}" IsEnabled="False" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Value.Count}" Value="1">
                                        <Setter TargetName="ItemText" Property="Text" Value="{x:Static properties:Resources.PropertyGrid_SingleItem}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                            <!-- CollectionElement Editor DataTemplate -->
                            <DataTemplate x:Key="{x:Static local:PropertyGrid.CollectionElementEditorKey}">
                                <Grid Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding}" Grid.Column="0" Margin="0,0,3,0"
                                                    ContentTemplate="{Binding DecoratedTemplate, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
                                    <Button Grid.Column="1" Command="{x:Static local:PropertyGrid.CollectionRemoveCommand}" ToolTip="Click to remove this item"
                                            CommandParameter="{Binding DecoratedNode, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}"
                                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" Padding="1">
                                        <Button.Content>
                                            <Image Source="{StaticResource RemoveMinusSmall}" Width="14" Height="14" />
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </Border.Resources>
                        <DockPanel>
                            <pg:TreeListView x:Name="PART_Grid" 
                                  ItemTemplate="{StaticResource PropertyGridHierarchy}" 
                                  ItemsSource="{TemplateBinding BindingView}">
                                <pg:TreeListView.Columns>
                                    <GridViewColumnCollection>
                                        <GridViewColumn CellTemplate="{Binding PropertyNameTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                                                        Width="{Binding Path=(pg:TreeListView.ResizeColumnWidth), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
                                        <GridViewColumn>
                                            <GridViewColumn.CellTemplate>
                                                <HierarchicalDataTemplate>
                                                    <Border MinHeight="25" Margin="{Binding Content,Converter={StaticResource GroupItemToMarginConverter},RelativeSource={RelativeSource AncestorType={x:Type GroupItem}}}"
                                                            BorderThickness="0" BorderBrush="{Binding Path=Foreground, ElementName=PART_Grid}">
                                                        <ContentControl Content="{Binding}" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                                                                        ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
                                                    </Border>
                                                </HierarchicalDataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <!--<GridViewColumn CellTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Path=EditorSelector}" />-->
                                    </GridViewColumnCollection>
                                </pg:TreeListView.Columns>
                                <!--<pg:TreeListView.GroupStyle>
                                    <GroupStyle ContainerStyleSelector="{StaticResource GroupStyleSelector}" />
                                </pg:TreeListView.GroupStyle>-->
                            </pg:TreeListView>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeListView -->
    <Style x:Key="GridViewColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="Height" Value="0" />
    </Style>

    <Style x:Key="TreeListViewItemContainerStyle" TargetType="pg:TreeListViewItem">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="{x:Type pg:TreeListView}" x:Shared="False">
        <!-- must be unshared or the TLVs end up sharing their column collections, which means column widths end up synchronised! -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TreeListViewItemContainerStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type pg:TreeListView}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="PART_ScrollViewer">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding Foreground}">
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <GridViewHeaderRowPresenter Columns="{Binding Path=Columns,RelativeSource={RelativeSource TemplatedParent}}" 
                                            DockPanel.Dock="Top" ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeaderStyle}" />
                                <ItemsPresenter />
                            </DockPanel>
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
