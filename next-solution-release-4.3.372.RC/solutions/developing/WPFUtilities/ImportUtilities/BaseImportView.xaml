<UserControl x:Class="WPFUtilities.BaseImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             xmlns:converters="clr-namespace:WPFUtilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>        
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand SourceName="gridDataControl" EventName="SelectionChanged"
                               Command="{Binding SelectionChangedCommand}" PassEventArgsToCommand="True"/>
        <dxmvvm:EventToCommand SourceName="cbDelimiters" EventName="SelectionChanged"
                               Command="{Binding DelimitersSelectionChangedCommand}" PassEventArgsToCommand="True"/>
        <dxmvvm:EventToCommand SourceName="gridDataControl" EventName="FilterChanged"
                               Command="{Binding FilterChangedCommand}" PassEventArgsToCommand="True"/>
    </dxmvvm:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <GroupBox Grid.ColumnSpan="3" BorderThickness="1" Margin="0,10">
            <GroupBox.Header>
                <TextBlock Text="{x:Static properties:Resources.FileOptions}"/>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static properties:Resources.Filepath}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding FilePath}" Grid.Column="1" Margin="5"
                         Grid.ColumnSpan="2"/>
                <Button Margin="5" Grid.Column="3"
                        Command="{Binding ChooseFileCommand}">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>

                <TextBlock Text="{x:Static properties:Resources.Delimiter}" 
                           Grid.Row="1" 
                           VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Delimiters}" 
                          x:Name="cbDelimiters"
                          SelectedItem="{Binding Delimiter, Mode=OneWay}"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="5" MinWidth="100"
                          VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
        <Button Command="{Binding LoadDataCommand}" Margin="0,10"
                Content="{x:Static properties:Resources.Import}"
                Grid.Row="1"/>
        <Button Command="{Binding UnselectAllCommand}" Margin="5,10"
                Content="{x:Static properties:Resources.UnselectAll}"
                Grid.Column="1"
                Grid.Row="1"/>
        <Button Command="{Binding SelectAllCommand}" Margin="5,10"
                Content="{x:Static properties:Resources.SelectAll}"
                Grid.Column="2"
                Grid.Row="1"/>
        <dxg:GridControl Grid.Row="2" Grid.ColumnSpan="3" MinHeight="10" MinWidth="10"
                     AutoExpandAllGroups="True"
                     AutoGenerateColumns="AddNew"
                     Name="gridDataControl"
                     AllowDrop="True" 
                     AllowLiveDataShaping="False"
                     SelectionMode="MultipleRow"
                     ItemsSource="{Binding ItemsSource}"
                     SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                     Visibility="{Binding LoadingDataError, Converter={StaticResource InverseBooleanConverter}}"
                         AutoGeneratedColumns="OnAutoGeneratedColumns">
        <dxg:GridControl.View>
            <dxg:TableView x:Name="tableView"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Row">
            </dxg:TableView>
        </dxg:GridControl.View>
    </dxg:GridControl>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" 
              Visibility="{Binding LoadingDataError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
