<UserControl x:Class="WPFUtilities.PropertyDataTemplate.CustomColorNameEditor"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             Width="300" Height="50"
             d:DesignHeight="50" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,2,0,2" Grid.Row="1" Grid.Column="1">
            <DockPanel>
                <TextBlock Text="{x:Static properties:Resources.ColorName}" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox x:Name="textbox_colorName" Margin="5,1" DockPanel.Dock="Right" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
