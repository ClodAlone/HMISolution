<UserControl x:Class="WPFUtilities.PropertyDataTemplate.NumericUpDownPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:WPFUtilities.Converters"
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:SpinEditDoubleConverter x:Key="SpinEditDoubleConverter" />
            <converters:BytesSizeConverter x:Key="BytesSizeConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <dxe:SpinEdit x:Name="updown" TextBlock.TextAlignment="Left" 
                      AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False"
                      AllowRoundOutOfRangeValue="False" InvalidValueBehavior="AllowLeaveEditor"
                      MaskType="Numeric" dxe:NumericMaskOptions.AlwaysShowDecimalSeparator="False"
                      TextBoxBase.TextChanged="updown_TextChanged"
                      DisplayFormatString="{Binding Path=DisplayFormatString, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                      Increment="{Binding Path=SpinValue, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                      MinValue="{Binding Path=MinValue, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                      MaxValue="{Binding Path=MaxValue, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" 
                      Validation.ErrorTemplate="{x:Null}">
            <dxe:SpinEdit.EditValue>
                <MultiBinding Converter="{StaticResource SpinEditDoubleConverter}" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay" ValidatesOnDataErrors="True">
                    <Binding Path="Value" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" />
                    <Binding Path="BytesMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                </MultiBinding>
            </dxe:SpinEdit.EditValue>
        </dxe:SpinEdit>
        <Button Grid.Column="1" Click="unsetValueBtn_Click" 
                Visibility="{Binding Path=CanClearValue, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTip="{Binding x:Static properties:Resources.TooltipPropertyEditorButtonUnsetValue}" >
                <Button.Content>
                <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <ContentPresenter Grid.Column="2" 
                Content="{Binding ElementName=updown, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
