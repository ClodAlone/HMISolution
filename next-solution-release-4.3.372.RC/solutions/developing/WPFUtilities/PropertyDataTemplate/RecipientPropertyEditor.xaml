<UserControl x:Class="WPFUtilities.PropertyDataTemplate.RecipientPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:converter="clr-namespace:WPFUtilities.Converters"   
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:RecipientConverter x:Key="RecipientConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="context" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="text" IsReadOnly="True" Text="{Binding Path=Tag, ElementName=context, Mode=OneWay, Converter={StaticResource RecipientConverter}}" Validation.ErrorTemplate="{x:Null}" />
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=context, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
