<UserControl x:Class="WPFUtilities.PropertyDataTemplate.BrushEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPFUtilities.PropertyDataTemplate"
    xmlns:properties="clr-namespace:WPFUtilities.Properties"
    xmlns:dxei="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Height="400" Width="300">

    <UserControl.Resources>
        <local:ResourceToBrushConverter x:Key="MyConverter" />
        <local:BrushCollection x:Key="brushlist"/>
        <local:ColorTypeToIsCheckedConverter x:Key="ColorTypeToIsCheckedConverter"/>
    </UserControl.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="80*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" x:Name="tabControl">
            <TabItem x:Name="picker" Header="{x:Static properties:Resources.CustomHeader}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="transparentButton" ToolTip="{x:Static properties:Resources.SetTransparent}" Grid.Row="0" 
                            Margin="2" Click="TransparentButton_Click" Content="{x:Static properties:Resources.BrushEditor_Transparent}"/>
                    <Grid ClipToBounds="True" 
                          Grid.Row="1" Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="tyeSelection">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton IsChecked="{Binding ColorTypeSelection, Mode=OneWay, Converter={StaticResource ColorTypeToIsCheckedConverter}, ConverterParameter=0}" Grid.Column="0" x:Name="solidBtn" Content="{x:Static properties:Resources.CustomGradientSolid}" Click="solidBtn_Click"/>
                            <ToggleButton IsChecked="{Binding ColorTypeSelection, Mode=OneWay, Converter={StaticResource ColorTypeToIsCheckedConverter}, ConverterParameter=1}" Grid.Column="1" x:Name="linearBtn" Content="{x:Static properties:Resources.CustomGradientLinear}" Click="linearBtn_Click"/>
                            <ToggleButton IsChecked="{Binding ColorTypeSelection, Mode=OneWay, Converter={StaticResource ColorTypeToIsCheckedConverter}, ConverterParameter=2}" Grid.Column="2" x:Name="radialBtn" Content="{x:Static properties:Resources.CustomGradientRadial}" Click="radialBtn_Click"/>
                        </Grid>
                        <dxei:ColorPicker Grid.Row="1" x:Name="colorEdit"/>
                        <local:MyGradientMultiSlider x:Name="linearGradientMultiSlider" BrushType="Linear" Visibility="Collapsed"  Grid.Row="2"/>
                        <local:MyGradientMultiSlider x:Name="radialGradientMultiSlider" BrushType="Radial" Visibility="Collapsed"  Grid.Row="2"/>
                        <Grid Grid.Row="3" x:Name="radialOptions" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Text="{x:Static properties:Resources.GradientOptionX}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{x:Static properties:Resources.GradientOptionY}"/>

                            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.RadialBrushOrigin}"/>
                            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.RadialBrushCenter}"/>
                            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.RadialBrushRadius}"/>
                            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.RadialBrushOpacity}"/>




                            <dxe:SpinEdit Grid.Row="1" Grid.Column="1" 
                                        EditValue="{Binding RadialBrush.GradientOrigin.X, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1"  Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" EditValueChanging="options_EditValueChanging"
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="gradientOriginX"/>

                            <dxe:SpinEdit Grid.Row="1" Grid.Column="2" 
                                        EditValue="{Binding RadialBrush.GradientOrigin.Y, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" EditValueChanging="options_EditValueChanging" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="gradientOriginY"/>


                            <dxe:SpinEdit Grid.Row="2" Grid.Column="1" 
                                        EditValue="{Binding RadialBrush.Center.X, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" EditValueChanging="options_EditValueChanging" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="centerX"/>

                            <dxe:SpinEdit Grid.Row="2" Grid.Column="2" 
                                        EditValue="{Binding RadialBrush.Center.Y, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" EditValueChanging="options_EditValueChanging" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="centerY"/>



                            <dxe:SpinEdit Grid.Row="3" Grid.Column="1" 
                                        EditValue="{Binding RadialBrush.RadiusX, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" EditValueChanging="options_EditValueChanging" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="radiusX"/>

                            <dxe:SpinEdit Grid.Row="3" Grid.Column="2" 
                                        EditValue="{Binding RadialBrush.RadiusY, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" EditValueChanging="options_EditValueChanging" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="radiusY"/>
                            
                            <dxe:SpinEdit Grid.Row="4" Grid.Column="1" 
                                        EditValue="{Binding RadialBrush.Opacity, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="0" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="ropacity"/>

                        </Grid>
                        <Grid Grid.Row="3" x:Name="linearOptions" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Text="{x:Static properties:Resources.GradientOptionX}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Text="{x:Static properties:Resources.GradientOptionY}"/>


                            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.LinearBrushStartPoint}"/>
                            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.LinearBrushEndPoint}"/>
                            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.LinearBrushOpacity}"/>

                            <dxe:SpinEdit Grid.Row="1" Grid.Column="1" 
                                        EditValue="{Binding LinearBrush.StartPoint.X, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True"  EditValueChanging="options_EditValueChanging"
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="startPointX"/>

                            <dxe:SpinEdit Grid.Row="1" Grid.Column="2" 
                                        EditValue="{Binding LinearBrush.StartPoint.Y, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True"  EditValueChanging="options_EditValueChanging"
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="startPointY"/>


                            <dxe:SpinEdit Grid.Row="2" Grid.Column="1" 
                                        EditValue="{Binding LinearBrush.EndPoint.X, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True"  EditValueChanging="options_EditValueChanging"
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="endPointX"/>

                            <dxe:SpinEdit Grid.Row="2" Grid.Column="2" 
                                        EditValue="{Binding LinearBrush.EndPoint.Y, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="-1" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True"  EditValueChanging="options_EditValueChanging"
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="endPointY"/>

                            <dxe:SpinEdit Grid.Row="3" Grid.Column="1" 
                                        EditValue="{Binding LinearBrush.Opacity, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" 
                                        MinValue="0" MaxValue="1" Increment="0.01"
                                        Mask="0.00" MaskUseAsDisplayFormat="True" 
                                        MaskType="Numeric" EditValueType="{x:Type sys:Double}"
                                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                                        x:Name="opacity"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem  x:Name="named" Header="{x:Static properties:Resources.NamedHeader}">
                <ListBox Grid.Row="0" x:Name="listNamed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="2" MinHeight="8" MinWidth="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         MouseDoubleClick="list_MouseDoubleClick"
                         SelectionChanged="list_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Width="70" Height="50">
                                <Rectangle Fill="{Binding Converter={StaticResource MyConverter}}" ClipToBounds="True" Width="30" Height="30" Margin="2, 2, 2, 2" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" />
                                    </Rectangle.Effect>
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Converter={StaticResource MyConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding Converter={StaticResource MyConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem  x:Name="solid" Header="{x:Static properties:Resources.SolidHeader}">
                <!--Background="Transparent" AlternationCount="1" MaxHeight="300" MinHeight="80" MaxWidth="300" MinWidth="80"-->
                <ListBox Grid.Row="0" x:Name="listSolid" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         MouseDoubleClick="list_MouseDoubleClick"
                         SelectionChanged="list_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Width="70" Height="50">
                                <Rectangle Fill="{Binding Converter={StaticResource MyConverter}}" ClipToBounds="True" Width="30" Height="30" Margin="2, 2, 2, 2" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" />
                                    </Rectangle.Effect>
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Converter={StaticResource MyConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding Converter={StaticResource MyConverter}, ConverterParameter='1'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem  x:Name="linear" Header="{x:Static properties:Resources.LinearHeader}">
                <ListBox Grid.Row="0" x:Name="listLinear" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         MouseDoubleClick="list_MouseDoubleClick"
                         SelectionChanged="list_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Width="70" Height="50">
                                <Rectangle Fill="{Binding Converter={StaticResource MyConverter}}" ClipToBounds="True" Width="30" Height="30" Margin="2, 2, 2, 2" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" />
                                    </Rectangle.Effect>
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Converter={StaticResource MyConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding Converter={StaticResource MyConverter}, ConverterParameter='1'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem  x:Name="radial" Header="{x:Static properties:Resources.RadialHeader}">
                <ListBox Grid.Row="0" x:Name="listRadial" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         MouseDoubleClick="list_MouseDoubleClick"
                         SelectionChanged="list_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Width="70" Height="50">
                                <Rectangle Fill="{Binding Converter={StaticResource MyConverter}}" ClipToBounds="True" Width="30" Height="30" Margin="2, 2, 2, 2" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" />
                                    </Rectangle.Effect>
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Converter={StaticResource MyConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding Converter={StaticResource MyConverter}, ConverterParameter='1'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem  x:Name="visual" Header="{x:Static properties:Resources.VisualHeader}">
                <ListBox Grid.Row="0" x:Name="listVisual" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         MouseDoubleClick="list_MouseDoubleClick" SelectionChanged="list_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="False" VerticalAlignment="Top">
                                <DockPanel.ToolTip>
                                    <DockPanel LastChildFill="True" VerticalAlignment="Top">
                                        <TextBlock  DockPanel.Dock="Bottom" MaxWidth="250" Height="Auto" TextWrapping="Wrap" HorizontalAlignment="Left" Text="{Binding Key}"/>
                                        <Rectangle Fill="{Binding Visual}" MaxWidth="250" MaxHeight="250"/>
                                    </DockPanel>
                                </DockPanel.ToolTip>
                                <Rectangle DockPanel.Dock="Top" Width="60" Height="60" Margin="2, 2, 2, 2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{Binding Visual}" MaxWidth="250" MaxHeight="250"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem  x:Name="user" Header="{x:Static properties:Resources.UserHeader}">
                <ListBox Grid.Row="0" x:Name="listUser" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         MouseDoubleClick="list_MouseDoubleClick"
                         SelectionChanged="list_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Width="70" Height="50">
                                <Rectangle Fill="{Binding Converter={StaticResource MyConverter}}" ClipToBounds="True" Width="30" Height="30" Margin="2, 2, 2, 2" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" />
                                    </Rectangle.Effect>
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Converter={StaticResource MyConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
        <Grid Margin="0,2,0,2" Grid.ColumnSpan="4" Grid.Row="1" x:Name="selectedColorGrid">
            <DockPanel>
                <TextBlock Margin="5,1" DockPanel.Dock="Left" Text="{x:Static properties:Resources.SelectedColor}"/>
                <CheckBox Margin="5,1" DockPanel.Dock="Right" x:Name="spreadColor"  Content="{x:Static properties:Resources.SpreadColor}" IsChecked="{Binding SpreadColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox IsReadOnly="True"  Margin="5,1" x:Name="selectedColor"  Text=""/>
            </DockPanel>
        </Grid>
        <Grid Margin="0,2,0,2" Grid.ColumnSpan="4" Grid.Row="2" x:Name="buttonsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="33*"/>
                <ColumnDefinition Width="33*"/>
                <ColumnDefinition Width="33*"/>
                <ColumnDefinition Width="0*" x:Name="resetColor"/>
            </Grid.ColumnDefinitions>
            <Button Click="Button_Click" Grid.Column="0">
                <TextBlock Text="{x:Static properties:Resources.LoadFromFile}" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
            </Button>
            <Button Click="Button_Save"  Grid.Column="1">
                <TextBlock Text="{x:Static properties:Resources.SaveFile}" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
            </Button>
            <Button ToolTip="{x:Static properties:Resources.ResetColorTooltip}" Click="Button_Reset"  Grid.Column="2">
                <TextBlock Text="{x:Static properties:Resources.ResetColor}" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
            </Button>
            <Button Visibility="Collapsed"  x:Name="colorResetButton" ToolTip="{x:Static properties:Resources.ResetToDefaultColorTooltip}" Click="Button_ResetToDefault"  Grid.Column="3">
                <TextBlock Text="{x:Static properties:Resources.ResetToDefaultColor}" TextWrapping="Wrap" TextAlignment="Center"></TextBlock>
            </Button>
        </Grid>
    </Grid>
</UserControl>
