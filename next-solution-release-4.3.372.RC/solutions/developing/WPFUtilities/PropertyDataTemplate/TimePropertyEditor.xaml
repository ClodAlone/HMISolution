<UserControl x:Class="WPFUtilities.PropertyDataTemplate.TimePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">
    <Grid>
        <dxe:ButtonEdit HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Value, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
            EditValue="{Binding Value, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" AllowDefaultButton="False" AllowSpinOnMouseWheel="False"
            MaskType="DateTimeAdvancingCaret" Mask="T" AllowUpdateTwoWayBoundPropertiesOnSynchronization="True" AllowUpdateTextBlockWhenPrinting="True" DisplayFormatString="T" >
            <dxe:ButtonEdit.Buttons>
                <dxe:SpinButtonInfo SpinStyle="Vertical" 
                 SpinDownCommand="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:ButtonEdit}}, Path=SpinDownCommand}"
                 SpinUpCommand="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:ButtonEdit}}, Path=SpinUpCommand}"
                 />
            </dxe:ButtonEdit.Buttons>
        </dxe:ButtonEdit>
    </Grid>
</UserControl>
