<UserControl x:Class="WPFUtilities.PropertyDataTemplate.StrokeDashArrayPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFUtilities.Converters"
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <local:StrokeDashArrayConverter x:Key="StrokeDashArrayConverter" />
        <!--<local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />-->
    </UserControl.Resources>

    <Grid>
        <ComboBox x:Name="cmbStrokeDashArray" IsEditable="True" IsReadOnly="False"
                  Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource StrokeDashArrayConverter}}"
                  SelectedIndex="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StrokeDashArrayConverter}}">
            <ComboBoxItem Content="{x:Static properties:Resources.StrokeDashArraySolid}" />
            <ComboBoxItem Content="{x:Static properties:Resources.StrokeDashArrayDash}" />
            <ComboBoxItem Content="{x:Static properties:Resources.StrokeDashArrayDot}" />
            <ComboBoxItem Content="{x:Static properties:Resources.StrokeDashArrayDashDot}" />
            <ComboBoxItem Content="{x:Static properties:Resources.StrokeDashArrayDashDotDot}" />
        </ComboBox>
        <!--<TextBox x:Name="txtStrokeDashArray" 
                 Visibility="{Binding SelectedItem, ElementName=cmbStrokeDashArray, Converter={StaticResource NullToVisibilityConverter}}"
                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StrokeDashArrayConverter}, ConverterParameter=TextBox}" />-->
    </Grid>
</UserControl>
