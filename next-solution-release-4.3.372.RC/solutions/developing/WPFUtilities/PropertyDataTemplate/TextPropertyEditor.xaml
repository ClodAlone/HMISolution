<UserControl x:Class="WPFUtilities.PropertyDataTemplate.TextPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="mainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <DockPanel>
            <Button x:Name="clear" DockPanel.Dock="Right" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uri"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                    Validation.ErrorTemplate="{x:Null}" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="text" GotFocus="OnGotFocus" LostFocus="OnLostFocus" TextChanged="OnTextChanged" IsReadOnly="False" Text="{Binding Path=Tag, ElementName=uri, UpdateSourceTrigger=LostFocus}" PreviewKeyDown="OnPreviewKeyDownNewLine" />
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
            Content="{Binding ElementName=uri, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
