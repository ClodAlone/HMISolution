<UserControl x:Class="WPFUtilities.PropertyDataTemplate.TextDefaultPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WPFUtilities.Converters"
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="label" Text="{Binding Value, Mode=OneWay}" 
                   Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType=ContentControl, Mode=FindAncestor}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}" />
        <TextBox x:Name="text" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}" 
                 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                 Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType=ContentControl, Mode=FindAncestor}, Converter={StaticResource BooleanToVisibilityConverter}}"
                 PreviewKeyDown="text_PreviewKeyDown"
                 Validation.ErrorTemplate="{x:Null}" />
        <Button Grid.Column="1" Click="unsetValueBtn_Click" 
                Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType=ContentControl, Mode=FindAncestor}, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTip="{Binding x:Static properties:Resources.TooltipPropertyEditorButtonUnsetValue}" >
                <Button.Content>
                <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <ContentPresenter Grid.Column="2" 
                Content="{Binding ElementName=text, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
