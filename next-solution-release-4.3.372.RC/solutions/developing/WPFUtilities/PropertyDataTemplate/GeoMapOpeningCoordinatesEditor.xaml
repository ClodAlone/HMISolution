<UserControl x:Class="WPFUtilities.PropertyDataTemplate.GeoMapOpeningParametersEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:WPFUtilities.Converters"
             xmlns:properties="clr-namespace:WPFUtilities.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DoubleToLongitudeDegreesConverter x:Key="DoubleToLongitudeDegreesConverter"/>
            <converters:DoubleToLatitudeDegreesConverter x:Key="DoubleToLatitudeDegreesConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.15*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock 
            Grid.Row="0" 
            Grid.Column="0" 
            Text="{x:Static properties:Resources.GeoMapOpeningParametersLongitude}"/>
        <dxe:TextEdit 
            Grid.Row="0"
            Grid.Column="1"
            x:Name="longitude" 
            MaskType="Regular" 
            Mask="\d{3}° \d{2}' \d{2}'' >[WE]" 
            MaskShowPlaceHolders="False" 
            LostFocus="longitude_LostFocus"
            DisplayFormatString="" 
            MaskUseAsDisplayFormat="True"
            Margin="0 1 0 1"/>
        <ContentPresenter 
            Grid.Row="0"
            Grid.Column="2" 
                Content="{Binding ElementName=longitude, Path=(Validation.Errors).CurrentItem}" />


        <TextBlock 
            Grid.Row="1" 
            Grid.Column="0" 
            Text="{x:Static properties:Resources.GeoMapOpeningParametersLatitude}"/>
        <dxe:TextEdit 
            Grid.Row="1"
            Grid.Column="1" 
            x:Name="latitude" 
            MaskType="Regular" 
            Mask="\d{3}° \d{2}' \d{2}'' >[SN]" 
            MaskShowPlaceHolders="False"
            LostFocus="latitude_LostFocus"
            DisplayFormatString="" 
            MaskUseAsDisplayFormat="True"
            Margin="0 1 0 1"/>
        <ContentPresenter 
            Grid.Row="1"
            Grid.Column="2"   
            Content="{Binding ElementName=latitude, Path=(Validation.Errors).CurrentItem}" />

        <TextBlock 
            Grid.Row="2" 
            Grid.Column="0" 
            Text="{x:Static properties:Resources.GeoMapOpeningParametersZoomLevel}"/>
        <dxe:SpinEdit 
            x:Name="zoomLevel"
            Grid.Row="2" 
            Grid.Column="1" 
            TextBlock.TextAlignment="Left" 
            AllowSpinOnMouseWheel="False" 
            ValidateOnTextInput="True"
            ShowError="True"
            AllowRoundOutOfRangeValue="False" 
            InvalidValueBehavior="WaitForValidValue"
            MaskType="Numeric" 
            dxe:NumericMaskOptions.AlwaysShowDecimalSeparator="False"
            DisplayFormatString=""
            LostFocus="zoomLevel_LostFocus"
            Increment="{Binding Path=GeoMapOpeningParametersIncrementZoom, Source={x:Static properties:Settings.Default}}"
            MinValue="{Binding Path=GeoMapOpeningParametersMinZoom, Source={x:Static properties:Settings.Default}}"
            MaxValue="{Binding Path=GeoMapOpeningParametersMaxZoom, Source={x:Static properties:Settings.Default}}"
            Validation.ErrorTemplate="{x:Null}"
            Margin="0 1 0 1">
        </dxe:SpinEdit>
        <ContentPresenter 
            Grid.Row="2"
            Grid.Column="2"   
            Content="{Binding ElementName=zoomLevel, Path=(Validation.Errors).CurrentItem}" />

        <TextBlock 
            Grid.Row="3" 
            Grid.Column="0" 
            Text="{x:Static properties:Resources.GeoMapOpeningParametersSetMap}"/>
        <Button 
            Grid.Row="3"
            Grid.Column="1" 
            x:Name="btnOpenMap" 
            Tag="{Binding Value, Mode=TwoWay}" 
            Click="btnOpenMap_Click"
            Margin="0 1 0 1">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        
    </Grid>
    
</UserControl>
