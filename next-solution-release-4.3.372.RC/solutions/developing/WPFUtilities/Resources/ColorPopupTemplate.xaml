<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys" 
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
    xmlns:dxei="http://schemas.devexpress.com/winfx/2008/xaml/editors/internal" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:properties="clr-namespace:WPFUtilities.Properties">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <dx:EmbeddedResourceImageConverter x:Key="EmbeddedResourceImageConverter" />
    <ControlTemplate x:Key="{dxet:ColorEditThemeKey ResourceKey=EditTemplate, IsThemeIndependent=True}">
        <dxb:BarManager x:Name="PART_Editor" CreateStandardLayout="False">
            <dxb:BarManager.Items>
                <dxb:BarButtonItem x:Name="PART_ResetButton" Content="{x:Static properties:Resources.DefaultColorButtonContent}" IsVisible="{Binding Path=DataContext.ShowDefaultColorButton, RelativeSource={RelativeSource TemplatedParent}}" />
                <dxei:GalleryBarItem x:Name="galleryItem">
                    <dxei:GalleryBarItem.Gallery>
                        <dxb:Gallery x:Name="PART_Gallery" 
                                     ColCount="{Binding Path=DataContext.ColumnCount, RelativeSource={RelativeSource TemplatedParent}}" 
                                     MinColCount="{Binding Path=DataContext.ColumnCount, RelativeSource={RelativeSource TemplatedParent}}"
                                     ItemMargin="{Binding Path=DataContext.ChipMargin, RelativeSource={RelativeSource TemplatedParent}}"
                                     ItemCheckMode="Single" 
                                     IsGroupCaptionVisible="True" 
                                     IsItemGlyphVisible="False"
                                     IsItemDescriptionVisible="False" 
                                     IsItemCaptionVisible="True"
                                     GroupItemsMargin="0,3,0,3"
                                     AllowFilter="False">
                        </dxb:Gallery>
                    </dxei:GalleryBarItem.Gallery>
                </dxei:GalleryBarItem>
                <dxb:BarButtonItem x:Name="PART_NoColorButton" Content="{x:Static properties:Resources.NoColorButtonContent}" IsVisible="{Binding Path=DataContext.ShowNoColorButton, RelativeSource={RelativeSource TemplatedParent}}" />
                <dxb:BarButtonItem x:Name="PART_MoreColorsButtonCustom" Content="{x:Static properties:Resources.MoreColorsButtonContent}" IsVisible="{Binding Path=DataContext.ShowMoreColorsButton, RelativeSource={RelativeSource TemplatedParent}}" Glyph="{StaticResource MoreColors}" CloseSubMenuOnClick="False" Command="{Binding MoreColorsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource TemplatedParent}}">
                </dxb:BarButtonItem>
            </dxb:BarManager.Items>
            <dxb:MenuBarControl Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}">
                <dxb:MenuBarControl.Menu>
                    <dxb:PopupMenu x:Name="PART_Menu">
                        <dxb:BarButtonItemLink BarItemName="PART_ResetButton" />
                        <dxei:GalleryBarItemLink BarItemName="galleryItem" />
                        <dxb:BarButtonItemLink BarItemName="PART_NoColorButton" />
                        <dxb:BarButtonItemLink BarItemName="PART_MoreColorsButtonCustom" />
                    </dxb:PopupMenu>
                </dxb:MenuBarControl.Menu>
            </dxb:MenuBarControl>
        </dxb:BarManager>
    </ControlTemplate>
</ResourceDictionary>