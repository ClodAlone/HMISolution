<UserControl x:Class="UFEventEditor.Controls.NewEvent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:properties="clr-namespace:UFEventEditor.Properties"
             xmlns:converters="clr-namespace:UFEventEditor.Converters"
             xmlns:common="clr-namespace:OPCUAViewModel.PropertyDataTemplate;assembly=OPCUAViewModel"
             xmlns:wpfconverters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             x:Name="NewEventUserControl"
             mc:Ignorable="d" Width="500" Height="700"
             d:DesignHeight="700" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <wpfconverters:EditValueToBrushConverter x:Key="EditValueToBrushConverter" />
            <converters:TagTypeToVisibilityConverter x:Key="TagTypeToVisibilityConverter"/>
            <wpfconverters:DefaultDateTimeConverter x:Key="DefaultDateTimeConverter"/>
            <converters:SchedTypeToVisibilityConverter x:Key="SchedTypeToVisibilityConverter"/>
            <converters:ConditionToVisibilityConverter x:Key="ConditionToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  DockPanel.Dock="Top" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewEventTitle}" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewEventName}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                    x:Name="textEditName" />
                    <ContentPresenter Grid.Row="1" Grid.Column="2" 
                                      Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

                    <CheckBox Grid.Column="1" Grid.Row="2" x:Name="checkBoxDown"  IsChecked="{Binding Enable}" 
                              Content="{x:Static properties:Resources.NewEventEnable}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewEventType}" VerticalAlignment="Center" Name="lblType" />
                    <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding Type, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" x:Name="comboType" 
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
                    <ContentPresenter Grid.Row="3" Grid.Column="2" 
                                      Content="{Binding ElementName=comboType, Path=(Validation.Errors).CurrentItem}" />

                    <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewEventEnableName}" VerticalAlignment="Center" Margin="0,7" />
                    <DockPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <common:OPCUAEntityReferencePropertyEditorFromXML x:Name="textEditEnableItem"/>
                    </DockPanel>
                    <ContentPresenter Grid.Row="4" Grid.Column="3" Content="{Binding ElementName=textEditEnableItem, Path=(Validation.Errors).CurrentItem}"/>
                </Grid>
                <Grid Grid.Row="1" Visibility="{Binding Type, Converter={StaticResource TagTypeToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.NewEventTagName}" VerticalAlignment="Center" Margin="0,7" />
                    <DockPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <common:OPCUAEntityReferencePropertyEditorFromXML x:Name="textEditItem"/>
                    </DockPanel>
                    <ContentPresenter Grid.Row="0" Grid.Column="3" Content="{Binding ElementName=textEditItem, Path=(Validation.Errors).CurrentItem}"/>

                    <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewEventCondition}" VerticalAlignment="Center" x:Name="textConditionType" />
                    <ComboBox Grid.Column="1" Grid.Row="1" SelectedValue="{Binding ConditionType}" x:Name="comboConditionType" 
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />

                    <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewEventValue}" VerticalAlignment="Center" x:Name="textBlockActivationValue" Margin="0,7" 
                               Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" />
                    <dxe:SpinEdit Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" Grid.Column="1" Grid.Row="2" MaskType="Numeric" Mask="#########.00" MaskUseAsDisplayFormat="True" EditValueType="{x:Type sys:Double}" Name="textActivationValue" Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" EditValue="{Binding ActivationValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}">
                        <dxe:SpinEdit.Foreground>
                            <MultiBinding Converter="{StaticResource EditValueToBrushConverter}">
                                <Binding Path="ActivationValue" />
                                <Binding ElementName="NewEventUserControl" Path="Foreground" />
                            </MultiBinding>
                        </dxe:SpinEdit.Foreground>
                    </dxe:SpinEdit>
                    <ContentPresenter Grid.Row="2" Grid.Column="2" Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" 
                                      Content="{Binding ElementName=textActivationValue, Path=(Validation.Errors).CurrentItem}"/>
                    <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewEventStringValue}" VerticalAlignment="Center" x:Name="textBlockActivationStringValue" Margin="0,7" 
                               Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" />
                    <TextBox Grid.Column="1" Grid.Row="3" Name="textActivationStringValue" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Validation.ErrorTemplate="{x:Null}" Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" 
                                       Text="{Binding ActivationStringValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
                    <ContentPresenter Grid.Row="3" Grid.Column="2" Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" 
                                      Content="{Binding ElementName=textActivationStringValue, Path=(Validation.Errors).CurrentItem}"/>


                    <TextBlock Grid.Row="4" Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" Text="{x:Static properties:Resources.NewEventValueName}" VerticalAlignment="Center" Margin="0,7" />
                    <DockPanel Grid.Row="4" Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <common:OPCUAEntityReferencePropertyEditorFromXML x:Name="textEditValueItem"/>
                    </DockPanel>
                    <ContentPresenter Grid.Row="4" Visibility="{Binding ConditionType, Converter={StaticResource ConditionToVisibilityConverter}}" Grid.Column="3" Content="{Binding ElementName=textEditValueItem, Path=(Validation.Errors).CurrentItem}"/>                
                </Grid>
                <Grid Grid.Row="2" Visibility="{Binding Type, Converter={StaticResource SchedTypeToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.NewSchedType}" VerticalAlignment="Center" Name="lblSchedType" />
                    <ComboBox Grid.Column="1" Grid.Row="0" SelectedValue="{Binding SchedType, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" 
                              x:Name="comboSchedType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
                    <ContentPresenter Grid.Row="0" Grid.Column="2" Content="{Binding ElementName=comboSchedType, Path=(Validation.Errors).CurrentItem}" />

                    <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.Time}" VerticalAlignment="Center" Name="lblTime" />
                    <dxe:DateEdit Margin="2,0,2,0" Grid.Row="1" Grid.Column="1" EditValue="{Binding Time, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultDateTimeConverter}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                        x:Name="textEditTime" MaskType="TimeSpan" Mask="HH:mm:ss" MaskUseAsDisplayFormat="True" AllowDefaultButton="False" PopupMaxHeight="0">
                        <dxe:ButtonEdit.Buttons>
                            <dxe:SpinButtonInfo IsDefaultButton="true" SpinStyle="Vertical" />
                        </dxe:ButtonEdit.Buttons>
                    </dxe:DateEdit>
                    <ContentPresenter Grid.Row="1" Grid.Column="2" 
                    Content="{Binding ElementName=textEditTime, Path=(Validation.Errors).CurrentItem}" />

                    <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.Date}" VerticalAlignment="Center" Name="lblDate" />
                    <dxe:DateEdit Margin="2,0,2,0" Grid.Row="2" Grid.Column="1" EditValue="{Binding Date, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultDateTimeConverter}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}"
                        x:Name="textEditDate" MaskType="DateTime" Mask="d" MaskUseAsDisplayFormat="True"/>
                    <ContentPresenter Grid.Row="2" Grid.Column="2" 
                    Content="{Binding ElementName=textEditDate, Path=(Validation.Errors).CurrentItem}" />
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid DockPanel.Dock="Bottom">
            <!--<TextBlock Grid.Row="0" Text="{x:Static properties:Resources.NewEventCommand}" VerticalAlignment="Center" />-->
            <ContentControl x:Name="CommandCtrl" />
        </Grid>
    </DockPanel>
</UserControl>
