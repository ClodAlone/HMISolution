<UserControl x:Class="CrossReferenceControl.CrossReference"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:CrossReferenceControl.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
   <Grid x:Name="view">
        <ContentControl Name="crossreference" />

        <StackPanel x:Name="uriLoading" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <cc:CircularProgressBar Background="Black" Opacity="0.5" />
            <TextBlock Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Opacity="0.5"
                       FontFamily="Segoe UI" FontWeight="Light" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="White" FontSize="32" />
        </StackPanel>

    </Grid>
</UserControl>
