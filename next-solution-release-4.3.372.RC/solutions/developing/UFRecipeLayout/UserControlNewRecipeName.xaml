<UserControl x:Name="controlRecipeName"
             x:Class="UFRecipeLayout.UserControlNewRecipeName"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFRecipeLayout.Properties" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="160">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="textRecipeName"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         Text="{Binding Path=RecipeName, 
                                FallbackValue=Recipe name goes here,
                                ElementName=controlRecipeName, 
                                Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged, 
                                ValidatesOnDataErrors=True}"  Validation.ErrorTemplate="{x:Null}" />
        <ContentPresenter Grid.Column="1"
                        Content="{Binding ElementName=textRecipeName, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
