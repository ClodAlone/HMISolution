<UserControl x:Class="UFRecipeLayout.LayoutItemControls.ItemControlNumericDataValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             Width="Auto" Height="Auto" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <dxe:SpinEdit x:Name="textDataValue" TextBlock.TextAlignment="Left" 
                      ShowNullText="False" ShowEditorButtons="False"
                      AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" 
                      AllowRoundOutOfRangeValue="False" InvalidValueBehavior="AllowLeaveEditor"
                      MaskType="Numeric" dxe:NumericMaskOptions.AlwaysShowDecimalSeparator="False"
                      Validation.ErrorTemplate="{x:Null}" />
        
        <ContentPresenter Grid.Column="1"
            Content="{Binding ElementName=textDataValue, Path=(Validation.Errors).CurrentItem}" />
        
    </Grid>
</UserControl>
