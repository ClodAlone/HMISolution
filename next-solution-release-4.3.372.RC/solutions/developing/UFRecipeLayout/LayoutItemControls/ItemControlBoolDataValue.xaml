<UserControl x:Class="UFRecipeLayout.LayoutItemControls.ItemControlBoolDataValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Width="Auto" Height="Auto">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
    
        <CheckBox x:Name="checkValue" Validation.ErrorTemplate="{x:Null}" />
        <ContentPresenter Grid.Column="1"
                Content="{Binding ElementName=checkValue, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>