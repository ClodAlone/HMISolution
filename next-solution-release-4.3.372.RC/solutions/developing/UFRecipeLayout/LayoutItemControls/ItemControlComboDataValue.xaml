<UserControl x:Class="UFRecipeLayout.LayoutItemControls.ItemControlComboDataValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Width="Auto" Height="Auto" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="textDataValue" Validation.ErrorTemplate="{x:Null}" />
        
        <ContentPresenter Grid.Column="1"
            Content="{Binding ElementName=textDataValue, Path=(Validation.Errors).CurrentItem}" />
        
    </Grid>
</UserControl>
