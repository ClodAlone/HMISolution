<UserControl x:Class="UFRecipeLayout.LayoutItemControls.ItemControlRecipeIndex"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:properties="clr-namespace:UFRecipeLayout.Properties"
             xmlns:wpfutils="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             Width="Auto" Height="Auto" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!--
            <DataTemplate x:Key="recipeTemplate" >
                <TextBlock x:Name="textblock" Text="{Binding Path=ColumnName}" Width="150"/>
                <DataTemplate.Triggers>
                    <DataTrigger 
                        Binding="{Binding Path=IsActive}" 
                        Value="False">
                        <Setter 
                        TargetName="textblock" 
                        Property="Foreground" 
                        Value="Green"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="marker" Text="*" Margin="5,0,5,0" Foreground="Red" Visibility="Collapsed"
                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                   ToolTip="{x:Static properties:Resources.PendingChangesTooltipMarker}" />
        <wpfutils:ComboWeb ItemPropertyName="Name" Grid.Column="1" x:Name="textRecipeIndex" IsEditable="True" MinWidth="150" 
                    Validation.ErrorTemplate="{x:Null}" />
        <ContentPresenter Grid.Column="2"
            Content="{Binding ElementName=textRecipeIndex, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
