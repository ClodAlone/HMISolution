<Window x:Class="test.Window1" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:opcuavm="clr-namespace:OPCUAViewModel;assembly=OPCUAViewModel"
        xmlns:nad="clr-namespace:NetAPIDiscovery;assembly=NetAPIDiscovery"
        
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Window1" Height="300" Width="755" 
        
         >
    <Grid>
        <Button Margin="16,12,0,0" Name="button1" Click="button1_Click" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top" Width="66">Search</Button>
        <Button Margin="106,14,103,0" Name="button2" Click="button2_Click" Height="34" VerticalAlignment="Top">Refresh</Button>
        <ListBox Margin="31,76,0,28" Name="listBox1" ItemsSource="{Binding Path=Children}" HorizontalAlignment="Left" Width="154" />
        <ListBox HorizontalAlignment="Left" ItemsSource="{Binding Path=m_ListDiscoveringWorstations}" Margin="205,76,0,28" Name="listBox2" Width="154" MouseDoubleClick="listBox2_MouseDoubleClick" />
        <ListBox HorizontalAlignment="Right" ItemsSource="{Binding Path=m_ListDiscoveredWorstations}" Margin="0,76,194,28" Name="listBox3" Width="154" />

        <TreeView Margin="0,54,35,0" ItemsSource="{Binding NetworkViewModel.Children}" HorizontalAlignment="Right" Width="136">
            <TreeView.ItemContainerStyle>
                <!-- 
        This Style binds a TreeViewItem to a TreeViewItemViewModel. 
        -->
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>

                <HierarchicalDataTemplate DataType="{x:Type nad:NetworkViewModel}" 
          ItemsSource="{Binding Children}"
          >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Network" />
                        <Button Margin="3,0">Add Network</Button>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type nad:DomainViewModel}" 
          ItemsSource="{Binding Children}"
          >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DomainName}" />
                        <Button Margin="3,0">Add Domain</Button>
                    </StackPanel>
                </HierarchicalDataTemplate>


                <HierarchicalDataTemplate DataType="{x:Type nad:WorkstationViewModel}" 
          ItemsSource="{Binding Children}"
          >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Workstation}" />
                        <Button Margin="3,0">Add Workstation</Button>
                    </StackPanel>
                </HierarchicalDataTemplate>

            </TreeView.Resources>

        </TreeView>

    </Grid>
</Window>