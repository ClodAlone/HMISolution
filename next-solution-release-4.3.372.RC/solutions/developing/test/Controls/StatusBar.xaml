<UserControl x:Class="test.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
    >
    <StatusBar x:Name="statusBar">
        <StatusBar.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ItemsPanelTemplate>
        </StatusBar.ItemsPanel>
        <StatusBarItem Grid.Column="0" HorizontalAlignment="Left" x:Name="StatusText">Ready</StatusBarItem>
        <StatusBarItem Grid.Column="1" x:Name="TimePortion" Content="{Binding CurrentDateAndTime}"></StatusBarItem>
        <StatusBarItem Grid.Column="2" HorizontalAlignment="Right" IsEnabled="{Binding IsCapsPressed}">CAPS</StatusBarItem>
        <StatusBarItem Grid.Column="3" HorizontalAlignment="Right" IsEnabled="{Binding IsInsPressed}">INS</StatusBarItem>
        <StatusBarItem Grid.Column="4" HorizontalAlignment="Right" IsEnabled="{Binding IsScrollPressed}">SCR</StatusBarItem>
        <StatusBarItem Grid.Column="5" HorizontalAlignment="Right" IsEnabled="{Binding IsNumPressed}">NUM</StatusBarItem>
    </StatusBar>

</UserControl>
