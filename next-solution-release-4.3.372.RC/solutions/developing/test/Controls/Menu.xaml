<UserControl x:Class="test.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Menu Grid.Row="0" Name="mainMenu">
        <MenuItem Header="_File">
            <MenuItem Command="New" Icon="{DynamicResource CommandNew}" />
            <MenuItem Command="Open" Icon="{DynamicResource CommandOpen}" />
            <MenuItem Command="Save" Icon="{DynamicResource CommandSave}" />
            <MenuItem Command="SaveAs" />
            <Separator />
            <MenuItem Command="Print" Icon="{DynamicResource CommandPrint}" />
            <MenuItem Command="PrintPreview" Icon="{DynamicResource CommandPrintPreview}" />
            <Separator />
            <MenuItem Header="E_xit" Click="Exit_Click" />
        </MenuItem>
        <MenuItem Header="_Edit">
            <MenuItem Command="Undo" Icon="{DynamicResource CommandUndo}" />
            <MenuItem Command="Redo" Icon="{DynamicResource CommandRedo}" />
            <Separator />
            <MenuItem Command="Cut" Icon="{DynamicResource CommandCut}" />
            <MenuItem Command="Copy" Icon="{DynamicResource CommandCopy}" />
            <MenuItem Command="Paste" Icon="{DynamicResource CommandPaste}" />
            <Separator />
            <MenuItem Command="SelectAll" />
        </MenuItem>
        <MenuItem Header="_Help">
            <MenuItem Command="Help" />
        </MenuItem>
    </Menu>
</UserControl>
