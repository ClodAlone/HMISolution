<dxb:BarManager
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             x:Class="ScriptManager.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScriptManager.MenuControls"
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="ScriptsBarManagerToolbar"
             mc:Ignorable="d">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="scriptToolbar" x:Name="scriptToolBar"
                    GlyphSize="Small" ShowDragWidget="True" 
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True"
                    Caption="{x:Static translatableMenu:Resources.EditRibbonTitle}" >
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biEditReferences"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biDebugStepInto"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
