<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="ScreenManager.Services" elementFormDefault="qualified" targetNamespace="ScreenManager.Services" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import namespace="http://schemas.datacontract.org/2004/07/ScreenManager.Services" />
