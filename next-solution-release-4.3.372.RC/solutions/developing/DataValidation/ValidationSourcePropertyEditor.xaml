<UserControl x:Class="DataValidation.ValidationSourcePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:local="clr-namespace:DataValidation"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="{Binding SourcesListLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" x:Name="progressBar" VerticalAlignment="Top"/>
            <ComboBox x:Name="sourcesCombo" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="150"
                          IsEditable="True" IsReadOnly="True"  
                          Text="{Binding Value, Mode=OneTime}"         
                          SelectedValue="{Binding Value, Mode=TwoWay}" 
                          DropDownOpened="OnDropDownOpened"
                          />
        </DockPanel>
    </Grid>
</UserControl>
