<UserControl x:Class="CommandManager.UserControls.UnlockUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommandManager.UserControls"
             xmlns:converters="clr-namespace:CommandManager.UserControls.Converters"
             xmlns:properties="clr-namespace:CommandManager.Properties">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ItemSourceLockedUsersConverter x:Key="ItemSourceLockedUsersConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label x:Name="userName" Content="{x:Static properties:Resources.UnlockUserList}"/>
        <ComboBox x:Name="cmbUser" Grid.Row="1" IsEditable="False" 
                  ItemsSource="{Binding Converter={StaticResource ItemSourceLockedUsersConverter}}" DisplayMemberPath="UserName" SelectedValuePath="UserName" />
    </Grid>
</UserControl>
