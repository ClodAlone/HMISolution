<UserControl x:Class="CommandManager.UserControls.EditMethodCallParameters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:properties="clr-namespace:CommandManager.Properties" 
             xmlns:local="clr-namespace:CommandManager.UserControls.Converters"
             mc:Ignorable="d" Width="400" Height="300"
             d:DesignHeight="300" d:DesignWidth="412">
    <UserControl.Resources>
        <local:NodeIdToTypeConverter x:Key="NodeIdConverter" x:Shared="False"/>
        <local:ArgumentValueConverter x:Key="ArgumentValueConverter" x:Shared="False"/>       
    </UserControl.Resources>
    <Grid>
        <dxg:GridControl Name="gridControl" MinHeight="10" MinWidth="10" 
                         Visibility="Visible"
                         AutoPopulateColumns="False" 
                         AllowDrop="False" 
                         AllowLiveDataShaping="False">
            <dxg:GridControl.Columns>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" FieldName="Name" 
                                DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" 
                                Header="{x:Static properties:Resources.NameColumnHeader}" />
                <dxg:GridColumn ReadOnly="False" AllowEditing="True" FieldName="Value" 
                                Header="{x:Static properties:Resources.ValueColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dxe:TextEdit MaskType="None">
                                <dxe:TextEdit.Text>
                                    <MultiBinding Converter="{StaticResource ArgumentValueConverter}">
                                        <Binding Path="RowData.Row" Mode="OneWay" />
                                        <Binding Path="DataContext" ElementName="gridControl" Mode="OneWay" />
                                    </MultiBinding>
                                </dxe:TextEdit.Text>
                            </dxe:TextEdit>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" FieldName="Description" 
                                DisplayMemberBinding="{Binding Path=Description, Mode=OneWay}" Header="{x:Static properties:Resources.DescriptionColumnHeader}" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="False"
                            NavigationStyle="Cell" 
                            MultiSelectMode="None">
                    <dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <!--<Style.Triggers>
                                <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>-->
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource NodeIdConverter}">
                                        <Binding Path="Row" Mode="OneWay" />
                                        <Binding Path="DataContext" ElementName="gridControl" Mode="OneWay" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        
                    </dxg:TableView.RowStyle>
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
