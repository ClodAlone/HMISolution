<UserControl x:Class="ClientEditor.ClientEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:self="clr-namespace:ClientEditor"
             xmlns:Controls="clr-namespace:ClientEditor.Controls"
             xmlns:properties="clr-namespace:ClientEditor.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

  <UserControl.CommandBindings>

    <CommandBinding Command="ApplicationCommands.Save"
                Executed="OnCommandSave"
                CanExecute="CanCommandSave" />

    <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewTag}"
                Executed="OnAddNewTempTag"
                CanExecute="CanAddNewTempTag" />

    <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewFolder}"
                Executed="OnAddNewTempFolder"
                CanExecute="CanAddNewTempFolder" />

    <CommandBinding Command="ApplicationCommands.Delete"
                Executed="OnRemoveItem"
                CanExecute="CanRemoveItem" />

  </UserControl.CommandBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/Client.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <dx:DXTabControl Name="tabControlExt">
            <dx:DXTabItem Header="{x:Static properties:Resources.tabGeneralSetting}"  x:Name="tabGeneralSettings" 
                          Glyph="{StaticResource CEGeneralSettingsSmall}">
            </dx:DXTabItem>
            <dx:DXTabItem Header="{x:Static properties:Resources.tabTagList}" x:Name="tabTempVariables" 
                          Glyph="{StaticResource CEAddressSpaceSmall}">
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
