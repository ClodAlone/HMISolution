<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="RecipeUAServer.UAServer" type="Opc.Ua.ApplicationConfigurationSection,Opc.Ua.Core"/>
    <section name="OPCUAClient" type="Opc.Ua.ApplicationConfigurationSection,Opc.Ua.Core" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="RecipeUAServer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <appSettings>
    <add key="log4net.Internal.Emit" value="false"/>
  </appSettings>
  <RecipeUAServer.UAServer>
    <ConfigurationLocation xmlns="http://opcfoundation.org/UA/SDK/Configuration.xsd">
      <FilePath>RecipeUAServer.UAServer.Config.xml</FilePath>
    </ConfigurationLocation>
  </RecipeUAServer.UAServer>
  <OPCUAClient>
    <ConfigurationLocation xmlns="http://opcfoundation.org/UA/SDK/Configuration.xsd">
      <FilePath>RecipeUAServer.Core.Config.xml</FilePath>
    </ConfigurationLocation>
  </OPCUAClient>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>