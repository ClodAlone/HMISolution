<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp2.0</TargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>RecipeUAServer</RootNamespace>
    <AssemblyName>RecipeUAServer.Core</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <DefineConstants>NET_CORE;NET_STANDARD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;NET_CORE;NET_STANDARD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>NET_CORE;NET_STANDARD</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="DevExpress.Data" Version="21.2.13" />
    <PackageReference Include="DevExpress.Xpo" Version="21.2.13" />
    <PackageReference Include="log4net" Version="2.0.14" />
    <PackageReference Include="Mindscape.Raygun4Net.NetCore" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Sources\UA SDK\UA-.NETStandard\Stack\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\..\..\Sources\UA SDK\UA-.NETStandard\Libraries\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\Sources\UA SDK\UA-.NETStandard\Libraries\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\ClientEditor\ClientEditor.csproj" />
    <ProjectReference Include="..\DriverBaseClassLibrary\DriverBaseInterfaces.csproj" />
    <ProjectReference Include="..\ConcurrentLog4Net\ConcurrentLog4Net.csproj" />
    <ProjectReference Include="..\Dynamics\MSZ.csproj" />
    <ProjectReference Include="..\SolutionExplorer\UFProjectManager.csproj" />
    <ProjectReference Include="..\UFRecipeEditor\UFRecipeEditor.csproj" />
    <ProjectReference Include="..\UFRecipeExecuter\UFRecipeExecuter.csproj" />
    <ProjectReference Include="..\UFRecipeSettings\UFRecipeSettings.csproj" />
    <ProjectReference Include="..\RecipeUAServerInfo\RecipeUAServerInfo.csproj" />
    <ProjectReference Include="..\OPCUAViewModel\OPCUAViewModel.csproj" />
    <ProjectReference Include="..\UFInterfaces\UFInterfaces.csproj" />
    <ProjectReference Include="..\UFUAEditor\UFUAEditor.csproj" />
    <ProjectReference Include="..\UFUAServerBase\UFUAServerBase.csproj" />
    <ProjectReference Include="..\UFUATag\UFUAModel.csproj" />
    <ProjectReference Include="..\UriResolver\UriResolver.csproj" />
    <ProjectReference Include="..\Utilities\Utilities.csproj" />
    <ProjectReference Include="..\ViewModelBase\ViewModelBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
    <Compile Include="..\RecipeUAServer\RecipeUAServer.cs" Link="RecipeUAServer.cs" />
    <Compile Include="..\RecipeUAServer\RecipeUANodeManager.cs" Link="RecipeUANodeManager.cs" />
    <Compile Include="..\RecipeUAServer\RecipeServer.cs" Link="RecipeServer.cs" />
    <Compile Include="..\RecipeUAServer\Program.cs" Link="Program.cs" />
    <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
    <Content Include="App.ico" />
      <Compile Include="..\RecipeUAServer\Properties\Settings.Designer.cs" Link="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>..\RecipeUAServer\Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DesignTime>True</DesignTime>
    </Compile>
    <None Include="..\RecipeUAServer\Properties\Settings.settings" Link="Properties\Settings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
    </None>
    <Compile Include="..\RecipeUAServer\Properties\Resources.Designer.cs" Link="Properties\Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\RecipeUAServer\Properties\Resources.resx" Link="Properties\Resources.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="RecipeUAServer.UAServer.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="OPCUAClient.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="RecipeUAServer.Core.Config.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
