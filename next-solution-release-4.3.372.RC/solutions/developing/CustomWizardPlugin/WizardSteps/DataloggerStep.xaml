<UserControl x:Class="CustomWizardPlugin.DataloggerStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:properties="clr-namespace:CustomWizardPlugin.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             HorizontalAlignment="Left" VerticalAlignment="Top">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/CustomWizard.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

    <GroupBox HorizontalAlignment="Left">
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="281" Width="497">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!--<ContentControl x:Name="Control1" />-->
            <StackPanel Grid.ColumnSpan="2" Grid.Row="0"  Orientation="Horizontal">
                <Image VerticalAlignment="Top"  Margin="2" Source="{StaticResource CWHistoricalPrototypes}" Height="32" Width="32" />
                <Label VerticalAlignment="Top" Content="{x:Static properties:Resources.DataloggerSection}" FontFamily="Calibri" FontSize="22" />
            </StackPanel>
            <CheckBox Grid.Row="1" IsChecked="False" Click="checkboxEnable_Click" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxEnable" Content="{x:Static properties:Resources.AddDatalogger}" MinHeight="22" MinWidth="169" Margin="12,0,0,0" Grid.RowSpan="2" />
            <Grid  Margin="12,0,0,0" x:Name="gridControlContainer" IsEnabled="False" Grid.RowSpan="8" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="169*"/>
                    <ColumnDefinition Width="51*"/>
                    <ColumnDefinition Width="74*"/>
                </Grid.ColumnDefinitions>
                <CheckBox  Margin="12,0,0,0" Grid.ColumnSpan="3" Grid.Row="0" IsChecked="True" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLROnChange" Content="{x:Static properties:Resources.AddDataloggerOnChange}"/>
                <CheckBox  Margin="12,0,0,0" Grid.ColumnSpan="3" Grid.Row="1" IsChecked="True" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLR5Sec" Content="{x:Static properties:Resources.AddDatalogger5Sec}"/>
                <CheckBox  Margin="12,0,0,0" Grid.ColumnSpan="3" Grid.Row="2" IsChecked="True" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLR30Sec" Content="{x:Static properties:Resources.AddDatalogger30Sec}"/>
                <CheckBox  Margin="12,0,0,0" Grid.ColumnSpan="3" Grid.Row="3" IsChecked="True" VerticalAlignment="Top" HorizontalAlignment="Left" x:Name="checkboxDLR1Min" Content="{x:Static properties:Resources.AddDatalogger1Min}"/>
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>
