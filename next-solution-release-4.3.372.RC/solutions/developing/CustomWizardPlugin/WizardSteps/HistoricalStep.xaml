<UserControl x:Class="CustomWizardPlugin.HistoricalStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:properties="clr-namespace:CustomWizardPlugin.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             HorizontalAlignment="Left" VerticalAlignment="Top">

    <Grid HorizontalAlignment="Left" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="345" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="690"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="30,0,40,0">
                <TextBlock TextWrapping="WrapWithOverflow" FontSize="20" HorizontalAlignment="Left" x:Name="labelHisTitle" Text="{x:Static properties:Resources.Step4Comment}" Height="Auto" 
                           MaxWidth="{Binding ElementName=historyconnectionString,Path=ActualWidth}"/>
                <!--<RadioButton GroupName="AddHis" x:Name="WithoutHisRadio" IsChecked="True" Content="{x:Static properties:Resources.No}" Margin="0,8,0,0.156" Width="66" />
                <RadioButton GroupName="AddHis" x:Name="WithHisRadio" IsChecked="False" Content="{x:Static properties:Resources.Yes}" Margin="0,8,0,0.156" Width="66"/>-->
            </StackPanel>
            <GroupBox x:Name="HisGroup"  Margin="10,0,50,24"  Grid.Row="1" Grid.RowSpan="5" BorderThickness="0" BorderBrush="{x:Null}" >
                <!--IsEnabled="{Binding ElementName=WithHisRadio,Path=IsChecked}">-->
                <StackPanel Margin="12,10,12,0" Orientation="Vertical">
                    <StackPanel>
                        <TextBox Height="50" TextWrapping="Wrap"  
                                 Text="" 
                                 x:Name="historyconnectionString" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" />
                        <Button Content="{x:Static properties:Resources.GetConnectionString}" x:Name="buttonHisConnectoinString" Click="buttonHisConnectoinString_Click" Grid.Row="3" Grid.ColumnSpan="3"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="30,0,40,0">
                <TextBlock  TextWrapping="WrapWithOverflow" FontSize="20"  HorizontalAlignment="Left" x:Name="labelDlrTitle" Text="{x:Static properties:Resources.AddDLRConnectionString}" Margin="0,0,0,0.156" Height="Auto" 
                           MaxWidth="{Binding ElementName=historyconnectionString,Path=ActualWidth}"/>
                <!--<RadioButton GroupName="AddDlrConn" x:Name="WithoutDlrConRadio" IsChecked="True" Content="{x:Static properties:Resources.No}" Margin="0,8,0,0.156" Width="66" />
                <RadioButton GroupName="AddDlrConn" x:Name="WithDlrConnRadio" IsChecked="False" Content="{x:Static properties:Resources.Yes}" Margin="0,8,0,0.156" Width="66"/>-->
            </StackPanel>
            <GroupBox x:Name="DlrGroup" Margin="12,0,50,0.185" Grid.Row="7" Grid.RowSpan="4" BorderThickness="0" BorderBrush="{x:Null}"  
                IsEnabled="{Binding ElementName=WithDlrConnRadio,Path=IsChecked}">
                <StackPanel Margin="12,10,12,0" Orientation="Vertical">
                    <StackPanel>
                        <TextBox Height="50" TextWrapping="Wrap"  Text="" 
                                 x:Name="dlrconnectionString"/>
                        <Button Content="{x:Static properties:Resources.GetConnectionString}" x:Name="buttonDLRConnectionString" Click="buttonDLRConnectionString_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
