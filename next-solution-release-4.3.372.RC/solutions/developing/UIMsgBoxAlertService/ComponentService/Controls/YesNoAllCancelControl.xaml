<UserControl x:Class="UIMsgBoxAlertService.ComponentService.Controls.YesNoAllCancelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UIMsgBoxAlertService.Properties"
             mc:Ignorable="d"
             d:Height="150" d:Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Margin="20" x:Name="txtMessage" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Left" TextWrapping="Wrap"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Margin="5" Name="btnYes" Content="{x:Static properties:Resources.LabelYes}" Click="Yes_Click" />
            <Button Margin="5" Grid.Column="1" Name="btnYesAll" Content="{x:Static properties:Resources.LabelYesAll}" Click="YesAll_Click" />
            <Button Margin="5" Grid.Column="2" Name="btnNo" Content="{x:Static properties:Resources.LabelNo}" Click="No_Click" />
            <Button Margin="5" Grid.Column="3" Name="btnNoAll" Content="{x:Static properties:Resources.LabelNoAll}" Click="NoAll_Click" />
            <Button Margin="5" Grid.Column="4" Name="btnCancel" Content="{x:Static properties:Resources.LabelCancel}" IsCancel="True" Click="Cancel_Click" />
        </Grid>
    </Grid>
</UserControl>
