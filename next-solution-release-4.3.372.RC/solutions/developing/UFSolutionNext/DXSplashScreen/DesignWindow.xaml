<UserControl x:Class="UFSolutionNext.DesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{x:Null}"  
        Width="911" Height="513">

    <Grid>
        <ContentControl x:Name="splashContent"/>
        <Label Margin="0,45,50,0" x:Name="versionLabel" Content="Ver. {0}" FontFamily="Arial" FontSize="27" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="White" />
        <Label Margin="0,30,50,0" x:Name="revisionLabel" Content="Int. {0}" FontFamily="Arial" FontSize="12" FontWeight="Regular" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="White" />
    </Grid>
</UserControl>
