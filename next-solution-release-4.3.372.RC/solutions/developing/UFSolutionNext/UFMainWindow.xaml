<dx:ThemedWindow x:Class="UFSolutionNext.UFMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" 
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"                 
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:ctrls="http://progea.com/CommonControls"
        xmlns:local="clr-namespace:UFSolutionNext"
        xmlns:properties="clr-namespace:UFSolutionNext.Properties"
        xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
        xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
        x:Name="MainWnd"
        Closing="Window_Closing" Loaded="Window_Loaded" ContentRendered="MainWnd_ContentRendered" 
        PreviewMouseDown="MainWnd_PreviewMouseDown"
        WindowStartupLocation="CenterScreen"
        TitleAlignment="Center"
        WindowState="Maximized"
        Width="800"
        Height="600"
        Padding="0"
        Icon="App.ico"
        Title="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitle, Mode=OneWay}"
        >
  <dx:ThemedWindow.ToolbarItems>
        <dxe:AutoSuggestEdit Height="22" Margin="4,0,6,0" Width="200"
                            x:Name="searchCommand"
                            ImmediatePopup="True"
                            SelectAllOnMouseUp="True"
                            SelectAllOnGotFocus="True"
                            AllowPopupTextHighlighting="True"
                            DisplayMember="Item1.Name"
                            TextMember="item1.Name"
                            SuggestionChosen="SearchCommand_SuggestionChosen"
                            KeyDown="SearchCommand_KeyDown"
                            PopupHighlightedTextCriteria="Regex"
                            NullText="{x:Static properties:Resources.QuickLunchTitle}"
                            QuerySubmitted="Command_OnQuerySubmitted">
        </dxe:AutoSuggestEdit>
    </dx:ThemedWindow.ToolbarItems>
    
    <dx:ThemedWindow.CommandBindings>
        <CommandBinding Command="{x:Static local:UIGeneralCommands.Exit}"
                    Executed="OnFileExit"
                    CanExecute="CanAlwaysExecute" />
        <CommandBinding Command="{x:Static local:UIGeneralCommands.FullScreen}"
                    Executed="OnFullScreen"
                    CanExecute="CanExecuteFullScreen" />
        <CommandBinding Command="{x:Static local:UIGeneralCommands.LanguagePreferences}"
                    Executed="OnLanguagePreferences"
                    CanExecute="CanAlwaysExecute" />

        <CommandBinding Command="{x:Static local:UIGeneralCommands.CheckCertificates}"
                    Executed="OnCheckCertificates"
                    CanExecute="CanAlwaysExecute" />

        <CommandBinding Command="{x:Static local:UIGeneralCommands.ShowToolbar}"
                    Executed="OnShowToolbar"
                    CanExecute="CanAlwaysExecute" />

        <CommandBinding Command="{x:Static local:UIGeneralCommands.EasyMode}"
                    Executed="OnEasyMode"
                    CanExecute="CanAlwaysExecute" />

        <CommandBinding Command="{x:Static local:UIGeneralCommands.ChangeApplicationTheme}"
                    Executed="OnChangeApplicationTheme"
                    CanExecute="CanAlwaysExecute" />
      <CommandBinding Command="{x:Static local:UIGeneralCommands.CheckForUpdates}"
                  Executed="OnCheckForUpdates"
                  CanExecute="CanAlwaysExecute" />
    </dx:ThemedWindow.CommandBindings>
    <dx:ThemedWindow.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
          <ResourceDictionary Source="/SharedResources;component/Resources/WorkSpace.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <local:ThemeKeyBooleanConverter x:Key="ThemeKeyBooleanConverter" />
      <Style TargetType="dxdo:LayoutPanel">
        <Style.Triggers>
          <Trigger Property="IsActive" Value="True">
            <Setter Property="dxb:MergingProperties.ElementMergingBehavior" Value="InternalWithExternal" />
            <Setter Property="dxb:MergingProperties.ToolBarMergeStyle" Value="All" />
            <Setter Property="dxb:MergingProperties.AllowMerging" Value="True" />
          </Trigger>
          <Trigger Property="DockItemState" Value="Docked">
            <Setter Property="dxb:MergingProperties.ElementMergingBehavior" Value="InternalWithExternal" />
            <Setter Property="dxb:MergingProperties.ToolBarMergeStyle" Value="All" />
            <Setter Property="dxb:MergingProperties.AllowMerging" Value="True" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="dxdo:DocumentPanel">
        <Style.Triggers>
          <Trigger Property="IsActive" Value="True">
            <Setter Property="dxb:MergingProperties.ElementMergingBehavior" Value="InternalWithExternal" />
            <Setter Property="dxb:MergingProperties.ToolBarMergeStyle" Value="All" />
            <Setter Property="dxb:MergingProperties.AllowMerging" Value="True" />
          </Trigger>
          <Trigger Property="DockItemState" Value="Docked">
            <Setter Property="dxb:MergingProperties.ElementMergingBehavior" Value="InternalWithExternal" />
            <Setter Property="dxb:MergingProperties.ToolBarMergeStyle" Value="All" />
            <Setter Property="dxb:MergingProperties.AllowMerging" Value="True" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="{x:Type dxdo:AutoHideGroup}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      </ResourceDictionary>
    </dx:ThemedWindow.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:TaskbarButtonService ProgressValue="{Binding TaskbarProgressValue}"
                                     ProgressState="{Binding TaskbarProgressState}"
                                     OverlayIcon="{Binding TaskbarOverlayIcon}"
                                     Description="{Binding TaskbarDescription}"/>
        <dxmvvm:NotificationService x:Name="notificationService" 
                                    UseWin8NotificationsIfAvailable="false"
                                    CustomNotificationPosition="BottomRight">
            <dxmvvm:NotificationService.ApplicationId>
                <Binding Source="{x:Static local:UFMainWindow.ApplicationID}"/>
            </dxmvvm:NotificationService.ApplicationId>
        </dxmvvm:NotificationService>
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <local:NotificationAreaIcon x:Name="notifyIcon"
                      Text="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitle, Mode=OneWay}"
                      ToolTip="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitle, Mode=OneWay}"
                      Icon="App.ico"
                      MouseDoubleClick="OnNotificationAreaIconDoubleClick">
            <!--<self:NotificationAreaIcon.MenuItems>
                <forms:MenuItem Text="Open" Click="OnMenuItemOpenClick" DefaultItem="True" />
                <forms:MenuItem Text="-" />
                <forms:MenuItem Text="Exit" Click="OnMenuItemExitClick" />
            </self:NotificationAreaIcon.MenuItems>-->
        </local:NotificationAreaIcon>
        <DockPanel>
            <dxb:BarManager x:Name="mainBarManager" DockPanel.Dock="Top" MDIMergeStyle="Always" dxb:BarNameScope.IsScopeOwner="True" dx:DXSerializer.SerializationID="mainBarManager"
                        dxb:MergingProperties.ToolBarMergeStyle="All" MenuAnimationType="None"
                        dxb:MergingProperties.AllowMerging="True" AllowCustomization="False" AllowQuickCustomization="True">
                <dxb:BarManager.Resources>
                    <Style TargetType="{x:Type dxb:BarControl}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="BarManager_OnPreviewMouseLeftDown" />
                    </Style>
                </dxb:BarManager.Resources>
                <dxb:BarManager.DXContextMenu>
                    <dxb:PopupMenu x:Name="toolbarsContextMenu" />
                </dxb:BarManager.DXContextMenu>
                <dxb:BarManager.Bars>
                    <dxb:Bar IsMainMenu="True" x:Name="mainMenu" AllowCustomizationMenu="False" AllowQuickCustomization="False" dxb:BarManagerHelper.BarIsPrivate="True">
                        <dxb:BarSubItemLink BarItemName="biFile" MergeType="MergeItems"/>
                        <dxb:BarSubItemLink BarItemName="biEdit" MergeType="MergeItems"/>
                        <dxb:BarSubItemLink BarItemName="biView" MergeType="MergeItems"/>
                        <dxb:BarSubItemLink BarItemName="biOptions" MergeType="MergeItems"/>
                        <dxb:BarSubItemLink BarItemName="biMainHelp" MergeType="MergeItems"/>
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.MainToolBarTitle}" x:Name="mainToolBar" dxb:MergingProperties.Name="mainToolBar"
                            GlyphSize="Small" ShowDragWidget="True" VisibleChanged="OnMainToolbarVisibleChanged"
                            AllowCustomizationMenu="True"  IsMultiLine="False" 
                            AllowDrop="True" 
                            AllowHide="False"
                            AllowCollapse="False"
                            AllowQuickCustomization="True">
                        <!-- Quick Commands-->
                        <dxb:BarButtonItemLink MergeOrder="1000" ToolTipService.ShowOnDisabled="True"  BarItemName="biSave"/>
                        <dxb:BarButtonItemLink MergeOrder="1001" ToolTipService.ShowOnDisabled="True"  BarItemName="biSaveAs"/>
                        <dxb:BarItemLinkSeparator />
                        <!-- Exit -->
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biExit"/>
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True"  BarItemName="biUndo"/>
                        <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True"  BarItemName="biRedo"/>
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biCopy"/>
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biPaste"/>
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biCut"/>
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biDelete"/>
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biRename"/>
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biSelectAll"/>
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biPrint"/>

                        <dxb:BarItemLinkSeparator />

                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biCheckCertificate"/>
                        <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biLanguagePreferences"/>
                        <dxb:BarCheckItemLink ToolTipService.ShowOnDisabled="True"  BarItemName="rbEasyMode"/>

                        <dxb:BarItemLinkSeparator />
                        <dxb:BarCheckItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True"  BarItemName="biCheckForUpdates"/>
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static properties:Resources.ProjectToolBarTitle}" x:Name="projectMDIToolbar" 
                            dxb:MergingProperties.Name="projectMDIToolbar"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False" 
                            AllowCustomizationMenu="True" 
                            AllowDrop="True" 
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.ServerGeneralToolBar}" x:Name="generalToolBar1" 
                            dxb:MergingProperties.Name="generalToolBar1"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.TagsToolBar}" x:Name="addressSpaceToolBar1" 
                            dxb:MergingProperties.Name="addressSpaceToolBar1"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.AssignToolBar}" x:Name="assignToolbar1" 
                            dxb:MergingProperties.Name="assignToolbar1"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.DriverToolBar}" x:Name="driverToolBar1" 
                            dxb:MergingProperties.Name="driverToolBar1"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.HistoricalsToolBar}" x:Name="historicalsToolBar1" 
                            dxb:MergingProperties.Name="historicalsToolBar1"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.DataloggerToolBar}" x:Name="historicalsToolBar2" 
                            dxb:MergingProperties.Name="historicalsToolBar2"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.AlarmToolBar}" x:Name="alarmToolBar1" 
                            dxb:MergingProperties.Name="alarmToolBar1"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.EngineeringUnitToolBar}" x:Name="addressSpaceToolBar2" 
                            dxb:MergingProperties.Name="addressSpaceToolBar2"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                    <dxb:Bar HideWhenEmpty="True" Caption="{x:Static translatableMenu:Resources.ViewToolBar}" x:Name="addressSpaceToolBar3" 
                            dxb:MergingProperties.Name="addressSpaceToolBar3"
                            GlyphSize="Small" ShowDragWidget="True" IsMultiLine="False"
                            AllowCustomizationMenu="True"
                            AllowDrop="True"
                            AllowHide="True"
                            AllowCollapse="True"
                            AllowQuickCustomization="False">
                    </dxb:Bar>
                  </dxb:BarManager.Bars>
                <dxb:BarManager.Items>
                    <!-- File -->
                    <dxb:BarSubItem x:Name="biFile" Content="{x:Static translatableMenu:Resources.RibbonFileHeader}" MergeType="MergeItems">
                        <!-- Quick Commands-->
                        <dxb:BarButtonItem MergeOrder="60" ToolTipService.ShowOnDisabled="True" x:Name="biSave" CategoryName="{x:Static translatableMenu:Resources.RibbonFileHeader}" 
                                RibbonStyle="Default" Command="ApplicationCommands.Save" 
                                Content="{x:Static appproperties:ApplicationCommandsResource.Save}" Glyph="{StaticResource SaveSmall}" />
                        <dxb:BarButtonItem MergeOrder="80" ToolTipService.ShowOnDisabled="True" x:Name="biSaveAs" CategoryName="{x:Static translatableMenu:Resources.RibbonFileHeader}" 
                                RibbonStyle="Default" Command="ApplicationCommands.SaveAs" 
                                Content="{x:Static appproperties:ApplicationCommandsResource.SaveAs}" Glyph="{StaticResource WSsaveas}" />
                        <dxb:BarItemLinkSeparator MergeOrder="85" />
                        <!-- Print -->
                        <dxb:BarButtonItem MergeOrder="110" ToolTipService.ShowOnDisabled="True" x:Name="biPrint" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Command="ApplicationCommands.Print" Content="{x:Static appproperties:ApplicationCommandsResource.Print}" Glyph="{StaticResource Print}" />
                        <!-- Exit -->
                        <dxb:BarItemLinkSeparator MergeOrder="125" />
                        <dxb:BarButtonItem MergeOrder="130" ToolTipService.ShowOnDisabled="True" x:Name="biExit" CategoryName="{x:Static translatableMenu:Resources.RibbonFileHeader}" 
                                RibbonStyle="SmallWithText" Content="{x:Static properties:UICommandResource.ExitName}" 
                                Command="{x:Static local:UIGeneralCommands.Exit}" Glyph="{StaticResource WSExit}" />
                    </dxb:BarSubItem>
                    <!-- Edit -->
                    <dxb:BarSubItem x:Name="biEdit" Content="{x:Static translatableMenu:Resources.EditRibbonTitle}">
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biUndo" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biRedo" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biCopy" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biPaste" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biCut" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" Command="ApplicationCommands.Cut" />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biDelete" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource Delete}" Command="ApplicationCommands.Delete" />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biRename" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" RibbonStyle="Default" Content="{x:Static appproperties:ApplicationCommandsResource.Rename}" Glyph="{StaticResource WSRename}" Command="ApplicationCommands.Replace" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biSelectAll" CategoryName="{x:Static translatableMenu:Resources.EditRibbonTitle}" Content="{x:Static appproperties:ApplicationCommandsResource.SelectAll}" Glyph="{StaticResource WSSelection}" Command="ApplicationCommands.SelectAll" />
                    </dxb:BarSubItem>

                    <!-- Help -->
                    <dxb:BarSubItem MergeOrder="1000" x:Name="biMainHelp" Content="{x:Static translatableMenu:Resources.HelpRibbonTitle}">
                      <dxb:BarButtonItem MergeOrder="50" ToolTipService.ShowOnDisabled="True" x:Name="biCheckForUpdates" CategoryName="{x:Static properties:Resources.HelpRibbonHeader}" RibbonStyle="SmallWithText"
                                             Command="{x:Static local:UIGeneralCommands.CheckForUpdates}" Content="{x:Static properties:UICommandResource.CheckForUpdatesText}" Glyph="{StaticResource WSCheckForUpdates}"/>
                      <dxb:BarItemLinkSeparator MergeOrder="55" />
                    </dxb:BarSubItem>

                    <!-- View -->
                    <dxb:BarSubItem x:Name="biView" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
                        <dxb:BarLinkContainerItem ItemLinksSource="{Binding DockedElements, ElementName=MainWnd, Mode=OneWay}" x:Name="biViewContainer" />
                        <dxb:BarItemSeparator />
                        <dxb:BarSubItem MergeOrder="120" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
                            <!--<dxb:BarCheckItem IsChecked="True" IsEnabled="False" CloseSubMenuOnClick="False" MergeOrder="10" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static properties:Resources.ToolbarHeaderTitle}" 
                            Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{x:Static local:UIGeneralCommands.ShowToolbar}" />-->
                        </dxb:BarSubItem>
                        <dxb:BarCheckItem MergeOrder="130" x:Name="fullScreenCommand" CategoryName="{x:Static translatableMenu:Resources.RibbonFileHeader}" 
                                RibbonStyle="Default" Command="{x:Static local:UIGeneralCommands.FullScreen}" 
                                Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" Glyph="{StaticResource WSFullScreen}"/>
                      <dxb:BarCheckItem MergeOrder="135" x:Name="rbEasyMode" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}"
                              RibbonStyle="SmallWithText" Content="{x:Static properties:Resources.EasyModeCommandTitle}"
                              Command="{x:Static local:UIGeneralCommands.EasyMode}" Glyph="{StaticResource WSEasyMode}" />
                    </dxb:BarSubItem>
                    <!-- Options -->
                    <dxb:BarSubItem x:Name="biOptions" Content="{x:Static translatableMenu:Resources.OptionsRibbonHeader}">
                        <dxb:BarButtonItem MergeOrder="50" ToolTipService.ShowOnDisabled="True" x:Name="biCheckCertificate" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" 
                                RibbonStyle="SmallWithText" Content="{x:Static properties:Resources.ApplicationCertificateRibbonTitle}" 
                                Glyph="{StaticResource WSCertificate}" Command="{x:Static local:UIGeneralCommands.CheckCertificates}"/>
                        <dxb:BarItemSeparator MergeOrder="55" />

                        <dxb:BarButtonItem MergeOrder="70" ToolTipService.ShowOnDisabled="True" x:Name="biLanguagePreferences" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" 
                                RibbonStyle="SmallWithText" Content="{x:Static properties:Resources.LanguagePreferencesCommandTitle}" 
                                Glyph="{StaticResource WSLanguagePreferences}" Command="{x:Static local:UIGeneralCommands.LanguagePreferences}"/>
                        <dxb:BarItemLinkSeparator MergeOrder="75" />
                        <!--<dxb:BarCheckItem MergeOrder="80" x:Name="rbEasyMode" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" 
                                RibbonStyle="SmallWithText" Content="{x:Static properties:Resources.EasyModeCommandTitle}" 
                                Command="{x:Static local:UIGeneralCommands.EasyMode}" Glyph="{StaticResource WSEasyMode}" />-->

                        <dxb:BarSubItem x:Name="biColorTheme" MergeOrder="90" 
                                        Content="{x:Static properties:Resources.ColorThemeMenuItem}" 
                                        CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" 
                                        RibbonStyle="SmallWithText" Glyph="{StaticResource WSColorTheme}" >
                            <dxb:BarCheckItem MergeOrder="10" x:Name="rbDarkTheme" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" 
                                              Content="{x:Static properties:Resources.DarkThemeMenuItem}" 
                                              IsChecked="{Binding ThemeKey, ElementName=MainWnd, Mode=OneWay, Converter={StaticResource ThemeKeyBooleanConverter}, ConverterParameter='Dark'}"
                                              IsEnabled="{Binding ThemeKey, ElementName=MainWnd, Mode=OneWay, Converter={StaticResource ThemeKeyBooleanConverter}, ConverterParameter='!Dark'}"
                                              Command="{x:Static local:UIGeneralCommands.ChangeApplicationTheme}" CommandParameter="Dark" />
                            <dxb:BarCheckItem MergeOrder="20" x:Name="rbLightTheme" CategoryName="{x:Static translatableMenu:Resources.OptionsRibbonHeader}" 
                                              Content="{x:Static properties:Resources.LightThemeMenuItem}" 
                                              IsChecked="{Binding ThemeKey, ElementName=MainWnd, Mode=OneWay, Converter={StaticResource ThemeKeyBooleanConverter}, ConverterParameter='Light'}"
                                              IsEnabled="{Binding ThemeKey, ElementName=MainWnd, Mode=OneWay, Converter={StaticResource ThemeKeyBooleanConverter}, ConverterParameter='!Light'}"
                                              Command="{x:Static local:UIGeneralCommands.ChangeApplicationTheme}" CommandParameter="Light" />
                        </dxb:BarSubItem>
                    </dxb:BarSubItem>
                </dxb:BarManager.Items>
                <Grid x:Name="menuGrid" Visibility="Collapsed">

                </Grid>
            </dxb:BarManager>
            <dxdo:DockLayoutManager x:Name="dockingManager" DockingStyle="VS2010" AutoHideExpandMode="MouseDown" FloatingMode="Desktop"
                            DockItemActivated="OnDockItemActivated"
                            DockItemActivating="OnDockItemActivating"
                            DockItemEndDocking="OnDockItemEndDocking"
                            DockOperationStarting="OnDockOperationStarting"
                            DockOperationCompleted="OnDockOperationCompleted"
                            DockItemClosing="OnDockItemClosing"
                            DockItemClosed="OnDockItemClosed">
                <!-- ClosingBehavior="ImmediatelyRemove" -->
                <dxdo:LayoutGroup x:Name="rootLayoutGroup" DestroyOnClosingChildren="False">
                    <dxdo:DocumentGroup x:Name="ChildDocumentGroup" MDIStyle="Tabbed" DestroyOnClosingChildren="False" ClosePageButtonShowMode="InAllTabPageHeaders">
                    </dxdo:DocumentGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </DockPanel>
        <ProgressBar x:Name="menuProgressBar" Grid.Row="0" Visibility="Collapsed" IsIndeterminate="True" ToolTip="{x:Static properties:Resources.LoadingMenuToolbars}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="5" />
    </Grid>
</dx:ThemedWindow>
