<Window x:Class="UFSolutionNext.RuntimeWindow" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" Closed="Window_Closed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:self="clr-namespace:UFSolutionNext" AllowsTransparency="True"
        xmlns:properties="clr-namespace:UFSolutionNext.Properties" Background="{x:Null}"  
        Title="RuntimeWindow" Width="911" Height="513" Icon="/MoviconNeXT;component/App.ico" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None" SizeToContent="WidthAndHeight" ShowInTaskbar="False">
    <Grid>
        <self:NotificationAreaIcon x:Name="notifyIcon"
                      Text="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitleRunTime, Mode=OneWay}"
                      ToolTip="{Binding Source={x:Static properties:Settings.Default}, Path=MainWindowTitleRunTime, Mode=OneWay}"
                      Icon="App.ico"
                      MouseDoubleClick="OnNotificationAreaIconDoubleClick">
            <!--<self:NotificationAreaIcon.MenuItems>
                <forms:MenuItem Text="Open" Click="OnMenuItemOpenClick" DefaultItem="True" />
                <forms:MenuItem Text="-" />
                <forms:MenuItem Text="Exit" Click="OnMenuItemExitClick" />
            </self:NotificationAreaIcon.MenuItems>-->
        </self:NotificationAreaIcon>

        <ContentControl x:Name="splashContent"/>
        <Label Margin="0,45,50,0" x:Name="versionLabel" Content="Ver. {0}" FontFamily="Arial" FontSize="27" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="White" />
        <Label Margin="0,30,50,0" x:Name="revisionLabel" Content="Int. {0}" FontFamily="Arial" FontSize="12" FontWeight="Regular" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="White" />
    </Grid>
</Window>
