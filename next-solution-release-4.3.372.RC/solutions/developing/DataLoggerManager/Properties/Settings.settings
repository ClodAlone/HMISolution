<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="DataLoggerManager.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DataLoggerFlushFileExt" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.SafeDataDL</Value>
    </Setting>
    <Setting Name="WaitCloseConnectionSeconds" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">300</Value>
    </Setting>
    <Setting Name="AggregatedTablesDeleteStoreProcedure" Type="System.String" Scope="Application">
      <Value Profile="(Default)">EXEC [dbo].[spDeleteDlData] @deleteFrom={2}, @UtcTimeColName=N'{1}', @SourceTable=N'{0}'</Value>
    </Setting>
  </Settings>
</SettingsFile>