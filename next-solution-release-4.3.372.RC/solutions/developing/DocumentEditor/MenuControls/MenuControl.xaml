<UserControl x:Class="DocumentEditor.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:self="clr-namespace:DocumentEditor"
             xmlns:properties="clr-namespace:DocumentEditor.Properties"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="SingledocBarManager"
             mc:Ignorable="d">
    <dxb:MainMenuControl BarItemDisplayMode="ContentAndGlyph" Caption="{x:Static properties:Resources.DocumentEditorRibbonTitle}" DockPanel.Dock="Top" GlyphSize="Small">
        <dxb:MainMenuControl.Items>
            <dxb:BarSubItem Content="{x:Static properties:Resources.DocumentEditorRibbonTitle}">
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.MyCommand}" 
                                   Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" Glyph="../Images/Editor.png"/>
            </dxb:BarSubItem>
        </dxb:MainMenuControl.Items>
    </dxb:MainMenuControl>
</UserControl>
