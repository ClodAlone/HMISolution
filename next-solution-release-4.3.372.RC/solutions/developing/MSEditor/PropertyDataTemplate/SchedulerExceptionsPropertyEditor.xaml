<UserControl x:Class="MSEditor.PropertyDataTemplate.SchedulerExceptionsPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:CommandManager.UserControls.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Button DockPanel.Dock="Right" Click="DlgButton_ClickEdit">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
    </DockPanel>
</UserControl>
