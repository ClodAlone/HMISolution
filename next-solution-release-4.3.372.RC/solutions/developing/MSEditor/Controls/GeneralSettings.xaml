<UserControl x:Class="MSEditor.Controls.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpfc="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:converters="clr-namespace:CommonControls.Converters;assembly=CommonControls"
             xmlns:properties="clr-namespace:MSEditor.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ConnectionStringConverter x:Key="ConnectionStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.GeneralSettingsApplicationName}" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ApplicationName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textApplicationName" />
        <ContentPresenter Grid.Row="0" Grid.Column="2"
            Content="{Binding ElementName=textApplicationName, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.LogConnectionString}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                         x:Name="textLogConnection">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource ConnectionStringConverter}" 
                                  ValidatesOnDataErrors="True" UpdateSourceTrigger="PropertyChanged">
                        <Binding Path="EventDefaultConnection" Mode="TwoWay" />
                        <Binding Path="Document" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
            <Button Grid.Column="1" Click="textLogConnection_DefaultButtonClick" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Click="textLogConnection_DlgButton_Clear" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
        </Grid>
        <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=textLogConnection, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.LogMaxAge}" VerticalAlignment="Center" />
        <wpfc:TimeSpanEdit x:Name="textEditMaxAge" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TimeSpan="{Binding EventMaxAge, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                               MinValue="0"
                               Validation.ErrorTemplate="{x:Null}" 
                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

        <ContentPresenter Grid.Row="2" Grid.Column="2" 
            Content="{Binding ElementName=textEditMaxAge, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.SpeechEnabled}" VerticalAlignment="Center" />
        <CheckBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" 
                              Content="" IsChecked="{Binding SpeechEnabled, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                              x:Name="chkSpeechEnabled" />
        
    </Grid>
</UserControl>
