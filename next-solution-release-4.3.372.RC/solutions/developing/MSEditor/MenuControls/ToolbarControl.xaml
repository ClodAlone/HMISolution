<dxb:BarManager
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="MSEditor.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MSEditor.MenuControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="MSBarManagerToolbar"
             mc:Ignorable="d">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="schedulerToolbar" x:Name="schedulerToolBar1"
                GlyphSize="Small" ShowDragWidget="True" 
                AllowCustomizationMenu="False" 
                AllowDrop="False" 
                AllowHide="False"
                AllowCollapse="False"
                AllowQuickCustomization="False">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewEventText"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewFolderText"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStartServerText"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStopServerText"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biServiceManager"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
