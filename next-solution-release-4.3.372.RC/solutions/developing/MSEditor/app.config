<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="UFUserEditor.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="MSEditor.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
	<log4net>
		<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
			<File value="${ALLUSERSPROFILE}\Progea\Movicon.NExT.Log\SysLog.xml" />
      <encoding value="unicode" />
			<appendToFile value="true" />
			<rollingStyle value="Size" />
			<maxSizeRollBackups value="10" />
			<maximumFileSize value="10MB" />
			<staticLogFileName value="true" />
			<param name="LockingModel" type="ConcurrentLog4Net.ConcurrentMinimalLock,ConcurrentLog4Net" />
			<datePattern value="yyyyMMdd" />
			<layout type="log4net.Layout.XmlLayout">
				<locationInfo value="true" />
			</layout>
		</appender>
		<root>
			<level value="DEBUG" />
			<appender-ref ref="RollingFileAppender" />
		</root>
	</log4net>
  <appSettings>
    <add key="log4net.Internal.Emit" value="false" />
  </appSettings>
  <userSettings>
        <UFUserEditor.Properties.Settings>
            <setting name="DefaultRoleName" serializeAs="String">
                <value>Role</value>
            </setting>
            <setting name="DefaultFileExt" serializeAs="String">
                <value>.UFUser</value>
            </setting>
            <setting name="TypeLabel" serializeAs="String">
                <value>UFUser</value>
            </setting>
            <setting name="DefaultProjectName" serializeAs="String">
                <value>User</value>
            </setting>
            <setting name="DefaultUserName" serializeAs="String">
                <value>User</value>
            </setting>
            <setting name="AdminRoleName" serializeAs="String">
                <value>Admin</value>
            </setting>
            <setting name="PowerUserRoleName" serializeAs="String">
                <value>Power User</value>
            </setting>
            <setting name="GuestRoleName" serializeAs="String">
                <value>Guest</value>
            </setting>
			<setting name="FolderAlwaysExpandible" serializeAs="String">
				<value>False</value>
			</setting>
        </UFUserEditor.Properties.Settings>
    </userSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
  <applicationSettings>
        <MSEditor.Properties.Settings>
          <setting name="TypeLabelString" serializeAs="String">
            <value>Strings</value>
          </setting>
          <setting name="DefaultProjectNameString" serializeAs="String">
            <value>Strings</value>
          </setting>
          <setting name="DefaultFileExtString" serializeAs="String">
            <value>.Strings</value>
          </setting>
          <setting name="MaxItemsInTree" serializeAs="String">
            <value>2147483647</value>
          </setting>
          <setting name="SaveAsFileExtensions" serializeAs="String">
            <value />
          </setting>
        </MSEditor.Properties.Settings>
  </applicationSettings>
</configuration>
