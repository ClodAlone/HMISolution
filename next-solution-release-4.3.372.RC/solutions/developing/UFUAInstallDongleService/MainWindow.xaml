<dx:DXWindow x:Class="UFUAInstallDongleService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:self="clr-namespace:UFUAInstallDongleService"
        xmlns:properties="clr-namespace:UFUAInstallDongleService.Properties"
        xmlns:uc="clr-namespace:UFUAServiceLibrary;assembly=UFUAServiceLibrary"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        WindowStartupLocation="CenterScreen" BorderEffect="Default"
        Background="{x:Null}" SizeToContent="WidthAndHeight"
        Title="{x:Static properties:Resources.AppTitle}">

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static self:MainWindow.SaveSettings}" 
                    Executed="OnSaveSettings" 
                    CanExecute="CanSaveSettings" />

        <CommandBinding Command="{x:Static self:MainWindow.ReloadSettings}" 
                    Executed="OnReloadSettings" 
                    CanExecute="CanReloadSettings" />

    </Window.CommandBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Auto"
                                        Name="Scroll">
        <Grid Name="maingrid">
            <Grid.Resources>
                <DataTemplate DataType="{x:Type ValidationError}">
                    <TextBlock Grid.Column="4" FontStyle="Italic"
          Foreground="Red" FontSize="12"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
                </DataTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <uc:InstallServiceControl x:Name="serviceControl"/>

          <TextBlock Margin="10"  Text="{x:Static properties:Resources.SettingsHeader}" Grid.Row="1" HorizontalAlignment="Left" />
          <Grid Margin="20, 10" Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="10*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="32*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.ServerName}" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" />
                <TextBox Margin="5,0" Name="serverName" Grid.Column="2" Grid.Row="1" Text="{Binding Settings.ServerName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3"
            Content="{Binding ElementName=serverName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Margin="2,2,2,2"  Text="{x:Static properties:Resources.PortNumber}" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" />
            <TextBox Margin="5,0" Name="portNumber" Grid.Column="2" Grid.Row="2" Text="{Binding Settings.PortNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3"
            Content="{Binding ElementName=portNumber, Path=(Validation.Errors).CurrentItem}"/>

          </Grid>
            <Grid Grid.Row="3" x:Name="commands" Visibility="Visible" MinHeight="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button  Margin="5" 
                    Command="{x:Static self:MainWindow.SaveSettings}" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.SaveSettingsText}" />
                    </StackPanel>
                </Button>
                <Button  Margin="5" Grid.Column="1" 
                    Command="{x:Static self:MainWindow.ReloadSettings}" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{x:Static properties:Resources.ReloadSettingsText}" />
                    </StackPanel>
                </Button>

            </Grid>
        </Grid>
    </ScrollViewer>
</dx:DXWindow>
