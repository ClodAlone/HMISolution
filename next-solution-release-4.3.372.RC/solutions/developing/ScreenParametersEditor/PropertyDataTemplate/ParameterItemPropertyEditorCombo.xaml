<UserControl x:Class="ScreenParametersEditor.PropertyDataTemplate.ParameterItemPropertyEditorCombo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:local="clr-namespace:ScreenParametersEditor.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:ParameterItemConverter x:Key="ParameterItemConverter" />
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image x:Name="cancelImg" Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click">
                <Button.Content>
                    <Image x:Name="editImg" Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <dxe:ComboBoxEdit
                    x:Name="uriLabel" 
                    Text="{Binding Path=Tag,ElementName=uriButton,Converter={StaticResource ParameterItemConverter}, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                    PopupOpening="uriLabel_PopupOpening"
                    LostFocus="uriLabel_LostFocus" PreviewKeyDown="uriLabel_KeyDown" GotFocus="uriLabel_GotFocus"
                    SelectedIndexChanged="uriLabel_SelectedIndexChanged"
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
            </dxe:ComboBoxEdit>
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=uriButton, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
