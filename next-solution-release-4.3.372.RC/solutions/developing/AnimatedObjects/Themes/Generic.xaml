<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Converters;assembly=Converters"
                    xmlns:z="clr-namespace:AnimatedObjects">

    <!-- ************* --> 
    <!-- AnimatedObject -->
    <!-- ************* -->
    <!-- FullAnimatedText Template -->
    <Style TargetType="z:FullAnimatedText">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="z:FullAnimatedText">
                    <ControlTemplate.Resources>
                        <converters:NullImageConverter x:Key="nullImageConverter"/>
                    </ControlTemplate.Resources>
                    <Grid x:Name="externalGrid">
                    <Border x:Name="mainBorder" SnapsToDevicePixels="True"
                            Background="{x:Null}"
                            BorderBrush="{Binding BorderBrush,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                            BorderThickness="{Binding BorderThickness,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}">
                        </Border>
                        <Grid x:Name="mainGrid" ClipToBounds="{Binding ControlClipToBounds,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"> 
                          <Image x:Name="mainBorderImage" Stretch="{Binding Stretch, Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" Source="{Binding BaseImage, Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}, Converter={StaticResource nullImageConverter}}"
                                 Margin="{Binding BorderThickness,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
                          <Image x:Name="backImage" Source="{Binding BackImage, Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}, Converter={StaticResource nullImageConverter}}"
                                 Margin="{Binding BorderThickness,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" />
                            <!--Text="{Binding Text,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"-->
                            <TextBlock Margin="3" x:Name="baseText" Background="Transparent"
                                                FontFamily="{Binding FontFamily,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                                                FontSize="{Binding FontSize,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                                                FontWeight="{Binding FontWeight,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                                                FontStyle="{Binding FontStyle,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                                                TextAlignment="{Binding TextAlignment,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" 
                                                TextWrapping="{Binding TextWrapping,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" 
                                                HorizontalAlignment="{Binding HorizontalContentAlignment,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" 
                                                VerticalAlignment="{Binding VerticalContentAlignment,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"  
                                                RenderTransformOrigin="{Binding ControlRenderTransformOrigin,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}">
                                <TextBlock.Resources>
                                    <Storyboard x:Key="translationX" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextTransform"
                                             Storyboard.TargetProperty="X"
                                             From="-150"
                                             To="150"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                                    </Storyboard>
                                    <Storyboard x:Key="translationY" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextTransform"
                                             Storyboard.TargetProperty="Y"
                                             From="-150"
                                             To="150"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                                    </Storyboard>
                                    <Storyboard x:Key="blink" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="baseText"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0"
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                                    </Storyboard>
                                    <Storyboard x:Key="rotation" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextRotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" 
                                             To="360" 
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                                    </Storyboard>
                                    <Storyboard x:Key="scaleX" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextScale"
                                             Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                             To="1.5" 
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                    <Storyboard x:Key="scaleY" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextScale"
                                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             To="1.5" 
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                    <Storyboard x:Key="skewX" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextSkew"
                                             Storyboard.TargetProperty="(SkewTransform.AngleX)"
                                             To="180" AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                    <Storyboard x:Key="skewY" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextSkew"
                                             Storyboard.TargetProperty="(SkewTransform.AngleY)"
                                             To="180" AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                </TextBlock.Resources>
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform   x:Name="AnimatedTextScale" />
                                        <SkewTransform  x:Name="AnimatedTextSkew" />
                                        <TranslateTransform x:Name="AnimatedTextTransform" />
                                        <RotateTransform x:Name="AnimatedTextRotation"  />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    <!--</Border>-->
                    <Border x:Name="outerBorder" BorderBrush="DarkGray" BorderThickness="1" Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- AnimatedText Template -->
