                                                FontSize="{Binding FontSize,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                                                FontWeight="{Binding FontWeight,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
