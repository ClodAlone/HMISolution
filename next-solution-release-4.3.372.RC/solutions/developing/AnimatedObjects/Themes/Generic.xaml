                                    <Storyboard x:Key="rotation" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextRotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" 
                                             To="360" 
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />

                                    </Storyboard>
                                    <Storyboard x:Key="scaleX" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextScale"
                                             Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                             To="1.5" 
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                    <Storyboard x:Key="scaleY" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextScale"
                                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                                             To="1.5" 
                                             AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                    <Storyboard x:Key="skewX" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextSkew"
                                             Storyboard.TargetProperty="(SkewTransform.AngleX)"
                                             To="180" AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                    <Storyboard x:Key="skewY" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextSkew"
                                             Storyboard.TargetProperty="(SkewTransform.AngleY)"
                                             To="180" AutoReverse="True"
                                             BeginTime="0:0:0" 
                                             Duration="0:0:5"  />
                                    </Storyboard>
                                </TextBlock.Resources>
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform   x:Name="AnimatedTextScale" />
                                        <SkewTransform  x:Name="AnimatedTextSkew" />
                                        <TranslateTransform x:Name="AnimatedTextTransform" />
                                        <RotateTransform x:Name="AnimatedTextRotation"  />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <Border x:Name="outerBorder" BorderBrush="DarkGray" BorderThickness="1" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- AnimatedImage Template -->
    <Style TargetType="z:AnimatedImage">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="z:AnimatedImage">
                    <ControlTemplate.Resources>
                        <converters:NullImageConverter x:Key="nullImageConverter"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="mainBorder"
                                Background="{x:Null}"
                                BorderBrush="{Binding BorderBrush,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}"
                                BorderThickness="{Binding BorderThickness,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}">
                        <Grid x:Name="mainGrid" ClipToBounds="{Binding ControlClipToBounds,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}">
                          <Image x:Name="mainBorderImage" Stretch="{Binding Stretch, Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}}" Source="{Binding BaseImage, Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}, Converter={StaticResource nullImageConverter}}"/>
                          <Image x:Name="backImage" Stretch="None" Source="{Binding BackImage, Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Control}, Converter={StaticResource nullImageConverter}}"/>
                            <Border x:Name="outerBorder" BorderBrush="DarkGray" BorderThickness="1" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>