                                <TextBlock.Resources>
                                    <Storyboard x:Key="translationX" RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                             Storyboard.TargetName="AnimatedTextTransform"
                                             Storyboard.TargetProperty="X"
                                             From="-150"
                                             To="150"
