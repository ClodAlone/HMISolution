<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             x:Class="AnimatedObjects.Controls.SmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:properties="clr-namespace:AnimatedObjects.Properties"
             xmlns:converters="clr-namespace:AnimatedObjects.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:commoncontrols="http://progea.com/CommonControls"
             xmlns:smartutils="clr-namespace:SmartControlUtilities.Controls;assembly=SmartControlUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:UriToVisualBrushConverter x:Key="UriToVisualBrushConverter" />
            <utilities:BrushToNameConverter x:Key="BrushNameConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddButtonTitle}" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="1" IsEnabled="False" x:Name="btnDelete" 
                    ToolTip="{x:Static properties:Resources.DeleteButtonTitle}" Click="OnDelete" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
        </Grid>
        <!--CustomColumnSort="grid_CustomColumnSort"-->
        <dxg:GridControl AllowDrop="False" Name="gridControl" Grid.Row="1">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Value" SortOrder="Ascending" SortMode="Value" Width="50" Header="{x:Static properties:Resources.ValueColumnHeader}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" HorizontalContentAlignment="Right" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn Validate="GridColumn_Validate" AllowDrop="False" AllowMoving="False" DisplayMemberBinding="{Binding Path=Text, Mode=TwoWay}" Header="{x:Static properties:Resources.TextColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Click="DlgButtonClear_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button DockPanel.Dock="Right" Click="DlgButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                    <TextBox IsReadOnly="False" IsHitTestVisible="True" x:Name="text" HorizontalAlignment="Stretch"
                                                 Text="{Binding Path=Data.Text, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn MinWidth="80" AllowDrop="False" AllowEditing="False" Header="{x:Static properties:Resources.TagName}">
                  <dxg:GridColumn.CellTemplate>
                    <DataTemplate>
                      <smartutils:TagSelector RuntimeVersion="False"  ReferencedTag="TagReference" ColumnPropName="TagName"
                              OnApplyChanges="OnApplyChanges" DataContext="{Binding RowData.Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Document="{Binding Document, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay}" />
                    </DataTemplate>
                  </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="Animation" DisplayMemberBinding="{Binding Path=Animation, Mode=TwoWay}" Header="{x:Static properties:Resources.AnimationColumnHeader}">
                    <dxg:GridColumn.EditTemplate>
                        <ControlTemplate>
                            <dxe:ComboBoxEdit Name="PART_Editor"
                        HorizontalContentAlignment="Left"
                        EditValue="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                        SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                        Text="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                        EditorActivated="Editor_DropDownOpened"
                        IsTextEditable="False"
                        AllowNullInput="False"
                        AcceptsReturn="True"
                        AutoComplete="True"
                        ImmediatePopup="True">
                            </dxe:ComboBoxEdit>
                        </ControlTemplate>
                    </dxg:GridColumn.EditTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="AnimationTime" Width="50" Header="{x:Static properties:Resources.AnimationTimeColumnHeader}">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="Numeric" Mask="d" HorizontalContentAlignment="Right" />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn AllowDrop="False" AllowMoving="False" Width="80"  Header="{x:Static properties:Resources.ImageColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Click="ButtonImageClear_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Button Tag="{Binding Data.BackImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Click="ButtonImage_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Rectangle Width="16"  Fill="{Binding Data.BackImage, Mode=OneWay,Converter={StaticResource UriToVisualBrushConverter}}">
                                    <Rectangle.ToolTip>
                                        <ToolTip HasDropShadow="True" Width="250" Height="250" Background="{Binding Data.BackImage, Mode=OneWay,Converter={StaticResource UriToVisualBrushConverter}}" />
                                    </Rectangle.ToolTip>
                                </Rectangle>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn FieldName="ImageStretch" DisplayMemberBinding="{Binding Path=ImageStretch, Mode=TwoWay}" Header="{x:Static properties:Resources.ImageStretchColumnHeader}">
                    <dxg:GridColumn.EditTemplate>
                        <ControlTemplate>
                            <dxe:ComboBoxEdit Name="PART_Editor"
                        HorizontalContentAlignment="Left"
                        EditValue="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                        SelectedItem="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}}"
                        Text="{Binding Path=EditValue, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        EditorActivated="STRETCH_Editor_DropDownOpened"
                        IsTextEditable="False"
                        AllowNullInput="False"
                        AcceptsReturn="False"
                        AutoComplete="False"
                        ImmediatePopup="True" SelectedIndexChanged="PART_Editor_SelectedIndexChanged">
                            </dxe:ComboBoxEdit>
                        </ControlTemplate>
                    </dxg:GridColumn.EditTemplate>
                </dxg:GridColumn>
                <!--ImageStretch-->
                <dxg:GridColumn AllowDrop="False" AllowMoving="False" Binding="{Binding Path=Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberBinding="{Binding Path=Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.ForegroundColumnHeader}">
                    <!--<dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Button Tag="{Binding Data.Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Click="Button_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Content>
                                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                                    </Button.Content>
                                </Button>
                                <Rectangle Fill="{Binding Data.Foreground, Mode=OneWay}"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>-->
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <commoncontrols:CustomPopupColorEdit Name="PART_Editor" DockPanel.Dock="Right"
                                                                     OnlySolidColors="False" Document="{Binding Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                                                     BrushSelected="OnBrushSelected"
                                                                     SelectedBrush="{Binding RowData.Row.Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False"
                        AllowSorting="False" EnableImmediatePosting="True"
                        FocusedRowChanged="tableView_FocusedRowChanged" ValidateRow="tableView_ValidateRow"
                        InvalidRowException="tableView_InvalidRowException" CellValueChanged="tableView_CellValueChanged" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
