<UserControl x:Class="UFUAEditor.PropertyDataTemplate.EngineeringUnitPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:convutilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convutilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
            <!--<converters:PropertyGridManyValueConverter x:Key="ManyValueConverter" />-->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uri" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <dxe:ComboBoxEdit
                        x:Name="uriLabel"
                        Text="{Binding Path=Tag,ElementName=uri, UpdateSourceTrigger=PropertyChanged}" 
                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"                        
                        PopupOpening="comboBox_PopupOpening"
                        ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup"/>
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=uriLabel, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
