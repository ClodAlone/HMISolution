<UserControl x:Class="UFUAEditor.Controls.NewDataLoggerColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:Propertydatatemplate="clr-namespace:UFUAEditor.PropertyDataTemplate"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Width="400" Height="350"
             d:DesignHeight="400" d:DesignWidth="350">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewDataLoggerColumnProperties}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewDataLoggerColumnName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewDataLoggerColumnSourceTimeStampSuffix}" VerticalAlignment="Center" />
            <Grid Grid.Row="3" Grid.Column="1" Name="gridSourceTimeStamp" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkSourceTimeStamp" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto"
                      IsChecked="{Binding AddSourceTimeStampColumn, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Name="textSourceTimeStamp" Grid.Column="1" 
                     IsEnabled="{Binding Path=IsChecked, ElementName=checkSourceTimeStamp}"
                     Validation.ErrorTemplate="{x:Null}"
                     Text="{Binding SourceTimeStampSuffixColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <ContentPresenter Grid.Row="3" Grid.Column="2" Content="{Binding ElementName=textSourceTimeStamp, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewDataLoggerColumnServerTimeStampSuffix}" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Grid.Column="1" Name="gridServerTimeStamp" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkServerTimeStamp" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto"
                      IsChecked="{Binding AddServerTimeStampColumn, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Name="textServerTimeStamp" Grid.Column="1" 
                     IsEnabled="{Binding Path=IsChecked, ElementName=checkServerTimeStamp}"
                     Validation.ErrorTemplate="{x:Null}"
                     Text="{Binding ServerTimeStampSuffixColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <ContentPresenter Grid.Row="4" Grid.Column="2" Content="{Binding ElementName=textServerTimeStamp, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.NewDataLoggerColumnStatusCodeSuffix}" VerticalAlignment="Center" />
            <Grid Grid.Row="5" Grid.Column="1" Name="gridStatusCode" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkStatusCode" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto"
                      IsChecked="{Binding AddStatusCodeColumn, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Name="textStatusCode" Grid.Column="1" 
                     IsEnabled="{Binding Path=IsChecked, ElementName=checkStatusCode}"
                     Validation.ErrorTemplate="{x:Null}"
                     Text="{Binding StatusCodeSuffixColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <ContentPresenter Grid.Row="5" Grid.Column="2" Content="{Binding ElementName=textStatusCode, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.NewDataLoggerColumnUserNameSuffix}" VerticalAlignment="Center" />
            <Grid Grid.Row="6" Grid.Column="1" Name="gridUserName" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Name="checkUserName" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto"
                      IsChecked="{Binding AddUserColumn, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Name="textUserName" Grid.Column="1" 
                     IsEnabled="{Binding Path=IsChecked, ElementName=checkUserName}"
                     Validation.ErrorTemplate="{x:Null}"
                     Text="{Binding UserSuffixColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <ContentPresenter Grid.Row="6" Grid.Column="2" Content="{Binding ElementName=textUserName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.NewDataLoggerColumnTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="7" Grid.Column="1">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textColumnTag"/>
            </Grid>
            <!--<DockPanel Grid.Column="1" Grid.Row="7" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Tag="{Binding ColumnTag, Mode=TwoWay}" Click="ResetEntityReferenceTag_Click">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="uriColumnTag" DockPanel.Dock="Right" 
                    Tag="{Binding ColumnTag, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                    Click="SetEntityReferenceTag_Click" Validation.ErrorTemplate="{x:Null}">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox x:Name="textColumnTag" IsReadOnly="True" Text="{Binding Path=Tag, ElementName=uriColumnTag, Mode=OneWay}" />
            </DockPanel>-->
            <ContentPresenter Grid.Row="7" Grid.Column="2" 
            Content="{Binding ElementName=textColumnTag, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
