<UserControl x:Class="UFUAEditor.Controls.NewAlarmThreshold"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:commands="clr-namespace:CommandManager.PropertyDataTemplate;assembly=CommandManager"
             xmlns:Propertydatatemplate="clr-namespace:UFUAEditor.PropertyDataTemplate"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Height="620" Width="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:ItemsCountConverter x:Key="ItemsCountConverter" />
            <converters:TripAlarmTypeToVisibilityConverter x:Key="TripAlarmTypeToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.AlarmDescriptionProperties}" VerticalAlignment="Center" FontWeight="Bold" />

            <!--<TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewThresholdComposedAlarmText}" VerticalAlignment="Center" />
        <TextBox IsReadOnly="True" Grid.Column="1" Grid.Row="1" Text="{Binding ComposedAlarmText, Mode=OneWay}" 
                 VerticalAlignment="Center" HorizontalAlignment="Stretch" />-->

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.TagAlarm}" VerticalAlignment="Center" />
            <Grid x:Name="gridText" Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding AlarmText, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 x:Name="textEditName" />
                <Button Click="textEditName_Click" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="textEditName_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewThresholdAddTagDescription}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Grid.Row="2" IsChecked="{Binding AddTagDescription}" VerticalAlignment="Center"  HorizontalAlignment="Left" Width="Auto" />

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.EnabledThreshold}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Grid.Row="3" IsChecked="{Binding Enabled}" VerticalAlignment="Center"  HorizontalAlignment="Left" Width="Auto" />

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.EnabledThresholdTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Grid.Column="1">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textEnabledThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=uri, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.ADEnableQualityGood}" VerticalAlignment="Center" x:Name="textEnableQualityGood" />
            <ComboBox Grid.Column="1" Grid.Row="5" x:Name="comboEnableQualityGood" SelectedValue="{Binding EnableQualityGood}" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.ADBeep}" VerticalAlignment="Center" x:Name="textBlockBeep" />
            <ComboBox Grid.Column="1" Grid.Row="6" x:Name="comboBeep" SelectedValue="{Binding Beep}" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
            <!--<CheckBox x:Name="checkBoxBeep" Grid.Column="1" Grid.Row="5" IsChecked="{Binding Beep, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" VerticalAlignment="Center" Margin="5" />-->

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.AlarmThresholdExpression}" VerticalAlignment="Center" x:Name="textBlockExpression" />
            <!--<TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="textEditExpression" />-->
            <Grid Grid.Row="7" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 x:Name="textEditExpression" />
                <Button Click="textEditExpression_Click" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Click="textEditExpression_Clear" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <ContentPresenter Grid.Row="7" Grid.Column="2" 
            Content="{Binding ElementName=textEditExpression, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.AlarmThresholdAliasTags}" VerticalAlignment="Center" x:Name="textBlockAliasTags"/>
            <DockPanel x:Name="dockAliasTags" Grid.Column="1" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Button DockPanel.Dock="Right" Tag="{Binding AliasTags, Mode=OneWay}" Click="AliasTags_Click_Clear" 
                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="uriCommand" DockPanel.Dock="Right" Tag="{Binding AliasTags, Mode=OneWay}" Click="AliasTags_Click_Edit" 
                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Label x:Name="uriLabel" Content="{Binding Path=Tag, ElementName=uriCommand, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ItemsCountConverter}}"
                         VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </DockPanel>
            <ContentPresenter Grid.Row="8" Grid.Column="2" 
                Content="{Binding ElementName=textEditAliasTags, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.ActivationValueThresholdTag}" VerticalAlignment="Center" 
                       Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}}" />
            <Grid Grid.Row="9" Grid.Column="1"  x:Name="gridActivationValueThresholdTag" 
                  Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}}">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textActivationValueThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="9" Grid.Column="2" 
                              Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}}"
                              Content="{Binding ElementName=uriActivation, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.ActivationLowValueThresholdTag}" VerticalAlignment="Center" 
                       Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}}" />
            <Grid Grid.Row="10" Grid.Column="1"  x:Name="gridActivationLowValueThresholdTag" 
                  Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}}">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textActivationLowValueThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="10" Grid.Column="2" 
                              Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}}"
                              Content="{Binding ElementName=uriActivation, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.HighHighLimitThresholdTag}" VerticalAlignment="Center" 
                       Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" />
            <Grid Grid.Row="9" Grid.Column="1" x:Name="gridHighHighLimitThresholdTag"
                  Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textHighHighLimitThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="9" Grid.Column="2" 
                              Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" 
                              Content="{Binding ElementName=uriHighHigh, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.HighLimitThresholdTag}" VerticalAlignment="Center"
                       Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" />
            <Grid Grid.Row="10" Grid.Column="1" 
                  Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textHighLimitThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="10" Grid.Column="2" 
                              Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" 
                              Content="{Binding ElementName=uriHigh, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.LowLimitThresholdTag}" VerticalAlignment="Center" 
                       Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" />
            <Grid Grid.Row="11" Grid.Column="1" 
                  Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textLowLimitThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="11" Grid.Column="2" 
                              Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" 
                              Content="{Binding ElementName=uriLow, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.LowLowLimitThresholdTag}" VerticalAlignment="Center" 
                       Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" />
            <Grid Grid.Row="12" Grid.Column="1"
                  Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" >
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textLowLowLimitThresholdTag"/>
            </Grid>
            <ContentPresenter Grid.Row="12" Grid.Column="2" 
                              Visibility="{Binding AlarmType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TripAlarmTypeToVisibilityConverter}, ConverterParameter=true}" 
                              Content="{Binding ElementName=uriLowLow, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.NewAlarmThresholdCommandsOn}" VerticalAlignment="Center" 
                       Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" />
            <ContentControl Grid.Row="13" Grid.Column="1"
                            Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}">
                <ContentControl.Content>
                    <commands:CommandsPropertyEditor x:Name="templateCommandsOn" VerticalAlignment="Center" />
                </ContentControl.Content>
            </ContentControl>

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.NewAlarmThresholdCommandsOff}" VerticalAlignment="Center"
                       Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" />
            <ContentControl Grid.Row="14" Grid.Column="1"
                            Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}">
                <ContentControl.Content>
                    <commands:CommandsPropertyEditor x:Name="templateCommandsOff" VerticalAlignment="Center" />
                </ContentControl.Content>
            </ContentControl>

            <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.NewAlarmThresholdCommandsAck}" VerticalAlignment="Center" 
                       Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" />
            <ContentControl Grid.Row="15" Grid.Column="1"
                            Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}">
                <ContentControl.Content>
                    <commands:CommandsPropertyEditor x:Name="templateCommandsAck" VerticalAlignment="Center" />
                </ContentControl.Content>
            </ContentControl>

            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.NewAlarmThresholdCommandsReset}" VerticalAlignment="Center" 
                       Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" />
            <ContentControl Grid.Row="16" Grid.Column="1"
                            Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}">
                <ContentControl.Content>
                    <commands:CommandsPropertyEditor x:Name="templateCommandsReset" VerticalAlignment="Center" />
                </ContentControl.Content>
            </ContentControl>

            <TextBlock Grid.Row="17" Text="{x:Static properties:Resources.NewAlarmThresholdCommandsDbClick}" VerticalAlignment="Center" 
                       Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}" />
            <ContentControl Grid.Row="17" Grid.Column="1"
                            Visibility="{Binding IsCommandsSupported, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, 
                                    ConverterParameter=False, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}}">
                <ContentControl.Content>
                    <commands:CommandsPropertyEditor x:Name="templateCommandsDbClick" VerticalAlignment="Center" />
                </ContentControl.Content>
            </ContentControl>

            <Button Grid.Row="18" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Content="{x:Static properties:Resources.EditAlarmPrototype}" Click="EditAlarmPrototype_Click" 
                x:Name="editAlarmPrototype" />
        </Grid>
    </ScrollViewer>
</UserControl>
