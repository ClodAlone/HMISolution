<UserControl x:Class="UFUAEditor.Controls.NewDataLoggerSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:editors="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:Propertydatatemplate="clr-namespace:UFUAEditor.PropertyDataTemplate"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" Width="350" Height="760"
             d:DesignHeight="760" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewDataLoggerSettingsProperties}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewDataLoggerSettingsName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewDataLoggerSettingsEnabled}" VerticalAlignment="Center" />
            <CheckBox x:Name="checkBoxEnabled" Grid.Column="1" Grid.Row="2" IsChecked="{Binding Enable}" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto" />

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewDataLoggerSettingsTableName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TableName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditTableName" />
            <ContentPresenter Grid.Row="3" Grid.Column="2" 
            Content="{Binding ElementName=textEditTableName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewDataLoggerSettingsUtcTimeColumnName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UtcTimeColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditUtcTimeColumnName" />
            <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=textEditUtcTimeColumnName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.NewDataLoggerSettingsLocalTimeColumnName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LocalTimeColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditLocalTimeColumnName" />
            <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=textEditLocalTimeColumnName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.NewDataLoggerSettingsMillisecondsColumnName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MillisecondsColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditMillisecondsColumnName" />
            <ContentPresenter Grid.Row="6" Grid.Column="2" 
            Content="{Binding ElementName=textEditLocalTimeColumnName, Path=(Validation.Errors).CurrentItem}"/>


            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.NewDataLoggerSettingsUserColumnName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding UserColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditUserColumnName" />
            <ContentPresenter Grid.Row="7" Grid.Column="2" 
            Content="{Binding ElementName=textEditUserColumnName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.NewDataLoggerSettingsReasonColumnName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ReasonColumnName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditReasonColumnName" />
            <ContentPresenter Grid.Row="8" Grid.Column="2" 
            Content="{Binding ElementName=textEditReasonColumnName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.NewDataLoggerSettingsRecordingTime}" VerticalAlignment="Center" />
            <editors:TimeSpanEdit Grid.Row="9" Grid.Column="1"
                            TimeSpan="{Binding RecordingTimeInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            MinValue="0"
                            Mask="hh:mm:ss"
                            Validation.ErrorTemplate="{x:Null}"
                            ValidateOnTextInput="False" AllowSpinOnMouseWheel="False"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                 x:Name="textEditRecordingTimeInterval"  />
            <ContentPresenter Grid.Row="9" Grid.Column="2" 
            Content="{Binding ElementName=textEditRecordingTimeInterval, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.NewDataLoggerSettingsRecordOnDataChange}" VerticalAlignment="Center" />
            <CheckBox x:Name="checkRecordOnDataChange" Grid.Column="1" Grid.Row="10" IsChecked="{Binding RecordOnDataChange}" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto" />

            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.NewDataLoggerSettingsHysteresisTime}" VerticalAlignment="Center" />
            <editors:TimeSpanEdit  Grid.Row="11" Grid.Column="1" 
                                 TimeSpan="{Binding HysteresisTimeInterval, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            MinValue="0"
                            Mask="hh:mm:ss"
                            Validation.ErrorTemplate="{x:Null}"
                            ValidateOnTextInput="False" AllowSpinOnMouseWheel="False"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                 x:Name="textEditHysteresisTimeInterval"  />
            <ContentPresenter Grid.Row="11" Grid.Column="2" 
            Content="{Binding ElementName=textEditHysteresisTimeInterval, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.NewDataLoggerSettingsEnableRecordingTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="12" Grid.Column="1">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textEnableRecordingTag"/>
            </Grid>
            <!--<DockPanel Grid.Column="1" Grid.Row="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" >
                <Button DockPanel.Dock="Right" Tag="{Binding EnableRecordingTag, Mode=TwoWay}" Click="ResetEntityReferenceTag_Click">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="uriEnableRecordingTag" DockPanel.Dock="Right" 
                    Tag="{Binding EnableRecordingTag, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                    Click="SetEntityReferenceTag_Click" Validation.ErrorTemplate="{x:Null}">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>

                <TextBox x:Name="textEnableRecordingTag" IsReadOnly="True" Text="{Binding Path=Tag, ElementName=uriEnableRecordingTag, Mode=OneWay}" />
            </DockPanel>-->
            <ContentPresenter Grid.Row="12" Grid.Column="2" 
            Content="{Binding ElementName=textEnableRecordingTag, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.NewDataLoggerSettingsRecordingTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="13" Grid.Column="1">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textRecordingTag"/>
            </Grid>
            <!--<DockPanel Grid.Column="1" Grid.Row="13" HorizontalAlignment="Stretch" VerticalAlignment="Center" >
                <Button DockPanel.Dock="Right" Tag="{Binding RecordingTag, Mode=TwoWay}" Click="ResetEntityReferenceTag_Click">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="uriRecordingTag" DockPanel.Dock="Right" 
                    Tag="{Binding RecordingTag, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                    Click="SetEntityReferenceTag_Click" Validation.ErrorTemplate="{x:Null}">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>

                <TextBox x:Name="textRecordingTag" IsReadOnly="True" Text="{Binding Path=Tag, ElementName=uriRecordingTag, Mode=OneWay}" />
            </DockPanel>-->
            <ContentPresenter Grid.Row="13" Grid.Column="2" 
            Content="{Binding ElementName=textRecordingTag, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.NewDataLoggerSettingsResettingTag}" VerticalAlignment="Center" />
            <Grid Grid.Row="14" Grid.Column="1">
                <Propertydatatemplate:TagEntityReferencePropertyEditor x:Name="textResettingTag"/>
            </Grid>
            <!--<DockPanel Grid.Row="14" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" >
                <Button DockPanel.Dock="Right" Tag="{Binding ResettingTag, Mode=TwoWay}" Click="ResetEntityReferenceTag_Click">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="uriResettingTag" DockPanel.Dock="Right" 
                    Tag="{Binding ResettingTag, Mode=TwoWay, ValidatesOnDataErrors=True}" 
                    Click="SetEntityReferenceTag_Click" Validation.ErrorTemplate="{x:Null}">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox x:Name="textResettingTag" IsReadOnly="True" Text="{Binding Path=Tag, ElementName=uriResettingTag, Mode=OneWay}" />
            </DockPanel>-->
            <ContentPresenter Grid.Row="14" Grid.Column="2" 
            Content="{Binding ElementName=textResettingTag, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.NewDataLoggerSettingsMaxAge}" VerticalAlignment="Center" />
          <editors:TimeSpanEdit Grid.Row="15" Grid.Column="1"
                            TimeSpan="{Binding MaxAge, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            MinValue="0"                                
                            Mask="hh:mm:ss"
                            Validation.ErrorTemplate="{x:Null}"
                            ValidateOnTextInput="False" AllowSpinOnMouseWheel="False"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 x:Name="textEditMaxAge"  />
            <ContentPresenter Grid.Row="15" Grid.Column="2" 
            Content="{Binding ElementName=textEditMaxAge, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="16" Text="{x:Static properties:Resources.NewDataLoggerSettingsConnectionString}" VerticalAlignment="Center" />
            <Grid Grid.Row="16" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ReadableConnectionString, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditConnection" IsReadOnly="False" />
                <Button Grid.Column="1" Click="textEditConnection_DefaultButtonClick">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2"  Click="textEditConnection_ClearButtonClick" >
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
            </Grid>
            <ContentPresenter Grid.Row="16" Grid.Column="2" 
            Content="{Binding ElementName=textEditConnection, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock  x:Name="textBlockMaxLength" Grid.Row="17" Text="{x:Static properties:Resources.NewDataLoggerSettingsMaxLength}" VerticalAlignment="Center" />
            <dxe:SpinEdit Grid.Row="17" Grid.Column="1" EditValue="{Binding MaxLength, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MinValue="1" 
                 Mask="N0" MaskUseAsDisplayFormat="True" 
                 MaskType="Numeric" EditValueType="{x:Type sys:Int32}"
                 AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                 x:Name="textMaxLength"/>
            <ContentPresenter Grid.Row="17" Grid.Column="2" 
            Content="{Binding ElementName=textMaxLength, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock  x:Name="textBlockMaxTransactions" Grid.Row="18" Text="{x:Static properties:Resources.NewDataLoggerSettingsMaxTransactions}" VerticalAlignment="Center" />
          <dxe:SpinEdit Grid.Row="18" Grid.Column="1" EditValue="{Binding MaxTransactionsBeforeCommit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MinValue="0"
                        Mask="N0" MaskUseAsDisplayFormat="True"
                        MaskType="Numeric" EditValueType="{x:Type sys:UInt32}"
                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                 x:Name="textMaxTransactions"  />
            <ContentPresenter Grid.Row="18" Grid.Column="2" 
            Content="{Binding ElementName=textMaxTransactions, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock  x:Name="textBlockMaxErrors" Grid.Row="19" Text="{x:Static properties:Resources.NewDataLoggerSettingsMaxErrors}" VerticalAlignment="Center" />
          <dxe:SpinEdit Grid.Row="19" Grid.Column="1" EditValue="{Binding MaxErrorBeforeFlush, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MinValue="0"
                        Mask="N0" MaskUseAsDisplayFormat="True"
                        MaskType="Numeric" EditValueType="{x:Type sys:Byte}"
                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                 x:Name="textMaxErrors"  />
            <ContentPresenter Grid.Row="19" Grid.Column="2" 
            Content="{Binding ElementName=textMaxErrors, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock  x:Name="textBlockRetryTime" Grid.Row="20" Text="{x:Static properties:Resources.NewDataLoggerSettingsRetryTime}" VerticalAlignment="Center" />
          <dxe:SpinEdit Grid.Row="20" Grid.Column="1" EditValue="{Binding WaitBeforeRetry, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MinValue="0" 
                        Mask="N0" MaskUseAsDisplayFormat="True"
                        MaskType="Numeric" EditValueType="{x:Type sys:UInt32}"
                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                 x:Name="textRetryTime"  />
            <ContentPresenter Grid.Row="20" Grid.Column="2" 
            Content="{Binding ElementName=textRetryTime, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock  x:Name="textBlockCacheSize" Grid.Row="21" Text="{x:Static properties:Resources.NewDataLoggerSettingsCacheSize}" VerticalAlignment="Center" />
          <dxe:SpinEdit Grid.Row="21" Grid.Column="1" EditValue="{Binding MaxCacheSize, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}" MinValue="0"
                        Mask="N0" MaskUseAsDisplayFormat="True"
                        MaskType="Numeric" EditValueType="{x:Type sys:UInt32}"
                        AllowSpinOnMouseWheel="False" ValidateOnTextInput="True" ShowError="False" InvalidValueBehavior="AllowLeaveEditor"
                 x:Name="textCacheSize"  />
            <ContentPresenter Grid.Row="21" Grid.Column="2" 
            Content="{Binding ElementName=textCacheSize, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="22" Text="{x:Static properties:Resources.NewDataLoggerSettingsAllowDuplicatedRows}" VerticalAlignment="Center" />
            <CheckBox x:Name="checkBoxAllowDuplicatedRows" Grid.Column="1" Grid.Row="22" IsChecked="{Binding AllowDuplicatedRows}" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Left" Width="Auto" />

        </Grid>
    </ScrollViewer>
</UserControl>
