<UserControl x:Class="UFUAEditor.Controls.RuntimeAddressSpaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d"
             Height="300" Width="300">
    <UserControl.Resources>
        <converters:TranslateConverter x:Key="TranslateConverter" x:Shared="false"/>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="gridViews">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.ComboViewTitle}" HorizontalAlignment="Right" Margin="2"/>
            <ComboBox IsEditable="False" x:Name="cmbViews" Grid.Column="1" SelectionChanged="cmbViews_SelectionChanged"/>
        </Grid>
        
        <dxg:TreeListControl Grid.Row="1" Name="treeListControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged">
            <dxg:TreeListControl.Columns>
                <dxg:TreeListColumn FieldName="ItemHeader" AllowMoving="False" FilterPopupMode="Excel" SortIndex="0" SortOrder="Ascending" Header="{x:Static properties:Resources.ASName}" />
                <dxg:TreeListColumn FieldName="DataType" AllowMoving="False" FilterPopupMode="Excel" SortIndex="1" SortOrder="Ascending" Header="{x:Static properties:Resources.ASDataType}" />
                <dxg:TreeListColumn FieldName="PrototypeName" AllowMoving="False" FilterPopupMode="Excel" SortIndex="2" SortOrder="Ascending" Header="{x:Static properties:Resources.ASPrototype}" />
                <dxg:TreeListColumn FieldName="HistorianSettings" AllowMoving="False" FilterPopupMode="Excel" SortIndex="3" SortOrder="Ascending" Header="{x:Static properties:Resources.ASHistorianSettings}" />
                <!-- Validate="OnTreeHeaderValidate" -->
            </dxg:TreeListControl.Columns>
            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                    ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                    AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                    ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                    IsSynchronizedWithCurrentItem="True" AllowDragDrop="False" NodeExpanding="OnTreeNodeExpanding"
                    RowDoubleClick="OnRowDoubleClick" AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing">
                    <!--PreviewDragOver="treeListControl_PreviewDragOver"  CompleteRecordDragDrop="TreeListControl_CompletedDragDrop"
                    PreviewQueryContinueDrag="addressSpaceTree_PreviewQueryContinueDrag"
                    DropRecord="TreeListControl_DragEnd"-->
                    <dxg:TreeListView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                            <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                        </Style>
                    </dxg:TreeListView.RowStyle>
                    <dxg:TreeListView.CellStyle>
                        <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                          <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                        </Style>
                    </dxg:TreeListView.CellStyle>
                </dxg:TreeListView>
            </dxg:TreeListControl.View>
        </dxg:TreeListControl>
    </Grid>
</UserControl>
