<UserControl x:Class="UFUAEditor.Controls.NewTag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="560" Height="480"
             d:DesignHeight="560" d:DesignWidth="480" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:template="clr-namespace:UFUAEditor.PropertyDataTemplate"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}" >
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:PrototypeNameConverter x:Key="PrototypeNameConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.TagProperties}" VerticalAlignment="Center" FontWeight="Bold" />

        <TextBlock x:Name="textUseShared" Grid.Row="1" Text="{x:Static properties:Resources.UseShared}" VerticalAlignment="Center" 
                   Visibility="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}" />
        <CheckBox x:Name="checkUseShared" Grid.Column="1" Grid.Row="1" IsChecked="{Binding UseShared, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  Visibility="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"
                  HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.TagName}" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 IsEnabled="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
        <ContentPresenter Grid.Row="2" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.TagDescription}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Description}" x:Name="textEditDesc" 
                 IsEnabled="{Binding IsSharedMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}" 
                 VerticalAlignment="Center" HorizontalAlignment="Stretch" />

        <!--<TextBlock Grid.Row="3" Text="{x:Static properties:Resources.TagAlarm}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding AlarmDescription}" x:Name="textEditAlarmText" VerticalAlignment="Center" HorizontalAlignment="Stretch" />-->

        <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.TagModel}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" Grid.Row="4" SelectedValue="{Binding ModelType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                  IsEnabled="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                  x:Name="comboModelType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboModelType_SelectionChanged" />
        <ContentPresenter Grid.Row="4" Grid.Column="2" 
            Content="{Binding ElementName=comboModelType, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.TagData}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textDataType" />
        <ComboBox Grid.Column="1" Grid.Row="5" SelectedValue="{Binding DataType, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                  IsEnabled="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                  x:Name="comboDataType" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboDataType_SelectionChanged" />
        <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=comboDataType, Path=(Validation.Errors).CurrentItem}"/>

         <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.TagPrototype}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textPrototype"/>
            <ComboBox Grid.Column="1" Grid.Row="5" Text="{Binding PrototypeName, Mode=OneTime, Converter={StaticResource PrototypeNameConverter}}" 
                      SelectedValue="{Binding PrototypeName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                      IsEnabled="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                      x:Name="comboPrototype" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="True" IsReadOnly="True" />
        <ContentPresenter Grid.Row="5" Grid.Column="2" 
            Content="{Binding ElementName=comboPrototype, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.TagEngineering}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textEngineeringUnit"/>
            <ComboBox Grid.Column="1" Grid.Row="6" Text="{Binding UFUAEngineeringUnit, Mode=OneTime}" 
                      SelectedValue="{Binding UFUAEngineeringUnit, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                      x:Name="comboEngineeringUnit" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="True" IsReadOnly="True" 
                      IsEnabled="{Binding IsSharedMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}" />
        <ContentPresenter Grid.Row="6" Grid.Column="2" 
            Content="{Binding ElementName=comboEngineeringUnit, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.TagDynamic}" VerticalAlignment="Center" x:Name="textDynamicSettings"/>
            <ContentControl x:Name="contentDynamic" Grid.Row="7" Grid.Column="1" 
                            IsEnabled="{Binding IsSharedMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}">
            <ContentControl.Content>
                    <template:EnumDynamicSettingsPropertyEditor x:Name="gridDynamic" VerticalAlignment="Center" />
            </ContentControl.Content>    
        </ContentControl>

        <TextBlock x:Name="textBlockRetentive" Grid.Row="9" Text="{x:Static properties:Resources.TagRetentive}" VerticalAlignment="Center" />
        <CheckBox x:Name="checkBoxRetentive" Grid.Column="1" Grid.Row="9" IsChecked="{Binding IsRetentive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    IsEnabled="{Binding IsSharedMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}" 
                    HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center" />

        <TextBlock x:Name="textBlockArrayDimension" Grid.Row="10" Text="{x:Static properties:Resources.TagArray}" VerticalAlignment="Center" />
       <dxe:SpinEdit  Grid.Column="1" Grid.Row="10" Name="textArrayDimension" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                     IsEnabled="{Binding IsSubPrototypeMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                     MinValue="0" MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:UInt32}" 
                     Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                     EditValue="{Binding ArrayDimension, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
        <ContentPresenter Grid.Row="10" Grid.Column="2" 
            Content="{Binding ElementName=textArrayDimension, Path=(Validation.Errors).CurrentItem}"/>

        <TextBlock x:Name="textBlockInitialValue" Grid.Row="11" Text="{x:Static properties:Resources.TagInitial}" VerticalAlignment="Center" />
        <TextBox x:Name="textInitialValue" Grid.Column="1" Grid.Row="11" 
                 Text="{Binding InitialValue, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 IsEnabled="{Binding IsSharedMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}"
                 VerticalAlignment="Center" HorizontalAlignment="Stretch" />
        <ContentPresenter Grid.Row="11" Grid.Column="2" 
            Content="{Binding ElementName=textInitialValue, Path=(Validation.Errors).CurrentItem}"/>

       <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.TagEnum}" VerticalAlignment="Center" x:Name="textEnumStrings"/>
            <DockPanel x:Name="dockEnumStrings" Grid.Column="1" Grid.Row="12" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                       IsEnabled="{Binding IsSharedMember, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}">
                <Button DockPanel.Dock="Right" Tag="{Binding EnumStrings, Mode=OneWay}" Click="DlgButton_Click_Clear" 
                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource CancelSmall}" Height="14" Width="14" />
                    </Button.Content>
                </Button>
                <Button x:Name="uriCommand" DockPanel.Dock="Right" Tag="{Binding EnumStrings, Mode=OneWay}" Click="DlgButton_Click" 
                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="14" Width="14" />
                    </Button.Content>
                </Button>
                <TextBox Text="{Binding EnumStringsFlat, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" x:Name="textEditEnumStrings" 
                         VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </DockPanel>
            <ContentPresenter Grid.Row="12" Grid.Column="2" 
                Content="{Binding ElementName=textEditEnumStrings, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
