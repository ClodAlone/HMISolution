<UserControl x:Class="UFUAEditor.Controls.TagsImportProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:converters="clr-namespace:UFUAEditor.Converters"
             mc:Ignorable="d" Width="300" Height="200"
             d:DesignHeight="200" d:DesignWidth="300">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5" Orientation="Vertical" 
                    Visibility="{Binding IsAborting, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}">
            <Label Content="{x:Static properties:Resources.TagsImportProgressStructuresProgress}"/>
            <ProgressBar Margin="0, 10, 0, 0"
                Minimum="0" 
                Maximum="100" 
                Height="20" 
                Value="{Binding PrototypesImportOverallProgress}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="5" Orientation="Vertical"
                    Visibility="{Binding IsAborting, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}">
            <Label Content="{x:Static properties:Resources.TagsImportProgressTagsImportProgress}"/>
            <ProgressBar Margin="0, 10, 0, 0"
                Minimum="0" 
                Maximum="100" 
                Height="20"
                Value="{Binding TagsImportOverallProgress}"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Margin="5" Orientation="Vertical"
                    Visibility="{Binding IsAborting, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}">
            <Label Content= "{x:Static properties:Resources.TagsImportProgressOverallImportProgress}"/>
            <ProgressBar Margin="0, 10, 0, 0"
                Minimum="0" 
                Maximum="100" 
                Height="20" 
                Value="{Binding ImportOverallProgress}"/>
        </StackPanel>


        <StackPanel Grid.Row="0" Margin="5" Orientation="Vertical"
                    Visibility="{Binding IsAborting, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False, Mode=OneWay}">
            <Label Content= "{x:Static properties:Resources.TagsImportProgressAbortingLabel}"/>
            <ProgressBar Margin="0, 10, 0, 0" IsIndeterminate="True" Height="20"/>
        </StackPanel>
    </Grid>
</UserControl>