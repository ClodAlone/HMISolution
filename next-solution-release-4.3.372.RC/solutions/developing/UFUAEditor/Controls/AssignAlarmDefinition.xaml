<UserControl x:Class="UFUAEditor.Controls.AssignAlarmDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFUAEditor.Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             Width="500" Height="500"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="500">
    
    <UserControl.Resources>
        <!-- The ObjectDataProvider exposes the enum as a binding source -->
        <ObjectDataProvider 
            x:Key="assignTypes"
            MethodName="GetValues" 
            ObjectType="{x:Type system:Enum}" >
            <!-- Pass the AssignAlarmType type to the -->
            <!-- GetValues property of System.Enum. -->
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="self:AssignAlarmType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <self:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="prototypeList" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" 
                        Content="{Binding AlarmPrototypeList}" />
        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Background="{x:Null}" 
                  IsEnabled="{Binding IsSingleAlarmDefinitionSelected, Mode=OneWay}"
                  Opacity="{Binding IsSingleAlarmDefinitionSelected, Mode=OneWay, Converter={StaticResource BooleanToOpacityConverter}}"
                  Header="{x:Static properties:Resources.AssignAlarmSettings}" >
            <Grid Margin="5" >
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static properties:Resources.AssignAlarmMode}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False"
                      ToolTip="{x:Static properties:Resources.AssignAlarmModeTooltip}"
                      SelectedItem="{Binding AssignAlarmType}" ItemsSource="{Binding Source={StaticResource assignTypes}}" />

                <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.AssignAlarmText}" VerticalAlignment="Center" />
                <CheckBox Grid.Row="1" Grid.Column="1"  HorizontalAlignment="Left" Width="Auto" VerticalAlignment="Center"
                          ToolTip="{x:Static properties:Resources.AssignAlarmTextTooltip}"
                          IsChecked="{Binding SetAlarmText}" />

                <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.AssingAlarmTextPrefix}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                         ToolTip="{x:Static properties:Resources.AssingAlarmTextPrefixTooltip}"
                         Text="{Binding PrefixAlarmText}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
