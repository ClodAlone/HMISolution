<UserControl x:Class="UFUAEditor.Controls.ImportEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:local="clr-namespace:UFUAEditor"
             xmlns:src="clr-namespace:WPFUtilities.ImportExportHelpers;assembly=WPFUtilities"
             xmlns:converter="clr-namespace:UFUAEditor.Converters"
             mc:Ignorable="d">
    <!--xmlns:tree="clr-namespace:Aga.Controls.Tree;assembly=Aga.Controls"-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <src:ImportItemsCheckedConverter x:Key="ImportItemsCheckedConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="1" Margin="2" FontWeight="Bold" BorderThickness="1" Header="{x:Static properties:Resources.ActionType}" >
            <StackPanel Margin="5" >
                <RadioButton GroupName="EnumActionGroup" Margin="2" Content="{x:Static properties:Resources.ExportActionType}"
                IsChecked="{Binding EnumAction, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                ConverterParameter={x:Static src:ActionType.Export}}"/>

                <RadioButton GroupName="EnumActionGroup" Margin="2" Content="{x:Static properties:Resources.ImportActionType}"  
                IsChecked="{Binding EnumAction, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                ConverterParameter={x:Static src:ActionType.Import}}">
                </RadioButton>
            </StackPanel>
        </GroupBox>
        <GroupBox Visibility="{Binding ShowFilter, 
                    RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, 
                    Converter={StaticResource BoolToVisibilityConverter}, 
                    ConverterParameter=False}"
            Grid.Row="2" Margin="2" x:Name="filterGrid" FontWeight="Bold" Header="{x:Static properties:Resources.PropertyFilter}" >
            <DockPanel LastChildFill="True" Margin="5" >
                <!--<TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left" FontWeight="Normal" TextAlignment="Left" Text="{x:Static properties:Resources.PropertyFilterName}" />-->
                <CheckBox Margin="2" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding MatchCase, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" Content="{x:Static properties:Resources.MatchCase}" />
                <TextBox IsReadOnly="False"  Margin="2" DockPanel.Dock="Left" TextWrapping="Wrap" Text="{Binding Filter, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
            </DockPanel>
        </GroupBox>
        <GroupBox Visibility="{Binding ShowSeparator, 
                    RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, 
                    Converter={StaticResource BoolToVisibilityConverter}, 
                    ConverterParameter=False}"
            Grid.Row="3" Margin="2" x:Name="filterSep" FontWeight="Bold" Header="{x:Static properties:Resources.PropertySep}" >
            <StackPanel Margin="5">
                <RadioButton GroupName="SepPropertyGroup" Margin="2" Content="';'"  
                    IsChecked="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                    ConverterParameter={x:Static src:SepType.SemiColon}}">
                </RadioButton>
                <RadioButton GroupName="SepPropertyGroup" Margin="2" Content="','"
                    IsChecked="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                    ConverterParameter={x:Static src:SepType.Colon}}"/>
                <RadioButton GroupName="SepPropertyGroup" Margin="2" Content="Tab"
                    IsChecked="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Converter={StaticResource ImportItemsCheckedConverter}, 
                    ConverterParameter={x:Static src:SepType.Tab}}">
                </RadioButton>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="2" FontWeight="Bold" Header="{x:Static properties:Resources.SelectFle}">
            <DockPanel LastChildFill="True" Margin="5">
                <!--<TextBlock DockPanel.Dock="Left"  Margin="2" FontWeight="Normal" MinWidth="80" TextAlignment="Left" Text="{x:Static properties:Resources.ImportEditorFilePath}" />-->
                <Button DockPanel.Dock="Right"  Margin="2" Name="btnOpen" MinWidth="30" Content="..." ToolTip="{x:Static properties:Resources.SelectFle}" Click="SelectFile_Click"></Button>
                <TextBox IsReadOnly="True" Margin="2" TextWrapping="Wrap" Text="{Binding FilePath, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
