<UserControl x:Class="UFUAEditor.Controls.DynamicSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             Width="500" Height="300"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <dx:DXTabControl Name="tabControlExt" SelectionChanged="tabControlExt_SelectionChanged"
                         dx:DXTabControl.TabContentCacheMode="CacheTabsOnSelecting"/>
        <StackPanel Visibility="Collapsed" x:Name="stackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Static properties:Resources.DriverInstall}" TextWrapping="Wrap" Margin="2,2,2,2"/>
            <Button x:Name="btnInstallDriver" Content="{x:Static properties:Resources.DriverInstallBtn}" Click="Button_Click" Margin="2,2,2,2"/>
        </StackPanel>
    </Grid>
</UserControl>
