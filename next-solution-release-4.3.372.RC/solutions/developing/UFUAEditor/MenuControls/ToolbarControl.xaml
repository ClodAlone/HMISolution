<dxb:BarManager
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="UFUAEditor.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFUAEditor.MenuControls"
             xmlns:properties="clr-namespace:UFUAEditor.Properties"
             xmlns:self="clr-namespace:UFUAEditor"
             mc:Ignorable="d" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="UFUAEditorBarManagerToolbar"
             d:DesignHeight="450" d:DesignWidth="800">
    <dxb:BarManager.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/UFUAServer.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dxb:BarManager.Resources>
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="generalToolBar1" x:Name="generalToolBar1" 
                    GlyphSize="Small" ShowDragWidget="True" 
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStartServer"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStopServer"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAttachDebugger"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biCertificateChecker"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biServiceManager"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportAddressSpace"/>
        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="addressSpaceToolBar1" x:Name="addressSpaceToolBar1"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True"  
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddFolder"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddTag"/>
          <!--<dxb:BarButtonItem IsVisible="False" x:Name="biAddGeneralFolder" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                       Glyph="{StaticResource OpenFolder}"
                       Command="{x:Static self:UIGeneralCommands.AddNewGeneralFolder}" />
          <dxb:BarButtonItem IsVisible="False" x:Name="biAddGeneralTag"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                       Glyph="{StaticResource UFUASVariable}"
                       Command="{x:Static self:UIGeneralCommands.AddNewGeneralTag}" />-->
          <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddPrototype"/>-->
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewPrototype"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biMoveMemberUp"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biMoveMemberDown"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biSetMemberPosition"/>
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportPrototypes"/>-->
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExport"/>-->
        </dxb:Bar>
        <!--<dxb:Bar dxb:MergingProperties.Name="localTagsToolbar1" x:Name="localTagsToolbar1"
                    GlyphSize="Small" ShowDragWidget="True" Caption="{x:Static properties:Resources.TempVariables}"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddFolderLocal"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddTagLocal"/>
        </dxb:Bar>-->
        <!--<dxb:Bar dxb:MergingProperties.Name="prototypesToolBar1" x:Name="prototypesToolBar1"
                    GlyphSize="Small" ShowDragWidget="True" Caption="{x:Static properties:Resources.PrototypeRibbonTitle}"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewPrototype"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewFolder"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewMember"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportPrototypes"/>

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biMoveMemberUp"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biMoveMemberDown"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biSetMemberPosition"/>
        </dxb:Bar>-->
        <dxb:Bar dxb:MergingProperties.Name="assignToolbar1" x:Name="assignToolbar1"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAssignAlarmDefinition"/>
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biRemoveAlarmDefinitions"/>-->
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAssignHistoricalSettings"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAssociateView"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewDataLoggerColumn"/>
        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="driverToolBar1" x:Name="driverToolBar1"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewDriver"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biOpenDriverSettings"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biImportTagsDrivers"/>
        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="historicalsToolBar1" x:Name="historicalsToolBar1"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewHistoricalSettings"/>
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biManteinanceHistoricalSettings"/>-->
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportHistoricals"/>-->
        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="historicalsToolBar2" x:Name="historicalsToolBar2"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewDataLoggerSettings"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAggregateTables"/>
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportDataloggers"/>-->
        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="alarmToolBar1"  x:Name="alarmToolBar1"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAlarmArea"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAlarmSource"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAlarmPrototype"/>
            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biMessagePrototype"/>

            <dxb:BarItemLinkSeparator />

            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportAlarms"/>-->

        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="addressSpaceToolBar2" x:Name="addressSpaceToolBar2"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddEUnit"/>
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biImportExportEU"/>-->

        </dxb:Bar>
        <dxb:Bar dxb:MergingProperties.Name="addressSpaceToolBar3" x:Name="addressSpaceToolBar3"
                    GlyphSize="Small" ShowDragWidget="True"
                    AllowCustomizationMenu="True" 
                    AllowDrop="True" 
                    AllowHide="True"
                    AllowCollapse="True"
                    AllowQuickCustomization="True">

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddView"/>

        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
