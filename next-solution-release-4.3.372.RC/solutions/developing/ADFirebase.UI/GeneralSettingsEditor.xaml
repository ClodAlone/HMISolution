<UserControl x:Class="ADFirebase.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:templates="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:ADFirebase.UI.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static properties:Resources.Title}" Grid.ColumnSpan="6" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>

            <TextBlock Text="{x:Static properties:Resources.pathToServiceAccountKey}" Grid.Column="0" Grid.Row="3" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="txtServiceAccountKeyFile" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5" Text="{Binding ServeiceAccountKeyFile, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <Button Name="btnBrowseServiceAccountKeyFile" Grid.Column="4" Grid.Row="3" HorizontalAlignment="Right" Margin="5,0,0,0" Click="btnBrowseServiceAccountKeyFile_Click" VerticalAlignment="Center">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ContentPresenter Grid.Row="3" Grid.Column="5" 
                Content="{Binding ElementName=ServeiceAccountKeyFile, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.RealtimeDatabaseUrl}" Grid.Column="0" Grid.Row="4" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="txtRealtimeDatabaseUrl" Grid.Column="2" Grid.Row="4"  Grid.ColumnSpan="3" Margin="0,5" Text="{Binding RealtimeDatabaseUrl, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="4" Grid.Column="5" 
                Content="{Binding ElementName=RealtimeDatabaseUrl, Path=(Validation.Errors).CurrentItem}"/>

            <CheckBox Name="ChkUseAccessToken" Content="{x:Static properties:Resources.UseAccessToken}" Grid.Column="2" Grid.Row="5" Height="29" VerticalContentAlignment="Center" 
                      IsChecked="{Binding UseAccessToken, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" />

            <TextBlock Text="{x:Static properties:Resources.NotificantionsTitle}" Grid.Column="0" Grid.Row="6" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="txtNotificationsTitle" Grid.Column="2" Grid.Row="6"  Margin="0,5" Text="{Binding NotificationsTitle, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" Grid.ColumnSpan="3"></TextBox>
            <ContentPresenter Grid.Row="6" Grid.Column="5" 
                Content="{Binding ElementName=NotificationsTitle, Path=(Validation.Errors).CurrentItem}"/>

        </Grid>
    </ScrollViewer>
</UserControl>
