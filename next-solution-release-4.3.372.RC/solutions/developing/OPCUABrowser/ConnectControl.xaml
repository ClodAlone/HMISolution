<UserControl x:Class="OPCUABrowser.ConnectControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="{Binding ElementName=TreeViewItem, Path=Width}"
    Height="{Binding ElementName=TreeViewItem, Path=Height}"
    xmlns:cc="clr-namespace:CommonControls;assembly=CommonControls" >
    
    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/OPCUABrowser.xaml" />
                <ResourceDictionary Source="Resources\GlobalConverters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="stackButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="stackButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

        </ResourceDictionary>

    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource MouseOverOpacity}" x:Name="MouseOver_BeginStoryboard" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource MouseLeaveOpacity}" x:Name="MouseLeave_BeginStoryboard" />
        </EventTrigger>
    </UserControl.Triggers>
    <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" 

                        Visibility="{Binding IsBusy, 
                        Converter={StaticResource BoolToVisibilityConv}, 
                        ConverterParameter=false}" >
                        
            <cc:CircularProgressBar />
        </Viewbox>
        <TextBlock x:Name="appDescTitle" FontWeight="Bold" Margin="2,0,2,0"/>
        <TextBlock Text="{Binding DisplayTitle}" Margin="2,0,2,0"/>
        <StackPanel Orientation="Horizontal" x:Name="stackButtons" Opacity="0">
            <Button Click="Button_Browse">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="2" Source="{StaticResource OPCBaddbk}" Height="14" Width="14"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Click="Button_AreaBrowse">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="2" Source="{StaticResource OPCBwiretransfer}" Height="14" Width="14"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Click="Button_Alarm">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="2" Source="{StaticResource OPCBvolume}" Height="14" Width="14"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Click="Button_Audit">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="2" Source="{StaticResource OPCBdatabase}" Height="14" Width="14"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Click="Button_Remove">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Margin="2" Source="{StaticResource OPCBRemoveRecentEndpoint}" Height="14" Width="14"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
