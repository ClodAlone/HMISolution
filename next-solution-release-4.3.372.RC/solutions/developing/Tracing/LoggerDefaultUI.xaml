        <ListView HorizontalContentAlignment="Stretch" ItemsSource="{Binding logItems}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static properties:Resources.TimeColumnHeader}" DisplayMemberBinding="{Binding Path=TimeStamp}" Width="100" />
                    <GridViewColumn Header="{x:Static properties:Resources.CategoryColumnHeader}" DisplayMemberBinding="{Binding Path=Severity}" Width="80" />
                    <GridViewColumn Header="{x:Static properties:Resources.MessageColumnHeader}" DisplayMemberBinding="{Binding Path=Message}" Width="200" />
                    <GridViewColumn Header="{x:Static properties:Resources.SourceColumnHeader}" DisplayMemberBinding="{Binding Path=Source}" Width="200" />
                </GridView>
            </ListView.View>
        </ListView>
