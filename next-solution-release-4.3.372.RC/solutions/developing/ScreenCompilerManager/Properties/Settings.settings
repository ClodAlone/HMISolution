<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="ScreenCompilerManager.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="ScreenCompilerExe" Type="System.String" Scope="Application">
      <Value Profile="(Default)">ScreenCompiler.exe</Value>
    </Setting>
    <Setting Name="ScreenCompilerArg" Type="System.String" Scope="Application">
      <Value Profile="(Default)">/P"{0}" /S"{1}" /C"{2}" /K</Value>
    </Setting>
    <Setting Name="ScreenCompiledExtension" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.compiled</Value>
    </Setting>
    <Setting Name="ScreenCompilerEnabled" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">True</Value>
    </Setting>
    <Setting Name="ScreenCompilerTraceEnabled" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">False</Value>
    </Setting>
    <Setting Name="MaxRetryOnError" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">3</Value>
    </Setting>
    <Setting Name="ScreenCompilerRemoveCompiledParameter" Type="System.String" Scope="Application">
      <Value Profile="(Default)">/S"{0}" /D</Value>
    </Setting>
  </Settings>
</SettingsFile>