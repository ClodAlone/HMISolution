<UserControl x:Class="UFShortcutEditor.Controls.TypeKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             FocusManager.FocusedElement="{Binding ElementName=btnKey}"
             mc:Ignorable="d" 
             xmlns:properties="clr-namespace:UFShortcutEditor.Properties" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Button x:Name="btnKey" Content="{x:Static properties:Resources.TypeAnyKeyTitle}" FontSize="22" 
                PreviewKeyDown="UserControl_PreviewKeyDown" PreviewKeyUp="UserControl_PreviewKeyUp"/>
    </Grid>
</UserControl>
