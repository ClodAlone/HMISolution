<UserControl x:Class="DataloggerViewerControl.DataloggerViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:DataloggerViewerControl.Properties"
             xmlns:enum="clr-namespace:DataloggerViewerControl"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:self="clr-namespace:DataloggerViewerControl.Converters"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:wpfutils="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" Height="835" Width="865">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/DataLoggerViewer.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <dxe:TextEditSettings x:Key="dateSettings" DisplayFormat="" MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            <dxe:TextEditSettings x:Key="generalSettings" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"  />
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <DiscreteObjectKeyFrame x:Key="colTextWrapKey" Value="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></DiscreteObjectKeyFrame>
            <Style x:Key="printColumnHeaderStyle" BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintHeaderStyle}}" TargetType="dxe:TextEdit">
                <Setter Property="TextWrapping" Value="{Binding Value, Source={StaticResource colTextWrapKey}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <DockPanel.Resources>
            <self:ErrorInfoToBooleanConverter x:Key="ErrorInfoToBooleanConverter" />
            <self:ErrorInfoToVisibilityConverter x:Key="ErrorInfoToVisibilityConverter" />

            <!-- GRID CONTROL -->
            <!-- Header Foreground -->
            <DataTemplate x:Key="ColumnHeaderTemplate">
                <Border>
                    <ContentPresenter Name="contentPresenter" Content="{Binding}" TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontFamily="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontSize="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontWeight="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontStyle="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                     Style="{Binding  Path=(dxg:BaseGridHeader.GridColumn).ActualColumnHeaderContentStyle, RelativeSource={RelativeSource TemplatedParent}}">
                    </ContentPresenter>
                </Border>
            </DataTemplate>
            <!-- END GRID CONTROL -->
        </DockPanel.Resources>
        <dxb:BarContainerControl ContainerType="Top" DockPanel.Dock="Top" x:Name="toolbar">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" dxb:MergingProperties.Name="mainDataloggerViewerToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False">
              <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                  <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  UseLightweightTemplates="False" EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                        <dxe:ComboBoxEdit 
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>

                    <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall" Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmall" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />  
              </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit"  />
                <dxb:BarItemSeparator />

                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="startTime" Content="{x:Static properties:Resources.HistoricalEvents_DateTimeStart}" EditValue="{Binding DateTimeStart,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                        </dxe:TextEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>

                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="endTime" Content="{x:Static properties:Resources.HistoricalEvents_DateTimeEnd}" EditValue="{Binding DateTimeEnd,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                        </dxe:TextEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>

              <dxb:BarStaticItem ShowBorder="False" x:Name="comboDataloggerListTitle" Content="{x:Static properties:Resources.HistoricalEvents_DataloggerList}" />
              <dxb:BarEditItem UseLightweightTemplates="False" x:Name="comboDataloggerList" Content="{x:Static properties:Resources.HistoricalEvents_DataloggerList}" EditValueChanged="comboDataloggerList_SelectionChanged">
                  <dxb:BarEditItem.EditTemplate>
                    <DataTemplate>
                      <dxe:ComboBoxEdit 
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                      Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" 
                                      IsTextEditable="False" />
                    </DataTemplate>
                  </dxb:BarEditItem.EditTemplate>
              </dxb:BarEditItem>
              <dxb:BarEditItem IsVisible="False" UseLightweightTemplates="False" x:Name="comboDataloggerList_web" Content="{x:Static properties:Resources.HistoricalEvents_DataloggerList}" EditValueChanged="comboDataloggerList_SelectionChanged">
                    <dxb:BarEditItem.EditTemplate>
                        <DataTemplate>
                            <wpfutils:ComboWeb
                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                SelectedItem="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:BarItemLinkInfo}}, Path=Item.EditValue}"
                                x:Name="PART_Editor"
                                IsEditable="False"
                                MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}"
                                Validation.ErrorTemplate="{x:Null}" />
                        </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
              </dxb:BarEditItem>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid DockPanel.Dock="Top" MinHeight="40" Grid.Row="0" x:Name="options">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="Button1" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Minute}" Grid.Column="0" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="1" />
                <Button x:Name="Button2" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Hour}" Grid.Column="1"
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="2" />
                <Button x:Name="Button3" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Day}" Grid.Column="2" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="3" />
                <Button x:Name="Button4" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Week}" Grid.Column="3" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="4" />
                <Button x:Name="Button5" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Month}" Grid.Column="4" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="5" />
                <Button x:Name="Button6" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_Year}" Grid.Column="5" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="6" />
                <Button x:Name="Button7" ToolTipService.ShowOnDisabled="True" Grid.Row="1" Content="{x:Static properties:Resources.HistoricalEvents_All}" Grid.Column="6" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="0" />
            </Grid>
            <Grid DockPanel.Dock="Bottom" Grid.Row="2" x:Name="commands">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button DockPanel.Dock="Bottom" MinHeight="40" Grid.Row="2" ToolTipService.ShowOnDisabled="True" x:Name="Button8" Content="{x:Static properties:Resources.RefreshDataCommand}" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="7" />
                <Button Grid.Row="2" Grid.Column="1"
    		MinWidth="16" x:Name="Button9"
    		ToolTip="{x:Static properties:Resources.ExportDataCommand}"
    		Command="{Binding Path=ExportDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="1" Tag="ButtonExportData">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.ExportDataCommand}" Background="{x:Null}" x:Name="txtExport" />
                    </StackPanel>
                </Button>
                <ComboBox MinWidth="90" Visibility="Visible" Grid.Column="2" x:Name="cmbExportType" SelectionChanged="cmbExportType_SelectionChanged" />
                <Border Grid.Column="3" BorderThickness="1" 
                        BorderBrush="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderBrush}}"
                        Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}">
                    <dxe:CheckEdit ShowBorder="True" Grid.Column="3" x:Name="chkMultiLine" Content="{x:Static properties:Resources.HistoricalEvents_MultilineExportOption}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" Checked="chkMultiLine_Checked" Unchecked="chkMultiLine_Unchecked"></dxe:CheckEdit>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
			                 Tag="DataSourceStyle"
                             AutoExpandAllGroups="True"
                             AutoPopulateColumns="True" AutoGenerateColumns="AddNew" AutoGeneratedColumns="OnColumnsGenerated"
			                 x:Name="gridControl"
                             AllowDrop="True" 
                             AllowLiveDataShaping="False"                         
                             dx:DXSerializer.SerializationID="gridControl" 
                             dx:DXSerializer.StoreLayoutMode="All" 
                             dxg:DataControlSerializationOptions.AddNewColumns="False" 
    		                 dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                    <dxg:GridControl.View>
                        <!--<dxg:TableView Name="tableView" ShowTotalSummary="True"  AllowEditing="False"
                               ShowAutoFilterRow="True" ShowFilterPanelMode="ShowAlways" InvalidRowException="tableView_InvalidRowException"
                               ColumnHeaderTemplate="{DynamicResource ColumnHeaderTemplate}">-->
                        <!---->

                    <dxg:TableView x:Name="tableView" AllowEditing="False" InvalidRowException="tableView_InvalidRowException" AutoWidth="False"
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        ShowGroupPanel="True"
                        ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row"
                        VerticalScrollbarVisibility="Auto"
                        HorizontalScrollbarVisibility="Auto">
                            <dxg:TableView.RowStyle>
                                <!--<Style BasedOn="{StaticResource {dxgt:GridRowThemeKey 
                                ResourceKey=RowStyle}}" TargetType="{x:Type dxg:GridRowContent}">-->
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Setter Property="TextBlock.FontFamily" Value="{Binding RowAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontSize" Value="{Binding RowAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontWeight" Value="{Binding RowAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontStyle" Value="{Binding RowAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <!--<Style.Triggers>
                                <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>-->
                                </Style>
                            </dxg:TableView.RowStyle>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>


                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.RowSpan="3" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.RowSpan="3"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
                <Border Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                BorderThickness="1" BorderBrush="Gray" Background="Black" 
                Visibility="{Binding ElementName=errorInfo, Path=Text, Converter={StaticResource ErrorInfoToVisibilityConverter}}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=gridDataControl1, Mode=OneWay}" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2" Text="{x:Static properties:Resources.DataLoggerViewerError}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Foreground="Red" />
                        <Button Grid.Column="1" Margin="2" Width="24" HorizontalAlignment="Right" Click="errorInfo_ClearMessage">
                            <Button.Content>
                                <Image Source="{DynamicResource DLVAcknowledge}" Height="14" Width="14" />
                            </Button.Content>
                        </Button>
                        <TextBlock x:Name="errorInfo" Grid.Row="1" Grid.ColumnSpan="2" 
                            Margin="2" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Text="" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
