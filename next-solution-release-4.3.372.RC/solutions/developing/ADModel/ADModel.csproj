    </Compile>
    <Compile Include="ADBaseAddress.cs" />
    <Compile Include="ADFolder.cs" />
    <Compile Include="ADGeneralSettings.cs" />
    <Compile Include="ADMessage.cs" />
    <Compile Include="ADNotification.cs" />
    <Compile Include="ADPlugin.cs" />
    <Compile Include="MediaType.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
