<UserControl x:Class="Meters.LinearMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:converters="clr-namespace:Meters.Converters" 
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             FontSize="14" FontFamily="Segoe UI" FontWeight="Normal" FontStyle="Normal"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Viewbox Stretch="Fill" x:Name="view">
        <Grid x:Name="container">
        </Grid>
    </Viewbox>
 </UserControl>
