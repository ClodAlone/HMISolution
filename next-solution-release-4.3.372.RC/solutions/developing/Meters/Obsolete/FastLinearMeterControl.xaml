<basetype:RangeBaseControl x:Class="Meters.FastLinearMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gauge="http://schemas.actiprosoftware.com/winfx/xaml/gauge"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:rbconverters="clr-namespace:RangeBaseControl.Converters;assembly=RangeBaseControl"
             xmlns:converter="clr-namespace:Meters.Converters" Background="#FFD6D4D4"
             xmlns:basetype="clr-namespace:RangeBaseControl;assembly=RangeBaseControl"
                           
             xmlns:local="clr-namespace:Meters">
  <basetype:RangeBaseControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Meters;component/MeterContainers/FastControlResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
        <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converter:EnumTypeConverter x:Key="EnumTypeConverter"/>
        <converter:FontSettingsConverter x:Key="FontSettingsConverter"/>
        <rbconverters:MinorIntervalConverter x:Key="MinorIntervalConverter"/>
        <rbconverters:MajorIntervalConverter x:Key="MajorIntervalConverter"/>
      </ResourceDictionary>
  </basetype:RangeBaseControl.Resources>
  <basetype:RangeBaseControl.Style>
    <Style TargetType="{x:Type basetype:RangeBaseControl}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type basetype:RangeBaseControl}">
            <Grid x:Name="mainGrid">
              <gauge:LinearGauge x:Name="gauge"
                           IsRimEffectEnabled="False" IsBackgroundEffectEnabled="False"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                           FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                           RimBrush="Transparent"
                           Background="Transparent"
                           FrameType="None">
                <gauge:LinearGauge.Scales>
                    <gauge:LinearScale BarExtent="75%" 
                        BarAscent="{Binding BarWidth, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                        Background="{Binding BarBackColor, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" >
                    <gauge:LinearScale.TickSets>
                      <gauge:LinearTickSet Minimum="0" Maximum="100" x:Name="tickSet">
                        <gauge:LinearTickSet.Ticks>
                          <!--Minor TickMarks-->
                          <gauge:LinearTickMarkMinor
                            MajorIntervalType="Linear" MinorIntervalType="Linear" x:Name="tickMarkMinor"
                            ScalePlacement="{Binding MeterScalePlacement, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            ScaleOffset="{Binding MeterScaleMinorOffset, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            TickMarkExtent="{Binding MinorTickMarkWidth, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            TickMarkAscent="{Binding MinorTickMarkHeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            Background="{Binding MeterScaleColor, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" >
                            <gauge:LinearTickMarkMinor.MajorInterval>
                                <MultiBinding Converter="{StaticResource MajorIntervalConverter}">
                                    <Binding Path="MeterScaleMajorInterval" RelativeSource="{RelativeSource AncestorType=UserControl,Mode=FindAncestor}" Mode="OneWay" />
                                    <Binding Path="Maximum" ElementName="tickSet" Mode="OneWay" />
                                    <Binding Path="Minimum" ElementName="tickSet" Mode="OneWay" />
                                </MultiBinding>
                            </gauge:LinearTickMarkMinor.MajorInterval>
                            <gauge:LinearTickMarkMinor.MinorInterval>
                                <MultiBinding Converter="{StaticResource MinorIntervalConverter}">
                                    <Binding Path="MeterScaleMinorInterval" RelativeSource="{RelativeSource AncestorType=UserControl,Mode=FindAncestor}" Mode="OneWay" />
                                    <Binding Path="MajorInterval" RelativeSource="{RelativeSource Self}" Mode="OneWay" />
                                </MultiBinding>
                            </gauge:LinearTickMarkMinor.MinorInterval>
                          </gauge:LinearTickMarkMinor>
                          <!--Major TickMarks-->
                          <gauge:LinearTickMarkMajor
                            MajorIntervalType="Linear" MinorIntervalType="Linear"
                            ScalePlacement="{Binding MeterScalePlacement, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            ScaleOffset="{Binding MeterScaleOffset, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            TickMarkExtent="{Binding MajorTickMarkWidth, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            TickMarkAscent="{Binding MajorTickMarkHeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            Background="{Binding MeterScaleColor, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            MajorInterval="{Binding Path=MajorInterval, ElementName=tickMarkMinor, Mode=OneWay}"
                            MinorInterval="{Binding Path=MinorInterval, ElementName=tickMarkMinor, Mode=OneWay}"/>
                          <!--Labels-->
                          <gauge:LinearTickLabelMajor
                          TextFormat="{Binding Path=LabelStringFormat, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          FontSize="{Binding Path=LabelFontSettings.FontSize, Converter={StaticResource FontSettingsConverter}, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          FontWeight="{Binding Path=LabelFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          FontStyle="{Binding Path=LabelFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          FontFamily="{Binding Path=LabelFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          ScaleOffset="{Binding LabelOffset, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          ScalePlacement="{Binding MeterScalePlacement, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                          MajorInterval="{Binding Path=MajorInterval, ElementName=tickMarkMinor, Mode=OneWay}"
                          MinorInterval="{Binding Path=MinorInterval, ElementName=tickMarkMinor, Mode=OneWay}"/>
                        </gauge:LinearTickSet.Ticks>
                        <gauge:LinearTickSet.Pointers>
                          <!--Bar-->
                          <gauge:LinearPointerBar HasDropShadow="False" ValueChanged="LinearPointer_ValueChanged"
                            CanDrag="{Binding CanDrag, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            Background="{Binding BarColor, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                            PointerAscent="{Binding BarWidth, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" />
                          <!--Pointer-->
                          <gauge:LinearPointerMarker HasDropShadow="False" ValueChanged="LinearPointer_ValueChanged"
                             CanDrag="{Binding CanDrag, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             Visibility="{Binding HasMarker, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             MarkerType="{Binding MarkerType, Converter={StaticResource EnumTypeConverter}, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             PointerExtent="{Binding MarkerHeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             PointerAscent="{Binding MarkerWidth, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             ScalePlacement="{Binding MarkerPlacement, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             ScaleOffset="{Binding MarkerOffset, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             Background="{Binding MarkerColor, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             BorderBrush="{Binding MarkerStroke, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                             BorderWidth="{Binding MarkerBorderThickness, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}" />
                        </gauge:LinearTickSet.Pointers>
                      </gauge:LinearTickSet>
                    </gauge:LinearScale.TickSets>
                  </gauge:LinearScale>
                </gauge:LinearGauge.Scales>

              </gauge:LinearGauge>
              <TextBlock IsHitTestVisible="False"
                FontSize="{Binding Path=EngeneeringUnitFontSettings.FontSize, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                FontWeight="{Binding Path=EngeneeringUnitFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                FontStyle="{Binding Path=EngeneeringUnitFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                FontFamily="{Binding Path=EngeneeringUnitFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                Foreground="{Binding EngeneeringUnitForeground, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                Visibility="{Binding ShowEngeneeringUnit, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                Margin="{Binding EngeneeringOffset, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"/>
              <TextBlock IsHitTestVisible="False"
                 FontSize="{Binding Path=ValueFontSettings.FontSize, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                 FontWeight="{Binding Path=ValueFontSettings.FontWeight, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                 FontStyle="{Binding Path=ValueFontSettings.FontStyle, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                 FontFamily="{Binding Path=ValueFontSettings.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                 Foreground="{Binding ValueForeground, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                 Visibility="{Binding ShowValue, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"
                 Margin="{Binding ValueOffset, RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor}, Mode=OneWay}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </basetype:RangeBaseControl.Style>
  <Grid/>
</basetype:RangeBaseControl>
