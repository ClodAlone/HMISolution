<UserControl x:Class="TempVariablesManager.Controls.ControlEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:TempVariablesManager"
             xmlns:properties="clr-namespace:TempVariablesManager.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/TempVariables.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <utilities:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
    </ResourceDictionary>
  </UserControl.Resources>
    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu">
            <dxb:PopupMenu.Items>

                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewTag}" Content="{x:Static properties:UICommandResource.AddNewTagText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewFolder}" Content="{x:Static properties:UICommandResource.AddNewFolderText}"/>

                <dxb:BarItemLinkSeparator />

                <dxb:BarSubItem Content="{x:Static properties:Resources.EditMenuText}">
                    <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                    <dxb:BarButtonItem Command="Properties" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                </dxb:BarSubItem>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="ApplicationCommands.Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="ApplicationCommands.Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    Executed="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />

        <CommandBinding Command="ApplicationCommands.Redo"
                    Executed="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewTag}" 
                    Executed="OnAddNewTag" 
                    CanExecute="CanAddNewTag" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewFolder}" 
                    Executed="OnAddNewFolder" 
                    CanExecute="CanAddNewFolder" />

        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

    </UserControl.CommandBindings>
    <!--<Grid>
        <ListBox x:Name="listBox" MouseDoubleClick="listBox_MouseDoubleClick"/>
    </Grid>-->
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Toolbar-->
        <dxb:BarContainerControl ContainerType="Top" x:Name="toolbar" Visibility="Collapsed">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" >
                <dxb:BarButtonItem Glyph="{StaticResource OpenFolderSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                        Command="{x:Static self:UIGeneralCommands.AddNewFolder}"/>
                <dxb:BarButtonItem Glyph="{StaticResource TVEditorSmall}" GlyphSize="Custom" CustomGlyphSize="14,14" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                         Command="{x:Static self:UIGeneralCommands.AddNewTag}"/>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <dx:DXTabControl Grid.Row="1" Grid.Column="0" x:Name="tabControlEditorTabControl" Padding="0">
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Bottom" />
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="treeListTab" Header="{x:Static properties:Resources.Hierarchical}">
                <dxg:TreeListControl Name="treeListControl" SelectionMode="Row" SelectionChanged="treeListControl_SelectionChanged">
                    <dxg:TreeListControl.Columns>
                        <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="ItemHeader" Header="{x:Static self:Properties.Resources.ASName}" />
                        <!-- Validate="OnTreeHeaderValidate" -->
                        <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="DataType" Header="{x:Static self:Properties.Resources.ASDataType}" />
                        <dxg:TreeListColumn FilterPopupMode="Excel" FieldName="Description" Header="{x:Static self:Properties.Resources.ASDescription}" />
                    </dxg:TreeListControl.Columns>
                    <dxg:TreeListControl.View>
                        <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
                    ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
                    AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
                    ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
                    IsSynchronizedWithCurrentItem="True" AllowDragDrop="True" AllowSortedDataDragDrop="True" NodeExpanding="OnTreeNodeExpanding"
                    AutoWidth="True" NodeCollapsing="OnTreeNodeCollapsing" NodeChanged="OnTreeNodeChanged" 
                    StartRecordDrag="TreeListControl_DragStart" DropRecord="TreeListControl_DragEnd"
                    CompleteRecordDragDrop="TreeListControl_CompletedDragDrop" RowDoubleClick="OnRowDoubleClick"
                                          NodeExpanded="OnTreeNodeExpanded">
                            <!-- HiddenEditor="OnHiddenEditor" PreviewDragOver="treeListControl_PreviewDragOver" PreviewDrop="treeListControl_PreviewDrop"
                    PreviewQueryContinueDrag="addressSpaceTree_PreviewQueryContinueDrag" DragRecordOver="TreeListControl_DragRecordOver" -->
                            <dxg:TreeListView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                    <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                                </Style>
                            </dxg:TreeListView.RowStyle>
                            <dxg:TreeListView.CellStyle>
                                <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                                  <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                                </Style>
                            </dxg:TreeListView.CellStyle>
                        </dxg:TreeListView>
                    </dxg:TreeListControl.View>
                    <dxg:TreeListControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:TreeListControl.CommandBindings>
                </dxg:TreeListControl>
            </dx:DXTabItem>
            <dx:DXTabItem x:Name="gridControlTab" Header="{x:Static properties:Resources.Flat}">
                <dxg:GridControl MinHeight="10" MinWidth="10"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                Name="gridDataControl" 
                                AutoPopulateColumns="False" 
                                AllowDrop="True" 
                                AllowLiveDataShaping="False" 
                                dx:DXSerializer.SerializationID="gridDataControl" 
                                dx:DXSerializer.StoreLayoutMode="All" 
                                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                    <dxg:GridControl.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Cut"
                                        Executed="OnCommandCut" 
                                        CanExecute="CanCommandCut" />
                        <!--<CommandBinding Command="ApplicationCommands.Delete"
                                        Executed="OnDeleteEvent" 
                                        CanExecute="CanExecuteDelete" />-->
                        <CommandBinding Command="ApplicationCommands.Paste"
                                        Executed="OnCommandPaste" 
                                        CanExecute="CanCommandPaste" />
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        Executed="OnCommandCopy" 
                                        CanExecute="CanCommandCopy" />
                    </dxg:GridControl.CommandBindings>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" FieldName="Name" Header="{x:Static properties:Resources.ASName}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=FolderReadablePath, Mode=OneWay}" FieldName="FolderReadablePath" Header="{x:Static properties:Resources.ASPath}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Description, Mode=OneWay}" FieldName="Description" Header="{x:Static properties:Resources.ASDescription}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=DataType, Mode=OneWay}" FieldName="DataType" Header="{x:Static properties:Resources.ASDataType}"/>
                        <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ModelType, Mode=OneWay}" FieldName="ModelType" Header="{x:Static properties:Resources.ASModel}"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>

                        <dxg:TableView x:Name="tableView" AllowEditing="True"
                            ValidateCell="OnValidateCell" ItemsSourceErrorInfoShowMode="None"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            RowDoubleClick="OnRowDoubleClick" 
                            NavigationStyle="Row" 
                            MultiSelectMode="Row">
                            <!--<dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Style.Triggers>
                                        <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                            <Setter Property="Background" Value="LightGray" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TableView.RowStyle>-->
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
