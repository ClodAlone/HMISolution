<UserControl x:Class="SQLDatabaseConfiguration.TraceExecution"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxwuin="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/navigation"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:local="clr-namespace:SQLDatabaseConfiguration"
             xmlns:converters="clr-namespace:DataReaderEditor.Converters;assembly=DataReaderEditor"
             xmlns:common="clr-namespace:CommonControls;assembly=CommonControls"
             xmlns:properties="clr-namespace:SQLDatabaseConfiguration.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxg:GridControl x:Name="grid" ItemsSource="{Binding TraceMessages}"
                         AllowLiveDataShaping="False" >
            <dxg:GridControl.Columns>
                <dxg:GridColumn x:Name="colTime" AllowBestFit="True"
                                DisplayMemberBinding="{Binding Path=Time, Mode=OneWay}" Header="{x:Static properties:Resources.TraceTimeColumnHeader}" >
                    <dxg:GridColumn.EditSettings>
                        <dxe:DateEditSettings Mask="t" MaskUseAsDisplayFormat="True"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn x:Name="colAction" AllowBestFit="True"
                                DisplayMemberBinding="{Binding Path=Action, Mode=OneWay}" Header="{x:Static properties:Resources.TraceActionColumnHeader}" />
                <dxg:GridColumn x:Name="colMessage" AllowBestFit="True"
                                DisplayMemberBinding="{Binding Path=Message, Mode=OneWay}" Header="{x:Static properties:Resources.TraceMessageColumnHeader}" />
                <dxg:GridColumn x:Name="colResult" AllowBestFit="True"
                                DisplayMemberBinding="{Binding Path=Result, Mode=OneWay}" Header="{x:Static properties:Resources.TraceResultColumnHeader}" />
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" AutoWidth="False" NavigationStyle="Row" 
                               ShowGroupPanel="False" ShowColumnHeaders="True" 
                               AllowColumnMoving="False" AllowEditing="False" AllowSorting="False" 
                               AllowBestFit="True" AllowResizing="True" 
                               ShowHorizontalLines="True" 
                               HorizontalScrollbarVisibility="Auto" VerticalScrollbarVisibility="Auto" />
            </dxg:GridControl.View>
        </dxg:GridControl>

        <common:PS3CircularProgressBar x:Name="busyControl" Visibility="Collapsed" />

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="backButton" VerticalAlignment="Center" MinWidth="100" MinHeight="30" Margin="5" 
                    Content="{x:Static properties:Resources.BackBtnTitle}" />
            <Button VerticalAlignment="Center" MinWidth="100" MinHeight="30" Margin="5"
                    Command="{Binding ClearLog}"
                    Content="{x:Static properties:Resources.ClearLogBtnTitle}" />
        </StackPanel>
    </Grid>
</UserControl>
