    <Setting Name="Add_spDeleteDlData" Type="System.String" Scope="Application">
      <Value Profile="(Default)">CREATE PROCEDURE [dbo].[spDeleteDlData]
@deleteFrom datetime,
@UtcTimeColName nvarchar(max),
@SourceTable nvarchar(max)
AS
Begin 
	SET NOCOUNT ON
	
	if @SourceTable is null 
		set @SourceTable = 'DataLogger'

	declare @tableDay nvarchar(max) = @SourceTable + '_DD'
				 ,@tableHour nvarchar(max) = @SourceTable + '_HH'
				 ,@tableMin nvarchar(max) = @SourceTable + '_MI' 
				 ,@sql nvarchar(max) = ''

	SET DateFirst 1;

	if @UtcTimeColName is null begin  set @UtcTimeColName ='UtcTimeCol' end

	set @sql  = 'delete from ' + @SourceTable  + ' where ' +  @UtcTimeColName + ' &lt; ''' + FORMAT(@deleteFrom, 'yyyy-MM-ddTHH:mm:ss') + ''''
	exec sp_executesql @sql

	set @sql  = 'delete from ' + @tableDay  + ' where ' +  @UtcTimeColName + ' &lt; ''' + FORMAT(dbo.UDF_SetAggregateTime(@deleteFrom,'dd'), 'yyyy-MM-ddTHH:mm:ss') + ''''
	exec sp_executesql @sql
  
	set @sql  = 'delete from ' + @tableHour  + ' where ' +  @UtcTimeColName + ' &lt; ''' + FORMAT(dbo.UDF_SetAggregateTime(@deleteFrom,'hh'), 'yyyy-MM-ddTHH:mm:ss') + ''''
	exec sp_executesql @sql

	set @sql  = 'delete from ' + @tableMin  + ' where ' +  @UtcTimeColName + ' &lt; ''' + FORMAT(dbo.UDF_SetAggregateTime(@deleteFrom,'mi'), 'yyyy-MM-ddTHH:mm:ss') + ''''
	exec sp_executesql @sql
	
	EXEC [dbo].[spAggregateDlDataWithColName]
		@sTablename = N'TableName',
		@EnableMI = 1,
		@EnableHH = 1,
		@EnableDD = 1,
		@UtcTimeColName = N'UtcTimeColName',
		@LocalTimeColName = N'LocalTimeColName',
		@NumericColumnNames = N'NumericColumnNames'
End</Value>
    </Setting>
    <Setting Name="Remove_spDeleteDlData" Type="System.String" Scope="Application">
      <Value Profile="(Default)">IF OBJECT_ID (N'dbo.spDeleteDlData', N'P') IS NOT NULL DROP PROCEDURE [dbo].[spDeleteDlData]</Value>
    </Setting>
  </Settings>
</SettingsFile>