<UserControl x:Class="SQLDatabaseConfiguration.SelectOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxwuin="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/navigation"
             xmlns:local="clr-namespace:SQLDatabaseConfiguration"
             xmlns:selfconverters="clr-namespace:SQLDatabaseConfiguration.Converters"
             xmlns:properties="clr-namespace:SQLDatabaseConfiguration.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <selfconverters:ProjectPathToVisibilityConverter x:Key="ProjectPathToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="5">
            <TextBlock Margin="0,0,0,5" FontStyle="Italic" DockPanel.Dock="Top"
                        Text="{x:Static properties:Resources.SelectProjectFilePath}" />
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="textProjectPath" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                         Validation.ErrorTemplate="{x:Null}" 
                         Text="{Binding ProjectFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                <Button Grid.Column="1" Click="SelectProjectPath_Click" Width="{Binding ActualHeight, ElementName=textProjectPath, Mode=OneWay}">
                    <Button.Content>
                        <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button Grid.Column="2" Click="SelectProjectPath_Clear" Width="{Binding ActualHeight, ElementName=textProjectPath, Mode=OneWay}">
                    <Button.Content>
                        <Image Source="{StaticResource ClearSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <ContentPresenter Grid.Column="3"
                                  Content="{Binding ElementName=textProjectPath, Path=(Validation.Errors).CurrentItem}"/>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="5" 
                   Visibility="{Binding ProjectFilePath, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, 
                                Converter={StaticResource ProjectPathToVisibilityConverter}}" >
            <TextBlock Margin="0,0,0,5" FontStyle="Italic" DockPanel.Dock="Top"
                       Text="{x:Static properties:Resources.EnterProjectPassword}" />
            <PasswordBox x:Name="textProjectPassword" DockPanel.Dock="Bottom" VerticalContentAlignment="Center" />
        </DockPanel>

        <GroupBox Margin="5" Grid.Row="2"
            Header="{x:Static properties:Resources.SelectOperationTypeHeader}" >
            <StackPanel Margin="10">
                <RadioButton Grid.Row="0" x:Name="radioAggregation" Checked="radioAggregation_Checked"
                             Content="{x:Static properties:Resources.AggregationTitle}" IsChecked="True" />
                <RadioButton Grid.Row="1" x:Name="radioPartition" Checked="radioPartition_Checked"
                             Content="{x:Static properties:Resources.PartitionTitle}" IsEnabled="False" />
            </StackPanel>
        </GroupBox>
        
        <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button VerticalAlignment="Center" MinWidth="100" MinHeight="30" Margin="5" 
                Content="{x:Static properties:Resources.CloseBtnTitle}" Click="CloseButton_Click" />
            <Button VerticalAlignment="Center" MinWidth="100" MinHeight="30" Margin="5" x:Name="buttonGo"
                Content="{x:Static properties:Resources.GoBtnTitle}" />
        </StackPanel>
    </Grid>
</UserControl>
