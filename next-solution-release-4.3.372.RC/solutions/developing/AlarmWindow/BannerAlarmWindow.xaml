<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
             x:Class="AlarmWindow.BannerAlarmWindow" 
             xmlns:properties="clr-namespace:AlarmWindow.Properties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:userlocal="clr-namespace:AlarmWindow.Converters"
             xmlns:local="clr-namespace:AlarmWindow"
             Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             Foreground="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
             mc:Ignorable="d" Height="25.666" Width="159.667">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>                
                <ResourceDictionary Source="Spin\UpArrow.xaml" />
                <ResourceDictionary Source="Spin\DownArrow.xaml" />
                <ResourceDictionary Source="Spin\RefreshButton.xaml" />
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/AlarmWindow.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <userlocal:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <userlocal:HorizontalToAlignementConverter x:Key="HorizontalToAlignementConverter" />
            <userlocal:SpinOrientationToRotation x:Key="SpinOrientationToRotation" />
            <userlocal:SpinDimensionToWidthConverter x:Key="SpinDimensionToWidthConverter" />
            <userlocal:SpinRelativePositionToDock x:Key="SpinRelativePositionToDock" />
            <userlocal:SeverityToThresholdValueConverter x:Key="SeverityToThresholdValueConverter" />
            <userlocal:SeverityToThresholdForegroundValueConverter x:Key="SeverityToThresholdForegroundValueConverter" />
            <userlocal:ActualWidthToSpinButtonWidthConvertercs x:Key="ActualWidthToSpinButtonWidthConvertercs" />
            <userlocal:ThresholdToIconConverter x:Key="ThresholdToIconConverter" />
            <!--<local:ColorToBackgroundConverter x:Key="ColorToBackgroundConverter" />-->

            <!--<Style TargetType="{x:Type ListView}" x:Key="AlarmBindTag">
                <Setter Property="ItemsSource" Value="{Binding ConditionStateList}" />
            </Style>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" HorizontalAlignment="Stretch" x:Name="mainDock"
      VerticalAlignment="Stretch">
        <DockPanel.Width>
            <MultiBinding Converter="{StaticResource ActualWidthToSpinButtonWidthConvertercs}" Mode="OneWay">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" Mode="OneWay"></Binding>
                <Binding Path="BorderThickness" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" Mode="OneWay"></Binding>
            </MultiBinding>
        </DockPanel.Width>
     <Viewbox MaxWidth="25" OverridesDefaultStyle="True"
                 Stretch="Fill" x:Name="viewboxSpin"
                 Height="Auto" Margin="1,1,1,1"
                 Width="25"
                 DockPanel.Dock="Right">
            <StackPanel Orientation="Vertical">
                <RepeatButton MinWidth="15" MinHeight="15" ToolTipService.ShowOnDisabled="True" 
        				Margin="0" Click="nextalarmButton_Click_1"
        				x:Name="nextalarmButton" Style="{StaticResource UpArrow}" />
                <RepeatButton Click="prevalarmButton_Click_1" 
                        MinWidth="15" MinHeight="15" ToolTipService.ShowOnDisabled="True" 
        				x:Name="prevalarmButton" Margin="0" Style="{StaticResource DownArrow}" />
            </StackPanel>
        </Viewbox>
    <Viewbox OverridesDefaultStyle="True"
             Stretch="Uniform" x:Name="viewboxRefresh"
             Height="Auto" Margin="1,1,1,1"
                 >
      <Button ToolTip="{x:Static properties:Resources.RefreshCmd}"
      x:Name="refreshButton" ToolTipService.ShowOnDisabled="True" Background="{Binding Background, ElementName=nextalarmButton}"
              Command="{Binding RefreshCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
              Style="{StaticResource RefreshButton}">
      </Button>
    </Viewbox>
    <Border Margin="0,2,0,2" x:Name="AlarmBackgroundBorder" BorderBrush="Transparent" Background="Transparent" BorderThickness="0">
            <Grid>
                <TextBox Margin="0" x:Name="alarmBlink" BorderBrush="{x:Null}" BorderThickness="0" IsReadOnly="True"
                Background="Transparent">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="TextBox.Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=NeedsAcknoledge}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="Stop">
                                                <ColorAnimation Storyboard.TargetProperty="(TextBox.Background).(SolidColorBrush.Color)"
                                                    From="Transparent" To="Red" Duration="0:0:1.0"
                                                    AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="Stop">
                                                <ColorAnimation Storyboard.TargetProperty="(TextBox.Background).(SolidColorBrush.Color)"
                                                    To="Transparent" Duration="0:0:0.5"
                                                    AutoReverse="False" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding IconWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="CellImage" 
                        Grid.Column="0"
                        Grid.ColumnSpan="1"               
                        Grid.RowSpan="1"               
                        Stretch="Uniform" 
                        StretchDirection="DownOnly" 
                        MaxHeight="{Binding ElementName=grid, Path=ActualHeight}">
                    </Image>
                    <TextBox Grid.Column="1" Margin="0" x:Name="alarmText" BorderBrush="{x:Null}" BorderThickness="0" IsReadOnly="True"
                        FontFamily="{Binding AlarmAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        FontSize="{Binding AlarmAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        FontWeight="{Binding AlarmAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        FontStyle="{Binding AlarmAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        VerticalContentAlignment="{Binding VerticalAlignment, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        TextAlignment="{Binding HorizontalContentAlignment, Converter={StaticResource HorizontalToAlignementConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        TextWrapping="{Binding TextWrapping, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Hidden" Background="Transparent">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="TextBox.Background" Value="Transparent" />
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                Text="{x:Static properties:Resources.NotConnected}" FontSize="22" x:Name="statusText" />
            </Grid>
        </Border>
  </DockPanel>
</UserControl>

