<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
             x:Class="AlarmWindow.GridAlarmWindow" 
             xmlns:properties="clr-namespace:AlarmWindow.Properties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:OPCUAViewModel="clr-namespace:OPCUAViewModel;assembly=OPCUAViewModel"
             xmlns:userlocal="clr-namespace:AlarmWindow.Converters"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dxet="clr-namespace:DevExpress.Xpf.Editors.Themes;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" Height="835" Width="865">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/AlarmWindow.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <utilities:QualityToStringConverter x:Key="qualityToStringConverter" x:Shared="True" />
            <userlocal:ThresholdToIconConverter x:Key="ThresholdToIconConverter" />
            <userlocal:RowHeightConverter x:Key="RowHeightConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="childsStatus" Header="{x:Static properties:Resources.ChildsStatus}" Visibility="Collapsed" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <DockPanel LastChildFill="True" x:Name="container">
        <DockPanel.Resources>
            <userlocal:CommandPositionToOrientationConverter x:Key="ButtonOrientationConverter" />
            <userlocal:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <userlocal:BooleanToValueConverter x:Key="BooleanToValueConverter" />
            <userlocal:TitleToVisibilityCoverter x:Key="TitleToVisibilityCoverter" />


            <userlocal:BooleanToInvertionVisibilityConverter x:Key="BooleanToInvertionVisibilityConverter" />
            <userlocal:DateTimeConverter x:Key="DateTimeConverter" />
            <userlocal:TimeSpanToDateTimeConverter x:Key="TimeSpanToDateTimeConverter" />


            <userlocal:SeverityToThresholdValueConverter x:Key="SeverityToThresholdValueConverter" />
            <userlocal:SeverityToThresholdForegroundValueConverter x:Key="SeverityToThresholdForegroundValueConverter" />
            <userlocal:ColorToBackgroundConverter x:Key="ColorToBackgroundConverter" />
            <userlocal:LocalizedTextToStringConverter x:Key="LocalizedTextToStringConverter" />

            <userlocal:DimensionToMinHeightConverter x:Key="DimensionToMinHeightConverter" />
            <userlocal:DimensionToMinWidthConverter x:Key="DimensionToMinWidthConverter" />
            <userlocal:DimensionToImageDimensionConverter x:Key="DimensionToImageDimensionConverter" />
            <userlocal:QualityToBooleanConverter x:Key="QualityToBooleanConverter" />
            <userlocal:BooleanToDefaultBooleanConverter x:Key="BooleanToDefaultBooleanConverter" />

            <userlocal:StateConverter x:Key="StateConverter" />
            <userlocal:MessageConverter x:Key="MessageConverter" />


            <!-- ***********************COMANDI********************************* -->
            <Style TargetType="{x:Type Button}" x:Key="ButtonRowCommandStyle">
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <Style TargetType="{x:Type ToggleButton}" x:Key="ToggleButtonRowCommandStyle">
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="ButtonStyle">
                <Setter Property="Command" Value="{Binding RefreshCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="ButtonAckAllStyle">
                <Setter Property="Command" Value="{Binding AckAllCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="ButtonResAllStyle">
                <Setter Property="Command" Value="{Binding ConditionConfirmAllCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>

            <!--<Style TargetType="{x:Type dxg:GridControl}" x:Key="AlarmBind">
            <Setter Property="ItemsSource" Value="{Binding ConditionStateList}" />
        </Style>-->

            <Style TargetType="{x:Type ToggleButton}" x:Key="ToggleStyle">
                <Setter Property="Command" Value="{Binding DisableSoundCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <Setter Property="Foreground" Value="{Binding Foreground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </Style>
            <!-- *************************************************************** -->

        </DockPanel.Resources>

        <dxb:BarContainerControl DockPanel.Dock="Top" x:Name="toolbartray" ContainerType="Top">
            <dxb:ToolBarControl UseWholeRow="True" IsMultiLine="False" ShowDragWidget="False" dxb:MergingProperties.Name="mainGridAlarmToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" x:Name="toolBarControl"
                                AllowCustomizationMenu="False" AllowQuickCustomization="False">
                <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                    <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                    EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                      <dxb:BarEditItem.EditTemplate>
                        <DataTemplate>
                          <dxe:ComboBoxEdit
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                          Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                        </DataTemplate>
                      </dxb:BarEditItem.EditTemplate>
                    </dxb:BarEditItem>
                    <dxb:BarButtonItem x:Name="clearSmall" Glyph="{StaticResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem x:Name="saveSmall" Glyph="{StaticResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />
                </dxb:BarLinkContainerItem>
                <!-- commands -->
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit" ToolTipService.ShowOnDisabled="True"
                                        IsVisible="{Binding ShowBestFitButton, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <dxb:BarItemSeparator IsVisible="{Binding ShowExpandCollapseButtons, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <dxb:BarButtonItem GlyphSize="Custom" CustomGlyphSize="16,16" IsVisible="{Binding ShowExpandCollapseButtons, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                            x:Name="ButtonExpandAll"
                            Content="{x:Static properties:Resources.ExpandAll}" ItemClick="ButtonExpand_Click" />
                <dxb:BarButtonItem GlyphSize="Custom" CustomGlyphSize="16,16" IsVisible="{Binding ShowExpandCollapseButtons, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                            />
                <dxb:BarButtonItem GlyphSize="Custom" CustomGlyphSize="16,16" IsVisible="{Binding ShowExpandCollapseButtons, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                            x:Name="ButtonCollapseAll"
                            Content="{x:Static properties:Resources.CollapseAll}" ItemClick="ButtonCollapse_Click" />
                <dxb:BarItemSeparator IsVisible="{Binding ShowUshelvedAlaramsButton, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <dxb:BarCheckItem GlyphSize="Custom" CustomGlyphSize="16,16" IsVisible="{Binding ShowUshelvedAlaramsButton, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        x:Name="ButtonUnsvelved" Content="{x:Static properties:Resources.Unshelved}" ItemClick="ButtonUnsvelved_OnClick" />
                <!-- server -->
                <dxb:BarStaticItem ShowBorder="False" x:Name="servertitle" Content="{x:Static properties:Resources.ServerTitle}" 
                                       IsVisible="{Binding ShowServerTitle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <dxb:BarStaticItem ShowBorder="False" x:Name="title" 
                                       IsVisible="{Binding ShowServerTitle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <!-- status -->
                <dxb:BarStaticItem ShowBorder="False" x:Name="qualitytitle" Content="{x:Static properties:Resources.Quality}" 
                                       IsVisible="{Binding ShowQualityStatus, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                <dxb:BarStaticItem ShowBorder="False" x:Name="quality" Content="{Binding Quality, Mode=OneWay}" 
                                       IsVisible="{Binding ShowQualityStatus, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <!--<Label DockPanel.Dock="Top" Content="{Binding Title}" Background="{DynamicResource TableViewBackgroundAreaColor}" HorizontalAlignment="Stretch"/>-->
        <Grid DockPanel.Dock="{Binding SpecificCommandPosition, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                 Height="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                 x:Name="horizontalPanel" Visibility="Collapsed">
            <!--<Border BorderThickness="1" Grid.ColumnSpan="5" Background="{DynamicResource TableViewBackgroundAreaColor}" BorderBrush="#FF515151" >-->
            <Grid Margin="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding AckAllCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding ConfirmAllCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />

                    <ColumnDefinition Width="{Binding AckCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding ConfirmCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding AddCommentCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding ExecuteCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding ShelveCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding ShelveCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding ShelveCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding RefreshCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="{Binding SoundCmdButton, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <!--<ColumnDefinition Width="{Binding AuthomaticColumnLayout, 
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}},
                                    Converter={StaticResource BooleanToValueConverter}}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />-->
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ackAllBtn"
                            MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        Visibility="{Binding AckAllCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                            ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.AckAllCmd}"
					         
                        Command="{Binding AckAllCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonAckAllStyle}" Tag="ButtonAckAllStyle">
                    <StackPanel>
                        <TextBlock x:Name="ackAllBtnText" Text="{x:Static properties:Resources.AckAllCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWAcknowledgeAll}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" x:Name="confirmAllBtn"
                            MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        Visibility="{Binding ConfirmAllCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                            ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ConfirmAllCmd}"
					         
                        Command="{Binding ConditionConfirmAllCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonResAllStyle}" Tag="ButtonResAllStyle">
                    <StackPanel>
                        <TextBlock x:Name="confirmAllBtnText" Text="{x:Static properties:Resources.ConfirmAllCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWConfirm2}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ack" Grid.Column="2"
                                    Command="{Binding Path=AcknowledgeCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonRowCommandStyle}"  
                                    MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.AckCmd}"
    					            Visibility="{Binding AckCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    <StackPanel>
                        <TextBlock x:Name="ack_Text" Text="{x:Static properties:Resources.AckCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWAcknowledge}" />
                    </StackPanel>
                </Button>
                <Button x:Name="reset" Grid.Column="3"
                                    Command="{Binding Path=ConfirmCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonRowCommandStyle}"  
                                    MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ConfirmCmd}"
    					            Visibility="{Binding ConfirmCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                    <StackPanel>
                        <TextBlock x:Name="reset_Text" Text="{x:Static properties:Resources.ConfirmCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWConfirm}" />
                    </StackPanel>
                </Button>
                <Button x:Name="comment" Grid.Column="4" 
                                    Command="{Binding AddAlarmComment, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonRowCommandStyle}"  
                                    MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        Visibility="{Binding AddCommentCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                               ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.AddCommentCmd}">
                    <StackPanel>
                        <TextBlock x:Name="comment_Text" Text="{x:Static properties:Resources.AddCommentCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWAddComment}" />
                    </StackPanel>
                </Button>
                <Button x:Name="command" Grid.Column="5" 
                                    Command="{Binding ExecuteAlarmCommands, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonRowCommandStyle}"  
                                    MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        Visibility="{Binding ExecuteCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ExecuteComandsCmd}">
                    <StackPanel>
                        <TextBlock x:Name="command_Text" Text="{x:Static properties:Resources.ExecuteComandsCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWExecuteCommand}" />
                    </StackPanel>
                </Button>
                <Button x:Name="shelve" Grid.Column="6"
                                    Command="{Binding Path=ShelveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Style="{StaticResource ButtonRowCommandStyle}"  
                                    MinWidth="16"
                            MinHeight="{Binding CommandDimension, Converter={StaticResource DimensionToMinHeightConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
					        Visibility="{Binding ShelveCmdButton, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                               ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ShelveCmd}"
                                   >
                    <StackPanel>
                        <TextBlock x:Name="shelve_Text" Text="{x:Static properties:Resources.ShelveCmd}" Background="{x:Null}" 
                            Visibility="{Binding UseIcon, Converter={StaticResource BooleanToInvertionVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Image Visibility="{Binding UseIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Width="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                               Height="{Binding CommandDimension, Converter={StaticResource DimensionToImageDimensionConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                               Source="{StaticResource AWShelve}" />
                    </StackPanel>
                </Button>
                <dxe:TextEdit x:Name="shelve_Time" Grid.Column="7" DataContext="{Binding Path=View.FocusedRowData.Row, ElementName=gridControl}"
                                          EditValue="{Binding Path=ShelvingTime, Converter={StaticResource TimeSpanToDateTimeConverter}, ConverterParameter=TotalMilliseconds, UpdateSourceTrigger=PropertyChanged}"   
                                     Text="00:00:00" Margin="0"
                                     MaskType="DateTimeAdvancingCaret" Mask="HH:mm:ss" MaskUseAsDisplayFormat="True"
                                     MinWidth="60" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ShelveTime}"
