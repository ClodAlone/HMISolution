                                               TextWrapping="{Binding TextWrapping, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                               Text="{Binding Data.Parent.Parent.Parent.Title }"  
                                               HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource TitleToVisibilityCoverter}">
                                                <Binding Path="Data.Parent.Parent.Parent.Title" />
                                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}" Path="Title" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <!--ShowGroupPanel="{Binding ShowGroupPanel, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"-->
                    <dxg:TableView x:Name="view" AutoWidth="False" AllowEditing="False" 
                        WheelScrollLines="0.1"
                        FadeSelectionOnLostFocus="False" 
                        AllowColumnMoving="{Binding AllowDropColumns, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        AllowDrop="{Binding AllowDropColumns, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="{Binding AuthomaticColumnLayout, Mode=OneWay, Converter={StaticResource BooleanToDefaultBooleanConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        AllowResizing="{Binding AllowResizing, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        ShowSearchPanelMode="Always" SearchPanelFindMode="Always" ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" ShowFilterPopup="TableView_ShowFilterPopup"
                        MultiSelectMode="Row"
                        VerticalScrollbarVisibility="Auto"
                        HorizontalScrollbarVisibility="Auto">

                        <!--ValidateRow="TableView_ValidateRow" InvalidRowException="TableView_InvalidRowException"
                        CellValueChanging="TableView_CellValueChanging"
                        CellValueChanged="TableView_CellValueChanged"-->

                        <dxg:TableView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Setter Property="Foreground">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource 
                                                    SeverityToThresholdForegroundValueConverter}">
                                            <Binding Path="DataContext.Severity" />
                                            <Binding Path="Thresholds" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" />
                                            <Binding Path="DataContext.NeedsAcknoledge" />
                                            <Binding Path="DataContext.EnabledState" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="TextBlock.FontFamily" Value="{Binding AlarmAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontSize" Value="{Binding AlarmAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontWeight" Value="{Binding AlarmAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontStyle" Value="{Binding AlarmAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <!--<Setter Property="Height" Value="{Binding RowHeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource RowHeightConverter}}"></Setter>-->
                                <Setter Property="Height" >
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource RowHeightConverter}" Mode="TwoWay">
                                            <Binding Path="RowHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Mode="OneWay" />
                                            <Binding Path="AlarmAreaFontSettings.FontSize" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}" Mode="OneWay" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource 
                                                    SeverityToThresholdValueConverter}">
                                            <Binding Path="DataContext.Severity" />
                                            <Binding Path="Thresholds" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                            <Binding Path="DataContext.NeedsAcknoledge" />
                                            <Binding Path="DataContext.EnabledState" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </dxg:TableView.RowStyle>
                    </dxg:TableView>
                </dxg:GridControl.View>

            </dxg:GridControl>

            <TextBlock Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.25"
                       Text="{x:Static properties:Resources.NotConnected}" FontSize="22" x:Name="statusText" />
        </Grid>
    </DockPanel>

</UserControl>

