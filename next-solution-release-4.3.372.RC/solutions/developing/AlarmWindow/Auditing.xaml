<UserControl x:Class="AlarmWindow.Auditing"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"  
             xmlns:properties="clr-namespace:AlarmWindow.Properties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:OPCUAViewModel="clr-namespace:OPCUAViewModel;assembly=OPCUAViewModel"
             xmlns:userlocal="clr-namespace:AlarmWindow.Converters"
             xmlns:local="clr-namespace:AlarmWindow"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
			 xmlns:dxet="clr-namespace:DevExpress.Xpf.Editors.Themes;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dgc="clr-namespace:AlarmWindow"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" Height="835" Width="865">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel x:Name="view" LastChildFill="True">
        <DockPanel.Resources>
           
        </DockPanel.Resources>

        <dxb:BarContainerControl DockPanel.Dock="Top" x:Name="toolbartray" ContainerType="Top">
            <dxb:ToolBarControl UseWholeRow="True" IsMultiLine="False" ShowDragWidget="False" dxb:MergingProperties.Name="mainAuditToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False"
                                AllowCustomizationMenu="False" AllowQuickCustomization="False"
                                Visibility="{Binding AllowRuntimeChanges, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                  <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                        <dxe:ComboBoxEdit 
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>

                    <dxb:BarButtonItem x:Name="clearSmall" Glyph="{StaticResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem x:Name="saveSmall" Glyph="{StaticResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16"
                                       Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                                       ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}">
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />
                </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit" ToolTipService.ShowOnDisabled="True" />
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>

        <Button MinHeight="40" DockPanel.Dock="Bottom" x:Name="ButtonRefresh" Content="{x:Static properties:Resources.Refresh}" Command="{Binding RefreshCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
        <Grid>
            <dxg:GridControl Grid.Row="1" MinHeight="10" MinWidth="10" Visibility="Visible"
                             Tag="DataSourceStyle" 
                             AllowDrop="{Binding AllowDropColumns, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                             Name="gridView"
                             AllowLiveDataShaping="True">
                <dxg:GridControl.Resources>
                    <Style TargetType="{x:Type dxg:BaseGridHeader}">
                        <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    </Style>
                    <Style x:Key="columnStyle" BasedOn="{StaticResource {x:Type dxg:BaseGridHeader}}" TargetType="{x:Type dxg:BaseGridHeader}">
                        <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                    </Style>
                    <remoteconverters:UTCToLocalConverterWithClientOffset x:Key="UTCToLocalConverterWithClientOffset" />
                    <ControlTemplate x:Key="borderTemplate" TargetType="{x:Type ContentControl}">
                        <Border BorderThickness="0" CornerRadius="0" 
		                    Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:TextEdit}}}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                    <Style BasedOn="{StaticResource {dxet:TextEditThemeKey ResourceKey=TextStyle}}" TargetType="{x:Type TextBox}">
                        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type dxe:TextEdit}}}" />
                    </Style>
                    <dxe:TextEditSettings x:Key="dateSettings" MaskType="DateTime" Mask="G" />
                </dxg:GridControl.Resources>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowSearchPanel="True" x:Name="Col1" Header="{x:Static properties:Resources.State}" FieldName="EnabledState" Width="50" />
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowSearchPanel="True" x:Name="Col2" Header="{x:Static properties:Resources.Source}" FieldName="Source" Width="50" />
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowSearchPanel="True" x:Name="Col3" Header="{x:Static properties:Resources.Type}" FieldName="Type" Width="50" />
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowSearchPanel="True" x:Name="Col4" Header="{x:Static properties:Resources.Method}" FieldName="Method" DisplayMemberBinding="{Binding Path=Method}" Width="50" />
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowSearchPanel="True" x:Name="Col5" EditSettings="{StaticResource dateSettings}" Header="{x:Static properties:Resources.Time}" FieldName="Time" Width="100">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="2,2,2,2" TextWrapping="WrapWithOverflow">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource 
                                                    UTCToLocalConverterWithClientOffset}" Mode="OneWay">
                                                <Binding Path="Data.Time" />
                                                <Binding Path="ClientTimezoneOffset" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                                <Binding Path="RunningOnServer" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                                <Binding Path="CurrentCulture" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowSearchPanel="True" x:Name="Col6" Header="{x:Static properties:Resources.Message}" FieldName="Message" Width="190" />
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView"    
                        AutoWidth="False" AllowEditing="False"
                        FadeSelectionOnLostFocus="False" 
                        AllowColumnMoving="{Binding AllowDropColumns, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        AllowDrop="{Binding AllowDropColumns, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True" ShowGroupPanel="False"
                        ShowSearchPanelMode="Never" SearchPanelFindMode="Always" ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row"
                        VerticalScrollbarVisibility="Auto"
                        HorizontalScrollbarVisibility="Auto">
                        <dxg:TableView.RowStyle>
                            <!--<Style BasedOn="{StaticResource {dxgt:GridRowThemeKey 
                                ResourceKey=RowStyle}}" TargetType="{x:Type dxg:GridRowContent}">-->
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Setter Property="TextBlock.FontFamily" Value="{Binding AlarmAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontSize" Value="{Binding AlarmAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontWeight" Value="{Binding AlarmAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.FontStyle" Value="{Binding AlarmAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <Setter Property="TextBlock.Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                <!--<Style.Triggers>
                                    <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                        <Setter Property="Background" Value="LightGray" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                </Style.Triggers>-->
                            </Style>
                        </dxg:TableView.RowStyle>
                    </dxg:TableView>

                </dxg:GridControl.View>
            </dxg:GridControl>
            <TextBlock Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="{x:Static properties:Resources.NotConnected}" FontSize="22" x:Name="statusText" />
        </Grid>
    </DockPanel>
</UserControl>
