<project outputDir="..\Release\Confused" snKey="" xmlns="http://confuser.codeplex.com">
  <settings name="settings1">
    <confusion id="anti debug" />
    <confusion id="anti ildasm" />
    <confusion id="const encrypt" />
    <confusion id="ctor proxy" />
    <confusion id="mtd proxy" />
    <confusion id="rename" />
    <confusion id="res encrypt" />
  </settings>
  <settings name="settings2">
    <confusion id="anti ildasm" />
    <confusion id="const encrypt" />
    <confusion id="rename" />
  </settings>
  <settings name="settings3">
    <confusion id="anti ildasm" />
    <confusion id="const encrypt" />
    <confusion id="rename" />
    <confusion id="anti debug" />
    <confusion id="anti dump" />
    <confusion id="anti tamper" />
    <confusion id="ctor proxy" />
    <confusion id="ctrl flow" />
    <confusion id="invalid md" />
    <confusion id="mtd proxy" />
    <confusion id="reduce md" />
    <confusion id="res encrypt" />
  </settings>
  <settings name="settings4">
    <confusion id="anti ildasm" />
    <confusion id="const encrypt" />
    <confusion id="rename" />
    <confusion id="anti debug" />
    <confusion id="ctor proxy" />
    <confusion id="mtd proxy" />
    <confusion id="res encrypt" />
  </settings>
  <assembly path="..\Release\MSZFactory.dll">
    <config id="settings1" />
    <module name="MSZFactory.dll">
      <config id="settings2" applytomembers="true" />
      <type fullname="WPFUtilities.CryptString.CryptString">
        <config id="settings3" applytomembers="true" />
      </type>
      <type fullname="WPFUtilities.CryptString.X509Certificate2_Cryptographer">
        <config id="settings3" applytomembers="true" />
      </type>
      <type fullname="MSZFactory.Craddle">
        <config id="settings4" applytomembers="true" />
      </type>
      <type fullname="&lt;Module&gt;">
        <config id="settings4" />
      </type>
    </module>
  </assembly>
</project>