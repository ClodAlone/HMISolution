<Window x:Class="MSZUtils.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
        xmlns:properties="clr-namespace:MSZUtils.Properties"
        xmlns:cc="http://progea.com/CommonControls"
        xmlns:local="clr-namespace:MSZUtils" WindowState="Maximized"
        xmlns:localconverters="clr-namespace:MSZUtils.Converters" 
        xmlns:helpers="clr-namespace:MSZUtilsServiceHelper;assembly=MSZUtilsServiceHelper"
        xmlns:converter="clr-namespace:Converters;assembly=Converters"
        xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
        Title="{x:Static properties:Resources.AppMainTitle}" Height="1024" Width="1600">
    <!--Background="#FF2D2D2D"-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
                <ResourceDictionary Source="Resources\Dictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
          <localconverters:ValueToDateTimeConverter x:Key="ValueToDateTimeConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.ShowLicences}" Executed="OnShowLicences"  />
        <CommandBinding Command="{x:Static local:MainWindow.ShowCustomers}" Executed="OnShowCustomers"  />
        <CommandBinding Command="{x:Static local:MainWindow.ReadLicense}" Executed="OnReadLicense"  />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:MainWindow.ShowLicences}" Key="L" Modifiers="ALT"/>
        <KeyBinding Command="{x:Static local:MainWindow.ShowCustomers}" Key="C" Modifiers="ALT"/>
        <KeyBinding Command="{x:Static local:MainWindow.ReadLicense}" Key="S" Modifiers="ALT"/>
    </Window.InputBindings>
    <Grid>
        <Border>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35*"/>
                    <RowDefinition Height="140*"/>
                    <RowDefinition Height="296*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Customer selection-->
                    <StackPanel>
                        <TextBlock FontSize="16" TextWrapping="Wrap" Text="{x:Static properties:Resources.Customer}" Background="Transparent" Margin="33,0" />
                        <dxe:ComboBoxEdit FontSize="14"
                    x:Name="customers" Grid.Row="1" Margin="33,4" TextSearch.TextPath="Name"
                    IsCaseSensitiveSearch="False" IsSynchronizedWithCurrentItem="False" DisplayMember="Name"
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
                            <dxe:ComboBoxEdit.ItemTemplate>
                                <DataTemplate DataType="{x:Type helpers:Customer}" >
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Stretch" TextAlignment="Justify" Text="{Binding Name}" Background="Transparent"/>
                                </DataTemplate>
                            </dxe:ComboBoxEdit.ItemTemplate>
                        </dxe:ComboBoxEdit>

                    </StackPanel>
                    <!-- LicenceType selection-->
                    <!--
                    <StackPanel Grid.Row="1">
                        <TextBlock FontSize="16" Grid.Column="2" TextWrapping="Wrap" Text="{x:Static properties:Resources.LicenceType}" Background="Transparent" Margin="33,0" />
                        <DockPanel Grid.Column="1"  Grid.Row="1" LastChildFill="True"  Margin="33,4">
                            <Button Margin="0,0" FontSize="16" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.ApplyOptions}" Click="LoadOptionsOnPanel" 
                                    Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Left">
                                <Image Source="{StaticResource ReloadSmall}" x:Name="reloadImage" Stretch="Uniform"/>
                            </Button>
                            <Button Margin="10,0" FontSize="16" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.MergeOptions}" 
                                    Click="MergeOptionOnPanel" Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Left">
                                <Image Source="{StaticResource AddNewSmall}" x:Name="addnewImage"  Stretch="Uniform"/>
                            </Button>
                            <dxe:ComboBoxEdit FontSize="14"
                    x:Name="licencetype" Grid.Row="2" TextSearch.TextPath="Name"
                    IsCaseSensitiveSearch="False" IsSynchronizedWithCurrentItem="False" DisplayMember="Name"
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
                                <dxe:ComboBoxEdit.ItemTemplate>
                                    <DataTemplate DataType="{x:Type helpers:LicenceType}" >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="2,2,0,2" Grid.Column="1"  HorizontalAlignment="Stretch" Text="{Binding Name}" Background="Transparent"/>
                                            <TextBlock Margin="10,2,2,2" Grid.Column="1"  HorizontalAlignment="Stretch" Text="{Binding Description}" Background="Transparent"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </dxe:ComboBoxEdit.ItemTemplate>
                            </dxe:ComboBoxEdit>
                        </DockPanel>
                    </StackPanel>-->
                </Grid>
                <DockPanel Grid.Column="1" Grid.Row="0" LastChildFill="True" HorizontalAlignment="Stretch">
                  <!-- Logo-->
                  <Image Stretch="Uniform" HorizontalAlignment="Stretch" DockPanel.Dock="Right" Source="Images\AboutLogo.png" Width="164" Margin="0,0,0,-2"/>
                    <Grid Margin="1,1,5,1" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45*"/>
                            <ColumnDefinition Width="109*"/>
                            <ColumnDefinition Width="154*"/>
                        </Grid.ColumnDefinitions>
                        <!-- ProjectType selection-->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="{x:Static properties:Resources.MovApp}" Background="Transparent"  HorizontalAlignment="Left"  />
                                <RadioButton GroupName="AppName" x:Name="MovApp" IsChecked="True" Content="" 
                              Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" Margin="0,8"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Grid.Column="5" Text="{x:Static properties:Resources.MovTrace}" Background="Transparent"  HorizontalAlignment="Left"  />
                                <RadioButton GroupName="AppName" x:Name="MovTrace" Grid.Row="1" Grid.Column="5" Content="" 
                              Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="17" Height="30" Margin="0,8" IsEnabled="False"/>

                            </StackPanel>
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Grid.Column="6" Text="{x:Static properties:Resources.MovBA}" Background="Transparent"  HorizontalAlignment="Left"  />
                                <RadioButton GroupName="AppName" x:Name="MovBa" Grid.Row="1" Grid.Column="6" Content="" 
                              Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="17" Height="30" Margin="0,8" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                        <Button ToolTip="{x:Static properties:Resources.ReInitDatas}" Click="ReloadAndInitValues" Grid.Column="0"
                        Margin="0,0,0,-1" Width="70" HorizontalAlignment="Left" Style="{StaticResource RefreshButton}"/>
                        <Button ToolTip="{x:Static properties:Resources.LogOffUser}" Click="LogOffUser" Grid.Column="1"
                        Margin="0,0,0,-1" Width="70" HorizontalAlignment="Left">
                            <Image Source="Images\User-Login.png" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </DockPanel>
                <Grid Grid.Column="1" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                  <!-- Build-->
                  <TextBlock Margin="0,0,11,0" Grid.Column="2" HorizontalAlignment="Right" Text="0.0.000.0"
                             VerticalAlignment="Top" x:Name="mainBuild"/>

                  <DockPanel Margin="10,2" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock FontSize="16" DockPanel.Dock="Top" TextWrapping="Wrap" Text="{x:Static properties:Resources.ExpiringDate}" Background="Transparent" VerticalAlignment="Bottom"  />

                        <Button  Margin="5,0" FontSize="16" Tag="6" DockPanel.Dock="Right" Click="SetCalendar" MinHeight="30" MinWidth="100">
                            <TextBlock Text="{x:Static properties:Resources.Set6Monthes}" TextWrapping="Wrap"/>
                        </Button>
                        <Button  Margin="5,0" FontSize="16" Tag="12" DockPanel.Dock="Right" Click="SetCalendar" MinHeight="30" MinWidth="100">
                            <TextBlock Text="{x:Static properties:Resources.Set12Monthes}" TextWrapping="Wrap"/>
                        </Button>
                        <CheckBox  Margin="5,0" FontSize="16" x:Name="Unlimited" IsChecked="True" Grid.Row="1" Grid.Column="2" 
                              Click="Unlimited_Click" Content="{x:Static properties:Resources.UnlimitedOption}" DockPanel.Dock="Right"
                              Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <dxe:DateEdit FontSize="14" x:Name="dateTimePicker1" IsEnabled="{Binding ElementName=Unlimited,Path=IsChecked, Converter={StaticResource InverseBooleanConverter}}"           
                        Validation.ErrorTemplate="{x:Null}"  HorizontalAlignment="Left"
                        MaskType="DateTime" Mask="D" Width="190" Height="25"
                        MaskCulture="{x:Static glob:CultureInfo.CurrentCulture}"
                        MaskUseAsDisplayFormat="True" MaxValue="{Binding Converter={StaticResource ValueToDateTimeConverter}}"
                        ShowClearButton="False"
                        ShowToday="True"
                        ShowWeekNumbers="True"/>
                    </DockPanel>
                    <DockPanel Visibility="Collapsed" Margin="10,2" Grid.Column="1" Grid.Row="0" LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock FontSize="16" DockPanel.Dock="Top" TextWrapping="Wrap" Text="{x:Static properties:Resources.Theme}" Background="Transparent" VerticalAlignment="Bottom"  />
                        <dxe:ComboBoxEdit FontSize="14" HorizontalAlignment="Left" Width="190" Height="25"
                x:Name="themeKeeper" Grid.Row="1" SelectedIndexChanged="themeKeeper_SelectedIndexChanged"
                IsCaseSensitiveSearch="False" IsSynchronizedWithCurrentItem="False" 
                ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
                            <dxe:ComboBoxEdit.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Stretch" TextAlignment="Justify" Text="{Binding}" Background="Transparent"/>
                                </DataTemplate>
                            </dxe:ComboBoxEdit.ItemTemplate>
                        </dxe:ComboBoxEdit>
                    </DockPanel>
                    <Button FontSize="16" x:Name="btn6" Grid.Column="0" 
                            Grid.Row="1" Margin="10,2" Click="ReadDBLicense_Click">
                        <TextBlock x:Name="btnReadLicenses" />
                    </Button>
                    <Button FontSize="16" x:Name="btn8" Content="{x:Static properties:Resources.ClearOptionsPanel}" Grid.Column="0" 
                            Grid.Row="2" Margin="10,2" Click="Clear_Click"/>
                    <Button FontSize="16" Grid.Column="1" Grid.Row="1" Margin="10,2" 
                            Click="OpenLicenseTable_Click">
                        <TextBlock x:Name="btnOpenLicenses" />
                    </Button>
                    <Button FontSize="16" Grid.Column="2" Grid.Row="1" IsEnabled="True" Visibility="Visible" 
                            Margin="10,2" Click="OpenCustomerTable_Click">
                        <TextBlock x:Name="btnCustomerTable" />
                    </Button>
                    <Button FontSize="16" Content="{x:Static properties:Resources.OpenLicenseOptions}" IsEnabled="False" Visibility="Visible" 
                            x:Name="btnAdvancedSettings" Grid.Column="1" Grid.Row="2" Margin="10,2" Click="OpenAdvanceSettings_Click"/>
                    <!--<Button FontSize="16" Content="{x:Static properties:Resources.OpenReportViewer}" IsEnabled="False" Visibility="Visible" 
                            x:Name="btnReportViewer" 
                            Grid.Column="2" Grid.Row="1" Margin="10,2" Click="OpenReportViewer_Click"/>-->
                    <!--<Button FontSize="16" Content="{x:Static properties:Resources.AddNewCustomer}" IsEnabled="False" Visibility="Visible" 
                            x:Name="btnAddNewCustomer" 
                            Grid.Column="2" Grid.Row="2" Margin="10,2" Click="AddNewCustomer_Click"/>-->
                </Grid>
                <Grid Grid.Column="0" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- LicenceType selection-->
                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="16" Grid.Column="2" TextWrapping="Wrap" Text="{x:Static properties:Resources.LicenceType}" Background="Transparent" Margin="33,0" />
                        <DockPanel Grid.Column="1"  Grid.Row="1" LastChildFill="True"  Margin="33,0">
                            <Button Margin="0,0" FontSize="16" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.ApplyOptions}" Click="LoadOptionsOnPanel" 
                                    Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Left">
                                <Image Source="{StaticResource ReloadSmall}" x:Name="reloadImage" Stretch="Uniform" Height="16" Width="16"/>
                            </Button>
                            <Button Margin="10,0" FontSize="16" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.MergeOptions}" 
                                    Click="MergeOptionOnPanel" Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Left">
                                <Image Source="{StaticResource AddNewSmall}" x:Name="addnewImage"  Stretch="Uniform" Height="16" Width="16"/>
                            </Button>
                            <dxe:ComboBoxEdit FontSize="14"
                    x:Name="licencetype" Grid.Row="2" TextSearch.TextPath="Name"
                    IsCaseSensitiveSearch="False" IsSynchronizedWithCurrentItem="False" DisplayMember="Name"
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
                                <dxe:ComboBoxEdit.ItemTemplate>
                                    <DataTemplate DataType="{x:Type helpers:LicenceType}" >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="2,2,0,2" Grid.Column="1"  HorizontalAlignment="Stretch" Text="{Binding Name}" Background="Transparent"/>
                                            <TextBlock Margin="10,2,2,2" Grid.Column="1"  HorizontalAlignment="Stretch" Text="{Binding Description}" Background="Transparent"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </dxe:ComboBoxEdit.ItemTemplate>
                            </dxe:ComboBoxEdit>
                        </DockPanel>
                    </StackPanel>
                    <!-- Description -->
                    <StackPanel Grid.Row="1">
                        <TextBlock FontSize="16" TextWrapping="Wrap" Text="{x:Static properties:Resources.Description}" Background="Transparent" Margin="33,0" />
                        <DockPanel Grid.Column="2"  Grid.Row="1"   Margin="33,0" LastChildFill="True">
                            <dxe:TextEdit FontSize="14" Text="" x:Name="description" TextWrapping="NoWrap" MaskType="None" Grid.Column="2"  Grid.Row="1"/>
                        </DockPanel>
                    </StackPanel>
                    <!-- Site Code -->
                    <StackPanel Grid.Row="2">
                        <TextBlock FontSize="16" TextWrapping="Wrap" Text="{x:Static properties:Resources.SiteCode}" Background="Transparent" Margin="33,0" />
                        <DockPanel Grid.Column="2"  Grid.Row="1"   Margin="33,0" LastChildFill="True">
                          <Button  Margin="5,0" FontSize="16" x:Name="btnNetCore" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.NetCoreLicenseHelp}"
                                  Click="btnNetCore_Click" Width="40" HorizontalAlignment="Left">
                            <Image Source="Images/Delete_32x32.png"  Stretch="Uniform"  Height="16" Width="16"/>
                          </Button>
                          <Button  Margin="5,0" FontSize="16" Visibility="Collapsed" x:Name="btnWindows" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.WindowsCoreHelp}"
                                Click="btnWindows_Click" Width="40" HorizontalAlignment="Left">
                            <Image Source="Images/OkButton.png"  Stretch="Uniform"  Height="16" Width="16"/>
                          </Button>
                          <Grid>
                            <dxe:TextEdit FontSize="14" Text="" x:Name="siteCode" TextWrapping="NoWrap" MaskType="None" Grid.Column="2"  Grid.Row="1"/>
                            <TextBlock FontSize="14" Margin="20,0" x:Name="netcoreWarning" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{x:Static properties:Resources.NetCoreLicense}" Foreground="White"/>
                          </Grid>
                        </DockPanel>
                    </StackPanel>
                    <!-- Serial Number-->
                    <StackPanel Grid.Row="3">
                        <TextBlock FontSize="16" Grid.Column="1" TextWrapping="Wrap" Text="{x:Static properties:Resources.SerialNumber}" Background="Transparent" Margin="33,0"  />
                        <DockPanel Grid.Column="1"  Grid.Row="1" LastChildFill="True"  Margin="33,0">
                            <Button FontSize="16" Visibility="Collapsed" x:Name="btn14" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.GetFirstSerialNumber}" 
                                    Click="GetNewSerialAvailable" Grid.Row="1" Grid.Column="2" Width="40" HorizontalAlignment="Left">
                                <Image Source="Images/new_32x32.png" Stretch="Uniform"  x:Name="getfirstserialImage" Height="16" Width="16"/>
                            </Button>
                            <dxe:SpinEdit Value="0" 
                                          MinValue="0" MaxValue="99999999999"  x:Name="numSerial" MaskType="Numeric" Mask="d" FontSize="14"/>
                        </DockPanel>
                    </StackPanel>
                    <!-- Removing Number-->
                    <StackPanel Grid.Row="4">
                        <TextBlock FontSize="16" Grid.Column="2" TextWrapping="Wrap" Text="{x:Static properties:Resources.RemovingNumber}" Background="Transparent" Margin="33,0"  />
                        <DockPanel Grid.Column="2"  Grid.Row="1"   Margin="33,0">
                            <Button  Margin="5,0" FontSize="16" x:Name="btnCheck" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.RemovingNumberHelp}" 
                                    Click="btnCheck_Click" Width="40" HorizontalAlignment="Left">
                                <Image Source="Images/check_32x32.png"  Stretch="Uniform"  x:Name="removingnumberImage" Height="16" Width="16"/>
                            </Button>
                            <dxe:TextEdit FontSize="14" Text="" x:Name="numRemoved" MaskType="None" Grid.Column="2"  Grid.Row="1"/>
                        </DockPanel>
                    </StackPanel>
                    <!-- Instance Number-->
                    <StackPanel Grid.Row="5">
                        <TextBlock FontSize="16" Grid.Column="1" TextWrapping="Wrap" Text="{x:Static properties:Resources.InstanceNumber}" Background="Transparent" Margin="33,0"  />
                        <DockPanel Grid.Column="2"  Grid.Row="1"   Margin="33,0" LastChildFill="True">
                            <Button  Margin="5,0" FontSize="16" x:Name="btnDisable" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.DisableLicenseHelp}"
                                    Click="btnDisable_Click" Width="40" HorizontalAlignment="Left">
                              <Image Source="Images/Delete_32x32.png"  Stretch="Uniform"  Height="16" Width="16"/>
                            </Button>
                            <Button  Margin="5,0" FontSize="16" Visibility="Collapsed" x:Name="btnEnable" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.EnableLicenseHelp}"
                                  Click="btnEnable_Click" Width="40" HorizontalAlignment="Left">
                                <Image Source="Images/OkButton.png"  Stretch="Uniform"  Height="16" Width="16"/>
                            </Button>
                            <Grid>
                                <dxe:SpinEdit EditValueChanged="instanceNumber_EditValueChanged" FontSize="14" Mask="D" MaskType="Numeric" 
                                              MaxValue="65535" MinValue="-1" Text="" x:Name="instanceNumber" TextWrapping="NoWrap" Grid.Column="2"  Grid.Row="1"/>
                                <TextBlock FontSize="14" Margin="20,0" x:Name="suspendedWarning" Visibility="Collapsed" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{x:Static properties:Resources.LicenseSuspended}" Foreground="White"/>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80*"/>
                            <RowDefinition Height="110*"/>
                        </Grid.RowDefinitions>
                        <!-- Options list -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox Grid.Row="0" x:Name="boolOptionList" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <CheckBox  IsEnabled="{Binding Enabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="160" Height="35" Grid.Column="1"  IsChecked="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                                <TextBlock FontSize="12" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox Grid.Row="0" x:Name="intOptionList" Grid.Column="1" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" Width="140" Height="35" Grid.Column="0" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent"/>
                                            <!--<TextBox Width="100" Height="30" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Background="White"/>-->
                                            <dxe:SpinEdit FontSize="12" IsEnabled="{Binding Enabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="99999999999" Width="100" Height="30" Grid.Column="1" Value="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="d" Grid.Row="1"   />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <!-- Actions -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <!-- SW License -->
                            <GroupBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="10" FontSize="16" Header="{x:Static properties:Resources.SoftWareLicense}" FontWeight="Bold" Foreground="#FF0146FF" />
                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="5" Margin="10,25,10,10" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Button Margin="10" FontSize="16" x:Name="btn1" DockPanel.Dock="Top" Grid.ColumnSpan="2" Grid.Row="0" Click="CreateSWLic">
                                    <TextBlock Text="{x:Static properties:Resources.GetSWKey}" TextWrapping="Wrap"/>
                                </Button>
                                <Button Margin="10" FontSize="16" x:Name="btn2" DockPanel.Dock="Top" Grid.ColumnSpan="2" Grid.Row="1" Click="CreateTemporarySWLic">
                                    <TextBlock Text="{x:Static properties:Resources.GetTemporarySWKey}" TextWrapping="Wrap"/>
                                </Button>
                                <!--<Button Margin="10" FontSize="16" x:Name="btn60DaysSWKey" DockPanel.Dock="Top" Grid.Column="0" Grid.Row="1" Click="CreateTemporarySWLic">
                                    <TextBlock Text="{x:Static properties:Resources.GetTemporary60DaysSWKey}" TextWrapping="Wrap"/>
                                </Button>
                                <Button Margin="10" FontSize="16" x:Name="btn1YearSWKey" DockPanel.Dock="Top" Grid.Column="1" Grid.Row="1" Click="CreateTemporarySWLic">
                                    <TextBlock Text="{x:Static properties:Resources.GetTemporary1YearSWKey}" TextWrapping="Wrap"/>
                                </Button>-->
                                <Button Margin="10" FontSize="16" x:Name="btn3" DockPanel.Dock="Top" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Click="ReadSWLic">
                                    <TextBlock Text="{x:Static properties:Resources.ReadSWKey}" TextWrapping="Wrap"/>
                                </Button>
                            </Grid>

                            <!-- HW License -->
                            <GroupBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="5" Header="{x:Static properties:Resources.HardWareLicense}"  FontSize="16" FontWeight="Bold" Foreground="#FFE4276C" />
                            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="5" Margin="10,25,10,10" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Button Margin="10" FontSize="16" x:Name="btn23" Content="{x:Static properties:Resources.WriteHWKey}" Grid.Column="1" Grid.Row="0" Click="UpdateAndWriteHWKey"/>
                                <Button Margin="10" FontSize="16" x:Name="btn5" Content="{x:Static properties:Resources.CreateUpdateFile}" Grid.Column="1" Grid.Row="1" Click="CreateHWUpdateFile"/>
                                <Button Margin="10" FontSize="16" x:Name="btn4" Content="{x:Static properties:Resources.ReadHWKey}" Grid.Column="1" Grid.Row="2" Click="ReadHWKey"/>
                            </Grid>

                            <Grid Grid.Column="3" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Button FontSize="16" x:Name="btn7" Grid.Column="3" Grid.Row="0" Margin="10,2" Click="AddToDB_Click">
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.SaveToDB}" x:Name="btnSaveOptions"/>
                            </Button>
                            <Button x:Name="btnSaveOptionRange" FontSize="16" Grid.Column="3" Grid.Row="1" Margin="10,2" Click="OpenAdvanceInsertion_Click">
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static properties:Resources.OpenAdvanceInsertion}"/>
                            </Button>

                            <Grid Grid.Row="0" Grid.Column="2" Margin="0,2,0,0" Grid.RowSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="True" Grid.Row="0" Margin="5,0">
                                    <Label FontSize="14" Width="120" DockPanel.Dock="Left" Content="{x:Static properties:Resources.OrderNbr}" HorizontalContentAlignment="Left" />
                                    <TextBox FontSize="14" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" x:Name="Order" Margin="10,2"/>
                                </DockPanel>
                                <DockPanel LastChildFill="True" Grid.Row="1" Margin="5,0">
                                    <Label FontSize="14" Width="120" DockPanel.Dock="Left" Content="{x:Static properties:Resources.BillNbr}" HorizontalContentAlignment="Left" />
                                    <TextBox FontSize="14" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" x:Name="Bill" Margin="10,2" />
                                </DockPanel>
                                <DockPanel LastChildFill="True" Grid.Row="2" Margin="5,0">
                                    <Label FontSize="14" Width="120" DockPanel.Dock="Left" Content="{x:Static properties:Resources.FinalCustomer}" HorizontalContentAlignment="Left" />
                                    <TextBox FontSize="14" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" x:Name="FinalCustomer" Margin="10,2" />
                                </DockPanel>
                                <DockPanel LastChildFill="True" Grid.Row="3" Margin="5,0">
                                    <Label FontSize="14" Width="120" DockPanel.Dock="Left" Content="{x:Static properties:Resources.Euro}" HorizontalContentAlignment="Left" />
                                    <TextBox FontSize="14" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" x:Name="Euro" Margin="10,2" />
                                </DockPanel>
                            </Grid>
                            <DockPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="4" LastChildFill="True" Margin="0,10">
                                <Label  Margin="5,0" FontSize="16" Width="80" DockPanel.Dock="Left" Content="{x:Static properties:Resources.Notes}" HorizontalContentAlignment="Left" />
                                <TextBox ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" FontSize="14" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" x:Name="logNote" Margin="10,2" />
                            </DockPanel>
                        </Grid>

                    </Grid>
                </Border>

                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" FontSize="26" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextAlignment="Center"
                   x:Name="inactivityClosure" Foreground="OrangeRed" 
                   Text="{x:Static properties:Resources.ExpiredLogin}" Visibility="Collapsed"/>

                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed"  Grid.RowSpan="3" Grid.ColumnSpan="3" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center"  Grid.RowSpan="3" Grid.ColumnSpan="3"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
        <TextBlock Grid.ColumnSpan="13" Grid.RowSpan="13" x:Name="sglockCheck" Visibility="Collapsed" 
                   TextWrapping="Wrap" Text="{x:Static properties:Resources.KeyEmptyWarning}" 
                   Foreground="Red"
                   FontSize="75" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" />
        <TextBlock Grid.ColumnSpan="13" Grid.RowSpan="13" x:Name="dbLicType"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" Text="" 
                   Foreground="Green"
                   FontSize="85" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center">
            <TextBlock.Resources>
                <Storyboard x:Key="blink">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.1" To="1"
                                             Duration="0:0:0.5"
                                             AutoReverse="True"
                                             RepeatBehavior="0:0:2" />
                </Storyboard>
                <Storyboard x:Key="hide">
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)">
                        <DiscreteObjectKeyFrame KeyTime="0:0:3" Value="{x:Static Visibility.Collapsed}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </TextBlock.Resources>
