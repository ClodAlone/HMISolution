<dx:DXWindow x:Class="MSZUtils.Controls.Licenses"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:helpers="clr-namespace:MSZUtilsServiceHelper;assembly=MSZUtilsServiceHelper"
             xmlns:local="clr-namespace:MSZUtils.Controls"
             xmlns:properties="clr-namespace:MSZUtils.Properties"
             xmlns:converters="clr-namespace:MSZUtils.Converters"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             mc:Ignorable="d" Height="1024" Width="1600" Background="#FFCCDDF4">
    <dx:DXWindow.Resources>
        <ResourceDictionary>

            <local:ExpiringDateConverter x:Key="ExpiringDateConverter" />
            <dxe:TextEditSettings x:Key="dateSettings" DisplayFormat="" 
                                  MaskType="DateTime" MaskUseAsDisplayFormat="True" />
            <DataTemplate x:Key="SummaryTemplate">
                <TextBlock DataContext="{Binding RelativeSource={RelativeSource AncestorType=dxg:GroupRowDefaultSummaryControl}, Path=DataContext.GroupSummaryData}"
                       >
                    <TextBlock.Text>
                        <MultiBinding Converter="{local:Converter}" StringFormat="Brutto Marge: {0:#,##0.00 '%'}">
                            <Binding Path="[0].SummaryValue" />
                            <Binding Path="[1].SummaryValue" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>
            <local:GroupSummaryItemTemplateSelector x:Key="selector" />
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:DXWindow.Resources>
    <Grid x:Name="view">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="5,10" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>
            <!--Filters-->
            <Grid Grid.Column="3" Grid.RowSpan="10" Margin="5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <GroupBox Header="Licenses" FontSize="14" Grid.RowSpan="4" />
                <Grid Margin="5,18,5,2" x:Name="commands1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.ExpandeAllGroup}" x:Name="expandAll" Click="expandAll_Click" />
                    <Button Height="30" Content="{x:Static properties:Resources.CollapseAllGroup}" x:Name="collapseAll" Click="collapseAll_Click" Grid.Column="1" />
                </Grid>
                <Grid Margin="5,0,5,2" Grid.Row="1" x:Name="commands2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.BestFitColumns}" x:Name="bestFitColumns" Click="bestFitColumns_Click" />
                    <Button Height="30" Content="{x:Static properties:Resources.ClearFilters}" x:Name="clearFilters" Click="clearFilters_Click" Grid.Column="1" />
                </Grid>
                <Grid Margin="5,0,5,5" Grid.Row="2" x:Name="commands3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.ClearGroups}" x:Name="clearGroups" Click="clearGroups_Click" />
                    <Button Height="30" Content="{x:Static properties:Resources.ClearSort}" x:Name="clearSort" Click="clearSort_Click" Grid.Column="1" />
                </Grid>
                <Grid Margin="5,0,5,5" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60*" />
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="20*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Height="30" x:Name="filtersCombo" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Name" 
                              SelectionChanged="filtersCombo_SelectionChanged" IsEditable="True" IsTextSearchEnabled="True" />
                    <Button Height="30" Margin="5,0,0,0" Content="{x:Static properties:Resources.SaveFilterAs}" x:Name="saveFilter" Click="saveFilter_Click" Grid.Column="1" />
                    <Button Height="30" Margin="0" Content="{x:Static properties:Resources.LoadFilter}" x:Name="loadFilter" Click="loadFilter_Click" Grid.Column="2" />
                    <Button Height="30" Content="{x:Static properties:Resources.DeleteFilter}" x:Name="deleteFilter" Click="deleteFilter_Click" Grid.Column="3" />
                </Grid>
                <Grid Margin="5,0,5,5" Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.All}" Tag="0" x:Name="all" Click="dateFilter_Click" Grid.Column="0" />
                    <Button Height="30" Content="{x:Static properties:Resources.LastYear}" Tag="6" x:Name="year" Click="dateFilter_Click" Grid.Column="1" />
                    <Button Height="30" Content="{x:Static properties:Resources.LastMonth}" Tag="5" x:Name="month" Click="dateFilter_Click" Grid.Column="2" />
                    <Button Height="30" Content="{x:Static properties:Resources.LastWeek}" x:Name="week" Tag="4" Click="dateFilter_Click" Grid.Column="3" />
                    <Button Height="30" Content="{x:Static properties:Resources.Today}" x:Name="day" Tag="3" Click="dateFilter_Click" Grid.Column="4" />
                </Grid>

                <Grid Margin="5,0,5,5" Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Button Height="30" Margin="5,0,0,0" Content="{x:Static properties:Resources.Prev}" Tag="0" x:Name="p" Click="addDateFilter_Click" Grid.Column="0" />
                    <Button Height="30" Margin="0" Content="{x:Static properties:Resources.Next}" Tag="1" x:Name="n" Click="addDateFilter_Click" Grid.Column="1" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Content="{x:Static properties:Resources.StartDate}" Grid.Row="1" />
                        <TextBox MinWidth="100" IsReadOnly="True" x:Name="startDate" TextAlignment="Left" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1" />
                        <Label Content="{x:Static properties:Resources.EndDate}" Grid.Row="1" Grid.Column="2" />
                        <TextBox MinWidth="100" IsReadOnly="True" x:Name="endDate" TextAlignment="Left" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="3" />
                    </Grid>
                </Grid>


                <Grid Margin="5,0,5,5" Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.ExportDataCommand}" x:Name="exportData" Click="exportData_Click" Grid.Column="0" />
                    <Button Height="30" Content="{x:Static properties:Resources.RestoreDefaultFilters}" x:Name="restoreDefaultFilters" Click="restoreDefaultFilters_Click" Grid.Column="1" />
                </Grid>


                <GroupBox Header="Historicals" FontSize="14" Grid.Row="7" Grid.RowSpan="5" />
                <Grid Margin="5,18,5,2" Grid.Row="7" x:Name="commands4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.ExpandeAllGroup}" x:Name="expandAllLog" Click="expandAllLog_Click" />
                    <Button Height="30" Content="{x:Static properties:Resources.CollapseAllGroup}" x:Name="collapseAllLog" Click="collapseAllLog_Click" Grid.Column="1" />
                </Grid>
                <Grid Margin="5,0,5,2" Grid.Row="8" x:Name="commands5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.BestFitColumns}" x:Name="bestFitColumnsLog" Click="bestFitColumnsLog_Click" />
                    <Button Height="30" Content="{x:Static properties:Resources.ClearFilters}" x:Name="clearFiltersLog" Click="clearFiltersLog_Click" Grid.Column="1" />
                </Grid>
                <Grid Margin="5,0,5,5" Grid.Row="9" x:Name="commands6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Content="{x:Static properties:Resources.ClearGroups}" x:Name="clearGroupsLog" Click="clearGroupsLog_Click" />
                    <Button Height="30" Content="{x:Static properties:Resources.ClearSort}" x:Name="clearSortLog" Click="clearSortLog_Click" Grid.Column="1" />
                </Grid>
                
                <!-- Buttons -->
                <Grid Margin="5,0,5,5" Grid.Row="14" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Button Click="Button_Click" Margin="12,2,2,2" Width="180" Height="50">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.ExitLabel}" />
                    </Button>
                    <Button Grid.Column="1" Click="Button1_Click" Margin="12,2,2,2" Width="180" Height="50">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.LoadAndOkLabel}" />
                    </Button>
                    <Button Grid.Row="1" Click="Button2_Click" Margin="12,2,2,2" Width="180" Height="50">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.LoadLabel}" />
                    </Button>
                    <Button Grid.Column="1" Grid.Row="1" Click="ReloadAndInitValues" Margin="12,2,2,2" Width="180" Height="50">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{x:Static properties:Resources.ReInitDatas}" />
                    </Button>
                </Grid>
            </Grid>

            <GridSplitter Background="DarkGray" Width="2" Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" />
            <!--Licenses-->
            <Grid Margin="5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="35*" />
                </Grid.RowDefinitions>
                <GroupBox Header="Licenses" FontSize="14" Grid.Row="0" Grid.RowSpan="1" />
                <!--  Licences  -->
                <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible" Margin="5,20,5,10"
			                 Tag="DataSourceStyle"
                             AutoExpandAllGroups="True"
                             AutoPopulateColumns="False" 
			                 x:Name="gridControl"
                             AllowDrop="True" SelectionChanged="gridControl_SelectionChanged"
                             AllowColumnMRUFilterList="True" 
                             AllowLiveDataShaping="False"                         
                             dx:DXSerializer.SerializationID="gridControl" 
                             dx:DXSerializer.StoreLayoutMode="All" 
                             dxg:DataControlSerializationOptions.AddNewColumns="False" 
    		                 dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:N0}" FieldName="ID" SummaryType="Count" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="ID" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="SerialNumber" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="AreaGeoDescr" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="CustomerCode" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="CustomerDescription" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="TypeName" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="TypeDescr" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="LicDescr" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        EditSettings="{StaticResource dateSettings}" 
                                        AllowSearchPanel="True" FieldName="LastChangesDate" />

                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="FinalCustomer" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="Price" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="LastChangesUser" />

                      <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" DisplayMemberBinding="{Binding Path=SKExpiredDate, Mode=OneWay}" FieldName="SKExpiredDate">
                        <dxg:GridColumn.CellTemplate>
                          <DataTemplate>
                                    <TextBlock Text="{Binding RowData.Row.SKExpiredDate, Converter={StaticResource ExpiringDateConverter}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                          </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                      </dxg:GridColumn>
                        
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="RemovedCode" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="Order" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="SiteCode" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="Bill" />
                        <dxg:GridColumn AllowEditing="False" Tag="Value" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="Note" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" AllowEditing="False"
                        GroupSummaryItemTemplateSelector="{StaticResource selector}"
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        ShowTotalSummary="True"
                        ShowGroupPanel="True"
                        ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem DisplayFormat="Licence Number: {0:N0}" FieldName="ID" ShowInColumn="" SummaryType="Count" />
                    </dxg:GridControl.GroupSummary>
                </dxg:GridControl>
                <GridSplitter Background="DarkGray" Height="2" Grid.Row="1" HorizontalAlignment="Stretch" />
                <!--  Historical  -->
                <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible" Margin="5,20,5,10"
			                 Grid.Row="2" 
                             AutoExpandAllGroups="True"
                             AutoPopulateColumns="False" 
			                 x:Name="historicals" CustomColumnDisplayText="historicals_CustomColumnDisplayText"
                             AllowDrop="False"
                             AllowColumnMRUFilterList="False"
                             AllowLiveDataShaping="False"                         
                             >
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" 
                                        EditSettings="{StaticResource dateSettings}" 
                                        AllowSearchPanel="True" FieldName="DateOfChange">

                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="NewValue">

                        </dxg:GridColumn>
                        <!--<dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" AllowSearchPanel="True" FieldName="NewValue">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Height="Auto" Text="{Binding Data.NewValue}" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>-->
                        <dxg:GridColumn AllowEditing="False" AllowAutoFilter="True" 
                                        AllowSearchPanel="True" FieldName="ChangesUser">

                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableLogView" AllowEditing="False"
                        GroupSummaryItemTemplateSelector="{StaticResource selector}"
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        ShowTotalSummary="True"
                        ShowGroupPanel="True"
                        ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem DisplayFormat="Historical rows: {0:N0}" FieldName="DateOfChange" ShowInColumn="" SummaryType="Count" />
                    </dxg:GridControl.GroupSummary>
                </dxg:GridControl>
                <GridSplitter Background="DarkGray" Height="2" Grid.Row="3" HorizontalAlignment="Stretch" />
                <!--  Details  -->
                <GroupBox Header="Details" Margin="0,2,0,0" FontSize="14" Grid.Row="4" Grid.RowSpan="1" />
                <Grid Grid.Row="4" Margin="5,6,5,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <ListView Grid.Row="0" BorderThickness="0" x:Name="boolOptionList" Margin="0,15,2,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsHitTestVisible="False" IsEnabled="{Binding Enabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="16" Height="35" Grid.Column="0" IsChecked="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock FontSize="12" Width="140" Height="35" Margin="5,2" Grid.Column="1" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent" />
                                    <!--<TextBlock FontSize="12" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />-->
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListBox Grid.Row="0" BorderThickness="0" x:Name="intOptionList" Grid.Column="1" Margin="2,15,0,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" AlternationCount="1" MinHeight="8" MinWidth="8" IsHitTestVisible="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12" Width="140" Height="35" Margin="5,2" Grid.Column="0" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Background="Transparent" />
                                    <!--<TextBox Width="100" Height="30" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Background="White"/>-->
                                    <dxe:SpinEdit FontSize="12" IsHitTestVisible="False" IsEnabled="{Binding Enabled, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="99999999999" Width="100" Height="30" Grid.Column="1" Value="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaskType="Numeric" Mask="d" Grid.Row="1" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!--  Busy control  -->
                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.RowSpan="3" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.RowSpan="3"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</dx:DXWindow>
