<dx:DXWindow x:Class="MSZUtils.Controls.AdvancedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:properties="clr-namespace:MSZUtils.Properties" 
             xmlns:converters="clr-namespace:MSZUtils.Converters" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             mc:Ignorable="d" Height="350" Width="450">
    <DockPanel LastChildFill="True" x:Name="view">
        <DockPanel.Resources>
            <converters:EnumMatchToBooleanConverter x:Key="enumConverter" />
        </DockPanel.Resources>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,0,10">
            <Button Content="{x:Static properties:Resources.OkLabel}" Click="Button_Click" IsDefault="True" Margin="12,2,2,2" Width="120" Height="50" />
            <Button Content="{x:Static properties:Resources.CancelLabel}" IsCancel="True" Margin="12,2,2,2" Width="120" Height="50" />
        </StackPanel>
        <StackPanel Margin="10,10,10,5" Orientation="Vertical">
            <StackPanel Orientation="Vertical">
                <RadioButton Content="{x:Static properties:Resources.AddLicenseFromRange}" 
                             GroupName="Options1" 
                             x:Name="range"
                             IsChecked="{Binding Path=Selection, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=Range}" />
                <StackPanel Margin="10,10" Orientation="Horizontal" IsEnabled="{Binding ElementName=range,Path=IsChecked}">
                    <TextBlock Height="Auto" HorizontalAlignment="Right" Width="120" Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.AddLicenseFromNumber}" FontSize="14" />
                    <dxe:SpinEdit Height="Auto" Width="190" Grid.Row="0" Grid.Column="1" MinValue="0" MaxValue="99999999999" Value="{Binding FromSerial, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="numSerial1" MaskType="Numeric" Mask="d" FontSize="14" />
                </StackPanel>
                <StackPanel Margin="10,10" Orientation="Horizontal" IsEnabled="{Binding ElementName=range,Path=IsChecked}">
                    <TextBlock Height="Auto" HorizontalAlignment="Right" Width="120" Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.AddLicenseToNumber}" FontSize="14" />
                    <dxe:SpinEdit Height="Auto" Width="190" Grid.Row="1" Grid.Column="1" MinValue="0" MaxValue="99999999999" Value="{Binding ToSerial, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="numSerial2" MaskType="Numeric" Mask="d" FontSize="14" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,20,0,0">
                <RadioButton Content="{x:Static properties:Resources.AddLicenseFromList}" 
                             x:Name="numbers" 
                             GroupName="Options2"
                             IsChecked="{Binding Path=Selection, Mode=TwoWay, 
                                 Converter={StaticResource enumConverter},
                                 ConverterParameter=List}" />
                <StackPanel Margin="10,10" Orientation="Horizontal" IsEnabled="{Binding ElementName=numbers,Path=IsChecked}">
                    <TextBlock Height="Auto" HorizontalAlignment="Right" Width="120" Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.AddLicenseNumberList}" FontSize="14" />
                    <dxe:TextEdit NullText="{x:Static properties:Resources.AddLicenseHelp}" Height="Auto" Width="190" Grid.Row="0" Grid.Column="1" ToolTip="{x:Static properties:Resources.AddLicenseTooltip}" Text="{Binding SerialNumbers, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" x:Name="numSerials" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</dx:DXWindow>
