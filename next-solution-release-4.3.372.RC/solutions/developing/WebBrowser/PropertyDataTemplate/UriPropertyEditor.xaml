<UserControl x:Class="WebBrowser.PropertyDataTemplate.UriPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WebBrowser.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFUtilities;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:UriConverter x:Key="UriConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
            <TextBox x:Name="textUrl" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, Converter={StaticResource UriConverter}}" 
                                        Validation.ErrorTemplate="{x:Null}" />
        <ContentPresenter Grid.Column="1" Content="{Binding ElementName=textUrl, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
