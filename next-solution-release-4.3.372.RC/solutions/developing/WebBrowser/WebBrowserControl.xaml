<UserControl x:Class="WebBrowser.WebBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/exression/blend/2008"
             xmlns:properties="clr-namespace:WebBrowser.Properties"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/WebBrowser.xaml" />
        <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="Black" Background="{Binding ControlBackground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" BorderThickness="1" x:Name="view">
        <DockPanel Margin="4" LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" Height="25">
                <Button x:Name="btnInternal" ToolTip="{x:Static properties:Resources.GoHome}" Margin="0" Width="50" Height="25" Click="btnHome_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource WBHome}" Width="16" Height="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="btnSetHome" ToolTip="{x:Static properties:Resources.SetHome}" Margin="0" Width="50" Height="25" Click="btnSetHome_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource WBSetHome}" Width="16" Height="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="btnExternal" ToolTip="{x:Static properties:Resources.NavigateURL}" Margin="0" Width="50" Height="25" Click="btnLoad_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource WBopen}" Width="16" Height="16" />
                    </Button.Content>
                </Button>
              <Button x:Name="btnNext" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.GoForward}" Margin="0" Width="50" Height="25" Click="btnNext_Click">
                <Button.Content>
                  <Image Source="{DynamicResource Next}"  Width="16" Height="16" />
                </Button.Content>
              </Button>
              <Button x:Name="btnPrevious" DockPanel.Dock="Right" ToolTip="{x:Static properties:Resources.GoBack}" Margin="0" Width="50" Height="25" Click="btnPrevious_Click">
                  <Button.Content>
                  <Image Source="{DynamicResource Previous}"  Width="16" Height="16" />
                  </Button.Content>
                </Button>
                <TextBox x:Name="txtLoad"
                         GotFocus="textBox_GotFocus"
                         GotKeyboardFocus="textBox_GotKeyboardFocus"
                         PreviewMouseLeftButtonDown="textBox_PreviewMouseLeftButtonDown"
                         TextWrapping="Wrap" HorizontalAlignment="Stretch" 
                         Cursor="None" Height="25" VerticalAlignment="Top"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom">
                <ContentControl x:Name="Container"/>
                <!--<WebBrowser IsEnabled="False"  Height="Auto" x:Name="BrowserWindow" Margin="0" Cursor="Arrow"/>-->
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
