<%@ Register TagPrefix="dx" Namespace="DevExpress.Data" Assembly="DevExpress.Data.v21.2, Version=21.2.13.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxe" Namespace="DevExpress.Web" Assembly="DevExpress.Web.v21.2, Version=21.2.13.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<dxe:ASPxDateEdit runat="server" SpriteCssFilePath="~/App_Themes/Youthful/{0}/sprite.css" CssFilePath="~/App_Themes/Youthful/{0}/styles.css" 
    CssPostfix="Youthful" ShowShadow="False">
    <CalendarProperties>
        <FooterStyle Spacing="3px"></FooterStyle>
        <HeaderStyle Spacing="8px"></HeaderStyle>
    </CalendarProperties>
    <ValidationSettings>
        <ErrorFrameStyle ImageSpacing="4px">
            <ErrorTextPaddings PaddingLeft="4px"></ErrorTextPaddings>
        </ErrorFrameStyle>
    </ValidationSettings>
</dxe:ASPxDateEdit>
