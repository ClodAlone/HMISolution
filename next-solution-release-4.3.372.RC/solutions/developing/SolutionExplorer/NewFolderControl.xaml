<UserControl x:Class="UFProjectManager.NewFolderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="300" Height="80"     
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             FocusManager.FocusedElement="{Binding ElementName=folderName}"
             mc:Ignorable="d">

    <Grid>

        <StackPanel Orientation="Vertical" Margin="5" >

            <TextBlock Margin="2" Text="{x:Static properties:Resources.NewFolderControlTitle}" />
            <TextBox Margin="2" x:Name="folderName" />
        </StackPanel>
    </Grid>
</UserControl>
