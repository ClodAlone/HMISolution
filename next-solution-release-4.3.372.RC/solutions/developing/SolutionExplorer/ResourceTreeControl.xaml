<UserControl x:Class="UFProjectManager.ResourceTreeControl"
             x:Name="ResourceTreeUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:self="clr-namespace:UFProjectManager"
             Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Path=Width}"
             Height="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Path=Height}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            <ResourceDictionary Source="/SharedResources;component/Resources/UFProject.xaml" />
          </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="MouseOverOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="stackButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="MouseLeaveOpacity">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="stackButtons">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.5" Value="0.2" KeySpline="0,0,0.5,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="4,0,4,0" />
            </Style>

        </ResourceDictionary>

    </UserControl.Resources>
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource MouseOverOpacity}" x:Name="MouseOver_BeginStoryboard" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource MouseLeaveOpacity}" x:Name="MouseLeave_BeginStoryboard" />
        </EventTrigger>
    </UserControl.Triggers>

    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu" ShowKeyGestures="True">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph" Content="{x:Static appproperties:ApplicationCommandsResource.Open}" Command="{Binding DataContext.OpenCommand, ElementName=ResourceTreeUserControl}" ToolTip="{x:Static appproperties:ApplicationCommandsResource.Open}" Glyph="{StaticResource UFPRJOpenSmall}" ToolTipService.ShowOnDisabled="True" GlyphSize="Custom" CustomGlyphSize="14,14"/>
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph" KeyGesture="F2" Content="{x:Static appproperties:ApplicationCommandsResource.Rename}" Command="{Binding DataContext.RenameCommand, ElementName=ResourceTreeUserControl}" ToolTip="{x:Static appproperties:ApplicationCommandsResource.Rename}" Glyph="{StaticResource RenameSmall}" ToolTipService.ShowOnDisabled="True" GlyphSize="Custom" CustomGlyphSize="14,14"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="ApplicationCommands.Copy" KeyGesture="CTRL+C" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Paste" KeyGesture="CTRL+V" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Cut" KeyGesture="CTRL+X" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                <dxb:BarButtonItem Command="ApplicationCommands.Delete" KeyGesture="Del" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.CreateQRCode}" Content="{x:Static properties:UICommandResource.CreateQRCodeText}"  Glyph="{StaticResource UFPRJQRCode_32x32}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="Properties" KeyGesture="F4" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}" />
                <!--<dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="NavigationCommands.Refresh" Content="{x:Static appproperties:ApplicationCommandsResource.Refresh}"/>-->
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Title}" Margin="2,0,2,0" VerticalAlignment="Center" x:Name="PART_Header" Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, Path=IsTitleVisible}" />
        <StackPanel Orientation="Horizontal" x:Name="stackButtons" Opacity="0.2">
            <Button Command="{Binding OpenCommand}" x:Name="btnOpen" ToolTip="{x:Static appproperties:ApplicationCommandsResource.Open}">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource UFPRJOpenSmall}" Height="14" Width="14" ToolTip="Open"/>
                </Button.Content>
            </Button>
            <Button Command="{Binding DeleteCommand}" x:Name="btnDelete" ToolTip="{x:Static appproperties:ApplicationCommandsResource.Delete}">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource DeleteSmall}" Height="14" Width="14" ToolTip="Delete"/>
                </Button.Content>
            </Button>
            <Button Command="{Binding RenameCommand}" x:Name="btnRename" ToolTip="{x:Static appproperties:ApplicationCommandsResource.Rename}">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource RenameSmall}" Height="14" Width="14" ToolTip="Rename"/>
                </Button.Content>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
