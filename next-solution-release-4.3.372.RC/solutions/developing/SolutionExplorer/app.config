            </setting>
            <setting name="RemoteLicenseFileName" serializeAs="String">
                <value>msz_controls.xaml</value>
            </setting>
            <setting name="ServerWebHMIImagesFolder" serializeAs="String">
                <value>wwwroot\images</value>
            </setting>
            <setting name="MovNextKeyName" serializeAs="String">
                <value>Movicon.NExT</value>
            </setting>
            <setting name="MovNextSubKey" serializeAs="String">
                <value>Software\Progea</value>
            </setting>
            <setting name="VersionKeyName" serializeAs="String">
                <value>Version</value>
            </setting>
            <setting name="WinExecutableName_WebHMI" serializeAs="String">
                <value>WebNExTHMI.exe</value>
            </setting>
            <setting name="WebClientServiceCertificateFriendlyName" serializeAs="String">
                <value>UFWebClientService_LocalCertificate</value>
            </setting>
            <setting name="RuntimeProcessName" serializeAs="String">
                <value>MoviconNextRT.exe</value>
            </setting>
            <setting name="TileDetailsFilename" serializeAs="String">
                <value>Tile.details</value>
            </setting>
            <setting name="IsErrorLogEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsWarningLogEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsInformationLogEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="MaxEventLogErrorRetryCount" serializeAs="String">
                <value>3</value>
            </setting>
            <setting name="MaxPendingMessagesCount" serializeAs="String">
                <value>5000</value>
            </setting>
            <setting name="EventLogErrorRetryIntervall" serializeAs="String">
                <value>5000</value>
            </setting>
            <setting name="WebHMIWwwrootDocumentsExtensionsPattern" serializeAs="String">
