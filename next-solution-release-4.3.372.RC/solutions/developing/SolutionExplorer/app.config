            </setting>
            <setting name="ServerWebHMIDocumentsFolder" serializeAs="String">
                <value>wwwroot\documents</value>
            </setting>
            <setting name="ProjectUpdaterExe" serializeAs="String">
                <value>ProjectUpdater.exe</value>
            </setting>
            <setting name="ProjectUpdaterArg" serializeAs="String">
                <value>/P"{0}"</value>
            </setting>
            <setting name="UpdateProjectFromMajorVersion" serializeAs="String">
                <value>4</value>
            </setting>
            <setting name="UpdateProjectFromMinorVersion" serializeAs="String">
                <value>3</value>
            </setting>
            <setting name="DefaultDeployClientConnectToPort" serializeAs="String">
                <value>5002</value>
            </setting>
            <setting name="DownloadPathFileName" serializeAs="String">
                <value>DeployClientDownloadPath</value>
            </setting>
            <setting name="WebHMIMaxDownloadChunkSize" serializeAs="String">
                <value>1024000</value>
            </setting>
            <setting name="ConnectItemsAtStartupTimeout" serializeAs="String">
                <value>30000</value>
            </setting>
            <setting name="ADServiceNamePrefix" serializeAs="String">
                <value>ADispatcherServer</value>
            </setting>
            <setting name="CheckedAssemblyName_ADServer" serializeAs="String">
                <value>ADispatcherServer.Core.dll</value>
            </setting>
            <setting name="ADServerFilePath" serializeAs="String">
                <value>AlarmDispatcher/AlarmDispatcher.ADServer</value>
            </setting>
        </UFProjectManager.Properties.Settings>
    </applicationSettings>
<appSettings>
    <add key="PubnubMessaging.LogLevel" value="0" />
    <add key="PubnubMessaging.PubnubErrorFilterLevel" value="3" />
    <add key="PubnubMessaging.LogMessageLengthLimit" value="0" />
  </appSettings><system.diagnostics>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <add name="pubnubListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="pubnub-messaging.log" />
        <remove name="Default" />
      </listeners>
    </trace>
  </system.diagnostics><system.net>
    <connectionManagement>
      <add address="*" maxconnection="30" />
    </connectionManagement>
  </system.net>
</configuration>
