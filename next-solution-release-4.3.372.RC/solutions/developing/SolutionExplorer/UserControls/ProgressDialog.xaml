<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" x:Class="UFProjectManager.Controls.ProgressDialog"
        mc:Ignorable="d"
        xmlns:properties="clr-namespace:UFProjectManager.Properties"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:Converters;assembly=Converters" Width="600" Height="150">
    <UserControl.Resources>
        <!--<converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:DoubleToPercentageConverter x:Key="DoubleToPercentageConverter" />-->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <dxe:ProgressBarEdit x:Name="progressBar" MinHeight="50" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" IsPercent="False" DisplayFormatString="{Binding CurrentState, Mode=OneWay}" ContentDisplayMode="Value" />
        <Button Content="{x:Static properties:Resources.SVGExportAbort}" Grid.Column="1" Grid.Row="0" MinHeight="50" Click="OnAbortBtnClick" />
    </Grid>
</UserControl>
