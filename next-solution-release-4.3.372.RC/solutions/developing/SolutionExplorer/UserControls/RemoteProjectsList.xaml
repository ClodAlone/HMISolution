<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" x:Class="UFProjectManager.Controls.RemoteProjectsList"
        mc:Ignorable="d"
        xmlns:properties="clr-namespace:UFProjectManager.Properties"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Height="500" Width="400">
    <dxg:GridControl x:Name="RemoteProjectsGrid" MaxHeight="400" MaxWidth="500" ItemsSource="{Binding FoldersList, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
        <dxg:GridControl.Columns>
            <dxg:GridColumn Header="{x:Static properties:Resources.ProjectFolderNameColumnHeader}">
                <dxg:GridColumn.DisplayMemberBinding>
                    <Binding Path="RowData.Row" Mode="OneWay" />
                </dxg:GridColumn.DisplayMemberBinding>
            </dxg:GridColumn>
        </dxg:GridControl.Columns>
        <dxg:GridControl.View>
            <dxg:TableView RowDoubleClick="OnRowDoubleClick" VerticalScrollbarVisibility="Auto" HorizontalScrollbarVisibility="Auto" ShowGroupPanel="False" NavigationStyle="Row" MultiSelectMode="None" AutoWidth="True" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
