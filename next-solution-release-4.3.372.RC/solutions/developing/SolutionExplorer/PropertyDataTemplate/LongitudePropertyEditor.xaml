<UserControl x:Class="UFProjectManager.PropertyDataTemplate.LongitudePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DoubleToLongitudeDegreesConverter x:Key="DoubleToLongitudeDegreesConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <dxe:TextEdit x:Name="longitude" 
                          MaskType="Regular" Mask="\d{3}° \d{2}' \d{2}'' >[WE]" 
                          MaskShowPlaceHolders="False" Text="{Binding Value, 
                          Converter={StaticResource DoubleToLongitudeDegreesConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                          DisplayFormatString="" MaskUseAsDisplayFormat="True"/>
        <ContentPresenter Grid.Column="1" 
                Content="{Binding ElementName=longitude, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
