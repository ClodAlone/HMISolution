<dxb:BarSubItem
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="UFProjectManager.MenuControls.BarCommonItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:translatableMenu ="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:self="clr-namespace:UFProjectManager"
             xmlns:properties="clr-namespace:UFProjectManager.Properties"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/UFProject.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <!--<dxb:BarSubItem Content="{Binding Path=TypeLabel,Mode=OneWay,Source={x:Static properties:Settings.Default}}">
        </dxb:BarSubItem>-->
    <dxb:BarSubItem x:Name="biFileUFProject" Content="{x:Static translatableMenu:Resources.RibbonFileHeader}" MergeType="MergeItems">

        <dxb:BarButtonItem MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biClose" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                         Glyph="{StaticResource UFPRJClose_16x16}"  CategoryName="{x:Static properties:Resources.FilesRibbonHeader}" 
                                         Command="{x:Static self:UIGeneralCommands.ApplicationClose}"/>

        <dxb:BarButtonItem MergeOrder="22" ToolTipService.ShowOnDisabled="True" x:Name="biCloseAll" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                         Glyph="{StaticResource UFPRJCloseAll_16x16}"  CategoryName="{x:Static properties:Resources.FilesRibbonHeader}" 
                                         Command="{x:Static self:UIGeneralCommands.CloseAll}"/>

        <!--<dxb:BarItemLinkSeparator MergeOrder="45" />-->

        <dxb:BarButtonItem MergeOrder="50" ToolTipService.ShowOnDisabled="True" x:Name="biAddPassword" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                         Glyph="{StaticResource UFPRJKey}"  CategoryName="{x:Static properties:Resources.FilesRibbonHeader}" 
                                         Command="{x:Static self:UIGeneralCommands.AddPasswordProject}" />

        <dxb:BarItemLinkSeparator MergeOrder="55" />

        <dxb:BarButtonItem MergeOrder="70" ToolTipService.ShowOnDisabled="True" x:Name="biSaveAll" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                                         Glyph="{StaticResource UFPRJSaveAll_16x16}"  CategoryName="{x:Static properties:Resources.FilesRibbonHeader}" 
                                         Command="{x:Static self:UIGeneralCommands.SaveAll}" Tag="QuickAccess" />

        <!--<dxb:BarButtonItem ToolTipService.ShowOnDisabled="True" x:Name="biSaveAsPrj" Glyph="{StaticResource UFPRJSaveAs}"  
                                       Command="ApplicationCommands.SaveAs"  CategoryName="{x:Static properties:Resources.FilesRibbonHeader}" 
                                       Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>-->

        <dxb:BarButtonItem MergeOrder="90" ToolTipService.ShowOnDisabled="True" x:Name="biStartupRuntime" 
                                 Glyph="{StaticResource UFPRJRun32}"  CategoryName="{x:Static properties:Resources.ResourcesRibbonExecution}" 
                                 Command="{x:Static self:UIGeneralCommands.StartupRuntime}"
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="100" ToolTipService.ShowOnDisabled="True" x:Name="biStopRuntime" 
                                 Glyph="{StaticResource UFPRJstop32}"  CategoryName="{x:Static properties:Resources.ResourcesRibbonExecution}" 
                                 Command="{x:Static self:UIGeneralCommands.StopRuntime}"
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarItemLinkSeparator MergeOrder="105" />

    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biViewUFProject" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="20" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" IsChecked="{Binding IsToolbarShown, Mode=OneWay}" MergeOrder="20" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static properties:Resources.ToolbarHeaderTitle}" 
                                Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" x:Name="toolbarMenuItem"
                                Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biOptionsUFProject" Content="{x:Static translatableMenu:Resources.OptionsRibbonHeader}">
        <dxb:BarButtonItem MergeOrder="10" ToolTipService.ShowOnDisabled="True" x:Name="biOpenServicesPanel" 
                                 Glyph="{StaticResource UFPRJServiceManager32x32}"   CategoryName="{x:Static properties:Resources.ResourcesRibbonExecution}" 
                                 Command="{x:Static self:UIGeneralCommands.OpenServicesPanel}"
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarItemLinkSeparator MergeOrder="15" />

        <dxb:BarButtonItem MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biCreateWebClientApp"
                                 Glyph="{StaticResource UFPRJHTML5_Logo_32}"   CategoryName="{x:Static properties:Resources.ResourcesRibbonWebClients}" 
                                 Command="{x:Static self:UIGeneralCommands.CreateWebClientApp}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biCreateWebClientExpress"
                                 Glyph="{StaticResource UFPRJWebExpressToSvg}"   CategoryName="{x:Static properties:Resources.ResourcesRibbonWebClients}" 
                                 Command="{x:Static self:UIGeneralCommands.CreateWebClientExpress}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="20" ToolTipService.ShowOnDisabled="True" x:Name="biCreateRuntimeShortcut"
                                 Glyph="{StaticResource UFPRJRuntimeShortcut}" CategoryName="{x:Static properties:Resources.ResourcesRibbonWebClients}" 
                                 Command="{x:Static self:UIGeneralCommands.CreateRuntimeShortcut}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="21" ToolTipService.ShowOnDisabled="True" x:Name="biDeployWebClientExpress"
                                 Glyph="{StaticResource UFPRJServiceInstall32x32}"   CategoryName="{x:Static properties:Resources.ResourcesRibbonWebClients}" 
                                 Command="{x:Static self:UIGeneralCommands.DeployWebClientExpress}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="22" ToolTipService.ShowOnDisabled="True" x:Name="biAddGeoLocation"
                                 Glyph="{StaticResource UFPRJweb_32x32}" CategoryName="{x:Static properties:Resources.ResourcesRibbonWebClients}" 
                                 Command="{x:Static self:UIGeneralCommands.AddGeoLocation}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="22" ToolTipService.ShowOnDisabled="True" x:Name="biCreateQRCode"
                                 Glyph="{StaticResource UFPRJQRCode_32x32}" CategoryName="{x:Static properties:Resources.ResourcesRibbonWebClients}" 
                                 Command="{x:Static self:UIGeneralCommands.CreateQRCode}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarItemLinkSeparator MergeOrder="25" />

        <dxb:BarButtonItem MergeOrder="30" ToolTipService.ShowOnDisabled="True" x:Name="biUploadIoTApp"
                                 Glyph="{StaticResource UFPRJUpload}"    CategoryName="{x:Static properties:Resources.ResourcesRibbonUploads}" 
                                 Command="{x:Static self:UIGeneralCommands.UploadIoTApp}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarItemLinkSeparator MergeOrder="35" />

        <dxb:BarButtonItem MergeOrder="40" ToolTipService.ShowOnDisabled="True" x:Name="biEditAppNameSettings"
                                 Glyph="{StaticResource UFPRJEditAppName}"     CategoryName="{x:Static properties:Resources.ResourcesStringHeader}" 
                                 Command="{x:Static self:UIGeneralCommands.EditAppNameSettings}" 
                                 Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <dxb:BarButtonItem MergeOrder="45" ToolTipService.ShowOnDisabled="True" x:Name="biAddStringId"
                                 Glyph="{StaticResource AddStringId}"
                                 Command="{x:Static self:UIGeneralCommands.AddStringId}"
                                 Content="{x:Static translatableMenu:Resources.AddStringIdName}"/>
        
    </dxb:BarSubItem>
</dxb:BarSubItem>
