<dxb:BarManager
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="UFProjectManager.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UFProjectManager.MenuControls"
             mc:Ignorable="d" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="PrjManagerBarManagerToolbar"
             d:DesignHeight="450" d:DesignWidth="800">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar x:Name="MDIToolbar" dxb:MergingProperties.Name="projectMDIToolbar"
                             GlyphSize="Small" ShowDragWidget="True" 
                             AllowCustomizationMenu="True"
                             AllowDrop="True" 
                             AllowHide="True"
                             AllowCollapse="True"
                             AllowQuickCustomization="True">

            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biSaveAll"/>
            <dxb:BarItemLinkSeparator />
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biClose"/>-->
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCloseAll"/>
            <dxb:BarItemLinkSeparator />
            <!--<dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biSaveAsPrj"/>-->
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddPassword"/>

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biOpenServicesPanel"/>

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCreateWebClientApp"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCreateWebClientExpress"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biCreateRuntimeShortcut"/>

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biDeployWebClientExpress"/>

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddGeoLocation"/>

            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biCreateQRCode"/>

          <!--<dxb:BarItemLinkSeparator />-->

            <dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biUploadIoTApp"/>

            <!--<dxb:BarItemLinkSeparator />-->

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biEditAppNameSettings"/>
            <!--<dxb:BarButtonItemLink IsVisible="False" ToolTipService.ShowOnDisabled="True" BarItemName="biAddStringId"/>-->
            <dxb:BarItemLinkSeparator />

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStartupRuntime"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStopRuntime"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
