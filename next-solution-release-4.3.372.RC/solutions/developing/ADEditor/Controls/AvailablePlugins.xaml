<UserControl x:Class="ADEditor.Controls.AvailablePlugins"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ADEditor.Properties"
             xmlns:converter="clr-namespace:ADEditor.Converters"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" Height="300" Width="300"
             d:DesignHeight="300" d:DesignWidth="300" PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:ValueToLocalizedTextConverter x:Key="ValueToLocalizedTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static properties:Resources.SelectPlugin}"/>
        <dxg:GridControl Grid.Row="1" Name="PluginGrid" MouseDoubleClick="PluginSelect_DblClick" SelectionMode="Row">
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="{x:Static properties:Resources.PluginName}" ReadOnly="True" AllowEditing="False">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <MultiBinding Converter="{StaticResource ValueToLocalizedTextConverter}" ConverterParameter="FriendlyName">
                            <Binding Path="Name" />
                            <Binding Path="AssemblyName" />
                        </MultiBinding>
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn Header="{x:Static properties:Resources.PluginDescription}" ReadOnly="True" AllowEditing="False">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <MultiBinding Converter="{StaticResource ValueToLocalizedTextConverter}" ConverterParameter="Description">
                            <Binding Path="Description" />
                            <Binding Path="AssemblyName" />
                        </MultiBinding>
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView ShowGroupPanel="False" 
                               NavigationStyle="Row"
                               MultiSelectMode="None"
                               AutoWidth="True"
                               AllowBestFit="True" 
                               AllowResizing="True" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
