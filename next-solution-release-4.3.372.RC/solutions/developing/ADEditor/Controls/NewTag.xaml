<UserControl x:Class="ADEditor.Controls.NewTag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ADEditor.Properties"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d"  Width="300" Height="280"
             d:DesignHeight="280" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewTagTitle}" VerticalAlignment="Center" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewTagName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            <ContentPresenter Grid.Row="1" Grid.Column="2" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewTagDescription}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Description}" x:Name="textEditDesc" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.NewTagModelType}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Grid.Row="3" SelectedValue="{Binding ModelType}" x:Name="comboModelType" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" SelectionChanged="comboModelType_SelectionChanged" />

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.NewTagDataType}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textDataType"/>
            <ComboBox Grid.Column="1" Grid.Row="4" SelectedValue="{Binding DataType}" x:Name="comboDataType" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.NewTagTagType}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="textTagType"/>
            <ComboBox Grid.Column="1" Grid.Row="5" SelectedValue="{Binding ADTagType}" x:Name="comboTagType" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsEditable="False" />
        </Grid>
    </ScrollViewer>
</UserControl>
