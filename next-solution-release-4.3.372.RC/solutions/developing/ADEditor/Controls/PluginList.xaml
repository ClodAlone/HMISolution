<UserControl x:Class="ADEditor.Controls.PluginList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:self="clr-namespace:ADEditor"
             xmlns:properties="clr-namespace:ADEditor.Properties"
             xmlns:appproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:converter="clr-namespace:ADEditor.Converters"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <converter:ValueToLocalizedTextConverter x:Key="ValueToLocalizedTextConverter" />
      </ResourceDictionary>
    </UserControl.Resources>
    
    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewPlugin}" Content="{x:Static properties:UICommandResource.AddNewPluginText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.EditPlugin}" Content="{x:Static properties:UICommandResource.EditPluginText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.RunTestPlugin}" Content="{x:Static properties:UICommandResource.RunTestPluginText}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.StartServer}" Content="{x:Static properties:UICommandResource.StartServerText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.StopServer}" Content="{x:Static properties:UICommandResource.StopServerText}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.ServiceManager}" Content="{x:Static properties:UICommandResource.ServiceManagerText}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarSubItem Content="{x:Static self:Properties.UICommandResource.EditMenuText}">
                    <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static appproperties:ApplicationCommandsResource.Undo}" Glyph="{StaticResource UndoSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static appproperties:ApplicationCommandsResource.Redo}" Glyph="{StaticResource RedoSmall}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static appproperties:ApplicationCommandsResource.Copy}" Glyph="{StaticResource CopySmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static appproperties:ApplicationCommandsResource.Paste}" Glyph="{StaticResource PasteSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static appproperties:ApplicationCommandsResource.Cut}" Glyph="{StaticResource CutSmall}" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static appproperties:ApplicationCommandsResource.Delete}" Glyph="{StaticResource DeleteSmall}" />
                    <dxb:BarButtonItem Command="Properties" Content="{x:Static appproperties:ApplicationCommandsResource.Properties}"/>
                </dxb:BarSubItem>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>
    <Grid>
        <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
                                AutoExpandAllGroups="True"
                                AutoGenerateColumns="AddNew"
                                Name="gridDataControl" 
                                AutoPopulateColumns="False" 
                                AllowDrop="True" 
                                AllowLiveDataShaping="False" 
                                MouseDoubleClick="gridDataControl_MouseDoubleClick"
                                dx:DXSerializer.SerializationID="gridDataControl" 
                                dx:DXSerializer.StoreLayoutMode="All" 
                                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
            <dxg:GridControl.Columns>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" Header="{x:Static properties:Resources.PluginName}">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <MultiBinding Converter="{StaticResource ValueToLocalizedTextConverter}" ConverterParameter="FriendlyName">
                            <Binding Path="Name" />
                            <Binding Path="AssemblyName" />
                        </MultiBinding>
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" Header="{x:Static properties:Resources.PluginDescription}">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <MultiBinding Converter="{StaticResource ValueToLocalizedTextConverter}" ConverterParameter="Description">
                            <Binding Path="Description" />
                            <Binding Path="AssemblyName" />
                        </MultiBinding>
                    </dxg:GridColumn.DisplayMemberBinding>
                </dxg:GridColumn>
                <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=AssemblyName, Mode=OneWay}" FieldName="AssemblyName" Header="{x:Static properties:Resources.PluginAssemblyName}"/>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>

            <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False" 
                            AutoWidth="True"
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Row" 
                            MultiSelectMode="Row">
                    <!--<dxg:TableView.RowStyle>
                        <Style TargetType="{x:Type dxg:RowControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                    <Setter Property="Background" Value="LightGray" />
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxg:TableView.RowStyle>-->
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
