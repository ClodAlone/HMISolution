<UserControl x:Class="ADEditor.Controls.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpfc="clr-namespace:WPFUtilities.Controls;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:ADEditor.Properties"
             xmlns:local="clr-namespace:ADEditor"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:converters="clr-namespace:CommonControls.Converters;assembly=CommonControls"
             x:Name="GeneralSettingsPage"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="300" Loaded="OnLoaded" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:ConnectionStringConverter x:Key="ConnectionStringConverter" />
          <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
          </Style>
          <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
          </Style>
          <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"/>
          </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.GeneralSettingsApplicationName}" VerticalAlignment="Center" Margin="0,8,0,6" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ApplicationName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textApplicationName" Margin="5,0,0,0" />
        <ContentPresenter Grid.Row="0" Grid.Column="2" 
                              Content="{Binding ElementName=textApplicationName, Path=(Validation.Errors).CurrentItem}" Margin="0,0,0,29" Grid.RowSpan="2"/>

        <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.LogConnectionString}" VerticalAlignment="Center" Margin="0,9,0,5" />
        <Grid Grid.Column="1" Grid.Row="1" Margin="5,1,0,28" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                         x:Name="textLogConnection">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource ConnectionStringConverter}" 
                                  ValidatesOnDataErrors="True" UpdateSourceTrigger="PropertyChanged">
                        <Binding Path="EventDefaultConnection" Mode="TwoWay" />
                        <Binding Path="Document" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" Mode="OneWay" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
            <Button Grid.Column="1" Click="textLogConnection_DefaultButtonClick" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Click="textLogConnection_DlgButton_Clear" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
        </Grid>
        <ContentPresenter Grid.Row="2" Grid.Column="1" 
                              Content="{Binding ElementName=textLogConnection, Path=(Validation.Errors).CurrentItem}" Margin="0,2,0,27" Grid.RowSpan="2"/>

        <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.LogMaxAge}" VerticalAlignment="Center" />
        <wpfc:TimeSpanEdit x:Name="textEditMaxAge" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               TimeSpan="{Binding EventMaxAge, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                               MinValue="0"
                               Margin="5,0,0,0"
                               Validation.ErrorTemplate="{x:Null}" 
                               ValidateOnTextInput="False" AllowSpinOnMouseWheel="False" />

        <ContentPresenter Grid.Row="2" Grid.Column="2" 
            Content="{Binding ElementName=textEditMaxAge, Path=(Validation.Errors).CurrentItem}"/>
        
        <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.ErrorThreshold}" VerticalAlignment="Center" Margin="0,10,0,4" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ErrorThreshold, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     x:Name="textErrorthreshold" Margin="5,0,0,0" />
        <ContentPresenter Grid.Row="3" Grid.Column="2" 
                              Content="{Binding ElementName=textErrorthreshold, Path=(Validation.Errors).CurrentItem}" Margin="0,2,0,27" Grid.RowSpan="2"/>

        <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.ErrorDelay}" VerticalAlignment="Center" Margin="0,10,0,4" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ErrorDelay, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                     x:Name="textErrorDelay" Margin="5,0,0,0" />
        <ContentPresenter Grid.Row="4" Grid.Column="2" 
                              Content="{Binding ElementName=textErrorDelay, Path=(Validation.Errors).CurrentItem}" Margin="0,2,0,27" Grid.RowSpan="2"/>

        <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.UseLocalDateTime}" VerticalAlignment="Center" Margin="0,12,0,2" />
        <CheckBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" 
                      IsChecked="{Binding UseLocalDateTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                      x:Name="chkUseLocalDateTime" Margin="5,8,0,0" />

        <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.NotifyEveryStateChange}" VerticalAlignment="Center" Margin="0,13,0,1" />
        <CheckBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding NotifyEveryStateChange, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkNotifyEveryStateChange" Margin="5,8,0,0" />

        <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.CustomMessage}" VerticalAlignment="Center" Margin="0,14,0,0" />
        <CheckBox Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding CustomMessage, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkCustomMessage" Checked="OnVerifyCustomMessageCheck" Margin="5,8,0,0"/>
        <GroupBox Header="{x:Static properties:Resources.CustomMessageGroup}" Grid.Row="9" Grid.ColumnSpan="2" IsEnabled="{Binding CustomMessage}"
                  Visibility="{Binding Path=CustomMessage, Mode=OneWay, 
                            Converter={StaticResource BoolToVisibilityConverter}, 
                            UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,1"  >
            <Grid x:Name="CustomMessageGrid" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.DateTime}" VerticalAlignment="Center" />
                <CheckBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding AddDateTime, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkDateTime" Unchecked="OnVerifyCustomMessageCheck"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.NotificationName}" VerticalAlignment="Center" />
                <CheckBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding AddNotificationName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkNotificationName" Unchecked="OnVerifyCustomMessageCheck"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.AlarmState}" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding AddAlarmState, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkAlarmState" Unchecked="OnVerifyCustomMessageCheck"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static properties:Resources.NotificationText}" VerticalAlignment="Center" />
                <CheckBox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding AddNotificationText, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkNotificationText" Unchecked="OnVerifyCustomMessageCheck"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static properties:Resources.ServerText}" VerticalAlignment="Center" />
                <CheckBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" 
                  IsChecked="{Binding AddServerText, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                  x:Name="chkServerText" Unchecked="OnVerifyCustomMessageCheck"/>

            </Grid>
        </GroupBox>
        <GroupBox Header="{x:Static properties:Resources.ProrityTitle}" Background="{x:Null}"
                  Grid.Row="11" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="0,10,0,0" >
            <Grid x:Name="PriorityDelayGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.Priority}" HorizontalAlignment="Center"  VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static properties:Resources.DelayPri}" HorizontalAlignment="Center"  VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{x:Static properties:Resources.Priority}" HorizontalAlignment="Center"  VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="6" Text="{x:Static properties:Resources.DelayPri}" HorizontalAlignment="Center"  VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.Pri0}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay0" Grid.Row="1" Grid.Column="2"  Text="{Binding PriorityDelay0, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="4" Text="{x:Static properties:Resources.Pri5}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay5" Grid.Row="1" Grid.Column="6"  Text="{Binding PriorityDelay5, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.Pri1}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay1" Grid.Row="2" Grid.Column="2"  Text="{Binding PriorityDelay1, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="4" Text="{x:Static properties:Resources.Pri6}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay6" Grid.Row="2" Grid.Column="6"  Text="{Binding PriorityDelay6, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static properties:Resources.Pri2}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay2" Grid.Row="3" Grid.Column="2"  Text="{Binding PriorityDelay2, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Grid.Column="4" Text="{x:Static properties:Resources.Pri7}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay7" Grid.Row="3" Grid.Column="6"  Text="{Binding PriorityDelay7, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static properties:Resources.Pri3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay3" Grid.Row="4" Grid.Column="2"  Text="{Binding PriorityDelay3, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Grid.Column="4" Text="{x:Static properties:Resources.Pri8}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay8" Grid.Row="4" Grid.Column="6"  Text="{Binding PriorityDelay8, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static properties:Resources.Pri4}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay4" Grid.Row="5" Grid.Column="2"  Text="{Binding PriorityDelay4, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <TextBlock Grid.Row="5" Grid.Column="4" Text="{x:Static properties:Resources.Pri9}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBox Name="Delay9" Grid.Row="5" Grid.Column="6"  Text="{Binding PriorityDelay9, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" />

            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
