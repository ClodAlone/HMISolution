<UserControl x:Class="ADEditor.ADEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:self="clr-namespace:ADEditor"
             xmlns:Controls="clr-namespace:ADEditor.Controls"
             xmlns:properties="clr-namespace:ADEditor.Properties"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewPlugin}" 
                    Executed="OnAddNewPlugin" 
                    CanExecute="CanAddNewPlugin" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.EditPlugin}" 
                    Executed="OnEditPlugin" 
                    CanExecute="CanEditPlugin" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.RunTestPlugin}" 
                    Executed="OnRunTestPlugin" 
                    CanExecute="CanRunTestPlugin" />

        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

        <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    Executed="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />
            
        <CommandBinding Command="ApplicationCommands.Redo"
                    Executed="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.StartServer}" 
                    Executed="OnStartServer" 
                    CanExecute="CanStartServer" />
        <CommandBinding Command="{x:Static self:UIGeneralCommands.StopServer}" 
                    Executed="OnStopServer" 
                    CanExecute="CanStopServer" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNotification}" 
                    Executed="OnAddNotification" 
                    CanExecute="CanAddNotification" />
        
        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewFolder}" 
                    Executed="OnAddNewFolder" 
                    CanExecute="CanAddNewFolder" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.ServiceManager}" 
                    Executed="OnServiceManager" 
                    CanExecute="CanServiceManager" />

        <!--<CommandBinding Command="{x:Static self:UIGeneralCommands.ImportAlarms}" 
                    Executed="OnImportAlarms" 
                    CanExecute="CanImportAlarms" />-->

    </UserControl.CommandBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml"/>
                <ResourceDictionary Source="/SharedResources;component/Resources/AlarmDispatcher.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HorizontalTile" TargetType="dxlc:Tile">
                <Setter Property="VerticalHeaderAlignment" Value="Top" />
                <Setter Property="HorizontalHeaderAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{x:Null}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid Background="Gray" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Padding="3,0,0,0" Text="{Binding Path=Header, RelativeSource={RelativeSource AncestorType=dxlc:Tile}}" />
                                <Image Grid.Column="1" Margin="1" Source="{StaticResource TileMaximizeSmall}" Height="16" Width="16" />
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--<self:MenuControl/>-->
        <dx:DXTabControl Name="tabControlExt">
            <dx:DXTabItem Header="{x:Static properties:Resources.tabGeneralSetting}"
                          x:Name="tabGeneralSettings" Glyph="{StaticResource ADGeneralSettingsSmall}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Expander x:Name="expanderSettings" Grid.Row="0" Header="{x:Static properties:Resources.Settings}" IsExpanded="True">
                        <Grid x:Name="Row1" VerticalAlignment="Top" Margin="2,15,2,10">
                            <!-- Settings Area-->
                            <Controls:GeneralSettings x:Name="generalSettings" 
                              FontSize="{Binding FontSize,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                              FontFamily="{Binding FontFamily,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
                        </Grid>
                    </Expander>
                    <Expander x:Name="expanderTransport" Grid.Row="1" Header="{x:Static properties:Resources.Transports}" IsExpanded="True">
                        <Grid Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" x:Name="Row03" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Name="btnAddTr" Content="{x:Static properties:Resources.AddTransports}" Click="TransportAdd_Click" Height="50" />
                                <Button Grid.Column="1" Name="btnEditTr" Content="{x:Static properties:Resources.EditTransports}" Click="TransportEdit_Click" Height="50" />
                                <Button Grid.Column="2" Name="btnDelTr" Content="{x:Static properties:Resources.DeleteTransports}"  Click="TransportDelete_Click" Height="50" />
                            </Grid>
                            <Grid x:Name="Row3" Grid.Row="1" Margin="2,2,2,2">
                                <!-- Transports Area-->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                </Grid.RowDefinitions>
                                <dxg:GridControl Grid.Row="1" Name="TransportGrid" MouseDoubleClick="TransportEdit_Click" >
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="{x:Static properties:Resources.NameTransports}" FieldName="Path" Width="300"/>
                                        <dxg:GridColumn Header="{x:Static properties:Resources.EnabledTransports}" FieldName="Enabled" Width="100" ReadOnly="True" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView  VerticalScrollbarVisibility="Auto" HorizontalScrollbarVisibility="Auto" ShowGroupPanel="False" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </Grid>
                        </Grid>
                    </Expander>
                    <Expander x:Name="expanderStatus" Grid.Row="2" Header="{x:Static properties:Resources.Status}" IsExpanded="True">
                        <Grid x:Name="Row5" Margin="2,10,2,0">
                            <!-- Events Area-->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Auto"
                                        Name="Scroll">
                                <TextBlock Name="txtevent"/>
                            </ScrollViewer>
                        </Grid>
                    </Expander>
                </Grid>
            </dx:DXTabItem>
            <dx:DXTabItem Header="{x:Static properties:Resources.tabPluginList}"
                          x:Name="tabPluginList" Glyph="{StaticResource ADPluginsSmall}">
                    <Grid x:Name="inPluginGrid" Grid.Column="1" Grid.Row="1"/>
                <!--</Grid>-->
            </dx:DXTabItem>
            <dx:DXTabItem Header="{x:Static properties:Resources.tabNotifications}" 
                          x:Name="tabNotifications" Glyph="{StaticResource ADNotificationSmall}">
                <Grid x:Name="NotificationGrid">
                    <Grid x:Name="inNotificationGrid" Grid.Column="1" Grid.Row="1"/>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Grid>
</UserControl>
