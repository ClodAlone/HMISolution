<dxb:BarManager
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="ADEditor.MenuControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADEditor.MenuControls"
             mc:Ignorable="d"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="ADEditorBarManagerToolbar"
             d:DesignHeight="450" d:DesignWidth="800">
    <dxb:BarManager.Items>
        <local:BarCommonItems />
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar dxb:MergingProperties.Name="adToolbar" x:Name="adToolBar1"
                GlyphSize="Small" ShowDragWidget="True" 
                AllowCustomizationMenu="True" 
                AllowDrop="True" 
                AllowHide="True"
                AllowCollapse="True"
                AllowQuickCustomization="True">

            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewPlugin"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biEditPlugin"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biRunTestPlugin"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewFolder"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNotification"/>

            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStartServer"/>
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biStopServer"/>
            <dxb:BarItemLinkSeparator />
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biServiceManager"/>
        </dxb:Bar>
    </dxb:BarManager.Bars>
</dxb:BarManager>
