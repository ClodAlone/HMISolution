<dxb:BarSubItem
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" x:Class="ADEditor.MenuControls.BarCommonItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:ADEditor.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:self="clr-namespace:ADEditor"
             mc:Ignorable="d">
   <dxb:BarSubItem.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
          <ResourceDictionary Source="/SharedResources;component/Resources/AlarmDispatcher.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewAlarmDispatcher" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="50" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="50" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectAlarmDispatcher" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="10" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <!-- DocumentEditorRibbonTitle -->
            <dxb:BarButtonItem x:Name="biServiceManager" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                             Glyph="{StaticResource UFUASServiceManager}"  
                             Command="{x:Static self:UIGeneralCommands.ServiceManager}" />
            <dxb:BarSubItem Content="{x:Static properties:Resources.PluginsItemText}">
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                    x:Name="biAddNewPlugin"   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.AddNewPlugin}" 
                                       Content="{x:Static properties:UICommandResource.AddNewPluginText}" Glyph="{StaticResource ADPluginsSmall}"/>
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                    x:Name="biEditPlugin"   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.EditPlugin}" 
                                       Content="{x:Static properties:UICommandResource.EditPluginText}" Glyph="{StaticResource ADEditPluginSmall}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                    x:Name="biRunTestPlugin"   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.RunTestPlugin}"
                                       Content="{x:Static properties:UICommandResource.RunTestPluginText}" Glyph="{StaticResource ADRunTestSmall}"/>
            </dxb:BarSubItem>
            <dxb:BarSubItem Content="{x:Static properties:Resources.NotificationsItemText}">
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                    x:Name="biAddNewFolder"   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.AddNewFolder}"
                                       Content="{x:Static properties:UICommandResource.AddNewFolderText}" Glyph="{StaticResource AddFolderSmall}"/>
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   x:Name="biAddNotification"    RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.AddNotification}"
                                       Content="{x:Static properties:UICommandResource.AddNotificationText}" Glyph="{StaticResource ADAddNotifySmall}"/>
            </dxb:BarSubItem>
            <dxb:BarSubItem Content="{x:Static properties:Resources.ServerItemText}">
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                    x:Name="biStartServer"   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.StartServer}"
                                       Content="{x:Static properties:UICommandResource.StartServerText}" Glyph="{StaticResource ADStartServerSmall}"/>
                <dxb:BarButtonItem CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                    x:Name="biStopServer"   RibbonStyle="SmallWithText" Command="{x:Static self:UIGeneralCommands.StopServer}"
                                       Content="{x:Static properties:UICommandResource.StopServerText}" Glyph="{StaticResource ADStopServerSmall}"/>
            </dxb:BarSubItem>

            
            
        </dxb:BarSubItem>
    </dxb:BarSubItem>
</dxb:BarSubItem>
