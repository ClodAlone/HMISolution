<UserControl x:Class="ADEditor.PropertyDataTemplate.NotificationItemPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:common="clr-namespace:OPCUAViewModel.Converters;assembly=OPCUAViewModel"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:UFUACommonControls.Converters;assembly=UFUACommonControls"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <common:UriConverter x:Key="UriConverter" />
            <common:DeclaringTypeToVisbilityConverter x:Key="DeclaringTypeToVisbilityConverter" />
            <converters:TagEntityReferenceConverter x:Key="TagConverter"/>
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="2" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <dxe:ComboBoxEdit
            x:Name="projectCmb" Grid.Row="0" Margin="0,1,0,3"
            Visibility="{Binding ProjectCmbBoxVisibility, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            Text="{Binding SelectedProjectName, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            PopupOpening="ProjectCmb_PopupOpening"
            SelectedIndexChanged="projectCmb_SelectedIndexChanged"
            GotFocus="projectCmb_GotFocus"
            ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
        </dxe:ComboBoxEdit>
        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <dxe:ComboBoxEdit HorizontalAlignment="Stretch" Width="Auto"
                        x:Name="uriLabel" 
                        Text="{Binding Path=Tag,ElementName=uriButton,Converter={StaticResource TagConverter}, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" 
                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                        PopupOpening="uriLabel_PopupOpening"
                        LostFocus="uriLabel_LostFocus" GotFocus="uriLabel_GotFocus" PreviewKeyDown="uriLabel_KeyDown" 
                        SelectedIndexChanged="uriLabel_SelectedIndexChanged"
                        ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup" Margin="0,0,0,0"/>
                <TextBox x:Name="txturiLabel" HorizontalAlignment="Stretch" Width="Auto"
                        Text="{Binding Path=Tag,ElementName=uriButton,Converter={StaticResource TagConverter}, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}" Margin="0,0,0,0"/>
            </Grid>

        </DockPanel>
        <Separator Grid.Row="2" Height="2" 
                   Visibility="{Binding SeparatorVisibility, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        <ContentPresenter Grid.Column="1" Grid.Row="1" 
                Content="{Binding ElementName=text, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
