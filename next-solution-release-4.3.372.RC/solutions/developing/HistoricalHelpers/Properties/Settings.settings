<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="HistoricalHelpers.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="SupportedTypeFilter" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Project Files (*.UFProject)|*.UFProject|All Files (*.*)|*.*</Value>
    </Setting>
    <Setting Name="xaml" Type="System.String" Scope="Application">
      <Value Profile="(Default)">ScreenManager</Value>
    </Setting>
    <Setting Name="DocumentManagersPath" Type="System.String" Scope="Application">
      <Value Profile="(Default)">DocumentManagers</Value>
    </Setting>
    <Setting Name="script" Type="System.String" Scope="Application">
      <Value Profile="(Default)">ScriptManager</Value>
    </Setting>
    <Setting Name="UFProject" Type="System.String" Scope="Application">
      <Value Profile="(Default)">UFProjectManager</Value>
    </Setting>
    <Setting Name="report" Type="System.String" Scope="Application">
      <Value Profile="(Default)">ReportManager</Value>
    </Setting>
  </Settings>
</SettingsFile>