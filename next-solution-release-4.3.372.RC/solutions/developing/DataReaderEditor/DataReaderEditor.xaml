<UserControl x:Class="DataReaderEditor.DataReaderEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:DataReaderEditor.Properties"
             xmlns:converters="clr-namespace:DataReaderEditor.Converters"
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             mc:Ignorable="d" 
             Height="400" Width="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <TabControl Grid.Row="0">
            <TabItem Header="{x:Static properties:Resources.SQLTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.DataProviderTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataProvider}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.ConnectionTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Connection}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding EditConnection}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button  Grid.Column="1" Command="{Binding ClearCommand}" CommandParameter="Connection">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.SelectTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="2" LostFocus="select_LostFocus" Grid.Column="1" Text="{Binding Select, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding EditSelect}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ClearCommand}" CommandParameter="Select">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static properties:Resources.WhereTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Where, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding EditWhere}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ClearCommand}" CommandParameter="Where">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static properties:Resources.GroupByTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GroupBy, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding EditGroupBy}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ClearCommand}" CommandParameter="GroupBy">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static properties:Resources.SortTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Sort, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding EditSort}">
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ClearCommand}" x:Name="sort" CommandParameter="Sort">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static properties:Resources.TimeColumnsTile}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TimeColumn, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Width="{Binding Width,ElementName=sort}" Command="{Binding ClearCommand}" CommandParameter="TimeColumn">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{x:Static properties:Resources.DataColumnsTile}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DataColumn, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <Grid Grid.Row="7" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Width="{Binding Width,ElementName=sort}" Command="{Binding ClearCommand}" CommandParameter="DataColumn">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.XMLTitle}" x:Name="xmlTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.XMLUriTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding XmlUri}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button>
                            <Button.Content>
                                <Image Source="{StaticResource SelectPathSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding ClearCommand}" CommandParameter="XmlUri">
                            <Button.Content>
                                <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.XMLItemsTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding XmlItems}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button>
                            <Button.Content>
                                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding ClearCommand}" CommandParameter="XmlItems">
                            <Button.Content>
                                <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.MaxTakeTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxTake, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Grid>

            </TabItem>
        </TabControl>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="2,2,2,2" Text="{x:Static properties:Resources.DataTitle}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Margin="2,2,2,2" Command="{Binding GetDataItems}" Width="40">
                    <Button.Content>
                        <Image Source="{StaticResource RefreshSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Button x:Name="btnClear" Grid.Column="2" Margin="2,2,2,2" Command="{Binding ClearCommand}" CommandParameter="DataItems" Width="40">
                    <Button.Content>
                        <Image Source="{StaticResource RemoveSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <Viewbox Grid.Column="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <cc:CircularProgressBar x:Name="busyControl" />
                </Viewbox>
                <ScrollViewer Grid.Column="3" Visibility="{Binding IsFault, Converter={StaticResource BoolToVisibilityConverter}}" 
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                    <TextBlock Margin="2,2,2,2" Text="{Binding LastError}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="Red" />
                </ScrollViewer>
            </Grid>
            <dxg:GridControl MinWidth="10" Visibility="Visible"
                AutoExpandAllGroups="True"
                AutoGenerateColumns="AddNew"
                Name="gridDataControl1" Grid.Row="1"
                AutoPopulateColumns="True" 
                AllowDrop="False" 
                ItemsSource="{Binding DataItems}"
                AllowLiveDataShaping="False"
                dx:DXSerializer.SerializationID="gridDataControl" 
                dx:DXSerializer.StoreLayoutMode="All" 
                dxg:DataControlSerializationOptions.AddNewColumns="False" 
                dxg:DataControlSerializationOptions.RemoveOldColumns="False">
                <!--<dxg:GridControl.Columns>
                    <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=ID, Mode=OneWay}" FieldName="ID" Header="ID"/>
                </dxg:GridControl.Columns>-->
                <dxg:GridControl.View>

                    <dxg:TableView x:Name="tableView" AllowEditing="True"
                            FadeSelectionOnLostFocus="False" 
                            BestFitMode="VisibleRows"
                            AllowBestFit="True" 
                            AllowResizing="True"
                            ShowGroupPanel="True"
                            ShowSearchPanelMode="Always" SearchPanelFindMode="Always" 
                            ShowSearchPanelMRUButton="True"
                            ShowFilterPanelMode="ShowAlways" 
                            NavigationStyle="Row" 
                            MultiSelectMode="Row">
                        <!--<dxg:TableView.RowStyle>
                            <Style TargetType="{x:Type dxg:RowControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxg:TableView.RowStyle>-->
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Stretch">
                <TextBlock Text="{x:Static properties:Resources.TimeColumnsTile}"/>
                <ComboBox SelectedItem="{Binding TimeColumn}" ItemsSource="{Binding TimeColumns}" Width="200"/>
                <TextBlock Text="{x:Static properties:Resources.DataColumnsTile}"/>
                <ComboBox SelectedItem="{Binding DataColumn}" ItemsSource="{Binding DataColumns}" Width="200"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
