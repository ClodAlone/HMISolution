<UserControl x:Class="UFMenuEditor.Controls.NewMenuDefinition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:UFMenuEditor.Properties" 
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Width="300" Height="300"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static properties:Resources.NewMenuDefinitionTitle}" VerticalAlignment="Center" FontWeight="Bold" />
            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.NewMenuDefinitionMenuName}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, Mode=OneWay}" IsReadOnly="True"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="textEditName" />

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.NewMenuDefinitionDescription}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Description}" x:Name="textEditDesc" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

        </Grid>
    </ScrollViewer>
</UserControl>
