<dxb:BarSubItem x:Class="UFMenuEditor.MenuControls.BarCommonItems"
             xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:UFMenuEditor"
             xmlns:properties="clr-namespace:UFMenuEditor.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d">
  <dxb:BarSubItem.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
        <ResourceDictionary Source="/SharedResources;component/Resources/Menu.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </dxb:BarSubItem.Resources>
    <dxb:BarSubItem x:Name="biViewMenuEditor" Content="{x:Static translatableMenu:Resources.ViewRibbonTitle}">
        <dxb:BarSubItem MergeOrder="130" Content="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" MergeType="MergeItems">
            <dxb:BarCheckItem CloseSubMenuOnClick="False" MergeOrder="130" ToolTipService.ShowOnDisabled="True" CategoryName="{x:Static translatableMenu:Resources.ToolbarHeaderTitle}" 
                              IsChecked="{Binding IsToolbarShown, Mode=OneWay}" x:Name="toolbarMenuItem"
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                              Command="{x:Static self:UIGeneralCommands.ShowToolbar}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
    <dxb:BarSubItem x:Name="biProjectMenuEditor" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
        <dxb:BarSubItem MergeOrder="100" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems" IsVisible="{Binding Path=IsMenuShown, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type wpfutilities:BarManagerBase}}}">
            <!-- MenuEditorRibbonHeader -->
            <dxb:BarButtonItem MergeOrder="20" x:Name="biAddMenuItem" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                     Glyph="{StaticResource MMAddNewMenuItem}"  
                                 Command="{x:Static self:UIGeneralCommands.AddNewMenuItem}" />
            <dxb:BarItemLinkSeparator MergeOrder="25" />
            <dxb:BarButtonItem MergeOrder="30" x:Name="biMoveItemUp" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                     Glyph="{StaticResource MMMoveItemUp}"  
                                 Command="self:UIGeneralCommands.MoveItemUp" />
            <dxb:BarButtonItem MergeOrder="40" x:Name="biMoveItemDown" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                     Glyph="{StaticResource MMMoveItemDown}"  
                                 Command="self:UIGeneralCommands.MoveItemDown" />
            <dxb:BarItemLinkSeparator MergeOrder="45" />
            <dxb:BarButtonItem MergeOrder="50" x:Name="biTestMenu" Content="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}" 
                                     Glyph="{StaticResource MMTestMenu}"  
                                 Command="{x:Static self:UIGeneralCommands.TestMenu}" />
        </dxb:BarSubItem>
    </dxb:BarSubItem>
</dxb:BarSubItem>
