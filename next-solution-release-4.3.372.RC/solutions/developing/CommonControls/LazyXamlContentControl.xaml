<UserControl x:Class="CommonControls.LazyXamlContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommonControls"
             mc:Ignorable="d" IsVisibleChanged="HandleVisibleChanged"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="Transparent" x:Name="contentGrid"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <!--<RowDefinition Height="Auto" />-->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:PS3CircularProgressBar Grid.Row="1" x:Name="progressBar" VerticalAlignment="Center" HorizontalAlignment="Center" Width="32" Height="32" Margin="5,5,5,5" />
        <!--<TextBlock Grid.Row="0" HorizontalAlignment="Center" x:Name="textBlock"/>-->
        <ContentControl Grid.Row="1" x:Name="contentControl" Loaded="Content_Loaded" Unloaded="Content_Unloaded" />
    </Grid>
</UserControl>
