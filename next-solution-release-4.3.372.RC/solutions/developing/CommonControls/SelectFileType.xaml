<UserControl x:Class="CommonControls.SelectFileType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CommonControls.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SharedResources;component/Resources/CommonControls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <Button Margin="10,10,10,10" Click="Button_Click_FileSource">
                <Grid Height="84">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource CCCurrentFolder}" Margin="10" HorizontalAlignment="Right"/>
                    <TextBlock MinWidth="{Binding ActualWidth, ElementName=dataSource}" x:Name="fileSource" Text="{x:Static properties:Resources.FileSource}" Grid.Column="1" FontSize="30" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Margin="10,10,10,10" Click="Button_Click_DataSource">
                <Grid Height="84">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource CCData}" Margin="10" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="dataSource" MinWidth="{Binding ActualWidth, ElementName=fileSource}" Text="{x:Static properties:Resources.DataSource}" Grid.Column="1" FontSize="30" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
