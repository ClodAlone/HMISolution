<UserControl x:Class="CommonControls.MySQLConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:local="clr-namespace:CommonControls"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition/>
                    
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
                <Label HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,2,6,2" Grid.Column="0" Grid.Row="0" Name="label1" Content="{x:Static properties:Resources.lblMySQLServer}"/>
                <!--<ComboBox Grid.Column="2" Grid.Row="0" Name="tbServer" Text="" 
                          DropDownOpened="tbServer_PopupOpening" IsEditable="True" 
                          SelectionChanged="tbServer_SelectionChanged" 
                          TextBoxBase.TextChanged="tbServer_TextChanged" />-->
                <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2" Grid.Column="1" Grid.Row="0" Name="tbServer" IsEnabled="True"/>
                <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" Name="label2" Content="{x:Static properties:Resources.lblDatabase}" />
                <!--<ComboBox Grid.Column="2" Grid.Row="2" Name="cbDatabase" DropDownOpened="cbDatabase_PopupOpening" IsEditable="True" />-->
                <TextBox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="1"  Name="tbDatabase" IsEnabled="True"/>
                <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="2" Name="label6" Content="{x:Static properties:Resources.lblLogin}" />
                <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2" Grid.Column="1" Grid.Row="2" Name="tbLogin" IsEnabled="True"/>
                <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="3" Name="label7" Content="{x:Static properties:Resources.lblPassword}" />
                <dxe:PasswordBoxEdit Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.Row="3" Name="tbPassword" IsEnabled="True" />
            </Grid>
       
</UserControl>
