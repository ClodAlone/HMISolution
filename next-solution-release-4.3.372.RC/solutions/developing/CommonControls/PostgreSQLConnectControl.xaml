<UserControl x:Class="CommonControls.PostgreSQLConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommonControls"
             mc:Ignorable="d" d:Width="450" d:Height="200">
    <Grid Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static properties:Resources.lblHostName}" />
        <TextBox Margin="2" Grid.Column="1" Name="tbServer" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="True" />
        <Label Margin="2,2,6,2" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static properties:Resources.lblPortNumber}" />
        <dxe:SpinEdit Margin="2" Grid.Row="1" Grid.Column="1" x:Name="portNumber" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextBlock.TextAlignment="Left" 
                      AllowSpinOnMouseWheel="False" ShowError="False" AllowRoundOutOfRangeValue="False" dxe:NumericMaskOptions.AlwaysShowDecimalSeparator="False"
                      InvalidValueBehavior="AllowLeaveEditor" MaskType="Numeric" Increment="1" MinValue="0" MaxValue="65535" />
        <Label Margin="2,2,6,2" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center"  Content="{x:Static properties:Resources.lblDatabase}" />
        <TextBox Margin="2" Grid.Row="2" Grid.Column="1" Name="tbDatabase" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="True"/>
        <Label Margin="2,2,6,2" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center"  Content="{x:Static properties:Resources.lblLogin}" />
        <TextBox Margin="2" Grid.Row="3" Grid.Column="1" Name="tbLogin" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="True" />
        <Label Margin="2,2,6,2" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Center"  Content="{x:Static properties:Resources.lblPassword}" />
        <dxe:PasswordBoxEdit Margin="2" Grid.Column="1" Grid.Row="4" Name="tbPassword" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="True" />
        <Label Margin="2,2,6,2" Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Center"  Content="{x:Static properties:Resources.PostgreTimezone}" />
        <TextBox Margin="2" Grid.Row="5" Grid.Column="1" Name="tbTimezone" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="True"/>
    </Grid>
</UserControl>