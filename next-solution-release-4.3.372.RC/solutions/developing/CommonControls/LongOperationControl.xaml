<UserControl x:Class="CommonControls.LongOperationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="clr-namespace:CommonControls" Background="{x:Null}"
             xmlns:properties="clr-namespace:CommonControls.Properties">
    <Grid Background="Black" Opacity="0.5" Cursor="Wait">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <cc:PS3CircularProgressBar Margin="20,20,20,20" HorizontalAlignment="Right" x:Name="busyControl" Width="100" Height="100" MaxWidth="100" MaxHeight="100"/>
        <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center"
                   FontFamily="Segoe UI" FontWeight="Light"
                   HorizontalAlignment="Left" Foreground="White" FontSize="32" Grid.Column="1"/>
    </Grid>
</UserControl>
