                    <EasingColorKeyFrame KeyTime="0:0:5" Value="DimGray"/>
                </ColorAnimationUsingKeyFrames>
                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="path2">
                    <EasingColorKeyFrame KeyTime="0" Value="DimGray"/>
                    <EasingColorKeyFrame KeyTime="0:0:2.5" Value="Red"/>
                    <EasingColorKeyFrame KeyTime="0:0:5" Value="DimGray"/>
                </ColorAnimationUsingKeyFrames>
            </Storyboard>
        </Viewbox.Resources>
        <Viewbox.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource Storyboard1}"/>
