<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="CommonControls.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="lblSQLAzurePrefix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">tcp:</Value>
    </Setting>
    <Setting Name="lblSQLAzureSuffix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">.database.windows.net</Value>
    </Setting>
    <Setting Name="SQLiteFileType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">SQLite Databases (*.db;*.sqlite)|*.db;*.sqlite|All Files (*.*)|*.*</Value>
    </Setting>
    <Setting Name="PostgreSQLDefaultHost" Type="System.String" Scope="Application">
      <Value Profile="(Default)">localhost</Value>
    </Setting>
    <Setting Name="PostgreSQLDefaultPortName" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">5432</Value>
    </Setting>
    <Setting Name="PostgreSQLDefaultDatabase" Type="System.String" Scope="Application">
      <Value Profile="(Default)">postgres</Value>
    </Setting>
    <Setting Name="PostgreSQLDefaultTimezone" Type="System.String" Scope="Application">
      <Value Profile="(Default)">UTC</Value>
    </Setting>
  </Settings>
</SettingsFile>