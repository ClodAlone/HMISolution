<UserControl x:Class="CommonControls.SQLAzureConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    
            <!--<TextBlock Width="500" FontSize="13" Name="tbDescription" TextWrapping="Wrap" Margin="0,0,0,32" />-->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition  Width="Auto"/>
                    <ColumnDefinition Width="Auto"  />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,2,6,2"  Name="label1"/>
                <TextBox Grid.ColumnSpan="2" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2" Name="tbServer" Text="" />
                <Label Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,2,6,2" Grid.Row="0" Name="label3"/>
                <Label Grid.Column="0" Grid.Row="1" Name="label2" Content="{x:Static properties:Resources.lblDatabase}" />
                <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Grid.Row="1" Name="cbDatabase" />
                <Label HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,2,6,2"  Grid.Column="0" Grid.Row="2" Name="label6" Content="{x:Static properties:Resources.lblLogin}" />
                <TextBox Grid.ColumnSpan="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2" Grid.Row="2" Name="tbLogin" IsEnabled="True"/>
                <Label Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,2,6,2" Grid.Row="3" Name="label7" Content="{x:Static properties:Resources.lblPassword}" />
                <dxe:PasswordBoxEdit Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2" Grid.Column="1" Grid.Row="3" Name="tbPassword" IsEnabled="True"/>
            </Grid>
            
</UserControl>
