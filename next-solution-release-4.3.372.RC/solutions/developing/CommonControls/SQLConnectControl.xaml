<UserControl x:Class="CommonControls.SQLConnectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:CommonControls.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    
            
            <Grid  HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Name="label1" Content="{x:Static properties:Resources.lblSQLServer}" />
                <ComboBox Margin="2" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Name="tbServer"  DropDownOpened="tbServer_PopupOpening" 
                          IsEditable="True" SelectionChanged="tbServer_SelectionChanged" 
                          TextBoxBase.TextChanged="tbServer_TextChanged"/>
                <Label Margin="2,2,6,2" Grid.Column="0" Grid.Row="1" Name="label2" Content="{x:Static properties:Resources.lblDatabase}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ComboBox Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" Name="cbDatabase" DropDownOpened="cbDatabase_PopupOpening" IsEditable="True" />
                <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="2" Name="label6" Content="{x:Static properties:Resources.lblLogin}"/>
                <TextBox Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.Row="2" Text="sa" Name="tbLogin" IsEnabled="True"/>
                <Label Margin="2,2,6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="3" Name="label7" Content="{x:Static properties:Resources.lblPassword}"/>
                <dxe:PasswordBoxEdit HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2" Grid.Column="1" Grid.Row="3" Name="tbPassword" IsEnabled="True"/>
                <StackPanel Orientation="Vertical" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left">
                    <RadioButton Name="rbWindowsAuthentication" IsChecked="True" Margin="0,0,0,4" GroupName="AutentificationGroup" Content="{x:Static properties:Resources.lblWinAuth}" />
                    <RadioButton Name="rbSQLServerAuthentication" GroupName="AutentificationGroup" Content="{x:Static properties:Resources.lblSQLAuth}"/>
                </StackPanel>
            </Grid>
            
        
</UserControl>
