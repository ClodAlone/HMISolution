<ComboBox x:Class="ComboBoxControls.ComboControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             xmlns:properties="clr-namespace:ComboBoxControls.Properties"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}"
             Foreground="{dxi:ThemeResource {dxet:TextEditThemeKey ResourceKey=CaretBrush}}"
             mc:Ignorable="d" 
             IsSynchronizedWithCurrentItem="True" SelectionChanged="combobox_SelectionChanged" ScrollViewer.ScrollChanged="comboBox_ScrollChanged"
    		 Text="{x:Static properties:Resources.ComboBoxTitle}" IsTextSearchEnabled="False" IsEditable="False" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
             Height="51" Width="130.5" 
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <ComboBox.ItemContainerStyle>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{Binding Foreground,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}"/>
        </Style>
    </ComboBox.ItemContainerStyle>
</ComboBox>
