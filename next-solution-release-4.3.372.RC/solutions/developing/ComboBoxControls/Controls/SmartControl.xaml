<UserControl xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  
             x:Class="ComboBoxControls.Controls.SmartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Height="640" Width="960"
             xmlns:properties="clr-namespace:ComboBoxControls.Properties" 
             xmlns:converters="clr-namespace:ComboBoxControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
             xmlns:propertydatatemplate="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Click="OnAdd" ToolTip="{x:Static properties:Resources.AddButtonTitle}" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="1" IsEnabled="False" x:Name="btnDelete" 
                            ToolTip="{x:Static properties:Resources.DeleteButtonTitle}" Click="OnDelete" Margin="5">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource RemoveMinusSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="2" IsEnabled="False" x:Name="moveUp" 
                            ToolTip="{x:Static properties:Resources.MoveUpButtonTitle}" Click="OnMoveUp">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource MoveUpSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button Grid.Column="3" IsEnabled="False" x:Name="moveDown" 
                            ToolTip="{x:Static properties:Resources.MoveDownButtonTitle}" Click="OnMoveDown">
                <Button.Content>
                    <Image Margin="2" Source="{StaticResource MoveDownSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
        </Grid>
        
        <dxg:GridControl AllowDrop="False" Name="gridControl" Grid.Row="1">
            <dxg:GridControl.Columns>
                <dxg:GridColumn Validate="GridColumn_Validate" AllowDrop="False" AllowMoving="False" DisplayMemberBinding="{Binding Path=UntranslatedOptionContent, Mode=TwoWay}" Header="{x:Static properties:Resources.ContentTitle}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <propertydatatemplate:TextPropertyEditor BindingPath="Data.UntranslatedOptionContent"
                                                                         Workspace="{Binding Workspace, Mode=OneWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn Validate="GridColumn_Validate" AllowDrop="False" AllowMoving="False" DisplayMemberBinding="{Binding Path=OptionValue, Mode=TwoWay}" Header="{x:Static properties:Resources.ValueTitle}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Grid.Column="1" Grid.Row="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBox IsReadOnly="False" IsHitTestVisible="True" x:Name="text" HorizontalAlignment="Stretch" 
                                                 Text="{Binding Path=Data.OptionValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowTotalSummary="False" AutoWidth="true" ShowGroupPanel="False" 
                               CellValueChanged="tableView_CellValueChanged_1" 
                               FocusedRowChanged="tableView_FocusedRowChanged" 
                               ValidateRow="tableView_ValidateRow" 
                               InvalidRowException="tableView_InvalidRowException" />
            </dxg:GridControl.View>
        </dxg:GridControl>
    </Grid>
</UserControl>
