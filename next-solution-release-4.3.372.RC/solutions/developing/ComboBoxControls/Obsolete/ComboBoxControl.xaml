<UserControl x:Class="ComboBoxControls.ComboBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:properties="clr-namespace:ComboBoxControls.Properties"
             mc:Ignorable="d" Height="51" Width="130.5">
    <Grid x:Name="view">
        <ComboBox IsSynchronizedWithCurrentItem="True"  x:Name="combobox" SelectionChanged="combobox_SelectionChanged" 
    		Text="{x:Static properties:Resources.ComboBoxTitle}" IsTextSearchEnabled="False" IsEditable="False" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
            BorderThickness="1" BorderBrush="Transparent"
    		FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
