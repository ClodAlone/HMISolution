<ListBox x:Class="ComboBoxControls.ListBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:System="clr-namespace:System;assembly=mscorlib"
            IsSynchronizedWithCurrentItem="True" SelectionChanged="listbox_SelectionChanged" ScrollViewer.ScrollChanged="listBox_ScrollChanged"
    		IsTextSearchEnabled="False" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
            ScrollViewer.VerticalScrollBarVisibility="Auto" 
            ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Single"
     		mc:Ignorable="d" Height="51" Width="130.5"
    		HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <ListBox.Resources>
        <Style x:Key="itemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{Binding Foreground,Mode=OneWay,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}"/>
        </Style>
    </ListBox.Resources>
    <ListBox.Style>
        <Style TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource itemStyle}"/>
        </Style>
    </ListBox.Style>
</ListBox>
