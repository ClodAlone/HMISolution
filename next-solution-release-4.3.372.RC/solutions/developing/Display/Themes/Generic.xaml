<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:z="clr-namespace:Display">

    <!-- ************* -->
    <!-- Numeric Gauge -->
    <!-- ************* -->
    <!-- Digit Template -->
    <Style TargetType="z:Digit">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="z:Digit">
                    <Grid x:Name="LayoutRoot" Width="100" Height="170">
                        <Viewbox>
                            <TextBlock
							    x:Name="DefaultText"
							    Text="{TemplateBinding Value}"
							    FontSize="170"
							    FontWeight="{TemplateBinding FontWeight}"
							    FontStyle="{TemplateBinding FontStyle}"
							    FontFamily="{TemplateBinding FontFamily}"
							    VerticalAlignment="Center"
							    HorizontalAlignment="Center"
							    TextAlignment="Center"
							    Foreground="{TemplateBinding Foreground}"/>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Numeric Gauge Template -->
    <Style TargetType="z:Display">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="z:Display">
                    <Canvas x:Name="LayoutRoot" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border x:Name="Background"
								Canvas.Left="0"
								Canvas.Top="0"
								z:Gauge.SizingMethod="Explicit"
								Height="100"
								Width="200"
								BorderThickness="2"
								BorderBrush="Transparent"
								CornerRadius="4" Background="{TemplateBinding Background}">
                            <!--<Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000" Offset="0" />
                                    <GradientStop Color="#000" Offset="0.5" />
                                    <GradientStop Color="#404040" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>-->
                        </Border>
                        <Canvas x:Name="AdditionalElements"/>
                        <Canvas x:Name="Elements"/>
                        <Canvas x:Name="Cover" Canvas.Left="0" Canvas.Top="0" Width="200" Height="100" Background="Transparent">
                            <Rectangle Width="198" Height="98" StrokeThickness="2" Stroke="Transparent" Canvas.Left="1" Canvas.Top="1" RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#47ffffff" Offset="0" />
                                        <GradientStop Color="#47ffffff" Offset="0.5" />
                                        <GradientStop Color="#00ffffff" Offset="0.5" />
                                        <GradientStop Color="#00ffffff" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Canvas>
                        <Border
							x:Name="Frame"
							Canvas.Left="0"
							Canvas.Top="0"
							z:Gauge.SizingMethod="Explicit"
							Height="100"
							Width="200"
							BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
							CornerRadius="4"
						>
                            <!--<Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000" Offset="0" />
                                    <GradientStop Color="#333" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>-->
                            <!--<Border BorderThickness="1" CornerRadius="3" Margin="-1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000" Offset="0" />
                                        <GradientStop Color="#000" Offset="0.5" />
                                        <GradientStop Color="#131313" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>-->
                        </Border>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>