<UserControl x:Class="UFUserEditor.Controls.PaswordExpired"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             FocusManager.FocusedElement="{Binding ElementName=textOldPassword}"
             xmlns:properties="clr-namespace:UFUserEditor.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}" 
           mc:Ignorable="d" Width="300" Height="150">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
      <StackPanel Margin="10,10,10,10">
        <StackPanel Orientation="Vertical">
            <Label 
                  FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}"
                  Content="{x:Static properties:Resources.OldPassword}" 
                  x:Name="oldPassword" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <cc:BindablePasswordBox Grid.Column="0"
                              Height="{Binding ElementName=oldPassword, Path=ActualHeight}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Validation.ErrorTemplate="{x:Null}"
                              x:Name="textOldPassword" />
            <ContentPresenter Grid.Column="2"
                    Content="{Binding ElementName=textOldPassword, Path=(Validation.Errors).CurrentItem}"/>
            <Button DockPanel.Dock="Right" x:Name="selectButton1"
                            Height="{Binding ElementName=oldPassword, Path=ActualHeight}" 
                            FontSize="{Binding ElementName=oldPassword, Path=FontSize}" 
                            VerticalContentAlignment="Center" 
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="..." 
                            Grid.Column="1" Click="Button1_Click"/>
          </Grid>
        </StackPanel>
        <StackPanel Orientation="Vertical">
          <Label
                 FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}"
                 Content="{x:Static properties:Resources.Password}"
                 x:Name="password" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <cc:BindablePasswordBox Grid.Column="0"
                              Height="{Binding ElementName=oldPassword, Path=ActualHeight}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Validation.ErrorTemplate="{x:Null}"
                              Password="{Binding Password, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              x:Name="pswEditPwd" />
            <ContentPresenter Grid.Column="2"
                    Content="{Binding ElementName=pswEditPwd, Path=(Validation.Errors).CurrentItem}"/>
            <Button DockPanel.Dock="Right" x:Name="selectButton2"
                            Height="{Binding ElementName=oldPassword, Path=ActualHeight}"
                            FontSize="{Binding ElementName=oldPassword, Path=FontSize}"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="..."
                            Grid.Column="1" Click="Button2_Click"/>
          </Grid>
        </StackPanel>
        <StackPanel Orientation="Vertical">
          <Label
                 FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}"
                 Content="{x:Static properties:Resources.PasswordConfirm}"
                 x:Name="confirmPassword" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <cc:BindablePasswordBox Grid.Column="0"
                              Height="{Binding ElementName=oldPassword, Path=ActualHeight}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Validation.ErrorTemplate="{x:Null}"
                              Password="{Binding PasswordConfirm, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                              x:Name="pswEditPwdConfirm" />
            <ContentPresenter Grid.Column="2"
                    Content="{Binding ElementName=pswEditPwdConfirm, Path=(Validation.Errors).CurrentItem}"/>
            <Button DockPanel.Dock="Right" x:Name="selectButton3"
                              Height="{Binding ElementName=oldPassword, Path=ActualHeight}"
                              FontSize="{Binding ElementName=oldPassword, Path=FontSize}"
                              VerticalContentAlignment="Center"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Content="..."
                              Grid.Column="1" Click="Button3_Click"/>
          </Grid>
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
