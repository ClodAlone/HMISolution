<UserControl x:Class="UFUserEditor.Controls.NewUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:properties="clr-namespace:UFUserEditor.Properties"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             FocusManager.FocusedElement="{Binding ElementName=textEditName}"
             mc:Ignorable="d" Width="350" Height="450"
             d:DesignHeight="450" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <utilities:AccessMaskConverter x:Key="AccessMaskConverter" />
            <utilities:TextUpDownConverter x:Key="TextUpDownConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid x:Name="mainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="30*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition  Width="1*" />
                <ColumnDefinition  Width="9*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--<TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="userProperties" VerticalAlignment="Center" FontWeight="Bold" />-->

            <TextBlock Grid.Row="1" x:Name="userName" VerticalAlignment="Center" />
            <DockPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditName}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditName" />
            </DockPanel>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
            Content="{Binding ElementName=textEditName, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="2" x:Name="userPassword" VerticalAlignment="Center" />
            <DockPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}"
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=pswEditPwd}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <cc:BindablePasswordBox Grid.Row="2" Grid.Column="2" Password="{Binding Password, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="pswEditPwd" />
            </DockPanel>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
            Content="{Binding ElementName=pswEditPwd, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="3" x:Name="userPasswordConfirm" VerticalAlignment="Center" />
            <DockPanel Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=pswEditPwdConfirm}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <cc:BindablePasswordBox Grid.Row="3" Grid.Column="2" Password="{Binding PasswordConfirm, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="pswEditPwdConfirm" />
            </DockPanel>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
            Content="{Binding ElementName=pswEditPwdConfirm, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="4" x:Name="electronicSignature" VerticalAlignment="Center" />
            <DockPanel Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditElectronicSignature}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding ElectronicSignature, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditElectronicSignature" />
            </DockPanel>
            <ContentPresenter Grid.Row="4" Grid.Column="3" 
            Content="{Binding ElementName=textEditElectronicSignature, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock x:Name="textBlockArrayDimension" Grid.Row="5" VerticalAlignment="Center" />
            <!--<ms:SpinDecorator Grid.Column="2" Grid.Row="5" ValueProperty="Text" BorderBrush="Transparent"
                          Change="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                          MinimumProperty="0" 
                          MaximumProperty="255" >
                <TextBox Grid.Column="2" Grid.Row="5" x:Name="textPasswordExpiresInDays" 
                         Text="{Binding PasswordExpiresInDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, Converter={StaticResource TextUpDownConverter}}" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"/>
            </ms:SpinDecorator>-->
            <dxe:SpinEdit Grid.Column="2" Grid.Row="5" Name="textPasswordExpiresInDays" MinValue="0"  MaskType="Numeric" Mask="n0" EditValueType="{x:Type sys:Int32}" 
                          MinWidth="{Binding Path=LoginControlsWidth,Mode=OneWay,Source={x:Static properties:Settings.Default}}"
                          MinHeight="{Binding Path=LoginControlsHeight,Mode=OneWay,Source={x:Static properties:Settings.Default}}"
                          EditValue="{Binding PasswordExpiresInDays, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                          Validation.ErrorTemplate="{x:Null}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" />
            <ContentPresenter Grid.Row="5" Grid.Column="3" Name="contentPresenterPasswordExpiresInDays"
            Content="{Binding ElementName=textPasswordExpiresInDays, Path=(Validation.Errors).CurrentItem}"/>

            <DockPanel x:Name="runtimePasswordInDays" Visibility="Collapsed" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textRuntimePasswordExpiresInDays}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Name="textRuntimePasswordExpiresInDays" Grid.Column="2" Grid.Row="12"  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 Text="{Binding PasswordExpiresInDays, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            </DockPanel>
            <ContentPresenter Grid.Row="5" Grid.Column="3" Visibility="Collapsed"  x:Name="runtimeContentPresenterPasswordInDays"
            Content="{Binding ElementName=textRuntimePasswordExpiresInDays, Path=(Validation.Errors).CurrentItem}"/>


            <TextBlock x:Name="textForcePasswordChangeFirstLogin" Grid.Row="6" VerticalAlignment="Center" />
            <Viewbox
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Grid.Column="2" Grid.Row="6" 
                    Stretch="Uniform"
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" >
                <CheckBox x:Name="checkForcePasswordChangeFirstLogin" Grid.Column="2" Grid.Row="6" 
                          IsChecked="{Binding ForcePasswordChangeFirstLogin, UpdateSourceTrigger=PropertyChanged}"  
                          VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
            </Viewbox>

            <TextBlock x:Name="textUserLoginDiabled" Grid.Row="7" VerticalAlignment="Center" />
            <Viewbox
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Grid.Column="2" Grid.Row="7" 
                    Stretch="Uniform"
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" >
                <CheckBox x:Name="checkUserLoginDiabled" Grid.Column="2" Grid.Row="7" 
                          IsChecked="{Binding Disabled, UpdateSourceTrigger=PropertyChanged}"  
                          VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
            </Viewbox>

            <TextBlock Grid.Row="8" x:Name="userEmail" VerticalAlignment="Center" />
            <DockPanel Grid.Row="8" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=EmailMaskedTextbox}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Email, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="EmailMaskedTextbox" />
            </DockPanel>
            <ContentPresenter Grid.Row="8" Grid.Column="3" 
            Content="{Binding ElementName=EmailMaskedTextbox, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="9" x:Name="userPhoneNumber" VerticalAlignment="Center" />
            <DockPanel Grid.Row="9" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditPhone}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding PhoneNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditPhone" />
            </DockPanel>
            <ContentPresenter Grid.Row="9" Grid.Column="3" 
            Content="{Binding ElementName=textEditPhone, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="10" x:Name="userMobile" VerticalAlignment="Center" />
            <DockPanel Grid.Row="10" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditMobile}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding MobilePhoneNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textEditMobile" />
            </DockPanel>
            <ContentPresenter Grid.Row="10" Grid.Column="3" 
            Content="{Binding ElementName=textEditMobile, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="11" x:Name="userTelegram" VerticalAlignment="Center" />
            <DockPanel Grid.Row="11" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textTelegram}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="11" Grid.Column="2" Text="{Binding TelegramChatID, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textTelegram" />
            </DockPanel>
            <ContentPresenter Grid.Row="11" Grid.Column="3" 
            Content="{Binding ElementName=textTelegram, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="12" x:Name="userFirebase" VerticalAlignment="Center" />
            <DockPanel Grid.Row="12" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textFirebase}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Row="12" Grid.Column="2" Text="{Binding FCMTokenPath, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 x:Name="textFirebase" />
            </DockPanel>
            <ContentPresenter Grid.Row="12" Grid.Column="3" 
            Content="{Binding ElementName=textFirebase, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="13" x:Name="userAccessLevel" VerticalAlignment="Center" />
            <DockPanel Grid.Row="13" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding ElementName=textEditAccessLevel}" Click="TouchButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox Name="textEditAccessLevel" Grid.Column="2" Grid.Row="13"  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                 Text="{Binding AccessLevel, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            </DockPanel>
            <ContentPresenter Grid.Row="13" Grid.Column="3" 
            Content="{Binding ElementName=textEditAccessLevel, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="14" x:Name="userAccessMask" VerticalAlignment="Center" />
            <DockPanel Grid.Row="14" Grid.Column="2" x:Name="editAccesMask" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button x:Name="bitmask" DockPanel.Dock="Right" 
                    Height="{Binding ElementName=textEditName, Path=ActualHeight}" 
                    MinWidth="{Binding ElementName=textEditName, Path=ActualHeight}"
                    VerticalContentAlignment="Center" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{Binding AccessMask, Mode=TwoWay}" Click="AMButton_Click">
                    <Button.Content>
                        <Image Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
                    </Button.Content>
                </Button>
                <TextBox x:Name="text" IsReadOnly="False" Text="{Binding Path=Tag, ElementName=bitmask, UpdateSourceTrigger=LostFocus, StringFormat=X8, Converter={StaticResource AccessMaskConverter}}" />
            </DockPanel>
            <ContentPresenter Grid.Row="14" Grid.Column="3" 
            Content="{Binding ElementName=editAccesMask, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Grid.Row="15" x:Name="userCultureName" VerticalAlignment="Center" />
            <dxe:ComboBoxEdit Grid.Row="15" Grid.Column="2" SelectedItem="{Binding CultureName, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Validation.ErrorTemplate="{x:Null}"
                 BorderBrush="{Binding ElementName=textEditName, Path=BorderBrush}"
                 IsTextEditable="False"
                 x:Name="cmbCultures">
                <dxe:ComboBoxEdit.BorderTemplate>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <Border BorderThickness="1" BorderBrush="{Binding ElementName=textEditName, Path=BorderBrush}" 
                                Background="{Binding ElementName=textEditName, Path=Background}" 
                            CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </dxe:ComboBoxEdit.BorderTemplate>
                <dxe:ComboBoxEdit.Resources>
                    <Style TargetType="dxe:ButtonInfo">
                        <Setter Property="Template">
                            <Setter.Value>
                                <DataTemplate>
                                    <Button x:Name="PART_Item" Content="▼"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </dxe:ComboBoxEdit.Resources>
            </dxe:ComboBoxEdit>
            <ContentPresenter Grid.Row="15" Grid.Column="3" 
            Content="{Binding ElementName=cmbCultures, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
