<UserControl x:Class="UFUserEditor.UFRuntimeUserEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:self="clr-namespace:UFUserEditor"
             xmlns:properties="clr-namespace:UFUserEditor.Properties"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:utilities="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             FontSize="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}" 
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/RuntimeUsers.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:FontToMinRowHeightConverter x:Key="fontToMinRowHeightConverter" x:Shared="True" />
            <dx:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <dx:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverterInverted" Invert="True" />
            <Style TargetType="{x:Type Button}" x:Key="ButtonRowCommandStyle">
              <Setter Property="Foreground" Value="{Binding ControlForeground,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
              <Setter Property="Height" Value="{Binding Source={x:Static utilities:Settings.Default},Path=ButtonsHeight}" />
            </Style>
            <ControlTemplate x:Key="{dxgt:GroupRowThemeKey ResourceKey=ExpandButtonTemplate, IsThemeIndependent=true}"
                             TargetType="{x:Type dx:ToggleStateButton}">
              <Viewbox Stretch="Fill"
                       Width="{TemplateBinding Property=Width}" Height="{TemplateBinding Property=Height}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                      <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="arrow">
                          <EasingDoubleKeyFrame KeyTime="0" Value="-2.742"/>
                        </DoubleAnimationUsingKeyFrames>
                        <PointAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransformOrigin)" Storyboard.TargetName="arrow">
                          <EasingPointKeyFrame KeyTime="0" Value="0.497,0.396"/>
                        </PointAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="arrow">
                          <EasingDoubleKeyFrame KeyTime="0" Value="-23.238"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" Storyboard.TargetName="arrow">
                          <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Unchecked"/>
                    <VisualState x:Name="Indeterminate"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Canvas Height="57.072" Width="51" x:Name="mainCanvas">
                  <Ellipse x:Name="circle" HorizontalAlignment="Center" Height="57.072"
                    StrokeThickness="2" Fill="DarkGray"
                    Stroke="{x:Null}" VerticalAlignment="Stretch" Width="51" Margin="0"/>
                  <Path x:Name="arrow"
                    Data="M1,1.5 L4.5,5 8,1.5 z"
                    Stroke="{x:Null}"
                    StrokeThickness="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom" Stretch="Fill" RenderTransformOrigin="0.508,0.497" Margin="0" Height="27.469" 
                    Fill="#FFE0E0E0" Canvas.Left="17.409" Canvas.Top="41.462" Width="21.875">
                    <Path.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleY="0.894" ScaleX="1.119"/>
                        <SkewTransform/>
                        <RotateTransform Angle="-90"/>
                        <TranslateTransform X="-0.25100000000000122" Y="-26.283"/>
                      </TransformGroup>
                    </Path.RenderTransform>
                  </Path>
                </Canvas>
              </Viewbox>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                   <Setter Property="Fill" TargetName="circle" Value="#FF424242"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style x:Key="{dxgt:GroupRowThemeKey ResourceKey=ExpandButtonStyle, IsThemeIndependent=true}" TargetType="{x:Type dx:ToggleStateButton}">
                <Setter Property="Width" Value="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}"/>
                <Setter Property="Height" Value="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}"/>
                <Setter Property="MinWidth" Value="{Binding FontSize}"/>
                <Setter Property="MinHeight" Value="{Binding FontSize}"/>
                <Setter Property="Template" Value="{DynamicResource {dxgt:GroupRowThemeKey ResourceKey=ExpandButtonTemplate}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                    Executed="OnCommandSave" 
                    CanExecute="CanCommandSave" />

        <CommandBinding Command="ApplicationCommands.Delete" 
                    Executed="OnRemoveItem" 
                    CanExecute="CanRemoveItem" />

        <CommandBinding Command="Cut"
                    Executed="OnCommandCut" 
                    CanExecute="CanCommandCut" />

        <CommandBinding Command="Copy"
                    Executed="OnCommandCopy" 
                    CanExecute="CanCommandCopy" />

        <CommandBinding Command="Paste"
                    Executed="OnCommandPaste" 
                    CanExecute="CanCommandPaste" />

        <CommandBinding Command="ApplicationCommands.Undo"
                    PreviewExecuted="OnCommandUndo" 
                    CanExecute="CanCommandUndo" />

        <CommandBinding Command="ApplicationCommands.Redo"
                    PreviewExecuted="OnCommandRedo" 
                    CanExecute="CanCommandRedo" />

        <CommandBinding Command="ApplicationCommands.Properties"
                    Executed="OnCommandProperties" 
                    CanExecute="CanCommandProperties" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewRole}" 
                    Executed="OnAddNewRole" 
                    CanExecute="CanAddNewRole" />

        <CommandBinding Command="{x:Static self:UIGeneralCommands.AddNewUser}" 
                    Executed="OnAddNewUser" 
                    CanExecute="CanAddNewUser" />

    </UserControl.CommandBindings>
    <dxb:BarManager.DXContextMenu>
        <dxb:PopupMenu x:Name="contextMenu">
            <dxb:PopupMenu.Items>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewRole}" Content="{x:Static properties:UICommandResource.AddNewRoleText}"/>
                <dxb:BarButtonItem Command="{x:Static self:UIGeneralCommands.AddNewUser}" Content="{x:Static properties:UICommandResource.AddNewUserText}"/>
                <dxb:BarItemLinkSeparator />
                <dxb:BarSubItem x:Name="editMenu" Content="{x:Static properties:UICommandResource.EditMenuText}">
                    <dxb:BarButtonItem Command="ApplicationCommands.Undo" Content="{x:Static utilities:ApplicationCommandsResource.Undo}" Glyph="{DynamicResource UndoSmall}"/>
                    <dxb:BarButtonItem Command="ApplicationCommands.Redo" Content="{x:Static utilities:ApplicationCommandsResource.Redo}" Glyph="{DynamicResource RedoSmall}"/>
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Command="ApplicationCommands.Copy" Content="{x:Static utilities:ApplicationCommandsResource.Copy}" Glyph="{DynamicResource CopySmall}"/>
                    <dxb:BarButtonItem Command="ApplicationCommands.Paste" Content="{x:Static utilities:ApplicationCommandsResource.Paste}" Glyph="{DynamicResource PasteSmall}"/>
                    <dxb:BarButtonItem Command="ApplicationCommands.Cut" Content="{x:Static utilities:ApplicationCommandsResource.Cut}" Glyph="{DynamicResource CutSmall}"/>
                    <dxb:BarButtonItem Command="ApplicationCommands.Delete" Content="{x:Static utilities:ApplicationCommandsResource.Delete}" Glyph="{DynamicResource DeleteSmall}" />
                    <dxb:BarItemLinkSeparator />
                    <dxb:BarButtonItem Command="Properties" Content="{x:Static properties:UICommandResource.PropertiesMenuText}"/>
                </dxb:BarSubItem>
            </dxb:PopupMenu.Items>
        </dxb:PopupMenu>
    </dxb:BarManager.DXContextMenu>

  <Grid>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
      <!--Toolbar-->
    <Grid MinHeight="40" DockPanel.Dock="Top" x:Name="options">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="8*" />
        <ColumnDefinition Width="8*" />
        <ColumnDefinition Width="8*" />
        <ColumnDefinition Width="8*" />
        <ColumnDefinition Width="8*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="0" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="0" Command="{x:Static self:UIGeneralCommands.AddNewRole}">
        <Button.Content>
          <Image Margin="2" x:Name="addRoreSmallImg" Source="{DynamicResource RTUAaddrole}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="0" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="1" Command="{x:Static self:UIGeneralCommands.AddNewUser}">
        <Button.Content>
          <Image Margin="2" x:Name="addUserSmallImg" Source="{DynamicResource RTUAadduser}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="0" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="2" Command="ApplicationCommands.Properties">
        <Button.Content>
          <Image Margin="2" x:Name="propertiesSmallImg" Source="{DynamicResource EditGeneralSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="0" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="3" Command="ApplicationCommands.Undo">
        <Button.Content>
          <Image Margin="2" x:Name="undoSmallImg" Source="{DynamicResource UndoSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="0" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="4" Command="ApplicationCommands.Redo">
        <Button.Content>
          <Image Margin="2" x:Name="redoSmallImg" Source="{DynamicResource RedoSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>

      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="1" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="0" Command="Cut">
        <Button.Content>
          <Image Margin="2" x:Name="cutSmallImg" Source="{DynamicResource CutSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="1" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="1" Command="Copy">
        <Button.Content>
          <Image Margin="2" x:Name="copySmallImg" Source="{DynamicResource CopySmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="1" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="2" Command="Paste">
        <Button.Content>
          <Image Margin="2" x:Name="pasteSmallImg" Source="{DynamicResource PasteSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="1" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="3" Command="ApplicationCommands.Delete">
        <Button.Content>
          <Image Margin="2" x:Name="deleteSmallImg" Source="{DynamicResource DeleteSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
      <Button Style="{StaticResource ButtonRowCommandStyle}" ToolTipService.ShowOnDisabled="True"
              Grid.Row="1" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
              Grid.Column="4" Command="ApplicationCommands.Save">
        <Button.Content>
          <Image Margin="2" x:Name="saveSmallImg" Source="{DynamicResource SaveSmall}" Height="16" Width="16" />
        </Button.Content>
      </Button>
    </Grid>

    <dx:DXTabControl Grid.Row="1">
      <dx:DXTabControl.View>
        <dx:TabControlMultiLineView HeaderLocation="Bottom" />
      </dx:DXTabControl.View>
      <dx:DXTabItem>
        <dx:DXTabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static properties:Resources.Hierarchical}" />
          </StackPanel>
        </dx:DXTabItem.Header>
        <dxg:TreeListControl Name="treeListControl" SelectionMode="Row">
          <dxg:TreeListControl.Columns>
            <dxg:TreeListColumn FieldName="ItemHeader" FilterPopupMode="Excel" Header="{x:Static self:Properties.Resources.HeaderTextName}" />
          </dxg:TreeListControl.Columns>
          <dxg:TreeListControl.View>
            <dxg:TreeListView Name="treeListView" NavigationStyle="Row" AllowTreeIndentScrolling="True"
              RowIndent="{Binding Source={x:Static utilities:Settings.Default},Path=DialogControlsFontSize}"
              ImageFieldName="ResourceIcon" ShowNodeImages="True" VerticalScrollbarVisibility="Auto"
              AllowEditing="False" IsColumnChooserVisible="False" IsColumnMenuEnabled="False"
              ShowColumnHeaders="True" ShowDragDropHint="True" ShowVerticalLines="False" ShowHorizontalLines="False" ShowIndicator="False"
              IsSynchronizedWithCurrentItem="True" AllowDragDrop="False" NodeExpanding="OnTreeNodeExpanding"
              AutoWidth="True" PreviewMouseDoubleClick="treeListControl_PreviewMouseDoubleClick" PreviewMouseLeftButtonUp="treeListControl_PreviewMouseLeftButtonUp">
            <dxg:TreeListView.RowStyle>
                <Style TargetType="{x:Type dxg:RowControl}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=SelectionState}" Value="None"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=CellBorderFocusedBrush}}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                    <!--<Setter Property="ContextMenu" Value="{Binding Path=Row.TreeItemInnerObject, Converter={StaticResource TagToContextMenuConverter}}" />-->
                </Style>
            </dxg:TreeListView.RowStyle>
              <dxg:TreeListView.CellStyle>
                <Style TargetType="{x:Type dxg:LightweightCellEditor}">
                  <Setter Property="MinHeight" Value="{Binding FontSize, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource fontToMinRowHeightConverter}, Mode=OneWay}" />
                </Style>
              </dxg:TreeListView.CellStyle>
            </dxg:TreeListView>
          </dxg:TreeListControl.View>
          <dxg:TreeListControl.CommandBindings>
            <CommandBinding Command="ApplicationCommands.Cut"
                            Executed="OnCommandCut"
                            CanExecute="CanCommandCut" />
            <CommandBinding Command="ApplicationCommands.Paste"
                            Executed="OnCommandPaste"
                            CanExecute="CanCommandPaste" />
            <CommandBinding Command="ApplicationCommands.Copy"
                            Executed="OnCommandCopy"
                            CanExecute="CanCommandCopy" />
          </dxg:TreeListControl.CommandBindings>
        </dxg:TreeListControl>

      </dx:DXTabItem>
      <dx:DXTabItem>
        <dx:DXTabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static properties:Resources.Flat}" />
          </StackPanel>
        </dx:DXTabItem.Header>

        <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
                        AutoExpandAllGroups="True"
                        AutoGenerateColumns="AddNew"
                        Name="gridDataControl"
                        AutoPopulateColumns="False"
                        AllowDrop="True"
                        AllowLiveDataShaping="False"
                        MouseDoubleClick="gridDataControl_MouseDoubleClick"
                        dx:DXSerializer.SerializationID="gridDataControl"
                        dx:DXSerializer.StoreLayoutMode="All"
                        dxg:DataControlSerializationOptions.AddNewColumns="False"
                        dxg:DataControlSerializationOptions.RemoveOldColumns="False">
          <dxg:GridControl.Columns>
            <dxg:GridColumn ReadOnly="True" AllowEditing="False" AllowGrouping="True" DisplayMemberBinding="{Binding Path=Name, Mode=OneWay}" FieldName="Name" Header="{x:Static properties:Resources.HeaderTextName}"/>
          </dxg:GridControl.Columns>
          <dxg:GridControl.View>

            <dxg:TableView x:Name="tableView" AllowEditing="True"
                FadeSelectionOnLostFocus="False"
                BestFitMode="VisibleRows"
                AllowBestFit="True"
                AllowResizing="True"
                ShowGroupPanel="True"
                ShowSearchPanelMode="Always" SearchPanelFindMode="Always"
                ShowSearchPanelMRUButton="True"
                ShowFilterPanelMode="ShowAlways"
                NavigationStyle="Row"
                MultiSelectMode="Row">
              <dxg:TableView.RowStyle>
                <Style TargetType="{x:Type dxg:RowControl}">
                    <Style.Triggers>
                    <!--<Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">-->
                    <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                      <Setter Property="Background" Value="LightGray" />
                      <Setter Property="Foreground" Value="Black" />
                    </DataTrigger>
                    <!--</Trigger>-->
                  </Style.Triggers>
                </Style>
              </dxg:TableView.RowStyle>
            </dxg:TableView>
          </dxg:GridControl.View>
        </dxg:GridControl>

      </dx:DXTabItem>
    </dx:DXTabControl>
  </Grid>
</UserControl>
