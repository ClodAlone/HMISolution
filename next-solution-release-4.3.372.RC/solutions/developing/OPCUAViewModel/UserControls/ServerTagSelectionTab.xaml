<UserControl x:Class="OPCUAViewModel.UserControls.ServerTagSelectionTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"      
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Visibility="{Binding IsCmbBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" 
                   Grid.Column="0" 
                   VerticalAlignment="Center" 
                   Margin="5"
                   Content="{x:Static properties:Resource.TagSelection_Project}" ></Label>
            <dxe:ComboBoxEdit Height="30" Grid.Column="1" x:Name="cBox" Margin="5" HorizontalAlignment="Left"
                ItemsSource="{Binding ProjectsList}" 
                DisplayMember="DisplayName" 
                ValueMember="Id" 
                EditValue="{Binding StartingProject}"
                EditValueChanged="cBox_EditValueChanged"
                IsTextEditable="False"/>
        </Grid>

        <ContentControl x:Name="contentTab" Margin="5" Grid.Row="1">

        </ContentControl>
    </DockPanel>
</UserControl>
