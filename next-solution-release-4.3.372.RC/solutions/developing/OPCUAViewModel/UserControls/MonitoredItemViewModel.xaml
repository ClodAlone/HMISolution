<UserControl x:Class="OPCUAViewModel.UserControls.MonitoredItemViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"      
    xmlns:local="clr-namespace:OPCUAViewModel"
    xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties" 
    HorizontalAlignment="Center"
    VerticalAlignment="Center"  
    Width="400">

    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="DeadbandTypeEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:DeadbandType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="MonitoringModeEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:MonitoringMode" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>

    <dxn:NavBarControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <dxn:NavBarControl.Groups>
            <dxn:NavBarGroup Header="{x:Static properties:Resource.Data}" IsExpanded="True">
                <dxn:NavBarItem>
                    <dxn:NavBarItem.Content>

                        <Grid Margin="4" x:Name="grid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="167" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock 
          FontStyle="Italic"
          Foreground="Red"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>

        <Label 
      Grid.Row="0" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_MonitoredItem}" FontWeight="Bold"
      HorizontalAlignment="Right"
      />
        <Label 
      Grid.Row="0" Grid.Column="2" 
      Content="{Binding Path=Title}" 
      />









        <!-- Econding Support-->
        <Label 
      Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_MonitoringMode}" 
      HorizontalAlignment="Right"
      />

        <ComboBox Grid.Row="1" Grid.Column="2" IsEnabled="True"
                            ItemsSource="{Binding Source={StaticResource MonitoringModeEnums}}"
                            SelectedItem="{Binding Path=MonitoringMode, UpdateSourceTrigger=PropertyChanged, Mode=twoway}"
            >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Label x:Name="lbl"  
                                        Content="{Binding Path=.,Mode=OneWay, 
                                        Converter={StaticResource enumItemsConverter}}"
                                        FontSize="11"
                                        Height="25"
                                        Margin="2,0,0,0" 
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"/>
                    <DataTemplate.Triggers>
                        <DataTrigger 
                                            Binding="{Binding Path=IsHighlighted, 
                                                RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                            Value="True">
                            <Setter TargetName="lbl" Property="Foreground" Value="Red"/>
                            <Setter TargetName="lbl" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="lbl" Property="BitmapEffect" >
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="White" GlowSize="5" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>









        <Label 
      Grid.Row="2" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_QueueSize}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  x:Name="queueSize" Grid.Row="2" Grid.Column="2" MaskType="Numeric" Mask="n0" 
                    EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch" 
                    Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True" 
                    EditValue="{Binding Path=QueueSize, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />
        <Label 
      Grid.Row="3" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_SamplingInterval}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  x:Name="samplingInterval" Grid.Row="3" Grid.Column="2" MaskType="Numeric" Mask="n0"
                      EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                      EditValue="{Binding Path=SamplingInterval, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

        <Label 
      Grid.Row="4" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_CacheQueueSize}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  x:Name="cacheQueueSize" Grid.Row="4" Grid.Column="2" MaskType="Numeric" Mask="n0"
                      EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                      EditValue="{Binding Path=CacheQueueSize, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

        <Label 
      Grid.Row="5" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_RelativePath}" 
      HorizontalAlignment="Right"
      />
        <Label 
      Grid.Row="5" Grid.Column="2" 
      Content="{Binding Path=RelativePath, UpdateSourceTrigger=PropertyChanged}"
      />

                            <CheckBox Grid.Row="6" Grid.Column="2" Content="{x:Static properties:Resource.DiscardOldest}"  IsChecked="{Binding Path=DiscardOldest, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Button Grid.Row="7" Grid.Column="2" Content="{x:Static properties:Resource.ApplyButtonHeader}" Command="{Binding Path=ApplyCommand}" />
                            <CheckBox Grid.Row="8" Grid.Column="2" Content="{x:Static properties:Resource.AuditingDataEnabled}"  IsChecked="{Binding Path=AuditingDataEnabled, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" HorizontalAlignment="Left" VerticalAlignment="Center" />

                            <Label 
      Grid.Row="9" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_Value}" 
      HorizontalAlignment="Right"
      />
                            <Label 
      Grid.Row="9" Grid.Column="2" 
      Content="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged}" 
      />

                            <Label 
      Grid.Row="10" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_Quality}" 
      HorizontalAlignment="Right"
      />
                            <Label 
      Grid.Row="10" Grid.Column="2" 
      Content="{Binding Path=Quality, UpdateSourceTrigger=PropertyChanged}" 
      />
                        </Grid>
            </dxn:NavBarItem.Content>
        </dxn:NavBarItem>
    </dxn:NavBarGroup>

            <dxn:NavBarGroup Header="{x:Static properties:Resource.Filter}" IsExpanded="False">
        <dxn:NavBarItem>
            <dxn:NavBarItem.Content>

                        <Grid Margin="4" x:Name="grid2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="167" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Econding Support-->
                <Label 
      Grid.Row="0" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_DeadbandFilterType}" 
      HorizontalAlignment="Right"
      />

                <ComboBox Grid.Row="0" Grid.Column="2" IsEnabled="True"
                            ItemsSource="{Binding Source={StaticResource DeadbandTypeEnums}}"
                            SelectedItem="{Binding Path=DeadbandFilterType, 
                                UpdateSourceTrigger=PropertyChanged, Mode=twoway}"
            >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Label x:Name="lbl"  
                                        Content="{Binding Path=.,Mode=OneWay, 
                                        Converter={StaticResource enumItemsConverter}}"
                                        FontSize="11"
                                        Height="25"
                                        Margin="2,0,0,0" 
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"/>
                            <DataTemplate.Triggers>
                                <DataTrigger 
                                            Binding="{Binding Path=IsHighlighted, 
                                                RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                                            Value="True">
                                    <Setter TargetName="lbl" Property="Foreground" Value="Red"/>
                                    <Setter TargetName="lbl" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="lbl" Property="BitmapEffect" >
                                        <Setter.Value>
                                            <OuterGlowBitmapEffect GlowColor="White" GlowSize="5" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>



                <Label 
      Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.MonitoredItemView_DeadbandValue}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  x:Name="deadbandValue" Grid.Row="1" Grid.Column="2" MaskType="Numeric" Mask="n0"
                      EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                      EditValue="{Binding Path=DeadbandValue, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

                            <Button Grid.Row="2" Grid.Column="2" Content="{x:Static properties:Resource.ApplyButtonHeader}" Command="{Binding Path=ApplyCommand}" />
            </Grid>

            </dxn:NavBarItem.Content>
        </dxn:NavBarItem>
    </dxn:NavBarGroup>
        </dxn:NavBarControl.Groups>
    </dxn:NavBarControl>
</UserControl>
