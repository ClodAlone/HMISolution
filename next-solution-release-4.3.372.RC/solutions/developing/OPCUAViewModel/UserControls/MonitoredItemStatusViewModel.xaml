<UserControl x:Class="OPCUAViewModel.UserControls.MonitoredItemStatusViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"      
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    HorizontalAlignment="Center" 
    VerticalAlignment="Center" Opacity="0.75"
    Width="600">

    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="12,12,12,12">
    <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="167" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <Grid.Resources>
                    <DataTemplate DataType="{x:Type ValidationError}">
                        <TextBlock FontStyle="Italic"
                  Foreground="Red"
                  HorizontalAlignment="Right"
                  Margin="0,1"
                  Text="{Binding Path=ErrorContent}" 
                  />
                    </DataTemplate>
                </Grid.Resources>


                    <Label               Grid.Row="0" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_MonitoredItem}" FontWeight="Bold"
              HorizontalAlignment="Right"
              />
                <Label               Grid.Row="0" Grid.Column="2" 
              Content="{Binding Path=NodeIdModel.CompletePath}" 
              ToolTip="{Binding Path=NodeIdModel.CompletePath, UpdateSourceTrigger=PropertyChanged}" />


        <Label Grid.Row="1" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_Id}" FontWeight="Bold"
              HorizontalAlignment="Right"
              />
        <Label               Grid.Row="1" Grid.Column="2" 
              Content="{Binding Path=NodeIdModel.BrowseName}" 
              ToolTip="{Binding Path=NodeIdModel.BrowseName, UpdateSourceTrigger=PropertyChanged}" />









        <Label               Grid.Row="2" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_Value}" 
              HorizontalAlignment="Right"
              />
                <Label Grid.Row="2" Grid.Column="2" 
              x:Name="queueSize"
                              Content="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged}" />

                <Label               Grid.Row="3" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_Quality}" 
              HorizontalAlignment="Right"
              />
                <Label Grid.Row="3" Grid.Column="2" 
              x:Name="samplingInterval"
                              Content="{Binding Path=Quality, UpdateSourceTrigger=PropertyChanged}" />

                <Label               Grid.Row="4" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_Timestamp}" 
              HorizontalAlignment="Right"
              />
                <Label Grid.Row="4" Grid.Column="2" 
              x:Name="cacheQueueSize"
                              Content="{Binding Path=TimeStamp, UpdateSourceTrigger=PropertyChanged}" />


                <Label               Grid.Row="5" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_RelativePath}" 
              HorizontalAlignment="Right"
              />
                <Label               Grid.Row="5" Grid.Column="2" 
              Content="{Binding Path=RelativePath, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="{Binding Path=RelativePath, UpdateSourceTrigger=PropertyChanged}" />

                        <Label               Grid.Row="6" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_LastMessage}" 
              HorizontalAlignment="Right"
              />
                        <Label               Grid.Row="6" Grid.Column="2" 
              Content="{Binding Path=LastMessage, UpdateSourceTrigger=PropertyChanged}" 
                                             ToolTip="{Binding Path=LastMessage, UpdateSourceTrigger=PropertyChanged}"/>

            <Label               Grid.Row="7" Grid.Column="0" 
              Content="{x:Static properties:Resource.MonitoredItemStatusView_Session}" 
              HorizontalAlignment="Right"
              />
            <Label               Grid.Row="7" Grid.Column="2" 
              Content="{Binding Path=SessionName, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="{Binding Path=SessionName, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </Border>
</UserControl>
