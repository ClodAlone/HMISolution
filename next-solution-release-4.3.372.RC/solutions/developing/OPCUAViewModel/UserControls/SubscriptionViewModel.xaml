<UserControl x:Class="OPCUAViewModel.UserControls.SubscriptionViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:opcuacore="clr-namespace:Opc.Ua;assembly=Opc.Ua.Core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties" 
    HorizontalAlignment="Center"
    VerticalAlignment="Center"  
    Width="400">

    <UserControl.Resources>
        <!-- Resources scoped at the Application level should be defined here. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlobalConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="ServerStateEnums"
                            MethodName="GetValues" 
                            ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="opcuacore:ServerState" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="167" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type ValidationError}">
                <TextBlock FontStyle="Italic"
          Foreground="Red"
          HorizontalAlignment="Right"
          Margin="0,1"
          Text="{Binding Path=ErrorContent}" 
          />
            </DataTemplate>
        </Grid.Resources>

        <Label Grid.Row="0" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_Subscription}" FontWeight="Bold"
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="0" Grid.Column="2" 
      Content="{Binding Path=Title}" 
      />

        <Label Grid.Row="1" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_KeepAliveCount}" 
      HorizontalAlignment="Right"
      />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
          <dxe:SpinEdit  x:Name="keepAliveCount" MinValue="0" MaskType="Numeric" Mask="n0"
                        EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                        EditValue="{Binding Path=KeepAliveCount, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />
          <Label Content="{x:Static properties:Resource.SubscriptionView_Current}" />
            <Label Content="{Binding Path=CurrentKeepAliveCount, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Label Grid.Row="3" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_LifetimeCount}" 
      HorizontalAlignment="Right"
      />
        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
          <dxe:SpinEdit  x:Name="lifeTimeCount" MinValue="0" MaskType="Numeric" Mask="n0"
                      EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                      EditValue="{Binding Path=LifeTimeCount, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />
          <Label Content="{x:Static properties:Resource.SubscriptionView_Current}" />
            <Label Content="{Binding Path=CurrentLifeTimeCount, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Label Grid.Row="4" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_MaxMessageCount}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  Grid.Row="4" Grid.Column="2" x:Name="maxMessageCount" MinValue="0" MaskType="Numeric" Mask="n0"
                  EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                  Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                  EditValue="{Binding Path=MaxMessageCount, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

        <Label Grid.Row="5" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_MaxNotificationsPerPublish}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  Grid.Row="5" Grid.Column="2" x:Name="maxNotificationsPerPublish" MinValue="0" MaskType="Numeric" Mask="n0"
                  EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                  Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                  EditValue="{Binding Path=MaxNotificationsPerPublish, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

        <Label Grid.Row="6" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_MinLifetimeInterval}" 
      HorizontalAlignment="Right"
      />
      <dxe:SpinEdit  Grid.Row="6" Grid.Column="2" x:Name="minLifetimeInterval" MinValue="0" MaskType="Numeric" Mask="n0"
                  EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                  Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                  EditValue="{Binding Path=MinLifetimeInterval, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />

        <Label Grid.Row="7" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_Priority}" 
      HorizontalAlignment="Right"
      />
        <StackPanel Grid.Row="7" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
          <dxe:SpinEdit  x:Name="priority"  MinValue="0" MaskType="Numeric" Mask="n0"
                      EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Increment="1" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                      EditValue="{Binding Path=Priority, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />
            <Label Content="{x:Static properties:Resource.SubscriptionView_Current}" />
            <Label Content="{Binding Path=CurrentPriority, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>


        <Label Grid.Row="8" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_PublishingInterval}" 
      HorizontalAlignment="Right"
      />
        <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
          <dxe:SpinEdit  x:Name="publishingInterval"  MinValue="0" MaskType="Numeric" Mask="n0"
                      EditValueType="{x:Type sys:Int32}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Increment="100" AllowSpinOnMouseWheel="False" IsTextEditable="True"
                      EditValue="{Binding Path=PublishingInterval, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" />
            <Label Content="{x:Static properties:Resource.SubscriptionView_Current}" />
            <Label Content="{Binding Path=CurrentPublishingInterval, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <CheckBox Grid.Row="9" Grid.Column="2" Content="{x:Static properties:Resource.PublishEnabled}" IsChecked="{Binding Path=PublishingEnabled, UpdateSourceTrigger=PropertyChanged, Mode=twoway}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Button Grid.Row="10" Grid.Column="2" Content="{x:Static properties:Resource.ApplyButtonHeader}" Command="{Binding Path=ApplyCommand}" />

        <Label Grid.Row="11" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_MonitoredItemCount}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="11" Grid.Column="2" 
      Content="{Binding Path=MonitoredItemCount, UpdateSourceTrigger=PropertyChanged}" 
      />

        <Label Grid.Row="12" Grid.Column="0" 
      Content="{x:Static properties:Resource.SubscriptionView_NotificationCount}" 
      HorizontalAlignment="Right"
      />
        <Label Grid.Row="12" Grid.Column="2" 
      Content="{Binding Path=NotificationCount, UpdateSourceTrigger=PropertyChanged}" 
      />
    </Grid>
</UserControl>
