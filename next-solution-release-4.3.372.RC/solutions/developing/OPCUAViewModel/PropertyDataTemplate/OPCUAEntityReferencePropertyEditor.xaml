<UserControl x:Class="OPCUAViewModel.PropertyDataTemplate.OPCUAEntityReferencePropertyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:OPCUAViewModel.Converters"
    xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
    xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:UriConverter x:Key="UriConverter" />
            <local:DeclaringTypeToVisbilityConverter x:Key="DeclaringTypeToVisbilityConverter" />
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="2" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <dxe:ComboBoxEdit
                x:Name="projectCmb" Grid.Row="0" Margin="0,1,0,3" 
                Visibility="{Binding ProjectCmbBoxVisibility, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                Text="{Binding SelectedProjectName, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{x:Static properties:Resource.OPCUAEntityReferenceEditor_TooltipProject}"
                PopupOpening="ProjectCmb_PopupOpening"
                SelectedIndexChanged="projectCmb_SelectedIndexChanged"
                GotFocus="projectCmb_GotFocus"
                ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
        </dxe:ComboBoxEdit>
        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Click="DlgButton_Click_Clear" 
                    Visibility="{Binding Property.DeclaringType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DeclaringTypeToVisbilityConverter}}">
                <Button.Content>
                    <Image x:Name="cancelImg" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button x:Name="uriButton" DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="DlgButton_Click">
                <Button.Content>
                    <Image x:Name="editImg" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="20" Height="20" Visibility="Collapsed" x:Name="progressBar" VerticalAlignment="Top"/>

            <dxe:ComboBoxEdit
                    x:Name="uriLabel" 
                    Text="{Binding Path=Tag,ElementName=uriButton,Converter={StaticResource UriConverter}, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" 
                    ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}"
                    PopupOpening="uriLabel_PopupOpening"
                    LostFocus="uriLabel_LostFocus" GotFocus="uriLabel_GotFocus" PreviewKeyDown="uriLabel_KeyDown"
                    SelectedIndexChanged="uriLabel_SelectedIndexChanged"
                    ShowSizeGrip="False" AutoComplete="True" ImmediatePopup="True" FindButtonPlacement="Popup">
            </dxe:ComboBoxEdit>
        </DockPanel>
        <Separator Grid.Row="2" Height="2" 
                   Visibility="{Binding SeparatorVisibility, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
        <ContentPresenter Grid.Column="1" Grid.Row="1" 
                Content="{Binding ElementName=uriButton, Path=(Validation.Errors).CurrentItem}" />
    </Grid>
</UserControl>
