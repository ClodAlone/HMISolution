<UserControl x:Class="OPCUAViewModel.PropertyDataTemplate.OPCUAEntityReferenceListPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OPCUAViewModel.Converters"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <local:ListUriCountConverter x:Key="ListUriConverterCount" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Button x:Name="uriCommand"  DockPanel.Dock="Right" Tag="{Binding Value, Mode=TwoWay}" Click="DlgButton_Click">
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Label x:Name="uriLabel" Content="{Binding Path=Tag, ElementName=uriCommand, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ListUriConverterCount}}"/>
    </DockPanel>

</UserControl>
