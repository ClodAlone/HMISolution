<UserControl x:Class="OPCUAViewModel.PropertyDataTemplate.ExpressionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             Height="150" Width="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Static properties:Resources.ExpressionEditor_Expression}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="txtExpression" Validation.ErrorTemplate="{x:Null}" 
                     Text="{Binding Expression, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  VerticalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="2"/>
        <ContentPresenter Grid.Column="3" 
                Content="{Binding ElementName=txtExpression, Path=(Validation.Errors).CurrentItem}"/>
        <TextBlock  Grid.Row="1" Text="{x:Static properties:Resources.ExpressionEditor_Variables}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,30,0,0"/>
        <TextBox Margin="0,30,0 ,0" Grid.Row="1" x:Name="txtVariables" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="2" />
        <Button Margin="0,30,0,0" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Click="BrowseVariable" >
            <Button.Content>
                <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <Button Margin="0,30,0,0" Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" Click="AddVariable" >
            <Button.Content>
                <Image Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
        <TextBlock Margin="0,10,15,0" Grid.Row="2" Text="{x:Static properties:Resources.ExpressionEditor_Functions}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <ComboBox Margin="0,10,0,0" Grid.Row="2" x:Name="cmbFunctions" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" IsEditable="False" SelectedIndex="0" Grid.ColumnSpan="2" />
        <Button Margin="0,10,0,0" Grid.Column="3" Grid.Row="2" VerticalAlignment="Center" Click="AddFunction" >
            <Button.Content>
                <Image Source="{StaticResource AddNewSmall}" Height="16" Width="16" />
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
