<UserControl x:Class="OPCUAViewModel.PropertyDataTemplate.ListOPCUAEntityReferenceEditor"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OPCUAViewModel.Converters"
             xmlns:self="clr-namespace:OPCUAViewModel.PropertyDataTemplate"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:OPCUAViewModel.Properties"
             x:Name="listUriEditor"
             Height="300" Width="300"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:UriConverter x:Key="UriConverter" />
            <utilities:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        
        <CommandBinding Command="{x:Static self:ListOPCUAEntityReferenceEditor.EditCommand}"
                    Executed="OnEditCommandExecuted" 
                    CanExecute="OnCanExecuteEditCommand" />

        <CommandBinding Command="{x:Static self:ListOPCUAEntityReferenceEditor.RemoveCommand}"
                    Executed="OnRemoveCommandExecuted" 
                    CanExecute="OnCanExecuteRemoveCommand" />

        <CommandBinding Command="{x:Static self:ListOPCUAEntityReferenceEditor.MoveUpCommand}"
                    Executed="OnMoveUpCommandExecuted" 
                    CanExecute="OnCanExecuteMoveUpCommand" />

        <CommandBinding Command="{x:Static self:ListOPCUAEntityReferenceEditor.MoveDownCommand}"
                    Executed="OnMoveDownCommandExecuted" 
                    CanExecute="OnCanExecuteMoveDownCommand" />

    </UserControl.CommandBindings>

    <Grid x:Name="layoutGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="90*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <ListBox x:Name="listUriControl" 
                 ItemsSource="{Binding}"
                 IsSynchronizedWithCurrentItem="False" >

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel HorizontalAlignment="Stretch" >

                        <TextBox x:Name="textUri" IsReadOnly="True" DockPanel.Dock="Left"
                                 Text="{Binding Path=Tag, ElementName=uriEdit, Converter={StaticResource UriConverter}}" 
                                 ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}" />
                        <Button x:Name="uriEdit" DockPanel.Dock="Right" Tag="{Binding}"
                                Content="{x:Static properties:Resource.OPCUAEntityReferenceEditor_Edit}" Command="{x:Static self:ListOPCUAEntityReferenceEditor.EditCommand}" />
                        <Button DockPanel.Dock="Right" Tag="{Binding}"
                                Content="{x:Static properties:Resource.OPCUAEntityReferenceEditor_Delete}" Command="{x:Static self:ListOPCUAEntityReferenceEditor.RemoveCommand}" />
                        <Button DockPanel.Dock="Right" Tag="{Binding}"
                                Content="{x:Static properties:Resource.OPCUAEntityReferenceEditor_Up}" Command="{x:Static self:ListOPCUAEntityReferenceEditor.MoveUpCommand}" />
                        <Button DockPanel.Dock="Right" Tag="{Binding}"
                                Content="{x:Static properties:Resource.OPCUAEntityReferenceEditor_Down}" Command="{x:Static self:ListOPCUAEntityReferenceEditor.MoveDownCommand}" />

                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static properties:Resource.OPCUAEntityReferenceEditor_AddNew}" Command="{Binding Path=AddNew, ElementName=listUriEditor}" />
            <Button Content="{x:Static properties:Resource.OPCUAEntityReferenceEditor_RemoveAll}" Grid.Column="2" Command="{Binding Path=RemoveAll, ElementName=listUriEditor}" />
        </Grid>

    </Grid>
</UserControl>
