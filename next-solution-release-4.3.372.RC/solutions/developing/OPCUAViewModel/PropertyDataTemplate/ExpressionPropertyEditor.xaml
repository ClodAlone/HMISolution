<UserControl x:Class="OPCUAViewModel.PropertyDataTemplate.ExpressionPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
              <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StringToToolTipConverter x:Key="StringToToolTipConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <DockPanel>
            <Button x:Name="btnClear" DockPanel.Dock="Right" 
                    Tag="{Binding Value, Mode=TwoWay, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{x:Null}"
                    Click="DlgButton_Click_Clear">
                <Button.Content>
                    <Image Source="{StaticResource CancelSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <Button DockPanel.Dock="Right" Click="DlgButton_Click">
                <Button.Content>
                    <Image Source="{StaticResource EditGeneralSmall}" Height="16" Width="16" />
                </Button.Content>
            </Button>
            <TextBox x:Name="text" IsReadOnly="False" Text="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ElementName=btnClear}" 
                     ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text, Converter={StaticResource StringToToolTipConverter}}" />
        </DockPanel>
        <ContentPresenter Grid.Column="1" 
            Content="{Binding ElementName=btnClear, Path=(Validation.Errors).CurrentItem}"/>
    </Grid>
</UserControl>
