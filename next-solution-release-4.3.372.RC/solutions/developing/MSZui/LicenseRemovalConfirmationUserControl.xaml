<UserControl x:Class="MSZui.LicenseRemovalConfirmationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MSZui"
             xmlns:properties="clr-namespace:MSZui.Properties"
             mc:Ignorable="d" 
             Height="200" Width="520">
    <Grid>
        <StackPanel>
            <StackPanel 
                Margin="10,20" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Orientation="Vertical">
                <Label 
                    Foreground="White" 
                    HorizontalAlignment="Stretch" 
                    Content="{x:Static properties:Resources.DongleDisabled}"/>
            </StackPanel>
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button 
                    Grid.Column="0" 
                    x:Name="btnCopyCode" 
                    Margin="5" 
                    MinHeight="26" 
                    MinWidth="140" 
                    Content="{x:Static properties:Resources.CopyCode}"
                    Click="btnCopyCode_Click"/>
                <TextBox 
                    x:Name="codeTextBlock"
                    Grid.Column="1" 
                    FontFamily="Tahoma"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Left" 
                    Margin="20,0,0,0" 
                    Foreground="White"  
                    MinWidth="250"
                    Width="Auto" 
                    IsReadOnly="True"
                    PreviewMouseLeftButtonDown="codeTextBlock_PreviewMouseLeftButtonDown" 
                    GotKeyboardFocus="codeTextBlock_GotKeyboardFocus"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
