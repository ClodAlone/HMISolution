<wpfutilities:BarManagerBase
    xmlns:wpfutilities="clr-namespace:WPFUtilities;assembly=WPFUtilities" x:Class="ReportManager.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"  
             xmlns:self="clr-namespace:ReportManager"
             xmlns:properties="clr-namespace:ReportManager.Properties"
             xmlns:translatableMenu="clr-namespace:TranslatableMenu.Properties;assembly=TranslatableMenu"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             dx:DXSerializer.SerializationID="ReportsBarManager"
             mc:Ignorable="d">
    <dxb:BarManager.Items>
        <dxb:BarSubItem x:Name="biProjectReport" Content="{x:Static translatableMenu:Resources.ProjectRibbonTitle}">
            <dxb:BarSubItem MergeOrder="40" x:Name="biReports" Content="{x:Static properties:Resources.TypeTitle}" MergeType="MergeItems">
                <!--<dxb:BarButtonItem x:Name="biAddNewReport" CategoryName="{x:Static properties:Resources.DocumentEditorRibbonTitle}" 
                                   RibbonStyle="SmallWithText" ItemClick="OnAddNewReport_Click" 
                                   Content="{x:Static properties:UICommandResource.AddNewReportText}" Glyph="../Images/ReportManager.png"/>-->
            </dxb:BarSubItem>
        </dxb:BarSubItem>
    </dxb:BarManager.Items>
    <dxb:BarManager.Bars>
        <dxb:Bar IsMainMenu="True" x:Name="reportMenu">
            <dxb:BarSubItemLink BarItemName="biProjectReport" MergeType="MergeItems" />
        </dxb:Bar>
        <!--<dxb:Bar dxb:MergingProperties.Name="reportToolbar" x:Name="reportToolBar1"
                GlyphSize="Small" ShowDragWidget="True" 
                AllowCustomizationMenu="True" 
                AllowDrop="False" 
                AllowHide="True"
                AllowCollapse="False"
                AllowQuickCustomization="True">
            <dxb:BarButtonItemLink ToolTipService.ShowOnDisabled="True" BarItemName="biAddNewReportText"/>
        </dxb:Bar>-->
    </dxb:BarManager.Bars>
</wpfutilities:BarManagerBase>
