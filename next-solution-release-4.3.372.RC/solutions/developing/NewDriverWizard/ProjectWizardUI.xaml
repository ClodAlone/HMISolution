<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NewDriverWizard"
    xmlns:properties="clr-namespace:NewDriverWizard.Properties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
    mc:Ignorable="d" x:Class="NewDriverWizard.ProjectWizardUI"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
    xmlns:converters="clr-namespace:WizardPluginHelpers.Converters;assembly=WizardPluginHelpers" 
    xmlns:command="clr-namespace:WizardPluginHelpers;assembly=WizardPluginHelpers">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/SharedResources;component/Resources/CustomWizard.xaml" />
                <ResourceDictionary Source="/WizardPluginHelpers;component/Dictionaries.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>
    <DockPanel  Grid.Row="0"
                      HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
      <command:HeaderControl x:Name="headerControl"
                              FontSize="{Binding FontSize,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                              FontFamily="{Binding FontFamily,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </DockPanel>
    <GroupBox Margin="10" Grid.Row="1" >
      <DockPanel LastChildFill="True"
                 VerticalAlignment="Center" HorizontalAlignment="Center" >
        <dxnav:NavBarControl x:Name="wizardControl" Margin="10,10,10,0"
          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <dxnav:NavBarControl.Groups>
            <dxnav:NavBarGroup Header="{x:Static properties:Resources.Step1}"
                                DisplaySource="Content" GroupScrollMode="None"
                                x:Name="PathItem">
              <dxnav:NavBarGroup.Content>
                <local:Step1 x:Name="Step1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
              </dxnav:NavBarGroup.Content>
            </dxnav:NavBarGroup>
            <dxnav:NavBarGroup Header="{x:Static properties:Resources.Step2}"
                                DisplaySource="Content" GroupScrollMode="None">
              <dxnav:NavBarGroup.Content>
                <local:Step2 x:Name="Step2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
              </dxnav:NavBarGroup.Content>
            </dxnav:NavBarGroup>
            <dxnav:NavBarGroup Header="{x:Static properties:Resources.Step3}"
                                DisplaySource="Content" GroupScrollMode="None">
              <dxnav:NavBarGroup.Content>
                <local:Step3 x:Name="Step3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
              </dxnav:NavBarGroup.Content>
            </dxnav:NavBarGroup>
            <dxnav:NavBarGroup Header="{x:Static properties:Resources.Step4}"
                                DisplaySource="Content" GroupScrollMode="None">
              <dxnav:NavBarGroup.Content>
                <local:Step4 x:Name="Step4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
              </dxnav:NavBarGroup.Content>
            </dxnav:NavBarGroup>
            <dxnav:NavBarGroup Header="{x:Static properties:Resources.Stop}"
                                DisplaySource="Content" GroupScrollMode="None">
              <dxnav:NavBarGroup.Content>
                <local:EndPage x:Name="End" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
              </dxnav:NavBarGroup.Content>
            </dxnav:NavBarGroup>
          </dxnav:NavBarControl.Groups>
          <dxnav:NavBarControl.View>
            <dxnav:NavigationPaneView x:Name="navigationPane"
                    IsExpandButtonVisible="False" MaxVisibleGroupCount="0"
                    IsOverflowPanelVisible="False" IsSplitterVisible="False"
                    ItemsPanelOrientation="Horizontal">
              <dxnav:NavigationPaneView.GroupHeaderTemplate>
                <ControlTemplate/>
              </dxnav:NavigationPaneView.GroupHeaderTemplate>
            </dxnav:NavigationPaneView>
          </dxnav:NavBarControl.View>

        </dxnav:NavBarControl>
      </DockPanel>
    </GroupBox>
    <DockPanel  Grid.Row="2"
                 HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
      <command:FooterControl x:Name="footerControl"
                              FontSize="{Binding FontSize,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                              FontFamily="{Binding FontFamily,UpdateSourceTrigger=PropertyChanged, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                             Next="footerControl_Next"
                             Prev="footerControl_Prev"
                             Cancel="footerControl_Cancel"
                             Finish="footerControl_Finish"
                                 Help="footerControl_Help"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </DockPanel>
  </Grid>
</UserControl>
