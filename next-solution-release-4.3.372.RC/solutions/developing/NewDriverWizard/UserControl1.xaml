<UserControl x:Class="NewDriverWizard.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:properties="clr-namespace:NewDriverWizard.Properties" Width="650" Height="190"
             xmlns:converters="clr-namespace:NewDriverWizard">
    <UserControl.Resources>
        <converters:StepToBackgroundConverter x:Key="StepToBackgroundConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="98*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Column="1" Foreground="Black" VerticalAlignment="Center" Content="{x:Static properties:Resources.PluginTitle}" FontSize="20" FontFamily="Segoe UI Symbol" FontWeight="Bold" Height="37"/>
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="34">
                <Ellipse Height="34" Fill="{Binding SelectedStep, ConverterParameter=0, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}" Stroke="{Binding SelectedStep, ConverterParameter=-1, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Static properties:Resources.Start}"
						HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" Margin="2,2,2,2" TextWrapping="Wrap" Width="Auto" Height="Auto"
						Foreground="White" d:LayoutOverrides="Width, Height" />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ed:BlockArrow Grid.Column="0" HorizontalAlignment="Left" Orientation="Right" Width="14" Height="2" 
						Fill="#FFFF7F27" Stroke="#FFFF7F27"/>

                <TextBlock TextWrapping="Wrap" Grid.Column="1" Foreground="White" FontSize="11" 
						HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Stretch"
						Text="{x:Static properties:Resources.Step1}" MinHeight="50"
						Background="{Binding SelectedStep, ConverterParameter=1, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="{x:Static properties:Resources.Step1Comment}" />
            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ed:BlockArrow Grid.Column="0" HorizontalAlignment="Left" Orientation="Right" Width="14" Height="2" 
						Fill="#FFFF7F27" Stroke="#FFFF7F27"/>

                <TextBlock TextWrapping="WrapWithOverflow" Grid.Column="1" Foreground="White" FontSize="11" 
						HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Stretch"
						Text="{x:Static properties:Resources.Step2}" MinHeight="50"
						Background="{Binding SelectedStep, ConverterParameter=2, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="{x:Static properties:Resources.Step2Comment}" />
            </Grid>
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ed:BlockArrow Grid.Column="0" HorizontalAlignment="Left" Orientation="Right" Width="14" Height="2" 
						Fill="#FFFF7F27" Stroke="#FFFF7F27"/>

                <TextBlock TextWrapping="WrapWithOverflow" Grid.Column="1" Foreground="White" FontSize="11" 
						HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Stretch"
						Text="{x:Static properties:Resources.Step3}" MinHeight="50"
						Background="{Binding SelectedStep, ConverterParameter=3, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="{x:Static properties:Resources.Step3Comment}" />
            </Grid>
            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ed:BlockArrow Grid.Column="0" HorizontalAlignment="Left" Orientation="Right" Width="14" Height="2" 
						Fill="#FFFF7F27" Stroke="#FFFF7F27"/>

                <TextBlock TextWrapping="WrapWithOverflow" Grid.Column="1" Foreground="White" FontSize="11" 
						HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Stretch"
						Text="{x:Static properties:Resources.Step4}" MinHeight="50"
						Background="{Binding SelectedStep, ConverterParameter=4, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="{x:Static properties:Resources.Step4Comment}" />

                <ed:BlockArrow Grid.Column="2" HorizontalAlignment="Left" Orientation="Right" Width="14" Height="2" 
						Fill="#FFFF7F27" Stroke="#FFFF7F27"/>
            </Grid>
            <Grid Grid.Column="5" Width="34">
                <Ellipse   Height="34"  Fill="{Binding SelectedStep, ConverterParameter=5, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}" 
						Stroke="{Binding SelectedStep, ConverterParameter=5, Converter={StaticResource StepToBackgroundConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{x:Static properties:Resources.End}" 
						HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" Margin="2,2,2,2" TextWrapping="Wrap" Width="Auto" Height="Auto"
						Foreground="White" d:LayoutOverrides="Width, Height" />
            </Grid>

        </Grid>

    </Grid>
</UserControl>