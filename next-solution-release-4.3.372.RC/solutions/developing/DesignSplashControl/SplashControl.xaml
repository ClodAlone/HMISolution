<UserControl x:Class="DesignSplashControl.SplashControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Width="911" Height="513"
             mc:Ignorable="d" Background="{x:Null}">
    <Grid>
        <Image Stretch="Fill" Source="Images\SPLASHNEXT.png" />
        <Button Content="X" Click="Button_Click" 
                FontFamily="Arial" FontSize="12" FontWeight="Regular" HorizontalAlignment="Right" VerticalAlignment="Top" 
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                Background="White" Foreground="#004B8D" />
    </Grid>
</UserControl>
