<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" x:Class="WatchControl.WatchControl"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:WatchControl.Converters"
             xmlns:properties="clr-namespace:WatchControl.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:NullToEmptyStringMultiValueConverter x:Key="NullToEmptyStringMultiValueConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAdd" Content="{x:Static properties:Resources.AddButton}" Click="ButtonAdd_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2"/>
            <Button Grid.Column="1" x:Name="btnDelete" Content="{x:Static properties:Resources.DeleteButton}" IsEnabled="False" Click="ButtonDelete_Click" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2"/>
        </Grid>
        <dxg:GridControl Grid.Row="1" x:Name="gridControl" AutoExpandAllGroups="True" AllowLiveDataShaping="True">
            <dxg:GridControl.Columns>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.ColumnName}">
                </dxg:GridColumn>
                <dxg:GridColumn x:Name="colValue" FieldName="ColumnValue" Header="{x:Static properties:Resources.ColumnValue}">
                    <dxg:GridColumn.DisplayMemberBinding>
                        <MultiBinding Converter="{StaticResource NullToEmptyStringMultiValueConverter}" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                            <Binding Path="MonitoredItemViewModel.Value" Mode="TwoWay" />
                            <Binding Path="Format" Mode="OneWay" />
                            <Binding Path="MonitoredItemViewModel.DataValue" Mode="OneWay" />
                        </MultiBinding>
                    </dxg:GridColumn.DisplayMemberBinding>
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
              <dxg:GridColumn x:Name="formatValue" DisplayMemberBinding="{Binding Path=Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{x:Static properties:Resources.ColumnFormat}">
                <dxg:GridColumn.EditSettings>
                  <dxe:ComboBoxEditSettings IsTextEditable="False" IsSynchronizedWithCurrentItem="True"
                                            ItemsSource="{dxe:EnumItemsSource EnumType={x:Type converters:DisplayStringFormat}, SplitNames=True}"/>
                </dxg:GridColumn.EditSettings>
              </dxg:GridColumn>
              <dxg:GridColumn x:Name="colTimeStamp" DisplayMemberBinding="{Binding Path=MonitoredItemViewModel.TimeStamp, Mode=OneWay}" Header="{x:Static properties:Resources.ColumnTimestamp}">
                </dxg:GridColumn>
                <dxg:GridColumn x:Name="colQuality" DisplayMemberBinding="{Binding Path=MonitoredItemViewModel.Quality, Mode=OneWay}" Header="{x:Static properties:Resources.ColumnQuality}">
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="tableView" AllowPerPixelScrolling="True" ShowTotalSummary="True" AllowColumnMoving="True"
                             ShowSearchPanelMode="Always" SearchPanelFindMode="Always" ShowSearchPanelMRUButton="True"
                             ShowFilterPanelMode="ShowAlways" NewItemRowPosition="None"
                             FocusedRowChanged="tableView_FocusedRowChanged"
                             CellValueChanging="TableView_CellValueChanging"
                             AutoWidth="true" ShowGroupedColumns="True" NavigationStyle="Cell" 
                             MultiSelectMode="Row"
                             EditorShowMode="MouseDown" EnableImmediatePosting="False"
                             EditorButtonShowMode="ShowAlways" 
                             ValidateCell="tableView_ValidateCell">
              </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>

    </Grid>
</UserControl>
