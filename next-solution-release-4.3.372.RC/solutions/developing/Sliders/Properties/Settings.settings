<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="Sliders.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="SvgFrameworkProperties" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Orientation|TickPlacement|SmallChange|LargeChange|Delay|Interval|IsMoveToPointEnabled|IsSnapToTickEnabled</Value>
