<UserControl x:Class="GPIO.Controls.ControlEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"      
             xmlns:local="clr-namespace:GPIO.Controls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:properties="clr-namespace:GPIO.Properties" 
             xmlns:settings="clr-namespace:GPIO.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommandBinding_Executed" CanExecute="NewCommandBinding_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Delete" Executed="DeleteCommandBinding_Executed" CanExecute="DeleteCommandBinding_CanExecute" />
        <CommandBinding Command="EditingCommands.MoveUpByLine" Executed="MoveUpCommandBinding_Executed" CanExecute="MoveUpCommandBinding_CanExecute" />
        <CommandBinding Command="EditingCommands.MoveDownByLine" Executed="MoveDownCommandBinding_Executed" CanExecute="MoveDownCommandBinding_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyCommandBinding_Executed" CanExecute="CopyCommandBinding_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="PasteCommandBinding_Executed" CanExecute="PasteCommandBinding_CanExecute" />
    </UserControl.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <dxg:GridControl Name="gridControl">
            <dxg:GridControl.Columns>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Pin, Mode=TwoWay}" ReadOnly="False" Header="{x:Static properties:Resources.PinColumnHeader}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=Type, Mode=TwoWay}" ReadOnly="False" Header="{x:Static properties:Resources.TypeColumnHeader}">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dxe:ComboBoxEdit Name="PART_Editor" IsTextEditable="False" ApplyItemTemplateToSelectedItem="True">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EnumItemsSourceBehavior EnumType="{x:Type settings:GPIOType}" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxe:ComboBoxEdit>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=DebounceTimeout, Mode=TwoWay}" ReadOnly="False" Header="{x:Static properties:Resources.DebounceTimeoutColumnHeader}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=PubNubPublish, Mode=TwoWay}" ReadOnly="False" Header="{x:Static properties:Resources.PubNubPublishHeader}" />
                <dxg:GridColumn DisplayMemberBinding="{Binding Path=PubNubChannel, Mode=TwoWay}" ReadOnly="False" Header="{x:Static properties:Resources.PubNubChannelHeader}" />

            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView Name="tableView" ShowGroupPanel="False" MouseDoubleClick="tableView_MouseDoubleClick"/>
            </dxg:GridControl.View>
        </dxg:GridControl>
        <WrapPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1">
            <Button Width="32" Height="32" Command="ApplicationCommands.New" Margin="5" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                Path=Command.Text}">
                <Image Source="..\Images\new_16x16.png"/>
            </Button>


            <Button Width="32" Height="32" Command="EditingCommands.MoveUpByLine" Margin="5" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                Path=Command.Text}">
                <Image Source="..\Images\Road-Forward.png"/>
            </Button>
            <Button Width="32" Height="32" Command="EditingCommands.MoveDownByLine" Margin="5" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                    Path=Command.Text}">
                <Image Source="..\Images\Road-Backward.png"/>
            </Button>
            <Button Width="32" Height="32" Command="ApplicationCommands.Copy" Margin="5" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                Path=Command.Text}">
                <Image Source="..\Images\Copy.png"/>
            </Button>
            <Button Width="32" Height="32" Command="ApplicationCommands.Paste" Margin="5" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                Path=Command.Text}">
                <Image Source="..\Images\Paste.png"/>
            </Button>
            <Button Width="32" Height="32" Command="ApplicationCommands.Delete" Margin="5" ToolTip="{Binding RelativeSource={RelativeSource Self}, 
                                                                                Path=Command.Text}">
                <Image Source="..\Images\Delete.png"/>
            </Button>

            <Button Content="{x:Static properties:Resources.PubNubSettingsHeader}" Click="Button_Click"/>
        </WrapPanel>
    </Grid>
    
</UserControl>
