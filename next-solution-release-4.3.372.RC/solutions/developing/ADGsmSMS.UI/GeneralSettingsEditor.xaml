<UserControl x:Class="ADGsmSMS.UI.GeneralSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:WPFUtilities.Converters;assembly=WPFUtilities"
             xmlns:templates="clr-namespace:WPFUtilities.PropertyDataTemplate;assembly=WPFUtilities"
             xmlns:properties="clr-namespace:ADGsmSMS.UI.Properties"
             xmlns:cc="http://progea.com/CommonControls"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedResources;component/Resources/DataError.xaml" />
                <ResourceDictionary Source="/SharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static properties:Resources.Title}" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>

            <TextBlock Text="{x:Static properties:Resources.Timeout}" Grid.Column="0" Grid.Row="1" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Timeout" Grid.Column="2" Grid.Row="1" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding Timeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="1" Grid.Column="3" 
                Content="{Binding ElementName=Timeout, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Pause}" Grid.Column="0" Grid.Row="2" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Pause" Grid.Column="2" Grid.Row="2" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding Pause, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="2" Grid.Column="3" 
                Content="{Binding ElementName=Pause, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.InitString}" Grid.Column="0" Grid.Row="3" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="InitString" Grid.Column="2" Grid.Row="3" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding InitString, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="3" Grid.Column="3" 
                Content="{Binding ElementName=InitString, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.ServiceCenter}" Grid.Column="0" Grid.Row="4" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="ServiceCenter" Grid.Column="2" Margin="0,5" Grid.Row="4" Validation.ErrorTemplate="{x:Null}" Text="{Binding ServiceCenter, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="4" Grid.Column="3" 
                Content="{Binding ElementName=ServiceCenter, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Pin}" Grid.Column="0" Grid.Row="5" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Pin" Grid.Column="2" Grid.Row="5" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding Pin, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="5" Grid.Column="3" 
                Content="{Binding ElementName=Pin, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.PUK}" Grid.Column="0" Grid.Row="6" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="PUK" Grid.Column="2" Grid.Row="6" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding PUK, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="6" Grid.Column="3" 
                Content="{Binding ElementName=PUK, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.Pin2}" Grid.Column="0" Grid.Row="7" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="Pin2" Grid.Column="2" Grid.Row="7" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding Pin2, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="7" Grid.Column="3" 
                Content="{Binding ElementName=Pin2, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.SendPDU}" Grid.Column="0" Grid.Row="8" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="8" Grid.Column="2" Margin="0,5" Validation.ErrorTemplate="{x:Null}" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center" 
                      IsChecked="{Binding SendPDU, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>
            <!--<TextBox Name="SendPDU" Grid.Column="2" Grid.Row="8" Text="{Binding SendPDU, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>-->
            <ContentPresenter Grid.Row="8" Grid.Column="3" 
                Content="{Binding ElementName=SendPDU, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortName}" Grid.Column="0" Grid.Row="9" Margin="0,1" VerticalAlignment="Center"/>
            <ComboBox Name="CmbPort" Grid.Column="2" Grid.Row="9"  Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding CommPortName, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" >
            </ComboBox>
            <ContentPresenter Grid.Row="9" Grid.Column="3" 
                Content="{Binding ElementName=CmbPort, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortNameLinux}" Grid.Column="0" Grid.Row="10" Margin="0,1" VerticalAlignment="Center"/>
            <ComboBox Name="CmbPortLinux" Grid.Column="2" Grid.Row="10"  Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      DisplayMemberPath="Value" IsEditable="True"
                      SelectedValuePath="Value"
                      Text="{Binding CommPortNameLinux, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}" >
            </ComboBox>
            <ContentPresenter Grid.Row="10" Grid.Column="3" 
                Content="{Binding ElementName=CmbPortLinux, Path=(Validation.Errors).CurrentItem}"/>
            
            <TextBlock Text="{x:Static properties:Resources.CommPortBaudRate}" Grid.Column="0" Grid.Row="11" Margin="0,1" VerticalAlignment="Center"/>
            <ComboBox Name="CmbBaud" Grid.Column="2" Grid.Row="11" Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding CommPortBaudRate, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="11" Grid.Column="3" 
                Content="{Binding ElementName=CmbBaud, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortDataBits}" Grid.Column="0" Grid.Row="12" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="CommPortDataBits" Grid.Column="2" Grid.Row="12" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding CommPortDataBits, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="12" Grid.Column="3" 
                Content="{Binding ElementName=CommPortDataBits, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortParity}" Grid.Column="0" Grid.Row="13" Margin="0,1" VerticalAlignment="Center"/>
            <ComboBox Name="CmbParity" Grid.Column="2" Grid.Row="13" Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key" 
                      SelectedIndex="{Binding Path=CommPortParity, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"
                      >
            </ComboBox>
            <ContentPresenter Grid.Row="13" Grid.Column="3" 
                Content="{Binding ElementName=CmbParity, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortStopBits}" Grid.Column="0" Grid.Row="14" Margin="0,1" VerticalAlignment="Center"/>
            <ComboBox Name="CmbStop" Grid.Column="2" Grid.Row="14" Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding Path=CommPortStopBits, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="14" Grid.Column="3" 
                Content="{Binding ElementName=CmbStop, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortHandshake}" Grid.Column="0" Grid.Row="15" Margin="0,1" VerticalAlignment="Center"/>
            <ComboBox Name="CmbHandShake" Grid.Column="2" Grid.Row="15" Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedIndex="{Binding Path=CommPortHandshake, Mode=TwoWay, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}">
            </ComboBox>
            <ContentPresenter Grid.Row="15" Grid.Column="3" 
                Content="{Binding ElementName=CmbHandShake, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortRtsEnable}" Grid.Column="0" Grid.Row="16" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="16" Grid.Column="2" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center"  Margin="0,5" Validation.ErrorTemplate="{x:Null}"
                      IsChecked="{Binding CommPortRtsEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

            <TextBlock Text="{x:Static properties:Resources.CommPortDtrEnable}" Grid.Column="0" Grid.Row="17" Margin="0,1" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="17" Grid.Column="2" HorizontalAlignment="Left" Width="Auto"  VerticalAlignment="Center" Margin="0,5"  Validation.ErrorTemplate="{x:Null}"
                      IsChecked="{Binding CommPortDtrEnable, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></CheckBox>

            <TextBlock Text="{x:Static properties:Resources.CommPortReadTimeout}" Grid.Column="0" Grid.Row="18" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="CommPortReadTimeout" Grid.Column="2" Grid.Row="18" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding CommPortReadTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="18" Grid.Column="3" 
                Content="{Binding ElementName=CommPortReadTimeout, Path=(Validation.Errors).CurrentItem}"/>

            <TextBlock Text="{x:Static properties:Resources.CommPortWriteTimeout}" Grid.Column="0" Grid.Row="19" Margin="0,1" VerticalAlignment="Center"/>
            <TextBox Name="CommPortWriteTimeout" Grid.Column="2" Grid.Row="19" Margin="0,5" Validation.ErrorTemplate="{x:Null}" Text="{Binding CommPortWriteTimeout, ValidatesOnDataErrors=True, UpdateSourceTrigger = PropertyChanged}"></TextBox>
            <ContentPresenter Grid.Row="19" Grid.Column="3" 
                Content="{Binding ElementName=CommPortWriteTimeout, Path=(Validation.Errors).CurrentItem}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
