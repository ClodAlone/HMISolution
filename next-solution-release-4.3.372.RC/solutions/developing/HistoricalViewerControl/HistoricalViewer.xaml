<UserControl x:Class="HistoricalViewerControl.HistoricalViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="http://progea.com/CommonControls"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:properties="clr-namespace:HistoricalViewerControl.Properties"
             xmlns:enum="clr-namespace:HistoricalViewerControl"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:self="clr-namespace:HistoricalViewerControl.Converters"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:dxcn="clr-namespace:DevExpress.Xpf.Core.Native;assembly=DevExpress.Xpf.Core.v21.2"
             xmlns:dxght="clr-namespace:DevExpress.Xpf.Grid.HitTest;assembly=DevExpress.Xpf.Grid.v21.2"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:layout="clr-namespace:GridLayout;assembly=GridLayout"
             xmlns:utilities="clr-namespace:WPFUtilities;assembly=WPFUtilities"
             xmlns:commonproperties="clr-namespace:WPFUtilities.Properties;assembly=WPFUtilities"
             xmlns:remoteconverters="clr-namespace:Converters;assembly=Converters"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" Height="835" Width="865">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RuntimeLightSharedResources;component/Resources/SharedImages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <remoteconverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <self:ErrorInfoToBooleanConverter x:Key="ErrorInfoToBooleanConverter" />
            <self:ErrorInfoToVisibilityConverter x:Key="ErrorInfoToVisibilityConverter" />
            <remoteconverters:UTCToLocalConverterWithClientOffset x:Key="UTCToLocalConverterWithClientOffset" />
            <remoteconverters:DateTimeCurrentCultureConverter x:Key="DateTimeCurrentCultureConverter"/>
            <remoteconverters:DataValueToCurrentCulture x:Key="DataValueToCurrentCulture" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" x:Name="view">
        <DockPanel.Resources>
            
            <!-- *************************************************************** -->

            <!-- GRID CONTROL -->
            <!-- Header Foreground -->
            <DataTemplate x:Key="ColumnHeaderTemplate">
                <Border>
                    <ContentPresenter Name="contentPresenter" Content="{Binding}" TextBlock.Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontFamily="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontSize="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontWeight="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" TextBlock.FontStyle="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                     Style="{Binding  Path=(dxg:BaseGridHeader.GridColumn).ActualColumnHeaderContentStyle, RelativeSource={RelativeSource TemplatedParent}}">
                    </ContentPresenter>
                </Border>
            </DataTemplate>
            <!-- END GRID CONTROL -->
            <DiscreteObjectKeyFrame x:Key="colTextWrapKey" Value="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></DiscreteObjectKeyFrame>
        </DockPanel.Resources>
        <dxb:BarContainerControl ContainerType="Top" DockPanel.Dock="Top" x:Name="toolbar">
            <dxb:ToolBarControl UseWholeRow="True" BarItemDisplayMode="ContentAndGlyph" dxb:MergingProperties.Name="mainHistoricalViewerToolBar"
                               dxb:MergingProperties.ToolBarMergeStyle="All" dxb:MergingProperties.ElementMergingBehavior="InternalWithExternal"
                               dxb:MergingProperties.AllowMerging="False" IsMultiLine="False" ShowDragWidget="False" AllowCustomizationMenu="False" AllowQuickCustomization="False" AllowDrop="False">
              <dxb:BarLinkContainerItem x:Name="toolbarSettings" IsVisible="{Binding Editable, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                  <dxb:BarStaticItem ShowBorder="False" x:Name="configMemoryTitle" Content="{x:Static properties:Resources.ActualSettings}" />
                  <dxb:BarEditItem x:Name="configMemory" Content="{x:Static properties:Resources.ActualSettings}"
                                  UseLightweightTemplates="False" EditValueChanged="configMemory_SelectionChanged" LostFocus="configMemory_LostFocus" PreviewKeyDown="configMemory_PreviewKeyDown">
                    <dxb:BarEditItem.EditTemplate>
                      <DataTemplate>
                        <dxe:ComboBoxEdit 
                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type dxb:IBarEditItemLinkControl}}, Path=DataContext}"
                                        Name="PART_Editor" MinWidth="{Binding Source={x:Static commonproperties:Settings.Default},Path=RibbonBaseEditMinWidth}" IsTextEditable="True" />
                      </DataTemplate>
                    </dxb:BarEditItem.EditTemplate>
                  </dxb:BarEditItem>

                    <dxb:BarButtonItem Glyph="{DynamicResource ClearSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="clearSmall" Command="{Binding ResetCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.ResetSettingsTooltip}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource SaveSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="saveSmall" Command="{Binding SaveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.SaveConfiguration}" />
                    <dxb:BarButtonItem Glyph="{DynamicResource CancelSmall}" GlyphSize="Custom" CustomGlyphSize="16,16" x:Name="cancelSmall" Command="{Binding RemoveCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" ToolTipService.ShowOnDisabled="True" ToolTip="{x:Static properties:Resources.DeleteSettings}" />
                </dxb:BarLinkContainerItem>
                <dxb:BarButtonItem x:Name="bestFit" Content="{x:Static properties:Resources.BestFit}" ItemClick="Click_BestFit" />
                <dxb:BarItemSeparator />
                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="startTime" Content="{x:Static properties:Resources.HistoricalEvents_DateTimeStart}" EditValue="{Binding DateTimeStart,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                        </dxe:TextEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarEditItem UseLightweightTemplates="False" x:Name="endTime" Content="{x:Static properties:Resources.HistoricalEvents_DateTimeEnd}" EditValue="{Binding DateTimeEnd,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" MaskUseAsDisplayFormat="True" MaskCulture="{Binding CurrentCulture,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}">
                        </dxe:TextEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
            </dxb:ToolBarControl>
        </dxb:BarContainerControl>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MinHeight="40" DockPanel.Dock="Top" x:Name="options" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="16*" />
                </Grid.ColumnDefinitions>
                <Button  ToolTipService.ShowOnDisabled="True" x:Name="Button1" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_Minute}" Grid.Column="0" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.Minute}" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button2" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_Hour}" Grid.Column="1" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.Hour}" />
                <Button  ToolTipService.ShowOnDisabled="True" x:Name="Button3" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_Day}" Grid.Column="2" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.Day}" />
                <Button  ToolTipService.ShowOnDisabled="True" x:Name="Button4" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_Week}" Grid.Column="3" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.Week}" />
                <Button ToolTipService.ShowOnDisabled="True" x:Name="Button5" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_Month}" Grid.Column="4" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.Month}" />
                <Button  ToolTipService.ShowOnDisabled="True" x:Name="Button6" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_Year}" Grid.Column="5" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.Year}" />
                <Button  ToolTipService.ShowOnDisabled="True" x:Name="Button7" Grid.Row="1" 
                        Content="{x:Static properties:Resources.HistoricalEvents_All}" Grid.Column="6" 
                        Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.All}" />
                <ComboBox VerticalContentAlignment="Center"  x:Name="Combo" Grid.Row="1" SelectionChanged="Combo_SelectionChanged" SelectedItem="{Binding HistoricalName,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="7" />
                <utilities:ComboWeb Visibility="Collapsed" VerticalContentAlignment="Center"  x:Name="Combo_web" Grid.Row="1" SelectionChanged="Combo_SelectionChanged" SelectedItem="{Binding HistoricalName,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Grid.Column="7" />
            </Grid>
            <Grid DockPanel.Dock="Bottom" Grid.Row="2" x:Name="commands">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button MinHeight="40" Grid.Column="0" 
                         x:Name="Button8" Content="{x:Static properties:Resources.RefreshDataCommand}" Command="{Binding Path=RefreshDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                        CommandParameter="{x:Static utilities:DateSpan.None}" />
                <Button Grid.Row="2" Grid.Column="1" 
                        MinWidth="16" x:Name="Button9"
    		ToolTip="{x:Static properties:Resources.ExportDataCommand}"
    		Command="{Binding Path=ExportDataCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="1"
    		 Tag="ButtonExportData">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.ExportDataCommand}" Background="{x:Null}" x:Name="txtExport" />
                    </StackPanel>
                </Button>
                <ComboBox MinWidth="90" Visibility="Visible" Grid.Column="2" x:Name="cmbExportType" SelectionChanged="cmbExportType_SelectionChanged" />
                <Border Grid.Column="3" BorderThickness="1" 
                        BorderBrush="{dxi:ThemeResource {dxgt:GridRowThemeKey ResourceKey=BorderBrush}}"
                        Background="{dxi:ThemeResource {dxt:FloatingContainerThemeKey ResourceKey=FloatingContainerBackground}}">
                    <dxe:CheckEdit ShowBorder="True" Grid.Column="3" x:Name="chkMultiLine" Content="{x:Static properties:Resources.HistoricalEvents_MultilineExportOption}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" Checked="chkMultiLine_Checked" Unchecked="chkMultiLine_Unchecked"></dxe:CheckEdit>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <dxg:GridControl MinHeight="10" MinWidth="10" Visibility="Visible"
			                 Tag="DataSourceStyle"
                             AutoExpandAllGroups="True"
			                 x:Name="gridControl"
                             AllowDrop="True" 
                             AllowLiveDataShaping="False"                         
                             dxg:DataControlSerializationOptions.AddNewColumns="False" 
    		                 dxg:DataControlSerializationOptions.RemoveOldColumns="False"
                             dx:DXSerializer.SerializationID="gridControl" dx:DXSerializer.StoreLayoutMode="All" >
                    <dxg:GridControl.Resources>
                        <Style TargetType="{x:Type dxg:BaseGridHeader}">
                            <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        </Style>
                        <Style x:Key="columnStyle" BasedOn="{StaticResource {x:Type dxg:BaseGridHeader}}" TargetType="{x:Type dxg:BaseGridHeader}">
                            <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontFamily" Value="{Binding HeaderFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontSize" Value="{Binding HeaderFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontWeight" Value="{Binding HeaderFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            <Setter Property="FontStyle" Value="{Binding HeaderFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        </Style>
                        <Style x:Key="printColumnHeaderStyle" BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintHeaderStyle}}" TargetType="dxe:TextEdit">
                            <Setter Property="TextWrapping" Value="{Binding Value, Source={StaticResource colTextWrapKey}}" />
                        </Style>
                    </dxg:GridControl.Resources>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" ShowTotalSummary="True" AutoWidth="False"
                        InvalidRowException="tableView_InvalidRowException"
                        HorizontalScrollbarVisibility="Auto"
                        VerticalScrollbarVisibility="Auto"
                        AllowEditing="False"
                        FadeSelectionOnLostFocus="False" 
                        BestFitMode="VisibleRows"
                        AllowBestFit="True" 
                        AllowResizing="True"
                        AllowColumnMoving="True"
                        ShowGroupPanel="True"
                        ShowSearchPanelMode="Always" 
                        SearchPanelFindMode="Always" 
                        ShowSearchPanelMRUButton="True"
                        ShowFilterPanelMode="ShowAlways" 
                        NavigationStyle="Row" 
                        MultiSelectMode="Row">
                            <dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Setter Property="TextBlock.FontFamily" Value="{Binding RowAreaFontSettings.FontFamily, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontSize" Value="{Binding RowAreaFontSettings.FontSize, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontWeight" Value="{Binding RowAreaFontSettings.FontWeight, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.FontStyle" Value="{Binding RowAreaFontSettings.FontStyle, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="TextBlock.Foreground" Value="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Style.Triggers>
                                        <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="true">
                                            <Setter Property="Background" Value="LightGray" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxg:TableView.RowStyle>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col1" FieldName="Name"
                                Header="{x:Static properties:Resources.TagName}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                          <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                              <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="2,2,2,2" TextWrapping="WrapWithOverflow">
                                  <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource 
                                                    DataValueToCurrentCulture}" Mode="OneWay">
                                      <Binding Path="Data.Name" />
                                      <Binding Path="StringPlaceolder" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                      <Binding Path="CurrentCulture" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                      <Binding Path="StringToRemove" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                    </MultiBinding>
                                  </TextBlock.Text>
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </dxg:GridColumn.CellTemplate>
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col2" FieldName="Value"
                                Header="{x:Static properties:Resources.Value}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col12" FieldName="Description"
                                Header="{x:Static properties:Resources.TagDescription}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col3" FieldName="dValue"
                                Header="{x:Static properties:Resources.dValue}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col4" FieldName="ValueBefore" 
                                Header="{x:Static properties:Resources.ValueBefore}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col5" FieldName="dValueBefore" 
                                Header="{x:Static properties:Resources.dValueBefore}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col6" FieldName="RecordDateTime" 
                                Header="{x:Static properties:Resources.RecordDateTime}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </dxg:GridColumn.EditSettings>
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="2,2,2,2" TextWrapping="WrapWithOverflow">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource 
                                                    DateTimeCurrentCultureConverter}" Mode="OneWay">
                                                    <Binding Path="Data.RecordDateTime" />
                                                    <Binding Path="CurrentCulture" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" Tag="RecordDateTimeMilliseconds" x:Name="Col61" FieldName="RecordDateTime" 
                                Header="{x:Static properties:Resources.RecordDateTimeMilliseconds}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="fff" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col7" Tag="SourceTimeStamp" FieldName="SourceTimeStamp" 
                                Header="{x:Static properties:Resources.SourceTimeStamp}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </dxg:GridColumn.EditSettings>
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="2,2,2,2" TextWrapping="WrapWithOverflow">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource 
                                                    DateTimeCurrentCultureConverter}" Mode="OneWay">
                                                    <Binding Path="Data.SourceTimeStamp" />
                                                    <Binding Path="CurrentCulture" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                                    <Binding Source="{x:Null}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col71" Tag="SourceTimeStampMilliseconds" FieldName="SourceTimeStamp" 
                                Header="{x:Static properties:Resources.SourceTimeStampMilliseconds}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="fff" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col72" FieldName="SourcePicoseconds"
                                Header="{x:Static properties:Resources.SourcePicoseconds}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col8" Tag="ServerTimeStamp" FieldName="ServerTimeStamp"
                                Header="{x:Static properties:Resources.ServerTimeStamp}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings MaskType="DateTime" Mask="G" MaskUseAsDisplayFormat="True" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </dxg:GridColumn.EditSettings>
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="grid" Background="Transparent" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="{Binding HorizontalColumnAlignment, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="2,2,2,2" TextWrapping="WrapWithOverflow">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource 
                                                    DateTimeCurrentCultureConverter}" Mode="OneWay">
                                                    <Binding Path="Data.ServerTimeStamp" />
                                                    <Binding Path="CurrentCulture" RelativeSource="{RelativeSource 
                                                    FindAncestor, AncestorType={x:Type UserControl}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col81" Tag="ServerTimeStampMilliseconds" FieldName="ServerTimeStamp"
                                Header="{x:Static properties:Resources.ServerTimeStampMilliseconds}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="fff" PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col82" FieldName="ServerPicoseconds" 
                                Header="{x:Static properties:Resources.ServerTimeStampPicoseconds}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col9" FieldName="Status" 
                                Header="{x:Static properties:Resources.Status}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col10" FieldName="UserName" 
                                Header="{x:Static properties:Resources.UserName}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowEditing="False" ReadOnly="True" x:Name="Col11" FieldName="Reason" 
                                Header="{x:Static properties:Resources.Reason}" PrintColumnHeaderStyle="{StaticResource printColumnHeaderStyle}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings PrintTextWrapping="{Binding ColumnTextWrap, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"></dxe:TextEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <!--<dxg:GridColumn x:Name="Col10" DisplayMemberBinding="{Binding Path=HistoricalName, Mode=OneWay}" 
                                Header="{x:Static properties:Resources.HistoricalName}" />-->
                    </dxg:GridControl.Columns>
                </dxg:GridControl>


                <cc:CircularProgressBar Background="Black" x:Name="busyControl" Opacity="0.3" Visibility="Collapsed" Grid.RowSpan="3" />
                <TextBlock x:Name="busyContent" Text="{x:Static properties:Resources.WaitText}" VerticalAlignment="Center" Grid.RowSpan="3"
                   HorizontalAlignment="Center" Visibility="Collapsed" />
                <Border Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                BorderThickness="1" BorderBrush="Gray" Background="Black" 
                Visibility="{Binding ElementName=errorInfo, Path=Text, Converter={StaticResource ErrorInfoToVisibilityConverter}}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="{Binding Path=ActualWidth, ElementName=gridDataControl1, Mode=OneWay}" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="2" Text="{x:Static properties:Resources.HistoricalViewerError}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Foreground="Red" />
                        <Button Grid.Column="1" Margin="2" Width="24" HorizontalAlignment="Right" Click="errorInfo_ClearMessage">
                            <Button.Content>
                                <Image x:Name="acknowledgeImg" Source="{DynamicResource Acknowledge}" Height="14" Width="14" />
                            </Button.Content>
                        </Button>
                        <TextBlock x:Name="errorInfo" Grid.Row="1" Grid.ColumnSpan="2" 
                            Margin="2" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Text="" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
        
</UserControl>
