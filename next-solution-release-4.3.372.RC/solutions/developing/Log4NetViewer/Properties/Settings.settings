<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="LogViewer.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="LogFileName" Type="System.String" Scope="Application">
      <Value Profile="(Default)">SysLog</Value>
    </Setting>
    <Setting Name="BackupFilePrefix" Type="System.String" Scope="Application">
      <Value Profile="(Default)">_backup_</Value>
    </Setting>
    <Setting Name="LogFileDefaultExt" Type="System.String" Scope="User">
      <Value Profile="(Default)">.xml</Value>
    </Setting>
    <Setting Name="LogFileFilter" Type="System.String" Scope="User">
      <Value Profile="(Default)">XML Files (*.xml)|*.xml</Value>
    </Setting>
  </Settings>
</SettingsFile>