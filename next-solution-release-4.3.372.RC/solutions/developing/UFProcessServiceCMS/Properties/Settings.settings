<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="UFProcessServiceCMS.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="ServiceManagerProcessArgs" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"/K" "/N{0}" "/Y{1}" "/F{2}" "/D{3}"</Value>
    </Setting>
    <Setting Name="ServiceInstallProcessParams" Type="System.String" Scope="Application">
      <Value Profile="(Default)"> "/P{0}-{1}"</Value>
    </Setting>
    <Setting Name="ServiceInstallProcess" Type="System.String" Scope="Application">
      <Value Profile="(Default)">InstallServerService.exe</Value>
    </Setting>
    <Setting Name="ServiceStartProcessArgs" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"/S" "/N{0}" "/Y{1}" "/F{2}"</Value>
    </Setting>
    <Setting Name="ServiceStopProcessArgs" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"/T" "/N{0}" "/Y{1}" "/F{2}"</Value>
    </Setting>
    <Setting Name="ServerOption" Type="System.String" Scope="Application">
      <Value Profile="(Default)">-noservice</Value>
    </Setting>
    <Setting Name="SuspendedOption" Type="System.String" Scope="Application">
      <Value Profile="(Default)">-suspend</Value>
    </Setting>
    <Setting Name="CallingProcessOption" Type="System.String" Scope="Application">
      <Value Profile="(Default)">"-processId={0}"</Value>
    </Setting>
    <Setting Name="DefaultOperationTimeout" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">5000</Value>
    </Setting>
  </Settings>
</SettingsFile>