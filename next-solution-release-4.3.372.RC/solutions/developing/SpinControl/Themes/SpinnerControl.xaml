<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:btl="clr-namespace:SpinControl"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="/SpinControl;component/Themes/Brushes.xaml" />-->
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type btl:SpinControl}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type btl:SpinControl}">
                    <Viewbox Stretch="Fill">
                        <Grid x:Name="content">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                          <RepeatButton Grid.Row="0" BorderThickness="0" x:Name="btnUp" Command="{Binding Path=IncreaseCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                            <Path x:Name="path" Margin="60"
                                  Data="F1M96.7954,54.4546L102.2724,63.9416L107.7504,73.4286L96.7954,73.4286L85.8404,73.4286L91.3184,63.9416z"
                                                Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RepeatButton}}}" Height="180" Canvas.Left="4.582" Stretch="Fill" Canvas.Top="12.39" Width="320" RenderTransformOrigin="0.5,0.5"/>
                          </RepeatButton>
                          <RepeatButton Grid.Row="1" BorderThickness="0" Margin="0,0,0,1"  Command="{Binding Path=DecreaseCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                            <Path x:Name="path1" Margin="60"
                                  Data="F1M96.7954,73.4287L91.3184,63.9417L85.8404,54.4547L96.7954,54.4547L107.7504,54.4547L102.2724,63.9417z"
                                                Fill="{Binding Foreground, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RepeatButton}}}" Height="180" Canvas.Left="4.582" Stretch="Fill" Canvas.Top="16.404" Width="320" RenderTransformOrigin="0.5,0.5"/>
                          </RepeatButton>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Resource dictionary entries should be defined here.  -->
</ResourceDictionary>
