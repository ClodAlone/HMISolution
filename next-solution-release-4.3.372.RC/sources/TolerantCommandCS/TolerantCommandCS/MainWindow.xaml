<Window x:Class="Bornander.UI.Commands.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test window" Height="Auto" Width="Auto">
    <StackPanel>
        <StackPanel>
            <Label Content="Save to file" FontWeight="Bold"/>
            <Label Content="This tests saving a text string to the file specified, try using the same filename twice or a bad filename."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Path=Filename}"/>
                <Button Grid.Column="1" Width="64" Content="Save" Command="{Binding Path=SaveFileCommand, Mode=OneWay}"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
