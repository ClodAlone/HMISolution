<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:Mindscape.WpfElements"
					xmlns:dg="clr-namespace:Mindscape.WpfElements.WpfDataGrid">

  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  
  <Style x:Key="EmptyStyle" />
  
  <Style x:Key="EditorDropDown" TargetType="{x:Type Popup}">
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="StaysOpen" Value="False" />
    <Setter Property="AllowsTransparency" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="PopupAnimation" Value="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimation}}" />
  </Style>
  
  <!-- DataGrid filtering -->
  
  <dg:TypeToFilterBuilderNameConverter x:Key="TypeToBuilderName" />
  <dg:ObjectToTypeConverter x:Key="ObjectToType" />
  
  <DataTemplate x:Key="FilterBuilderTemplate">
    <TextBlock Text="{Binding Converter={StaticResource TypeToBuilderName}}" />
  </DataTemplate>
  
  <DataTemplate x:Key="StringFilterSelectorTemplate">
    <StackPanel Width="160">
      <ComboBox SelectedItem="{Binding Builder, Converter={StaticResource ObjectToType}, Mode=TwoWay}" ItemTemplate="{StaticResource FilterBuilderTemplate}">
	    <x:Type TypeName="dg:StartsWithFilterBuilder" />
		<x:Type TypeName="dg:EndsWithFilterBuilder" />
		<x:Type TypeName="dg:ContainsFilterBuilder" />
	  </ComboBox>
	  <DockPanel Margin="0,4,0,0">
	    <ToggleButton IsChecked="{Binding MatchCase, Mode=TwoWay}" Content="Aa" Margin="4,0,0,0" DockPanel.Dock="Right" ToolTip="Match case" />
	    <TextBox Text="{Binding FirstValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
      </DockPanel>
	</StackPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="DecimalTemplate">
    <local:NumericTextBox Value="{Binding FirstValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
  </DataTemplate>
  
  <DataTemplate x:Key="DoubleTemplate">
    <local:NumericTextBox Value="{Binding FirstValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
  </DataTemplate>
  
  <DataTemplate x:Key="IntegerTemplate">
    <local:IntegerTextBox Value="{Binding FirstValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
  </DataTemplate>
  
  <DataTemplate x:Key="DateTimeTemplate">
    <local:DropDownDatePicker Value="{Binding FirstValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Format="ShortDate" />
  </DataTemplate>
  
  <local:MatchingTemplateSelector x:Key="ComparableTypeTemplateSelector">
    <dg:ComparableTypeTemplate ComparableType="{x:Type sys:Decimal}" Template="{StaticResource DecimalTemplate}" />
	<dg:ComparableTypeTemplate ComparableType="{x:Type sys:Double}" Template="{StaticResource DoubleTemplate}" />
	<dg:ComparableTypeTemplate ComparableType="{x:Type sys:Int32}" Template="{StaticResource IntegerTemplate}" />
	<dg:ComparableTypeTemplate ComparableType="{x:Type sys:DateTime}" Template="{StaticResource DateTimeTemplate}" />
  </local:MatchingTemplateSelector>
  
  <DataTemplate x:Key="ComparableFilterSelectorTemplate">
    <StackPanel Width="160">
      <ComboBox SelectedItem="{Binding Builder, Converter={StaticResource ObjectToType}, Mode=TwoWay}" ItemTemplate="{StaticResource FilterBuilderTemplate}">
	    <x:Type TypeName="dg:NoFilterBuilder" />
		<x:Type TypeName="dg:GreaterThanFilterBuilder" />
		<x:Type TypeName="dg:GreaterThanOrEqualToFilterBuilder" />
		<x:Type TypeName="dg:LessThanFilterBuilder" />
		<x:Type TypeName="dg:LessThanOrEqualToFilterBuilder" />
		<x:Type TypeName="dg:EqualsFilterBuilder" />
		<x:Type TypeName="dg:NotEqualFilterBuilder" />
	  </ComboBox>
	  <DockPanel Margin="0,4,0,0">
		<ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ComparableTypeTemplateSelector}" />
      </DockPanel>
	</StackPanel>
  </DataTemplate>
  
  <local:MatchingTemplateSelector x:Key="SecondaryFilterDescriptionTemplateSelector">
    <local:TypeTemplate DataType="{x:Type dg:StringFilterDescription}" Template="{StaticResource StringFilterSelectorTemplate}" />
	<local:TypeTemplate DataType="{x:Type dg:ComparableFilterDescription}" Template="{StaticResource ComparableFilterSelectorTemplate}" />
  </local:MatchingTemplateSelector>
  
  <DataTemplate x:Key="BooleanFilterSelectorTemplate">
    <StackPanel>
	  <ContentControl Content="{Binding FirstFilter}" ContentTemplateSelector="{StaticResource SecondaryFilterDescriptionTemplateSelector}" />
	  <ComboBox SelectedItem="{Binding Builder, Converter={StaticResource ObjectToType}, Mode=TwoWay}" ItemTemplate="{StaticResource FilterBuilderTemplate}"
	            Margin="0,8,0,8" Width="60" HorizontalAlignment="Left">
		<x:Type TypeName="dg:AndFilterBuilder" />
		<x:Type TypeName="dg:OrFilterBuilder" />
	  </ComboBox>
	  <ContentControl Content="{Binding SecondFilter}" ContentTemplateSelector="{StaticResource SecondaryFilterDescriptionTemplateSelector}" />
	</StackPanel>
  </DataTemplate>
  
  <DataTemplate x:Key="SelectableObjectTemplate">
	<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Value}" />
  </DataTemplate>
  
  <DataTemplate x:Key="ObjectFilterSelectorTemplate">
    <StackPanel Width="160">
	  <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}" Content="Select all" Margin="4,3,0,4" />
      <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
	                BorderThickness="1" Padding="3,2,2,1">
        <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource SelectableObjectTemplate}" />
	  </ScrollViewer>
	</StackPanel>
  </DataTemplate>
  
  <local:MatchingTemplateSelector x:Key="FilterDescriptionTemplateSelector" BasedOn="{StaticResource SecondaryFilterDescriptionTemplateSelector}">
    <local:TypeTemplate DataType="{x:Type dg:BooleanFilterDescription}" Template="{StaticResource BooleanFilterSelectorTemplate}" />
	<local:TypeTemplate DataType="{x:Type dg:ObjectFilterDescription}" Template="{StaticResource ObjectFilterSelectorTemplate}" />
  </local:MatchingTemplateSelector>
  
</ResourceDictionary>