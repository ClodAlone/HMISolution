<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="http://namespaces.mindscape.co.nz/wpf">

  <SolidColorBrush x:Key="{x:Static local:FilteringTextBoxBase.BorderBrushKey}" Color="#FFA4B97F" />

  <SolidColorBrush x:Key="ColoredButtonBorderBrush" Color="#FF8E997D" />

  <RadialGradientBrush x:Key="ColoredButtonFillBrush_Normal" Center="0,0" RadiusX="1" RadiusY="1">
    <GradientStop Offset="0" Color="#FFA2B48D" />
    <GradientStop Offset="1" Color="#FF94A576" />
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="ColoredButtonFillBrush_Hot" Center="0,0" RadiusX="1" RadiusY="1">
    <GradientStop Offset="0" Color="#FFCAD7A7" />
    <GradientStop Offset="1" Color="#FFC1CF96" />
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="ColoredButtonFillBrush_Down" Center="1,1" RadiusX="1" RadiusY="1">
    <GradientStop Offset="0" Color="#FF94A77C" />
    <GradientStop Offset="1" Color="#FF90A470" />
  </RadialGradientBrush>

  <Style x:Key="ColoredButtonBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource ColoredButtonBorderBrush}" />
    <Setter Property="Background" Value="{StaticResource ColoredButtonFillBrush_Normal}" />
  </Style>

  <Style x:Key="{x:Static local:DropDownEditBox.ToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Style="{StaticResource ColoredButtonBorder}" Padding="3,3,3,0" Name="Bd">
            <Path Fill="White" Data="M 1 0 L 4 3 L 7 0 L 8.5 1.5 L 4 5.5 L -0.5 1.5" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:Spin.SpinButtonStyleKey}" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Style="{StaticResource ColoredButtonBorder}" Padding="1,1.5,1.5,1.5" Name="Bd">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static local:MonthCalendar.SelectButtonStyleKey}" TargetType="ButtonBase">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Style="{StaticResource ColoredButtonBorder}" Padding="6,4,6,4" Name="Bd" Margin="2">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Hot}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColoredButtonFillBrush_Down}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>