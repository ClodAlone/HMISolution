<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:styles="clr-namespace:Mindscape.WpfElements.Themes"
  xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid"
  xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
  xmlns:s="clr-namespace:System;assembly=mscorlib"
  xmlns:e="clr-namespace:Mindscape.WpfElements">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/AlloyLight.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <!-- References -->
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  <pg:GroupingViewConverter x:Key="GroupingConverter" />
  <pg:MarginInversionConverter x:Key="MarginInversionConverter" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderMargin" Usage="Margin" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderPadding" Usage="Padding" />
  <pg:LevelToIndentConverter x:Key="LevelToIndentConverter" />

  <!-- Brushes -->

  <SolidColorBrush x:Key="GridBackground" Color="#7C7C7C" />
  <SolidColorBrush x:Key="GridNoGroupingBackground" Color="#9C9C9C" />
  
  <SolidColorBrush x:Key="GlyphBackgroundColor" Color="#BFBFBF" />
  <SolidColorBrush x:Key="GlyphForegroundColor" Color="White" />
  <SolidColorBrush x:Key="ExpansionGlyphForegroundColor" Color="Black" />
  <SolidColorBrush x:Key="MouseOverColor" Color="White" />
  <SolidColorBrush x:Key="MousePressedColor" Color="#FF333333" />

  <SolidColorBrush x:Key="TextColor" Color="Black" />
  <SolidColorBrush x:Key="ReadonlyTextColor" Color="#FF484848" />
  <SolidColorBrush x:Key="EditorBackground" Color="#EDEDED" />
  <SolidColorBrush x:Key="EditorBorderColor" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ReadonlyEditorBackgroundColor" Color="Transparent" />
  <SolidColorBrush x:Key="ReadonlyEditorBorderColor" Color="#FF333333" />
  
  <SolidColorBrush x:Key="ValidationErrorTextColor" Color="White" />
  <SolidColorBrush x:Key="ValidationErrorBorderBackgroundColor" Color="Red" />
  <SolidColorBrush x:Key="ValidationErrorBorderColor" Color="DarkRed" />

  <SolidColorBrush x:Key="GroupColor" Color="#9C9C9C" />
  <SolidColorBrush x:Key="GroupTextColor" Color="Black" />
  
  <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#EDEDED" />
  <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LightGrey" Color="#CDCDCD" />
  <SolidColorBrush x:Key="MouseOverTabBrush" Color="#B6B6B6" />
  <SolidColorBrush x:Key="DeselectedTabBrush" Color="#9C9C9C" />

  <LinearGradientBrush x:Key="ButtonBackground" EndPoint="0,0" StartPoint="0,1">
    <GradientStop Color="#FF888888" Offset="0.10" />
    <GradientStop Color="#FFA6A6A6" Offset="0.80" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CalendarBackground" EndPoint="0,0" StartPoint="0,1">
    <GradientStop Color="#FFA6A6A6" Offset="0.10" />
    <GradientStop Color="#FFDDDDDD" Offset="0.80" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="HoverBrush" Color="#666666" />
  
  <LinearGradientBrush x:Key="SearchBoxBackground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#FFFFFF" Offset="1" />
    <GradientStop Color="#CDCDCD" Offset="1.2" />
    <GradientStop Color="#FFFFFF" Offset="1.4" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ButtonBorder" Color="#FF1A1A1A" />

  <!-- Validation styles -->
  <DataTemplate x:Key="ValidationErrorMessage">
    <Border Background="Transparent" Padding="2">
      <Border Background="{StaticResource ValidationErrorBorderBackgroundColor}" BorderBrush="{StaticResource ValidationErrorBorderColor}" BorderThickness="2" CornerRadius="3" Padding="4">
        <TextBlock Background="{StaticResource ValidationErrorBorderBackgroundColor}" Text="{Binding ErrorContent}" Foreground="{StaticResource ValidationErrorTextColor}" />
      </Border>
    </Border>
  </DataTemplate>

  <Style x:Key="BaseErrorPopupTriggerStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <Style x:Key="ErrorPopupTriggerBorder" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource ValidationErrorBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource ValidationErrorBorderBackgroundColor}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style x:Key="ErrorPopupTriggerContent" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource ValidationErrorTextColor}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Text" Value="!" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Height" Value="25" />
  </Style>
  
  <!--
  ==================================================================================================================================================================
                                                                                    Styles:
  ==================================================================================================================================================================
  -->

  <Style x:Key="EmptyStyle" />
  
  <Style x:Key="ToolbarBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource GridBackground}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="EditorBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
    <Setter Property="Height" Value="21" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  
  <Style x:Key="CancelSearchButtonStyle" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Name="Border" Background="Transparent" Visibility="{Binding IsEnabled, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
            <Path Stretch="Fill" Stroke="#888888" Data="M 0 0 L 1 1 M 1 0 L 0 1" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                  Width="8" Height="8" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Center" Name="Path" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#A6A6A6" />
              <Setter TargetName="Path" Property="Stroke" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#666666" />
              <Setter TargetName="Path" Property="Stroke" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="AllSingingAllDancingSearchBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextColor}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Name="Border" Background="{StaticResource SearchBoxBackground}" Grid.ColumnSpan="2" />
            <ScrollViewer x:Name="PART_ContentHost" />
            <Button Grid.Column="1" Style="{StaticResource CancelSearchButtonStyle}" Command="{x:Static pg:ViewCommandsToolBar.ClearFilter}" IsTabStop="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2">
                    <DoubleAnimation From="-0.4" To="1" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[1].Offset" />
                    <DoubleAnimation From="-0.2" To="1.2" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[2].Offset" />
                    <DoubleAnimation From="0" To="1.4" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[3].Offset" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <pg:ScalingConverter x:Key="IntegerHeightForGridRow" ScaleFactor="1.3" ForceToInteger="True" />

  <Style x:Key="AllSingingAllDancingTreeViewItem" TargetType="{x:Type pg:TreeListViewItem}">
    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:TreeListViewItem}">
          <StackPanel HorizontalAlignment="Stretch" Name="ContainerPanel">
            <Border Name="Bd">
              <!--ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" /-->
              <GridViewRowPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" 
                                    MinHeight="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IntegerHeightForGridRow}}"
                                    Columns="{Binding Path=Columns,RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListView}}}" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed">
              <ItemsPresenter.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" x:Name="ItemsHostScaleTransform" />
              </ItemsPresenter.LayoutTransform>
            </ItemsPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <EventTrigger RoutedEvent="pg:TreeListViewItem.Expanding">
              <BeginStoryboard>
                <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="4" AccelerationRatio="0.2" DecelerationRatio="0.4">
                  <DoubleAnimation From="0" To="1" Storyboard.TargetName="ItemsHostScaleTransform" Storyboard.TargetProperty="ScaleY" />
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="pg:TreeListViewItem.Collapsing">
              <BeginStoryboard>
                <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                  <DoubleAnimation From="1" To="0" Storyboard.TargetName="ItemsHostScaleTransform" Storyboard.TargetProperty="ScaleY" />
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <ControlTemplate x:Key="ToolTipTemplate" TargetType="ToolTip">
    <Border Name="Border" Background="{StaticResource GlyphForegroundColor}" BorderBrush="{StaticResource GridBackground}" BorderThickness="1"
            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="4">
      <ContentPresenter Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Border>
  </ControlTemplate>

  <!-- The Add Button for CollectionDisplayer -->
  <Style x:Key="AddButton" TargetType="{x:Type Button}">
    <Setter Property="Padding" Value="-1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="ToolTip" Value="Click to add a new item" />
    <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Visibility" Value="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="#9C9C9C" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource GlyphForegroundColor}">
            <Path StrokeThickness="2" Stroke="{StaticResource GlyphForegroundColor}" SnapsToDevicePixels="True" Name="Cross" Data="M 6 2 L 6 10 M 2 6 L 10 6" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cross" Property="Stroke" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource GridBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- The Remove Button for CollectionElementEditor -->
  <Style x:Key="RemoveButton" TargetType="{x:Type Button}">
    <Setter Property="ToolTip" Value="Click to remove this item" />
    <Setter Property="Visibility" Value="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="#9C9C9C" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource GlyphForegroundColor}">
            <Path Fill="{StaticResource GlyphForegroundColor}" SnapsToDevicePixels="True" StrokeThickness="2" Stroke="{StaticResource GlyphForegroundColor}"
              Name="Cross" Data="M 3 3 L 9 9 M 3 9 L 9 3" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cross" Property="Stroke" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource GridBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SimpleTreeViewItem" TargetType="{x:Type TreeViewItem}">
    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <StackPanel HorizontalAlignment="Stretch">
            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
            <ItemsPresenter x:Name="ItemsHost" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ExpansionStyle" TargetType="ToggleButton">
    <Setter Property="ToggleButton.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="Transparent" Name="Border">
            <Polygon x:Name="ExpansionGlyph" Fill="{StaticResource ExpansionGlyphForegroundColor}" Points="4,5 4,15 10,10" RenderTransformOrigin="0.5,0.5">
			  <Polygon.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="0" />
              </Polygon.RenderTransform>
		    </Polygon>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ExpansionGlyph" Property="Fill" Value="White" />
            </Trigger>
			<EventTrigger RoutedEvent="ToggleButton.Checked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="0.0" To="90.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="90.0" To="0.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DropDownStyle" TargetType="ToggleButton">
    <Setter Property="ToggleButton.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Margin="1" CornerRadius="2" Background="#9C9C9C" Name="Border">
            <Polygon Fill="{StaticResource GlyphForegroundColor}" Points="2,7 10,7 6,11" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
	      </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <HierarchicalDataTemplate x:Key="FancyNodeTemplate" ItemsSource="{Binding Children}">
    <Grid Margin="{Binding Level,Converter={StaticResource LevelToIndentConverter},RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="25" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="15" Name="SubitemExpanderColumn" />
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="15" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Visibility="{Binding Path=(pg:TreeListView.ShowSubitemExpanders), Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}">
        <ToggleButton x:Name="ExpansionToggle" Focusable="False" Margin="0,3,0,0" Style="{StaticResource ExpansionStyle}"
                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                      Visibility="{Binding HasItems, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource BooleanToVisibility}}">
        </ToggleButton>
      </Border>
      <Border HorizontalAlignment="Stretch" Grid.Column="1">
        <TextBlock Text="{Binding Node.HumanName}" 
                   Foreground="{StaticResource TextColor}" 
                   HorizontalAlignment="Left"  
                   VerticalAlignment="Top"  
                   Padding="3,5,0,0" 
                   ToolTipService.IsEnabled="{Binding Path=(ToolTipService.IsEnabled), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                   Tag="{Binding PropertyNameToolTipTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                   >
          <ToolTipService.ToolTip>
            <ToolTip Content="{Binding}" 
                     ContentTemplate="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     />
          </ToolTipService.ToolTip>
        </TextBlock>
      </Border>
    </Grid>
    <HierarchicalDataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=(pg:TreeListView.ShowSubitemExpanders), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" Value="False">
        <Setter TargetName="SubitemExpanderColumn" Property="Width" Value="0" />
      </DataTrigger>
    </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>

  <Style x:Key="ErrorPopupTriggerStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseErrorPopupTriggerStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Style="{StaticResource ErrorPopupTriggerBorder}">
            <TextBlock Style="{StaticResource ErrorPopupTriggerContent}" />
            </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="GroupExpanderButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="Transparent">
            <Path Name="Arrow" Data="M 7 3 L 11 7 L 7 11" StrokeThickness="3" Stroke="{StaticResource ExpansionGlyphForegroundColor}" RenderTransformOrigin="0.5,0.5">
			  <Path.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="90" />
              </Path.RenderTransform>
		    </Path>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Stroke" Value="White" />
            </Trigger>
			<EventTrigger RoutedEvent="ToggleButton.Checked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="0.0" To="90.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="90.0" To="0.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeListViewStyleExpander" TargetType="{x:Type Expander}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <StackPanel>
            <DockPanel Height="15">
              <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                            Style="{StaticResource GroupExpanderButton}" 
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="{Binding Path=(pg:TreeListView.ShowGroupExpanders), Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                            ClickMode="Press" Margin="-2,0,-2,0" />
              <ContentPresenter Margin="3,0,0,0" ContentSource="Header" />
            </DockPanel>
            <ContentPresenter Name="ItemsHost" 
                              Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
              <ContentPresenter.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </ContentPresenter.LayoutTransform>
            </ContentPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <!-- NOTE: Do not animate ScaleY all the way to zero - this messes up the measurement system.
                   Use a very small final value for ScaleY, and animate opacity to ensure the fade out is smooth
                   (otherwise it blinks out suddenly when the visibility animation kicks in).
              
                   Doing the triggger on IsExpanded=False prevents an animation effect as the sections appear.
                   If such an effect is desired, use a trigger on IsExpanded=True and swap the enter and exit actions.
              -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="1" To="0.001" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="LayoutTransform.ScaleY" />
                    <DoubleAnimation From="1" To="0" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Opacity" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="4" AccelerationRatio="0.2" DecelerationRatio="0.4">
                    <DoubleAnimation From="0.001" To="1" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="LayoutTransform.ScaleY" />
                    <DoubleAnimation From="0" To="1" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Opacity" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="ExpandCollapseGroupStyle" TargetType="{x:Type GroupItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupItem}">
          <Border Background="{StaticResource GroupColor}" BorderThickness="0" CornerRadius="3" Padding="3" Margin="0,3,2,0">
            <Expander Style="{StaticResource TreeListViewStyleExpander}" IsExpanded="True">
              <Expander.Header>
                <Border Background="{StaticResource GroupColor}" BorderThickness="0" Padding="0">
                  <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource GroupTextColor}" Text="{Binding Name}" />
                </Border>
              </Expander.Header>
              <Expander.Content>
                <ItemsPresenter />
              </Expander.Content>
            </Expander>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                          Editor Control Styles:
  ==================================================================================================================================================================
  -->

  <ControlTemplate x:Key="ComboBoxItemTemplate" TargetType="{x:Type ComboBoxItem}">
    <Border Name="Border" Padding="2" CornerRadius="2" Margin="1" SnapsToDevicePixels="True" Background="{StaticResource ComboBoxItemBackground}">
      <ContentPresenter />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Background" Value="#8D8D8D" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="ReadOnlyComboEditor" TargetType="{x:Type ComboBox}">
    <Setter Property="ComboBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="ControlContainer">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" Height="20" />
            <TextBlock Background="Transparent" VerticalAlignment="Center" Foreground="{StaticResource TextColor}" Text="{Binding Path=Value}" Grid.Column="0" />
              <ToggleButton Focusable="False" Grid.Column="1" Style="{StaticResource DropDownStyle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
              <Popup
                Name="Popup" Placement="Bottom" VerticalOffset="0" 
                IsOpen="{TemplateBinding IsDropDownOpen}"
                AllowsTransparency="True" Focusable="False" 
                PopupAnimation="Fade">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder" Background="{StaticResource ComboBoxItemBackground}" CornerRadius="4,0,0,4" BorderBrush="Black" BorderThickness="1">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Grid>
              </Popup>
            </Grid>
          <ControlTemplate.Resources>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template" Value="{StaticResource ComboBoxItemTemplate}" />
            </Style>
          </ControlTemplate.Resources>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="ComboEditorTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="Transparent">
            <DockPanel VerticalAlignment="Center">
              <ScrollViewer Margin="1" x:Name="PART_ContentHost" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboEditor" TargetType="{x:Type ComboBox}">
    <Setter Property="ComboBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="ControlContainer">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" Height="20" />
            <TextBox Style="{StaticResource ComboEditorTextBoxStyle}" VerticalAlignment="Center" Foreground="{StaticResource TextColor}"
                     Grid.Column="0" BorderThickness="0" Name="PART_EditableTextBox" />
            <ToggleButton Focusable="False" Grid.Column="1" Style="{StaticResource DropDownStyle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup Name="Popup" Placement="Bottom" VerticalOffset="0" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder" Background="{StaticResource ComboBoxItemBackground}" CornerRadius="4,0,0,4" BorderBrush="Black" BorderThickness="1">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
                </Grid>
              </Popup>
            </Grid>
          <ControlTemplate.Resources>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template" Value="{StaticResource ComboBoxItemTemplate}" />
            </Style>
          </ControlTemplate.Resources>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CheckSquare" TargetType="{x:Type CheckBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CheckBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
              <Border x:Name="Border" Width="15" Height="15" CornerRadius="2" Background="{StaticResource GlyphForegroundColor}" BorderThickness="1" BorderBrush="{StaticResource GridBackground}">
                <Path Width="7" Height="7" x:Name="CheckMark" SnapsToDevicePixels="False" StrokeThickness="2" Stroke="{StaticResource GridBackground}" Data="M 0 3 L 3 7 L 7 -2" />
              </Border>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" />
          </BulletDecorator>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="CheckMark" Property="Data" Value="M 0 7 L 7 0" />
              <Setter TargetName="Border" Property="BorderBrush" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
    
  <Style x:Key="TextEditor" TargetType="{x:Type TextBox}">
    <Setter Property="Control.Foreground" Value="{StaticResource TextColor}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBoxBase}">
          <Border Style="{StaticResource EditorBorder}" Margin="0" Padding="0">
            <DockPanel VerticalAlignment="Center">
              <ToggleButton x:Name="ErrorPlaceholder" Style="{StaticResource ErrorPopupTriggerStyle}" />
              <Popup IsOpen="{Binding ElementName=ErrorPlaceholder, Path=IsChecked}" AllowsTransparency="True"
                             Placement="Bottom" PlacementTarget="{Binding ElementName=ErrorPlaceholder}" StaysOpen="False">
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type pg:TextBox}}, Path=(Validation.Errors)}"
                                      ItemTemplate="{StaticResource ValidationErrorMessage}" />
              </Popup>
              <ScrollViewer Margin="2,1,1,1" x:Name="PART_ContentHost" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="ErrorPlaceholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate>
          <DockPanel>
            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="Red"
                             ToolTip="{Binding ElementName=EditorHolder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
            <AdornedElementPlaceholder x:Name="EditorHolder" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <ControlTemplate x:Key="RadioTemplate" TargetType="{x:Type RadioButton}">
    <Border Name="Background" Background="{StaticResource ComboBoxItemBackground}" CornerRadius="4" BorderThickness="0" >
      <BulletDecorator Background="Transparent">
        <BulletDecorator.Bullet>
          <Grid Width="13" Margin="5,2,0,2" Height="13" >
            <Ellipse x:Name="Border"   Fill="{StaticResource GlyphForegroundColor}" StrokeThickness="1" Stroke="Black" />
            <Ellipse x:Name="Dot" Margin="4" Fill="{StaticResource GridBackground}" />
          </Grid>
        </BulletDecorator.Bullet>
        <ContentPresenter  Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" />
      </BulletDecorator>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="False">
        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Background" Property="Background" Value="{StaticResource HoverBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="RadioEditor" TargetType="{x:Type ComboBox}">
    <Setter Property="ComboBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="ControlContainer">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" Height="20" />
            <TextBlock Background="Transparent" VerticalAlignment="Center" Padding="5,0,0,0" Foreground="{StaticResource TextColor}" Text="{Binding Path=Value}" Grid.Column="0" />
            <ToggleButton Focusable="False" Grid.Column="1" Style="{StaticResource DropDownStyle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup Name="Popup" Placement="Bottom" VerticalOffset="0" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder" Background="{StaticResource ComboBoxItemBackground}" CornerRadius="4,0,0,4" BorderBrush="Black" BorderThickness="1" Padding="0,2,0,2">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Resources>
            <Style TargetType="{x:Type RadioButton}">
              <Setter Property="Template" Value="{StaticResource RadioTemplate}" />
            </Style>
          </ControlTemplate.Resources>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="ManyEditorContent">
    <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Background="Transparent">
      <Border Background="Transparent" Width="5" Height="0" />
      <TextBlock Text="Multiple (" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PropertyTypeName}" VerticalAlignment="Center" />
      <TextBlock Text=")" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>
  
  <Style x:Key="ResetButton" TargetType="{x:Type Button}">
    <Setter Property="Command" Value="{x:Static pg:ManyEditor.ResetCommand}" />
    <Setter Property="CommandParameter" Value="{Binding}" />
    <Setter Property="ToolTip" Value="This property has different values across the selected objects. Click to set a value." />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" Background="{StaticResource HoverBrush}" Width="14" Height="23" CornerRadius="3" BorderThickness="1" BorderBrush="White">
            <Rectangle Stroke="Black" StrokeThickness="1" Fill="Azure" Width="6" Height="6" Margin="2,0,2,0">
              <Rectangle.LayoutTransform>
                <RotateTransform Angle="45" />
              </Rectangle.LayoutTransform>
            </Rectangle>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ManyEditor" TargetType="{x:Type pg:ManyEditor}">
    <Setter Property="Height" Value="23" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ManyEditor}">
          <Border Name="Bd" Margin="0" CornerRadius="4" Height="23" Padding="0">
            <Grid>
              <Grid.Resources>
                <pg:ManyToNodeConverter x:Key="DeManyfier" />
              </Grid.Resources>
              <DockPanel Name="InconsistentView">
                <Button DockPanel.Dock="Right" Padding="-1" Margin="-1" Style="{StaticResource ResetButton}"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
                <ContentControl Content="{Binding Value}" ContentTemplate="{StaticResource ManyEditorContent}" />
              </DockPanel>
              <ContentControl Name="ConsistentView" Visibility="Collapsed" Height="23" Margin="-1,0,-1,0" Content="{Binding Converter={StaticResource DeManyfier}}" 
                              Focusable="False" FocusVisualStyle="{StaticResource EmptyStyle}"
                              ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsConsistent" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlyphForegroundColor}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsConsistent" Value="True">
              <Setter TargetName="ConsistentView" Property="Visibility" Value="Visible" />
              <Setter TargetName="InconsistentView" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                          Toolbar Styles:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="ToolBarButton" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="18" Width="18" CornerRadius="3" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource GlyphForegroundColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="ToolbarStyle" TargetType="{x:Type pg:ViewCommandsToolBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ViewCommandsToolBar}">
          <Border Style="{StaticResource ToolbarBorder}">
            <DockPanel>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowCategorized}" ToolTip="Sort by Category" 
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButton}">
                <Path Data="M 0 0 L 5 0 L 5 1 L 0 1 Z M 7 0 L 12 0 L 12 1 L 7 1 Z
                                                      M 7 2 L 12 2 L 12 3 L 7 3 Z
                            M 0 4 L 5 4 L 5 5 L 0 5 Z M 7 4 L 12 4 L 12 5 L 7 5 Z
                                                      M 7 6 L 12 6 L 12 7 L 7 7 Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowAlphaSorted}" ToolTip="Sort Alphabetically"
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButton}">
                <Path Data="M 2 0 L 4 0 L 4 5 L 6 5 L 3 8 L 0 5 L 2 5 Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowUnsorted}" ToolTip="No Sorting" 
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButton}">
                <Path Data="M 0 0 L 8 0 L 8 1 L 0 1 Z
                            M 0 2 L 8 2 L 8 3 L 0 3 Z
                            M 0 4 L 8 4 L 8 5 L 0 5 Z
                            M 0 6 L 8 6 L 8 7 L 0 7 Z"
                      Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Label DockPanel.Dock="Left" Content="{DynamicResource {x:Static pg:ViewCommandsToolBar.SearchLabelContentKey}}" />
              <TextBox MinWidth="40" Name="PART_FilterText" Style="{StaticResource AllSingingAllDancingSearchBox}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
 
  <!--
  ==================================================================================================================================================================
                                                                            Slider Styles:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="SliderButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="Transparent" BorderThickness="0">
            <Path Name="Arrow" Data="M 2 3 L 7 7 L 12 3" Stroke="{StaticResource SliderThumbBrush}" StrokeThickness="3" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Stroke" Value="Black" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource SliderThumbBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider" TargetType="{x:Type Slider}">
    <Setter Property="Margin" Value="0,5,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" MinHeight="{TemplateBinding Slider.MinHeight}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Margin="7,3,7,0" CornerRadius="2" Height="5" Grid.Row="1" Background="{StaticResource LightGrey}" />
            <Track Grid.Row="1" Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderButtonStyle}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumbStyle}" Margin="0,0,0,2" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderButtonStyle}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                         DropDownDatePicker styles
  ==================================================================================================================================================================
  -->

  <SolidColorBrush x:Key="PressedDropDownButtonBorder" Color="#FB8C3C" />
  <e:DateTimeToFullDateStringConverter x:Key="LocalDateFormat" />

  <Style x:Key="DropDownDatePickerStyle" TargetType="{x:Type e:DropDownDatePicker}">
    <Style.Resources>
      <DataTemplate x:Key="HeaderTemplate">
        <TextBlock Text="{Binding Value, Converter={StaticResource LocalDateFormat}}" Padding="5,1,0,1"
                   Foreground="Black" />
        <!--e:DateTimePicker Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              BorderThickness="0"
                              Culture="{Binding Culture}"
                              Format="{Binding Format}" CustomFormat="{Binding CustomFormat}" /-->
      </DataTemplate>
      <DataTemplate x:Key="DropDownTemplate">
        <e:MonthCalendar SelectedDate="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Culture="{Binding Culture}"
                         TodayButtonTimeAction="{Binding TodayButtonTimeAction}" />
      </DataTemplate>
    </Style.Resources>
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:DropDownDatePicker}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                  CornerRadius="4">
            <e:DropDownEditBox Background="{TemplateBinding Background}" Name="DropDownEditBox"
                               Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type e:DropDownDatePicker}}}"
                               HeaderTemplate="{StaticResource HeaderTemplate}" BorderThickness="0" BorderBrush="{StaticResource EditorBorderColor}"
                               DropDownTemplate="{StaticResource DropDownTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!--
  ==================================================================================================================================================================
                                                                         NumericUpDown styles
  ==================================================================================================================================================================
  -->

  <Style x:Key="SpinDecoratorStyle" TargetType="{x:Type e:SpinDecorator}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static e:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:SpinDecorator}">
          <Border Background="{TemplateBinding Background}"
                  Name="Border" CornerRadius="2"
                  BorderBrush="{StaticResource EditorBorderColor}"
                  BorderThickness="0" Height="21"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <DockPanel>
              <Border BorderBrush="{StaticResource EditorBorderColor}" DockPanel.Dock="Right"
                      Visibility="{TemplateBinding ShowSpinUI, Converter={StaticResource BooleanToVisibility}}">
                <e:Spin Change="{TemplateBinding Change}" x:Name="PART_Spin" BorderThickness="0" Width="14" />
              </Border>
              <ContentPresenter />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpinnerStyle" TargetType="{x:Type e:NumericUpDown}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:NumericUpDown}">
          <e:SpinDecorator Change="{TemplateBinding SmallChange}"
                               Margin="{TemplateBinding Margin}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               Style="{StaticResource SpinDecoratorStyle}">
            <e:IntegerTextBox Value="{Binding Value}" 
                                  Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                  Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                  BorderThickness="0" />
          </e:SpinDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                          Master Property Grid:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="HostBackground" TargetType="{x:Type Border}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding BindingView.DefaultView.GroupDescriptions.Count, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource GroupingConverter}}" Value="True">
        <Setter Property="Background" Value="{StaticResource GridNoGroupingBackground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding BindingView.DefaultView.GroupDescriptions.Count, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource GroupingConverter}}" Value="False">
        <Setter Property="Background" Value="{StaticResource GridBackground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Type e:PropertyGrid}" TargetType="{x:Type e:PropertyGrid}">
    <Setter Property="DefaultMargin" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="PropertyNameTemplate" Value="{StaticResource FancyNodeTemplate}" />
    <Setter Property="BuiltInEditorStyles">
      <Setter.Value>
        <pe:BuiltInEditorStyleCollection>
          <pe:BuiltInEditorStyle x:Name="SimpleTextEditorStyle" EditorKey="{x:Static e:PropertyGrid.SimpleTextEditorKey}" 
                                 Style="{StaticResource TextEditor}" />

          <pe:BuiltInEditorStyle x:Name="SimpleComboEditorStyle" EditorKey="{x:Static e:PropertyGrid.ListSelectEditorKey}"
                                 Style="{StaticResource ComboEditor}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleReadOnlyComboEditorStyle" EditorKey="{x:Static e:PropertyGrid.ListSelectNoTextEntryEditorKey}"
                                 Style="{StaticResource ReadOnlyComboEditor}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleCheckBoxStyle" EditorKey="{x:Static e:PropertyGrid.CheckBoxEditorKey}"
                                 Style="{StaticResource CheckSquare}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleSliderStyle" EditorKey="{x:Static e:PropertyGrid.SliderEditorKey}"
                                 Style="{StaticResource Slider}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleRadioSelectEditorStyle" EditorKey="{x:Static e:PropertyGrid.RadioSelectEditorKey}"
                                 Style="{StaticResource RadioEditor}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleManyEditorStyle" EditorKey="{x:Static e:PropertyGrid.ManyEditorKey}"
                                 Style="{StaticResource ManyEditor}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleCalendarStyle" EditorKey="{x:Static e:PropertyGrid.DateEditorKey}"
                                 Style="{StaticResource DropDownDatePickerStyle}" />

          <pe:BuiltInEditorStyle x:Name="SimpleColorPickerStyle" EditorKey="{x:Static e:PropertyGrid.ColorEditorKey}"
                                 Style="{StaticResource {x:Type e:DropDownColorPicker}}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleNumericUpDownStyle" EditorKey="{x:Static e:PropertyGrid.NumericUpDownEditorKey}"
                                 Style="{StaticResource SpinnerStyle}" />

        </pe:BuiltInEditorStyleCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="0"  Padding="2,2,2,3" Style="{StaticResource HostBackground}">
            <Border.Resources>
              <!-- ReadOnlyDisplay DataTemplate -->
              <DataTemplate x:Key="{x:Static e:PropertyGrid.ReadOnlyDisplayKey}">
                <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True"
                        Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
                        Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
                  <TextBlock Foreground="{StaticResource ReadonlyTextColor}" Text="{Binding Value}" IsEnabled="False" Margin="0" VerticalAlignment="Center" Background="{StaticResource ReadonlyEditorBackgroundColor}" />
                </Border>
              </DataTemplate>
              <!-- CollectionDisplay DataTemplate -->
              <DataTemplate x:Key="{x:Static e:PropertyGrid.CollectionDisplayKey}">
                <Border Background="Transparent" BorderThickness="0"
                        Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
                        Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
                  <DockPanel>
                    <Border BorderThickness="0" DockPanel.Dock="Right" >
                      <Button Command="{x:Static e:PropertyGrid.CollectionAddCommand}" CommandParameter="{Binding Value}" Style="{StaticResource AddButton}" />
                    </Border>
                    <TextBlock Text="{Binding Path=Value.Count}" IsEnabled="False"  
                               DockPanel.Dock="Left" Margin="0" Padding="0" VerticalAlignment="Center"
                               Foreground="{StaticResource ReadonlyTextColor}" 
                               Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
                    <TextBlock Name="ItemText" Text=" items" IsEnabled="False"
                               Margin="0" Padding="0" VerticalAlignment="Center"
                               Foreground="{StaticResource ReadonlyTextColor}" 
                               Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Value.Count}" Value="1">
                    <Setter TargetName="ItemText" Property="Text" Value=" item" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
              <!-- CollectionElement Editor DataTemplate -->
              <DataTemplate x:Key="{x:Static e:PropertyGrid.CollectionElementEditorKey}">
                <Grid Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  
                  <ContentControl Content="{Binding}" Grid.Column="0" Margin="0,0,3,-3"
                                  ContentTemplate="{Binding DecoratedTemplate, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
                  <Button Grid.Column="1" Margin="0,1,0,-1" Style="{StaticResource RemoveButton}" Command="{x:Static e:PropertyGrid.CollectionRemoveCommand}" 
                          CommandParameter="{Binding DecoratedNode, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
                </Grid>
              </DataTemplate>
              <!-- Integrate Scrollbar template -->
              <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                  <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
              <!-- Intergrate ToolTip template -->
              <Style TargetType="ToolTip">
                <Setter Property="Template" Value="{StaticResource ToolTipTemplate}" />
              </Style>

            </Border.Resources>
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsToolBarVisible, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource BooleanToVisibility}}">
                <pg:ViewCommandsToolBar Style="{StaticResource ToolbarStyle}" Margin="0,0,3,0"
                                        Target="{Binding BindingView, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
                <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Padding="0,20,0,20" Foreground="White"
                           Visibility="{Binding BindingView.DefaultView.IsEmpty, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource BooleanToVisibility}}">
                  No properties match the search criteria.
                </TextBlock>
              </StackPanel>
              <pg:TreeListView ItemsSource="{Binding BindingView, RelativeSource={RelativeSource TemplatedParent}}" 
                               ItemContainerStyle="{StaticResource AllSingingAllDancingTreeViewItem}"
                               Background="Transparent" BorderThickness="0"
                               ItemTemplate="{StaticResource FancyNodeTemplate}" 
                               Margin="0,0,1,0" Padding="1,0,1,1" x:Name="PART_Grid">
                <pg:TreeListView.Columns>
                  <GridViewColumnCollection>
                    <GridViewColumn CellTemplate="{Binding PropertyNameTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"  Width="{Binding Path=(pg:TreeListView.ResizeColumnWidth), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
                    <GridViewColumn>
                      <GridViewColumn.CellTemplate>
                        <HierarchicalDataTemplate>
                          <Border Margin="0" Padding="0" MinHeight="25">
                            <ContentControl Content="{Binding}"
                                            ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                                            HorizontalContentAlignment="Left"  VerticalAlignment="Center" />
                          </Border>
                        </HierarchicalDataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridViewColumnCollection>
                </pg:TreeListView.Columns>
                <pg:TreeListView.GroupStyle>
                  <GroupStyle ContainerStyle="{StaticResource ExpandCollapseGroupStyle}" />
                </pg:TreeListView.GroupStyle>
              </pg:TreeListView>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>