<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid"
                    xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
                    xmlns:e="clr-namespace:Mindscape.WpfElements">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/Common.Generic.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <pe:EnumValuesConverter x:Key="EnumValuesConverter" />
  <pg:MarginInversionConverter x:Key="MarginInversionConverter" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderMargin" Usage="Margin" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderPadding" Usage="Padding" />

  <DataTemplate x:Key="{x:Static e:PropertyGrid.ReadOnlyDisplayKey}">
    <Border BorderThickness="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
            Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}"
            Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}">
      <TextBlock Text="{Binding Path=Value}" IsEnabled="False" 
                 Margin="0" Padding="0" VerticalAlignment="Center"
                 Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                 Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                 Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
    </Border>
  </DataTemplate>
  
  <e:NullableToStringConverter x:Key="NullableConverter" />
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.SimpleTextEditorKey}">
    <pg:TextBox Text="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, Converter={StaticResource NullableConverter}}"
                IsEnabled="{Binding Path=Editable}"
                Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>

  <DataTemplate x:Key="{x:Static e:PropertyGrid.NonAutoUpdatingTextEditorKey}">
    <pg:TextBox Text="{Binding Path=Value, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
                IsEnabled="{Binding Path=Editable}"
                Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.IntegerEditorKey}">
    <e:IntegerTextBox Value="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, Converter={StaticResource NullableConverter}}"
                      IsEnabled="{Binding Path=Editable}"
                      Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.DoubleEditorKey}">
    <e:NumericTextBox Value="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, Converter={StaticResource NullableConverter}}"
                      IsEnabled="{Binding Path=Editable}"
                      Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>

  <pe:ListSelectDisplayConverter x:Key="ListSelectDisplayConverter" />
  
  <DataTemplate x:Key="ListSelectItem">
    <TextBlock>
      <TextBlock.Text>
        <MultiBinding Converter="{StaticResource ListSelectDisplayConverter}">
          <Binding />
          <Binding Path="(pe:ListSelectDisplayContext.PropertyInfo)" RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.ListSelectEditorKey}">
    <ComboBox SelectedItem="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
              ItemsSource="{Binding Property, Converter={StaticResource EnumValuesConverter}}" 
              ItemTemplate="{StaticResource ListSelectItem}"
              pe:ListSelectDisplayContext.PropertyInfo="{Binding Property.Property}"
              IsEditable="True" FocusVisualStyle="{StaticResource EmptyStyle}"
              Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>

  <DataTemplate x:Key="{x:Static e:PropertyGrid.ListSelectNoTextEntryEditorKey}">
    <ComboBox SelectedItem="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
              ItemsSource="{Binding Property, Converter={StaticResource EnumValuesConverter}}" 
              ItemTemplate="{StaticResource ListSelectItem}"
              pe:ListSelectDisplayContext.PropertyInfo="{Binding Property.Property}"
              IsEditable="False" FocusVisualStyle="{StaticResource EmptyStyle}"
              IsEnabled="{Binding Path=Editable}"
              Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>

  <DataTemplate x:Key="{x:Static e:PropertyGrid.RadioSelectEditorKey}">
    <ComboBox SelectedItem="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
              ItemsSource="{Binding Path=Value, Converter={StaticResource EnumValuesConverter}}" 
              IsEditable="True" FocusVisualStyle="{StaticResource EmptyStyle}"
              Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}">
      <ComboBox.ItemContainerStyle>
        <Style TargetType="{x:Type ComboBoxItem}">
          <Setter Property="Margin" Value="1" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                <RadioButton IsHitTestVisible="True" Focusable="False" Margin="3,1,3,1"
                             IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                             Content="{TemplateBinding Content}" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ComboBox.ItemContainerStyle>
    </ComboBox>
  </DataTemplate>

  <DataTemplate x:Key="{x:Static e:PropertyGrid.CheckBoxEditorKey}">
    <Border>
      <CheckBox IsChecked="{Binding Path=Value, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}" 
                IsEnabled="{Binding Path=Editable}"
                Margin="0" Padding="0" FocusVisualStyle="{StaticResource EmptyStyle}"
                VerticalAlignment="Center"
                Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="{x:Static e:PropertyGrid.SliderEditorKey}">
    <Slider Value="{Binding Path=Value, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
            FocusVisualStyle="{StaticResource EmptyStyle}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.NumericUpDownEditorKey}">
    <e:NumericUpDown Value="{Binding Path=Value, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
                     Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.DateEditorKey}">
    <e:DropDownDatePicker Value="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
                          Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.TimeSpanEditorKey}">
    <e:TimeSpanPicker SelectedTimeSpan="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
                      Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.ColorEditorKey}">
    <e:DropDownColorPicker SelectedColor="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"
                           Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.ManyEditorKey}">
    <pg:ManyEditor ManyHolder="{Binding}"
                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
  </DataTemplate>
  
  <Style x:Key="CollectionButton" TargetType="{x:Type Button}">
    <Setter Property="Padding" Value="-1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Visibility" Value="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
  </Style>
   
  <DataTemplate x:Key="{x:Static e:PropertyGrid.CollectionDisplayKey}">
    <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="0"
            Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
            Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
      <DockPanel>
        <Border BorderThickness="0" DockPanel.Dock="Right" >
          <Button Command="{x:Static e:PropertyGrid.CollectionAddCommand}"
                  CommandParameter="{Binding Value}" Style="{StaticResource CollectionButton}">
            <Path Fill="Black" SnapsToDevicePixels="True" 
                   Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z" />
          </Button>
        </Border>
        <TextBlock Text="{Binding Path=Value.Count}" IsEnabled="False"  DockPanel.Dock="Left"
                   Margin="0" Padding="0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
        <TextBlock Text=" items" IsEnabled="False" Margin="0" Padding="0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
      </DockPanel>
    </Border>
  </DataTemplate>
  
  <DataTemplate x:Key="{x:Static e:PropertyGrid.CollectionElementEditorKey}">
    <Grid Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ContentControl Content="{Binding}" Grid.Column="0" Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource MarginInversionConverter}}"
                      ContentTemplate="{Binding DecoratedTemplate, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
      <Button Grid.Column="1"
              Style="{StaticResource CollectionButton}"
              Command="{x:Static e:PropertyGrid.CollectionRemoveCommand}" 
              CommandParameter="{Binding DecoratedNode, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}">
        <Path Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="True"
              Data="F1 M 0 0.7 L 0.7 0 L 5 4.3 L 4.3 5 Z M 4.3 0 L 5 0.7 L 0.7 5 L 0 4.3 Z" />
      </Button>
    </Grid>
  </DataTemplate>

</ResourceDictionary>