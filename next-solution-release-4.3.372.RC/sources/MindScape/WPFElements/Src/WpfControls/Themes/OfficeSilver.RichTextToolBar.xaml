  <SolidColorBrush x:Key="PopupBorder" Color="#868686" />

  <!-- ********** Button Styles ********** -->

  <Style x:Key="RichToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Background" Value="{StaticResource RichButtonBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border BorderThickness="0,0,1,0" BorderBrush="#DDDDDD">
              <Border Background="{TemplateBinding Background}" BorderThickness="1,1,0,1" BorderBrush="{StaticResource RichButtonBorder}" />
            </Border>
            <Border Name="MouseOverBorder" BorderThickness="0,0,1,0" BorderBrush="#A6B0B3" Opacity="0">
              <Border Background="{StaticResource RichMouseOverButtonBackground}" BorderThickness="1" BorderBrush="{StaticResource RichMouseOverButtonBorder}" />
            </Border>
            <Border Name="PressedBorder" BorderThickness="0,0,1,0" BorderBrush="#A9B2B5" Opacity="0">
              <Border BorderThickness="0,1,0,0" BorderBrush="#CC9666">
                <Border BorderThickness="0,1,0,0" BorderBrush="#E7A66D">
                  <Border Background="{StaticResource RichMousePressedButtonBackground}" BorderThickness="0,0,0,1" BorderBrush="#FFB31B" />
                </Border>
              </Border>
            </Border>
            <Border Name="CheckedBorder" BorderThickness="0,0,1,0" BorderBrush="#A9B2B5" Opacity="0">
              <Border BorderThickness="0,1,0,0" BorderBrush="#EBD1B4">
                <Border Background="{StaticResource RichSelectedButtonBackground}" BorderThickness="0,0,0,1" BorderBrush="#FFE47F" />
              </Border>
            </Border>
            <Border Name="MouseOverSelectedBorder" BorderThickness="0,0,1,0" BorderBrush="#A9B2B5" Opacity="0"
                    Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource bvc}}">
              <Border BorderThickness="0,1,0,0" BorderBrush="#CC985F">
                <Border BorderThickness="0,1,0,0" BorderBrush="#E8AE71">
                  <Border Background="{StaticResource RichMouseOverSelectedButtonBackground}" BorderThickness="0,0,0,1" BorderBrush="#FCCE6B" />
                </Border>
              </Border>
            </Border>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Opacity" Value="1" />
              <Setter TargetName="MouseOverSelectedBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True" >
              <Setter TargetName="PressedBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckedBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RichButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Background" Value="{StaticResource RichButtonBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border BorderThickness="0,0,1,0" BorderBrush="#DDDDDD">
              <Border Background="{TemplateBinding Background}" BorderThickness="1,1,0,1" BorderBrush="{StaticResource RichButtonBorder}" />
            </Border>
            <Border Name="MouseOverBorder" BorderThickness="0,0,1,0" BorderBrush="#A6B0B3" Opacity="0">
              <Border Background="{StaticResource RichMouseOverButtonBackground}" BorderThickness="1" BorderBrush="{StaticResource RichMouseOverButtonBorder}" />
            </Border>
            <Border Name="PressedBorder" BorderThickness="0,0,1,0" BorderBrush="#A9B2B5" Opacity="0">
              <Border BorderThickness="0,1,0,0" BorderBrush="#CC9666">
                <Border BorderThickness="0,1,0,0" BorderBrush="#E7A66D">
                  <Border Background="{StaticResource RichMousePressedButtonBackground}" BorderThickness="0,0,0,1" BorderBrush="#FFB31B" />
                </Border>
              </Border>
            </Border>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="DisabledBorder" Background="#88FDFDFD" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="DisabledBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

