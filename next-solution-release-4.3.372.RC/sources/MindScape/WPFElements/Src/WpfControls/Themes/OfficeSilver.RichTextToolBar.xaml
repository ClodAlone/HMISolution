  <LinearGradientBrush x:Key="RichMouseOverComboBoxBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFCE2" />
    <GradientStop Offset="0.5" Color="#FFE896" />
    <GradientStop Offset="0.5" Color="#FFD975" />
    <GradientStop Offset="1" Color="#FFE7A5" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichIsCheckedDropDownBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#EAE0BF" />
    <GradientStop Offset="0.5" Color="#EFBD77" />
    <GradientStop Offset="0.5" Color="#FFA838" />
    <GradientStop Offset="1" Color="#FFD456" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichIsCheckedDropDownBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#9A8F63" />
    <GradientStop Offset="1" Color="#B1A572" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichIsCheckedDropDownInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E5DCC6" />
    <GradientStop Offset="0.5" Color="#F5D4A6" />
    <GradientStop Offset="0.5" Color="#FFC67D" />
    <GradientStop Offset="1" Color="#FFE694" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseNearDropDownBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#ECF0F5" />
    <GradientStop Offset="0.5" Color="#DFE4EB" />
    <GradientStop Offset="0.5" Color="#DAE0E7" />
    <GradientStop Offset="1" Color="#EFF2F6" />
  </LinearGradientBrush>

  <!-- ComboBoxItem -->

  <LinearGradientBrush x:Key="RichMouseOverComboBoxItemInnerBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFFB" />
    <GradientStop Offset="0.5" Color="#FFF9E3" />
    <GradientStop Offset="0.5" Color="#FFF2C8" />
    <GradientStop Offset="1" Color="#FFF8B5" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseOverComboBoxItemBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFDEA" />
    <GradientStop Offset="0.5" Color="#FFEBA9" />
    <GradientStop Offset="0.5" Color="#FFD562" />
    <GradientStop Offset="1" Color="#FFE491" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseOverComboBoxItemBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DBCE99" />
    <GradientStop Offset="0.5" Color="#C0A776" />
    <GradientStop Offset="1" Color="#D7D0B3" />
  </LinearGradientBrush>

  <Style x:Key="RichComboBoxItemStyle" TargetType="ComboBoxItem">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Margin="2,0,1,0">
            <Border Name="Border" BorderThickness="1" BorderBrush="#01000000">
              <Border Name="InnerBorder" Background="#01000000" BorderThickness="1" BorderBrush="#01000000" />
            </Border>
            <ContentPresenter Margin="3,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource RichMouseOverComboBoxItemBorder}" />
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource RichMouseOverComboBoxItemBackground}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource RichMouseOverComboBoxItemInnerBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="FontFamilyItemTemplate">
    <TextBlock FontFamily="{Binding}" Text="{Binding}" FontSize="14" Height="22" VerticalAlignment="Center" />
  </DataTemplate>
  
  <DataTemplate x:Key="PlainFontFamilyItemTemplate">
    <TextBlock Text="{Binding}" FontSize="14" Height="22" VerticalAlignment="Center" />
  </DataTemplate>

  <DataTemplate x:Key="FontSizeItemTemplate">
    <TextBlock Text="{Binding}" />
  </DataTemplate>

  <!-- ComboBox -->

  <Style x:Key="RichComboBoxToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#FF333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2,2,3,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Grid Width="14" HorizontalAlignment="Right">
              <Border Background="#E8EAEC" BorderThickness="0,1,1,1" BorderBrush="#A9B1B8" />
              <Border Name="MouseNearBorder" BorderThickness="1" BorderBrush="#A4A4A4" Background="{StaticResource RichMouseNearDropDownBackground}"
                      Visibility="{Binding IsMouseOver, Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
              <Border Name="MouseOverBorder" BorderThickness="1" BorderBrush="#A4A4A4" Opacity="0">
                <Border Background="{StaticResource RichMouseOverComboBoxBackground}" BorderThickness="1" BorderBrush="{StaticResource RichMouseOverComboBoxInnerBorder}" />
              </Border>
              <Border Name="PressedBorder" Opacity="0">
                <Border BorderThickness="0,1,0,0" BorderBrush="#CC9666">
                  <Border BorderThickness="0,1,0,0" BorderBrush="#E7A66D">
                    <Border BorderThickness="1,0,0,0" BorderBrush="#CDB072">
                      <Border Background="{StaticResource RichMousePressedButtonBackground}" BorderThickness="0,0,0,1" BorderBrush="#FFB31B" />
                    </Border>
                  </Border>
                </Border>
              </Border>
              <Border Name="CheckedBorder" BorderThickness="1" BorderBrush="{StaticResource RichIsCheckedDropDownBorder}" Opacity="0">
                <Border Background="{StaticResource RichIsCheckedDropDownBackground}" BorderThickness="1" BorderBrush="{StaticResource RichIsCheckedDropDownInnerBorder}" />
              </Border>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"
                                x:Name="contentPresenter" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MouseOverBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedBorder" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckedBorder" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <local:ArithmeticConverter x:Key="Plus4" Additive="4" />

  <LinearGradientBrush x:Key="RichComboBoxBorder" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#A9B1B8" />
    <GradientStop Offset="1" Color="#A9B1B8" />
  </LinearGradientBrush>

  <ControlTemplate x:Key="ComboBoxTextBox" TargetType="TextBox">
    <Border x:Name="PART_ContentHost" Focusable="False" Background="{TemplateBinding Background}" />
  </ControlTemplate>

  <Style x:Key="FontFamilyComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Padding" Value="6,2,25,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RichComboBoxItemStyle}" />
    <Setter Property="ItemTemplate" Value="{StaticResource FontFamilyItemTemplate}" />
    <Setter Property="MaxDropDownHeight" Value="500" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="ControlContainer">
            <Border x:Name="ContentPresenterBorder">
              <Grid>
                <Border Name="Border" Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" Background="#E8EAEC"
                        Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1"
                        BorderBrush="{StaticResource RichComboBoxBorder}" />
                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" Padding="3,0,0,0" VerticalAlignment="Center" />
                <!--TextBox Template="{StaticResource ComboBoxTextBox}" VerticalAlignment="Center" Padding="5,0,0,0"
                         BorderThickness="0" x:Name="PART_EditableTextBox" Text="{TemplateBinding SelectedValue}" IsReadOnly="{TemplateBinding IsReadOnly}"
                         Focusable="True" Margin="3,0,0,0" Background="Transparent" /-->
                <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" HorizontalContentAlignment="Center"
                              HorizontalAlignment="Stretch" Margin="0" x:Name="DropDownToggle" Style="{StaticResource RichComboBoxToggleButtonStyle}"
                              Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}"
                              VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Grid>
                    <Path Height="4" Width="6" HorizontalAlignment="Right" Stretch="Uniform" Fill="#FFF8CB" Data="M 0 0 L 4 0 L 4 1 L 2 3 L 0 2 Z"
                          Margin="0,1,0,0" />
                    <Path Height="4" Width="6" HorizontalAlignment="Right" Stretch="Uniform" Fill="#7C7C7C" Data="M 0 0 L 4 0 L 2 2 Z" />
                  </Grid>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="0" AllowsTransparency="True"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Grid Name="PopupBorder" Width="260">
                  <Border Height="Auto" HorizontalAlignment="Stretch" BorderBrush="{StaticResource PopupBorder}" Background="White"
                          BorderThickness="1" CornerRadius="2" Padding="1" Name="DropDownBorder">
                    <ScrollViewer Padding="0" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                      <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                          <Setter Property="SnapsToDevicePixels" Value="True" />
                          <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                          <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                              <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </ScrollViewer.Resources>
                    </ScrollViewer>
                  </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#FFFFFF" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#A4A4A4" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="Margin" Value="0,0,-4,-4" />
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FontSizeComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Padding" Value="6,2,25,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RichComboBoxItemStyle}" />
    <Setter Property="ItemTemplate" Value="{StaticResource FontSizeItemTemplate}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="ControlContainer">
            <Border x:Name="ContentPresenterBorder">
              <Grid>
                <Border Name="Border" Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" Background="#E8EAEC"
                        Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1"
                        BorderBrush="{StaticResource RichComboBoxBorder}" />
                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" Padding="3,0,0,0" VerticalAlignment="Center" />
                <!--TextBox Template="{StaticResource ComboBoxTextBox}" VerticalAlignment="Center" Padding="5,0,0,0"
                         BorderThickness="0" x:Name="PART_EditableTextBox" Text="{TemplateBinding SelectedValue}" IsReadOnly="{TemplateBinding IsReadOnly}"
                         Focusable="True" Margin="3,0,0,0" Background="Transparent" /-->
                <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" HorizontalContentAlignment="Center"
                              HorizontalAlignment="Stretch" Margin="0" x:Name="DropDownToggle" Style="{StaticResource RichComboBoxToggleButtonStyle}"
                              Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}"
                              VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Grid>
                    <Path Height="4" Width="6" HorizontalAlignment="Right" Stretch="Uniform" Fill="#FFF8CB" Data="M 0 0 L 4 0 L 4 1 L 2 3 L 0 2 Z"
                          Margin="0,1,0,0" />
                    <Path Height="4" Width="6" HorizontalAlignment="Right" Stretch="Uniform" Fill="#7C7C7C" Data="M 0 0 L 4 0 L 2 2 Z" />
                  </Grid>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="0" AllowsTransparency="True">
              <Grid Name="DropDown" Width="{Binding Width, Converter={StaticResource Plus4}, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Height="Auto" HorizontalAlignment="Stretch" BorderBrush="{StaticResource PopupBorder}" Background="White"
                          BorderThickness="1" CornerRadius="2" Padding="1" Name="DropDownBorder">
                    <ScrollViewer Padding="0" BorderThickness="0" Margin="0,2,0,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                      <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                          <Setter Property="SnapsToDevicePixels" Value="True" />
                          <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                          <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                              <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </ScrollViewer.Resources>
                    </ScrollViewer>
                  </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#FFFFFF" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#A4A4A4" />
            </Trigger>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="Margin" Value="0,0,-4,-4" />
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ********** RichTextToolBar Style ********** -->

  <LinearGradientBrush x:Key="RichButtonGroupBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C4C6C6" />
    <GradientStop Offset="0.5" Color="#858586" />
    <GradientStop Offset="1" Color="#C4C6C6" />
  </LinearGradientBrush>

  <Style x:Key="{x:Type local:RichTextToolBar}" TargetType="{x:Type local:RichTextToolBar}">
    <Setter Property="Background" Value="#EBF0EF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RichTextToolBar}">
          <Grid Background="{TemplateBinding Background}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid>
                  <Border BorderThickness="5" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Command="{x:Static local:RichTextCommands.ToggleFontWeight}" CommandParameter="{StaticResource Bold}"
                                    Style="{StaticResource RichToggleButtonStyle}" ToolTip="Bold (Ctrl + B)"
                                    ContentTemplate="{StaticResource BoldButtonTemplate}"
                                    IsChecked="{Binding CurrentFontWeight, Converter={StaticResource FontWeightToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ToggleButton Command="{x:Static local:RichTextCommands.ToggleFontStyle}" CommandParameter="{StaticResource Italic}"
                                    Style="{StaticResource RichToggleButtonStyle}" ToolTip="Italic (Ctrl + I)"
                                    ContentTemplate="{StaticResource ItalicButtonTemplate}"
                                    IsChecked="{Binding CurrentFontStyle, Converter={StaticResource FontStyleToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ToggleButton Command="{x:Static local:RichTextCommands.ToggleTextDecorations}" CommandParameter="{StaticResource Underline}"
                                    Style="{StaticResource RichToggleButtonStyle}" ToolTip="Underline (Ctrl + U)"
                                    ContentTemplate="{StaticResource UnderlineButtonTemplate}"
                                    IsChecked="{Binding CurrentTextDecorations, Converter={StaticResource UnderlineToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                  </Border>
                  <Border BorderThickness="5" BorderBrush="{TemplateBinding Background}" IsHitTestVisible="False" CornerRadius="8" />
                  <Border BorderThickness="1" BorderBrush="{StaticResource RichButtonGroupBorder}" IsHitTestVisible="False" CornerRadius="4" Margin="5" />
                </Grid>

                <Grid>
                  <Border BorderThickness="5" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                      <local:DropDownColorPicker Style="{StaticResource BackgroundColorPickerStyle}"
                                              Palette="{Binding BackgroundPalette, RelativeSource={RelativeSource TemplatedParent}}"
                                              SelectedColor="{Binding CurrentBackground, Converter={StaticResource BrushToColor}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                      <local:DropDownColorPicker Style="{StaticResource ForegroundColorPickerStyle}"
                                              Palette="{Binding ForegroundPalette, RelativeSource={RelativeSource TemplatedParent}}"
                                              SelectedColor="{Binding CurrentForeground, Converter={StaticResource BrushToColor}, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                  </Border>
                  <Border BorderThickness="5" BorderBrush="{TemplateBinding Background}" IsHitTestVisible="False" CornerRadius="8" />
                  <Border BorderThickness="1" BorderBrush="{StaticResource RichButtonGroupBorder}" IsHitTestVisible="False" CornerRadius="4" Margin="5" />
                </Grid>

                <Grid>
                  <Border BorderThickness="5" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Left}"
                                  ToolTip="Align Text Left (Ctrl + L)"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource LeftAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource LeftAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Center}"
                                  ToolTip="Center (Ctrl + E)"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource CenterAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource CenterAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Right}"
                                  ToolTip="Align Text Right (Ctrl + R)"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource RightAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource RightAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ToggleButton Command="{x:Static local:RichTextCommands.ChangeTextAlignment}" CommandParameter="{StaticResource Justify}"
                                  ToolTip="Justify (Ctrl + J)"
                                  Style="{StaticResource RichToggleButtonStyle}" ContentTemplate="{StaticResource JustifyAlignmentButtonTemplate}"
                                  IsChecked="{Binding CurrentTextAlignment, Converter={StaticResource JustifyAlignToBoolConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                  </Border>
                  <Border BorderThickness="5" BorderBrush="{TemplateBinding Background}" IsHitTestVisible="False" CornerRadius="8" />
                  <Border BorderThickness="1" BorderBrush="{StaticResource RichButtonGroupBorder}" IsHitTestVisible="False" CornerRadius="4" Margin="5" />
                </Grid>

                <ComboBox Width="140" SelectedValue="{Binding CurrentFontFamily, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ItemsSource="{Binding FontFamilies, RelativeSource={RelativeSource TemplatedParent}}" Name="FontSelector"
                          Style="{StaticResource FontFamilyComboBoxStyle}" Height="26" Margin="5,0,0,0" />
                <ComboBox Width="50" SelectedValue="{Binding CurrentFontSize, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ItemsSource="{Binding FontSizes, RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource FontSizeComboBoxStyle}" Height="26" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Grid>
                  <Border BorderThickness="5" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{x:Static ApplicationCommands.Cut}" ToolTip="Cut (Ctrl + X)"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource CutButtonTemplate}" />
                      <Button Command="{x:Static ApplicationCommands.Copy}" ToolTip="Copy (Ctrl + C)"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource CopyButtonTemplate}" />
                      <Button Command="{x:Static ApplicationCommands.Paste}" ToolTip="Paste (Ctrl + V)"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource PasteButtonTemplate}" />
                    </StackPanel>
                  </Border>
                  <Border BorderThickness="5" BorderBrush="{TemplateBinding Background}" IsHitTestVisible="False" CornerRadius="8" />
                  <Border BorderThickness="1" BorderBrush="{StaticResource RichButtonGroupBorder}" IsHitTestVisible="False" CornerRadius="4" Margin="5" />
                </Grid>

                <Grid>
                  <Border BorderThickness="5" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{x:Static ApplicationCommands.Undo}" ToolTip="Undo (Ctrl + Z)"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource UndoButtonTemplate}" />
                      <Button Command="{x:Static ApplicationCommands.Redo}" ToolTip="Redo (Ctrl + Y)"
                            Style="{StaticResource RichButtonStyle}" ContentTemplate="{StaticResource RedoButtonTemplate}" />
                    </StackPanel>
                  </Border>
                  <Border BorderThickness="5" BorderBrush="{TemplateBinding Background}" IsHitTestVisible="False" CornerRadius="8" />
                  <Border BorderThickness="1" BorderBrush="{StaticResource RichButtonGroupBorder}" IsHitTestVisible="False" CornerRadius="4" Margin="5" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FontSelectorDisplayMode" Value="Plain">
              <Setter TargetName="FontSelector" Property="ItemTemplate" Value="{StaticResource PlainFontFamilyItemTemplate}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>