                    xmlns:local="clr-namespace:Mindscape.WpfElements"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeSilver.Common.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
  ==================================================================================================================================================================
                                                                           RichTextToolBar styles
  ==================================================================================================================================================================
  -->
  
  <local:BrushToColorConverter x:Key="BrushToColor" />

  <FontWeight x:Key="Bold">Bold</FontWeight>
  <FontStyle x:Key="Italic">Italic</FontStyle>
  <TextDecoration x:Key="Underline" Location="Underline" />

  <TextAlignment x:Key="Left">Left</TextAlignment>
  <TextAlignment x:Key="Right">Right</TextAlignment>
  <TextAlignment x:Key="Center">Center</TextAlignment>
  <TextAlignment x:Key="Justify">Justify</TextAlignment>

  <local:ObjectToBooleanConverter x:Key="FontWeightToBoolConverter" Object="{StaticResource Bold}" />
  <local:ObjectToBooleanConverter x:Key="FontStyleToBoolConverter" Object="{StaticResource Italic}" />
  <local:ListToBooleanConverter x:Key="UnderlineToBoolConverter" Object="{StaticResource Underline}" />
  <local:ObjectToBooleanConverter x:Key="LeftAlignToBoolConverter" Object="{StaticResource Left}" />
  <local:ObjectToBooleanConverter x:Key="RightAlignToBoolConverter" Object="{StaticResource Right}" />
  <local:ObjectToBooleanConverter x:Key="CenterAlignToBoolConverter" Object="{StaticResource Center}" />
  <local:ObjectToBooleanConverter x:Key="JustifyAlignToBoolConverter" Object="{StaticResource Justify}" />

  <SolidColorBrush x:Key="ToolBarFontColor" Color="#4A4A4A" />

  <LinearGradientBrush x:Key="ToolBoxButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FDFDFD" Offset="0" />
    <GradientStop Color="#E6E6E6" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ToolBoxButtonMouseOverBrush" Color="#DFF1FF" />
  <SolidColorBrush x:Key="ToolBarButtonIsSelectedBrush" Color="#C1D2EE" />

  <LinearGradientBrush x:Key="RichButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F1F3F3" />
    <GradientStop Offset="0.4" Color="#F0F2F2" />
    <GradientStop Offset="0.4" Color="#E7EAEE" />
    <GradientStop Offset="1" Color="#F6F7F8" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseOverButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FEF7D5" />
    <GradientStop Offset="0.4" Color="#FAE5A8" />
    <GradientStop Offset="0.4" Color="#FFD048" />
    <GradientStop Offset="1" Color="#FFE59F" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMousePressedButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FCB16D" />
    <GradientStop Offset="0.4" Color="#FFAA46" />
    <GradientStop Offset="0.4" Color="#FF8D05" />
    <GradientStop Offset="1" Color="#FFC450" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichSelectedButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FBDBB5" />
    <GradientStop Offset="0.3" Color="#FEC778" />
    <GradientStop Offset="0.3" Color="#FEB456" />
    <GradientStop Offset="1" Color="#FDEB9F" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseOverSelectedButtonBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F8BA79" />
    <GradientStop Offset="0.3" Color="#FFBD79" />
    <GradientStop Offset="0.3" Color="#FEA335" />
    <GradientStop Offset="1" Color="#FEE069" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichButtonBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D5E3F1" />
    <GradientStop Offset="0.4" Color="#EAF1FB" />
    <GradientStop Offset="0.4" Color="#DFE9F4" />
    <GradientStop Offset="1" Color="#E3EDFB" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseOverButtonBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFBE8" />
    <GradientStop Offset="0.4" Color="#FCEFCA" />
    <GradientStop Offset="0.4" Color="#FFE28F" />
    <GradientStop Offset="1" Color="#FFF9CC" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RichMouseOverColorPickerBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFCF0" />
    <GradientStop Offset="0.4" Color="#FFF7DF" />
    <GradientStop Offset="0.4" Color="#FFEEBE" />
    <GradientStop Offset="1" Color="#FFF6DD" />
