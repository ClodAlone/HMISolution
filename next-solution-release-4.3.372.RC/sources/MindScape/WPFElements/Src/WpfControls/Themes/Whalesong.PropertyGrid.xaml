<ResourceDictionary 
  x:Class="Mindscape.WpfElements.WpfPropertyGrid.Themes.Whalesong"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:t="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid.Themes"
  xmlns:s="clr-namespace:System;assembly=mscorlib"
  xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid"
  xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
  xmlns:e="clr-namespace:Mindscape.WpfElements">
  
  <!-- Base -->
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  <e:ColorToBrushConverter x:Key="ColorToBrush" />
  <e:ColorToNameConverter x:Key="ColorToName" />
  <e:DoubleToByteConverter x:Key="DoubleToByte" />
  <pg:GroupingViewConverter x:Key="GroupingConverter" />
  <pg:MarginInversionConverter x:Key="MarginInversionConverter" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderMargin" Usage="Margin" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderPadding" Usage="Padding" />
  
  <e:DateTimeToFullDateStringConverter x:Key="LocalDateFormat" />

  <!-- Brushes -->
  
  <SolidColorBrush x:Key="GridBackground" Color="#dfe8f0" />
  <SolidColorBrush x:Key="GridNoGroupingBackground" Color="#dfebf9" />

  <SolidColorBrush x:Key="GlyphBackgroundColor" Color="Transparent" />
  <SolidColorBrush x:Key="GlyphForegroundColor" Color="WhiteSmoke" />

  <SolidColorBrush x:Key="TextColor" Color="Black" />
  <SolidColorBrush x:Key="ReadonlyTextColor" Color="Black" />
  
  <LinearGradientBrush x:Key="EditorBackground" EndPoint="0,0" StartPoint="0,1">
    <GradientStop Color="White" Offset="0.7" />
    <GradientStop Color="#FFD3D7D8" Offset="1" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="EditorBorderColor" Color="#FF999B9A" />
  <SolidColorBrush x:Key="ReadonlyEditorBackgroundColor" Color="Transparent" />
  <SolidColorBrush x:Key="ReadonlyEditorBorderColor" Color="Transparent" />
  
  <SolidColorBrush x:Key="ValidationErrorTextColor" Color="White" />
  <SolidColorBrush x:Key="ValidationErrorBorderBackgroundColor" Color="Red" />
  <SolidColorBrush x:Key="ValidationErrorBorderColor" Color="DarkRed" />
  
  <SolidColorBrush x:Key="MouseOverColor" Color="Black" />
  <SolidColorBrush x:Key="MousePressedColor" Color="Black" />
  
  <SolidColorBrush x:Key="ToolBarIconColor" Color="Black" />
  
  <SolidColorBrush x:Key="GroupColor" Color="#FFDFEBFB" />
  <SolidColorBrush x:Key="GroupTextColor" Color="Black" />

  <LinearGradientBrush x:Key="ButtonBackground" EndPoint="0,0" StartPoint="0,1">
    <GradientStop Color="#FFDFEBFB" Offset="0.10" />
    <GradientStop Color="White" Offset="0.80" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="RepeatButtonBackground" EndPoint="0,0" StartPoint="0,1">
    <GradientStop Color="#FFDFEBFB" Offset="0.5" />
    <GradientStop Color="White" Offset="0.5" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="IndentButtonBackground" EndPoint="0,0" StartPoint="1,1">
    <GradientStop Color="#FFDFEBFF" Offset="0.8" />
    <GradientStop Color="WhiteSmoke" Offset="0.1" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="ScrollBarColor" EndPoint="0,0" StartPoint="1,0">
    <GradientStop Color="#FFDFEBFF" Offset="0.1" />
    <GradientStop Color="White" Offset="0.8" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="ScrollBarBackground" Color="#dfebf9" />
  
  <LinearGradientBrush x:Key="IndentScrollBarColor" EndPoint="0,0" StartPoint="1,0">
    <GradientStop Color="#FFDFEBFB" Offset="0.8" />
    <GradientStop Color="WhiteSmoke" Offset="0.1" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="DarkUpStroke" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="Gray" Offset="0" />
    <GradientStop Color="LightGray" Offset="1" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="DarkDownStroke" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="Gray" Offset="1" />
    <GradientStop Color="LightGray" Offset="0" />
  </LinearGradientBrush>
  
  <LinearGradientBrush x:Key="SearchBoxBackground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="White" Offset="0" />
    <GradientStop Color="White" Offset="1" />
    <GradientStop Color="#dfebf9" Offset="1.2" />
    <GradientStop Color="White" Offset="1.4" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="ButtonBorder" Color="#FF1A1A1A" />

  <!-- Validation styles -->
  <DataTemplate x:Key="ValidationErrorMessage">
    <Border Background="Transparent" Padding="2">
      <Border Background="{StaticResource ValidationErrorBorderBackgroundColor}" BorderBrush="{StaticResource ValidationErrorBorderColor}" BorderThickness="2" CornerRadius="3" Padding="4">
        <TextBlock Background="{StaticResource ValidationErrorBorderBackgroundColor}" Text="{Binding ErrorContent}" Foreground="{StaticResource ValidationErrorTextColor}" />
      </Border>
    </Border>
  </DataTemplate>

  <Style x:Key="BaseErrorPopupTriggerStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <Style x:Key="ErrorPopupTriggerBorder" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource ValidationErrorBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource ValidationErrorBorderBackgroundColor}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style x:Key="ErrorPopupTriggerContent" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource ValidationErrorTextColor}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Text" Value="!" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Height" Value="25" />
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                                    Styles:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="EmptyStyle" />
  
  <Style x:Key="ToolbarBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Etch" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="ExpanderPanel" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#dfebf9" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="Silver" />
  </Style>

  <Style x:Key="CaptionPanel" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#e8f0fb" />
    <Setter Property="BorderThickness" Value="1,0,1,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
          <GradientStop Color="#FFFFFFFF" Offset="0" />
          <GradientStop Color="Silver" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  
  <ControlTemplate x:Key="ToolTipTemplate" TargetType="ToolTip">
    <Border Name="Border" Background="AliceBlue" BorderBrush="Black" BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="4">
      <ContentPresenter Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Border>
  </ControlTemplate>
  
  <Style x:Key="AddButton" TargetType="{x:Type Button}">
    <Setter Property="Padding" Value="-1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="ToolTip" Value="Click to add a new item" />
    <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Visibility" Value="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" Background="{StaticResource ButtonBackground}" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}">
            <Path StrokeThickness="2" Stroke="Gray" SnapsToDevicePixels="True" Name="Cross" Data="M 6 2 L 6 10 M 2 6 L 10 6" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Cross" Property="Stroke" Value="Black" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RemoveButton" TargetType="{x:Type Button}">
    <Setter Property="ToolTip" Value="Click to remove this item" />
    <Setter Property="Visibility" Value="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" Background="{StaticResource ButtonBackground}" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}">
            <Path Fill="{StaticResource GlyphForegroundColor}" SnapsToDevicePixels="True" StrokeThickness="2" Stroke="Gray"
              Name="Cross" Data="M 3 3 L 9 9 M 3 9 L 9 3" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Cross" Property="Stroke" Value="Black" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EditorBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="21" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="ReadonlyEditorBorder" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource ReadonlyEditorBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{StaticResource ReadonlyEditorBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  
  <Style x:Key="AllSingingAllDancingSearchBox" TargetType="TextBox">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Border" Style="{StaticResource EditorBorder}" Background="{StaticResource SearchBoxBackground}" Margin="0" Padding="0">
            <DockPanel VerticalAlignment="Center">
              <ScrollViewer Margin="1" x:Name="PART_ContentHost" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2">
                    <DoubleAnimation From="-0.4" To="1" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[1].Offset" />
                    <DoubleAnimation From="-0.2" To="1.2" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[2].Offset" />
                    <DoubleAnimation From="0" To="1.4" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[3].Offset" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <pg:ScalingConverter x:Key="IntegerHeightForGridRow" ScaleFactor="1.3" ForceToInteger="True" />
  
  <Style x:Key="AllSingingAllDancingTreeViewItem" TargetType="{x:Type TreeViewItem}">
    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <StackPanel HorizontalAlignment="Stretch" Name="ContainerPanel">
            <Border Name="Bd">
              <GridViewRowPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" 
                                    MinHeight="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IntegerHeightForGridRow}}"
                                    Columns="{Binding Path=Columns,RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListView}}}" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed">
              <ItemsPresenter.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="0" x:Name="ItemsHostScaleTransform" />
              </ItemsPresenter.LayoutTransform>
            </ItemsPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="4" AccelerationRatio="0.2" DecelerationRatio="0.4">
                    <DoubleAnimation From="0" To="1"  Storyboard.TargetName="ItemsHostScaleTransform" Storyboard.TargetProperty="ScaleY" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="1" To="0"  Storyboard.TargetName="ItemsHostScaleTransform" Storyboard.TargetProperty="ScaleY" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DropDownStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="1" CornerRadius="2" Background="Transparent">
            <Grid>
              <!-- We create the relief arrows by superimposing a Polygon over a Path.
                   A simpler way to create a similar effect is to use BitmapEffect.  We
                   use the superimposed shapes because BitmapEffect does not work in partial
                   trust (XBAP), but it is left in for reference for custom template designers
                   for whom XBAP is not a required scenario.
              -->
              <Polygon Fill="{StaticResource GlyphForegroundColor}" Points="2,7 10,7 6,11" Name="Arrow">
                <!--Polygon.BitmapEffect>
                  <DropShadowBitmapEffect Color="Gray" Softness=".1" ShadowDepth="1" />
                </Polygon.BitmapEffect-->
              </Polygon>
              <Path Data="M 2 7 L 6 11 L 10 7" Stroke="{StaticResource DarkDownStroke}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ExpanderToggleButtonStyle">
    <Setter Property="ToggleButton.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="Transparent">
            <Grid>
              <Polygon x:Name="ExpansionGlyph" Fill="White" Points="4,5 4,15 10,10">
                <!--Polygon.BitmapEffect>
                  <DropShadowBitmapEffect Color="DarkGray" Softness=".1" ShadowDepth="1" />
                </Polygon.BitmapEffect-->
              </Polygon>
              <Path Name="Path" Data="M 4 5 L 10 10 L 4 15" Stroke="{StaticResource DarkDownStroke}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="ExpansionGlyph" Property="Points" Value="2,7 7,13 12,7" />
              <Setter TargetName="Path" Property="Data" Value="M 2 7 L 7 13 L 12 7" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ExpansionGlyph" Property="Fill" Value="LightGray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <HierarchicalDataTemplate x:Key="FancyNodeTemplate" ItemsSource="{Binding Children}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="25" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="15" Name="SubitemExpanderColumn" />
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="5" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource ExpanderPanel}" Visibility="{Binding Path=(pg:TreeListView.ShowSubitemExpanders), Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}">
        <ToggleButton x:Name="ExpansionToggle" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"  
                      Visibility="{Binding HasItems, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource BooleanToVisibility}}"
                      Style="{StaticResource ExpanderToggleButtonStyle}"
                      />
      </Border>
      <Border HorizontalAlignment="Stretch" Grid.Column="1" Style="{StaticResource CaptionPanel}">
        <TextBlock Text="{Binding Node.HumanName}" 
                   Foreground="{StaticResource TextColor}" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Center" 
                   Padding="40,0,15,0" 
                   ToolTipService.IsEnabled="{Binding Path=(ToolTipService.IsEnabled), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                   Tag="{Binding PropertyNameToolTipTemplate, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                   >
          <ToolTipService.ToolTip>
            <ToolTip Content="{Binding}" 
                     ContentTemplate="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     />
          </ToolTipService.ToolTip>
        </TextBlock>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Etch}" />
    </Grid>
    <HierarchicalDataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=(pg:TreeListView.ShowSubitemExpanders), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" Value="False">
        <Setter TargetName="SubitemExpanderColumn" Property="Width" Value="0" />
      </DataTrigger>
    </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>

  <Style x:Key="ErrorPopupTriggerStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseErrorPopupTriggerStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Style="{StaticResource ErrorPopupTriggerBorder}">
            <TextBlock Style="{StaticResource ErrorPopupTriggerContent}" />
            </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <DataTemplate x:Key="ValidationErrorMessage.Whalesong">
    <Border Background="Transparent" Padding="2">
      <Border Background="#FF375E92" BorderBrush="Black" BorderThickness="2" CornerRadius="3" Padding="4">
        <TextBlock Foreground="White" Text="{Binding ErrorContent}" />
        </Border>
    </Border>
  </DataTemplate>
  
  <Style x:Key="GroupExpanderButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="Transparent">
            <Path Name="Arrow" Data="M 7 3 L 11 7 L 7 11" StrokeThickness="2" Stroke="{StaticResource DarkDownStroke}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Arrow" Property="Data" Value="M 3 5 L 7 9 L 11 5" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource DarkUpStroke}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeListViewStyleExpander" TargetType="{x:Type Expander}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <StackPanel>
            <DockPanel>
              <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                            Style="{StaticResource GroupExpanderButton}" 
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="{Binding Path=(pg:TreeListView.ShowGroupExpanders), Converter={StaticResource BooleanToVisibility}, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                            ClickMode="Press" Margin="-2,0,-2,0" />
              <ContentPresenter ContentSource="Header" />
            </DockPanel>
            <ContentPresenter Name="ItemsHost" 
                              Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
              <ContentPresenter.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </ContentPresenter.LayoutTransform>
            </ContentPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <!-- NOTE: Do not animate ScaleY all the way to zero - this messes up the measurement system.
                   Use a very small final value for ScaleY, and animate opacity to ensure the fade out is smooth
                   (otherwise it blinks out suddenly when the visibility animation kicks in).
              
                   Doing the triggger on IsExpanded=False prevents an animation effect as the sections appear.
                   If such an effect is desired, use a trigger on IsExpanded=True and swap the enter and exit actions.
              -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="1" To="0.001" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="LayoutTransform.ScaleY" />
                    <DoubleAnimation From="1" To="0" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Opacity" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="4" AccelerationRatio="0.2" DecelerationRatio="0.4">
                    <DoubleAnimation From="0.001" To="1" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="LayoutTransform.ScaleY" />
                    <DoubleAnimation From="0" To="1" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Opacity" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="GroupStyle"  TargetType="{x:Type GroupItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{StaticResource GroupColor}" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}" CornerRadius="3" Padding="3,3,3,0" Margin="0,3,2,0">
            <Expander Style="{StaticResource TreeListViewStyleExpander}" IsExpanded="True">
              <Expander.Header>
                <Border Background="{StaticResource GroupColor}" BorderThickness="0" Padding="0">
                  <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource GroupTextColor}" Text="{Binding Name}" />
                </Border>
              </Expander.Header>
              <Expander.Content>
                <ItemsPresenter />
              </Expander.Content>
            </Expander>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="SimpleTreeViewItem" TargetType="{x:Type TreeViewItem}">
    <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <StackPanel HorizontalAlignment="Stretch">
            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
            <ItemsPresenter x:Name="ItemsHost" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!--
  ==================================================================================================================================================================
                                                                                Scrollbar Styles:
  ==================================================================================================================================================================
  -->

  <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{StaticResource GlyphBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="{StaticResource GlyphBackgroundColor}" BorderThickness="1,0,1,0" BorderBrush="{StaticResource EditorBorderColor}">
            <Border Width="16" Background="{StaticResource ScrollBarColor}" CornerRadius="3" Name="Thumb" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Thumb" Property="Background" Value="{StaticResource IndentScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Name="Border" Background="{StaticResource ScrollBarBackground}" BorderThickness="1,0,1,0" BorderBrush="{StaticResource EditorBorderColor}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="AliceBlue" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBarUpButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Margin="0">
            <Border BorderThickness="1,0,1,0" BorderBrush="{StaticResource EditorBorderColor}" CornerRadius="4,4,0,0">
              <Border Name="Border" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}" CornerRadius="3" Width="16" Height="16" Background="{StaticResource RepeatButtonBackground}" />
            </Border>
            <Grid>
              <Polygon Fill="White" Points="4,11 14,11 9,4" Name="Arrow">
                <!--Polygon.BitmapEffect>
                  <DropShadowBitmapEffect Color="DarkGray" Softness=".1" ShadowDepth="1" />
                </Polygon.BitmapEffect-->
              </Polygon>
              <Path Data="M 4 11 L 14 11 L 9 4 Z" Stroke="{StaticResource DarkDownStroke}" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource IndentButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBarDownButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Margin="0">
            <Border BorderThickness="1,0,1,0" BorderBrush="{StaticResource EditorBorderColor}" CornerRadius="0,0,4,4">
              <Border Name="Border" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}" CornerRadius="3" Width="16" Height="16" Background="{StaticResource RepeatButtonBackground}" />
            </Border>
            <Grid>
              <Polygon Fill="White" Points="4,5 14,5 9,12" Name="Arrow">
                <!--Polygon.BitmapEffect>
                  <DropShadowBitmapEffect Color="DarkGray" Softness=".1" ShadowDepth="1" />
                </Polygon.BitmapEffect-->
              </Polygon>
              <Path Data="M 4 5 L 14 5 L 9 12 Z" Stroke="{StaticResource DarkUpStroke}" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource IndentButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition MaxHeight="16" />
        <RowDefinition Height="*" />
        <RowDefinition MaxHeight="16" />
      </Grid.RowDefinitions>
      <RepeatButton Grid.Row="0" Height="16" Style="{StaticResource ScrollBarUpButtonStyle}" Command="ScrollBar.LineUpCommand">
      </RepeatButton>
      <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButtonStyle}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButtonStyle}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Row="3" Height="16" Style="{StaticResource ScrollBarDownButtonStyle}" Command="ScrollBar.LineDownCommand" Content="M 0 0 L 4 4 L 8 0 Z" />
      <RepeatButton Grid.Row="3" Height="16" Style="{StaticResource ScrollBarDownButtonStyle}" Command="ScrollBar.LineDownCommand">
      </RepeatButton>
    </Grid>
  </ControlTemplate>

  <!--
  ==================================================================================================================================================================
                                                                             Editor Styles:
  ==================================================================================================================================================================
  -->
  
  <ControlTemplate x:Key="ComboBoxItemTemplate" TargetType="{x:Type ComboBoxItem}">
    <Border Name="Border" Padding="2" CornerRadius="2" Margin="3" SnapsToDevicePixels="True" BorderThickness="1" BorderBrush="Transparent">
      <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonBackground}" />
        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="ReadOnlyComboEditor" TargetType="{x:Type ComboBox}">
    <Setter Property="ComboBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="ControlContainer">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" />
            <TextBlock Background="Transparent" VerticalAlignment="Center" Padding="5,0,0,0" Foreground="{StaticResource TextColor}" Text="{Binding Path=Value}" Grid.Column="0" />
            <ToggleButton Focusable="False" Grid.Column="1" Style="{StaticResource DropDownStyle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup Name="Popup" Placement="Bottom" 
                   VerticalOffset="0" 
                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                   AllowsTransparency="True" Focusable="False" 
                   PopupAnimation="Fade" >
              <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder" Background="{StaticResource ButtonBackground}" CornerRadius="4" BorderBrush="{StaticResource EditorBorderColor}" BorderThickness="1">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Resources>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template" Value="{StaticResource ComboBoxItemTemplate}" />
            </Style>
          </ControlTemplate.Resources>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboEditor" TargetType="{x:Type ComboBox}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ComboBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="ControlContainer">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" />
            <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="5,0,0,0" Foreground="{StaticResource TextColor}"
                     Grid.Column="0" Name="PART_EditableTextBox" FontSize="{TemplateBinding FontSize}" />
            <ToggleButton Focusable="False" Grid.Column="1" Style="{StaticResource DropDownStyle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup Name="Popup" Placement="Bottom" VerticalOffset="0" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder" Background="{StaticResource ButtonBackground}" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}" />
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" />
                </ScrollViewer>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Resources>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template" Value="{StaticResource ComboBoxItemTemplate}" />
            </Style>
          </ControlTemplate.Resources>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TextEditor" TargetType="{x:Type TextBox}">
    <Setter Property="Control.Foreground" Value="{StaticResource TextColor}" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBoxBase}">
          <Border Style="{StaticResource EditorBorder}" Margin="0" Padding="0">
            <DockPanel VerticalAlignment="Center">
              <ToggleButton x:Name="ErrorPlaceholder" Style="{StaticResource ErrorPopupTriggerStyle}" />
              <Popup IsOpen="{Binding ElementName=ErrorPlaceholder, Path=IsChecked}" AllowsTransparency="True"
                             Placement="Bottom" PlacementTarget="{Binding ElementName=ErrorPlaceholder}" StaysOpen="False">
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type pg:TextBox}}, Path=(Validation.Errors)}"
                                      ItemTemplate="{StaticResource ValidationErrorMessage}" />
              </Popup>
              <ScrollViewer Margin="1" x:Name="PART_ContentHost" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="ErrorPlaceholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate>
          <DockPanel>
            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="Red" ToolTip="{Binding ElementName=EditorHolder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
            <AdornedElementPlaceholder x:Name="EditorHolder" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="CheckSquare" TargetType="{x:Type CheckBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CheckBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
              <Border x:Name="Border" Width="14" Height="14" CornerRadius="3" Background="{StaticResource RepeatButtonBackground}" BorderThickness="1" BorderBrush="Gray">
                <Path Width="7" Height="7" x:Name="CheckMark" SnapsToDevicePixels="False" StrokeThickness="2" Stroke="Black" Data="M 0 3 L 3 7 L 7 -2" />
              </Border>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" />
          </BulletDecorator>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="CheckMark" Property="Data" Value="M 0 7 L 7 0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <ControlTemplate x:Key="RadioTemplate" TargetType="{x:Type RadioButton}">
    <BulletDecorator Background="Transparent">
      <BulletDecorator.Bullet>
        <Grid Width="13" Margin="5,2,0,2" Height="13" >
          <Ellipse x:Name="Border"   Fill="{StaticResource RepeatButtonBackground}" StrokeThickness="1" Stroke="Gray" />
          <Ellipse x:Name="Dot" Margin="4" Fill="Black" />
        </Grid>
      </BulletDecorator.Bullet>
      <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" />
    </BulletDecorator>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="False">
        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Border" Property="Stroke" Value="Black" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="RadioEditor" TargetType="{x:Type ComboBox}">
    <Setter Property="ComboBox.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid x:Name="ControlContainer">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" />
            <TextBlock Background="Transparent" VerticalAlignment="Center" Padding="5,0,0,0" Foreground="{StaticResource TextColor}" Text="{Binding Path=Value}" Grid.Column="0" />
            <ToggleButton Focusable="False" Grid.Column="1" Style="{StaticResource DropDownStyle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup Name="Popup" Placement="Bottom" VerticalOffset="0" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Name="DropDownBorder" Background="{StaticResource ButtonBackground}" CornerRadius="4" BorderBrush="{StaticResource EditorBorderColor}" BorderThickness="1" Padding="0,2,0,2">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Resources>
            <Style TargetType="{x:Type RadioButton}">
              <Setter Property="Template" Value="{StaticResource RadioTemplate}" />
            </Style>
          </ControlTemplate.Resources>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="AllowsTransparency" Value="False">
              <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="ManyEditorContent">
    <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Background="Transparent">
      <Border Background="Transparent" Width="5" Height="0" />
      <TextBlock Text="Multiple (" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PropertyTypeName}" VerticalAlignment="Center" />
      <TextBlock Text=")" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <Style x:Key="ResetButton" TargetType="{x:Type Button}">
    <Setter Property="Command" Value="{x:Static pg:ManyEditor.ResetCommand}" />
    <Setter Property="CommandParameter" Value="{Binding}" />
    <Setter Property="ToolTip" Value="This property has different values across the selected objects. Click to set a value." />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" Background="{StaticResource ButtonBackground}" Width="14" Height="23" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource EditorBorderColor}">
            <Rectangle Stroke="Black" StrokeThickness="1" Fill="Azure" Width="6" Height="6" Margin="2,0,2,0">
              <Rectangle.LayoutTransform>
                <RotateTransform Angle="45" />
              </Rectangle.LayoutTransform>
            </Rectangle>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource IndentButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ManyEditor" TargetType="{x:Type pg:ManyEditor}">
    <Setter Property="Height" Value="23" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ManyEditor}">
          <Border Name="Bd" Margin="0" CornerRadius="4" Height="23" Padding="0">
            <Grid>
              <Grid.Resources>
                <pg:ManyToNodeConverter x:Key="DeManyfier" />
              </Grid.Resources>
              <DockPanel Name="InconsistentView">
                <Button DockPanel.Dock="Right" Padding="-1" Margin="-1" Style="{StaticResource ResetButton}"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibility}}" />
                <ContentControl Content="{Binding Value}" ContentTemplate="{StaticResource ManyEditorContent}" />
              </DockPanel>
              <ContentControl Name="ConsistentView" Visibility="Collapsed" Height="23" Margin="-1,0,-1,0" Content="{Binding Converter={StaticResource DeManyfier}}" 
                              Focusable="False" FocusVisualStyle="{StaticResource EmptyStyle}"
                              ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsConsistent" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlyphForegroundColor}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EditorBorderColor}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsConsistent" Value="True">
              <Setter TargetName="ConsistentView" Property="Visibility" Value="Visible" />
              <Setter TargetName="InconsistentView" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!--
  ==================================================================================================================================================================
                                                                             Toolbar Styles:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="ToolBarButton" TargetType="Button">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="18" Width="18" CornerRadius="3" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
              <Setter TargetName="Border" Property="Background" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolbarStyle" TargetType="{x:Type pg:ViewCommandsToolBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ViewCommandsToolBar}">
          <Border Style="{StaticResource ToolbarBorder}">
            <DockPanel>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowCategorized}" ToolTip="Sort by Category" 
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButton}">
                <Path Data="M 0 0 L 5 0 L 5 1 L 0 1 Z M 7 0 L 12 0 L 12 1 L 7 1 Z
                                                      M 7 2 L 12 2 L 12 3 L 7 3 Z
                            M 0 4 L 5 4 L 5 5 L 0 5 Z M 7 4 L 12 4 L 12 5 L 7 5 Z
                                                      M 7 6 L 12 6 L 12 7 L 7 7 Z"
                      Fill="{StaticResource ToolBarIconColor}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowAlphaSorted}" ToolTip="Sort Alphabetically"
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButton}">
                <Path Data="M 2 0 L 4 0 L 4 5 L 6 5 L 3 8 L 0 5 L 2 5 Z"
                      Fill="{StaticResource ToolBarIconColor}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowUnsorted}" ToolTip="No Sorting" 
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButton}">
                <Path Data="M 0 0 L 8 0 L 8 1 L 0 1 Z
                            M 0 2 L 8 2 L 8 3 L 0 3 Z
                            M 0 4 L 8 4 L 8 5 L 0 5 Z
                            M 0 6 L 8 6 L 8 7 L 0 7 Z"
                      Fill="{StaticResource ToolBarIconColor}"
                      SnapsToDevicePixels="True" />
              </Button>
              <Label DockPanel.Dock="Left" Foreground="{StaticResource TextColor}" Content="{DynamicResource {x:Static pg:ViewCommandsToolBar.SearchLabelContentKey}}" />
              <TextBox MinWidth="40" Name="PART_FilterText" Style="{StaticResource AllSingingAllDancingSearchBox}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

 
  <!--
  ==================================================================================================================================================================
                                                                             Slider Styles:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="SliderButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Thumb" Background="{StaticResource ButtonBackground}" CornerRadius="3" BorderThickness="1" BorderBrush="Silver" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Thumb" Property="Background" Value="{StaticResource IndentButtonBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider" TargetType="{x:Type Slider}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" MinHeight="{TemplateBinding Slider.MinHeight}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="2" Grid.Row="1" Background="Gray" BorderBrush="White" BorderThickness="0,0,0,1" />
            <Track Grid.Row="1" Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderButtonStyle}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderButtonStyle}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                             Calendar Styles:
  ==================================================================================================================================================================
  -->

  <e:SameMonthConverter x:Key="SameMonth" />
  
  <DataTemplate x:Key="NonDayTemplate">
    <TextBlock />
  </DataTemplate>

  <DataTemplate x:Key="DayOfWeekTemplate">
    <TextBlock Text="{Binding}" HorizontalAlignment="Center" />
  </DataTemplate>

  <DataTemplate x:Key="DayTemplate">
    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Day}" />
    <DataTemplate.Triggers>
      <DataTrigger Value="False">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource SameMonth}">
            <Binding />
            <Binding RelativeSource="{RelativeSource AncestorType={x:Type e:MonthCalendar}}" Path="VisibleMonth" />
          </MultiBinding>
        </DataTrigger.Binding>
        <DataTrigger.Setters>
          <Setter Property="TextBlock.Foreground" Value="Silver" />
        </DataTrigger.Setters>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <e:DayTemplateSelector x:Key="DayTemplateSelector" DayTemplate="{StaticResource DayTemplate}" NonDayTemplate="{StaticResource NonDayTemplate}" />

  <s:String x:Key="{x:Static e:MonthCalendar.TodayButtonContentKey}">Today</s:String>

  <Style x:Key="LeftMonthButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid>
            <Border CornerRadius="4" Background="{StaticResource ButtonBackground}" Name="Border" Width="16" Height="16" BorderThickness="1" BorderBrush="Gray">
              <Path Name="Arrow" Data="M 4 7 L 10 4 L 10 10 Z" Width="16" Height="16" Fill="{StaticResource GlyphForegroundColor}" Stroke="Gray" SnapsToDevicePixels="True">
              </Path>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="Silver" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource IndentScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RightMonthButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid>
            <Border CornerRadius="4" Background="{StaticResource ButtonBackground}" Name="Border" Width="16" Height="16" BorderThickness="1" BorderBrush="Gray">
              <Path Name="Arrow" Data="M 11 7 L 5 4 L 5 10 Z" Width="16" Height="16" Fill="{StaticResource GlyphForegroundColor}" Stroke="Gray" SnapsToDevicePixels="True">
              </Path>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="Silver" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource IndentScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TodayButton" TargetType="{x:Type Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Margin="1" CornerRadius="4" Background="{StaticResource ButtonBackground}" Name="Border" Width="39" Height="18"
                    BorderThickness="1" BorderBrush="{StaticResource ButtonBorder}" Padding="3,1,0,0">
              <TextBlock Margin="0,-1,0,0" Name="Text" Foreground="Black" Text="{DynamicResource {x:Static e:MonthCalendar.TodayButtonContentKey}}" />
            </Border>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource IndentScrollBarColor}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2,0,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border SnapsToDevicePixels="True" x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="Black" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonBackground}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="Black" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="Silver" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MonthCalendarStyle" TargetType="{x:Type e:MonthCalendar}">
    <!--Setter Property="Background" Value="{StaticResource ToolbarBackgroundColor}" />
    <Setter Property="BorderBrush" Value="{StaticResource CalendarBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="Black" /-->
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:MonthCalendar}">
          <Border Background="{StaticResource GlyphForegroundColor}" BorderBrush="Silver" BorderThickness="1" SnapsToDevicePixels="True">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <RepeatButton DockPanel.Dock="Left" Focusable="False" Style="{StaticResource LeftMonthButton}" Command="{x:Static e:CalendarCommands.MonthBack}" />
                <RepeatButton DockPanel.Dock="Right" Focusable="False" Style="{StaticResource RightMonthButton}" Command="{x:Static e:CalendarCommands.MonthForward}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding MonthText}" />
                  <TextBlock Text="{Binding SelectedDate.Year, RelativeSource={RelativeSource AncestorType={x:Type e:MonthCalendar}}}" />
                </TextBlock>
              </DockPanel>
              <ItemsControl x:Name="PART_DaysOfWeekList" HorizontalContentAlignment="Center" DockPanel.Dock="Top" ItemTemplate="{StaticResource DayOfWeekTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Command="{x:Static e:CalendarCommands.SelectToday}" Style="{StaticResource TodayButton}" Margin="3" />
              </StackPanel>
              <ListBox x:Name="PART_DaysList" ItemTemplateSelector="{StaticResource DayTemplateSelector}" Background="{StaticResource ButtonBackground}"
                       HorizontalContentAlignment="Center" BorderThickness="0,1,0,0" ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                       KeyboardNavigation.DirectionalNavigation="None" FocusVisualStyle="{StaticResource EmptyStyle}" BorderBrush="#FFDFEBFB">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="{Binding WeeksToDisplay, RelativeSource={RelativeSource AncestorType={x:Type e:MonthCalendar}}}" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static e:DropDownEditBox.ToggleButtonStyleKey}" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="1" Padding="0,0,2,0" CornerRadius="2" Background="Transparent">
            <Grid>
              <Polygon Fill="{StaticResource GlyphForegroundColor}" Points="2,7 10,7 6,11" Name="Arrow" />
              <Path Data="M 2 7 L 6 11 L 10 7" Stroke="{StaticResource DarkDownStroke}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type e:DropDownEditBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:DropDownEditBox}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Name="Bd">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ContentPresenter ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
              <ToggleButton IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Name="ToggleButton"
                            Grid.Column="1" Style="{StaticResource {x:Static e:DropDownEditBox.ToggleButtonStyleKey}}" />
              <Popup AllowsTransparency="True" Placement="Bottom" Focusable="False" Name="Popup"
                     PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" 
                     IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                        Width="{Binding ActualWidth, ElementName=Bd}">
                  <ContentPresenter ContentTemplate="{TemplateBinding DropDownTemplate}" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Popup" Property="IsOpen" Value="True">
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="DropDownDatePickerStyle" TargetType="{x:Type e:DropDownDatePicker}">
    <Style.Resources>
      <DataTemplate x:Key="HeaderTemplate">
        <TextBlock Text="{Binding Value, Converter={StaticResource LocalDateFormat}}" Padding="5,0,0,0" Foreground="{StaticResource TextColor}" />
      </DataTemplate>
      <DataTemplate x:Key="DropDownTemplate">
        <e:MonthCalendar SelectedDate="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Minimum="{Binding Minimum}"
                         Maximum="{Binding Maximum}" Foreground="Black" Style="{StaticResource MonthCalendarStyle}" />
      </DataTemplate>
    </Style.Resources>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:DropDownDatePicker}">
          <Grid x:Name="ControlContainer">
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" />
            <e:DropDownEditBox Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type e:DropDownDatePicker}}}" MaxDropDownHeight="10cm"
                               HeaderTemplate="{StaticResource HeaderTemplate}" DropDownTemplate="{StaticResource DropDownTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                          ColorPicker Styles:
  ==================================================================================================================================================================
  -->

  <e:ColorChannelConverter x:Key="AlphaChanger" Channel="Alpha" />
  <e:ColorChannelConverter x:Key="RedChanger" Channel="Red" />
  <e:ColorChannelConverter x:Key="GreenChanger" Channel="Green" />
  <e:ColorChannelConverter x:Key="BlueChanger" Channel="Blue" />

  <LinearGradientBrush x:Key="HighAlpha" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="0" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource AlphaChanger}, ConverterParameter=255}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HighRed" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="0" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource RedChanger}, ConverterParameter=255}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HighGreen" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="0" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource GreenChanger}, ConverterParameter=255}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HighBlue" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="0" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource BlueChanger}, ConverterParameter=255}" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="HighColorButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Command" Value="Slider.IncreaseLarge" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Name="Border" />
          <ControlTemplate.Triggers>
            <Trigger Property="Foreground" Value="Transparent">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource HighAlpha}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Red">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource HighRed}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Green">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource HighGreen}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Blue">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource HighBlue}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <LinearGradientBrush x:Key="LowAlpha" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="1" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource AlphaChanger}, ConverterParameter=0}" Offset="0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="LowRed" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="1" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource RedChanger}, ConverterParameter=0}" Offset="0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="LowGreen" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="1" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource GreenChanger}, ConverterParameter=0}" Offset="0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="LowBlue" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{Binding SelectedColor}" Offset="1" />
    <GradientStop Color="{Binding SelectedColor, Converter={StaticResource BlueChanger}, ConverterParameter=0}" Offset="0" />
  </LinearGradientBrush>

  <Style x:Key="LowColorButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="5" />
    <Setter Property="Command" Value="Slider.DecreaseLarge" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Name="Border" />
          <ControlTemplate.Triggers>
            <Trigger Property="Foreground" Value="Transparent">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource LowAlpha}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Red">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource LowRed}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Green">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource LowGreen}" />
            </Trigger>
            <Trigger Property="Foreground" Value="Blue">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource LowBlue}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColorSliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Border Background="#dfebf9" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
              <Border Background="AliceBlue" BorderThickness="1" BorderBrush="Black" CornerRadius="2" Width="8" Height="12">
                <Border Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}" Height="5" Width="8" />
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColorSlider" TargetType="{x:Type Slider}">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="255" />
    <Setter Property="Margin" Value="0,5,3,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" MinHeight="{TemplateBinding Slider.MinHeight}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Margin="0" Height="1" Grid.Row="1" Background="Black" />
            <Track Grid.Row="1" Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Foreground="{Binding Foreground, RelativeSource={RelativeSource Self}}" Style="{StaticResource LowColorButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ColorSliderThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Foreground="{Binding Foreground, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighColorButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="ColorSwatchItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
              BorderBrush="Black" BorderThickness="1" Margin="1,1,6,1" SnapsToDevicePixels="True"
              Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
      <TextBlock Text="{Binding Name}" Grid.Column="1" />
    </Grid>
  </DataTemplate>

  <Style x:Key="TabPane" TargetType="{x:Type TabControl}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Background" Value="{StaticResource GlyphBackgroundColor}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Border BorderThickness="1" BorderBrush="Silver">
            <Grid KeyboardNavigation.TabNavigation="Local" Background="White">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TabPanel Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1" Margin="0,0,4,-1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent" />
              <Border Name="Border" Grid.Row="1" Background="AliceBlue" BorderBrush="Silver" BorderThickness="1" CornerRadius="0,4,0,0" Margin="-1,0,-1,-1"
                      KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2">
                <ContentPresenter  Name="PART_SelectedContentHost" Margin="6" ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Tab" TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource TextColor}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid Background="{StaticResource GlyphBackgroundColor}">
            <Path Data="M 0 17 L 0 4 L 4 0 L 55 0 C 70 4 65 12 80 17 Z" Stroke="Silver" Fill="White" Name="PathFill" Margin="0,0,-20,0" />
            <Path Data="M 0 17 L 0 4 L 4 0 L 55 0 C 70 4 65 12 81 17" Stroke="Silver" Name="Path" Margin="0,0,-20,0" />
            <Border Name="Border" Margin="-1,0,-4,-2" Background="{StaticResource GlyphBackgroundColor}" CornerRadius="4">
              <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="12,2,10,2" RecognizesAccessKey="True" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Panel.ZIndex" Value="100" />
              <Setter TargetName="PathFill" Property="Fill" Value="AliceBlue" />
              <Setter Property="Foreground" Value="Black" />
              <Setter TargetName="PathFill" Property="Stroke" Value="AliceBlue" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PathFill" Property="Fill" Value="{StaticResource GridBackground}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColorPicker" TargetType="{x:Type e:ColorPicker}">
    <Style.Resources>
      <DataTemplate x:Key="HeaderTemplate">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}}"
                  BorderBrush="{StaticResource TextColor}" BorderThickness="1" Margin="5,1,6,1" SnapsToDevicePixels="True"
                  Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
          <TextBlock Grid.Column="1" Foreground="{StaticResource TextColor}" Text="{Binding SelectedColor, Converter={StaticResource ColorToName}}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DropDownTemplate">
        <TabControl Style="{StaticResource TabPane}">
          <TabItem Header="Named" Style="{StaticResource Tab}">
            <Border CornerRadius="5" Background="{StaticResource ButtonBackground}" Padding="2,0,0,0" BorderThickness="1" BorderBrush="Silver">
              <ListBox ItemsSource="{x:Static e:NamedColor.NamedColors}" BorderThickness="0" SelectedValue="{Binding SelectedColor, Mode=TwoWay}"
                     SelectedValuePath="Color" TextSearch.TextPath="Name" ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                     ItemTemplate="{StaticResource ColorSwatchItem}" Background="{StaticResource ButtonBackground}" />
            </Border>
          </TabItem>

          <TabItem Header="Custom" Style="{StaticResource Tab}">
            <Border CornerRadius="5" Background="{StaticResource ButtonBackground}" Padding="3" BorderThickness="1" BorderBrush="Silver">
              <Grid Background="{StaticResource ButtonBackground}">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextColor}">Alpha:</Label>
                <Slider Name="AChannelEditor" Foreground="Transparent" Value="{Binding NotifyingColor.A}" Grid.Row="0" Grid.Column="1" Style="{StaticResource ColorSlider}" />
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=AChannelEditor, UpdateSourceTrigger=PropertyChanged,
                Converter={StaticResource DoubleToByte}}" Style="{StaticResource TextEditor}" Width="30" />

                <Label Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextColor}">Red:</Label>
                <Slider Name="RChannelEditor" Foreground="Red" Value="{Binding NotifyingColor.R}" Grid.Row="1" Grid.Column="1" Style="{StaticResource ColorSlider}" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=RChannelEditor, UpdateSourceTrigger=PropertyChanged,
                Converter={StaticResource DoubleToByte}}" Style="{StaticResource TextEditor}" Width="30" />

                <Label Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextColor}">Green:</Label>
                <Slider Name="GChannelEditor" Foreground="Green" Value="{Binding NotifyingColor.G}" Grid.Row="2" Grid.Column="1" Style="{StaticResource ColorSlider}" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=GChannelEditor, UpdateSourceTrigger=PropertyChanged,
                Converter={StaticResource DoubleToByte}}" Style="{StaticResource TextEditor}" Width="30" />

                <Label Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextColor}">Blue:</Label>
                <Slider Name="BChannelEditor" Foreground="Blue" Value="{Binding NotifyingColor.B}" Grid.Row="3" Grid.Column="1" Style="{StaticResource ColorSlider}" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=BChannelEditor, UpdateSourceTrigger=PropertyChanged,
                Converter={StaticResource DoubleToByte}}" Style="{StaticResource TextEditor}" Width="30" />
              </Grid>
            </Border>
          </TabItem>
        </TabControl>
      </DataTemplate>
    </Style.Resources>
    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:ColorPicker}">
          <Grid>
            <Border Grid.ColumnSpan="2" Style="{StaticResource EditorBorder}" />
            <e:DropDownEditBox MaxDropDownHeight="10cm" Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type e:ColorPicker}}}"
                               HeaderTemplate="{StaticResource HeaderTemplate}" DropDownTemplate="{StaticResource DropDownTemplate}">
              <e:DropDownEditBox.Resources>
                <Style TargetType="{x:Type ToggleButton}">
                  <Setter Property="ToggleButton.Template">
                    <Setter.Value>
                      <ControlTemplate>
                        <Border Margin="1" CornerRadius="2" Width="12" Background="{StaticResource GlyphBackgroundColor}">
                          <Grid>
                            <Polygon Fill="{StaticResource GlyphForegroundColor}" Points="2,7 10,7 6,11" Name="Arrow">
                              <!--Polygon.BitmapEffect>
                                <DropShadowBitmapEffect Color="Gray" Softness=".1" ShadowDepth="1" />
                              </Polygon.BitmapEffect-->
                            </Polygon>
                            <Path Data="M 2 7 L 6 11 L 10 7" Stroke="{StaticResource DarkDownStroke}" />
                          </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="Gray" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </e:DropDownEditBox.Resources>
            </e:DropDownEditBox>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!--
  ==================================================================================================================================================================
                                                                          Spinner Styles:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="NumericUpButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Name="Border" CornerRadius="3" Height="11" Background="{StaticResource ButtonBackground}" BorderBrush="{StaticResource EditorBorderColor}" BorderThickness="1">
            <Polygon Name="Arrow" Stroke="{StaticResource EditorBorderColor}" Fill="{StaticResource GlyphForegroundColor}" Points="2,6 10,6 6,2">
            </Polygon>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NumericDownButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,-1,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Name="Border" CornerRadius="3" Height="11" Background="{StaticResource ButtonBackground}" BorderBrush="{StaticResource EditorBorderColor}" BorderThickness="1">
            <Polygon Name="Arrow" Stroke="{StaticResource EditorBorderColor}" Fill="{StaticResource GlyphForegroundColor}" Points="2,3 10,3 6,7">
            </Polygon>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Arrow" Property="Fill" Value="Gray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type e:IntegerTextBox}" TargetType="{x:Type e:IntegerTextBox}">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="ShowSeparators" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:IntegerTextBox}">
          <TextBox x:Name="PART_TextBox"
                   HorizontalScrollBarVisibility="Disabled"
                   AcceptsReturn="False"
                   AutoWordSelection="False"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   VerticalAlignment="{TemplateBinding VerticalAlignment}"
                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   Style="{StaticResource TextEditor}">
          </TextBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type e:Spin}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:Spin}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <Grid DockPanel.Dock="Right" Width="13">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <RepeatButton Command="{x:Static e:SpinCommands.Increase}" Grid.Row="0"
                            Style="{StaticResource NumericUpButton}" />
              <RepeatButton Command="{x:Static e:SpinCommands.Decrease}" Grid.Row="1"
                            Style="{StaticResource NumericDownButton}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type e:SpinDecorator}" TargetType="{x:Type e:SpinDecorator}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource {x:Static e:FilteringTextBoxBase.BorderBrushKey}}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type e:SpinDecorator}">
          <Border Background="{TemplateBinding Background}"
                  Name="Border"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <Grid>
              <ContentPresenter />
              <Border HorizontalAlignment="Right"
                      Visibility="{TemplateBinding ShowSpinUI, Converter={StaticResource BooleanToVisibility}}">
                <e:Spin Change="{TemplateBinding Change}" x:Name="PART_Spin" BorderThickness="0" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
  ==================================================================================================================================================================
                                                                             Master Property Grid:
  ==================================================================================================================================================================
  -->
  
  <Style x:Key="HostBackground" TargetType="{x:Type Border}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding BindingView.DefaultView.GroupDescriptions.Count, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource GroupingConverter}}" Value="True">
        <Setter Property="Background" Value="{StaticResource GridNoGroupingBackground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding BindingView.DefaultView.GroupDescriptions.Count, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource GroupingConverter}}" Value="False">
        <Setter Property="Background" Value="{StaticResource GridBackground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Type e:PropertyGrid}" TargetType="{x:Type e:PropertyGrid}">
    <Setter Property="DefaultMargin" Value="1" />
    <Setter Property="BuiltInEditorStyles">
      <Setter.Value>
        <pe:BuiltInEditorStyleCollection>
          <pe:BuiltInEditorStyle x:Name="SimpleTextEditorStyle" EditorKey="{x:Static e:PropertyGrid.SimpleTextEditorKey}" 
                                 Style="{StaticResource TextEditor}" />

          <pe:BuiltInEditorStyle x:Name="SimpleComboEditorStyle" EditorKey="{x:Static e:PropertyGrid.ListSelectEditorKey}"
                                 Style="{StaticResource ComboEditor}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleReadOnlyComboEditorStyle" EditorKey="{x:Static e:PropertyGrid.ListSelectNoTextEntryEditorKey}"
                                 Style="{StaticResource ReadOnlyComboEditor}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleCheckBoxStyle" EditorKey="{x:Static e:PropertyGrid.CheckBoxEditorKey}"
                                 Style="{StaticResource CheckSquare}" />

          <pe:BuiltInEditorStyle x:Name="SimpleCalendarStyle" EditorKey="{x:Static e:PropertyGrid.DateEditorKey}"
                                 Style="{StaticResource DropDownDatePickerStyle}" />

          <pe:BuiltInEditorStyle x:Name="SimpleColorPickerStyle" EditorKey="{x:Static e:PropertyGrid.ColorEditorKey}"
                                 Style="{StaticResource ColorPicker}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleSliderStyle" EditorKey="{x:Static e:PropertyGrid.SliderEditorKey}"
                                 Style="{StaticResource Slider}" />
          
          <pe:BuiltInEditorStyle x:Name="SimpleRadioSelectEditorStyle" EditorKey="{x:Static e:PropertyGrid.RadioSelectEditorKey}"
                                 Style="{StaticResource RadioEditor}" />

          <pe:BuiltInEditorStyle x:Name="SimpleManyEditorStyle" EditorKey="{x:Static e:PropertyGrid.ManyEditorKey}"
                                 Style="{StaticResource ManyEditor}" />
          
        </pe:BuiltInEditorStyleCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="3" Style="{StaticResource HostBackground}" Padding="2,2,1,2">
            <Border.Resources>
              
              <DataTemplate x:Key="{x:Static e:PropertyGrid.ReadOnlyDisplayKey}">
                <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True"
                        Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
                        Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
                  <TextBlock Foreground="{StaticResource ReadonlyTextColor}" Text="{Binding Value}" IsEnabled="False" Margin="0" VerticalAlignment="Center" Background="{StaticResource ReadonlyEditorBackgroundColor}" />
                </Border>
              </DataTemplate>

              <DataTemplate x:Key="{x:Static e:PropertyGrid.CollectionDisplayKey}">
                <Border Background="Transparent" BorderThickness="0"
                        Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
                        Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
                  <DockPanel>
                    <Border BorderThickness="0" DockPanel.Dock="Right" >
                      <Button Command="{x:Static e:PropertyGrid.CollectionAddCommand}" CommandParameter="{Binding Value}" Style="{StaticResource AddButton}" />
                    </Border>
                    <TextBlock Text="{Binding Path=Value.Count}" IsEnabled="False"  DockPanel.Dock="Left" Margin="0" Padding="0" VerticalAlignment="Center"
                               Foreground="{StaticResource ReadonlyTextColor}" Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
                    <TextBlock Name="ItemText" Text=" items" IsEnabled="False" Margin="0" Padding="0" VerticalAlignment="Center"
                               Foreground="{StaticResource ReadonlyTextColor}" Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Value.Count}" Value="1">
                    <Setter TargetName="ItemText" Property="Text" Value=" item" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>

              <DataTemplate x:Key="{x:Static e:PropertyGrid.CollectionElementEditorKey}">
                <Grid Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <ContentControl Content="{Binding}" Grid.Column="0" Margin="0,-1,3,-1"
                      ContentTemplate="{Binding DecoratedTemplate, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
                  <Button Grid.Column="1" Margin="0,0,0,1" Style="{StaticResource RemoveButton}" Command="{x:Static e:PropertyGrid.CollectionRemoveCommand}" 
                          CommandParameter="{Binding DecoratedNode, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
                </Grid>
              </DataTemplate>
              
              <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                  <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
              
              <Style TargetType="ToolTip">
                <Setter Property="Template" Value="{StaticResource ToolTipTemplate}" />
              </Style>
              
            </Border.Resources>
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsToolBarVisible, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource BooleanToVisibility}}">
                <pg:ViewCommandsToolBar Style="{StaticResource ToolbarStyle}" Margin="0,0,3,0"
                                        Target="{Binding BindingView, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
                <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Padding="0,20,0,20"
                           Visibility="{Binding BindingView.DefaultView.IsEmpty, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}, Converter={StaticResource BooleanToVisibility}}">
                  No properties match the search criteria.
                </TextBlock>
              </StackPanel>

              <pg:TreeListView ItemsSource="{Binding BindingView, RelativeSource={RelativeSource TemplatedParent}}" ItemContainerStyle="{StaticResource AllSingingAllDancingTreeViewItem}"
                               Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource FancyNodeTemplate}"
                               Padding="-2,1,3,-2" x:Name="PART_Grid" Margin="0,0,2,0">
                <pg:TreeListView.Columns>
                  <GridViewColumnCollection>
                    <GridViewColumn CellTemplate="{StaticResource FancyNodeTemplate}" Width="{Binding Path=(pg:TreeListView.ResizeColumnWidth), RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}" />
                    <GridViewColumn>
                      <GridViewColumn.CellTemplate>
                        <HierarchicalDataTemplate>
                          <Border Margin="0" Padding="0" Grid.Column="3" Height="25">
                            <ContentControl Content="{Binding}"
                        ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type e:PropertyGrid}}}"
                        HorizontalContentAlignment="Left"  VerticalAlignment="Center" />
                          </Border>
                        </HierarchicalDataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridViewColumnCollection>
                </pg:TreeListView.Columns>
                <pg:TreeListView.GroupStyle>
                  <GroupStyle ContainerStyle="{StaticResource GroupStyle}" />
                </pg:TreeListView.GroupStyle>
              </pg:TreeListView>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>