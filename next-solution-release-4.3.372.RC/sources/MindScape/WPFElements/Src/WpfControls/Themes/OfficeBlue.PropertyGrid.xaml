<ResourceDictionary 
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:pg="clr-namespace:Mindscape.WpfElements.WpfPropertyGrid"
  xmlns:pe="clr-namespace:Mindscape.WpfElements.PropertyEditing"
  xmlns:local="clr-namespace:Mindscape.WpfElements">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Mindscape.WpfElements;component/Themes/OfficeBlue.DateTimeControls.xaml" />
  </ResourceDictionary.MergedDictionaries>
  
  <!-- Converters -->
  <pg:GroupingViewConverter x:Key="GroupingConverter" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderMargin" Usage="Margin" />
  <pg:GridSpacingCompensationConverter x:Key="DefaultMarginToBorderPadding" Usage="Padding" />
  <pg:ManyToNodeConverter x:Key="DeManyfier" />
  <pg:LevelToIndentConverter x:Key="LevelToIndentConverter" />

  <!-- =========== -->
  <!--   Brushes   -->
  <!-- =========== -->

  <LinearGradientBrush x:Key="PropertyGridBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#BFDBFF" />
    <GradientStop Offset="1" Color="#6591CD" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PropertyGridNoGroupingBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C9D9ED" />
    <GradientStop Offset="1" Color="#E7F2FF" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GroupBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C9D9ED" />
    <GradientStop Offset="1" Color="#E7F2FF" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="GroupForeground" Color="#15428B" />

  <LinearGradientBrush x:Key="GroupHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#DAE6F4" />
    <GradientStop Offset="1" Color="#DAE6F4" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ExpanderBackground" Color="#15428B" />
  <SolidColorBrush x:Key="MouseOverExpanderBackground" Color="#6593CF" />

  <LinearGradientBrush x:Key="SearchBoxBackground" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="White" />
    <GradientStop Offset="1" Color="White" />
    <GradientStop Offset="1.2" Color="#BFDBFF" />
    <GradientStop Offset="1.4" Color="White" />
  </LinearGradientBrush>
  
  <SolidColorBrush x:Key="InconsistentManyEditorBackground" Color="#DDDDDD" />
  <SolidColorBrush x:Key="InconsistentManyEditorForeground" Color="#6D6D6D" />

  <SolidColorBrush x:Key="ReadonlyForeground" Color="Black" />
  
  <SolidColorBrush x:Key="ValidationErrorForeground" Color="White" />
  <SolidColorBrush x:Key="ValidationErrorBackground" Color="Red" />
  <SolidColorBrush x:Key="ValidationErrorBorder" Color="DarkRed" />

  <!-- ===================== -->
  <!--   Validation styles   -->
  <!-- ===================== -->
  
  <DataTemplate x:Key="ValidationErrorMessage">
    <Border Background="Transparent" Padding="2">
      <Border Background="{StaticResource ValidationErrorBackground}" BorderBrush="{StaticResource ValidationErrorBorder}" BorderThickness="2" CornerRadius="3" Padding="4">
        <TextBlock Background="{StaticResource ValidationErrorBackground}" Text="{Binding ErrorContent}" Foreground="{StaticResource ValidationErrorForeground}" />
      </Border>
    </Border>
  </DataTemplate>

  <Style x:Key="BaseErrorPopupTriggerStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <Style x:Key="ErrorPopupTriggerBorder" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource ValidationErrorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource ValidationErrorBackground}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style x:Key="ErrorPopupTriggerContent" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource ValidationErrorForeground}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Text" Value="!" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Height" Value="25" />
  </Style>
  
  <Style x:Key="ErrorPopupTriggerStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseErrorPopupTriggerStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Style="{StaticResource ErrorPopupTriggerBorder}">
            <TextBlock Style="{StaticResource ErrorPopupTriggerContent}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- ================= -->
  <!--   Editor styles   -->
  <!-- ================== -->
  
  <!-- TextBox -->
  
  <Style x:Key="PropertyGridTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="Background" Value="{StaticResource EditorBackground}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBoxBase}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel VerticalAlignment="Center">
              <ToggleButton x:Name="ErrorPlaceholder" Style="{StaticResource ErrorPopupTriggerStyle}" />
              <Popup IsOpen="{Binding ElementName=ErrorPlaceholder, Path=IsChecked}" AllowsTransparency="True"
                     Placement="Bottom" PlacementTarget="{Binding ElementName=ErrorPlaceholder}" StaysOpen="False">
                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type pg:TextBox}}, Path=(Validation.Errors)}"
                              ItemTemplate="{StaticResource ValidationErrorMessage}" />
              </Popup>
              <ScrollViewer BorderThickness="0" x:Name="PART_ContentHost" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="ErrorPlaceholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate>
          <DockPanel>
            <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="Red"
                     ToolTip="{Binding ElementName=EditorHolder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
            <AdornedElementPlaceholder x:Name="EditorHolder" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  
  <!-- ManyEditor -->

  <DataTemplate x:Key="ManyEditorContentTemplate">
    <StackPanel Orientation="Horizontal" TextBlock.Foreground="{StaticResource InconsistentManyEditorForeground}" Background="Transparent">
      <Border Background="Transparent" Width="5" Height="0" />
      <TextBlock Text="Multiple (" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PropertyTypeName}" VerticalAlignment="Center" />
      <TextBlock Text=")" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <Style x:Key="ManyEditorStyle" TargetType="{x:Type pg:ManyEditor}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ManyEditor}">
          <Grid>
            <DockPanel Name="InconsistentView">
              <Button DockPanel.Dock="Right" Command="{x:Static pg:ManyEditor.ResetCommand}" CommandParameter="{Binding}" Width="14" Height="14"
                      ToolTip="This property has different values across the selected objects. Click to set a value." Padding="1" Margin="4,0,0,0"
                      Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource bvc}}">
                <Path StrokeThickness="1" Stroke="{StaticResource Foreground}" Fill="White" Data="M 0.5 0 L 1 0.5 L 0.5 1 L 0 0.5 Z" Stretch="Fill" />
              </Button>
              <Border Name="Bd" CornerRadius="4" Background="{StaticResource InconsistentManyEditorBackground}" BorderBrush="Black" BorderThickness="1">
                <ContentControl Content="{Binding Value}" ContentTemplate="{StaticResource ManyEditorContentTemplate}" Margin="{TemplateBinding Padding}" />
              </Border>
            </DockPanel>
            <ContentControl Name="ConsistentView" Visibility="Collapsed" Content="{Binding Converter={StaticResource DeManyfier}}" 
                            Focusable="False" FocusVisualStyle="{x:Null}"
                            ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsConsistent" Value="True">
              <Setter TargetName="ConsistentView" Property="Visibility" Value="Visible" />
              <Setter TargetName="InconsistentView" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <!-- DatePicker -->

  <Style x:Key="PropertyGridDatePickerStyle" TargetType="{x:Type local:DropDownDatePicker}" BasedOn="{StaticResource {x:Type local:DropDownDatePicker}}">
    <Setter Property="Format" Value="Custom" />
    <Setter Property="CustomFormat" Value="dd/MM/yyyy" />
  </Style>
  
  <!-- ================== -->
  <!--   ToolBar styles   -->
  <!-- ================== -->
  
  <Style x:Key="CancelSearchButtonStyle" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Name="Border" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}"
                  Visibility="{Binding IsEnabled, Converter={StaticResource bvc}, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Name="InnerBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <Path Stretch="Fill" Stroke="{StaticResource Border}" Data="M 0 0 L 1 1 M 1 0 L 0 1" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                    Width="8" Height="8" Margin="4" VerticalAlignment="Center" HorizontalAlignment="Center" Name="Path" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource MouseOverButtonBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource MouseOverInnerBorder}" />
              <Setter TargetName="Path" Property="Stroke" Value="Black" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource PressedButtonBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedBorder}" />
              <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{StaticResource PressedInnerBorder}" />
              <Setter TargetName="Path" Property="Stroke" Value="Black" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="AllSingingAllDancingSearchBox" TargetType="TextBox">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle"	Value="{x:Null}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    <Setter Property="Background" Value="{StaticResource SearchBoxBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2" />
            <ScrollViewer x:Name="PART_ContentHost" />
            <Button Grid.Column="1" Style="{StaticResource CancelSearchButtonStyle}" Command="{x:Static pg:ViewCommandsToolBar.ClearFilter}" IsTabStop="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:6" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2">
                    <DoubleAnimation From="-0.4" To="1" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[1].Offset" />
                    <DoubleAnimation From="-0.2" To="1.2" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[2].Offset" />
                    <DoubleAnimation From="0" To="1.4" Storyboard.TargetName="Border" Storyboard.TargetProperty="Background.GradientStops[3].Offset" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="ToolBarBorderStyle" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource HorizontalToolBarBackground}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource ToolBarBorder}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  
  <Style x:Key="ToolBarButtonStyle" TargetType="Button">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="18" Width="18">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverToolBarButtonBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedToolBarButtonBackground}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedBorder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  <Style x:Key="ToolBarStyle" TargetType="{x:Type pg:ViewCommandsToolBar}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:ViewCommandsToolBar}">
          <Border Style="{StaticResource ToolBarBorderStyle}">
            <DockPanel>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowCategorized}" ToolTip="Sort by Category"
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButtonStyle}">
                <Path Data="M 0 0 L 5 0 L 5 1 L 0 1 Z M 7 0 L 12 0 L 12 1 L 7 1 Z
                                                      M 7 2 L 12 2 L 12 3 L 7 3 Z
                            M 0 4 L 5 4 L 5 5 L 0 5 Z M 7 4 L 12 4 L 12 5 L 7 5 Z
                                                      M 7 6 L 12 6 L 12 7 L 7 7 Z"
                      Fill="{StaticResource Foreground}" SnapsToDevicePixels="True"
                      VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowAlphaSorted}" ToolTip="Sort Alphabetically"
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButtonStyle}">
                <Path Data="M 2 0 L 4 0 L 4 5 L 6 5 L 3 8 L 0 5 L 2 5 Z" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Fill="{StaticResource Foreground}" SnapsToDevicePixels="True" />
              </Button>
              <Button Command="{x:Static pg:ViewCommandsToolBar.ShowUnsorted}" ToolTip="No Sorting"
                      DockPanel.Dock="Left" Style="{StaticResource ToolBarButtonStyle}">
                <Path Data="M 0 0 L 8 0 L 8 1 L 0 1 Z
                            M 0 2 L 8 2 L 8 3 L 0 3 Z
                            M 0 4 L 8 4 L 8 5 L 0 5 Z
                            M 0 6 L 8 6 L 8 7 L 0 7 Z"
                      Fill="{StaticResource Foreground}" SnapsToDevicePixels="True"
                      VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Button>
              <Label DockPanel.Dock="Left" Content="{DynamicResource {x:Static pg:ViewCommandsToolBar.SearchLabelContentKey}}" VerticalAlignment="Center" />
              <TextBox Name="PART_FilterText" Style="{StaticResource AllSingingAllDancingSearchBox}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= -->
  <!--   PropertyGrid styles   -->
  <!-- ======================= -->

  <pg:ScalingConverter x:Key="IntegerHeightForGridRow" ScaleFactor="1.3" ForceToInteger="True" />

  <Style x:Key="AllSingingAllDancingTreeViewItem" TargetType="{x:Type pg:TreeListViewItem}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type pg:TreeListViewItem}">
          <StackPanel HorizontalAlignment="Stretch" Name="ContainerPanel">
            <GridViewRowPresenter x:Name="PART_Header" Content="{TemplateBinding Header}" 
                                  MinHeight="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IntegerHeightForGridRow}}"
                                  Columns="{Binding Path=Columns, RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListView}}}" />
            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed">
              <ItemsPresenter.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" x:Name="ItemsHostScaleTransform" />
              </ItemsPresenter.LayoutTransform>
            </ItemsPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <EventTrigger RoutedEvent="pg:TreeListViewItem.Expanding">
              <BeginStoryboard>
                <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="4" AccelerationRatio="0.2" DecelerationRatio="0.4">
                  <DoubleAnimation From="0" To="1" Storyboard.TargetName="ItemsHostScaleTransform" Storyboard.TargetProperty="ScaleY" />
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="pg:TreeListViewItem.Collapsing">
              <BeginStoryboard>
                <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                  <DoubleAnimation From="1" To="0" Storyboard.TargetName="ItemsHostScaleTransform" Storyboard.TargetProperty="ScaleY" />
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ExpansionStyle" TargetType="ToggleButton">
    <Setter Property="ToggleButton.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="Transparent" Name="Border">
            <Polygon x:Name="ExpansionGlyph" Fill="{StaticResource ExpanderBackground}" Points="4,5 4,15 10,10" RenderTransformOrigin="0.5,0.5">
			  <Polygon.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="0" />
              </Polygon.RenderTransform>
		    </Polygon>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ExpansionGlyph" Property="Fill" Value="{StaticResource MouseOverExpanderBackground}" />
            </Trigger>
			<EventTrigger RoutedEvent="ToggleButton.Checked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="0.0" To="90.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="90.0" To="0.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <HierarchicalDataTemplate x:Key="FancyNodeTemplate" ItemsSource="{Binding Children}">
    <Grid Margin="{Binding Level,Converter={StaticResource LevelToIndentConverter},RelativeSource={RelativeSource AncestorType={x:Type pg:TreeListViewItem}}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="15" Name="SubitemExpanderColumn" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="15" />
      </Grid.ColumnDefinitions>
      <Border Visibility="{Binding Path=(pg:TreeListView.ShowSubitemExpanders), Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}">
        <ToggleButton x:Name="ExpansionToggle" Focusable="False" Style="{StaticResource ExpansionStyle}" Margin="0,3,0,0"
                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"  
                      Visibility="{Binding HasItems, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource bvc}}" />
      </Border>
      <Border HorizontalAlignment="Stretch" Grid.Column="1">
        <TextBlock Text="{Binding Node.HumanName}" Foreground="{StaticResource Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Padding="3,5,0,1"
                   ToolTipService.IsEnabled="{Binding Path=(ToolTipService.IsEnabled), RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}"
                   Tag="{Binding PropertyNameToolTipTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}">
          <ToolTipService.ToolTip>
            <ToolTip Content="{Binding}" ContentTemplate="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" />
          </ToolTipService.ToolTip>
        </TextBlock>
      </Border>
    </Grid>
    <HierarchicalDataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=(pg:TreeListView.ShowSubitemExpanders), RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" Value="False">
        <Setter TargetName="SubitemExpanderColumn" Property="Width" Value="0" />
      </DataTrigger>
    </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>

  <Style x:Key="GroupExpanderButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="Transparent">
            <Path Name="Arrow" Data="M 7 3 L 11 7 L 7 11" StrokeThickness="3" Stroke="{StaticResource ExpanderBackground}" RenderTransformOrigin="0.5,0.5">
			  <Path.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="90" />
              </Path.RenderTransform>
		    </Path>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource MouseOverExpanderBackground}" />
            </Trigger>
			<EventTrigger RoutedEvent="ToggleButton.Checked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="0.0" To="90.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="90.0" To="0.0" Storyboard.TargetName="Rotation" Storyboard.TargetProperty="Angle" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeListViewExpanderStyle" TargetType="{x:Type Expander}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <StackPanel>
            <DockPanel>
              <Border Background="{StaticResource GroupHeaderBackground}" CornerRadius="3,0,0,0" DockPanel.Dock="Left" Margin="-2,0,-2,0" Height="15">
                <ToggleButton x:Name="Expander" Style="{StaticResource GroupExpanderButtonStyle}" ClickMode="Press"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Visibility="{Binding Path=(pg:TreeListView.ShowGroupExpanders), Converter={StaticResource bvc}, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
              </Border>
              <ContentPresenter Margin="3,0,0,0" ContentSource="Header" />
            </DockPanel>
            <ContentPresenter Name="ItemsHost" Visibility="{TemplateBinding IsExpanded, Converter={StaticResource bvc}}">
              <ContentPresenter.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </ContentPresenter.LayoutTransform>
            </ContentPresenter>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <!-- NOTE: Do not animate ScaleY all the way to zero - this messes up the measurement system.
                   Use a very small final value for ScaleY, and animate opacity to ensure the fade out is smooth
                   (otherwise it blinks out suddenly when the visibility animation kicks in).
              
                   Doing the triggger on IsExpanded=False prevents an animation effect as the sections appear.
                   If such an effect is desired, use a trigger on IsExpanded=True and swap the enter and exit actions.
              -->
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="5" AccelerationRatio="0.2" DecelerationRatio="0.2">
                    <DoubleAnimation From="1" To="0.001" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="LayoutTransform.ScaleY" />
                    <DoubleAnimation From="1" To="0" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Opacity" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard Duration="0:0:2" AutoReverse="False" SpeedRatio="4" AccelerationRatio="0.2" DecelerationRatio="0.4">
                    <DoubleAnimation From="0.001" To="1" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="LayoutTransform.ScaleY" />
                    <DoubleAnimation From="0" To="1" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Opacity" />
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ExpandCollapseGroupStyle" TargetType="{x:Type GroupItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupItem}">
          <Border Background="{StaticResource GroupBackground}" BorderThickness="0" CornerRadius="3" Margin="0,3,2,0" Padding="3,0,0,3">
            <Expander Style="{StaticResource TreeListViewExpanderStyle}" IsExpanded="True">
              <Expander.Header>
                <Border Background="{StaticResource GroupHeaderBackground}" BorderThickness="0" Padding="0" CornerRadius="0,3,0,0">
                  <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource GroupForeground}" Text="{Binding Name}" />
                </Border>
              </Expander.Header>
              <ItemsPresenter />
            </Expander>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PropertyGridBorderStyle" TargetType="{x:Type Border}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding BindingView.DefaultView.GroupDescriptions.Count, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource GroupingConverter}}" Value="True">
        <Setter Property="Background" Value="{StaticResource PropertyGridNoGroupingBackground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding BindingView.DefaultView.GroupDescriptions.Count, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource GroupingConverter}}" Value="False">
        <Setter Property="Background" Value="{StaticResource PropertyGridBackground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  
  <!-- ReadOnlyDisplay DataTemplate -->
  
  <DataTemplate x:Key="{x:Static local:PropertyGrid.ReadOnlyDisplayKey}">
    <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True"
            Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
            Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
      <TextBlock Foreground="{StaticResource ReadonlyForeground}" Text="{Binding Value}" VerticalAlignment="Center" />
    </Border>
  </DataTemplate>
  
  <!-- CollectionDisplay DataTemplate -->
  
  <DataTemplate x:Key="{x:Static local:PropertyGrid.CollectionDisplayKey}">
    <Border Background="Transparent" BorderThickness="0"
            Padding="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderPadding}}"
            Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource DefaultMarginToBorderMargin}}">
      <DockPanel>
        <Border DockPanel.Dock="Right">
          <Button Command="{x:Static local:PropertyGrid.CollectionAddCommand}" CommandParameter="{Binding Value}" Width="14" Height="14"
                  ToolTip="Click to add a new item" Padding="0" 
                  Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource bvc}}">
            <Path StrokeThickness="2" Stroke="{StaticResource Foreground}" Data="M 0.5 0 L 0.5 1 M 0 0.5 L 1 0.5" Stretch="Fill" />
          </Button>
        </Border>
        <TextBlock Text="{Binding Path=Value.Count}" IsEnabled="False" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource ReadonlyForeground}"
                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
        <TextBlock Name="ItemText" Text="items" IsEnabled="False" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource ReadonlyForeground}"
                   Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=(pe:Editor.HostStyle)}" />
      </DockPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Value.Count}" Value="1">
        <Setter TargetName="ItemText" Property="Text" Value="item" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  
  <!-- CollectionElement Editor DataTemplate -->
  
  <DataTemplate x:Key="{x:Static local:PropertyGrid.CollectionElementEditorKey}">
    <Grid Margin="{Binding DefaultMargin, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ContentControl Content="{Binding}" Grid.Column="0" Margin="0,0,3,0"
                      ContentTemplate="{Binding DecoratedTemplate, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}" />
      <Button Grid.Column="1" Command="{x:Static local:PropertyGrid.CollectionRemoveCommand}" Width="14" Height="14" ToolTip="Click to remove this item"
              CommandParameter="{Binding DecoratedNode, RelativeSource={RelativeSource AncestorType={x:Type pe:EditorDecorator}}}"
              Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource bvc}}" Padding="1">
        <Path StrokeThickness="2" Stroke="{StaticResource Foreground}" Data="M 0 0 L 1 1 M 1 0 L 0 1" Stretch="Fill" />
      </Button>
    </Grid>
  </DataTemplate>
  
  <!-- Master PropertyGrid style -->
  
  <Style x:Key="{x:Type local:PropertyGrid}" TargetType="{x:Type local:PropertyGrid}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="DefaultMargin" Value="0" />
    <Setter Property="PropertyNameTemplate" Value="{StaticResource FancyNodeTemplate}" />
    <Setter Property="BuiltInEditorStyles">
      <Setter.Value>
        <pe:BuiltInEditorStyleCollection>
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.SimpleTextEditorKey}" Style="{StaticResource PropertyGridTextBoxStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectEditorKey}" Style="{StaticResource {x:Type ComboBox}}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ListSelectNoTextEntryEditorKey}" Style="{StaticResource {x:Type ComboBox}}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.SliderEditorKey}" Style="{StaticResource {x:Type Slider}}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.RadioSelectEditorKey}" Style="{StaticResource {x:Type ComboBox}}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ManyEditorKey}" Style="{StaticResource ManyEditorStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.ColorEditorKey}" Style="{StaticResource {x:Type local:DropDownColorPicker}}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.DateEditorKey}" Style="{StaticResource PropertyGridDatePickerStyle}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.CheckBoxEditorKey}" Style="{StaticResource {x:Type CheckBox}}" />
          <pe:BuiltInEditorStyle EditorKey="{x:Static local:PropertyGrid.NumericUpDownEditorKey}" Style="{StaticResource {x:Type local:NumericUpDown}}" />
        </pe:BuiltInEditorStyleCollection>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Padding="2,2,2,3" Style="{StaticResource PropertyGridBorderStyle}">
            <DockPanel FocusVisualStyle="{x:Null}">
              <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsToolBarVisible, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource bvc}}">
                <pg:ViewCommandsToolBar Style="{StaticResource ToolBarStyle}" Margin="0,0,3,0"
                                        Target="{Binding BindingView, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
                <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Padding="0,20,0,20" Foreground="White"
                           Visibility="{Binding BindingView.DefaultView.IsEmpty, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Converter={StaticResource bvc}}"
                           Text="No properties match the search criteria." />
              </StackPanel>
              <pg:TreeListView ItemsSource="{Binding BindingView, RelativeSource={RelativeSource TemplatedParent}}" 
                               ItemContainerStyle="{StaticResource AllSingingAllDancingTreeViewItem}"
                               Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                               ItemTemplate="{StaticResource FancyNodeTemplate}" Margin="0,0,1,0" Padding="1,0,1,1" x:Name="PART_Grid">
                <pg:TreeListView.Columns>
                  <GridViewColumnCollection>
                    <GridViewColumn CellTemplate="{Binding PropertyNameTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}"  Width="{Binding Path=(pg:TreeListView.ResizeColumnWidth), RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
                    <GridViewColumn>
                      <GridViewColumn.CellTemplate>
                        <HierarchicalDataTemplate>
                          <Border MinHeight="25">
                            <ContentControl Content="{Binding}" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                                            ContentTemplateSelector="{Binding EditorSelector, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" />
                          </Border>
                        </HierarchicalDataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridViewColumnCollection>
                </pg:TreeListView.Columns>
                <pg:TreeListView.GroupStyle>
                  <GroupStyle ContainerStyle="{StaticResource ExpandCollapseGroupStyle}" />
                </pg:TreeListView.GroupStyle>
              </pg:TreeListView>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>