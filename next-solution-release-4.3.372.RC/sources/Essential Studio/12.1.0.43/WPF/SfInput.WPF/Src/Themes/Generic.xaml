                                                Content="9" x:Name="PART_Digit9"/>
                        <Input:CalculatorButton Margin="2" Key="NumPad4" IsTabStop="False" Focusable="False"
                                                Grid.Row="1" Foreground="{TemplateBinding Foreground}"
                                                Content="4" x:Name="PART_Digit4" />
                        <Input:CalculatorButton Margin="2" Key="NumPad5" IsTabStop="False" Focusable="False"
                                                Grid.Row="1" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="1"
                                                Content="5" x:Name="PART_Digit5"/>
                        <Input:CalculatorButton Margin="2" Key="NumPad6" IsTabStop="False" Focusable="False"
                                                Grid.Row="1" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="2"
                                                Content="6" x:Name="PART_Digit6"/>
                        <Input:CalculatorButton Margin="2" Key="NumPad1" IsTabStop="False" Focusable="False"
                                                Grid.Row="2" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="0"
                                                Content="1" x:Name="PART_Digit1"/>
                        <Input:CalculatorButton Margin="2" Key="NumPad2" IsTabStop="False" Focusable="False"
                                                Grid.Row="2" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="1"
                                                Content="2" x:Name="PART_Digit2"/>
                        <Input:CalculatorButton Margin="2" Key="NumPad3" IsTabStop="False" Focusable="False"
                                                Grid.Row="2" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="2"
                                                Content="3" x:Name="PART_Digit3"/>
                        <Input:CalculatorButton Margin="2" Key="NumPad0" IsTabStop="False" Focusable="False"
                                                Grid.Row="3" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Content="0" x:Name="PART_Digit0"/>
                        <Input:CalculatorButton Margin="2" Key="Decimal" IsTabStop="False" Focusable="False"
                                                Grid.Row="3" Foreground="{TemplateBinding Foreground}"
                                                Grid.Column="2"
                                                Content="." x:Name="PART_Decimal"/>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Input:DisplayPane">
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Input:DisplayPane">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <TextBlock Grid.ColumnSpan="2"
                                   Margin="8"
                                   HorizontalAlignment="Right"
                                   FontSize="14"
                                   FontWeight="ExtraLight"
                                   Text="{TemplateBinding Expression}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap" />
                        <Viewbox Grid.Row="1"
                                 Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom">
                            <TextBlock Margin="8"
                                       VerticalAlignment="Center"
                                       FontSize="50"
                                       FontWeight="ExtraLight"
                                       Text="{Binding DisplayText,
                                                      RelativeSource={RelativeSource TemplatedParent}}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" x:Name="PART_MemorySign"
                                   Margin="8"
                                   VerticalAlignment="Bottom"
                                   Text="M"
                                   Visibility="{Binding Path=Memory,
                                                        RelativeSource={RelativeSource TemplatedParent},
                                                        Converter={StaticResource MemoryConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
