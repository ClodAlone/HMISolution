<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.DocumentContainerSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="DocumentContainer Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Background="#FFDCEBFE">
            <TextBlock Grid.Row="0" Margin="5,5" FontWeight="Bold">Essential Tools - DocumentContainer</TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border  Margin="5,5" Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" />
                
                <TextBlock Text="Name" Margin="5,5" Grid.Row="1" Grid.Column="0" />
                
                <TextBox x:Name="txtName" Margin="5,5" Grid.Row="1" Grid.Column="1"/>
                <Border  Margin="5,5" Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" />
                <TextBlock Margin="5,5" FontWeight="Bold" Grid.Row="3" Grid.ColumnSpan="2">Appearance</TextBlock>
                
                <TextBlock Text="Mode" Grid.Row="4" Grid.Column="0" Margin="5,5" />
                <ComboBox Name="ModeSelector" Margin="5,5" Grid.Row="4" Grid.Column="1" />

                <TextBlock Text="Window Switchers" Grid.Row="5" Grid.Column="0" Margin="5,5" />
                <ComboBox Name="switcher" Margin="5,5" Grid.Row="5" Grid.Column="1" />

            </Grid>

            <Border  Margin="5,5" BorderBrush="Black" BorderThickness=".5" HorizontalAlignment="Stretch" />
            <TextBlock Margin="5,5" FontWeight="Bold" >Behavior</TextBlock>
            <CheckBox Name="chkShowTabItemContextMenu" Content="Show Tab Item Context Menu" Margin="5,5"/>
            <CheckBox Name="chkShowTabListContextMenu" Content="Show Tab List Context Menu" Margin="5,5"/>
            <CheckBox Name="chkIsInMdiMax" Content="IsInMDIMaximizedState" Margin="5,5"/>
            <CheckBox Name="chkcanmdimini" Content="CanMDIMinimize" Margin="5,5"/>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>