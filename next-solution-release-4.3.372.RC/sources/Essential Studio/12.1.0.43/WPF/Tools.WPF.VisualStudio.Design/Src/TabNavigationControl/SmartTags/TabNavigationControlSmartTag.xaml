<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.TabNavigationControlSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="TabNavigationControl Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Height="329" Width="297">
            <StackPanel Name="panel1" Orientation="Vertical" Height="108" Width="280">
                <TextBlock FontWeight="Bold" Margin="0,20,0,0" Text="Essential Tools - TabNavigationControl"></TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,4,0,0" />
                <TextBlock FontWeight="Bold" Margin="0,7,0,0" Text="Actions" Width="289"></TextBlock>
                <Grid Height="34">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="122*" />
                        <ColumnDefinition Width="142*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="3,13,139,6" Grid.ColumnSpan="3" />
                    <TextBox VerticalAlignment="Center" x:Name="txtName" Margin="0,13,40,0" Grid.Column="2" />
                </Grid>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
            </StackPanel>
            <Grid Width="286">
                <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
                    <Grid Width="286">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="21" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="27*" />
                            <RowDefinition Height="27*" />
                            <RowDefinition Height="27*" />
                            <RowDefinition Height="23*" />
                            <RowDefinition Height="0*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="23*" />
                            <RowDefinition Height="23*" />
                            <RowDefinition Height="27*" />
                            <RowDefinition Height="0*" />

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.RowSpan="2" Text="Appearance"></TextBlock>
                        <TextBlock VerticalAlignment="Center" Text="CornerRadius" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0" />
                        <TextBox x:Name="CornerRadius" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Height="20" Margin="0,3,0,1" HorizontalAlignment="Left" Width="100" />
                        <!--<ComboBox x:Name="CornerRadius" Grid.Column="1" Grid.Row="1" Width="100" VerticalAlignment="Bottom" Height="20"/>-->
                        <!--<CheckBox Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="1"/>-->
                        <TextBlock VerticalAlignment="Center" Text="HeaderVisiblity" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" />
                        <ComboBox x:Name="HeaderVisibility" Grid.Column="1" Grid.Row="2" Width="100" Margin="0,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20"/>
                        <!--<CheckBox Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="2"/>-->
                        <TextBlock VerticalAlignment="Center" Text="TabStripVisiblity" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0" />
                        <ComboBox x:Name="TabStripVisibility" Grid.Column="1" Grid.Row="3" Width="100"  Margin="0,7,0,0" VerticalAlignment="Bottom" Height="20" HorizontalAlignment="Left"/>
                        <TextBlock VerticalAlignment="Center" Text="NavigationButtonVisiblity" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0" />
                        <!--<CheckBox Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="3"/>-->
                        <Border BorderBrush="Black" BorderThickness="0.5" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,7,0,0"/>
                        <ComboBox x:Name="NavigationButtonVisibility" Grid.Column="1" Grid.Row="4" Margin="0,7,0,0" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20"/>

                        <TextBlock Text="Behaviour" FontWeight="Bold" Grid.Row="9"  Margin="0,7,0,0" VerticalAlignment="Bottom"/>
                        <TextBlock VerticalAlignment="Center" Text="EnableTouch" Grid.Row="10" Grid.Column="0" Margin="0,7,0,0" />
                        <CheckBox x:Name="EnableTouch" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,7,0,0" Grid.Row="10"/>
                        <TextBlock VerticalAlignment="Center" Text="TouchThreshold" Grid.Row="11" Margin="0,7,0,0" />
                        <TextBox x:Name="TouchThreshold" Grid.Column="1" Grid.Row="11" VerticalAlignment="Center" Height="20" Margin="0,3,0,1" HorizontalAlignment="Left" Width="100" />
                        <!--<TextBox x:Name="TouchThreshold" Grid.Column="1" Grid.Row="11"  HorizontalAlignment="Left" Margin="21,7,22,0" Height="20"/>-->
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
