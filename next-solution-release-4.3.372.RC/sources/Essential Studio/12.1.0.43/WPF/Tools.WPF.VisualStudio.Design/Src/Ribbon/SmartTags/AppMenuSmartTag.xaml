<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.AppMenuSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    
    <syncfusion:SmartTagPresenter Title="ApplicationMenu Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>
            </Grid>

            <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

            <TextBlock FontWeight="Bold" Margin="0,7,0,0">Actions</TextBlock>
            <TextBlock Margin="0,7,0,0">
              <Hyperlink Tag="{x:Type syncfusion:MenuButton}" Click="AddChildControl">Add New MenuButton</Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,7,0,0">
              <Hyperlink Tag="{x:Type syncfusion:SimpleMenuButton}" Click="AddChildControl">Add New MenuButton</Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,7,0,0">
              <Hyperlink Tag="{x:Type syncfusion:MenuButton}" Click="AddChildControl">Add New SimpleMenuButton</Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,7,0,0">
              <Hyperlink Tag="{x:Type Separator}" Click="AddChildControl">Add New Separator</Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,7,0,0">
              <Hyperlink Tag="{x:Type syncfusion:SplitMenuButton}" Click="AddChildControl">Add New SplitMenuButton</Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,7,0,0">
              <Hyperlink Tag="{x:Type syncfusion:RibbonButton}" Click="AddFooterItem">Add FooterItem</Hyperlink>
            </TextBlock>

            <Border BorderBrush="Black"   BorderThickness="0.5"  Margin="0,7,0,0"/>


            <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

            <StackPanel  Margin="7">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>


                    <TextBlock VerticalAlignment="Center" Text="Horizontal Alignment" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="HorizontalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="Vertical Alignment" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VerticalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>


                <Border BorderBrush="Black"   BorderThickness="0.5"  Margin="0,7,0,0"/>


                <TextBlock FontWeight="Bold" >Behavior</TextBlock>

                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <CheckBox Name="isEnabled"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                            Is Enabled
                    </TextBlock>
                </StackPanel>


                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <CheckBox Name="isBelowAppButton"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                           Is Below AppButton
                    </TextBlock>
                </StackPanel>

            </StackPanel>

        </StackPanel>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
