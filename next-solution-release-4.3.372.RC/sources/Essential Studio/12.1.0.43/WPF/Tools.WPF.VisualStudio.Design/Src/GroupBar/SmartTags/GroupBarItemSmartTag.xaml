<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.GroupBarItemSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="GroupBarItem Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">
                               
                <StackPanel Margin="0,7,0,0">
                    <TextBlock FontWeight="Bold" >Actions</TextBlock>
                    <TextBlock Margin="0,7,0,0">
                    <Hyperlink Tag="{x:Type syncfusion:GroupView}" Click="SetGroupViewContent">Set GroupView as Content</Hyperlink>
                    </TextBlock>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />

                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                        <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Header Text" VerticalAlignment="Center"  Grid.Row="2" Grid.Column="0" Margin="2"/>
                        <TextBox Name="HeaderTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>

                    </Grid>


                  



                </StackPanel>





            </StackPanel>

            <StackPanel  Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>




                    <Border BorderBrush="Black" BorderThickness="0.5" Grid.Row="0" Grid.ColumnSpan="2"  Margin="0,7,0,0"/>



                    <TextBlock FontWeight="Bold" Grid.Row="1" Margin="0,7,0,0">Behavior</TextBlock>

                    <StackPanel Grid.Row="2"  Margin="0,7,0,0">
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsExpandedCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                 Allow Expand for GroupBar Item
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="ShowInGroupBarCheckBox"/>
                            <TextBlock  Margin="3,0,0,0" VerticalAlignment="Center">
                                 Show in GroupBar
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsAnimatingCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                Animate GroupBar Item
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0"  Orientation="Horizontal">
                            <CheckBox Name="IsInEditModeCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                Is InEditMode
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0"  Orientation="Horizontal">
                            <CheckBox Name="IsDragOverTopCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                 Is DragOverTop
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0"  Orientation="Horizontal">
                            <CheckBox Name="IsLastItemCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                Set as Last Item
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0"  Orientation="Horizontal">
                            <CheckBox Name="IsSelectedCheckBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                                 Selected GroupBar Item
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>

                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>