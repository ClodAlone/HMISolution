<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.AutoCompleteSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    <syncfusion:SmartTagPresenter Title="AutoComplete Tasks">

<syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <Grid Background="#FFDCEBFE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
           
            <StackPanel Margin="7" Grid.Row="0">
                <TextBlock FontWeight="Bold">Essential Tools - AutoComplete</TextBlock>
              
            </StackPanel>
            
            


            <StackPanel  Margin="7" Grid.Row="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <Border   Grid.Row="0" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>

                    <TextBlock Text="Name" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                    <TextBox Name="name"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>
               
                     <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="2" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0"  FontWeight="Bold" Grid.Row="3">Appearance</TextBlock>
               
                    
                    
                    
                        <TextBlock VerticalAlignment="Center" Text="Source Mode" Grid.Row="5" Grid.Column="0"/>
                        <ComboBox Name="SourceSelector" Margin="3,3,3,3" Width="115" Grid.Row="5" Grid.Column="1"/>
                    
                     



 <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="7" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="8">Behavior</TextBlock>

                    <StackPanel Grid.Row="9"  Margin="7">
                        
                       


                      <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="isAutoAppend"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Is AutoAppend 
                        </TextBlock>
                    </StackPanel>

                        
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="isFilter"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Is Filter 
                        </TextBlock>
                    </StackPanel>
                    
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="isAutoCompleteItem"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Is AutoCompleteItem
                        </TextBlock>
                    </StackPanel>
                        
                          <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="isAsyncAddContent"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Is AsynchronousAddContent 
                        </TextBlock>
                    </StackPanel>

                    
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <CheckBox Name="isHistory"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Is History 
                        </TextBlock>
                    </StackPanel>

                        
                        
                            </StackPanel>
                         
            <TextBlock Text="Maximum Drop Height" VerticalAlignment="Center" Grid.Row="10" Grid.Column="0" />
                    <syncfusion:DoubleTextBox Name="Dropheightbox"  Margin="3,3,3,3" Width="115" Grid.Row="10" Grid.Column="1"/>
                        
                        
                          <TextBlock Text="Text" VerticalAlignment="Center" Grid.Row="11" Grid.Column="0" />
                    <TextBox Name="textbox"  Margin="3,3,3,3" Width="115" Grid.Row="11" Grid.Column="1"/>
                        
                          <TextBlock Text="File Storage Name" VerticalAlignment="Center" Grid.Row="12" Grid.Column="0"/>
                    <TextBox Name="fileName"  Margin="3,3,3,3" Width="115" Grid.Row="12" Grid.Column="1"/>
                </Grid>
            </StackPanel>
        </Grid>

        
   
        </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>

