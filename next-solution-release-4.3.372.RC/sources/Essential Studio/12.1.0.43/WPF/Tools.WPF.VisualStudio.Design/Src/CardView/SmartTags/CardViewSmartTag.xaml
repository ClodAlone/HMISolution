<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.CardViewSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue" 
                     Height="24" Width="24" x:Name="one">

    <syncfusion:SmartTagPresenter Title="CardView Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Height="268" Width="243">
            <Grid Width="250">
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="123"/>
                    <ColumnDefinition Width="127*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="Bold" Margin="0,0,7,0" Grid.ColumnSpan="2" VerticalAlignment="Center">Essential Tools - CardView</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,22,0,0" Grid.Row="0" Grid.ColumnSpan="2"/>
                <TextBlock Text="Name" VerticalAlignment="Bottom"  Grid.Row="2" Margin="0,0,7,0"/>
                <TextBox x:Name="textBox1" HorizontalAlignment="Left" Width="100" Grid.Row="2" Grid.Column="1" Height="20"/>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,22,0,0" Grid.Row="3" Grid.ColumnSpan="2"/>
                <TextBlock FontWeight="Bold" Grid.Row="4" VerticalAlignment="Bottom">Appearance</TextBlock>
                <TextBlock Text="Orientation" Grid.Row="5" VerticalAlignment="Bottom"></TextBlock>
                <ComboBox x:Name="comboBox1" Grid.Row="5" Grid.Column="1" Width="100" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                <CheckBox x:Name="checkBox1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="1"/>
                <TextBlock Text="ShowHeader" Grid.Row="6" VerticalAlignment="Bottom"/>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,22,0,0" Grid.Row="7" Grid.ColumnSpan="2"/>
                <TextBlock Text="  Behaviour" FontWeight="Bold" Grid.Row="8" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                <TextBlock Text="  CanEdit" Grid.Row="9" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                <TextBlock Text="  CanSort" Grid.Row="10" VerticalAlignment="Bottom"/>
                <TextBlock Text="  CanGroup" Grid.Row="11" VerticalAlignment="Bottom"/>
                <CheckBox x:Name="checkBox2" VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Grid.Row="9" Grid.Column="1" />
                <CheckBox x:Name="checkBox3" VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Grid.Row="10" Grid.Column="1" />
                <CheckBox x:Name="checkBox4" VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Grid.Row="11" Grid.Column="1" />

            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
    
</syncfusion:SmartTagBase>
