<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.TreeViewItemAdvSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="TreeViewItemAdv Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">

            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - TreeViewItemAdv</TextBlock>

                <Border BorderBrush="Black" Margin="0,7,0,0" BorderThickness="0.5"/>

                <TextBlock Margin="0,7,0,0">
					<Hyperlink Tag="{x:Type syncfusion:TreeViewItemAdv}" Click="AddChildControls">Add New TreeViewItemAdv</Hyperlink>
                </TextBlock>
            </StackPanel>


            <Border BorderBrush="Black" Margin="7,7,7,0" BorderThickness="0.5"/>

			<StackPanel Margin="7">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock Text="Name" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
					<TextBox Name="NameTextBox" HorizontalAlignment="Right"  Margin="3" Width="115" Grid.Row="0" Grid.Column="1"/>
					<Border BorderBrush="Black"  Grid.Row="1" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
				</Grid>
			</StackPanel>
			<StackPanel  Margin="7">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>
                    <TextBlock Text="Header" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="2"/>
                    <TextBox Name="HeaderTextBox"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>


                    <StackPanel Grid.Row="2">
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="IsExpanded" VerticalAlignment="Center"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Expand TreeViewItemAdv
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>