                    xmlns:Syncfusion_Windows_Controls_Primitives="clr-namespace:Syncfusion.Windows.Controls.Primitives">
    <Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey" />

    <SolidColorBrush x:Key="Office2007.Silver.Background" Color="#FFDDE2EC" />
    <SolidColorBrush x:Key="Office2007.Silver.BorderBrush" Color="#FF9B9DA0" />
    <SolidColorBrush x:Key="Office2007.Silver.Foreground" Color="Black" />
