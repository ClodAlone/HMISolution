<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:vsm="clr-namespace:Syncfusion.Windows" xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared"
                    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/MetroThemeBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

  
    <SolidColorBrush Color="#FFDFDFDF" x:Key="MetroThemeOverflowBurronBackgroundBrush"/>
    
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFFFF" />
 
    <Style x:Key="DropDownButtonAdvStyle" TargetType="{x:Type shared:DropDownButtonAdv}">
        <Setter Property="Foreground" Value="{DynamicResource  MetroForegroundBrush}"/>
        <Setter Property="Label" Value="Drop Down Button"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}"/>
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:DropDownButtonAdv}">
                    <Grid>
                        <Grid.Resources>
                            <shared:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <!--<vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonButtonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{DynamicResource  MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{DynamicResource  MetroBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{DynamicResource  MetroBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{DynamicResource  MetroFocusedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                
                                
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".5"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>-->
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" MinHeight="22">
                           
                              
                               
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PART_Text" Grid.Column="1" Foreground="{TemplateBinding Foreground}" 
                                                   FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" 
                                                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                                                   Text="{TemplateBinding Label}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                                        <Path x:Name="path" Grid.Column="2" Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z " Fill="{TemplateBinding  Foreground}" HorizontalAlignment="Center" Height="4" Margin="3" Stretch="Uniform" VerticalAlignment="Center" Width="8"/>
                                    </Grid>
                               
                           
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <!--<Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw" Color="Transparent" >-->
                                <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                    <Border Background="White" BorderThickness="1" BorderBrush="{DynamicResource  MetroBorderBrush}" CornerRadius="0">

                                        <Border BorderThickness="0"  CornerRadius="1">
                                            <ContentPresenter/>
                                        </Border>
                                    </Border>
                                </Grid>
                            <!--</Microsoft_Windows_Themes:SystemDropShadowChrome>-->
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="HasDropShadow" SourceName="PART_DropDown" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5"/>
                            <Setter Property="Color" TargetName="Shdw" Value="#71000000"/>
                        </Trigger>-->
                        <Trigger Property="IsDropDownOpen" Value="true">
                            <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource  MetroBrush}"/>
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{DynamicResource  MetroFocusedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" SourceName="ItemBorder" Value="true"/>
                                <Condition Property="IsDropDownOpen" Value="true"/>
                                    
                                
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource  MetroBrush}"/>
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{DynamicResource  MetroFocusedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>

                        </MultiTrigger>
                        <!--<MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" SourceName="ItemBorder" Value="true"/>
                                <Condition Property="IsPressed"  Value="true"/>


                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource  MetroBrush}"/>
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{DynamicResource  MetroFocusedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>

                        </MultiTrigger>
                        <Trigger Property="IsPressed"  Value="true">
                            <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource  MetroBrush}"/>
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{DynamicResource  MetroFocusedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                        </Trigger>-->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" SourceName="ItemBorder" Value="true"/>
                                <Condition Property="IsDropDownOpen" Value="false"/>


                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="ItemBorder" Value="{DynamicResource  MetroHoverBrush}"/>

                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <SolidColorBrush Color="#FFD8D8D9" x:Key="meugroupheaderbackgroundbrush"/>
 
    <Style x:Key="DropDownMenuGroupStyle1" TargetType="{x:Type tools:DropDownMenuGroup}">
        <Setter Property="Background" Value="{DynamicResource  MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource  MetroBorderBrush}"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tools:DropDownMenuGroup}">
                    <Grid x:Name="gri" Background="{DynamicResource  MetroPanelBackgroundBrush}">
                        <Grid.Resources>
                            <tools:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                            <tools:TextToVisibilityConverter x:Key="TextConverter"/>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="White" BorderThickness="0,0,0,1" Background="White"  Height="22" Margin="1,0,1,1" Grid.Row="0">
                            <Border.Visibility>
                                <Binding Path="Header" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <tools:TextToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <Grid>
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Background="white"/>
                                <ContentControl Content="{TemplateBinding Header}" Foreground="Black" FontWeight="Bold" HorizontalContentAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>
                                <Border x:Name="IconTray" BorderBrush="Transparent" BorderThickness="0,0,1,0" Background="White" HorizontalAlignment="Left" Margin="0,0,0,1" Width="44">
                                    <Border.Visibility>
                                        <Binding Path="IconBarEnabled" RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                    <Border BorderBrush="#FFCCCCCC" BorderThickness="0,0,1,0"/>
                                </Border>
                                <Border>
                                    <ScrollViewer KeyboardNavigation.DirectionalNavigation="Cycle" Padding="1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                                        <ScrollViewer.BorderThickness>
                                            <Binding Path="ScrollBarVisibility" RelativeSource="{RelativeSource TemplatedParent}">
                                                <Binding.Converter>
                                                    <tools:VisibilityToThicknessConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </ScrollViewer.BorderThickness>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border BorderBrush="#FFCCCCCC" BorderThickness="0,0,2,0" Background="White"  HorizontalAlignment="Left" Width="22">
                                    <Border.Visibility>
                                        <Binding Path="IsMoreItemsIconTrayEnabled" RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                </Border>
                                <ItemsControl/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Background="Transparent" HorizontalAlignment="Stretch" Margin="1,0" Grid.Row="3" Width="{Binding ActualWidth, ElementName=PART_ResizeThumb}">
                            <Border.Visibility>
                                <Binding Path="IsResizable" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <Grid>
                                <Border BorderBrush="White" BorderThickness="0,1,0,0">
                                    <Border HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Width="3"/>
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Margin="3,0,0,0" SnapsToDevicePixels="True" Width="3"/>
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Margin="3,0,0,0" SnapsToDevicePixels="True" Width="3"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Cursor="SizeNS" Opacity="0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>





    <Style TargetType="shared:DropDownMenuItem" x:Key="MenuItemStyle">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:DropDownMenuItem">
                    <Grid>
                        <Grid.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <Border Margin="0,0,2,0"  Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                      
                                <Grid Margin="0,0,0,-2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="21"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentControl Content="{TemplateBinding Header}" Grid.Column="2" Margin="6 2 2 2"/>
                                    <ContentControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="3" Margin="3" FontSize="14"/>
                                    <Border Margin="0,2,2,2" x:Name="iconborder" Grid.Column="1">
                                        <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1,1,1,2"/>
                                    </Border>
                                    <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2,2,2,4"  Background="White" BorderBrush="#FF333333" BorderThickness="1">
                                        <Path x:Name="CheckIcon" 
                                          Data="M92,307 L106,322 136.61635,291.20421 132.61635,286.20421 107,311.5 98,302 z" 
                                          Fill="#FF333333" FlowDirection="LeftToRight" Height="9" Stretch="Fill" Width="9.5"/>
                                    </Border>
                                </Grid>
                           
                        </Border>

                        <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                            <Grid Opacity="0" x:Name="PART_poup">
                                <Border Background="{DynamicResource MetroPanelBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource  MetroBorderBrush}">
                                    <ItemsPresenter />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource  MetroBrush}"/>

                            <Setter Property="Foreground"  Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}" >
                            <Setter TargetName ="iconborder" Property="Visibility" Value="Collapsed" />
                        </Trigger>


                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="OverflowButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                     
                        <Trigger Property="IsEnabled" Value="false">
                            <!--<Setter Property="Foreground" Value="#ADADAD"/>-->
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="OverflowButtonStyle1" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      
                        <Trigger Property="IsEnabled" Value="false">
                            <!--<Setter Property="Foreground" Value="#ADADAD"/>-->
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  


    <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}" x:Key="VerticalTemplate">
        <Border x:Name="mainborder" SnapsToDevicePixels="True"  Background="{StaticResource  MetroThemeOverflowBurronBackgroundBrush}" CornerRadius="3" BorderThickness="0" BorderBrush="#FFB5BECE">
            <vsm:VisualStateManager.VisualStateGroups>
                <vsm:VisualStateGroup x:Name="Orientation">
                </vsm:VisualStateGroup>
            </vsm:VisualStateManager.VisualStateGroups>
            <Grid >
                <Grid.RowDefinitions>

                    <RowDefinition x:Name="row0" Height="*"></RowDefinition>
                    <RowDefinition x:Name="row1" Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Border SnapsToDevicePixels="True"  Background="{TemplateBinding Background}" BorderThickness="1,1,1,0" BorderBrush="{StaticResource  MetroThemeOverflowBurronBackgroundBrush}" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8" />
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>



                        <!--<Button x:Name="PART_DragThumb" Style="{StaticResource ThumbStyle}" Margin="2 3 4 2" ></Button>-->
                        <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="2 3 4 2" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                            <Path x:Name="verticalGripper" Data="M12.5,0.5 L13.5,0.5 L13.5,1.5 L12.5,1.5 z M8.5,0.5 L9.5,0.5 L9.5,1.5 L8.5,1.5 z M4.5,0.5 L5.5,0.5 L5.5,1.5 L4.5,1.5 z M0.5,0.5 L1.5,0.5 L1.5,1.5 L0.5,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="2" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="14"/>
                        </Grid>
                        <shared:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Row="1"></shared:ToolBarPanelAdv>
                    </Grid>
                </Border>
                <ToggleButton x:Name="PART_OverflowButton" Height="12"  Grid.Row="1" Style="{StaticResource OverflowButtonStyle1}">
                    <Grid>
                        <Grid x:Name="verticalPath">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="verticalDownPath" Data="M0.5,20.5 L0.5,0.5 L13.499992,10.582473 z" Grid.Column="2" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" Margin="0,0,4,0" Height="6" Stretch="Fill" Stroke="{TemplateBinding Foreground}" Width="4"/>
                            <Path x:Name="verticalDownPath1" Data="M0.5,0.5 L0.5,20" Fill="Black" Grid.Column="1" HorizontalAlignment="Right" Height="6" Margin="0,0,2,0" Stretch="Fill" Stroke="{TemplateBinding Foreground}" Width="1"/>
                            <Path x:Name="verticalTopOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="{TemplateBinding Foreground}" Margin="3,0,3,2" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="{TemplateBinding Foreground}" VerticalAlignment="Top" Width="3"/>
                            <Path x:Name="verticalBottomOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="{TemplateBinding Foreground}" Margin="3,4,3,0" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="{TemplateBinding Foreground}" VerticalAlignment="Bottom" Width="3"/>
                        </Grid>
                    </Grid>
                </ToggleButton>
                <Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}" StaysOpen="False">
                    <!--<Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw" Color="Transparent" >-->
                        <Border BorderBrush="{DynamicResource  MetroBorderBrush}" BorderThickness="1" Background="{DynamicResource  MetroPanelBackgroundBrush}" MaxWidth="150">

                            <StackPanel>
                                <tools:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></tools:ToolBarOverflowPanel>
                                <shared:DropDownButtonAdv x:Name="PART_AddRemoveButtons" Label="Add or remove buttons"  DropDirection="Right" Margin="2,0,2,2" Style="{StaticResource DropDownButtonAdvStyle}" Visibility="{Binding Path=EnableAddRemoveButton, RelativeSource={RelativeSource AncestorType=shared:ToolBarAdv}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" Margin="0,2,0,2" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True" Style="{StaticResource DropDownMenuGroupStyle1}" >
                                        <shared:DropDownMenuGroup.ItemTemplate>
                                            <DataTemplate>
                                                <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                    <shared:DropDownMenuItem.Icon>
                                                        <Image Source="{Binding Icon}"/>
                                                    </shared:DropDownMenuItem.Icon>
                                                </shared:DropDownMenuItem>
                                            </DataTemplate>
                                        </shared:DropDownMenuGroup.ItemTemplate>
                                    </shared:DropDownMenuGroup>
                                </shared:DropDownButtonAdv>
                            </StackPanel>
                        </Border>
                    <!--</Microsoft_Windows_Themes:SystemDropShadowChrome>-->
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!--<Trigger Property="HasDropShadow" SourceName="PART_OverflowPopup" Value="true">
                <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5"/>
                <Setter Property="Color" TargetName="Shdw" Value="#71000000"/>
            </Trigger>-->

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="sfshared:SkinStorage.EnableTouch" Value="False"/>
                    <Condition Property="IsMouseOver" Value="True" SourceName="PART_OverflowButton"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="mainborder" Value="{DynamicResource  MetroHoverBrush}"/>
            </MultiTrigger>
            
            <Trigger Property="IsPressed" Value="True" SourceName="PART_OverflowButton">
                <Setter Property="Background" TargetName="mainborder" Value="{DynamicResource MetroBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
            </Trigger>
            
            <Trigger Property="IsChecked" Value="True" SourceName="PART_OverflowButton">
                <Setter Property="Background" TargetName="mainborder" Value="{DynamicResource MetroBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
            </Trigger>
            
            <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="MinWidth" Value="45"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Height" Value="25" TargetName="PART_OverflowButton"/>
            </Trigger>
            
        </ControlTemplate.Triggers>        
    </ControlTemplate>
 
    <Style x:Key="ToolBarAdvStyle" TargetType="{x:Type shared:ToolBarAdv}">
        <Setter Property="Background" Value="{DynamicResource  MetroBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent" />
        <!--<Setter Property="ControlsResourceDictionary">
            <Setter.Value>
                <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/Controls/ToolBarAdv/Themes/Metro/MetroResources.xaml"/>
            </Setter.Value>
        </Setter>-->
        <Setter Property="BorderThickness" Value="1,1,0,1"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}">
                    <Border x:Name="mainborder" SnapsToDevicePixels="True"   CornerRadius="3" Background="{StaticResource MetroThemeOverflowBurronBackgroundBrush}" BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="Orientation">
                                    <vsm:VisualState x:Name="Horizontal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Vertical">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="col0" Width="*"></ColumnDefinition>
                                    <ColumnDefinition x:Name="col1" Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="row0"  Height="*"></RowDefinition>
                                    <RowDefinition x:Name="row1" Height="Auto"></RowDefinition>
                                    <RowDefinition x:Name="row2" Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <!--<Button x:Name="PART_DragThumb" Style="{StaticResource ThumbStyle}" Margin="2 3 4 2" ></Button>-->
                                <Border x:Name="border" SnapsToDevicePixels="True"  Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"  BorderBrush="{StaticResource  MetroThemeOverflowBurronBackgroundBrush}" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition  Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="4 2 2 0" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path x:Name="horizontalGripper" Data="M0.5,12.5 L1.5000002,12.5 L1.5000002,13.5 L0.5,13.5 z M0.50000137,8.5 L1.5000012,8.5 L1.5000012,9.5 L0.50000137,9.5 z M0.50000137,4.5 L1.5000012,4.5 L1.5000012,5.5 L0.50000137,5.5 z M0.50000137,0.5 L1.5000014,0.5 L1.5000014,1.5 L0.50000137,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="14" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="2"/>
                                        </Grid>
                                        <tools:ToolBarPanelAdv Grid.Column="1" Margin="1" Background="Transparent"  x:Name="PART_ToolBarPanel" ></tools:ToolBarPanelAdv>
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="PART_OverflowButton" Width="12"   Grid.Column="1" Style="{StaticResource OverflowButtonStyle}">
                                    <!--<MenuItem.Header>-->
                                    <Grid x:Name="horizontalPath" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Path x:Name="horizontalDownPath1" Data="M0,-2 L6,-2" Stroke="{TemplateBinding Foreground}" VerticalAlignment="Bottom" Margin="0,0,0,2" Grid.Row="1" Stretch="Uniform" Height="1" StrokeThickness="1" Width="6"/>
                                        <Path x:Name="horizontalDownPath" Data="M0.5,3 L5.5,3 L3,6 z" Fill="{TemplateBinding Foreground}" Stretch="Fill" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,4" Stroke="{TemplateBinding Foreground}" Width="6" Height="4" />
                                        <Path x:Name="horizontalLeftOverflowPath" Margin="0,3,1,3" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="{TemplateBinding Foreground}"  HorizontalAlignment="Left" Height="3" Stretch="Fill" Stroke="{TemplateBinding Foreground}" VerticalAlignment="Top" Width="2.5"/>
                                        <Path x:Name="horizontalRightOverflowPath" Margin="0,3,0,3" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="{TemplateBinding Foreground}"  Height="3" HorizontalAlignment="Right" Stretch="Fill" Stroke="{TemplateBinding Foreground}" VerticalAlignment="Top"  Width="2.5"/>
                                    </Grid>
                                </ToggleButton>
                                <Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}" StaysOpen="False">
                                    <!--<Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw" Color="Transparent" >-->

                                        <Border BorderBrush="{DynamicResource  MetroBorderBrush}" BorderThickness="1" Background="{DynamicResource  MetroPanelBackgroundBrush}" MaxWidth="150" x:Name="PopupBorder">

                                            <StackPanel>
                                                <tools:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></tools:ToolBarOverflowPanel>
                                                <shared:DropDownButtonAdv x:Name="PART_AddRemoveButtons" Label="Add or remove buttons"  DropDirection="Right" Margin="2,-2,2,2" Style="{StaticResource DropDownButtonAdvStyle}" Visibility="{Binding Path=EnableAddRemoveButton, RelativeSource={RelativeSource AncestorType=shared:ToolBarAdv}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True" Style="{StaticResource DropDownMenuGroupStyle1}">
                                                        <shared:DropDownMenuGroup.ItemTemplate>
                                                            <DataTemplate>
                                                                <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                                    <shared:DropDownMenuItem.Icon>
                                                                        <Image Source="{Binding Icon}"/>
                                                                    </shared:DropDownMenuItem.Icon>
                                                                </shared:DropDownMenuItem>
                                                            </DataTemplate>
                                                        </shared:DropDownMenuGroup.ItemTemplate>
                                                    </shared:DropDownMenuGroup>
                                                </shared:DropDownButtonAdv>
                                            </StackPanel>
                                        </Border>
                                    <!--</Microsoft_Windows_Themes:SystemDropShadowChrome>-->

                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="HasDropShadow" SourceName="PART_OverflowPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5"/>
                            <Setter Property="Color" TargetName="Shdw" Value="#71000000"/>
                        </Trigger>-->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="sfshared:SkinStorage.EnableTouch" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True" SourceName="PART_OverflowButton"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource MetroHoverBrush}"/>
                        </MultiTrigger>

                        <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter TargetName="PopupBorder" Property="MaxWidth" Value="210"/>
                            <Setter Property="Width" Value="25" TargetName="PART_OverflowButton"/>
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Background" TargetName="mainborder" Value="{DynamicResource MetroBrush}"/>
                            
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>

                        </Trigger>
                        <Trigger Property="IsChecked" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Background" TargetName="mainborder" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="MinWidth" Value="45"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Height" Value="25" TargetName="PART_OverflowButton"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource VerticalTemplate}"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource ToolBarAdvStyle}" TargetType="shared:ToolBarAdv"/>
    <SolidColorBrush Color="#D8D8D9" x:Key="MetroThemeSeperatorBrush"/>
    <Style x:Key="toolBarItemSeparator" TargetType="tools:ToolBarItemSeparator">
        <Setter Property="Background" Value="{StaticResource MetroThemeSeperatorBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroThemeSeperatorBrush}" >
           
        </Setter>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tools:ToolBarItemSeparator">
                    <StackPanel Orientation="{TemplateBinding Orientation}">
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="{TemplateBinding Background}" />
                       
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource toolBarItemSeparator}" TargetType="tools:ToolBarItemSeparator"/>


</ResourceDictionary>