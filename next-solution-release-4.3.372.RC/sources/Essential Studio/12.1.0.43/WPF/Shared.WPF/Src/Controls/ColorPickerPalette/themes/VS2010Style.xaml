    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoderMouseOverBrushKey" Color="#FFE8C76D" />

    <LinearGradientBrush x:Key="ColorPickerPaletteAutoBoderSelectedBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCE4A0" Offset="0" />
        <GradientStop Color="#FFFFE8A6" Offset="0.021" />
