<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:vsm="clr-namespace:Syncfusion.Windows"
                    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ToolBarAdv Brushes -->

    <BooleanToVisibilityConverter x:Key="BoolConverter"/>
    <SolidColorBrush x:Key="DropDownButtonAdvBackground" Color="#7FFFFFFF"/>

    <SolidColorBrush x:Key="DropDownButtonAdvBorderBrush" Color="#7F000000"/>
    
    <SolidColorBrush x:Key="DropDownButtonAdvForeground" Color="#FF000000"/>

    <SolidColorBrush x:Key="ToolBarAdvForeground" Color="#FF000000"/>


    <LinearGradientBrush x:Key="ToolBarAdvBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FBEBEBE" Offset="1"/>
        <GradientStop Color="#99FFFFFF"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ToolBarAdvBorderBrush" Color="#7F000000"/>

    <SolidColorBrush x:Key="OverflowPopupBackground" Color="#E5FFFFFF"/>

    <SolidColorBrush x:Key="OverflowPopupBorderBrush" Color="#7F000000"/>        
    
    <SolidColorBrush x:Key="TrayIconBackground" Color="#FFFFFFFF" Opacity="0.195"/>

    <SolidColorBrush x:Key="ToolBarItemSeperatorBackground" Color="#FFFFFFFF" Opacity="0.5"/>

    <SolidColorBrush x:Key="ToolBarItemSeperatorBorderBrush" Color="#FFFFFFFF" Opacity="0.5"/>
   
    <LinearGradientBrush  x:Key="DropDownButtonAdvMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="DropDownButtonAdvInnerBorderBrush" Color="#CCFFFFFF"/>

    <SolidColorBrush x:Key="DropDownButtonAdvMouseOverBorderBrush" Color="#7F000000"/>  

    <LinearGradientBrush x:Key="MenuItemHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuItemHoverBorderBrush" Color="#7F000000"/>

    <LinearGradientBrush x:Key="MenuOverflowButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF"/>
        <GradientStop Color="#7EFFFFFF" Offset="0.032"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.649"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuOverflowButtonPressedBorderBrush" Color="#7F000000"/>

    <LinearGradientBrush x:Key="MenuOverflowButtonHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuOverflowButtonHoverBorderBrush" Color="#7F000000"/>

    <LinearGradientBrush x:Key="MenuOverflowButtonCheckedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#A5FFFFFF" Offset="0.008"/>
        <GradientStop Color="#CFFFFFFF" Offset="0.487"/>
        <GradientStop Color="#72C2C2C2" Offset="0.531"/>
        <GradientStop Color="#A7FFFFFF" Offset="0.788"/>
        <GradientStop Color="#B2FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuOverflowButtonCheckedBorderBrush" Color="#7F000000"/>

    <SolidColorBrush x:Key="MenuItemHoverInnerBorderBrush" Color="#CCFFFFFF"/>   

    <SolidColorBrush x:Key="IconTrayBorderBrush" Color="#FF000000" Opacity="0.40"/>


    <Style x:Key="DropDownMenuGroupStyle1" TargetType="{x:Type tools:DropDownMenuGroup}">
        <Setter Property="Background" Value="{StaticResource OverflowPopupBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OverflowPopupBorderBrush}"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tools:DropDownMenuGroup}">
                    <Grid x:Name="gri">
                        <Grid.Resources>
                            <tools:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                            <tools:TextToVisibilityConverter x:Key="TextConverter"/>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Background="{TemplateBinding Background}" Height="22" Margin="1,0,1,1" Grid.Row="0">
                            <Border.Visibility>
                                <Binding Path="Header" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <tools:TextToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <Grid>
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Background="Transparent"/>
                                <ContentControl Content="{TemplateBinding Header}" Foreground="Black" FontWeight="Bold" HorizontalContentAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>
                                <Border x:Name="IconTray" BorderBrush="{StaticResource IconTrayBorderBrush}" SnapsToDevicePixels="True"  BorderThickness="0,0,1,0" Background="{StaticResource TrayIconBackground}" HorizontalAlignment="Left" Margin="1" Width="44">
                                    <Border.Visibility>
                                        <Binding Path="IconBarEnabled" RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>

                                </Border>
                                <Border>
                                    <ScrollViewer KeyboardNavigation.DirectionalNavigation="Cycle" Padding="0" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                                        <ScrollViewer.BorderThickness>
                                            <Binding Path="ScrollBarVisibility" RelativeSource="{RelativeSource TemplatedParent}">
                                                <Binding.Converter>
                                                    <tools:VisibilityToThicknessConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </ScrollViewer.BorderThickness>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border BorderBrush="White" BorderThickness="0,0,2,0" Background="Transparent" HorizontalAlignment="Left" Width="22">
                                    <Border.Visibility>
                                        <Binding Path="IsMoreItemsIconTrayEnabled" RelativeSource="{RelativeSource TemplatedParent}">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                </Border>
                                <ItemsControl/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Background="Transparent" HorizontalAlignment="Stretch" Margin="1,0" Grid.Row="3" Width="{Binding ActualWidth, ElementName=PART_ResizeThumb}">
                            <Border.Visibility>
                                <Binding Path="IsResizable" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <Grid>
                                <Border BorderBrush="White" BorderThickness="0,1,0,0">
                                    <Border HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Width="3"/>
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Margin="3,0,0,0" SnapsToDevicePixels="True" Width="3"/>
                                            <Border Background="#FF959595" CornerRadius="2" Height="3" Margin="3,0,0,0" SnapsToDevicePixels="True" Width="3"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Cursor="SizeNS" Opacity="0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DropDownButtonAdvStyle" TargetType="{x:Type shared:DropDownButtonAdv}">
        <Setter Property="Foreground" Value="{StaticResource DropDownButtonAdvForeground}"/>
        <Setter Property="Label" Value="Drop Down Button"/>
        <Setter Property="Background" Value="{StaticResource DropDownButtonAdvBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DropDownButtonAdvBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:DropDownButtonAdv}">
                    <Grid>
                        <Grid.Resources>
                            <shared:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonButtonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{StaticResource DropDownButtonAdvMouseOverBackground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{StaticResource DropDownButtonAdvMouseOverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed"/>
                                <vsm:VisualState x:Name="UnChecked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemCheckedBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".5"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="ItemBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" MinHeight="22">
                            <Grid>
                                <Border x:Name="border"  BorderThickness="1" Background="Transparent" BorderBrush="Transparent">
                                    <Border x:Name="InnerBorder" BorderThickness="1" BorderBrush="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="2" x:Name="PART_Text" Grid.Column="1" Foreground="{TemplateBinding Foreground}" 
                                                   FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" 
                                                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                                                   Text="{TemplateBinding Label}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                                        <Path Grid.Column="2" Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z " Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" Height="4" Margin="3" Stretch="Uniform" VerticalAlignment="Center" Width="8"/>
                                    </Grid>
                                </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom"  AllowsTransparency="True">
                            <Border SnapsToDevicePixels="True" Margin="0,0,20,20">
                                <Border.Effect>
                                    <DropShadowEffect Color="#71000000" Opacity="0.25" ShadowDepth="5" Direction="325"/>
                                </Border.Effect>
                                <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                    <Border Background="{StaticResource OverflowPopupBackground}" BorderThickness="1" BorderBrush="{StaticResource OverflowPopupBorderBrush}" CornerRadius="0">
                                    <Border BorderThickness="1" BorderBrush="Transparent"  CornerRadius="1">
                                        <ContentPresenter/>
                                    </Border>
                                </Border>                                                                   
                                 </Grid>
                            </Border>    
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource DropDownButtonAdvMouseOverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource DropDownButtonAdvInnerBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource DropDownButtonAdvMouseOverBorderBrush}"/>                     
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="shared:DropDownMenuItem" x:Key="MenuItemStyle">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:DropDownMenuItem">
                    <Grid Margin="2">
                        <Grid.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonMenuItemStates">
                                <vsm:VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>             
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border CornerRadius="0" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <Border x:Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                                <Grid Margin="0,0,0,-2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Grid.Column="2" Margin="6 2 2 2"/>
                                <ContentControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="3" Margin="3" FontSize="14"/>
                                <Border Margin="2" CornerRadius="2" Grid.Column="1">
                                    <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                                </Border>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" CornerRadius="0" Background="Transparent"  BorderBrush="Transparent"  BorderThickness="0">
                                    <Path x:Name="CheckIcon" Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="Black" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                </Border>
                            </Grid>
                            </Border>
                        </Border>

                        <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown" AllowsTransparency="True">
                            <Border SnapsToDevicePixels="True" Margin="0,0,20,20">
                                <Border.Effect>
                                    <DropShadowEffect Color="#71000000"  Opacity="0.25" ShadowDepth="5" Direction="325"/>
                                </Border.Effect>
                                <Grid x:Name="PART_poup">
                                <Border Background="{StaticResource OverflowPopupBackground}" BorderThickness="1" BorderBrush="{StaticResource OverflowPopupBorderBrush}">
                                    <ItemsPresenter />
                                </Border>
                            </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource MenuItemHoverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource MenuItemHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerBorder" Value="{StaticResource MenuItemHoverInnerBorderBrush}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="OverflowButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolBarAdvBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource ToolBarAdvForeground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,3,3,0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="#ADADAD"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>                     
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="OverflowButtonStyle1" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="#ADADAD"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}" x:Key="VerticalTemplate">
        <Border x:Name="mainborder" Background="{StaticResource ToolBarAdvBackground}" CornerRadius="3" BorderThickness="0.5" BorderBrush="{TemplateBinding BorderBrush}">
            <vsm:VisualStateManager.VisualStateGroups>
                <vsm:VisualStateGroup x:Name="Orientation">
                </vsm:VisualStateGroup>
            </vsm:VisualStateManager.VisualStateGroups>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="row0" Height="*"></RowDefinition>
                    <RowDefinition x:Name="row1" Height="12"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.5" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8" />
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="2 3 4 2" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                            <Path x:Name="verticalGripper" Data="M12.5,0.5 L13.5,0.5 L13.5,1.5 L12.5,1.5 z M8.5,0.5 L9.5,0.5 L9.5,1.5 L8.5,1.5 z M4.5,0.5 L5.5,0.5 L5.5,1.5 L4.5,1.5 z M0.5,0.5 L1.5,0.5 L1.5,1.5 L0.5,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="2" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="14"/>
                        </Grid>
                        <shared:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Row="1"></shared:ToolBarPanelAdv>
                    </Grid>
                </Border>
                <ToggleButton x:Name="PART_OverflowButton"   Grid.Row="1" Style="{StaticResource OverflowButtonStyle1}">
                    <Grid>
                        <Grid x:Name="verticalPath">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="verticalDownPath" Data="M0.5,20.5 L0.5,0.5 L13.499992,10.582473 z" Grid.Column="2" Fill="#FF000000" HorizontalAlignment="Left" Margin="0,0,4,0" Height="6" Stretch="Fill" Stroke="#FF000000" Width="4"/>
                            <Path x:Name="verticalDownPath1" Data="M0.5,0.5 L0.5,20" Fill="#FF000000" Grid.Column="1" HorizontalAlignment="Right" Height="6" Margin="0,0,2,0" Stretch="Fill" Stroke="#FF000000" Width="1"/>
                            <Path x:Name="verticalTopOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="#FF000000" Margin="3,0,3,2" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="#FF000000" VerticalAlignment="Top" Width="3"/>
                            <Path x:Name="verticalBottomOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="#FF000000" Margin="3,2,3,2" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="#FF000000" VerticalAlignment="Bottom" Width="3"/>
                        </Grid>
                    </Grid>
                </ToggleButton>
                <Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}" StaysOpen="False" AllowsTransparency="True">
                    <Border SnapsToDevicePixels="True" Margin="0,0,20,20">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.25" ShadowDepth="5" Direction="325"/>
                        </Border.Effect>
                        <Border BorderBrush="{StaticResource OverflowPopupBorderBrush}" BorderThickness="1" Background="{StaticResource OverflowPopupBackground}" MaxWidth="150">
                        <StackPanel>
                            <tools:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></tools:ToolBarOverflowPanel>
                            <shared:DropDownButtonAdv x:Name="PART_AddRemoveButtons" Label="Add or remove buttons"  DropDirection="Right" Margin="2" Style="{StaticResource DropDownButtonAdvStyle}" Visibility="{Binding Path=EnableAddRemoveButton, RelativeSource={RelativeSource AncestorType=shared:ToolBarAdv}, Converter={StaticResource BoolConverter}}">
                                <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True" Style="{StaticResource DropDownMenuGroupStyle1}">
                                    <shared:DropDownMenuGroup.ItemTemplate>
                                        <DataTemplate>
                                            <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                <shared:DropDownMenuItem.Icon>
                                                    <Image Source="{Binding Icon}"/>
                                                </shared:DropDownMenuItem.Icon>
                                            </shared:DropDownMenuItem>
                                        </DataTemplate>
                                    </shared:DropDownMenuGroup.ItemTemplate>
                                </shared:DropDownMenuGroup>
                            </shared:DropDownButtonAdv>
                        </StackPanel>
                    </Border>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True" SourceName="PART_OverflowButton">
                <Setter Property="Background" TargetName="mainborder" Value="{StaticResource MenuOverflowButtonHoverBackground}"/>
                <Setter Property="BorderBrush" TargetName="mainborder" Value="{StaticResource MenuOverflowButtonHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True" SourceName="PART_OverflowButton">
                <Setter Property="Stroke" TargetName="verticalDownPath1" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalDownPath1" Value="Black"/>
                <Setter Property="Stroke" TargetName="verticalDownPath" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalDownPath" Value="Black"/>
                <Setter Property="Stroke" TargetName="verticalTopOverflowPath" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalTopOverflowPath" Value="Black"/>
                <Setter Property="Stroke" TargetName="verticalBottomOverflowPath" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalBottomOverflowPath" Value="Black"/>
                <Setter Property="Background" TargetName="mainborder" Value="{StaticResource MenuOverflowButtonPressedBackground}"/>
                <Setter Property="BorderBrush" TargetName="mainborder" Value="{StaticResource MenuOverflowButtonPressedBorderBrush}"/>             
            </Trigger>
            <Trigger Property="IsChecked" Value="True" SourceName="PART_OverflowButton">
                <Setter Property="Stroke" TargetName="verticalDownPath1" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalDownPath1" Value="Black"/>
                <Setter Property="Stroke" TargetName="verticalDownPath" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalDownPath" Value="Black"/>
                <Setter Property="Stroke" TargetName="verticalTopOverflowPath" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalTopOverflowPath" Value="Black"/>
                <Setter Property="Stroke" TargetName="verticalBottomOverflowPath" Value="Black"/>
                <Setter Property="Fill" TargetName="verticalBottomOverflowPath" Value="Black"/>
                <Setter Property="Background" TargetName="mainborder" Value="{StaticResource MenuOverflowButtonCheckedBackground}"/>
                <Setter Property="BorderBrush" TargetName="mainborder" Value="{StaticResource MenuOverflowButtonCheckedBorderBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ToolBarAdvStyle" TargetType="{x:Type shared:ToolBarAdv}">
        <Setter Property="Background" Value="{StaticResource ToolBarAdvBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolBarAdvBorderBrush}"/>
        <!--<Setter Property="ControlsResourceDictionary">
            <Setter.Value>
                <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/Controls/ToolBarAdv/Themes/Transparent/TransparentResources.xaml"/>
            </Setter.Value>
        </Setter>-->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}">
                    <Border x:Name="mainborder" Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="0.5" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="Orientation">
                                    <vsm:VisualState x:Name="Horizontal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Vertical">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="col0" Width="*"></ColumnDefinition>
                                    <ColumnDefinition x:Name="col1" Width="12"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="row0"  Height="*"></RowDefinition>
                                    <RowDefinition x:Name="row1" Height="Auto"></RowDefinition>
                                    <RowDefinition x:Name="row2" Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.5" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition  Width="*"/>
                                        </Grid.ColumnDefinitions>                                        
                                        <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="4 2 2 0" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path x:Name="horizontalGripper" SnapsToDevicePixels="True"  Data="M0.5,12.5 L1.5000002,12.5 L1.5000002,13.5 L0.5,13.5 z M0.50000137,8.5 L1.5000012,8.5 L1.5000012,9.5 L0.50000137,9.5 z M0.50000137,4.5 L1.5000012,4.5 L1.5000012,5.5 L0.50000137,5.5 z M0.50000137,0.5 L1.5000014,0.5 L1.5000014,1.5 L0.50000137,1.5 z" Fill="#FF000000" HorizontalAlignment="Center" Height="14" Stretch="Fill" Stroke="#FF000000" VerticalAlignment="Center" Width="2"/>
                                        </Grid>
                                        <tools:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Column="1"></tools:ToolBarPanelAdv>
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="PART_OverflowButton"   Grid.Column="2" Style="{StaticResource OverflowButtonStyle}">              
                                    <Grid x:Name="horizontalPath" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Path x:Name="horizontalDownPath1" Data="M0,-2 L6,-2" Stroke="#FF000000" VerticalAlignment="Bottom" Margin="0,0,0,2" Grid.Row="1" Stretch="Uniform" Height="1" StrokeThickness="1" Width="6"/>
                                        <Path x:Name="horizontalDownPath" Data="M0.5,3 L5.5,3 L3,6 z" Fill="#FF000000" Stretch="Fill" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,4" Stroke="#FF000000" Width="6" Height="4" />
                                        <Path x:Name="horizontalLeftOverflowPath" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="#FF000000" Margin="0,3,1,3" HorizontalAlignment="Left" Height="3" Stretch="Fill" Stroke="#FF000000" VerticalAlignment="Center" Width="2.5"/>
                                        <Path x:Name="horizontalRightOverflowPath" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="#FF000000" Margin="0,3,0,3" Height="3" HorizontalAlignment="Right" Stretch="Fill" Stroke="#FF000000" VerticalAlignment="Center" Width="2.5"/>
                                    </Grid>
                                </ToggleButton>
                                <Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}" StaysOpen="False" AllowsTransparency="True">
                                    <Border SnapsToDevicePixels="True" Margin="0,0,20,20">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.25" ShadowDepth="5" Direction="325"/>
                                        </Border.Effect>
                                        <Border BorderBrush="{StaticResource OverflowPopupBorderBrush}" BorderThickness="1" Background="{StaticResource OverflowPopupBackground}" MaxWidth="150">
                                        <StackPanel>
                                            <tools:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></tools:ToolBarOverflowPanel>
                                            <shared:DropDownButtonAdv x:Name="PART_AddRemoveButtons" Label="Add or remove buttons"  DropDirection="Right" Margin="1,0,1,1" Style="{StaticResource DropDownButtonAdvStyle}" Visibility="{Binding Path=EnableAddRemoveButton, RelativeSource={RelativeSource AncestorType=shared:ToolBarAdv}, Converter={StaticResource BoolConverter}}">
                                                <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True" Style="{StaticResource DropDownMenuGroupStyle1}">
                                                    <shared:DropDownMenuGroup.ItemTemplate>
                                                        <DataTemplate>
                                                            <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource MenuItemStyle}">
                                                                <shared:DropDownMenuItem.Icon>
                                                                    <Image Source="{Binding Icon}"/>
                                                                </shared:DropDownMenuItem.Icon>
                                                            </shared:DropDownMenuItem>
                                                        </DataTemplate>
                                                    </shared:DropDownMenuGroup.ItemTemplate>
                                                </shared:DropDownMenuGroup>
                                            </shared:DropDownButtonAdv>
                                        </StackPanel>
                                    </Border>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Background" TargetName="PART_OverflowButton" Value="{StaticResource MenuOverflowButtonHoverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="PART_OverflowButton" Value="{StaticResource MenuOverflowButtonHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Stroke" TargetName="horizontalDownPath1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Background" TargetName="PART_OverflowButton" Value="{StaticResource MenuOverflowButtonPressedBackground}"/>
                            <Setter Property="BorderBrush" TargetName="PART_OverflowButton" Value="{StaticResource MenuOverflowButtonPressedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Stroke" TargetName="horizontalDownPath1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Background" TargetName="PART_OverflowButton" Value="{StaticResource MenuOverflowButtonCheckedBackground}"/>
                            <Setter Property="BorderBrush" TargetName="PART_OverflowButton" Value="{StaticResource MenuOverflowButtonCheckedBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource VerticalTemplate}"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource ToolBarAdvStyle}" TargetType="shared:ToolBarAdv"/>

    <Style x:Key="toolBarItemSeparator" TargetType="tools:ToolBarItemSeparator">
        <Setter Property="Background" Value="{StaticResource ToolBarItemSeperatorBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolBarItemSeperatorBorderBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tools:ToolBarItemSeparator">
                    <StackPanel Orientation="{TemplateBinding Orientation}">
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="{TemplateBinding Background}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource toolBarItemSeparator}" TargetType="tools:ToolBarItemSeparator"/>

</ResourceDictionary>