    <Style x:Key="BlendClockStyle" TargetType="{x:Type local:Clock}">
        <Setter Property="local:Clock.ClockPointBrush" Value="{StaticResource Blend.ClockPointColor}" />
        <Setter Property="local:Clock.CenterCircleBrush" Value="{StaticResource Blend.CenteredEllipseColor}" />
        <Setter Property="local:Clock.BorderBrush" Value="{StaticResource Blend.FirstBorderFrameColor}" />
