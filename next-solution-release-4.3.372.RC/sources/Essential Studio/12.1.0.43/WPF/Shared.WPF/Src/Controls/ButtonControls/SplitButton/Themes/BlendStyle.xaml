<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <SolidColorBrush x:Key="PopupBackground" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="PopupBorder" Color="#FF595959"/>
    <SolidColorBrush x:Key="SplitButtonAdvBackgroundBrush" Color="#FF595959"/>
    <SolidColorBrush x:Key="SplitButtonAdvBorderBrush" Color="#FF424242"/>
    <SolidColorBrush x:Key="SplitButtonAdvForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SplitButtonAdvHoverForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SplitButtonAdvContentForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SplitButtonAdvHoverBackgroundBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="SplitButtonAdvDropDownHoverBackgroundBrush" Color="#FF707070"/>
    <SolidColorBrush x:Key="SplitButtonAdvHoverBorderBrush" Color="#FFDBCCA5"/>
    <SolidColorBrush x:Key="SplitButtonAdvHoverInnerBorderBrush" Color=" #FFFFFCF0 "/>

    <LinearGradientBrush x:Key="SplitButtonAdvPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFBEC" Offset="0.194"/>
        <GradientStop Color="#FFFFF7DF" Offset="0.397"/>
        <GradientStop Color="#FFFFEEBE" Offset="0.399"/>
        <GradientStop Color="#FFFFF6DD" Offset="0.951"/>
        <GradientStop Color="#FFFFFDED" Offset="0.954"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SplitButtonAdvDropDownPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFBDBB5" Offset="0.045"/>
        <GradientStop Color="#FFFEC778" Offset="0.252"/>
        <GradientStop Color="#FFFEB456" Offset="0.267"/>
        <GradientStop Color="#FFFDC66E" Offset="0.585"/>
        <GradientStop Color="#FFFDE699" Offset="0.807"/>
        <GradientStop Color="#FFFDEA98" Offset="0.955"/>
        <GradientStop Color="#FFFFE47F" Offset="0.97"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvPressedBackgroundBrush" Color="#FF424242"/>
    <SolidColorBrush x:Key="ButtonAdvPressedBorderBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="SplitButtonAdvPressedBorderBrush" Color="#FFCBB499"/>

    <Style x:Key="ButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="White" StrokeThickness="1" StrokeDashArray="1 2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="BlendSplitButtonAdvStyle" TargetType="local:SplitButtonAdv">
    <Setter Property="Foreground" Value="{StaticResource SplitButtonAdvContentForeground}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
    <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
    <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Label" Value="Split Button"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource SplitButtonAdvBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SplitButtonAdvBorderBrush}"/>
     <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="local:SplitButtonAdv">
                <Grid>
                    <Grid.Resources>
                        <local:MultiLineConverter x:Key="TextConverter"/>
                    </Grid.Resources>
                    <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                            <Border BorderThickness="1" Background="{StaticResource PopupBackground}" BorderBrush="{StaticResource PopupBorder}" CornerRadius="1" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="3"/>
                            </Border>
                        </Grid>
                    </Popup>
                    <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder" CornerRadius="2" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PART_ButtonNormal" Background="Transparent"  Grid.Column="0">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Name="PART_ImageBorder" Grid.Column="0">
                                        <Image Margin="2"
						            Width="16" Height="16"   x:Name="SmallImage"
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{StaticResource SplitButtonAdvForeground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           Margin="2,0,4,0"/>
                                </Grid>
                            </Border>
                            <Border x:Name="PART_DropDownButtonNormal" Grid.Column="1" BorderThickness="1,0,0,0" Background="Transparent">
                                <!--<Path HorizontalAlignment="Center" Name="Arrow" VerticalAlignment="Center" Fill="{StaticResource SplitButtonAdvForeground}" Data="M 0 0 L 4 4 L 8 0 Z" Margin="2,1,2,1"/>-->
                                <Path Name="Arrow" StrokeThickness="2"                                 
                                  Stroke="White" Margin="2,1,2,1"
                                  Data="M 1,1.5 L 4.5,5 L 8,1.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            </Border>

                        </Grid>
                    </Border>
                    <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" CornerRadius="3" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition  Height="*"/>
                                    <RowDefinition  Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="PART_Button" Background="Transparent" >
                                <Border Name="PART_ImageBorderLarge">
                                    <Image Margin="2" x:Name="LargeImage"
                                    Width="26" Height="26" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}" 
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                            </Border>
                            <Border Grid.Row="1" x:Name="PART_DropDownButton" BorderThickness="0,1,0,0" Background="Transparent">
                                <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="1" x:Name="InnerDropBorder1">
                                    <ItemsControl x:Name="PART_TextAreaLarge"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               Margin="2,0,4,0">
                                    </ItemsControl>
                                </Border>
                            </Border>
                                </Grid>
                        </Border>

                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                        <!--<Setter Property="Path.Margin" TargetName="Arrow" Value="8,3,10,1"/>-->
                            <Setter Property="Path.Margin" TargetName="Arrow" Value="10,3,6,1"/>
                            <Setter Property="Path.Data" TargetName="Arrow" Value="M 0 0 L 7 7 L 14 0 Z"/>
                            <Setter Property="StrokeThickness" TargetName="Arrow" Value="0"/>
                            <Setter Property="Fill" TargetName="Arrow" Value="White"/>
                            <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Height" TargetName="SmallImage" Value="20"/>
                        <Setter Property="Width" TargetName="SmallImage" Value="20"/>
                        <Setter TargetName="PART_DropDownButtonNormal" Property="CornerRadius" Value="0,6,6,0"/>

                        <Setter Property="CornerRadius"  TargetName="ItemBorder" Value="6"/>
                        <Setter Property="CornerRadius" TargetName="ItemBorder1" Value="6"/>



                        <Setter Property="Margin" TargetName="SmallImage" Value="0,2,2,2"/>

                        <Setter Property="Height" TargetName="LargeImage" Value="30"/>
                        <Setter Property="Width" TargetName="LargeImage" Value="30"/>
                        <Setter Property="Border.Effect" TargetName="ItemBorder">
                            <Setter.Value>
                                <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Border.Effect" TargetName="ItemBorder1">
                            <Setter.Value>
                                <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" TargetName="PART_Text" Value="5,0,0,0"/>

                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            <Condition Property="IsMouseOver" SourceName="PART_DropDownButtonNormal" Value="true"/>

                        </MultiTrigger.Conditions>
                        <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource SplitButtonAdvHoverBackgroundBrush}"/>
                        <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource SplitButtonAdvDropDownHoverBackgroundBrush}"/>
                        <Setter Property="Path.Stroke" TargetName="Arrow" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                        <Setter Property="Foreground" TargetName="PART_Text" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            <Condition Property="IsMouseOver" SourceName="PART_DropDownButtonNormal" Value="true"/>

                        </MultiTrigger.Conditions>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            <Condition Property="IsMouseOver" SourceName="PART_ButtonNormal" Value="true"/>

                        </MultiTrigger.Conditions>
                        <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource SplitButtonAdvDropDownHoverBackgroundBrush}"/>
                        <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource SplitButtonAdvHoverBackgroundBrush}"/>
                        <Setter Property="Path.Stroke" TargetName="Arrow" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                        <Setter Property="Foreground" TargetName="PART_Text" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            <Condition Property="IsMouseOver" SourceName="PART_ButtonNormal" Value="true"/>

                        </MultiTrigger.Conditions>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            <Condition Property="IsMouseOver" SourceName="PART_DropDownButton" Value="true"/>

                        </MultiTrigger.Conditions>
                        <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource SplitButtonAdvHoverBackgroundBrush}"/>
                        <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource SplitButtonAdvDropDownHoverBackgroundBrush}"/>
                        <Setter Property="Path.Stroke" TargetName="Arrow" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                        <Setter Property="Foreground" TargetName="PART_Text" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            <Condition Property="IsMouseOver" SourceName="PART_DropDownButton" Value="true"/>

                        </MultiTrigger.Conditions>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            <Condition Property="IsMouseOver" SourceName="PART_Button" Value="true"/>

                        </MultiTrigger.Conditions>
                        <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource SplitButtonAdvDropDownHoverBackgroundBrush}"/>
                        <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource SplitButtonAdvHoverBackgroundBrush}"/>
                        <Setter Property="Path.Stroke" TargetName="Arrow" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                        <Setter Property="Foreground" TargetName="PART_Text" Value="{StaticResource SplitButtonAdvHoverForeground}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            <Condition Property="IsMouseOver" SourceName="PART_Button" Value="true"/>

                        </MultiTrigger.Conditions>
                    </MultiTrigger>
                    <Trigger Property="IsDropDownPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                        </Trigger>
                        <!--<Trigger Property="IsChecked" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                        </Trigger>-->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                        <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendSplitButtonAdvStyle}" TargetType="local:SplitButtonAdv"/>

</ResourceDictionary>