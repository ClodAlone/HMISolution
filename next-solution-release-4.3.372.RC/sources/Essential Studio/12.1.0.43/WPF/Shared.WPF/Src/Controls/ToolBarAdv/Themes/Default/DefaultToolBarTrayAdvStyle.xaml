<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls">
    <SolidColorBrush x:Key="TrayBackColor" Color="#FFF4F7FC"/>

    <Style x:Key="ToolBarTrayAdvStyle" TargetType="tools:ToolBarTrayAdv">
        <Setter Property="Background" Value="{StaticResource TrayBackColor}"/>
    </Style>

    <Style BasedOn="{StaticResource ToolBarTrayAdvStyle}" TargetType="tools:ToolBarTrayAdv"/>
</ResourceDictionary>