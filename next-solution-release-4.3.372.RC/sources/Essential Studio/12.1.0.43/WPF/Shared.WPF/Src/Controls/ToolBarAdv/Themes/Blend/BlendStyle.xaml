<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:vsm="clr-namespace:Syncfusion.Windows" xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared"
                    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <LinearGradientBrush x:Key="CloseButton_NormalBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF4CAC2" Offset="0"/>
        <GradientStop Color="#FFCC7D6D" Offset="0.5"/>
        <GradientStop Color="#FFB94630" Offset="0.5"/>
        <GradientStop Color="#FFF4B19C" Offset="1"/>
        <GradientStop Color="#FFBE7360" Offset="0.85"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBackground" Color="#FF3A3A3A" />

    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FF979797" />

    <SolidColorBrush x:Key="DropDownMouseOverBrush" Color="#FF707070" />
  
    <SolidColorBrush x:Key="DropDownMouseOverBorderBrush" Color="#FF5C5C5C" />
   
   <SolidColorBrush x:Key="MouseOverBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="MouseOverBackground" Color="#FF707070"/>

    <SolidColorBrush x:Key="PressedBackground" Color="#FFAAAAAA"/>

    <SolidColorBrush x:Key="PressedBorderBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="CheckedBackground" Color="#FF707070"/>

    <SolidColorBrush x:Key="CheckedBorderBrush" Color="Transparent"/>

   
    <SolidColorBrush x:Key="ToolBarBackground" Color="#FF595959"/>

    <SolidColorBrush x:Key="ToolBarBorderBrush" Color="#FF444444"/>
    

    <SolidColorBrush x:Key="OverflowPopupBackground" Color="#FF3A3A3A"/>

    <SolidColorBrush x:Key="OverflowPopupBorderBrush" Color="#FF595959"/>
    
    <SolidColorBrush x:Key="Foreground" Color="White"/>

    <SolidColorBrush x:Key="DropDownButtonAdvBackground" Color="#FF595959"/>

    <SolidColorBrush x:Key="DropDownButtonAdvBorderBrush" Color="#FFBABFC4"/>

    <SolidColorBrush x:Key="MenuBackground" Color="#FF3A3A3A" />

    <SolidColorBrush x:Key="BorderBrush" Color="#FF5C5C5C" />

    <LinearGradientBrush x:Key="MenuItemPressedFill" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#28717070" Offset="0"/>
        <GradientStop Color="#50717070" Offset="0.75"/>
        <GradientStop Color="#90717070" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SubMenuBackgroundBrush" Color="#FF333333"/>

    <SolidColorBrush x:Key="ToolBarItemSeperatorBackground" Color="#FF3A3A3A"/>

    <SolidColorBrush x:Key="BlendOverFlowButtonBackgroundBrush" Color="#FF444444"/>
    <SolidColorBrush Color="#FF707070" x:Key="BlendMouseOverBackground"/>
    <SolidColorBrush Color="#FFAAAAAA" x:Key="BlendPressedBackground"/>

    <SolidColorBrush Color="#FFAAAAAA" x:Key="BlendMenuItemHoverBackground"/>


    <Style x:Key="DropDownButtonAdvStyle" TargetType="{x:Type shared:DropDownButtonAdv}">
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="Label" Value="Drop Down Button"/>
        <Setter Property="Background" Value="{StaticResource DropDownButtonAdvBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DropDownButtonAdvBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:DropDownButtonAdv}">
                    <Grid>
                        <Grid.Resources>
                            <shared:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonButtonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                         <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{StaticResource MouseOverBackground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{StaticResource MouseOverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed"/>
                                <vsm:VisualState x:Name="UnChecked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemCheckedBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ItemBorder">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".5"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="ItemBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" MinHeight="22">
                            <Grid>
                                <Border x:Name="border"  BorderThickness="1" Background="Transparent" BorderBrush="Transparent"/>
                                <Border x:Name="InnerBorder" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="2" x:Name="PART_Text" Grid.Column="1" Foreground="{TemplateBinding Foreground}" 
                                                   FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" 
                                                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                                                   Text="{TemplateBinding Label}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                                        <Path Grid.Column="2" Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z " Fill="{StaticResource Foreground}" HorizontalAlignment="Center" Height="4" Margin="3" Stretch="Uniform" VerticalAlignment="Center" Width="8"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                <Border Background="#FF3A3A3A" BorderThickness="1" BorderBrush="{StaticResource OverflowPopupBorderBrush}" CornerRadius="0">
                                    <Border BorderThickness="0"  CornerRadius="1">
                                        <ContentPresenter/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource MouseOverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource MouseOverBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="shared:DropDownMenuItem" x:Key="MenuItemStyle">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:DropDownMenuItem">
                    <Grid Margin="2">
                        <Grid.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonMenuItemStates">
                                <vsm:VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="{StaticResource BlendMenuItemHoverBackground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0"	Value="#FF333333" />
                                        </ObjectAnimationUsingKeyFrames>-->

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border CornerRadius="0" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <Grid Margin="0,0,0,-2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <ContentControl Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Grid.Column="2" Margin="6 2 2 2"/>
                                <ContentControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="3" Margin="3" FontSize="14"/>
                                <Border Margin="2" CornerRadius="2" Grid.Column="1">
                                    <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                                </Border>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" CornerRadius="0" Background="Transparent"  BorderBrush="Transparent"  BorderThickness="0">
                                    <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="White" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                            <Grid Opacity="0" x:Name="PART_poup">
                                <Border Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <ItemsPresenter />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource BlendMenuItemHoverBackground}"/>
                            <Setter Property="Fill" TargetName="CheckIcon" Value="#FF333333"/>
                            <Setter Property="Foreground"  Value="#FF333333"/>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="OverflowButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource BlendMouseOverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource MouseOverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource BlendPressedBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource PressedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource BlendPressedBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource CheckedBorderBrush}"/>
                        </Trigger>-->
                        <Trigger Property="IsEnabled" Value="false">
                            <!--<Setter Property="Foreground" Value="#ADADAD"/>-->
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>                      
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="OverflowButtonStyle1" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--<Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource BlendMouseOverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource MouseOverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource BlendPressedBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource PressedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" TargetName="Chrome" Value="{StaticResource BlendPressedBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Chrome" Value="{StaticResource CheckedBorderBrush}"/>
                        </Trigger>-->
                        <Trigger Property="IsEnabled" Value="false">
                            <!--<Setter Property="Foreground" Value="#ADADAD"/>-->
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}" x:Key="VerticalTemplate">
        <Border x:Name="mainborder" Background="{StaticResource BlendOverFlowButtonBackgroundBrush}" CornerRadius="3" BorderThickness="0" >
            <vsm:VisualStateManager.VisualStateGroups>
                <vsm:VisualStateGroup x:Name="Orientation">
               </vsm:VisualStateGroup>
            </vsm:VisualStateManager.VisualStateGroups>
            <Grid>              
                <Grid.RowDefinitions>
                   
                    <RowDefinition x:Name="row0" Height="*"></RowDefinition>
                    <RowDefinition x:Name="row1" Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8" />
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="2 3 4 2" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                    <Path x:Name="verticalGripper" Data="M12.5,0.5 L13.5,0.5 L13.5,1.5 L12.5,1.5 z M8.5,0.5 L9.5,0.5 L9.5,1.5 L8.5,1.5 z M4.5,0.5 L5.5,0.5 L5.5,1.5 L4.5,1.5 z M0.5,0.5 L1.5,0.5 L1.5,1.5 L0.5,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="2" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="14"/>
                </Grid>
                <shared:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Row="1"></shared:ToolBarPanelAdv>
                    </Grid>
                </Border>
                <ToggleButton x:Name="PART_OverflowButton" Height="12"   Grid.Row="1" Style="{StaticResource OverflowButtonStyle1}">
                    <Grid>
                        <Grid x:Name="verticalPath">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="verticalDownPath" Data="M0.5,20.5 L0.5,0.5 L13.499992,10.582473 z" Grid.Column="2" Fill="#FFAAAAAA" HorizontalAlignment="Left" Margin="0,0,4,0" Height="6" Stretch="Fill" Stroke="#FFAAAAAA" Width="4"/>
                            <Path x:Name="verticalDownPath1" Data="M0.5,0.5 L0.5,20" Fill="#FFAAAAAA" Grid.Column="1" HorizontalAlignment="Right" Height="6" Margin="0,0,2,0" Stretch="Fill" Stroke="#FFAAAAAA" Width="1"/>
                            <Path x:Name="verticalTopOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="#FFAAAAAA" Margin="3,0,3,2" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="#FFAAAAAA" VerticalAlignment="Top" Width="3"/>
                            <Path x:Name="verticalBottomOverflowPath" Visibility="Collapsed" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="#FFAAAAAA" Margin="3,2,3,2" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="#FFAAAAAA" VerticalAlignment="Bottom" Width="3"/>
                        </Grid>
                    </Grid>
                </ToggleButton>
				<Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}" StaysOpen="False">
                    <Border BorderBrush="{StaticResource OverflowPopupBorderBrush}" BorderThickness="1" Background="{StaticResource OverflowPopupBackground}" MaxWidth="150">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3" BlurRadius="7" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <tools:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></tools:ToolBarOverflowPanel>
                            <shared:DropDownButtonAdv x:Name="PART_AddRemoveButtons" Label="Add or remove buttons"  DropDirection="Right" Margin="2" Style="{StaticResource DropDownButtonAdvStyle}" Visibility="{Binding Path=EnableAddRemoveButton, RelativeSource={RelativeSource AncestorType=shared:ToolBarAdv}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True">
                                    <shared:DropDownMenuGroup.ItemTemplate>
                                        <DataTemplate>
                                            <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                <shared:DropDownMenuItem.Icon>
                                                    <Image Source="{Binding Icon}"/>
                                                </shared:DropDownMenuItem.Icon>
                                            </shared:DropDownMenuItem>
                                        </DataTemplate>
                                    </shared:DropDownMenuGroup.ItemTemplate>
                                </shared:DropDownMenuGroup>
                            </shared:DropDownButtonAdv>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
  <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource MouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Stroke" TargetName="verticalDownPath1" Value="Black"/>
<Setter Property="Fill" TargetName="verticalDownPath1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="verticalDownPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="verticalDownPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="verticalTopOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="verticalTopOverflowPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="verticalBottomOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="verticalBottomOverflowPath" Value="Black"/>
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Stroke" TargetName="verticalDownPath1" Value="Black"/>
<Setter Property="Fill" TargetName="verticalDownPath1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="verticalDownPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="verticalDownPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="verticalTopOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="verticalTopOverflowPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="verticalBottomOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="verticalBottomOverflowPath" Value="Black"/>
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource CheckedBackground}"/>
                        </Trigger>
                        <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="MinWidth" Value="45"/>                          
                            <Setter Property="FontSize" Value="18"/>                      
                            <Setter Property="Height" Value="25" TargetName="PART_OverflowButton"/>
                        </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ToolBarAdvStyle" TargetType="{x:Type shared:ToolBarAdv}">
        <Setter Property="Background" Value="{StaticResource ToolBarBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BlendOverFlowButtonBackgroundBrush}"/>
        <!--<Setter Property="ControlsResourceDictionary">
            <Setter.Value>
                <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/Controls/ToolBarAdv/Themes/Blend/BlendResources.xaml"/>
            </Setter.Value>
        </Setter>-->
        <Setter Property="BorderThickness" Value="1,1,0,1"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:ToolBarAdv}">
                    <Border x:Name="mainborder" Background="{StaticResource BlendOverFlowButtonBackgroundBrush}" CornerRadius="3" BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <vsm:VisualStateManager.VisualStateGroups>
                                <vsm:VisualStateGroup x:Name="Orientation">
                                    <vsm:VisualState x:Name="Horizontal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                    <vsm:VisualState x:Name="Vertical">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </vsm:VisualState>
                                </vsm:VisualStateGroup>
                            </vsm:VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Grid.ColumnDefinitions>                                  
                                    <ColumnDefinition x:Name="col0" Width="*"></ColumnDefinition>
                                    <ColumnDefinition x:Name="col1" Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="row0"  Height="*"></RowDefinition>
                                    <RowDefinition x:Name="row1" Height="Auto"></RowDefinition>
                                    <RowDefinition x:Name="row2" Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition  Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!--<Button x:Name="PART_DragThumb" Style="{StaticResource ThumbStyle}" Margin="2 3 4 2" ></Button>-->
                                        <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="4 2 2 0" Cursor="SizeAll" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Path x:Name="horizontalGripper" SnapsToDevicePixels="True"  Data="M0.5,12.5 L1.5000002,12.5 L1.5000002,13.5 L0.5,13.5 z M0.50000137,8.5 L1.5000012,8.5 L1.5000012,9.5 L0.50000137,9.5 z M0.50000137,4.5 L1.5000012,4.5 L1.5000012,5.5 L0.50000137,5.5 z M0.50000137,0.5 L1.5000014,0.5 L1.5000014,1.5 L0.50000137,1.5 z" Fill="#FFAAAAAA" HorizontalAlignment="Center" Height="14" Stretch="Fill" Stroke="#FFAAAAAA" VerticalAlignment="Center" Width="2"/>
                                        </Grid>
                                        <tools:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Column="1"></tools:ToolBarPanelAdv>
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="PART_OverflowButton"   Grid.Column="2" Width="12" Style="{StaticResource OverflowButtonStyle}">
                                    <!--<MenuItem.Header>-->
                                    <Grid x:Name="horizontalPath" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Path x:Name="horizontalDownPath1" Data="M0,-2 L6,-2" Stroke="#FFAAAAAA" VerticalAlignment="Bottom" Margin="0,0,0,2" Grid.Row="1" Stretch="Uniform" Height="1" StrokeThickness="1" Width="6"/>
                                        <Path x:Name="horizontalDownPath" Data="M0.5,3 L5.5,3 L3,6 z" Fill="#FFAAAAAA" Stretch="Fill" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,4" Stroke="#FFAAAAAA" Width="6" Height="4" />
                                        <Path x:Name="horizontalLeftOverflowPath" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="#FFAAAAAA" Margin="0,3,1,3" HorizontalAlignment="Left" Height="3" Stretch="Fill" Stroke="#FFAAAAAA" VerticalAlignment="Center" Width="2.5"/>
                                        <Path x:Name="horizontalRightOverflowPath" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="#FFAAAAAA" Margin="0,3,0,3" Height="3" HorizontalAlignment="Right" Stretch="Fill" Stroke="#FFAAAAAA" VerticalAlignment="Center" Width="2.5"/>
                                    </Grid>
                                </ToggleButton>
								<Popup x:Name="PART_OverflowPopup" PlacementTarget="{Binding ElementName=PART_OverflowButton}" StaysOpen="False">
                                <Border BorderBrush="{StaticResource OverflowPopupBorderBrush}" BorderThickness="1" Background="{StaticResource OverflowPopupBackground}" MaxWidth="150" x:Name="PopupBorder">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="3" BlurRadius="7" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <tools:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></tools:ToolBarOverflowPanel>
                                        <shared:DropDownButtonAdv x:Name="PART_AddRemoveButtons"  DropDirection="Right" Margin="2,0,2,2" Style="{StaticResource DropDownButtonAdvStyle}" Visibility="{Binding Path=EnableAddRemoveButton, RelativeSource={RelativeSource AncestorType=shared:ToolBarAdv}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True">
                                                <shared:DropDownMenuGroup.ItemTemplate>
                                                    <DataTemplate>
                                                        <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                            <shared:DropDownMenuItem.Icon>
                                                                <Image Source="{Binding Icon}"/>
                                                            </shared:DropDownMenuItem.Icon>
                                                        </shared:DropDownMenuItem>
                                                    </DataTemplate>
                                                </shared:DropDownMenuGroup.ItemTemplate>
                                            </shared:DropDownMenuGroup>
                                        </shared:DropDownButtonAdv>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>                       
                        <Trigger Property="IsPressed" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Stroke" TargetName="horizontalDownPath1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True" SourceName="PART_OverflowButton">
                            <Setter Property="Stroke" TargetName="horizontalDownPath1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalDownPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalLeftOverflowPath" Value="Black"/>
                            <Setter Property="Stroke" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Fill" TargetName="horizontalRightOverflowPath" Value="Black"/>
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource CheckedBackground}"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="sfshared:SkinStorage.EnableTouch" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True" SourceName="PART_OverflowButton"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="mainborder" Value="{StaticResource MouseOverBackground}"/>
                        </MultiTrigger>

                        <Trigger Property="sfshared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter TargetName="PopupBorder" Property="MaxWidth" Value="200"/>
                            <Setter Property="Width" Value="25" TargetName="PART_OverflowButton"/>
                        </Trigger>
                           
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource VerticalTemplate}"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource ToolBarAdvStyle}" TargetType="shared:ToolBarAdv"/>
	
	<Style x:Key="toolBarItemSeparator" TargetType="tools:ToolBarItemSeparator">
        <Setter Property="Background" Value="{StaticResource ToolBarItemSeperatorBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolBarItemSeperatorBackground}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="tools:ToolBarItemSeparator">
                    <StackPanel Orientation="{TemplateBinding Orientation}">
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="{TemplateBinding Background}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style BasedOn="{StaticResource toolBarItemSeparator}" TargetType="tools:ToolBarItemSeparator"/>
       
</ResourceDictionary>