<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:conv="clr-namespace:Syncfusion.Windows.Tools"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared"
    xmlns:Sync_Resources="clr-namespace:Syncfusion.Windows.Shared.Resources"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">

    <Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey" />
    <!-- ColorPickerPallette -->
    <local:SizeToDoubleConverter x:Key="SizeToDoubleConverterKey" />
    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF333333" />
    <SolidColorBrush x:Key="ColorGroupItemBorderBrushKey" Color="#FFA0BCE4" />

    <!--New Brushes-->
    <SolidColorBrush x:Key="ColorGroupItemMouseOverBrushKey" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="ColorGroupItemSelectedBrushKey" Color="#FF119EDA" />

    <SolidColorBrush x:Key="PopupBackgroundBrushKey" Color="White" />

    <SolidColorBrush x:Key="ColorPickerPaletteBackgroundBrushKey" Color="White" />
    <SolidColorBrush x:Key="ColorPickerPaletteBorderBrushKey" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="ColorPickerPaletteForegroundBrushKey" Color="#FF333333" />
    <SolidColorBrush x:Key="ColorPickerPalettePopupBackgroundBrushKey" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorPickerPalettePopupBorderBrushKey" Color="#FFC7C7C7" />
    <SolidColorBrush x:Key="ThemeHeaderBackGroundBrush" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="ThemeHeaderForeGroundBrush" Color="#FF333333" />

    <SolidColorBrush x:Key="ColorPickerPaletteMoreColorBackgroundBrushKey" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorPickerPaletteMoreColorBorderBrushKey" Color="#FFC7C7C7" />
    <!--New Brushes-->

    <LinearGradientBrush x:Key="ColorPickerUpDownBorderBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="Red" Offset="0.835" />
        <GradientStop Color="Transparent" Offset="0.129" />
        <GradientStop Color="Transparent" Offset="0.5" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoderBrushKey" Color="#FFD8ECFE" />
    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1BrushKey" Color="#FFD8ECFE" />

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBackgroundBrushKey" Color="#FFFFE7A2" />

    <LinearGradientBrush x:Key="ColorPickerPaletteAutomaticColorBackgroundBrushKey" EndPoint=".5,1" StartPoint=".5,0">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.54" />
        <GradientStop Color="#FFFFFFFF" Offset="0.971" />
        <GradientStop Color="#FFFFFFFF" Offset="0.427" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1MouseOverBrushKey" Color="#FF119EDA" />

    <!--<SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA" />-->
    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoderMouseOverBrushKey" Color="#FFE8C76D" />

    <LinearGradientBrush x:Key="ColorPickerPaletteAutoBoderSelectedBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCE4A0" Offset="0" />
        <GradientStop Color="#FFFFE8A6" Offset="0.021" />
        <GradientStop Color="#FFFFE8A6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1SelectedBrushKey" Color="#FFD2B564" />

    <LinearGradientBrush x:Key="ColorPickerPaletteMoreColorMouseOverBrushKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFFFAEE" Offset="0.019" />
        <GradientStop Color="#FFFFF2CB" Offset="0.529" />
        <GradientStop Color="#FFFFF2CB" Offset="0.961" />
        <GradientStop Color="#FFCED4DD" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ColorPickerPaletteMouseOverBrushKey" Color="White" />
    <SolidColorBrush x:Key="ColorPickerUpDownMouseOverBrushKey" Color="#FFE0E0E0" />

    <SolidColorBrush x:Key="ColorPickerUpDownMouseOverBorderBrushKey" Color="#FFCCCCCC" />

    <SolidColorBrush x:Key="ColorPickerPaletteMouseOverBorderBrushKey" Color="#FFB79E73" />

    <Style x:Key="local:ColorGroupItem"  TargetType="local:ColorGroupItem">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorGroupItem">
                    <Grid>
                        <Border>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ItemBorder" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Color}" Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BorderWidth}" Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BorderHeight}" HorizontalAlignment="Left" Margin="{TemplateBinding BorderMargin}"  Grid.Row="0" SnapsToDevicePixels="True">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{TemplateBinding ColorName}"></TextBlock>
                                        </ToolTip>
                                    </Border.ToolTip>
                                </Border>

                                <ItemsControl  x:Name="Ic1" Grid.Row="1" Margin="{TemplateBinding ItemMargin}"   HorizontalAlignment="Left"></ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="ItemBorder" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>
                            <!--<Setter Property="BorderThickness" TargetName="ItemBorder" Value="1" />-->
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{StaticResource ColorGroupItemMouseOverBrushKey}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <!--<Setter Property="BorderThickness" TargetName="ItemBorder" Value="1" />-->
                            <Setter Property="BorderBrush" TargetName="ItemBorder" Value="{DynamicResource MetroBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorGroupItem" BasedOn="{StaticResource local:ColorGroupItem}" />

    <Style x:Key="local:ColorGroup" TargetType="local:ColorGroup">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorGroup">
                    <Grid Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=PanelVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition  Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" x:Name="CGHeaderName" HorizontalAlignment="Stretch" Visibility="{TemplateBinding HeaderVisibility}" Fill="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ThemeHeaderBackGround}" Margin="0">
                        </Rectangle>
                        <TextBlock x:Name="CGTextBox" Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=HeaderName}" Visibility="{TemplateBinding HeaderVisibility}" Grid.Row="0" VerticalAlignment="Center" FontWeight="Medium"  Margin="5,2,2,2"  Foreground="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ThemeHeaderForeGround}" HorizontalAlignment="Left"  FontSize="14" />

                        <ItemsControl  x:Name="Ic"  Grid.Row="1" ItemsSource="{TemplateBinding DataSource}" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel  Orientation="Horizontal" ></StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                            <Setter TargetName="CGTextBox" Property="Margin" Value="8,6,4,6" />
                            <Setter TargetName="CGTextBox" Property="FontSize" Value="18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorGroup" BasedOn="{StaticResource local:ColorGroup}" />

    <Style x:Key="local:PolygonItem" TargetType="local:PolygonItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PolygonItem">
                    <Grid>

                        <Grid>

                            <Polygon x:Name="polygon" Fill="{Binding RelativeSource={RelativeSource TemplatedParent},Path=color}" Stroke="{StaticResource GlyphBrushKey}"  StrokeThickness="0"  Points="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Points}">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="{TemplateBinding ColorName}"></TextBlock>
                                </ToolTipService.ToolTip>
                            </Polygon>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PolygonItem" BasedOn="{StaticResource local:PolygonItem}" />

    <Style x:Key="MetroColorPickerPaletteStyle" TargetType="local:ColorPickerPalette">
        <Setter Property="Background" Value="{StaticResource ColorPickerPaletteBackgroundBrushKey}" />
        <Setter Property="ThemeHeaderBackGround" Value="{StaticResource ThemeHeaderBackGroundBrush}" />
        <Setter Property="ThemeHeaderForeGround" Value="{StaticResource ThemeHeaderForeGroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorPickerPaletteBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource ColorPickerPaletteForegroundBrushKey}" />
        <Setter Property="MouseOverBackground" Value="{StaticResource ColorPickerUpDownMouseOverBrushKey}" />
        <!--<Setter Property="Icon" Value="/Syncfusion.Shared.WPF;component/Images/Label.png" />-->
        <Setter Property="MoreColorsIcon" Value="/Syncfusion.Shared.WPF;component/Images/MoreColorsIcon.png" />
        <!--<Setter Property="IconSize" Value="16,16" />-->
        <Setter Property="MoreColorsIconSize" Value="16,16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorPickerPalette">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Visibility="Collapsed" Width="Auto" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" x:Name="b_Expanded" Background="{TemplateBinding Background}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <Grid Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="Automatic1_Expanded" Margin="2,2,2,2" Grid.Row="0" Visibility="{TemplateBinding AutomaticColorVisibility}">
                                        <Border.Background>
                                            <LinearGradientBrush EndPoint=".5,1" StartPoint=".5,0">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#FFFFFFFF" Offset="0.54" />
                                                <GradientStop Color="#FFFFFFFF" Offset="0.971" />
                                                <GradientStop Color="#FFFFFFFF" Offset="0.427" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AutoBorder1_Expanded" Grid.Column="0" BorderBrush="{StaticResource ColorPickerPaletteAutoBoderBrushKey}" CornerRadius="2" BorderThickness="1">
                                                <Border x:Name="AutoBorder2_Expanded" Background="{StaticResource ColorPickerPaletteAutoBackgroundBrushKey}"  BorderBrush="{StaticResource ColorPickerPaletteAutoBoder1BrushKey}" Grid.Column="0" BorderThickness="1">
                                                    <Border x:Name="aborder_Expanded" Grid.Column="0" Height="{TemplateBinding BorderHeight}" Width="{TemplateBinding BorderWidth}"  Background="{TemplateBinding AutomaticColor}" />
                                                </Border>
                                            </Border>
                                            <Rectangle x:Name="splitter1" Width="1" MinHeight="23" Fill="#FFC5C5C5" Grid.Column="1" SnapsToDevicePixels="True" Margin="3,0,3,0" />
                                            <TextBlock x:Name="AutomaticText_Expanded" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=AutomaticText}" Padding="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}"></TextBlock>
                                        </Grid>
                                    </Border>

                                    <ItemsControl x:Name="ColorArea_Expanded" Grid.Row="1">
                                        <local:ColorGroup x:Name="item1_Expanded"  HeaderName="Theme Colors" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                        <local:ColorGroup x:Name="item2_Expanded" HeaderName="Standard Colors" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                        <local:ColorGroup x:Name="item3_Expanded" HeaderName="Recently Used" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                    </ItemsControl>
                                    <!--<Border BorderBrush="#FFDDE7EE" BorderThickness="1" Margin="2,0,2,0" Grid.Row="2"></Border>-->

                                    <Border Grid.Row="3" Background="{StaticResource PopupBackgroundBrushKey}" Visibility="{TemplateBinding MoreColorOptionVisibility}" BorderThickness="1" Margin="2,1,2,1" CornerRadius="1" x:Name="MoreColors1_Expanded">
                                        <Grid x:Name="MoreColorsGrid1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{TemplateBinding MoreColorsIcon}" Grid.Column="0"  Width="{Binding Path=MoreColorsIconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Height="{Binding Path=MoreColorsIconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" x:Name="morecolorsimage1" Margin="1,3,4,0" />
                                            <Border x:Name="splitterborder1" BorderBrush="#FFC5C5C5" BorderThickness=".5" Grid.Column="1" Margin="0" />
                                            <TextBlock x:Name="MoreColorText_Expanded" Grid.Column="2" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=MoreColorsText}" Padding="2" VerticalAlignment="Center" HorizontalAlignment="Left"  FontSize="{TemplateBinding FontSize}" Margin="8,0,0,0" Foreground="{TemplateBinding Foreground}" />
                                        </Grid>
                                    </Border>

                                    <!--<Border Grid.Row="3" Visibility="{TemplateBinding MoreColorOptionVisibility}" Margin="3,2,2,5">
                                        <Button Content="More Colors..." FontSize="13" Background="{StaticResource ColorPickerPaletteMoreColorBackgroundBrushKey}" x:Name="MoreColors1_Expanded" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextBlock.FontSize="14" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>-->
                                </Grid>
                            </Border>
                        </Border>
                        <Border x:Name="ColorPaletteBorder" Background="Transparent" BorderBrush="Transparent">
                            <Grid x:Name="lay">
                                <Grid.Resources>
                                    <ItemsPanelTemplate x:Key="ItemPanelTemplate">
                                        <StackPanel  Orientation="Horizontal" ></StackPanel>
                                    </ItemsPanelTemplate>
                                    <ItemsPanelTemplate x:Key="ItemPanelTemplate2">
                                        <StackPanel  Orientation="Vertical" ></StackPanel>
                                    </ItemsPanelTemplate>
                                </Grid.Resources>

                                <Border x:Name="ColorPickerBorder" Background="Transparent" BorderBrush="Transparent"   BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="OutBorder" BorderBrush="{TemplateBinding BorderBrush}" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" BorderThickness="1" Grid.ColumnSpan="2">
                                        </Border>
                                        <Border x:Name="ColorBorder" BorderBrush="Transparent" BorderThickness="0" Grid.Column="0">

                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="Transparent" Offset="0.835" />
                                                    <GradientStop Color="Transparent" Offset="0.129" />
                                                    <GradientStop Color="Transparent" Offset="0.5" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Margin="2" x:Name="IconGrid">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" x:Name="colorborder_row" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{TemplateBinding Icon}"  Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" x:Name="image" />
                                                <Border Name="color_border" Grid.Row="1"></Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="UpDownBorder" BorderBrush="Transparent" BorderThickness="1" Grid.Column="1" MinWidth="16">
                                            <TextBlock Text="6" x:Name="Txt" FontFamily="Webdings" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="Transparent" Offset="0.835" />
                                                    <GradientStop Color="Transparent" Offset="0.129" />
                                                    <GradientStop Color="Transparent" Offset="0.5" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Popup x:Name="pop">
                                    <Border BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource PopupBackgroundBrushKey}" BorderBrush="{StaticResource ColorPickerPalettePopupBorderBrushKey}" x:Name="b">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border x:Name="Automatic1" Background="{StaticResource ColorPickerPaletteAutomaticColorBackgroundBrushKey}" Margin="2,2,2,3"  Grid.Row="0" Visibility="{TemplateBinding AutomaticColorVisibility}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="AutoBorder1" Grid.Column="0" BorderBrush="{StaticResource ColorPickerPaletteAutoBoderBrushKey}" CornerRadius="2" BorderThickness="1">
                                                        <Border x:Name="AutoBorder2" Background="{StaticResource ColorPickerPaletteAutoBackgroundBrushKey}"  BorderBrush="{StaticResource ColorPickerPaletteAutoBoder1BrushKey}" Grid.Column="0" BorderThickness="1">
                                                            <Border x:Name="aborder" Grid.Column="0" Height="{TemplateBinding BorderHeight}" Width="{TemplateBinding BorderWidth}"  Background="{TemplateBinding AutomaticColor}" />
                                                        </Border>
                                                    </Border>
                                                    <TextBlock x:Name="AutomaticText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=AutomaticText}" Padding="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}"></TextBlock>
                                                </Grid>
                                            </Border>

                                            <ItemsControl x:Name="ColorArea" Grid.Row="1" Margin="2,2,2,0">
                                                <local:ColorGroup x:Name="item1"  HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=ThemeColorsText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                <local:ColorGroup x:Name="item2" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=StandardColorsText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                <local:ColorGroup x:Name="item3" HeaderName="{Binding Source={StaticResource ResourceWrapperKey}, Path=RecentlyUsedText}" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                            </ItemsControl>
                                            <Border BorderBrush="#FFDDE7EE" BorderThickness=".5" Margin="2,0,2,0" Grid.Row="2"></Border>
                                            <Border Grid.Row="3" Background="{StaticResource ColorPickerPaletteMoreColorBackgroundBrushKey}" BorderBrush="{StaticResource ColorPickerPaletteMoreColorBorderBrushKey}" BorderThickness="0" Visibility="{TemplateBinding MoreColorOptionVisibility}" Margin="2,2,2,2" Height="{Binding ElementName=Automatic1, Path=Height , Mode=OneWay}"  x:Name="MoreColors1">

                                                <Grid x:Name="MoreColorsGrid">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="1" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{TemplateBinding MoreColorsIcon}" Grid.Column="0"  Width="{Binding Path=MoreColorsIconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Height="{Binding Path=MoreColorsIconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" x:Name="morecolorsimage" Margin="1,3,4,0" />
                                                    <Border x:Name="splitterborder" BorderBrush="#FFC5C5C5" BorderThickness=".5" Grid.Column="1" Margin="0" />
                                                    <TextBlock x:Name="MoreColorText" Grid.Column="2" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=MoreColorsText}" Foreground="{TemplateBinding Foreground}"  Padding="2" VerticalAlignment="Center" HorizontalAlignment="Left"  FontSize="{TemplateBinding FontSize}" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                            <!--<Setter Property="PopupWidth" Value="300" />-->
                            <Setter Property="FontSize" TargetName="Txt" Value="22" />
                            <Setter Property="MinHeight" TargetName="colorborder_row" Value="3" />
                            <Setter Property="Margin"  TargetName="Txt" Value="5,0,5,3" />
                            <Setter Property="Width" Value="300" TargetName="b_Expanded" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="MinHeight"  TargetName="MoreColors1_Expanded" Value="40" />
                            <Setter Property="MinHeight"  TargetName="MoreColors1" Value="40" />

                            <Setter TargetName="morecolorsimage1" Property="Margin" Value="5,3,9,0" />
                            <Setter TargetName="morecolorsimage" Property="Margin" Value="5,3,9,0" />

                            <Setter Property="MoreColorsIconSize" Value="20,20" />
                            <Setter Property="Margin" TargetName="IconGrid" Value="8,10,8,10" />
                            <Setter Property="IconSize">
                                <Setter.Value>
                                    <Size>20,20</Size>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="AutoBorder1" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="AutoBorder1" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Automatic1" Property="Background" Value="{DynamicResource MetroBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="Automatic1" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="AutoBorder1" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="AutoBorder2" Property="BorderBrush" Value="{StaticResource ColorGroupItemMouseOverBrushKey}" />
                            <Setter TargetName="Automatic1" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="AutomaticText" Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="Automatic1_Expanded" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="AutoBorder1_Expanded" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="AutoBorder2_Expanded" Property="BorderBrush" Value="{StaticResource ColorGroupItemMouseOverBrushKey}" />
                            <Setter TargetName="Automatic1_Expanded" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="AutomaticText_Expanded" Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="MoreColors1" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MoreColors1" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="MoreColorText" Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="MoreColors1_Expanded" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MoreColors1_Expanded" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="MoreColorText_Expanded" Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAutomaticBorderPressed" Value="True" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="AutoBorder1" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="AutoBorder2" Property="BorderBrush" Value="{StaticResource ColorGroupItemMouseOverBrushKey}" />
                            <Setter TargetName="Automatic1" Property="Background" Value="{DynamicResource MetroBrush}" />
