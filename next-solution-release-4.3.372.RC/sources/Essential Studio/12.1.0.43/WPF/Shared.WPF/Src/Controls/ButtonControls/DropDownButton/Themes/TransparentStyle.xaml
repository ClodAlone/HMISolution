<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <SolidColorBrush x:Key="ButtonAdvBackgroundBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="ButtonAdvBorderBrush" Color="#7F000000"/>
    <SolidColorBrush x:Key="ButtonAdvForeground" Color="Black"/>
    <LinearGradientBrush x:Key="ButtonAdvHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonAdvPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF"/>
        <GradientStop Color="#7EFFFFFF" Offset="0.032"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.649"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>        
    <SolidColorBrush x:Key="PopupBackground" Color="#E5FFFFFF"/>
    <SolidColorBrush x:Key="PopupBorder" Color="#FF434343" Opacity="0.7"/>
    <LinearGradientBrush x:Key="DropDownMenuGroupHeaderBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.5">
        <GradientStop Color="#FFE0EDFD" Offset="0.017"/>
        <GradientStop Color="#FF292929" Offset="0.992"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DropDownMenuGroupHeaderBorder" Color="#B3000000"/>
    <SolidColorBrush x:Key="DropDownMenuItemSidePanelBackgroundBrush" Color="White" Opacity="0.5"/>
    <LinearGradientBrush x:Key="DropDownMenuItemHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>
    <!--<LinearGradientBrush x:Key="DropDownMenuItemHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#99FAFAFA" Offset="0"/>
        <GradientStop Color="#99FFFFFF" Offset="0.491"/>
        <GradientStop Color="#99E2E2E2" Offset="0.531"/>
        <GradientStop Color="#99B6B6B6" Offset="0.789"/>
        <GradientStop Color="#99D5D5D5" Offset="0.996"/>
    </LinearGradientBrush>-->   
    <SolidColorBrush x:Key ="DropDownMenuItemHoverBorderBrush" Color="#7F000000"/>
    <SolidColorBrush Color="#CCFFFFFF" x:Key="TransparentDropdownitemhoverInnerBorderBrush"/>
    <LinearGradientBrush x:Key="CheckIconBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.5">
        <GradientStop Color="#FFE6E6E6" Offset="0"/>
        <GradientStop Color="#FFFCFCFC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CheckIconBorder" Color="#FF333333" Opacity="0.5"/>    
    <SolidColorBrush x:Key="ResizeThumbBackgroundBrush" Color="#FFBCC7D8"/>
    <SolidColorBrush x:Key="ResizeThumbBorderBrush" Color="#FF9CAAC1"/>
    <SolidColorBrush x:Key="CheckIconPathFillBrush" Color="#FF000000"/>
    <SolidColorBrush Color="#CCFFFFFF" Opacity="0.70" x:Key="TransparentButtonInnerBorderBrush"/>

    <Style x:Key="TransparentDropDownButtonAdvStyle" TargetType="local:DropDownButtonAdv">
        <Setter Property="Foreground" Value="{StaticResource ButtonAdvForeground}" />
        <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
        <Setter Property="Label" Value="Drop Down Button"/>
        <Setter Property="Background" Value="{StaticResource ButtonAdvBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonAdvBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownButtonAdv">
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">

                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="8,8,8,8"/>

                            <Setter Property="Border.CornerRadius"  TargetName="ItemBorder" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder1" Value="6"/>
                            <Setter Property="Border.CornerRadius"  TargetName="innerborder" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="innerborder1" Value="6"/>

                            <Setter Property="Image.Height" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Width" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Height" TargetName="smallImage" Value="20"/>
                            <Setter Property="Image.Width" TargetName="smallImage" Value="20"/>
                            <Setter Property="Path.Margin" TargetName="Arrow" Value="10,3,6,1"/>
                            <Setter Property="Path.Data" TargetName="Arrow" Value="M 0 0 L 7 7 L 14 0 Z"/>
                            <Setter Property="Border.Effect" TargetName="ItemBorder">
                                <Setter.Value>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Border.Effect" TargetName="ItemBorder1">
                                <Setter.Value>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Border.Margin" TargetName="PART_Text" Value="5,0,0,0"/>

                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                            </MultiTrigger.Conditions>
                        
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true"/>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                            <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>

                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True">
                            <Border BorderThickness="{TemplateBinding BorderThickness}" x:Name="innerborder" BorderBrush="{StaticResource TransparentButtonInnerBorderBrush}">
                                <Grid Margin="{TemplateBinding Padding}" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Name="PART_ImageBorder" Grid.Column="0">
                                        <Image Margin="2" x:Name="smallImage"
						            Width="16" Height="16"   
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                           Margin="2,0,4,0">
                                         <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <Path Grid.Column="2" HorizontalAlignment="Center" Name="Arrow" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M 0 0 L 4 4 L 8 0 Z" Margin="1,1,2,1">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="White"/>
                                        </Path.Effect>
                                    </Path>
                                </Grid>
                            </Border>
                        </Border>
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True">
                            <Border BorderThickness="{TemplateBinding BorderThickness}" x:Name="innerborder1" BorderBrush="{StaticResource TransparentButtonInnerBorderBrush}">
                                <StackPanel Margin="{TemplateBinding Padding}">
                                    <Border Name="PART_ImageBorderLarge">
                                        <Image Margin="2" x:Name="LargeImage"
                                    Width="26" Height="26" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}"  
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <ItemsControl x:Name="PART_TextAreaLarge"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               Margin="2,0,4,0">
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}" Margin="0,0,5,5">
                                <Border Background="{StaticResource PopupBackground}" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".3" Direction="325"/>
                                    </Border.Effect>
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentDropDownButtonAdvStyle}" TargetType="local:DropDownButtonAdv"/>

    <Style x:Key="TransparentDropDownMenuGroupStyle" TargetType="local:DropDownMenuGroup">
        <Setter Property="Background" Value="{StaticResource PopupBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource ButtonAdvForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownMenuGroup">
                    <Grid Name="gri">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextConverter"/>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource DropDownMenuGroupHeaderBackground}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="22" Grid.Row="0" BorderThickness="0" BorderBrush="{StaticResource DropDownMenuGroupHeaderBorder}" Margin="0,0,0,1">
                            <ContentControl Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Left" Margin="5,0,0,0"/>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>
                                <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}" Background="{StaticResource DropDownMenuItemSidePanelBackgroundBrush}" BorderThickness="0,1,0,0" Width="22" HorizontalAlignment="Left"/>
                                <Border>
                                    <ScrollViewer KeyboardNavigation.DirectionalNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" Background="{StaticResource DropDownMenuItemSidePanelBackgroundBrush}" BorderThickness="0,0,2,0" Width="22" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Background="{StaticResource DropDownMenuGroupHeaderBackground}" BorderBrush="{StaticResource DropDownMenuGroupHeaderBorder}" BorderThickness="0,1,0,0" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                            <Grid>
                                <Border HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="White" CornerRadius="2" Height="3" Width="3"/>
                                        <Border  Background="Gray" CornerRadius="2"  Height="3" Width="3" Margin="-5,0,0,0"/>
                                        <Border Background="White" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                        <Border  Background="Gray" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                        <Border Background="White" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                        <Border  Background="Gray" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">

                            <Setter TargetName ="IconTray"  Property ="Width" Value="30"/>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentDropDownMenuGroupStyle}" TargetType="local:DropDownMenuGroup"/>
    <LinearGradientBrush x:Key="menuitempressedbrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7F767676"/>
        <GradientStop Color="#B3FEFEFE" Offset="0.015"/>
        <GradientStop Color="#7F9F9F9F" Offset="0.052"/>
        <GradientStop Color="#7FB8B8B8" Offset="0.358"/>
        <GradientStop Color="#FFFEFEFE" Offset="0.608"/>
        <GradientStop Color="#FDFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="TransparentDropDownMenuItemStyle" TargetType="local:DropDownMenuItem">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownMenuItem">
                    <Border Name="Bd" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"  BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Margin="2,0,2,0">
                        <Border BorderThickness="1" x:Name="innerborder">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                </Grid.Resources>
                                <Border Grid.Column="1"  Background="Transparent">
                                    <ContentControl Name="content" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="6,3,2,2" Background="Transparent"/>
                                </Border>
                                <Border Grid.Column="2" Background="Transparent">
                                    <ContentControl Name="path" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Margin="3" FontSize="14"/>
                                </Border>

                                <Border Margin="2" Background="Transparent">
                                    <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                                </Border>

                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" Background="{StaticResource CheckIconBackground}" BorderBrush="{StaticResource CheckIconBorder}" BorderThickness="1">
                                    <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{TemplateBinding Foreground}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                </Border>

                                <Popup IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver, Mode=OneWay}" Margin="2,0,0,0" Placement="Right" AllowsTransparency="True" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                                    <Grid x:Name="PART_poup" Margin="0,0,5,5">
                                        <Border Background="{StaticResource PopupBackground}" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}" SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".3" Direction="325"/>
                                            </Border.Effect>
                                            <ItemsPresenter Margin="2"/>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>


                        <Trigger  Property="IsMouseOver" Value="true">

                            <Setter Property="Border.Background" TargetName="Bd" Value="{StaticResource DropDownMenuItemHoverBackground}"/>
                            <Setter Property="Border.BorderBrush" TargetName="Bd" Value="{StaticResource DropDownMenuItemHoverBorderBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="innerborder" Value="{StaticResource TransparentDropdownitemhoverInnerBorderBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#7F000000"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:DropDownMenuItem">
                            <Border Name="Bd"  SnapsToDevicePixels="True"  BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Margin="1,0,1,0">
                                <Border BorderThickness="1" x:Name="innerborder">
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.Resources>
                                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                        </Grid.Resources>
                                        <Border Grid.Column="1"  Background="Transparent">
                                            <ContentControl Name="content" Content="{TemplateBinding Header}" Margin="6,8,2,7" Background="Transparent"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="Transparent">
                                            <ContentControl Name="path" SnapsToDevicePixels="True"  VerticalAlignment="Center"  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Margin="3,6,3,3" FontSize="20"/>
                                        </Border>

                                        <Border Margin="2" Background="Transparent">
                                            <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="20" Width="20" Margin="1"/>
                                        </Border>

                                        <Border Width="26" Height="26" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" Background="{StaticResource CheckIconBackground}" BorderBrush="{StaticResource CheckIconBorder}" BorderThickness="1">
                                            <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{TemplateBinding Foreground}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                        </Border>

                                        <Popup IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver, Mode=OneWay}" Margin="2,0,0,0" Placement="Right" AllowsTransparency="True" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                                            <Grid x:Name="PART_poup" Margin="0,0,5,5">
                                                <Border Background="{StaticResource PopupBackground}" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}" SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".3" Direction="325"/>
                                                    </Border.Effect>
                                                    <ItemsPresenter Margin="-1,0,-1,-1"/>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="true">
                                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource menuitempressedbrush}"/>
                                        </Trigger>


                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentDropDownMenuItemStyle}" TargetType="local:DropDownMenuItem"/>


</ResourceDictionary>