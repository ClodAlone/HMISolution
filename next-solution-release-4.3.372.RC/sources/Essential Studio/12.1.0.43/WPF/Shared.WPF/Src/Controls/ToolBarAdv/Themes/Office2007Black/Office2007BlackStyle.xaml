    <Style TargetType="shared:DropDownMenuItem" x:Key="MenuItemStyle">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsCheckable" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:DropDownMenuItem">
                    <Grid>
                        <Grid.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                        </Grid.Resources>
                        <Border Margin="0,0,2,0" CornerRadius="2" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <Border BorderThickness="0" Margin="1" x:Name="Innerborder" Background="Transparent" >
                                <Grid Margin="0,0,0,-2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="21"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentControl Content="{TemplateBinding Header}" Grid.Column="2" Margin="6 2 2 2"/>
                                    <ContentControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="3" Margin="3" FontSize="14"/>
                                    <Border Margin="0,2,2,2" x:Name="iconborder" CornerRadius="2" Grid.Column="1">
                                        <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1,1,1,2"/>
                                    </Border>
                                    <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2,2,2,4" CornerRadius="2" Background="#FFFFE395" BorderBrush="#FFF29536" BorderThickness="1">
                                        <Path x:Name="CheckIcon" 
                                          Data="M92,307 L106,322 136.61635,291.20421 132.61635,286.20421 107,311.5 98,302 z" 
                                          Fill="#FF32357B" FlowDirection="LeftToRight" Height="9" Stretch="Fill" Width="9.5"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>

                        <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                            <Grid Opacity="0" x:Name="PART_poup">
                                <Border Background="White" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <ItemsPresenter />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource Office2007BlueDropDownMenuItemHoverOuterBackground}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Office2007BlueDropDownMenuItemHoverBorderBrush}"/>
                            <Setter Property="Background" TargetName="Innerborder" Value="{StaticResource Office2007blueDropDownMenuItemHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}" >
                            <Setter TargetName ="iconborder" Property="Visibility" Value="Collapsed" />
                        </Trigger>


                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
