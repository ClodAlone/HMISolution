<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/MetroThemeBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

   
    <SolidColorBrush Color="White" x:Key="HoverBrush"/>
    <Style x:Key="ButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="Black" StrokeThickness="1" StrokeDashArray="1 2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MetroSplitButtonAdvStyle" TargetType="local:SplitButtonAdv">
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
        <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Label" Value="Split Button"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource  MetroBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SplitButtonAdv">
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                <Border BorderThickness="1" Background="{DynamicResource MetroPanelBackgroundBrush}" BorderBrush="{DynamicResource MetroBorderBrush}"  SnapsToDevicePixels="True">
                                    <ContentPresenter Margin="2"/>
                                </Border>
                            </Grid>
                        </Popup>
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PART_ButtonNormal" Grid.Column="0">
                                    <Grid Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Name="PART_ImageBorder" Grid.Column="0">
                                            <Image Margin="2"
						            Width="16" Height="16"   x:Name="SmallImage"
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           Margin="2,0,4,0"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="PART_DropDownButtonNormal" Grid.Column="1" BorderThickness="1,0,0,0" Background="Transparent">
                                    <!--<Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="1" x:Name="InnerDropBorder">-->
                                    <Path HorizontalAlignment="Center" Name="Arrow" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M 0 0 L 4 4 L 8 0 Z" Margin="2,1,2,1"/>
                                    <!--</Border>-->
                                </Border>

                            </Grid>

                        </Border>
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1"  SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition  Height="*"/>
                                    <RowDefinition  Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="PART_Button" >
                                    <Border Name="PART_ImageBorderLarge">
                                        <Image Margin="2" x:Name="LargeImage"
                                    Width="26" Height="26" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}"
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                </Border>
                                <Border Grid.Row="1" x:Name="PART_DropDownButton" BorderThickness="0,1,0,0" Background="Transparent">
                                    <!--<Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="1" x:Name="InnerDropBorder1">-->
                                    <ItemsControl x:Name="PART_TextAreaLarge"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               Margin="2,0,4,0">
                                    </ItemsControl>
                                    <!--</Border>-->
                                </Border>
                            </Grid>

                        </Border>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                            <Setter Property="Path.Margin" TargetName="Arrow" Value="8,3,10,3"/>
                            <Setter Property="Path.Data" TargetName="Arrow" Value="M 0 0 L 7 7 L 14 0 Z"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="Height" TargetName="SmallImage" Value="20"/>
                            <Setter Property="Width" TargetName="SmallImage" Value="20"/>
                            <Setter TargetName="PART_DropDownButtonNormal" Property="CornerRadius" Value="0"/>

                            <Setter Property="CornerRadius"  TargetName="ItemBorder" Value="0"/>
                            <Setter Property="CornerRadius" TargetName="ItemBorder1" Value="0"/>


                            <Setter Property="Margin" TargetName="SmallImage" Value="0,2,2,2"/>

                            <Setter Property="Height" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Width" TargetName="LargeImage" Value="30"/>
                           
                            <Setter Property="Margin" TargetName="PART_Text" Value="5,0,0,0"/>

                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver"  Value="true"/>

                            </MultiTrigger.Conditions>
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource  MetroHoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource HoverBrush}"/>


                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroHoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource HoverBrush}"/>

                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver"  Value="true"/>

                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" SourceName="PART_DropDownButtonNormal" Value="true"/>

                            </MultiTrigger.Conditions>

                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource HoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{DynamicResource MetroHoverBrush}"/>


                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" SourceName="PART_DropDownButtonNormal" Value="true"/>

                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" SourceName="PART_ButtonNormal" Value="true"/>

                            </MultiTrigger.Conditions>

                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroHoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{StaticResource HoverBrush}"/>


                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" SourceName="PART_ButtonNormal" Value="true"/>

                            </MultiTrigger.Conditions>


                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" SourceName="PART_DropDownButton" Value="true"/>

                            </MultiTrigger.Conditions>

                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource HoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{DynamicResource MetroHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" SourceName="PART_DropDownButton" Value="true"/>

                            </MultiTrigger.Conditions>


                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" SourceName="PART_Button" Value="true"/>

                            </MultiTrigger.Conditions>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroHoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{StaticResource HoverBrush}"/>

                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" SourceName="PART_Button" Value="true"/>

                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="PART_DropDownButton" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="PART_DropDownButtonNormal" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Foreground" TargetName="PART_Text" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <Setter Property="Foreground" TargetName="PART_TextAreaLarge" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>

                            <Setter Property="Foreground"  Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="PART_DropDownButton" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButton" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.Background" TargetName="PART_DropDownButtonNormal" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="PART_DropDownButtonNormal" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Foreground" TargetName="PART_Text" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <Setter Property="Foreground" TargetName="PART_TextAreaLarge" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <Setter Property="Foreground"  Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                            <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource MetroSplitButtonAdvStyle}" TargetType="local:SplitButtonAdv"/>

</ResourceDictionary>