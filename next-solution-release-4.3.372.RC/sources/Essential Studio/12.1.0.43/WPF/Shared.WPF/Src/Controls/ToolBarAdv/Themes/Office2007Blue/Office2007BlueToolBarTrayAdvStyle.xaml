<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TrayBackColor" Color="#FFBFDBFF"/>
    <LinearGradientBrush x:Key="Office2007BlueToolBarTrayBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDAEAFF" Offset="0.034"/>
        <GradientStop Color="#FFAED1FF" Offset="0.813"/>
    </LinearGradientBrush>
    <Style x:Key="ToolBarTrayAdvStyle" TargetType="{x:Type tools:ToolBarTrayAdv}">
        <Setter Property="Background" Value="{StaticResource Office2007BlueToolBarTrayBackgroundBrush}"/>
       
    </Style>
    
    <Style BasedOn="{StaticResource ToolBarTrayAdvStyle}" TargetType="tools:ToolBarTrayAdv"/>

    
</ResourceDictionary>