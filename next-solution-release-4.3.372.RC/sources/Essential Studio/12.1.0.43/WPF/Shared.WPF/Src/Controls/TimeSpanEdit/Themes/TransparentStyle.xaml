<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:Syncfusion.Windows.Shared">

    <local:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Brushes -->

    <LinearGradientBrush x:Key="BackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FBEBEBE" Offset="1" />
        <GradientStop Color="#99FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderBrush" Color="#7F000000" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF000000" />

    <SolidColorBrush x:Key="RepeatButtonBackground" Color="#7FFFFFFF" />

    <SolidColorBrush x:Key="RepeatButtonInnerBorderBrush" Color="#CCFFFFFF" />

    <SolidColorBrush x:Key="RepeatButtonBorderBrush" Color="#7F000000" />

    <LinearGradientBrush x:Key="RepeatButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EFFFFFF" />
        <GradientStop Color="#7EFFFFFF" Offset="0.032" />
        <GradientStop Color="#A5FFFFFF" Offset="0.649" />
        <GradientStop Color="White" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TransparentToggleButtonPressedBorderBrush" Color="#7F000000" />

    <LinearGradientBrush x:Key="RepeatButtonHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1" />
        <GradientStop Color="#7EE5E5E5" Offset="0.968" />
        <GradientStop Color="#A5FFFFFF" Offset="0.504" />
        <GradientStop Color="White" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF000000" />

    <SolidColorBrush x:Key="TextBoxMouseOverBorderBrush" Color="#FF818181" Opacity="0.495" />

    <SolidColorBrush x:Key="TextBoxMouseOverBackground" Color="#FFFFFFFF" Opacity="0.495" />

    <ControlTemplate x:Key="RepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
        <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" SnapsToDevicePixels="true">
            <Border x:Name="InnerBorder" BorderBrush="{StaticResource RepeatButtonInnerBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" CornerRadius="0">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RepeatButtonHoverBackground}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RepeatButtonPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Background"
                Value="{StaticResource RepeatButtonBackground}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource RepeatButtonBorderBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource RepeatButtonForeground}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Template" Value="{StaticResource RepeatButtonTemplate}" />
    </Style>

    <Style x:Key="TransparentTimeSpanEditStyle" TargetType="{x:Type  local:TimeSpanEdit}">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="AllowDrop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TimeSpanEdit}">

                    <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="InnerBorder" BorderBrush="{StaticResource RepeatButtonInnerBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"  VerticalAlignment="Center" />
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*" />
                                    <RowDefinition Height="5*" />
                                </Grid.RowDefinitions>
                                <RepeatButton x:Name="upbutton" IsTabStop="False" Visibility="{Binding ShowArrowButtons, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding Path=UpCommand, RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="0" Margin="0,-1,-1,0"  Style="{StaticResource RepeatButtonStyle}" Width="17" HorizontalAlignment="Right">
                                    <Path Stretch="Uniform" x:Name="upbuttonpath" Width="6" Fill="{StaticResource GlyphBrushKey}" Data="F1 M 541.537,173.589L 531.107,173.589L 536.322,167.49L 541.537,173.589 Z " HorizontalAlignment="Center"  VerticalAlignment="Center" />
                                </RepeatButton>
                                <RepeatButton x:Name="downbutton" IsTabStop="False" Visibility="{Binding ShowArrowButtons, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding Path=DownCommand, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,-1,-1,-1" Grid.Row="1" Style="{StaticResource RepeatButtonStyle}" Width="17" HorizontalAlignment="Right">
                                    <Path Stretch="Uniform" x:Name="downbuttonpath" Fill="{StaticResource GlyphBrushKey}" Width="6" Data="F1 M 531.107,321.943L 541.537,321.943L 536.322,328.042L 531.107,321.943 Z " HorizontalAlignment="Center"  VerticalAlignment="Center" />
                                </RepeatButton>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="1,8" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Width" TargetName="upbutton" Value="40" />
                            <Setter Property="Width" TargetName="downbutton" Value="40" />
                            <Setter Property="Height" TargetName="upbutton" Value="25" />
                            <Setter Property="Height" TargetName="downbutton" Value="25" />
                            <Setter Property="Width" TargetName="upbuttonpath" Value="12" />
                            <Setter Property="Width" TargetName="downbuttonpath" Value="12" />
                            <Setter Property="Height" TargetName="downbuttonpath" Value="8" />
                            <Setter Property="Height" TargetName="upbuttonpath" Value="8" />
                            <Setter Property="EnableTouch" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TransparentTimeSpanEditStyle}" TargetType="{x:Type local:TimeSpanEdit}" />
</ResourceDictionary>