        <GradientStop Color="#FFFDDD81" Offset="0.047" />
        <GradientStop Color="#FFFEE287" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlueButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC2762B" Offset="0" />
        <GradientStop Color="#FFC29E47" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlueButtonInnerBorderPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF6C867" Offset="0" />
        <GradientStop Color="#FFFAD77A" Offset="1" />
