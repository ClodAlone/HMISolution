    <SolidColorBrush x:Key="Office2010BlueTextboxFocusedBorderBrush" Color="#FFEB8900" />

    <SolidColorBrush x:Key="ReadOnlyForeground" Color="#FF808080" />

    <SolidColorBrush x:Key="Office2010BlueMouseOverBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFEDF5FD" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#FFCEDDED" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="LightGray" />

    <SolidColorBrush x:Key="ReadOnlyBackground" Color="#FFF3F3F3" />
