    <!-- Button Brushes -->

    <LinearGradientBrush x:Key="Office2010BlueButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE1EDFA" Offset="0.084" />
        <GradientStop Color="#FFD2E0EF" Offset="0.87" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlueButtonBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFABBAD0" Offset="0" />
        <GradientStop Color="#FFABBAD0" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueButtonForeground" Color="#FF1E395B" />

    <!-- MousOver and Pressed States-->

    <LinearGradientBrush x:Key="Office2010BlueButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF7E8A7" Offset="0.046" />
        <GradientStop Color="#FFF7DF86" Offset="0.368" />
        <GradientStop Color="#FFF7E394" Offset="0.685" />
        <GradientStop Color="#FFF9F6DD" Offset="0.957" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2010BlueButtonMouseOverBorderBrush" Color="#FFEAC656" />

    <LinearGradientBrush x:Key="Office2010BlueButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
