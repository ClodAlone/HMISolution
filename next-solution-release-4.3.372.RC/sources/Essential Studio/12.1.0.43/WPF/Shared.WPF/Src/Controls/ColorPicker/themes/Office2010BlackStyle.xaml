                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                        <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="syncfusion:SkinStorage.EnableTouch" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Office2010BlackTextBoxMouseOverBorderBrush}" />
                            <Setter Property="Background" TargetName="Bd" Value="{StaticResource Office2010BlackTextBoxMouseOverBackground}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Office2010BlackTextBoxFocusedBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Brushes -->
    <LinearGradientBrush x:Key="Office2010BlackButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFB3B3B3" Offset="0.139" />
        <GradientStop Color="#FFA1A1A1" Offset="0.968" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlackButtonBorderBrush" Color="#FF6A6A6A" />

    <SolidColorBrush x:Key="Office2010BlackButtonForeground" Color="White" />

    <LinearGradientBrush x:Key="Office2010BlackButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFECDB98" Offset="0.043" />
        <GradientStop Color="#FFECD279" Offset="0.369" />
        <GradientStop Color="#FFEED885" Offset="0.637" />
        <GradientStop Color="#FFF3E7B0" Offset="0.751" />
        <GradientStop Color="#FFF6F3D9" Offset="0.967" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlackButtonMouseOverBorderBrush" Color="#FFDEB745" />

    <LinearGradientBrush x:Key="Office2010BlackButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
