        <GradientStop Color="#FFFDDD81" Offset="0.047" />
        <GradientStop Color="#FFFEE287" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlackButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
