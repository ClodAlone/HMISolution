                                    <Border Grid.Row="5" Margin="-2,4,-2,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0.5,0,0" Name="GridBorder"  Background="Transparent" Grid.ColumnSpan="4">
                                        <Grid>
