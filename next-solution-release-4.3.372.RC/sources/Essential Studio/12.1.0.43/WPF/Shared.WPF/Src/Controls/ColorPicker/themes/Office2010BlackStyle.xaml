            <Trigger  Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office2010BlackPopupMouseOverBackground}" />
                <Setter Property="BorderBrush" TargetName="innerBorder" Value="White" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Office2010BlackPopupMouseOverBorderBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
