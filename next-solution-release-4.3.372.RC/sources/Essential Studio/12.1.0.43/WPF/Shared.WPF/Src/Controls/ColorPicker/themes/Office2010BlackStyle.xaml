                                        <TextBox Grid.Column="2" Grid.Row="1" Margin="1,1,1,1" Name="Gval" Text="{Binding G, Converter={StaticResource FloatToString}, RelativeSource={RelativeSource TemplatedParent},UpdateSourceTrigger=PropertyChanged}" />
