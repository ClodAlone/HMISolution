<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Shared">

    <LinearGradientBrush x:Key="ButtonPressedOuterBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE072" Offset="0.026"/>
        <GradientStop Color="#FFFFD96C" Offset="0.853"/>
        <GradientStop Color="#FFFFF37F" Offset="0.993"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonPressedOuterBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC28A30" Offset="0"/>
        <GradientStop Color="#FFC2A44D" Offset="1"/>
    </LinearGradientBrush>


    <LinearGradientBrush x:Key="ButtonPressedInnerBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE072" Offset="0.026"/>
        <GradientStop Color="#FFFFD96C" Offset="0.853"/>
        <GradientStop Color="#FFFFF37F" Offset="0.993"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonPressedInnerBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC28A30" Offset="0"/>
        <GradientStop Color="#FFC2A44D" Offset="1"/>
    </LinearGradientBrush>


    <RadialGradientBrush x:Key="HoverBrush" Center="0.488,1.016" GradientOrigin="0.488,1.016" RadiusY="0.176" RadiusX="0.675">
        <GradientStop Color="White"/>
        <GradientStop Offset="0.987"/>
    </RadialGradientBrush>

    <LinearGradientBrush  x:Key="ButtonHoverInnerBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFBEDB3"/>
        <GradientStop Color="#FFFAE188" Offset="0.181"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="InnerRectangleBackground" Center="0.488,1.016" GradientOrigin="0.488,1.016" RadiusY="0.176" RadiusX="0.675">
        <GradientStop Color="White"/>
        <GradientStop Offset="0.987"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="ButtonHoverInnerBrush" Center="0.487,0.995" GradientOrigin="0.54,0.972" RadiusX="0.587" RadiusY="0.219">
        <GradientStop Offset="1" Color="#00FDE38A"/>
        <GradientStop Color="White" Offset="0.005"/>
    </RadialGradientBrush>


    <SolidColorBrush x:Key="ButtonHoverOuterBorderBrush" Color="#FFF7C840"/>

    <SolidColorBrush x:Key="ButtonHoverInnerBorderBrush" Color="#FFFFFFFF"/>


    <local:StringToVisibility x:Key="strconv"/>

    <local:CountToVisibilityConverter x:Key="countconv"/>

   <!--<ContextMenu x:Key="UnpinContextMenu">
        <MenuItem Header="Pin to list" Command="{x:Static local:PinnableListBoxItem.PinCommand}"/>
        <MenuItem Header="_Remove from list" Command="{x:Static local:PinnableListBoxItem.RemoveCommand}"/>
        <MenuItem Header="Cl_ear unpinned Documents" Command="{x:Static local:PinnableListBoxItem.ClearCommand}"/>
    </ContextMenu>-->

    <Style x:Key="Office2010BluePinnableListBoxStyle" TargetType="{x:Type local:PinnableListBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PinnableListBox}">
                    <Grid x:Name="PART_Grid">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Header}" Margin="2" FontWeight="Bold"/>

                                <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" StrokeDashArray="1.7"
                                      Stroke="#FF4D4949" StrokeThickness="1" Margin="2" Grid.Row="1" Stretch="Uniform" Opacity="0.3"
                                      Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource strconv}}"/>

                                <ScrollViewer Grid.Row="2" Margin="2" Padding="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <local:PinnableItemsControl ItemsSource="{Binding PinnedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    x:Name="PART_PinnedItems" IsPinnedContainer="True">

                                        </local:PinnableItemsControl>

                                        <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" StrokeDashArray="1.7"
                                                  Stroke="#FF4D4949" StrokeThickness="1" Margin="2" Grid.Row="1" Stretch="Uniform" Opacity="0.3"
                                                  x:Name="pinline" 
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PinnedItems.Count, Converter={StaticResource countconv}}"/>

                                        <local:PinnableItemsControl Grid.Row="2" ItemsSource="{Binding UnpinnedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    x:Name="PART_UnpinnedItems">

                                        </local:PinnableItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BluePinnableListBoxStyle}" TargetType="{x:Type local:PinnableListBox}"/>

    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OuterBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            >
                            <Grid >
                                <Rectangle x:Name="InnerPath" RadiusX="3" RadiusY="3"/>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{StaticResource InnerRectangleBackground}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="{StaticResource ButtonHoverInnerBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonHoverInnerBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonHoverOuterBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonPressedOuterBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonPressedOuterBackgroundBrush}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="{StaticResource ButtonPressedOuterBackgroundBrush}"/>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{StaticResource ButtonPressedOuterBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>

        </Setter>
    </Style>

    <Style x:Key="Office2010BluePinnableListBoxItemStyle" TargetType="{x:Type local:PinnableListBoxItem}">
        <Setter Property="Padding" Value="2"/>
        <!--<Setter Property="ContextMenu" Value="{StaticResource UnpinContextMenu}"/>-->
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PinnableListBoxItem}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OuterBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            >
                            <Border x:Name="InnerBorder" SnapsToDevicePixels="True">
                             <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Rectangle x:Name="InnerPath" RadiusX="3" RadiusY="3" Grid.RowSpan="2" Grid.Column="1"/>
                                <Grid  Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{TemplateBinding Icon}" Grid.RowSpan="2" Margin="2 2 18 2"/>
                                    <ContentPresenter VerticalAlignment="Center" Grid.Column="1" Margin="1 2 2 1"/>
                                    <TextBlock TextTrimming="WordEllipsis" Text="{TemplateBinding Description}" Grid.Row="1" Margin="1 1 2 2"
                                               Foreground="Gray" VerticalAlignment="Center" Grid.Column="1"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Description, Converter={StaticResource strconv}}"/>
                                </Grid>
                            </Grid>
                            </Border>
                        </Border>
                        <Button Grid.Column="1" BorderThickness="1" BorderBrush="Transparent"
                                                 Command="{x:Static local:PinnableListBoxItem.PinCommand}" x:Name="pinnedButton"
                                                 Style="{StaticResource ButtonStyle}" Width="20" Padding="0 10">
                            <Image Source="/Syncfusion.Shared.Wpf;component/Controls/PinnableListBox/unpinned.png" Width="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" x:Name="pin"/>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" SourceName="OuterBorder" Value="True"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Fill" TargetName="InnerPath" Value="{StaticResource InnerRectangleBackground}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="{StaticResource ButtonHoverInnerBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonHoverInnerBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonHoverOuterBorderBrush}"/>
                            <Setter Property="Background" TargetName="InnerBorder" Value="{StaticResource ButtonHoverInnerBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Fill" TargetName="InnerPath" Value="{StaticResource InnerRectangleBackground}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="{StaticResource ButtonHoverInnerBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonHoverInnerBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonHoverOuterBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPinned" Value="True">
                            <Setter Property="Source" Value="/Syncfusion.Shared.Wpf;component/Controls/PinnableListBox/pinned.png" TargetName="pin"/>
                        </Trigger>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="1,8,1,8"/>
                            <Setter Property="Width" Value="20" TargetName="pin"/>
                            <Setter Property="Width" Value="45" TargetName="pinnedButton"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>

        </Setter>

    </Style>

    <Style BasedOn="{StaticResource Office2010BluePinnableListBoxItemStyle}" TargetType="{x:Type local:PinnableListBoxItem}"/>


</ResourceDictionary>