    <ControlTemplate x:Key="SkinTemp" TargetType="{x:Type local:ChromelessWindow}">
        <AdornerDecorator x:Name="Part_AdornerDecorator">
            <Border Name="OuterBorder" Margin="{TemplateBinding Margin}"  Background="{StaticResource Blue.OuterBackground}" BorderBrush="{TemplateBinding ResizeBorderBrush}" BorderThickness="{TemplateBinding ResizeBorderThickness}">
                <Border Name="InnerBorder"  Background="{TemplateBinding Background}">
                    <Grid x:Name="RootGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Name="ContentAreaBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.Row="1">
                            <Grid x:Name="ChildGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <local:ResizeGripStyle x:Name="PART_Resizegrip" Style="{TemplateBinding ResizeGripStyle}" HorizontalAlignment="right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False" Cursor="SizeNWSE" Margin="0,0,3,3" />
                                <ContentPresenter Name="contentpresenter" />
                            </Grid>
                        </Border>
                        <Border Name="TitleBarBorder"   Grid.Row="0">
                            <local:TitleBar VerticalAlignment="Top" Template="{TemplateBinding TitleBarTemplate}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding TitleBarBackground}" Name="PART_TitleBar">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--<StackPanel Orientation="Horizontal">-->
                                    <Image x:Name="PART_Icon" Grid.Column="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Source="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=Icon}" VerticalAlignment="Center"  HorizontalAlignment="Left" Margin="4,4,2,4"  MaxWidth="16" MaxHeight="16" MinWidth="16" MinHeight="16"
                                               Visibility="{Binding Path=ShowIcon, Converter={StaticResource BooleanToVisibilityConverter},RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock Focusable="False" Grid.Column="1" Foreground="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=TitleBarForeground}"  Text="{TemplateBinding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChromelessWindow}},  Path=TitleTextAlignment}"
                                                       x:Name="TitlePresenter" Margin="5,5,5,5" />
                                    <!--</StackPanel>-->

                                    <StackPanel x:Name="MinMaxCloseStackPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center">
                                        <local:TitleButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="local:ChromelessWindow.ToggleMinimizedState" x:Name="MinimizeButton"  Template="{TemplateBinding MinimizeButtonTemplate}" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeTooltip}" />
                                        <local:TitleButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="local:ChromelessWindow.ToggleMaximizedState" Visibility="Collapsed" Name="PART_MaximizeButton" Template="{TemplateBinding MaximizeButtonTemplate}"    ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=MaximizeTooltip}" />
                                        <local:TitleButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="local:ChromelessWindow.ToggleMaximizedState" Visibility="Collapsed" Name="PART_RestoreButton" Template="{TemplateBinding RestoreButtonTemplate}"    ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=RestoreTooltip}" />
                                        <local:TitleButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Command="local:ChromelessWindow.CloseWindow" x:Name="CloseButton" Template="{TemplateBinding CloseButtonTemplate}"   ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseTooltip}" />
                                    </StackPanel>
                                </Grid>
                            </local:TitleBar>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </AdornerDecorator>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Height" Value="50" TargetName="PART_TitleBar" />
                <Setter Property="MinHeight" Value="20" TargetName="PART_Icon" />
                <Setter Property="MaxHeight" Value="20" TargetName="PART_Icon" />
                <Setter Property="MinWidth" Value="20" TargetName="PART_Icon" />
                <Setter Property="MaxWidth" Value="20" TargetName="PART_Icon" />
                <Setter Property="FontSize" Value="18" />
            </Trigger>
            <Trigger Property="UseNativeChrome" Value="False">
                <Setter Property="CornerRadius" TargetName="OuterBorder" Value="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius}" />
                <Setter Property="CornerRadius" TargetName="InnerBorder" Value="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius}" />
                <Setter Property="CornerRadius" TargetName="TitleBarBorder" Value="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius}" />
                <Setter Property="CornerRadius" TargetName="ContentAreaBorder" Value="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius}" />
            </Trigger>
            <Trigger Property="ResizeMode" Value="NoResize">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MinimizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_RestoreButton" />
                <Setter Property="ResizeBorderThickness" Value="1" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanMinimize" />
                    <Condition Property="WindowState" Value="Normal" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_RestoreButton" />
                <Setter Property="IsEnabled" Value="False" TargetName="PART_MaximizeButton" />
                <Setter Property="IsEnabled" Value="False" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanMinimize" />
                    <Condition Property="WindowState" Value="Maximized" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" TargetName="PART_RestoreButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_MaximizeButton" />
                <Setter Property="IsEnabled" Value="False" TargetName="PART_MaximizeButton" />
                <Setter Property="IsEnabled" Value="False" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanResize" />
                    <Condition Property="WindowState" Value="Normal" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" TargetName="MinimizeButton" />
                <Setter Property="Visibility" Value="Visible" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanResize" />
                    <Condition Property="WindowState" Value="Maximized" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" TargetName="MinimizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Visible" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                    <Condition Property="WindowState" Value="Normal" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" TargetName="PART_Resizegrip" />
                <Setter Property="Visibility" Value="Visible" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                    <Condition Property="WindowState" Value="Maximized" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_Resizegrip" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Visible" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="NoResize" />
                    <Condition Property="WindowState" Value="Maximized" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" TargetName="MinimizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_MaximizeButton" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="PART_RestoreButton" />
            </MultiTrigger>

            <Trigger Property="local:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" TargetName="OuterBorder" Value="#FF333333" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="WindowStyle" Value="None" />
                    <Condition Property="WindowState" Value="Maximized" />
                    <Condition Property="HideTaskBar" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" TargetName="TitleBarBorder" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MinimizeBlend" TargetType="{x:Type Button}">
        <Border Name="minborder"   BorderThickness=".5" CornerRadius="2" Background="Transparent" Margin="0,2,0,0" Height="25" Width="25">
            <Image x:Name="minimize" Source="{StaticResource minimizewhite}"  Width="22" Height="15" Margin="0,5,0,0" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Width" TargetName="minborder" Value="30" />
                <Setter Property="Height" TargetName="minborder" Value="28" />
                <Setter Property="Width" Value="30" TargetName="minimize" />
                <Setter Property="Height" Value="20" TargetName="minimize" />
                <Setter Property="Margin" Value="0,6,0,0" TargetName="minimize" />
                <Setter Property="Margin" TargetName="minborder" Value="0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="minimize" Property="Source" Value="{StaticResource MinimizeHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="minimize" Property="Source" Value="{StaticResource MinimizeHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RestoreBlend" TargetType="{x:Type Button}">
        <Border Name="resborder"   BorderThickness=".5" CornerRadius="2" Background="Transparent" Margin="0,2,0,0" Height="25" Width="25">
            <Image x:Name="restore" Source="{StaticResource restorewhite}"  Width="22" Height="15" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Width" TargetName="resborder" Value="30" />
                <Setter Property="Height" TargetName="resborder" Value="28" />
                <Setter Property="Width" Value="30" TargetName="restore" />
                <Setter Property="Height" Value="20" TargetName="restore" />
                <Setter Property="Margin" TargetName="resborder" Value="0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="restore" Property="Source" Value="{StaticResource RestoreHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="restore" Property="Source" Value="{StaticResource RestoreHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MaximizeBlend" TargetType="{x:Type Button}">
        <Border Name="maxborder" BorderThickness=".5" CornerRadius="2" Background="Transparent" Margin="0,2,0,0" Height="25" Width="25">
            <Image x:Name="maximize" Source="{StaticResource maximizewhite}" Width="16" Height="13" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Width" TargetName="maxborder" Value="30" />
                <Setter Property="Height" TargetName="maxborder" Value="28" />
                <Setter Property="Width" Value="30" TargetName="maximize" />
                <Setter Property="Height" Value="20" TargetName="maximize" />
                <Setter Property="Margin" TargetName="maxborder" Value="0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="maximize" Property="Source" Value="{StaticResource MaximizeHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="maximize" Property="Source" Value="{StaticResource MaximizeHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="CloseBlend" TargetType="{x:Type Button}">
        <Border Name="closeborder" BorderThickness=".5" CornerRadius="2" Background="Transparent" Height="25" Width="25" Margin="0,2,4,0">
            <Image x:Name="close" Source="{StaticResource closewhite}" Width="22" Height="15" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Width" TargetName="closeborder" Value="30" />
                <Setter Property="Height" TargetName="closeborder" Value="28" />
                <Setter Property="Width" Value="30" TargetName="close" />
                <Setter Property="Height" Value="20" TargetName="close" />
                <Setter Property="Margin" TargetName="closeborder" Value="0,0,4,0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="local:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="close" Property="Source" Value="{StaticResource CloseHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="close" Property="Source" Value="{StaticResource CloseHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="BlendTitleBarTemplate" TargetType="{x:Type local:TitleBar}">
        <Border Name="border"  Height="30" CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius,Converter={StaticResource CRConvert},ConverterParameter=Top}"  Background="{StaticResource Blend_ContentAreaBackground}">
            <Border BorderBrush="Black" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1"  CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor,  AncestorType={x:Type local:ChromelessWindow}}, Path=CornerRadius,Converter={StaticResource CRConvert},ConverterParameter=Top}" Width="Auto">
                <ContentPresenter x:Name="content" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"  Margin="0,0,0,0" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="local:SkinStorage.EnableTouch" Value="true">
                <Setter TargetName="content" Property="VerticalAlignment" Value="Center" />
                <Setter TargetName="border" Property="Height" Value="50" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <SolidColorBrush Color="#FF717171" x:Key="BlendTitleBarInActiveBackground" />
    <Style x:Key="BlendChromelessWindowStyle" TargetType="{x:Type local:ChromelessWindow}">
        <!--<Setter Property="AllowsTransparency" Value="true" />-->
        <Setter Property="ResizeGripStyle" Value="{StaticResource ResizeStyle}" />
        <Setter Property="ResizeBorderThickness" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Icon" Value="..\Resources\app.png" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="MinHeight" Value="40" />

        <Setter Property="TitleBarBackground" Value="{StaticResource Blend_ContentAreaBackground}" />
        <Setter Property="Background" Value="{StaticResource BlendContentArea}" />
        <Setter Property="ResizeBorderBrush" Value="{StaticResource BlendBorderBrush}" />
        <Setter Property="MinimizeButtonTemplate" Value="{StaticResource MinimizeBlend}" />
        <Setter Property="MaximizeButtonTemplate" Value="{StaticResource MaximizeBlend}" />
        <Setter Property="RestoreButtonTemplate" Value="{StaticResource RestoreBlend}" />
        <Setter Property="CloseButtonTemplate"  Value="{StaticResource CloseBlend}" />
        <Setter Property="TitleBarTemplate" Value="{StaticResource BlendTitleBarTemplate}" />
        <Setter Property="TitleBarForeground" Value="{StaticResource White}" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="Template" Value="{StaticResource SkinTemp}" />
        <Style.Triggers>
            <Trigger Property="SizeToContent" Value="Width">
                <Setter Property="MinWidth" Value="190"></Setter>
            </Trigger>
            <Trigger Property="SizeToContent" Value="WidthAndHeight">
                <Setter Property="MinWidth" Value="190"></Setter>
            </Trigger>
            <Trigger Property="IsActive" Value="False">
                <Setter Property="TitleBarForeground" Value="#FFA7ABB1" />
                <Setter Property="TitleBarBackground" Value="{StaticResource BlendTitleBarInActiveBackground}" />
            </Trigger>
            <Trigger Property="UseNativeChrome" Value="False">
                <Setter Property="WindowStyle" Value="None" />
            </Trigger>
         </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource BlendChromelessWindowStyle}" TargetType="{x:Type local:ChromelessWindow}" />
</ResourceDictionary>