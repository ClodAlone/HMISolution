<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Shared">

    <SolidColorBrush x:Key="PinnedListBoxBorderBrush" Color="#FF6593CF"/>

    <SolidColorBrush x:Key="PinnedListBoxBackground" Color="#FFDEEBFE"/>

    <SolidColorBrush x:Key="PinnableListBoxForeground" Color="#FF000000"/>

    <LinearGradientBrush x:Key="ButtonHoverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFDEC" Offset="0.036"/>
        <GradientStop Color="#FFFFEEB7" Offset="0.448"/>
        <GradientStop Color="#FFFFD66A" Offset="0.509"/>
        <GradientStop Color="#FFFFE497" Offset="0.939"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#FFDBCF9A"/>

    <LinearGradientBrush x:Key="ButtonPressedBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF3C799" Offset="0.011"/>
        <GradientStop Color="#FFFCD3A7" Offset="0.013"/>
        <GradientStop Color="#FFFAA85B" Offset="0.371"/>
        <GradientStop Color="#FFF98E2A" Offset="0.373"/>
        <GradientStop Color="#FFFCDF94" Offset="0.939"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ButtonPressedBorderBrush" Color="#FF8E8165"/>


    <local:StringToVisibility x:Key="strconv"/>

    <local:CountToVisibilityConverter x:Key="countconv"/>

    <!--<ContextMenu x:Key="UnpinContextMenu">
        <MenuItem Header="Pin to list" Command="{x:Static local:PinnableListBoxItem.PinCommand}"/>
        <MenuItem Header="_Remove from list" Command="{x:Static local:PinnableListBoxItem.RemoveCommand}"/>
        <MenuItem Header="Cl_ear unpinned Documents" Command="{x:Static local:PinnableListBoxItem.ClearCommand}"/>
    </ContextMenu>-->

    <Style x:Key="Office2007BluePinnableListBoxStyle" TargetType="{x:Type local:PinnableListBox}">
        <Setter Property="Background" Value="{StaticResource PinnedListBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PinnedListBoxBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PinnableListBoxForeground}"/>     
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PinnableListBox}">
                    <Grid x:Name="PART_Grid">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Header}" Margin="2" FontWeight="Bold"/>
                                <StackPanel Grid.Row="1">
                                   <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" 
                                      Stroke="#FFDCDCDC" StrokeThickness="1" Margin="2,0" Grid.Row="1" Stretch="Uniform"
                                      Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource strconv}}"/>
                                    <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" 
                                      Stroke="#FFF5F5F5" StrokeThickness="1" Margin="2,0" Grid.Row="1" Stretch="Uniform" 
                                      Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource strconv}}"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="2" Margin="2" Padding="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <local:PinnableItemsControl ItemsSource="{Binding PinnedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    x:Name="PART_PinnedItems" IsPinnedContainer="True">

                                        </local:PinnableItemsControl>

                                        <Line HorizontalAlignment="Stretch" X1="0" Y1="0" X2="1" Y2="0" Height="1" StrokeDashArray="1.7"
                                                  Stroke="#FF4D4949" StrokeThickness="1" Margin="2" Grid.Row="1" Stretch="Uniform" Opacity="0.3"
                                                  x:Name="pinline" 
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=PinnedItems.Count, Converter={StaticResource countconv}}"/>

                                        <local:PinnableItemsControl Grid.Row="2" ItemsSource="{Binding UnpinnedItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    x:Name="PART_UnpinnedItems">

                                        </local:PinnableItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>                
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style BasedOn="{StaticResource Office2007BluePinnableListBoxStyle}" TargetType="{x:Type local:PinnableListBox}"/>

    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OuterBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            >
                            <Grid >
                                <Rectangle x:Name="InnerPath" RadiusX="3" RadiusY="3"/>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonHoverBorderBrush}"/>
                            <Setter Property="Stroke" TargetName="InnerPath" Value="#FFFFF7B4"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonPressedBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>

        </Setter>
    </Style>

    <Style x:Key="Office2007BluePinnableListBoxItemStyle" TargetType="{x:Type local:PinnableListBoxItem}">
        <Setter Property="Padding" Value="2"/>
        <!--<Setter Property="ContextMenu" Value="{StaticResource UnpinContextMenu}"/>-->
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PinnableListBoxItem}">
                    <Border x:Name="OuterBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            >
                        <Border x:Name="InnerPath" CornerRadius="3" BorderThickness="1">
                        <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>                               
                                <Grid  Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{TemplateBinding Icon}" Grid.RowSpan="2" Margin="2 2 18 2"/>
                                    <ContentPresenter VerticalAlignment="Center" Grid.Column="1" Margin="1 2 2 1"/>
                                    <TextBlock TextTrimming="WordEllipsis" Text="{TemplateBinding Description}" Grid.Row="1" Margin="1 1 2 2"
                                               Foreground="Gray" VerticalAlignment="Center" Grid.Column="1"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Description, Converter={StaticResource strconv}}"/>
                                </Grid>
                            </Grid>                       
                        <Button Grid.Column="1" BorderThickness="1" BorderBrush="Transparent" x:Name="pinnedButton" Background="Transparent"
                                                 Command="{x:Static local:PinnableListBoxItem.PinCommand}"
                                                 Style="{StaticResource ButtonStyle}" Width="30">
                            <Image Source="/Syncfusion.Shared.Wpf;component/Controls/PinnableListBox/unpinned.png" Width="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" x:Name="pin"/>
                        </Button>                            
                    </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonHoverBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerPath" Value="#FFFFF7B4"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" SourceName="pinnedButton"/>
                                <Condition Property="local:SkinStorage.EnableTouch" Value="False"/>
                            </MultiTrigger.Conditions>                           
                            <Setter Property="Background" TargetName="pinnedButton" Value="{StaticResource ButtonHoverBrush}"/>
                            <Setter Property="BorderBrush" TargetName="pinnedButton" Value="{StaticResource ButtonHoverBorderBrush}"/>
                            <Setter Property="Background" TargetName="OuterBorder" Value="Transparent"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="Transparent"/>
                            <Setter Property="BorderBrush" TargetName="InnerPath" Value="Transparent"/>
                        </MultiTrigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="OuterBorder" Value="{StaticResource ButtonPressedBrush}"/>
                            <Setter Property="BorderBrush" TargetName="OuterBorder" Value="{StaticResource ButtonPressedBorderBrush}"/>
                            <Setter Property="BorderBrush" TargetName="InnerPath" Value="{StaticResource ButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPinned" Value="True">
                            <Setter Property="Source" Value="/Syncfusion.Shared.Wpf;component/Controls/PinnableListBox/pinned.png" TargetName="pin"/>
                        </Trigger>
                        <Trigger Property="local:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="1,7,1,7"/>
                            <Setter Property="Width" Value="20" TargetName="pin"/>
                            <Setter Property="Width" Value="45" TargetName="pinnedButton"/>                            
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>

        </Setter>

    </Style>
    
    <Style BasedOn="{StaticResource Office2007BluePinnableListBoxItemStyle}" TargetType="{x:Type local:PinnableListBoxItem}"/>


</ResourceDictionary>