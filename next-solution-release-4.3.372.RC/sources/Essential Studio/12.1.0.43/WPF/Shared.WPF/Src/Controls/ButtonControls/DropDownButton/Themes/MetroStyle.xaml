<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/MetroThemeBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <SolidColorBrush x:Key="CheckIconPathFillBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="CheckIconBackground" Color="White"/>
    <SolidColorBrush x:Key="CheckIconBorder" Color="#FF333333"/>




   


    <LinearGradientBrush x:Key="ResizeThumbBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE3EFFF" Offset="0.023"/>
        <GradientStop Color="#FFAFD2FF" Offset="0.977"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ResizeThumbBorderBrush" Color="#FF868686"/>

    
    <Style x:Key="MetroDropDownButtonAdvStyle" TargetType="local:DropDownButtonAdv">
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
        <Setter Property="Label" Value="Drop Down Button"/>

        <Setter Property="Background" Value="{DynamicResource MetroBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownButtonAdv">
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">

                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="8,8,8,8"/>

                            <Setter Property="Border.CornerRadius"  TargetName="ItemBorder" Value="0"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder1" Value="0"/>


                    
                            <Setter Property="Image.Height" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Width" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Height" TargetName="SmallImage" Value="20"/>
                            <Setter Property="Image.Width" TargetName="SmallImage" Value="20"/>
                            <Setter Property="Path.Margin" TargetName="Arrow" Value="10,0,6,1"/>
                            <Setter Property="Path.Data" TargetName="Arrow" Value="M 0 0 L 7 7 L 14 0 Z"/>
                          
                            <Setter Property="Border.Margin" TargetName="PART_Text" Value="5,0,0,0"/>

                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" Value="true"/>

                            </MultiTrigger.Conditions>
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroHoverBrush}"/>

                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroHoverBrush}"/>


                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" Value="true"/>

                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{DynamicResource MetroBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{DynamicResource MetroFocusedBrush}"/>
                            <Setter Property="TextBlock.Foreground" TargetName="PART_Text" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <Setter Property="TextBlock.Foreground" TargetName="PART_TextAreaLarge" Value="{DynamicResource MetroHighlightedForegroundBrush}"/>
                            <!--<Setter Property="Foreground"  Value="{DynamicResource MetroHighlightedForegroundBrush}"/>-->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                            <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>

                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True" >
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Name="PART_ImageBorder" Grid.Column="0">
                                    <Image Margin="2"
						            Width="16" Height="16"   x:Name="SmallImage"
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                           Margin="2,0,4,0"/>
                                <Path Grid.Column="2" HorizontalAlignment="Center" Name="Arrow" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M 0 0 L 4 4 L 8 0 Z" Margin="2,1,2,1"/>

                            </Grid>
                        </Border>
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True" >
                            <StackPanel Margin="{TemplateBinding Padding}">
                                <Border Name="PART_ImageBorderLarge">
                                    <Image Margin="2" x:Name="LargeImage"
                                    Width="26" Height="26" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}" 
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <ItemsControl x:Name="PART_TextAreaLarge"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               Margin="2,0,4,0">
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                <Border Background="{DynamicResource MetroPanelBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource MetroBorderBrush}" >
                                    <Border Background="{DynamicResource MetroPanelBackgroundBrush}" BorderThickness="0" BorderBrush="{DynamicResource MetroBorderBrush}" >
                                        <ContentPresenter/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource MetroDropDownButtonAdvStyle}" TargetType="local:DropDownButtonAdv"/>
    <SolidColorBrush Color="#FFD8D8D9" x:Key="meugroupheaderbackgroundbrush"/>
    <Style x:Key="MetroDropDownMenuGroupStyle" TargetType="local:DropDownMenuGroup">
        <Setter Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownMenuGroup">
                    <Grid Name="gri" Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextConverter"/>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="PART_Header" Background="{DynamicResource MetroBackgroundBrush}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="20" Grid.Row="0" BorderThickness="0" BorderBrush="{DynamicResource  MetroBorderBrush}" HorizontalAlignment="Stretch" >
                            <ContentControl x:Name="header" Content="{TemplateBinding Header}" Foreground="{TemplateBinding   Foreground}" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Left" Margin="5,0,0,0"/>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>

                                <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}" BorderBrush="{DynamicResource MetroBorderBrush}" Background="{DynamicResource  MetroPanelBackgroundBrush}" BorderThickness="0,0,1,0" Width="23" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                                <Border Margin="1,0,0,0">
                                    <ScrollViewer x:Name="PART_ScrollViewer" KeyboardNavigation.DirectionalNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                        <ItemsPresenter Margin="0,0,0,0"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" BorderBrush="{DynamicResource  MetroBorderBrush}" Background="{DynamicResource  MetroPanelBackgroundBrush}" BorderThickness="0,0,2,0" Width="22" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                                <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Background="{DynamicResource MetroPanelBackgroundBrush}" BorderBrush="{DynamicResource MetroBorderBrush}" BorderThickness="0,1,0,0" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                            <Grid>
                                <Border HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="Transparent"  Height="3" Width="3"/>

                                        <Border  Background="#FFC7C7C7" Height="3" Width="3" Margin="-5,0,0,0" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>

                                        <Border  Background="#FFC7C7C7" Height="3" Width="3"  Margin="-5,0,0,0" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                        <Border  Background="#FFC7C7C7" Height="3" Width="3"  Margin="-5,0,0,0" SnapsToDevicePixels="True"/>
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                            <Setter Property="Margin" TargetName="PART_ScrollViewer" Value="1,0,1,-1"/>
                            <Setter Property="Margin" TargetName="header" Value="10,3,0,3"/>
                            <Setter Property="Width" TargetName="IconTray" Value="32"/>
                            <Setter Property="Background" TargetName="IconTray" Value="Transparent"/>
                            <Setter Property="BorderBrush" TargetName="IconTray" Value="Transparent"/>

                            <Setter Property="Height" TargetName="PART_Header" Value="30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource MetroDropDownMenuGroupStyle}" TargetType="local:DropDownMenuGroup"/>

    <Style x:Key="MetroDropDownMenuItemStyle" TargetType="local:DropDownMenuItem">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownMenuItem">
                    <Border  Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Margin="3,0,3,0">
                        <Grid Margin="0" x:Name="contentgrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            </Grid.Resources>
                            <Border Grid.Column="1"  Background="Transparent">
                                <ContentControl Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" ContentTemplate="{TemplateBinding HeaderTemplate}"  Name="content" Content="{TemplateBinding Header}" Margin="0" Background="Transparent"/>
                            </Border>
                            <Border Grid.Column="2" Background="Transparent">
                                <ContentControl VerticalAlignment="Center"  Name="path" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Margin="3" FontSize="14"/>
                            </Border>

                            <Border Margin="2"  Background="Transparent">
                                <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                            </Border>

                            <Border Height="18" SnapsToDevicePixels="True"  Width="18" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" Background="{StaticResource CheckIconBackground}" BorderBrush="{StaticResource CheckIconBorder}" BorderThickness="1">
                                <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource CheckIconPathFillBrush}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                            </Border>

                            <Popup VerticalOffset="1" IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver, Mode=OneWay}" Margin="2,0,0,0" Placement="Right" AllowsTransparency="True" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                                <Grid x:Name="PART_poup">
                                    <Border  Width="{Binding Path=ActualWidth,ElementName=contentgrid}" Background="{DynamicResource  MetroPanelBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource  MetroBorderBrush}" SnapsToDevicePixels="True">
                                        <ItemsPresenter Margin="2"/>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Border.Background" TargetName="Bd" Value="{DynamicResource  MetroBrush}"/>

                            <Setter Property="Foreground"  TargetName="content" Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                            <Setter Property="Foreground"  TargetName="path" Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                            <Setter Property="Foreground"  Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:DropDownMenuItem">
                            <Border  Name="Bd" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" >
                                <Grid Margin="0" x:Name="contentgrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                    </Grid.Resources>
                                    <Border Grid.Column="1"  Background="Transparent">
                                        <ContentControl Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"  Name="content" Content="{TemplateBinding Header}" Margin="0" Background="Transparent"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="Transparent">
                                        <ContentControl VerticalAlignment="Center"  Name="path" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Margin="3" FontSize="20"/>
                                    </Border>

                                    <Border Margin="2"  Background="Transparent">
                                        <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="20" Width="20" Margin="1"/>
                                    </Border>

                                    <Border Height="24" SnapsToDevicePixels="True"  Width="24" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" Background="{StaticResource CheckIconBackground}" BorderBrush="{StaticResource CheckIconBorder}" BorderThickness="1">
                                        <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource CheckIconPathFillBrush}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                    </Border>

                                    <Popup VerticalOffset="1" IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver, Mode=OneWay}" Margin="2,0,0,0" Placement="Right" AllowsTransparency="True" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                                        <Grid x:Name="PART_poup">
                                            <Border  Width="{Binding Path=ActualWidth,ElementName=contentgrid}" Background="{DynamicResource  MetroPanelBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource  MetroBorderBrush}" SnapsToDevicePixels="True">
                                                <ItemsPresenter Margin="0,0,0,-1"/>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Border.Background" TargetName="Bd" Value="{DynamicResource  MetroBrush}"/>

                                    <Setter Property="Foreground"  TargetName="content" Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                                    <Setter Property="Foreground"  TargetName="path" Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                                    <Setter Property="Foreground"  Value="{DynamicResource  MetroHighlightedForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource MetroDropDownMenuItemStyle}" TargetType="local:DropDownMenuItem"/>

</ResourceDictionary>