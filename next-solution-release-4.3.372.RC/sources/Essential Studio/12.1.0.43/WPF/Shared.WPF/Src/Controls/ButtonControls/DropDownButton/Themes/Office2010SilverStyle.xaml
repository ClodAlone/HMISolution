<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skin="clr-namespace:Syncfusion.Windows.Shared" 
                    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <LinearGradientBrush x:Key="ButtonAdvBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFEFEFE" Offset="0"/>
        <GradientStop Color="#FFF7F7F9" Offset="0.677"/>
        <GradientStop Color="#FFF6F7F9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvBorderBrush" Color="#FFB6BABF"/>
    <SolidColorBrush x:Key="ButtonAdvForeground" Color="#FF3B3B3B"/>

    <LinearGradientBrush x:Key="ButtonAdvHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDECA9" Offset="0.037"/>
        <GradientStop Color="#FFFDE68D" Offset="0.532"/>
        <GradientStop Color="#FFFDFAE0" Offset="0.935"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvHoverBorderBrush" Color="#FFF1CA58"/>
   
    <LinearGradientBrush x:Key="ButtonAdvHoverInnerBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFAE6" Offset="0"/>
        <GradientStop Color="#FFFFFFED" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvHoverForeground" Color="#FF3B3B49"/>

    <LinearGradientBrush x:Key="ButtonAdvPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC2762B" Offset="0"/>
        <GradientStop Color="#FFC29E47" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonAdvPressedInnerBorderBrush" Color="#FFF6C867"/>
    <LinearGradientBrush x:Key="ButtonAdvPressedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF6C867" Offset="0"/>
        <GradientStop Color="#FFFBD678" Offset="0.005"/>
        <GradientStop Color="#FFFFE48A" Offset="0.17"/>
        <GradientStop Color="#FFFEE287" Offset="0.989"/>
        <GradientStop Color="#FFFAD77A" Offset="0.995"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="PopupBorder" Color="#FFA7ABB0"/>  

    <SolidColorBrush x:Key="DropDownMenuGroupHeaderBackground" Color="#FFF0F2F5"/>
    <SolidColorBrush x:Key="DropDownMenuGroupHeaderBorder" Color="Transparent"/>
    <SolidColorBrush x:Key="DropDownMenuGroupHeaderForeground" Color="#FF3B3B3B"/>

    <LinearGradientBrush x:Key="DropDownMenuItemHoverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDECA9" Offset="0.056"/>
        <GradientStop Color="#FFFDE68D" Offset="0.553"/>
        <GradientStop Color="#FFFDFAE0" Offset="0.953"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DropDownMenuItemHoverBorder" Color="#FFF1CA58"/>

    <SolidColorBrush x:Key="DropDownMenuItemSidePanelBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="DropDownMenuItemSidePanelBorderBrush" Color="#FFE2E4E7"/>

    <LinearGradientBrush x:Key="ResizeThumbBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFA5ACB5" Offset="0.008"/>
        <GradientStop Color="#FFF5F7F9" Offset="0.016"/>
        <GradientStop Color="#FFEFF2F6" Offset="0.992"/>
        <GradientStop Color="#FFA5ACB5" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ResizeThumbBorderBrush" Color="#FFA7ABB0"/>


    <SolidColorBrush x:Key="CheckIconPathFillBrush" Color="#FF393D80"/>
    <SolidColorBrush x:Key="CheckIconBackground" Color="#FFFCF1C2"/>
    <SolidColorBrush x:Key="CheckIconBorder" Color="#FFF29536"/>

    <Style x:Key="Office2010SilverDropDownButtonAdvStyle" TargetType="local:DropDownButtonAdv">
        <Setter Property="Foreground" Value="{StaticResource ButtonAdvForeground}" />
        <Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
        <Setter Property="Label" Value="Drop Down Button"/>
        <Setter Property="Background" Value="{StaticResource ButtonAdvBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonAdvBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownButtonAdv">
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">

                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="8,8,8,8"/>

                            <Setter Property="Border.CornerRadius"  TargetName="ItemBorder" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="ItemBorder1" Value="6"/>
                    

                            <Setter Property="Border.CornerRadius" TargetName="InnerBorder" Value="6"/>
                            <Setter Property="Border.CornerRadius" TargetName="InnerBorder1" Value="6"/>
                            <Setter Property="Image.Height" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Width" TargetName="LargeImage" Value="30"/>
                            <Setter Property="Image.Height" TargetName="SmallImage" Value="20"/>
                            <Setter Property="Image.Width" TargetName="SmallImage" Value="20"/>
                            <Setter Property="Path.Margin" TargetName="Arrow" Value="10,3,6,1"/>
                            <Setter Property="Path.Data" TargetName="Arrow" Value="M 0 0 L 7 7 L 14 0 Z"/>
                            <Setter Property="Border.Effect" TargetName="ItemBorder">
                                <Setter.Value>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Border.Effect" TargetName="ItemBorder1">
                                <Setter.Value>
                                    <DropShadowEffect Direction="315" ShadowDepth="2" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Border.Margin" TargetName="PART_Text" Value="5,0,0,0"/>

                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" Value="true"/>

                            </MultiTrigger.Conditions>
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource ButtonAdvHoverBorderBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvHoverBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvHoverBorderBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="InnerBorder" Value="{StaticResource ButtonAdvHoverInnerBorderBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="InnerBorder1" Value="{StaticResource ButtonAdvHoverInnerBorderBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="skin:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" Value="true"/>

                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                            <Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="InnerBorder" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="Border.BorderBrush" TargetName="InnerBorder1" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Border.Opacity" TargetName="ItemBorder" Value="0.5"/>
                            <Setter Property="Border.Opacity" TargetName="ItemBorder1" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>

                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True" CornerRadius="3">
                            <Border Name="InnerBorder" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" CornerRadius="3">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Name="PART_ImageBorder" Grid.Column="0">
                                    <Image Margin="2"
						            Width="16" Height="16"   x:Name="SmallImage"
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                           Margin="2,0,4,0"/>
                                <Path Grid.Column="2" HorizontalAlignment="Center" Name="Arrow" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M 0 0 L 4 4 L 8 0 Z" Margin="2,1,2,1"/>

                            </Grid>
                        </Border>
                        </Border>
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True" CornerRadius="3">
                                <Border Name="InnerBorder1" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" CornerRadius="3">
                                    <StackPanel Margin="{TemplateBinding Padding}">
                                <Border Name="PART_ImageBorderLarge">
                                    <Image Margin="2" x:Name="LargeImage"
                                    Width="26" Height="26" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}" 
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <ItemsControl x:Name="PART_TextAreaLarge"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               Margin="2,0,4,0">
                                </ItemsControl>
                            </StackPanel>
                            </Border>
                        </Border>
                        <Popup x:Name="PART_DropDown" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                <Border Background="{StaticResource PopupBackground}" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}" CornerRadius="0">
                                    <Border Background="{StaticResource PopupBackground}" BorderThickness="0" BorderBrush="{StaticResource PopupBorder}" CornerRadius="1">
                                        <ContentPresenter/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010SilverDropDownButtonAdvStyle}" TargetType="local:DropDownButtonAdv"/>

    <Style x:Key="Office2010SilverDropDownMenuGroupStyle" TargetType="local:DropDownMenuGroup">
        <Setter Property="Background" Value="{StaticResource PopupBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource ButtonAdvForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownMenuGroup">
                    <Grid Name="gri" Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextConverter"/>
                            <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="PART_Header" Background="{StaticResource DropDownMenuGroupHeaderBackground}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="20" Grid.Row="0" BorderThickness="1,1,1,0" BorderBrush="{StaticResource DropDownMenuGroupHeaderBorder}" Margin="0,0,0,1" CornerRadius="3,3,0,0">
                            <ContentControl x:Name="header" Content="{TemplateBinding Header}" Foreground="{StaticResource DropDownMenuGroupHeaderForeground}" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Left" Margin="5,0,0,0"/>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid>
                                <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}" BorderBrush="{StaticResource DropDownMenuItemSidePanelBorderBrush}" Background="{StaticResource DropDownMenuItemSidePanelBackgroundBrush}" BorderThickness="0,0,1,0" Width="22" HorizontalAlignment="Left"/>
                                <Border>
                                    <ScrollViewer x:Name="PART_ScrollViewer" KeyboardNavigation.DirectionalNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                        <ItemsPresenter Margin="-2,0,0,0"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" BorderBrush="{StaticResource DropDownMenuItemSidePanelBorderBrush}" Background="{StaticResource DropDownMenuItemSidePanelBackgroundBrush}" BorderThickness="0,0,2,0" Width="22" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Background="{StaticResource ResizeThumbBackgroundBrush}" BorderBrush="{StaticResource ResizeThumbBorderBrush}" BorderThickness="0,1,0,0" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                            <Grid>
                                <Border HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="White" CornerRadius="2" Height="3" Width="3"/>

                                        <Border  Background="#FF494A4B" CornerRadius="2"  Height="3" Width="3" Margin="-5,0,0,0"/>
                                        <Border Background="White" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>

                                        <Border  Background="#FF494A4B" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                        <Border Background="White" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                        <Border  Background="#FF494A4B" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                            <Setter Property="Margin" TargetName="PART_ScrollViewer" Value="1,0,1,-1"/>
                            <Setter Property="Margin" TargetName="header" Value="10,3,0,3"/>
                            <Setter Property="Width" TargetName="IconTray" Value="32"/>
                            <Setter Property="Background" TargetName="IconTray" Value="Transparent"/>
                            <Setter Property="BorderBrush" TargetName="IconTray" Value="Transparent"/>

                            <Setter Property="Height" TargetName="PART_Header" Value="30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010SilverDropDownMenuGroupStyle}" TargetType="local:DropDownMenuGroup"/>
    <LinearGradientBrush x:Key="Office2010BlueSelectedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE072" Offset="0.101"/>
        <GradientStop Color="#FFFFD86C" Offset="0.449"/>
        <GradientStop Color="#FFFFF480" Offset="0.96"/>
    </LinearGradientBrush>
    <Style x:Key="Office2010SilverDropDownMenuItemStyle" TargetType="local:DropDownMenuItem">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DropDownMenuItem">
                    <Border CornerRadius="2" Name="Bd" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Margin="4,0,2,0">
                        <Grid Margin="0,-1,0,-3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            </Grid.Resources>
                            <Border Grid.Column="1"  Background="Transparent">
                                <ContentControl Name="content" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Margin="6 1 1 1" Background="Transparent"/>
                            </Border>
                            <Border Grid.Column="2" Background="Transparent">
                                <ContentControl Name="path" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Margin="3" FontSize="14"/>
                            </Border>

                            <Border Margin="2" CornerRadius="2" Background="Transparent">
                                <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                            </Border>

                            <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" CornerRadius="2" Background="{StaticResource CheckIconBackground}" BorderBrush="{StaticResource CheckIconBorder}" BorderThickness="1">
                                <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource CheckIconPathFillBrush}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                            </Border>

                            <Popup IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver, Mode=OneWay}" Margin="2,0,0,0" Placement="Right" AllowsTransparency="True" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                                <Grid x:Name="PART_poup">
                                    <Border Background="{StaticResource PopupBackground}" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}" SnapsToDevicePixels="True">
                                        <ItemsPresenter Margin="2"/>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Border.Background" TargetName="Bd" Value="{StaticResource DropDownMenuItemHoverBackground}"/>
                            <Setter Property="Border.BorderBrush" TargetName="Bd" Value="{StaticResource DropDownMenuItemHoverBorder}"/>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="skin:SkinStorage.EnableTouch" Value="true">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource PopupBorder}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:DropDownMenuItem">
                            <Border  Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" >
                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                    </Grid.Resources>
                                    <Border Grid.Column="1"  Background="Transparent">
                                        <ContentControl Name="content" Content="{TemplateBinding Header}" Margin="6 1 1 1" Background="Transparent"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="Transparent">
                                        <ContentControl Name="path" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Margin="3" FontSize="20"/>
                                    </Border>

                                    <Border Margin="2" CornerRadius="2" Background="Transparent">
                                        <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="20" Width="20" Margin="1"/>
                                    </Border>

                                    <Border Width="24" Height="24" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" CornerRadius="2" Background="{StaticResource CheckIconBackground}" BorderBrush="{StaticResource CheckIconBorder}" BorderThickness="1">
                                        <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource CheckIconPathFillBrush}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                    </Border>

                                    <Popup IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver, Mode=OneWay}" Margin="2,0,0,0" Placement="Right" AllowsTransparency="True" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown">
                                        <Grid x:Name="PART_poup">
                                            <Border Background="{StaticResource PopupBackground}" BorderThickness="1" BorderBrush="{StaticResource PopupBorder}" SnapsToDevicePixels="True">
                                                <ItemsPresenter Margin="0,0,0,-1"/>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Office2010BlueSelectedBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Office2010SilverDropDownMenuItemStyle}" TargetType="local:DropDownMenuItem"/>

</ResourceDictionary>