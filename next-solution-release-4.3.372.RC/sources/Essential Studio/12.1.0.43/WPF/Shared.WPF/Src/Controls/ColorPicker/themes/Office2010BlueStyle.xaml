                                                                        <shared:UpDown Visibility="Visible"  Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="gradx" ></shared:UpDown>
                                                                        <shared:UpDown Visibility="Visible"  Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="grady"></shared:UpDown>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="2" Grid.Column="1" Grid.Row="2">
                                                                        <shared:UpDown Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="centrex"></shared:UpDown>
                                                                        <shared:UpDown Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="centrey"></shared:UpDown>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="2" Grid.Column="1" Grid.Row="3">
                                                                        <shared:UpDown Width="75" Height="25" Step="0.01" MinValue="-1" MaxValue="1" Margin="2" Name="radiusx"  ></shared:UpDown>
                                                                        <shared:UpDown Width="75" Height="25" Step="0.01" MinValue="-1" MaxValue="1" Margin="2" Name="radiusy"  ></shared:UpDown>
