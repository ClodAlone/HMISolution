                                                                        <shared:UpDown Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="gradx"  ></shared:UpDown>
                                                                        <shared:UpDown Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="grady"></shared:UpDown>
