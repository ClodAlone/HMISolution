                                                                        <shared:UpDown Width="75" Height="25" Step="0.01" MinValue="-1" MaxValue="1" Margin="2" Name="radiusy" local:SkinStorage.EnableTouch="False" ></shared:UpDown>
                                                                    </StackPanel>
