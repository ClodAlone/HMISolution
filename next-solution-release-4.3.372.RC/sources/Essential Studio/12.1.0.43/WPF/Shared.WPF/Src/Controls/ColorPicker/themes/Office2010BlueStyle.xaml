                                                                    </Grid>

                                                                    <StackPanel Orientation="Horizontal" Margin="2"  Grid.Column="1" Grid.Row="1">
                                                                        <shared:UpDown Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="startx" local:SkinStorage.EnableTouch="False"></shared:UpDown>
                                                                        <shared:UpDown Width="75" Step="0.01" MinValue="-1" MaxValue="1" Height="25" Margin="2" x:Name="starty" local:SkinStorage.EnableTouch="False"></shared:UpDown>
                                                                    </StackPanel>
                                                                    <TextBlock Text="Start Point" FontSize="12"  VerticalAlignment="Center" Margin="8,2,2,2" Grid.Row="1" Grid.Column="0"></TextBlock>
