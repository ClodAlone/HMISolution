                                    <Canvas Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" ClipToBounds="True">
                                        <Path x:Name="SelectorEllipse" Canvas.Left="{Binding Path=SelectorPositionX,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ColorEdit}}}" Canvas.Top="{Binding Path=SelectorPositionY,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ColorEdit}}}" Data="M34.6665,10 C21.043567,10 9.9999997,21.043793 9.9999997,34.667 9.9999997,48.290207 21.043567,59.334 34.6665,59.334 48.289432,59.334 59.333,48.290207 59.333,34.667 59.333,21.043793 48.289432,10 34.6665,10 z M34.6665,0 C53.812278,0 69.333,15.520945 69.333,34.667 69.333,53.813057 53.812278,69.334 34.6665,69.334 15.52072,69.334 -3.2269691E-07,53.813057 0,34.667 -3.2269691E-07,15.520945 15.52072,0 34.6665,0 z" Fill="{Binding Path=Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToBrush}}" Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="0.5" Visibility="Collapsed" Height="90" Width="90">
                                            <Path.Effect>
                                                <DropShadowEffect Direction="294" ShadowDepth="2" Opacity="0.155" />
