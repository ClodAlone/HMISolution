                                    <Slider Grid.Column="1" Grid.Row="3" Name="AlphaSlider"   Style="{StaticResource Slider_CustomStyle}" Background="{TemplateBinding BackgroundA}" Value="{Binding Path=A, RelativeSource={RelativeSource TemplatedParent}}" />
