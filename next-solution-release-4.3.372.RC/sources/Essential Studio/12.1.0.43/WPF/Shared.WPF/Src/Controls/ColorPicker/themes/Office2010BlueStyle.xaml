                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3.5*" />
                                                                        <ColumnDefinition Width="6.5*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Grid.Column="1" Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="75" />
                                                                            <ColumnDefinition Width="75" />
