                                                    <ToggleButton Name="PopButton" BorderBrush="{DynamicResource MetroBorderBrush}" BorderThickness="1" Background="{DynamicResource MetroPanelBackground}" Template="{StaticResource TogglePopupButtonTemplate}" Margin="0,2,0,0" ClickMode="Press" Height="14" HorizontalAlignment="Stretch">
                                                    </ToggleButton>

                                                    <Popup Name="GradPopup" PopupAnimation="Slide" AllowsTransparency="True" MinWidth="230" StaysOpen="True" Width="230"
					   IsOpen="{Binding ElementName= PopButton, Path=IsChecked}">
