                                                                        <shared:UpDown Width="70" Step="0.01" MinValue="-1" MaxValue="1" Height="25"  x:Name="grady" Margin="1"></shared:UpDown>
                                                                    </StackPanel>
                                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="2" Grid.Column="1" Grid.Row="2">
