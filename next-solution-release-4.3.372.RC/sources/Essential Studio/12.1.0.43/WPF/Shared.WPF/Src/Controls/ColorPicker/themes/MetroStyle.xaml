                                                <Rectangle x:Name="SelectedColor" Margin="0,0.5,0,0.5"  Fill="{Binding Path=Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToBrush}}" RadiusX="0" RadiusY="0" />
                                            </Grid>

                                            <Grid Grid.Column="1" Grid.Row="1" Margin="0">
                                                <Border CornerRadius="0" BorderThickness="0" SnapsToDevicePixels="True">
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush EndPoint="0.71,0.997" StartPoint="0.71,0.846">
                                                            <GradientStop Color="#FFB2B2B2" Offset="0.961" />
                                                            <GradientStop Color="#FFE4E4E4" Offset="0.966" />
