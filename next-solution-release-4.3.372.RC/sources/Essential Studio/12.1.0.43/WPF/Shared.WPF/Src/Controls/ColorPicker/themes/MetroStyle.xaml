                                                        </Rectangle>
                                                    </Canvas>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" Margin="7,0,0,0">
                                                    <Button Width="25"  Height="20" Margin="2,2,3,1" VerticalAlignment="Center" Name="linear">
                                                        <Button.Content>
                                                            <!--<ControlTemplate>-->
                                                            <Border Width="15" Height="12" BorderThickness="0.5" BorderBrush="{DynamicResource MetroBorderBrush}" Background="{StaticResource MetroLinearButtonBackground}" />
                                                            <!--</ControlTemplate>-->
                                                        </Button.Content>
                                                    </Button>
                                                    <Button Height="20" Margin="0,2,3,1" Width="25"  VerticalAlignment="Center" Name="radial">
                                                        <Button.Content>
                                                            <!--<ControlTemplate>-->
                                                            <Border Width="15" Height="12" BorderThickness="0.5" BorderBrush="{DynamicResource MetroBorderBrush}" Background="{StaticResource MetroRadialButtonBackground}" />
                                                            <!--</ControlTemplate>-->
                                                        </Button.Content>
                                                    </Button>
                                                    <Button Height="20" Margin="0,2,5,1" Width="25"  VerticalAlignment="Center" Name="Reverse">
                                                        <Button.Content>
                                                            <!--<ControlTemplate>-->
                                                            <Border Width="15" Height="12" Background="{StaticResource ReverseBrushKey}" />
                                                            <!--</ControlTemplate>-->
                                                        </Button.Content>
                                                    </Button>
