					<TextBlock.ToolTip>
						<ToolTip Style="{StaticResource MetroToolTipCustomStyle}">
							<TextBlock>Green</TextBlock>
						</ToolTip>
					</TextBlock.ToolTip>
				</TextBlock>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource TextBlockStyle}" HorizontalAlignment="Left" FontSize="9">
