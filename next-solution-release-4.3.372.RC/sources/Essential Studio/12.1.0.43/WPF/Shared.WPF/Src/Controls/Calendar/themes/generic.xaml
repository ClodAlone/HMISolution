        <GradientStop Color="#72ACF4" Offset="1" />
        <GradientStop Color="#599EF2" Offset="0" />
    </LinearGradientBrush>-->
    <SolidColorBrush Color="White" x:Key="CalendarFill" />
    <SolidColorBrush x:Key="Default.SelectionBorderBrush" Color="#FF3988D7" />

    <SolidColorBrush x:Key="Aero.ButtonStroke"  Color="#E5A213" />
    <SolidColorBrush x:Key="Aero.MouseOverButtonStroke"  Color="#E2AF48" />
    <LinearGradientBrush x:Key="Aero.ButtonFill" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFFFDE" Offset="1" />
        <GradientStop Color="#FFD442" Offset="0" />
    </LinearGradientBrush>
