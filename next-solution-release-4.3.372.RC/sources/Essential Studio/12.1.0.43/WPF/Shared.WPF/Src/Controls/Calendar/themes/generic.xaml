    <SolidColorBrush x:Key="Aero.NotCurrentMonthDayCellForeground" Color="#FF777777" />
    <SolidColorBrush x:Key="Aero.SelectedDayCellForeground" Color="#000000" />
    <SolidColorBrush x:Key="Aero.SelectedDayCellBorderBrush" Color="#9CDFFF" />
    <SolidColorBrush x:Key="Aero.SelectedDayCellBackground" Color="#DBF4FF" />
    <SolidColorBrush x:Key="Aero.MouseOverDayCellForeground" Color="#000000" />
    <SolidColorBrush x:Key="Aero.MouseOverDayCellBorderBrush" Color="#DBF4FF" />
    <SolidColorBrush x:Key="Aero.MouseOverDayCellBackground" Color="#DBF4FF" />
    <SolidColorBrush x:Key="Aero.CalendarBorderBrush" Color="#5E9EAA" />
    <SolidColorBrush x:Key="Aero.CalendarInnerBorderBrush" Color="White" />
