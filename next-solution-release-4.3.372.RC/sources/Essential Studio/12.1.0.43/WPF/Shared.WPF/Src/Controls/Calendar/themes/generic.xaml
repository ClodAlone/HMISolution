    <SolidColorBrush x:Key="Default.MouseOverButtonFill"  Color="#FF73A9D8" />
    <!--<LinearGradientBrush x:Key="Default.MouseOverButtonFill" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFFFFF" Offset="1" />
        <GradientStop Color="#FFE48C" Offset="0" />
    </LinearGradientBrush>-->
    <SolidColorBrush x:Key="Default.DisabledButtonStroke" Color="#545454" />
    <SolidColorBrush x:Key="Default.DisabledButtonFill" Color="#8E8E8E" />
    <SolidColorBrush x:Key="Default.DayCellForeground" Color="#FF333333" />
    <SolidColorBrush x:Key="Default.NotCurrentMonthDayCellForeground" Color="#000000" />
    <SolidColorBrush x:Key="Default.SelectedDayCellForeground" Color="#000000" />
    <SolidColorBrush x:Key="Default.SelectedDayCellBorderBrush" Color="#FF95E4F8" />
    <SolidColorBrush x:Key="Default.SelectedWeekCellBorderBrush" Color="Beige" />
    <SolidColorBrush x:Key="Default.WeekCellBackground" Color="Transparent" />
