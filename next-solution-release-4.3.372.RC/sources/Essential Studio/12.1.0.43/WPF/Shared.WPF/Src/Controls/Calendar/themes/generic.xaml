        <GradientStop Color="#FFFFFF" Offset="1" />
        <GradientStop Color="#FFE48C" Offset="0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Aero.DisabledButtonStroke" Color="#545454" />
    <SolidColorBrush x:Key="Aero.DisabledButtonFill" Color="#8E8E8E" />
