<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="clr-namespace:Syncfusion.Windows.Controls.PivotGrid.Resources"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">
    <res:ResourceWrapperKeys x:Key="resourceWrapperKey"/>
    <local:SortDirectionConverter x:Key="sortDirectionConverter"/>
    <local:ValueFilterConverter x:Key="valueFilterConverter"/>
    <local:FilterCheckBoxVisibilityConverter x:Key="visibilityConverter"/>
    <!-- Filter Button Style -->
    <Style TargetType="{x:Type local:FilterButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FilterButton}">
                    <Grid Name="FilterLayout" Height="20" Background="Transparent">
                        <Path x:Name="FilterPath" Height="13" VerticalAlignment="Center"
                          Width="16" Stretch="Fill" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}" 
                          Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource valueFilterConverter}}"
                          HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:PivotExpanderCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PivotExpanderCell}">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" x:Name="PART_StackPanel" >
                        <Expander x:Name="PART_Expander" 
                                  Focusable="False" 
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left"
                                  Margin="2,0,0,0"
                                  IsExpanded="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                            <Expander.Style>
                                <Style TargetType="{x:Type Expander}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Expander}">
                                                <Border SnapsToDevicePixels="true" 
                                                        Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="3">
                                                    <ToggleButton x:Name="HeaderSite" 
                                                                  Margin="0" 
                                                                  MinHeight="0" 
                                                                  MinWidth="0" 
                                                                  Style="{Binding Path=ExpanderStyle, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}}}" 
                                                                  Content="{TemplateBinding Header}" 
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                        </Expander>
                        <TextBlock Margin="0,-1,0,0"  VerticalAlignment="Top" x:Name="PART_ValueTextBlock" Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           />
                        <StackPanel.ContextMenu>
                                <ContextMenu x:Name="PART_ExpanderContextMenu" />
                        </StackPanel.ContextMenu>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsHyperlinkCell" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ValueTextBlock" Property="TextDecorations"  Value="Underline"/>
                            <Setter TargetName="PART_ValueTextBlock" Property="Foreground"  Value="Red"/>
                            <Setter TargetName="PART_ValueTextBlock" Property="Cursor"  Value="Hand"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHyperlinkCell" Value="True"/>
                                <Condition Property="IsEnabledOnMouseOver" Value="False"/>
                                <Condition Property="IsMouseOver" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ValueTextBlock" Property="TextDecorations"  Value="Underline"/>
                            <Setter TargetName="PART_ValueTextBlock" Property="Foreground"  Value="Blue"/>
                            <Setter TargetName="PART_ValueTextBlock" Property="Cursor"  Value="Hand"/>
                        </MultiTrigger>                        
                    </ControlTemplate.Triggers>
                   
                </ControlTemplate>
                
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:PivotSortHeaderCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotSortHeaderCell">
                    <Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="13"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PART_CellValueTextBlock" VerticalAlignment="Top" Margin="5,2.5,3,0" Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}" 
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           TextWrapping="Wrap"  ToolTipService.ToolTip="{Binding Path=Text,ElementName=PART_CellValueTextBlock}" TextTrimming="WordEllipsis"
                                           />
                            <local:FilterButton x:Name="PART_btnFilter" Grid.Column="1" Margin="0,0,0,0" Command="local:PivotGridCommands.ShowCalculationFilter" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <Path x:Name="colSortPath" Grid.Column="2"  Margin="1,8,5,0"  VerticalAlignment="Top"  Height="6" Width="7" Stretch="Fill" Fill="#FF4F4F4F" 
                                        Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource sortDirectionConverter}}" 
                                           HorizontalAlignment="Right" />
                            
                            <Grid.ContextMenu>
                                <ContextMenu x:Name="Part_SortHeaderContext">
                                    <MenuItem Header="{Binding Allow_Filtering,Source={StaticResource resourceWrapperKey}}" Tag="Allow Filtering"  Command="local:PivotGridCommands.AllowValueFiltering"/>
                                    <MenuItem Header="{Binding Allow_Sorting,Source={StaticResource resourceWrapperKey}}" Tag="Allow Sorting"  Command="local:PivotGridCommands.AllowValueSort" />
                                    <MenuItem Header="{Binding Hide_Column,Source={StaticResource resourceWrapperKey}}" Tag="Hide Column"  Command="local:PivotGridCommands.HideValueColumn" />
                                    <Separator/>
                                    <MenuItem Header="{Binding Clear_Filters,Source={StaticResource resourceWrapperKey}}" Tag="Clear Filters" Command="local:PivotGridCommands.ClearValueFilters"/>
                                    <MenuItem Header="{Binding Clear_Sorts,Source={StaticResource resourceWrapperKey}}" Tag="Clear Sorts"  Command="local:PivotGridCommands.ClearValueSorts" />
                                    <Separator/>
                                    <MenuItem Header="{Binding Show_Value_Chooser,Source={StaticResource resourceWrapperKey}}" Tag="Show Pivot Value Chooser" Command="local:PivotGridCommands.ShowPivotValueChooser"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            
                        </Grid>
                        <!-- FilterPopup -->
                        <local:ColumnFilterPopup Width="200" Height="210" MinWidth="200" MinHeight="210" Placement="Bottom" StaysOpen="False"
                                                 x:Name="PART_ColumnFilterPopup" 
                                                 PopupAnimation="Fade"
                                                 AllowsTransparency="True">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                    Background="{TemplateBinding Background}"
                                    x:Name="PART_FilterPopupBorder"
                                    BorderThickness="0.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="12" />
                                    </Grid.RowDefinitions>
                                    <ListBox Margin="4,0" Grid.Row="0">
                                        <CheckBox x:Name="PART_AllCheckBox" Height="20" Content="{Binding Path=FilterPopUp_All,Source={StaticResource resourceWrapperKey}}" IsChecked="True" />
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="1,0,0,0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <ListBox Grid.Row="1" x:Name="PART_FilterPopupListBox" ItemsSource="{Binding Path=FilterListBoxItems, RelativeSource={RelativeSource TemplatedParent}}" Margin="4,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Name="ChBox" Content="{Binding Text}" IsChecked="{Binding IsChecked}" Height="20" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Visibility" Value="{Binding Path=IsChecked, Converter={StaticResource visibilityConverter}}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,6,4,0">
                                        <Button x:Name="PART_btnOK" 
                                                Content="{Binding Path=OkButton,Source={StaticResource ResourceKey=resourceWrapperKey}}"
                                                MinWidth="36" MinHeight="20" Height="20" Width="70"
                                                HorizontalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                        <Button x:Name="PART_btnCancel" 
                                                Content="{Binding Path=CancelButton,Source={StaticResource ResourceKey=resourceWrapperKey}}"  
                                                MinWidth="36" MinHeight="20" Height="20" Width="70"
                                                Margin="7,0,0,0"
                                                HorizontalAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <Border Name="ResizeBorder" Grid.Row="3" BorderBrush="LightGray" BorderThickness="0.3" CornerRadius="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <LinearGradientBrush.GradientStops>
                                                    <GradientStop Offset="0" Color="Transparent" />
                                                    <GradientStop Offset="1" Color="#E3E3E3" />
                                                </LinearGradientBrush.GradientStops>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Thumb Name="PART_thumbRightCorner" Width="10" VerticalAlignment="Stretch"
                                               HorizontalAlignment="Right" HorizontalContentAlignment="Right" 
                                               Cursor="SizeNWSE">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Grid>
                                                        <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Stretch" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Border>
                                </Grid>
                            </Border>
                        </local:ColumnFilterPopup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type local:PivotGridHyperlinkCell}">
          <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PivotGridHyperlinkCell}">
                    <TextBlock Margin="5,0,5,0" x:Name="PART_CellValueTextBlock" Text="{Binding Path=FormattedText}"
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           />
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabledOnMouseOver" Value="False"/>
                                <Condition Property="IsMouseOver" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_CellValueTextBlock" Property="TextDecorations"  Value="Underline"/>
                            <Setter TargetName="PART_CellValueTextBlock" Property="Foreground"  Value="Blue"/>                            
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>                                
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_CellValueTextBlock" Property="TextDecorations"  Value="Underline"/>
                            <Setter TargetName="PART_CellValueTextBlock" Property="Foreground"  Value="Red"/>
                            <Setter TargetName="PART_CellValueTextBlock" Property="Cursor"  Value="Hand"/>
                        </MultiTrigger>                      
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>