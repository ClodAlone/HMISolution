    </Style>

    <!-- GridGroupingBar -->
    <Style TargetType="{x:Type local:PivotGridGroupingBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PivotGridGroupingBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35px"/>
                            <RowDefinition Height="35px"/>
                        </Grid.RowDefinitions>
                        <!-- FilterBar -->
                        <local:PivotGroupingItemsControl
                            x:Name="PART_FilterList"                              
                            Grid.Column="0" 
                            AllowDrop="True"
                            Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridGroupingBar}}, Path=Background}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{Binding Path=GridOuterBorderBrush,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:PivotGridControl}},Mode=TwoWay}"
                            ItemsPanel="{StaticResource PivotFilterItemPanelTemplate}"
                            ItemTemplate="{StaticResource PivotFilterItemTemplate}"
                            ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}">
                            <!--<TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotGridHeaderDropFilterFileds}" x:Name="FilterListItemText" FontFamily="Segoe UI" Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}},
                            Path=GroupingBarItemForeground}"  FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"/>-->

                        </local:PivotGroupingItemsControl>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ComputationInfoWidth"/>
                                <ColumnDefinition x:Name="ComputationButtonWidth"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ComputationInfo List-->
                            <local:PivotGroupingItemsControl 
                                x:Name="PART_ComputationInfoList"                                 
                                Grid.Column="0" 
                                AllowDrop="True"
                                BorderThickness="0,0,0,0"                              
                                Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridGroupingBar}}, Path=Background}"
                                BorderBrush="#CFD2D3"
                                ItemsPanel="{StaticResource PivotComputationInfoPanelTemplate}"
                                ItemTemplate="{StaticResource PivotCalculationTemplate}"
                                ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                Margin="0,0,0,-1"/>

                            <Button x:Name="Button_ComputationArea" Grid.Column="1" Height="23" Margin="4,2,4,0"
                                    Visibility="Hidden" 
                                    ToolTip="Click the Button 'Show Fields' to View Computation List"
                                    Content="Show Fields"  />
                            
                            <!-- Column List -->
                            <local:PivotGroupingItemsControl 
                                x:Name="PART_ColumnList"
                                Grid.Column="3" 
                                AllowDrop="True"
                                BorderThickness="0,0,0,0"
                                BorderBrush="#CFD2D3"
                                ItemsPanel="{StaticResource PivotColumnItemPanelTemplate}"
                                ItemTemplate="{StaticResource PivotColumnItemTemplate}"
                                ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}"                       
                                Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridGroupingBar}}, Path=Background}"
                                Margin="-3,0,0,0">
                                <!--<TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotGridDropColumnFields}" x:Name="ColumnListItemText" Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}},
                            Path=GroupingBarItemForeground}"  FontFamily="Segoe UI" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"/>-->
                            </local:PivotGroupingItemsControl>

                            <!-- FilterPopup -->
                            <local:FilterPopup Width="200" Height="200" Placement="Bottom" StaysOpen="False" x:Name="PART_FilterPopup">
                                <Border BorderBrush="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotGridGroupingBar}},
                                        Path = ItemsBorderBrush}" 
                                        Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotGridGroupingBar}},
                                        Path = ItemsBackground}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="PART_FilterPopupListBox" ItemsSource="{Binding Path=FilterList, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:FilterPopup}}" Grid.Row="0" Margin="4,2" Background="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridGroupingBar}}, Path=ItemsBackground}" >
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Key}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}}, Path=GroupingBarItemForeground}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PART_btnOK" Grid.Column="1" Margin="3" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=OkButton}" Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}},
                            Path=GroupingBarItemForeground}"  MinWidth="50" MinHeight="23"/>
                                            <Button x:Name="PART_btnCancel" Grid.Column="3" Margin="3" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path= CancelButton}"  Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}},
                            Path=GroupingBarItemForeground}" MinWidth="50" MinHeight="23"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </local:FilterPopup>

                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotGridControl}},
                                        Path = GroupingBarBackground}"/>
        <Setter Property="ItemsBackground" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotGridControl}},
                                        Path = GroupingBarItemBackground}"/>
        <Setter Property="ItemsBorderBrush" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotGridControl}},
                                        Path = GroupingBarItemBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type local:PivotGridControl}},
                                        Path = FieldListBorderBrush}"/>
    </Style>

    <!-- PivotGridControl -->
    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PivotGridControl}">
                    <syncfusion:BusyIndicator x:Name="PART_BusyIndicator" IsEnabled="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsBusy="False"
                                              CloseButtonVisibility="Collapsed"
                                              CancelButtonVisibility="Collapsed"
                                              IsIndeterminate="True"
                                              OverlayOpacity="0.5">
                        <syncfusion:BusyIndicator.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Height="0" Width="0"/>
                            </DataTemplate>
                        </syncfusion:BusyIndicator.HeaderTemplate>
                        <syncfusion:BusyIndicator.LoadingDescription>
                            <TextBlock Width="230" Height="35" TextAlignment="Left" Text="{Binding Source={StaticResource resourceWrapperKeys},Path=pivotGridBusyIndicatorLoadingDescription}" TextWrapping="Wrap"/>
                        </syncfusion:BusyIndicator.LoadingDescription>
                        <Border x:Name="PART_GridOuterBorder" BorderThickness="1" BorderBrush="{Binding Path=GridOuterBorderBrush,RelativeSource={RelativeSource Mode=TemplatedParent},Mode=TwoWay}">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="PART_GroupingBarRowDefinition"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <local:PivotGridGroupingBar x:Name="PART_PivotGridGroupingBar" Grid.Row="0">
                                <local:PivotGridGroupingBar.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotGridContextMenuReloadData}" Command="local:PivotGridCommands.ReloadData">
                                            <MenuItem.Icon>
                                                <Image Height="18" Width="18" Source="/Syncfusion.PivotAnalysis.Wpf;component/PivotGridControl/Resources/ReloadData.png">
                                                </Image>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotGridContextMenuShowFieldList}" Command="local:PivotGridCommands.ShowFieldList">
                                            <MenuItem.Icon>
                                                <Image Height="18" Width="18" Source="/Syncfusion.PivotAnalysis.Wpf;component/PivotGridControl/Resources/ShowFieldList.png">
                                                </Image>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                    </ContextMenu>
                                </local:PivotGridGroupingBar.ContextMenu>
                            </local:PivotGridGroupingBar>
                            <ScrollViewer 
                        x:Name="PART_GridScrollViewer"
                        Grid.Row="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"                        
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        CanContentScroll="True" >
                                <!--<local:PivotGridControlBase x:Name="PART_PivotGridControlBase" 
                                   GridControl="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}}}"/>-->

                            </ScrollViewer>
                        </Grid>
                    </Border>
                    </syncfusion:BusyIndicator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--Expander Style-->
        <Setter Property="ExpanderStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Padding="{TemplateBinding Padding}">
                                    <Grid SnapsToDevicePixels="False" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="13"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="circle" Stroke="DarkGray" HorizontalAlignment="Center" VerticalAlignment="Center" Width="13" Height="13"/>
                                        <Path x:Name="arrow" Stroke="#666" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="false" Data="M 1,4.5  L 4.5,1  L 8,4.5"/>
                                        <ContentPresenter HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True" Grid.Column="1" RecognizesAccessKey="True"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="true">
                                        <Setter Property="Data" TargetName="arrow" Value="M 1,1.5 L 4.5,5 L 8,1.5"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Stroke" TargetName="circle" Value="#FF3C7FB1"/>
                                        <Setter Property="Stroke" TargetName="arrow" Value="#222"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="true">
                                        <Setter Property="Stroke" TargetName="circle" Value="#FF526C7B"/>
                                        <Setter Property="StrokeThickness" TargetName="circle" Value="1.5"/>
                                        <Setter Property="Stroke" TargetName="arrow" Value="#FF003366"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="Background" Value="{StaticResource Classic.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Classic.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Classic.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Classic.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Classic.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Classic.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Classic.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Classic.ExpanderStyle}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ClassicGroupingButtonsHoverBackgroundBrush}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ClassicGroupingButtonHoverBorderBrush}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Classic.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Classic.SummaryForegroundBrush}"/>
        <Setter Property="GroupingBarBackground" Value="{StaticResource Classic.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Classic.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Classic.GroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Classic.WindowBorderBrush}"/>

        <Setter Property="GroupingBarItemForeground" Value="#FF2A447F"/>
        <Setter Property="GridOuterBorderBrush" Value="#FFE2E2E2"/>
    </Style>
</ResourceDictionary>