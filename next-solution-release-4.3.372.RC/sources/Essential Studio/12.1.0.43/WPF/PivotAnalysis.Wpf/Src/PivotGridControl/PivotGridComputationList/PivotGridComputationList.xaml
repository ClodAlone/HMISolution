<Window x:Class="Syncfusion.Windows.Controls.PivotGrid.PivotGridComputationList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid" 
        xmlns:sfShared="http://schemas.syncfusion.com/wpf"        
        xmlns:resource="clr-namespace:Syncfusion.Windows.Controls.PivotGrid.Resources"        
        x:Name="ComputationList" Title="PivotGridComputationList" WindowStyle="None"  ShowInTaskbar="False" PreviewMouseMove="ResetCursor" ResizeMode="NoResize"
        MinWidth="220" Width="220" Height="250"  AllowsTransparency="True">
    
    <Window.Resources>
        <resource:ResourceWrapperKeys x:Key="resourceWrapperKeys"/>
        <LinearGradientBrush x:Key="PivotGroupingItemMouseOver" StartPoint="0.522556,-0.0161282" EndPoint="0.522556,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#FFFFF8E7" Offset="0"/>
                <GradientStop Color="#FFF6CA54" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <Style TargetType="{x:Type ToggleButton}" x:Key="PivotToggleButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Margin="2,4" x:Name="brdItem"
                            Background="{Binding Path=GridControl.GroupingBar.ItemsBackground,ElementName=ComputationList}"                             
                            BorderBrush="{Binding Path=GridControl.GroupingBar.ItemsBorderBrush,ElementName=ComputationList}"
                            BorderThickness="1">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PART_contentTxt" Grid.Column="0" TextTrimming="WordEllipsis" VerticalAlignment="Center"  
                                       Text="{Binding FieldHeader}" Margin="2 0 0 0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="PART_contentTxt" Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger SourceName="brdItem" Property="IsMouseOver" Value="True">
                                <Setter TargetName="brdItem" Property="Background" Value="{StaticResource PivotGroupingItemMouseOver}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PivotItemTemplate">
            <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotToggleButtonStyle}"  
                      Margin="-1,-1,-1,-4" Height="33" Tag="{Binding}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="PivotItemPanelTemplate">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>

        <Style x:Key="PivotGroupingItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Rectangle">
            <Setter Property="Fill" Value="{Binding Path= GridControl.GroupingBar.FieldListBorderBrush,ElementName=ComputationList}"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="Background"  Value="{Binding Path=GridControl.GroupingBar.FieldListBorderBrush,ElementName=ComputationList}"/>
        </Style>

        <LinearGradientBrush x:Key="backgroundGradient" Opacity="0.3"  EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#CFCFCF" Offset="0.1" />
            <GradientStop Color="#E2E8F1" Offset="0.5" />
            <GradientStop Color="#E2E8F1" Offset="0.5" />
            <GradientStop Color="#CFCFCF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="btnStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Grid x:Name="grid" Background="{Binding Path= GridControl.GroupingBar.FieldListBorderBrush,ElementName=ComputationList}">
                            <Path Stretch="Fill" Fill="{Binding Path=GridControl.GridLineStroke,ElementName=ComputationList}" Data="F1 M 156.386,156.917L 158.779,156.917L 166.74,164.876L 164.386,164.876L 156.386,156.917 Z "
                              Height="10" Width="10"/>
                            <Path Stretch="Fill" Fill="{Binding Path=GridControl.GridLineStroke,ElementName=ComputationList}" Data="F1 M 166.374,156.917L 164.151,156.917L 156.753,164.876L 158.939,164.876L 166.374,156.917 Z "
                              Height="10" Width="10"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grid" Property="Background" Value="{StaticResource backgroundGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="grid" Property="Background" Value="{Binding Path= GridControl.GroupingBar.FieldListBorderBrush,ElementName=ComputationList}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <Rectangle Name="topleft" Grid.Column="0" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="21"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Grid.ColumnSpan="2"  Margin="-1,0,-1,-1" Name="top" Grid.Row="0" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
                <Border Height="30" Name="topBrd" Grid.Column="0" Margin="-1 0 -1 -1" Grid.Row="1" VerticalAlignment="Top" MouseMove="DisplayResizeCursor" PreviewMouseDown="Border_PreviewMouseDown" >
                    <TextBlock Name="txtFieldList" Text="PivotGridComputationList" Margin="4 2 0 5" FontFamily="Calibri" VerticalAlignment="Top" FontSize="14" Foreground="{Binding Path=GridControl.GridLineStroke,ElementName=ComputationList}"></TextBlock>
                </Border>
                <Button Name="closeButton" Grid.Column="1" Grid.Row="1" Style="{StaticResource btnStyle}" Margin="0 0 -1 0" Click="CloseButton_Click"/>
                <Rectangle Name="topRect" Grid.Column="0" Grid.ColumnSpan="2"  Margin="-1,-1,-1,0" Grid.Row="2"/>
            </Grid>
            <Rectangle Name="topright" Grid.Column="2" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0 -2 0 -2" Name="left"  PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
            <Border Grid.Column="2" Margin="0 -2 0 -2" Name="right" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
            <local:PivotGroupingItemsControl x:Name="PivotItemComputationPanel" AllowDrop="True" Grid.Column="1"   
                        ItemsPanel="{StaticResource PivotItemPanelTemplate}"
                        ItemTemplate="{StaticResource PivotItemTemplate}"
                        ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}" 
                        BorderBrush="#CFD2D3"
                        Margin="0,0,0,0"
                      />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <Rectangle  Name="bottomleft" Grid.Column="0" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
            <Border Grid.Row="2" Margin="-1,0,-1,0" Grid.Column="1" Name="bottom" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
            <Rectangle Grid.Column="2" Name="bottomright" PreviewMouseDown="Resize" MouseMove="DisplayResizeCursor"/>
        </Grid>

    </Grid>
</Window>
