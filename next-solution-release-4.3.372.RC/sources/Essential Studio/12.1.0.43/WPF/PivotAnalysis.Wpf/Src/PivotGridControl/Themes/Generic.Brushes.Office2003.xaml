<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">

    <SolidColorBrush x:Key="Office2003Blue.GridBackground" Color="#D5E5FC"/>
    <SolidColorBrush x:Key="Office2003Blue.GroupingBarBackground" Color="#D5E5FC"/>

    <SolidColorBrush x:Key="Office2003Blue.GridLineStroke" Color="#3170C9" />
    <SolidColorBrush x:Key="Office2003Blue.GroupingBarItemsBorderBrush" Color="#3170C9"/>
    
    <SolidColorBrush x:Key="Office2003Blue.ColumnHeaderBackgroundBrush" Color="#93B7EA"/>
    <SolidColorBrush x:Key="Office2003Blue.RowHeaderBackgroundBrush" Color="#93B7EA"/>
    <SolidColorBrush x:Key="Office2003Blue.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2003Blue.SummaryBackgroundBrush" Color="#BDD7FF"/>
    <SolidColorBrush x:Key="Office2003Blue.GroupingBarItemsBackground" Color="#BDD7FF"/>   
    <SolidColorBrush x:Key="Office2003Blue.ColumnHeaderForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.RowHeaderForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.ValueCellForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.SummaryForegroundBrush" Color="#415788"/>
    <SolidColorBrush x:Key="Office2003Blue.WindowBorderBrush" Color="#93B7EA"/> 

    <local:PivotGridCellStyle x:Key="Office2003Blue.ColumnHeaderStyle" 
                             Background="{StaticResource Office2003Blue.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2003Blue.RowHeaderStyle" 
                             Background="{StaticResource Office2003Blue.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2003Blue.SummaryHeaderStyle" 
                             Background="{StaticResource Office2003Blue.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2003Blue.SummaryCellStyle"
                              Background="{StaticResource Office2003Blue.ValueCellBackgroundBrush}"
                              Foreground="{StaticResource Office2003Blue.ValueCellForegroundBrush}"
                              FontFamily="Calibri"
                              />

    <local:PivotGridCellStyle x:Key="Office2003Blue.ValueCellStyle" 
                             Background="{StaticResource Office2003Blue.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2003Blue.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackground.Blue}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style x:Key="Office2003Blue.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Blue}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Blue}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Blue}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonMouseOverBrush.Blue}"
                                    TargetName="border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource Office2003Blue.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Office2003Blue.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Office2003Blue.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Office2003Blue.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Office2003Blue.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Office2003Blue.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2003Blue.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2003Blue.ExpanderStyle}"/>
        <Setter Property="GroupingBarBackground" Value="{StaticResource Office2003Blue.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2003Blue.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Office2003Blue.GroupingBarItemsBorderBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Office2003Blue.ColumnHeaderForegroundBrush}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2003Blue.ColumnHeaderForegroundBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Office2003Blue.WindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
    </Style>

</ResourceDictionary>