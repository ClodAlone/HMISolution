<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">

    <SolidColorBrush x:Key="Office2007Blue.GridLineStroke" Color="#3170C9"/>
    <SolidColorBrush x:Key="Office2007Blue.GroupingBarItemsBorderBrush" Color="#FF6593CF"/>

    <SolidColorBrush x:Key="Office2007Blue.GridBackground" Color="AliceBlue"/>
    <SolidColorBrush x:Key="Office2007Blue.GroupingBarBackground" Color="#FFB0D7FF"/>

   
    <LinearGradientBrush x:Key="Office2007Blue.ColumnHeaderBackgroundBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC4D9FF" Offset="0.97"/>
        <GradientStop Color="#FFFBFFFF" Offset="0.03"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Blue.RowHeaderBackgroundBrush" Color="#FFD7E6FE"/>
    <SolidColorBrush x:Key="Office2007Blue.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryBackgroundBrush" Color="#FFFBE292"/>
    

    <LinearGradientBrush x:Key="Office2007Blue.GroupingBarItemsBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7FA6DB" Offset="1"/>
        <GradientStop Color="#FFC3D8FE" Offset="0.993"/>
        <GradientStop Color="#FFF4FAFE" Offset="0.082"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007Blue.ColumnHeaderForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.RowHeaderForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.ValueCellForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.SummaryForegroundBrush" Color="#243A76"/>
    <SolidColorBrush x:Key="Office2007Blue.WindowBorderBrush" Color="#AED1FF"/>

    <local:PivotGridCellStyle x:Key="Office2007Blue.ColumnHeaderStyle" 
                             Background="{StaticResource Office2007Blue.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2007Blue.RowHeaderStyle" 
                             Background="{StaticResource Office2007Blue.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Office2007Blue.SummaryHeaderStyle" 
                             Background="{StaticResource Office2007Blue.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Office2007Blue.SummaryCellStyle"
                              Background="{StaticResource Office2007Blue.SummaryBackgroundBrush}"
                              Foreground="{StaticResource Office2007Blue.ValueCellForegroundBrush}"
                              FontFamily="Calibri"
                              />

    <local:PivotGridCellStyle x:Key="Office2007Blue.ValueCellStyle" 
                             Background="{StaticResource Office2007Blue.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2007Blue.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToolTipBackgroundColor"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="LightBlue"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
<LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <DataTemplate x:Key="pivotTooltipTemplate">
    <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackgroundColor}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4"
            >
        <TextBlock Text="{Binding Path=Tag}" Padding="2" />
    </Border>
    </DataTemplate>

    <Style x:Key="Office2007Blue.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Blue}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Blue}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Blue}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonHoverBackgroundBrush1}"
                                    TargetName="border"/>
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ButtonHoverBorderBrush1}"
                                    TargetName="border"/>
                            <Setter Property="Fill" TargetName="ExpandPath" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="Office2007BlueCurrentCellBorder" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7B6541" Offset="0"/>
        <GradientStop Color="#FFA48D62" Offset="0.996"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource Office2007Blue.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Office2007Blue.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Office2007Blue.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Office2007Blue.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Office2007Blue.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Office2007Blue.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Blue.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2007Blue.ExpanderStyle}"/>
        <Setter Property="GroupingBarBackground" Value="{StaticResource Office2007Blue.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Office2007Blue.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Office2007Blue.GroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Office2007Blue.WindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF15428B"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF6593CF"/>
        <Setter Property="CurrentCellBorder" Value="{StaticResource Office2007BlueCurrentCellBorder}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Office2007Blue.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Office2007Blue.SummaryForegroundBrush}"/>
        
    </Style>
</ResourceDictionary>