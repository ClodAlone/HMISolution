<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.PivotGrid">


    
    <SolidColorBrush Color="#FF595959 " x:Key="Blend.GridBackground"/>
    <SolidColorBrush Color="#FF595959" x:Key="Blend.GroupingBarBackground"/>
  

    <SolidColorBrush x:Key="Blend.GridLineStroke" Color="Black" />
    <SolidColorBrush x:Key="Blend.GroupingBarItemsBorderBrush" Color="#FF2B2B2B"/>

    <SolidColorBrush x:Key="Blend.ColumnHeaderBackgroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Blend.RowHeaderBackgroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Blend.ValueCellBackgroundBrush" Color="#FF414141"/>
    <SolidColorBrush x:Key="Blend.SummaryBackgroundBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="Blend.GroupingBarItemsBackground" Color="#FF3A3A3A"/>

    <SolidColorBrush x:Key="Blend.ColumnHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.RowHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.ValueCellForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.SummaryForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.WindowBorderBrush" Color="#4F4F4F"/>

    <local:PivotGridCellStyle x:Key="Blend.ColumnHeaderStyle" 
                             Background="{StaticResource Blend.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Blend.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Blend.RowHeaderStyle" 
                             Background="{StaticResource Blend.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Blend.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:PivotGridCellStyle x:Key="Blend.SummaryHeaderStyle" 
                             Background="{StaticResource Blend.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Blend.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Blend.SummaryCellStyle"
                              Background="{StaticResource Blend.SummaryBackgroundBrush}"
                              Foreground="{StaticResource Blend.ValueCellForegroundBrush}"
                              FontFamily="Calibri"
                              />

    <local:PivotGridCellStyle x:Key="Blend.ValueCellStyle" 
                             Background="{StaticResource Blend.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Blend.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

   
    <SolidColorBrush x:Key="TreeViewFill.Black" Color="#FF898989"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Black"  StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFB5B5B5"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush1" Color="#FFAAAAAA"/>
    <SolidColorBrush Color="#FF424242" x:Key="ButtonHoverBorderBrush1"/>
    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Black" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <DataTemplate x:Key="pivotTooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource ToolTipBackground.Black}"
            BorderBrush="#888"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Path=Tag}" Padding="2" />
        </Border>
    </DataTemplate>

    <Style x:Key="Blend.ExpanderStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                       
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="Transparent" 
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            Background="Transparent" >

                            <Path x:Name="ExpandPath" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FF9B9B9B" RenderTransformOrigin="0.5,0.5">

                            </Path>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M290.5,329 L312.5,329.5 302.5,347.5 z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Fill"
                                    Value="White"
                                    TargetName="ExpandPath"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    

    <Style TargetType="{x:Type local:PivotGridControl}">
        <Setter Property="Background" Value="{StaticResource Blend.GridBackground}"/>
        <Setter Property="ColumnHeaderCellStyle" Value="{StaticResource Blend.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderCellStyle" Value="{StaticResource Blend.RowHeaderStyle}"/>
        <Setter Property="SummaryHeaderStyle" Value="{StaticResource Blend.SummaryHeaderStyle}"/>
        <Setter Property="SummaryCellStyle" Value="{StaticResource Blend.SummaryCellStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Blend.ValueCellStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Blend.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Blend.ExpanderStyle}"/>
        <Setter Property="GroupingBarBackground"  Value="{StaticResource Blend.GroupingBarBackground}"/>
        <Setter Property="GroupingBarItemBackground" Value="{StaticResource Blend.GroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="{StaticResource Blend.GroupingBarItemsBorderBrush}"/>
        <Setter Property="FieldListBorderBrush" Value="{StaticResource Blend.WindowBorderBrush}"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ButtonHoverBackgroundBrush1}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ButtonHoverBorderBrush1}"/>
        <Setter Property="GroupingBarItemForeground" Value="#FFFFFF"/>
        <Setter Property="GridOuterBorderBrush" Value="#FF2B2B2B"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Blend.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonHoverForeground" Value="{StaticResource Blend.SummaryForegroundBrush}"/>
        <!--<Setter Property="CurrentCellBorder" Value="{StaticResource Office2007SilverCurrentCellBorder}"/>-->
    </Style>
</ResourceDictionary>