<sync:ChromelessWindow x:Class="Syncfusion.Windows.Controls.PivotSchemaDesigner.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:sync="http://schemas.syncfusion.com/wpf"
        xmlns:res="clr-namespace:Syncfusion.Windows.Controls.PivotGrid.Resources"
        Title="PopupWindow" Height="300" Width="200" 
        ResizeMode="NoResize"  ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <sync:ChromelessWindow.Resources>
        <res:ResourceWrapperKeys x:Key="resourceWrapperKeys"/>
    </sync:ChromelessWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Button x:Name="btnSortAssending" Grid.Row="0" Content="Sort A to Z" Margin="4,2" />
        <Button x:Name="btnSortDessending" Grid.Row="1" Content="Sort Z to A" Margin="4,2" />
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaFilterWindowPopupCaptionFilter}"  Grid.Row="2" VerticalAlignment="Center" Margin="4,0,0,0" />
        <ListBox Grid.Row="3" Margin="4,2" ItemsSource="{Binding FilterList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Key}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=OkButton}"   Margin="3" Width="75" Click="btnOK_Click" IsEnabled="{Binding Path=IsSelected}" />
            <Button x:Name="btnCancel" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=CancelButton}"   Margin="3" Width="75" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</sync:ChromelessWindow>
