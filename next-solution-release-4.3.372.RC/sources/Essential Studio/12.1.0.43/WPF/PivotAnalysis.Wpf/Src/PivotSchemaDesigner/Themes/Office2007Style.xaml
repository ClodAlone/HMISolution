    <!--ListBox PivotItem Template-->
    <DataTemplate x:Key="lstPivotItemTemplate">
        <StackPanel HorizontalAlignment="Stretch">
            <Rectangle x:Name="Part_Indicator" Fill="Transparent" Height="2"/>

            <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotItemToggleButtonStyle}" 
                      Tag="{Binding}"/>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="DragOver">
                    <BeginStoryboard>
                        <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                            <ColorAnimation From="Transparent" To="#9E9E9E" Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="DragLeave">
                    <BeginStoryboard>
                        <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                            <ColorAnimation From="#9E9E9E" To="Transparent" Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Drop">
                    <BeginStoryboard>
                        <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                            <ColorAnimation From="#9E9E9E" To="Transparent" Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
        </StackPanel>
    </DataTemplate>

