    <Style TargetType="{x:Type ToggleButton}" x:Key="PivotCalculationToggleButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Margin="2,1" x:Name="brdItem" Background="{StaticResource ListBoxItem}" BorderBrush="#F1D14D" BorderThickness="1" CornerRadius="2">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="contentTxt" Text="{Binding FieldHeader}" Margin="6,0" />
                            <Button Grid.Column="1" Width="12" Height="12" Margin="2,0" Tag="{Binding}" Command="local:PivotCommands.DeletePivotItem" >
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="PART_PivotCalculationImageBorder" >
                                            <Image HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                               Source="{StaticResource Delete}" 
                                                               Width="8" Height="8" 
                                                               Margin="2,0"
                                                               Tag="{Binding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="PART_PivotCalculationImageBorder" Property="IsMouseOver" Value="True">
                                                <Setter  TargetName="PART_PivotCalculationImageBorder" Property="Background" Value="#EFC723"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="contentTxt" Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="SizeAll"/>
                        </Trigger>
                        <Trigger SourceName="brdItem" Property="IsMouseOver" Value="True">
                            <Setter  TargetName="brdItem" Property="Background" Value="{StaticResource ListBoxItemMouseOver}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
