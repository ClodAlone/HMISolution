                        <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                            <ColorAnimation From="#9E9E9E" To="Transparent" Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Drop">
                    <BeginStoryboard>
                        <Storyboard Storyboard.TargetName="Part_Indicator" Storyboard.TargetProperty="Fill.Color">
                            <ColorAnimation From="#9E9E9E" To="Transparent" Duration="0:0:0" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>