<sync:ChromelessWindow x:Class="Syncfusion.Windows.Controls.PivotSchemaDesigner.ComputationInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:res="clr-namespace:Syncfusion.Windows.Controls.PivotGrid.Resources"
        xmlns:sync="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusion="clr-namespace:Syncfusion.PivotAnalysis.Base;assembly=Syncfusion.PivotAnalysis.Base"
        Title="Pivot Computation Information" Height="280" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseNativeChrome="True"
        WindowStyle="ToolWindow"
        >
    <sync:ChromelessWindow.Resources>
        <res:ResourceWrapperKeys x:Key="resourceWrapperKeys"/>
    </sync:ChromelessWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaComputationalInfoDialogCaptionFieldname}"   Grid.Row="0" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Text="{Binding FieldName}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="2,2,4,2" />
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaFilterHeader}" VerticalAlignment="Center" Margin="2" Grid.Row="1"/>
        <TextBox Grid.Row="1" Text="{Binding FieldHeader,Mode=TwoWay}" Grid.Column="1" VerticalAlignment="Center" Margin="2,2,4,2"/>
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaComputationalInfoDialogCaptionDescription}"   Grid.Row="2" VerticalAlignment="Center" Margin="2"/>
        <TextBox Text="{Binding Description,Mode=TwoWay}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="2,2,4,2" />
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaComputationalInfoDialogCaptionFormat}"   Grid.Row="3" VerticalAlignment="Center" Margin="2"/>
        <TextBox x:Name="txtFormat" Text="{Binding Format, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="2,2,4,2" />
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaComputationalInfoDialogCaptionSummaryType}"  Grid.Row="4" VerticalAlignment="Center" Margin="2"/>
        <ComboBox x:Name="cmbSummaryType"  
                  Grid.Row="4" 
                  Grid.Column="1"  
                  Height="24"
                  Margin="2,0,4,0" />
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaComputationalInfoDialogCaptionCalculationType}"  Grid.Row="5" VerticalAlignment="Center" Margin="2"/>
        <ComboBox x:Name="cmbCalculationType"  
                  Grid.Row="5" 
                  Grid.Column="1"  
                  Height="24"
                  Margin="2,0,4,0" />
        <TextBlock x:Name="txtBlockBaseField" Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=pivotSchemaComputationalInfoDialogCaptionBaseField}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="2" />
        <ComboBox x:Name="cmbBaseField"  
                  Grid.Row="6" 
                  Grid.Column="1"  
                  Height="24"
                  Margin="2,0,4,0" IsEnabled="False" />
        <StackPanel Grid.Row="7" Height="28" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=OkButton}"  Margin="3" Width="75" Click="btnOK_Click" />
            <Button x:Name="btnCancel" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=CancelButton}" Margin="3,3,4,3" Width="75" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</sync:ChromelessWindow>