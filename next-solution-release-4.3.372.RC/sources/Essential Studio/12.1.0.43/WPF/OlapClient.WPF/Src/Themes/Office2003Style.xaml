<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"   
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Client.Olap">

    <!--<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFFFE" Offset="0"/>
        <GradientStop Color="#FFFEFBD3" Offset="0.008"/>
        <GradientStop Color="#FFF7C463" Offset="0.984"/>
        <GradientStop Color="#FFFBE2B3" Offset="0.992"/>
    </LinearGradientBrush>-->
    <LinearGradientBrush x:Key="HeaderMouseOverBackgroundBrush" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FFFFFFFE" Offset="0"/>
        <GradientStop Color="#FFFEFBD3" Offset="0.012"/>
        <GradientStop Color="#FFF7C463" Offset="0.988"/>
        <GradientStop Color="#FFFBE2B3" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type local:OlapClient}">
        <Setter Property="Background" Value="#FFEAF2FB"/>
        <Setter Property="BorderBrush" Value="#FFABC1DE"/>
        <Setter Property="HeaderBackground" Value="#FFE3EFFF"/>
        <Setter Property="HeaderBorderBrush" Value="#FFADD1FF"/>
        <Setter Property="HeaderMouseOverBackground" Value="{StaticResource HeaderMouseOverBackgroundBrush}"/>
        <Setter Property="HeaderMouseOverBorderBrush" Value="#FFDBCE99"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    
    
</ResourceDictionary>
