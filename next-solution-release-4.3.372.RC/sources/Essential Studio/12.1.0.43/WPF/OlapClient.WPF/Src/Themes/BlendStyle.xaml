<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"   
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Client.Olap">


    <Style TargetType="{x:Type local:OlapClient}">
        <Setter Property="Background" Value="#FF333333"/>
        <Setter Property="BorderBrush" Value="#FF595959"/>
        <Setter Property="HeaderBackground" Value="#FF595959"/>
        <Setter Property="HeaderBorderBrush" Value="#FF595959"/>
        <Setter Property="HeaderMouseOverBackground">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF3373AC" Offset="0.019"/>
                    <GradientStop Color="#FF4B87B9" Offset="0.948"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderMouseOverBorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <!--<Setter Property="ListBoxStyle" Value="{StaticResource style}"/>-->
        <!--<Style.Triggers>
            <Trigger Property="IsDragOver" Value="True">
                <Setter Property="HeaderBackground" Value="Red"/>
            </Trigger>
        </Style.Triggers>-->
    </Style>

    <!--<Style x:Key="style" TargetType="ListBox">
        <Setter Property="Background" Value="Red">            
        </Setter>    
    </Style>-->
</ResourceDictionary>
