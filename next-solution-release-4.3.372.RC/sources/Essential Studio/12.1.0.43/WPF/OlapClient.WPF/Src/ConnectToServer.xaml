<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Client.Olap.ConnectToServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="ConnectToServer" Height="150" Width="300"
    Name="connectToServer1" ResizeMode="NoResize"
    Icon="App.ico"
    WindowStartupLocation="CenterScreen" >
    <Grid Margin="2,5,2,5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".35*"/>
                <ColumnDefinition Width=".65*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="5,2,2,2" VerticalAlignment="Center"   Name="tbConnectToServer"  Text="Server Name :"/>
            <TextBox Grid.Column="1" Margin="2,4,2,4"  Name="txtServerName" Text="localhost"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".35*"/>
                <ColumnDefinition Width=".65*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="5,2,2,2" VerticalAlignment="Center"   Name="tbDataBaseName" Text="Database Name :"/>
            <TextBox Grid.Column="1" Margin="2,4,2,4"   Name="txtDatabaseName" Text="Adventure Works DW"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".7*"/>
                <ColumnDefinition Width=".3*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="2,4,2,4" HorizontalAlignment="Right" Width="70"  Name="btnOK" Content="OK" Click="btnOK_Click" IsDefault="True"/>
            <Button Grid.Column="1" Margin="2,4,2,4"   Name="btnCancel" Content="Cancel" Click="btnCancel_Click" IsCancel="True" />
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>