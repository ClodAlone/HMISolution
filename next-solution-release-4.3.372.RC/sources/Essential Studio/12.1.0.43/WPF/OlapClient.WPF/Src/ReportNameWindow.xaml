<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Client.Olap.ReportNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resource="clr-namespace:Syncfusion.Windows.Client.Olap.Resources"
    Name="reportNameWindow" Title="{Binding ElementName=textBlockTitle, Path=Text}" 
                              xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    HorizontalAlignment="Center" VerticalAlignment="Center" Height="105" MinHeight="100" MinWidth="250" Width="250"
    Icon="App.ico" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <resource:ReportNameResourceWrapper x:Key="ResourceWrapperKeys" />
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <!-- Since, Resource wrapper is added as resource of the window. We can't bind the title directly. 
			So, we are binding this text block with the title. The Title will bind to this text block-->
        <TextBlock x:Name="textBlockTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientReportNameDlgReportName}" Visibility="Collapsed" />
        <Grid Grid.Row="0" Margin="7,7,7,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientReportNameDlgReportName}"/>
            <TextBox Grid.Column="2" Margin="0,0,0,0" Height="25" Name="txtReportName"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,7,7">
            <Button Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientReportNameDlgOk}" Name="btnOK" Margin="2,2,0,0" Width="65" Height="23" HorizontalAlignment="Right" Click="btnOK_Click" IsDefault="True"/>
            <Button Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapClientReportNameDlgCancel}" Name="btnCancel" Margin="7,2,0,0" Width="65" Height="23" HorizontalAlignment="Right" Click="btnCancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
