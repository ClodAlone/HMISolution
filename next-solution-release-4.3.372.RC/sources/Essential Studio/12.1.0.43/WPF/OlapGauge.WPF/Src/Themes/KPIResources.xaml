<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:Syncfusion.Windows.Gauge.Olap">

    <Style x:Key="StatusType" TargetType="{x:Type syn:GaugeImage}">
        <Setter Property="Style">
            <Setter.Value>
                <DataTemplate >
                    <Grid>
                        <Image Name="StatusImage" Margin="1,1,1,16" Height="32" Width="16"  />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding}" Value="1">
                            <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Circle.png" TargetName="StatusImage" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="0">
                            <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Triangle.png" TargetName="StatusImage" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="2">
                            <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Diamond.png" TargetName="StatusImage" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
    <DataTemplate x:Key="Status">
        <Grid>
            <Image Name="StatusImage" Margin="1,1,1,16" Height="32" Width="16"  />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="1">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Circle.png" TargetName="StatusImage" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="0">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Triangle.png" TargetName="StatusImage" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="2">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Diamond.png" TargetName="StatusImage" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="StatusRoadSigns">
        <Grid>
            <Image Name="StatusRoadSignsImage" Margin="1,1,1,16" Height="32"  Width="16"  />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="1">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Green.png" TargetName="StatusRoadSignsImage" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="0">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Yellow.png" TargetName="StatusRoadSignsImage" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="2">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/Red.png" TargetName="StatusRoadSignsImage" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Trend">
        <Grid>
            <Image Name="TrendImage" Margin="1,1,1,16" Height="32"  Width="16"  />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="1">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/UpArrow.png" TargetName="TrendImage" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="0">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/RightArrow.png" TargetName="TrendImage" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="2">
                <Setter Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapGauge.WPF;component//Images/KPI/DownArrow.png" TargetName="TrendImage" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>