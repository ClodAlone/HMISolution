<sync:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Viewer.Dialogs.ExceptionDetail" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sync="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf/shared"
    sync:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:prop="clr-namespace:Syncfusion.ReportViewer.WPF.Properties"
    Title="Issue Details" ResizeMode="NoResize" Height="272" Width="480"
    WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#FFF0F0F0" Foreground="Black"
    ShowInTaskbar="False" UseNativeChrome="True" Icon="..\Icons\error.png">
    <sync:WindowChrome.WindowChrome>
        <sync:WindowChrome GlassFrameThickness="0" CornerRadius="12"/>
    </sync:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type Hyperlink}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Blue" />
                    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="#015FAC" />
            <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="213*"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>
        <RichTextBox Name="textBlockStackTrace"  FlowDirection="LeftToRight" HorizontalAlignment="Left" VerticalAlignment="Stretch"  IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="2,2,2,2" >
            <FlowDocument LineHeight="1">
            </FlowDocument>
        </RichTextBox>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="10,0,0,0"><Hyperlink Click="Hyperlink_Click" FontFamily="Arial">Click here to copy issue details</Hyperlink></TextBlock>
    </Grid>
</sync:ChromelessWindow>
