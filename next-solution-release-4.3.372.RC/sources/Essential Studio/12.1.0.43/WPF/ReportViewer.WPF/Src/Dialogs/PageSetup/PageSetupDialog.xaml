<sync:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Viewer.Dialogs.PageSetupDialog" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sync="http://schemas.syncfusion.com/wpf"
    sync:SkinStorage.VisualStyle="Office2007Blue"
    Title="Page Setup" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" WindowStyle="None" Width="400" Height="280"
    ShowInTaskbar="False" UseNativeChrome="True" ShowIcon="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
            <RowDefinition Height="41*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Name="textblock_paper" Text="Paper" Height="20" Margin="20,10,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="30,10,0,0" Height="20" >
                <TextBlock Name="textblock_size" Text="Size:" Width="50"/>
                <ComboBox Name="cmb_PageSize" Width="280"/>
            </StackPanel>
            <StackPanel Margin="30,10,0,0" x:Name="stpnl_CustomSize" Orientation="Horizontal" Height="20" IsEnabled="False" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                    <TextBlock Name="textblock_width" Text="Width:" Width="50"/>
                    <sync:UpDown Name="updwn_Width" Width="80" HorizontalAlignment="Left" MinValue="0.5" MaxValue="22" Step=".1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="70,0,0,0" >
                    <TextBlock Name="textblock_height" Text="Height:" Width="50"/>
                    <sync:UpDown Name="updwn_Height" Width="80" HorizontalAlignment="Left" MinValue="0.5" MaxValue="22" Step=".1"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="10,10,0,0"  Orientation="Vertical" VerticalAlignment="Top" Height="90" Width="100" HorizontalAlignment="Left">
            <TextBlock Name="textblock_orientation" Text="Orientation" Height="20" Margin="10,0,0,0"/>
            <RadioButton Margin="20,0,0,0" x:Name="rbtn_portrait" Content="Portrait" Width="100" IsChecked="True"/>
            <RadioButton Margin="20,10,0,0" x:Name="rbtn_landscape" Content="Landscape" Width="100" />
        </StackPanel>
        <StackPanel Grid.Row="1"  Height="90" HorizontalAlignment="Left" Margin="130,10,0,0" VerticalAlignment="Top" Width="250">
            <TextBlock Text="Margins(inches)" Height="20"/>
            <Grid Height="50" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45*" />
                    <RowDefinition Height="45*" />
                </Grid.RowDefinitions>
                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" >
                    <TextBlock Name="textblock_left" Text="Left:" Width="45"/>
                    <sync:UpDown Name="updwn_Left" Width="60" HorizontalAlignment="Left" MinValue="0" MaxValue="22" Step=".1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                    <TextBlock Name="textblock_right" Text="Right:" Width="45"/>
                    <sync:UpDown Name="updwn_Right" Width="60" HorizontalAlignment="Left" MinValue="0" MaxValue="22" Step=".1" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" >
                    <TextBlock Name="textblock_top" Text="Top:" Width="45"/>
                    <sync:UpDown Name="updwn_Top" Width="60" HorizontalAlignment="Left" MinValue="0" MaxValue="22" Step=".1"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                    <TextBlock Name="textblock_bottom" Text="Bottom:" Width="45"/>
                    <sync:UpDown Name="updwn_Bottom" Width="60" HorizontalAlignment="Left" MinValue="0" MaxValue="22" Step=".1" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Name="btn_setDefault" Content="Set Default" Height="25" Width="80" Margin="10,0,0,0" />
            <Button Name="btn_Ok" Content="Ok" Height="25" Margin="120,0,0,0"  Width="70" />
            <Button Name="btn_Cancel" Content="Cancel" Height="25" Margin="10,0,0,0" Width="70" />
        </StackPanel>
        <GridSplitter Height="60" Background="CornflowerBlue" Width="1" Margin="120,20,0,0" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <GridSplitter Grid.Row="1" Height="1" Background="CornflowerBlue" Width="450" Margin="-30,-5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <GridSplitter Grid.Row="2" Height="1" Background="CornflowerBlue" Width="450" Margin="-30,-5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
    </Grid>
</sync:ChromelessWindow>
