    <Style TargetType="local:ScheduleHorizontalView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_HorizontalTimeSlotScrollViewer" 
							HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" 
							Background="{TemplateBinding Background}" Style="{StaticResource ScheduleScrollViewStyle}">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="55" />
                                    <RowDefinition Height="Auto" MinHeight="30" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <local:ScheduleHorizontalTimeLineItemsControl TimelineVisibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ScheduleHorizontalView}}, Path=TimelineVisibility, Mode=OneWay}" HorizontalAlignment="Left" x:Name="PART_HorizontalTimeLineItemsControl" LinesStroke="#FFA9B0B8" Background="White" BorderBrush="#FFA9B0B8" BorderThickness="0.5" Height="55" Grid.Row="0"  > 
                                    <local:ScheduleHorizontalTimeLineItemsControl.ContextMenu>
                                        <ContextMenu Style="{StaticResource ContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"  x:Name="ContextMenuHorizontalTimeLineItems"/>
                                    </local:ScheduleHorizontalTimeLineItemsControl.ContextMenu>
                                </local:ScheduleHorizontalTimeLineItemsControl>
                                <local:ScheduleHorizontalDaysHeaderViewItemsControl HorizontalAlignment="Left" x:Name="PART_HorizontalDaysHeaderControl" Height="30" Grid.Row="1" />
                                <local:ScheduleHorizontalTimeSlotItemsControl HorizontalAlignment="Left" x:Name="PART_HorizontalTimeSlot" VerticalAlignment="{TemplateBinding VerticalAlignment}" Grid.Row="2">
                                    <local:ScheduleHorizontalTimeSlotItemsControl.ContextMenu>
                                        <ContextMenu Style="{StaticResource ContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" x:Name="ContextMenuHorizontalTimeSlotItems"/>
                                    </local:ScheduleHorizontalTimeSlotItemsControl.ContextMenu>
                                </local:ScheduleHorizontalTimeSlotItemsControl>
                                <local:ScheduleHorizontalAppointmentLayoutItemsControl x:Name="PART_HorizontalAppointmentsLayout" Grid.Row="2" >
                                    <local:ScheduleHorizontalAppointmentLayoutItemsControl.ContextMenu>
                                        <ContextMenu Style="{StaticResource ContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" x:Name="ContextMenuHorizontalAppointmentItems"/>
                                    </local:ScheduleHorizontalAppointmentLayoutItemsControl.ContextMenu>
                                </local:ScheduleHorizontalAppointmentLayoutItemsControl>
                                <Grid x:Name="PART_HorizontalAppointmentPopup" Grid.Row="2" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>