                        <Button x:Name="PART_PrevButton" Height="20" Style="{StaticResource PrevNavigationButtonStyle}" Width="20" Grid.Column="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

