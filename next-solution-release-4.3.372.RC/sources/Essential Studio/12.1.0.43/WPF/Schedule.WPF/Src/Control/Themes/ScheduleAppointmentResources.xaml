	<local:ScheduleRecurrenceIsCheckedConverter x:Key="RadioCheckedConverterKey" />
    <Style TargetType="local:ScheduleRecurrenceConfirmationWindow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleRecurrenceConfirmationWindow">
                    <Grid x:Name="grid" Background="#FFF0F0F0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock x:Name="PART_Message" Margin="5" Text="{Binding Appointment.RecurrenceAlertMessage, Mode=TwoWay}" TextWrapping="Wrap"/>
						<RadioButton Grid.Row="1" Margin="5" VerticalAlignment="Center" x:Name="PART_NonRecurrence" IsChecked="{Binding Appointment.IsRecurrenceAppointment, Converter={StaticResource RadioCheckedConverterKey}, Mode=TwoWay}" Content="{Binding Source={StaticResource ResourceWrapper},Path=RecurrenceAlertWindowOpen}"/>
						<RadioButton Grid.Row="2" Margin="5" VerticalAlignment="Center" x:Name="PART_Recurrence" IsChecked="{Binding Appointment.IsRecurrenceAppointment, Mode=TwoWay}" Content="{Binding Source={StaticResource ResourceWrapper},Path=RecurrenceAlertWindowOpenSeries}"/>
						<StackPanel Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
							<Button Content="{Binding Source={StaticResource ResourceWrapper},Path=Ok}" x:Name="PART_OkButton" Height="23" Width="60" Margin="2"/>
							<Button Content="{Binding Source={StaticResource ResourceWrapper},Path=Cancel}" x:Name="PART_CancelButton" Height="23" Width="60" Margin="2"/>
						</StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:ScheduleHeaderTitleBar">
        <Setter Property="Template">
            <Setter.Value>
