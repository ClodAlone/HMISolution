                                    <schedule:ScheduleTimeLineItemsControl.ContextMenu>
                                        <ContextMenu x:Name="ContextMenuTimeLineItemsControl" Style="{StaticResource ContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </schedule:ScheduleTimeLineItemsControl.ContextMenu>
                                </schedule:ScheduleTimeLineItemsControl>
                                <schedule:ScheduleTimeSlotItemsControl x:Name="PART_TimeSlot" VerticalAlignment="Top" Grid.Column="1">
                                    <schedule:ScheduleTimeSlotItemsControl.ContextMenu>
                                        <ContextMenu x:Name="ContextMenuTimeSlot"  FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI"   Style="{StaticResource ContextMenuStyle}" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
