                                                <Path x:Name="X" Stroke="#FF3B3B3B" Fill="#FFFFFFFF" Stretch="Fill" HorizontalAlignment="Center" Margin="0,-1,0,0" VerticalAlignment="Center" Width="12" Height="10" Opacity="0.7" Data="F1 M 6.742676,3.852539 L 9.110840,1.559570 L 8.910645,0.500000 L 6.838379,0.500000 L 4.902832,2.435547 L 2.967285,0.500000 L 0.895020,0.500000 L 0.694824,1.559570 L 3.062988,3.852539 L 0.527832,6.351563 L 0.689941,7.600586 L 2.967285,7.600586 L 4.897949,5.575195 L 6.854004,7.600586 L 9.115723,7.600586 L 9.277832,6.351563 L 6.742676,3.852539 Z"/>
