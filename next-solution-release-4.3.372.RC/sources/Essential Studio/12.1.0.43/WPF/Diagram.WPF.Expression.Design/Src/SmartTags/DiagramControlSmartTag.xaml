<syncfusion:SmartTagBase x:Class="Syncfusion.Diagram.WPF.Expression.Design.DiagramControlSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="Diagram Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Diagram</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0"  Width="120" Height="25" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>

                <!--<TextBlock Text="Text" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtText" Grid.Row="3" 
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Visible"
                         Grid.Column="1" Margin="5,5,0,0" Text="" Width="200" Height="25" HorizontalAlignment="Stretch" />-->

                <TextBlock Text="Background" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbBackground" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Foreground" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbForeground" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="BorderBrush" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbBorderBrush" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="BorderThickness" Grid.Row="7" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtBorderThickness" Grid.Row="7" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Behavior</TextBlock>
                <CheckBox x:Name="chkline" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="IsSymbolPaletteEnabled" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                
            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
    