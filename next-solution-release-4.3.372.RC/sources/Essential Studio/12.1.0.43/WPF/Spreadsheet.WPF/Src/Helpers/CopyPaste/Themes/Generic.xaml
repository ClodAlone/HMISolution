<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Wpf"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet">

    <ImageSource x:Key="PasteIcon">/Syncfusion.Spreadsheet.Wpf;component/Helpers/CopyPaste/PasteIcon.png</ImageSource>

    <Style x:Key="DropDownStyle" TargetType="local:PasteDropDownItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PasteDropDownItem">
                    <Border Background="#FFFFEEC2"
                            BorderBrush="#FFF0D14D"
                            BorderThickness="1">
                        <shared:SplitButtonAdv Name="dropdownSplitter" SmallIcon="{StaticResource PasteIcon}" Label="" Background="#FFFFEEC2" BorderBrush="#FFF0D14D" BorderThickness="1">
                            <ListBox Name="FillList" BorderBrush="White">
                                <ListBox.Items>
                                    <ListBoxItem Height="32">
                                        <RadioButton Name="FormulaButton" Content="Formulas" Margin="8,8,8,8" GroupName="Paste" IsChecked="True"></RadioButton>
                                    </ListBoxItem>
                                    <ListBoxItem Height="32">
                                        <RadioButton Name="ValueButton" Content="Values" Margin="8,8,8,8" GroupName="Paste"></RadioButton>
                                    </ListBoxItem>
                                </ListBox.Items>
                            </ListBox>
                        </shared:SplitButtonAdv>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DropDownStyle}" TargetType="local:PasteDropDownItem"></Style>

</ResourceDictionary>