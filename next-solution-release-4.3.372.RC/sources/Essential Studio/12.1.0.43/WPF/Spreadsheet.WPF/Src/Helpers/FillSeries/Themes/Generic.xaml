<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib"
                    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Wpf"  
                    xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources">

    <ImageSource x:Key="FillIcon">/Syncfusion.Spreadsheet.Wpf;component/Helpers/FillSeries/DropDownIcon.png</ImageSource>

    <Style x:Key="DropDownStyle" TargetType="local:FillDropDownItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:FillDropDownItem">
                    <Border Background="#FFFFEEC2"
                            BorderBrush="#FFF0D14D"
                            BorderThickness="1">
                        <shared:SplitButtonAdv Name="dropdownSplitter" SmallIcon="{StaticResource FillIcon}" Label="" Background="#FFFFEEC2" BorderBrush="#FFF0D14D" BorderThickness="1">
                            <ListBox Name="FillList" BorderBrush="White">
                                <ListBox.Items>
                                    <ListBoxItem  Height="32">
                                        <RadioButton Name="FillSeries" Content="FillSeries" Margin="8,8,8,8" GroupName="Fill" IsChecked="True"></RadioButton>
                                    </ListBoxItem>
                                    <ListBoxItem  Height="32">
                                        <RadioButton Name="CopySeries" Content="CopySeries" Margin="8,8,8,8" GroupName="Fill"></RadioButton>
                                    </ListBoxItem>
                                    <ListBoxItem  Height="32">
                                        <RadioButton Name="FillFormatOnly" Content="FillFormatOnly" Margin="8,8,8,8" GroupName="Fill"></RadioButton>
                                    </ListBoxItem>
                                    <ListBoxItem  Height="32">
                                        <RadioButton Name="FillWithoutFormat" Content="FillWithoutFormat" Margin="8,8,8,8" GroupName="Fill"></RadioButton>
                                    </ListBoxItem>
                                </ListBox.Items>
                            </ListBox>
                        </shared:SplitButtonAdv>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DropDownStyle}" TargetType="local:FillDropDownItem"></Style>

</ResourceDictionary>