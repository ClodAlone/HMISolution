<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.FormatAsTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="formatWindow"
        Width="250" Height="130"  WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Title="Format As Table">
    <Grid x:Name="LayoutRoot" Background="#F0F0F0">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" Margin="5" Width="220" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBox x:Name="txtValue" Text="{Binding Path=Text,Mode=TwoWay,ElementName=formatWindow}" Margin="5" Width="230"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
