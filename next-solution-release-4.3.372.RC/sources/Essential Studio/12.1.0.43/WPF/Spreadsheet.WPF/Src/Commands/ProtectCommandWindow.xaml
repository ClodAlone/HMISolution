<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.ProtectCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="protectWindow"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
        Width="290" Height="155" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Title="Table">
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=protectWindow}" Margin="5" Height="20"  Width="275" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Path=DescriptionText,Mode=TwoWay,ElementName=protectWindow}" Margin="5" Height="20" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <PasswordBox  x:Name="txtValue"   Margin="5"  Width="270"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,3,0" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
