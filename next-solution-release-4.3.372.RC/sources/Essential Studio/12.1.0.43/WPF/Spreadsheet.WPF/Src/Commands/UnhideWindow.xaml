<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.UnhideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="formatWindow"
         Width="290" Height="175" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" Margin="5,5,2,0" Width="200"   HorizontalAlignment="Left"/>
            <ListBox SelectedIndex="0" x:Name="sheetListBox" Height="80" Width="270" Margin="5,0,5,5" VerticalAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding Path=HiddenSheet, Mode=TwoWay, ElementName=formatWindow}"/>
            <StackPanel Margin="5,5,3,5" Orientation="Horizontal"  HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
