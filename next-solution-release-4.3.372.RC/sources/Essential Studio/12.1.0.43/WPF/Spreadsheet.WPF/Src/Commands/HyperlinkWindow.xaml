<Window x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.HyperlinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf"
        x:Name="commentWindow"
        Width="320" Height="125"  WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Texttodisplay}" Margin="5"/>
        <TextBox x:Name="DisplayTextBox" Grid.Column="1" Margin="5" Text="{Binding ElementName=commentWindow,Path=TextToDisplay,Mode=TwoWay}"/>

        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Address}" Margin="5" Grid.Row="1"/>
        <TextBox Name="AddressText" Grid.Column="1" Margin="5" Text="{Binding ElementName=commentWindow,Path=Address,Mode=TwoWay}" Grid.Row="1"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Margin="5" HorizontalAlignment="Right" Width="70" Click="OnOkButtonClick"/>
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="5" HorizontalAlignment="Left" Width="70" Click="OnCancelButtonClick"/>
        </StackPanel>
    </Grid>
</Window>
