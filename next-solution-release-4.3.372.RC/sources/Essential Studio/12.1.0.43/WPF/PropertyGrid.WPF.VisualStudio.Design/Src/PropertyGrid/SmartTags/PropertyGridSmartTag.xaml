<syncfusion:SmartTagBase x:Class="Syncfusion.PropertyGrid.WPF.VisualStudio.Design.PropertyGridSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    <syncfusion:SmartTagPresenter Title="PropertyGrid Tasks">

<syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <Grid Background="#FFDCEBFE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
           
            <StackPanel Margin="7" Grid.Row="0">
                <TextBlock FontWeight="Bold">Essential Tools - PropertyGrid</TextBlock>
              
            </StackPanel>
            
            


            <StackPanel  Margin="7" Grid.Row="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <Border   Grid.Row="0" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>

                    <TextBlock Text="Name" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                    <TextBox Name="name"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>
               
                     <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="2" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0"  FontWeight="Bold" Grid.Row="3">Appearance</TextBlock>
               
                    
                    
                    
                        <TextBlock VerticalAlignment="Center" Text="Button Panel Visibility" Grid.Row="5" Grid.Column="0"/>
                        <ComboBox Name="buttonPanelVisibility" Margin="3,3,3,3" Width="115" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Search Box Visibility" Grid.Row="6" Grid.Column="0"/>
                    <ComboBox Name="searchBoxVisibility" Margin="3,3,3,3" Width="115" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Description Panel Visibility" Grid.Row="7" Grid.Column="0"/>
                    <ComboBox Name="descriptionPanelVisibility" Margin="3,3,3,3" Width="115" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Property Expand Mode" Grid.Row="8" Grid.Column="0"/>
                    <ComboBox Name="propertyExpandMode" Margin="3,3,3,3" Width="115" Grid.Row="8" Grid.Column="1"/>





                    <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="9" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="10">Behavior</TextBlock>

                    <StackPanel Grid.Row="11"  Margin="7">
                        
                       


                      <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="collapseSidePanel"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Collapse SidePanel
                        </TextBlock>
                    </StackPanel>

                        
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="enableGrouping"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Enable Grouping
                        </TextBlock>
                    </StackPanel>
                    
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="enableToolTip"/>
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    EnableToolTip
                        </TextBlock>
                    </StackPanel>
                        
                    
                    
                      
                        
                        
                            </StackPanel>
                         
                </Grid>
            </StackPanel>
        </Grid>

        
   
        </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>

