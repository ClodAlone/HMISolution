                        <ContentPresenter Content="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LegendSymbol}" x:Name="PART_LegendSymbol"></ContentPresenter>
                        <TextBlock  Margin="10" Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=LegendText}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
      
    <Style TargetType="{x:Type local:MapPath}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:MapPath}">
                    <Border BorderBrush="{TemplateBinding PathStroke}" BorderThickness="{TemplateBinding PathStrokeThickness}">
                            <Grid>
                                <ContentPresenter Content="{TemplateBinding MapPathContent}"/>
                                <TextBlock Text="{TemplateBinding PathLabel}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=PathLabelVisibility}" Margin="{TemplateBinding LabelMargin}" x:Name="PART_PathLabel" FontStyle="{TemplateBinding PathLabelFontStyle}" IsHitTestVisible="False" FontSize="{TemplateBinding PathLabelFontSize}" FontFamily="{TemplateBinding PathLabelFontFamily}" Foreground="{TemplateBinding PathLabelForeground}"  >                                  
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Angle}" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:ImageryLayer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageryLayer}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid x:Name="PART_BingMapGrid" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                           
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:Tile}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Tile}">
                    <Grid>                    
                         <Image Source="{TemplateBinding TileImageSource}" Height="256" Width="256" Stretch="Uniform">                                
                                </Image>                 
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
