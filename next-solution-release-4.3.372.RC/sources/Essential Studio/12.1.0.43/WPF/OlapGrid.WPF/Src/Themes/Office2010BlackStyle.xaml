<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls.Scroll;assembly=Syncfusion.GridCommon.Wpf"
    xmlns:local="clr-namespace:Syncfusion.Windows.Grid.Olap"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Grid.Olap.Resources">

    <resources:ResourceWrapper x:Key="ResourceWrapperKeys" />

    <SolidColorBrush Color="Gray" x:Key="Office2010Black.GridBackground"/>

    <LinearGradientBrush x:Key="Office2010Black.ColumnHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE7E7E7"/>
        <GradientStop Color="Gainsboro" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010Black.RowHeaderBackgroundBrush" Color="#FFEFF1F4"/>
    <SolidColorBrush x:Key="Office2010Black.ValueCellBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Office2010Black.SummaryColumnBackgroundBrush" Color="#FF3B3B3B"/>
    <SolidColorBrush x:Key="Office2010Black.SummaryRowBackgroundBrush" Color="#FF3B3B3B"/>

    <SolidColorBrush x:Key="Office2010Black.ColumnHeaderForegroundBrush" Color="#FF363636"/>
    <SolidColorBrush x:Key="Office2010Black.RowHeaderForegroundBrush" Color="#FF363636"/>
    <SolidColorBrush x:Key="Office2010Black.ValueCellForegroundBrush" Color="#FF6C6D6F"/>
    <SolidColorBrush x:Key="Office2010Black.SummaryColumnForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="Office2010Black.SummaryRowForegroundBrush" Color="White"/>

    <!--Tooltip Assets-->
    <LinearGradientBrush x:Key="Office2010Black.TooltipBackground" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#FFE9E9E9" Offset="0"/>
        <GradientStop Color="#FFDEDEDE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2010Black.TooltipBorderBrush" Color="#FF3B3B3B"/>

    <local:OlapGridCellStyle x:Key="Office2010Black.ColumnHeaderStyle" 
                             Background="{StaticResource Office2010Black.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.ColumnHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:OlapGridCellStyle x:Key="Office2010Black.RowHeaderStyle" 
                             Background="{StaticResource Office2010Black.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.RowHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />


    <local:OlapGridCellStyle x:Key="Office2010Black.SummaryColumnStyle" 
                             Background="{StaticResource Office2010Black.SummaryColumnBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.SummaryColumnForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:OlapGridCellStyle x:Key="Office2010Black.SummaryRowStyle" 
                             Background="{StaticResource Office2010Black.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.SummaryRowForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:OlapGridCellStyle x:Key="Office2010Black.ValueCellStyle" 
                             Background="{StaticResource Office2010Black.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Office2010Black.ValueCellForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
    <LinearGradientBrush x:Key="ExpanderBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFDDDDE0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ExpanderBorderBrush" Color="#FFA9B1B8"/>

    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF4CC" Offset="0"/>
        <GradientStop Color="#FFFFEDA6" Offset="0.03"/>
        <GradientStop Color="#FFFFE178" Offset="0.298"/>
        <GradientStop Color="#FFFFE275" Offset="0.576"/>
        <GradientStop Color="#FFFFFBDF" Offset="0.97"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#FFF3C84B" x:Key="ButtonHoverBorderBrush1"/>

    <Style x:Key="ExpanderButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="11" Height="11" SnapsToDevicePixels="true" BorderBrush="Transparent" Background="Transparent"  BorderThickness="1" CornerRadius="2" Name="FrameBorder" >
                        <Path Height="8.032" Width="6" Name="path" Stretch="Fill" Fill="White" StrokeThickness="0.5" Stroke="Black" HorizontalAlignment="Left" VerticalAlignment="Top"  />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding CellDescriptor.ExpandableState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" 
                                               Value="Collapsed">
                            <Setter TargetName="path" Property="Data" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CellDescriptor.ExpandableState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" 
                                               Value="Expanded">
                            <Setter TargetName="path" Property="Data" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                            <Setter TargetName="path" Property="RenderTransformOrigin" Value="0.175,0.722"/>
                            <Setter TargetName="path" Property="Fill" Value="Black"/>
                            <Setter TargetName="path" Property="Stroke" Value="Black"/>
                            <Setter TargetName="path" Property="Width" Value="5"/>
                            <Setter TargetName="path" Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <RotateTransform Angle="40"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="path" Property="Fill" Value="#FFFDDC00"/>
                            <Setter TargetName="path" Property="Stroke" Value="{StaticResource ButtonHoverBorderBrush1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:OlapGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OlapGrid}">
                    <ControlTemplate.Resources>
                        <!--Tooltip Value convertors-->
                        <local:ValueCellToolTipConvertor x:Key="valueConverter"/>
                        <local:StringtoVisibilityConverter x:Key="stringConverter"/>
                        <local:HeaderCellToolTipConvertor x:Key="headerConverter"/>
                        <local:HeaderCellMemberPropertyToolTipConverter x:Key="headerCellMemberPropertyToolTipConverter"/>
                        <!--Tooltip template-->
                        <DataTemplate x:Key="toolTipValueTemplate">
                            <Border Background="{StaticResource Office2010Black.TooltipBackground}" BorderBrush="{StaticResource Office2010Black.TooltipBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!--Tooltip header cells-->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="RTLtoolTipValueTemplate">
                            <Border Background="Transparent" BorderThickness="1" CornerRadius="4" Margin="2,0,2,2">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFB1B3B9" Offset="0"/>
                                        <GradientStop Color="#FFE3E9EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Direction="0"/>
                                </Border.Effect>
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!--Tooltip header cells-->

                                    <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!--Headercell Tooltip-->
                        <DataTemplate x:Key="toolTipHeaderCells">
                            <Border BorderBrush="Black" BorderThickness="1" Margin="5" Background="{StaticResource Office2010Black.GridBackground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerConverter}}" ValueCellStyle="{StaticResource Office2010Black.ValueCellStyle}" ColumnHeaderStyle="{StaticResource Office2010Black.ColumnHeaderStyle}" RowHeaderStyle="{StaticResource Office2010Black.RowHeaderStyle}" SummaryColumnStyle="{StaticResource Office2010Black.SummaryColumnStyle}" SummaryRowStyle="{StaticResource Office2010Black.SummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="MemberPropertytoolTipHeaderCells">
                            <Border BorderBrush="Black" BorderThickness="1" Margin="5" Background="{StaticResource Office2010Black.GridBackground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerCellMemberPropertyToolTipConverter}}" ResizeRowsToFit="True" ResizeColumnsToFit="True" ValueCellStyle="{StaticResource Office2010Black.ValueCellStyle}" ColumnHeaderStyle="{StaticResource Office2010Black.ColumnHeaderStyle}" RowHeaderStyle="{StaticResource Office2010Black.RowHeaderStyle}" SummaryColumnStyle="{StaticResource Office2010Black.SummaryColumnStyle}" SummaryRowStyle="{StaticResource Office2010Black.SummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <ScrollViewer Grid.Row="3" 
                                     Grid.ColumnSpan="2"   
                                     x:Name="PART_GridArea" 
                                     CanContentScroll="True" 
                                     HorizontalScrollBarVisibility="Auto" 
                                     Background="{TemplateBinding Background}"  
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     VerticalScrollBarVisibility="Auto">
                        <local:OlapGridBase x:Name="PART_OlapGridBase"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Background" Value="{StaticResource Office2010Black.GridBackground}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Office2010Black.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource Office2010Black.RowHeaderStyle}"/>
        <Setter Property="SummaryColumnStyle" Value="{StaticResource Office2010Black.SummaryColumnStyle}"/>
        <Setter Property="SummaryRowStyle" Value="{StaticResource Office2010Black.SummaryRowStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Office2010Black.ValueCellStyle}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderButtonStyle}"/>
        <Setter Property="GridLineStroke" Value="#FF1F1F1F"/>
        <Setter Property="GridLineThickness" Value="0.15"/>
    </Style>

</ResourceDictionary>