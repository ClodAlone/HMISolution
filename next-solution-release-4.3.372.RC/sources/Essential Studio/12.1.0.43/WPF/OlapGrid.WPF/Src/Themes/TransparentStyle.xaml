<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls.Scroll;assembly=Syncfusion.GridCommon.Wpf"
    xmlns:local="clr-namespace:Syncfusion.Windows.Grid.Olap"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Grid.Olap.Resources">

    <resources:ResourceWrapper x:Key="ResourceWrapperKeys" />

    <SolidColorBrush Color="#4CFFFFFF" x:Key="Transparent.GridBackground"/>

    <LinearGradientBrush x:Key="Transparent.ColumnHeaderBackgroundBrush" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#ECF8FBFD"/>
        <GradientStop Color="#7EA3A3A3" Offset="1"/>
        <GradientStop Color="#C0FFFFFF"/>
        <GradientStop Color="#9BFFFFFF" Offset="0.511"/>
        <GradientStop Color="#83C7C7C7" Offset="0.515"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Transparent.RowHeaderBackgroundBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Transparent.ValueCellBackgroundBrush" Color="#4CFFFFFF"/>
    <SolidColorBrush x:Key="Transparent.SummaryColumnBackgroundBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Transparent.SummaryRowBackgroundBrush" Color="#B3FFFFFF"/>

    <SolidColorBrush x:Key="Transparent.ColumnHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.RowHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.ValueCellForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.SummaryColumnForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.SummaryRowForegroundBrush" Color="#000000"/>

    <!--Tooltip Assets-->
    <LinearGradientBrush x:Key="Office2010Blue.TooltipBackground" StartPoint="0.5,-0.00517532" EndPoint="0.5,1.00001">
        <GradientStop Color="#D8FEFEFE" Offset="0"/>
        <GradientStop Color="#CCC2C2C2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2010Blue.TooltipBorderBrush" Color="#FF535353"/>

    <local:OlapGridCellStyle x:Key="Transparent.ColumnHeaderStyle" 
                             Background="{StaticResource Transparent.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Transparent.ColumnHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:OlapGridCellStyle x:Key="Transparent.RowHeaderStyle" 
                             Background="{StaticResource Transparent.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Transparent.RowHeaderForegroundBrush}"
                             FontFamily="Segoe UI"
                             />


    <local:OlapGridCellStyle x:Key="Transparent.SummaryColumnStyle" 
                             Background="{StaticResource Transparent.SummaryColumnBackgroundBrush}"
                             Foreground="{StaticResource Transparent.SummaryColumnForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:OlapGridCellStyle x:Key="Transparent.SummaryRowStyle" 
                             Background="{StaticResource Transparent.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Transparent.SummaryRowForegroundBrush}"
                             FontFamily="Segoe UI"
                             />

    <local:OlapGridCellStyle x:Key="Transparent.ValueCellStyle" 
                             Background="{StaticResource Transparent.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Transparent.ValueCellForegroundBrush}"
                             FontFamily="Segoe UI"
                             />
    <LinearGradientBrush x:Key="ExpanderBackground"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFDDDDE0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ExpanderBorderBrush" Color="#FFA9B1B8"/>

    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF4CC" Offset="0"/>
        <GradientStop Color="#FFFFEDA6" Offset="0.03"/>
        <GradientStop Color="#FFFFE178" Offset="0.298"/>
        <GradientStop Color="#FFFFE275" Offset="0.576"/>
        <GradientStop Color="#FFFFFBDF" Offset="0.97"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#FFF3C84B" x:Key="ButtonHoverBorderBrush1"/>

    <Style x:Key="ExpanderButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="11" Height="11" SnapsToDevicePixels="true" BorderBrush="Transparent" Background="Transparent"  BorderThickness="1" CornerRadius="2" Name="FrameBorder" >
                        <Path Height="8.032" Width="6" Name="path" Stretch="Fill" Fill="#FF787878" StrokeThickness="0.5" Stroke="#FF2B2B2B" HorizontalAlignment="Left" VerticalAlignment="Top"  />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding CellDescriptor.ExpandableState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" 
                                               Value="Collapsed">
                            <Setter TargetName="path" Property="Data" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CellDescriptor.ExpandableState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" 
                                               Value="Expanded">
                            <Setter TargetName="path" Property="Data" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                            <Setter TargetName="path" Property="RenderTransformOrigin" Value="0.175,0.722"/>
                            <Setter TargetName="path" Property="Fill" Value="Black"/>
                            <Setter TargetName="path" Property="Stroke" Value="Black"/>
                            <Setter TargetName="path" Property="Width" Value="5"/>
                            <Setter TargetName="path" Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <RotateTransform Angle="40"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Path.Fill" Value="#FF585858" TargetName="path"/>
                            <Setter TargetName="path" Property="Path.Stroke" Value="#FF000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:OlapGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OlapGrid}">
                    <ControlTemplate.Resources>
                        <!--Tooltip Value convertors-->
                        <local:ValueCellToolTipConvertor x:Key="valueConverter"/>
                        <local:StringtoVisibilityConverter x:Key="stringConverter"/>
                        <local:HeaderCellToolTipConvertor x:Key="headerConverter"/>
                        <local:HeaderCellMemberPropertyToolTipConverter x:Key="headerCellMemberPropertyToolTipConverter"/>
                        <!--Tooltip template-->
                        <DataTemplate x:Key="toolTipValueTemplate">
                            <Border Background="#FFDDE4EC" BorderBrush="#FF9B9DA0" BorderThickness="1" CornerRadius="4" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!--Tooltip header cells-->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="RTLtoolTipValueTemplate">
                            <Border Background="Transparent" BorderThickness="1" CornerRadius="4" Margin="2,0,2,2">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFB1B3B9" Offset="0"/>
                                        <GradientStop Color="#FFE3E9EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Direction="0"/>
                                </Border.Effect>
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!--Tooltip header cells-->

                                    <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!--Headercell Tooltip-->
                        <DataTemplate x:Key="toolTipHeaderCells">
                            <Border BorderBrush="Black" BorderThickness="1" Margin="5" Background="{StaticResource Transparent.GridBackground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerConverter}}" ValueCellStyle="{StaticResource Transparent.ValueCellStyle}" ColumnHeaderStyle="{StaticResource Transparent.ColumnHeaderStyle}" RowHeaderStyle="{StaticResource Transparent.RowHeaderStyle}" SummaryColumnStyle="{StaticResource Transparent.SummaryColumnStyle}" SummaryRowStyle="{StaticResource Transparent.SummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="MemberPropertytoolTipHeaderCells">
                            <Border BorderBrush="Black" BorderThickness="1" Margin="5" Background="{StaticResource Transparent.GridBackground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerCellMemberPropertyToolTipConverter}}" ResizeRowsToFit="True" ResizeColumnsToFit="True" ValueCellStyle="{StaticResource Transparent.ValueCellStyle}" ColumnHeaderStyle="{StaticResource Transparent.ColumnHeaderStyle}" RowHeaderStyle="{StaticResource Transparent.RowHeaderStyle}" SummaryColumnStyle="{StaticResource Transparent.SummaryColumnStyle}" SummaryRowStyle="{StaticResource Transparent.SummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <ScrollViewer Grid.Row="3" 
                                     Grid.ColumnSpan="2"   
                                     x:Name="PART_GridArea" 
                                     CanContentScroll="True" 
                                     HorizontalScrollBarVisibility="Auto" 
                                     Background="{TemplateBinding Background}"  
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     VerticalScrollBarVisibility="Auto">
                        <local:OlapGridBase x:Name="PART_OlapGridBase"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Background" Value="{StaticResource Transparent.GridBackground}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Transparent.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource Transparent.RowHeaderStyle}"/>
        <Setter Property="SummaryColumnStyle" Value="{StaticResource Transparent.SummaryColumnStyle}"/>
        <Setter Property="SummaryRowStyle" Value="{StaticResource Transparent.SummaryRowStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Transparent.ValueCellStyle}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderButtonStyle}"/>
        <Setter Property="GridLineStroke" Value="#000000"/>
        <Setter Property="GridLineThickness" Value="0.15"/>
    </Style>

</ResourceDictionary>