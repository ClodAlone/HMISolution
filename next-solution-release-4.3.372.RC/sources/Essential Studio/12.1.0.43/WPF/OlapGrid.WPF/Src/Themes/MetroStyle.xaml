<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls.Scroll;assembly=Syncfusion.GridCommon.Wpf"
    xmlns:local="clr-namespace:Syncfusion.Windows.Grid.Olap"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Grid.Olap.Resources">

    <resources:ResourceWrapper x:Key="ResourceWrapperKeys" />
    
    <!--<SolidColorBrush x:Key="Blend.GridLineStroke" Color="Black" />
    <SolidColorBrush Color="#FF595959" x:Key="Blend.GridBackground"/>
    <SolidColorBrush x:Key="Blend.ColumnHeaderBackgroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Blend.RowHeaderBackgroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Blend.ValueCellBackgroundBrush" Color="#FF414141"/>
    <SolidColorBrush x:Key="Blend.SummaryColumnBackgroundBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="Blend.SummaryRowBackgroundBrush" Color="#FF2E2E2E"/>

    <SolidColorBrush x:Key="Blend.ColumnHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.RowHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.ValueCellForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.SummaryColumnForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.SummaryRowForegroundBrush" Color="#FFFFFF"/>-->

    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>
    <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroFocusedBorderBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />

    <local:OlapGridCellStyle x:Key="MetroColumnHeaderStyle" 
                             Background="{StaticResource MetroBrush}"
                             Foreground="{StaticResource MetroHighlightedForegroundBrush}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />

    <local:OlapGridCellStyle x:Key="MetroRowHeaderStyle" 
                             Background="{StaticResource MetroBrush}"
                             Foreground="{StaticResource MetroHighlightedForegroundBrush}"
                             FontFamily="Segoe WP"
                             FontSize="13"
                             />


    <local:OlapGridCellStyle x:Key="MetroSummaryColumnStyle" 
                             Background="{StaticResource MetroHoverBrush}"
                             Foreground="{StaticResource MetroForegroundBrush}"
                             FontFamily="Segoe WP"
                             FontWeight="SemiBold"                             
                             FontSize="12"
                             />

    <local:OlapGridCellStyle x:Key="MetroSummaryRowStyle" 
                             Background="{StaticResource MetroHoverBrush}"
                             Foreground="{StaticResource MetroForegroundBrush}"
                             FontFamily="Segoe WP"
                             FontWeight="SemiBold"
                             FontSize="12"
                             />

    <local:OlapGridCellStyle x:Key="MetroValueCellStyle" 
                             Background="{DynamicResource MetroPanelBackgroundBrush}"
                             Foreground="{DynamicResource MetroForegroundBrush}"
                             FontFamily="Segoe WP"
                             FontSize="12"
                             />

    <local:OlapGridCellStyle x:Key="MetroValueCellTooltipStyle" 
                             Background="{StaticResource MetroPanelBackgroundBrush}"
                             Foreground="{StaticResource MetroForegroundBrush}"
                             FontFamily="Segoe WP"
                             FontSize="12"
                             />
    <Style x:Key="ExpanderButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="11" Height="11" SnapsToDevicePixels="true" BorderBrush="Transparent" Background="Transparent"  BorderThickness="1" CornerRadius="2" Name="FrameBorder" >
                        <Path Name="path" Fill="{StaticResource MetroHighlightedForegroundBrush}" Stretch="Fill" Margin="0"   VerticalAlignment="Center" HorizontalAlignment="Center"  />
                    </Border>
                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding CellDescriptor.ExpandableState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" Value="Collapsed">
                            <Setter TargetName="path" Property="Data" Value="M357,301 L357.5,352.5 422.5,325.5 z"/>
                            <Setter TargetName="path" Property="Width" Value="8"/>
                            <Setter TargetName="path" Property="Height" Value="8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CellDescriptor.ExpandableState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" Value="Expanded">
                            <Setter TargetName="path" Property="Data" Value="M290.5,329 L312.5,329.5 302.5,347.5 z"/>
                            <Setter TargetName="path" Property="Width" Value="8"/>
                            <Setter TargetName="path" Property="Height" Value="8"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"  Value="true">
                            <Setter Property="Fill" Value="{StaticResource MetroHighlightedForegroundBrush}" TargetName="path"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <Style TargetType="{x:Type local:OlapGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OlapGrid}">
                    <ControlTemplate.Resources>
                        <!--Tooltip Value convertors-->
                        <local:ValueCellToolTipConvertor x:Key="valueConverter"/>
                        <local:StringtoVisibilityConverter x:Key="stringConverter"/>
                        <local:HeaderCellToolTipConvertor x:Key="headerConverter"/>
                        <local:HeaderCellMemberPropertyToolTipConverter x:Key="headerCellMemberPropertyToolTipConverter"/>
                        <!--Tooltip template-->
                        <DataTemplate x:Key="toolTipValueTemplate">
                            <Border Background="{StaticResource MetroBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="2" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!--Tooltip header cells-->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="3,2,2,1" Visibility="{Binding Visibility,ElementName=tbmeasure}" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Margin="3,1,2,1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Margin="3,1,2,1" Visibility="{Binding Visibility,ElementName=tbrows}" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1"  Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Foreground="{StaticResource MetroHighlightedForegroundBrush}" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="RTLtoolTipValueTemplate">
                            <Border Background="Transparent" BorderThickness="1" CornerRadius="4" Margin="2,0,2,2">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFB1B3B9" Offset="0"/>
                                        <GradientStop Color="#FFE3E9EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Direction="0"/>
                                </Border.Effect>
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!--Tooltip header cells-->

                                    <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!--Headercell Tooltip-->
                        <DataTemplate x:Key="toolTipHeaderCells">
                            <Border BorderBrush="Transparent" BorderThickness="1" Background="{StaticResource MetroBrush}" Margin="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerConverter}}" ValueCellStyle="{StaticResource MetroValueCellTooltipStyle}" ColumnHeaderStyle="{StaticResource MetroColumnHeaderStyle}" RowHeaderStyle="{StaticResource MetroRowHeaderStyle}" SummaryColumnStyle="{StaticResource MetroSummaryColumnStyle}" SummaryRowStyle="{StaticResource MetroSummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="MemberPropertytoolTipHeaderCells">
                            <Border BorderBrush="Transparent" BorderThickness="1" Background="{StaticResource MetroBrush}" Margin="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerCellMemberPropertyToolTipConverter}}" ResizeRowsToFit="True" ResizeColumnsToFit="True" ValueCellStyle="{StaticResource MetroValueCellTooltipStyle}" ColumnHeaderStyle="{StaticResource MetroColumnHeaderStyle}" RowHeaderStyle="{StaticResource MetroRowHeaderStyle}" SummaryColumnStyle="{StaticResource MetroSummaryColumnStyle}" SummaryRowStyle="{StaticResource MetroSummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <ScrollViewer Grid.Row="3" 
                                     Grid.ColumnSpan="2"   
                                     x:Name="PART_GridArea" 
                                     CanContentScroll="True" 
                                     HorizontalScrollBarVisibility="Auto" 
                                     Background="{TemplateBinding Background}"  
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     VerticalScrollBarVisibility="Auto">
                        <local:OlapGridBase x:Name="PART_OlapGridBase"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource MetroColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource MetroRowHeaderStyle}"/>
        <Setter Property="SummaryColumnStyle" Value="{StaticResource MetroSummaryColumnStyle}"/>
        <Setter Property="SummaryRowStyle" Value="{StaticResource MetroSummaryRowStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource MetroValueCellStyle}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderButtonStyle}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="GridLineThickness" Value="0.15"/>

    </Style>

</ResourceDictionary>
