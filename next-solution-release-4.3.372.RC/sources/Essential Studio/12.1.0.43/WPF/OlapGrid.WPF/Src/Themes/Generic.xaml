    </Style>

    <Style TargetType="{x:Type local:OlapGridTemplateCell}"
           BasedOn="{StaticResource {x:Type ContentControl}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OlapGridTemplateCell}">
                    <TextBlock Text="{Binding CellValue}" 
                               Background="{Binding Background,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridTemplateCell}}}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:OlapGridHyperlinkCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OlapGridHyperlinkCell}">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" x:Name="PART_CellValueTextBlock" Text="{Binding Path=CellValue}"
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand"                               
                                           />
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_CellValueTextBlock" Property="TextDecorations"  Value="Underline"/>
                            <Setter TargetName="PART_CellValueTextBlock" Property="Foreground"  Value="Red"/>
                            <Setter TargetName="PART_CellValueTextBlock" Property="Cursor"  Value="Hand"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:OlapGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OlapGrid}">
                    <ControlTemplate.Resources>
                        <!--Tooltip Value convertors-->
                        <local:ValueCellToolTipConvertor x:Key="valueConverter"/>
                        <local:StringtoVisibilityConverter x:Key="stringConverter"/>
                        <local:HeaderCellToolTipConvertor x:Key="headerConverter"/>
                        <local:HeaderCellMemberPropertyToolTipConverter x:Key="headerCellMemberPropertyToolTipConverter"/>
                        <!--Tooltip template-->
                        <DataTemplate x:Key="toolTipValueTemplate">
                            <Border Background="Transparent" BorderThickness="1" CornerRadius="4" Margin="2,0,2,2">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFB1B3B9" Offset="0"/>
                                        <GradientStop Color="#FFE3E9EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Direction="0"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!--Tooltip header cells-->
                                    
                                   <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <DataTemplate x:Key="RTLtoolTipValueTemplate">
                            <Border Background="Transparent" BorderThickness="1" CornerRadius="4" Margin="2,0,2,2">
                                <Border.BorderBrush>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFB1B3B9" Offset="0"/>
                                        <GradientStop Color="#FFE3E9EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Direction="0"/>
                                </Border.Effect>
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!--Tooltip header cells-->

                                    <TextBlock Grid.Column="0" Grid.Row="0" Visibility="{Binding Visibility,ElementName=tbmeasure}" Margin="3,2,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridMeasureTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Visibility="{Binding Visibility,ElementName=tbcolumns}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridColumnTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Visibility="{Binding Visibility,ElementName=tbrows}" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridRowTooltip}"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridValueTooltip}"/>
                                    <!--Tooltip Value Bindings-->
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="tbmeasure" Visibility="{Binding Text,ElementName=tbmeasure,Converter={StaticResource stringConverter}}" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="tbcolumns" Visibility="{Binding Text,ElementName=tbcolumns,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" x:Name="tbrows" Visibility="{Binding Text,ElementName=tbrows,Converter={StaticResource stringConverter}}" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <!--Headercell Tooltip-->
                        <DataTemplate x:Key="toolTipHeaderCells">
                            <Border BorderThickness="1" Background="{StaticResource Classic.GridBackground}" Margin="5">
                                <Border.Effect>                                   
                                    <DropShadowEffect Color="Gray" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <!--<TextBlock Text="sdhfvsdfghsdfhdsfcsdfbdh"/>-->
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerConverter}}" ValueCellStyle="{StaticResource Classic.ValueCellStyle}" ColumnHeaderStyle="{StaticResource Classic.ColumnHeaderStyle}" RowHeaderStyle="{StaticResource Classic.RowHeaderStyle}" SummaryColumnStyle="{StaticResource Classic.SummaryColumnStyle}" SummaryRowStyle="{StaticResource Classic.SummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="MemberPropertytoolTipHeaderCells">
                            <Border BorderThickness="1" Background="{StaticResource Classic.GridBackground}" Margin="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Gray" ShadowDepth="0" BlurRadius="10" Direction="0"/>
                                </Border.Effect>
                                <local:OlapGridBase Engine="{Binding Converter={StaticResource headerCellMemberPropertyToolTipConverter}}" ResizeRowsToFit="True" ResizeColumnsToFit="True" ValueCellStyle="{StaticResource Classic.ValueCellStyle}" ColumnHeaderStyle="{StaticResource Classic.ColumnHeaderStyle}" RowHeaderStyle="{StaticResource Classic.RowHeaderStyle}" SummaryColumnStyle="{StaticResource Classic.SummaryColumnStyle}" SummaryRowStyle="{StaticResource Classic.SummaryRowStyle}"/>
                            </Border>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <ScrollViewer Grid.Row="3" 
                                     Grid.ColumnSpan="2"   
                                     x:Name="PART_GridArea" 
                                     CanContentScroll="True" 
                                     HorizontalScrollBarVisibility="Auto" 
                                     Background="{TemplateBinding Background}"  
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     VerticalScrollBarVisibility="Auto">
                        <local:OlapGridBase x:Name="PART_OlapGridBase"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <Setter Property="Background" Value="{StaticResource Classic.GridBackground}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Classic.ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource Classic.RowHeaderStyle}"/>
        <Setter Property="SummaryColumnStyle" Value="{StaticResource Classic.SummaryColumnStyle}"/>
        <Setter Property="SummaryRowStyle" Value="{StaticResource Classic.SummaryRowStyle}"/>
        <Setter Property="ValueCellStyle" Value="{StaticResource Classic.ValueCellStyle}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderButtonStyle}"/>
            
    </Style>

</ResourceDictionary>
