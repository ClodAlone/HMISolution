<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls.Scroll;assembly=Syncfusion.GridCommon.Wpf"
    xmlns:local="clr-namespace:Syncfusion.Windows.Grid.Olap"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Grid.Olap.Resources">    

    <resources:ResourceWrapper x:Key="ResourceWrapperKeys" />

    <SolidColorBrush x:Key="Classic.GridBackground" Color="#FFF4F4F5"/>


   
<LinearGradientBrush x:Key="Classic.ColumnHeaderBackgroundBrush" EndPoint="0.994,0.922" StartPoint="0.994,0.101">
        <GradientStop Color="#FFF5FAFF" Offset="0.099"/>
        <GradientStop Color="#FFE6F0FA" Offset="0.515"/>
        <GradientStop Color="#FFDCE6F4" Offset="0.52"/>
    </LinearGradientBrush>
  
    <SolidColorBrush Color="#FFECF2F9"  x:Key="Classic.RowHeaderBackgroundBrush"/>
   
    <LinearGradientBrush  x:Key="Classic.SummaryColumnBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEAEAEA" Offset="0"/>
        <GradientStop Color="#FFCCD9EA" Offset="0.007"/>
        <GradientStop Color="#FFE8EEF7" Offset="0.046"/>
    </LinearGradientBrush>


    <LinearGradientBrush  x:Key="Classic.SummaryRowBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEAEAEA" Offset="0"/>
        <GradientStop Color="#FFCCD9EA" Offset="0.007"/>
        <GradientStop Color="#FFE8EEF7" Offset="0.046"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Classic.ValueCellBackgroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Classic.ColumnHeaderForegroundBrush" Color="#FF2A447F"/>
    <SolidColorBrush x:Key="Classic.RowHeaderForegroundBrush" Color="#FF2A447F"/>
    <SolidColorBrush x:Key="Classic.ValueCellForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.SummaryColumnForegroundBrush" Color="#FF2A447F"/>
    <SolidColorBrush x:Key="Classic.SummaryRowForegroundBrush" Color="#FF2A447F"/>

    <local:OlapGridCellStyle x:Key="Classic.ColumnHeaderStyle" 
                             Background="{StaticResource Classic.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:OlapGridCellStyle x:Key="Classic.RowHeaderStyle" 
                             Background="{StaticResource Classic.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />


    <local:OlapGridCellStyle x:Key="Classic.SummaryColumnStyle" 
                             Background="{StaticResource Classic.SummaryColumnBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryColumnForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:OlapGridCellStyle x:Key="Classic.SummaryRowStyle" 
                             Background="{StaticResource Classic.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryRowForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:OlapGridCellStyle x:Key="Classic.ValueCellStyle" 
                             Background="{StaticResource Classic.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Classic.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

