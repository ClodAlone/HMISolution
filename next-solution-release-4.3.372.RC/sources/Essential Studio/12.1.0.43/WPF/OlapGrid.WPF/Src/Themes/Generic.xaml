                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CellDescriptor.CellType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridKpiCell}}}" 
