                                <Style TargetType="{x:Type Border}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CellDescriptor.HasChildren, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:OlapGridExpandHyperlinkCell}}}" 
