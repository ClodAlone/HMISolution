<syncfusion:ChromelessWindow  x:Class="Syncfusion.Windows.Grid.Olap.FormattingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:olapgrid="clr-namespace:Syncfusion.Windows.Grid.Olap;assembly=Syncfusion.OlapGrid.WPF"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Grid.Olap.Resources"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize" Icon="pack://application:,,,/Syncfusion.OlapGrid.WPF;component//Images/App.ico"
    Title="{Binding ElementName=textBlockTitle, Path=Text}" Height="390" Width="370" >
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <resources:ResourceWrapper x:Key="ResourceWrapperKeys" />
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid x:Name="Popup" Margin="2">
        <Grid.ColumnDefinitions >
            <ColumnDefinition  />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions> 
        <!-- Since, Resource wrapper is added as resource of the window. We can't bind the title directly. 
            So, we are binding this text block with the title. The Title will bind to this text block-->
        <TextBlock x:Name="textBlockTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogTitle}" Visibility="Collapsed" />
        <TabControl Name="Design" TabStripPlacement="Top">
            <TabItem Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogHeaderStyle }" IsSelected="True" >
                <Grid>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GroupBox BorderThickness="1" Height="95" BorderBrush="DarkGray" >
                        <GroupBox.Header>
                            <CheckBox Name="chkColumnHeader" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogColumnHeader }" Checked="chkColumnHeader_Checked" Unchecked="chkColumnHeader_Unchecked" />
                        </GroupBox.Header>
                        <Grid  Name="grdColumnHeader">
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="*"  />
                                <ColumnDefinition Width="*"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"   />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0"  Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogBackgroundColor }" />
                            <syncfusion:ColorPicker Grid.Column="1" Grid.Row="0" Height="27"  VerticalAlignment="Center" Name="HeaderColumnBackColor" />
                            <TextBlock Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogForegroundColor }" />
                            <syncfusion:ColorPicker   Grid.Column="1" Grid.Row="1"  Height="27" VerticalAlignment="Center" Name="HeaderColumnForeColor" />

                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" BorderThickness="1" BorderBrush="DarkGray" Height="95">
                        <GroupBox.Header>
                            <CheckBox Name="chkRowHeader" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogRowHeader }" Checked="chkRowHeader_Checked" Unchecked="chkRowHeader_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdRowHeader" >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition  Width="*" />
                                <ColumnDefinition  Width="*"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogBackgroundColor }" />
                            <syncfusion:ColorPicker  Grid.Column="1" Grid.Row="0" Height="27" VerticalAlignment="Center" Name="HeaderRowBackColor" />

                            <TextBlock Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogForegroundColor }" />
                            <syncfusion:ColorPicker   Grid.Column="1" Grid.Row="1"  Height="27"  VerticalAlignment="Center" Name="HeaderRowForeColor" />
                        </Grid>
                    </GroupBox>
                    <GroupBox  Grid.Row="2" BorderThickness="1" BorderBrush="DarkGray" Height="95" >
                        <GroupBox.Header>

                            <CheckBox Name="chkHeaderFont" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogHeaderFont }" Checked="chkHeaderFont_Checked" Unchecked="chkHeaderFont_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdHeaderFont" >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition  Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontName }"/>
                            <syncfusion:FontListComboBox Name="HeaderFontName" Height="27" Grid.Column="1" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontSize }" />
                            <ComboBox  Grid.Column="1" Grid.Row="1"   Height="27" VerticalAlignment="Center" Name="HeaderFontSize" />


                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem  Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogSummaryStyle }" Background="AliceBlue" IsSelected="False">
                <Grid Height="314">
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GroupBox  BorderThickness="1" BorderBrush="DarkGray" Height="95" >
                        <GroupBox.Header>
                            <CheckBox Name="chkColumnSummary" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogColumnSummary }" Checked="chkColumnSummary_Checked" Unchecked="chkColumnSummary_Unchecked" />
                        </GroupBox.Header>
                        <Grid  Name="grdColumnSummary">
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="*"  />
                                <ColumnDefinition Width="*"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"   />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0"  Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogBackgroundColor }" />
                            <syncfusion:ColorPicker Grid.Column="1" Grid.Row="0" Height="27" VerticalAlignment="Center" Name="SummaryColumnBackColor" />
                            <TextBlock Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogForegroundColor }" />
                            <syncfusion:ColorPicker   Grid.Column="1" Grid.Row="1"  Height="27" VerticalAlignment="Center" Name="SummaryColumnForeColor" />

                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="1"  BorderThickness="1" BorderBrush="DarkGray" Height="95">
                        <GroupBox.Header>
                            <CheckBox Name="chkRowSummary" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogRowSummary }" Checked="chkRowSummary_Checked" Unchecked="chkRowSummary_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdRowSummary">
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition  Width="*" />
                                <ColumnDefinition  Width="*"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center"  Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogBackgroundColor }" />
                            <syncfusion:ColorPicker  Grid.Column="1" Grid.Row="0" Height="27"  VerticalAlignment="Center" Name="SummaryRowBackColor" />

                            <TextBlock Grid.Column="0" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogForegroundColor }" />
                            <syncfusion:ColorPicker   Grid.Column="1" Grid.Row="1"  Height="27" VerticalAlignment="Center" Name="SummaryRowForeColor" />
                        </Grid>
                    </GroupBox>
                    <GroupBox  Grid.Row="2" BorderThickness="1" BorderBrush="DarkGray" Height="95" >
                        <GroupBox.Header>

                            <CheckBox Name="chkSummaryFont" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogSummaryFont }" Checked="chkSummaryFont_Checked" Unchecked="chkSummaryFont_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdSummaryFont" >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition  Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontName }" />
                            <syncfusion:FontListComboBox  Grid.Column="1"  Name="SummaryFontName" Height="27" />

                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontSize }" />
                            <ComboBox Grid.Column="1" Grid.Row="1"  Height="27"  VerticalAlignment="Center" Name="SummaryFontSize" />

                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogCellStyles }" Background="AliceBlue" IsSelected="False">
                <Grid >
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition  />

                    </Grid.RowDefinitions>
                    <GroupBox  Margin="5,2,9,22"  BorderThickness="1" BorderBrush="DarkGray" Height="170" >
                        <GroupBox.Header>
                            <CheckBox Name="chkCellStyles" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogCellStyles }" Checked="chkCellStyles_Checked" Unchecked="chkCellStyles_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdCellStyles">
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"  />
                                <RowDefinition Height="35"  />
                                <RowDefinition Height="35"  />
                                <RowDefinition Height="35"  />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontName }" />
                            <syncfusion:FontListComboBox  Grid.Column="1" Name="CellFontName" Height="27">
                            </syncfusion:FontListComboBox >
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontStyle }" />
                            <ComboBox  Grid.Column="1" Grid.Row="1"  Height="27"   VerticalAlignment="Center" Name="CellFontStyle">
                            </ComboBox >
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontColor }" />
                            <syncfusion:ColorPicker  Grid.Column="1" Grid.Row="2"  Height="27" VerticalAlignment="Center" Name="CellFontColor" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogFontSize }" />
                            <ComboBox  Grid.Column="1" Grid.Row="3" Height="27"  VerticalAlignment="Center" Name="CellFontSize">
                            </ComboBox >

                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Common" Background="AliceBlue" IsSelected="False" Visibility="Hidden" >
                <Grid >
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"  />
                       
                    </Grid.RowDefinitions>
                    <GroupBox  Margin="5,-48,9,22"  BorderThickness="1" BorderBrush="DarkGray" Height="65" >
                        <GroupBox.Header>
                            <CheckBox Name="chkCommon" Content="Common Styles" Checked="chkCommonStyles_Checked" Unchecked="chkCommonStyles_Unchecked" />
                        </GroupBox.Header>
                        <Grid Name="grdCommonStyles">
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"  />
                                <!--<RowDefinition Height="30"  />
                                <RowDefinition Height="30"  />-->
                                
                            </Grid.RowDefinitions>
                            <!--<TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" >Gridline Color</TextBlock>
                            <syncfusion:ColorPicker  Grid.Column="1" Grid.Row="0"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Name="GridlinesColor">
                            </syncfusion:ColorPicker >-->
                            <TextBlock Grid.Column="0" Margin=" 0,5,0,0" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center" >Grid BackGround</TextBlock>
                            <syncfusion:ColorPicker Margin=" 0,5,0,0"  Grid.Column="1" Grid.Row="0"  Height="27" VerticalAlignment="Center" HorizontalAlignment="Left" Name="GridBackGroundColor">
                            </syncfusion:ColorPicker  >
                            <!--<TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" >Gridlines Thickness </TextBlock>
                            <syncfusion:UpDown   Grid.Column="1" Grid.Row="2" Width="150" Height="20" MinValue="2" MaxValue="20" VerticalAlignment="Center" HorizontalAlignment="Left" Name="GridlineThickness" />-->
                            

                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Button x:Name="OKButton" Grid.Row="1" HorizontalAlignment="Right" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogOk }" Margin="0,0,60,0" Click="OKButton_Click" Width="55" Height="23"/>
        <Button x:Name="CancelButton" Grid.Row="1" HorizontalAlignment="Right"  Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapGridDialogCancel }" Click="CancelButton_Click" Width="55" Height="23"/>
    </Grid>

</syncfusion:ChromelessWindow>