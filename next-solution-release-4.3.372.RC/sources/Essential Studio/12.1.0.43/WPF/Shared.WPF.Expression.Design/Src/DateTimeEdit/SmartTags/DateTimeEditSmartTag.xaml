<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.Expression.Design.DateTimeEditSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24"  syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    <syncfusion:SmartTagPresenter Title="DateTimeEdit Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <Grid Background="#FFDCEBFE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="7" Grid.Row="0">
                <TextBlock FontWeight="Bold">Essential Tools - DateTimeEdit</TextBlock>

            </StackPanel>




            <StackPanel  Margin="7" Grid.Row="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <Border   Grid.Row="0" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>

                    <TextBlock Text="Name" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                    <TextBox Name="Name1"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>

                    <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="2" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>

                    <TextBlock FontWeight="Bold" Grid.Row="3">Appearance</TextBlock>

                    <TextBlock Text="Custom Pattern" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" />
                    <TextBox Name="CustomPattern"  Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock Text="None Date Text Pattern" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" />
                    <TextBox Name="NoneDateText"  Margin="3,3,3,3" Width="115" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock Text="Pop-Up Delay" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0" />
                    <TextBox Name="PopUpDelay"  LostFocus="PopUpDelay_LostFocus" Margin="3,3,3,3" Width="115" Grid.Row="6" Grid.Column="1"/>


                    <TextBlock Text="Scrolling Duration" VerticalAlignment="Center" Grid.Row="7" Grid.Column="0" />
                    <TextBox Name="ScrollDuration"  Margin="3,3,3,3" Width="115" Grid.Row="7" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="AutoCorrected Higlight Duration" Grid.Row="8" Grid.Column="0"/>
                    <TextBox Name="AutoCorrectedHiglightDuration" Margin="3,3,3,3" Width="115" Grid.Row="8" Grid.Column="1"/>



                    <TextBlock VerticalAlignment="Center" Text="Incorrect Foreground" Grid.Row="9" Grid.Column="0" Margin="2" />
                    <ComboBox Name="IncorrectForegroundSelector"  Margin="3,3,3,3" Width="115" Grid.Row="9" Grid.Column="1" />


                    <TextBlock VerticalAlignment="Center" Text="Correct Foreground" Grid.Row="10" Grid.Column="0"/>
                    <ComboBox Name="CorrectForegroundSelector" Margin="3,3,3,3" Width="115" Grid.Row="10" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="Uncertain Foreground" Grid.Row="11" Grid.Column="0"/>
                    <ComboBox Name="UncertainForegroundselector" Margin="3,3,3,3" Width="115" Grid.Row="11" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="Date Time Pattern" Grid.Row="12" Grid.Column="0"/>
                    <ComboBox Name="Patternselector" Margin="3,3,3,3" Width="115" Grid.Row="12" Grid.Column="1"/>

                    <Border Margin="0,7,0,0"  Grid.Row="13" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="14">Behavior</TextBlock>

                    <StackPanel Grid.Row="15"  Margin="7">

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="switchanimation"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Switch Animation
                            </TextBlock>
                        </StackPanel>


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="isAutoCorrect"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       AutoCorrect
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsScrollingOnCircle"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Circle Mode Change
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsEmptyDate"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is EmptyDateEnabled
                            </TextBlock>
                        </StackPanel>


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="Iswatchenabled"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is WatchEnabled
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="iseditable"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is Editable
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="isreadonly"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is ReadOnly
                            </TextBlock>
                        </StackPanel>


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsButtonPopUpEnabled"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                     Is ButtonPopUpEnabled
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsCalendarEnabled"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    Is CalendarEnabled
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsEnabledRepeatButton"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    Is EnabledRepeatButton
                            </TextBlock>
                        </StackPanel>





                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsVisibleRepeatButton"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                    Is VisibleRepeatButton
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="ShowNoDateTime"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                   Show No Date Time
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsHoldMaxWidth"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                   Is HoldMaximumWidth
                            </TextBlock>
                        </StackPanel>


                    </StackPanel>
                   
                </Grid>
            </StackPanel>
        </Grid>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>