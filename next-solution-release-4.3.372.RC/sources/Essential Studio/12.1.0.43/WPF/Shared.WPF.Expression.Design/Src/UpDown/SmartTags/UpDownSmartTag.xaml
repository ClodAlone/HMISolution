<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.Expression.Design.UpDownSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="Up-Down Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Tools - Up-Down</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                 
                    
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Text="percentTextbox1" Width="120"  HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />
            <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Default Values</TextBlock>
                
                <TextBlock Text="Value" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtValue" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Text="0.00%" Width="Auto" Height="20" HorizontalAlignment="Stretch" />
                
             
                <TextBlock Text="Step Value" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtStepValue" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Text="0.00%" Width="Auto" Height="20" HorizontalAlignment="Stretch" />
                
            </Grid>
        </StackPanel>

        
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>