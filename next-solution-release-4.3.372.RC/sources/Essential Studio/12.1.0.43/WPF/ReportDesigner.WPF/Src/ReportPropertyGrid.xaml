<UserControl x:Class="Syncfusion.Windows.Reports.Designer.ReportPropertyGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:syncfusionproperty="clr-namespace:Syncfusion.Windows.PropertyGrid;assembly=Syncfusion.PropertyGrid.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Name="propertyGridNameBox" Background="Transparent" Text="PropertyGrid" FontSize="14" FontWeight="Bold" Margin="2" Padding="2"></TextBlock>
        <syncfusionproperty:PropertyGrid Grid.Row="1"  BorderThickness="1" x:Name="PropertiesWindow" PropertyExpandMode="NestedMode"
                                     DescriptionPanelVisibility="Visible"
                                     SearchBoxVisibility="Collapsed"
                                     EnableGrouping="True"
                                     EnableToolTip="False"
                                     SortDirection="Ascending"
                                     ButtonPanelVisibility="Visible"/>
    </Grid>
</UserControl>
