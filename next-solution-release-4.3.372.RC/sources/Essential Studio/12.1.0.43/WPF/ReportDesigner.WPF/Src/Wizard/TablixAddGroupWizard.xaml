<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixAddGroupWizard" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterScreen"
    Title="{x:Static prop:Resources.titleTablixAddGroupWizard}" ShowInTaskbar="False" Height="183" Width="414" ResizeMode="NoResize" ShowIcon="False" TitleTextAlignment="Center"  Margin="0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="grd_General" Height="152" Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="108*"/>
        </Grid.RowDefinitions>

        <StackPanel  x:Name="stpnl_Value" Orientation="Horizontal" Margin="0,15,0,25" Grid.RowSpan="2">
            <!--<RadioButton VerticalAlignment="Center"> </RadioButton>-->
            <TextBlock Text="{x:Static prop:Resources.textBlockGroupBy}" Margin=" 5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="23" Width="97"></TextBlock>

            <ComboBox  TabIndex="1" Name="cmb_Value" IsEditable="True"  HorizontalAlignment="Left" Width="270" Height="20">
                <ComboBox.Items>

                </ComboBox.Items>
            </ComboBox>
        </StackPanel>
        <!--<StackPanel Grid.Row="1" Height="30" VerticalAlignment="Top" Orientation="Horizontal">
            <RadioButton VerticalAlignment="Center"></RadioButton>
            <TextBlock Text=" Show detail data " Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,10,0,40">
            
            <CheckBox Name="chk_AddGroupHeader" Margin="0,5,0,0" Content=" Add group header" HorizontalAlignment="Left" Height="15" Width="300" />
            <CheckBox Name="chk_AddGroupFooter" Margin="0,5,0,0" Content=" Add group footer" HorizontalAlignment="Left" Height="20" Width="300" />
        </StackPanel>-->
        <!--<Button Grid.Row="2" Height="23" HorizontalAlignment="Left" Margin="10,0,0,15" Name="Help_button" VerticalAlignment="Bottom" Width="68">Help</Button>-->
        <Button  TabIndex="3" HorizontalAlignment="Right" Margin="0,0,12,14" Name="Cancel_button" Width="68" Height="23" Grid.Row="2" VerticalAlignment="Bottom" Click="Cancel_button_Click" Content="{x:Static prop:Resources.btnCancel}" IsCancel="True" />
        <Button  TabIndex="2" HorizontalAlignment="Right" Margin="0,0,86,14" Name="Ok_button" Width="68" Height="23" Grid.Row="2" VerticalAlignment="Bottom" Click="Ok_button_Click" Content="{x:Static prop:Resources.btnOK}" IsDefault="True"/>
    </Grid>

</syncfusion:ChromelessWindow>
