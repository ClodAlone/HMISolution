<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.DataSetUI" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:dialogs="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Title="{x:Static prop:Resources.titleDataSetProperties}" TitleTextAlignment="Center" Height="500" Width="550" ResizeMode="NoResize"  ShowIcon="False" Margin="0">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Border BorderThickness="0.5" BorderBrush="Gray" Margin="5,5,5,5">
        <Grid Margin="5,5,5,5">
            <Grid.Resources>
                <ControlTemplate x:Key="GridParamtersHeader">
                    <Grid Background="LightGray">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Parameter Name" />
                        <TextBlock Text="Parameter Value" />
                    </Grid>
                </ControlTemplate>
                <ControlTemplate x:Key="GridParamtersContent">
                    <Grid Background="LightGray">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="Parameter Name" />
                        <ComboBox Style="{StaticResource comboStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            <syncfusion:TabControlExt x:Name="tab_Dataset" Grid.Row="0" CloseButtonType="Hide" ShowTabItemContextMenu="False" ShowTabListContextMenu="False" >
                <syncfusion:TabItemExt Header="{x:Static prop:Resources.headerGeneral}" IsSelected="True" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static prop:Resources.dataSetTextBlock}" VerticalAlignment="Center" FontSize="14" Margin="15,0,0,0"></TextBlock>
                        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock Text="{x:Static prop:Resources.txtBlockName}" HorizontalAlignment="Left" Width="50"></TextBlock>
                            <TextBox Name="txt_DataSetName" HorizontalAlignment="Left" Width="200" TabIndex="1"/>
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock Text="{x:Static prop:Resources.textBlockDataSource}" HorizontalAlignment="Left" Width="200"></TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox TabIndex="2" x:Name="cmb_DataSources" Margin="0,0,2,0" HorizontalAlignment="Left" Width="250" SelectionChanged="cmb_DataSources_SelectionChanged"/>
                                <Button  TabIndex="3" x:Name="btn_NewDataSource"  Height="25" Margin="2,0,0,0" Content="{x:Static prop:Resources.btnNew}" Width="75" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="20,0,0,0" Grid.Row="3" Height="Auto">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="51"/>
                                <RowDefinition Height="23"/>
                                <RowDefinition Height="127*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Query type :" x:Name="tblk_QueryType" HorizontalAlignment="Left" Width="85" Margin="0,0,0,25"></TextBlock>
                            <TextBlock Text="{x:Static prop:Resources.textBlockQuery}" x:Name="tblk_Query" Grid.Row="1" HorizontalAlignment="Left" Width="200"></TextBlock>
                            <StackPanel Name="Qurypanel" Grid.Row="2" Grid.Column="0">
                                <ComboBox Name="param_query" Visibility="Collapsed" IsEditable="True"></ComboBox>
                                <TextBox  TabIndex="4" Name="txt_Query"  AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Height="115" />
                            </StackPanel>
                            <Button TabIndex="5" Name="btn_QueryDesigner"  Content="{x:Static prop:Resources.btnQueryDesigner}" Grid.Row="2" Grid.Column="1" Height="25" Width="100" VerticalAlignment="Top" Margin="14,0,6,0" ToolTipService.ShowOnDisabled="true"></Button>
                            <Button TabIndex="6" Name="btn_RefreshFields"  Content="Refresh Fields..." Grid.Row="2" Grid.Column="1" Height="25" Width="100" VerticalAlignment="Top" Margin="14,30,6,0"></Button>
                            <RadioButton Content="Text" Height="19" HorizontalAlignment="Left" Margin="21,26,0,0" Name="Text" VerticalAlignment="Top" Width="64" GroupName="Querytype" IsChecked="True"/>
                            <RadioButton Content="StoredProcedure" Height="21" HorizontalAlignment="Right" Margin="0,24,148,0" Name="Storedprocedure" VerticalAlignment="Top" Width="143" GroupName="Querytype" />
                        </Grid>
                    </Grid>
                </syncfusion:TabItemExt>
                <syncfusion:TabItemExt Header="{x:Static prop:Resources.headerFilter}">
                    <Grid>
                        <dialogs:TablixFilters x:Name="tbl_filters" HorizontalAlignment="Left" Margin="0,-10,20,0" Width="510"></dialogs:TablixFilters>
                    </Grid>
                </syncfusion:TabItemExt>
            </syncfusion:TabControlExt>
            <Grid Grid.Row="1" Height="25" Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button  TabIndex="6" x:Name="btn_HelponDataSet" Width="80"  Content="{x:Static prop:Resources.btnHelp}" Grid.Column="0" />
                <StackPanel Orientation="Horizontal"  Grid.Column="1" HorizontalAlignment="Right">
                    <Button  TabIndex="7" Content="{x:Static prop:Resources.btnOK}" Margin="0,0,2,0" Width="80" x:Name="btn_DataSetOk" IsDefault="True" />
                    <Button  TabIndex="8" Content="{x:Static prop:Resources.btnCancel}" Margin="2,0,2,0" Width="80" x:Name="btn_DataSetCancel" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</syncfusion:ChromelessWindow>