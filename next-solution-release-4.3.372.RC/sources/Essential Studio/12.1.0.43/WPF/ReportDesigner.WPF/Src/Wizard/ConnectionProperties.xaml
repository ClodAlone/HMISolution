<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ConnectionProperties" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterOwner" Margin="0"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf" Loaded="ChromelessWindow_Loaded"
    Title="{x:Static prop:Resources.titleConnectionProperties}" Height="470" Width="400" ResizeMode="NoResize"  ShowIcon="False" ShowInTaskbar="False" TitleTextAlignment="Center" >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <syncfusion:BusyIndicator x:Name="busyIndicator"
                                              Header="SQL Server" 
                                              IsBusy="False"
                                              LoadingDescription="Loading Server names..."
                                              CloseButtonVisibility="Collapsed"
                                               CancelButtonVisibility="Collapsed"
                                              IsIndeterminate="True"                                              
                                              OverlayOpacity="0.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="5,0,5,5" Orientation="Horizontal">
                    <TextBlock Text="{x:Static prop:Resources.textBlockServerName}" Margin="10,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox IsEditable="True" TabIndex="1" x:Name="cmb_ServerName" Margin="5,2,2,2" Width="275" Height="20" />
                    </StackPanel>
                </StackPanel>
                <GroupBox Grid.Row="1" Margin="5,0,5,5" Header="{x:Static prop:Resources.headerLogOnToServer}">
                    <StackPanel Margin="10,0,0,0" Orientation="Vertical">
                        <RadioButton TabIndex="2" x:Name="rbtn_WindowsAuthentication" GroupName="Credentials" Margin="0,5,0,5" IsChecked="True" Content="{x:Static prop:Resources.optionUseWindowsAuthentication}" />
                        <RadioButton TabIndex="3" x:Name="rbtn_SqlAuthentication" GroupName="Credentials" Margin="0,0,0,5" Content="{x:Static prop:Resources.optionUseSqlServerAuthentication}" />
                        <Grid x:Name="grd_SqlServerAuthentication" Margin="25,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,3,0,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockUserName}" />
                            <TextBox  TabIndex="4" x:Name="txt_UserName" Grid.Row="0" Margin="0,3,0,3" Grid.Column="1" TextChanged="txt_UserName_TextChanged"  />
                            <TextBlock Grid.Row="1" Margin="0,3,0,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockPassword}" />
                            <PasswordBox  TabIndex="5" x:Name="pwd_Password" Grid.Row="1" Margin="0,3,0,3" Grid.Column="1" />
                            <CheckBox  TabIndex="6" x:Name="chk_SavePwd" Grid.Row="2" Margin="0,3,0,3" Grid.Column="1" Content="{x:Static prop:Resources.chkBoxSavePassword}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Row="2" Margin="5,0,5,5" Header="{x:Static prop:Resources.headerConnectToDatabase}">
                    <StackPanel x:Name="stck_DataBase" Margin="10,0,0,0" Orientation="Vertical">
                        <RadioButton  TabIndex="8" Margin="0,5,0,0" x:Name="rbtn_SelectDataBase" GroupName="Database" IsChecked="True" Content="{x:Static prop:Resources.optionSelectDatabaseName}" />
                        <ComboBox  TabIndex="9" x:Name="cmb_Databases" IsEnabled="False" IsEditable="False" Margin="20,3,0,2"/>
                        <RadioButton  TabIndex="10" x:Name="rbtn_AttachDataBaseFile" GroupName="Database" Content="{x:Static prop:Resources.optionAttachDatabaseFile}" />
                        <Grid x:Name="grd_AttachDataBaseFile" Margin="25,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBox  TabIndex="11" x:Name="txt_DataBaseFilePath" Margin="3,3,3,3" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"/>
                            <Button  TabIndex="12" x:Name="btn_BrowseFile"  Margin="3,3,3,3" Grid.Row="0" Grid.Column="1" Content="{x:Static prop:Resources.btnBrowse}"/>
                            <TextBlock Grid.Row="1" Margin="3,3,3,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockLogicalName}" />
                            <TextBox  TabIndex="13" x:Name="txt_LogicalName" Margin="3,3,3,3" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <Grid Grid.Row="3" Height="25" Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button TabIndex="14" x:Name="btn_TestConnection" Width="100"  Content="{x:Static prop:Resources.btnTestConnection}" Grid.Column="0" />
                    <StackPanel Orientation="Horizontal"  Grid.Column="1" HorizontalAlignment="Right">
                        <Button TabIndex="15" Content="{x:Static prop:Resources.btnOK}" Margin="0,0,2,0" Width="80" x:Name="btn_TestConnectionOK" IsDefault="True"/>
                        <Button TabIndex="16" Content="{x:Static prop:Resources.btnCancel}" Margin="2,0,0,0" Width="80" x:Name="btn_TestConnectionCancel"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </syncfusion:BusyIndicator>
    </Grid>
</syncfusion:ChromelessWindow>
