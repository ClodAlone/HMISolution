<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixDeleteGroupWizard" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterScreen"
    Title="Delete Group" ShowInTaskbar="False" Height="183" Width="414" ResizeMode="NoResize" TitleTextAlignment="Center" ShowIcon="False"  Margin="0">

    <Grid>
        <TextBlock Height="23" HorizontalAlignment="Left" Margin="12,12,0,0" Name="textBlock1" Text="Delete column option :" VerticalAlignment="Top" Width="194" />
        <RadioButton Name="deletewithgroup" Content="Delete columns and associated groups " Height="20" HorizontalAlignment="Left" Margin="39,41,0,0" VerticalAlignment="Top" Width="268" GroupName="delete" IsChecked="True"/>
        <RadioButton Name="deletecolumn" Content="Delete columns only" Height="20" HorizontalAlignment="Left" Margin="39,67,0,0" VerticalAlignment="Top" Width="268" GroupName="delete"/>
        <Button Content="Ok" Height="23" IsDefault="True" HorizontalAlignment="Left" Margin="192,109,0,0" Name="button1" VerticalAlignment="Top" Width="83" Click="button1_Click" />
        <Button Content="Cancel" IsCancel="True"  Height="23" HorizontalAlignment="Left" Margin="298,109,0,0" Name="button2" VerticalAlignment="Top" Width="82" Click="button2_Click" />
    </Grid>
</syncfusion:ChromelessWindow>
