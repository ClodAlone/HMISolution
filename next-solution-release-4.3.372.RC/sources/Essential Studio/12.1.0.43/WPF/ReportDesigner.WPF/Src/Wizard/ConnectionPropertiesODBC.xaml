<sync:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ConnectionPropertiesODBC"  x:ClassModifier="internal"
                        xmlns:sync="http://schemas.syncfusion.com/wpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  
        Title="Connection properties"  ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Height="415" Width="391" ShowIcon="False" ShowInTaskbar="False" >
    <!--sync:SkinStorage.VisualStyle="Office2007Blue"-->
    <Grid Width="372" >

        <Label  Content="Data Source" HorizontalAlignment="Left" Margin="7,0,0,348" Name="label1"  Width="100" />
        <TextBlock  Height="18" HorizontalAlignment="Left" Margin="12,29,0,0" Name="textBlock1" Text="ODBC (ODBC)" VerticalAlignment="Top" Width="269" ><TextBlock.OpacityMask><LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5"><GradientStop Color="Black" Offset="0" /><GradientStop Color="White" Offset="1" /></LinearGradientBrush></TextBlock.OpacityMask></TextBlock>
        <GroupBox Header="Data source specification" FontSize="12" Height="140" HorizontalAlignment="Left" Margin="5,51,0,0" Name="groupBox1" VerticalAlignment="Top" Width="361">
            <Grid >
                <RadioButton  Content="Use user or system data source name :" Height="14" FontSize="11" HorizontalAlignment="Left" Margin="2,6,0,0" Name="rbtn_sourcename" VerticalAlignment="Top" Checked="rbtn_sourcename_Checked" />
                <Grid Height="31" HorizontalAlignment="Left" Margin="0,24,0,0" Name="src_grid" VerticalAlignment="Top" Width="349" >

                    <ComboBox Height="23" HorizontalAlignment="Left" Margin="6,3,0,0" Name="cmb_sourcename" VerticalAlignment="Top" Width="247" SelectedIndex="0">
                        <!--<ComboBoxItem>dBASE Files
                        </ComboBoxItem>-->
                        <ComboBoxItem>Excel Files
                        </ComboBoxItem>
                        <ComboBoxItem>MS Access Database
                        </ComboBoxItem>

                    </ComboBox>
                    <Button  Content="Refresh" Height="23" FontSize="11" HorizontalAlignment="Right" Margin="0,3,6,0" Name="btn_refreshdsn" VerticalAlignment="Top" Width="81" Click="btn_refreshdsn_Click" />

                </Grid>
                <RadioButton Content="Use connection string :" Height="16" FontSize="11" HorizontalAlignment="Left" Margin="3,57,0,0" Name="con_str_radbtn" VerticalAlignment="Top" Width="201" Checked="con_str_radbtn_Checked" />
                <Grid Height="36" HorizontalAlignment="Left" Margin="3,75,0,0" Name="constr_grid" VerticalAlignment="Top" Width="346">
                    <TextBox  Height="23" HorizontalAlignment="Left" Margin="4,8,0,0" Name="txt_connectiostring" VerticalAlignment="Top" Width="246"  />
                    <!--Text="{Binding Path=SelectedValue.Content, ElementName=src_bx}"-->
                    <Button  Content="Build..." Height="23" FontSize="11" HorizontalAlignment="Right" Margin="0,8,6,0" Name="btn_buildconnectionstring" VerticalAlignment="Top" Width="81" Click="btn_buildconnectionstring_Click" />
                </Grid>
            </Grid>
        </GroupBox>
        <GroupBox Header="Login information" FontSize="12" Height="100" HorizontalAlignment="Left" Margin="7,195,0,0" Name="groupBox2" VerticalAlignment="Top" Width="359">
            <Grid>
                <Label Content="Username:" FontSize="11" Height="24" HorizontalAlignment="Left" Margin="4,10,0,0" Name="label2" VerticalAlignment="Top" Width="74" />
                <Label Content="Password:" FontSize="11" Height="23" HorizontalAlignment="Left" Margin="6,38,0,0" Name="label3" VerticalAlignment="Top" Width="72" />
                <TextBox Height="23" HorizontalAlignment="Left" Margin="84,10,0,0" Name="txt_username" VerticalAlignment="Top" Width="256" />
                <PasswordBox Height="23" HorizontalAlignment="Left" Margin="86,39,0,0" Name="pwd_userpassword" VerticalAlignment="Top" Width="254" />
            </Grid>
        </GroupBox>
        <Button Content="Test Connection"  FontSize="11" Height="23" HorizontalAlignment="Left" Margin="11,348,0,0" Name="btn_testconnection" VerticalAlignment="Top" Width="126" Click="btn_testconnection_Click" />
        <Button Content="OK" FontSize="11" Height="23" HorizontalAlignment="Left" Margin="206,348,0,0" Name="btn_testok" VerticalAlignment="Top" Width="75" Click="btn_testok_Click" />
        <Button Content="Cancel" FontSize="11" Height="23" HorizontalAlignment="Left" Margin="291,348,0,0" Name="cancel_btn" VerticalAlignment="Top" Width="75" Click="cancel_btn_Click" />
    </Grid>
</sync:ChromelessWindow>
