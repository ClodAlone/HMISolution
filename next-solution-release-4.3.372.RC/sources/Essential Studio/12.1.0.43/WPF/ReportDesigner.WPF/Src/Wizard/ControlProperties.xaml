<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ControlProperties" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="ChromelessWindow_PreviewKeyDown"
                             Loaded="ChromelessWindow_Loaded"
    Title="{x:Static prop:Resources.titleControlProperties}" TitleTextAlignment="Center" Height="520" Width="620" ResizeMode="NoResize"  ShowIcon="False" Margin="0">
    
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
                <ResourceDictionary>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="sysEnum">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ControlPropertyType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Border BorderThickness="0.5" Margin="5,5,5,5" BorderBrush="Gray">
    <Grid x:Name="grd_PlaceHolder">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
            <ListBox  TabIndex="0" x:Name="lbox_NodeType" BorderThickness="1" BorderBrush="Gray" Grid.Row="0" Grid.Column="0" Margin="5,5,2,2" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" Height="16"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="0" x:Name="brdr_PlaceHolder" Grid.Column="1" BorderThickness="1" BorderBrush="Gray" Margin="2,5,5,2" >
        </Border>
        
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="25" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button HorizontalAlignment="Right" TabIndex="1" x:Name="btn_HelponControlProperties" Margin="5,0,10,0" Click="btn_HelponControlProperties_Click" Width="80" Content="{x:Static prop:Resources.btnHelp}" Grid.Column="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"  Grid.Column="1" HorizontalAlignment="Right">
                <Button  TabIndex="2" Content="{x:Static prop:Resources.btnOK}" HorizontalAlignment="Left" Margin="10,0,10,0" Width="80" x:Name="btn_ControlPropertiesOk" IsDefault="True" />
                <Button  TabIndex="3" Content="{x:Static prop:Resources.btnCancel}" HorizontalAlignment="Left" Margin="10,0,5,0" Width="80" x:Name="btn_ControlPropertiesCancel" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</syncfusion:ChromelessWindow>
