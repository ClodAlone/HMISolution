<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.QueryDesigner" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterOwner"
    xmlns:converter="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    Title="{x:Static prop:Resources.titleQueryDesigner}" TitleTextAlignment="Center" Height="550" Width="700"  ShowInTaskbar="False" ResizeMode="NoResize" Loaded="ChromelessWindow_Loaded" PreviewKeyDown="ChromelessWindow_PreviewKeyDown"  ShowIcon="False" Margin="0">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converter:FolderTypeConverter x:Key="folderTypeConverter" />
            <converter:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
            <HierarchicalDataTemplate x:Key="treeTemplate" ItemsSource="{Binding Path=SchemaInfos}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chck_TableNode" ClickMode="Press" Margin="2,0,0,0" VerticalAlignment="Center" Click="chck_TableNode_Click" IsChecked="{Binding Path=IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=TreeNodeType, Converter={StaticResource boolToVisibilityConverter}}"/>
                    <Image Source="{Binding ImageSource}" Margin="2,0,0,0" VerticalAlignment="Center"  Height="16" Width="16" SnapsToDevicePixels="True" Visibility="{Binding Path=TreeNodeType, Converter={StaticResource folderTypeConverter}}"/>
                    <TextBlock Text="{Binding Path=Key}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderThickness="0.5" Margin="5,5,5,5" BorderBrush="Gray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,10,0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="15" Text="{x:Static prop:Resources.textBlockDesignQuery}" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="10,0,0,0" Text="{x:Static prop:Resources.textBlockBuildQueryInfo}"/>
                <StackPanel Margin="10,0,10,0" Height="25" Grid.Row="2" Orientation="Horizontal">
                    <ToggleButton  TabIndex="7" Margin="0,0,10,0" x:Name="tgbtn_EditText" Content="{x:Static prop:Resources.btnEditAsText}" ></ToggleButton>
                    <!--<Button Margin="0,0,10,0" Content="Import..." Width="80" VerticalContentAlignment="Center"></Button>-->
                    <Button   TabIndex="8" Margin="10,0,0,0" Content="{x:Static prop:Resources.btnRunQuery}" VerticalContentAlignment="Center" Name="btn_RunQuery"/>
                </StackPanel>
                <Grid Grid.Row="3" x:Name="grd_TreeView" Height="Auto" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center"  Text="{x:Static prop:Resources.textBlockDatabaseView}" />
                        <TreeView  TabIndex="1" Name="trvw_Schemas" Grid.Row="1" ItemTemplate="{StaticResource treeTemplate}" SnapsToDevicePixels="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        </TreeView>
                    </Grid>
                    <GridSplitter  TabIndex="2" Background="Transparent" Width="1" Name="spliterVertical" Opacity=".7" VerticalAlignment="Stretch" HorizontalAlignment="Right" />
                    <Grid Grid.Column="1" Height="Auto"  Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="0.8*"/>
                            <!--<RowDefinition Height="0.9*"/>-->
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{x:Static prop:Resources.textBlockSelectedFields}" />
                            <ListBox  TabIndex="3" Grid.Row="1" Name="lvw_SelectedFields" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            </ListBox>
                        </Grid>
                        <Expander Grid.Row="1" IsExpanded="False" Header="{x:Static prop:Resources.headerRelationships}">
                            <ListView x:Name="ListViewRelationships" ItemsSource="{Binding}" TabIndex="4">
                                <!--<ListView.Resources>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.Resources>-->
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{x:Static prop:Resources.headerLeftTable}" DisplayMemberBinding="{Binding LeftTable}" Width="170">
                                        </GridViewColumn>
                                        <GridViewColumn Header="{x:Static prop:Resources.headerRelationships}" DisplayMemberBinding="{Binding RelationShip}" Width="150">
                                        </GridViewColumn>
                                        <GridViewColumn Header="{x:Static prop:Resources.headerRightTable}" DisplayMemberBinding="{Binding RightTable}" Width="170">
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Expander>
                    </Grid>
                </Grid>
                <Grid Grid.Row="3" x:Name="grd_TextView" Visibility="Collapsed"  Height="Auto" Margin="10,0,0,0">
                    <TextBox x:Name="rtbox_TextView" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="rtbox_TextView_TextChanged" />
                </Grid>
                <GridSplitter  TabIndex="5" Grid.Row="4" Name="spliterHorizontal" Margin="0,0,0,0" Opacity=".7" ResizeDirection="Rows" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="2" />
                <Expander  TabIndex="6" Grid.Row="5" IsExpanded="True" Header="{x:Static prop:Resources.headerQueryResults}" Margin="10,0,0,0">
                    <syncfusion:GridDataControl Margin="0,0,0,5" Grid.Row="1" AllowEdit="False" Name="dgrd_QueryResults" AutoPopulateColumns="True" AutoPopulateRelations="False" ShowAddNewRow="False" IsHitTestVisible="False" AllowDelete="False"/>
                </Expander>
            </Grid>
            <Grid Grid.Row="1" Height="25" Margin="10,0,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button TabIndex="9" x:Name="btn_HelponQueryDesigner" Width="80"  Content="{x:Static prop:Resources.btnHelp}" Grid.Column="0" />
                <StackPanel Orientation="Horizontal"  Grid.Column="1" HorizontalAlignment="Right">
                    <Button  TabIndex="10" Content="{x:Static prop:Resources.btnOK}" Margin="0,0,2,0" Width="80" x:Name="btn_QueryDesignerOk"/>
                    <Button  TabIndex="11" Content="{x:Static prop:Resources.btnCancel}" Margin="2,0,0,0" Width="80" x:Name="btn_QueryDesignerCancel" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</syncfusion:ChromelessWindow>
