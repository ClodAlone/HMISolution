<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.RdlcDataSourceUI" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
        Title="{x:Static prop:Resources.titleDataSetProperties}" ResizeMode="NoResize" ShowInTaskbar="False"        
        syncfusion:SkinStorage.VisualStyle="Office2007Blue" WindowStartupLocation="CenterScreen" PreviewKeyDown="ChromelessWindow_PreviewKeyDown"
        MinHeight="300" MinWidth="400" ShowIcon="False" Margin="0"
                             Height="400" Width="500" >
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Grid Width="480" Height="350">
        <Grid.RowDefinitions>            
            <RowDefinition Height="50*" />
            <RowDefinition Height="230*" />
            <RowDefinition Height="60*" />
        </Grid.RowDefinitions>
        <TextBlock Height="25"  HorizontalAlignment="Left" Margin="14,12,0,0" Name="Title_block" Text="Choose instances for data source used in the report." VerticalAlignment="Top" Width="450" FontSize="15" />
        <Grid Height="233" HorizontalAlignment="Left" Margin="1,5,0,0" Name="grid1" VerticalAlignment="Top" Width="480" Grid.Row="1">
            <Border BorderThickness="2" BorderBrush="Silver" Margin="15,0"></Border>
        </Grid>
        <Button Content="Finish" Width="100" Grid.Row="2" Height="25" HorizontalAlignment="Left" Margin="249,15,0,0" Name="btnFinish" VerticalAlignment="Top" Click="btnFinish_Click" />
        <Button Content="{x:Static prop:Resources.btnCancel}" Height="25" HorizontalAlignment="Left" Margin="364,15,0,0" Name="btnCancel" VerticalAlignment="Top" Width="100" Grid.Row="2" Click="btnCancel_Click" />
        <Grid Margin="18,6,16,0" Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Silver" BorderThickness="1" Height="25" HorizontalAlignment="Left" Name="border1" VerticalAlignment="Top" Width="215" >
                    <TextBlock Text=" Report Data Sets" Height="20"/>
                </Border>
                <Border BorderBrush="Silver" BorderThickness="1" Grid.Column="1" Height="25" HorizontalAlignment="Left" Margin="0,0,0,0" Name="border2" VerticalAlignment="Top" Width="232" >
                    <TextBlock Text=" Data Set Instances" Height="20"/>
                </Border>
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <Grid Name="dataSetGrid" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>
