<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ConnectionPropertiesOLEDB" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" syncfusion:SkinStorage.VisualStyle="Office2007Blue" ShowIcon="False" Margin="0"
        xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"   
        Title="ConnectionProperties" Height="450" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Loaded="ChromelessWindow_Loaded" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Height="412">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="134"/>
            <RowDefinition Height="86"/>
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="OLE DB Provider:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="98" />
        </StackPanel>
        <StackPanel>
            <Grid Height="49">
                
            <ComboBox IsEditable="False" TabIndex="1" x:Name="cmb_OLEDBProvider" Margin="20,21,0,0" Width="254" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>
        <GroupBox  Grid.Row="1" Header="Enter a server or file name" Margin="5,0,12,5">
            <StackPanel Orientation="Vertical">
            <Grid Height="58">
              
                    <TextBox  TabIndex="4" x:Name="txt_FileName" Margin="10,16,86,20" Width="253" />
                    <Button Content="Browse...." Height="23" HorizontalAlignment="Right" Margin="0,15,7,0" Name="btn_browse" VerticalAlignment="Top" Width="73" Click="btn_browse_Click" />
                </Grid>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Margin="5,0,12,0" Header="{x:Static prop:Resources.headerLogOnToServer}"></GroupBox>
        <Grid Grid.Row="4" Height="25" Margin="4,7,-4,68">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button TabIndex="14" x:Name="btn_TestConnection" Width="100"  Content="{x:Static prop:Resources.btnTestConnection}" Grid.Column="0" Click="btn_TestConnection_Click" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,5,69" Grid.Row="4">
            <Button TabIndex="15" Content="{x:Static prop:Resources.btnOK}" Margin="0,0,12,0" Width="80" x:Name="btn_TestConnectionOK" IsDefault="True" Click="btn_TestConnectionOK_Click" />
            <Button TabIndex="16" Content="{x:Static prop:Resources.btnCancel}" Margin="2,0,15,0" Width="80" x:Name="btn_TestConnectionCancel" Click="btn_TestConnectionCancel_Click" />
        </StackPanel>
        <StackPanel Margin="11,17,11,0" Orientation="Vertical" Height="117" Grid.Row="2">
            <RadioButton TabIndex="2" x:Name="rbtn_WindowsAuthentication" GroupName="Credentials" Margin="0,5,0,5" Content="{x:Static prop:Resources.optionUseWindowsAuthentication}" Height="20" Checked="rbtn_WindowsAuthentication_Checked" />
            <RadioButton TabIndex="3" x:Name="rbtn_SqlAuthentication" GroupName="Credentials" Margin="0,0,0,5" Content="{x:Static prop:Resources.optionUseSqlServerAuthentication}" Height="20" Checked="rbtn_SqlAuthentication_Checked" />
            <Grid x:Name="grd_SqlServerAuthentication" Margin="25,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="tb_UserName" Grid.Row="0" Margin="0,3,0,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockUserName}" Height="20" />
                <TextBox TabIndex="4" x:Name="txt_UserName" Margin="0,3,6,3" Grid.Column="1" Width="240" Height="20" />
                <TextBlock x:Name="tb_Password" Grid.Row="1" Margin="0,3,0,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockPassword}" Height="20" />
                <PasswordBox TabIndex="5" x:Name="pwd_Password" Grid.Row="1" Margin="0,3,6,3" Grid.Column="1" Width="240" Height="20" />
            </Grid>
        </StackPanel>
        <GroupBox Grid.Row="3" Header="Initial catalog:" Height="55" HorizontalAlignment="Left" Margin="5,6,0,0" Name="grpbx_catalog" VerticalAlignment="Top" Width="373">
            <ComboBox Height="23" Name="cmb_catalog" Width="323" GotFocus="cmb_catalog_GotFocus" />
        </GroupBox>
    </Grid>
</syncfusion:ChromelessWindow>
