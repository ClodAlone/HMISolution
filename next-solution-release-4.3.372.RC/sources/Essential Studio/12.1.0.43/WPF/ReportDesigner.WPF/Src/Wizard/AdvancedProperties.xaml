<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.AdvancedProperties" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="Advanced Properties" Height="300" Width="300" ResizeMode="NoResize"  ShowIcon="False" ShowInTaskbar="False" Margin="0">
    <Grid x:Name="grd_AdvancedProperties">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="1" BorderThickness="0.2" BorderBrush="Gray">
            <TextBlock x:Name="tblk_PropertyDesc" />
        </Border>
        <Border Grid.Row="2" BorderThickness="0.2" BorderBrush="Gray">
            <TextBlock x:Name="tblk_ConnectionString"/>
        </Border>
        <Grid Grid.Row="3" Height="25" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"  Grid.Column="1" HorizontalAlignment="Right">
                <Button TabIndex="1" Content="OK" Margin="0,0,2,0" Width="80" x:Name="btn_TestConnectionOK"/>
                <Button TabIndex="2" Content="Cancel" Margin="2,0,0,0" Width="80" x:Name="btn_TestConnectionCancel"/>
            </StackPanel>
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>
