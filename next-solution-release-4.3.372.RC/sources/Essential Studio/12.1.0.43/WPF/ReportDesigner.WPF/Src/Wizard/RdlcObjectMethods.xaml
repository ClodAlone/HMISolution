<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.RdlcObjectMethods" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
        Title="{x:Static prop:Resources.titleDataSetProperties}" ResizeMode="NoResize" ShowInTaskbar="False"        
        syncfusion:SkinStorage.VisualStyle="Office2007Blue" WindowStartupLocation="CenterScreen" PreviewKeyDown="ChromelessWindow_PreviewKeyDown"
        MinHeight="300" MinWidth="400" ShowIcon="False" Margin="0"
                             Height="400" Width="500" >
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
        <Grid Height="360" Width="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="38*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="57*" />
            <RowDefinition Height="91*" />
            <RowDefinition Height="74*" />
            <RowDefinition Height="49*" />
        </Grid.RowDefinitions>
        <syncfusion:ComboBoxAdv Height="25" HorizontalAlignment="Left" Margin="12,20,0,0" Name="Methodscombo" VerticalAlignment="Top" Width="450"  Grid.Row="3" SelectionChanged="Methodscombo_SelectionChanged" >
            <syncfusion:ComboBoxAdv.Resources>
                <Style TargetType="{x:Type Popup}">                    
                </Style>
            </syncfusion:ComboBoxAdv.Resources>
        </syncfusion:ComboBoxAdv>
        <Button Content="OK"  Height="25" HorizontalAlignment="Left" Margin="287,12,0,0" Name="SelectOK" VerticalAlignment="Top" Width="80" Click="SelectOK_Click" Grid.Row="5" />
        <TextBlock Height="19" HorizontalAlignment="Left" Margin="12,4,0,0" Name="textBlock1" Text="Choose a method." VerticalAlignment="Top" Width="228" Grid.Row="3" />
        <TextBlock Height="25"  HorizontalAlignment="Left" Margin="12,11,0,0" Name="textBlock2" FontSize="15" Text="Choose a method of the business object that returns data collection. " VerticalAlignment="Top" Width="450" />
        <TextBlock Grid.Row="3"  Height="19" HorizontalAlignment="Left" Margin="12,63,0,0" Name="textBlock3" Text="Example: GetDataSource(),returns DataSet." VerticalAlignment="Top" Width="434" />
        <TextBlock Grid.Row="4" HorizontalAlignment="Left" Margin="12,5,0,50" Name="textBlock4" Text="Method signature:" Width="152" />
        <TextBlock Grid.Row="4"  Height="45" HorizontalAlignment="Left" Margin="12,21,0,0" Name="SignatureText" VerticalAlignment="Top" Width="450" MaxHeight="60" MaxWidth="500" TextWrapping="Wrap" />
        <syncfusion:ComboBoxAdv Height="25" HorizontalAlignment="Left" Margin="12,21,0,0" Name="NameSpaceCombo" VerticalAlignment="Top" Width="450" Grid.Row="1" SelectionChanged="NameSpaceCombo_SelectionChanged">
            <syncfusion:ComboBoxAdv.Resources>
                <Style TargetType="{x:Type Popup}">
                </Style>
            </syncfusion:ComboBoxAdv.Resources>
        </syncfusion:ComboBoxAdv>
        <TextBlock Height="19" HorizontalAlignment="Left" Margin="12,5,0,0" Name="textBlock5" Text="Choose a namespace." VerticalAlignment="Top" Width="228" Grid.Row="1" />
        <syncfusion:ComboBoxAdv Height="25" HorizontalAlignment="Left" Margin="12,23,0,0" Name="ClassCombo" VerticalAlignment="Top" Width="450" Grid.Row="2" SelectionChanged="ClassCombo_SelectionChanged">
            <syncfusion:ComboBoxAdv.Resources>
                <Style TargetType="{x:Type Popup}">
                </Style>
            </syncfusion:ComboBoxAdv.Resources>
        </syncfusion:ComboBoxAdv>
        <TextBlock Height="20" HorizontalAlignment="Left" Margin="12,6,0,0" Name="textBlock6" Text="Choose a class." VerticalAlignment="Top" Width="228" Grid.Row="2" />
        <Button Content="Cancel" Height="25" HorizontalAlignment="Right" Margin="0,12,25,0" Name="btnCancel"  VerticalAlignment="Top" Width="80" Grid.Row="5" Click="btnCancel_Click" />
    </Grid>
</syncfusion:ChromelessWindow>
