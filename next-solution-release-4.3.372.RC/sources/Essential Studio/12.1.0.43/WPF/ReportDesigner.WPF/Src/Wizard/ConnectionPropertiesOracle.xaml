<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ConnectionPropertiesOracle" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"  ShowIcon="False" Margin="0"
                             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"   
    Title="{x:Static prop:Resources.titleConnectionProperties}" Height="350" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Loaded="ChromelessWindow_Loaded" ShowInTaskbar="False">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>       
        <Grid.RowDefinitions>
            <RowDefinition Height="114"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="10"/>
            <RowDefinition />          
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,5,5" Orientation="Horizontal">
            <TextBlock Text="{x:Static prop:Resources.textBlockDataSource}" Margin="10,10,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </StackPanel>
        <StackPanel>
            <TextBox TabIndex="0" Text="Oracle(OracleClient)" Margin="15,30,0,0" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"></TextBox>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{x:Static prop:Resources.textBlockServerName}" Margin="15,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        </StackPanel>
        <StackPanel>
            <TextBox TabIndex="1" x:Name="service_text" Text="" Margin="15,80,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="250"></TextBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="5,5,5,14" Orientation="Horizontal">
            <GroupBox Header="{x:Static prop:Resources.headerLogOnToDatabase}" Margin="10,10,0,0" Width="300">
                <Grid x:Name="grd_ServerAuthentication" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />                       
                        <RowDefinition Height="20"/>                        
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,3,0,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockUserName}" VerticalAlignment="Center"/>
                    <TextBox TabIndex="2" x:Name="txt_UserName" Grid.Row="0" Margin="0,3,0,3" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Margin="0,3,0,3" Grid.Column="0" Text="{x:Static prop:Resources.textBlockPassword}" VerticalAlignment="Center"/>
                    <PasswordBox TabIndex="3" x:Name="pwd_Password" Grid.Row="1" Margin="0,3,0,3" Grid.Column="1" VerticalAlignment="Center" />                    
                    <CheckBox TabIndex="4" x:Name="chk_SavePwd" Grid.Row="2" Margin="34,3,0,3" Grid.Column="1" Content="{x:Static prop:Resources.chkBoxSavePassword}" />                                      
                </Grid>
          </GroupBox>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Separator Margin="0,1,0,0" Width="328" HorizontalAlignment="Left" Height="0"></Separator>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="5,0,0,5" Orientation="Horizontal">
            <Button TabIndex="5" Margin="10,0,0,0" x:Name="btn_TestConnection" Width="100" Height="25"  Content="{x:Static prop:Resources.btnTestConnection}" Click="btn_TestConnection_Click" />
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right">
                <Button TabIndex="6" Content="{x:Static prop:Resources.btnOK}" Margin="20,0,0,0" Width="80" Height="25" x:Name="btn_TestConnectionOK" Click="btn_TestConnectionOk_Click" IsDefault="True"/>
                <Button TabIndex="7" Content="{x:Static prop:Resources.btnCancel}" Margin="8,0,5,0" Width="80" Height="25"  x:Name="btn_TestConnectionCancel" Click="btn_TestConnectionCancel_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
