<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Wizard.LoginCredentials" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
        Title="{x:Static prop:Resources.textBlockAuthenticationWindow}" TitleTextAlignment="Center" Height="195" Width="300" ResizeMode="NoResize" ShowIcon="False" WindowStartupLocation="CenterOwner" Loaded="ChromelessWindow_Loaded">
    <StackPanel Orientation="Vertical">
        <Grid>
            <TextBlock Grid.Row="0" x:Name="txt_serverName" Margin="20,0,0,0" Height="21" HorizontalAlignment="Stretch" 
                   VerticalAlignment="Center" />
        </Grid>
        <Grid >
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96*"></ColumnDefinition>
                    <ColumnDefinition Width="182*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Label Margin="32,6,0,6" Target="{Binding ElementName=txtUsername}" HorizontalAlignment="Left" Width="73" Grid.Row="1">
                    <AccessText>
                        _Username:
                    </AccessText>
                </Label>
                <TextBox Name="txtUsername" Margin="5,10,31,6"  Grid.Column="1" Grid.Row="1">
                </TextBox>
                <Label Margin="32,6,0,6" Target="{Binding ElementName=txtPassword}" HorizontalAlignment="Left" Width="73" Grid.Row="2">
                    <AccessText>
                        _Password:
                    </AccessText>
                </Label>
                <PasswordBox Name="txtPassword" Margin="5,10,31,6"  Grid.Column="1" Grid.Row="2" PasswordChar="*">
                </PasswordBox>
            </Grid>
            <Grid ShowGridLines="True" Margin="2,96,-2,1347" Height="Auto">
                <Button Content="Submit" Width="70" Height="21" Name="btnSubmit" Margin="56,8,152,67" Click="btnSubmit_Click" />
                <Button Content="Cancel" Width="70" Height="21" Name="btnCancel" Margin="145,9,63,67" Click="btnCancel_Click" />
            </Grid>
        </Grid>
    </StackPanel>
</syncfusion:ChromelessWindow>
