<sync:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ODBCDatasources"  x:ClassModifier="internal"
        xmlns:sync="http://schemas.syncfusion.com/wpf"              
        xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Data Source" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Height="450" Width="470" ShowIcon="False" ShowInTaskbar="False" >
    <Grid>
        <GroupBox Header="Drivers" Height="107" HorizontalAlignment="Left" Margin="14,8,0,0" Name="groupBox1" VerticalAlignment="Top" Width="434">
            <Grid>
                <Label Content="Select a driver to set up a data source:" Height="29" HorizontalAlignment="Left" Margin="13,13,0,0" Name="label5" VerticalAlignment="Top" Width="219" HorizontalContentAlignment="Left" />
                <ComboBox Height="24" HorizontalAlignment="Left" Margin="17,43,0,0" Name="datasourcelst" VerticalAlignment="Top" Width="268" SelectionChanged="datasourcelst_SelectionChanged" />
            </Grid>
        </GroupBox>
        <Button Content="Test connection" Height="27" HorizontalAlignment="Left" Margin="18,371,0,0" Name="btn_testconnection" VerticalAlignment="Top" Width="128" Click="btn_testconnection_Click" />
        <Button Content="OK" Height="27" HorizontalAlignment="Right" Margin="0,372,115,0" Name="btn_ok" VerticalAlignment="Top" Width="64" Click="btn_ok_Click" />
        <Button Content="Cancel" Height="27" HorizontalAlignment="Right" Margin="0,372,19,0" Name="btn_cancel" VerticalAlignment="Top" Width="88" Click="btn_cancel_Click" />
        <GroupBox Header="Data source set up" Height="235" Margin="14,121,12,0" Name="groupBox2" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="37*" />
                    <RowDefinition Height="37*" />
                    <RowDefinition Height="140*" />
                </Grid.RowDefinitions>
                <Label Content="Data source Name" Height="26" HorizontalAlignment="Left" Margin="7,6,0,0" Name="label1" VerticalAlignment="Top" Width="72" HorizontalContentAlignment="Right" />
                <Label Content="Database" Grid.Row="1" Height="26" HorizontalAlignment="Left" Margin="7,5,0,0" Name="label2" VerticalAlignment="Top" Width="72" HorizontalContentAlignment="Right" />
                <TextBox Height="26" HorizontalAlignment="Left" Margin="82,6,0,0" Name="txt_dsn" VerticalAlignment="Top" Width="203" />
                <TextBox Grid.Row="1" Height="26" HorizontalAlignment="Left" Margin="82,5,0,0" Name="txt_db" VerticalAlignment="Top" Width="203" />
                <Button Content="Browse.." Grid.Row="1" Height="26" HorizontalAlignment="Left" Margin="320,6,0,0" Name="btn_browse" VerticalAlignment="Top" Width="84" Click="btn_browse_Click" />
                <Grid Grid.Row="2" Height="136" HorizontalAlignment="Left" Margin="0,1,0,0" Name="Postgre_grid" VerticalAlignment="Top" Width="409">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="37*" />
                        <RowDefinition Height="37*" />
                        <RowDefinition Height="57*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="79*" />
                        <ColumnDefinition Width="126*" />
                        <ColumnDefinition Width="78*" />
                        <ColumnDefinition Width="126*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Server" Height="26" HorizontalAlignment="Left" Margin="5,8,0,0" Name="label3" VerticalAlignment="Top" Width="72" HorizontalContentAlignment="Right" />
                    <Label Content="Port" Grid.Column="2" Height="26" HorizontalAlignment="Left" Margin="3,7,0,0" Name="label4" VerticalAlignment="Top" Width="72" HorizontalContentAlignment="Right" />
                    <Label Content="Username" Height="26" HorizontalAlignment="Left" Margin="6,6,0,0" Name="label6" VerticalAlignment="Top" Width="72" Grid.Row="1" HorizontalContentAlignment="Right" />
                    <Label Content="Password" Grid.Column="2" Height="25" HorizontalAlignment="Left" Margin="3,6,0,0" Name="label7" VerticalAlignment="Top" Width="72" Grid.Row="1" HorizontalContentAlignment="Right"/>
                    <TextBox Height="26" HorizontalAlignment="Right" Margin="0,7,3,0" Name="txt_servername" VerticalAlignment="Top" Width="120" Grid.Column="1" />
                    <TextBox Height="26" HorizontalAlignment="Left" Margin="3,6,0,0" Name="txt_username" VerticalAlignment="Top" Width="120" Grid.Row="1" Grid.Column="1" />
                    <TextBox Grid.Column="3" Height="26" HorizontalAlignment="Left" Margin="3,7,0,0" Name="txt_portname" VerticalAlignment="Top" Width="120" />
                    <PasswordBox Grid.Column="3" Grid.Row="1" Height="26" HorizontalAlignment="Left" Margin="3,6,0,0" Name="txt_pwd" VerticalAlignment="Top" Width="120" />
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</sync:ChromelessWindow>
