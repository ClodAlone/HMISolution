<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.DataSetObjectWizard" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        syncfusion:SkinStorage.VisualStyle="Office2007Blue"
        xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
                             xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs" 
        WindowStartupLocation="CenterOwner"  TitleTextAlignment="Center" ShowInTaskbar="False"
        Height="500" Width="658" ResizeMode="NoResize"
        Title="Data Source Configuration Wizard"  ShowIcon="False" Margin="0">    
    <Grid>
        <syncfusion:BusyIndicator x:Name="busyIndicator"
                                              Header="Assembly" 
                                              IsBusy="False"
                                              LoadingDescription="Loading Assemblies..."
                                              CloseButtonVisibility="Collapsed"
                                               CancelButtonVisibility="Collapsed"
                                              IsIndeterminate="True"                                              
                                              OverlayOpacity="0.5">
    <Grid>        
        <Grid Margin="0,0,0,397" >
            <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/DataObjects.png" Margin="0,0,586,0"/>
            <TextBlock Text="Select the Data Objects" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="90,0,0,0" />
        </Grid>
        <Grid Margin="0,70,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="317*" />
                <ColumnDefinition Width="361*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Expand the referenced assemblies and namespaces to select your objects. If an object is missing from a referenced assembley, cancel the wizard and rebuildthe project that contains the object" TextWrapping="Wrap" Margin="17,6,0,351" Grid.ColumnSpan="2" />
            <TextBlock Text="What objects do you want to bind to?" TextWrapping="Wrap" FontWeight="Bold" Margin="17,46,6,325" Grid.ColumnSpan="2" />
        
            <TreeView x:Name="referenceList" Margin="17,68,197,111" Grid.ColumnSpan="2">
                        <TreeView.Resources>
						   <HierarchicalDataTemplate  DataType="{x:Type local:AssemblyInfo}" ItemsSource="{Binding Path = NameSpaces}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsThreeState ="True"  IsChecked="{Binding Path = IsChecked}" VerticalAlignment="Center" Checked="CheckBox_Checked"
                                               Unchecked="CheckBox_Unchecked" />
                                    <ContentPresenter Content="{Binding Path = AssemblyName}" Margin="2,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
							
							<HierarchicalDataTemplate  ItemsSource="{Binding Path = Objects}" DataType="{x:Type local:AssemblyNameSpaceInfo}" >
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsThreeState ="True"  IsChecked="{Binding Path = IsChecked}" VerticalAlignment="Center" Checked="CheckBox_Checked"
                                               Unchecked="CheckBox_Unchecked" />
                                    <ContentPresenter Content="{Binding Path = NameSpace}" Margin="2,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
							
                            <DataTemplate DataType="{x:Type local:ObjectInfo}" >
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Path = IsChecked}" VerticalAlignment="Center" Checked="CheckBox_Checked"
                                               Unchecked="CheckBox_Unchecked" />
                                    <ContentPresenter Content="{Binding Path = FullName}" Margin="2,0" />
                                </StackPanel>
                            </DataTemplate>

                        </TreeView.Resources>
                    </TreeView>
            
            <TextBox Margin="17,294,197,83" Grid.ColumnSpan="2" IsReadOnly="True"/>

            <Button Content="Finish" Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="78,362,0,0" Name="finishWizard" VerticalAlignment="Top" Width="95" Click="finishWizard_Click"  />
            <Button Content="Cancel" Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="194,362,0,0" Name="cancelWizard" VerticalAlignment="Top" Width="86" Click="cancelWizard_Click" />
            <Button Content="Add Reference..." Grid.Column="1" Height="23" HorizontalAlignment="Left" Margin="194,68,0,0" Name="addReference" VerticalAlignment="Top" Width="120" Click="FileDialog"  />
            <Line
    X1="0" Y1="350"
    X2="700" Y2="350"
    Stroke="White"
    StrokeThickness="2" Grid.ColumnSpan="2" />
        </Grid>
        </Grid>
        </syncfusion:BusyIndicator>
    </Grid>
</syncfusion:ChromelessWindow>
