<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.DataSourceUI" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    Title="{x:Static prop:Resources.titleDataSourceProperties}" TitleTextAlignment="Center" ResizeMode="NoResize" ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner" Loaded="ChromelessWindow_Loaded" PreviewKeyDown="ChromelessWindow_PreviewKeyDown"
    MinHeight="300" MinWidth="400" Height="530" Width="500"  ShowIcon="False" Margin="0">
    
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
                <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    
    <Grid Margin="5,5,5,5" Height="482">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <syncfusion:TabControlExt CloseButtonType="Hide" ShowTabItemContextMenu="False" ShowTabListContextMenu="False" Margin="0,0,0,12">
            <syncfusion:TabItemExt Header="{x:Static prop:Resources.headerGeneral}" IsSelected="True" x:Name="tabItemGeneral">
                <Grid Height="399">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="256*"/>
                        <RowDefinition Height="6*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static prop:Resources.dataSourceTextBlock}" VerticalAlignment="Center" FontSize="14" Margin="15,0,0,0"></TextBlock>
                    <StackPanel Margin="18,3,2,1" VerticalAlignment="Center" Orientation="Vertical" Grid.Row="1">
                        <TextBlock Text="{x:Static prop:Resources.txtBlockName}" HorizontalAlignment="Left" Width="50"></TextBlock>
                        <TextBox  TabIndex="1" Name="txt_DataSourceName" HorizontalAlignment="Left" Width="200" />
                    </StackPanel>
                  
                    <StackPanel Grid.Row="2" Height="42" HorizontalAlignment="Left" Margin="17,1,0,0" Name="stackPanel1" VerticalAlignment="Top" Width="440">
                        <RadioButton Content="Use a embedded connection" IsChecked="True" Height="16" Margin="1,5,0,0" Name="rbtn_embeddedconnection" Width="262" HorizontalAlignment="Left" />
                        <RadioButton Content="use a shared connection" Height="16" Margin="1,5,0,0" Name="rbtn_sharedconnection" Width="257" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Height="238" HorizontalAlignment="Left" Margin="6,10,0,0" Name="embedded_connection" VerticalAlignment="Top" Width="450">

                    <StackPanel Margin="15,28,17,185" Grid.Row="3" VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock Text="{x:Static prop:Resources.textBlockSelectConnectionType}" HorizontalAlignment="Left" Width="200"></TextBlock>
                        <ComboBox Name="cmb_ConnectionType" HorizontalAlignment="Left" Width="200"></ComboBox>
                    </StackPanel>
                        <Grid Margin="11,-190,17,16" Grid.Row="3" Height="155">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static prop:Resources.textBlockConnectionString}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Width="200"></TextBlock>
                            <TextBox TabIndex="3" Name="txt_ConnectionString" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Auto" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" />
                            <Button TabIndex="4" Name="btn_Build" Content="{x:Static prop:Resources.btnBuild}" Grid.Row="1" Grid.Column="1" Height="25" Width="80" VerticalAlignment="Top"></Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Height="235" HorizontalAlignment="Left" Margin="9,15,0,0" Name="sharedconnection" VerticalAlignment="Top" Width="444">
                        <StackPanel Height="179" Name="stackPanel3" Width="425">
                            <ListBox Height="172" Name="datasourcelist" Width="408">
                                
                            </ListBox>
                        </StackPanel>
                        <Button Content="Browse..." Margin="19,3,0,0" Name="browse" Width="80" Height="25" HorizontalAlignment="Left" />
                    </StackPanel>
                    <!--<CheckBox Margin="20,0,0,0" Name="chk_Transaction" Content="Use single transaction when processing the queries" Grid.Row="4" VerticalAlignment="Center"></CheckBox>-->
                </Grid>
            </syncfusion:TabItemExt>
