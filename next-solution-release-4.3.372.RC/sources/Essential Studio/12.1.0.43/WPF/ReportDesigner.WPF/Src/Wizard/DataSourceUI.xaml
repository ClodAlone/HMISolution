        </syncfusion:TabControlExt>
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Height="25" Orientation="Horizontal">
            <Button  TabIndex="5" Name="btn_OK" Content="{x:Static prop:Resources.btnOK}" Width="80"  Click="btn_OK_Click" IsDefault="True"></Button>
            <Button  TabIndex="6" Name="btn_Cancel" Margin="8,0,0,0" Content="{x:Static prop:Resources.btnCancel}" Width="80" Click="btn_Cancel_Click"></Button>
        </StackPanel>
        </Grid>
        
</syncfusion:ChromelessWindow>
