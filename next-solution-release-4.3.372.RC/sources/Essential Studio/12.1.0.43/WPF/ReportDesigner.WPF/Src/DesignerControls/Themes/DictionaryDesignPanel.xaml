<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.WPF"
                    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
                    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"                    
                    xmlns:syncfusionSchemas="http://schemas.syncfusion.com/wpf"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.ReportDesigner.WPF;component/Themes/generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <ToolTip x:Key="ToolTipDisabledIcons" Width="200" Height="30" Content="This feature is under construction."/>
    <Style TargetType="{x:Type local:DesignPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DesignPanel}">
                       <Grid AllowDrop="True" Background="Gray" x:Name="GridDesignPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.Resources>
                            <local:DesignPanelStyle x:Key="DeafultStyle" RulerTickColor="Black" RulerBorderColor="Transparent" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="#ff9bbbe3" DesignerAreaBackGround ="#FF618CC6"/>
                            
                            <local:DesignPanelStyle x:Key="MetroStyle" RulerTickColor="Black" RulerBorderColor="Black" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="White" DesignerAreaBackGround ="#F4F4F4"/>
                            
                            <local:DesignPanelStyle x:Key="Office2003Style" RulerTickColor="Black" RulerBorderColor="#83A5D2" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="#E2F0FD" DesignerAreaBackGround ="#E2F0FD"/>

                            <local:DesignPanelStyle x:Key="Office2007BlueStyle" RulerTickColor="Black" RulerBorderColor="#D5E2F3" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="#9BBBE3" DesignerAreaBackGround ="#9FBEE7"/>

                            <local:DesignPanelStyle x:Key="Office2007BlackStyle" RulerTickColor="Black" RulerBorderColor="Black" RulerIndicatorColor="Red"
                            RulerTextColor="#5A616C" RulerBackGround="#B1CAEB" RulerAreaBackGround="White" DesignerAreaBackGround ="#3D3D3D"/>

                            <local:DesignPanelStyle x:Key="Office2007SilverStyle" RulerTickColor="#585B5E" RulerBorderColor="#DCE1EC" RulerIndicatorColor="Red"
                            RulerTextColor="#585B5E" RulerBackGround="White" RulerAreaBackGround="#B2B7C2" DesignerAreaBackGround ="#CBCED7"/>

                            <local:DesignPanelStyle x:Key="ShinyRedStyle" RulerTickColor="Black" RulerBorderColor="#671919" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="White" DesignerAreaBackGround ="#D3D3D3"/>

                            <local:DesignPanelStyle x:Key="BlendStyle" RulerTickColor="White" RulerBorderColor="#424242" RulerIndicatorColor="Red"
                            RulerTextColor="White" RulerBackGround="#595959" RulerAreaBackGround="#333333" DesignerAreaBackGround ="#333333"/>

                            <local:DesignPanelStyle x:Key="ShinyBlueStyle" RulerTickColor="Black" RulerBorderColor="#094271" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="#6E2612" DesignerAreaBackGround ="#D3D3D3"/>

                            <local:DesignPanelStyle x:Key="SyncOrangeStyle" RulerTickColor="Black" RulerBorderColor="#D54A25" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="White" DesignerAreaBackGround ="#FAA846"/>

                            <local:DesignPanelStyle x:Key="VS2010Style" RulerTickColor="#8591A2" RulerBorderColor="#2C3D5A" RulerIndicatorColor="Red"
                            RulerTextColor="#8591A2" RulerBackGround="White" RulerAreaBackGround="#D3D3D3" DesignerAreaBackGround ="#D3D3D3"/>

                            <local:DesignPanelStyle x:Key="Office2010BlueStyle" RulerTickColor="#08325C" RulerBorderColor="#7994B4" RulerIndicatorColor="Red"
                            RulerTextColor="#08325C" RulerBackGround="#DFEBF7" RulerAreaBackGround="#CFDAF0" DesignerAreaBackGround ="#CFDAF0"/>

                            <local:DesignPanelStyle x:Key="Office2010BlackStyle" RulerTickColor="Black" RulerBorderColor="Black" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="#A7A7A7" RulerAreaBackGround="#6F6F6F" DesignerAreaBackGround ="#6F6F6F"/>

                            <local:DesignPanelStyle x:Key="Office2010SilverStyle" RulerTickColor="#585B5E" RulerBorderColor="#81878F" RulerIndicatorColor="Red"
                            RulerTextColor="#585B5E" RulerBackGround="#F6F6F6" RulerAreaBackGround="#CDD1D6" DesignerAreaBackGround ="#CDD1D6"/>
                            
                            <local:DesignPanelStyle x:Key="TransparentStyle" RulerTickColor="Black" RulerBorderColor="Black" RulerIndicatorColor="Red"
                            RulerTextColor="Black" RulerBackGround="White" RulerAreaBackGround="White" DesignerAreaBackGround ="#F4F4F4"/>

                        </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                        <Grid  x:Name="GridVertialRuler"  Grid.Row="1" Grid.Column="0" ClipToBounds="True" Background="#ff9bbbe3" Width="22" 
                              Visibility="Visible">
                                <Grid Margin="0,38.4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Grid.Row="0" Grid.Column="0">
                                    <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinitionRulerHeader" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinitionSeparatorHeader" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinitionRulerBody" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinitionSeparatorFooter" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinitionRulerFooter" Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid Margin="5,0,5,0" x:Name="GridHeaderRuler" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" Grid.Row="0" Grid.Column="0"
                                          Visibility="Collapsed">
                                        <local:Ruler x:Name="RulerVerticalHeader" Width="Auto" Unit="Inch" Marks="Down" RenderTransformOrigin="0,0" Length="2">
                                            <local:Ruler.LayoutTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <SkewTransform AngleX="0" AngleY="0"/>
                                                    <RotateTransform Angle="90"/>
                                                    <TranslateTransform X="0"/>
                                                </TransformGroup>
                                            </local:Ruler.LayoutTransform>
                                        </local:Ruler>
                                    </Grid>

                                <Separator x:Name="HeaderRulerSeperator" Width="22" Background="Gray" Grid.Row="1" Grid.Column="0" Height="1"
                                               Visibility="Collapsed"/>
                                    
                                    <Grid Margin="5,0,5,0" x:Name="GridBodyRuler" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" Grid.Row="2" Grid.Column="0">
                                        <local:Ruler x:Name="RulerVerticalBody" Width="Auto" Unit="Inch" Marks="Down" RenderTransformOrigin="0,0" Length="2">
                                            <local:Ruler.LayoutTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <SkewTransform AngleX="0" AngleY="0"/>
                                                    <RotateTransform Angle="90"/>
                                                    <TranslateTransform X="0"/>
                                                </TransformGroup>
                                            </local:Ruler.LayoutTransform>
                                        </local:Ruler>
                                    </Grid>

                                <Separator x:Name="FooterRulerSeperator" Width="22" Background="Gray" Grid.Row="3" Grid.Column="0" 
                                           Height="1" Visibility="Collapsed"/>

                                    <Grid Margin="5,0,5,0" x:Name="GridFooterRuler" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" Grid.Row="4" Grid.Column="0" 
                                          Visibility="Collapsed">

                                        <local:Ruler x:Name="RulerVerticalFooter" Width="Auto" Unit="Inch" Marks="Down" RenderTransformOrigin="0,0" Length="2">
                                            <local:Ruler.LayoutTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <SkewTransform AngleX="0" AngleY="0"/>
                                                    <RotateTransform Angle="90"/>
                                                    <TranslateTransform X="0"/>
                                                </TransformGroup>

                                            </local:Ruler.LayoutTransform>
                                        </local:Ruler>

                                    </Grid>

                                </Grid>
                            </Grid>

                        <Grid x:Name="GridHorizontalRuler" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#ff9bbbe3" Height="22"
                              Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HorizontalRulerColumnDefinition"  Width="Auto"/>
                                </Grid.ColumnDefinitions>

                            <Grid Margin="38.4,5,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" Grid.Row="0" Grid.Column="0">
                                    <local:Ruler x:Name="RulerHorizontal" Unit="Inch" Length="7" Margin="0,0,0,0"/>
                                </Grid>
                            </Grid>

                        <Grid  Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="GridCorner" Background="#ff9bbbe3"
                               Visibility="Visible"/>

                        <ScrollViewer Grid.Row="1"  Grid.Column="1" Visibility="Visible" HorizontalScrollBarVisibility="Auto"  VerticalScrollBarVisibility="Auto"                                      
                                          x:Name="scrollViewerReportBody">

                            <Grid Name="DesignerAreaGrid" Background="#FF618CC6" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" Margin="38.4,38.4,38.4,38.4" x:Name="DesignerInnerAreaGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="Gray" ShadowDepth="0" BlurRadius="20"></DropShadowEffect>
                                    </Grid.Effect>
                                        <Grid.RowDefinitions>
                                        <RowDefinition x:Name="headerRowDefination" MinHeight="0" />
                                        <RowDefinition x:Name="bodyRowDefination" MinHeight="0"/>
                                        <RowDefinition x:Name="footerRowDefination" MinHeight="0"/>
                                        <RowDefinition Height="2"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="reportColumnDefination"/>
                                            <ColumnDefinition Width="2"/>
                                        </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0" x:Name="HeaderGrid"
                                              Visibility="Collapsed">
                                            <Canvas x:Name="HeaderCanvas" Background="Transparent" >
                                                <Canvas.ContextMenu>
                                                 <ContextMenu>
                                                    <MenuItem Header="{x:Static prop:Resources.headerRemoveHeader}" x:Name="MenuItemHeaderRemoveHeader"/>                                                    
                                                </ContextMenu>
                                                </Canvas.ContextMenu>
                                            <Rectangle
                                                x:Name="HeaderSelectionBox"
                                                Visibility="Collapsed"
                                                Stroke="Black"
                                                StrokeThickness="1"
                                            />
                                        </Canvas>
                                        </Grid>

                                    <Grid Grid.Row="1" x:Name="BodyGrid">
                                            <Canvas x:Name="BodyCanvas" Background="Transparent">
                                            <Rectangle
                                                x:Name="BodySelectionBox"
                                                Visibility="Collapsed"
                                                Stroke="Black"
                                                StrokeThickness="1"
                                            />
                                        </Canvas>                                            
                                        </Grid>

                                    <Grid Grid.Row="2" x:Name="FooterGrid"  Visibility="Collapsed">
                                            <Canvas x:Name="FooterCanvas" Background="Transparent">
                                                <Canvas.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{x:Static prop:Resources.headerRemoveFooter}" x:Name="MenuItemFooterRemoveFooter" />                                                        
                                                    </ContextMenu>
                                                </Canvas.ContextMenu>
                                            <Rectangle
                                                x:Name="FooterSelectionBox"
                                                Visibility="Collapsed"
                                                Stroke="Black"
                                                StrokeThickness="1"
                                            />
                                        </Canvas>
                                        </Grid>

                                    <!--Header grid splitter-->
                                    <GridSplitter Margin="1,0,1,0" Height="1" Grid.Row="0" Background="Gray" HorizontalAlignment="Stretch" x:Name="gridSplitterHeader" VerticalAlignment="Bottom" 
                                                      Visibility="Collapsed"/>

                                    <!--Body grid splitter-->
                                    <GridSplitter Margin="1,0,1,0" Height="1" Grid.Row="1" Background="Gray" HorizontalAlignment="Stretch" x:Name="gridSplitterBody" VerticalAlignment="Bottom" />

                                    <!--Footer grid splitter-->
                                    <GridSplitter x:Name="gridSplitterFooter" Grid.Row="2" Grid.ColumnSpan="2" Height="2" Background="Transparent" 
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />

                                    <!--Report Witdh grid splitter-->
                                    <Grid Grid.Row="3" Background="Black" Margin="3,0,0,0" Grid.ColumnSpan="2"/>
                                    <GridSplitter Width="2" Grid.RowSpan="3" Margin="0,3,0,0" Grid.Column="1" Background="Black" HorizontalAlignment="Left" x:Name="gridSplitterReport" VerticalAlignment="Stretch" />
                                </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle Width="8" Height="8" Stroke="Black" StrokeThickness="1" RadiusX="2" RadiusY="2">
                        <Rectangle.Fill >
                            <SolidColorBrush Color="White" ></SolidColorBrush>
                        </Rectangle.Fill>
                        <!--<Rectangle.BitmapEffect>
                            <DropShadowBitmapEffect Color="Black" Direction="320" ShadowDepth="5" Softness="0.5" Opacity="0.2" />
                        </Rectangle.BitmapEffect>-->
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="MovingThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle Width="18" Height="18">
                        <Rectangle.Fill >
                            <ImageBrush ImageSource="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/MovingThumb.png"/>
                        </Rectangle.Fill>
                        <!--<Rectangle.BitmapEffect>
                            <DropShadowBitmapEffect Color="Black" Direction="320" ShadowDepth="5" Softness="0.5" Opacity="0.2" />
                        </Rectangle.BitmapEffect>-->
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>