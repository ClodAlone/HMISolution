<UserControl x:Class="Syncfusion.Windows.Reports.Designer.RDLDesignerControl" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
             xmlns:syncfusionTab="http://schemas.syncfusion.com/wpf">
    <Grid>
    <syncfusionTab:TabControlExt Name="rdlControl" TabStripPlacement="Bottom" CloseButtonType="Hide" >
          <syncfusionTab:TabItemExt Header="Design" Name="designTab">
            </syncfusionTab:TabItemExt>
            <syncfusionTab:TabItemExt Header="RDL[Read Only]" Name="rdlViewTab">
                <syncfusionTab:EditControl Name="rdlTextFile" DocumentLanguage="XML" IsReadOnly="True"/>
            </syncfusionTab:TabItemExt>
          </syncfusionTab:TabControlExt>
      <ContentControl Name="designControl" Visibility="Collapsed"/>
    </Grid>
</UserControl>