<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TextBoxGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="300" Width="400">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition x:Name="NameRowDef" Height="60"/>
            <RowDefinition x:Name="ValueRowDef" Height="60"/>
            <RowDefinition x:Name="ToolTipRowDef" Height="40"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockTextGeneralInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <StackPanel x:Name="stpnl_Name" Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockName}" HorizontalAlignment="Left" Width="50"></TextBlock>
            <TextBox TabIndex="1" Name="txt_GeneralName" HorizontalAlignment="Left" Width="300" />
        </StackPanel>
        <StackPanel  Margin="20,0,0,0" x:Name="stpnl_Value" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockValue}" HorizontalAlignment="Left" Width="300"></TextBlock>
            <ComboBox TabIndex="2" Name="cmb_Value" HorizontalAlignment="Left" Width="300">
              
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="stpnl_ToolTip" Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockToolTip}" HorizontalAlignment="Left" Width="300"></TextBlock>
            <TextBox    TabIndex="3" Name="txt_ToolTip" HorizontalAlignment="Left" Width="300" />
        </StackPanel>
        <StackPanel Visibility="Hidden" Margin="20,0,80,0" Grid.Row="4" VerticalAlignment="Top" Orientation="Vertical">
            <StackPanel Height="20" Background="CornflowerBlue">
                <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="{x:Static prop:Resources.textBlockSizingOptions}" />
            </StackPanel>
            <CheckBox TabIndex="4" Name="chk_AllowHeightIncrease" Margin="10,5,0,0" Content="{x:Static prop:Resources.chkBoxAllowHeightToIncrease}" HorizontalAlignment="Left" Width="300" />
            <CheckBox TabIndex="5" Name="chk_AllowHeightDecrease" Margin="10,5,0,0" Content="{x:Static prop:Resources.chkBoxAllowHeightToDecrease}" HorizontalAlignment="Left" Width="300" />
        </StackPanel>
    </Grid>
</UserControl>
