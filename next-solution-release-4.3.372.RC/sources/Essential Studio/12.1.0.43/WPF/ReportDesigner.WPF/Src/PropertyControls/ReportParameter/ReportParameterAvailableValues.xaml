<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ReportParameterAvailableValues" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"        
    Height="400" Width="400" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>-->
    </UserControl.Resources>
    <Grid x:Name="grd_ReportParamDefaultValues">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockParamAvailableInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="30,10,0,0" Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockSelectFromOneOfTheFollowingOptions}" HorizontalAlignment="Left" Width="300"></TextBlock>
            <RadioButton TabIndex="1" x:Name="rbtn_NoDefaultValue" Margin="5,10,0,0" GroupName="AvailableValues" IsChecked="True" Content="{x:Static prop:Resources.optionNone}" Checked="rbtn_NoDefaultValue_Checked" />
            <RadioButton TabIndex="2" x:Name="rbtn_SpecifyValue" Margin="5,5,0,0" GroupName="AvailableValues" Content="{x:Static prop:Resources.optionSpecifyValues}" Checked="rbtn_SpecifyValue_Checked"/>
            <RadioButton TabIndex="3" x:Name="rbtn_GetValueFromQuery" Margin="5,5,0,0" GroupName="AvailableValues" Content="{x:Static prop:Resources.optionGetValueFromQuery}" Checked="rbtn_GetValueFromQuery_Checked" />
        </StackPanel>
        <Grid Margin="15,0,0,0" Grid.Row="2" x:Name="grd_Specific" Visibility="Hidden">
            <StackPanel Margin="17,6,13,0" Orientation="Horizontal" Height="35" VerticalAlignment="Top">
                <Button Content="{x:Static prop:Resources.btnAdd}" x:Name="btn_Add" Margin="10,10,10,5" Width="50" Click="Button_Add_Click"/>
                <Button Content="{x:Static prop:Resources.btnDelete}" x:Name="btn_Delete" Margin="10,10,10,5" Width="65" IsEnabled="False" Click="Button_Delete_Click"/>
                <Button Margin="10,10,10,5" Width="30"  x:Name="btn_UpArrow" IsEnabled="False" Click="Button_UPArrow_Click">
                    <Image Source="../../Images/UpArrow.png" Width="15" Height="15"/>
                </Button>
                <Button Margin="10,10,10,5" Width="30" x:Name="btn_DownArrow" IsEnabled="False" Click="Button_DownArrow_Click">
                    <Image Source="../../Images/DownArrow.png" Width="15" Height="15"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10,40,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="listBox_Values" Height="215" Width="360">
                        <ListBoxItem IsSelected="False" IsHitTestVisible="False">
                            <StackPanel Width="340" Orientation="Horizontal">
                                <TextBlock Text="Label" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
                                <TextBlock Text="Value" Margin="260,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
                            </StackPanel>
                        </ListBoxItem>
                        <!--<ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="cmb_SpecificValue1" Text="(Null)" Width="300" IsEditable="True" />
                            <Button Content="fx" Margin="10,0,10,0" Width="30" />
                        </StackPanel>
                    </ListBoxItem>-->
                    </ListBox>
                </ScrollViewer>
            </StackPanel>

        </Grid>
        <Grid Margin="15,0,0,0" Grid.Row="2" x:Name="grid_QueryValues" Visibility="Hidden">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="10,10,10,10">
                <TextBlock Text="{x:Static prop:Resources.textBlockDataSet}" x:Name="txtBlock_DataSet"/>
                <ComboBox TabIndex="4" x:Name="cmb_QueryDataSet" Margin="10,10,10,30" SelectionChanged="cmb_QueryDataSet_SelectionChanged"/>

                <TextBlock Text="{x:Static prop:Resources.textBlockValueField}" x:Name="txtBlock_ValueField"/>
                <ComboBox TabIndex="5" x:Name="cmb_QueryValueField" Margin="10,10,10,30" IsEnabled="False"/>
                
                <TextBlock Text="{x:Static prop:Resources.textBlockLabelField}" x:Name="txtBlock_LabelField"/>
                <ComboBox TabIndex="6" x:Name="cmb_QueryLabelField" Margin="10,10,10,30" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
    </UserControl>
