<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixGroupPageBreak" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue" 
    Height="400" Width="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="367*" />
        </Grid.RowDefinitions>
        <TextBlock Height="20" HorizontalAlignment="Left" FontSize="14" Margin="10,0,0,0" Name="txt_HeaderText" Text="Change page break options." VerticalAlignment="Center" Width="200" />
        <StackPanel  Grid.Row="1" Height="100" Orientation="Vertical" Margin="10,10,0,0" VerticalAlignment="Top">
            <TextBlock Height="20" HorizontalAlignment="Left" Margin="30,0,0,0" Name="txt_SubHeaderText" Text="Page break options:" Width="200" />
            <CheckBox Content="Between each instance of a group" Height="20" HorizontalAlignment="Left" Margin="30,0,0,0" Name="chk_betweenGroup" Checked="Between_Checked" Unchecked="Between_UnChecked" />
            <CheckBox Content="Also at the start of a group" Height="20" HorizontalAlignment="Left" Margin="50,0,0,0" Name="chk_AtStart" IsEnabled="False" />
            <CheckBox Content="Between each instance of a group" Height="20" HorizontalAlignment="Left" Margin="50,0,0,0" Name="chk_AtEnd" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
