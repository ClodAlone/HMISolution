<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ServerAuthentication" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterScreen"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="{x:Static prop:Resources.textBlockAuthenticationWindow}" TitleTextAlignment="Center" ShowInTaskbar="False" Height="200" Width="380" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="txt_serverName" Margin="20,0,0,0" HorizontalAlignment="Stretch" 
                   VerticalAlignment="Center" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txt_UserName" Margin="20,0,0,0" HorizontalAlignment="Stretch"
                       VerticalAlignment="Center" Text="{x:Static prop:Resources.textBlockUserName}" />
            <TextBox Grid.Column="1" TabIndex="1" x:Name="txBx_Username" Margin="5,0,0,0" HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txt_Password" Margin="20,0,0,0" HorizontalAlignment="Stretch"
                       VerticalAlignment="Center" Text="{x:Static prop:Resources.textBlockPassword}" />
            <PasswordBox Grid.Column="1" TabIndex="2" x:Name="pwBx_Password" Margin="5,0,0,0" 
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Grid>
        <!--<Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>            
            <CheckBox Grid.Column="1" TabIndex="3" x:Name="chk_Remember" Margin="5,0,0,0" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsChecked="False"/>
            <TextBlock Grid.Column="2" x:Name="txt_Remember" Margin="0,0,0,0" HorizontalAlignment="Stretch"
                       VerticalAlignment="Center" Text="Remember my password" />
        </Grid>-->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="118*" />
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="18*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" TabIndex="3" x:Name="btn_Ok" Content="{x:Static prop:Resources.btnOK}" Width="60" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" Margin="5,0,0,0" Click="btn_Ok_Click" IsDefault="True" />
            <Button Grid.Column="3" TabIndex="4" x:Name="btn_cancel" Content="{x:Static prop:Resources.btnCancel}" Width="60" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,0,0,0" Click="btn_cancel_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>
