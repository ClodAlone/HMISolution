<UserControl x:Class="Syncfusion.Windows.Reports.PropertyControls.GaugeFrameFill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Wizard"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid x:Name="grd_FrameFill">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>           
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Set the Frame Color options." VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="15,0,0,0"></TextBlock>

       <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Frame Color:" HorizontalAlignment="Left" Width="200"></TextBlock>
            <syncfusion:ColorPicker Margin="0,3,0,0" x:Name="clrpkr_FrameColor" Width="100" HorizontalAlignment="Left"/>
        </StackPanel>       
    </Grid>
</UserControl>
