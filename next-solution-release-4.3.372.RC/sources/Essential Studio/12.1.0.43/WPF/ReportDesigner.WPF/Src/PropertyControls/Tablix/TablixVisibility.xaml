<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixVisibility" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="300" Width="400">
    <Grid x:Name="grd_Visibility">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="130*"/>
            <RowDefinition Height="130*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change display options" VerticalAlignment="Center" FontSize="14" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Top" Orientation="Vertical" Height="132">
            <TextBlock Text="When the report is initially run:" Margin="0,0,0,5" HorizontalAlignment="Left" ></TextBlock>
            <RadioButton TabIndex="1" x:Name="rbtn_Show" IsChecked="True" Margin="10,0,0,5" GroupName="ControlVisibility" Content="Show" />
            <RadioButton TabIndex="2" x:Name="rbtn_Hide" Margin="10,0,0,5" GroupName="ControlVisibility" Content="Hide" />
            <RadioButton TabIndex="3" x:Name="rbtn_Expression" Margin="10,0,0,5" GroupName="ControlVisibility" Content="Show or Hide based on expression" />
            <designerlocal:ExpressionComboBox x:Name="expression" Margin="0,0,25,5" Height="25" Width="300" IsEnabled="{Binding ElementName=rbtn_Expression,Path=IsChecked}" ></designerlocal:ExpressionComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <CheckBox  Content="Display can be toggled by this report item:" Height="20" Name="chk_toggle" Margin="20,0,0,0" />
            <ComboBox Margin="40,0,50,0" Height="25" Name="cmb_ToggleItem" />
        </StackPanel>
    </Grid>
</UserControl>
