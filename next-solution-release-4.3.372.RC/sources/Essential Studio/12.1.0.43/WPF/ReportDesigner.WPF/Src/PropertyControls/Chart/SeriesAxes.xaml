<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.SeriesAxes" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"  
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="450" >
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="220*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Set Series Axis" VerticalAlignment="Center" FontSize="16" Margin="15,-250,0,0" ></TextBlock>
       
        <StackPanel Name="stackPanel_Axes" Margin="15,70,80,0" Grid.Row="0" VerticalAlignment="Top" Orientation="Vertical" Height="300">
            <StackPanel Height="20" Background="CornflowerBlue"  Width="350">
                <TextBlock FontWeight="Bold" Text="Change Series Axis Position" Height="20" Width="350" />
            </StackPanel>
            <StackPanel Height="70" Width="350" Margin="0,10,0,0">
                <TextBlock Text="Value Axis:" Height="23" Width="350" />
                <RadioButton TabIndex="4" Name="rb_PrimaryYAxis" Margin="20,5,0,0" Content="Primary" HorizontalAlignment="Left" Width="300" GroupName="YAxis" />
                <RadioButton TabIndex="5" Name="rb_SecondaryYAxis" Margin="20,4,0,0" Content="Secondary" HorizontalAlignment="Left" Width="300" GroupName="YAxis" />
            </StackPanel>
            <StackPanel Height="100" Width="350" Margin="0,10,0,0">
                <TextBlock Text="Category Axis:" Height="23" Width="350" />
                <RadioButton TabIndex="4" Name="rb_PrimaryXAxis" Margin="20,5,0,0" Content="Primary" HorizontalAlignment="Left" Width="300" GroupName="XAxis" />
                <RadioButton TabIndex="5" Name="rb_SecondaryXAxis" Margin="20,4,0,0" Content="Secondary" HorizontalAlignment="Left" Width="300" GroupName="XAxis" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
