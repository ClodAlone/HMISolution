<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.SelectReport"  x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    WindowStartupLocation="CenterOwner"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="{x:Static prop:Resources.textBlockBrowserWindow}" TitleTextAlignment="Center" ShowIcon="False" ShowInTaskbar="False" Height="500" Width="600" ResizeMode="NoResize">
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="435"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="txt_LookIn" Text="{x:Static prop:Resources.textBlockSitesInfo}" Margin="15,0,0,0" HorizontalAlignment="Stretch"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" TabIndex="1" x:Name="cmb_SitesAndServer" IsEditable="False"
                      SelectedIndex="0" Height="25" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
            </ComboBox>
            <Button Grid.Column="2" TabIndex="2" x:Name="btn_Back" Margin="10,0,0,0" BorderThickness="1"
                    BorderBrush="Black" HorizontalAlignment="Stretch" IsEnabled="False" VerticalAlignment="Stretch"
                    Click="btn_Back_Click">
                <Image Source="pack://application:,,,/Syncfusion.ReportDesigner.WPF;component//Images/BackButton.png"/>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <ListBox Margin="10,10,10,10" TabIndex="3" x:Name="Ltbx_Contents" HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"></ListBox>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txt_Name" Text="{x:Static prop:Resources.textBlockName}" Margin="10,0,0,0" 
                       HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" TabIndex="4" x:Name="txt_FileName" Margin="5,0,10,0" 
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="25"/>
            <Button Grid.Row="0" Grid.Column="2" TabIndex="5" x:Name="btn_OpenFile" Content="{x:Static prop:Resources.btnOpen}" Margin="5,0,8,0" Height="25"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" IsDefault="True" Click="btn_OpenFile_Click"/>
            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="txt_Items" Text="{x:Static prop:Resources.textBlockServerFilesType}" Margin="10,0,0,0"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" TabIndex="6" x:Name="cmb_TypeItems" Margin="5,0,10,0" Height="25"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedIndex="0">
                <ComboBox.Items>
                    <ComboBoxItem Content="Reports(*.rdl)" />
                    <ComboBoxItem Content="All Items(*.*)" />
                </ComboBox.Items>
            </ComboBox>
            <Button Grid.Row="1" Grid.Column="2" TabIndex="7" x:Name="btn_Cancel" Margin="5,0,8,0" Height="25"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{x:Static prop:Resources.btnCancel}" 
                    Click="btn_Cancel_Click" IsCancel="True"></Button>
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>
