<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TextBoxText_General" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="300" Width="400">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/> 
            <RowDefinition Height="40"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockTextBoxGeneralTextInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        
        <StackPanel Margin="15,24.04,5,17.96" Grid.Row="1" Orientation="Vertical" Grid.RowSpan="2">
            <TextBlock Text="{x:Static prop:Resources.textBlockToolTip}" HorizontalAlignment="Left" Width="381" Height="17"></TextBlock>
            <TextBox TabIndex="1" IsEnabled="True"  Name="txt_ToolTip" HorizontalAlignment="Left" Width="384" Height="21" />
        </StackPanel>
        <StackPanel Visibility="Hidden" Margin="20,0,80,0" Grid.Row="3" VerticalAlignment="Top" Orientation="Vertical">
            <StackPanel Height="20" Background="CornflowerBlue">
                <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="{x:Static prop:Resources.textBlockSizingOptions}" />
            </StackPanel>
            <CheckBox TabIndex="2" Name="chk_AllowHeightIncrease" Margin="10,5,0,0" Content="{x:Static prop:Resources.chkBoxAllowHeightToIncrease}" HorizontalAlignment="Left" Width="300" />
            <CheckBox TabIndex="3" Name="chk_AllowHeightDecrease" Margin="10,5,0,0" Content="{x:Static prop:Resources.chkBoxAllowHeightToDecrease}" HorizontalAlignment="Left" Width="300" />
        </StackPanel>
    </Grid>
</UserControl>
