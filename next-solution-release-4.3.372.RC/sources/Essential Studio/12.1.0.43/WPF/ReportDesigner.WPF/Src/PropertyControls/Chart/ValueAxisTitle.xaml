<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ValueAxisTitle" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"   
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockAxisTitleInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,2,0,16"></TextBlock>

        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <TextBox TabIndex="1" Name="Txt_ValueTitle" Text="Axis Title" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-250,0,0,-15" Height="23"/>
            <TextBlock Text="{x:Static prop:Resources.textBlockFontFamily}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="FontFamily" TabIndex="2" x:Name="cmb_ValueTitleFont" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" SelectedIndex="51"></designerlocal:ExpressionComboBox>
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockFontSize}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="FontSize" TabIndex="3" x:Name="cmb_ValueTitleFontSize" SelectedIndex="3" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
            <TextBlock Text="{x:Static prop:Resources.textBlockTitleAllignment}" HorizontalAlignment="Left" Width="194" Margin="0,0,0,0" Height="43"></TextBlock>
            <designerlocal:ExpressionComboBox ComboType="TitleAlignment" TabIndex="4" x:Name="cmb_TitleAllignment" SelectedIndex="1" HorizontalAlignment="Left" Width="150 " 
                           IsEnabled="True" Margin="-195,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockFontColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="5" x:Name="clrpkr_ValueTitleFontColor" Width="150"
                     VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-200,0,0,-15" Height="23"/>
            <TextBlock Text="Font Style:" HorizontalAlignment="Left" Width="194" Margin="0,0,0,0" Height="43"></TextBlock>
            <designerlocal:ExpressionComboBox ComboType="FontStyle"  TabIndex="4" x:Name="cmb_ValueFontStyle" SelectedIndex="1" HorizontalAlignment="Left" Width="150 " 
                           IsEnabled="True" Margin="-195,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
        </StackPanel>

    </Grid>
</UserControl>
