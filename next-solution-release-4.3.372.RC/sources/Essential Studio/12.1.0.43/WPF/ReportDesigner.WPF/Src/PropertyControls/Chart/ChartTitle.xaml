<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ChartTitle" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"   
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="80*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockChartTitleInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,18"></TextBlock>

        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <TextBox TabIndex="1" Name="Txt_ChartTitle" Text="{x:Static prop:Resources.textBlockTitle}" Width="150" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="-250,0,0,-10" Height="23"/>
            <TextBlock Text="Font:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="FontFamily" x:Name="cmb_ChartTitleFont" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center"
                                              Margin="-200,0,0,-10" Height="23"></designerlocal:ExpressionComboBox>            
        </StackPanel>

        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="Size:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="FontSize" TabIndex="3" x:Name="cmb_ChartTitleFontSize" SelectedIndex="4" HorizontalAlignment="Left" Width="150"
                      VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>           
            <TextBlock Text="Color" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="4" x:Name="clrpkr_ChartFontColor" Width="150"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>            
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="Background:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="5" x:Name="clrpkr_ChartTitleBackground" Width="150"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>
            <TextBlock Text="Style:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox x:Name="cmb_FontStyle" ComboType="FontStyle" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-150,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
        </StackPanel>       
    </Grid>
</UserControl>
