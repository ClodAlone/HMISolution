<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ReportVariables" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="400" Width="400" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="268*" />
        </Grid.RowDefinitions>
        <TextBlock Height="25" HorizontalAlignment="Left" Margin="10,5,0,0" Name="txt_HeaderText" Text="Change report variable." FontSize="14" VerticalAlignment="Top" Width="330" />
        <Grid Grid.Row="1" x:Name="grd_AddReferences" Visibility="Visible" Grid.RowSpan="2">            
            <StackPanel Margin="20,15,0,0" Orientation="Horizontal" Height="35" VerticalAlignment="Top">
                <Button Content="{x:Static prop:Resources.btnAdd}" x:Name="btn_Add" Margin="0,5,10,5" Width="50" Click="btn_Add_Click" />
                <Button Content="{x:Static prop:Resources.btnDelete}" x:Name="btn_Delete" Margin="0,5,10,5" Width="65" IsEnabled="False" Click="btn_Delete_Click" />               
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,50,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lbx_Variables" Height="280" Width="360">
                        <ListBoxItem IsSelected="False" IsHitTestVisible="False">
                            <StackPanel Width="340" Orientation="Horizontal" >
                                <TextBlock Text="Name" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"></TextBlock>
                                <TextBlock Text="Value" Margin="140,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"></TextBlock>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
