<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TablixSorting" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue" 
    Height="400" Width="430">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="360*" />
        </Grid.RowDefinitions>
        <TextBlock Height="20" HorizontalAlignment="Left" Margin="15,0,0,0" Name="txt_header" Text="Change sorting option." FontSize="14" VerticalAlignment="Center" Width="175" />
        <Grid Margin="0,0,0,0" Grid.Row="1" x:Name="grd_AddSorting" Visibility="Visible">
            <StackPanel Margin="20,10,0,0" Orientation="Horizontal" Height="25" VerticalAlignment="Top">
                <Button Content="{x:Static prop:Resources.btnAdd}" x:Name="btn_Add" Margin="0,0,10,0" Width="65" Click="btn_Add_Click" />
                <Button Content="{x:Static prop:Resources.btnDelete}" x:Name="btn_Delete" Margin="0,0,10,0" Width="65" IsEnabled="False" Click="btn_Delete_Click" />
                <Button Margin="0,0,10,0" Width="30"  x:Name="btn_UpArrow" IsEnabled="False" Click="btn_UpArrow_Click">
                    <Image Source="../../Images/UpArrow.png" Width="15" Height="15"/>
                </Button>
                <Button Margin="0,0,10,0" Width="30" x:Name="btn_DownArrow" IsEnabled="False" Click="btn_DownArrow_Click">
                    <Image Source="../../Images/DownArrow.png" Width="15" Height="15"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,40,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="lbx_SortingOptions" Height="300" Width="390">
                        <ListBoxItem IsSelected="False" IsHitTestVisible="False">
                            <StackPanel Width="360" Orientation="Horizontal">
                                <TextBlock Text="Column" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"></TextBlock>
                                <TextBlock Text="Order" Margin="240,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"></TextBlock>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
