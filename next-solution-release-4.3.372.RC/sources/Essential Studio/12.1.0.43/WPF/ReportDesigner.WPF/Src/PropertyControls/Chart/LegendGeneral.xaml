<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.LegendGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"       
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockLegendInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,1,0,17"></TextBlock>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockName}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <TextBox TabIndex="1" Name="Txt_LegendName" Text="Default" Width="150" HorizontalAlignment="Center" 
                     VerticalAlignment="Center" Margin="-250,0,0,-10" Height="23"/>
            <TextBlock Text="{x:Static prop:Resources.textBlockPosition}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <ComboBox x:Name="cmb_LegendPosition" SelectedIndex="0" HorizontalAlignment="Left" Width="150" Margin="-200,0,0,-10" Height="23"
                      VerticalAlignment="Center" IsEnabled="True" >
                <ComboBox.Items>
                    <ComboBoxItem Content="TopCenter"></ComboBoxItem> 
                    <ComboBoxItem Content="RightCenter"></ComboBoxItem>
                    <ComboBoxItem Content="BottomCenter"></ComboBoxItem>
                    <ComboBoxItem Content="LeftCenter"></ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Name="Txt_ShowLegend" Text="{x:Static prop:Resources.chkBoxShowLegend}" VerticalAlignment="Center" Margin="0,-30,0,0" Width="200"/>
            <designerlocal:ExpressionComboBox ComboType="Hidden" x:Name="Chkbx_ShowLegend" VerticalAlignment="Center" HorizontalAlignment="Left" Width="150"  Margin="-200,0,0,-10" Height="23"></designerlocal:ExpressionComboBox>
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockLayout}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <ComboBox x:Name="cmb_LegendLayout" SelectedIndex="1" HorizontalAlignment="Left" Width="150" Margin="-200,0,0,-10" Height="23"
                      VerticalAlignment="Center" IsEnabled="True" >
                <ComboBox.Items>
                    <ComboBoxItem Content="Column"></ComboBoxItem>
                    <ComboBoxItem Content="Row"></ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>
            <TextBlock Text="Color:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>               
            <designerlocal:CustomUIEditorDropDown TabIndex="5" x:Name="clrpkr_LegendColor" Width="150" 
                                    VerticalAlignment="Center" HorizontalAlignment="Left" IsEnabled="True" Margin="-200,0,0,-10" Height="23"></designerlocal:CustomUIEditorDropDown>
        </StackPanel>
    </Grid>
</UserControl>
