<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.LegendFont" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"     
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockLegendFontInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,2,0,16"></TextBlock>

        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="Font:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox x:Name="cmb_LegendFont" ComboType="FontFamily" Width="150" Margin="-250,0,0,-10" Height="23"></designerlocal:ExpressionComboBox>
            <TextBlock Text="Size:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox x:Name="cmb_LegendFontSize" ComboType="FontSize" Width="150" Margin="-250,0,0,-10" Height="23"></designerlocal:ExpressionComboBox>           
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="Color" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="3" x:Name="clrpkr_LegendFontColor" Width="150"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>
            <TextBlock Text="FontStyle:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox x:Name="cmb_FontStyle" ComboType="FontStyle" Width="150" Margin="-250,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>
        </StackPanel>        
    </Grid>
</UserControl>
