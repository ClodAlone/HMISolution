<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ScaleGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockScaleInfo}"
                   VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0" ></TextBlock>
        
        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockMinimumValue}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="1" x:Name="updwn_MinimumValue" IsTabStop="True"
                               HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>
            <TextBlock Text="{x:Static prop:Resources.textBlockMaximumValue}"  HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="2" x:Name="updwn_MaximumValue" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23" IsTabStop="True" />
        </StackPanel>        
      
        
        <StackPanel Margin="15,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockLabelMultiply}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0" />
            <syncfusion:UpDown TabIndex="3" x:Name="updwn_MultLabel" IsTabStop="True" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
            <TextBlock Text="{x:Static prop:Resources.textBlockScaleRadius}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <syncfusion:UpDown TabIndex="4" x:Name="updwn_ScaleRadius" IsTabStop="True" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"></syncfusion:UpDown>
        </StackPanel>       
      
        
        <StackPanel Margin="15,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockStartAngle}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <Slider TabIndex="5" Name="sldr_StartAngle" Minimum="0" Maximum="360" Interval="1" HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" 
                    Margin="-200,0,0,-15" Height="23" IsTabStop="True"/>
            <TextBlock Text="{x:Static prop:Resources.textBlockSweepAngle}" HorizontalAlignment="Left" Width="200" VerticalAlignment="Center" Margin="0,-30,0,0"/>
            <Slider TabIndex="6" Name="sldr_SweepAngle" Minimum="0" Maximum="360" Interval="1"
                    HorizontalAlignment="Left" Width="150" VerticalAlignment="Center" Margin="-200,0,0,-15" Height="23"/>
        </StackPanel>     
    </Grid>
</UserControl>
    
