<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.RectangleFill" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="350" Width="350">
    <Grid x:Name="grd_Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockTextFillInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="20,20,0,0" Grid.Row="1" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockFillColor}" HorizontalAlignment="Left" Width="50"></TextBlock>
            <Border Margin="0,3,0,0" Width="175" HorizontalAlignment="Left">
                <designerlocal:CustomUIEditorDropDown TabIndex="1" x:Name="clrpkr_Fill" Height="25"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
