<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.TextBoxBorder" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="350" Width="387"
             x:Name="TextBoxFontUser">
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="EffectsType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:EffectsType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grd_Font">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change the textBox border, width, background." VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <Grid Grid.Row="1" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="BorderStyle" />
                <designerlocal:ExpressionComboBox TabIndex="1" Height="25" ComboType="BorderStyle" x:Name="cmb_style" Margin="5,2,5,2" SelectedIndex="1" >
                    <!--<ComboBox.Items>
                        <ComboBoxItem Content="Solid" />
                        <ComboBoxItem Content="Dashed" />
                        <ComboBoxItem Content="Dotted" />
                    </ComboBox.Items>-->

                </designerlocal:ExpressionComboBox>
                <!--<TextBox x:Name="txt_FontName" Width="150" HorizontalAlignment="Left"/>
                <syncfusion:FontListBox x:Name="lst_FontName" Height="60" Width="150" HorizontalAlignment="Left"/>-->
            </StackPanel>
        </Grid>
        <TextBlock Text="BorderColor" Margin="25,11,188,60" Grid.Row="2" />
        <designerlocal:CustomUIEditorDropDown TabIndex="1" x:Name="borderColor" Margin="25,30,0,35" Height="25" Grid.Row="2" HorizontalAlignment="Left" Width="174" />
        <TextBlock Text="BorderWidth" Margin="25,5,188,136" Grid.Row="3" />
        <designerlocal:ExpressionComboBox x:Name="updwn_Custom" ComboType="BorderWidth" Margin="25,24,188,110" Height="25" Grid.Row="3"></designerlocal:ExpressionComboBox>
    </Grid>
</UserControl>
