<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ChartAreaBackground" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"   
    xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="400" Width="450">
    <Grid Loaded="grd_ChartAreaBackground_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static prop:Resources.textBlockChartAreaInfo}" VerticalAlignment="Center" FontSize="16" Margin="15,2,0,16"></TextBlock>

        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockFillStyle}" HorizontalAlignment="Left" Width="200" ></TextBlock>
            <designerlocal:ExpressionComboBox ComboType="FillStyle" x:Name="cmb_FillStyle" Width="150" Height="23" SelectionChanged="cmb_FillStyle_Changed" HorizontalAlignment="Left" />
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockPickColor}" HorizontalAlignment="Left" Width="430" Background="CornflowerBlue"
                       VerticalAlignment="Center" ></TextBlock>
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockGradientStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:ExpressionComboBox ComboType="GradientStyle" TabIndex="3" x:Name="cmb_GradientStyle" SelectedIndex="1" IsEnabled="False" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Width="150 " Margin="-200,0,0,-15" Height="23"></designerlocal:ExpressionComboBox>            
            <TextBlock Text="{x:Static prop:Resources.textBlockColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="4" x:Name="clrpkr_ColorFill" Width="150"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>
        </StackPanel>
        
        <StackPanel Margin="20,0,0,0" Grid.Row="4" VerticalAlignment="Center" Orientation="Horizontal" Height="50">
            <TextBlock Text="{x:Static prop:Resources.textBlockSecondaryColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Margin="0,-30,0,0"/>
            <designerlocal:CustomUIEditorDropDown TabIndex="5" x:Name="clrpkr_SecondaryColor" IsEnabled="False"
                                    VerticalAlignment="Center" Width="150" HorizontalAlignment="Left" Margin="-200,0,0,-15" Height="23"></designerlocal:CustomUIEditorDropDown>
        </StackPanel>
    </Grid>
</UserControl>
