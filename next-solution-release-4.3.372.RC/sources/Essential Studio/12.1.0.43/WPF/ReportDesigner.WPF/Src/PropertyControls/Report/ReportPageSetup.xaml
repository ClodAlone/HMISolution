<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ReportPageSetup" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="400" Width="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="PageSizeType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:PageSizeType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change page units, size, and margins for the report" VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0"></TextBlock>
        <StackPanel Margin="10,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="Page units:" HorizontalAlignment="Left" Width="50"></TextBlock>
            <StackPanel Orientation="Horizontal">
            <RadioButton TabIndex="1" x:Name="rbtn_PageUnitInches" IsChecked="True" GroupName="Inches" Margin="0,5,0,0" Content="Inches" />
            <RadioButton x:Name="rbtn_PageUnitCm" GroupName="Inches" Margin="80,5,0,0" Content="Centimeters" />
            </StackPanel>
        </StackPanel>
        <StackPanel Margin="10,5,20,0" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
            <StackPanel Height="20" Background="CornflowerBlue">
                <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="Paper size" />
            </StackPanel>
            <TextBlock Margin="10,5,0,0" Text="Orientation" />
            <StackPanel Margin="20,5,0,0" Orientation="Horizontal">
                <RadioButton TabIndex="2" x:Name="rbtn_Portrait" GroupName="Orientation" IsChecked="True" Content="Portrait" />
                <RadioButton TabIndex="3" x:Name="rbtn_Landscape" GroupName="Orientation" Margin="20,0,0,0" Content="Landscape" />
            </StackPanel>
            <StackPanel Margin="10,5,0,0" Orientation="Horizontal">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Paper size:" />
                    <ComboBox TabIndex="4" x:Name="cmb_PaperSize" Margin="0,5,0,0" Height="25" Width="110" SelectionChanged="PaperSizeChanged"/>
                </StackPanel>
                <StackPanel Margin="20,0,0,0" x:Name="stpnl_Width" Orientation="Vertical">
                    <TextBlock Text="Width:" HorizontalAlignment="Left" ></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:UpDown TabIndex="5" x:Name="updwn_Width" Width="90" Margin="0,5,0,0" TextAlignment="Left" HorizontalAlignment="Left" Height="25" Step="0.5"></syncfusion:UpDown>
                        <TextBlock Name="txt_WidthUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,0,0" x:Name="stpnl_Height" Orientation="Vertical">
                    <TextBlock Text="Height:" HorizontalAlignment="Left" ></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:UpDown TabIndex="6" x:Name="updwn_Height" Height="25" Width="90" Margin="0,5,0,0" TextAlignment="Left" HorizontalAlignment="Left" Step="0.5"></syncfusion:UpDown>
                        <TextBlock Name="txt_HeightUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Margin="10,0,20,0" Grid.Row="3" Height="20" Background="CornflowerBlue">
            <TextBlock FontWeight="Bold" Margin="5,3,0,0" Text="Margins" />
        </StackPanel>
        <StackPanel Margin="10,0,20,0" Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,0" x:Name="stpnl_Left" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Orientation="Vertical">
                    <TextBlock Text="Left:" HorizontalAlignment="Left" ></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:UpDown TabIndex="7" x:Name="updwn_Left" Height="25" Margin="0,5,0,0" Width="100" TextAlignment="Left" HorizontalAlignment="Left" Step="0.5"></syncfusion:UpDown>
                        <TextBlock Name="txt_LeftUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" x:Name="stpnl_Right" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical">
                    <TextBlock Text="Right:" HorizontalAlignment="Left" ></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:UpDown TabIndex="8" x:Name="updwn_Right" Height="25" Margin="0,5,0,0" Width="100" TextAlignment="Left" HorizontalAlignment="Left" Step="0.5" />
                        <TextBlock Name="txt_RightUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" x:Name="stpnl_Top" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Orientation="Vertical">
                    <TextBlock Text="Top:" HorizontalAlignment="Left" ></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:UpDown TabIndex="9" x:Name="updwn_Top" Height="25" TextAlignment="Left" Margin="0,5,0,0" Width="100" HorizontalAlignment="Left" Step="0.5"></syncfusion:UpDown>
                        <TextBlock Name="txt_TopUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" x:Name="stpnl_Bottom" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical">
                    <TextBlock Text="Bottom:" HorizontalAlignment="Left" ></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <syncfusion:UpDown TabIndex="10" x:Name="updwn_Bottom" Height="25" Margin="0,5,0,0" Width="100" TextAlignment="Left" HorizontalAlignment="Left" Step="0.5"></syncfusion:UpDown>
                        <TextBlock Name="txt_BottomUnit" Text="in" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="25" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
