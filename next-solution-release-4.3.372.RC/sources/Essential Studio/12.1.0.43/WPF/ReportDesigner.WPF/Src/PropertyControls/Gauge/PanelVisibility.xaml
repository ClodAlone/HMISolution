<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.PanelVisibility" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"             
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
    Height="300" Width="450">
    <Grid x:Name="grd_Visibility">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="{x:Static prop:Resources.textBlockDisplayOptions}" VerticalAlignment="Center" FontSize="16" 
                   Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="15,0,0,0" Grid.Row="1" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockReportInitiallyRun}" Margin="0,0,0,5" HorizontalAlignment="Left" ></TextBlock>
            <RadioButton TabIndex="1" x:Name="rbtn_Show" IsChecked="True" Margin="20,0,0,5" Content="{x:Static prop:Resources.radioBtnShow}" />
            <RadioButton TabIndex="1" x:Name="rbtn_Hide" Margin="20,0,0,5" Content="{x:Static prop:Resources.radioBtnHide}" />
        </StackPanel>
    </Grid>
</UserControl>
