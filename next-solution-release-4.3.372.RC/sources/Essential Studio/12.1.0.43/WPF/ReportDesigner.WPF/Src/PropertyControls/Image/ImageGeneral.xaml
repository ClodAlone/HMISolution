<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.ImageGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"             
    xmlns:local="clr-namespace:Syncfusion.Windows.Reports.Designer.Dialogs"  
              xmlns:prop="clr-namespace:Syncfusion.Windows.Reports.Designer.Properties"  
             xmlns:designerlocal="clr-namespace:Syncfusion.Windows.Reports.Designer.Editors"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"              
    Height="300" Width="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="ImageSourceType">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ImageSourceType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change name,image, and tooltip options." VerticalAlignment="Center" FontSize="16" Margin="15,10,0,28" ></TextBlock>
        <StackPanel Margin="20,0,0,0" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockName}" HorizontalAlignment="Left" Width="50" ></TextBlock>
            <TextBox TabIndex="1" Name="txt_GeneralName" HorizontalAlignment="Left" Width="300" Height="25" />
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="2" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockToolTip}" HorizontalAlignment="Left" Width="300" ></TextBlock>
            <Border Margin="0,3,0,0" Width="150" Height="25"  HorizontalAlignment="Left">
                <designerlocal:ExpressionComboBox x:Name="txt_ToolTip"  ComboType="ToolTip" Width="150" Margin="0,0,0,0" Height="23"></designerlocal:ExpressionComboBox>
            </Border>
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="3" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockSelectImageSource}" HorizontalAlignment="Left" Width="300" ></TextBlock>
            <ComboBox TabIndex="3" Name="cmb_ImageSource" HorizontalAlignment="Left" ItemsSource="{Binding Source={StaticResource ImageSourceType}}" Width="150" Height="23" >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="4" x:Name="stk_EmbeddedImage" VerticalAlignment="Top" Orientation="Vertical">
            <TextBlock Text="{x:Static prop:Resources.textBlockUsethisImage}" HorizontalAlignment="Left" Width="300" ></TextBlock>
            <StackPanel Orientation="Horizontal">
                <designerlocal:ExpressionComboBox ComboType="ImageValue" x:Name="cmb_ImageName" HorizontalAlignment="Left" Height="23" Width="300" />

                <Button Name="btn_Import" Content="Import" Margin="5,0,0,0" Width="70" Height="23" />
            </StackPanel>
        </StackPanel>
        <StackPanel Margin="20,0,0,0" Grid.Row="4" x:Name="stk_ExternalImage" VerticalAlignment="Top" Visibility="Hidden" Orientation="Vertical">
            <TextBlock Text="Use this image:" HorizontalAlignment="Left" Width="300"></TextBlock>
            <StackPanel Orientation="Horizontal">
                <ComboBox TabIndex="4" Name="cmb_ExternalImageName" HorizontalAlignment="Left" Width="300" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button TabIndex="5" Name="btn_Browse" Content="{x:Static prop:Resources.btnBrowse}" Margin="5,0,0,0" Width="70" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
