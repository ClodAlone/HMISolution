<UserControl x:Class="Syncfusion.Windows.Reports.Designer.Dialogs.LineGeneral" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    syncfusion:SkinStorage.VisualStyle="Office2007Blue"             
    Height="400" Width="400">
    <Grid x:Name="grd_General">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txt_HeaderText" Text="Change name" VerticalAlignment="Center" FontSize="16" Margin="15,0,0,0"></TextBlock>
        <StackPanel Margin="15,0,0,53" Grid.Row="1" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="Name:" HorizontalAlignment="Left" Width="50"></TextBlock>
        </StackPanel>
        <TextBox TabIndex="1" Name="txt_GeneralName" HorizontalAlignment="Left" Width="300" Margin="15,27,0,29" Grid.Row="1" Height="25" />
    </Grid>
</UserControl>
