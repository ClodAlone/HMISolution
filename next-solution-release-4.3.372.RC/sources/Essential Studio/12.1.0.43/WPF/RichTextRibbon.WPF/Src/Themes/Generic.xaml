                                                <MenuItem Header="3.0" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=3.0, Mode=TwoWay}"  Command="tools:RichTextBoxAdv.LineSpacing" CommandParameter="3.0"/>
                                            </tools:RibbonMenuGroup>
                                        </tools:DropDownButton>
