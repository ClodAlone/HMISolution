                                        <tools:RibbonButton SizeForm="ExtraSmall" Height="22" Width="24" Padding="2" Label="SubScript" IsToggle="True" IsSelected="{Binding Path=CurrentInlineStyle.Baseline, Converter={StaticResource SubscriptToChecked}, Mode=TwoWay}" Command="tools:RichTextBoxAdv.ToggleSubScript"  SmallIcon="/Syncfusion.RichTextRibbon.WPF;component/Images/Subscript16.png">
