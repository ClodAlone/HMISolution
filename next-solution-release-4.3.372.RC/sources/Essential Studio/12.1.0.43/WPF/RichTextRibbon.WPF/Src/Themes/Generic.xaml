                                        <tools:RibbonButton SizeForm="ExtraSmall" Height="22" Width="24" Padding="2" Label="SingleStrike" IsToggle="True" IsSelected="{Binding Path=CurrentInlineStyle.StrikeThrough, Converter={StaticResource SingleStrikeToChecked}, Mode=TwoWay}" Command="tools:RichTextBoxAdv.ToggleSingleStrikeThrough" SmallIcon="/Syncfusion.RichTextRibbon.WPF;component/Images/Strikethrough16.png">
