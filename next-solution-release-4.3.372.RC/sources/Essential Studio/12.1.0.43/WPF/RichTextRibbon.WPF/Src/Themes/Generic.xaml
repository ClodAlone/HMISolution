                                            </tools:RibbonButton.ToolTip>
                                        </tools:RibbonButton>
                                        <tools:RibbonButton SizeForm="ExtraSmall" Height="22" Width="24" Padding="2" Label="DoubleStrike" IsToggle="True" IsSelected="{Binding Path=CurrentInlineStyle.StrikeThrough, Converter={StaticResource DoubleStrikeToChecked}, Mode=TwoWay}" Command="tools:RichTextBoxAdv.ToggleDoubleStrikeThrough" SmallIcon="/Syncfusion.RichTextRibbon.WPF;component/Images/DoubleStrikethrough.png">
