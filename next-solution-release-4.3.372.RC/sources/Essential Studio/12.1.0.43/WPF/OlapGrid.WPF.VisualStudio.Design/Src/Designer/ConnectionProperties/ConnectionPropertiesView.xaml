<UserControl
	x:Class="Syncfusion.OlapGrid.WPF.VisualStudio.Design.ConnectionPropertiesView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.OlapGrid.WPF.VisualStudio.Design">
    <UserControl.Resources>
        <local:ConnectionModeToBoolConverter x:Key="connectionModeToBoolConverter" />
    </UserControl.Resources>
	<Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" /> <!-- 0th Row -->
            <RowDefinition Height="5*" /> <!-- 1th Row -->
            <RowDefinition Height="2*" /> <!-- 2th Row -->
            <RowDefinition Height="5*" /> <!-- 3th Row -->
            <RowDefinition Height="5*" /> <!-- 4th Row -->
            <RowDefinition Height="3*" /> <!-- 5th Row -->
            <RowDefinition Height="18*" /> <!-- 6th Row -->
            <RowDefinition Height="2*" /> <!-- 7th Row -->
            <RowDefinition Height="54*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Text="Create or edit connection properties..." FontSize="12pt" Margin="11,0,0,0"/>        
        <RadioButton Grid.Row="3" x:Name="radioButtonServer" Content="Use server name and data base to connect to a server." Margin="11,0,0,0" IsChecked="{Binding Path=ConnectionMode, Converter={StaticResource connectionModeToBoolConverter}, ConverterParameter=CustomServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>
        <RadioButton Grid.Row="4" x:Name="radioButtonRawConnectionString" Content="Use a connection string to connect to a server." Margin="11,0,0,0" IsChecked="{Binding Path=ConnectionMode, Converter={StaticResource connectionModeToBoolConverter}, ConverterParameter=RawString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"/>
        <Ellipse Grid.Row="5" Stroke="Gray" Fill="LightGray" Height="0.5" Margin="11,0,18,0"/>
        <Grid Grid.Row="6" Name="gridCustomServer" IsEnabled="{Binding Path=CanCustomServerGridEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Server Name:" VerticalAlignment="Bottom" Margin="11,0,0,4"/>
            <TextBox Name="textBoxServerName" Grid.Row="1" Height="25" Margin="11,0,18,0" Text="{Binding Path=ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="2" Text="Database Name:" VerticalAlignment="Bottom" Margin="11,0,0,4"/>
            <TextBox Name="textBoxDatabaseName" Grid.Row="3" Height="25" Margin="11,0,18,0" Text="{Binding Path=DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <StackPanel Grid.Row="8" Margin="11,0,18,0">
        <Expander Grid.Row="8" Header="Credentials" IsEnabled="{Binding Path=CanCustomServerGridEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
            <Grid Name="gridCredentials">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="5*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="User Name:" VerticalAlignment="Bottom" Margin="0,4,0,4" />
                <TextBox Name="textBoxUserName" Grid.Row="1" Height="25" Text="{Binding Path=UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="Password:" VerticalAlignment="Bottom" Margin="0,4,0,4"/>
                <TextBox Name="textBoxPassword" Grid.Row="3" Height="25" Text="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Expander>
        <TextBlock Grid.Row="10" Text="Connection String:" Margin="0,15,0,4" VerticalAlignment="Bottom"/>
        <TextBox Grid.Row="11" x:Name="textBoxRawConnectionString" IsEnabled="{Binding Path=CanRawStringEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding Path=RawConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="100"/>
        </StackPanel>
    </Grid>
</UserControl>