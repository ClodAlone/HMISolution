<Window x:Class="Syncfusion.OlapGrid.WPF.VisualStudio.Design.WizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:command="clr-namespace:Syncfusion.OlapGrid.WPF.VisualStudio.Design"
    Name="WizardControl"
    Title="Data Source Properties" Width="598" Height="625" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Canvas Background="#FFF0F0F0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="Gray" Height="{Binding ElementName=layoutGrid, Path=Height}" Width="{Binding ElementName=layoutGrid, Path=Width}" Margin="10,10,0,0">
                <Grid x:Name="layoutGrid" Background="White" Width="573" Height="544" Margin="0.5">            
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="70*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop Color="#FF222222" Offset="0" />
                                <GradientStop Color="#FF777777" Offset="0.85" />
                                <GradientStop Color="#FF666666" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="80*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Image x:Name="imageConnectionProperties"/>
                            <TextBlock x:Name="textBlockConnectionProperties" Text="Connection Properties" Foreground="White" FontSize="12" FontWeight="Bold" Margin="11,0,0,0">
                                <TextBlock.BitmapEffect>
                                    <OuterGlowBitmapEffect GlowColor="White" GlowSize="2" Opacity="0.35"/>
                                </TextBlock.BitmapEffect>
                            </TextBlock>                            
                        </StackPanel>
                        <!--<StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Image x:Name="imageDimensions"/>
                            <TextBlock x:Name="textBlockDimensions" Text="Slice and Dice" Foreground="White" Margin="11,0,0,0">                                
                            </TextBlock>
                        </StackPanel>-->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Image x:Name="imageSummaries"/>
                            <TextBlock x:Name="textBlockSummaires" Text="Query Designer" Foreground="White" Margin="11,0,0,0">
                                <!--<TextBlock.BitmapEffect>
                                    <OuterGlowBitmapEffect GlowColor="White" GlowSize="2" Opacity="0.5"/>
                                </TextBlock.BitmapEffect>-->
                            </TextBlock>                            
                        </StackPanel>
                        <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                            <Image Grid.Row="4" Source="{StaticResource wizardGrid}" Margin="15" />                        
                        </StackPanel>
                    </Grid>
                    
                    <!--Connection properties, Slice and dice and Summary controls will be hosted below.-->
                    <Grid x:Name="gridConentLayout" Grid.Column="1">    
                        <!--<StackPanel Name="stackPanelLayout" Orientation="Vertical">                            
                        </StackPanel>-->
                    </Grid>
                </Grid> 
            </Border>
            <Grid Grid.Row="1">
                <Button Name="buttonTestConnection" Content="Test Connection" Height="23" Width="100" HorizontalAlignment="Left" Margin="11,11,0,11" Click="buttonTestConnection_Click" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                    <Button Name="buttonBack"  Width="75" Height="23" Margin="0,0,7,0" Click="buttonBack_Click" >&lt; Back</Button>
                    <Button Name="buttonNext" Width="75" Height="23" Margin="0,0,7,0" Click="buttonNext_Click" ><!--Command="{Binding FinishButton}" >>-->
                        <!--<Button.CommandBindings>
                            <CommandBinding 
                        </Button.CommandBindings>-->
                        Next &gt;
                    </Button>
                    <Button Name="buttonFinish" Width="75" Height="23" Margin="0,0,0,0" Click="buttonFinish_Click">
                        Finish
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Canvas>
</Window>
