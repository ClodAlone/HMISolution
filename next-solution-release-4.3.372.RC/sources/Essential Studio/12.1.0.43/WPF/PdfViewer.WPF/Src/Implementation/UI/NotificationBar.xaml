<UserControl x:Class="Syncfusion.Windows.PdfViewer.NotificationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="38" HorizontalAlignment="Stretch" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,7,5,5" Name="button1" Width="20" Height="Auto">X</Button>
            <Image Width="20" Height="Auto" Source="{StaticResource Break}"></Image>
            <Label DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Name="label1" Width="Auto" >Label</Label>
            <TextBlock Name="LinkLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Hyperlink>
                    Copy exception details to the clipboard
                </Hyperlink>
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>
