<syncfusion:SmartTagBase x:Class="Syncfusion.Gauge.WPF.Expression.Design.LinearScaleSmartTag"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
                         syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                         Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="Linear Scale Tasks">

        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


       <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Text="pointercap1" Width="120" Height="22" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />
                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Action</TextBlock>

                <TextBlock Margin="5,5" Grid.Row="3">
                    <Hyperlink Tag="{x:Type syncfusion:LinearBarPointer}" Click="AddLinearBarPointer">Add Linear Bar Pointer</Hyperlink>
                </TextBlock>

                <TextBlock Margin="5,5" Grid.Row="4">
                    <Hyperlink Tag="{x:Type syncfusion:LinearMarkerPointer}" Click="AddLinearMarkerPointer">Add Linear Marker Pointer</Hyperlink>
                </TextBlock>

                <TextBlock Margin="5,5" Grid.Row="5">
                    <Hyperlink Tag="{x:Type syncfusion:LinearRange}" Click="AddLinearRange">Add Linear Range</Hyperlink>
                </TextBlock>

                <TextBlock Margin="5,5" Grid.Row="6">
                    <Hyperlink Tag="{x:Type syncfusion:LinearLabelTick}" Click="AddLinearLabelTick">Add Linear Label Tick</Hyperlink>
                </TextBlock>

                <TextBlock Margin="5,5" Grid.Row="7">
                    <Hyperlink Tag="{x:Type syncfusion:LinearMarkTick}" Click="AddLinearMarkTick">Add Linear Mark Tick</Hyperlink>
                </TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>
                
                <TextBlock Text="Minimum" Grid.Row="10" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtMinimum" Grid.Row="10" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />

                <TextBlock Text="Maximum" Grid.Row="11" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtMaximum" Grid.Row="11" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Minor Interval Value" Grid.Row="12" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtMinorIntervalValue" Grid.Row="12" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="MajorIntervalValue" Grid.Row="13" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtMajorIntervalValue" Grid.Row="13" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Scale Bar Length" Grid.Row="14" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtScaleBarLength" Grid.Row="14" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
                
                <TextBlock Text="Scale Bar Size" Grid.Row="15" Grid.Column="0" Margin="5,5,0,0"  VerticalAlignment="Center"/>
                <TextBox x:Name="txtScaleBarSize" Grid.Row="15" Grid.Column="1" Margin="5,5,0,0" Width="120" Height="22" HorizontalAlignment="Left" />
            </Grid>           
        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
