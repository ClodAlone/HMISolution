<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.VisualStudio.Design.RangeSliderSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="RangeSlider Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - Range Slider</TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="0.5"  Margin="7,7,7,0"/>
            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>


                    <TextBlock VerticalAlignment="Center" Text="Name" Grid.Row="2" Grid.Column="0"/>
                    <TextBox Name="name" Margin="3,3,3,3" Width="115" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Background" Grid.Row="3" Grid.Column="0"/>
                    <ComboBox Name="Backgroundselector" Margin="3,3,3,3" Width="115" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Foreground" Grid.Row="4" Grid.Column="0"/>
                    <ComboBox Name="Foregroundselector" Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>

					<Border BorderBrush="Black"  Grid.Row="7" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

					<TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="8">Behavior</TextBlock>
                    
                    <TextBlock VerticalAlignment="Center" Text="Tick Frequency" Grid.Row="9" Grid.Column="0"/>
                    <syncfusion:DoubleTextBox Name="Tickfrequency" Margin="3,3,3,3" Width="115" Grid.Row="9" Grid.Column="1"/>
                    
                    <TextBlock VerticalAlignment="Center" Text="Tick Placement" Grid.Row="10" Grid.Column="0"/>
                    <ComboBox Name="Tickplacement" Margin="3,3,3,3" Width="115" Grid.Row="10" Grid.Column="1"/>


                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
