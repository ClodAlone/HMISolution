<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.Expression.Design.TabSplitterSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue" 
                     Height="24" Width="24" x:Name="one">

    <syncfusion:SmartTagPresenter Title="TabSplitter Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - TabSplitter</TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="0.5"  Margin="7,7,7,0"/>
			<StackPanel Margin="7">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock Text="Name" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
					<TextBox Name="NameTextBox" HorizontalAlignment="Right" Margin="3" Width="115" Grid.Row="0" Grid.Column="1"/>
					<Border BorderBrush="Black"  Grid.Row="1" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
				</Grid>
			</StackPanel>
			<StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

                    <TextBlock VerticalAlignment="Center" Text="Mouse over Background" Grid.Row="1" Grid.Column="0"/>
                    <ComboBox Name="Backgroundselector" Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Mouse over Foreground" Grid.Row="2" Grid.Column="0"/>
                    <ComboBox Name="Foregroundselector" Margin="3,3,3,3" Width="115" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Selected Background" Grid.Row="3" Grid.Column="0"/>
                    <ComboBox Name="SelectedBackgroundelector" Margin="3,3,3,3" Width="115" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Selected Foreground" Grid.Row="4" Grid.Column="0"/>
                    <ComboBox Name="Selectedforeground" Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1"/>

                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
