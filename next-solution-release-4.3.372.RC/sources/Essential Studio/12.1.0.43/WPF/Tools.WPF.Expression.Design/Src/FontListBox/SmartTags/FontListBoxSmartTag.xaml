<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.Expression.Design.FontListBoxSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">
    <syncfusion:SmartTagPresenter Title="FontListBox Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <Grid Background="#FFDCEBFE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="7" Grid.Row="0">
                <TextBlock FontWeight="Bold">Essential Tools - FontListBox</TextBlock>

            </StackPanel>

            <StackPanel  Margin="7" Grid.Row="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <Border   Grid.Row="0" BorderBrush="Black"  BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Text="Name" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                    <TextBox Name="name"  Margin="3,3,3,3" Width="115" Grid.Row="1" Grid.Column="1"/>

                    <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="2" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>

                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="3">Appearance</TextBlock>

                    <TextBlock VerticalAlignment="Center" Text="Horizontal Alignment" Grid.Row="4" Grid.Column="0" Margin="2" />
                    <ComboBox Name="horizontalAlignment"  Margin="3,3,3,3" Width="115" Grid.Row="4" Grid.Column="1" />

                    <TextBlock VerticalAlignment="Center" Text="Vertical Alignment" Grid.Row="5" Grid.Column="0" Margin="2" />
                    <ComboBox Name="verticalAlignment"  Margin="3,3,3,3" Width="115" Grid.Row="5" Grid.Column="1" />


                    <Border  Margin="0,7,0,0" BorderBrush="Black" Grid.Row="7" BorderThickness=".5" HorizontalAlignment="Stretch" Grid.ColumnSpan="2"/>
                    <TextBlock Margin="0,7,0,0" FontWeight="Bold" Grid.Row="8">Behavior</TextBlock>

                    <StackPanel Grid.Row="9"  Margin="7">

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="DisplayFontNamesInSystemFont"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Display Font Names In System Font
                            </TextBlock>
                        </StackPanel>


                    </StackPanel>
                   
                </Grid>
            </StackPanel>
        </Grid>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>