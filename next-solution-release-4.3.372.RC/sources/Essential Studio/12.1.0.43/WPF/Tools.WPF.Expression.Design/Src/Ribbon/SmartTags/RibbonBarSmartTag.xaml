<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.Expression.Design.RibbonBarSmartTag"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="RibbonBar Tasks">


        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Header" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="HeaderTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>


                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />

                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Actions</TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonButton}" Click="AddChildControl">Add New RibbonButton</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonCheckBox}" Click="AddChildControl">Add New RibbonCheckBox</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonComboBox}" Click="AddChildControl">Add New RibbonComboBox</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:DropDownButton}" Click="AddChildControl">Add New DropDownButton</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonRadioButton}" Click="AddChildControl">Add New RibbonRadioButton</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonGallery}" Click="AddChildControl">Add New RibbonGallery</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type Separator}" Click="AddChildControl">Add New Separator</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:SplitButton}" Click="AddChildControl">Add New RibbonSplitButton</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:RibbonTextBox}" Click="AddChildControl">Add New RibbonTextBox</Hyperlink>
                </TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />




                <TextBlock FontWeight="Bold">Appearance</TextBlock>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Horizontal Alignment" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="HorizontalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="0" Grid.Column="1"/>


                    <TextBlock VerticalAlignment="Center" Text="Vertical Alignment" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VerticalAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Horizontal Content Alignment" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="HorizontalContentAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock VerticalAlignment="Center" Text="Vertical Content Alignment" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="VerticalContentAlignmentSelector" Margin="0,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>



                </Grid>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />


                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Behavior</TextBlock>


                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <CheckBox Name="IsLargeButtonPanelCheckBox"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                           Is LargeButtonPanel
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <CheckBox Name="IsLauncherButtonVisibleCheckBox"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                           Is LauncherButtonVisible
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <CheckBox Name="clipToBounds"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                           Clip to Bounds
                    </TextBlock>
                </StackPanel>


                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <CheckBox Name="isEnabled"/>
                    <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                          Is Enabled
                    </TextBlock>
                </StackPanel>



            </StackPanel>





        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
