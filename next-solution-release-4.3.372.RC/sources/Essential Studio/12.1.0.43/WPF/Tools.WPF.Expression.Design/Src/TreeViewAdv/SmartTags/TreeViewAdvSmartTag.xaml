<syncfusion:SmartTagBase x:Class="Syncfusion.Tools.WPF.Expression.Design.TreeViewAdvSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    Height="24" Width="24" syncfusion:SkinStorage.VisualStyle="Office2007Blue">

    <syncfusion:SmartTagPresenter Title="TreeViewAdv Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - TreeViewAdv</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>
                <TextBlock Margin="0,7,0,0">
					<Hyperlink Tag="{x:Type syncfusion:TreeViewItemAdv}" Click="AddChildControls">Add New TreeViewItemAdv</Hyperlink>
                </TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="0.5"  Margin="7,7,7,0"/>
			<StackPanel Margin="7">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<TextBlock Text="Name" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
				<TextBox Name="NameTextBox" Margin="3" HorizontalAlignment="Right" Width="115" Grid.Row="0" Grid.Column="1"/>
					<Border BorderBrush="Black"  Grid.Row="1" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
				</Grid>
			</StackPanel>

				<StackPanel  Margin="7">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>

                    <StackPanel Grid.Row="1"  Margin="7">


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="ShowRootLines"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Enable Rootlines of TreeViewAdv
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="MultiColumnEnable"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Enable Multi Column of TreeViewAdv
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>


                    <TextBlock VerticalAlignment="Center" Text="AnimationType" Grid.Row="2" Grid.Column="0"/>
                    <ComboBox Name="AnimationTypeSelector" Margin="3,3,3,3" Width="115" Grid.Row="2" Grid.Column="1"/>



                    <Border BorderBrush="Black"  Grid.Row="3" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                    <TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="4">Behavior</TextBlock>

                    <StackPanel Grid.Row="5"  Margin="7">

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="AllowMultiSelect"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Allow Multiple Selection of TreeViewItemAdv
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsFakeDragIndicator"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Enable Fake Drag Indicator
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="AllowDragDrop"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Allow Drag-and-Drop of TreeViewItemAdv
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="AllowsColumnReorder"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                      Allow Column Reorder
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>