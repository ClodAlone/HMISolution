<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"  xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
	                >

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

    <SolidColorBrush x:Key="Office2010BlackAutoCompleteBackground" Color="#FFC6C6C6" />
    <SolidColorBrush x:Key="Office2010BlackAutoCompleteBorderBrush" Color="#FF919191" />
    <Thickness x:Key="XP.Margin" >1</Thickness>
    <Thickness x:Key="Vista.Margin">0</Thickness>
    <SolidColorBrush x:Key="White" Color="White" />
    <SolidColorBrush x:Key="Office2010BlackToggleButtonPathFill" Color="Black" />
    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />

    <SolidColorBrush x:Key="Office2010BlackForeground" Color="Black" />

    <SolidColorBrush x:Key="Black" Color="Black" />

    <LinearGradientBrush x:Key="Office2010BlackToggleButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF9E7A1" Offset="0.073" />
        <GradientStop Color="#FFF9E085" Offset="0.384" />
        <GradientStop Color="#FFF9E69F" Offset="0.84" />
        <GradientStop Color="#FFFAF2CD" Offset="0.971" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2010BlackToggleButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFAD577" Offset="0" />
        <GradientStop Color="#FFFCDB7F" Offset="0.039" />
        <GradientStop Color="#FFFFE48A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2010BlackToggleButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC27A2D" Offset="0.113" />
        <GradientStop Color="#FFC29A44" Offset="0.887" />
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFEDC757" x:Key="Office2010BlackToggleButtonMouseOverBorderBrush" />
    <SolidColorBrush x:Key="Office2010BlackToggleButtonPressedInnerBackground" Color="#FFF7D072" />
    <Style x:Key="OfficeToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Office2010BlackAutoCompleteBackground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderBrush" Value="{StaticResource Transparent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Border BorderThickness="0" Background="Transparent" x:Name="InnerBorder"  Margin="1">
                            <Path Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center"  SnapsToDevicePixels="True"  Data="F1 M 386,271.344L 392.667,271.344L 392.667,272.677L 391.312,272.677L 391.312,274.01L 390.021,274.01L 390.021,275.323L 388.646,275.323L 388.646,273.969L 387.354,273.969L 387.354,272.635L 386,272.635L 386,271.344 Z "  Height="3"   Width="5.5">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.395101,-0.0808108" EndPoint="1.07361,-0.0808108">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <SkewTransform CenterX="0.395101" CenterY="-0.0808108" AngleX="27.1126" AngleY="0" />
                                                <RotateTransform CenterX="0.395101" CenterY="-0.0808108" Angle="66.6663" />
                                            </TransformGroup>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF6E6B5F" Offset="0" />
                                        <GradientStop Color="#FF44433F" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010BlackToggleButtonMouseOverBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFFCF4D7" Offset="0.649" />
                                        <GradientStop Color="#FFFCF8E8" Offset="0.905" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlackToggleButtonMouseOverBackground}" />
                        </Trigger>

                        <DataTrigger
                    Binding="{Binding Path=(local:AutoComplete.IsKeyboardFocusWithin), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010BlackToggleButtonMouseOverBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FFFCF4D7" Offset="0.649" />
                                        <GradientStop Color="#FFFCF8E8" Offset="0.905" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlackToggleButtonMouseOverBackground}" />
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlackToggleButtonMouseOverBackground}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsKeyboardFocusWithin), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsDropDownOpen), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlackToggleButtonPressedBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010BlackToggleButtonPressedBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010BlackToggleButtonPressedInnerBackground}">
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsKeyboardFocusWithin), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsHistoryDropDownOpen), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlackToggleButtonPressedBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010BlackToggleButtonPressedBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010BlackToggleButtonPressedInnerBackground}">
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <SolidColorBrush x:Key="Office2010BlackAutoCompleteThumbFillColor" Color="#FFABABAB" />
    <Style x:Key="Office2010BlackThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{StaticResource Office2010BlackAutoCompleteThumbFillColor}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFF7F7F7"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FFABABAB"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="Office2010BlackMouseOverToggleButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE2E2E2" Offset="0.078" />
        <GradientStop Color="#FFC4C4C4" Offset="0.968" />
    </LinearGradientBrush>
    <SolidColorBrush Color="#FF919191" x:Key="Office2010BlackMouseOverToggleButtonBorderBrush" />
    <Style x:Key="Office2010BlackAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource Office2010BlackAutoCompleteBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlackAutoCompleteBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Office2010BlackForeground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{StaticResource Office2010BlackForeground}">
                        <Grid Name="ContentGrid"
>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>

                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0"
                 Margin="0"
				 VerticalAlignment="Center" Style="{x:Null}"
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}"
                 BorderThickness="0"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
                 Padding="{TemplateBinding Padding}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1" BorderThickness="1"  Margin="0,-1,-1,-1" BorderBrush="{StaticResource Transparent}"
                              SnapsToDevicePixels="True"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource OfficeToggleDropDownButtonStyle}"
>

                                <Path Name="PART_Arrow"
                Data="M0,0 L3,4 6,0"

                Fill="{StaticResource Office2010BlackToggleButtonPathFill}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
              VerticalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">

                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw">
                                    <Border Background="White" BorderBrush="#FF919191" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_Container"    KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"      BorderThickness="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}"
                   Focusable="True">
                                            </ListBox>
                                            <Border BorderBrush="#FFC4C4C4" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFE2E2E2" Offset="0.285" />
                                                        <GradientStop Color="#FFCBCBCB" Offset="0.9" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Office2010BlackThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                            <Popup Name="HistoryPopup"
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True"
               Focusable="True"   VerticalOffset="1"
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="Shdw1">
                                    <Border Background="White" BorderBrush="#FF919191" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_HistoryContainer"    BorderThickness="0" KeyboardNavigation.DirectionalNavigation="Cycle"
                              SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"
			       Height="{TemplateBinding HistoryListHeight}"
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
>
                                            </ListBox>
                                            <Border BorderBrush="#FFC4C4C4" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFE2E2E2" Offset="0.285" />
                                                        <GradientStop Color="#FFCBCBCB" Offset="0.9" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="HistoryThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Office2010BlackThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="White" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Office2010BlackMouseOverToggleButtonBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{StaticResource Office2010BlackMouseOverToggleButtonBorderBrush}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>

                        <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw" Value="#71000000" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="HistoryPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw1" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw1" Value="#71000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2010BlackAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>