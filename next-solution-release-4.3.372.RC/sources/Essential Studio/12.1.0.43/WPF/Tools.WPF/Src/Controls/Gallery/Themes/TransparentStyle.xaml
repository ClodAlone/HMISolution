<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">
    
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="Black"/>
    <SolidColorBrush x:Key="InnerBorderBrush" Color="#CCFFFFFF"/>
    <LinearGradientBrush x:Key="ItemBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".7">
        <GradientStop Color="#FF8B8B8B"/>
        <GradientStop Color="#FFD4D4D4" Offset="0.068"/>
        <GradientStop Color="Silver" Offset="0.979"/>
        <GradientStop Color="#FFEED38A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ItemBorderBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="ItemForegroundBrush" Color="Black"/>
    <LinearGradientBrush x:Key="ItemMouseOverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7EF6F8F4" Offset="1"/>
        <GradientStop Color="#7EEAF0E6" Offset="0.968"/>
        <GradientStop Color="#A5CBD2B2" Offset="0.604"/>
        <GradientStop Color="Gainsboro"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ItemMouseOverBorderBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="ItemMouseOverForegroundBrush" Color="Black"/>
    <LinearGradientBrush x:Key="ItemSelectedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".7">
        <GradientStop Color="#993D3D3D"/>
        <GradientStop Color="#7E454545" Offset="0.369"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.649"/>
        <GradientStop Color="#BD9B9B9B" Offset="1"/>
        <GradientStop Color="#F1FFFFFF" Offset="0.948"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ItemSelectedBorderBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="Black"/>
    <SolidColorBrush x:Key="PanelBackground" Color="White" Opacity=".175"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="PanelSelectedBackground" Color="White" Opacity=".45"/>
    <SolidColorBrush x:Key="PanelSelectedBorderBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="PanelMouseOverBackground" Color="White" Opacity=".3"/>
    <SolidColorBrush x:Key="PanelMouseOverBorderBrush" Color="#B3000000" />
    <LinearGradientBrush x:Key="GroupBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".5">
        <GradientStop Color="#FFB2B2B2" Offset="0.04"/>
        <GradientStop Color="#FF4F4F4F" Offset="0.598"/>
        <GradientStop Color="#FF555555" Offset="0.879"/>
        <GradientStop Color="#FF6B6B6B" Offset="0.984"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GroupBorderBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="GroupForeground" Color="Black"/>
    <LinearGradientBrush x:Key="GroupMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".5">
        <GradientStop Color="#FF3D3D3D" Offset="0"/>
        <GradientStop Color="#FF434343" Offset="0.026"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GroupMouseOverBorderBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="GroupMouseOverForeground" Color="Black"/>
    <LinearGradientBrush x:Key="GroupSelectedBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity=".6">
        <GradientStop Color="#FFFAFAFA" Offset="0"/>
        <GradientStop Color="#FFE9E9E9" Offset="0.491"/>
        <GradientStop Color="#FFA5A5A5" Offset="0.531"/>
        <GradientStop Color="#FFB6B6B6" Offset="0.789"/>
        <GradientStop Color="Gray" Offset="0.996"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GroupSelectedForeground" Color="Black"/>
    <SolidColorBrush x:Key="GroupSelectedBorderBrush" Color="#B3000000" />

    <!--GalleryItem style-->
    <Style x:Key="TransparentGalleryItemStyle" TargetType="{x:Type local:GalleryItem}">
        <Setter Property="ContentTemplate" Value="{Binding Path=ItemContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="ContentTemplateSelector" Value="{Binding Path=ItemContentTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="VisualMode" Value="{Binding Path=VisualMode, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="IsAlwaysShownCaption" Value="{Binding Path=IsAlwaysShownCaption, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="AllowDrop" Value="{Binding Path=AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"/>
        <Setter Property="Margin" Value="{Binding Path=ItemMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>        
        <Style.Triggers>

            <Trigger Property="VisualMode" Value="Detailed">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryItem}">
                            <Border Name="border" MinHeight="75"  SnapsToDevicePixels="True"
                BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                        BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"  
                        CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                        Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" >
                                <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Name="InnerBorder" Grid.Column="0" Margin="2,4,2,4" Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" BorderThickness="1" BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" SnapsToDevicePixels="True">
                                            <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                                <ContentPresenter MinWidth="0" ContentSource="Content" Margin="2,1,1,1"
														ContentTemplate="{TemplateBinding Property=local:GalleryItem.ContentTemplate}"
														ContentTemplateSelector="{TemplateBinding Property=local:GalleryItem.ContentTemplateSelector}"/>
                                            </Border>
                                        </Border>
                                        <Border Name="HeaderTextBorder" Grid.Column="1" Margin="2" SnapsToDevicePixels="True"
                        CornerRadius="{Binding Path=CaptionCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderThickness="{Binding Path=CaptionBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderBrush="{Binding Path=CaptionBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        Background="{Binding Path=CaptionBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <TextBlock Name="HeaderText" Foreground="{Binding Path=ItemForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" Grid.Column="1" Margin="3,3,3,20" DockPanel.Dock="Top"
						 Text="{Binding Path=Caption, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}"
						 FontSize="14" FontWeight="Bold">
                                                 <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                        </TextBlock.Effect>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Name="DescrText" Foreground="{Binding Path=ItemForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" Grid.Column="1" DockPanel.Dock="Bottom" Margin="5,30,3,3"
										 Text="{Binding Path=Description, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}"
										 FontSize="11" FontStyle="Normal">
                                             <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                        </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"  Property="Background"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="BorderBrush" Value="{Binding Path=ItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>                                    
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="BorderBrush" Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>
                                <Trigger Property="HasFocus" Value="True">
                                    <Setter TargetName="border" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="BorderBrush" Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="HeaderText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="DescrText"  Property="Foreground" Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>                               
                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="border" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="Background"  Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="border"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="Standard"/>
                    <Condition Property="IsAlwaysShownCaption" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryItem}">
                            <utilsOuter:TrippleBorder Name="contentBorder"                              
                             BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
							 Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"                            
                             MinWidth="0" CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             SnapsToDevicePixels="True">
                                <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1">
                                    <ContentPresenter MinWidth="0" ContentSource="Content" TextBlock.Foreground="{TemplateBinding Foreground}"
                        Margin="{Binding Path=ItemPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
										    ContentTemplate="{TemplateBinding Property=local:GalleryItem.ContentTemplate}"
										    ContentTemplateSelector="{TemplateBinding Property=local:GalleryItem.ContentTemplateSelector}">
                                        <ContentPresenter.Effect>
                                            <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35"/>
                                        </ContentPresenter.Effect>
                                    </ContentPresenter>
                                </Border>
                            </utilsOuter:TrippleBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground"  Value="{Binding Path=ItemMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground"  Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>

                                <Trigger Property="HasFocus" Value="true">
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground"  Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="HasFocus" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground"  Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </MultiTrigger>
                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="contentBorder"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground"  Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground"  Value="{Binding Path=ItemSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </MultiTrigger>                              
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="Standard"/>
                    <Condition Property="IsAlwaysShownCaption" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryItem}">
                            <utilsOuter:TrippleBorder Name="contentBorder"  CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"                             
                             BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
							 Background="{Binding Path=ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"                         
                             MinWidth="0"
                             SnapsToDevicePixels="True">
                                <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0" Name="contentGridColumn0"></ColumnDefinition>
                                            <ColumnDefinition Width="0" Name="contentGridColumn1"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="0" Name="contentGridColumn3"></ColumnDefinition>
                                            <ColumnDefinition Width="0" Name="contentGridColumn4"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0" Name="contentGridRow0"></RowDefinition>
                                            <RowDefinition Height="0" Name="contentGridRow1"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="0" Name="contentGridRow3"></RowDefinition>
                                            <RowDefinition Height="0" Name="contentGridRow4"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Border Name="headerTextBorder" Grid.Column="2" Grid.Row="0" Margin="1" SnapsToDevicePixels="True"
                        CornerRadius="{Binding Path=CaptionCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderThickness="{Binding Path=CaptionBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderBrush="{Binding Path=CaptionBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        Background="{Binding Path=CaptionBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <TextBlock Text="{Binding Path=Caption, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}" 
                               FontSize="9" FontWeight="Bold" TextAlignment="Center" Grid.Row="0" Grid.Column="2" Name="headerTextBlock">
                                                 <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                        </TextBlock.Effect>
                                            </TextBlock>
                                        </Border>
                                        <ContentPresenter MinWidth="0" MinHeight="0" ContentSource="Content"
										    ContentTemplate="{TemplateBinding Property=local:GalleryItem.ContentTemplate}"
										    ContentTemplateSelector="{TemplateBinding Property=local:GalleryItem.ContentTemplateSelector}"
                                  Grid.Column="2" Grid.Row="2"/>
                                        <Border Name="descriptionTextBorder" Grid.Column="2" Grid.Row="4" Margin="1" SnapsToDevicePixels="True"
                        CornerRadius="{Binding Path=CaptionCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderThickness="{Binding Path=CaptionBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        BorderBrush="{Binding Path=CaptionBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                        Background="{Binding Path=CaptionBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                            <TextBlock Text="{Binding Path=Description, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryItem}}}" 
                               FontSize="8" TextAlignment="Center" Grid.Row="4" Grid.Column="2" Name="descriptionTextBlock">
                                                 <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                        </TextBlock.Effect>


                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </utilsOuter:TrippleBorder>
                            <ControlTemplate.Triggers>

                                <!--CaptionAlignment and DescriptionAlignment related triggers-->
                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Top">
                                    <Setter TargetName="contentGridRow0" Property="Height" Value="16"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Bottom">
                                    <Setter TargetName="contentGridRow3" Property="Height" Value="16"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Row" Value="3"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Row" Value="3"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Left">
                                    <Setter TargetName="contentGridColumn0" Property="Width" Value="16"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="headerTextBlock" Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter TargetName="headerTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=CaptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Right">
                                    <Setter TargetName="contentGridColumn3" Property="Width" Value="16"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="headerTextBorder" Property="Grid.Column" Value="3"/>
                                    <Setter TargetName="headerTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Top">
                                    <Setter TargetName="contentGridRow1" Property="Height" Value="14"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Row" Value="1"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Bottom">
                                    <Setter TargetName="contentGridRow4" Property="Height" Value="14"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Left">
                                    <Setter TargetName="contentGridColumn1" Property="Width" Value="14"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Column" Value="1"/>
                                    <Setter TargetName="descriptionTextBlock" Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter TargetName="descriptionTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Path=DescriptionAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                         Value="Right">
                                    <Setter TargetName="contentGridColumn4" Property="Width" Value="14"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="descriptionTextBorder" Property="Grid.Column" Value="4"/>
                                    <Setter TargetName="descriptionTextBlock" Property="Grid.Column" Value="4"/>
                                    <Setter TargetName="descriptionTextBlock" Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground" Value="White"/>

                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=ItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=ItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <!--<Setter TargetName="innerBorder" Property="BorderBrush" Value="White"/>-->
                                </Trigger>
                                <Trigger Property="HasFocus" Value="true">
                                    <Setter TargetName="contentBorder"  Property="Background"  Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush"  Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground" Value="White"/>

                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true"/>
                                        <Condition Property="HasFocus" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="contentBorder" Property="BorderThickness" Value="{Binding Path=FocusedItemBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground" Value="White"/>

                                </MultiTrigger>
                                <Trigger Property="IsDragOver" Value="true">
                                    <Setter TargetName="contentBorder"  Property="Background" Value="{Binding Path=FocusedItemBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush" Value="{Binding Path=FocusedItemBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground" Value="White"/>

                                </Trigger>                              
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="HasFocus" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="contentBorder"  Property="BorderBrush" Value="{Binding Path=FocusedItemMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="contentBorder"  Property="Background" Value="{Binding Path=FocusedItemMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource TransparentGalleryItemStyle}" TargetType="{x:Type local:GalleryItem}"/>

    <!--GalleryGroup style-->
    <Style TargetType="{x:Type local:GalleryGroup}">
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}"/>
        <Setter Property="ItemContentTemplate" Value="{Binding Path=ItemContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="ItemContentTemplateSelector" Value="{Binding Path=ItemContentTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="AllowDrop" Value="{Binding Path=AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="IsAlwaysShownCaption" Value="{Binding Path=IsAlwaysShownCaption, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="CaptionAlignment" Value="{Binding Path=CaptionAlignment, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="DescriptionAlignment" Value="{Binding Path=DescriptionAlignment, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GalleryGroup}">
                    <DockPanel Name="GroupStandardPanel" MinHeight="20" Background="Transparent">
                        <Border  Name="headerBorder" DockPanel.Dock="Top" MinHeight="20" SnapsToDevicePixels="True"
                             Margin="{Binding Path=GroupMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Background="{Binding Path=GroupBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 BorderBrush="{Binding Path=GroupBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             BorderThickness="{Binding Path=GroupBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             CornerRadius="{Binding Path=GroupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Padding="{Binding Path=GroupPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 Visibility="{Binding Path=IsHeaderVisible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Gallery}}, Converter={StaticResource BooleanToVisibility}}" >
                            <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1">
                                <ContentPresenter Name="GroupHeaderText" Margin="2" TextBlock.Foreground="{Binding Path=GroupForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" TextBlock.FontSize="14" TextBlock.FontFamily="{TemplateBinding FontFamily}" ContentSource="Header">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Border>
                        <Border Name="groupStandardBorder" SnapsToDevicePixels="True"
					Margin="{Binding Path=GroupStandardBorderMargin, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					BorderBrush="{Binding Path=PanelBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					Background="{Binding Path=PanelBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
					BorderThickness="1,0,1,1"
                            Padding="{Binding Path=PanelPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            CornerRadius="{Binding Path=PanelCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                            <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1">
                                <ItemsPresenter/>
                            </Border>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:Gallery.IsSelected" Value="True">
                            <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                        </Trigger>
                        <Trigger Property="IsDragOver" Value="true">
                            <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupSelectedBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="groupStandardBorder"  Property="Background"  Value="{Binding Path=PanelMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="groupStandardBorder"  Property="BorderBrush" Value="{Binding Path=PanelMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <!--<Setter TargetName="headerinnerBorder" Property="BorderBrush" Value="#FFF4F6FA"/>-->
                            <Setter TargetName="headerBorder"  Property="Background"  Value="{Binding Path=GroupMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="headerBorder"  Property="BorderBrush" Value="{Binding Path=GroupMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                            <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:WrapPanelExt ItemWidth="{Binding Path=ItemWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemHeight="{Binding Path=ItemHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMinWidth="{Binding Path=ItemMinWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMaxWidth="{Binding Path=ItemMaxWidth, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMinHeight="{Binding Path=ItemMinHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
                                        ItemMaxHeight="{Binding Path=ItemMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}" 
   VerticalAlignment="{Binding Path=VerticalAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryGroup}}}"
                             ClipToBounds="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="VisualMode" Value="Detailed">
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:GalleryGroup}">

                            <StackPanel Background="Transparent" MinHeight="50">
                                <Border  Name="headerDetailedBorder" DockPanel.Dock="Top" SnapsToDevicePixels="True"
					 MinHeight="15" 
                             Margin="{Binding Path=GroupMargin, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Background="{Binding Path=GroupBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					 BorderBrush="{Binding Path=GroupBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             BorderThickness="{Binding Path=GroupBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
                             CornerRadius="{Binding Path=GroupCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                             Padding="{Binding Path=GroupPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}">
                                    <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                        <ContentPresenter Name="GroupHeaderText" TextBlock.Foreground="{Binding Path=GroupForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" ContentSource="Header" Margin="2,2,0,2">
                                            <ContentPresenter.Effect>
                                                <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                            </ContentPresenter.Effect>
                                        </ContentPresenter>
                                    </Border>
                                </Border>
                                <Border Name="groupDetailedBorder" Margin="{Binding Path=GroupStandardBorderMargin, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
					BorderBrush="{Binding Path=PanelBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" SnapsToDevicePixels="True"
					Background="{Binding Path=PanelBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" 
					BorderThickness="1,0,1,1"
                            Padding="{Binding Path=PanelPadding, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"
                            CornerRadius="{Binding Path=PanelCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}" MinHeight="30">
                                    <Border BorderBrush="{StaticResource InnerBorderBrush}" BorderThickness="1,0,1,1" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="groupDetailedBorder"  Property="Background"  Value="{Binding Path=PanelMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="groupDetailedBorder"  Property="BorderBrush" Value="{Binding Path=PanelMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerDetailedBorder"  Property="Background"  Value="{Binding Path=GroupMouseOverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="headerDetailedBorder"  Property="BorderBrush" Value="{Binding Path=GroupMouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                    <Setter TargetName="GroupHeaderText"  Property="TextBlock.Foreground" Value="{Binding Path=GroupMouseOverForeground, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
                                </Trigger>                              
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--GalleryDeterminedStyle-->
    <Style x:Key="GalleryDeterminedStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="BorderThickness" Value="{Binding Path=BorderThickness, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="CornerRadius" Value="{Binding Path=GalleryCornerRadius, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="Padding" Value="{Binding Path=Padding, RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:Gallery}}}" />
        <Setter Property="Margin" Value="1" />
    </Style>
                  
    <!--Gallery  style-->
    <Style x:Key="TransparentGalleryStyle" TargetType="{x:Type local:Gallery}">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="ItemBackground" Value="{StaticResource ItemBackgroundBrush}"/>
        <Setter Property="ItemBorderBrush" Value="{StaticResource ItemBorderBrush}"/>
        <Setter Property="ItemForeground" Value="{StaticResource ItemForegroundBrush}"/>

        <Setter Property="ItemMouseOverBackground"  Value="{StaticResource ItemMouseOverBackgroundBrush}"/>
        <Setter Property="ItemMouseOverBorderBrush" Value="{StaticResource ItemMouseOverBorderBrush}"/>
        <Setter Property="ItemMouseOverForeground" Value="{StaticResource ItemMouseOverForegroundBrush}"/>

        <Setter Property="ItemSelectedBackground" Value="{StaticResource ItemSelectedBackgroundBrush}"/>
        <Setter Property="ItemSelectedBorderBrush" Value="{StaticResource ItemSelectedBorderBrush}"/>
        <Setter Property="ItemSelectedForeground" Value="{StaticResource ItemSelectedForegroundBrush}"/>

        <Setter Property="FocusedItemBackground" Value="{StaticResource ItemSelectedBackgroundBrush}"/>
        <Setter Property="FocusedItemBorderBrush" Value="{StaticResource ItemSelectedBorderBrush}"/>
        
        <Setter Property="FocusedItemMouseOverBackground"  Value="{StaticResource ItemSelectedBackgroundBrush}"/>
        <Setter Property="FocusedItemMouseOverBorderBrush" Value="{StaticResource ItemSelectedBorderBrush}"/>
        <Setter Property="FocusedItemMouseOverForeground" Value="{StaticResource ItemSelectedForegroundBrush}"/>        

        <Setter Property="GroupBackground" Value="{StaticResource GroupBackground}"/>
        <Setter Property="GroupBorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="GroupMouseOverBackground" Value="{StaticResource GroupMouseOverBackground}"/>
        <Setter Property="GroupMouseOverBorderBrush" Value="{StaticResource PanelMouseOverBorderBrush}"/>
        <Setter Property="GroupSelectedBackground" Value="{StaticResource GroupSelectedBackground}"/>
        <Setter Property="GroupSelectedBorderBrush" Value="{StaticResource PanelSelectedBorderBrush}"/>
        <Setter Property="GroupMouseOverForeground" Value="{StaticResource GroupMouseOverForeground}"/>
        <Setter Property="GroupSelectedForeground" Value="{StaticResource GroupSelectedForeground}"/>
        <Setter Property="GroupForeground" Value="{StaticResource GroupForeground}"/>
        
        <Setter Property="PanelBackground" Value="{StaticResource PanelBackground}"/>
        <Setter Property="PanelBorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="PanelSelectedBackground" Value="{StaticResource PanelSelectedBackground}"/>
        <Setter Property="PanelSelectedBorderBrush" Value="{StaticResource PanelSelectedBorderBrush}"/>
        <Setter Property="PanelMouseOverBackground" Value="{StaticResource PanelMouseOverBackground}"/>
        <Setter Property="PanelMouseOverBorderBrush" Value="{StaticResource PanelMouseOverBorderBrush}"/>

        <Setter Property="PanelBorderThickness" Value="1"/>
        <Setter Property="GroupMargin" Value="1,0,1,0"/>
        <Setter Property="GroupBorderThickness" Value="1"/>
        <Setter Property="GroupCornerRadius" Value="0"/>
        <Setter Property="GroupPadding" Value="0"/>
        <Setter Property="PanelCornerRadius" Value="0"/>
        <Setter Property="PanelPadding" Value="0"/>
        <Setter Property="FocusedItemBorderThickness" Value="1"/>
        <Setter Property="SelectedItemBorderThickness" Value="1"/>
        <Setter Property="ItemBorderThickness" Value="1"/>
        <Setter Property="ItemCornerRadius" Value="0"/>
        <Setter Property="ItemPadding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="AllowDrop" Value="{Binding Path=AllowDrop, RelativeSource={RelativeSource AncestorType={x:Type local:Gallery}}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Gallery}">
                    <Border Style="{StaticResource GalleryDeterminedStyle}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:GalleryStackPanel Background="Transparent"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource TransparentGalleryStyle}" TargetType="{x:Type local:Gallery}"/>

</ResourceDictionary>