<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Office2003Metallic_GroupBar_BorderBrush" Color="#FF7C7C94"/>
	<LinearGradientBrush x:Key="Office2003Metallic_GroupBar_HeaderBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFE1E2EC"/>
				<GradientStop Offset="1" Color="#FF9593B2"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003Metallic_GroupBar_Content" Color="#FFE0DFE3"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Office2003Metallic_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE1E2EC"/>
			<GradientStop Offset="1" Color="#FF9593B2"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Metallic_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFBE694"/>
			<GradientStop Offset="1" Color="#FFEE9515"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Metallic_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFDC"/>
			<GradientStop Offset="1" Color="#FFF7C05B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Metallic_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE87F08"/>
			<GradientStop Offset="1" Color="#FFF7DA7C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_SeparatorBrush" Color="#FF7C7C94"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Office2003Metallic_GroupView_Background" Color="#FFE0DFE3"/>

	<!-- GroupViewItem -->
	<Color x:Key="Office2003Metallic_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Office2003Metallic_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Office2003Metallic_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Office2003Metallic_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_BackgroundBrush" Color="#FFE0DFE3"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_BorderBrush" Color="#FFE0DFE3"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003Metallic_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

	<!-- Splitter -->
	<LinearGradientBrush x:Key="Office2003Metallic_Splitter_BackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFA8A7BF"/>
			<GradientStop Offset="1" Color="#FF777697"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Office2003Metallic_NavigationToolbar_BackgroundBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFE1E2EC"/>
				<GradientStop Offset="1" Color="#FF9593B2"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Office2003Metallic_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFBE694"/>
			<GradientStop Offset="1" Color="#FFEE9515"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Metallic_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFDC"/>
			<GradientStop Offset="1" Color="#FFF7C05B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Metallic_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE87F08"/>
			<GradientStop Offset="1" Color="#FFF7DA7C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!-- MenuItem -->
	<LinearGradientBrush x:Key="Office2003Metallic_MenuItem_Brush"
						 StartPoint="0,0"
						 EndPoint="1,0">
		<GradientStop Color="#FFF9F9FF" Offset="0"/>
		<GradientStop Color="#FF9F9DB9" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003Metallic_MenuItem_OverBrush" Color="#FFFFEEC2"/>
	<SolidColorBrush x:Key="Office2003Metallic_MenuItem_OverBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="Office2003Metallic_MenuItem_SelectedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="Office2003Metallic_MenuItem_SelectedOverBackgroundBrush" Color="#FFFE803E"/>
	<SolidColorBrush x:Key="Office2003Metallic_MenuItem_SeparatorBrush" Color="#FF6E6D8F"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="Office2003Metallic_Menu_BackgroundBrush" Color="#FFFDFAFF"/>
	<SolidColorBrush x:Key="Office2003Metallic_Menu_BorderBrush" Color="#FF7C7C94"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="Office2003Metallic_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003Metallic_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003Metallic_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="Office2003Metallic_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003Metallic_ItemText_Brush" Color="Black"/>

</ResourceDictionary>