<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupBar_BorderBrush" Color="#FF919B9C"/>
	<LinearGradientBrush x:Key="VisualStudio2005Metallic_GroupBar_HeaderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFD3D4DD"/>
				<GradientStop Offset="1" Color="#FFA6A5BF"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupBar_Content" Color="#FFEAE9EE"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="VisualStudio2005Metallic_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFEBECEA"/>
			<GradientStop Offset="1" Color="#FFDFE0E3"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupBarItem_BorderBrush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupBarItem_SelectedBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupBarItem_SelectedBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_SeparatorBrush" Color="#FFD9DADD"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupView_Background" Color="#FFEAE9EE"/>

	<!-- GroupViewItem -->
	<Color x:Key="VisualStudio2005Metallic_GroupViewItem_OverBackgroundColor">#FFFFEEC2</Color>
	<Color x:Key="VisualStudio2005Metallic_GroupViewItem_PressedBackgroundColor">#FFFFC06F</Color>
	<Color x:Key="VisualStudio2005Metallic_GroupViewItem_SelectedBackgroundColor">#FFFFC06F</Color>
	<Color x:Key="VisualStudio2005Metallic_GroupViewItem_SelectedOverBackgroundColor">#FFFE803E</Color>

	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_BackgroundBrush" Color="#FFEAE9EE"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_BorderBrush" Color="#FFEAE9EE"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_OverBackgroundBrush" Color="#FFFFEEC2"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_OverBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_PressedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_PressedBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_SelectedBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE803E"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="VisualStudio2005Metallic_NavigationToolbar_BackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFD3D4DD"/>
				<GradientStop Offset="1" Color="#FFA6A5BF"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_OverBrush" Color="#FFFFEEC2"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_OverBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_PressedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_PressedBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_SelectedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_SelectedBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_NavigationToolbarItem_SelectedOverBackgroundBrush" Color="#FFFE803E"/>

	<!-- MenuItem -->
	<LinearGradientBrush x:Key="VisualStudio2005Metallic_MenuItem_Brush"
						 EndPoint="1,0"
						 StartPoint="0,0">
		<GradientStop Color="#FF9F9DB9" Offset="1"/>
		<GradientStop Color="#FFB1B0C7" Offset="0.875"/>
		<GradientStop Color="#FFF9F9FF" Offset="0"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuItem_OverBrush" Color="#FFFFEEC2"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuItem_OverBorderBrush" Color="#FF4B4B6F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuItem_SelectedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuItem_SelectedOverBackgroundBrush" Color="#FFFE803E"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuItem_SeparatorBrush" Color="#FFC5C2B8"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="VisualStudio2005Metallic_Menu_BackgroundBrush" Color="#FFE9E7D8"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_Menu_BorderBrush" Color="#FFACA899"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="VisualStudio2005Metallic_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="VisualStudio2005Metallic_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Luna.Metallic_CollapseArrowColor" Color="Black"/>
    <SolidColorBrush x:Key="Luna.Metallic_PopupBorderFillColor" Color="#B6B5C9"/>
    <SolidColorBrush x:Key="Luna.Metallic_NavigationPaneColor" Color="#EAE9EE"/>
    <SolidColorBrush x:Key="Luna.Metallic_NavigationPaneMouseOverColor" Color="#FFC06F"/>
    <SolidColorBrush x:Key="Luna.Metallic_NavigationPaneTextColor" Color="Black"/>
    <SolidColorBrush x:Key="Luna.Metallic_NavigationPaneBorderColor" Color="#919B9C"/>
    <SolidColorBrush x:Key="Luna.Metallic_NavigationPaneCheckedBorderColor" Color="Black"/>

</ResourceDictionary>