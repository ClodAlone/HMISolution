<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Office2003Homestead_GroupBar_BorderBrush" Color="#FF608058"/>
	<LinearGradientBrush x:Key="Office2003Homestead_GroupBar_HeaderBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFEAF0CF"/>
				<GradientStop Offset="1" Color="#FFB1C08C"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003Homestead_GroupBar_Content" Color="#FFECE9D8"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Office2003Homestead_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFEAF0CF"/>
			<GradientStop Offset="1" Color="#FFB1C08C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Homestead_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFBE694"/>
			<GradientStop Offset="1" Color="#FFEE9515"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Homestead_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFDC"/>
			<GradientStop Offset="1" Color="#FFF7C05B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Homestead_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE87F08"/>
			<GradientStop Offset="1" Color="#FFF7DA7C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_SeparatorBrush" Color="#FF608058"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Office2003Homestead_GroupView_Background" Color="#FFECE9D8"/>

	<!-- GroupViewItem -->
	<Color x:Key="Office2003Homestead_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Office2003Homestead_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Office2003Homestead_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Office2003Homestead_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_BackgroundBrush" Color="#FFECE9D8"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_BorderBrush" Color="#FFECE9D8"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003Homestead_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

	<!-- Splitter -->
	<LinearGradientBrush x:Key="Office2003Homestead_Splitter_BackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FF788E6F"/>
			<GradientStop Offset="1" Color="#FF495B43"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Office2003Homestead_NavigationToolbar_BackgroundBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFEAF0CF"/>
				<GradientStop Offset="1" Color="#FFB1C08C"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Office2003Homestead_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFBE694"/>
			<GradientStop Offset="1" Color="#FFEE9515"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Homestead_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFDC"/>
			<GradientStop Offset="1" Color="#FFF7C05B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003Homestead_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE87F08"/>
			<GradientStop Offset="1" Color="#FFF7DA7C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!-- MenuItem -->
	<LinearGradientBrush x:Key="Office2003Homestead_MenuItem_Brush"
						 StartPoint="0,0"
						 EndPoint="1,0">
		<GradientStop Color="#FFFFFFED" Offset="0"/>
		<GradientStop Color="#FFB8C792" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003Homestead_MenuItem_OverBrush" Color="#FFFFEEC2"/>
	<SolidColorBrush x:Key="Office2003Homestead_MenuItem_OverBorderBrush" Color="#FF3F5D38"/>
	<SolidColorBrush x:Key="Office2003Homestead_MenuItem_SelectedBackgroundBrush" Color="#FFFFC06F"/>
	<SolidColorBrush x:Key="Office2003Homestead_MenuItem_SelectedOverBackgroundBrush" Color="#FFFE803E"/>
	<SolidColorBrush x:Key="Office2003Homestead_MenuItem_SeparatorBrush" Color="#FF608058"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="Office2003Homestead_Menu_BackgroundBrush" Color="#FFF4F4EE"/>
	<SolidColorBrush x:Key="Office2003Homestead_Menu_BorderBrush" Color="#FF758D5E"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="Office2003Homestead_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003Homestead_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003Homestead_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="Office2003Homestead_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003Homestead_ItemText_Brush" Color="Black"/>

</ResourceDictionary>