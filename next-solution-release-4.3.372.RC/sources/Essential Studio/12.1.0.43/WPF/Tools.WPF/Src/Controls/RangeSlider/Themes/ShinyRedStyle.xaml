    <ControlTemplate x:Key="ThumbTemplateKey" TargetType="Thumb">

        <Grid>
            <Path Stretch="Fill" x:Name="paththumb" Stroke="{StaticResource HorizontalThumbBorderBrush}"  StrokeThickness="1"   Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z" Fill="{StaticResource RepeatButtonLeft}">
            </Path>
            <Path Stretch="Fill" x:Name="paththumb1"  StrokeThickness="1" Stroke="Transparent"  Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z" Fill="{StaticResource RepeatButtonLeft}">
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="paththumb" Property="Fill" Value="{StaticResource RangeSliderRepeatButtonMouseOverBrushKey}">
                </Setter>
                <Setter TargetName="paththumb1" Property="Fill" Value="{StaticResource RangeSliderRepeatButtonMouseOverBrushKey}">
                </Setter>
                <Setter TargetName="paththumb" Property="Stroke">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFB6B6B6" Offset="0" />
                            <GradientStop Color="#FF040404" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--Custom Template for vertical Thumb-->

