<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:conv="clr-namespace:Syncfusion.Windows.Tools"
xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/MetroThemeBrushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:IsSymbolFontConverter x:Key="IsSymbolFontConverter" />
    <conv:MergeCollectionsConverter x:Key="MergeCollectionsConverter" />
    <conv:FontToRecordConverter x:Key="FontToRecordConverter" />

    <!-- Brushes -->

    <SolidColorBrush x:Key="MetroFontListBoxBorderBrush" Color="#FFCCCCCC" />

    <SolidColorBrush x:Key="MetroFontListBoxItemMouseOverBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="MetroHeaderBackground" Color="#FFD8D8D9" />
    <SolidColorBrush x:Key="MetroHeaderBorderBrush" Color="Transparent" />
    <Thickness x:Key="MetroHeaderBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />

    <SolidColorBrush x:Key="MetroFontListBoxItemBackground" Color="Transparent" />

    <CornerRadius x:Key="MetroBorderCornerRadius">0</CornerRadius>

    <Thickness x:Key="MetroFontListBoxItemMargin" Left="1" Top="0" Right="1" Bottom="0" />

    <!--DataTemplate for FontFamilyRecord -->
    <DataTemplate x:Key="FontFamilyRecordTemplate" DataType="{x:Type local:FontFamilyRecord}">
        <Border Height="20" Name="border">
            <DockPanel ClipToBounds="True">
                <Border Name="icon"  Height="18" Width="18" Margin="1" Opacity="1">
                    <Border.Background>
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/FontListBox/Images/tt.png"></BitmapImage>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock Margin="2"  Name="tb"  VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"  Text="{Binding Path=Name}" FontFamily="{Binding Path=Family}" />
                <TextBlock Margin="2"  Name="tbName" VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
                <TextBlock Margin="2" Name="tbPurpose" VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" DockPanel.Dock="Right"
                   HorizontalAlignment="Right" Text="{Binding Path=Purpose}" Opacity="0" />
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true">
                <Setter TargetName="tbName" Property="Text" Value="{Binding Path=Name}" />
                <Setter TargetName="tb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="tb" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="tb" Property="Text" Value="abcde123" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tb" Property="Opacity" Value="0" />
                <Setter TargetName="tb" Property="Text" Value="" />
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="false" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=DisplayFontNamesInSystemFont, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" Value="True">
                <Setter TargetName="tb" Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TouchFontFamilyRecordTemplate" DataType="{x:Type local:FontFamilyRecord}">
        <Border Height="45" Name="border">
            <DockPanel ClipToBounds="True">
                <Border Name="icon"  Height="30" Width="30" Margin="1" Opacity="1">
                    <Border.Background>
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/FontListBox/Images/tt.png"></BitmapImage>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock Margin="2"  Name="tb"  VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"  Text="{Binding Path=Name}" FontFamily="{Binding Path=Family}" />
                <TextBlock Margin="2"  Name="tbName" VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
                <TextBlock Margin="2" Name="tbPurpose" VerticalAlignment="Center" FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" DockPanel.Dock="Right"
                   HorizontalAlignment="Right" Text="{Binding Path=Purpose}" Opacity="0" />
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true">
                <Setter TargetName="tbName" Property="Text" Value="{Binding Path=Name}" />
                <Setter TargetName="tb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="tb" Property="DockPanel.Dock" Value="Right" />
                <Setter TargetName="tb" Property="Text" Value="abcde123" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="true" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tb" Property="Opacity" Value="0" />
                <Setter TargetName="tb" Property="Text" Value="" />
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=Type}" Value="Theme" />
                    <Condition Binding ="{Binding ElementName=tb, Path=FontFamily, Converter={StaticResource IsSymbolFontConverter}}"
                   Value="false" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="tbPurpose" Property="Opacity" Value="1" />
                <Setter TargetName="icon" Property="Opacity" Value="0" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=DisplayFontNamesInSystemFont, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" Value="True">
                <Setter TargetName="tb" Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--FontListBox template-->
    <Style x:Key="MetroFontListBoxStyle" TargetType="{x:Type local:FontListBox}">
        <Setter Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MetroFontListBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:FontListBox}">
                    <Border Name="Border"
				Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}"
				BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"
>
                        <local:FontListBoxInternal>
                            <local:FontListBoxInternal.ItemsSource>
                                <MultiBinding Converter="{StaticResource MergeCollectionsConverter}">
                                    <Binding Path="ThemeFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                    <Binding Path="RecentlyUsedFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                    <Binding Path="AllFonts" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" UpdateSourceTrigger="PropertyChanged" />
                                </MultiBinding>
                            </local:FontListBoxInternal.ItemsSource>

                            <local:FontListBoxInternal.SelectedItem>
                                <Binding Path="SelectedFontFamily" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Converter="{StaticResource FontToRecordConverter}" Mode="TwoWay" />
                            </local:FontListBoxInternal.SelectedItem>

                            <local:FontListBoxInternal.FocusedItem>
                                <Binding Path="FocusedFontFamily" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Converter="{StaticResource FontToRecordConverter}" Mode="TwoWay" />
                            </local:FontListBoxInternal.FocusedItem>

                            <local:FontListBoxInternal.HasFocus>
                                <Binding Path="HasFocus" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                            </local:FontListBoxInternal.HasFocus>

                            <local:FontListBoxInternal.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:InternalPanel x:Name="iternalPanel" GroupHeaderStyle="{Binding Path=GroupHeaderStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
																 Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                </ItemsPanelTemplate>
                            </local:FontListBoxInternal.ItemsPanel>

                            <local:FontListBoxInternal.ItemTemplate>
                                <Binding Path="ItemTemplate" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                            </local:FontListBoxInternal.ItemTemplate>

                            <local:FontListBoxInternal.ItemContainerStyle>
                                <Binding Path="ItemContainerStyle" RelativeSource="{RelativeSource AncestorType={x:Type local:FontListBox}}" Mode="TwoWay" />
                            </local:FontListBoxInternal.ItemContainerStyle>
                        </local:FontListBoxInternal>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="FontSize" Value="18" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource MetroFontListBoxStyle}" TargetType="{x:Type local:FontListBox}" />

    <Style TargetType="{x:Type local:FontListBoxInternalItem}">
        <Setter Property="Background" Value="{StaticResource MetroFontListBoxItemBackground}" />
        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}" />
        <Setter Property="Margin" Value="{StaticResource MetroFontListBoxItemMargin}" />
        <Setter Property="ContentTemplate" Value="{StaticResource FontFamilyRecordTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:FontListBoxInternalItem}">
                    <Grid>
                        <Border Name="Border" TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource MetroBorderCornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True">

                            <ContentPresenter MinWidth="0" ContentSource="Content"
					          ContentTemplate="{TemplateBinding ContentTemplate}"
				              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                        </Border>
                        <Rectangle x:Name="BottomBorder" Fill="{StaticResource MetroFontListBoxBorderBrush}" Height="1" Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <!--<Setter TargetName="Border" Property="Margin" Value="0,-1,0,0" />-->
                            <Setter TargetName="BottomBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasFocus" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="Border" Property="TextBlock.Foreground" Value="{DynamicResource MetroHighlightedForegroundBrush}" />
                            <Setter TargetName="BottomBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Margin" Value="0" />
                <Setter Property="ContentTemplate" Value="{StaticResource TouchFontFamilyRecordTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:GroupHeader}">
        <Setter Property="Background" Value="{StaticResource   MetroHeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource MetroFontFamily}" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:GroupHeader}">
                    <Border Name="Border" Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            Background="{TemplateBinding Background}"
            BorderThickness="{StaticResource MetroHeaderBorderThickness}" Margin="0,0,0,1"
            BorderBrush="{StaticResource MetroHeaderBorderBrush}">
                        <TextBlock Text="{TemplateBinding Text}"
                       FontSize="{TemplateBinding FontSize}"
                       FontFamily="{TemplateBinding FontFamily}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"
                       FontStyle="{TemplateBinding FontStyle}" Margin="1"
                       VerticalAlignment="{TemplateBinding VerticalAlignment}"
                       HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                       FlowDirection="{TemplateBinding FlowDirection}"
                       FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="20" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>