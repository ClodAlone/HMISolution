<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:Sync_Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF" >
    
    <!-- Brushes -->
	<Geometry x:Key="RightArrow">M 0,0 L 4,3.5 L 0,7 Z</Geometry>
	<Geometry x:Key="Checkmark">M 0,5.1 L 1.7,5.2 L 3.4,7.1 L 8,0.4 L 9.2,0 L 3.3,10.8 Z</Geometry>
    <Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey"/>
    <SolidColorBrush x:Key="Blend.TabControlBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="Blend.TabPanelBackgroundBrush" Color="#333333" />
    <Thickness x:Key="Blend.TabPanelPadding" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Blend.TabPanelMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Blend.ContentPanelBorderThickness" Left="3" Top="3" Right="3" Bottom="3" />
    <CornerRadius x:Key="Blend.ContentPanelBorderCornerRadius" TopLeft="5" TopRight="5" BottomRight="5" BottomLeft="5" />
    <Thickness x:Key="Blend.ContentPanelInnerBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Blend.ContentPanelInnerBorderMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Blend.ContentPanelOuterBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />
    <Thickness x:Key="Blend.TabItemBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />

    <SolidColorBrush x:Key="Blend.ActiveForeground" Color="White"/>
    <SolidColorBrush x:Key="Blend.InactiveForeground" Color="White"/>
    <SolidColorBrush x:Key="Blend.TabHoverBorderBrush" Color="#595959"/>
    <SolidColorBrush x:Key="Blend.TabSelectedBorderBrush" Color="#595959"/>
    <SolidColorBrush x:Key="Blend.TabHoverSelectedBorderBrush" Color="#595959"/>
    <SolidColorBrush x:Key="Blend.TabSubLineBorderBrush" Color="#595959"/>
    <SolidColorBrush x:Key="Blend.TabBottomBorderBrush" Color="#595959"/>
    <SolidColorBrush x:Key="Blend.ButtonActivePathBrush" Color="White"/>
    <SolidColorBrush x:Key="Blend.ButtonInactivePathBrush" Color="#CBCBCB"/>
    <SolidColorBrush x:Key="Blend.ButtonInactiveBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Blend.ButtonActiveBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Blend.ContentPanelBorderBrush" Color="#595959"/>
    <!--<SolidColorBrush x:Key="Blend.ContentPanelBackgroundBrush" Color="#595959"/>-->
    <SolidColorBrush x:Key="Blend.ContentPanelInnerBorderBrush" Color="#595959"/>   
    <SolidColorBrush x:Key="Blend.ContextMenuBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Blend.ContextMenuBorderBrush" Color="#FF595959"/>
    <!--<SolidColorBrush x:Key="Blend.ContextMenuBarBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Blend.ContextMenuBarInnerBorderBrush" Color="White"/>-->
    <SolidColorBrush x:Key="Blend.ContextMenuBarBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Blend.ContextMenuBarInnerBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Blend.MenuItemBorderBrush" Color="#3A3A3A"/>    
    <SolidColorBrush x:Key="Blend.MenuItemActiveForeground" Color="White" />
    <SolidColorBrush x:Key="Blend.MenuItemInactiveForeground" Color="White" />
    
    <SolidColorBrush x:Key="Blend.ButtonBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Blend.TabHoverBackgroundBrush" Color="#424242" />
    <SolidColorBrush x:Key="Blend.TabSelectedBackgroundBrush" Color="#595959" />
 <SolidColorBrush x:Key="TabBackground.Blend" Color="#FF595959"/>

    <SolidColorBrush x:Key="Blend.MenuItemBackgroundBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="Blend.ContextMenuBarBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Blend.TabItemBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Blend.TabItemBorderBrush" Color="#3A3A3A"/>

	<local:ImageAlignmentToDockConverter x:Key="ImageAlignmentToDockConverter"/>

    <DataTemplate x:Key="HeaderDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBlock Focusable="False" Text="{Binding FallbackValue=''}" TextTrimming="CharacterEllipsis" 
				   IsHitTestVisible="False" Padding="4,0,4,1" />
    </DataTemplate>

    <DataTemplate x:Key="EditableDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBox x:Name="EditableHeader" Focusable="True" Style="{Binding Path=EditHeaderItemStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}"
				 Text="{Binding Path=Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabItemExt}}, Mode=TwoWay}"  
				 IsReadOnly="False" Padding="4,1,4,1" />
    </DataTemplate>

    <LinearGradientBrush x:Key="background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFCFDFD" Offset="0"/>
        <GradientStop Color="#FFE5EAF5" Offset="0.3"/>
        <GradientStop Color="#FFCFD7EB" Offset="0.3"/>
        <GradientStop Color="#FFE0E5F5" Offset="0.7"/>
        <GradientStop Color="#FFECEEFC" Offset="1"/>
    </LinearGradientBrush>


    <ControlTemplate TargetType="{x:Type TabItem}" 
                                     x:Key="newtabitem">
        <Border BorderThickness="0" 
                                Margin="2,0,0,0"  Name="Bd"
                                BorderBrush="AliceBlue" 
                                Background="{StaticResource background}"
                                CornerRadius="5,5,0,0">
        </Border>      
    </ControlTemplate>


    <local:CloseButtonTypeToVisibilityConverter x:Key="CloseButtonTypeToVisibilityConverter"/>
    <shared:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx"/>

    <SolidColorBrush x:Key="ButtonAdvPressedBackgroundBrush" Color="#FF424242"/>
    <SolidColorBrush x:Key="ButtonAdvPressedBorderBrush" Color="#FF1A1A1A"/>
    <ControlTemplate x:Key="BlendCloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Blend.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource Blend.ButtonInactivePathBrush}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                <Setter Property="Height" Value="13" TargetName="pathButton"/>
                <Setter Property="Width" Value="13" TargetName="pathButton"/>
                <Setter Property="Data" Value="M1,1 L12,12 M1,12 L12,1" TargetName="pathButton"/>
                <Setter Property="StrokeThickness" Value="2.5" TargetName="pathButton"/>



            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                <Setter Property="BorderBrush" TargetName="brdBack" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                <Setter Property="Fill" TargetName="pathButton" Value="Black"/>
                <Setter Property="Stroke" TargetName="pathButton" Value="Black"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                </MultiTrigger.Conditions>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Blend.ButtonBackgroundBrush}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Blend.ButtonActiveBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Stroke" Value="#FFFFFFFF"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="BlendMenuButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Blend.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Fill="{StaticResource Blend.ButtonInactivePathBrush}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                <LineSegment Point="8,1"/>
                                <LineSegment Point="8,3"/>
                                <LineSegment Point="0,3"/>
                            </PathFigure>
                        </PathGeometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                <LineSegment Point="4,8"/>
                                <LineSegment Point="8,4"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                <Setter Property="Height" Value="15" TargetName="pathButton"/>
                <Setter Property="Width" Value="15" TargetName="pathButton"/>

                <Setter TargetName="pathButton" Property="Data">
                    <Setter.Value>
                        <GeometryGroup>
                            <PathGeometry>
                                <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                    <LineSegment Point="14,1"/>
                                    <LineSegment Point="14,4"/>
                                    <LineSegment Point="0,4"/>
                                </PathFigure>
                            </PathGeometry>
                            <PathGeometry>
                                <PathFigure StartPoint="0,7" IsFilled="True" IsClosed="True">
                                    <LineSegment Point="7,14"/>
                                    <LineSegment Point="14,7"/>
                                </PathFigure>
                            </PathGeometry>
                        </GeometryGroup>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions >
                    <Condition Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    <Condition Binding="{Binding Path=(shared:SkinStorage.EnableTouch),RelativeSource={RelativeSource AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="false"/>
                </MultiDataTrigger.Conditions>

                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L4,8 L8,4 z"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions >
                    <Condition Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    <Condition Binding="{Binding Path=(shared:SkinStorage.EnableTouch),RelativeSource={RelativeSource AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="true"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="14" TargetName="pathButton"/>
                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L8,12 L14,4 z"/>
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                <Setter Property="BorderBrush" TargetName="brdBack" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                <Setter Property="Fill" TargetName="pathButton" Value="Black"/>
                <Setter Property="Stroke" TargetName="pathButton" Value="Black"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                </MultiTrigger.Conditions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition  Property="IsMouseOver" Value="True"/>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Blend.ButtonBackgroundBrush}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Blend.ButtonActiveBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BlendTabScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <shared:Border3D x:Name="PART_Border" VerticalAlignment="Center" HorizontalAlignment="Center"
				Margin="1,0,0,0"
                Padding="1"
                Width="15"
                Height="15" Background="Transparent"
                BorderThickness="1"
                BorderBrush="{StaticResource Blend.ButtonInactiveBorderBrush}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0">
                        <Canvas Width="8" Height="7" x:Name="canvas"  VerticalAlignment="center" HorizontalAlignment="center">
                            <Path Data="M0,0L4,3.5 0,7" HorizontalAlignment="Center" Stroke="{StaticResource Blend.ButtonInactivePathBrush}" Fill="{StaticResource Blend.ButtonInactivePathBrush}" Name="PART_Path1" VerticalAlignment="Center"/>
                            <Path Data="M4,0L8,3.5 4,7" HorizontalAlignment="Center" Stroke="{StaticResource Blend.ButtonInactivePathBrush}" Fill="{StaticResource Blend.ButtonInactivePathBrush}" Name="PART_Path2" VerticalAlignment="Center"/>
                            <Path Data="M5,0L5,7" HorizontalAlignment="Center" Stroke="{StaticResource Blend.ButtonInactivePathBrush}" Fill="{StaticResource Blend.ButtonInactivePathBrush}" Name="PART_Path3" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Canvas>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                            <Setter Property="Data" TargetName="PART_Path1" Value="M0,0 L8,6 0,12"/>
                            <Setter Property="Height" TargetName="PART_Border" Value="24"/>
                            <Setter Property="Width" TargetName="PART_Border" Value="24"/>
                            <Setter Property="Data" TargetName="PART_Path2" Value="M4,0L12,6 4,12"/>
                            <Setter Property="Margin" TargetName="canvas" Value="0,0,0,5"/>
                        </Trigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="LastTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="LastTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M9,0L9,12"/>

                            <Setter TargetName="PART_Path3" Property="StrokeThickness" Value="2"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="FirstTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,7"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="FirstTab"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M12,0L4,5.5 12,11"/>
                            <Setter Property="Margin" TargetName="canvas" Value="0,0,4,5"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,12"/>
                            <Setter TargetName="PART_Path3" Property="StrokeThickness" Value="2"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="PrevPage"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="PrevPage"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Margin" TargetName="canvas" Value="0,0,4,5"/>

                            <Setter TargetName="PART_Path1" Property="Data" Value="M8,0L0,6 8,11"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M12,0L4,6 12,11"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="Tag" Value="PrevTab"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="Tag" Value="PrevTab"/>
                            </MultiTrigger.Conditions>


                            <Setter TargetName="PART_Path1" Property="Data" Value="M8,0L0,6 8,12"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="NextTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>


                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource ButtonAdvPressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{StaticResource ButtonAdvPressedBorderBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="Black"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="Black"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="Black"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="Black"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="Black"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="Black"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="true"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="false"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource Blend.ButtonBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{StaticResource Blend.ButtonActiveBorderBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource Blend.ButtonActivePathBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Path1" Property="Opacity" Value=".4"/>
                            <Setter TargetName="PART_Path2" Property="Opacity" Value=".4"/>
                            <Setter TargetName="PART_Path3" Property="Opacity" Value=".4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlendTabPanelAdvStyle" TargetType="{x:Type local:TabPanelAdv}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabPanelAdv}">
                    <Border Name="Bord" Background="{Binding TabPanelBackground,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}},FallbackValue=Transparent}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}"
							CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">


                        <DockPanel LastChildFill="True">
                            <Border Name="BottomBorder" Height="0" DockPanel.Dock="Bottom" Background="Transparent" />


                            <ContentPresenter x:Name="PART_CustomItems"  AllowDrop="False" ContentSource="TabPanelItem"
                                              MaxHeight="{Binding Path=ActualHeight, ElementName=PART_TabItems}" Margin="2,0,0,0" DockPanel.Dock="Right" 
                                              Content="{Binding Path=TabPanelItem, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=''}">

                            </ContentPresenter>
                            <local:NewTabLayout>
                                <ContentPresenter x:Name="PART_ToolBarTray" Content="{Binding Path=ToolBarTray, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=''}" />
                                <local:TabItemExt BorderThickness="80" Name="PART_NewTab" DockPanel.Dock="Top" IsNewTab="True" />
                            </local:NewTabLayout>
                            <ToggleButton Name="PART_CloseButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  Focusable="False" 
                                  AllowDrop="False"
                                  Visibility="{Binding Path=CloseButtonType, Converter={StaticResource CloseButtonTypeToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Collapsed}"
							      Template="{StaticResource BlendCloseButtonTemplate}"
                                  Command="local:TabControlCommands.CloseCurrentTabItem" 
                                  >
                                <ToggleButton.ToolTip>
                                    <ToolTip Name="tooltip" >
                                        <TextBlock Name="tooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseButtonTooltipText}"/>
                                    </ToolTip>
                                </ToggleButton.ToolTip>
                            </ToggleButton>

                            <ToggleButton Name="PART_MenuButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  AllowDrop="False"
                                  Focusable="True"
                                  Visibility="{Binding Path=ShowTabListContextMenu, Converter={StaticResource BooleanToVisibilityConverterEx}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Collapsed}"
							      Template="{StaticResource BlendMenuButtonTemplate}"
                                  Command="local:TabControlCommands.OpenContextMenu"
                                  >
                                <ToggleButton.ToolTip>
                                    <ToolTip Name="PART_ContextMenuButtonTooltip" >
